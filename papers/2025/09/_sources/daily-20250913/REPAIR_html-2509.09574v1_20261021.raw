<tbody id="A3.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66.m1" class="ltx_math_unparsed" alttext="\displaystyle+N\sum^{m-1}_{i=1}(F(\mu)^{N(T_{i}+\Delta_{i}+1)}-F(\mu)^{NT_{i+1}})\int^{1}_{\mu}rd\frac{(F(r)^{N}-F(\mu)^{N})}{1-F(\mu)N}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>N</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">(</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><mi>r</mi><mi>d</mi><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle+N\sum^{m-1}_{i=1}(F(\mu)^{N(T_{i}+\Delta_{i}+1)}-F(\mu)^{NT_{i+1}})\int^{1}_{\mu}rd\frac{(F(r)^{N}-F(\mu)^{N})}{1-F(\mu)N}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex67.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67.m2" class="ltx_Math" alttext="\displaystyle v_{\emptyset}(t)+N\sum^{m}_{i=1}F(\mu)^{N(T_{i}+\Delta_{i}+1)}\int^{1}_{\mu}\frac{1-F(r)^{N}}{1-F(\mu)^{N}}dr+N\sum^{m}_{i=1}F(\mu)^{NT_{i}}\left(\int^{1}_{\mu}\frac{F(r)^{N}-F(\mu)^{N}}{1-F(\mu)^{N}}dr-\int^{1}_{\mu}\left(\frac{F(r)-F(\mu)}{1-F(\mu)}+F(\mu)^{\Delta_{i}+1}\frac{1-F(r)}{1-F(\mu)}\right)^{N}dr\right)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mi mathvariant="normal">∅</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle v_{\emptyset}(t)+N\sum^{m}_{i=1}F(\mu)^{N(T_{i}+\Delta_{i}+1)}\int^{1}_{\mu}\frac{1-F(r)^{N}}{1-F(\mu)^{N}}dr+N\sum^{m}_{i=1}F(\mu)^{NT_{i}}\left(\int^{1}_{\mu}\frac{F(r)^{N}-F(\mu)^{N}}{1-F(\mu)^{N}}dr-\int^{1}_{\mu}\left(\frac{F(r)-F(\mu)}{1-F(\mu)}+F(\mu)^{\Delta_{i}+1}\frac{1-F(r)}{1-F(\mu)}\right)^{N}dr\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(45)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E45.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E45.m2" class="ltx_Math" alttext="\displaystyle v_{\emptyset}(t)+N\sum^{m}_{i=1}F(\mu)^{NT_{i}}y_{\Delta_{i}+1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>v</mi><mi mathvariant="normal">∅</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle v_{\emptyset}(t)+N\sum^{m}_{i=1}F(\mu)^{NT_{i}}y_{\Delta_{i}+1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.3" class="ltx_p">For social welfare of total time horizon <math id="A3.p10.m4" class="ltx_Math" alttext="V_{\mathcal{M}}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><annotation encoding="application/x-tex">V_{\mathcal{M}}</annotation></semantics></math>, we calculate it by summing up <math id="A3.p10.m5" class="ltx_Math" alttext="v_{\mathcal{M}}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">v_{\mathcal{M}}(t)</annotation></semantics></math> above for all time slots:</p>
<table id="A3.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex68.m1" class="ltx_Math" alttext="\displaystyle V_{\mathcal{M}}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle V_{\mathcal{M}}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68.m2" class="ltx_Math" alttext="\displaystyle N\sum^{T_{1}}_{t=0}v_{\mathcal{M}}(t)+\sum_{m=1}^{M}\left(\sum^{T_{m}+\Delta_{m}}_{t=T_{m}+1}v_{\mathcal{M}}(t)+N\sum^{T_{m+1}}_{t=T_{m}+\Delta_{m}+1}v_{\mathcal{M}}(t)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><msub><mi>v</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub></mrow></munderover></mstyle><mrow><msub><mi>v</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><msub><mi>T</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></munderover></mstyle><mrow><msub><mi>v</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N\sum^{T_{1}}_{t=0}v_{\mathcal{M}}(t)+\sum_{m=1}^{M}\left(\sum^{T_{m}+\Delta_{m}}_{t=T_{m}+1}v_{\mathcal{M}}(t)+N\sum^{T_{m+1}}_{t=T_{m}+\Delta_{m}+1}v_{\mathcal{M}}(t)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex69.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69.m2" class="ltx_Math" alttext="\displaystyle V_{\emptyset}+N\sum_{m=1}^{M}\left(\sum^{T_{m}+\Delta_{m}}_{t=T_{m}+1}\left(\sum^{m-1}_{i=1}F(\mu)^{NT_{i}}y_{\Delta_{i}+1}-F(\mu)^{NT_{m}}x_{t-T_{m}}\right)+\sum^{T_{m+1}}_{t=T_{m}+\Delta_{m}+1}\sum^{m}_{i=1}F(\mu)^{NT_{i}}y_{\Delta_{i}+1}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi mathvariant="normal">∅</mi></msub><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub></mrow></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>m</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>T</mi><mi>m</mi></msub></mrow></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><msub><mi>T</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{\emptyset}+N\sum_{m=1}^{M}\left(\sum^{T_{m}+\Delta_{m}}_{t=T_{m}+1}\left(\sum^{m-1}_{i=1}F(\mu)^{NT_{i}}y_{\Delta_{i}+1}-F(\mu)^{NT_{m}}x_{t-T_{m}}\right)+\sum^{T_{m+1}}_{t=T_{m}+\Delta_{m}+1}\sum^{m}_{i=1}F(\mu)^{NT_{i}}y_{\Delta_{i}+1}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex70.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex70.m2" class="ltx_Math" alttext="\displaystyle V_{\emptyset}+N\sum_{m=1}^{M}(T-T_{m}-\Delta_{m})F(\mu)^{NT_{m}}y_{\Delta_{m}+1}-N\sum_{m=1}^{M}\sum^{T_{m}+\Delta_{m}}_{t=T_{m}+1}F(\mu)^{NT_{m}}x_{t-T_{m}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>V</mi><mi mathvariant="normal">∅</mi></msub><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mi>m</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>m</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>m</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>T</mi><mi>m</mi></msub></mrow></msub></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{\emptyset}+N\sum_{m=1}^{M}(T-T_{m}-\Delta_{m})F(\mu)^{NT_{m}}y_{\Delta_{m}+1}-N\sum_{m=1}^{M}\sum^{T_{m}+\Delta_{m}}_{t=T_{m}+1}F(\mu)^{NT_{m}}x_{t-T_{m}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(46)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E46.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E46.m2" class="ltx_Math" alttext="\displaystyle V_{\emptyset}+N\sum_{m=1}^{M}F(\mu)^{NT_{m}}\left(T-T_{m}-\Delta_{m})y_{\Delta_{m}+1}-\sum^{\Delta_{m}}_{i=1}x_{i}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><msub><mi>V</mi><mi mathvariant="normal">∅</mi></msub><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>m</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mi>m</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub></munderover></mstyle><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle V_{\emptyset}+N\sum_{m=1}^{M}F(\mu)^{NT_{m}}\left(T-T_{m}-\Delta_{m})y_{\Delta_{m}+1}-\sum^{\Delta_{m}}_{i=1}x_{i}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p10.4" class="ltx_p">which completes the proof of (<a href="#S3.E12" title="In Lemma 3.3. ‣ 3.2. Decentralized Communication Mechanism ‣ 3. Decentralized Communication Mechanism for Myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>).</p>
</div>
<div id="A3.p11" class="ltx_para">
<p id="A3.p11.1" class="ltx_p">Let <math id="A3.p11.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, in <math id="A3.p11.m2" class="ltx_Math" alttext="\{1,\ldots,T+1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,\ldots,T+1\}</annotation></semantics></math>, denote the random variable representing exploration time by the myopic agents under communication restriction mechanism <math id="A3.p11.m3" class="ltx_math_unparsed" alttext="\mathcal{M}=\cup_{m=1}^{M}\{T_{m},\ldots,T_{m}+\Delta_{m}-1\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo rspace="0em">=</mo><msubsup><mo lspace="0em">∪</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></msubsup><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>m</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>−</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}=\cup_{m=1}^{M}\{T_{m},\ldots,T_{m}+\Delta_{m}-1\}</annotation></semantics></math> in the total process. Then the expectation of <math id="A3.p11.m4" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is</p>
<table id="A3.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex71.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\tau]=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>τ</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\tau]=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex71.m2" class="ltx_Math" alttext="\displaystyle\sum^{T}_{t=1}t\mathbb{P}(\tau=t)=\sum^{T}_{t=1}\mathbb{P}(\tau\geq t)=\sum^{T_{1}+1}_{t=1}\mathbb{P}(\tau\geq t)+\sum^{M}_{m=1}\sum^{T_{m}+\Delta_{m}+1}_{t=T_{m}+2}\mathbb{P}(\tau\geq t)+\sum^{M}_{m=1}\sum_{t=T_{m}+\Delta_{m}+2}^{T_{m+1}+1}\mathbb{P}(\tau\geq t)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>≥</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>≥</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><mn>2</mn></mrow></mrow><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>≥</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>2</mn></mrow></mrow><mrow><msub><mi>T</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>≥</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{T}_{t=1}t\mathbb{P}(\tau=t)=\sum^{T}_{t=1}\mathbb{P}(\tau\geq t)=\sum^{T_{1}+1}_{t=1}\mathbb{P}(\tau\geq t)+\sum^{M}_{m=1}\sum^{T_{m}+\Delta_{m}+1}_{t=T_{m}+2}\mathbb{P}(\tau\geq t)+\sum^{M}_{m=1}\sum_{t=T_{m}+\Delta_{m}+2}^{T_{m+1}+1}\mathbb{P}(\tau\geq t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex72.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72.m2" class="ltx_Math" alttext="\displaystyle\sum^{T_{1}+1}_{t=1}F(\mu)^{N(t-1)}+\sum^{M}_{m=1}\sum^{T_{m}+\Delta_{m}+1}_{t=T_{m}+2}F(\mu)^{NT_{m}+t-T_{m}-1}+\sum^{M}_{m=1}\sum_{t=T_{m}+\Delta_{m}+2}^{T_{m+1}+1}F(\mu)^{N(t-1)}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><mn>2</mn></mrow></mrow><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>m</mi></msub></mrow><mo>+</mo><mi>t</mi></mrow><mo>−</mo><msub><mi>T</mi><mi>m</mi></msub><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>2</mn></mrow></mrow><mrow><msub><mi>T</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{T_{1}+1}_{t=1}F(\mu)^{N(t-1)}+\sum^{M}_{m=1}\sum^{T_{m}+\Delta_{m}+1}_{t=T_{m}+2}F(\mu)^{NT_{m}+t-T_{m}-1}+\sum^{M}_{m=1}\sum_{t=T_{m}+\Delta_{m}+2}^{T_{m+1}+1}F(\mu)^{N(t-1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex73.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex73.m2" class="ltx_Math" alttext="\displaystyle\sum^{T_{1}}_{t=0}F(\mu)^{Nt}+\sum^{M}_{m=1}\left(\sum^{\Delta_{m}}_{t=1}F(\mu)^{NT_{m}+t}+\sum_{t=T_{m}+\Delta_{m}+1}^{T_{m+1}}F(\mu)^{Nt}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>m</mi></msub></mrow><mo>+</mo><mi>t</mi></mrow></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><msub><mi>T</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{T_{1}}_{t=0}F(\mu)^{Nt}+\sum^{M}_{m=1}\left(\sum^{\Delta_{m}}_{t=1}F(\mu)^{NT_{m}+t}+\sum_{t=T_{m}+\Delta_{m}+1}^{T_{m+1}}F(\mu)^{Nt}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p11.2" class="ltx_p">which completes the proof of (<a href="#S3.E13" title="In Lemma 3.3. ‣ 3.2. Decentralized Communication Mechanism ‣ 3. Decentralized Communication Mechanism for Myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>).</p>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Proof of Theorem <a href="#S3.Thmtheorem5" title="Theorem 3.5. ‣ 3.2. Decentralized Communication Mechanism ‣ 3. Decentralized Communication Mechanism for Myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a></h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">Denote <math id="A4.p1.m1" class="ltx_Math" alttext="\tilde{\mathcal{M}}^{*}_{1}=\{0,\ldots,\tilde{\Delta}^{*}_{1}-1\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mathcal{M}}^{*}_{1}=\{0,\ldots,\tilde{\Delta}^{*}_{1}-1\}</annotation></semantics></math> as the solution returned by Algorithm <a href="#alg1" title="Algorithm 1 ‣ 3.2. Decentralized Communication Mechanism ‣ 3. Decentralized Communication Mechanism for Myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, and <math id="A4.p1.m2" class="ltx_math_unparsed" alttext="\mathcal{M}^{*}=\{0,\ldots,\Delta_{1}^{*}-1\}\cup_{m=1}^{M-1}\{\sum^{m}_{i=1}(\Delta_{i}^{*}+1),\ldots,\sum^{m}_{i=1}(\Delta_{i}^{*}+1)+\Delta^{*}_{m+1}-1\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>∗</mo></msubsup><mo>−</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><msubsup><mo>∪</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo stretchy="false">{</mo><msubsup><mo lspace="0em" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mi>i</mi><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo rspace="0em">,</mo><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mrow><mo stretchy="false">(</mo><msubsup><mi mathvariant="normal">Δ</mi><mi>i</mi><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>+</mo><msubsup><mi mathvariant="normal">Δ</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo>∗</mo></msubsup><mo>−</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}^{*}=\{0,\ldots,\Delta_{1}^{*}-1\}\cup_{m=1}^{M-1}\{\sum^{m}_{i=1}(\Delta_{i}^{*}+1),\ldots,\sum^{m}_{i=1}(\Delta_{i}^{*}+1)+\Delta^{*}_{m+1}-1\}</annotation></semantics></math> as the optimal solution of problem (<a href="#S3.E14" title="In 3.2. Decentralized Communication Mechanism ‣ 3. Decentralized Communication Mechanism for Myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>). Recall that <math id="A4.p1.m3" class="ltx_Math" alttext="\tilde{\mathcal{M}}^{*}_{1}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\tilde{\mathcal{M}}^{*}_{1}</annotation></semantics></math> is the best single communication restriction window mechanism, which provide us the following inequality</p>
<table id="A4.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(47)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E47.m1" class="ltx_Math" alttext="\displaystyle\left((T-\sum_{i=1}^{m}\Delta_{i}^{*}-m+1)y_{\Delta_{m}^{*}+1}-\sum_{i=1}^{\Delta_{m}^{*}}x_{i}\right)\leq(T-\tilde{\Delta}^{*}_{1})y_{\tilde{\Delta}^{*}_{1}+1}-\sum_{i=1}^{\tilde{\Delta}^{*}_{1}}x_{i},\forall m\in\{1,\ldots,M\}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msubsup><mi mathvariant="normal">Δ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><mo>−</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>m</mi><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>m</mi><mo>∗</mo></msubsup></munderover></mstyle><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></munderover></mstyle><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>m</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left((T-\sum_{i=1}^{m}\Delta_{i}^{*}-m+1)y_{\Delta_{m}^{*}+1}-\sum_{i=1}^{\Delta_{m}^{*}}x_{i}\right)\leq(T-\tilde{\Delta}^{*}_{1})y_{\tilde{\Delta}^{*}_{1}+1}-\sum_{i=1}^{\tilde{\Delta}^{*}_{1}}x_{i},\forall m\in\{1,\ldots,M\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.2" class="ltx_p">which is derived from</p>
<table id="A4.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex74.m1" class="ltx_Math" alttext="\displaystyle(T-\sum_{i=1}^{m}\Delta_{i}^{*}-m+1)y_{\Delta_{m}^{*}+1}-\sum_{i=1}^{\Delta_{m}^{*}}x_{i}&lt;(T-\Delta_{m}^{*})y_{\Delta_{m}^{*}+1}-\sum_{i=1}^{\Delta_{m}^{*}}x_{i}&lt;\left((T-\tilde{\Delta}^{*}_{1})y_{\tilde{\Delta}^{*}_{1}+1}-\sum_{i=1}^{\tilde{\Delta}^{*}_{1}}x_{i}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msubsup><mi mathvariant="normal">Δ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><mo>−</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>m</mi><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>m</mi><mo>∗</mo></msubsup></munderover></mstyle><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>&lt;</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msubsup><mi mathvariant="normal">Δ</mi><mi>m</mi><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>m</mi><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>m</mi><mo>∗</mo></msubsup></munderover></mstyle><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>&lt;</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></munderover></mstyle><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(T-\sum_{i=1}^{m}\Delta_{i}^{*}-m+1)y_{\Delta_{m}^{*}+1}-\sum_{i=1}^{\Delta_{m}^{*}}x_{i}&lt;(T-\Delta_{m}^{*})y_{\Delta_{m}^{*}+1}-\sum_{i=1}^{\Delta_{m}^{*}}x_{i}&lt;\left((T-\tilde{\Delta}^{*}_{1})y_{\tilde{\Delta}^{*}_{1}+1}-\sum_{i=1}^{\tilde{\Delta}^{*}_{1}}x_{i}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.3" class="ltx_p">Then we have</p>
<table id="A4.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex75.m1" class="ltx_Math" alttext="\displaystyle\frac{V_{\mathcal{M}^{*}}}{V_{\tilde{\mathcal{M}}^{*}_{1}}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><msub><mi>V</mi><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup></msub><msub><mi>V</mi><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></msub></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{V_{\mathcal{M}^{*}}}{V_{\tilde{\mathcal{M}}^{*}_{1}}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex75.m2" class="ltx_Math" alttext="\displaystyle=\frac{\left((T-\Delta_{1}^{*})y_{\Delta_{1}^{*}+1}-\sum_{i=1}^{\Delta_{1}^{*}}x_{i}\right)+\sum^{M}_{m=2}F(\mu)^{N\sum_{i=1}^{m-1}(\Delta_{i}^{*}+1)}\left((T-\sum_{i=1}^{m}\Delta_{i}^{*}-m+1)y_{\Delta_{m}^{*}+1}-\sum_{i=1}^{\Delta_{m}^{*}}x_{i}\right)}{\left((T-\tilde{\Delta}^{*}_{1})y_{\tilde{\Delta}^{*}_{1}+1}-\sum_{i=1}^{\tilde{\Delta}^{*}_{1}}x_{i}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi mathvariant="normal">Δ</mi><mn>1</mn><mo>∗</mo></msubsup></msubsup><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>2</mn></mrow><mi>M</mi></msubsup><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>i</mi><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msubsup><mi mathvariant="normal">Δ</mi><mi>i</mi><mo>∗</mo></msubsup></mrow><mo>−</mo><mi>m</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>m</mi><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>m</mi><mo>∗</mo></msubsup></msubsup><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></msubsup><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\left((T-\Delta_{1}^{*})y_{\Delta_{1}^{*}+1}-\sum_{i=1}^{\Delta_{1}^{*}}x_{i}\right)+\sum^{M}_{m=2}F(\mu)^{N\sum_{i=1}^{m-1}(\Delta_{i}^{*}+1)}\left((T-\sum_{i=1}^{m}\Delta_{i}^{*}-m+1)y_{\Delta_{m}^{*}+1}-\sum_{i=1}^{\Delta_{m}^{*}}x_{i}\right)}{\left((T-\tilde{\Delta}^{*}_{1})y_{\tilde{\Delta}^{*}_{1}+1}-\sum_{i=1}^{\tilde{\Delta}^{*}_{1}}x_{i}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex76.m1" class="ltx_Math" alttext="\displaystyle&lt;\frac{(1+\sum^{M}_{m=2}F(\mu)^{N\sum_{i=1}^{k-1}(\Delta_{i}^{*}+1)})\left((T-\tilde{\Delta}^{*}_{1})y_{\tilde{\Delta}^{*}_{1}+1}-\sum_{i=1}^{\tilde{\Delta}^{*}_{1}}x_{i}\right)}{\left((T-\tilde{\Delta}^{*}_{1})y_{\tilde{\Delta}_{1}+1}-\sum_{i=1}^{\tilde{\Delta}^{*}_{1}}x_{i}\right)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>2</mn></mrow><mi>M</mi></msubsup><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>i</mi><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></msubsup><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mo>(</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msubsup><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></msubsup><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>)</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\frac{(1+\sum^{M}_{m=2}F(\mu)^{N\sum_{i=1}^{k-1}(\Delta_{i}^{*}+1)})\left((T-\tilde{\Delta}^{*}_{1})y_{\tilde{\Delta}^{*}_{1}+1}-\sum_{i=1}^{\tilde{\Delta}^{*}_{1}}x_{i}\right)}{\left((T-\tilde{\Delta}^{*}_{1})y_{\tilde{\Delta}_{1}+1}-\sum_{i=1}^{\tilde{\Delta}^{*}_{1}}x_{i}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex77.m1" class="ltx_Math" alttext="\displaystyle=1+\sum^{M}_{m=2}F(\mu)^{N\sum_{i=1}^{m-1}(\Delta_{i}^{*}+1)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>2</mn></mrow><mi>M</mi></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mstyle><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>i</mi><mo>∗</mo></msubsup><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=1+\sum^{M}_{m=2}F(\mu)^{N\sum_{i=1}^{m-1}(\Delta_{i}^{*}+1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex78.m1" class="ltx_Math" alttext="\displaystyle\leq 1+\sum^{T/2}_{m=2}F(\mu)^{2N(m-1)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>2</mn></mrow><mrow><mi>T</mi><mo>/</mo><mn>2</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 1+\sum^{T/2}_{m=2}F(\mu)^{2N(m-1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex79.m1" class="ltx_Math" alttext="\displaystyle=\frac{1-F(\mu)^{TN}}{1-F(\mu)^{2N}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1-F(\mu)^{TN}}{1-F(\mu)^{2N}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.4" class="ltx_p">where the first inequality comes from (<a href="#A4.E47" title="In Appendix D Proof of Theorem ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">47</span></a>), the second inequality comes from <math id="A4.p1.m4" class="ltx_Math" alttext="\Delta^{*}_{i}\geq 1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>i</mi><mo>∗</mo></msubsup><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\Delta^{*}_{i}\geq 1</annotation></semantics></math> and the upper bound of <math id="A4.p1.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> in problem (<a href="#S3.E15" title="In 3.2. Decentralized Communication Mechanism ‣ 3. Decentralized Communication Mechanism for Myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>). Then</p>
<table id="A4.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex80.m1" class="ltx_Math" alttext="\displaystyle V_{\mathcal{M}^{*}}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup></msub><annotation encoding="application/x-tex">\displaystyle V_{\mathcal{M}^{*}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex80.m2" class="ltx_Math" alttext="\displaystyle&lt;\frac{1-F(\mu)^{TN}}{1-F(\mu)^{2N}}V_{\tilde{\mathcal{M}}^{*}_{1}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&lt;</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&lt;\frac{1-F(\mu)^{TN}}{1-F(\mu)^{2N}}V_{\tilde{\mathcal{M}}^{*}_{1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex81.m1" class="ltx_Math" alttext="\displaystyle V_{\mathcal{M}^{*}}\left(1-\frac{F(\mu)^{2N}-F(\mu)^{TN}}{1-F(\mu)^{TN}}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{\mathcal{M}^{*}}\left(1-\frac{F(\mu)^{2N}-F(\mu)^{TN}}{1-F(\mu)^{TN}}\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex81.m2" class="ltx_Math" alttext="\displaystyle&lt;V_{\tilde{\mathcal{M}}^{*}_{1}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&lt;</mo><msub><mi>V</mi><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>~</mo></mover><mn>1</mn><mo>∗</mo></msubsup></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle&lt;V_{\tilde{\mathcal{M}}^{*}_{1}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.5" class="ltx_p">where <math id="A4.p1.m6" class="ltx_Math" alttext="\left(1-\frac{F(\mu)^{2N}-F(\mu)^{TN}}{1-F(\mu)^{TN}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msup></mrow></mrow></mfrac></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(1-\frac{F(\mu)^{2N}-F(\mu)^{TN}}{1-F(\mu)^{TN}}\right)</annotation></semantics></math> is the approximate ratio. As <math id="A4.p1.m7" class="ltx_Math" alttext="N\rightarrow\infty" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">N\rightarrow\infty</annotation></semantics></math>, if <math id="A4.p1.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is also large enough to satisfy condition (<a href="#S3.E11" title="In Proposition 3.2. ‣ 3.1. Analysis of Existing Centralized Communication Policy ‣ 3. Decentralized Communication Mechanism for Myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>), the approximate ratio will tend to 1.</p>
</div>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Proof for Lemma <a href="#S4.Thmtheorem2" title="Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a></h2>

<div id="A5.p1" class="ltx_para">
<p id="A5.p1.1" class="ltx_p">We begin by establishing the monotonicity of <math id="A5.p1.m1" class="ltx_Math" alttext="\{u_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{u_{t}\}_{t=1}^{T}</annotation></semantics></math> as stated in (<a href="#S4.E16" title="In Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>). With this monotonicity in hand, we then verify the equations in (<a href="#S4.E16" title="In Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>). Next, we derive the expression for <math id="A5.p1.m2" class="ltx_Math" alttext="P(r)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(r)</annotation></semantics></math> in (<a href="#S4.EGx16" title="Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>), and finally, we establish the expected number of time slots for exploration as given in (<a href="#S4.E21" title="In Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>).</p>
</div>
<div id="A5.p2" class="ltx_para">
<p id="A5.p2.1" class="ltx_p">First, note that <math id="A5.p2.m1" class="ltx_Math" alttext="u_{T}=\mu" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>T</mi></msub><mo>=</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">u_{T}=\mu</annotation></semantics></math> and <math id="A5.p2.m2" class="ltx_Math" alttext="u_{t}\geq\mu" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>≥</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">u_{t}\geq\mu</annotation></semantics></math> for every <math id="A5.p2.m3" class="ltx_Math" alttext="t\in[T]" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[T]</annotation></semantics></math>. We then show that any threshold sequence <math id="A5.p2.m4" class="ltx_Math" alttext="\{u_{t}\}_{t=1}^{T-1}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><annotation encoding="application/x-tex">\{u_{t}\}_{t=1}^{T-1}</annotation></semantics></math> containing two elements <math id="A5.p2.m5" class="ltx_Math" alttext="u_{i}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>i</mi></msub><annotation encoding="application/x-tex">u_{i}</annotation></semantics></math> and <math id="A5.p2.m6" class="ltx_Math" alttext="u_{j}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>j</mi></msub><annotation encoding="application/x-tex">u_{j}</annotation></semantics></math> with <math id="A5.p2.m7" class="ltx_Math" alttext="i&lt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&lt;j</annotation></semantics></math> and <math id="A5.p2.m8" class="ltx_Math" alttext="u_{i}&lt;u_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>&lt;</mo><msub><mi>u</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">u_{i}&lt;u_{j}</annotation></semantics></math> can be improved upon by an alternative strategy that yields a strictly higher expected reward.</p>
</div>
<div id="A5.p3" class="ltx_para">
<p id="A5.p3.1" class="ltx_p">The existence of <math id="A5.p3.m1" class="ltx_Math" alttext="u_{i},u_{j}\in\{u_{t}\}_{t=1}^{T-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>∈</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">u_{i},u_{j}\in\{u_{t}\}_{t=1}^{T-1}</annotation></semantics></math> with <math id="A5.p3.m2" class="ltx_Math" alttext="i&lt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&lt;j</annotation></semantics></math> and <math id="A5.p3.m3" class="ltx_Math" alttext="u_{i}&lt;u_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>&lt;</mo><msub><mi>u</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">u_{i}&lt;u_{j}</annotation></semantics></math> implies that there is at least one time instance <math id="A5.p3.m4" class="ltx_Math" alttext="t\in\{1,\ldots,T-1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{1,\ldots,T-1\}</annotation></semantics></math> where <math id="A5.p3.m5" class="ltx_Math" alttext="u_{t}&lt;u_{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">u_{t}&lt;u_{t+1}</annotation></semantics></math>. Suppose that at time <math id="A5.p3.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, the agent <math id="A5.p3.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>’s maximum reward is <math id="A5.p3.m8" class="ltx_Math" alttext="m_{n}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(t)</annotation></semantics></math> satisfying <math id="A5.p3.m9" class="ltx_Math" alttext="u_{t}&lt;m_{n}(t)&lt;u_{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>&lt;</mo><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">u_{t}&lt;m_{n}(t)&lt;u_{t+1}</annotation></semantics></math>. According to the threshold strategy, the agent exploits at time <math id="A5.p3.m10" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and explores at time <math id="A5.p3.m11" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math>, yielding a combined expected reward of <math id="A5.p3.m12" class="ltx_Math" alttext="m_{n}(t)+\mu" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">m_{n}(t)+\mu</annotation></semantics></math> over these two time slots. Under these actions, the expected maximum reward <math id="A5.p3.m13" class="ltx_Math" alttext="m_{n}(t+2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(t+2)</annotation></semantics></math> after time <math id="A5.p3.m14" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math> is given by:</p>
<table id="A5.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(48)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E48.m1" class="ltx_Math" alttext="\displaystyle m_{n}(t+2)=\int^{1}_{m_{n}(t)}r\,dF(r)+F(m_{n}(t))\,m_{n}(t)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle m_{n}(t+2)=\int^{1}_{m_{n}(t)}r\,dF(r)+F(m_{n}(t))\,m_{n}(t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p3.2" class="ltx_p">Alternatively, if the agent explores at time <math id="A5.p3.m15" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and exploits at time <math id="A5.p3.m16" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math>, the expected reward from <math id="A5.p3.m17" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> to <math id="A5.p3.m18" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math> becomes:</p>
<table id="A5.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex82.m1" class="ltx_Math" alttext="\mu+\int^{1}_{m_{n}(t)}r\,dF(r)+F(m_{n}(t))\,m_{n}(t)," display="block" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo rspace="0.055em">+</mo><mrow><msubsup><mo>∫</mo><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mn>1</mn></msubsup><mrow><mi>r</mi><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mu+\int^{1}_{m_{n}(t)}r\,dF(r)+F(m_{n}(t))\,m_{n}(t),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p3.3" class="ltx_p">which is strictly greater than <math id="A5.p3.m19" class="ltx_Math" alttext="m_{n}(t)+\mu" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">m_{n}(t)+\mu</annotation></semantics></math> under the original threshold strategy, because it leverages the possibility of obtaining a higher reward at <math id="A5.p3.m20" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Moreover, the resulting <math id="A5.p3.m21" class="ltx_Math" alttext="m_{n}(t+2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(t+2)</annotation></semantics></math> remains as in (<a href="#A5.E48" title="In Appendix E Proof for Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a>), meaning that the expected reward after time <math id="A5.p3.m22" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math> is unaffected by the switch. Therefore, a threshold strategy that includes <math id="A5.p3.m23" class="ltx_Math" alttext="u_{i},u_{j}\in\{u_{t}\}_{t=1}^{T-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>u</mi><mi>j</mi></msub><mo>∈</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">u_{i},u_{j}\in\{u_{t}\}_{t=1}^{T-1}</annotation></semantics></math> with <math id="A5.p3.m24" class="ltx_Math" alttext="i&lt;j" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">i&lt;j</annotation></semantics></math> and <math id="A5.p3.m25" class="ltx_Math" alttext="u_{i}&lt;u_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>&lt;</mo><msub><mi>u</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">u_{i}&lt;u_{j}</annotation></semantics></math> cannot be optimal. Since <math id="A5.p3.m26" class="ltx_Math" alttext="\{u_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{u_{t}\}_{t=1}^{T}</annotation></semantics></math> is the optimal solution for problem (<a href="#S2.E2" title="In 2.2. Problem formulation as MA-MDP ‣ 2. System Model and Problem Formulation ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) under the full communication policy, this completes the proof of the monotonicity of <math id="A5.p3.m27" class="ltx_Math" alttext="\{u_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{u_{t}\}_{t=1}^{T}</annotation></semantics></math>.</p>
</div>
<div id="A5.p4" class="ltx_para">
<p id="A5.p4.1" class="ltx_p">Next, we prove the equation of <math id="A5.p4.m1" class="ltx_Math" alttext="\{u_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{u_{t}\}_{t=1}^{T}</annotation></semantics></math> in (<a href="#S4.E16" title="In Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>). At each time <math id="A5.p4.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, <math id="A5.p4.m3" class="ltx_Math" alttext="u_{t}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>t</mi></msub><annotation encoding="application/x-tex">u_{t}</annotation></semantics></math> represents the state <math id="A5.p4.m4" class="ltx_Math" alttext="m_{n}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(t)</annotation></semantics></math> at which agent <math id="A5.p4.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is indifferent between exploring and exploiting. Note that <math id="A5.p4.m6" class="ltx_Math" alttext="u_{t}&gt;u_{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>&gt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">u_{t}&gt;u_{t+1}</annotation></semantics></math> implies that if <math id="A5.p4.m7" class="ltx_Math" alttext="m_{n}(t)=u_{t}&gt;u_{t+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>u</mi><mi>t</mi></msub><mo>&gt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">m_{n}(t)=u_{t}&gt;u_{t+1}</annotation></semantics></math>, then agent <math id="A5.p4.m8" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> will cease to explore from time <math id="A5.p4.m9" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math> onward. Let <math id="A5.p4.m10" class="ltx_Math" alttext="R_{t}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>t</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">R_{t}^{n}</annotation></semantics></math> denote the reward for agent <math id="A5.p4.m11" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, which is a random variable with distribution <math id="A5.p4.m12" class="ltx_Math" alttext="F(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\cdot)</annotation></semantics></math>, if agent <math id="A5.p4.m13" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> chooses to explore at time <math id="A5.p4.m14" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Under this scenario, the long-term reward for agent <math id="A5.p4.m15" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> starting from time <math id="A5.p4.m16" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> when opting to explore is given by:</p>
<table id="A5.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex83.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\Biggl[\sum^{T}_{\tau=t}r_{a_{n}(\tau)}\,\Big|\,a_{n}(t)\in\mathcal{K}\setminus I_{n}(t),\,m_{n}(t)=u_{t}\Biggr]=\mu+\max\{R^{n}_{t},m_{n}(t)\}(T-t)+\max\{R^{n}_{t},m_{n}(t),\max_{i\neq n}m_{i}(T-1)\}." display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><mi>T</mi></munderover></mstyle><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.337em" stretchy="true">|</mo><msub><mi>a</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∖</mo><msub><mi>I</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.337em">,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>u</mi><mi>t</mi></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><mo>=</mo><mi>μ</mi><mo>+</mo><mi>max</mi><mrow><mo stretchy="false">{</mo><msubsup><mi>R</mi><mi>t</mi><mi>n</mi></msubsup><mo>,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>max</mi><mrow><mo stretchy="false">{</mo><msubsup><mi>R</mi><mi>t</mi><mi>n</mi></msubsup><mo>,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><munder><mi>max</mi><mrow><mi>i</mi><mo>≠</mo><mi>n</mi></mrow></munder><msub><mi>m</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\Biggl[\sum^{T}_{\tau=t}r_{a_{n}(\tau)}\,\Big|\,a_{n}(t)\in\mathcal{K}\setminus I_{n}(t),\,m_{n}(t)=u_{t}\Biggr]=\mu+\max\{R^{n}_{t},m_{n}(t)\}(T-t)+\max\{R^{n}_{t},m_{n}(t),\max_{i\neq n}m_{i}(T-1)\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p4.2" class="ltx_p">Recalling that <math id="A5.p4.m17" class="ltx_Math" alttext="P(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\cdot)</annotation></semantics></math> denotes the distribution of <math id="A5.p4.m18" class="ltx_Math" alttext="m_{i}(T-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{i}(T-1)</annotation></semantics></math>, we can express this expectation as:</p>
<table id="A5.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex84.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\Biggl[\sum^{T}_{\tau=t}r_{a_{n}(\tau)}\,\Big|\,a_{n}(t)\in\mathcal{K}\setminus I_{n}(t),\,m_{n}(t)=u_{t}\Biggr]=" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><mi>T</mi></munderover></mstyle><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.337em" stretchy="true">|</mo><msub><mi>a</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∖</mo><msub><mi>I</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.337em">,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>u</mi><mi>t</mi></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><mo>=</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\Biggl[\sum^{T}_{\tau=t}r_{a_{n}(\tau)}\,\Big|\,a_{n}(t)\in\mathcal{K}\setminus I_{n}(t),\,m_{n}(t)=u_{t}\Biggr]=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex84.m2" class="ltx_Math" alttext="\displaystyle\mu+\left(\int^{1}_{u_{t}}r\,dF(r)+u_{t}F(u_{t})\right)(T-t-1)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu+\left(\int^{1}_{u_{t}}r\,dF(r)+u_{t}F(u_{t})\right)(T-t-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex85.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad+\int^{1}_{u_{t}}r\,dF(r)P(r)^{N-1}+u_{t}F(u_{t})P(u_{t})^{N-1}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mi>r</mi><mi>d</mi><mi>F</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo><msub><mi>u</mi><mi>t</mi></msub><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\quad+\int^{1}_{u_{t}}r\,dF(r)P(r)^{N-1}+u_{t}F(u_{t})P(u_{t})^{N-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(49)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E49.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E49.m2" class="ltx_Math" alttext="\displaystyle\mu+\left(1-\int^{1}_{u_{t}}F(r)\,dr\right)(T-t-1)+1-\int^{1}_{u_{t}}F(r)P(r)^{N-1}\,dr," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>μ</mi><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mu+\left(1-\int^{1}_{u_{t}}F(r)\,dr\right)(T-t-1)+1-\int^{1}_{u_{t}}F(r)P(r)^{N-1}\,dr,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p4.3" class="ltx_p">Similarly, if agent <math id="A5.p4.m19" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> opts for exploitation at time <math id="A5.p4.m20" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, her long-term reward is:</p>
<table id="A5.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex86.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\Biggl[\sum^{T}_{\tau=t}r_{a_{n}(\tau)}\,\Big|\,a_{n}(t)=\bar{a}_{n}(t),\,m_{n}(t)=u_{t}\Biggr]=" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><mi>T</mi></munderover></mstyle><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.337em" stretchy="true">|</mo><msub><mi>a</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mover accent="true"><mi>a</mi><mo>¯</mo></mover><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.337em">,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>u</mi><mi>t</mi></msub><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><mo>=</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\Biggl[\sum^{T}_{\tau=t}r_{a_{n}(\tau)}\,\Big|\,a_{n}(t)=\bar{a}_{n}(t),\,m_{n}(t)=u_{t}\Biggr]=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex86.m2" class="ltx_Math" alttext="\displaystyle\,m_{n}(t)(T-t)+\max\{m_{n}(t),\max_{i\neq n}m_{i}(T-1)\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>i</mi><mo>≠</mo><mi>n</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>m</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,m_{n}(t)(T-t)+\max\{m_{n}(t),\max_{i\neq n}m_{i}(T-1)\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex87.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex87.m2" class="ltx_Math" alttext="\displaystyle\,u_{t}(T-t)+\int^{1}_{u_{t}}r\,dP(r)^{N-1}+u_{t}P(u_{t})^{N-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>P</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,u_{t}(T-t)+\int^{1}_{u_{t}}r\,dP(r)^{N-1}+u_{t}P(u_{t})^{N-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(50)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E50.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E50.m2" class="ltx_Math" alttext="\displaystyle\,u_{t}(T-t)+1-\int^{1}_{u_{t}}P(r)^{N-1}\,dr." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\,u_{t}(T-t)+1-\int^{1}_{u_{t}}P(r)^{N-1}\,dr.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p4.4" class="ltx_p">The value <math id="A5.p4.m21" class="ltx_Math" alttext="u_{t}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>t</mi></msub><annotation encoding="application/x-tex">u_{t}</annotation></semantics></math> for <math id="A5.p4.m22" class="ltx_Math" alttext="t=1,\ldots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=1,\ldots,T-1</annotation></semantics></math> is then determined by equating the expressions in (<a href="#A5.E49" title="In Appendix E Proof for Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">49</span></a>) and (<a href="#A5.E50" title="In Appendix E Proof for Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">50</span></a>):</p>
<table id="A5.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex88.m1" class="ltx_Math" alttext="\displaystyle\mu+\left(1-\int^{1}_{u_{t}}F(r)\,dr\right)(T-t-1)+1-\int^{1}_{u_{t}}F(r)P(r)^{N-1}\,dr" display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu+\left(1-\int^{1}_{u_{t}}F(r)\,dr\right)(T-t-1)+1-\int^{1}_{u_{t}}F(r)P(r)^{N-1}\,dr</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex88.m2" class="ltx_Math" alttext="\displaystyle=u_{t}(T-t)+1-\int^{1}_{u_{t}}P(r)^{N-1}\,dr" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=u_{t}(T-t)+1-\int^{1}_{u_{t}}P(r)^{N-1}\,dr</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(51)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E51.m1" class="ltx_Math" alttext="\displaystyle\int^{1}_{u_{t}}P(r)^{N-1}\bigl(1-F(r)\bigr)dr+(T-t-1)\int^{1}_{u_{t}}\bigl(1-F(r)\bigr)dr" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>u</mi><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int^{1}_{u_{t}}P(r)^{N-1}\bigl(1-F(r)\bigr)dr+(T-t-1)\int^{1}_{u_{t}}\bigl(1-F(r)\bigr)dr</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E51.m2" class="ltx_math_unparsed" alttext="\displaystyle=u_{t}-\mu,\quad t=1,\ldots,T-1." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>u</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>μ</mi><mo rspace="1.167em">,</mo><mi>t</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi><mo>−</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=u_{t}-\mu,\quad t=1,\ldots,T-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p4.5" class="ltx_p">This completes the proof for the equation of <math id="A5.p4.m23" class="ltx_Math" alttext="\{u_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{u_{t}\}_{t=1}^{T}</annotation></semantics></math> in (<a href="#S4.E16" title="In Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>).</p>
</div>
<div id="A5.p5" class="ltx_para">
<p id="A5.p5.1" class="ltx_p">Next, we will prove the distribution <math id="A5.p5.m1" class="ltx_Math" alttext="P(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\cdot)</annotation></semantics></math> of the maximum reward <math id="A5.p5.m2" class="ltx_Math" alttext="m_{n}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(t)</annotation></semantics></math> for agent <math id="A5.p5.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> at time <math id="A5.p5.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, as outlined in (<a href="#S4.EGx16" title="Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>), when agent <math id="A5.p5.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> adheres to the threshold strategy <math id="A5.p5.m6" class="ltx_Math" alttext="\{u_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{u_{t}\}_{t=1}^{T}</annotation></semantics></math> described in (<a href="#S4.E16" title="In Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>). We modify the definition of <math id="A5.p5.m7" class="ltx_Math" alttext="E_{(t_{1},t_{2})}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><msub><mi>t</mi><mn>1</mn></msub><mo>,</mo><msub><mi>t</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">E_{(t_{1},t_{2})}</annotation></semantics></math> in Appendix <a href="#A1" title="Appendix A Proof of Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a> here for subsequent analysis. Let <math id="A5.p5.m8" class="ltx_Math" alttext="E_{t}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>t</mi></msub><annotation encoding="application/x-tex">E_{t}</annotation></semantics></math> denote the event where agent <math id="A5.p5.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>’s maximum reward <math id="A5.p5.m10" class="ltx_Math" alttext="m_{n}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(t)</annotation></semantics></math> exceeds the exploration threshold, <math id="A5.p5.m11" class="ltx_Math" alttext="m_{n}(t)&gt;u_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><msub><mi>u</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">m_{n}(t)&gt;u_{t}</annotation></semantics></math>, for the first time at time <math id="A5.p5.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Conversely, <math id="A5.p5.m13" class="ltx_Math" alttext="\bar{E}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\bar{E}_{t}</annotation></semantics></math> indicates that the agent does not meet the exploration cessation condition at any time <math id="A5.p5.m14" class="ltx_Math" alttext="\tau=1,\ldots,T_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\tau=1,\ldots,T_{1}</annotation></semantics></math>. Then, <math id="A5.p5.m15" class="ltx_Math" alttext="P(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\cdot)</annotation></semantics></math> with <math id="A5.p5.m16" class="ltx_Math" alttext="u_{1}\leq r&lt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">u_{1}\leq r&lt;1</annotation></semantics></math> is:</p>
<table id="A5.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex89.m1" class="ltx_Math" alttext="\displaystyle P(r|u_{1}\leq r&lt;1)=\mathbb{P}(m_{n}(T-1)&lt;r|u_{1}\leq r&lt;1)=1-\mathbb{P}(m_{n}(T-1)\geq r|u_{1}\leq r&lt;1)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>r</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>r</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle P(r|u_{1}\leq r&lt;1)=\mathbb{P}(m_{n}(T-1)&lt;r|u_{1}\leq r&lt;1)=1-\mathbb{P}(m_{n}(T-1)\geq r|u_{1}\leq r&lt;1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p5.2" class="ltx_p">We know that <math id="A5.p5.m17" class="ltx_Math" alttext="E_{1},\ldots,E_{T-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>E</mi><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">E_{1},\ldots,E_{T-1}</annotation></semantics></math> and <math id="A5.p5.m18" class="ltx_Math" alttext="\bar{E}_{T-1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\bar{E}_{T-1}</annotation></semantics></math> form the complete event space for the historical events before <math id="A5.p5.m19" class="ltx_Math" alttext="T-1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T-1</annotation></semantics></math>. Note that under the event <math id="A5.p5.m20" class="ltx_Math" alttext="E_{t}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>t</mi></msub><annotation encoding="application/x-tex">E_{t}</annotation></semantics></math> and for <math id="A5.p5.m21" class="ltx_Math" alttext="r&gt;u_{1}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&gt;</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">r&gt;u_{1}</annotation></semantics></math>, the event <math id="A5.p5.m22" class="ltx_Math" alttext="m_{n}(T-1)&gt;r" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">m_{n}(T-1)&gt;r</annotation></semantics></math> can only occur if <math id="A5.p5.m23" class="ltx_Math" alttext="R^{n}_{t-1}&gt;r" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>&gt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">R^{n}_{t-1}&gt;r</annotation></semantics></math>, and in fact, <math id="A5.p5.m24" class="ltx_Math" alttext="m_{n}(T-1)=R^{n}_{t-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msubsup><mi>R</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><annotation encoding="application/x-tex">m_{n}(T-1)=R^{n}_{t-1}</annotation></semantics></math>. Then</p>
<table id="A5.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex90.m1" class="ltx_Math" alttext="\displaystyle 1-\mathbb{P}(m_{n}(T-1)\geq r|u_{1}\leq r&lt;1)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>r</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-\mathbb{P}(m_{n}(T-1)\geq r|u_{1}\leq r&lt;1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex91.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex91.m2" class="ltx_math_unparsed" alttext="\displaystyle 1-\sum^{T-1}_{t=1}\mathbb{P}(E_{t})\mathbb{P}(m(T-1)\geq r|E_{t},u_{1}\leq r&lt;1)-\mathbb{P}(\bar{E}_{T-1})\mathbb{P}(m(T-1)\geq r|\bar{E}_{T-1},u_{1}\leq r&lt;1)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>r</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mn>1</mn></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>r</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>u</mi><mn>1</mn></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-\sum^{T-1}_{t=1}\mathbb{P}(E_{t})\mathbb{P}(m(T-1)\geq r|E_{t},u_{1}\leq r&lt;1)-\mathbb{P}(\bar{E}_{T-1})\mathbb{P}(m(T-1)\geq r|\bar{E}_{T-1},u_{1}\leq r&lt;1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex92.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex92.m2" class="ltx_Math" alttext="\displaystyle 1-(\mathbb{P}(R^{n}_{0}&gt;r)+\mathbb{P}(R^{n}_{0}&lt;u_{1},R^{n}_{1}&gt;r)+\mathbb{P}(R^{n}_{0},R^{n}_{1}&lt;u_{2},R^{n}_{1}&gt;r)+\ldots+\mathbb{P}(R^{n}_{0},\ldots,R^{n}_{T-2}&lt;u_{T-1},R^{n}_{T-1}&gt;r))=" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>R</mi><mn>0</mn><mi>n</mi></msubsup><mo>&gt;</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>R</mi><mn>0</mn><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>&lt;</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msubsup><mi>R</mi><mn>1</mn><mi>n</mi></msubsup></mrow><mo>&gt;</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mn>0</mn><mi>n</mi></msubsup><mo>,</mo><mrow><msubsup><mi>R</mi><mn>1</mn><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>&lt;</mo><mrow><msub><mi>u</mi><mn>2</mn></msub><mo>,</mo><msubsup><mi>R</mi><mn>1</mn><mi>n</mi></msubsup></mrow><mo>&gt;</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>R</mi><mn>0</mn><mi>n</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msubsup><mi>R</mi><mrow><mi>T</mi><mo>−</mo><mn>2</mn></mrow><mi>n</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>&lt;</mo><mrow><msub><mi>u</mi><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msubsup><mi>R</mi><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mrow><mo>&gt;</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle 1-(\mathbb{P}(R^{n}_{0}&gt;r)+\mathbb{P}(R^{n}_{0}&lt;u_{1},R^{n}_{1}&gt;r)+\mathbb{P}(R^{n}_{0},R^{n}_{1}&lt;u_{2},R^{n}_{1}&gt;r)+\ldots+\mathbb{P}(R^{n}_{0},\ldots,R^{n}_{T-2}&lt;u_{T-1},R^{n}_{T-1}&gt;r))=</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex93.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex93.m2" class="ltx_Math" alttext="\displaystyle 1-(1-F(r)+F(u_{1})(1-F(r))+F(u_{2})^{2}(1-F(r))+\ldots+F(u_{T-1})^{T-1}(1-F(r)))=" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle 1-(1-F(r)+F(u_{1})(1-F(r))+F(u_{2})^{2}(1-F(r))+\ldots+F(u_{T-1})^{T-1}(1-F(r)))=</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex94.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex94.m2" class="ltx_Math" alttext="\displaystyle F(r)-(1-F(r))\sum^{T-1}_{t=1}F(u_{t})^{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle F(r)-(1-F(r))\sum^{T-1}_{t=1}F(u_{t})^{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p5.3" class="ltx_p">Similarly, <math id="A5.p5.m25" class="ltx_Math" alttext="P(r)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(r)</annotation></semantics></math> for <math id="A5.p5.m26" class="ltx_Math" alttext="u_{t}\leq r&lt;u_{t-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">u_{t}\leq r&lt;u_{t-1}</annotation></semantics></math> is:</p>
<table id="A5.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex95.m1" class="ltx_Math" alttext="\displaystyle P(r|u_{t}\leq r&lt;u_{t-1})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle P(r|u_{t}\leq r&lt;u_{t-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex96.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex96.m2" class="ltx_Math" alttext="\displaystyle\mathbb{P}(m(T-1)&lt;r|u_{t}\leq r&lt;u_{t-1})=1-\mathbb{P}(m(T-1)\geq r|u_{t}\leq r&lt;u_{t-1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>r</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>r</mi></mrow><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(m(T-1)&lt;r|u_{t}\leq r&lt;u_{t-1})=1-\mathbb{P}(m(T-1)\geq r|u_{t}\leq r&lt;u_{t-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex97.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex97.m2" class="ltx_math_unparsed" alttext="\displaystyle 1-\sum^{T-1}_{\tau=1}\mathbb{P}(E_{\tau})\mathbb{P}(m(T-1)\geq r|E_{\tau},u_{t}\leq r&lt;u_{t-1})-\mathbb{P}(\bar{E}_{T-1})\mathbb{P}(m(T-1)\geq r|\bar{E}_{T},u_{t}\leq r&lt;u_{t-1})." display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>r</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mi>τ</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>r</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mi>T</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 1-\sum^{T-1}_{\tau=1}\mathbb{P}(E_{\tau})\mathbb{P}(m(T-1)\geq r|E_{\tau},u_{t}\leq r&lt;u_{t-1})-\mathbb{P}(\bar{E}_{T-1})\mathbb{P}(m(T-1)\geq r|\bar{E}_{T},u_{t}\leq r&lt;u_{t-1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p5.4" class="ltx_p">Note that, under the event <math id="A5.p5.m27" class="ltx_Math" alttext="E_{\tau}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">E_{\tau}</annotation></semantics></math> for <math id="A5.p5.m28" class="ltx_Math" alttext="\tau=1,\ldots,t-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\tau=1,\ldots,t-1</annotation></semantics></math> with <math id="A5.p5.m29" class="ltx_Math" alttext="u_{t}\leq r&lt;u_{t-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">u_{t}\leq r&lt;u_{t-1}</annotation></semantics></math>, the event <math id="A5.p5.m30" class="ltx_Math" alttext="m(T-1)\geq r" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">m(T-1)\geq r</annotation></semantics></math> happens with probability 1, since agent <math id="A5.p5.m31" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> must stop with a reward greater than <math id="A5.p5.m32" class="ltx_Math" alttext="u_{\tau}&gt;r" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>τ</mi></msub><mo>&gt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">u_{\tau}&gt;r</annotation></semantics></math>. Then</p>
<table id="A5.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex99.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex99.m2" class="ltx_math_unparsed" alttext="\displaystyle 1-\sum^{t-1}_{\tau=1}\mathbb{P}(E_{\tau})-\sum_{\tau=t}^{T-1}\mathbb{P}(m(T-1)\geq r|E_{t},u_{t}\leq r&lt;u_{t-1})-\mathbb{P}(\bar{E}_{T-1})\mathbb{P}(m(T-1)\geq r|\bar{E}_{T},u_{t}\leq r&lt;u_{t-1})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>r</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mi>t</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>r</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mi>T</mi></msub><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mo>≤</mo><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-\sum^{t-1}_{\tau=1}\mathbb{P}(E_{\tau})-\sum_{\tau=t}^{T-1}\mathbb{P}(m(T-1)\geq r|E_{t},u_{t}\leq r&lt;u_{t-1})-\mathbb{P}(\bar{E}_{T-1})\mathbb{P}(m(T-1)\geq r|\bar{E}_{T},u_{t}\leq r&lt;u_{t-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex100.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex100.m2" class="ltx_Math" alttext="\displaystyle 1-(1-F(u_{1})+F(u_{1})-F(u_{2})^{2}+\ldots+F(u_{t-2})^{t-2}-F(u_{t-1})^{t-1})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 1-(1-F(u_{1})+F(u_{1})-F(u_{2})^{2}+\ldots+F(u_{t-2})^{t-2}-F(u_{t-1})^{t-1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex101.m1" class="ltx_Math" alttext="\displaystyle-(F(u_{t-1})^{t-1}-F(r)^{t}+F(u_{t})^{t}(1-F(r))+F(u_{t+1})^{t+1}(1-F(r))+\ldots+F(u_{T-1})^{T-1}(1-F(r)))" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow></mrow><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-(F(u_{t-1})^{t-1}-F(r)^{t}+F(u_{t})^{t}(1-F(r))+F(u_{t+1})^{t+1}(1-F(r))+\ldots+F(u_{T-1})^{T-1}(1-F(r)))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex102.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex102.m2" class="ltx_Math" alttext="\displaystyle F(r)^{t}-(1-F(r))\sum^{T-1}_{i=t}F(u_{i})^{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mi>t</mi></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>i</mi></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle F(r)^{t}-(1-F(r))\sum^{T-1}_{i=t}F(u_{i})^{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p5.5" class="ltx_p">Finally, for <math id="A5.p5.m33" class="ltx_Math" alttext="P(r)=\mathbb{P}(m(T-1)&lt;r)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>r</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P(r)=\mathbb{P}(m(T-1)&lt;r)</annotation></semantics></math> when <math id="A5.p5.m34" class="ltx_Math" alttext="r&lt;u_{T-1}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">r&lt;u_{T-1}</annotation></semantics></math>, the event <math id="A5.p5.m35" class="ltx_Math" alttext="m(T-1)&lt;r" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">m(T-1)&lt;r</annotation></semantics></math> occurs only if all explored rewards from time 0 to <math id="A5.p5.m36" class="ltx_Math" alttext="T-1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T-1</annotation></semantics></math> are less than <math id="A5.p5.m37" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. Therefore, <math id="A5.p5.m38" class="ltx_Math" alttext="P(r)=F(r)^{T}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>T</mi></msup></mrow></mrow><annotation encoding="application/x-tex">P(r)=F(r)^{T}</annotation></semantics></math> for <math id="A5.p5.m39" class="ltx_Math" alttext="r&lt;u_{T-1}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><msub><mi>u</mi><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">r&lt;u_{T-1}</annotation></semantics></math>. Then we complete the proof for (<a href="#S4.EGx16" title="Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>).</p>
</div>
<div id="A5.p6" class="ltx_para">
<p id="A5.p6.1" class="ltx_p">Let <math id="A5.p6.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, in <math id="A5.p6.m2" class="ltx_Math" alttext="\{1,\ldots,T+1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,\ldots,T+1\}</annotation></semantics></math>, denote the random variable representing exploration time by non-myopic agents under full communication policy in the total process. Then expectation of <math id="A5.p6.m3" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is</p>
<table id="A5.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex103.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\tau]=\sum^{T+1}_{t=1}t\mathbb{P}(\tau=t)=\sum^{T+1}_{t=1}\mathbb{P}(\tau\geq t)=1+\sum^{T-1}_{t=1}F(u_{t})^{t}+P(u_{T})^{N}=1+\sum^{T-1}_{t=1}F(u_{t})^{t}+F(u_{T})^{NT}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>τ</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>+</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>≥</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow></mrow><mo>+</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mi>t</mi></msup></mrow></mrow><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>u</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\tau]=\sum^{T+1}_{t=1}t\mathbb{P}(\tau=t)=\sum^{T+1}_{t=1}\mathbb{P}(\tau\geq t)=1+\sum^{T-1}_{t=1}F(u_{t})^{t}+P(u_{T})^{N}=1+\sum^{T-1}_{t=1}F(u_{t})^{t}+F(u_{T})^{NT}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p6.2" class="ltx_p">which completes the proof of (<a href="#S4.E21" title="In Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>).</p>
</div>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Proof of Proposition <a href="#S4.Thmtheorem3" title="Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a></h2>

<div id="A6.p1" class="ltx_para">
<p id="A6.p1.1" class="ltx_p">First, monotonicity within the sequences <math id="A6.p1.m1" class="ltx_Math" alttext="\{u_{t}(T_{1})\}_{t=1}^{T_{1}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></msubsup><annotation encoding="application/x-tex">\{u_{t}(T_{1})\}_{t=1}^{T_{1}}</annotation></semantics></math> and <math id="A6.p1.m2" class="ltx_Math" alttext="\{u_{t}(T_{1})\}_{T_{1}+1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{u_{t}(T_{1})\}_{T_{1}+1}^{T}</annotation></semantics></math> can be established analogously by the procedure detailed in Appendix <a href="#A5" title="Appendix E Proof for Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>, since agents do not communicate prior to or after time <math id="A6.p1.m3" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math>. However, the relative ordering between <math id="A6.p1.m4" class="ltx_Math" alttext="u_{t}(T_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}(T_{1})</annotation></semantics></math> for <math id="A6.p1.m5" class="ltx_Math" alttext="t\leq T_{1}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≤</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">t\leq T_{1}</annotation></semantics></math> and for <math id="A6.p1.m6" class="ltx_Math" alttext="t&gt;T_{1}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">t&gt;T_{1}</annotation></semantics></math> cannot be demonstrated similarly, owing to the information exchange occurring precisely at time <math id="A6.p1.m7" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math>.</p>
</div>
<div id="A6.p2" class="ltx_para">
<p id="A6.p2.1" class="ltx_p">Next, we derive the equations for the threshold sequence <math id="A6.p2.m1" class="ltx_Math" alttext="\{u_{t}(T_{1})\}_{t=1}^{T_{1}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></msubsup><annotation encoding="application/x-tex">\{u_{t}(T_{1})\}_{t=1}^{T_{1}}</annotation></semantics></math> in (<a href="#S4.E22" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) and (<a href="#S4.E23" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>), and for the total social welfare <math id="A6.p2.m2" class="ltx_Math" alttext="V_{\mathcal{M}_{2}}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn></msub></msub><annotation encoding="application/x-tex">V_{\mathcal{M}_{2}}</annotation></semantics></math> in (<a href="#S4.E24" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>), under the communication restriction mechanism <math id="A6.p2.m3" class="ltx_Math" alttext="\mathcal{M}_{2}=[T]\setminus\{T_{1}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><mo stretchy="false">[</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{2}=[T]\setminus\{T_{1}\}</annotation></semantics></math>. The distribution <math id="A6.p2.m4" class="ltx_Math" alttext="P(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\cdot)</annotation></semantics></math> for the maximum reward <math id="A6.p2.m5" class="ltx_Math" alttext="m_{n}(T_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(T_{1})</annotation></semantics></math> at communication time <math id="A6.p2.m6" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math> follows directly from the analogous distribution proof for <math id="A6.p2.m7" class="ltx_Math" alttext="m_{n}(T-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(T-1)</annotation></semantics></math> in Appendix <a href="#A5" title="Appendix E Proof for Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a> by substituting <math id="A6.p2.m8" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math> for <math id="A6.p2.m9" class="ltx_Math" alttext="T-1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T-1</annotation></semantics></math>. Thus, we omit it here.</p>
</div>
<div id="A6.p3" class="ltx_para">
<p id="A6.p3.1" class="ltx_p">Considering the threshold sequence <math id="A6.p3.m1" class="ltx_Math" alttext="u_{t}(T_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}(T_{1})</annotation></semantics></math> for <math id="A6.p3.m2" class="ltx_Math" alttext="t&gt;T_{1}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">t&gt;T_{1}</annotation></semantics></math> as in equation (<a href="#S4.E23" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>), we observe it reduces to the single-agent exploration threshold, independent of <math id="A6.p3.m3" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math>, denoted as <math id="A6.p3.m4" class="ltx_Math" alttext="\{\bar{u}_{t}\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{\bar{u}_{t}\}_{t=1}^{T}</annotation></semantics></math>. Specifically, we have <math id="A6.p3.m5" class="ltx_Math" alttext="\{u_{t}(T_{1})\}_{t=T_{1}+1}^{T}=\{\bar{u}_{t}\}_{t=T_{1}+1}^{T}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></msubsup><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></msubsup></mrow><annotation encoding="application/x-tex">\{u_{t}(T_{1})\}_{t=T_{1}+1}^{T}=\{\bar{u}_{t}\}_{t=T_{1}+1}^{T}</annotation></semantics></math>. Recall from Appendix <a href="#A5" title="Appendix E Proof for Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a> that <math id="A6.p3.m6" class="ltx_Math" alttext="R_{t}^{n}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>t</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">R_{t}^{n}</annotation></semantics></math> represents the exploration reward agent <math id="A6.p3.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> receives at time <math id="A6.p3.m8" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, drawn from distribution <math id="A6.p3.m9" class="ltx_Math" alttext="F(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\cdot)</annotation></semantics></math> when choosing exploration. When the agent’s maximum reward <math id="A6.p3.m10" class="ltx_Math" alttext="m_{n}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(t)</annotation></semantics></math> equals the threshold <math id="A6.p3.m11" class="ltx_Math" alttext="\bar{u}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\bar{u}_{t}</annotation></semantics></math>, she is indifferent between exploration and exploitation. If she chooses exploration, her expected long-term reward (<a href="#S2.E2" title="In 2.2. Problem formulation as MA-MDP ‣ 2. System Model and Problem Formulation ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) becomes</p>
<table id="A6.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(52)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E52.m1" class="ltx_Math" alttext="\displaystyle\mu+\mathbb{E}[\max\{R^{n}_{t},\bar{u}_{t}\}](T-t)=\mu+\left(1-\int^{1}_{\bar{u}_{t}}F(r)dr\right)(T-t)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>μ</mi><mo>+</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>R</mi><mi>t</mi><mi>n</mi></msubsup><mo>,</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>t</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>μ</mi><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mu+\mathbb{E}[\max\{R^{n}_{t},\bar{u}_{t}\}](T-t)=\mu+\left(1-\int^{1}_{\bar{u}_{t}}F(r)dr\right)(T-t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p3.2" class="ltx_p">If instead she selects exploitation, her expected long-term reward (<a href="#S2.E2" title="In 2.2. Problem formulation as MA-MDP ‣ 2. System Model and Problem Formulation ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) equals <math id="A6.p3.m12" class="ltx_Math" alttext="\bar{u}_{t}(T-t+1)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bar{u}_{t}(T-t+1)</annotation></semantics></math>. Equating these two alternatives yields the threshold <math id="A6.p3.m13" class="ltx_Math" alttext="\bar{u}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\bar{u}_{t}</annotation></semantics></math> equation for all <math id="A6.p3.m14" class="ltx_Math" alttext="t\in\{1,\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{1,\ldots,T\}</annotation></semantics></math>:</p>
<table id="A6.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex104.m1" class="ltx_Math" alttext="\displaystyle\bar{u}_{t}-\mu" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>t</mi></msub><mo>−</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">\displaystyle\bar{u}_{t}-\mu</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex104.m2" class="ltx_Math" alttext="\displaystyle=(T-t)\left(\int^{1}_{\bar{u}_{t}}1-F(r)\,dr\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>t</mi></msub><mn>1</mn></msubsup></mstyle><mn>1</mn></mrow><mo>−</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(T-t)\left(\int^{1}_{\bar{u}_{t}}1-F(r)\,dr\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.p4" class="ltx_para">
<p id="A6.p4.1" class="ltx_p">Now, we derive <math id="A6.p4.m1" class="ltx_Math" alttext="u_{t}(T_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}(T_{1})</annotation></semantics></math> for <math id="A6.p4.m2" class="ltx_Math" alttext="t\in\{1,\ldots,T_{1}\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{1,\ldots,T_{1}\}</annotation></semantics></math>, corresponding to equations (<a href="#S4.E22" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>). When <math id="A6.p4.m3" class="ltx_Math" alttext="u_{t}(T_{1})&gt;u_{T_{1}+1}(T_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mi>u</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{t}(T_{1})&gt;u_{T_{1}+1}(T_{1})</annotation></semantics></math>, fulfilling the exploration-stopping condition at time <math id="A6.p4.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> also implies fulfillment in the subsequent period <math id="A6.p4.m5" class="ltx_Math" alttext="\{T_{1},\ldots,T\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{T_{1},\ldots,T\}</annotation></semantics></math>. Hence, in this scenario, the derivation of <math id="A6.p4.m6" class="ltx_Math" alttext="u_{t}(T_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}(T_{1})</annotation></semantics></math> parallels the threshold derivation (<a href="#S4.E16" title="In Lemma 4.2. ‣ 4.1. Analysis of Existing Centralized Communications Policy ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) under full communication policy outlined in Appendix <a href="#A5" title="Appendix E Proof for Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>.</p>
</div>
<div id="A6.p5" class="ltx_para">
<p id="A6.p5.1" class="ltx_p">Conversely, if <math id="A6.p5.m1" class="ltx_Math" alttext="u_{t}(T_{1})&lt;u_{T_{1}+1}(T_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><msub><mi>u</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{t}(T_{1})&lt;u_{T_{1}+1}(T_{1})</annotation></semantics></math>, it’s possible that <math id="A6.p5.m2" class="ltx_Math" alttext="u_{T_{1}+1}(T_{1})&gt;m_{n}(t)&gt;u_{t}(T_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{T_{1}+1}(T_{1})&gt;m_{n}(t)&gt;u_{t}(T_{1})</annotation></semantics></math>, indicating the agent may stop exploration at time <math id="A6.p5.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> but resume after time <math id="A6.p5.m4" class="ltx_Math" alttext="T_{1}+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T_{1}+1</annotation></semantics></math>. Suppose threshold <math id="A6.p5.m5" class="ltx_Math" alttext="u_{t}(T_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}(T_{1})</annotation></semantics></math> lies within the interval <math id="A6.p5.m6" class="ltx_Math" alttext="[\bar{u}_{T_{1}+k+1},\bar{u}_{T_{1}+k}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\bar{u}_{T_{1}+k+1},\bar{u}_{T_{1}+k}]</annotation></semantics></math>. In this case, event <math id="A6.p5.m7" class="ltx_Math" alttext="E^{n}_{T_{1}+\tau}" display="inline" intent=":literal"><semantics><msubsup><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">E^{n}_{T_{1}+\tau}</annotation></semantics></math>, for some <math id="A6.p5.m8" class="ltx_Math" alttext="1\leq\tau\leq k+1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>τ</mi><mo>≤</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq\tau\leq k+1</annotation></semantics></math>, occurs with positive probability. Given this setting, if the agent’s maximum reward at time <math id="A6.p5.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> equals <math id="A6.p5.m10" class="ltx_Math" alttext="u_{t}(T_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}(T_{1})</annotation></semantics></math> and she chooses to explore, her expected long-term reward (<a href="#S2.E2" title="In 2.2. Problem formulation as MA-MDP ‣ 2. System Model and Problem Formulation ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) can be expressed as:</p>
<table id="A6.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex105.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum^{T}_{\tau=t}\mathbb{E}[r_{a_{n}(\tau)}|a_{n}(t)\in\mathcal{K}\setminus I_{n}(t),m_{n}(t)=u_{t}(T_{1})]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><mi>T</mi></munderover></mstyle><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>a</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∖</mo><msub><mi>I</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>u</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{T}_{\tau=t}\mathbb{E}[r_{a_{n}(\tau)}|a_{n}(t)\in\mathcal{K}\setminus I_{n}(t),m_{n}(t)=u_{t}(T_{1})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex106.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex106.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum^{T_{1}}_{\tau=t}\mathbb{E}[r_{a_{n}(\tau)}|a_{n}(t)\in\mathcal{K}\setminus I_{n}(t),m_{n}(t)=u_{t}(T_{1})]+\sum^{T}_{\tau=T_{1}+1}\mathbb{E}[r_{a_{n}(\tau)}|a_{n}(t)\in\mathcal{K}\setminus I_{n}(t),m_{n}(t)=u_{t}(T_{1})]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>a</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∖</mo><msub><mi>I</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>u</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>a</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∖</mo><msub><mi>I</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>u</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{T_{1}}_{\tau=t}\mathbb{E}[r_{a_{n}(\tau)}|a_{n}(t)\in\mathcal{K}\setminus I_{n}(t),m_{n}(t)=u_{t}(T_{1})]+\sum^{T}_{\tau=T_{1}+1}\mathbb{E}[r_{a_{n}(\tau)}|a_{n}(t)\in\mathcal{K}\setminus I_{n}(t),m_{n}(t)=u_{t}(T_{1})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex107.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex107.m2" class="ltx_Math" alttext="\displaystyle\mu+\mathbb{E}[\max\{R^{n}_{t},u_{t}(T_{1})\}](T_{1}-t)+\mathbb{P}(E_{T_{1}+1})\mathbb{E}[\max\{R^{n}_{t},\max_{i\neq n}m_{i}(T_{1})\}|E_{T_{1}+1}](T-T_{1})" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>+</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>R</mi><mi>t</mi><mi>n</mi></msubsup><mo>,</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>R</mi><mi>t</mi><mi>n</mi></msubsup><mo>,</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>i</mi><mo>≠</mo><mi>n</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>m</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu+\mathbb{E}[\max\{R^{n}_{t},u_{t}(T_{1})\}](T_{1}-t)+\mathbb{P}(E_{T_{1}+1})\mathbb{E}[\max\{R^{n}_{t},\max_{i\neq n}m_{i}(T_{1})\}|E_{T_{1}+1}](T-T_{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex108.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum^{k-1}_{j=1}\mathbb{P}(E_{T_{1}+j+1})\bigg(\mu j+\mathbb{E}[\max\{R^{n}_{t},u_{t}(T_{1}),\max_{i\neq n}m_{i}(T_{1}),\max_{\tau=1,\ldots,j}R^{n}_{T_{1}+\tau}\}|E_{T_{1}+j+1}](T-T_{1}-j)\bigg)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>μ</mi><mi>j</mi><mo>+</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>max</mi><mrow><mo stretchy="false">{</mo><msubsup><mi>R</mi><mi>t</mi><mi>n</mi></msubsup><mo>,</mo><msub><mi>u</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><munder><mi>max</mi><mrow><mi>i</mi><mo>≠</mo><mi>n</mi></mrow></munder><msub><mi>m</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><munder><mi>max</mi><mrow><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>j</mi></mrow></munder><msubsup><mi>R</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow><mi>n</mi></msubsup><mo stretchy="false">}</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sum^{k-1}_{j=1}\mathbb{P}(E_{T_{1}+j+1})\bigg(\mu j+\mathbb{E}[\max\{R^{n}_{t},u_{t}(T_{1}),\max_{i\neq n}m_{i}(T_{1}),\max_{\tau=1,\ldots,j}R^{n}_{T_{1}+\tau}\}|E_{T_{1}+j+1}](T-T_{1}-j)\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(53)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E53.m1" class="ltx_Math" alttext="\displaystyle+\mathbb{P}(E_{T_{1}+k+1})\bigg(\mu k+\mathbb{E}[\max\{R^{n}_{t},u_{t}(T_{1}),\max_{i\neq n}m_{i}(T_{1}),\max_{\tau=1,\ldots,k}R^{n}_{T_{1}+\tau}\}|E_{T_{1}+k+1}](T-T_{1}-k)\bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>R</mi><mi>t</mi><mi>n</mi></msubsup><mo>,</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>i</mi><mo>≠</mo><mi>n</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>m</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><munder><mi>max</mi><mrow><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msubsup><mi>R</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow><mi>n</mi></msubsup></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{P}(E_{T_{1}+k+1})\bigg(\mu k+\mathbb{E}[\max\{R^{n}_{t},u_{t}(T_{1}),\max_{i\neq n}m_{i}(T_{1}),\max_{\tau=1,\ldots,k}R^{n}_{T_{1}+\tau}\}|E_{T_{1}+k+1}](T-T_{1}-k)\bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p5.2" class="ltx_p">Since the expressions differ significantly by line, we proceed by evaluating each term separately. The first line can be immediately obtained from equation (<a href="#A6.E52" title="In Appendix F Proof of Proposition ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">52</span></a>), as follows:</p>
<table id="A6.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(54)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E54.m1" class="ltx_Math" alttext="\displaystyle\mu+\left(1-\int^{1}_{u_{t}(T_{1})}F(r)dr\right)(T_{1}-t)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mu+\left(1-\int^{1}_{u_{t}(T_{1})}F(r)dr\right)(T_{1}-t).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p5.3" class="ltx_p">Then the second line is</p>
<table id="A6.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(55)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E55.m1" class="ltx_Math" alttext="\displaystyle\int^{1}_{\bar{u}_{T_{1}+1}}rdP(r)^{N-1}F(r)(T-T_{1})=\bigg(1-\bar{u}_{T_{1}+1}P(\bar{u}_{T_{1}+1})^{N-1}F(\bar{u}_{T_{1}+1})-\int^{1}_{\bar{u}_{T_{1}+1}}P(r)^{N-1}F(r)dr\bigg)(T-T_{1})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>P</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mn>1</mn></msubsup></mstyle><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\int^{1}_{\bar{u}_{T_{1}+1}}rdP(r)^{N-1}F(r)(T-T_{1})=\bigg(1-\bar{u}_{T_{1}+1}P(\bar{u}_{T_{1}+1})^{N-1}F(\bar{u}_{T_{1}+1})-\int^{1}_{\bar{u}_{T_{1}+1}}P(r)^{N-1}F(r)dr\bigg)(T-T_{1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p5.4" class="ltx_p">The third line is</p>
<table id="A6.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex109.m1" class="ltx_math_unparsed" alttext="\displaystyle\sum^{k-1}_{j=1}\left[\mu j\bigg(F(\bar{u}_{T_{1}+j})\cdot P(\bar{u}_{T_{1}+j})^{N-1}F(\bar{u}_{T_{1}+j})^{j-1}-F(\bar{u}_{T_{1}+j+1})\cdot P(\bar{u}_{T_{1}+j+1})^{N-1}F(\bar{u}_{T_{1}+j+1})^{j}\bigg)\right." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>[</mo><mi>μ</mi><mi>j</mi><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>j</mi></msup><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{k-1}_{j=1}\left[\mu j\bigg(F(\bar{u}_{T_{1}+j})\cdot P(\bar{u}_{T_{1}+j})^{N-1}F(\bar{u}_{T_{1}+j})^{j-1}-F(\bar{u}_{T_{1}+j+1})\cdot P(\bar{u}_{T_{1}+j+1})^{N-1}F(\bar{u}_{T_{1}+j+1})^{j}\bigg)\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex110.m1" class="ltx_math_unparsed" alttext="\displaystyle\left.+\bigg(\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}rdP(r)^{N-1}F(r)\cdot F(r)^{j}+F(\bar{u}_{T_{1}+j})P(\bar{u}_{T_{1}+j})^{N-1}\cdot F(\bar{u}_{T_{1}+j})^{j-1}\int^{1}_{\bar{u}_{T_{1}+j}}rdF(r)\bigg)(T-T_{1}-j)\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub></msubsup></mstyle><mi>r</mi><mi>d</mi><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>F</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>j</mi></msup><mo>+</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.222em">⋅</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mn>1</mn></msubsup></mstyle><mi>r</mi><mi>d</mi><mi>F</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\bigg(\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}rdP(r)^{N-1}F(r)\cdot F(r)^{j}+F(\bar{u}_{T_{1}+j})P(\bar{u}_{T_{1}+j})^{N-1}\cdot F(\bar{u}_{T_{1}+j})^{j-1}\int^{1}_{\bar{u}_{T_{1}+j}}rdF(r)\bigg)(T-T_{1}-j)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex111.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex111.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum^{k-1}_{j=1}\left[\mu j\bigg(F(\bar{u}_{T_{1}+j})^{j}P(\bar{u}_{T_{1}+j})^{N-1}-F(\bar{u}_{T_{1}+j+1})^{j+1}P(\bar{u}_{T_{1}+j+1})^{N-1}\bigg)\right." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>[</mo><mi>μ</mi><mi>j</mi><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>j</mi></msup><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{k-1}_{j=1}\left[\mu j\bigg(F(\bar{u}_{T_{1}+j})^{j}P(\bar{u}_{T_{1}+j})^{N-1}-F(\bar{u}_{T_{1}+j+1})^{j+1}P(\bar{u}_{T_{1}+j+1})^{N-1}\bigg)\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex112.m1" class="ltx_Math" alttext="\displaystyle+F(\bar{u}_{T_{1}+j})^{j}P(\bar{u}_{T_{1}+j})^{N-1}\bigg(1-\int^{1}_{\bar{u}_{T_{1}+j}}F(r)dr\bigg)(T-T_{1}-j)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+F(\bar{u}_{T_{1}+j})^{j}P(\bar{u}_{T_{1}+j})^{N-1}\bigg(1-\int^{1}_{\bar{u}_{T_{1}+j}}F(r)dr\bigg)(T-T_{1}-j)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex113.m1" class="ltx_math_unparsed" alttext="\displaystyle\left.-\bigg(\bar{u}_{T_{1}+j+1}P(\bar{u}_{T_{1}+j+1})^{N-1}F(\bar{u}_{T_{1}+j})^{j+1}+\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}P(r)^{N-1}F(r)^{j+1}dr\bigg)(T-T_{1}-j)\right]." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>+</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub></msubsup></mstyle><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>d</mi><mi>r</mi><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.-\bigg(\bar{u}_{T_{1}+j+1}P(\bar{u}_{T_{1}+j+1})^{N-1}F(\bar{u}_{T_{1}+j})^{j+1}+\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}P(r)^{N-1}F(r)^{j+1}dr\bigg)(T-T_{1}-j)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p5.5" class="ltx_p">Replace the bracket <math id="A6.p5.m11" class="ltx_Math" alttext="\bigg(1-\int^{1}_{\bar{u}_{T_{1}+j}}F(r)dr\bigg)(T-T_{1}-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mn>1</mn></msubsup><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bigg(1-\int^{1}_{\bar{u}_{T_{1}+j}}F(r)dr\bigg)(T-T_{1}-j)</annotation></semantics></math> in this equation by <math id="A6.p5.m12" class="ltx_Math" alttext="(\bar{u}_{T_{1}+j}(T-T_{1}-j+1)-\mu)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bar{u}_{T_{1}+j}(T-T_{1}-j+1)-\mu)</annotation></semantics></math> derived from (<a href="#S4.E23" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>), it follows that</p>
