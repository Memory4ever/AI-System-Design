<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex116.m2" class="ltx_Math" alttext="\displaystyle-\mu F(\bar{u}_{T_{1}+k})^{k}P(\bar{u}_{T_{1}+k})^{N-1}(k-1)+\bar{u}_{T_{1}+1}F(\bar{u}_{T_{1}+1})^{j}P(\bar{u}_{T_{1}+1})^{N-1}(T-T_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\mu F(\bar{u}_{T_{1}+k})^{k}P(\bar{u}_{T_{1}+k})^{N-1}(k-1)+\bar{u}_{T_{1}+1}F(\bar{u}_{T_{1}+1})^{j}P(\bar{u}_{T_{1}+1})^{N-1}(T-T_{1})</annotation></semantics></math></td>
