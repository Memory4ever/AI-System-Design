<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E57.m1" class="ltx_Math" alttext="\displaystyle-\bar{u}_{T_{1}+k}F(\bar{u}_{T_{1}+k})^{k}P(\bar{u}_{T_{1}+k})^{N-1}(T-T_{1}-k+1)-\sum^{k-1}_{j=1}\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}P(r)^{N-1}F(r)^{j+1}dr(T-T_{1}-j)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub></msubsup></mstyle><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\bar{u}_{T_{1}+k}F(\bar{u}_{T_{1}+k})^{k}P(\bar{u}_{T_{1}+k})^{N-1}(T-T_{1}-k+1)-\sum^{k-1}_{j=1}\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}P(r)^{N-1}F(r)^{j+1}dr(T-T_{1}-j).</annotation></semantics></math></td>
