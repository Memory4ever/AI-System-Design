<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex65.m1" class="ltx_math_unparsed" alttext="\displaystyle+N\sum^{m}_{i=1}F(\mu)^{NT_{i}}\left(1-\mu F(\mu)^{N(\Delta_{i}+1)}-\int^{1}_{\mu}\left(\frac{F(r)-F(\mu)}{1-F(\mu)}+F(\mu)^{\Delta_{i}+1}\frac{1-F(r)}{1-F(\mu)}\right)^{N}dr\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>N</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow></msup><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>μ</mi><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>+</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msup><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mi>N</mi></msup><mi>d</mi><mi>r</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+N\sum^{m}_{i=1}F(\mu)^{NT_{i}}\left(1-\mu F(\mu)^{N(\Delta_{i}+1)}-\int^{1}_{\mu}\left(\frac{F(r)-F(\mu)}{1-F(\mu)}+F(\mu)^{\Delta_{i}+1}\frac{1-F(r)}{1-F(\mu)}\right)^{N}dr\right)</annotation></semantics></math></td>
