<p id="A3.p9.5" class="ltx_p">Then the remaining parts of (<a href="#A3.E40" title="In Appendix C Proof for Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>) are</p>
<table id="A3.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex58.m1" class="ltx_Math" alttext="\displaystyle N\sum^{m-1}_{i=1}F(\mu)^{NT_{i}}\left(1-\mu F(\mu)^{N(\Delta_{i}+1)}-\int^{1}_{\mu}\left(\frac{F(r)-F(\mu)}{1-F(\mu)}+F(\mu)^{\Delta_{i}+1}\frac{1-F(r)}{1-F(\mu)}\right)^{N}dr\right)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N\sum^{m-1}_{i=1}F(\mu)^{NT_{i}}\left(1-\mu F(\mu)^{N(\Delta_{i}+1)}-\int^{1}_{\mu}\left(\frac{F(r)-F(\mu)}{1-F(\mu)}+F(\mu)^{\Delta_{i}+1}\frac{1-F(r)}{1-F(\mu)}\right)^{N}dr\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex59.m1" class="ltx_math_unparsed" alttext="\displaystyle+N\sum^{m-2}_{i=1}(F(\mu)^{N(T_{i}+\Delta_{i}+1)}-F(\mu)^{NT_{i+1}})\left(1-\int^{1}_{\mu}\frac{(F(r)^{N}-F(\mu)^{N})}{1-F(\mu)^{N}}dr\right)+N(F(\mu)^{N(T_{m-1}+\Delta_{m-1}+1)}-F(\mu)^{NT_{1}})\left(1-\int^{1}_{\mu}\frac{(F(r)^{N}-F(\mu)^{N})}{1-F(\mu)^{N}}dr\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>N</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>2</mn></mrow></munderover></mstyle><mrow><mo stretchy="false">(</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow></mfrac></mstyle><mi>d</mi><mi>r</mi><mo>)</mo></mrow><mo>+</mo><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo>−</mo><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>1</mn></msub></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow></mfrac></mstyle><mi>d</mi><mi>r</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+N\sum^{m-2}_{i=1}(F(\mu)^{N(T_{i}+\Delta_{i}+1)}-F(\mu)^{NT_{i+1}})\left(1-\int^{1}_{\mu}\frac{(F(r)^{N}-F(\mu)^{N})}{1-F(\mu)^{N}}dr\right)+N(F(\mu)^{N(T_{m-1}+\Delta_{m-1}+1)}-F(\mu)^{NT_{1}})\left(1-\int^{1}_{\mu}\frac{(F(r)^{N}-F(\mu)^{N})}{1-F(\mu)^{N}}dr\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex60.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex60.m2" class="ltx_Math" alttext="\displaystyle N\sum^{m-1}_{i=1}F(\mu)^{NT_{i}}\left(\int^{1}_{\mu}\frac{F(r)^{N}-F(\mu)^{N}}{1-F(\mu)^{N}}+F(\mu)^{N(\Delta_{i}+1)}\frac{1-F(r)^{N}}{1-F(\mu)^{N}}-\left(\frac{F(r)-F(\mu)}{1-F(\mu)}+F(\mu)^{\Delta_{i}+1}\frac{1-F(r)}{1-F(\mu)}\right)^{N}dr\right)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N\sum^{m-1}_{i=1}F(\mu)^{NT_{i}}\left(\int^{1}_{\mu}\frac{F(r)^{N}-F(\mu)^{N}}{1-F(\mu)^{N}}+F(\mu)^{N(\Delta_{i}+1)}\frac{1-F(r)^{N}}{1-F(\mu)^{N}}-\left(\frac{F(r)-F(\mu)}{1-F(\mu)}+F(\mu)^{\Delta_{i}+1}\frac{1-F(r)}{1-F(\mu)}\right)^{N}dr\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(42)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E42.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E42.m2" class="ltx_Math" alttext="\displaystyle N\sum^{m-1}_{i=1}F(\mu)^{NT_{i}}y_{\Delta_{i}+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle N\sum^{m-1}_{i=1}F(\mu)^{NT_{i}}y_{\Delta_{i}+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p9.6" class="ltx_p">Finally, summing up (<a href="#A3.E41" title="In Appendix C Proof for Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>) and (<a href="#A3.E42" title="In Appendix C Proof for Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>), <math id="A3.p9.m9" class="ltx_Math" alttext="v_{\mathcal{M}}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">v_{\mathcal{M}}(t)</annotation></semantics></math> for <math id="A3.p9.m10" class="ltx_Math" alttext="t\in\{T_{m}+1,\ldots,T_{m}+\Delta_{m}\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{T_{m}+1,\ldots,T_{m}+\Delta_{m}\}</annotation></semantics></math> is</p>
<table id="A3.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(43)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E43.m1" class="ltx_math_unparsed" alttext="\displaystyle v_{\mathcal{M}}(t)=v_{\emptyset}(t)+N\sum^{m-1}_{i=1}F(\mu)^{NT_{i}}y_{\Delta_{i}+1}-NF(\mu)^{NT_{m}}x_{t-T_{m}},t\in\{T_{m}+1,\ldots,T_{m}+\Delta_{m}\},m=1,\ldots,M." display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>v</mi><mi mathvariant="normal">∅</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>N</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow></msup><msub><mi>y</mi><mrow><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mi>N</mi><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>m</mi></msub></mrow></msup><msub><mi>x</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>T</mi><mi>m</mi></msub></mrow></msub><mo>,</mo><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo stretchy="false">}</mo></mrow><mo>,</mo><mi>m</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle v_{\mathcal{M}}(t)=v_{\emptyset}(t)+N\sum^{m-1}_{i=1}F(\mu)^{NT_{i}}y_{\Delta_{i}+1}-NF(\mu)^{NT_{m}}x_{t-T_{m}},t\in\{T_{m}+1,\ldots,T_{m}+\Delta_{m}\},m=1,\ldots,M.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p10" class="ltx_para">
<p id="A3.p10.1" class="ltx_p">For <math id="A3.p10.m1" class="ltx_Math" alttext="t\in\{T_{m}+\Delta_{m}+1,\ldots,T_{m+1}\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>T</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{T_{m}+\Delta_{m}+1,\ldots,T_{m+1}\}</annotation></semantics></math>, the historical events can be partitioned as follows:</p>
<table id="A3.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex61.m1" class="ltx_Math" alttext="\displaystyle E_{(0,T_{m}-1)},E_{(T_{m},T_{m}+\Delta_{m})},E_{(T_{m}+\Delta_{m}+1,T_{m+1}-1)},\ldots,E_{(T_{m}+\Delta_{m}+1,t-1)},\bar{E}_{t-1}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>m</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><msub><mi>T</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle E_{(0,T_{m}-1)},E_{(T_{m},T_{m}+\Delta_{m})},E_{(T_{m}+\Delta_{m}+1,T_{m+1}-1)},\ldots,E_{(T_{m}+\Delta_{m}+1,t-1)},\bar{E}_{t-1},</annotation></semantics></math></td>
