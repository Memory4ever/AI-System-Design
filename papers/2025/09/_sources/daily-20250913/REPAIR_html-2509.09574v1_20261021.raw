<p id="A3.p10.2" class="ltx_p">under which <math id="A3.p10.m2" class="ltx_Math" alttext="v_{{\mathcal{M}}}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">v_{{\mathcal{M}}}(t)</annotation></semantics></math> for <math id="A3.p10.m3" class="ltx_Math" alttext="t\in\{T_{m}+\Delta_{m}+1,\ldots,T_{m+1}\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>T</mi><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{T_{m}+\Delta_{m}+1,\ldots,T_{m+1}\}</annotation></semantics></math> is</p>
