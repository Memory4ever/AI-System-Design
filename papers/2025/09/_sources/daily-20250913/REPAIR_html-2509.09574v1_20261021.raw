<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex64.m2" class="ltx_Math" alttext="\displaystyle N(1-F(\mu)^{NT_{1}})\int^{1}_{\mu}rd\frac{F(r)^{N}-F(\mu)^{N}}{1-F(\mu)^{N}}+N(F(\mu)^{N(T_{m}+\Delta_{m}+1)}-F(\mu)^{Nt})\int^{1}_{\mu}rd\frac{F(r)^{N}-F(\mu)^{N}}{1-F(\mu)N}+F(\mu)^{Nt}\mu" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mn>1</mn></msub></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>m</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>m</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mi>μ</mi><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N(1-F(\mu)^{NT_{1}})\int^{1}_{\mu}rd\frac{F(r)^{N}-F(\mu)^{N}}{1-F(\mu)^{N}}+N(F(\mu)^{N(T_{m}+\Delta_{m}+1)}-F(\mu)^{Nt})\int^{1}_{\mu}rd\frac{F(r)^{N}-F(\mu)^{N}}{1-F(\mu)N}+F(\mu)^{Nt}\mu</annotation></semantics></math></td>
