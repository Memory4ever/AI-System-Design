<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex62.m2" class="ltx_math_unparsed" alttext="\displaystyle N\mathbb{P}(E_{(0,T_{1}-1)})\mathbb{E}[r_{a_{n}(t)}|E_{(0,T_{1}-1)}]+\sum^{m}_{i=1}N\mathbb{P}(E_{(T_{i},T_{i}+\Delta_{1})})\mathbb{E}[r_{a_{n}(t)}|E_{(T_{i},T_{i}+\Delta_{1})}]+N\sum^{m-1}_{i=1}\mathbb{P}(E_{(T_{i}+\Delta_{i}+1,T_{i+1}-1)})\mathbb{E}[r_{a_{n}(t)}|E_{(T_{i}+\Delta_{i}+1,T_{i+1}-1)})]" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mi>N</mi><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">]</mo></mrow><mo>+</mo><mi>N</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><msub><mi>T</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>+</mo><msub><mi mathvariant="normal">Δ</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><msub><mi>T</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle N\mathbb{P}(E_{(0,T_{1}-1)})\mathbb{E}[r_{a_{n}(t)}|E_{(0,T_{1}-1)}]+\sum^{m}_{i=1}N\mathbb{P}(E_{(T_{i},T_{i}+\Delta_{1})})\mathbb{E}[r_{a_{n}(t)}|E_{(T_{i},T_{i}+\Delta_{1})}]+N\sum^{m-1}_{i=1}\mathbb{P}(E_{(T_{i}+\Delta_{i}+1,T_{i+1}-1)})\mathbb{E}[r_{a_{n}(t)}|E_{(T_{i}+\Delta_{i}+1,T_{i+1}-1)})]</annotation></semantics></math></td>
