<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex131.m1" class="ltx_Math" alttext="\displaystyle+NF(u_{T_{1}}(T_{1}))^{T_{1}}\mu(T_{1}+1)+N\int^{1}_{\bar{u}_{T_{1}+1}}rdP(r)^{N}(T-T_{1})+N\sum^{T-T_{1}-1}_{\tau=1}\bigg(\left(P(\bar{u}_{T_{1}+\tau})^{N}F(\bar{u}_{T_{1}+\tau})^{\tau-1}-P(\bar{u}_{T_{1}+\tau+1})^{N}F(\bar{u}_{T_{1}+\tau+1})^{\tau}\right)\mu\tau" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><msub><mi>T</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><msub><mi>T</mi><mn>1</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>P</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mo>(</mo><mrow><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>−</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>τ</mi></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+NF(u_{T_{1}}(T_{1}))^{T_{1}}\mu(T_{1}+1)+N\int^{1}_{\bar{u}_{T_{1}+1}}rdP(r)^{N}(T-T_{1})+N\sum^{T-T_{1}-1}_{\tau=1}\bigg(\left(P(\bar{u}_{T_{1}+\tau})^{N}F(\bar{u}_{T_{1}+\tau})^{\tau-1}-P(\bar{u}_{T_{1}+\tau+1})^{N}F(\bar{u}_{T_{1}+\tau+1})^{\tau}\right)\mu\tau</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex132.m1" class="ltx_Math" alttext="\displaystyle\left.+\left(\int^{\bar{u}_{T_{1}+\tau}}_{\bar{u}_{T_{1}+\tau+1}}rdP(r)^{N}F(r)^{\tau}+P(\bar{u}_{T_{1}+\tau})^{N}F(\bar{u}_{T_{1}+\tau})^{\tau-1}\int^{1}_{\bar{u}_{T_{1}+\tau}}rdF(r)\right)(T-T_{1}-\tau)\right)+NP(\bar{u}_{T})^{N}F(r)^{T-T_{1}-1}\mu(T-T_{1})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>P</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>τ</mi></msup></mrow></mrow><mo>+</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\left(\int^{\bar{u}_{T_{1}+\tau}}_{\bar{u}_{T_{1}+\tau+1}}rdP(r)^{N}F(r)^{\tau}+P(\bar{u}_{T_{1}+\tau})^{N}F(\bar{u}_{T_{1}+\tau})^{\tau-1}\int^{1}_{\bar{u}_{T_{1}+\tau}}rdF(r)\right)(T-T_{1}-\tau)\right)+NP(\bar{u}_{T})^{N}F(r)^{T-T_{1}-1}\mu(T-T_{1}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p7.3" class="ltx_p">where we set <math id="A6.p7.m29" class="ltx_Math" alttext="u_{0}(T_{1})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">u_{0}(T_{1})=1</annotation></semantics></math> for simplification, which does not affect the agents’ actions at time <math id="A6.p7.m30" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> since agents can only choose to explore. Then</p>
<table id="A6.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex134.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex134.m2" class="ltx_Math" alttext="\displaystyle N\sum^{T_{1}}_{\tau=0}F(u_{\tau}(T_{1}))^{\tau}\mu+N\sum^{T_{1}}_{\tau=1}\left(\int^{u_{\tau-1}(T_{1})}_{u_{\tau}(T_{1})}rdF(r)^{\tau}+F(u_{\tau-1}(T_{1}))^{\tau-1}\int^{1}_{u_{\tau-1}(T_{1})}rdF(r)\right)(T_{1}-\tau+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>u</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>τ</mi></msup></mrow></mrow><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N\sum^{T_{1}}_{\tau=0}F(u_{\tau}(T_{1}))^{\tau}\mu+N\sum^{T_{1}}_{\tau=1}\left(\int^{u_{\tau-1}(T_{1})}_{u_{\tau}(T_{1})}rdF(r)^{\tau}+F(u_{\tau-1}(T_{1}))^{\tau-1}\int^{1}_{u_{\tau-1}(T_{1})}rdF(r)\right)(T_{1}-\tau+1)</annotation></semantics></math></td>
