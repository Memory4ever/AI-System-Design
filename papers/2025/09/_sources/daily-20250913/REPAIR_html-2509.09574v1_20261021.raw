chy="false">)</mo></mrow><mi>j</mi></msup><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>μ</mi><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{k-1}_{j=1}\left[\mu j\bigg(F(\bar{u}_{T_{1}+j})^{j}P(\bar{u}_{T_{1}+j})^{N-1}-F(\bar{u}_{T_{1}+j+1})^{j+1}P(\bar{u}_{T_{1}+j+1})^{N-1}\bigg)\right.+F(\bar{u}_{T_{1}+j})^{j}P(\bar{u}_{T_{1}+j})^{N-1}\bigg(\bar{u}_{T_{1}+j}(T-T_{1}-j+1)-\mu\bigg)</annotation></semantics></math></td>
