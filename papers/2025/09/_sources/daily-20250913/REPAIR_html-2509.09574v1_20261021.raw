<p id="A6.p5.6" class="ltx_p">Finally, the last line is</p>
<table id="A6.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex117.m1" class="ltx_Math" alttext="\displaystyle\mu F(\bar{u}_{T_{1}+k})^{k}P(\bar{u}_{T_{1}+k})^{N-1}k+\left(\int^{\bar{u}_{T_{1}+k}}_{u_{t}(T_{1})}rdP(r)^{N-1}F(r)^{k+1}+P(\bar{u}_{T_{1}+k})^{N-1}F(\bar{u}_{T_{1}+k})^{k}\int^{1}_{\bar{u}_{T_{1}+k}}rdF(r)\right." display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>P</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>+</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu F(\bar{u}_{T_{1}+k})^{k}P(\bar{u}_{T_{1}+k})^{N-1}k+\left(\int^{\bar{u}_{T_{1}+k}}_{u_{t}(T_{1})}rdP(r)^{N-1}F(r)^{k+1}+P(\bar{u}_{T_{1}+k})^{N-1}F(\bar{u}_{T_{1}+k})^{k}\int^{1}_{\bar{u}_{T_{1}+k}}rdF(r)\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex118.m1" class="ltx_Math" alttext="\displaystyle+u_{t}(T_{1})P(u_{t}(T_{1}))^{N-1}F(u_{t}(T_{1}))^{k+1}\bigg)(T-T_{1}-k)" display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>+</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+u_{t}(T_{1})P(u_{t}(T_{1}))^{N-1}F(u_{t}(T_{1}))^{k+1}\bigg)(T-T_{1}-k)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(58)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E58.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E58.m2" class="ltx_Math" alttext="\displaystyle\bar{u}_{T_{1}+k}F(\bar{u}_{T_{1}+k})^{k}P(\bar{u}_{T_{1}+k})^{N-1}(T-T_{1}-k+1)+\mu F(\bar{u}_{T_{1}+k})^{k}P(\bar{u}_{T_{1}+k})^{N-1}(k-1)-\int^{\bar{u}_{T_{1}+k}}_{u_{t}(T_{1})}P(r)^{N-1}F(r)^{k+1}dr(T-T_{1}-k)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>k</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub></msubsup></mstyle><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bar{u}_{T_{1}+k}F(\bar{u}_{T_{1}+k})^{k}P(\bar{u}_{T_{1}+k})^{N-1}(T-T_{1}-k+1)+\mu F(\bar{u}_{T_{1}+k})^{k}P(\bar{u}_{T_{1}+k})^{N-1}(k-1)-\int^{\bar{u}_{T_{1}+k}}_{u_{t}(T_{1})}P(r)^{N-1}F(r)^{k+1}dr(T-T_{1}-k).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p5.7" class="ltx_p">By summing up these equation of each line of (<a href="#A6.E53" title="In Appendix F Proof of Proposition ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>), we derive the final expression of the expected long-term reward for agent <math id="A6.p5.m13" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> if she chooses to explore at time <math id="A6.p5.m14" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>:</p>
<table id="A6.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex119.m1" class="ltx_Math" alttext="\displaystyle\mu+\left(1-\int^{1}_{u_{t}(T_{1})}F(r)dr\right)(T_{1}-t)+\bigg(1-\int^{1}_{\bar{u}_{T_{1}+1}}P(r)^{N-1}F(r)dr\bigg)(T-T_{1})" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mn>1</mn></msubsup></mstyle><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu+\left(1-\int^{1}_{u_{t}(T_{1})}F(r)dr\right)(T_{1}-t)+\bigg(1-\int^{1}_{\bar{u}_{T_{1}+1}}P(r)^{N-1}F(r)dr\bigg)(T-T_{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(59)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E59.m1" class="ltx_math_unparsed" alttext="\displaystyle-\sum^{k-1}_{j=1}\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}P(r)^{N-1}F(r)^{j+1}dr(T-T_{1}-j)-\int^{\bar{u}_{T_{1}+k}}_{u_{t}(T_{1})}P(r)^{N-1}F(r)^{k+1}dr(T-T_{1}-k)." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub></msubsup></mstyle><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>d</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub></msubsup></mstyle><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mi>d</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\sum^{k-1}_{j=1}\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}P(r)^{N-1}F(r)^{j+1}dr(T-T_{1}-j)-\int^{\bar{u}_{T_{1}+k}}_{u_{t}(T_{1})}P(r)^{N-1}F(r)^{k+1}dr(T-T_{1}-k).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.p6" class="ltx_para">
<p id="A6.p6.1" class="ltx_p">Next, we will determine agent <math id="A6.p6.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>’s expected long-term reward in (<a href="#S2.E2" title="In 2.2. Problem formulation as MA-MDP ‣ 2. System Model and Problem Formulation ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) if she opts for exploitation at time <math id="A6.p6.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, given that <math id="A6.p6.m3" class="ltx_Math" alttext="m_{n}(t)=u_{t}(T_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">m_{n}(t)=u_{t}(T_{1})</annotation></semantics></math> and <math id="A6.p6.m4" class="ltx_Math" alttext="u_{t}(T_{1})\in[\bar{u}_{T_{1}+k+1},\bar{u}_{T_{1}+k}]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">u_{t}(T_{1})\in[\bar{u}_{T_{1}+k+1},\bar{u}_{T_{1}+k}]</annotation></semantics></math>. Similar to (<a href="#A6.E53" title="In Appendix F Proof of Proposition ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>), we have</p>
<table id="A6.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex120.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[\sum^{T}_{\tau=t}r_{a_{n}(\tau)}|a_{n}(t)=\bar{a}_{n}(t),m_{n}(t)=u_{t}(T_{1})]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><mi>T</mi></munderover></mstyle><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>a</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mover accent="true"><mi>a</mi><mo>¯</mo></mover><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>u</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\sum^{T}_{\tau=t}r_{a_{n}(\tau)}|a_{n}(t)=\bar{a}_{n}(t),m_{n}(t)=u_{t}(T_{1})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex121.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex121.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum^{T_{1}}_{\tau=t}\mathbb{E}[r_{a_{n}(\tau)}|a_{n}(t)=\bar{a}_{n}(t),m_{n}(t)=u_{t}(T_{1})]+\sum^{T}_{\tau=T_{1}+1}\mathbb{E}[r_{a_{n}(\tau)}|a_{n}(t)=\bar{a}_{n}(t),m_{n}(t)=u_{t}(T_{1})]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mi>t</mi></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>a</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mover accent="true"><mi>a</mi><mo>¯</mo></mover><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>u</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>a</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mover accent="true"><mi>a</mi><mo>¯</mo></mover><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>u</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{T_{1}}_{\tau=t}\mathbb{E}[r_{a_{n}(\tau)}|a_{n}(t)=\bar{a}_{n}(t),m_{n}(t)=u_{t}(T_{1})]+\sum^{T}_{\tau=T_{1}+1}\mathbb{E}[r_{a_{n}(\tau)}|a_{n}(t)=\bar{a}_{n}(t),m_{n}(t)=u_{t}(T_{1})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex122.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex122.m2" class="ltx_Math" alttext="\displaystyle u_{t}(T_{1})(T_{1}-t+1)+\mathbb{P}(E_{T_{1}+1})\mathbb{E}[\max\{u_{t}(T_{1}),\max_{i\neq n}m_{i}(T_{1}),\max_{\tau=1,\ldots,j}R^{n}_{T_{1}+\tau}\}|E_{T_{1}+1}](T-T_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>t</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>i</mi><mo>≠</mo><mi>n</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>m</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><munder><mi>max</mi><mrow><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>j</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msubsup><mi>R</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow><mi>n</mi></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{t}(T_{1})(T_{1}-t+1)+\mathbb{P}(E_{T_{1}+1})\mathbb{E}[\max\{u_{t}(T_{1}),\max_{i\neq n}m_{i}(T_{1}),\max_{\tau=1,\ldots,j}R^{n}_{T_{1}+\tau}\}|E_{T_{1}+1}](T-T_{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex123.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum^{k-1}_{j=1}\mathbb{P}(E_{T_{1}+j+1})\bigg(\mu j+\mathbb{E}[\max\{u_{t}(T_{1}),\max_{i\neq n}m_{i}(T_{1}),\max_{\tau=1,\ldots,j}R^{n}_{T_{1}+\tau}\}|E_{T_{1}+j+1}](T-T_{1}-j)\bigg)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>μ</mi><mi>j</mi><mo>+</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>max</mi><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><munder><mi>max</mi><mrow><mi>i</mi><mo>≠</mo><mi>n</mi></mrow></munder><msub><mi>m</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><munder><mi>max</mi><mrow><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>j</mi></mrow></munder><msubsup><mi>R</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow><mi>n</mi></msubsup><mo stretchy="false">}</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\sum^{k-1}_{j=1}\mathbb{P}(E_{T_{1}+j+1})\bigg(\mu j+\mathbb{E}[\max\{u_{t}(T_{1}),\max_{i\neq n}m_{i}(T_{1}),\max_{\tau=1,\ldots,j}R^{n}_{T_{1}+\tau}\}|E_{T_{1}+j+1}](T-T_{1}-j)\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E60"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(60)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E60.m1" class="ltx_Math" alttext="\displaystyle+\mathbb{P}(E_{T_{1}+k+1})\bigg(\mu k+\mathbb{E}[\max\{u_{t}(T_{1}),\max_{i\neq n}m_{i}(T_{1}),\max_{\tau=1,\ldots,k}R^{n}_{T_{1}+\tau}\}|E_{T_{1}+k+1}](T-T_{1}-k)\bigg)." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>+</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>i</mi><mo>≠</mo><mi>n</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>m</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><munder><mi>max</mi><mrow><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>k</mi></mrow></munder><mo lspace="0.167em">⁡</mo><msubsup><mi>R</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow><mi>n</mi></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{P}(E_{T_{1}+k+1})\bigg(\mu k+\mathbb{E}[\max\{u_{t}(T_{1}),\max_{i\neq n}m_{i}(T_{1}),\max_{\tau=1,\ldots,k}R^{n}_{T_{1}+\tau}\}|E_{T_{1}+k+1}](T-T_{1}-k)\bigg).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p6.2" class="ltx_p">Note that, unlike the expression in (<a href="#A6.E53" title="In Appendix F Proof of Proposition ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>) for the long-term reward of exploration, the expected reward after <math id="A6.p6.m5" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math> lacks the <math id="A6.p6.m6" class="ltx_Math" alttext="R^{n}_{t}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>t</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">R^{n}_{t}</annotation></semantics></math> component because there is no exploration at time <math id="A6.p6.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Then, by following a derivation process similar to that for (<a href="#A6.E53" title="In Appendix F Proof of Proposition ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>), we obtain equation (<a href="#A6.E60" title="In Appendix F Proof of Proposition ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">60</span></a>) as follows:</p>
<table id="A6.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex124.m1" class="ltx_Math" alttext="\displaystyle u_{t}(T_{1})(T_{1}-t+1)+\bigg(1-\int^{1}_{\bar{u}_{T_{1}+1}}P(r)^{N-1}dr\bigg)(T-T_{1})-\sum^{k-1}_{j=1}\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}P(r)^{N-1}F(r)^{j}dr(T-T_{1}-j)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>t</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mn>1</mn></msubsup></mstyle><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi><mo>+</mo><mn>1</mn></mrow></msub><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>j</mi></mrow></msub></msubsup></mstyle><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>j</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u_{t}(T_{1})(T_{1}-t+1)+\bigg(1-\int^{1}_{\bar{u}_{T_{1}+1}}P(r)^{N-1}dr\bigg)(T-T_{1})-\sum^{k-1}_{j=1}\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}P(r)^{N-1}F(r)^{j}dr(T-T_{1}-j)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.E61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(61)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E61.m1" class="ltx_math_unparsed" alttext="\displaystyle-\int^{\bar{u}_{T_{1}+k}}_{u_{t}(T_{1})}P(r)^{N-1}F(r)^{k}dr(T-T_{1}-k)." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>k</mi></mrow></msub></msubsup></mstyle><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>k</mi></msup><mi>d</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\int^{\bar{u}_{T_{1}+k}}_{u_{t}(T_{1})}P(r)^{N-1}F(r)^{k}dr(T-T_{1}-k).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p6.3" class="ltx_p">By equating (<a href="#A6.E59" title="In Appendix F Proof of Proposition ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">59</span></a>) with (<a href="#A6.E61" title="In Appendix F Proof of Proposition ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">61</span></a>), we derive equation (<a href="#S4.E22" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) when <math id="A6.p6.m8" class="ltx_Math" alttext="u_{t}(T_{1})&lt;\bar{u}_{T_{1}+1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">u_{t}(T_{1})&lt;\bar{u}_{T_{1}+1}</annotation></semantics></math>, which complete the prove for (<a href="#S4.E22" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>) and (<a href="#S4.E23" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>).</p>
</div>
<div id="A6.p7" class="ltx_para">
<p id="A6.p7.1" class="ltx_p">We next prove <math id="A6.p7.m1" class="ltx_Math" alttext="V_{\mathcal{M}_{2}}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn></msub></msub><annotation encoding="application/x-tex">V_{\mathcal{M}_{2}}</annotation></semantics></math> in (<a href="#S4.E24" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>). In addition to the event <math id="A6.p7.m2" class="ltx_Math" alttext="E_{t}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>t</mi></msub><annotation encoding="application/x-tex">E_{t}</annotation></semantics></math> defined in Appendix <a href="#A1" title="Appendix A Proof of Lemma ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>, we further define <math id="A6.p7.m3" class="ltx_Math" alttext="E_{T_{1}+t}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">E_{T_{1}+t}</annotation></semantics></math> for <math id="A6.p7.m4" class="ltx_Math" alttext="t=1,\ldots,T-T_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">t=1,\ldots,T-T_{1}</annotation></semantics></math> as the event where agent <math id="A6.p7.m5" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>’s maximum reward <math id="A6.p7.m6" class="ltx_Math" alttext="m_{n}(T_{1}+t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(T_{1}+t)</annotation></semantics></math> exceeds the exploration threshold <math id="A6.p7.m7" class="ltx_Math" alttext="\bar{u}_{T_{1}+t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\bar{u}_{T_{1}+t}</annotation></semantics></math> for the first time at time <math id="A6.p7.m8" class="ltx_Math" alttext="T_{1}+t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{1}+t</annotation></semantics></math>, subsequent to time <math id="A6.p7.m9" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math>, regardless of whether <math id="A6.p7.m10" class="ltx_Math" alttext="m_{n}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m_{n}(t)</annotation></semantics></math> had previously surpassed <math id="A6.p7.m11" class="ltx_Math" alttext="u_{t}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>t</mi></msub><annotation encoding="application/x-tex">u_{t}</annotation></semantics></math> before time <math id="A6.p7.m12" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math>. Given that the sequences <math id="A6.p7.m13" class="ltx_Math" alttext="\{u_{t}(T_{1})\}_{t=1}^{T_{1}}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></msubsup><annotation encoding="application/x-tex">\{u_{t}(T_{1})\}_{t=1}^{T_{1}}</annotation></semantics></math> and <math id="A6.p7.m14" class="ltx_Math" alttext="\{u_{t}(T_{1})\}_{t=T_{1}+1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>u</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{u_{t}(T_{1})\}_{t=T_{1}+1}^{T}</annotation></semantics></math> decrease separately, the events <math id="A6.p7.m15" class="ltx_Math" alttext="E_{t}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>t</mi></msub><annotation encoding="application/x-tex">E_{t}</annotation></semantics></math> for <math id="A6.p7.m16" class="ltx_Math" alttext="t=1,\ldots,T_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">t=1,\ldots,T_{1}</annotation></semantics></math>, <math id="A6.p7.m17" class="ltx_Math" alttext="\bar{E}_{T_{1}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><msub><mi>T</mi><mn>1</mn></msub></msub><annotation encoding="application/x-tex">\bar{E}_{T_{1}}</annotation></semantics></math>, <math id="A6.p7.m18" class="ltx_Math" alttext="E_{T_{1}+\tau}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><annotation encoding="application/x-tex">E_{T_{1}+\tau}</annotation></semantics></math> for <math id="A6.p7.m19" class="ltx_Math" alttext="\tau=1,\ldots,T-T_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\tau=1,\ldots,T-T_{1}</annotation></semantics></math>, and <math id="A6.p7.m20" class="ltx_Math" alttext="\bar{E}_{T}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mi>T</mi></msub><annotation encoding="application/x-tex">\bar{E}_{T}</annotation></semantics></math> together form the complete event space for the total process. Then social welfare (<a href="#S2.E3" title="In 2.2. Problem formulation as MA-MDP ‣ 2. System Model and Problem Formulation ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) can be written as</p>
<table id="A6.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex125.m1" class="ltx_Math" alttext="\displaystyle\sum^{T}_{t=1}\sum^{N}_{n=1}\mathbb{E}[r_{a_{n}(t)}]=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{T}_{t=1}\sum^{N}_{n=1}\mathbb{E}[r_{a_{n}(t)}]=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex125.m2" class="ltx_Math" alttext="\displaystyle\sum^{N}_{n=1}\sum^{T_{1}}_{t=1}\mathbb{E}[r_{a_{n}(t)}]+\sum^{N}_{n=1}\sum^{T}_{t=T_{1}+1}\mathbb{E}[r_{a_{n}(t)}]" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{N}_{n=1}\sum^{T_{1}}_{t=1}\mathbb{E}[r_{a_{n}(t)}]+\sum^{N}_{n=1}\sum^{T}_{t=T_{1}+1}\mathbb{E}[r_{a_{n}(t)}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex126.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex126.m2" class="ltx_Math" alttext="\displaystyle\sum^{N}_{n=1}\sum^{T_{1}}_{\tau=1}\mathbb{P}(E_{\tau})\sum^{T_{1}}_{t=1}\mathbb{E}[r_{a_{n}(t)}|E_{\tau}]+\sum^{N}_{n=1}\mathbb{P}(\bar{E}_{T_{1}})\sum^{T_{1}}_{t=1}\mathbb{E}[r_{a_{n}(t)}|\bar{E}_{T_{1}}]+\sum^{N}_{n=1}\sum^{T-T_{1}}_{\tau=1}\mathbb{P}(E_{T_{1}+\tau})\sum^{T}_{t=T_{1}+1}\mathbb{E}[r_{a_{n}(t)}|E_{T_{1}+\tau}]" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mi>τ</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><msub><mi>T</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><msub><mi>T</mi><mn>1</mn></msub></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{N}_{n=1}\sum^{T_{1}}_{\tau=1}\mathbb{P}(E_{\tau})\sum^{T_{1}}_{t=1}\mathbb{E}[r_{a_{n}(t)}|E_{\tau}]+\sum^{N}_{n=1}\mathbb{P}(\bar{E}_{T_{1}})\sum^{T_{1}}_{t=1}\mathbb{E}[r_{a_{n}(t)}|\bar{E}_{T_{1}}]+\sum^{N}_{n=1}\sum^{T-T_{1}}_{\tau=1}\mathbb{P}(E_{T_{1}+\tau})\sum^{T}_{t=T_{1}+1}\mathbb{E}[r_{a_{n}(t)}|E_{T_{1}+\tau}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex127.m1" class="ltx_math_unparsed" alttext="\displaystyle+\sum^{N}_{n=1}\mathbb{P}(\bar{E}_{T})\sum^{T}_{t=T_{1}+1}\mathbb{E}[r_{a_{n}(t)}|\bar{E}_{T}]." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></mrow><mi>T</mi></munderover></mstyle><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>r</mi><mrow><msub><mi>a</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mi>T</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\sum^{N}_{n=1}\mathbb{P}(\bar{E}_{T})\sum^{T}_{t=T_{1}+1}\mathbb{E}[r_{a_{n}(t)}|\bar{E}_{T}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p7.2" class="ltx_p">Conditioned on the event <math id="A6.p7.m21" class="ltx_Math" alttext="E_{\tau}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>τ</mi></msub><annotation encoding="application/x-tex">E_{\tau}</annotation></semantics></math>, each agent will explore for <math id="A6.p7.m22" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> time slots and then exploit for the remaining <math id="A6.p7.m23" class="ltx_Math" alttext="(T_{1}-\tau+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T_{1}-\tau+1)</annotation></semantics></math> time slots. Similarly, conditioned on the event <math id="A6.p7.m24" class="ltx_Math" alttext="E_{T_{1}+\tau}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><annotation encoding="application/x-tex">E_{T_{1}+\tau}</annotation></semantics></math>, each agent will explore for <math id="A6.p7.m25" class="ltx_Math" alttext="(\tau-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\tau-1)</annotation></semantics></math> time slots and exploit for the subsequent <math id="A6.p7.m26" class="ltx_Math" alttext="(T-T_{1}-\tau+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T-T_{1}-\tau+1)</annotation></semantics></math> time slots. Since the process is the same for all agents, we omit the superscript <math id="A6.p7.m27" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> in <math id="A6.p7.m28" class="ltx_Math" alttext="R^{n}_{i}" display="inline" intent=":literal"><semantics><msubsup><mi>R</mi><mi>i</mi><mi>n</mi></msubsup><annotation encoding="application/x-tex">R^{n}_{i}</annotation></semantics></math> in the following. Then</p>
<table id="A6.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex128.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex128.m2" class="ltx_Math" alttext="\displaystyle N\sum^{T_{1}}_{\tau=1}\mathbb{P}(E_{\tau})\left(\mu\tau+\mathbb{E}[\max_{i\in\{0,\ldots,i-1\}}R_{i}|E_{\tau}](T_{1}-\tau+1)\right)+N\mathbb{P}(\bar{E}_{T_{1}})\mu(T_{1}+1)+N\mathbb{P}(E_{T_{1}+1})\mathbb{E}[\max_{n\in\mathcal{N}}\{m_{n}(T_{1})\}|E_{T_{1}+1}](T-T_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>τ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo>+</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></munder><mo lspace="0.167em">⁡</mo><msub><mi>R</mi><mi>i</mi></msub></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mi>τ</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><msub><mi>T</mi><mn>1</mn></msub></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>m</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N\sum^{T_{1}}_{\tau=1}\mathbb{P}(E_{\tau})\left(\mu\tau+\mathbb{E}[\max_{i\in\{0,\ldots,i-1\}}R_{i}|E_{\tau}](T_{1}-\tau+1)\right)+N\mathbb{P}(\bar{E}_{T_{1}})\mu(T_{1}+1)+N\mathbb{P}(E_{T_{1}+1})\mathbb{E}[\max_{n\in\mathcal{N}}\{m_{n}(T_{1})\}|E_{T_{1}+1}](T-T_{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex129.m1" class="ltx_math_unparsed" alttext="\displaystyle+N\sum^{T-T_{1}-1}_{\tau=1}\mathbb{P}(E_{T_{1}+\tau+1})\left(\mu\tau+\mathbb{E}[\max_{n\in\mathcal{N},\tau\in\{1,\ldots,\tau\}}\{m_{n}(T_{1}),R_{T_{1}+\tau}\}|E_{T_{1}+\tau+1}](T-T_{1}-\tau)\right)+N\mathbb{P}(\bar{E}_{T})\mu(T-T_{1})" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>N</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><mi>μ</mi><mi>τ</mi><mo>+</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><munder><mi>max</mi><mrow><mrow><mi>n</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo>,</mo><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>τ</mi><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mrow><mo stretchy="false">{</mo><msub><mi>m</mi><mi>n</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>R</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo stretchy="false">}</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>E</mi><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>+</mo><mi>N</mi><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>E</mi><mo>¯</mo></mover><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+N\sum^{T-T_{1}-1}_{\tau=1}\mathbb{P}(E_{T_{1}+\tau+1})\left(\mu\tau+\mathbb{E}[\max_{n\in\mathcal{N},\tau\in\{1,\ldots,\tau\}}\{m_{n}(T_{1}),R_{T_{1}+\tau}\}|E_{T_{1}+\tau+1}](T-T_{1}-\tau)\right)+N\mathbb{P}(\bar{E}_{T})\mu(T-T_{1})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex130.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex130.m2" class="ltx_Math" alttext="\displaystyle N\sum^{T_{1}}_{\tau=1}\left(\left(F(u_{\tau-1}(T_{1}))^{\tau-1}-F(u_{\tau}(T_{1}))^{\tau}\right)\mu\tau+\left(\int^{u_{\tau-1}(T_{1})}_{u_{\tau}(T_{1})}rdF(r)^{\tau}+F(u_{\tau-1}(T_{1}))^{\tau-1}\int^{1}_{u_{\tau-1}(T_{1})}rdF(r)\right)(T_{1}-\tau+1)\right)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>−</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>τ</mi></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>u</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>τ</mi></msup></mrow></mrow><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N\sum^{T_{1}}_{\tau=1}\left(\left(F(u_{\tau-1}(T_{1}))^{\tau-1}-F(u_{\tau}(T_{1}))^{\tau}\right)\mu\tau+\left(\int^{u_{\tau-1}(T_{1})}_{u_{\tau}(T_{1})}rdF(r)^{\tau}+F(u_{\tau-1}(T_{1}))^{\tau-1}\int^{1}_{u_{\tau-1}(T_{1})}rdF(r)\right)(T_{1}-\tau+1)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
