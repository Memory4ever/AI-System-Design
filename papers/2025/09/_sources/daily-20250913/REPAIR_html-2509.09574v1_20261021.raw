gg(\bar{u}_{T_{1}+j+1}P(\bar{u}_{T_{1}+j+1})^{N-1}F(\bar{u}_{T_{1}+j})^{j}+\int^{\bar{u}_{T_{1}+j}}_{\bar{u}_{T_{1}+j+1}}P(r)^{N-1}F(r)^{j+1}dr\bigg)(T-T_{1}-j)\right]</annotation></semantics></math></td>
