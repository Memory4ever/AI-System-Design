<tbody id="A6.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex135.m1" class="ltx_math_unparsed" alttext="\displaystyle+N\int^{1}_{\bar{u}_{T_{1}+1}}rdP(r)^{N}(T-T_{1})+N\sum^{T-T_{1}-1}_{\tau=1}\bigg(\left(P(\bar{u}_{T_{1}+\tau})^{N}F(\bar{u}_{T_{1}+\tau})^{\tau-1}-P(\bar{u}_{T_{1}+\tau+1})^{N}F(\bar{u}_{T_{1}+\tau+1})^{\tau}\right)\mu\tau" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>N</mi><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mn>1</mn></mrow></msub><mn>1</mn></msubsup></mstyle><mi>r</mi><mi>d</mi><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>N</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mo>(</mo><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>−</mo><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>τ</mi></msup><mo>)</mo></mrow><mi>μ</mi><mi>τ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+N\int^{1}_{\bar{u}_{T_{1}+1}}rdP(r)^{N}(T-T_{1})+N\sum^{T-T_{1}-1}_{\tau=1}\bigg(\left(P(\bar{u}_{T_{1}+\tau})^{N}F(\bar{u}_{T_{1}+\tau})^{\tau-1}-P(\bar{u}_{T_{1}+\tau+1})^{N}F(\bar{u}_{T_{1}+\tau+1})^{\tau}\right)\mu\tau</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex136.m1" class="ltx_Math" alttext="\displaystyle+\bigg(P(\bar{u}_{T_{1}+\tau})^{N}F(\bar{u}_{T_{1}+\tau})^{\tau-1}\left(1-\int^{1}_{\bar{u}_{T_{1}+\tau}}F(r)dr\right)-\bar{u}_{T_{1}+\tau+1}P(\bar{u}_{T_{1}+\tau+1})^{N}F(\bar{u}_{T_{1}+\tau+1})^{\tau}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mi>τ</mi></msup></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\bigg(P(\bar{u}_{T_{1}+\tau})^{N}F(\bar{u}_{T_{1}+\tau})^{\tau-1}\left(1-\int^{1}_{\bar{u}_{T_{1}+\tau}}F(r)dr\right)-\bar{u}_{T_{1}+\tau+1}P(\bar{u}_{T_{1}+\tau+1})^{N}F(\bar{u}_{T_{1}+\tau+1})^{\tau}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex137.m1" class="ltx_math_unparsed" alttext="\displaystyle-\int^{\bar{u}_{T_{1}+\tau}}_{\bar{u}_{T_{1}+\tau+1}}P(r)^{N}F(r)^{t}dr\bigg)(T-T_{1}-\tau)\bigg)+NP(\bar{u}_{T})^{N}F(\bar{u}_{T})^{T-T_{1}-1}\mu(T-T_{1})." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi><mo>+</mo><mn>1</mn></mrow></msub><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub></msubsup></mstyle><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mi>d</mi><mi>r</mi><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo><mo>+</mo><mi>N</mi><mi>P</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mi>N</mi></msup><mi>F</mi><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mi>T</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></msup><mi>μ</mi><mo stretchy="false">(</mo><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\int^{\bar{u}_{T_{1}+\tau}}_{\bar{u}_{T_{1}+\tau+1}}P(r)^{N}F(r)^{t}dr\bigg)(T-T_{1}-\tau)\bigg)+NP(\bar{u}_{T})^{N}F(\bar{u}_{T})^{T-T_{1}-1}\mu(T-T_{1}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p7.4" class="ltx_p">Replace <math id="A6.p7.m31" class="ltx_Math" alttext="\left(1-\int^{1}_{\bar{u}_{T_{1}+\tau}}F(r)dr\right)(T-T_{1}-\tau)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo rspace="0.055em">−</mo><mrow><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mn>1</mn></msubsup><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\left(1-\int^{1}_{\bar{u}_{T_{1}+\tau}}F(r)dr\right)(T-T_{1}-\tau)</annotation></semantics></math> in the last sentence by the part in equation (<a href="#S4.E23" title="In Proposition 4.3. ‣ 4.2. Optimal Decentralized Communication Mechanism ‣ 4. Dcentralized Communication Mechanism for Non-myopic Agents ‣ Human-in-the-loop Learning Through Decentralized Communication Mechanisms" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) as</p>
<table id="A6.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex139.m1" class="ltx_Math" alttext="\displaystyle\left(1-\int^{1}_{\bar{u}_{T_{1}+\tau}}F(r)dr\right)(T-T_{1}-\tau)=\bar{u}_{T_{1}+\tau}(T-T_{1}-\tau+1)-\mu," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mn>1</mn></msubsup></mstyle><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>r</mi></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>u</mi><mo>¯</mo></mover><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>+</mo><mi>τ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>μ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(1-\int^{1}_{\bar{u}_{T_{1}+\tau}}F(r)dr\right)(T-T_{1}-\tau)=\bar{u}_{T_{1}+\tau}(T-T_{1}-\tau+1)-\mu,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p7.5" class="ltx_p">then we have</p>
<table id="A6.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex140.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex140.m2" class="ltx_Math" alttext="\displaystyle N\sum^{T_{1}}_{\tau=0}F(u_{\tau}(T_{1}))^{\tau}\mu+N\sum^{T_{1}}_{\tau=1}\left(\int^{u_{\tau-1}(T_{1})}_{u_{\tau}(T_{1})}rdF(r)^{\tau}+F(u_{\tau-1}(T_{1}))^{\tau-1}\int^{1}_{u_{\tau-1}(T_{1})}rdF(r)\right)(T_{1}-\tau+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow><mo>+</mo><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>T</mi><mn>1</mn></msub></munderover></mstyle><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mi>τ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>u</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mi>τ</mi></msup></mrow></mrow><mo>+</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><msub><mi>u</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mn>1</mn></msubsup></mstyle><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>−</mo><mi>τ</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle N\sum^{T_{1}}_{\tau=0}F(u_{\tau}(T_{1}))^{\tau}\mu+N\sum^{T_{1}}_{\tau=1}\left(\int^{u_{\tau-1}(T_{1})}_{u_{\tau}(T_{1})}rdF(r)^{\tau}+F(u_{\tau-1}(T_{1}))^{\tau-1}\int^{1}_{u_{\tau-1}(T_{1})}rdF(r)\right)(T_{1}-\tau+1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
