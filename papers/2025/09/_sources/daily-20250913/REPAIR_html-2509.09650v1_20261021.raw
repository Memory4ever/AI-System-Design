<th id="S4.T4.2.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt" colspan="2"><math id="S4.T4.m1" class="ltx_Math" alttext="A+B+C" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>+</mo><mi>B</mi><mo>+</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">A+B+C</annotation></semantics></math></th>
<th id="S4.T4.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt" colspan="2"><math id="S4.T4.m2" class="ltx_Math" alttext="A+B-C" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>+</mo><mi>B</mi></mrow><mo>−</mo><mi>C</mi></mrow><annotation encoding="application/x-tex">A+B-C</annotation></semantics></math></th></tr>
