<td id="S1.T1.24.1.14.1" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t"><span id="S1.T1.24.1.14.1.1" class="ltx_text" style="position:relative; bottom:-0.2pt;"><img src="2509.09584v1/figures/icons/friends.png" id="S1.T1.g25" class="ltx_graphics ltx_img_square" style="aspect-ratio:18/19;" width="18" height="19" alt="[Uncaptioned image]"></span>
<span id="S1.T1.24.1.14.1.2" class="ltx_text ltx_font_sansserif">Talk2Event</span></td>
<td id="S1.T1.24.1.14.2" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t"><span id="S1.T1.24.1.14.2.1" class="ltx_text ltx_font_bold">Ours</span></td>
<td id="S1.T1.24.1.14.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t"><span id="S1.T1.24.1.14.3.1" class="ltx_text" style="position:relative; bottom:-0.2pt;"><img src="2509.09584v1/figures/icons/frame.png" id="S1.T1.g26" class="ltx_graphics ltx_img_square" style="aspect-ratio:18/15;" width="18" height="15" alt="[Uncaptioned image]"></span> <span id="S1.T1.24.1.14.3.2" class="ltx_text" style="position:relative; bottom:-0.2pt;"><img src="2509.09584v1/figures/icons/event-camera.png" id="S1.T1.g27" class="ltx_graphics ltx_img_square" style="aspect-ratio:17/14;" width="17" height="14" alt="[Uncaptioned image]"></span> <span id="S1.T1.24.1.14.3.3" class="ltx_text" style="position:relative; bottom:-0.3pt;"><img src="2509.09584v1/figures/icons/lidar.png" id="S1.T1.g28" class="ltx_graphics ltx_img_square" style="aspect-ratio:18/16;" width="18" height="16" alt="[Uncaptioned image]"></span></td>
<td id="S1.T1.24.1.14.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t"><span id="S1.T1.24.1.14.4.1" class="ltx_text ltx_font_bold">Dynamic</span></td>
<td id="S1.T1.24.1.14.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S1.T1.m55" class="ltx_Math" alttext="\mathbf{5{,}567}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">5,567</mn><annotation encoding="application/x-tex">\mathbf{5{,}567}</annotation></semantics></math></td>
<td id="S1.T1.24.1.14.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S1.T1.m56" class="ltx_Math" alttext="\mathbf{13{,}458}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">13,458</mn><annotation encoding="application/x-tex">\mathbf{13{,}458}</annotation></semantics></math></td>
<td id="S1.T1.24.1.14.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S1.T1.m57" class="ltx_Math" alttext="\mathbf{30{,}690}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">30,690</mn><annotation encoding="application/x-tex">\mathbf{30{,}690}</annotation></semantics></math></td>
<td id="S1.T1.24.1.14.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t"><math id="S1.T1.m58" class="ltx_Math" alttext="\mathbf{34.1}" display="inline" intent=":literal"><semantics><mn class="ltx_mathvariant_bold" mathvariant="bold">34.1</mn><annotation encoding="application/x-tex">\mathbf{34.1}</annotation></semantics></math></td>
<td id="S1.T1.24.1.14.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S1.T1.24.1.14.9.1" class="ltx_text" style="--ltx-fg-color:#00B48B;">✓</span></td>
