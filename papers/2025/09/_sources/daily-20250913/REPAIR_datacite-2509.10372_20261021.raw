{"data":{"id":"10.48550/arxiv.2509.10372","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10372","prefix":"10.48550","suffix":"arxiv.2509.10372","identifiers":[{"identifier":"2509.10372","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.10372"}],"creators":[{"name":"Wang, Huizheng","nameType":"Personal","givenName":"Huizheng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zichuan","nameType":"Personal","givenName":"Zichuan","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Yue, Zhiheng","nameType":"Personal","givenName":"Zhiheng","familyName":"Yue","affiliation":[],"nameIdentifiers":[]},{"name":"Long, Yousheng","nameType":"Personal","givenName":"Yousheng","familyName":"Long","affiliation":[],"nameIdentifiers":[]},{"name":"Wei, Taiquan","nameType":"Personal","givenName":"Taiquan","familyName":"Wei","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Jianxun","nameType":"Personal","givenName":"Jianxun","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yang","nameType":"Personal","givenName":"Yang","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Chao","nameType":"Personal","givenName":"Chao","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Wei, Shaojun","nameType":"Personal","givenName":"Shaojun","familyName":"Wei","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Yang","nameType":"Personal","givenName":"Yang","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Yin, Shouyi","nameType":"Personal","givenName":"Shouyi","familyName":"Yin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MCBP: A Memory-Compute Efficient LLM Inference Accelerator Leveraging Bit-Slice-enabled Sparsity and Repetitiveness"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T16:05:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-15T00:43:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large language models (LLMs) face significant inference latency due to inefficiencies in GEMM operations, weight access, and KV cache access, especially in real-time scenarios. This highlights the need for a versatile compute-memory efficient accelerator. Unfortunately, existing Transformer accelerators struggle to address both aspects simultaneously, as they focus on value-level processing, missing fine-grained opportunities to optimize computation and memory collaboratively. This paper introduces MCBP, a bit-grained compute-memory efficient algorithm-hardware co-design that leverages bit-slice (BS) enabled repetitiveness and sparsity to accelerate LLM inference. MCBP features three key innovations: 1) BS-repetitiveness-enabled computation reduction (BRCR), which eliminates redundant GEMM computations via leveraging redundancy hidden among BS vectors; 2) BS-sparsity-enabled two-state coding (BSTC), which reduces weight access via exploiting significant sparsity in high-order bit-slice weight; 3) Bit-grained progressive prediction (BGPP), which reduces KV cache access by leveraging early-termination-based bit-grained prediction. These techniques, supported by custom accelerator designs, effectively alleviate the burden in GEMM, weight access, and KV cache access. Extensive experiments on 26 benchmarks show that MCBP achieves 9.43x speed up and 31.1x higher energy efficiency than Nvidia A100 GPU. Compared to SOTA Transformer accelerators, MCBP achieves 35x, 5.2x and 3.2x energy saving than Spatten, FACT and SOFA, respectively.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.10372","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-15T01:33:27.000Z","registered":"2025-09-15T01:33:28.000Z","published":"2025","updated":"2025-09-15T01:33:28.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.10372","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}