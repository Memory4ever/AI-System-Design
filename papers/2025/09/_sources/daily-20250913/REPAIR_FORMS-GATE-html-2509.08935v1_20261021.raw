<td id="S4.T2.1.1.3.1" class="ltx_td ltx_align_left ltx_border_b">Post-contrast</td>
<td id="S4.T2.1.1.3.2" class="ltx_td ltx_align_center ltx_border_b">0.720</td>
<td id="S4.T2.1.1.3.3" class="ltx_td ltx_align_center ltx_border_b">0.878</td>
