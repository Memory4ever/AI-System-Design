{"data":{"id":"10.48550/arxiv.2509.09774","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.09774","prefix":"10.48550","suffix":"arxiv.2509.09774","identifiers":[{"identifier":"2509.09774","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.09774"}],"creators":[{"name":"Popovici, Doru Thom","nameType":"Personal","givenName":"Doru Thom","familyName":"Popovici","affiliation":[],"nameIdentifiers":[]},{"name":"Vega, Mario","nameType":"Personal","givenName":"Mario","familyName":"Vega","affiliation":[],"nameIdentifiers":[]},{"name":"Ioannou, Angelos","nameType":"Personal","givenName":"Angelos","familyName":"Ioannou","affiliation":[],"nameIdentifiers":[]},{"name":"Chaix, Fabien","nameType":"Personal","givenName":"Fabien","familyName":"Chaix","affiliation":[],"nameIdentifiers":[]},{"name":"Mosuli, Dania","nameType":"Personal","givenName":"Dania","familyName":"Mosuli","affiliation":[],"nameIdentifiers":[]},{"name":"Reasoner, Blair","nameType":"Personal","givenName":"Blair","familyName":"Reasoner","affiliation":[],"nameIdentifiers":[]},{"name":"Nguyen, Tan","nameType":"Personal","givenName":"Tan","familyName":"Nguyen","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Xiaokun","nameType":"Personal","givenName":"Xiaokun","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Shalf, John","nameType":"Personal","givenName":"John","familyName":"Shalf","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards An Approach to Identify Divergences in Hardware Designs for HPC Workloads"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-11T18:10:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-15T00:02:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Developing efficient hardware accelerators for mathematical kernels used in scientific applications and machine learning has traditionally been a labor-intensive task. These accelerators typically require low-level programming in Verilog or other hardware description languages, along with significant manual optimization effort. Recently, to alleviate this challenge, high-level hardware design tools like Chisel and High-Level Synthesis have emerged. However, as with any compiler, some of the generated hardware may be suboptimal compared to expert-crafted designs. Understanding where these inefficiencies arise is crucial, as it provides valuable insights for both users and tool developers. In this paper, we propose a methodology to hierarchically decompose mathematical kernels - such as Fourier transforms, matrix multiplication, and QR factorization - into a set of common building blocks or primitives. Then the primitives are implemented in the different programming environments, and the larger algorithms get assembled. Furthermore, we employ an automatic approach to investigate the achievable frequency and required resources. Performing this experimentation at each level will provide fairer comparisons between designs and offer guidance for both tool developers and hardware designers to adopt better practices.","descriptionType":"Abstract"},{"description":"9 pages, 8 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.09774","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-15T01:19:18.000Z","registered":"2025-09-15T01:19:19.000Z","published":"2025","updated":"2025-09-15T01:19:19.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.09774","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}