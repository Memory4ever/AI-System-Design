<td id="S3.T2.4.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.4.1.2.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">30</span></td>
<td id="S3.T2.4.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.4.1.2.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">510</span></td></tr>
