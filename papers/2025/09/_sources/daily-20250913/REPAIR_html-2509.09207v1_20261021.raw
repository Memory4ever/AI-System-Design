<td id="S5.T3.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">5.97%</td>
<td id="S5.T3.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">94.31%</td>
<td id="S5.T3.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">41.28</td>
