<span id="A5.T12.4.1.6.2.1.1" class="ltx_p ltx_align_center"><span id="A5.T12.4.1.6.2.1.1.1" class="ltx_text" style="font-size:80%;">OS-level packages to be installed via package manager (e.g., </span><span id="A5.T12.4.1.6.2.1.1.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;">nmap</span><span id="A5.T12.4.1.6.2.1.1.3" class="ltx_text" style="font-size:80%;">, </span><span id="A5.T12.4.1.6.2.1.1.4" class="ltx_text ltx_font_typewriter" style="font-size:80%;">build-essential</span><span id="A5.T12.4.1.6.2.1.1.5" class="ltx_text" style="font-size:80%;">).</span></span>
</span></td></tr>
<tr id="A5.T12.4.1.7" class="ltx_tr">
<td id="A5.T12.4.1.7.1" class="ltx_td ltx_align_left ltx_align_top">
