<td id="S3.T2.4.1.3.2" class="ltx_td ltx_align_center"><span id="S3.T2.4.1.3.2.1" class="ltx_text" style="font-size:90%;">CTF Flag</span></td>
<td id="S3.T2.4.1.3.3" class="ltx_td ltx_align_center"><span id="S3.T2.4.1.3.3.1" class="ltx_text" style="font-size:90%;">Extra Hints</span></td>
