<span id="A3.SS3.p2.pic1.1.5" class="ltx_block ltx_minipage ltx_align_center ltx_align_middle" style="width:146.5pt;"><img src="2509.09332v1/images/where2xx-examples/where2approach_2_mask.png" id="A3.SS3.p2.pic1.g4" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:202/152;" width="202" height="152" alt="[Uncaptioned image]">
</span>
