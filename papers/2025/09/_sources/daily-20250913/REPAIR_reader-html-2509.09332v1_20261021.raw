<td id="A1.T5.2.12.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">true</td></tr>
<tr id="A1.T5.2.13" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="A1.T5.2.13.1" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.13.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">use fp16</span></td>
<td id="A1.T5.2.13.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.13.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">false</span></td>
<td id="A1.T5.2.13.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.13.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">false</span></td>
<td id="A1.T5.2.13.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.13.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">false</span></td></tr>
<tr id="A1.T5.2.14" class="ltx_tr">
<td id="A1.T5.2.14.1" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">warmup ratio</td>
<td id="A1.T5.2.14.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">1e-3</td>
<td id="A1.T5.2.14.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">1e-3</td>
<td id="A1.T5.2.14.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">0.0</td></tr>
<tr id="A1.T5.2.15" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="A1.T5.2.15.1" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.15.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">optimizer</span></td>
<td id="A1.T5.2.15.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.15.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">AdamW</span></td>
<td id="A1.T5.2.15.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.15.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">AdamW</span></td>
<td id="A1.T5.2.15.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.15.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">AdamW</span></td></tr>
<tr id="A1.T5.2.16" class="ltx_tr">
<td id="A1.T5.2.16.1" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">image resolution</td>
