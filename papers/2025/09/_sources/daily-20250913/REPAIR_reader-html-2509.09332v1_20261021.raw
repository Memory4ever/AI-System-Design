<div id="A5.SS1.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A5.SS1.p3.pic1" class="ltx_picture" height="996.79" overflow="visible" version="1.1" viewBox="0 0 550 996.79" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,996.79) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#F9F2EC;" fill="#F9F2EC" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 990.88 C 0 994.14 2.64 996.79 5.91 996.79 L 544.09 996.79 C 547.36 996.79 550 994.14 550 990.88 L 550 5.91 C 550 2.64 547.36 0 544.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FEFEFD;" fill="#FEFEFD" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 972.68 L 548.03 972.68 L 548.03 5.91 C 548.03 3.73 546.27 1.97 544.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 981.27)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
