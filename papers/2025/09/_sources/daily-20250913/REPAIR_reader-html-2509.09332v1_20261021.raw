<td id="A1.T5.2.16.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">448×448</td>
<td id="A1.T5.2.16.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;">448×448</td></tr>
<tr id="A1.T5.2.17" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="A1.T5.2.17.1" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.17.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">video frames (training)</span></td>
<td id="A1.T5.2.17.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.17.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">16</span></td>
<td id="A1.T5.2.17.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.17.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">16</span></td>
<td id="A1.T5.2.17.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.17.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">16</span></td></tr>
