</span>
<span id="A4.SS1.p2.pic1.1.1.5" class="ltx_block ltx_minipage ltx_align_middle" style="width:113.5pt;"><img src="2509.09332v1/images/sim_downstream/mobile_placement_easy_9.png" id="A4.SS1.p2.pic1.g5" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:157/118;" width="157" height="118" alt="[Uncaptioned image]">
</span>
<span id="A4.SS1.p2.pic1.1.1.6" class="ltx_block ltx_minipage ltx_align_middle" style="width:113.5pt;"><img src="2509.09332v1/images/sim_downstream/mobile_placement_easy_11.png" id="A4.SS1.p2.pic1.g6" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:157/119;" width="157" height="119" alt="[Uncaptioned image]">
