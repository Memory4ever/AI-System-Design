<td id="A1.T5.2.11.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.11.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">1.0</span></td>
<td id="A1.T5.2.11.4" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.2.11.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">1.0</span></td></tr>
