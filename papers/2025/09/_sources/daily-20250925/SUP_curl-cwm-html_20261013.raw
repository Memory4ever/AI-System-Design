lass="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">return</span><span id="lstnumberx155.74" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx155.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">value</span><span id="lstnumberx155.76" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx155.77" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">is</span><span id="lstnumberx155.78" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx155.79" class="ltx_text ltx_font_typewriter" style="font-size:50%;">{1:</span><span id="lstnumberx155.80" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx155.81" class="ltx_text ltx_font_typewriter" style="font-size:50%;">2,</span><span id="lstnumberx155.82" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx155.83" class="ltx_text ltx_font_typewriter" style="font-size:50%;">2:</span><span id="lstnumberx155.84" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx155.85" class="ltx_text ltx_font_typewriter" style="font-size:50%;">4}.</span>
