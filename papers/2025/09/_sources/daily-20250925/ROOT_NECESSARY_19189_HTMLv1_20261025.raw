<th id="S1.T1.6.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" colspan="2">Data-Optimal Scaling Laws</th>
<th id="S1.T1.6.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2">Compute-Optimal Scaling Laws</th></tr>
<tr id="S1.T1.6.1.2" class="ltx_tr">
<th id="S1.T1.6.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Easy</th>
