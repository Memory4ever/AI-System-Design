<td id="A3.T2.7.9.6" class="ltx_td ltx_align_right"><span id="A3.T2.7.9.6.1" class="ltx_text" style="font-size:90%;">17.72</span></td></tr>
<tr id="A3.T2.7.10" class="ltx_tr">
