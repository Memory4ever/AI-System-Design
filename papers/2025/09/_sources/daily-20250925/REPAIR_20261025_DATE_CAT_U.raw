{"data":{"id":"10.48550/arxiv.2509.14234","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14234","prefix":"10.48550","suffix":"arxiv.2509.14234","identifiers":[{"identifier":"2509.14234","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.14234"}],"creators":[{"name":"Jayalath, Dulhan","nameType":"Personal","givenName":"Dulhan","familyName":"Jayalath","affiliation":[],"nameIdentifiers":[]},{"name":"Goel, Shashwat","nameType":"Personal","givenName":"Shashwat","familyName":"Goel","affiliation":[],"nameIdentifiers":[]},{"name":"Foster, Thomas","nameType":"Personal","givenName":"Thomas","familyName":"Foster","affiliation":[],"nameIdentifiers":[]},{"name":"Jain, Parag","nameType":"Personal","givenName":"Parag","familyName":"Jain","affiliation":[],"nameIdentifiers":[]},{"name":"Gururangan, Suchin","nameType":"Personal","givenName":"Suchin","familyName":"Gururangan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Cheng","nameType":"Personal","givenName":"Cheng","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Goyal, Anirudh","nameType":"Personal","givenName":"Anirudh","familyName":"Goyal","affiliation":[],"nameIdentifiers":[]},{"name":"Schelten, Alan","nameType":"Personal","givenName":"Alan","familyName":"Schelten","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Compute as Teacher: Turning Inference Compute Into Reference-Free Supervision"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T17:59:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:58:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-01T13:13:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T02:10:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-09T12:06:02Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-12T00:44:18Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Where do learning signals come from when there is no ground truth in post-training? We show that inference compute itself can serve as supervision. By generating parallel rollouts and converting them into reference estimates, models can learn without human labels-critically, even in non-verifiable domains like healthcare guidance where no programmatic checker exists. We call this framework Compute as Teacher (CaT) and it turns inference-time compute from parallel rollouts into supervision for RL training. The framework has two components: (1) reference estimation which aggregates rollouts into a pseudo-reference answer, and (2) reward derivation which converts that pseudo-reference into RL rewards. For (1), we explore a simple method we call synthesis, but the framework admits any aggregator. For (2), we introduce self-proposed rubrics for non-verifiable domains. These are binary, auditable criteria generated from the pseudo-reference and scored by an LLM judge. On HealthBench, models trained with CaT match or exceed inference-time aggregation quality while using 9x less test-time compute. Here, CaT also competes with learning from expert physician annotations, yielding up to +30% relative improvement over the initial policy. The framework extends naturally to verifiable rewards, matching the best existing baselines on MATH-500 in test-time RL and demonstrating 'drop-in' versatility across both types of domains.","descriptionType":"Abstract"},{"description":"Published as a conference paper at ICML 2026. 23 pages, 6 figures, 12 tables","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.14234","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T18:17:59.000Z","registered":"2025-09-18T18:17:59.000Z","published":"2025","updated":"2026-05-12T05:02:51.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.14234","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}