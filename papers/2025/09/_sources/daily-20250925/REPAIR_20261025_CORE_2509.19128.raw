<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S2.F2.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.19128v1/figures/qwen_throughput.png" id="S2.F2.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:648/432;" width="648" height="432" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S2.F2.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S2.F2.sf1.4" class="ltx_text" style="font-size:90%;">Throughput vs batch size.</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
