  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2509.19017">arXiv:2509.19017</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.19017">pdf</a>, <a href="https://arxiv.org/ps/2509.19017">ps</a>, <a href="https://arxiv.org/format/2509.19017">other</a>]&nbsp;</span>
