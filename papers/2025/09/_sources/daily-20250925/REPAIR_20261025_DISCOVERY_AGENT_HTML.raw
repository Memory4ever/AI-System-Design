      <a href="/search/?searchtype=author&amp;query=Khatibi%2C+N+N">Nicole N Khatibi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Radamovich%2C+D+A">Daniil A. Radamovich</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Brenner%2C+M+P">Michael P. Brenner</a>
      
