<tr id="S3.T2.2.1.5" class="ltx_tr">
<th id="S3.T2.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">COT+ Agg</th>
<td id="S3.T2.2.1.5.2" class="ltx_td ltx_align_center">96.17%</td>
