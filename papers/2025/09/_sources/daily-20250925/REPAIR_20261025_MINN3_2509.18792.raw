<td id="A5.T6.2.19.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;" colspan="3"><span id="A5.T6.2.19.1.1" class="ltx_text ltx_font_bold">D. User Interaction Management</span></td></tr>
