        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.18088">pdf</a>, <a href="https://arxiv.org/ps/2509.18088">ps</a>, <a href="https://arxiv.org/format/2509.18088">other</a>]&nbsp;</span>
