      <a href="/search/?searchtype=author&amp;query=Hwang%2C+Y">Yeonjun Hwang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kang%2C+M">Minseok Kang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jihn%2C+I">Iiseo Jihn</a>, 
      
