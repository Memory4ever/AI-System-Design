        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.17544">pdf</a>, <a href="https://arxiv.org/ps/2509.17544">ps</a>, <a href="https://arxiv.org/format/2509.17544">other</a>]&nbsp;</span>
