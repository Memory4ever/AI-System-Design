  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2509.17442">arXiv:2509.17442</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.17442">pdf</a>, <a href="https://arxiv.org/ps/2509.17442">ps</a>, <a href="https://arxiv.org/format/2509.17442">other</a>]&nbsp;</span>
