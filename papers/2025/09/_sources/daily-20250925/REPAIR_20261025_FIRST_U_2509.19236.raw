{"data":{"id":"10.48550/arxiv.2509.19236","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.19236","prefix":"10.48550","suffix":"arxiv.2509.19236","identifiers":[{"identifier":"2509.19236","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.19236"}],"creators":[{"name":"Tian, Chunhao","nameType":"Personal","givenName":"Chunhao","familyName":"Tian","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yutong","nameType":"Personal","givenName":"Yutong","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Xuebo","nameType":"Personal","givenName":"Xuebo","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zhexuan","nameType":"Personal","givenName":"Zhexuan","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Liang","nameType":"Personal","givenName":"Liang","familyName":"Ding","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Miao","nameType":"Personal","givenName":"Miao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Min","nameType":"Personal","givenName":"Min","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgentInit: Initializing LLM-based Multi-Agent Systems via Diversity and Expertise Orchestration for Effective and Efficient Collaboration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T16:58:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-24T01:07:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Proper initialization is crucial for any system, particularly in multi-agent systems (MAS), where it plays a pivotal role in determining both the system's efficiency and effectiveness. However, existing MAS initialization methods do not fully account for the collaborative needs of the generated agents in subsequent stages. Inspired by the principles of effective team composition, we propose AgentInit, which aims to optimize the structure of agent teams. Specifically, in addition to multi-round interactions and reflections between agents during agent generation, AgentInit incorporates a Natural Language to Format mechanism to ensure consistency and standardization. Balanced team selection strategies using Pareto principles are subsequently applied to jointly consider agent team diversity and task relevance to promote effective and efficient collaboration and enhance overall system performance. Experiments show that AgentInit consistently outperforms state-of-the-art initialization methods and pre-defined strategies across various frameworks and tasks, achieving an overall performance improvement of up to 1.2 and 1.6, respectively, while also significantly reducing token consumption. Further analysis confirms its strong transferability to similar tasks and verifies the effectiveness of its key components, demonstrating its capability and adaptability as a reliable MAS initialization method. Source code and models are available at https://github.com/1737423697/AgentInit.","descriptionType":"Abstract"},{"description":"EMNLP 2025 Findings","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.19236","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-24T02:17:18.000Z","registered":"2025-09-24T02:17:19.000Z","published":"2025","updated":"2025-09-24T02:17:19.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.19236","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}