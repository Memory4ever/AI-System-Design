        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.18771">pdf</a>, <a href="https://arxiv.org/ps/2509.18771">ps</a>, <a href="https://arxiv.org/format/2509.18771">other</a>]&nbsp;</span>
