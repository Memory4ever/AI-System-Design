      <a href="/search/?searchtype=author&amp;query=Mir%2C+T+H">Tatheer Hussain Mir</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+K">Kuang-Te Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Su%2C+M">Min-I Su</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+P">Pei-Kang Liu</a>, 
      
