    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2510.01236">arXiv:2510.01236</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2510.01236">pdf</a>, <a href="https://arxiv.org/ps/2510.01236">ps</a>, <a href="https://arxiv.org/format/2510.01236">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
        <span class="tag is-small is-link tooltip is-tooltip-top" data-tooltip="Computation and Language">cs.CL</span>
        
          
