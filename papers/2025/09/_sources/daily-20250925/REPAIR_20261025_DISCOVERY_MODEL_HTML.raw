        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.18570">pdf</a>, <a href="https://arxiv.org/ps/2509.18570">ps</a>, <a href="https://arxiv.org/format/2509.18570">other</a>]&nbsp;</span>
