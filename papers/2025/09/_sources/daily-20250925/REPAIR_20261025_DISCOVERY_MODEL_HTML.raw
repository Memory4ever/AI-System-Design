      <a href="/search/?searchtype=author&amp;query=Yu%2C+J">Jianwei Yu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yuan%2C+J">Jialing Yuan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+X">Xiaoyue Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=He%2C+C">Cheng He</a>, 
      
