      <a href="/search/?searchtype=author&amp;query=Shi%2C+K">Kaiwen Shi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ma%2C+Y">Yijun Ma</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Song%2C+W">Wei Song</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Abbasi%2C+A">Ahmed Abbasi</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cheng%2C+Y">Ying Cheng</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cleland-Huang%2C+J">Jane Cleland-Huang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Corcelli%2C+S">Steven Corcelli</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Goulding%2C+R">Robert Goulding</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hu%2C+M">Ming Hu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hua%2C+T">Ting Hua</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lalor%2C+J">John Lalor</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+F">Fang Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Luo%2C+T">Tengfei Luo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Maginn%2C+E">Edward Maginn</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Moniz%2C+N">Nuno Moniz</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Rohr%2C+J">Jason Rohr</a>, 
      
