        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.19044">pdf</a>, <a href="https://arxiv.org/ps/2509.19044">ps</a>, <a href="https://arxiv.org/format/2509.19044">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
