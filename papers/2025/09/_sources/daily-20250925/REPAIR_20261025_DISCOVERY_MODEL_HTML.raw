    <p class="title is-5 mathjax">
      
        Digital Twins as Funhouse Mirrors: Five Key Distortions
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Peng%2C+T">Tianyi Peng</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gui%2C+G">George Gui</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Brucks%2C+M">Melanie Brucks</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Merlau%2C+D+J">Daniel J. Merlau</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fan%2C+G+J">Grace Jiarui Fan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sliman%2C+M+B">Malek Ben Sliman</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Johnson%2C+E+J">Eric J. Johnson</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Althenayyan%2C+A">Abdullah Althenayyan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Bellezza%2C+S">Silvia Bellezza</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Donati%2C+D">Dante Donati</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fong%2C+H">Hortense Fong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Friedman%2C+E">Elizabeth Friedman</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Guevara%2C+A">Ariana Guevara</a>, 
      
