      <a href="/search/?searchtype=author&amp;query=Oreshkin%2C+B">Boris Oreshkin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wilson%2C+A+G">Andrew Gordon Wilson</a>, 
      
