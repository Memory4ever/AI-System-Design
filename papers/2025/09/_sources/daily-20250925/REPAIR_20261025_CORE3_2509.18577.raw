<td id="S4.T2.5.1.8.8" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.8.8.1" class="ltx_text ltx_underline">3.70</span></td></tr>
<tr id="S4.T2.5.1.9" class="ltx_tr">
