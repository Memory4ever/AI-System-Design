<tr id="S4.T2.5.1.3" class="ltx_tr">
<td id="S4.T2.5.1.3.1" class="ltx_td ltx_align_left">       no-filter</td>
<td id="S4.T2.5.1.3.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><span id="S4.T2.5.1.3.2.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;">-</span></td>
<td id="S4.T2.5.1.3.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><span id="S4.T2.5.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;">5.78</span></td>
<td id="S4.T2.5.1.3.4" class="ltx_td ltx_align_center">5.52</td>
<td id="S4.T2.5.1.3.5" class="ltx_td ltx_align_center">0.44</td>
<td id="S4.T2.5.1.3.6" class="ltx_td ltx_align_center">6.14</td>
<td id="S4.T2.5.1.3.7" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.3.7.1" class="ltx_text ltx_font_bold">13.22</span></td>
<td id="S4.T2.5.1.3.8" class="ltx_td ltx_align_center">3.59</td></tr>
<tr id="S4.T2.5.1.4" class="ltx_tr">
<td id="S4.T2.5.1.4.1" class="ltx_td ltx_align_left">      DSIR</td>
<td id="S4.T2.5.1.4.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><span id="S4.T2.5.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;">4 hours</span></td>
<td id="S4.T2.5.1.4.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><span id="S4.T2.5.1.4.3.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;">7.56</span></td>
<td id="S4.T2.5.1.4.4" class="ltx_td ltx_align_center">7.03</td>
<td id="S4.T2.5.1.4.5" class="ltx_td ltx_align_center">6.84</td>
<td id="S4.T2.5.1.4.6" class="ltx_td ltx_align_center">7.31</td>
<td id="S4.T2.5.1.4.7" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.4.7.1" class="ltx_text ltx_underline">12.67</span></td>
<td id="S4.T2.5.1.4.8" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.4.8.1" class="ltx_text ltx_font_bold">3.97</span></td></tr>
<tr id="S4.T2.5.1.5" class="ltx_tr">
<td id="S4.T2.5.1.5.1" class="ltx_td ltx_align_left">      PPL-based</td>
<td id="S4.T2.5.1.5.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><math id="S4.T2.m1" class="ltx_Math" style="--ltx-bg-color:#D9D9D9;" alttext="216" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#D9D9D9;" mathbackground="#D9D9D9">216</mn><annotation encoding="application/x-tex">216</annotation></semantics></math><span id="S4.T2.5.1.5.2.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;"> GPU hours</span></td>
<td id="S4.T2.5.1.5.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><span id="S4.T2.5.1.5.3.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#D9D9D9;">8.22</span></td>
<td id="S4.T2.5.1.5.4" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.5.4.1" class="ltx_text ltx_font_bold">9.98</span></td>
<td id="S4.T2.5.1.5.5" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.5.5.1" class="ltx_text ltx_font_bold">11.91</span></td>
<td id="S4.T2.5.1.5.6" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.5.6.1" class="ltx_text ltx_underline">7.34</span></td>
<td id="S4.T2.5.1.5.7" class="ltx_td ltx_align_center">7.91</td>
<td id="S4.T2.5.1.5.8" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.5.8.1" class="ltx_text ltx_underline">3.96</span></td></tr>
<tr id="S4.T2.5.1.6" class="ltx_tr">
<td id="S4.T2.5.1.6.1" class="ltx_td ltx_align_left">      Prior-based (ours)</td>
<td id="S4.T2.5.1.6.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><span id="S4.T2.5.1.6.2.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;">0.25 hours</span></td>
