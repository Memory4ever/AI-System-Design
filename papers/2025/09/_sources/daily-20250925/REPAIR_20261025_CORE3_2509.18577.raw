<td id="A2.T6.7.1.2.2" class="ltx_td ltx_align_right ltx_border_t"><span id="A2.T6.7.1.2.2.1" class="ltx_text" style="font-size:120%;">0.7734</span></td>
<td id="A2.T6.7.1.2.3" class="ltx_td ltx_align_right ltx_border_t"><span id="A2.T6.7.1.2.3.1" class="ltx_text" style="font-size:120%;">0.8978</span></td></tr>
<tr id="A2.T6.7.1.3" class="ltx_tr">
<td id="A2.T6.7.1.3.1" class="ltx_td ltx_align_left"><span id="A2.T6.7.1.3.1.1" class="ltx_text" style="font-size:120%;">0.1</span></td>
<td id="A2.T6.7.1.3.2" class="ltx_td ltx_align_right"><span id="A2.T6.7.1.3.2.1" class="ltx_text" style="font-size:120%;">0.7558</span></td>
