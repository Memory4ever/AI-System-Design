<tr id="S4.T2.5.1.11" class="ltx_tr">
<td id="S4.T2.5.1.11.1" class="ltx_td ltx_align_left ltx_border_bb">      Prior-based (ours)</td>
<td id="S4.T2.5.1.11.2" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#D9D9D9;"><span id="S4.T2.5.1.11.2.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;">0.25 hours</span></td>
<td id="S4.T2.5.1.11.3" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#D9D9D9;"><span id="S4.T2.5.1.11.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#D9D9D9;">6.65</span></td>
