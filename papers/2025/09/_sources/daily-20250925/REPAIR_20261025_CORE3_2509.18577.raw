<tr id="A2.T6.7.1.4" class="ltx_tr">
<td id="A2.T6.7.1.4.1" class="ltx_td ltx_align_left"><span id="A2.T6.7.1.4.1.1" class="ltx_text" style="font-size:120%;">0.2</span></td>
<td id="A2.T6.7.1.4.2" class="ltx_td ltx_align_right"><span id="A2.T6.7.1.4.2.1" class="ltx_text" style="font-size:120%;">0.7332</span></td>
