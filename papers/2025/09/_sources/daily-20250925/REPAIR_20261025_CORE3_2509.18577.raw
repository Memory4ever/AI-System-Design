<td id="S4.T2.5.1.9.7" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.9.7.1" class="ltx_text ltx_underline">11.60</span></td>
<td id="S4.T2.5.1.9.8" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.9.8.1" class="ltx_text ltx_font_bold">3.80</span></td></tr>
<tr id="S4.T2.5.1.10" class="ltx_tr">
<td id="S4.T2.5.1.10.1" class="ltx_td ltx_align_left">      PPL-based</td>
<td id="S4.T2.5.1.10.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><math id="S4.T2.m2" class="ltx_Math" style="--ltx-bg-color:#D9D9D9;" alttext="216" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#D9D9D9;" mathbackground="#D9D9D9">216</mn><annotation encoding="application/x-tex">216</annotation></semantics></math><span id="S4.T2.5.1.10.2.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;"> GPU hours</span></td>
<td id="S4.T2.5.1.10.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><span id="S4.T2.5.1.10.3.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;">5.26</span></td>
