<td id="S4.T2.5.1.10.6" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.10.6.1" class="ltx_text ltx_underline">2.90</span></td>
<td id="S4.T2.5.1.10.7" class="ltx_td ltx_align_center">7.84</td>
