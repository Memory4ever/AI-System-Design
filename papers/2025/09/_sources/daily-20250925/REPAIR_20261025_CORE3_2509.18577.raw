<td id="S4.T2.5.1.9.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9D9D9;"><span id="S4.T2.5.1.9.3.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#D9D9D9;">5.60</span></td>
<td id="S4.T2.5.1.9.4" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.9.4.1" class="ltx_text ltx_font_bold">5.68</span></td>
