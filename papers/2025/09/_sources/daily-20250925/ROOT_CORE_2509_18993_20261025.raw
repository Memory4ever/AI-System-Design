<td id="A5.T17.2.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:7.0pt;padding-right:7.0pt;"><math id="A5.T17.m4" class="ltx_Math" alttext="[1.00,1.25)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1.00</mn><mo>,</mo><mn>1.25</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[1.00,1.25)</annotation></semantics></math></td></tr>
