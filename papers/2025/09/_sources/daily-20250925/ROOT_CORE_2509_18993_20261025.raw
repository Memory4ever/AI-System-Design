<tr id="A4.T9.2.4" class="ltx_tr">
<td id="A4.T9.2.4.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="--ltx-bg-color:#B3FFFF;"><span id="A4.T9.2.4.1.1" class="ltx_text ltx_font_italic" style="--ltx-bg-color:#B3FFFF;">CR-Net</span></td>
<td id="A4.T9.2.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#B3FFFF;"><span id="A4.T9.2.4.2.1" class="ltx_text" style="--ltx-bg-color:#B3FFFF;">19.20</span></td>
<td id="A4.T9.2.4.3" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#B3FFFF;"><span id="A4.T9.2.4.3.1" class="ltx_text" style="--ltx-bg-color:#B3FFFF;">15.52</span></td>
<td id="A4.T9.2.4.4" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#B3FFFF;"><span id="A4.T9.2.4.4.1" class="ltx_text" style="--ltx-bg-color:#B3FFFF;">15.22</span></td></tr>
</table>
</figure>
<figure id="A4.T10" class="ltx_table">
