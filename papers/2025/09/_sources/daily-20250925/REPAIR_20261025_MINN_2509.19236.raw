<span id="A1.F5.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:44.23em;">
<span id="A1.F5.pic1.1.1" class="ltx_p"><span id="A1.F5.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#FFFFFF;">Final Answer</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.59 29.32)"><foreignObject style="--ltx-fo-width:44.23em;--ltx-fo-height:0.61em;--ltx-fo-depth:1.2em;font-size:10pt;" height="25.06" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="612.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.F5.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:44.23em;">
<span id="A1.F5.pic1.2.1" class="ltx_p"><span id="A1.F5.pic1.2.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">B <span id="A1.F5.pic1.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#00A64F;">✓</span>
<span id="A1.F5.pic1.2.1.1.2" class="ltx_text ltx_font_serif">
</span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span>Case Study</figcaption>
</figure>
