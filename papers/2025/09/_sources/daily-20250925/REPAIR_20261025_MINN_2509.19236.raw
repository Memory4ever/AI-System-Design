            <math id="algorithm1.m10" class="ltx_Math" alttext="\{\hat{A}_{i}^{t}\}_{i=1}^{n_{t}}\leftarrow G_{f}(\{A_{i}^{t}\}_{i=1}^{n_{t}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>t</mi></msub></msubsup><mo stretchy="false">←</mo><mrow><msub><mi>G</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>A</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>t</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\hat{A}_{i}^{t}\}_{i=1}^{n_{t}}\leftarrow G_{f}(\{A_{i}^{t}\}_{i=1}^{n_{t}})</annotation></semantics></math>

</div>
<div id="algorithm1.4.12" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.12.1" class="ltx_text ltx_font_bold">6</span></span>
            <span id="algorithm1.4.12.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm1.4.12.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m11" class="ltx_Math" alttext="t&lt;K" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&lt;</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">t&lt;K</annotation></semantics></math></em> <span id="algorithm1.4.12.4" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="algorithm1.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.13.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">// </span><span id="algorithm1.4.13.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">Step 4: Observer provides feedback for the next round </span>
</div>
<div id="algorithm1.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.14.1" class="ltx_text ltx_font_bold">7</span></span>
            <math id="algorithm1.m12" class="ltx_Math" alttext="\phi^{t}\leftarrow G_{o}(\{\hat{A}_{i}^{t}\}_{i=1}^{n_{t}},\{\tau_{i}^{t}\}_{i=1}^{n_{t}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mi>t</mi></msup><mo stretchy="false">←</mo><mrow><msub><mi>G</mi><mi>o</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>t</mi></msub></msubsup><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>τ</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>t</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi^{t}\leftarrow G_{o}(\{\hat{A}_{i}^{t}\}_{i=1}^{n_{t}},\{\tau_{i}^{t}\}_{i=1}^{n_{t}})</annotation></semantics></math>

</div>
<div id="algorithm1.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
