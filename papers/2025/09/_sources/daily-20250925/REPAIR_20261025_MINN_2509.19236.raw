<div id="algorithm1.4.1" class="ltx_listingline"><span id="algorithm1.4.1.1" class="ltx_text"><span id="algorithm1.4.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>Query <math id="algorithm1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>
</div>
