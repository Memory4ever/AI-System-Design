</div>
<div id="algorithm1.4.4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.4.1" class="ltx_text ltx_font_bold">1</span></span>
            <math id="algorithm1.m3" class="ltx_Math" alttext="\tau^{0}\leftarrow\texttt{None}" display="inline" intent=":literal"><semantics><mrow><msup><mi>τ</mi><mn>0</mn></msup><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">None</mtext></mrow><annotation encoding="application/x-tex">\tau^{0}\leftarrow\texttt{None}</annotation></semantics></math>, <math id="algorithm1.m4" class="ltx_Math" alttext="\hat{A}^{0}\leftarrow\texttt{None}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>A</mi><mo>^</mo></mover><mn>0</mn></msup><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">None</mtext></mrow><annotation encoding="application/x-tex">\hat{A}^{0}\leftarrow\texttt{None}</annotation></semantics></math>, <math id="algorithm1.m5" class="ltx_Math" alttext="\phi^{0}\leftarrow\texttt{None}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ϕ</mi><mn>0</mn></msup><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">None</mtext></mrow><annotation encoding="application/x-tex">\phi^{0}\leftarrow\texttt{None}</annotation></semantics></math>

</div>
<div id="algorithm1.4.5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.5.1" class="ltx_text ltx_font_bold">2</span></span>
            <span id="algorithm1.4.5.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.5.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m6" class="ltx_Math" alttext="t\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t\leftarrow 1</annotation></semantics></math> <span id="algorithm1.4.5.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm1.m7" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math></em> <span id="algorithm1.4.5.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.6.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">// </span><span id="algorithm1.4.6.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">Step 1: Task decomposition based on query and previous feedback </span>
</div>
<div id="algorithm1.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.7.1" class="ltx_text ltx_font_bold">3</span></span>
            <math id="algorithm1.m8" class="ltx_Math" alttext="\{\tau_{i}^{t}\}_{i=1}^{n_{t}}\leftarrow G_{p_{1}}(q,\phi^{t-1},\{\tau_{i}^{t-1}\}_{i=1}^{n_{t-1}},\{\hat{A}_{i}^{t-1}\}_{i=1}^{n_{t-1}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>τ</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>t</mi></msub></msubsup><mo stretchy="false">←</mo><mrow><msub><mi>G</mi><msub><mi>p</mi><mn>1</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><msup><mi>ϕ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>τ</mi><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>i</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{\tau_{i}^{t}\}_{i=1}^{n_{t}}\leftarrow G_{p_{1}}(q,\phi^{t-1},\{\tau_{i}^{t-1}\}_{i=1}^{n_{t-1}},\{\hat{A}_{i}^{t-1}\}_{i=1}^{n_{t-1}})</annotation></semantics></math>

</div>
<div id="algorithm1.4.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.8.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">// </span><span id="algorithm1.4.8.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">Step 2: Generate natural language agent for each sub-task </span>
</div>
<div id="algorithm1.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.9.1" class="ltx_text ltx_font_bold">4</span></span>
            <math id="algorithm1.m9" class="ltx_Math" alttext="\{A_{i}^{t}\}_{i=1}^{n_{t}}\leftarrow G_{p_{2}}(\{\tau_{i}^{t}\}_{i=1}^{n_{t}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>A</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>t</mi></msub></msubsup><mo stretchy="false">←</mo><mrow><msub><mi>G</mi><msub><mi>p</mi><mn>2</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>τ</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>t</mi></msub></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{A_{i}^{t}\}_{i=1}^{n_{t}}\leftarrow G_{p_{2}}(\{\tau_{i}^{t}\}_{i=1}^{n_{t}})</annotation></semantics></math>

</div>
<div id="algorithm1.4.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="algorithm1.4.10.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">// </span><span id="algorithm1.4.10.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">Step 3: Convert agents into standardized format </span>
</div>
<div id="algorithm1.4.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
