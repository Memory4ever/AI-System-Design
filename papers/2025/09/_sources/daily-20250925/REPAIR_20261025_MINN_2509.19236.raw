<td id="S5.T5.2.1.4.1" class="ltx_td ltx_align_left"><math id="S5.T5.m3" class="ltx_Math" alttext="\text{AgentInit}_{(1,10)}" display="inline" intent=":literal"><semantics><msub><mtext>AgentInit</mtext><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>10</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\text{AgentInit}_{(1,10)}</annotation></semantics></math></td>
