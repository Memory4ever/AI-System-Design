            end if
</div>
<div id="algorithm1.4.16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.16.1" class="ltx_text ltx_font_bold">9</span></span>
            end for
</div>
<div id="algorithm1.4.17" class="ltx_listingline"><span id="algorithm1.4.17.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">// </span><span id="algorithm1.4.17.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">Final candidate agent set after <math id="algorithm1.m13" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#008080;" mathcolor="#008080">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> rounds </span>
</div>
<div id="algorithm1.4.18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.18.1" class="ltx_text ltx_font_bold">10</span></span>
            <math id="algorithm1.m14" class="ltx_Math" alttext="\mathcal{A}_{\text{candidate}}\leftarrow\{\hat{A}_{i}^{K}\}_{i=1}^{n_{K}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mtext>candidate</mtext></msub><mo stretchy="false">←</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>A</mi><mo>^</mo></mover><mi>i</mi><mi>K</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>n</mi><mi>K</mi></msub></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{A}_{\text{candidate}}\leftarrow\{\hat{A}_{i}^{K}\}_{i=1}^{n_{K}}</annotation></semantics></math>

</div>
<div id="algorithm1.4.19" class="ltx_listingline"><span id="algorithm1.4.19.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">// </span><span id="algorithm1.4.19.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">Generate all valid teams within the given size constraints </span>
</div>
<div id="algorithm1.4.20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.20.1" class="ltx_text ltx_font_bold">11</span></span>
            <math id="algorithm1.m15" class="ltx_Math" alttext="\mathcal{T}\leftarrow\texttt{GenerateTeams}(\mathcal{A}_{\text{candidate}},N_{\text{min}},N_{\text{max}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">GenerateTeams</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mtext>candidate</mtext></msub><mo>,</mo><msub><mi>N</mi><mtext>min</mtext></msub><mo>,</mo><msub><mi>N</mi><mtext>max</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T}\leftarrow\texttt{GenerateTeams}(\mathcal{A}_{\text{candidate}},N_{\text{min}},N_{\text{max}})</annotation></semantics></math>

</div>
<div id="algorithm1.4.21" class="ltx_listingline"><span id="algorithm1.4.21.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">// </span><span id="algorithm1.4.21.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">Construct Pareto-optimal team set based on relevance and diversity </span>
</div>
<div id="algorithm1.4.22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.22.1" class="ltx_text ltx_font_bold">12</span></span>
            <math id="algorithm1.m16" class="ltx_Math" alttext="\mathcal{T^{*}}\leftarrow\arg\max_{\mathcal{A}^{\prime}\in\mathcal{T}}\left[\text{Rel}(\mathcal{A}^{\prime},q),\text{Div}(\mathcal{A}^{\prime})\right]" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>max</mi><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi></mrow></msub><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mtext>Rel</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><mo>,</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mtext>Div</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{T^{*}}\leftarrow\arg\max_{\mathcal{A}^{\prime}\in\mathcal{T}}\left[\text{Rel}(\mathcal{A}^{\prime},q),\text{Div}(\mathcal{A}^{\prime})\right]</annotation></semantics></math>

</div>
<div id="algorithm1.4.23" class="ltx_listingline"><span id="algorithm1.4.23.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">// </span><span id="algorithm1.4.23.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#008080;">Select final team according to task characteristics </span>
</div>
<div id="algorithm1.4.24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.24.1" class="ltx_text ltx_font_bold">13</span></span>
