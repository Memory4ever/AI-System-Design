<th id="A5.T2.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">LoRA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib9" title="" class="ltx_ref">Hu et al., 2022</a>)</cite> Rank</th>
<td id="A5.T2.2.6.2" class="ltx_td ltx_align_center">32</td></tr>
<tr id="A5.T2.2.7" class="ltx_tr">
