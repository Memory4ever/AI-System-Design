<th id="A1.T7.3.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T7.3.1.1.4.1" class="ltx_text ltx_font_bold">75%</span></th>
<th id="A1.T7.3.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T7.3.1.1.5.1" class="ltx_text ltx_font_bold">86.32%</span></th>
