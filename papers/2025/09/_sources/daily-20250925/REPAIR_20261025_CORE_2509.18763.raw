<td id="S4.T5.3.1.6.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">57.36 (<span id="S4.T5.3.1.6.8.1" class="ltx_text ltx_font_bold">4.55<math id="S4.T5.m10" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span>)</td></tr>
