<td id="A1.T7.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t">85.72</td>
<td id="A1.T7.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t">85.87</td>
<td id="A1.T7.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t">85.72</td>
<td id="A1.T7.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t">85.47</td>
<td id="A1.T7.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t">78.33</td>
<td id="A1.T7.3.1.2.7" class="ltx_td ltx_align_center ltx_border_t">57.76</td></tr>
<tr id="A1.T7.3.1.3" class="ltx_tr">
<th id="A1.T7.3.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">5</th>
<td id="A1.T7.3.1.3.2" class="ltx_td ltx_align_center ltx_border_t">86.12</td>
<td id="A1.T7.3.1.3.3" class="ltx_td ltx_align_center ltx_border_t">85.67</td>
<td id="A1.T7.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t">85.97</td>
<td id="A1.T7.3.1.3.5" class="ltx_td ltx_align_center ltx_border_t">85.32</td>
<td id="A1.T7.3.1.3.6" class="ltx_td ltx_align_center ltx_border_t">80.86</td>
<td id="A1.T7.3.1.3.7" class="ltx_td ltx_align_center ltx_border_t">53.79</td></tr>
<tr id="A1.T7.3.1.4" class="ltx_tr">
