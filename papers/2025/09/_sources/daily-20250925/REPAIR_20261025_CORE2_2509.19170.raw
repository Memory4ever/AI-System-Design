<span id="A5.T3.2.1.2.9.3.1" class="ltx_tabular ltx_align_middle">
<span id="A5.T3.2.1.2.9.3.1.1" class="ltx_tr">
<span id="A5.T3.2.1.2.9.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Soft</span></span>
<span id="A5.T3.2.1.2.9.3.1.2" class="ltx_tr">
<span id="A5.T3.2.1.2.9.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Greedy</span></span>
