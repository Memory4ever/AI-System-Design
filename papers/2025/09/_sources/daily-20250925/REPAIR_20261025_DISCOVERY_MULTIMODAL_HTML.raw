        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.17666">pdf</a>, <a href="https://arxiv.org/ps/2509.17666">ps</a>, <a href="https://arxiv.org/format/2509.17666">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
