        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.17664">pdf</a>, <a href="https://arxiv.org/ps/2509.17664">ps</a>, <a href="https://arxiv.org/format/2509.17664">other</a>]&nbsp;</span>
