      <a href="/search/?searchtype=author&amp;query=Ramasubramanian%2C+S">Shankar Ramasubramanian</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Oreshkin%2C+B">Boris Oreshkin</a>, 
      
