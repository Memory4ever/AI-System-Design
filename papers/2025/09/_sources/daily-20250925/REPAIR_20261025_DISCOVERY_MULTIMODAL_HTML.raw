      <a href="/search/?searchtype=author&amp;query=Hoq%2C+M+E">MD Enamul Hoq</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Alabtah%2C+G">Ghazal Alabtah</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tizhoosh%2C+H+R">H. R. Tizhoosh</a>
      
