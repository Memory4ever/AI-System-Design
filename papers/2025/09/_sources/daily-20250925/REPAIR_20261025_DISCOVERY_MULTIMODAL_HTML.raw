      <span class="has-text-grey-dark mathjax">The project is available at https://charlescsyyy.github.io/MVT</span>
    </p>
    

    

    
  </li>

  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2509.18691">arXiv:2509.18691</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.18691">pdf</a>, <a href="https://arxiv.org/ps/2509.18691">ps</a>, <a href="https://arxiv.org/format/2509.18691">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
