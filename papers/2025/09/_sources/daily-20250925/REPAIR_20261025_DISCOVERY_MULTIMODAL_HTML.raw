        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.19595">pdf</a>, <a href="https://arxiv.org/ps/2509.19595">ps</a>, <a href="https://arxiv.org/format/2509.19595">other</a>]&nbsp;</span>
