      <a href="/search/?searchtype=author&amp;query=Vera%2C+H+S">Henrique Schechter Vera</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Dua%2C+S">Sahil Dua</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+B">Biao Zhang</a>, 
      
