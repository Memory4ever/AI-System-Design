      <a href="/search/?searchtype=author&amp;query=Hu%2C+H">Hanjiang Hu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+C">Changliu Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+N">Na Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+Y">Yebin Wang</a>
      
