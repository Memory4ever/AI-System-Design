<td id="S4.T3.5.4.2" class="ltx_td ltx_align_center">12/20</td>
<td id="S4.T3.5.4.3" class="ltx_td ltx_align_center">16/20</td>
<td id="S4.T3.5.4.4" class="ltx_td ltx_align_center"><span id="S4.T3.5.4.4.1" class="ltx_text ltx_font_bold">18/20</span></td></tr>
