<td id="S4.T2.6.8.7" class="ltx_td ltx_align_center"><span id="S4.T2.6.8.7.1" class="ltx_text ltx_font_bold">71 <math id="S4.T2.m43" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 4</span> <math id="S4.T2.m44" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math> <span id="S4.T2.6.8.7.2" class="ltx_text" style="--ltx-fg-color:#808080;">11</span></td></tr>
