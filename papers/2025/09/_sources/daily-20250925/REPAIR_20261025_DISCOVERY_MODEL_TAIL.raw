  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2509.18053">arXiv:2509.18053</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2509.18053">pdf</a>, <a href="https://arxiv.org/ps/2509.18053">ps</a>, <a href="https://arxiv.org/format/2509.18053">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
