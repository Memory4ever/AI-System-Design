<td id="A2.T7.6.11.2" class="ltx_td ltx_align_center">-</td>
<td id="A2.T7.6.11.3" class="ltx_td ltx_align_center">256 <math id="A2.T7.m9" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> 512 <math id="A2.T7.m10" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> 1024</td>
<td id="A2.T7.6.11.4" class="ltx_td ltx_align_center">1024</td></tr>
<tr id="A2.T7.6.12" class="ltx_tr">
<th id="A2.T7.6.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Semantic Encoder</th>
<td id="A2.T7.6.12.2" class="ltx_td ltx_align_center ltx_border_t">Trainable</td>
<td id="A2.T7.6.12.3" class="ltx_td ltx_align_center ltx_border_t">Not Loaded</td>
<td id="A2.T7.6.12.4" class="ltx_td ltx_align_center ltx_border_t">Trainable</td></tr>
<tr id="A2.T7.6.13" class="ltx_tr">
