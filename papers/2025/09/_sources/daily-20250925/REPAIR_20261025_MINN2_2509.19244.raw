<th id="A2.T11.6.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">ChartQA</th>
<th id="A2.T11.6.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">ScienceQA</th></tr>
