<tr id="A2.T12.6.2" class="ltx_tr">
<th id="A2.T12.6.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">w/o grounding data</th>
<th id="A2.T12.6.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">0.74</th>
