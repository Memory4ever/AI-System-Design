<td id="A2.T11.6.3.2" class="ltx_td ltx_align_center ltx_border_t">83.2</td>
<td id="A2.T11.6.3.3" class="ltx_td ltx_align_center ltx_border_t">74.6</td>
<td id="A2.T11.6.3.4" class="ltx_td ltx_align_center ltx_border_t">78.3</td>
<td id="A2.T11.6.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T11.6.3.5.1" class="ltx_text ltx_font_bold">449</span></td>
<td id="A2.T11.6.3.6" class="ltx_td ltx_align_center ltx_border_t">72.6</td>
<td id="A2.T11.6.3.7" class="ltx_td ltx_align_center ltx_border_t">84.3</td></tr>
