<td id="A2.T8.6.4.4" class="ltx_td ltx_align_center"><span id="A2.T8.6.4.4.1" class="ltx_text ltx_font_bold">63.1</span></td>
<td id="A2.T8.6.4.5" class="ltx_td ltx_align_center">16</td>
