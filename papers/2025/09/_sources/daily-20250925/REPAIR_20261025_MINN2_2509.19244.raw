</thead>
<tbody class="ltx_tbody">
<tr id="A2.T11.6.2" class="ltx_tr">
<td id="A2.T11.6.2.1" class="ltx_td"></td>
<th id="A2.T11.6.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">RefCOCO</th>
<th id="A2.T11.6.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">RefCOCO+</th>
