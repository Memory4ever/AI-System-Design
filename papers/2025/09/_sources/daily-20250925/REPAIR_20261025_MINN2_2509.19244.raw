<tr id="A2.T8.6.5" class="ltx_tr">
<td id="A2.T8.6.5.1" class="ltx_td ltx_align_left">4B+4B</td>
<td id="A2.T8.6.5.2" class="ltx_td ltx_align_center">3072</td>
<td id="A2.T8.6.5.3" class="ltx_td ltx_align_center">0.48</td>
