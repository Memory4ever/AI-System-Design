<th id="A2.T12.6.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T12.6.1.2.1" class="ltx_text ltx_font_bold">GenEval</span></th>
<th id="A2.T12.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T12.6.1.3.1" class="ltx_text ltx_font_bold">DPG</span></th>
