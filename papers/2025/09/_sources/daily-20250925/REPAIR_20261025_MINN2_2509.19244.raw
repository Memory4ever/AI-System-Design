<td id="S1.T1.6.3.6" class="ltx_td ltx_align_center ltx_border_t"><math id="S1.T1.m5" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td></tr>
