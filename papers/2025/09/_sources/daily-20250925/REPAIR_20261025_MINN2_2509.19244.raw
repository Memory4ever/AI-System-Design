<td id="A2.T11.6.4.4" class="ltx_td ltx_align_center">85.7</td>
<td id="A2.T11.6.4.5" class="ltx_td ltx_align_center">349</td>
<td id="A2.T11.6.4.6" class="ltx_td ltx_align_center">65.0</td>
<td id="A2.T11.6.4.7" class="ltx_td ltx_align_center">75.8</td></tr>
