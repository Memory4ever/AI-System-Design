<td id="A2.T12.6.4.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T12.6.4.3.1" class="ltx_text ltx_font_bold">82.9</span></td>
<td id="A2.T12.6.4.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A2.T12.6.4.4.1" class="ltx_text ltx_font_bold">3.80</span></td></tr>
</tbody>
