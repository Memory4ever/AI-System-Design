<td id="S1.T1.6.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S1.T1.m1" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi>✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td>
