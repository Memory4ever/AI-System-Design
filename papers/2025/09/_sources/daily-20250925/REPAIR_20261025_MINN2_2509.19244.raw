<td id="S1.T1.6.5.4" class="ltx_td ltx_align_center"><math id="S1.T1.m13" class="ltx_Math" alttext="512^{2}" display="inline" intent=":literal"><semantics><msup><mn>512</mn><mn>2</mn></msup><annotation encoding="application/x-tex">512^{2}</annotation></semantics></math></td>
