<th id="A2.T15.6.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T15.6.1.7.1" class="ltx_text ltx_font_bold">N=16</span></th>
<th id="A2.T15.6.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T15.6.1.8.1" class="ltx_text ltx_font_bold">N=20</span></th></tr>
