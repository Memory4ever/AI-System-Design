<td id="A1.T2.2.17.2" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;">1.0</td>
<td id="A1.T2.2.17.3" class="ltx_td" style="padding:0.75pt 10.0pt;"></td></tr>
