<th id="S5.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt" colspan="3"><span id="S5.T1.2.1.1.2.1" class="ltx_text ltx_font_bold">Math</span></th>
<th id="S5.T1.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="S5.T1.2.1.1.3.1" class="ltx_text ltx_font_bold">Medical</span></th></tr>
<tr id="S5.T1.2.1.2" class="ltx_tr">
