</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.2.1.3" class="ltx_tr">
<th id="S5.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">Qwen3-1.7B</th>
<td id="S5.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">68.5</td>
<td id="S5.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">46.85</td>
<td id="S5.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">57.5</td>
<td id="S5.T1.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">46.11</td>
<td id="S5.T1.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t">43.17</td>
<td id="S5.T1.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t">57.85</td></tr>
<tr id="S5.T1.2.1.4" class="ltx_tr">
