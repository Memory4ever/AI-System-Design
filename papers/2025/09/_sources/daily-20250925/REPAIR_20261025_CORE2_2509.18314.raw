<td id="S5.T1.2.1.8.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">75.0</td>
<td id="S5.T1.2.1.8.5" class="ltx_td ltx_align_center ltx_border_t">65.36</td>
