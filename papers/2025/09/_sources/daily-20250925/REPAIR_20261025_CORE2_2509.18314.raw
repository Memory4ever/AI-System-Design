<th id="A1.T2.2.18.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.75pt 10.0pt;">KL penalty coefficient <math id="A1.T2.m10" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></th>
<td id="A1.T2.2.18.2" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;"><math id="A1.T2.m11" class="ltx_Math" alttext="1\!\times\!10^{-4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\!\times\!10^{-4}</annotation></semantics></math></td>
<td id="A1.T2.2.18.3" class="ltx_td" style="padding:0.75pt 10.0pt;"></td></tr>
<tr id="A1.T2.2.19" class="ltx_tr">
<th id="A1.T2.2.19.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding:0.75pt 10.0pt;" colspan="3"><span id="A1.T2.2.19.1.1" class="ltx_text ltx_font_bold">GRPO/HEPO/TEMPO</span></th></tr>
<tr id="A1.T2.2.20" class="ltx_tr">
<th id="A1.T2.2.20.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.75pt 10.0pt;"># Responses per prompt</th>
<td id="A1.T2.2.20.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 10.0pt;">6</td>
<td id="A1.T2.2.20.3" class="ltx_td ltx_border_t" style="padding:0.75pt 10.0pt;"></td></tr>
<tr id="A1.T2.2.21" class="ltx_tr">
<th id="A1.T2.2.21.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.75pt 10.0pt;">Mini-batch size</th>
<td id="A1.T2.2.21.2" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;">64</td>
<td id="A1.T2.2.21.3" class="ltx_td" style="padding:0.75pt 10.0pt;"></td></tr>
<tr id="A1.T2.2.22" class="ltx_tr">
<th id="A1.T2.2.22.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.75pt 10.0pt;">Discount factor <math id="A1.T2.m12" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></th>
<td id="A1.T2.2.22.2" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;">1.0</td>
<td id="A1.T2.2.22.3" class="ltx_td" style="padding:0.75pt 10.0pt;"></td></tr>
<tr id="A1.T2.2.23" class="ltx_tr">
<th id="A1.T2.2.23.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.75pt 10.0pt;">KL penalty coefficient <math id="A1.T2.m13" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></th>
<td id="A1.T2.2.23.2" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;">0.0</td>
<td id="A1.T2.2.23.3" class="ltx_td" style="padding:0.75pt 10.0pt;"></td></tr>
<tr id="A1.T2.2.24" class="ltx_tr">
<th id="A1.T2.2.24.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.75pt 10.0pt;">Policy clipping parameter <math id="A1.T2.m14" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math></th>
<td id="A1.T2.2.24.2" class="ltx_td ltx_align_left" style="padding:0.75pt 10.0pt;">0.28, 0.2</td>
<td id="A1.T2.2.24.3" class="ltx_td" style="padding:0.75pt 10.0pt;"></td></tr>
<tr id="A1.T2.2.25" class="ltx_tr">
<th id="A1.T2.2.25.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding:0.75pt 10.0pt;" colspan="3"><span id="A1.T2.2.25.1.1" class="ltx_text ltx_font_bold">HEPO</span></th></tr>
<tr id="A1.T2.2.26" class="ltx_tr">
