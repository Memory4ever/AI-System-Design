<tr id="S5.T1.2.1.7" class="ltx_tr">
<th id="S5.T1.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">   + TEMPO</th>
<td id="S5.T1.2.1.7.2" class="ltx_td ltx_align_center"><span id="S5.T1.2.1.7.2.1" class="ltx_text ltx_font_bold">87.0</span></td>
<td id="S5.T1.2.1.7.3" class="ltx_td ltx_align_center"><span id="S5.T1.2.1.7.3.1" class="ltx_text ltx_font_bold">56.71</span></td>
<td id="S5.T1.2.1.7.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T1.2.1.7.4.1" class="ltx_text ltx_font_bold">75.0</span></td>
<td id="S5.T1.2.1.7.5" class="ltx_td ltx_align_center"><span id="S5.T1.2.1.7.5.1" class="ltx_text ltx_font_bold">59.15</span></td>
<td id="S5.T1.2.1.7.6" class="ltx_td ltx_align_center"><span id="S5.T1.2.1.7.6.1" class="ltx_text ltx_font_bold">51.54</span></td>
