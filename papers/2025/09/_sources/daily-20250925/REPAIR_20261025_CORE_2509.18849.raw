<td id="A1.T4.9.1.25.1" class="ltx_td ltx_align_center ltx_border_rr ltx_border_t" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A1.T4.9.1.25.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><span class="ltx_rule" style="width:100%;height:1.0pt;--ltx-fg-color:#000000;--ltx-bg-color:#000000;display:inline-block;"> </span></td>
<td id="A1.T4.9.1.25.2" class="ltx_td ltx_border_t" style="padding-left:20.0pt;padding-right:20.0pt;"></td>
