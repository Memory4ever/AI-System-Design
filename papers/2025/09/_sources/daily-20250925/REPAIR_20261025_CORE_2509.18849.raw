<td id="S4.T2.14.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1pt 3.0pt;"><span id="S4.T2.14.1.1.3.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#E6E6E6;">Geo3K</span></td>
