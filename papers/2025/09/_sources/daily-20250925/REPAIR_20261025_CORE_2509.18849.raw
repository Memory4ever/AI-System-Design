0.0 1.0 5.91 8.6)} \pgfsys@hbox{65}\lxSVG@closescope }\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}}_{{\color[rgb]{0.6289,0.4492,0}\textbf{Mean-based}}}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">∗</mo><munder><munder accentunder="true"><mtext> <svg style="vertical-align:-8.6px" height="20.46" overflow="visible" version="1.1" viewBox="0 0 46.98 20.46" width="46.98"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,20.46) matrix(1 0 0 -1 0 0)"> <g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"> <path style="stroke:none" d="M 0 5.91 L 0 14.55 C 0 17.82 2.64 20.46 5.91 20.46 L 41.07 20.46 C 44.33 20.46 46.98 17.82 46.98 14.55 L 46.98 5.91 C 46.98 2.64 44.33 0 41.07 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path> </g> <g style="--ltx-fill-color:#EBFFEB;" fill="#EBFFEB" fill-opacity="1.0"> <path style="stroke:none" d="M 1.97 5.91 L 1.97 14.55 C 1.97 16.73 3.73 18.49 5.91 18.49 L 41.07 18.49 C 43.24 18.49 45.01 16.73 45.01 14.55 L 45.01 5.91 C 45.01 3.73 43.24 1.97 41.07 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path> </g> <g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 5.91 8.6)"> <foreignObject style="--ltx-fo-width:2.54em;--ltx-fo-height:0.43em;--ltx-fo-depth:0.19em;font-size:10pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="35.17"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><mstyle displaystyle="true"><mfrac><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>−</mo><mi>μ</mi></mrow><mi>σ</mi></mfrac></mstyle></span></span></foreignObject> </g> </g> </svg> </mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">⏟</mo></munder><mtext style="--ltx-fg-color:#2A6E3F;" class="ltx_mathvariant_bold" mathcolor="#2A6E3F">Deviation-based</mtext></munder></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">∗</mo><munder><munder accentunder="true"><mtext> <svg style="vertical-align:-8.6px" height="20.46" overflow="visible" version="1.1" viewBox="0 0 47.41 20.46" width="47.41"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,20.46) matrix(1 0 0 -1 0 0)"> <g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacit