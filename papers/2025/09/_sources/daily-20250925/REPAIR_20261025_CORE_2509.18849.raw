<td id="S2.T1.7.1.11.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 3.0pt;"><span id="S2.T1.7.1.11.4.1" class="ltx_text" style="--ltx-fg-color:#5F6CA1;--ltx-bg-color:#F2F4FA;">✓<span id="S2.T1.7.1.11.4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> (Length Reward)</span></span></td>
<td id="S2.T1.7.1.11.5" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;"><span id="S2.T1.7.1.11.5.1" class="ltx_text" style="--ltx-fg-color:#5F6CA1;--ltx-bg-color:#F2F4FA;">✓<span id="S2.T1.7.1.11.5.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"> (Advantage Rescale Factor)</span></span></td></tr>
<tr id="S2.T1.7.1.12" class="ltx_tr">
<td id="S2.T1.7.1.12.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding:1pt 3.0pt;" colspan="4"><span id="S2.T1.7.1.12.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="--ltx-fg-color:#000000;">Advantage Estimation Redesign</span><span id="S2.T1.7.1.12.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="S2.T1.7.1.12.1.3" class="ltx_text" style="position:relative; bottom:-2.0pt;--ltx-fg-color:#000000;"><img src="2509.18849v1/Figure/advantages.png" id="S2.T1.g3" class="ltx_graphics ltx_img_square" style="aspect-ratio:14/14;" width="14" height="14" alt="[Uncaptioned image]"></span></td>
