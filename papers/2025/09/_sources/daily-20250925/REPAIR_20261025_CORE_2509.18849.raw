<section id="Ax1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix" style="--ltx-fg-color:#000000;">Appendix</h2>

</section>
<section id="A1a" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Notation and Algorithm</h2>

<div id="A1a.p1" class="ltx_para ltx_noindent">
<p id="A1a.p1.1" class="ltx_p"><span id="A1a.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">We provide the notation table in </span><a href="#A1.T4" title="In Appendix A Notation and Algorithm ‣ MAPO: Mixed Advantage Policy Optimization" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">Tab.</span> <span class="ltx_text ltx_ref_tag">4</span></a><span id="A1a.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> and proposed method algorithm in </span><a href="#algorithm1" title="In Appendix A Notation and Algorithm ‣ MAPO: Mixed Advantage Policy Optimization" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">algorithm</span> <span class="ltx_text ltx_ref_tag">1</span></a><span id="A1a.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></p>
</div>
<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.5" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>MAPO</figcaption>
<div id="algorithm1.6" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.6.1" class="ltx_listingline"><span id="algorithm1.6.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">
</span><span id="algorithm1.6.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"><span id="algorithm1.6.1.2.1" class="ltx_text ltx_font_bold">Input:</span> </span><span id="algorithm1.6.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">Reference model </span><math id="algorithm1.m1" class="ltx_Math" alttext="\pi_{ref}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{ref}</annotation></semantics></math><span id="algorithm1.6.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, old model </span><math id="algorithm1.m2" class="ltx_Math" alttext="\pi_{old}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{old}</annotation></semantics></math><span id="algorithm1.6.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">, current policy model </span><math id="algorithm1.m3" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math><span id="algorithm1.6.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">, group size </span><math id="algorithm1.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math><span id="algorithm1.6.1.7" class="ltx_text" style="--ltx-fg-color:#000000;">, Training Step </span><math id="algorithm1.m5" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math><span id="algorithm1.6.1.8" class="ltx_text" style="--ltx-fg-color:#000000;">, Current Step </span><math id="algorithm1.m6" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math><span id="algorithm1.6.1.9" class="ltx_text" style="--ltx-fg-color:#000000;">, Training Batch </span><math id="algorithm1.m7" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math><span id="algorithm1.6.1.10" class="ltx_text" style="--ltx-fg-color:#000000;">, Question Distribution </span><math id="algorithm1.m8" class="ltx_Math" alttext="\rho_{Q}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Q</mi></msub><annotation encoding="application/x-tex">\rho_{Q}</annotation></semantics></math><span id="algorithm1.6.1.11" class="ltx_text" style="--ltx-fg-color:#000000;">, Query Prompt </span><math id="algorithm1.m9" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math><span id="algorithm1.6.1.12" class="ltx_text" style="--ltx-fg-color:#000000;"> </span>
</div>
<div id="algorithm1.6.2" class="ltx_listingline"><span id="algorithm1.6.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Initialize </span><math id="algorithm1.m10" class="ltx_Math" alttext="\pi_{\theta}\leftarrow\pi_{ref}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\pi_{\theta}\leftarrow\pi_{ref}</annotation></semantics></math><span id="algorithm1.6.2.2" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="algorithm1.6.3" class="ltx_listingline"><span id="algorithm1.6.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">for</span><span id="algorithm1.6.3.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><em id="algorithm1.6.3.3" class="ltx_emph ltx_font_italic" style="--ltx-fg-color:#000000;"><math id="algorithm1.m11" class="ltx_Math" alttext="e=1,2,...,E" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">E</mi></mrow><annotation encoding="application/x-tex">e=1,2,...,E</annotation></semantics></math></em><span id="algorithm1.6.3.4" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algorithm1.6.3.5" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">do</span>
</div>
<div id="algorithm1.6.4" class="ltx_listingline"><span id="algorithm1.6.4.1" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.4.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="algorithm1.m12" class="ltx_Math" alttext="\pi_{old}\leftarrow\pi_{\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{old}\leftarrow\pi_{\theta}</annotation></semantics></math><span id="algorithm1.6.4.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="algorithm1.6.5" class="ltx_listingline"><span id="algorithm1.6.5.1" class="ltx_text" style="--ltx-fg-color:#406595;"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> </span><math id="algorithm1.m13" class="ltx_Math" alttext="q\sim\rho_{Q}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∼</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Q</mi></msub></mrow><annotation encoding="application/x-tex">q\sim\rho_{Q}</annotation></semantics></math><span id="algorithm1.6.5.2" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="algorithm1.m14" class="ltx_math_unparsed" alttext="o=\{o_{i}\}_{i=1}^{G}\sim\pi_{old}(\cdot|q)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∼</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">q</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">o=\{o_{i}\}_{i=1}^{G}\sim\pi_{old}(\cdot|q)</annotation></semantics></math><span id="algorithm1.6.5.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algorithm1.6.5.4" class="ltx_text" style="--ltx-fg-color:#406595;">;  <span id="algorithm1.6.5.4.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.6.5.4.2" class="ltx_text ltx_font_typewriter">Sample prompt with <math id="algorithm1.m15" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#406595;" mathcolor="#406595">G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> trajectory.</span></span>
</div>
<div id="algorithm1.6.6" class="ltx_listingline"><span id="algorithm1.6.6.1" class="ltx_text" style="--ltx-fg-color:#000000;"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> </span>
</div>
<div id="algorithm1.6.7" class="ltx_listingline"><span id="algorithm1.6.7.1" class="ltx_text" style="--ltx-fg-color:#406595;"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> </span><math id="algorithm1.m16" class="ltx_Math" alttext="\bm{r}=\{r_{i}\}_{i=1}^{G}=R(o)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒓</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">o</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{r}=\{r_{i}\}_{i=1}^{G}=R(o)</annotation></semantics></math><span id="algorithm1.6.7.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algorithm1.6.7.3" class="ltx_text" style="--ltx-fg-color:#406595;">;  <span id="algorithm1.6.7.3.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.6.7.3.2" class="ltx_text ltx_font_typewriter">Measure trajectory reward.</span></span>
</div>
<div id="algorithm1.6.8" class="ltx_listingline"><span id="algorithm1.6.8.1" class="ltx_text" style="--ltx-fg-color:#000000;"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> </span>
</div>
<div id="algorithm1.6.9" class="ltx_listingline"><span id="algorithm1.6.9.1" class="ltx_text" style="--ltx-fg-color:#406595;"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> </span><math id="algorithm1.m17" class="ltx_Math" alttext="\mu=\frac{1}{G}\sum_{r_{i}\in\bm{r}}r_{i}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒓</mi></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu=\frac{1}{G}\sum_{r_{i}\in\bm{r}}r_{i}</annotation></semantics></math><span id="algorithm1.6.9.2" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="algorithm1.m18" class="ltx_Math" alttext="\sigma=\sqrt{\frac{1}{G}\sum_{i=1}^{G}\left(r_{i}-\mu\right)^{2}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">G</mi></msubsup><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\sigma=\sqrt{\frac{1}{G}\sum_{i=1}^{G}\left(r_{i}-\mu\right)^{2}}</annotation></semantics></math><span id="algorithm1.6.9.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algorithm1.6.9.4" class="ltx_text" style="--ltx-fg-color:#406595;">;  <span id="algorithm1.6.9.4.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.6.9.4.2" class="ltx_text ltx_font_typewriter">Calculate static information.</span></span>
</div>
