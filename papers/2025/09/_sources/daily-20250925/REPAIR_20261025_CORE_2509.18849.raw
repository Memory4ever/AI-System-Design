<td id="A1.T4.9.1.22.1" class="ltx_td ltx_align_center ltx_border_rr" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A1.T4.9.1.22.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">  <math id="A1.T4.m33" class="ltx_Math" alttext="\mathcal{T}=\{T_{t}\}_{t=1}^{|\mathcal{T}|}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" class="ltx_font_mathcaligraphic" mathbackground="#F2F4FA" mathcolor="#000000">𝒯</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">=</mo><msubsup><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000" stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">T</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000" stretchy="false">}</mo></mrow><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">1</mn></mrow><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" class="ltx_font_mathcaligraphic" mathbackground="#F2F4FA" mathcolor="#000000">𝒯</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000" stretchy="false">|</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{T}=\{T_{t}\}_{t=1}^{|\mathcal{T}|}</annotation></semantics></math></span></td>
<td id="A1.T4.9.1.22.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A1.T4.9.1.22.2.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">  Set of unseen test datasets</span></td>
<td id="A1.T4.9.1.22.3" class="ltx_td ltx_align_center" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A1.T4.9.1.22.3.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">  <a href="#S4.SS1" title="4.1 Experimental Setup ‣ 4 Experiments ‣ MAPO: Mixed Advantage Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Sec.</span> <span class="ltx_text ltx_ref_tag">4.1</span></a></span></td></tr>
<tr id="A1.T4.9.1.23" class="ltx_tr">
<td id="A1.T4.9.1.23.1" class="ltx_td ltx_align_center ltx_border_rr" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A1.T4.9.1.23.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><math id="A1.T4.m34" class="ltx_Math" alttext="|\mathcal{T}|" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒯</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{T}|</annotation></semantics></math></td>
<td id="A1.T4.9.1.23.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A1.T4.9.1.23.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">  Number of unseen test datasets</span></td>
<td id="A1.T4.9.1.23.3" class="ltx_td ltx_align_center" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A1.T4.9.1.23.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><a href="#S4.SS1" title="4.1 Experimental Setup ‣ 4 Experiments ‣ MAPO: Mixed Advantage Policy Optimization" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">Sec.</span> <span class="ltx_text ltx_ref_tag">4.1</span></a></td></tr>
<tr id="A1.T4.9.1.24" class="ltx_tr" style="--ltx-bg-color:#F2F4FA;">
<td id="A1.T4.9.1.24.1" class="ltx_td ltx_align_center ltx_border_rr" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A1.T4.9.1.24.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">  <math id="A1.T4.m35" class="ltx_Math" alttext="\mathcal{A}^{S},\mathcal{A}^{T},\bar{\mathcal{A}}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" class="ltx_font_mathcaligraphic" mathbackground="#F2F4FA" mathcolor="#000000">𝒜</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">S</mi></msup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">,</mo><msup><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" class="ltx_font_mathcaligraphic" mathbackground="#F2F4FA" mathcolor="#000000">𝒜</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">T</mi></msup><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">,</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" class="ltx_font_mathcaligraphic" mathbackground="#F2F4FA" mathcolor="#000000">𝒜</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">¯</mo></mover></mrow><annotation encoding="application/x-tex">\mathcal{A}^{S},\mathcal{A}^{T},\bar{\mathcal{A}}</annotation></semantics></math></span></td>
<td id="A1.T4.9.1.24.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A1.T4.9.1.24.2.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">  In-domain, out-of-domain and average accuracy</span></td>
<td id="A1.T4.9.1.24.3" class="ltx_td ltx_align_center" style="padding-left:20.0pt;padding-right:20.0pt;"><span id="A1.T4.9.1.24.3.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">  <a href="#S4.SS1" title="4.1 Experimental Setup ‣ 4 Experiments ‣ MAPO: Mixed Advantage Policy Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Sec.</span> <span class="ltx_text ltx_ref_tag">4.1</span></a></span></td></tr>
