<td id="S3.F3.2.1.2.1" class="ltx_td ltx_align_right ltx_border_rr" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#E6E6E6;">Methods</span></td>
