<tr id="S3.F3.2.1.8" class="ltx_tr">
<td id="S3.F3.2.1.8.1" class="ltx_td ltx_align_right ltx_border_rr ltx_border_t" style="padding:1pt 2.0pt;"><span class="ltx_rule" style="width:100%;height:1.0pt;--ltx-fg-color:#000000;--ltx-bg-color:#000000;display:inline-block;"> </span></td>
