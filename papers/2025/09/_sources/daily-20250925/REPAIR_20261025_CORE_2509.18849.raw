</div>
<div id="algorithm1.6.11" class="ltx_listingline"><span id="algorithm1.6.11.1" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.11.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><em id="algorithm1.6.11.3" class="ltx_emph ltx_font_italic" style="--ltx-fg-color:#000000;">Advantage Percent Deviation</em><span id="algorithm1.6.11.4" class="ltx_text" style="--ltx-fg-color:#000000;">;</span>
</div>
<div id="algorithm1.6.12" class="ltx_listingline"><span id="algorithm1.6.12.1" class="ltx_text" style="--ltx-fg-color:#406595;"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> </span><math id="algorithm1.m19" class="ltx_Math" alttext="\hat{A}_{i}\leftarrow(\bm{r},\mu,\sigma)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒓</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">σ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{A}_{i}\leftarrow(\bm{r},\mu,\sigma)</annotation></semantics></math><span id="algorithm1.6.12.2" class="ltx_text" style="--ltx-fg-color:#000000;"> via </span><a href="#S3.E2" title="In 3.1 Preliminary ‣ 3 Methodology ‣ MAPO: Mixed Advantage Policy Optimization" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">2</span></a><span id="algorithm1.6.12.3" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="algorithm1.m20" class="ltx_Math" alttext="\hat{A}_{i}^{{APD}}\leftarrow(\bm{r},\mu)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝒓</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{A}_{i}^{{APD}}\leftarrow(\bm{r},\mu)</annotation></semantics></math><span id="algorithm1.6.12.4" class="ltx_text" style="--ltx-fg-color:#000000;"> via </span><a href="#S3.E4" title="In 3.2 Proposed Method ‣ 3 Methodology ‣ MAPO: Mixed Advantage Policy Optimization" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">4</span></a><span id="algorithm1.6.12.5" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algorithm1.6.12.6" class="ltx_text" style="--ltx-fg-color:#406595;">;  <span id="algorithm1.6.12.6.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.6.12.6.2" class="ltx_text ltx_font_typewriter">Measure advantage.</span></span>
</div>
