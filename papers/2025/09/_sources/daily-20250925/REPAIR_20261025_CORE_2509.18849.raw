<tr id="S3.F3.2.1.3" class="ltx_tr" style="--ltx-bg-color:#F2F4FA;">
<td id="S3.F3.2.1.3.1" class="ltx_td ltx_align_right ltx_border_rr ltx_border_tt" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;"><a name="A1" id="A1" class="ltx_anchor">GRPO ♣</a></span></td>
<td id="S3.F3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:1pt 2.0pt;"><math id="S3.F3.m1" class="ltx_Math" style="--ltx-bg-color:#F2F4FA;" alttext="\hat{A}_{i}=\frac{r_{i}-\mu}{\sigma}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">μ</mi></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">σ</mi></mfrac></mrow><annotation encoding="application/x-tex">\hat{A}_{i}=\frac{r_{i}-\mu}{\sigma}</annotation></semantics></math></td>
<td id="S3.F3.2.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.3.3.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">✓</span></td>
<td id="S3.F3.2.1.3.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.3.4.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">✓</span></td></tr>
<tr id="S3.F3.2.1.4" class="ltx_tr">
<td id="S3.F3.2.1.4.1" class="ltx_td ltx_align_right ltx_border_rr" style="padding:1pt 2.0pt;"><a name="A2" id="A2" class="ltx_anchor"><span id="A2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Dr. GRPO ♠</span></a></td>
<td id="S3.F3.2.1.4.2" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 2.0pt;"><math id="S3.F3.m2" class="ltx_Math" alttext="\hat{A}_{i}=r_{i}-\mu" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mrow></mrow><annotation encoding="application/x-tex">\hat{A}_{i}=r_{i}-\mu</annotation></semantics></math></td>
<td id="S3.F3.2.1.4.3" class="ltx_td ltx_border_r" style="padding:1pt 2.0pt;"></td>
<td id="S3.F3.2.1.4.4" class="ltx_td ltx_align_center" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.4.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">✓</span></td></tr>
<tr id="S3.F3.2.1.5" class="ltx_tr" style="--ltx-bg-color:#F2F4FA;">
<td id="S3.F3.2.1.5.1" class="ltx_td ltx_align_right ltx_border_rr" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.5.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;"><a name="A3" id="A3" class="ltx_anchor">GPG ♥</a></span></td>
<td id="S3.F3.2.1.5.2" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 2.0pt;"><math id="S3.F3.m3" class="ltx_Math" style="--ltx-bg-color:#F2F4FA;" alttext="\hat{A}_{i}=\alpha*(r_{i}-\mu)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">α</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" lspace="0.222em" mathbackground="#F2F4FA" mathcolor="#000000" rspace="0.222em">∗</mo><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">μ</mi></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{A}_{i}=\alpha*(r_{i}-\mu)</annotation></semantics></math></td>
<td id="S3.F3.2.1.5.3" class="ltx_td ltx_border_r" style="padding:1pt 2.0pt;"></td>
<td id="S3.F3.2.1.5.4" class="ltx_td ltx_align_center" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.5.4.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">✓</span></td></tr>
<tr id="S3.F3.2.1.6" class="ltx_tr">
<td id="S3.F3.2.1.6.1" class="ltx_td ltx_align_right ltx_border_rr" style="padding:1pt 2.0pt;"><a name="A4" id="A4" class="ltx_anchor"><span id="A4.1" class="ltx_text" style="--ltx-fg-color:#000000;">TreeRPO ♠</span></a></td>
<td id="S3.F3.2.1.6.2" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 2.0pt;"><math id="S3.F3.m4" class="ltx_Math" alttext="\hat{A}_{i}=\frac{r_{i}-\mu}{\mu(1-\mu)}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\hat{A}_{i}=\frac{r_{i}-\mu}{\mu(1-\mu)}</annotation></semantics></math></td>
<td id="S3.F3.2.1.6.3" class="ltx_td ltx_border_r" style="padding:1pt 2.0pt;"></td>
<td id="S3.F3.2.1.6.4" class="ltx_td ltx_align_center" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.6.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">✓</span></td></tr>
<tr id="S3.F3.2.1.7" class="ltx_tr" style="--ltx-bg-color:#F2F4FA;">
<td id="S3.F3.2.1.7.1" class="ltx_td ltx_align_right ltx_border_rr ltx_border_t" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.7.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;"><a name="A5" id="A5" class="ltx_anchor">MAPO ★</a></span></td>
<td id="S3.F3.2.1.7.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1pt 2.0pt;"><math id="S3.F3.m5" class="ltx_Math" style="--ltx-bg-color:#F2F4FA;" alttext="\hat{A}_{i}=\lambda\frac{r_{i}-\mu}{\sigma}\!+\!(1-\lambda)\frac{r_{i}-\mu}{\mu}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">=</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">λ</mi><mo lspace="0em" rspace="0em">​</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">μ</mi></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">σ</mi></mfrac></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" lspace="0.052em" mathbackground="#F2F4FA" mathcolor="#000000" rspace="0.052em">+</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">λ</mi></mrow><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">r</mi><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">μ</mi></mrow><mi style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;" mathbackground="#F2F4FA" mathcolor="#000000">μ</mi></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{A}_{i}=\lambda\frac{r_{i}-\mu}{\sigma}\!+\!(1-\lambda)\frac{r_{i}-\mu}{\mu}</annotation></semantics></math></td>
<td id="S3.F3.2.1.7.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.7.3.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">-</span></td>
