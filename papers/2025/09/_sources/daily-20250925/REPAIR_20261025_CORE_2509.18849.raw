<td id="S2.T1.7.1.10.3" class="ltx_td ltx_border_r" style="padding:1pt 3.0pt;"></td>
<td id="S2.T1.7.1.10.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 3.0pt;"><span id="S2.T1.7.1.10.4.1" class="ltx_text" style="--ltx-fg-color:#5F6CA1;">✓</span><span id="S2.T1.7.1.10.4.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (Length Penalty)</span></td>
<td id="S2.T1.7.1.10.5" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;"><span id="S2.T1.7.1.10.5.1" class="ltx_text" style="--ltx-fg-color:#5F6CA1;">✓</span><span id="S2.T1.7.1.10.5.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (Top-</span><math id="S2.T1.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math><span id="S2.T1.7.1.10.5.3" class="ltx_text" style="--ltx-fg-color:#000000;"> Fraction)</span></td></tr>
<tr id="S2.T1.7.1.11" class="ltx_tr" style="--ltx-bg-color:#F2F4FA;">
<td id="S2.T1.7.1.11.1" class="ltx_td ltx_align_right ltx_border_rr" style="padding:1pt 3.0pt;"><span id="S2.T1.7.1.11.1.1" class="ltx_text" style="--ltx-fg-color:#000000;--ltx-bg-color:#F2F4FA;">GRPO-LEAD</span></td>
<td id="S2.T1.7.1.11.2" class="ltx_td ltx_border_r" style="padding:1pt 3.0pt;"></td>
