<div id="algorithm1.6.17" class="ltx_listingline"><span id="algorithm1.6.17.1" class="ltx_text" style="--ltx-fg-color:#406595;"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> </span><math id="algorithm1.m23" class="ltx_Math" alttext="\lambda(p)=1-4p(1-p)" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">λ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">p</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda(p)=1-4p(1-p)</annotation></semantics></math><span id="algorithm1.6.17.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algorithm1.6.17.3" class="ltx_text" style="--ltx-fg-color:#406595;">;  <span id="algorithm1.6.17.3.1" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm1.6.17.3.2" class="ltx_text ltx_font_typewriter">Measure trajectory maturity degree.</span></span>
