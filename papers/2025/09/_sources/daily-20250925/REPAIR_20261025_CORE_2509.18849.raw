<td id="S3.F3.2.1.2.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 2.0pt;"><span id="S3.F3.2.1.2.3.1" class="ltx_text" style="--ltx-fg-color:#2A6E3F;--ltx-bg-color:#E6E6E6;">Adv. Reversion</span></td>
