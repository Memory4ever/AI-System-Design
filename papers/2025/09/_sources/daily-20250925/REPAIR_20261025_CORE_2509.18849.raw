<div id="S3.F3.2" class="ltx_inline-block ltx_figure_panel ltx_minipage ltx_align_center ltx_transformed_outer" style="width:266.3pt;height:80.9pt;vertical-align:-38.4pt;"><span class="ltx_transformed_inner" style="transform:translate(-27.5pt,8.4pt) scale(0.828669711376163,0.828669711376163) ;">
