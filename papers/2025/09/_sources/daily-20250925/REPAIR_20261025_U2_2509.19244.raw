{"data":{"id":"10.48550/arxiv.2509.19244","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.19244","prefix":"10.48550","suffix":"arxiv.2509.19244","identifiers":[{"identifier":"2509.19244","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.19244"}],"creators":[{"name":"Li, Shufan","nameType":"Personal","givenName":"Shufan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Gu, Jiuxiang","nameType":"Personal","givenName":"Jiuxiang","familyName":"Gu","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Kangning","nameType":"Personal","givenName":"Kangning","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Zhe","nameType":"Personal","givenName":"Zhe","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Wei, Zijun","nameType":"Personal","givenName":"Zijun","familyName":"Wei","affiliation":[],"nameIdentifiers":[]},{"name":"Grover, Aditya","nameType":"Personal","givenName":"Aditya","familyName":"Grover","affiliation":[],"nameIdentifiers":[]},{"name":"Kuen, Jason","nameType":"Personal","givenName":"Jason","familyName":"Kuen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lavida-O: Elastic Large Masked Diffusion Models for Unified Multimodal Understanding and Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T17:05:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-24T01:08:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T09:38:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:38:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-15T22:48:21Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-17T00:13:34Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"We propose Lavida-O, a unified Masked Diffusion Model (MDM) for multimodal understanding and generation. Unlike existing multimodal MDMs such as MMaDa and Muddit which only support simple image-level understanding tasks and low-resolution image generation, Lavida-O presents a single framework that enables image-level understanding, object grounding, image editing, and high-resolution (1024px) text-to-image synthesis. Lavida-O incorporates a novel Elastic Mixture-of-Transformers (Elastic-MoT) architecture that couples a lightweight generation branch with a larger understanding branch, supported by token compression, universal text conditioning and stratified sampling for efficient and high-quality generation. Lavida-O further incorporates planning and iterative self-reflection in image generation and editing tasks, seamlessly boosting generation quality with its understanding capabilities. Lavida-O achieves state-of-the-art performance on a wide range of benchmarks including RefCOCO object grounding, GenEval text-to-image generation, and ImgEdit image editing, outperforming existing autoregressive models and continuous diffusion models such as Qwen2.5-VL and FluxKontext-dev, while offering considerable speedup at inference. These advances establish Lavida-O as a new paradigm for scalable multimodal reasoning and generation.","descriptionType":"Abstract"},{"description":"31 pages, 15 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.19244","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-24T02:17:29.000Z","registered":"2025-09-24T02:17:30.000Z","published":"2025","updated":"2026-07-17T02:33:34.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.19244","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}