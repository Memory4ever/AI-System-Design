{"data":{"id":"10.48550/arxiv.2509.18816","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18816","prefix":"10.48550","suffix":"arxiv.2509.18816","identifiers":[{"identifier":"2509.18816","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.18816"}],"creators":[{"name":"Wang, Junyu","nameType":"Personal","givenName":"Junyu","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Ziyang","nameType":"Personal","givenName":"Ziyang","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Luo, Zhengding","nameType":"Personal","givenName":"Zhengding","familyName":"Luo","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Tianrui","nameType":"Personal","givenName":"Tianrui","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Ge, Meng","nameType":"Personal","givenName":"Meng","familyName":"Ge","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Xiaobao","nameType":"Personal","givenName":"Xiaobao","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Longbiao","nameType":"Personal","givenName":"Longbiao","familyName":"Wang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pay More Attention To Audio: Mitigating Imbalance of Cross-Modal Attention in Large Audio Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Sound (cs.SD)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Multimedia (cs.MM)","subjectScheme":"arXiv"},{"lang":"en","subject":"Audio and Speech Processing (eess.AS)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T09:02:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-24T00:43:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large Audio-Language Models (LALMs) often suffer from audio-textual attention imbalance, prioritizing text over acoustic information, particularly in the multi-modal fusion layers of the Transformer architecture. This bias hinders their ability to fully utilize acoustic cues, causing suboptimal performance on audio reasoning tasks. To mitigate this, we propose \\textbf{MATA}, a novel training-free method that dynamically pushes LALMs to pay \\textbf{M}ore \\textbf{A}ttention \\textbf{T}o \\textbf{A}udio tokens within the self-attention mechanism. Specifically, MATA intervenes post raw attention scoring, targeting only the last token in intermediate layers without introducing additional parameters or computational overhead. Experiments on the MMAU and MMAR benchmarks confirm MATA's effectiveness, with consistent performance gains. Notably, on MMAR, MATA enables an open-source model to surpass the proprietary Gemini 2.0 Flash for the first time. Our work provides an efficient solution to mitigate attention bias and opens a new research direction for enhancing the audio-processing capabilities of multi-modal models.","descriptionType":"Abstract"},{"description":"Submitted to ICASSP 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.18816","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-24T02:07:23.000Z","registered":"2025-09-24T02:07:24.000Z","published":"2025","updated":"2025-09-24T02:07:24.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.18816","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}