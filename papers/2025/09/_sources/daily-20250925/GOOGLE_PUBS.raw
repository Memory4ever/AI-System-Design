          <a class="row-card__heading glue-link" href=https://research.google/pubs/mage-modality-agnostic-music-generation-and-editing/ >
            
              MAGE: Modality-Agnostic Music Generation and Editing
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        Muhammad Usama Saleem
                      
                    </div>
                
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Ravi Tejasvi
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Rajeev Nongpiur
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        <a class="row-card__small-link" href="/people/cady-tianyu-xu/">
                          Cady Xu
                        </a>
                      
                    </div>
                  
              
            
              
                
                  
