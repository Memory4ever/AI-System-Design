                        Bianca Gallardo
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Ying Wang
                      
                    </div>
                  
              
            
          
          
          <div class="row-card__subheading__spacer"></div>
          <div class="row-card__subheading__item small-text">
             Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems (CHI ’26), April 13–17, 2026, Barcelona, Spain (2026)
          </div>
          
