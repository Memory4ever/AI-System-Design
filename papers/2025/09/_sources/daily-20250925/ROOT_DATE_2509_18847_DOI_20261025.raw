{"data":{"id":"10.48550/arxiv.2509.18847","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18847","prefix":"10.48550","suffix":"arxiv.2509.18847","identifiers":[{"identifier":"2509.18847","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.18847"}],"creators":[{"name":"Su, Junhao","nameType":"Personal","givenName":"Junhao","familyName":"Su","affiliation":[],"nameIdentifiers":[]},{"name":"Wan, Yuanliang","nameType":"Personal","givenName":"Yuanliang","familyName":"Wan","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Junwei","nameType":"Personal","givenName":"Junwei","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Shi, Hengyu","nameType":"Personal","givenName":"Hengyu","familyName":"Shi","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Tianyang","nameType":"Personal","givenName":"Tianyang","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Luo, Junfeng","nameType":"Personal","givenName":"Junfeng","familyName":"Luo","affiliation":[],"nameIdentifiers":[]},{"name":"Qiu, Yurui","nameType":"Personal","givenName":"Yurui","familyName":"Qiu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Failure Makes the Agent Stronger: Enhancing Accuracy through Structured Reflection for Reliable Tool Interactions"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-23T09:35:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-24T00:44:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T14:17:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:52:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-15T06:57:52Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-16T00:32:27Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Tool-augmented large language models (LLMs) are usually trained with supervised imitation or coarse-grained reinforcement learning that optimizes single tool calls. Current self-reflection practices rely on heuristic prompts or one-way reasoning: the model is urged to 'think more' instead of learning error diagnosis and repair. This is fragile in multi-turn interactions; after a failure the model often repeats the same mistake. We propose structured reflection, which turns the path from error to repair into an explicit, controllable, and trainable action. The agent produces a short yet precise reflection: it diagnoses the failure using evidence from the previous step and then proposes a correct, executable follow-up call. For training we combine DAPO and GSPO objectives with a reward scheme tailored to tool use, optimizing the stepwise strategy Reflect, then Call, then Final. To evaluate, we introduce Tool-Reflection-Bench, a lightweight benchmark that programmatically checks structural validity, executability, parameter correctness, and result consistency. Tasks are built as mini trajectories of erroneous call, reflection, and corrected call, with disjoint train and test splits. Experiments on BFCL v3 and Tool-Reflection-Bench show large gains in multi-turn tool-call success and error recovery, and a reduction of redundant calls. These results indicate that making reflection explicit and optimizing it directly improves the reliability of tool interaction and offers a reproducible path for agents to learn from failure.","descriptionType":"Abstract"},{"description":"ACL","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.18847","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-24T02:08:13.000Z","registered":"2025-09-24T02:08:14.000Z","published":"2025","updated":"2026-04-16T02:18:14.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.18847","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}