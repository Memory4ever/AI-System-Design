<td id="S5.T3.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">0.7863</td>
<td id="S5.T3.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.9174</td>
<td id="S5.T3.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.1.1.2.4.1" class="ltx_text ltx_font_bold">0.9955</span></td>
<td id="S5.T3.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t">0.9270</td></tr>
<tr id="S5.T3.1.1.3" class="ltx_tr">
<th id="S5.T3.1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">LAWM (<span id="S5.T3.1.1.3.1.1" class="ltx_text ltx_font_bold">Ours</span>)</th>
<td id="S5.T3.1.1.3.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T3.1.1.3.2.1" class="ltx_text ltx_font_bold">0.9154</span></td>
<td id="S5.T3.1.1.3.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T3.1.1.3.3.1" class="ltx_text ltx_font_bold">0.9599</span></td>
