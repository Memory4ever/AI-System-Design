<th id="S4.T8.2.1.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S4.T8.2.1.16.1.1" class="ltx_text ltx_font_bold">OmniBridge (Ours)</span></th>
<td id="S4.T8.2.1.16.2" class="ltx_td ltx_align_center ltx_border_bb">80.55</td>
<td id="S4.T8.2.1.16.3" class="ltx_td ltx_align_center ltx_border_bb">85.85</td>
<td id="S4.T8.2.1.16.4" class="ltx_td ltx_align_center ltx_border_bb">84.94</td>
