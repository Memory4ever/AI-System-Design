{"data":{"id":"10.48550/arxiv.2509.18577","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18577","prefix":"10.48550","suffix":"arxiv.2509.18577","identifiers":[{"identifier":"2509.18577","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.18577"}],"creators":[{"name":"Seo, Yeongbin","nameType":"Personal","givenName":"Yeongbin","familyName":"Seo","affiliation":[],"nameIdentifiers":[]},{"name":"Kim, Gayoung","nameType":"Personal","givenName":"Gayoung","familyName":"Kim","affiliation":[],"nameIdentifiers":[]},{"name":"Kim, Jaehyung","nameType":"Personal","givenName":"Jaehyung","familyName":"Kim","affiliation":[],"nameIdentifiers":[]},{"name":"Yeo, Jinyoung","nameType":"Personal","givenName":"Jinyoung","familyName":"Yeo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prior-based Noisy Text Data Filtering: Fast and Strong Alternative For Perplexity"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"I.2.7","subjectScheme":"ACM"},{"lang":"en","subject":"68T50","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-23T02:57:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-24T00:25:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-29T02:13:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T01:28:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-02T05:39:55Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-03T02:41:19Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-03T08:49:36Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-04T01:36:09Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"As large language models (LLMs) are pretrained on massive web corpora, careful selection of data becomes essential to ensure effective and efficient learning. While perplexity (PPL)-based filtering has shown strong performance, it suffers from drawbacks: substantial time costs and inherent unreliability of the model when handling noisy or out-of-distribution samples. In this work, we propose a simple yet powerful alternative: a prior-based data filtering method that estimates token priors using corpus-level term frequency statistics, inspired by linguistic insights on word roles and lexical density. Our approach filters documents based on the mean and standard deviation of token priors, serving as a fast proxy to PPL while requiring no model inference. Despite its simplicity, the prior-based filter achieves the highest average performance across 20 downstream benchmarks, while reducing time cost by over 1000x compared to PPL-based filtering. We further demonstrate its applicability to symbolic languages such as code and math, and its dynamic adaptability to multilingual corpora without supervision","descriptionType":"Abstract"},{"description":"ICLR 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.18577","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-24T02:01:36.000Z","registered":"2025-09-24T02:01:36.000Z","published":"2025","updated":"2026-03-04T03:17:56.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.18577","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}