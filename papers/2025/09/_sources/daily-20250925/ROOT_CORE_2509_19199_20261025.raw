<tr id="S4.T1.4.8" class="ltx_tr">
<th id="S4.T1.4.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Base Model (ReAct)</th>
<td id="S4.T1.4.8.2" class="ltx_td ltx_align_center ltx_border_t">21.5</td>
<td id="S4.T1.4.8.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">47.3</td>
