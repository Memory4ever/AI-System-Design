<th id="A1.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_tt" colspan="2"><span id="A1.T3.2.1.2.1" class="ltx_text ltx_font_bold">Impact of Count</span></th></tr>
</thead>
