<td id="S4.T2.2.6.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S4.T2.2.6.3.1" class="ltx_text" style="--ltx-bg-color:#FFD9D9;">43.7</span></td>
