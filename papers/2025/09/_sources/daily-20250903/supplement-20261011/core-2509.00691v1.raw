e ltx_font_typewriter"> </span><span id="lstnumberx2.47" class="ltx_text ltx_lst_identifier ltx_font_typewriter">detailed</span><span id="lstnumberx2.48" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.49" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.50" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx2.51" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.52" class="ltx_text ltx_lst_identifier ltx_font_typewriter">realistic</span><span id="lstnumberx2.53" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx2.54" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.55" class="ltx_text ltx_lst_identifier ltx_font_typewriter">DO</span><span id="lstnumberx2.56" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.57" class="ltx_text ltx_lst_identifier ltx_font_typewriter">NOT</span><span id="lstnumberx2.58" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.59" class="ltx_text ltx_lst_identifier ltx_font_typewriter">USE</span><span id="lstnumberx2.60" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.61" class="ltx_text ltx_lst_identifier ltx_font_typewriter">THE</span><span id="lstnumberx2.62" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.63" class="ltx_text ltx_lst_identifier ltx_font_typewriter">WORDS</span><span id="lstnumberx2.64" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.65" class="ltx_text ltx_font_typewriter">{</span><span id="lstnumberx2.66" class="ltx_text ltx_lst_identifier ltx_font_typewriter">subject</span><span id="lstnumberx2.67" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx2.68" class="ltx_text ltx_lst_identifier ltx_font_typewriter">upper</span><span id="lstnumberx2.69" class="ltx_text ltx_font_typewriter">()}</span><span id="lstnumberx2.70" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.71" class="ltx_text ltx_lst_identifier ltx_font_typewriter">in</span><span id="lstnumberx2.72" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.73" class="ltx_text ltx_lst_identifier ltx_font_typewriter">your</span><span id="lstnumberx2.74" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx2.76" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.77" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.78" class="ltx_text ltx_lst_identifier ltx_font_typewriter">instead</span><span id="lstnumberx2.79" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.80" class="ltx_text ltx_lst_identifier ltx_font_typewriter">write</span><span id="lstnumberx2.81" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.82" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx2.83" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.84" class="ltx_text ltx_lst_identifier ltx_font_typewriter">opposite</span><span id="lstnumberx2.85" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.86" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx2.87" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.88" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx2.89" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.90" class="ltx_text ltx_lst_identifier ltx_font_typewriter">concept</span><span id="lstnumberx2.91" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx2.92" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.93" class="ltx_text ltx_lst_identifier ltx_font_typewriter">For</span><span id="lstnumberx2.94" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.95" class="ltx_text ltx_lst_identifier ltx_font_typewriter">example</span><span id="lstnumberx2.96" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.97" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.98" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx2.99" class="ltx_text ltx_lst_identifier ltx_font_typewriter">active</span><span id="lstnumberx2.100" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx2.101" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.102" class="ltx_text ltx_font_typewriter">-&gt;</span><span id="lstnumberx2.103" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.104" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx2.105" class="ltx_text ltx_lst_identifier ltx_font_typewriter">very</span><span id="lstnumberx2.106" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.107" class="ltx_text ltx_lst_identifier ltx_font_typewriter">inactive</span><span id="lstnumberx2.108" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.109" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.110" class="ltx_text ltx_lst_identifier ltx_font_typewriter">lethargic</span><span id="lstnumberx2.111" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.112" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.113" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sluggish</span><span id="lstnumberx2.114" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.115" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.116" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx2.117" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.118" class="ltx_text ltx_lst_identifier ltx_font_typewriter">lazy</span><span id="lstnumberx2.119" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx2.120" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.121" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx2.122" class="ltx_text ltx_lst_identifier ltx_font_typewriter">angry</span><span id="lstnumberx2.123" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx2.124" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.125" class="ltx_text ltx_font_typewriter">-&gt;</span><span id="lstnumberx2.126" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.127" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx2.128" class="ltx_text ltx_lst_identifier ltx_font_typewriter">very</span><span id="lstnumberx2.129" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.130" class="ltx_text ltx_lst_identifier ltx_font_typewriter">calm</span><span id="lstnumberx2.131" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.132" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.133" class="ltx_text ltx_lst_identifier ltx_font_typewriter">peaceful</span><span id="lstnumberx2.134" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.135" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.136" class="ltx_text ltx_lst_identifier ltx_font_typewriter">and</span><span id="lstnumberx2.137" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.138" class="ltx_text ltx_lst_identifier ltx_font_typewriter">relaxed</span><span id="lstnumberx2.139" class="ltx_text ltx_font_typewriter">"</span>
</span>
