<td id="S5.T3.5.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><math id="S5.T3.m3" class="ltx_Math" alttext="\bar{\delta_{a}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi>δ</mi><mi>a</mi></msub><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\delta_{a}}</annotation></semantics></math></td></tr>
