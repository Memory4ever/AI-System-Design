    </author>
    <author>
      <name>Alicja Kasicka</name>
    </author>
    <author>
      <name>Natalia Krawczyk</name>
    </author>
    <author>
      <name>Magalie Ochs</name>
    </author>
    <author>
      <name>Gwénolé Lecorvé</name>
    </author>
