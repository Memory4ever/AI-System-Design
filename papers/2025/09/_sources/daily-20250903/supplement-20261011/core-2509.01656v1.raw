<td id="S3.T4.3.1.5.12" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">51.00</td>
<td id="S3.T4.3.1.5.13" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">53.47</td>
