<td id="S3.T4.3.1.6.16" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S3.T4.3.1.6.16.1" class="ltx_text ltx_font_bold">60.48</span></td></tr>
