<div id="A2.T7.6" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:103.5pt;height:31.8pt;vertical-align:-14.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-28.5pt,8.7pt) scale(0.644865453323716,0.644865453323716) ;">
