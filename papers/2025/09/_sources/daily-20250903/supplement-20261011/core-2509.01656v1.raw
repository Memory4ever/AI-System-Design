<td id="S3.T4.3.1.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">✔</td>
<td id="S3.T4.3.1.6.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S3.T4.3.1.6.4.1" class="ltx_text ltx_font_bold">70.43</span></td>
