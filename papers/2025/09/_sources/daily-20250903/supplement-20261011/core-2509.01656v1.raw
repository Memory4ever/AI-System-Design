<td id="S2.T1.3.1.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="S2.T1.3.1.1.2.1" class="ltx_text ltx_font_bold">Description</span></td>
<td id="S2.T1.3.1.1.3" class="ltx_td ltx_align_left ltx_border_tt"><span id="S2.T1.3.1.1.3.1" class="ltx_text ltx_font_bold">Arguments</span></td>
<td id="S2.T1.3.1.1.4" class="ltx_td ltx_align_left ltx_border_tt"><span id="S2.T1.3.1.1.4.1" class="ltx_text ltx_font_bold">Tool Output</span></td></tr>
