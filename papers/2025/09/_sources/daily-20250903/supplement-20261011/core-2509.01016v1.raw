<td id="A4.T3.5.14.2" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.14.3" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.14.4" class="ltx_td ltx_align_center">Failure</td>
<td id="A4.T3.5.14.5" class="ltx_td ltx_align_center">Failure</td>
<td id="A4.T3.5.14.6" class="ltx_td ltx_align_center">42</td>
<td id="A4.T3.5.14.7" class="ltx_td ltx_align_center">0.8</td></tr>
<tr id="A4.T3.5.15" class="ltx_tr">
<td id="A4.T3.5.15.1" class="ltx_td ltx_align_left">14</td>
<td id="A4.T3.5.15.2" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.15.3" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.15.4" class="ltx_td ltx_align_center">Failure</td>
<td id="A4.T3.5.15.5" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.15.6" class="ltx_td ltx_align_center">14</td>
<td id="A4.T3.5.15.7" class="ltx_td ltx_align_center">0.3</td></tr>
<tr id="A4.T3.5.16" class="ltx_tr">
<td id="A4.T3.5.16.1" class="ltx_td ltx_align_left">15</td>
<td id="A4.T3.5.16.2" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.16.3" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.16.4" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.16.5" class="ltx_td ltx_align_center">Failure</td>
<td id="A4.T3.5.16.6" class="ltx_td ltx_align_center">36</td>
<td id="A4.T3.5.16.7" class="ltx_td ltx_align_center">0.7</td></tr>
<tr id="A4.T3.5.17" class="ltx_tr">
<td id="A4.T3.5.17.1" class="ltx_td ltx_align_left">16</td>
<td id="A4.T3.5.17.2" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.17.3" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.17.4" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.17.5" class="ltx_td ltx_align_center">Success</td>
<td id="A4.T3.5.17.6" class="ltx_td ltx_align_center">1804</td>
<td id="A4.T3.5.17.7" class="ltx_td ltx_align_center">32.8</td></tr>
<tr id="A4.T3.5.18" class="ltx_tr">
<td id="A4.T3.5.18.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="A4.T3.5.18.1.1" class="ltx_text ltx_font_bold">Total</span></td>
<td id="A4.T3.5.18.2" class="ltx_td ltx_border_bb ltx_border_t"></td>
<td id="A4.T3.5.18.3" class="ltx_td ltx_border_bb ltx_border_t"></td>
<td id="A4.T3.5.18.4" class="ltx_td ltx_border_bb ltx_border_t"></td>
<td id="A4.T3.5.18.5" class="ltx_td ltx_border_bb ltx_border_t"></td>
<td id="A4.T3.5.18.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">5500</td>
