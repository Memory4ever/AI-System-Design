<figure id="S4.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.00190v1/Llama_socialiqa_tsne.svg" id="S4.F2.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/357;" width="476" height="357"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">((b)) </span>Llama on SocialIQA</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S4.F2.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.00190v1/Llama_Math_tsne.svg" id="S4.F2.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/357;" width="476" height="357"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">((c)) </span>Llama on on Math</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S4.F2.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.00190v1/Llama_musique_tsne.svg" id="S4.F2.sf4.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/357;" width="476" height="357"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">((d)) </span>Llama on MusiQUe</figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>t-SNE projection of Chain-of-Thought step embeddings from Llama-3B across four datasets.</figcaption>
</figure>
<figure id="S4.T1" class="ltx_table">
<table id="S4.T1.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T1.2.1" class="ltx_tr">
<th id="S4.T1.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.1.1" class="ltx_text ltx_font_bold">Cluster ID</span></th>
<th id="S4.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.2.1" class="ltx_text ltx_font_bold">Label</span></th>
<th id="S4.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.3.1" class="ltx_text ltx_font_bold">Description</span></th>
<th id="S4.T1.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.2.1.4.1" class="ltx_text ltx_font_bold">Rank in CoT</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.2.2" class="ltx_tr">
<td id="S4.T1.2.2.1" class="ltx_td ltx_align_center ltx_border_t">0</td>
<td id="S4.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t">Scenario Description</td>
<td id="S4.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t">Summarize the scenario’s characters, actions, setting.</td>
<td id="S4.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t">4</td></tr>
<tr id="S4.T1.2.3" class="ltx_tr">
<td id="S4.T1.2.3.1" class="ltx_td ltx_align_center">1</td>
<td id="S4.T1.2.3.2" class="ltx_td ltx_align_center">Problem Framing</td>
<td id="S4.T1.2.3.3" class="ltx_td ltx_align_center">Extract key facts and define the question and options.</td>
<td id="S4.T1.2.3.4" class="ltx_td ltx_align_center">2</td></tr>
<tr id="S4.T1.2.4" class="ltx_tr">
<td id="S4.T1.2.4.1" class="ltx_td ltx_align_center">2</td>
<td id="S4.T1.2.4.2" class="ltx_td ltx_align_center">Detailed Option Evaluation</td>
<td id="S4.T1.2.4.3" class="ltx_td ltx_align_center">Integrate reasoning steps into a clear conclusion.</td>
<td id="S4.T1.2.4.4" class="ltx_td ltx_align_center">5</td></tr>
<tr id="S4.T1.2.5" class="ltx_tr">
<td id="S4.T1.2.5.1" class="ltx_td ltx_align_center">3</td>
<td id="S4.T1.2.5.2" class="ltx_td ltx_align_center">Option Analysis</td>
<td id="S4.T1.2.5.3" class="ltx_td ltx_align_center">Laying out settings before evaluating choices.</td>
<td id="S4.T1.2.5.4" class="ltx_td ltx_align_center">1</td></tr>
<tr id="S4.T1.2.6" class="ltx_tr">
<td id="S4.T1.2.6.1" class="ltx_td ltx_align_center ltx_border_bb">4</td>
