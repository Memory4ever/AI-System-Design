<th id="S3.T1.7.1.2.9" class="ltx_td ltx_align_right ltx_th ltx_th_column"><span id="S3.T1.7.1.2.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;">per 1K [s]</span></th></tr>
<tr id="S3.T1.7.1.3" class="ltx_tr">
<td id="S3.T1.7.1.3.1" class="ltx_td"></td>
<th id="S3.T1.7.1.3.2" class="ltx_td ltx_th ltx_th_column"></th>
