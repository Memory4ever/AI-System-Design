<th id="S3.T1.7.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S3.T1.7.1.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">score (<math id="S3.T1.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></th>
