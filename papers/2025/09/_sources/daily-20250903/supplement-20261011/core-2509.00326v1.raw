<th id="S3.T1.7.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.7.1.1.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">#wins (<math id="S3.T1.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></th>
<th id="S3.T1.7.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.7.1.1.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Improva-</span></th>
