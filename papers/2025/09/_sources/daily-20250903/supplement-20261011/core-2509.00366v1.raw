              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.3.1" class="ltx_text ltx_font_bold">1</span></span>
            <span id="algorithm3.4.3.2" class="ltx_text ltx_font_bold">Initialize:</span> <math id="algorithm3.m9" class="ltx_Math" alttext="Q\leftarrow[(start\_node,[start\_node])]" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">Q\leftarrow[(start\_node,[start\_node])]</annotation></semantics></math>, <math id="algorithm3.m10" class="ltx_Math" alttext="valid\_trajectories\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">valid\_trajectories\leftarrow\emptyset</annotation></semantics></math>
</div>
<div id="algorithm3.4.4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.4.1" class="ltx_text ltx_font_bold">2</span></span>
            <span id="algorithm3.4.4.2" class="ltx_text ltx_font_bold">while</span> <em id="algorithm3.4.4.3" class="ltx_emph ltx_font_italic"><math id="algorithm3.m11" class="ltx_Math" alttext="Q\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">Q\neq\emptyset</annotation></semantics></math> <span id="algorithm3.4.4.3.1" class="ltx_text ltx_font_bold">and</span> <math id="algorithm3.m12" class="ltx_Math" alttext="depth&lt;max\_depth" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>&lt;</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">_</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></mrow><annotation encoding="application/x-tex">depth&lt;max\_depth</annotation></semantics></math></em> <span id="algorithm3.4.4.4" class="ltx_text ltx_font_bold">do</span>
</div>
