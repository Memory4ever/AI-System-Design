</figure>
<figure id="S5.F2" class="ltx_figure"><img src="2509.01514v1/figure_1.png" id="S5.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:381/263;" width="381" height="263" alt="Refer to caption">
