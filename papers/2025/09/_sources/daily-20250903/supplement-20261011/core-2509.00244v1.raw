<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Example Research Strategies</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Minimal Research Strategy</h3>

<div id="A1.SS1.p1" class="ltx_para ltx_noindent">
<div id="A1.SS1.p1.1" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx1" class="ltx_listingline">1.<span id="lstnumberx1.1" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.2" class="ltx_text ltx_lst_identifier">Send</span><span id="lstnumberx1.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.4" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx1.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.6" class="ltx_text ltx_lst_identifier">notification</span><span id="lstnumberx1.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.8" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx1.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.10" class="ltx_text ltx_lst_identifier">type</span><span id="lstnumberx1.11" class="ltx_text ltx_lst_space"> </span>"<span id="lstnumberx1.12" class="ltx_text ltx_lst_identifier">prompt_received</span>"<span id="lstnumberx1.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.14" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx1.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.16" class="ltx_text ltx_lst_identifier">description</span><span id="lstnumberx1.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.18" class="ltx_text ltx_lst_identifier">saying</span><span id="lstnumberx1.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.20" class="ltx_text ltx_lst_identifier">what</span><span id="lstnumberx1.21" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.22" class="ltx_text ltx_lst_identifier">PROMPT</span><span id="lstnumberx1.23" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.24" class="ltx_text ltx_lst_identifier">has</span><span id="lstnumberx1.25" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.26" class="ltx_text ltx_lst_identifier">been</span><span id="lstnumberx1.27" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.28" class="ltx_text ltx_lst_identifier">received</span>,<span id="lstnumberx1.29" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.30" class="ltx_text ltx_lst_identifier">e</span>.<span id="lstnumberx1.31" class="ltx_text ltx_lst_identifier">g</span>.<span id="lstnumberx1.32" class="ltx_text ltx_lst_space"> </span>"<span id="lstnumberx1.33" class="ltx_text ltx_lst_identifier">Received</span><span id="lstnumberx1.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.35" class="ltx_text ltx_lst_identifier">research</span><span id="lstnumberx1.36" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx1.37" class="ltx_text ltx_lst_identifier">request</span>:<span id="lstnumberx1.38" class="ltx_text ltx_lst_space"> </span>{<span id="lstnumberx1.39" class="ltx_text ltx_lst_identifier">PROMPT</span>}"
</div>
<div id="lstnumberx2" class="ltx_listingline">2.<span id="lstnumberx2.1" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.2" class="ltx_text ltx_lst_identifier">Send</span><span id="lstnumberx2.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.4" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx2.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.6" class="ltx_text ltx_lst_identifier">notification</span><span id="lstnumberx2.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.8" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx2.9" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.10" class="ltx_text ltx_lst_identifier">type</span><span id="lstnumberx2.11" class="ltx_text ltx_lst_space"> </span>"<span id="lstnumberx2.12" class="ltx_text ltx_lst_identifier">prompt_analysis_started</span>",<span id="lstnumberx2.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.14" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx2.15" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.16" class="ltx_text ltx_lst_identifier">description</span><span id="lstnumberx2.17" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.18" class="ltx_text ltx_lst_identifier">indicating</span><span id="lstnumberx2.19" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.20" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx2.21" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.22" class="ltx_text ltx_lst_identifier">we</span><span id="lstnumberx2.23" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.24" class="ltx_text ltx_lst_identifier">are</span><span id="lstnumberx2.25" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.26" class="ltx_text ltx_lst_identifier">now</span><span id="lstnumberx2.27" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.28" class="ltx_text ltx_lst_identifier">analyzing</span><span id="lstnumberx2.29" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.30" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx2.31" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.32" class="ltx_text ltx_lst_identifier">research</span><span id="lstnumberx2.33" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.34" class="ltx_text ltx_lst_identifier">request</span>.
</div>
