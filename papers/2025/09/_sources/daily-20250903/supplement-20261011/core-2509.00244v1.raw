<div id="lstnumberx120" class="ltx_listingline"><span id="lstnumberx120.1" class="ltx_text ltx_lst_identifier">Ulysses</span><span id="lstnumberx120.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.3" class="ltx_text ltx_lst_identifier">S</span>.<span id="lstnumberx120.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.5" class="ltx_text ltx_lst_identifier">Grant</span>,<span id="lstnumberx120.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.7" class="ltx_text ltx_lst_identifier">born</span><span id="lstnumberx120.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.9" class="ltx_text ltx_lst_identifier">Hiram</span><span id="lstnumberx120.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.11" class="ltx_text ltx_lst_identifier">Ulysses</span><span id="lstnumberx120.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.13" class="ltx_text ltx_lst_identifier">Grant</span>,<span id="lstnumberx120.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.15" class="ltx_text ltx_lst_identifier">rose</span><span id="lstnumberx120.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.17" class="ltx_text ltx_lst_identifier">from</span><span id="lstnumberx120.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.19" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx120.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.21" class="ltx_text ltx_lst_identifier">mediocre</span><span id="lstnumberx120.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.23" class="ltx_text ltx_lst_identifier">military</span><span id="lstnumberx120.24" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.25" class="ltx_text ltx_lst_identifier">career</span><span id="lstnumberx120.26" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.27" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx120.28" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.29" class="ltx_text ltx_lst_identifier">become</span><span id="lstnumberx120.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.31" class="ltx_text ltx_lst_identifier">one</span><span id="lstnumberx120.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.33" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx120.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.35" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx120.36" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.37" class="ltx_text ltx_lst_identifier">most</span><span id="lstnumberx120.38" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.39" class="ltx_text ltx_lst_identifier">renowned</span><span id="lstnumberx120.40" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.41" class="ltx_text ltx_lst_identifier">generals</span><span id="lstnumberx120.42" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.43" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx120.44" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.45" class="ltx_text ltx_lst_identifier">U</span>.<span id="lstnumberx120.46" class="ltx_text ltx_lst_identifier">S</span>.<span id="lstnumberx120.47" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.48" class="ltx_text ltx_lst_identifier">history</span>,<span id="lstnumberx120.49" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.50" class="ltx_text ltx_lst_identifier">credited</span><span id="lstnumberx120.51" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.52" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx120.53" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.54" class="ltx_text ltx_lst_identifier">winning</span><span id="lstnumberx120.55" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx120.56"