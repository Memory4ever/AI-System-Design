</span></span><span id="S4.T3.2.1.1.2.2" class="ltx_text"></span></span></th>
<th id="S4.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_t"><span id="S4.T3.2.1.2.1" class="ltx_text"></span><span id="S4.T3.2.1.2.2" class="ltx_text ltx_font_bold"> <span id="S4.T3.2.1.2.2.1" class="ltx_text">
<span id="S4.T3.2.1.2.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T3.2.1.2.2.1.1.1" class="ltx_tr">
