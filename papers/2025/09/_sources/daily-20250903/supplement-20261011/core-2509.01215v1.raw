<tr id="S3.T5.2.1.3" class="ltx_tr">
<th id="S3.T5.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:7.0pt;padding-right:7.0pt;" colspan="7"><span id="S3.T5.2.1.3.1.1" class="ltx_text ltx_font_bold">Pipeline Methods</span></th>
<td id="S3.T5.2.1.3.2" class="ltx_td ltx_border_t" style="padding-left:7.0pt;padding-right:7.0pt;"></td></tr>
