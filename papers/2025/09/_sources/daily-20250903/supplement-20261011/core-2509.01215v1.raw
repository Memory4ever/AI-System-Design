<figure id="S3.F5" class="ltx_figure"><object type="image/svg+xml" data="2509.01215v1/fig4-2.svg" id="S3.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/296;" width="476" height="296"></object>
