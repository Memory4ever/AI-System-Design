<span id="A3.T3.2.3.3.1.1" class="ltx_p"><math id="A3.T3.m8" class="ltx_Math" alttext="0.00013" display="inline" intent=":literal"><semantics><mn>0.00013</mn><annotation encoding="application/x-tex">0.00013</annotation></semantics></math></span>
</span></td>
