<span id="A4.T4.2.2.2.1.1" class="ltx_p"><span id="A4.T4.2.2.2.1.1.1" class="ltx_text ltx_font_italic">Baseline 
<br class="ltx_break">w/o gap defns.</span></span>
</span></td>
<td id="A4.T4.2.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A4.T4.2.2.3.1" class="ltx_inline-block ltx_align_top" style="width:51.7pt;">
<span id="A4.T4.2.2.3.1.1" class="ltx_p"><span id="A4.T4.2.2.3.1.1.1" class="ltx_text ltx_font_italic">Baseline 
