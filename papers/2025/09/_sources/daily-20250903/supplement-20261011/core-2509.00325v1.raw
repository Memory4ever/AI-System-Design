<span id="A3.T3.2.3.4.1" class="ltx_inline-block ltx_align_top" style="width:27.6pt;">
<span id="A3.T3.2.3.4.1.1" class="ltx_p ltx_align_right"><math id="A3.T3.m9" class="ltx_Math" alttext="+0.11" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>0.11</mn></mrow><annotation encoding="application/x-tex">+0.11</annotation></semantics></math></span>
</span></td>
<td id="A3.T3.2.3.5" class="ltx_td ltx_align_left ltx_align_top">
<span id="A3.T3.2.3.5.1" class="ltx_inline-block ltx_align_top" style="width:62.1pt;">
<span id="A3.T3.2.3.5.1.1" class="ltx_p ltx_align_right"><math id="A3.T3.m10" class="ltx_Math" alttext="[+0.07,+0.16]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>+</mo><mn>0.07</mn></mrow><mo>,</mo><mrow><mo>+</mo><mn>0.16</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[+0.07,+0.16]</annotation></semantics></math></span>
</span></td>
<td id="A3.T3.2.3.6" class="ltx_td ltx_align_left ltx_align_top">
