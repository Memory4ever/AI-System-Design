<td id="S7.T2.2.3.3" class="ltx_td ltx_align_center" style="padding-left:2.7pt;padding-right:2.7pt;">4</td>
<td id="S7.T2.2.3.4" class="ltx_td ltx_align_center" style="padding-left:2.7pt;padding-right:2.7pt;">4</td>
<td id="S7.T2.2.3.5" class="ltx_td ltx_align_center" style="padding-left:2.7pt;padding-right:2.7pt;">4</td>
