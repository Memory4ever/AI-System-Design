<span id="A3.T3.2.3.6.1.1" class="ltx_p">Yes <math id="A3.T3.m11" class="ltx_Math" alttext="\blacktriangle" display="inline" intent=":literal"><semantics><mi mathvariant="normal">▲</mi><annotation encoding="application/x-tex">\blacktriangle</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T3.2.4" class="ltx_tr">
