<span id="A3.T3.2.2.6.1" class="ltx_inline-block ltx_align_top" style="width:51.7pt;">
<span id="A3.T3.2.2.6.1.1" class="ltx_p">No</span>
</span></td></tr>
<tr id="A3.T3.2.3" class="ltx_tr">
<th id="A3.T3.2.3.1" class="ltx_td ltx_th ltx_th_row"></th>
<th id="A3.T3.2.3.2" class="ltx_td ltx_align_right ltx_th ltx_th_row">Rationales Recall</th>
<td id="A3.T3.2.3.3" class="ltx_td ltx_align_left ltx_align_top">
