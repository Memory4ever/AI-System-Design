bsite/6c6d3e1316034500bc439eeda2eaaf844462e4a4-2400x1260.png\\\"],\\\"datePublished\\\":\\\"2025-08-05T16:00:00.000Z\\\",\\\"dateModified\\\":\\\"2025-08-14T16:28:38.000Z\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"mainEntityOfPage\\\":\\\"https://www.anthropic.com/news/claude-opus-4-1\\\",\\\"url\\\":\\\"https://www.anthropic.com/news/claude-opus-4-1\\\"}\"}],[\"$\",\"$L17\",null,{\"children\":[null,[\"$\",\"$L18\",null,{\"isMinimalNavigation\":\"$undefined\",\"siteSettings\":{\"headerNavigation\":\"$16:props:children:1:props:siteSettings:headerNavigation\",\"claudeCta\":\"$16:props:children:1:props:siteSettings:claudeCta\"},\"page\":\"$undefined\",\"theme\":\"$undefined\",\"hideOnScroll\":\"$undefined\"}],[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"\",\"children\":[\"$\",\"article\",null,{\"className\":\"\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__hero\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__header\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__subjects body-3 bold\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Announcements\"}]]}],[\"$\",\"h1\",null,{\"className\":\"headline-1 PostDetail-module-scss-module__UQuRMa__title\",\"children\":\"Claude Opus 4.1\"}],[\"$\",\"div\",null,{\"className\":\"body-3 agate\",\"children\":[\"$\",\"time\",null,{\"dateTime\":\"2025-08-05T16:00:00.000Z\",\"children\":\"Aug 5, 2025\"}]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__illustrationHeroWrapper\",\"children\":[\"$\",\"div\",null,{\"className\":\"Illustration-module-scss-module__WyGOtq__root Illustration-module-scss-module__WyGOtq__aspect-wide Illustration-module-scss-module__WyGOtq__padding-lg Illustration-module-scss-module__WyGOtq__radius-lg bg-clay\",\"children\":[\"$\",\"div\",null,{\"className\":\"Illustration-module-scss-module__WyGOtq__inner\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/a97733b3607b54a30778eb89de08afd9e02b9fb3-1000x1000.svg\",\"alt\":\"Claude Opus 4.1\",\"width\":1000,\"height\":1000,\"className\":\"\"}]}]}]}]]}],[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[\"$\",\"$L1b\",null,{\"body\":[{\"_key\":\"67294d260734\",\"_type\":\"block\",\"children\":[{\"_key\":\"5e904d556d0e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Today we're releasing Claude Opus 4.1, an upgrade to Claude Opus 4 on agentic tasks, real-world coding, and reasoning. We plan to release substantially larger improvements to our models in the coming weeks.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f9c564e07c7b\",\"_type\":\"block\",\"children\":[{\"_key\":\"550bd26090770\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c4e78c5881cb\",\"_type\":\"block\",\"children\":[{\"_key\":\"bdf1f8eeb6400\",\"_type\":\"span\",\"marks\":[],\"text\":\"Opus 4.1 is now available to paid Claude users and in Claude Code. It's also on our API, Amazon Bedrock, and Google Cloud's Vertex AI. Pricing is the same as Opus 4.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"84d467883201\",\"_type\":\"block\",\"children\":[{\"_key\":\"5437e17c6ebd\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude Opus 4.1\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"424feeb9bc27\",\"_type\":\"block\",\"children\":[{\"_key\":\"604c2c03a8640\",\"_type\":\"span\",\"marks\":[],\"text\":\"Opus 4.1 advances our state-of-the-art coding performance to 74.5% on \"},{\"_key\":\"04bbc612ca4f\",\"_type\":\"span\",\"marks\":[\"509a507e764d\"],\"text\":\"SWE-bench Verified\"},{\"_key\":\"e15f11280238\",\"_type\":\"span\",\"marks\":[],\"text\":\". It also improves Claude’s in-depth research and data analysis skills, especially around detail tracking and agentic search.\"}],\"markDefs\":[{\"_key\":\"509a507e764d\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.swebench.com/\"}],\"style\":\"normal\"},{\"_key\":\"bc59d3411f67\",\"_type\":\"block\",\"children\":[{\"_key\":\"b52c0f8847e5\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"147c8d00d470\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-dced1e451a52da3bcb3807d7a9510b1b5426ace6-3840x2160-png\",\"_type\":\"reference\"},\"caption\":null,\"description\":\"Chart showing Claude's progress on a popular coding evaluation\",\"height\":2160,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/dced1e451a52da3bcb3807d7a9510b1b5426ace6-3840x2160.png\",\"width\":3840},{\"_key\":\"c2be5e6f024a\",\"_type\":\"block\",\"children\":[{\"_key\":\"2fa9b71e3cbe0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"GitHub\"},{\"_key\":\"2fa9b71e3cbe1\",\"_type\":\"span\",\"marks\":[],\"text\":\" notes that Claude Opus 4.1 improves across most capabilities relative to Opus 4, with particularly notable performance gains in multi-file code refactoring. \"},{\"_key\":\"2fa9b71e3cbe2\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Rakuten Group\"},{\"_key\":\"2fa9b71e3cbe3\",\"_type\":\"span\",\"marks\":[],\"text\":\" finds that Opus 4.1 excels at pinpointing exact corrections within large codebases without making unnecessary adjustments or introducing bugs, with their team preferring this precision for everyday debugging tasks. \"},{\"_key\":\"2fa9b71e3cbe4\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Windsurf\"},{\"_key\":\"2fa9b71e3cbe5\",\"_type\":\"span\",\"marks\":[],\"text\":\" reports Opus 4.1 delivers a one standard deviation improvement over Opus 4 on their junior developer benchmark, showing roughly the same performance leap as the jump from Sonnet 3.7 to Sonnet 4.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"82c1024be77b\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-bde326699c667506c87f74b09a6355961d29eb26-2600x2084-png\",\"_type\":\"reference\"},\"caption\":null,\"description\":\"A benchmark table comparing Claude Opus 4.1 to prior Claude models and other public models\",\"height\":2084,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/bde326699c667506c87f74b09a6355961d29eb26-2600x2084.png\",\"width\":2600},{\"_key\":\"b8388611b103\",\"_type\":\"block\",\"children\":[{\"_key\":\"0967ebf9d2e00\",\"_type\":\"span\",\"marks\":[],\"text\":\"Getting started\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"b152193ef591\",\"_type\":\"block\",\"children\":[{\"_key\":\"60abf4a146970\",\"_type\":\"span\",\"marks\":[],\"text\":\"We recommend upgrading from Opus 4 to Opus 4.1 for all uses. If you’re a developer, simply use \"},{\"_key\":\"f970853975b7\",\"_type\":\"span\",\"marks\":[\"code\"],\"text\":\"claude-opus-4-1-20250805\"},{\"_key\":\"ac671c57d84f\",\"_type\":\"span\",\"marks\":[],\"text\":\" via the API. You can also explore our \"},{\"_key\":\"60abf4a146971\",\"_type\":\"span\",\"marks\":[\"ccc74b7ef235\"],\"text\":\"system card\"},{\"_key\":\"60abf4a146972\",\"_type\":\"span\",\"marks\":[],\"text\":\", \"},{\"_key\":\"60abf4a146973\",\"_type\":\"span\",\"marks\":[\"3c43fda653a4\"],\"text\":\"model page\"},{\"_key\":\"60abf4a146974\",\"_type\":\"span\",\"marks\":[],\"text\":\", \"},{\"_key\":\"60abf4a146975\",\"_type\":\"span\",\"marks\":[\"63f34d0b16ec\"],\"text\":\"pricing page\"},{\"_key\":\"60abf4a146976\",\"_type\":\"span\",\"marks\":[],\"text\":\", and \"},{\"_key\":\"60abf4a146977\",\"_type\":\"span\",\"marks\":[\"a78365c4ecf5\"],\"text\":\"docs\"},{\"_key\":\"60abf4a146978\",\"_type\":\"span\",\"marks\":[],\"text\":\" to learn more.\"}],\"markDefs\":[{\"_key\":\"ccc74b7ef235\",\"_type\":\"link\",\"href\":\"http://www.anthropic.com/claude-opus-4-1-system-card\"},{\"_key\":\"3c43fda653a4\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/claude/opus\"},{\"_key\":\"63f34d0b16ec\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/pricing#api\"},{\"_key\":\"a78365c4ecf5\",\"_type\":\"link\",\"href\":\"https://docs.anthropic.com/en/docs/about-claude/models/overview\"}],\"style\":\"normal\"},{\"_key\":\"287380ac290e\",\"_type\":\"block\",\"children\":[{\"_key\":\"823f04644b940\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4f6310a8a5df\",\"_type\":\"block\",\"children\":[{\"_key\":\"f5d0b0dfb7330\",\"_type\":\"span\",\"marks\":[],\"text\":\"As always, your \"},{\"_key\":\"912767489546\",\"_type\":\"span\",\"marks\":[\"448b247c6113\"],\"text\":\"feedback\"},{\"_key\":\"0e9e72143b0a\",\"_type\":\"span\",\"marks\":[],\"text\":\" helps us improve, especially as we continue to release new and more capable models.\"}],\"markDefs\":[{\"_key\":\"448b247c6113\",\"_type\":\"link\",\"href\":\"mailto: feedback@anthropic.com\"}],\"style\":\"normal\"}],\"footnotes\":{\"body\":\"$6:1:props:children:2:props:children:props:children:1:props:children:props:body\",\"count\":0,\"numberByListItemKey\":{},\"referenced\":\"$W1c\"},\"sidebar\":{\"isVisible\":false}}]}],\"$L1d\",\"$L1e\",\"$L1f\"]}]}],\"$L20\"]}]]\n9:null\ne:[[\"$\",\"title\",\"0\",{\"children\":\"Claude Opus 4.1 \\\\ Anthropic\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Anthropic is an AI safety and research company that's working to build reliable, interpretable, and steerable AI systems.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"msapplication-TileColor\",\"content\":\"141413\"}],[\"$\",\"meta\",\"3\",{\"name\":\"msapplication-config\",\"content\":\"/browserconfig.xml\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://www.anthropic.com/news/claude-opus-4-1\"}],[\"$\",\"meta\",\"5\",{\"name\":\"google-site-verification\",\"content\"