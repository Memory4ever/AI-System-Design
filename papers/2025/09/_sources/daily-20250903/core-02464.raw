ifier ltx_font_typewriter" style="font-size:90%;">GOOD</span><span id="lstnumberx52.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx52.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">EXAMPLE</span><span id="lstnumberx52.21" class="ltx_text ltx_font_typewriter" style="font-size:90%;">,</span><span id="lstnumberx52.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx52.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">BUT</span><span id="lstnumberx52.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx52.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">THE</span><span id="lstnumberx52.26" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx52.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">BAD</span>
</div>
<div id="lstnumberx53" class="ltx_listingline"><span id="lstnumberx53.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">EXAMPLE</span><span id="lstnumberx53.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">MIGHT</span><span id="lstnumberx53.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">BE</span><span id="lstnumberx53.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">EMPTY</span><span id="lstnumberx53.8" class="ltx_text ltx_font_typewriter" style="font-size:90%;">.</span><span id="lstnumberx53.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">THERE</span><span id="lstnumberx53.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">ALSO</span><span id="lstnumberx53.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">MIGHT</span><span id="lstnumberx53.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">BE</span><span id="lstnumberx53.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">MULTIPLE</span><span id="lstnumberx53.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">PAIRED</span><span id="lstnumberx53.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">BAD</span><span id="lstnumberx53.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx53.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">EXAMPLES</span>
</div>
<div id="lstnumberx54" class="ltx_listingline"><span id="lstnumberx54.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">WITH</span><span id="lstnumberx54.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">ONE</span><span id="lstnumberx54.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">GOOD</span><span id="lstnumberx54.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">EXAMPLE</span><span id="lstnumberx54.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">OR</span><span id="lstnumberx54.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">VICE</span><span id="lstnumberx54.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">VERSA</span><span id="lstnumberx54.14" class="ltx_text ltx_font_typewriter" style="font-size:90%;">.</span><span id="lstnumberx54.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">USE</span><span id="lstnumberx54.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">ALL</span><span id="lstnumberx54.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">OF</span><span id="lstnumberx54.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">THIS</span><span id="lstnumberx54.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">TO</span><span id="lstnumberx54.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">CALIBRATE</span><span id="lstnumberx54.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx54.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">YOUR</span>
</div>
<div id="lstnumberx55" class="ltx_listingline"><span id="lstnumberx55.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">SCORE</span><span id="lstnumberx55.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx55.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">AND</span><span id="lstnumberx55.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx55.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">TAKE</span><span id="lstnumberx55.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx55.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">IT</span><span id="lstnumberx55.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx55.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">IN</span><span id="lstnumberx55.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx55.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">CONTEXT</span><span id="lstnumberx55.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx55.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">TO</span><span id="lstnumberx55.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx55.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">THESE</span><span id="lstnumberx55.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx55.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">GROUND</span><span id="lstnumberx55.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx55.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">TRUTH</span><span id="lstnumberx55.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx55.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">REFERENCE</span>
</div>
<div id="lstnumberx56" class="ltx_listingline"><span id="lstnumberx56.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">COMPLIANCE</span><span id="lstnumberx56.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx56.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">RATINGS</span><span id="lstnumberx56.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;">:</span>
</div>
<div id="lstnumberx57" class="ltx_listingline">
</div>
<div id="lstnumberx58" class="ltx_listingline"><span id="lstnumberx58.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">{</span><span id="lstnumberx58.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">format_statement_examples</span><span id="lstnumberx58.3" class="ltx_text ltx_font_typewriter" style="font-size:90%;">(</span><span id="lstnumberx58.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">statement</span><span id="lstnumberx58.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;">)}</span>
</div>
<div id="lstnumberx59" class="ltx_listingline">
</div>
<div id="lstnumberx60" class="ltx_listingline"><span id="lstnumberx60.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">User</span><span id="lstnumberx60.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx60.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">Input</span><span id="lstnumberx60.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;">:</span>
</div>
<div id="lstnumberx61" class="ltx_listingline"><span id="lstnumberx61.1" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;">"{input_text}"</span>
</div>
<div id="lstnumberx62" class="ltx_listingline">
</div>
<div id="lstnumberx63" class="ltx_listingline"><span id="lstnumberx63.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">Assistant</span><span id="lstnumberx63.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx63.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">Response</span><span id="lstnumberx63.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;">:</span>
</div>
<div id="lstnumberx64" class="ltx_listingline"><span id="lstnumberx64.1" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:90%;">"{output_text}"</span>
</div>
