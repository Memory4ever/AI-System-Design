</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
             <span id="alg1.l8.3" class="ltx_text ltx_font_typewriter">inputs</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> TestMaker generates <math id="alg1.l8.m2" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> test inputs for this <span id="alg1.l8.4" class="ltx_text ltx_font_typewriter">scenario</span>

</div>
