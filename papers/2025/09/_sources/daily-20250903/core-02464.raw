          specification <math id="alg1.l1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>; TestMaker; Candidate; Judge; number of rounds <math id="alg1.l1.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>; scenarios per round <math id="alg1.l1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>; tests per scenario <math id="alg1.l1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>; score threshold <math id="alg1.l1.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>; target set size <math id="alg1.l1.m6" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
          curated test set <span id="alg1.l2.3" class="ltx_text ltx_font_typewriter">TestSet</span> of size <math id="alg1.l2.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>

</div>
