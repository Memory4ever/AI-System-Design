</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
            
            
             <span id="alg1.l16.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l16.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
            
            
            <span id="alg1.l17.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l17.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
            
            
          <span id="alg1.l18.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l18.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
            
            
          <span id="alg1.l19.3" class="ltx_text ltx_font_bold">if</span> |<span id="alg1.l19.4" class="ltx_text ltx_font_typewriter">TestSet</span>| &lt; <math id="alg1.l19.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> <span id="alg1.l19.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
            
            
            sort <span id="alg1.l20.3" class="ltx_text ltx_font_typewriter">History</span> by <span id="alg1.l20.4" class="ltx_text ltx_font_typewriter">score</span> ascending

</div>
<div id="alg1.l21" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
            
            
            add lowest-scoring inputs from <span id="alg1.l21.3" class="ltx_text ltx_font_typewriter">History</span> to <span id="alg1.l21.4" class="ltx_text ltx_font_typewriter">TestSet</span> until |<span id="alg1.l21.5" class="ltx_text ltx_font_typewriter">TestSet</span>| = <math id="alg1.l21.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>

</div>
