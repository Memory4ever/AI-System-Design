<td id="S5.T4.3.2.5" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">39,222</td>
<td id="S5.T4.3.2.6" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">4,664 (11.89%)</td>
<td id="S5.T4.3.2.7" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">3,296</td>
<td id="S5.T4.3.2.8" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">1,454</td></tr>
<tr id="S5.T4.3.3" class="ltx_tr">
