ght:0.66em;--ltx-fo-depth:0em;font-size:10pt;" height="9.07" overflow="visible" transform="matrix(1 0 0 -1 0 9.07)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F5.sf1.pic1.9" class="ltx_text ltx_font_sansserif" style="--ltx-fg-color:#262626;">1.7</span></span></span></foreignObject></g><g></g><g><clipPath id="pgfcp55"><path d="M 66.18 38.54 h 496 v 369.6 h -496 Z"></path></clipPath></g><g clip-path="url(#pgfcp55)"><g style="--ltx-stroke-color:#CCCCCC;" stroke="#CCCCCC" stroke-dasharray="1.85pt,0.8pt" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="round" stroke-width="0.50188pt"><path style="fill:none" d="M 66.18 308.94 L 562.18 308.94"></path></g></g><g style="--ltx-stroke-color:#262626;--ltx-fill-color:#262626;" fill="#262626" stroke="#262626" transform="matrix(1.0 0.0 0.0 1.0 34.37 303.66)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:10pt;" height="9.07" overflow="visible" transform="matrix(1 0 0 -1 0 9.07)" width="17.68"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F5.sf1.pic1.10" class="ltx_text ltx_font_sansserif" style="--ltx-fg-color:#262626;">1.8</span></span></span></foreignObject></g><g></g><g><clipPath id="pgfcp56"><path d="M 66.18 38.54 h 496 v 369.6 h -496 Z"></path></clipPath></g><g clip-path="url(#pgfcp56)"><g style="--ltx-stroke-color:#CCCCCC;" stroke="#CCCCCC" stroke-dasharray="1.85pt,0.8pt" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="round" stroke-width="0.50188pt"><path style="fill:none" d="M 66.18 361.77 L 562.18 361.77"></path></g></g><g style="--ltx-stroke-color:#262626;--ltx-fill-color:#262626;" fill="#262626" stroke="#262626" transform="matrix(1.0 0.0 0.0 1.0 34.37 356.5)"><foreignObject style="--ltx-fo-width:1.28em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:10pt;" height="9.07" overflow="visible" transform="matrix(1 0 0 -1 0 9.07)