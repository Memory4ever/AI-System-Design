#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="round" stroke-width="0.803pt" transform="matrix(1.0 0.0 0.0 1.0 262.86 60.22)"><path d="M 0 0 L 0 -4.86"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 259.4 41.43)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:10pt;" height="9.07" overflow="visible" transform="matrix(1 0 0 -1 0 9.07)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F6.sf1.pic1.8" class="ltx_text ltx_font_sansserif">8</span></span></span></foreignObject></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="round" stroke-width="0.803pt" transform="matrix(1.0 0.0 0.0 1.0 291.2 60.22)"><path d="M 0 0 L 0 -4.86"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 287.74 41.43)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.66em;--ltx-fo-depth:0em;font-size:10pt;" height="9.07" overflow="visible" transform="matrix(1 0 0 -1 0 9.07)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F6.sf1.pic1.9" class="ltx_text ltx_font_sansserif">9</span></span></span></foreignObject></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="round" stroke-width="0.803pt" transform="matrix(1.0 0.0 0.0 1.0 319.54 60.22)"><path d="M 0 0 L 0 -4.86"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0