<span id="S4.T4.3.3.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S4.T4.3.3.1.1.1" class="ltx_p ltx_align_left">is_attack</span>
</span></td>
<td id="S4.T4.3.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_b ltx_border_r ltx_border_t">
