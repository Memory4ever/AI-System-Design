<td id="S4.T3.5.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r ltx_border_t">
<span id="S4.T3.5.2.1.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="S4.T3.5.2.1.1.1" class="ltx_p ltx_align_left">Perception</span>
</span></td>
<td id="S4.T3.5.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
