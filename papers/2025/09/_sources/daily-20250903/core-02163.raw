<tr id="S6.T5.5.6" class="ltx_tr">
<th id="S6.T5.5.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S6.T5.5.6.1.1" class="ltx_text ltx_font_bold">GHI + No Defence</span></th>
