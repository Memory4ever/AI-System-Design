<td id="S6.T5.5.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S6.T5.m11" class="ltx_Math" alttext="\beta=0.4" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>=</mo><mn>0.4</mn></mrow><annotation encoding="application/x-tex">\beta=0.4</annotation></semantics></math></td>
