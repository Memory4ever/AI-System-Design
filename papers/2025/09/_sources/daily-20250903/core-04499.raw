<td id="S3.F2.sf1.2.6.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0.4</td>
<td id="S3.F2.sf1.2.6.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0.4</td>
<td id="S3.F2.sf1.2.6.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0.5</td>
<td id="S3.F2.sf1.2.6.5" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">0.4</td></tr>
<tr id="S3.F2.sf1.2.7" class="ltx_tr">
<th id="S3.F2.sf1.2.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="--ltx-bg-color:#F7F7F7;padding-top:1pt;padding-bottom:1pt;" colspan="5"><img src="2509.04499v1/Images/icons/answer_text_color.png" id="S3.F2.sf1.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:16/16;" width="16" height="16" alt="Refer to caption"><span id="S3.F2.sf1.2.7.1.1" class="ltx_text" style="--ltx-fg-color:#E61670;--ltx-bg-color:#F7F7F7;"> Answer Text Metrics</span></th></tr>
<tr id="S3.F2.sf1.2.8" class="ltx_tr">
<th id="S3.F2.sf1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">%One-Sided Answer</th>
<td id="S3.F2.sf1.2.8.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">51.6 <span id="S3.F2.sf1.2.8.2.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td>
<td id="S3.F2.sf1.2.8.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">48.7 <span id="S3.F2.sf1.2.8.3.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td>
<td id="S3.F2.sf1.2.8.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">83.4 <span id="S3.F2.sf1.2.8.4.1" class="ltx_text" style="--ltx-fg-color:#EF2E65;">▼</span></td>
<td id="S3.F2.sf1.2.8.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">90.4 <span id="S3.F2.sf1.2.8.5.1" class="ltx_text" style="--ltx-fg-color:#EF2E65;">▼</span></td></tr>
<tr id="S3.F2.sf1.2.9" class="ltx_tr">
<th id="S3.F2.sf1.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:1pt;padding-bottom:1pt;">%Overconfident Answer</th>
<td id="S3.F2.sf1.2.9.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">19.4 <span id="S3.F2.sf1.2.9.2.1" class="ltx_text" style="--ltx-fg-color:#16C056;">▲</span></td>
<td id="S3.F2.sf1.2.9.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">29.5 <span id="S3.F2.sf1.2.9.3.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td>
<td id="S3.F2.sf1.2.9.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">81.6 <span id="S3.F2.sf1.2.9.4.1" class="ltx_text" style="--ltx-fg-color:#EF2E65;">▼</span></td>
