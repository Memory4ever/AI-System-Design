<td id="S4.T1.2.21.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.2.21.2.1" class="ltx_text" style="--ltx-fg-color:#16C056;">▲▲</span></td>
