<tr id="S3.F2.sf1.2.5" class="ltx_tr">
<th id="S3.F2.sf1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:1pt;padding-bottom:1pt;">Number of Statements</th>
<td id="S3.F2.sf1.2.5.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">13.9</td>
