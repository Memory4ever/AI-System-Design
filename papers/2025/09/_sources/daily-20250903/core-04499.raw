<tr id="S3.F2.sf1.2.3" class="ltx_tr">
<th id="S3.F2.sf1.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="--ltx-bg-color:#F7F7F7;padding-top:1pt;padding-bottom:1pt;" colspan="5"><span id="S3.F2.sf1.2.3.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F7F7F7;">Basic Statistics</span></th></tr>
<tr id="S3.F2.sf1.2.4" class="ltx_tr">
