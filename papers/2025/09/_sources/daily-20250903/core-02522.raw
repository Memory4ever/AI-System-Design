<th id="A3.T5.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="A3.T5.m3" class="ltx_Math" alttext="\bm{2}" display="inline" intent=":literal"><semantics><mn>𝟐</mn><annotation encoding="application/x-tex">\bm{2}</annotation></semantics></math></th>
<th id="A3.T5.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="A3.T5.m4" class="ltx_Math" alttext="\bm{4}" display="inline" intent=":literal"><semantics><mn>𝟒</mn><annotation encoding="application/x-tex">\bm{4}</annotation></semantics></math></th>
