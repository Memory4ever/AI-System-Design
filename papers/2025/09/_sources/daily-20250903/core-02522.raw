<th id="A3.T5.2.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="A3.T5.m6" class="ltx_Math" alttext="\bm{16}" display="inline" intent=":literal"><semantics><mn>𝟏𝟔</mn><annotation encoding="application/x-tex">\bm{16}</annotation></semantics></math></th>
