<td id="A3.T5.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T5.2.1.3.7.1" class="ltx_text ltx_font_bold">83.88</span></td>
<td id="A3.T5.2.1.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T5.2.1.3.8.1" class="ltx_text ltx_font_bold">90.42</span></td>
