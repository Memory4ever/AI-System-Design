<th id="S6.T4.2.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T4.2.2.2.1" class="ltx_text ltx_font_bold">Memory [MiB]</span></th>
<th id="S6.T4.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T4.2.2.3.1" class="ltx_text ltx_font_bold">CPU [vcores]</span></th>
<th id="S6.T4.2.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T4.2.2.4.1" class="ltx_text ltx_font_bold">Memory [MiB]</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T4.2.3" class="ltx_tr">
<th id="S6.T4.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Idle</th>
<td id="S6.T4.2.3.2" class="ltx_td ltx_align_center ltx_border_t">0.01</td>
<td id="S6.T4.2.3.3" class="ltx_td ltx_align_center ltx_border_t">240</td>
<td id="S6.T4.2.3.4" class="ltx_td ltx_align_center ltx_border_t">0.03</td>
<td id="S6.T4.2.3.5" class="ltx_td ltx_align_center ltx_border_t">487</td></tr>
