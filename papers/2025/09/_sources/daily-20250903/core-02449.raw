<td id="S3.T1.2.1.4.2" class="ltx_td ltx_align_left"><span id="S3.T1.2.1.4.2.1" class="ltx_text ltx_font_typewriter">delete</span>, <span id="S3.T1.2.1.4.2.2" class="ltx_text ltx_font_typewriter">deletecollection</span></td>
