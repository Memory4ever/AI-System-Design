<td id="S3.T1.2.1.5.2" class="ltx_td ltx_align_left"><span id="S3.T1.2.1.5.2.1" class="ltx_text ltx_font_typewriter">exec</span>, <span id="S3.T1.2.1.5.2.2" class="ltx_text ltx_font_typewriter">port-forward</span>, <span id="S3.T1.2.1.5.2.3" class="ltx_text ltx_font_typewriter">attach</span>, <span id="S3.T1.2.1.5.2.4" class="ltx_text ltx_font_typewriter">proxy</span>, <span id="S3.T1.2.1.5.2.5" class="ltx_text ltx_font_typewriter">log</span></td>
<td id="S3.T1.2.1.5.3" class="ltx_td ltx_align_left">Run in-container commands, port forwarding, logs</td></tr>
