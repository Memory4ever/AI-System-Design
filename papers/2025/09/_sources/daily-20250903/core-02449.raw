<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_left"><span id="S3.T1.2.1.3.2.1" class="ltx_text ltx_font_typewriter">create</span>, <span id="S3.T1.2.1.3.2.2" class="ltx_text ltx_font_typewriter">update</span>, <span id="S3.T1.2.1.3.2.3" class="ltx_text ltx_font_typewriter">patch</span>, <span id="S3.T1.2.1.3.2.4" class="ltx_text ltx_font_typewriter">replace</span></td>
