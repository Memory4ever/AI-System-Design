<td id="S5.T3.2.16.3" class="ltx_td ltx_nopad_r ltx_align_left">0.2612 (15)</td></tr>
<tr id="S5.T3.2.17" class="ltx_tr">
<td id="S5.T3.2.17.1" class="ltx_td ltx_align_right">16</td>
<td id="S5.T3.2.17.2" class="ltx_td ltx_align_left">
<span id="S5.T3.2.17.2.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T3.2.17.2.1.1" class="ltx_p">tomasbernal01</span>
</span></td>
<td id="S5.T3.2.17.3" class="ltx_td ltx_nopad_r ltx_align_left">0.1660 (16)</td></tr>
<tr id="S5.T3.2.18" class="ltx_tr">
<td id="S5.T3.2.18.1" class="ltx_td ltx_align_right ltx_border_bb">17</td>
