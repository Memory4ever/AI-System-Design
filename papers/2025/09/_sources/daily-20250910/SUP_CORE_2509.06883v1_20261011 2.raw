<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Appendix</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Prompts used in Claimifying social media posts with Self-refinement</h3>

<section id="A1.SS1.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Claim Extraction System Prompt</h4>

<section id="A1.SS1.SSSx1.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Identity / System Message</h5>

<div id="A1.SS1.SSSx1.Px1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.SS1.SSSx1.Px1.p1.pic1" class="ltx_picture" height="40.74" overflow="visible" version="1.1" viewBox="0 0 477.38 40.74" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,40.74) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 0 3.46 L 0 37.28 C 0 39.19 1.55 40.74 3.46 40.74 L 473.92 40.74 C 475.83 40.74 477.38 39.19 477.38 37.28 L 477.38 3.46 C 477.38 1.55 475.83 0 473.92 0 L 3.46 0 C 1.55 0 0 1.55 0 3.46 Z"></path></g><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 3.46 L 0.69 37.28 C 0.69 38.81 1.93 40.04 3.46 40.04 L 473.92 40.04 C 475.45 40.04 476.68 38.81 476.68 37.28 L 476.68 3.46 C 476.68 1.93 475.45 0.69 473.92 0.69 L 3.46 0.69 C 1.93 0.69 0.69 1.93 0.69 3.46 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 10.16 9.13)"><foreignObject style="--ltx-fo-width:34.95em;--ltx-fo-height:1.75em;--ltx-fo-depth:0.13em;font-size:10pt;" height="25.94" overflow="visible" transform="matrix(1 0 0 -1 0 24.22)" width="483.61"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.SS1.SSSx1.Px1.p1.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:34.95em;">
<span id="A1.SS1.SSSx1.Px1.p1.pic1.1.1" class="ltx_p"><span id="A1.SS1.SSSx1.Px1.p1.pic1.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">You are a helpful AI assistant and an expert in claim detection, extraction,
and normalization.
</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
