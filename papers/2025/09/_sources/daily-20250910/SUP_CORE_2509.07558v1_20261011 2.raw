<li class="ltx_tocentry ltx_tocentry_paragraph"><a href="#A1.SS1.SSS0.Px1" title="In A.1 Proof of Magnitude relation of CV values ‣ Appendix A Appendix ‣ Δ⁢𝐿 Normalization: Rethink Loss Aggregation in RLVR" class="ltx_ref"><span class="ltx_text ltx_ref_title">Proof of <math class="ltx_Math" alttext="\mathrm{CV}(\bm{g}_{\mathrm{GRPO}})\leq\mathrm{CV}(\bm{g}_{\mathrm{DAPO}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>CV</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒈</mi><mi>GRPO</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>CV</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒈</mi><mi>DAPO</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CV}(\bm{g}_{\mathrm{GRPO}})\leq\mathrm{CV}(\bm{g}_{\mathrm{DAPO}})</annotation></semantics></math>.</span></a></li>
<li class="ltx_tocentry ltx_tocentry_paragraph"><a href="#A1.SS1.SSS0.Px2" title="In A.1 Proof of Magnitude relation of CV values ‣ Appendix A Appendix ‣ Δ⁢𝐿 Normalization: Rethink Loss Aggregation in RLVR" class="ltx_ref"><span class="ltx_text ltx_ref_title">Proof of <math class="ltx_Math" alttext="\mathrm{CV}(\bm{g}_{\mathrm{GRPO}})\leq\mathrm{CV}(\bm{g}_{\mathrm{Ours}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>CV</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒈</mi><mi>GRPO</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>CV</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒈</mi><mi>Ours</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CV}(\bm{g}_{\mathrm{GRPO}})\leq\mathrm{CV}(\bm{g}_{\mathrm{Ours}})</annotation></semantics></math>.</span></a></li>
<li class="ltx_tocentry ltx_tocentry_paragraph"><a href="#A1.SS1.SSS0.Px3" title="In A.1 Proof of Magnitude relation of CV values ‣ Appendix A Appendix ‣ Δ⁢𝐿 Normalization: Rethink Loss Aggregation in RLVR" class="ltx_ref"><span class="ltx_text ltx_ref_title">Proof of <math class="ltx_Math" alttext="\mathrm{CV}(\bm{g}_{\mathrm{Ours}})\leq\mathrm{CV}(\bm{g}_{\mathrm{DAPO}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>CV</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒈</mi><mi>Ours</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>CV</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒈</mi><mi>DAPO</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{CV}(\bm{g}_{\mathrm{Ours}})\leq\mathrm{CV}(\bm{g}_{\mathrm{DAPO}})</annotation></semantics></math> for <math class="ltx_Math" alttext="\alpha\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in[0,1]</annotation></semantics></math>.</span></a></li>
</ol></li>
