<td id="S4.T1.2.1.6.3" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T1.2.1.6.3.1" class="ltx_inline-block ltx_align_top" style="width:65.4pt;">
<span id="S4.T1.2.1.6.3.1.1" class="ltx_p">4k tokens</span>
</span></td>
