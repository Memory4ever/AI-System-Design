<span id="S4.T1.2.1.6.4.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T1.2.1.6.4.1.1" class="ltx_p">High (structured sparse kernels)</span>
</span></td>
<td id="S4.T1.2.1.6.5" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T1.2.1.6.5.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="S4.T1.2.1.6.5.1.1" class="ltx_p">+3.25% nDCG@10 on TREC DL’19</span>
</span></td>
<td id="S4.T1.2.1.6.6" class="ltx_td ltx_align_left ltx_align_top">
<span id="S4.T1.2.1.6.6.1" class="ltx_inline-block ltx_align_top" style="width:108.1pt;">
<span id="S4.T1.2.1.6.6.1.1" class="ltx_p">Task-specific design; limited generalizability</span>
</span></td></tr>
