<tr id="S3.T1.2.1.3" class="ltx_tr">
<td id="S3.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:0.7pt 3.0pt;" rowspan="2"><span id="S3.T1.2.1.3.1.1" class="ltx_text" style="font-size:90%;">Baichuan-Audio</span></td>
