{"data":[{"id":"10.48550/arxiv.2509.05755","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.05755","identifiers":[{"identifier":"2509.05755","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuchong","familyName":"Xie","name":"Xie, Yuchong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyu","familyName":"Luo","name":"Luo, Mingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zesen","familyName":"Liu","name":"Liu, Zesen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhixiang","familyName":"Zhang","name":"Zhang, Zhixiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaikai","familyName":"Zhang","name":"Zhang, Kaikai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Liu","name":"Liu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zongjie","familyName":"Li","name":"Li, Zongjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Chen","name":"Chen, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Wang","name":"Wang, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongdong","familyName":"She","name":"She, Dongdong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Red-Teaming Coding Agents from a Tool-Invocation Perspective: An Empirical Security Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-06T15:48:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-09T00:25:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-15T13:11:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-16T01:22:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-18T17:38:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-19T00:52:46Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09-19T17:17:58Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-09-22T00:58:08Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-01-04T13:12:54Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-01-06T01:42:13Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-06-28T05:20:23Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-06-30T00:52:10Z","dateType":"Updated","dateInformation":"v6"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Coding agents powered by large language models are becoming central modules of modern IDEs, helping users perform complex tasks by invoking tools. While powerful, tool invocation opens a substantial attack surface. Prior work has demonstrated attacks against general-purpose and domain-specific agents, but none have focused on the security risks of tool invocation in coding agents. To fill this gap, we conduct the first systematic red-teaming of six popular real-world coding agents: Cursor, Claude Code, Copilot, Windsurf, Cline, and Trae. Our red-teaming proceeds in two phases. In Phase 1, we perform prompt leakage reconnaissance to recover system prompts. We discover a general vulnerability, ToolLeak, which allows malicious prompt exfiltration through benign argument retrieval during tool invocation. In Phase 2, we hijack the agent's tool-invocation behavior using a novel two-channel prompt injection in the tool description and return values, achieving remote code execution (RCE). We adaptively construct payloads using security information leaked in Phase 1. In emulation across five backends, our method outperforms baselines on Claude-Sonnet-4, Claude-Sonnet-4.5, Grok-4, and GPT-5. On real agents, our approach succeeds on 19 of 25 agent-LLM pairs, achieving leakage on every agent using Claude and Grok backends. For tool-invocation hijacking, we obtain RCE on every tested agent-LLM pair, with our two-channel method delivering the highest success rate. We provide case studies on Cursor and Claude Code, analyze security guardrails of external and built-in tools, and conclude with practical defense recommendations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.05755","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-09T02:33:09Z","registered":"2025-09-09T02:33:09Z","published":null,"updated":"2026-06-30T04:06:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bsize%5D=100\u0026query=registered%3A%5B2025-09-08T16%3A00%3A00Z%20TO%202025-09-09T15%3A59%3A59Z%5D%20AND%20(titles.title%3A(%22language%20model%22%20OR%20%22language%20models%22%20OR%20LLM%20OR%20LLMs)%20OR%2