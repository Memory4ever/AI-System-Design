<td id="A4.T3.2.4.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T3.2.4.3.1" class="ltx_text"></span> <span id="A4.T3.2.4.3.2" class="ltx_text">
<span id="A4.T3.2.4.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="A4.T3.2.4.3.2.1.1" class="ltx_tr">
<span id="A4.T3.2.4.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">0.465</span></span>
<span id="A4.T3.2.4.3.2.1.2" class="ltx_tr">
