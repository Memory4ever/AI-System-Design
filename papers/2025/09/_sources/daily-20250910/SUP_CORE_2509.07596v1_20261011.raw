<td id="A4.T7.9.26.20" class="ltx_td ltx_align_right ltx_border_bb" style="padding:0.4pt 3.3pt;"><span id="A4.T7.9.26.20.1" class="ltx_text" style="font-size:70%;">21.64</span></td></tr>
