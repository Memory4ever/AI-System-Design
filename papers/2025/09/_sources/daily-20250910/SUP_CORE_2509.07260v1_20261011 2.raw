</span></span></td>
<td id="S5.T6.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t">Phi-3-mini-4k</td>
<td id="S5.T6.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">6.39</td>
<td id="S5.T6.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">112.39</td>
<td id="S5.T6.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">0.96</td>
<td id="S5.T6.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t">13.49</td>
<td id="S5.T6.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t">7.61</td>
<td id="S5.T6.2.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T6.2.1.2.8.1" class="ltx_text ltx_font_bold">70.20</span></td>
