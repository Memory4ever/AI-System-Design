<td id="S3.T1.3.12.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S3.T1.3.12.2.1" class="ltx_text" style="font-size:80%;">Zero-shot</span></td>
