<td id="S3.T1.3.11.3" class="ltx_td ltx_align_center" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S3.T1.3.11.3.1" class="ltx_text" style="font-size:80%;">0.16 (0.38)</span></td>
