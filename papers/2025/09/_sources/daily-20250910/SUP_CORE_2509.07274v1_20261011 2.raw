<td id="S3.T1.3.11.5" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S3.T1.3.11.5.1" class="ltx_text" style="font-size:80%;">0.13 (0.27)</span></td></tr>
