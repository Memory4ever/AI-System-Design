<td id="S3.T1.3.9.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S3.T1.3.9.5.1" class="ltx_text" style="font-size:80%;">0.17 (0.40)</span></td></tr>
<tr id="S3.T1.3.10" class="ltx_tr">
<td id="S3.T1.3.10.1" class="ltx_td" style="padding-top:0.85pt;padding-bottom:0.85pt;"></td>
<td id="S3.T1.3.10.2" class="ltx_td ltx_align_left" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S3.T1.3.10.2.1" class="ltx_text" style="font-size:80%;">Few-shot</span></td>
