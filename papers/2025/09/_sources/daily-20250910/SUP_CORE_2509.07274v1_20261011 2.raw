<td id="S3.T1.3.12.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="S3.T1.3.12.5.1" class="ltx_text" style="font-size:80%;">0.25 (0.45)</span></td></tr>
<tr id="S3.T1.3.13" class="ltx_tr">
