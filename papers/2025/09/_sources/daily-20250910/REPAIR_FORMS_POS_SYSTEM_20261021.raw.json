{"data":[{"id":"10.48550/arxiv.2509.06261","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.06261","identifiers":[{"identifier":"2509.06261","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kyungmin","familyName":"Bin","name":"Bin, Kyungmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungbeom","familyName":"Choi","name":"Choi, Seungbeom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jimyoung","familyName":"Son","name":"Son, Jimyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jieun","familyName":"Choi","name":"Choi, Jieun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daseul","familyName":"Bae","name":"Bae, Daseul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daehyeon","familyName":"Baek","name":"Baek, Daehyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kihyo","familyName":"Moon","name":"Moon, Kihyo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minsung","familyName":"Jang","name":"Jang, Minsung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyojung","familyName":"Lee","name":"Lee, Hyojung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FineServe: Precision-Aware KV Slab and Two-Level Scheduling for Heterogeneous Precision LLM Serving"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T00:57:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-09T00:54:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-15T00:51:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-16T00:56:59Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Post-Training Quantization (PTQ) techniques have significantly increased demand for serving quantized large language models (LLMs), enabling higher throughput and substantially reduced memory usage with minimal accuracy loss. Quantized models address memory constraints in LLMs and enhance GPU resource utilization through efficient GPU sharing. However, quantized models have smaller KV block sizes than non-quantized models, causing limited memory efficiency due to memory fragmentation. Also, distinct resource usage patterns between quantized and non-quantized models require efficient scheduling to maximize throughput. To address these challenges, we propose FineServe, an inference serving framework for mixed-precision LLMs. FineServe's key contributions include: (1) KV Slab, a precision-aware adaptive memory management technique dynamically allocating KV cache based on model quantization characteristics, significantly reducing GPU memory fragmentation, and (2) a two-level scheduling framework comprising a global scheduler that places models to GPUs based on request rates, latency SLOs, and memory constraints and efficiency, and a local scheduler that adaptively adjusts batch sizes according to real-time request fluctuations. Experimental results demonstrate that FineServe achieves up to 2.2x higher SLO attainment and 1.8x higher token generation throughput compared to the state-of-the-art GPU sharing systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.06261","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-09T02:45:09Z","registered":"2025-09-09T02:45:10Z","published":null,"updated":"2025-09-16T03:40:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bsize%5D=100\u0026query=registered%3A%5B2025-09-08T16%3A00%3A00Z%20TO%202025-09-09T15%3A59%3A59Z%5D%20AND%20(titles.title%3A(%22language%20model%22%20OR%20%22language%20models%22%20OR%20LLM%20OR%20LLMs%20OR%20GPU%20OR%20GPUs)%20OR%20descriptions.description%3A(%22language%20model%22%20OR%20%22language%20models%22%20OR%20LLM%20OR%20LLMs%20OR%20GPU%20OR%20GPUs))%20AND%20(titles.title%3A(inference%20OR%20communication%20OR%20communications%20OR%20kernel%20OR%20kernels%20OR%20compiler%20OR%20compilers%20OR%20serving%20OR%20parallel%20OR%20parallelism%20OR%20accelerator%20OR%20accelerators)%20OR%20descriptions.description%3A(inference%20OR%20communication%20OR%20communications%20OR%20kernel%20OR%20kernels%20OR%20compiler%20OR%20compilers%20OR%20serving%20OR%20parallel%20OR%20parallelism%20OR%20accelerator%20OR%20accelerators))%20AND%20doi%3A1