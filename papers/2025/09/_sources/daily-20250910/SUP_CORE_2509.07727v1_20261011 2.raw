<td id="S3.T8.2.4.4" class="ltx_td"></td>
<td id="S3.T8.2.4.5" class="ltx_td ltx_align_center">0.60</td>
<td id="S3.T8.2.4.6" class="ltx_td"></td></tr>
<tr id="S3.T8.2.5" class="ltx_tr">
<th id="S3.T8.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r"><span id="S3.T8.2.5.1.1" class="ltx_text ltx_font_bold">Layer20</span></th>
