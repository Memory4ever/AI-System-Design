<td id="S4.T10.7.13.3" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S4.T10.7.13.3.1" class="ltx_text" style="font-size:70%;">95.2</span></td>
