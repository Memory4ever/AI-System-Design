<td id="S4.T10.7.15.3" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S4.T10.7.15.3.1" class="ltx_text" style="font-size:70%;">99.0</span></td>
<td id="S4.T10.7.15.4" class="ltx_td ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S4.T10.7.15.4.1" class="ltx_text" style="font-size:70%;">84.5</span></td>
<td id="S4.T10.7.15.5" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S4.T10.7.15.5.1" class="ltx_text" style="font-size:70%;">18.8</span></td></tr>
