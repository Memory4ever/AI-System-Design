<td id="S4.T10.7.16.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S4.T10.7.16.2.1" class="ltx_text" style="font-size:70%;">81</span></td>
