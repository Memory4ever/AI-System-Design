<td id="S4.T10.7.13.5" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S4.T10.7.13.5.1" class="ltx_text" style="font-size:70%;">53.0</span></td></tr>
