<td id="S4.T10.7.14.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S4.T10.7.14.2.1" class="ltx_text" style="font-size:70%;">81</span></td>
<td id="S4.T10.7.14.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S4.T10.7.14.3.1" class="ltx_text" style="font-size:70%;">98.3</span></td>
<td id="S4.T10.7.14.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S4.T10.7.14.4.1" class="ltx_text" style="font-size:70%;">84.2</span></td>
<td id="S4.T10.7.14.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:5.5pt;padding-right:5.5pt;"><span id="S4.T10.7.14.5.1" class="ltx_text" style="font-size:70%;">18.2</span></td></tr>
