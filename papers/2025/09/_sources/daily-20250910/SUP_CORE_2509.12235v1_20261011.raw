<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F5.sf1.2" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S4.F5.sf1.3" class="ltx_text" style="font-size:90%;">Layer-wise (ID)</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S4.F5.sf2" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2509.12235v1/rl_reverse_singular_value_layer_ood.svg" id="S4.F5.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/349;" width="476" height="349"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F5.sf2.2" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S4.F5.sf2.3" class="ltx_text" style="font-size:90%;">Layer-wise (OOD)</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
