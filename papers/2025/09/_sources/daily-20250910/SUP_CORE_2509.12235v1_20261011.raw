<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F5.sf3.2" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S4.F5.sf3.3" class="ltx_text" style="font-size:90%;">Top-<math id="S4.F5.sf3.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> (ID)</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
