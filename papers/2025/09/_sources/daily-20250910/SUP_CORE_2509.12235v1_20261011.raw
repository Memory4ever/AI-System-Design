</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S4.F4.sf4" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2509.12235v1/sft_reverse_singular_value_topk_ood.svg" id="S4.F4.sf4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/341;" width="476" height="341"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F4.sf4.2" class="ltx_text" style="font-size:90%;">(d)</span> </span><span id="S4.F4.sf4.3" class="ltx_text" style="font-size:90%;">Top-<math id="S4.F4.sf4.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> (OOD)</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F4.4" class="ltx_text" style="font-size:90%;">Figure 4</span>: </span><span id="S4.F4.5" class="ltx_text" style="font-size:90%;">Singular <span id="S4.F4.5.1" class="ltx_text ltx_font_bold">value</span> reversion for <span id="S4.F4.5.2" class="ltx_text ltx_font_bold">SFT</span> stage. </span></figcaption>
</figure>
