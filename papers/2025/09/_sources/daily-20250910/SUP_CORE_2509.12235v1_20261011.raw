<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F5.sf4.2" class="ltx_text" style="font-size:90%;">(d)</span> </span><span id="S4.F5.sf4.3" class="ltx_text" style="font-size:90%;">Top-<math id="S4.F5.sf4.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> (OOD)</span></figcaption>
</figure></div></div>
