<td id="S5.T3.2.26.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T3.2.26.2.1" class="ltx_text ltx_underline">74.02</span></td>
<td id="S5.T3.2.26.3" class="ltx_td ltx_align_center ltx_border_bb">83.33</td>
