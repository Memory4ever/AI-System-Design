<td id="S5.T4.6.9.2" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T4.6.9.2.1" class="ltx_text ltx_underline">77.32</span></td>
<td id="S5.T4.6.9.3" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T4.6.9.3.1" class="ltx_text ltx_underline">80.95</span></td>
<td id="S5.T4.6.9.4" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T4.6.9.4.1" class="ltx_text ltx_underline">83.33</span></td></tr>
