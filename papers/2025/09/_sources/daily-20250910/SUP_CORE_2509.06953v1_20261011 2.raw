<td id="A5.T5.2.3.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A5.T5.2.3.2.1" class="ltx_text ltx_font_bold">3.48</span></td>
