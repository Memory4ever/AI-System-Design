<td id="S4.T3.fig1.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.5pt 4.0pt;">cuRobo <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite></td>
