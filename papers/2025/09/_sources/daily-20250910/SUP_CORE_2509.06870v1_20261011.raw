<td id="S6.T7.2.1.2" class="ltx_td ltx_align_center ltx_border_tt">AIME24</td>
<td id="S6.T7.2.1.3" class="ltx_td ltx_align_center ltx_border_tt">AIME25</td>
<td id="S6.T7.2.1.4" class="ltx_td ltx_align_center ltx_border_tt">HMMT24</td>
<td id="S6.T7.2.1.5" class="ltx_td ltx_align_center ltx_border_tt">HMMT25</td></tr>
