<td id="S6.T7.2.2.5" class="ltx_td ltx_align_center ltx_border_t">11343.28</td></tr>
<tr id="S6.T7.2.3" class="ltx_tr">
<th id="S6.T7.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Additionally Trained Solution Model</th>
<td id="S6.T7.2.3.2" class="ltx_td ltx_align_center">11367.57</td>
<td id="S6.T7.2.3.3" class="ltx_td ltx_align_center">11731.94</td>
