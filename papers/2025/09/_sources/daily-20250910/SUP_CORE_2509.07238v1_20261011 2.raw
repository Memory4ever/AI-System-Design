<td id="S3.T2.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m2" class="ltx_Math" alttext="[0.1,0.5]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0.1</mn><mo>,</mo><mn>0.5</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0.1,0.5]</annotation></semantics></math></td>
