<td id="S3.T2.2.1.3.2" class="ltx_td ltx_align_center"><math id="S3.T2.m4" class="ltx_Math" alttext="\{4,6,8,10,12\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>4</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>10</mn><mo>,</mo><mn>12</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{4,6,8,10,12\}</annotation></semantics></math></td>
