      glue-grid
      
        --remove-gap
        --full
      
    ">
      
        <div class="
          dynamic_media__item
          glue-grid__col
          glue-grid__col--span-4-sm
          
            glue-grid__col--span-12-md
          
          
            glue-grid__col--span-12-lg
          
        ">
          <div class="">
            



  
    





    <!-- Determine the appropriate width based on image_width -->
    
        
    


<!-- For mobile images, use a default width -->


<picture class="media__image media__image">
    
    
        <source media="(min-width: 768px)" srcset="https://storage.googleapis.com/gweb-research2023-media/images/AI-powered-empirical_software-leaderboard.width-1250.png" alt="leaderboard bar plot" />
    
