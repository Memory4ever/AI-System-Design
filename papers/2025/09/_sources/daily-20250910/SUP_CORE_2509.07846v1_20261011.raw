<tr id="S3.T1.2.1.2" class="ltx_tr">
<td id="S3.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">
<span id="S3.T1.2.1.2.1.1" class="ltx_inline-block ltx_align_top" style="width:24.2pt;">
<span id="S3.T1.2.1.2.1.1.1" class="ltx_p"><span id="S3.T1.2.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Literature</span> <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib23" title="" class="ltx_ref">23</a>]</cite><cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib24" title="" class="ltx_ref">24</a>]</cite></span>
</span></td>
<td id="S3.T1.2.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">
<span id="S3.T1.2.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:69.0pt;">
<span id="S3.T1.2.1.2.2.1.1" class="ltx_p ltx_align_left">Moby-Dick; or, The Whale</span>
