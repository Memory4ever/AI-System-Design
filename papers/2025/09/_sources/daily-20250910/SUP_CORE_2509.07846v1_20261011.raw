<td id="S3.T1.2.1.15.5" class="ltx_td ltx_align_right ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">11</td>
<td id="S3.T1.2.1.15.6" class="ltx_td ltx_align_right ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">5</td></tr>
<tr id="S3.T1.2.1.16" class="ltx_tr">
<td id="S3.T1.2.1.16.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;"></td>
<td id="S3.T1.2.1.16.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">
