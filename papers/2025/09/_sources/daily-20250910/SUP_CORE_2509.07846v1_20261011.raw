</span></td>
<td id="S3.T1.2.1.16.3" class="ltx_td ltx_align_right ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">42,630</td>
<td id="S3.T1.2.1.16.4" class="ltx_td ltx_align_right ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">71</td>
<td id="S3.T1.2.1.16.5" class="ltx_td ltx_align_right ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">8</td>
