</span></th>
<th id="S1.T1.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S1.T1.2.1.1.5.1" class="ltx_text ltx_font_bold ltx_align_center">Chosen Clue</span></th>
<th id="S1.T1.2.1.1.6" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
