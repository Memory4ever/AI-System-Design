hy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta(\tilde{\pi})-\eta(\pi_{pef})+\mathbb{E}_{s_{t}\sim\pi_{pef}}[\gamma^{t}A^{\pi_{pef}|\pi}(s_{t})]-\mathbb{E}_{s_{t}\sim\pi}[\gamma^{t}A^{\tilde{\pi}|\pi}(s_{t})]</annotation></semantics></math></td>
