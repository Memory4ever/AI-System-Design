<th id="A7.T10.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2">CIFAR-10</th>
<th id="A7.T10.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2">CIFAR-100</th></tr>
<tr id="A7.T10.2.2" class="ltx_tr">
<td id="A7.T10.2.2.1" class="ltx_td"></td>
<th id="A7.T10.2.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column">ACC</th>
