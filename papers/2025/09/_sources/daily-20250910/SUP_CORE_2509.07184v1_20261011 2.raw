</thead>
<tbody class="ltx_tbody">
<tr id="A3.T6.4.2" class="ltx_tr">
<th id="A3.T6.4.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">25%</th>
