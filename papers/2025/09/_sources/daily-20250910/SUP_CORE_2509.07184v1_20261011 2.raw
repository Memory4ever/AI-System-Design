<td id="A7.T10.2.3.3" class="ltx_td ltx_align_center ltx_border_t">5</td>
<td id="A7.T10.2.3.4" class="ltx_td ltx_align_center ltx_border_t">75.9</td>
<td id="A7.T10.2.3.5" class="ltx_td ltx_align_center ltx_border_t">20</td></tr>
<tr id="A7.T10.2.4" class="ltx_tr">
