<td id="A4.T9.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t">AUC@20<math id="A4.T9.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="A4.T9.3.1.3" class="ltx_tr">
<td id="A4.T9.3.1.3.1" class="ltx_td ltx_align_left ltx_border_t">Reloc3r <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib18" title="" class="ltx_ref">Dong et al., 2024</a>)</cite></td>
<td id="A4.T9.3.1.3.2" class="ltx_td ltx_align_center ltx_border_t">6.9</td>
<td id="A4.T9.3.1.3.3" class="ltx_td ltx_align_center ltx_border_t">15.4</td>
<td id="A4.T9.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t">27.1</td>
