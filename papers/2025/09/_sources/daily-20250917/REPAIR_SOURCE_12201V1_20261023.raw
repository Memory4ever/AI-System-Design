<div id="S1.T1.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:72.6pt;vertical-align:-35.4pt;"><span class="ltx_transformed_inner" style="transform:translate(-201.1pt,42.3pt) scale(0.461750805136141,0.461750805136141) ;">
