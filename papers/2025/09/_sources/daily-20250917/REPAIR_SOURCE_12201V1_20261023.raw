<td id="A4.T9.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t">AUC@5<math id="A4.T9.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
