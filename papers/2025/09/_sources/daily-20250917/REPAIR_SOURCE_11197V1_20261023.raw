<th id="S4.T3.4.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S4.T3.4.2.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#E6E6E6;">SPL<math id="S4.T3.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th></tr>
