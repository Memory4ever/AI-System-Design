<tr id="S4.T3.4.4" class="ltx_tr">
<th id="S4.T3.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T3.4.4.1.1" class="ltx_text" style="font-size:80%;">Ours (only MAC)</span></th>
<td id="S4.T3.4.4.2" class="ltx_td ltx_align_center"><span id="S4.T3.4.4.2.1" class="ltx_text" style="font-size:80%;">8.07</span></td>
<td id="S4.T3.4.4.3" class="ltx_td ltx_align_center"><span id="S4.T3.4.4.3.1" class="ltx_text" style="font-size:80%;">8.78</span></td>
<td id="S4.T3.4.4.4" class="ltx_td ltx_align_center"><span id="S4.T3.4.4.4.1" class="ltx_text" style="font-size:80%;">14.00</span></td>
<td id="S4.T3.4.4.5" class="ltx_td ltx_align_center"><span id="S4.T3.4.4.5.1" class="ltx_text" style="font-size:80%;">12.00</span></td>
