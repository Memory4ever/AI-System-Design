<td id="S6.T2.6.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S6.T2.6.2.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">7.40</span></td>
<td id="S6.T2.6.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S6.T2.6.2.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">19.70</span></td>
<td id="S6.T2.6.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S6.T2.6.2.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">28.70</span></td></tr>
<tr id="S6.T2.6.3" class="ltx_tr">
