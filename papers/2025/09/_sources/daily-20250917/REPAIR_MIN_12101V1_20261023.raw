<td id="S6.T2.6.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.T2.6.3.2.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">7.18</span></td>
<td id="S6.T2.6.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.T2.6.3.3.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">19.30</span></td>
<td id="S6.T2.6.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.T2.6.3.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">26.59</span></td></tr>
