<td id="S5.T2.3.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T2.3.2.2.1" class="ltx_text" style="font-size:90%;">46.1%</span></td>
