<td id="S5.T2.3.1.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T2.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Object Grounding</span></td>
