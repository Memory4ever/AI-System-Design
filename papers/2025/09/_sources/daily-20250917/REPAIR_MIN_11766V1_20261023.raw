<td id="S5.T3.3.4.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T3.3.4.3.1" class="ltx_text" style="font-size:90%;">80%</span></td>
<td id="S5.T3.3.4.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T3.3.4.4.1" class="ltx_text" style="font-size:90%;">35%</span></td></tr>
