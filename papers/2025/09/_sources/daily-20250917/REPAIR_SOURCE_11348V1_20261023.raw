<span id="S6.T2.2.1.1.1.2" class="ltx_tr">
<span id="S6.T2.2.1.1.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">Rank <math id="S6.T2.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
<span id="S6.T2.2.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="S6.T2.m4" class="ltx_Math" alttext="\hat{L}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>L</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{L}</annotation></semantics></math> <math id="S6.T2.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
<span id="S6.T2.2.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">Rank <math id="S6.T2.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
