<span id="A7.T5.4.1.1.1.7.3" class="ltx_td ltx_align_center" style="padding-top:1.5pt;padding-bottom:1.5pt;">12</span>
<span id="A7.T5.4.1.1.1.7.4" class="ltx_td ltx_align_left" style="padding-top:1.5pt;padding-bottom:1.5pt;">[2, 4, 6]</span>
<span id="A7.T5.4.1.1.1.7.5" class="ltx_td ltx_align_left" style="padding-top:1.5pt;padding-bottom:1.5pt;">[<a href="#A7.F18" title="Figure 18 ‣ G.1.1 Dense Mixture-of-Experts ‣ G.1 Verification of Linear Mode Connectivity across diverse configurations ‣ Appendix G Experimental Results ‣ On Linear Mode Connectivity of Mixture-of-Experts Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>, <a href="#A7.F19" title="Figure 19 ‣ G.1.1 Dense Mixture-of-Experts ‣ G.1 Verification of Linear Mode Connectivity across diverse configurations ‣ Appendix G Experimental Results ‣ On Linear Mode Connectivity of Mixture-of-Experts Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>, <a href="#A7.F20" title="Figure 20 ‣ G.1.1 Dense Mixture-of-Experts ‣ G.1 Verification of Linear Mode Connectivity across diverse configurations ‣ Appendix G Experimental Results ‣ On Linear Mode Connectivity of Mixture-of-Experts Architectures" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>]</span></span>
<span id="A7.T5.4.1.1.1.8" class="ltx_tr">
<span id="A7.T5.4.1.1.1.8.1" class="ltx_td" style="padding-top:1.5pt;padding-bottom:1.5pt;"></span>
<span id="A7.T5.4.1.1.1.8.2" class="ltx_td ltx_align_left" style="padding-top:1.5pt;padding-bottom:1.5pt;">ImageNet-21k<math id="A7.T5.m14" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>CIFAR-100</span>
