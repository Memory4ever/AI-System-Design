<figure id="A7.F78" class="ltx_figure"><object type="image/svg+xml" data="2509.11348v1/m_imgnetcifar10_6_2.svg" id="A7.F78.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:429/198;" width="429" height="198"></object>
