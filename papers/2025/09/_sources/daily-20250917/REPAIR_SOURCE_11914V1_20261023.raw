<td id="S5.T1.2.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Results</td>
<td id="S5.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.984</td>
<td id="S5.T1.2.3.3" class="ltx_td ltx_align_center ltx_border_t">0.958</td>
<td id="S5.T1.2.3.4" class="ltx_td ltx_align_center ltx_border_t">0.965</td>
<td id="S5.T1.2.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.00892</td>
<td id="S5.T1.2.3.6" class="ltx_td ltx_align_center ltx_border_t">0.960</td></tr>
