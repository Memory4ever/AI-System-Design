<span id="S5.T1.2.2.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">pass@1</span></span>
<span id="S5.T1.2.2.4.2.1.2" class="ltx_tr">
<span id="S5.T1.2.2.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">w/ s-norm</span></span>
</span></span><span id="S5.T1.2.2.4.3" class="ltx_text"></span></td>
