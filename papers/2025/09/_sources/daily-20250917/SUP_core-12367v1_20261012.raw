t ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">should</span><span id="lstnumberx23.37" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx23.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">not</span><span id="lstnumberx23.39" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx23.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">pick</span><span id="lstnumberx23.41" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx23.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">a</span><span id="lstnumberx23.43" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx23.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">skill</span><span id="lstnumberx23.45" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx23.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">to</span><span id="lstnumberx23.47" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx23.48" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">do</span><span id="lstnumberx23.49" class="ltx_text ltx_font_typewriter" style="font-size:90%;">.</span>
