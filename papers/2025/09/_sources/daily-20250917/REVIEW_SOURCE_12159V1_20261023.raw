<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S6.F8.sf2.3" class="ltx_text" style="font-size:80%;">(b)</span> </span><span id="S6.F8.sf2.4" class="ltx_text" style="font-size:80%;">Text Match.</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="S6.F8.sf3" class="ltx_figure ltx_figure_panel"><img src="2509.12159v1/design2code_clip_score_para.png" id="S6.F8.sf3.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:110/96;" width="110" height="96" alt="Refer to caption">
