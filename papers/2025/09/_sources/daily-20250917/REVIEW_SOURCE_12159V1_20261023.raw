<td id="S6.T2.6.1.16.14" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_b" style="padding-left:1.2pt;padding-right:1.2pt;"><span id="S6.T2.6.1.16.14.1" class="ltx_text ltx_underline">0.2634</span></td>
<td id="S6.T2.6.1.16.15" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_b" style="padding-left:1.2pt;padding-right:1.2pt;"><span id="S6.T2.6.1.16.15.1" class="ltx_text ltx_font_bold">2</span></td></tr>
