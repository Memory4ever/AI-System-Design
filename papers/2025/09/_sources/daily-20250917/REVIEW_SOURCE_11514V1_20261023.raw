<th id="S6.T2.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">Baskets</th>
<th id="S6.T2.2.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">Dogs</th></tr>
</thead>
<tbody class="ltx_tbody">
