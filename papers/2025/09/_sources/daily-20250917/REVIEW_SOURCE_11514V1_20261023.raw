<th id="A3.T10.2.18.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"># Words</th>
<td id="A3.T10.2.18.3" class="ltx_td ltx_align_right ltx_border_t">0.38</td>
<td id="A3.T10.2.18.4" class="ltx_td ltx_align_right ltx_border_t">0.16</td>
<td id="A3.T10.2.18.5" class="ltx_td ltx_align_right ltx_border_t">0.53</td>
<td id="A3.T10.2.18.6" class="ltx_td ltx_align_right ltx_border_t">0.12</td></tr>
<tr id="A3.T10.2.19" class="ltx_tr">
<th id="A3.T10.2.19.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"># Sentences</th>
<td id="A3.T10.2.19.2" class="ltx_td ltx_align_right">0.24</td>
<td id="A3.T10.2.19.3" class="ltx_td ltx_align_right">0.38</td>
<td id="A3.T10.2.19.4" class="ltx_td ltx_align_right">0.26</td>
<td id="A3.T10.2.19.5" class="ltx_td ltx_align_right">0.47</td></tr>
<tr id="A3.T10.2.20" class="ltx_tr">
<th id="A3.T10.2.20.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"># Utterances</th>
<td id="A3.T10.2.20.2" class="ltx_td ltx_align_right">0.38</td>
<td id="A3.T10.2.20.3" class="ltx_td ltx_align_right">0.16</td>
<td id="A3.T10.2.20.4" class="ltx_td ltx_align_right">0.50</td>
<td id="A3.T10.2.20.5" class="ltx_td ltx_align_right">0.14</td></tr>
<tr id="A3.T10.2.21" class="ltx_tr">
<th id="A3.T10.2.21.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"># Director Turns</th>
<td id="A3.T10.2.21.2" class="ltx_td ltx_align_right">0.20</td>
<td id="A3.T10.2.21.3" class="ltx_td ltx_align_right">0.48</td>
<td id="A3.T10.2.21.4" class="ltx_td ltx_align_right">0.28</td>
<td id="A3.T10.2.21.5" class="ltx_td ltx_align_right">0.43</td></tr>
<tr id="A3.T10.2.22" class="ltx_tr">
<th id="A3.T10.2.22.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"># Matcher Turns</th>
<td id="A3.T10.2.22.2" class="ltx_td ltx_align_right ltx_border_bb">0.16</td>
