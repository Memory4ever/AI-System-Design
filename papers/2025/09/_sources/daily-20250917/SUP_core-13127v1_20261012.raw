parameterized skills <math id="alg1.l0.m10" class="ltx_Math" alttext="\mathcal{U}=\{u_{i}(\pi_{i},\Theta_{i},I_{i},\beta_{i})\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>i</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mi>i</mi></msub><mo>,</mo><msub><mi>I</mi><mi>i</mi></msub><mo>,</mo><msub><mi>β</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{U}=\{u_{i}(\pi_{i},\Theta_{i},I_{i},\beta_{i})\}</annotation></semantics></math>

</div>
