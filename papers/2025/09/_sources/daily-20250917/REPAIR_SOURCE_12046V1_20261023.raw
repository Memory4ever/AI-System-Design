<td id="Sx5.T1.1.11.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="Sx5.T1.1.11.2.1" class="ltx_text ltx_font_bold">95.33</span></td>
<td id="Sx5.T1.1.11.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="Sx5.T1.1.11.3.1" class="ltx_text ltx_font_bold">86.84</span></td>
<td id="Sx5.T1.1.11.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="Sx5.T1.1.11.4.1" class="ltx_text ltx_font_bold">90.44</span></td>
<td id="Sx5.T1.1.11.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="Sx5.T1.1.11.5.1" class="ltx_text ltx_font_bold">89.45</span></td>
<td id="Sx5.T1.1.11.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="Sx5.T1.1.11.6.1" class="ltx_text ltx_underline">69.08</span></td>
