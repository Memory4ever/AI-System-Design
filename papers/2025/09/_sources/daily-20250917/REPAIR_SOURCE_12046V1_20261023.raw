<td id="Sx5.T1.1.10.5" class="ltx_td ltx_align_center"><span id="Sx5.T1.1.10.5.1" class="ltx_text ltx_underline">75.93</span></td>
<td id="Sx5.T1.1.10.6" class="ltx_td ltx_align_center"><span id="Sx5.T1.1.10.6.1" class="ltx_text ltx_font_bold">69.47</span></td>
<td id="Sx5.T1.1.10.7" class="ltx_td ltx_align_center"><span id="Sx5.T1.1.10.7.1" class="ltx_text ltx_font_bold">22.02</span></td>
<td id="Sx5.T1.1.10.8" class="ltx_td ltx_align_center"><span id="Sx5.T1.1.10.8.1" class="ltx_text ltx_font_bold">34.01</span></td>
<td id="Sx5.T1.1.10.9" class="ltx_td ltx_align_center"><span id="Sx5.T1.1.10.9.1" class="ltx_text ltx_underline">19.10</span></td>
<td id="Sx5.T1.1.10.10" class="ltx_td ltx_nopad_r ltx_align_center"><span id="Sx5.T1.1.10.10.1" class="ltx_text ltx_font_bold">22.04</span></td></tr>
<tr id="Sx5.T1.1.11" class="ltx_tr">
