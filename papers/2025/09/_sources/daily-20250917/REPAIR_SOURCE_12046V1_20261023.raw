<section id="Sx5.SSx4.SSSx2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">GRPO-based Post-training.</h4>

<figure id="Sx5.T3" class="ltx_table">
<table id="Sx5.T3.1" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="Sx5.T3.1.1" class="ltx_tr">
<td id="Sx5.T3.1.1.1" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.7pt;padding-right:5.7pt;" rowspan="2"><span id="Sx5.T3.1.1.1.1" class="ltx_text" style="position:relative; bottom:-24.5pt;">
<span id="Sx5.T3.1.1.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:23.3pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:23.3pt;transform:translate(-8.2pt,-8.2pt) rotate(-90deg) ;">
