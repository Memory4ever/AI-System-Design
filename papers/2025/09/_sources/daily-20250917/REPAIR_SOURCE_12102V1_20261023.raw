<td id="S4.T5.2.4.3" class="ltx_td ltx_nopad_l ltx_align_left ltx_border_t"><math id="S4.T5.m5" class="ltx_Math" alttext="-1.521^{**}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><msup><mn>1.521</mn><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>∗</mo></mrow></msup></mrow><annotation encoding="application/x-tex">-1.521^{**}</annotation></semantics></math></td>
