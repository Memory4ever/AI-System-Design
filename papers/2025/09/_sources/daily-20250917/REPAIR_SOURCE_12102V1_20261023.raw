<td id="S4.T5.2.1.5" class="ltx_td ltx_align_right ltx_border_tt"><span id="S4.T5.2.1.5.1" class="ltx_text"><math id="S4.T5.m1" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-value</span></td></tr>
