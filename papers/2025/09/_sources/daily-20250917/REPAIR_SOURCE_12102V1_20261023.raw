<td id="S4.T5.2.3.2" class="ltx_td ltx_nopad_l ltx_align_left"><math id="S4.T5.m3" class="ltx_Math" alttext="-0.399" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.399</mn></mrow><annotation encoding="application/x-tex">-0.399</annotation></semantics></math></td>
