<td id="S3.T2.fig2.1.10.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" rowspan="5"><span id="S3.T2.fig2.1.10.1.1" class="ltx_text ltx_font_bold">Experience</span></td>
<td id="S3.T2.fig2.1.10.2" class="ltx_td ltx_align_left ltx_border_t">Under a year</td>
<td id="S3.T2.fig2.1.10.3" class="ltx_td ltx_align_left ltx_border_t">4.3</td></tr>
<tr id="S3.T2.fig2.1.11" class="ltx_tr">
<td id="S3.T2.fig2.1.11.1" class="ltx_td ltx_align_left">1 - 2 years</td>
<td id="S3.T2.fig2.1.11.2" class="ltx_td ltx_align_left">8.7</td></tr>
<tr id="S3.T2.fig2.1.12" class="ltx_tr">
