<div id="lstnumberx101" class="ltx_listingline"><span id="lstnumberx101.1" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx101.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">For</span><span id="lstnumberx101.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">example</span><span id="lstnumberx101.5" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx101.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">your</span><span id="lstnumberx101.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">response</span><span id="lstnumberx101.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">should</span><span id="lstnumberx101.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">look</span><span id="lstnumberx101.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">like</span><span id="lstnumberx101.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">this</span><span id="lstnumberx101.18" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx101.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.20" class="ltx_text ltx_font_typewriter">{’’</span><span id="lstnumberx101.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">score</span><span id="lstnumberx101.22" class="ltx_text ltx_font_typewriter">’:</span><span id="lstnum