<div id="lstnumberx7" class="ltx_listingline"><span id="lstnumberx7.1" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx7.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">profit</span><span id="lstnumberx7.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.4" class="ltx_text ltx_font_typewriter">=</span><span id="lstnumberx7.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">np</span><span id="lstnumberx7.7" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx7.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">zeros</span><span id="lstnumberx7.9" class="ltx_text ltx_font_typewriter">((</span><span id="lstnumberx7.10" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter">len</span><span id="lstnumberx7.11" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx7.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx7.13" class="ltx_text ltx_font_typewriter">),</span><span id="lstnumberx7.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx7.15" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_typewriter">len</span><span id="lstnumberx7.16" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx7.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">prediction</span><span id="lstnumberx7.18" class="ltx_text ltx_font_typewriter">)))</span>
