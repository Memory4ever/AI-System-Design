<td id="A2.T9.3.1.8.10" class="ltx_td ltx_align_center" style="--ltx-bg-color:#E6E6E6;padding-top:0.8pt;padding-bottom:0.8pt;"><span id="A2.T9.3.1.8.10.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#E6E6E6;">0.862</span></td></tr>
<tr id="A2.T9.3.1.9" class="ltx_tr">
<td id="A2.T9.3.1.9.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.8pt;padding-bottom:0.8pt;"><span class="ltx_rule ltx_align_center ltx_align_top" style="width:68.3pt;height:0.8pt;--ltx-bg-color:black;display:inline-block;"> </span></td>
<td id="A2.T9.3.1.9.2" class="ltx_td ltx_align_top" style="padding-top:0.8pt;padding-bottom:0.8pt;"></td>
<td id="A2.T9.3.1.9.3" class="ltx_td" style="padding-top:0.8pt;padding-bottom:0.8pt;"></td>
<td id="A2.T9.3.1.9.4" class="ltx_td" style="padding-top:0.8pt;padding-bottom:0.8pt;"></td>
<td id="A2.T9.3.1.9.5" class="ltx_td" style="padding-top:0.8pt;padding-bottom:0.8pt;"></td>
