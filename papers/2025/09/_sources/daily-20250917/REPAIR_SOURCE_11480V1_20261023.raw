<td id="S4.T5.5.1.4.2" class="ltx_td ltx_align_center">96.2</td>
<td id="S4.T5.5.1.4.3" class="ltx_td ltx_align_center">98.3</td>
<td id="S4.T5.5.1.4.4" class="ltx_td ltx_align_center"><span id="S4.T5.5.1.4.4.1" class="ltx_text ltx_font_bold">96.2</span></td>
