<th id="S3.T4.5.1.1.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T4.5.1.1.6.1" class="ltx_text ltx_font_bold">Parameters</span></th></tr>
