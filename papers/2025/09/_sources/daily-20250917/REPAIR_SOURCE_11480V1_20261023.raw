<td id="S4.T5.5.1.6.6" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T5.5.1.6.6.1" class="ltx_text ltx_font_bold">96.9</span></td></tr>
<tr id="S4.T5.5.1.7" class="ltx_tr">
