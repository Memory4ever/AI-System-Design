<tr id="S3.T4.5.1.3" class="ltx_tr">
<td id="S3.T4.5.1.3.1" class="ltx_td ltx_align_left">SpatialVLA</td>
<td id="S3.T4.5.1.3.2" class="ltx_td ltx_align_center">PaliGemma 2</td>
<td id="S3.T4.5.1.3.3" class="ltx_td ltx_align_center">SigLIP+Ego3D</td>
<td id="S3.T4.5.1.3.4" class="ltx_td ltx_align_center">AAG</td>
