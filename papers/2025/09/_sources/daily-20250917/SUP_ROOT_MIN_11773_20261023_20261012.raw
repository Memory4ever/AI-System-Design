              <math id="algorithm3.m25" class="ltx_Math" alttext="\text{ROUGE}_{d,\ell}^{k}\leftarrow\frac{\text{ROUGE}_{d,\ell}^{k}}{Z}" display="inline" intent=":literal"><semantics><mrow><msubsup><mtext>ROUGE</mtext><mrow><mi>d</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>k</mi></msubsup><mo stretchy="false">←</mo><mfrac><msubsup><mtext>ROUGE</mtext><mrow><mi>d</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>k</mi></msubsup><mi>Z</mi></mfrac></mrow><annotation encoding="application/x-tex">\text{ROUGE}_{d,\ell}^{k}\leftarrow\frac{\text{ROUGE}_{d,\ell}^{k}}{Z}</annotation></semantics></math> ;
