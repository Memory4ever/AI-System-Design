</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.24 15.82)"><foreignObject style="--ltx-fo-width:44.28em;--ltx-fo-height:33.65em;--ltx-fo-depth:0.25em;font-size:10pt;" height="469.08" overflow="visible" transform="matrix(1 0 0 -1 0 465.62)" width="612.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.SS4.SSS2.p1.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:44.28em;">
