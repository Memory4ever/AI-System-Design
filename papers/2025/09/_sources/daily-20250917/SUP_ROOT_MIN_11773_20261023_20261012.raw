              <span id="algorithm3.4.7.2" class="ltx_text ltx_font_bold">return</span> <em id="algorithm3.4.7.3" class="ltx_emph ltx_font_italic"><math id="algorithm3.m8" class="ltx_Math" alttext="0,\ 0,\ 0" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn> 0</mn><mo>,</mo><mn> 0</mn></mrow><annotation encoding="application/x-tex">0,\ 0,\ 0</annotation></semantics></math></em> ;  <span id="algorithm3.4.7.4" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm3.4.7.5" class="ltx_text ltx_font_typewriter">Assign zero scores if parsing fails</span>
</div>
<div id="algorithm3.4.8" class="ltx_listingline">
