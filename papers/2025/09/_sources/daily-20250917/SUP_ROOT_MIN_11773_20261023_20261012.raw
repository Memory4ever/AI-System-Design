<td id="S3.T4.2.1.9.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#BFBFBF;"><span id="S3.T4.2.1.9.4.1" class="ltx_text" style="--ltx-bg-color:#BFBFBF;">0.712</span></td>
