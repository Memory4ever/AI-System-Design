                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.6.1" class="ltx_text ltx_font_bold">4</span></span>
              <span id="algorithm3.4.6.2" class="ltx_text ltx_font_bold">else</span>
</div>
