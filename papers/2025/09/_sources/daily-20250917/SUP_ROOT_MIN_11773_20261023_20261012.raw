              <math id="algorithm3.m21" class="ltx_Math" alttext="\text{ROUGE}_{d,\ell}^{k}\mathrel{+}=\text{ROUGE-L}(v_{p}^{\text{gt}},\ v_{p}^{\text{pred}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mtext>ROUGE</mtext><mrow><mi>d</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>k</mi></msubsup><mo lspace="0.278em" rspace="0.278em">+</mo><mphantom></mphantom><mo>=</mo><mrow><mtext>ROUGE-L</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>v</mi><mi>p</mi><mtext>gt</mtext></msubsup><mo>,</mo><msubsup><mi>v</mi><mi>p</mi><mtext>pred</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{ROUGE}_{d,\ell}^{k}\mathrel{+}=\text{ROUGE-L}(v_{p}^{\text{gt}},\ v_{p}^{\text{pred}})</annotation></semantics></math> ;  <span id="algorithm3.4.19.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm3.4.19.3" class="ltx_text ltx_font_typewriter">Eq. (<a href="#A1.E3" title="In A.3.1 Metrics Details ‣ A.3 Agentic System Evaluation Related Details ‣ Appendix A Appendix ‣ An Agentic Toolkit for Adaptive Information Extraction from Regulatory Documents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>)</span>
