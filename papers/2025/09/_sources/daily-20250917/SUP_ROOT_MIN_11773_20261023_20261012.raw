<div id="A1.SS4.SSS2.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.SS4.SSS2.p1.pic1" class="ltx_picture" height="516.07" overflow="visible" version="1.1" viewBox="0 0 653.15 516.07" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,516.07) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#BF8040;" fill="#BF8040" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.49 L 0 511.58 C 0 514.06 2.01 516.07 4.49 516.07 L 648.66 516.07 C 651.14 516.07 653.15 514.06 653.15 511.58 L 653.15 4.49 C 653.15 2.01 651.14 0 648.66 0 L 4.49 0 C 2.01 0 0 2.01 0 4.49 Z"></path></g><g style="--ltx-fill-color:#FFF9F2;" fill="#FFF9F2" fill-opacity="1.0"><path style="stroke:none" d="M 0.55 4.49 L 0.55 493.25 L 652.6 493.25 L 652.6 4.49 C 652.6 2.32 650.83 0.55 648.66 0.55 L 4.49 0.55 C 2.32 0.55 0.55 2.32 0.55 4.49 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.24 501.2)"><foreignObject style="--ltx-fo-width:44.28em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="612.71"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
