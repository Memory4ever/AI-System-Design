                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.21.1" class="ltx_text ltx_font_bold">19</span></span>
              <math id="algorithm3.m22" class="ltx_Math" alttext="Z\leftarrow\max(|\mathcal{M}_{d,\ell}^{k}|,\ 1)" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo stretchy="false">←</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>d</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>k</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>,</mo><mn> 1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Z\leftarrow\max(|\mathcal{M}_{d,\ell}^{k}|,\ 1)</annotation></semantics></math> ;  <span id="algorithm3.4.21.2" class="ltx_text ltx_font_typewriter">// </span><span id="algorithm3.4.21.3" class="ltx_text ltx_font_typewriter">Prevent division by zero</span>
