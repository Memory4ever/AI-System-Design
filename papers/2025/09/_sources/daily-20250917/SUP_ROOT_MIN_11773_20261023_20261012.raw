                <span class="ltx_tag ltx_tag_listingline"><span id="algorithm3.4.12.1" class="ltx_text ltx_font_bold">10</span></span>
              Initialize: <math id="algorithm3.m16" class="ltx_Math" alttext="\text{EM}_{d,\ell}^{k}\leftarrow 0,\ \text{BLEU}_{d,\ell}^{k}\leftarrow 0,\ \text{ROUGE}_{d,\ell}^{k}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mtext>EM</mtext><mrow><mi>d</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>k</mi></msubsup><mo stretchy="false">←</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><msubsup><mtext>BLEU</mtext><mrow><mi>d</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>k</mi></msubsup><mo stretchy="false">←</mo><mn>0</mn></mrow><mo rspace="0.667em">,</mo><mrow><msubsup><mtext>ROUGE</mtext><mrow><mi>d</mi><mo>,</mo><mi mathvariant="normal">ℓ</mi></mrow><mi>k</mi></msubsup><mo stretchy="false">←</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\text{EM}_{d,\ell}^{k}\leftarrow 0,\ \text{BLEU}_{d,\ell}^{k}\leftarrow 0,\ \text{ROUGE}_{d,\ell}^{k}\leftarrow 0</annotation></semantics></math> ;
</div>
