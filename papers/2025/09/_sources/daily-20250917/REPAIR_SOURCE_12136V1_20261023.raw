oke-color:#FF4D4D;--ltx-fill-color:#FF4D4D;" fill="#FF4D4D" stroke="#FF4D4D" transform="matrix(0.0 1.0 -1.0 0.0 31.37 30.46)"><foreignObject style="--ltx-fo-width:1.9em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="21.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic2.m22" class="ltx_Math" alttext="0.38" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#FF4D4D;" mathcolor="#FF4D4D" mathsize="0.700em">0.38</mn><annotation encoding="application/x-tex">0.38</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#FF4D4D;--ltx-fill-color:#FF4D4D;" fill="#FF4D4D" stroke="#FF4D4D" transform="matrix(0.0 1.0 -1.0 0.0 55.87 21.82)"><foreignObject style="--ltx-fo-width:1.9em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="21.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic2.m23" class="ltx_Math" alttext="0.25" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#FF4D4D;" mathcolor="#FF4D4D" mathsize="0.700em">0.25</mn><annotation encoding="application/x-tex">0.25</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#FF4D4D;--ltx-fill-color:#FF4D4D;" fill="#FF4D4D" stroke="#FF4D4D" transform="matrix(0.0 1.0 -1.0 0.0 80.37 41.66)"><foreignObject style="--ltx-fo-width:1.9em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="21.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic2.m24" class="ltx_Math" alttext="0.54" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#FF4D4D;" mathcolor="#FF4D4D" mathsize="0.700em">