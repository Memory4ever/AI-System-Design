bject style="--ltx-fo-width:5.86em;--ltx-fo-height:0.7em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.91" overflow="visible" transform="matrix(1 0 0 -1 0 8.91)" width="75.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F4.pic1.4" class="ltx_text" style="font-size:90%;">CUDA→OMP</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.97815 0.20792 -0.20792 0.97815 112.66 -14.63)"><foreignObject style="--ltx-fo-width:1.78em;--ltx-fo-height:0.66em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="10.93" overflow="visible" transform="matrix(1 0 0 -1 0 8.51)" width="22.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F4.pic1.5" class="ltx_text" style="font-size:90%;">Avg</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -25.71 -4.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -38.78 10.65)"><foreignObject style="--ltx-fo-width:1.44em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="19.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic1.m2" class="ltx_Math