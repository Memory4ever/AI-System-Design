plication/x-tex">0.49</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFCC00;--ltx-fill-color:#FFCC00;" fill="#FFCC00" stroke="#FFCC00" transform="matrix(0.0 1.0 -1.0 0.0 37.38 49.73)"><foreignObject style="--ltx-fo-width:1.9em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="21.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F2.pic1.m30" class="ltx_Math" alttext="0.44" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#FFCC00;" mathcolor="#FFCC00" mathsize="0.700em">0.44</mn><annotation encoding="application/x-tex">0.44</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -16.54 -37.86)"><foreignObject style="--ltx-fo-width:4.61em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.65" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="59.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F2.pic1.13" class="ltx_text" style="font-size:90%;">max token</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -27.33 116.28)"><foreignObject style="--ltx-fo-width:5.8em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="80.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.F2.pic1.14" class="ltx_text">GPT-4o-mini</span></span></span></foreignObject></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F2.4" class="ltx_text" style="font-size:90%;">Fig. 2</span>: </span><span id="S5.F2.5" class="ltx_text" style="font-size:90%;">
<span id="S5.F2.5.1" class="ltx_text ltx_font_bold">Effect of Temperature and Max Token Settings on Compilation Rate.</span>
Compilation success rates for the models across combinations of temperature and maximum token limits. Lower temperatures, particularly 0.2, yield the highest and most consistent compilation rates, with the effect especially pronounced at higher token lengths for LLaMA.
</span></figcaption>
</figure>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS2.6" class="ltx_text">V-B</span> </span><span id="S5.SS2.7" class="ltx_text ltx_font_bold">RQ1</span><span id="S5.SS2.8" class="ltx_text ltx_font_italic">: Translation Behavior with Few-shot Prompting</span></h3>

<div id="S5.SS2.p1" class="ltx_para ltx_noindent">
<p id="S5.SS2.p1.1" class="ltx_p">LLMs are trained on a broad range of general tasks. In many scenarios, providing input-output examples during inference (referred to as few-shot prompting) can help guide the model towards the specific task at hand <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib58" title="" class="ltx_ref">58</a>, <a href="#bib.bib59" title="" class="ltx_ref">59</a>]</cite>. To assess its effect in our setting, we compared the compilation rates of generated code with 0-shot, 1-shot, 2-shot, and 3-shot configurations.</p>
</div>
<div id="S5.SS2.p2" class="ltx_para ltx_noindent">
<p id="S5.SS2.p2.1" class="ltx_p">Each <em id="S5.SS2.p2.1.1" class="ltx_emph ltx_font_italic">n</em>-shot involved appending <em id="S5.SS2.p2.1.2" class="ltx_emph ltx_font_italic">n</em> additional examples for the same source–target language pair from the <span id="S5.SS2.p2.1.3" class="ltx_text ltx_font_smallcaps">ParaTrans</span> train set. We used the prompt addition shown in <a href="#S5.F3" title="Fig. 3 ‣ V-B RQ1: Translation Behavior with Few-shot Prompting ‣ V Results and Analysis ‣ UniPar: A Unified LLM-Based Framework for Parallel and Accelerated Code Translation in HPC" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Figure 3</span></a>. Each example consists of a source kernel and its corresponding translation to the target language, with both the original and the target language specified.</p>
</div>
<figure id="S5.F3" class="ltx_figure"><span class="ltx_inline-block"><svg id="S5.F3.pic1" class="ltx_picture ltx_centering" height="459.19" overflow="visible" version="1.1" viewBox="0 0 229.14 459.19" width="229.14"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,459.19) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#436633;" fill="#436633" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 453.28 C 0 456.54 2.64 459.19 5.91 459.19 L 223.23 459.19 C 226.49 459.19 229.14 456.54 229.14 453.28 L 229.14 5.91 C 229.14 2.64 226.49 0 223.23 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 442.64 L 227.17 442.64 L 227.17 5.91 C 227.17 3.73 225.41 1.97 223.23 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 19.1 448.15)"><foreignObject style="--ltx-fo-width:16.24em;--ltx-fo-height:0.56em;--ltx-fo-depth:0.16em;font-size:10pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="224.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S5.F3.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:16.24em;">
<span id="S5.F3.pic1.1.1" class="ltx_p"><span id="S5.F3.pic1.1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FFFFFF;">Instruction Prompt for Inference</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 19.1 7.85)"><foreignObject style="--ltx-fo-width:14.92em;--ltx-fo-height:31.17em;--ltx-fo-depth:0.23em;font-size:10pt;" height="434.45" overflow="visible" transform="matrix(1 0 0 -1 0 431.34)" width="206.45"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S5.F3.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:14.92em;">
<span id="S5.F3.pic1.2.1" class="ltx_p"><span id="S5.F3.pic1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">System:<span id="S5.F3.pic1.2.1.1.1" class="ltx_text ltx_font_medium"> You are an HPC expert specializing in translating between parallel programming APIs.</span></span></span><span class="ltx_rule" style="width:100%;height:1px;--ltx-fg-color:#000000;--ltx-bg-color:#000000;display:inline-block;"> </span>
<span id="S5.F3.pic1.2.2" class="ltx_p"><span id="S5.F3.pic1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Addition for 1-Shot prompt:
<br class="ltx_break">Instruction:<span id="S5.F3.pic1.2.2.1.1" class="ltx_text ltx_font_medium">
Translate the following code from <span id="S5.F3.pic1.2.2.1.1.1" class="ltx_text ltx_font_typewriter">{from_api}</span> to <span id="S5.F3.pic1.2.2.1.1.2" class="ltx_text ltx_font_typewriter">{to_api}
<br class="ltx_break"></span>Code: <span id="S5.F3.pic1.2.2.1.1.3" class="ltx_text ltx_font_typewriter">{from_code}
<br class="ltx_break"></span></span>Assistant:<span id="S5.F3.pic1.2.2.1.2" class="ltx_text ltx_font_medium">
Here is the translated code: <span id="S5.F3.pic1.2.2.1.2.1" class="ltx_text ltx_font_typewriter">{to_code}</span></span></span></span><span class="ltx_rule" style="width:100%;height:1px;--ltx-fg-color:#000000;--ltx-bg-color:#000000;display:inline-block;"> </span>
<span id="S5.F3.pic1.2.3" class="ltx_p"><span id="S5.F3.pic1.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#000000;">Instruction:<span id="S5.F3.pic1.2.3.1.1" class="ltx_text ltx_font_medium">
Translate the following code from <span id="S5.F3.pic1.2.3.1.1.1" class="ltx_text ltx_font_typewriter">{from_api}</span> to <span id="S5.F3.pic1.2.3.1.1.2" class="ltx_text ltx_font_typewriter">{to_api}
<br class="ltx_break"></span>Code: <span id="S5.F3.pic1.2.3.1.1.3" class="ltx_text ltx_font_typewriter">{from_code}</span> 
<br class="ltx_break"></span>Response:<span id="S5.F3.pic1.2.3.1.2" class="ltx_text ltx_font_medium"> <span id="S5.F3.pic1.2.3.1.2.1" class="ltx_text ltx_font_typewriter">{to_code}</span></span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F3.4" class="ltx_text" style="font-size:90%;">Fig. 3</span>: </span><span id="S5.F3.5" class="ltx_text" style="font-size:90%;">
<span id="S5.F3.5.1" class="ltx_text ltx_font_bold">Instruction Format for Translation Inference.</span>
The prompt template used to guide the model during translation between parallel programming schemes, including optional one-shot augmentation with an example input-output pair.
</span></figcaption>
</figure>
