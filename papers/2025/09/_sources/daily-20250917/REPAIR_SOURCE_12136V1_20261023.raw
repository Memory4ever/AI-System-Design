" width="21.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic2.m30" class="ltx_Math" alttext="0.25" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#FF8080;" mathcolor="#FF8080" mathsize="0.700em">0.25</mn><annotation encoding="application/x-tex">0.25</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#FF8080;--ltx-fill-color:#FF8080;" fill="#FF8080" stroke="#FF8080" transform="matrix(0.0 1.0 -1.0 0.0 87.87 41.64)"><foreignObject style="--ltx-fo-width:1.9em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="21.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic2.m31" class="ltx_Math" alttext="0.54" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#FF8080;" mathcolor="#FF8080" mathsize="0.700em">0.54</mn><annotation encoding="application/x-tex">0.54</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#FF8080;--ltx-fill-color:#FF8080;" fill="#FF8080" stroke="#FF8080" transform="matrix(0.0 1.0 -1.0 0.0 112.37 38.72)"><foreignObject style="--ltx-fo-width:1.42em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="16.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S5.F4.pic2.m32" class="ltx_Math" alttext="0.5" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#FF8080;" mathcolor="#FF8080" mathsize="0.700em">0.5</mn><annotation encoding="application/x-tex">0.5</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#FF8080;--ltx-fill-color:#FF8080;" fill="#FF8080" stroke="#FF8080" transform="matrix(0.0 1.0 -1.0 0.0 136.87 43.89)"><foreignObject style="--ltx-fo-w