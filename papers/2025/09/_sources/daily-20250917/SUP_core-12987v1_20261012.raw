</span></span></span></foreignObject></g><g style="--ltx-fill-color:#CCFFFF;" fill="#CCFFFF"><path d="M -132.78 -46.16 L -189.93 -46.16 C -192.99 -46.16 -195.46 -48.64 -195.46 -51.69 L -195.46 -91.85 C -195.46 -94.9 -192.99 -97.38 -189.93 -97.38 L -132.78 -97.38 C -129.72 -97.38 -127.24 -94.9 -127.24 -91.85 L -127.24 -51.69 C -127.24 -48.64 -129.72 -46.16 -132.78 -46.16 Z M -195.46 -97.38"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -190.85 -92.77)"><foreignObject style="--ltx-fo-width:4.26em;--ltx-fo-height:3.04em;--ltx-fo-depth:0em;font-size:10pt;" height="42" overflow="visible" transform="matrix(1 0 0 -1 0 42)" width="59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><img src="2509.12987v1/pics/tool-box-152145_640.png" id="Sx2.F1.pic1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:59/42;" width="59" height="42" alt="Refer to caption"></span></span></foreignObject></g><g style="--ltx-fill-color:#CCFFCC;" fill="#CCFFCC"><path d="M -141.23 -109.75 L -181.47 -109.75 C -184.53 -109.75 -187.01 -112.23 -187.01 -115.28 L -187.01 -147.52 C -187.01 -150.58 -184.53 -153.05 -181.47 -153.05 L -141.23 -153.05 C -138.17 -153.05 -135.7 -150.58 -135.7 -147.52 L -135.7 -115.28 C -135.7 -112.23 -138.17 -109.75 -141.23 -109.75 Z M -187.01 -153.05"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -182.4 -136.21)"><foreignObject style="--ltx-fo-width:3.04em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="42.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">Reflect</span></span></foreignObject></g><g style="--ltx-fill-color:#FFFFCC;" fill="#FFFFCC"><path d="M 285.14 -50.12 L 132.78 -50.12 C 129.72 -50.12 127.24 -52.6 127.24 -55.