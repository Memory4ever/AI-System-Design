<td id="S4.T5.5.4.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:14.0pt;padding-right:14.0pt;"><span id="S4.T5.5.4.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">20.48</span></td>
