<td id="S4.T5.5.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:14.0pt;padding-right:14.0pt;"><span id="S4.T5.5.4.2.1" class="ltx_text" style="font-size:80%;">24.10</span></td>
