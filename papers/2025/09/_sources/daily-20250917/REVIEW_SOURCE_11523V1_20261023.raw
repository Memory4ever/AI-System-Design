<td id="S4.T1.5.1.2.11" class="ltx_td ltx_align_center ltx_border_t">F1<math id="S4.T1.m11" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S4.T1.5.1.2.12" class="ltx_td ltx_align_center ltx_border_t">ACC<math id="S4.T1.m12" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="S4.T1.5.1.3" class="ltx_tr">
<th id="S4.T1.5.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T1.5.1.3.1.1" class="ltx_text">UniXcoder</span></th>
<th id="S4.T1.5.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">-</th>
