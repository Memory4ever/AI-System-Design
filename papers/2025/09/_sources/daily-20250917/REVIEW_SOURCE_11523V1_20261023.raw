<td id="S4.T5.5.3.4" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;"><span id="S4.T5.5.3.4.1" class="ltx_text" style="font-size:80%;">18.07</span></td>
<td id="S4.T5.5.3.5" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;"><span id="S4.T5.5.3.5.1" class="ltx_text" style="font-size:80%;">39.76</span></td>
