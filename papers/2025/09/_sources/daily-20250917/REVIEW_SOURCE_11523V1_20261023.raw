<td id="S4.T5.5.3.2" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;"><span id="S4.T5.5.3.2.1" class="ltx_text" style="font-size:80%;">25.30</span></td>
