<tr id="S4.T1.5.1.4" class="ltx_tr">
<th id="S4.T1.5.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="3"><span id="S4.T1.5.1.4.1.1" class="ltx_text">GPT-3.5</span></th>
<th id="S4.T1.5.1.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Single-Agent</th>
<th id="S4.T1.5.1.4.3" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">CoT</th>
<td id="S4.T1.5.1.4.4" class="ltx_td ltx_align_center ltx_border_t">6.21</td>
<td id="S4.T1.5.1.4.5" class="ltx_td ltx_align_center ltx_border_t">5.50</td>
<td id="S4.T1.5.1.4.6" class="ltx_td ltx_align_center ltx_border_t">0.71</td>
<td id="S4.T1.5.1.4.7" class="ltx_td ltx_align_center ltx_border_t">10.3</td>
<td id="S4.T1.5.1.4.8" class="ltx_td ltx_align_center ltx_border_t">18.1</td>
<td id="S4.T1.5.1.4.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">50.3</td>
