<td id="S4.T5.5.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:14.0pt;padding-right:14.0pt;"><span id="S4.T5.5.2.7.1" class="ltx_text" style="font-size:80%;">62.05</span></td></tr>
