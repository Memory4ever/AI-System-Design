<div id="S5.T4.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:440.1pt;height:57.5pt;vertical-align:-26.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-60.3pt,7.9pt) scale(0.8,0.8) ;">
<table id="S5.T4.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T4.2.1.1" class="ltx_tr">
