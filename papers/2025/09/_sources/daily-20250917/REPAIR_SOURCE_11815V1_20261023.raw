<td id="S5.T4.2.1.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><math id="S5.T4.m6" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math></td>
