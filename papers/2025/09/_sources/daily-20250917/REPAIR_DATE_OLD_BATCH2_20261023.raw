liation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayao","familyName":"Du","name":"Du, Jiayao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jupeng","familyName":"Chen","name":"Chen, Jupeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyue","familyName":"Mao","name":"Mao, Xinyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongyuan","familyName":"Guo","name":"Guo, Dongyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixuan","familyName":"Tang","name":"Tang, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yulin","familyName":"Tsai","name":"Tsai, Yulin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yonghao","familyName":"Tan","name":"Tan, Yonghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaao","familyName":"Yu","name":"Yu, Jiaao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junlin","familyName":"Yu","name":"Yu, Junlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keren","familyName":"Zhang","name":"Zhang, Keren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Li","name":"Li, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Chen","name":"Chen, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tian","familyName":"Liu","name":"Liu, Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Wang","name":"Wang, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhong","familyName":"Liu","name":"Liu, Yuhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Organizational","affiliation":[],"name":"Linus","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Jiang","name":"Jiang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuo","familyName":"Chen","name":"Chen, Zhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunchao","familyName":"Guo","name":"Guo, Chunchao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Hunyuan3D Studio: End-to-End AI Pipeline for Game-Ready 3D Asset Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T08:33:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:33:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The creation of high-quality 3D assets, a cornerstone of modern game development, has long been characterized by labor-intensive and specialized workflows. This paper presents Hunyuan3D Studio, an end-to-end AI-powered content creation platform designed to revolutionize the game production pipeline by automating and streamlining the generation of game-ready 3D assets. At its core, Hunyuan3D Studio integrates a suite of advanced neural modules (such as Part-level 3D Generation, Polygon Generation, Semantic UV, etc.) into a cohesive and user-friendly system. This unified framework allows for the rapid transformation of a single concept image or textual description into a fully-realized, production-quality 3D model complete with optimized geometry and high-fidelity PBR textures. We demonstrate that assets generated by Hunyuan3D Studio are not only visually compelling but also adhere to the stringent technical requirements of contemporary game engines, significantly reducing iteration time and lowering the barrier to entry for 3D content creation. By providing a seamless bridge from creative intent to technical asset, Hunyuan3D Studio represents a significant leap forward for AI-assisted workflows in game development and interactive media."},{"descriptionType":"Other","description":"Technical Report"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12815","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:49:13Z","registered":"2025-09-17T01:49:13Z","published":null,"updated":"2025-09-17T01:49:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12818","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12818","identifiers":[{"identifier":"2509.12818","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Maximilian","familyName":"Ilse","name":"Ilse, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harshita","familyName":"Sharma","name":"Sharma, Harshita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anton","familyName":"Schwaighofer","name":"Schwaighofer, Anton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sam","familyName":"Bond-Taylor","name":"Bond-Taylor, Sam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fernando","familyName":"Pérez-García","name":"Pérez-García, Fernando","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olesya","familyName":"Melnichenko","name":"Melnichenko, Olesya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anne-Marie G.","familyName":"Sykes","name":"Sykes, Anne-Marie G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kelly K.","familyName":"Horst","name":"Horst, Kelly K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashish","familyName":"Khandelwal","name":"Khandelwal, Ashish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxwell","familyName":"Reynolds","name":"Reynolds, Maxwell","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria T.","familyName":"Wetscherek","name":"Wetscherek, Maria T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noel C. F.","familyName":"Codella","name":"Codella, Noel C. F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javier","familyName":"Alvarez-Valle","name":"Alvarez-Valle, Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Korfiatis","familyName":"Panagiotis","name":"Panagiotis, Korfiatis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentina","familyName":"Salvatelli","name":"Salvatelli, Valentina","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Data Scaling Laws for Radiology Foundation Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T08:36:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:33:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Foundation vision encoders such as CLIP and DINOv2, trained on web-scale data, exhibit strong transfer performance across tasks and datasets. However, medical imaging foundation models remain constrained by smaller datasets, limiting our understanding of how data scale and pretraining paradigms affect performance in this setting. In this work, we systematically study continual pretraining of two vision encoders, MedImageInsight (MI2) and RAD-DINO representing the two major encoder paradigms CLIP and DINOv2, on up to 3.5M chest x-rays from a single institution, holding compute and evaluation protocols constant. We evaluate on classification (radiology findings, lines and tubes), segmentation (lines and tubes), and radiology report generation. While prior work has primarily focused on tasks related to radiology findings, we include lines and tubes tasks to counterbalance this bias and evaluate a model's ability to extract features that preserve continuity along elongated structures. Our experiments show that MI2 scales more effectively for finding-related tasks, while RAD-DINO is stronger on tube-related tasks. Surprisingly, continually pretraining MI2 with both reports and structured labels using UniCL improves performance, underscoring the value of structured supervision at scale. We further show that for some tasks, as few as 30k in-domain samples are sufficient to surpass open-weights foundation models. These results highlight the utility of center-specific continual pretraining, enabling medical institutions to derive significant performance gains by utilizing in-domain data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12818","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:49:17Z","registered":"2025-09-17T01:49:18Z","published":null,"updated":"2025-09-17T01:49:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12824","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12824","identifiers":[{"identifier":"2509.12824","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zechao","familyName":"Liu","name":"Liu, Zechao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Zhou","name":"Zhou, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangkun","familyName":"Chen","name":"Chen, Xiangkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Liang","name":"Liang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dapeng","familyName":"Lang","name":"Lang, Dapeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DiffHash: Text-Guided Targeted Attack via Diffusion Models against Deep Hashing Image Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T08:49:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:33:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T07:49:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:29:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep hashing models have been widely adopted to tackle the challenges of large-scale image retrieval. However, these approaches face serious security risks due to their vulnerability to adversarial examples. Despite the increasing exploration of targeted attacks on deep hashing models, existing approaches still suffer from a lack of multimodal guidance, reliance on labeling information and dependence on pixel-level operations for attacks. To address these limitations, we proposed DiffHash, a novel diffusion-based targeted attack for deep hashing. Unlike traditional pixel-based attacks that directly modify specific pixels and lack multimodal guidance, our approach focuses on optimizing the latent representations of images, guided by text information generated by a Large Language Model (LLM) for the target image. Furthermore, we designed a multi-space hash alignment network to align the high-dimension image space and text space to the low-dimension binary hash space. During reconstruction, we also incorporated text-guided attention mechanisms to refine adversarial examples, ensuring them aligned with the target semantics while maintaining visual plausibility. Extensive experiments have demonstrated that our method outperforms state-of-the-art (SOTA) targeted attack methods, achieving better black-box transferability and offering more excellent stability across datasets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12824","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:49:25Z","registered":"2025-09-17T01:49:26Z","published":null,"updated":"2025-09-18T17:46:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12838","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12838","identifiers":[{"identifier":"2509.12838","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kento","familyName":"Murata","name":"Murata, Kento","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shoichi","familyName":"Hasegawa","name":"Hasegawa, Shoichi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomochika","familyName":"Ishikawa","name":"Ishikawa, Tomochika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoshinobu","familyName":"Hagiwara","name":"Hagiwara, Yoshinobu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akira","familyName":"Taniguchi","name":"Taniguchi, Akira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lotfi El","familyName":"Hafi","name":"Hafi, Lotfi El","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tadahiro","familyName":"Taniguchi","name":"Taniguchi, Tadahiro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-Robot Task Planning for Multi-Object Retrieval Tasks with Distributed On-Site Knowledge via Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T09:00:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:34:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-30T12:31:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-01T00:59:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"It is crucial to efficiently execute instructions such as \"Find an apple and a banana\" or \"Get ready for a field trip,\" which require searching for multiple objects or understanding context-dependent commands. This study addresses the challenging problem of determining which robot should be assigned to which part of a task when each robot possesses different situational on-site knowledge-specifically, spatial concepts learned from the area designated to it by the user. We propose a task planning framework that leverages large language models (LLMs) and spatial concepts to decompose natural language instructions into subtasks and allocate them to multiple robots. We designed a novel few-shot prompting strategy that enables LLMs to infer required objects from ambiguous commands and decompose them into appropriate subtasks. In our experiments, the proposed method achieved 47/50 successful assignments, outperforming random (28/50) and commonsense-based assignment (26/50). Furthermore, we conducted qualitative evaluations using two actual mobile manipulators. The results demonstrated that our framework could handle instructions, including those involving ad hoc categories such as \"Get ready for a field trip,\" by successfully performing task decomposition, assignment, sequential planning, and execution."},{"descriptionType":"Other","description":"Submitted to AROB-ISBC 2026 (Journal Track option)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12838","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:49:44Z","registered":"2025-09-17T01:49:45Z","published":null,"updated":"2025-10-01T03:04:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12867","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12867","identifiers":[{"identifier":"2509.12867","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yabo","familyName":"Zhang","name":"Zhang, Yabo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihan","familyName":"Zeng","name":"Zeng, Yihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyun","familyName":"Li","name":"Li, Qingyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Hu","name":"Hu, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kavin","familyName":"Han","name":"Han, Kavin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wangmeng","familyName":"Zuo","name":"Zuo, Wangmeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tool-R1: Sample-Efficient Reinforcement Learning for Agentic Tool Use"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T09:22:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:35:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have demonstrated strong capabilities in language understanding and reasoning, yet they remain limited when tackling real-world tasks that require up-to-date knowledge, precise operations, or specialized tool use. To address this, we propose Tool-R1, a reinforcement learning framework that enables LLMs to perform general, compositional, and multi-step tool use by generating executable Python code. Tool-R1 supports integration of user-defined tools and standard libraries, with variable sharing across steps to construct coherent workflows. An outcome-based reward function, combining LLM-based answer judgment and code execution success, guides policy optimization. To improve training efficiency, we maintain a dynamic sample queue to cache and reuse high-quality trajectories, reducing the overhead of costly online sampling. Experiments on the GAIA benchmark show that Tool-R1 substantially improves both accuracy and robustness, achieving about 10\\% gain over strong baselines, with larger improvements on complex multi-step tasks. These results highlight the potential of Tool-R1 for enabling reliable and efficient tool-augmented reasoning in real-world applications. Our code will be available at https://github.com/YBYBZhang/Tool-R1."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12867","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:50:26Z","registered":"2025-09-17T01:50:26Z","published":null,"updated":"2025-09-17T01:50:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12876","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12876","identifiers":[{"identifier":"2509.12876","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fuyu","familyName":"Xing","name":"Xing, Fuyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimu","familyName":"Wang","name":"Wang, Zimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wang","name":"Wang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyang","familyName":"Zhang","name":"Zhang, Haiyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Benchmarking and Improving LVLMs on Event Extraction from Multimedia Documents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T09:29:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:36:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The proliferation of multimedia content necessitates the development of effective Multimedia Event Extraction (M2E2) systems. Though Large Vision-Language Models (LVLMs) have shown strong cross-modal capabilities, their utility in the M2E2 task remains underexplored. In this paper, we present the first systematic evaluation of representative LVLMs, including DeepSeek-VL2 and the Qwen-VL series, on the M2E2 dataset. Our evaluations cover text-only, image-only, and cross-media subtasks, assessed under both few-shot prompting and fine-tuning settings. Our key findings highlight the following valuable insights: (1) Few-shot LVLMs perform notably better on visual tasks but struggle significantly with textual tasks; (2) Fine-tuning LVLMs with LoRA substantially enhances model performance; and (3) LVLMs exhibit strong synergy when combining modalities, achieving superior performance in cross-modal settings. We further provide a detailed error analysis to reveal persistent challenges in areas such as semantic precision, localization, and cross-modal grounding, which remain critical obstacles for advancing M2E2 capabilities."},{"descriptionType":"Other","description":"Accepted at INLG 2025. Camera-ready version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12876","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:50:38Z","registered":"2025-09-17T01:50:39Z","published":null,"updated":"2025-09-17T01:50:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12878","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12878","identifiers":[{"identifier":"2509.12878","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qianguang","familyName":"Zhao","name":"Zhao, Qianguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongli","familyName":"Wang","name":"Wang, Dongli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Zhou","name":"Zhou, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianxun","familyName":"Li","name":"Li, Jianxun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Irampa","name":"Irampa, Richard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Few to Big: Prototype Expansion Network via Diffusion Learner for Point Cloud Few-shot Semantic Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T09:29:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:36:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-30T12:18:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-01T00:54:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Few-shot 3D point cloud semantic segmentation aims to segment novel categories using a minimal number of annotated support samples. However, prototypes derived from the limited non-structural point cloud support set are often misaligned and have a small capacity, hindering effective gen eralization to novel categories. This stems from two core issues: i) the prototype possess limited representational capacity fails to cover the full intra-class diversity of a novel category, and ii) the prototypes suffer from misalignment with the query space due to the inter-set inconsistency between support and query sets. To address these issues, our work focuses on leveraging the few support samples to construct a well-aligned big-capacity prototype. Motivated by the powerful generative capabilities of diffusion models, we re-purpose its pre-trained conditional encoder to provide rich feature components for prototype ex pansion. Subsequently, a push-pull force aligns this expanded prototype towards the query feature space. Under this setup, we introduce the Prototype Expansion Network (PENet), a framework that constructs aligned big-capacity prototypes from two complementary feature sources. Specifically, PENet employs a dual-stream learner architecture: it retains a conventional fully supervised Intrinsic Learner (IL) to distill representative features, while introducing a novel Diffusion Learner (DL) to provide rich generalizable features. The resulting dual prototypes are then processed by a Prototype Assimilation Module (PAM), which adopts a push-pull attention block to align the prototypes with the query space. Furthermore, a Prototype Calibration Mechanism (PCM) regularizes the final big-capacity prototype to prevent semantic drift. Extensive experiments on the S3DIS and ScanNet datasets demonstrate that PENet outperforms state-of-the-art methods across various few-shot settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12878","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:50:41Z","registered":"2025-09-17T01:50:42Z","published":null,"updated":"2026-07-01T02:27:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12886","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12886","identifiers":[{"identifier":"2509.12886","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yubo","familyName":"Zhu","name":"Zhu, Yubo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongrui","familyName":"Liu","name":"Liu, Dongrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zecheng","familyName":"Lin","name":"Lin, Zecheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Tong","name":"Tong, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheng","familyName":"Zhong","name":"Zhong, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Shao","name":"Shao, Jing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The LLM Already Knows: Estimating LLM-Perceived Question Difficulty via Hidden Representations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T09:38:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:36:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Estimating the difficulty of input questions as perceived by large language models (LLMs) is essential for accurate performance evaluation and adaptive inference. Existing methods typically rely on repeated response sampling, auxiliary models, or fine-tuning the target model itself, which may incur substantial computational costs or compromise generality. In this paper, we propose a novel approach for difficulty estimation that leverages only the hidden representations produced by the target LLM. We model the token-level generation process as a Markov chain and define a value function to estimate the expected output quality given any hidden state. This allows for efficient and accurate difficulty estimation based solely on the initial hidden state, without generating any output tokens. Extensive experiments across both textual and multimodal tasks demonstrate that our method consistently outperforms existing baselines in difficulty estimation. Moreover, we apply our difficulty estimates to guide adaptive reasoning strategies, including Self-Consistency, Best-of-N, and Self-Refine, achieving higher inference efficiency with fewer generated tokens."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12886","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:50:52Z","registered":"2025-09-17T01:50:53Z","published":null,"updated":"2025-09-17T01:50:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":40,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=id%3A%28%2210.48550%2Farxiv.2509.12492%22+OR+%2210.48550%2Farxiv.2509.12508%22+OR+%2210.48550%2Farxiv.2509.12512%22+OR+%2210.48550%2Farxiv.2509.12514%22+OR+%2210.48550%2Farxiv.2509.12519%22+OR+%2210.48550%2Farxiv.2509.12541%22+OR+%2210.48550%2Farxiv.2509.12554%22+OR+%2210.48550%2Farxiv.2509.12569%22+OR+%2210.48550%2Farxiv.2509.12574%22+OR+%2210.48550%2Farxiv.2509.12591%22+OR+%2210.48550%2Farxiv.2509.12594%22+OR+%2210.48550%2Farxiv.2509.12602%22+OR+%2210.48550%2Farxiv.2509.12603%22+OR+%2210.48550%2Farxiv.2509.12610%22+OR+%2210.48550%2Farxiv.2509.12612%22+OR+%2210.48550%2Farxiv.2509.12630%22+OR+%2210.48550%2Farxiv.2509.12647%22+OR+%2210.48550%2Farxiv.2509.12650%22+OR+%2210.48550%2Farxiv.2509.12661%22+OR+%2210.48550%2Farxiv.2509.12676%22+OR+%2210.48550%2Farxiv.2509.12697%22+OR+%2210.48550%2Farxiv.2509.12721%22+OR+%2210.48550%2Farxiv.2509.12724%22+OR+%2210.48550%2Farxiv.2509.12743%22+OR+%2210.48550%2Farxiv.2509.12754%22+OR+%2210.48550%2Farxiv.2509.12760%22+OR+%2210.48550%2Farxiv.2509.12765%22+OR+%2210.48550%2Farxiv.2509.12768%22+OR+%2210.48550%2Farxiv.2509.12772%22+OR+%2210.48550%