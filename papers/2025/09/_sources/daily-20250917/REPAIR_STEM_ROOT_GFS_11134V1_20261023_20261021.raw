<div id="alg1.6.9" class="ltx_listingline"><span id="alg1.6.9.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.9.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.9.3" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.6.9.4" class="ltx_text ltx_font_bold" style="font-size:80%;">7</span></span>
              <math id="alg1.m11" class="ltx_math_unparsed" alttext="\boldsymbol{\mathcal{G}_{f}}\leftarrow\{n_{k}\in\boldsymbol{\mathcal{G}}\mid n_{k}.\text{idleGPUs}\geq g_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝓖</mi><mi mathsize="0.800em">𝒇</mi></msub><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.800em">n</mi><mi mathsize="0.800em">k</mi></msub><mo mathsize="0.800em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝓖</mi><mo lspace="0em" mathsize="0.800em" rspace="0.167em">∣</mo><msub><mi mathsize="0.800em">n</mi><mi mathsize="0.800em">k</mi></msub><mo lspace="0em" mathsize="0.800em" rspace="0.167em">.</mo><mtext mathsize="0.800em">idleGPUs</mtext><mo mathsize="0.800em">≥</mo><msub><mi mathsize="0.800em">g</mi><mi mathsize="0.800em">i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\mathcal{G}_{f}}\leftarrow\{n_{k}\in\boldsymbol{\mathcal{G}}\mid n_{k}.\text{idleGPUs}\geq g_{i}</annotation></semantics></math><span id="alg1.6.9.5" class="ltx_text" style="font-size:80%;"> </span><span id="alg1.6.9.6" class="ltx_text" style="font-size:80%;"> and </span><span id="alg1.6.9.7" class="ltx_text" style="font-size:80%;"> </span><math id="alg1.m12" class="ltx_math_unparsed" alttext="Score_{3}(n_{k})&gt;0\}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">S</mi><mi mathsize="0.800em">c</mi><mi mathsize="0.800em">o</mi><mi mathsize="0.800em">r</mi><msub><mi mathsize="0.800em">e</mi><mn mathsize="0.800em">3</mn></msub><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">n</mi><mi mathsize="0.800em">k</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">&gt;</mo><mn mathsize="0.800em">0</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">Score_{3}(n_{k})&gt;0\}</annotation></semantics></math><span id="alg1.6.9.8" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg1.6.10" class="ltx_listingline"><span id="alg1.6.10.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.10.2" class="ltx_text" style="font-size:80%;">  </span>
