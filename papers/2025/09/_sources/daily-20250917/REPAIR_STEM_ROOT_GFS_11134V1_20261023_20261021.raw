</div>
<div id="alg1.6.11" class="ltx_listingline"><span id="alg1.6.11.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.11.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.11.3" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.6.11.4" class="ltx_text ltx_font_bold" style="font-size:80%;">9</span></span>
              <math id="alg1.m14" class="ltx_Math" alttext="n_{k}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">n</mi><mi mathsize="0.800em">k</mi></msub><mo mathsize="0.800em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">n_{k}\leftarrow</annotation></semantics></math><span id="alg1.6.11.5" class="ltx_text" style="font-size:80%;"> the top node in </span><math id="alg1.m15" class="ltx_Math" alttext="\boldsymbol{\mathcal{G}_{f}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝓖</mi><mi mathsize="0.800em">𝒇</mi></msub><annotation encoding="application/x-tex">\boldsymbol{\mathcal{G}_{f}}</annotation></semantics></math><span id="alg1.6.11.6" class="ltx_text" style="font-size:80%;"> sorted by &lt;Score</span><sub id="alg1.6.11.7" class="ltx_sub"><span id="alg1.6.11.7.1" class="ltx_text" style="font-size:80%;">1</span></sub><span id="alg1.6.11.8" class="ltx_text" style="font-size:80%;">, Score</span><sub id="alg1.6.11.9" class="ltx_sub"><span id="alg1.6.11.9.1" class="ltx_text" style="font-size:80%;">2</span></sub><span id="alg1.6.11.10" class="ltx_text" style="font-size:80%;">, Score</span><sub id="alg1.6.11.11" class="ltx_sub"><span id="alg1.6.11.11.1" class="ltx_text" style="font-size:80%;">3</span></sub><span id="alg1.6.11.12" class="ltx_text" style="font-size:80%;">&gt; in descending
</span>
</div>
<div id="alg1.6.12" class="ltx_listingline"><span id="alg1.6.12.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.12.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.12.3" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.6.12.4" class="ltx_text ltx_font_bold" style="font-size:80%;">10</span></span>
              <math id="alg1.m19" class="ltx_Math" alttext="x_{i,k,t}\leftarrow x_{i,k,t}+1" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">x</mi><mrow><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">k</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">t</mi></mrow></msub><mo mathsize="0.800em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.800em">x</mi><mrow><mi mathsize="0.800em">i</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">k</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">t</mi></mrow></msub><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">1</mn></mrow></mrow><annotation encoding="application/x-tex">x_{i,k,t}\leftarrow x_{i,k,t}+1</annotation></semantics></math><span id="alg1.6.12.5" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg1.6.13" class="ltx_listingline"><span id="alg1.6.13.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.13.2" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.6.13.3" class="ltx_text ltx_font_bold" style="font-size:80%;">11</span></span>
              <span id="alg1.6.13.4" class="ltx_text ltx_font_bold" style="font-size:80%;">else</span>
</div>
<div id="alg1.6.14" class="ltx_listingline"><span id="alg1.6.14.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.14.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg1.6.14.3" class="ltx_text" style="font-size:80%;">  </span>
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.6.14.4" class="ltx_text ltx_font_bold" style="font-size:80%;">12</span></span>
