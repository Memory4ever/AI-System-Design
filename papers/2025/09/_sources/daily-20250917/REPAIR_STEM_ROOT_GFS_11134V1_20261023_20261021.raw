</div>
<div id="alg1.6.3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.6.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">1</span></span>
              <span id="alg1.6.3.2" class="ltx_text" style="font-size:80%;">Initialize </span><math id="alg1.m4" class="ltx_Math" alttext="\boldsymbol{\mathcal{R}}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝓡</mi><annotation encoding="application/x-tex">\boldsymbol{\mathcal{R}}</annotation></semantics></math><span id="alg1.6.3.3" class="ltx_text" style="font-size:80%;"> with </span><math id="alg1.m5" class="ltx_Math" alttext="\emptyset" display="inline" intent=":literal"><semantics><mi mathsize="0.800em" mathvariant="normal">∅</mi><annotation encoding="application/x-tex">\emptyset</annotation></semantics></math><span id="alg1.6.3.4" class="ltx_text" style="font-size:80%;">
