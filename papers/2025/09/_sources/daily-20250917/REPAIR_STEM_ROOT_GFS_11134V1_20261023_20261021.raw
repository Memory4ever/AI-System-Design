</span>
</div>
<div id="alg1.6.15" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.6.15.1" class="ltx_text ltx_font_bold" style="font-size:80%;">13</span></span>
              <span id="alg1.6.15.2" class="ltx_text ltx_font_bold" style="font-size:80%;">return</span><span id="alg1.6.15.3" class="ltx_text" style="font-size:80%;"> </span><math id="alg1.m20" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math><span id="alg1.6.15.4" class="ltx_text" style="font-size:80%;">
