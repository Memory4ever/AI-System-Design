<td id="S4.T9.7.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T9.7.3.2.1" class="ltx_text" style="font-size:80%;">17,776.6</span></td>
<td id="S4.T9.7.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T9.7.3.3.1" class="ltx_text" style="font-size:80%;">27.6</span></td>
