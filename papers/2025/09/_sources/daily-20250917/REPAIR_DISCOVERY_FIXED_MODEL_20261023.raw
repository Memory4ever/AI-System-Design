{"data":[{"id":"10.48550/arxiv.2509.10468","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10468","identifiers":[{"identifier":"2509.10468","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifan","familyName":"Liu","name":"Liu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaokun","familyName":"Liu","name":"Liu, Yaokun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zelin","familyName":"Li","name":"Li, Zelin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenrui","familyName":"Yue","name":"Yue, Zhenrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gyuseok","familyName":"Lee","name":"Lee, Gyuseok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruichen","familyName":"Yao","name":"Yao, Ruichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhang","name":"Zhang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Wang","name":"Wang, Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning Decomposed Contextual Token Representations from Pretrained and Collaborative Signals for Generative Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"cs.IR","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-08-22T18:50:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:00:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-01T22:20:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-05T00:12:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in generative recommenders adopt a two-stage paradigm: items are first tokenized into semantic IDs using a pretrained tokenizer, and then large language models (LLMs) are trained to generate the next item via sequence-to-sequence modeling. However, these two stages are optimized for different objectives: semantic reconstruction during tokenizer pretraining versus user interaction modeling during recommender training. This objective misalignment leads to two key limitations: (i) suboptimal static tokenization, where fixed token assignments fail to reflect diverse usage contexts; and (ii) discarded pretrained semantics, where pretrained knowledge - typically from language model embeddings - is overwritten during recommender training on user interactions. To address these limitations, we propose to learn $\\underline{DE}$composed $\\underline{CO}$ntextual Token $\\underline{R}$epresentations (DECOR), a unified framework that preserves pretrained semantics while enhancing the adaptability of token embeddings. DECOR introduces contextualized token composition to refine token embeddings based on user interaction context, and decomposed embedding fusion that integrates pretrained codebook embeddings with newly learned collaborative embeddings. Experiments on three real-world datasets demonstrate that DECOR consistently outperforms state-of-the-art baselines in recommendation performance."},{"descriptionType":"Other","description":"Accepted to SIGIR 2026. Full author version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10468","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:39:57Z","registered":"2025-09-16T02:39:58Z","published":null,"updated":"2026-05-05T04:00:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10469","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10469","identifiers":[{"identifier":"2509.10469","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jesse","familyName":"Ponnock","name":"Ponnock, Jesse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Grace","familyName":"Kenneally","name":"Kenneally, Grace","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael Robert","familyName":"Briggs","name":"Briggs, Michael Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elinor","familyName":"Yeo","name":"Yeo, Elinor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tyrone","familyName":"Patterson","name":"Patterson, Tyrone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Kinberg","name":"Kinberg, Nicholas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Kalinowski","name":"Kalinowski, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Hechtman","name":"Hechtman, David","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Real-Time RAG for the Identification of Supply Chain Vulnerabilities"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; H.3.3; I.2.6","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-08-23T22:06:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T02:43:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"New technologies in generative AI can enable deeper analysis into our nation's supply chains but truly informative insights require the continual updating and aggregation of massive data in a timely manner. Large Language Models (LLMs) offer unprecedented analytical opportunities however, their knowledge base is constrained to the models' last training date, rendering these capabilities unusable for organizations whose mission impacts rely on emerging and timely information. This research proposes an innovative approach to supply chain analysis by integrating emerging Retrieval-Augmented Generation (RAG) preprocessing and retrieval techniques with advanced web-scraping technologies. Our method aims to reduce latency in incorporating new information into an augmented-LLM, enabling timely analysis of supply chain disruptors. Through experimentation, this study evaluates the combinatorial effects of these techniques towards timeliness and quality trade-offs. Our results suggest that in applying RAG systems to supply chain analysis, fine-tuning the embedding retrieval model consistently provides the most significant performance gains, underscoring the critical importance of retrieval quality. Adaptive iterative retrieval, which dynamically adjusts retrieval depth based on context, further enhances performance, especially on complex supply chain queries. Conversely, fine-tuning the LLM yields limited improvements and higher resource costs, while techniques such as downward query abstraction significantly outperforms upward abstraction in practice."},{"descriptionType":"Other","description":"14 pages, 5 figures, 1 table. Approved for Public Release; Distribution Unlimited. PRS Release Number: 25-0864"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10469","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:39:59Z","registered":"2025-09-16T02:39:59Z","published":null,"updated":"2025-09-16T03:41:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10489","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10489","identifiers":[{"identifier":"2509.10489","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Saptarshi","familyName":"Purkayastha","name":"Purkayastha, Saptarshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hrishikesh","familyName":"Bhagwat","name":"Bhagwat, Hrishikesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keerthika","familyName":"Sunchu","name":"Sunchu, Keerthika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Orlando","familyName":"Hoilett","name":"Hoilett, Orlando","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eddy","familyName":"Odari","name":"Odari, Eddy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reuben","familyName":"Thuo","name":"Thuo, Reuben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Wafula","name":"Wafula, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Celia","familyName":"Kariuki","name":"Kariuki, Celia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sherri","familyName":"Bucher","name":"Bucher, Sherri","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Development of AI-integrated infrastructure with biomedical device and mobile app for neonatal vital monitoring during and in between kangaroo care sessions"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-08-30T18:59:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:00:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Premature infant mortality remains a critical challenge in low- and middle-income countries (LMICs), with continuous vital sign monitoring being essential for early detection of life-threatening conditions. This paper presents an integrated system combining NeoWarm, a novel biomedical device, with NeoRoo, a mobile application, and NeoSmartML, a machine learning infrastructure, to enable comprehensive vital sign monitoring during Kangaroo Mother Care (KMC). Our power-optimized device achieves 6-6.5 days of continuous operation on a single charge, while the mobile application implements an offline-first architecture with efficient data synchronization. The optical character recognition pipeline demonstrates promising accuracy (F1 scores 0.78-0.875) for automated vital sign extraction from existing NICU monitors. Experimental validation shows the system's feasibility for deployment in resource-constrained settings, though further optimization of heart rate and temperature detection, along with the risk classification foundation model is needed."},{"descriptionType":"Other","description":"Presented at EMBC 2025, July 14-17, 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10489","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:40:28Z","registered":"2025-09-16T02:40:28Z","published":null,"updated":"2025-09-16T02:40:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10513","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10513","identifiers":[{"identifier":"2509.10513","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sugyeong","familyName":"Eo","name":"Eo, Sugyeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungjun","familyName":"Lee","name":"Lee, Jungjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chanjun","familyName":"Park","name":"Park, Chanjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heuiseok","familyName":"Lim","name":"Lim, Heuiseok","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mixture-of-Clustered-Experts: Advancing Expert Specialization and Generalization in Instruction Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-03T07:17:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:01:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A sparse Mixture-of-Experts (MoE) architecture has emerged as a highly scalable solution by conditionally activating sub-modules without a proportional increase in computational costs. However, improving expert specialization to enhance performance and generalization remains a challenge for MoE, especially in instruction tuning scenarios characterized by significant input heterogeneity. In this work, we propose the Mixture-of-Clustered-Experts (MoCE) to address this limitation through a dual-stage routing mechanism. The first stage in the mechanism performs expert group routing based on sequence-level features, while the second stage activates the top-$k$ experts within the group at the token level. This approach enables the effective partitioning of heterogeneous inputs based on their knowledge requirements, encouraging expert group specialization while maintaining the advantages of token-level routing. We evaluate MoCE across a comprehensive set of benchmarks, demonstrating its consistent superiority over strong baselines and its enhanced generalization capabilities. Detailed analysis further highlights the robustness and effectiveness of MoCE."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10513","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:41:02Z","registered":"2025-09-16T02:41:02Z","published":null,"updated":"2025-09-16T02:41:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10515","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10515","identifiers":[{"identifier":"2509.10515","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaobo","familyName":"Wang","name":"Wang, Xiaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixia","familyName":"Jia","name":"Jia, Zixia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Li","name":"Li, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Liu","name":"Liu, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zilong","familyName":"Zheng","name":"Zheng, Zilong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adaptive Preference Optimization with Uncertainty-aware Utility Anchor"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-03T10:20:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-26T00:49:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Offline preference optimization methods are efficient for large language models (LLMs) alignment. Direct Preference optimization (DPO)-like learning, one of the most popular approaches, stands out for its efficiency in reward modeling. However, these methods typically follow the convention to use Bradley-Terry (BT) reward modeling that faces several critical assumptions, including the requirement for pairwise training data, model distribution shifting, human rationality assumption, etc. To address these limitations, we propose a general framework for offline preference optimization methods, Adaptive Preference Optimization with Utility Anchor (UAPO), which introduces an anchoring function to estimate the uncertainties brought from preference data annotation. Our method enables training even in scenarios where the data is unpaired, significantly enhancing data utilization efficiency. Moreover, the anchor design makes UAPO more robust in the training process. Experimental results demonstrate that UAPO achieves competitive outcomes without the strict dependency on data pairing, paving the way for more flexible and effective preference optimization methods."},{"descriptionType":"Other","description":"Accepted by EMNLP 2025 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10515","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:41:04Z","registered":"2025-09-16T02:41:05Z","published":null,"updated":"2026-05-26T04:03:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10518","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10518","identifiers":[{"identifier":"2509.10518","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Justin","familyName":"Arndt","name":"Arndt, Justin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Holographic Knowledge Manifolds: A Novel Pipeline for Continual Learning Without Catastrophic Forgetting in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-03T16:54:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:01:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-21T00:59:21Z","dateType":"Withdrawn","dateInformation":"v2; This paper includes significant errors discovered post publication by the author"},{"date":"2025-11-24T01:11:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce the Holographic Knowledge Manifold (HKM), a four-phase pipeline that achieves zero catastrophic forgetting in AI knowledge representation while maintaining minimal memory growth and high efficiency. Leveraging fractal quantization, probabilistic entanglement, and dynamic diffraction chipping, HKM compresses knowledge substrates by 3x with 67% storage savings, integrates holographically at 100%, and supports over 1,020 updates with 1% growth per increment. In experiments on combined WikiText and FB15k datasets (scaled to 2,997 nodes), we demonstrate industry-leading performance: 0% forgetting (infinite improvement over GEM baselines), 3x compression, and 53% training time reduction on consumer GPU hardware. Hypothetical cost analyses project $92.4M savings over 5 years at petabyte scale, with 21.2% energy reduction and 33% lower carbon footprint. This work hypothesizes a paradigm shift for public large language models (LLMs), enabling \"eternal\" adaptation without retraining. Future extensions to multimodal fusion and quantum hardware could further democratize scalable AI, potentially reducing fine-tuning costs by 60-80% for models like Llama-3 or Grok-4. Code, datasets, and full results are publicly available for reproducibility."},{"descriptionType":"Other","description":"This paper includes significant errors discovered post publication by the author"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10518","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:41:09Z","registered":"2025-09-16T02:41:09Z","published":null,"updated":"2025-11-24T02:48:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10530","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10530","identifiers":[{"identifier":"2509.10530","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cheng","familyName":"Li","name":"Li, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiexiong","familyName":"Liu","name":"Liu, Jiexiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixuan","familyName":"Chen","name":"Chen, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"ji","name":"ji, Jie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Adaptive Shared Experts with Grouped Multi-Head Attention Mixture of Experts"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-05T02:49:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:01:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformer models based on the Mixture of Experts (MoE) architecture have made significant progress in long-sequence modeling, but existing models still have shortcomings in computational efficiency and the ability to capture long-range dependencies, especially in terms of the dynamic adaptability of expert resource allocation. In this paper, we propose a Dynamic Adaptive Shared Expert and Grouped Multi-Head Attention Hybrid Model (DASG-MoE) to enhance long-sequence modeling capabilities by integrating three modules. First, we employ the Grouped Multi-Head Attention (GMHA) mechanism to effectively reduce the computational complexity of long sequences. By parallel processing through sequence grouping, local sliding window attention, and feature aggregation, we address long-range dependency issues and the model's lack of generalization for local information. Second, we design a Dual-Scale Shared Expert Structure (DSSE), where shallow experts use lightweight computations to quickly respond to low-dimensional features, while deep experts process high-dimensional complex semantics through pre-training transfer and post-training optimization, achieving a dynamic balance between efficiency and accuracy. Third, we propose a hierarchical Adaptive Dynamic Routing (ADR) mechanism that dynamically selects expert levels based on feature complexity and task requirements, and optimizes resource allocation through a local expert activation strategy. Experiments on multiple long-sequence benchmark datasets demonstrate that our DASG-MoE model outperforms state-of-the-art models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10530","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:41:25Z","registered":"2025-09-16T02:41:26Z","published":null,"updated":"2025-09-16T02:41:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10534","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10534","identifiers":[{"identifier":"2509.10534","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anand","familyName":"Gopalakrishnan","name":"Gopalakrishnan, Anand","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Csordás","name":"Csordás, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jürgen","familyName":"Schmidhuber","name":"Schmidhuber, Jürgen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael C.","familyName":"Mozer","name":"Mozer, Michael C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoupling the \"What\" and \"Where\" With Polar Coordinate Positional Embeddings"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-05T14:22:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:01:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-22T20:13:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-24T01:05:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-08T15:29:23Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-09T01:57:02Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The attention mechanism in a Transformer architecture matches key to query based on both content -- the what -- and position in a sequence -- the where. We present an analysis indicating that what and where are entangled in the popular RoPE rotary position embedding. This entanglement can impair performance particularly when decisions require independent matches on these two factors. We propose an improvement to RoPE, which we call Polar Coordinate Position Embeddings or PoPE, that eliminates the what-where confound. PoPE is far superior on a diagnostic task requiring indexing solely by position or by content. On autoregressive sequence modeling in music, genomic, and natural language domains, Transformers using PoPE as the positional encoding scheme outperform baselines using RoPE with respect to evaluation loss (perplexity) and downstream task performance. On language modeling, these gains persist across model scale, from 124M to 774M parameters. Crucially, PoPE shows strong zero-shot length extrapolation capabilities compared not only to RoPE but even a method designed for extrapolation, YaRN, which requires additional fine tuning and frequency interpolation."},{"descriptionType":"Other","description":"ICML 2026 camera-ready version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10534","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:41:31Z","registered":"2025-09-16T02:41:32Z","published":null,"updated":"2026-06-09T04:12:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10538","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10538","identifiers":[{"identifier":"2509.10538","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rumeng","familyName":"Li","name":"Li, Rumeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xun","familyName":"Wang","name":"Wang, Xun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Yu","name":"Yu, Hong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DualAlign: Generating Clinically Grounded Synthetic Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-05T18:04:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:01:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthetic clinical data are increasingly important for advancing AI in healthcare, given strict privacy constraints on real-world EHRs, limited availability of annotated rare-condition data, and systemic biases in observational datasets. While large language models (LLMs) can generate fluent clinical text, producing synthetic data that is both realistic and clinically meaningful remains challenging. We introduce DualAlign, a framework that enhances statistical fidelity and clinical plausibility through dual alignment: (1) statistical alignment, which conditions generation on patient demographics and risk factors; and (2) semantic alignment, which incorporates real-world symptom trajectories to guide content generation. Using Alzheimer's disease (AD) as a case study, DualAlign produces context-grounded symptom-level sentences that better reflect real-world clinical documentation. Fine-tuning an LLaMA 3.1-8B model with a combination of DualAlign-generated and human-annotated data yields substantial performance gains over models trained on gold data alone or unguided synthetic baselines. While DualAlign does not fully capture longitudinal complexity, it offers a practical approach for generating clinically grounded, privacy-preserving synthetic data to support low-resource clinical text analysis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10538","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:41:37Z","registered":"2025-09-16T02:41:38Z","published":null,"updated":"2025-09-16T02:41:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10540","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10540","identifiers":[{"identifier":"2509.10540","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pavan","familyName":"Reddy","name":"Reddy, Pavan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya Sanjay","familyName":"Gujral","name":"Gujral, Aditya Sanjay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EchoLeak: The First Real-World Zero-Click Prompt Injection Exploit in a Production LLM System"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-06T04:06:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:02:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language model (LLM) assistants are increasingly integrated into enterprise workflows, raising new security concerns as they bridge internal and external data sources. This paper presents an in-depth case study of EchoLeak (CVE-2025-32711), a zero-click prompt injection vulnerability in Microsoft 365 Copilot that enabled remote, unauthenticated data exfiltration via a single crafted email. By chaining multiple bypasses-evading Microsofts XPIA (Cross Prompt Injection Attempt) classifier, circumventing link redaction with reference-style Markdown, exploiting auto-fetched images, and abusing a Microsoft Teams proxy allowed by the content security policy-EchoLeak achieved full privilege escalation across LLM trust boundaries without user interaction. We analyze why existing defenses failed, and outline a set of engineering mitigations including prompt partitioning, enhanced input/output filtering, provenance-based access control, and strict content security policies. Beyond the specific exploit, we derive generalizable lessons for building secure AI copilots, emphasizing the principle of least privilege, defense-in-depth architectures, and continuous adversarial testing. Our findings establish prompt injection as a practical, high-severity vulnerability class in production AI systems and provide a blueprint for defending against future AI-native threats."},{"descriptionType":"Other","description":"8 pages content, 1 page references, 2 figures, Published at AAAI Fall Symposium Series 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10540","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:41:40Z","registered":"2025-09-16T02:41:40Z","published":null,"updated":"2025-09-16T02:41:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10554","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10554","identifiers":[{"identifier":"2509.10554","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Xing","name":"Xing, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Irmak","familyName":"Karaca","name":"Karaca, Irmak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir","familyName":"Akhavanrezayat","name":"Akhavanrezayat, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samira","familyName":"Badrloo","name":"Badrloo, Samira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quan Dong","familyName":"Nguyen","name":"Nguyen, Quan Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahadevan","familyName":"Subramaniam","name":"Subramaniam, Mahadevan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MAE-SAM2: Mask Autoencoder-Enhanced SAM2 for Clinical Retinal Vascular Leakage Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Tissues and Organs (q-bio.TO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T20:29:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:02:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-20T20:57:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-23T00:39:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-25T19:24:23Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-29T00:04:13Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09-29T01:48:00Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-09-30T01:27:11Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10-10T15:39:58Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-04-09T00:06:29Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose MAE-SAM2, a novel foundation model for retinal vascular leakage segmentation on fluorescein angiography images. Due to the small size and dense distribution of the leakage areas, along with the limited availability of labeled clinical data, this presents a significant challenge for segmentation tasks. Our approach integrates a Self-Supervised learning (SSL) strategy, Masked Autoencoder (MAE), with SAM2. In our implementation, we explore different loss functions and conclude a task-specific combined loss. Extensive experiments and ablation studies demonstrate that MAE-SAM2 outperforms several state-of-the-art models, achieving the highest Dice score and Intersection-over-Union (IoU). Compared to the original SAM2, our model achieves a $5\\%$ performance improvement, highlighting the promise of foundation models with self-supervised pretraining in clinical imaging tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10554","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:42:00Z","registered":"2025-09-16T02:42:00Z","published":null,"updated":"2026-04-09T02:18:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10555","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10555","identifiers":[{"identifier":"2509.10555","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alejandra","familyName":"Perez","name":"Perez, Alejandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chinedu","familyName":"Nwoye","name":"Nwoye, Chinedu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ramtin Raji","familyName":"Kermani","name":"Kermani, Ramtin Raji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omid","familyName":"Mohareri","name":"Mohareri, Omid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad Abdullah","familyName":"Jamal","name":"Jamal, Muhammad Abdullah","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SurgLaVi: Large-Scale Hierarchical Dataset for Surgical Vision-Language Representation Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-09T21:21:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:02:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-05T02:19:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-06T01:16:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language pre-training (VLP) offers unique advantages for surgery by aligning language with surgical videos, enabling workflow understanding and transfer across tasks without relying on expert-labeled datasets. However, progress in surgical VLP remains constrained by the limited scale, procedural diversity, semantic quality, and hierarchical structure of existing datasets. In this work, we present SurgLaVi, the largest and most diverse surgical vision-language dataset to date, comprising nearly 240k clip-caption pairs from more than 200 procedures, and featuring hierarchical levels at coarse-, mid-, and fine-level. At the core of SurgLaVi lies a fully automated pipeline that systematically generates fine-grained transcriptions of surgical videos and segments them into coherent procedural units. To ensure high-quality annotations, it applies dual-modality filtering to remove irrelevant and noisy samples. Within this framework, the resulting captions are enriched with contextual detail, producing annotations that are both semantically rich and easy to interpret. To ensure accessibility, we release SurgLaVi-$\\b{eta}$, an open-source derivative of 113k clip-caption pairs constructed entirely from public data, which is over four times larger than existing surgical VLP datasets. To demonstrate the value of the SurgLaVi datasets, we introduce SurgCLIP, a CLIP-style video-text contrastive framework with dual encoders, as a representative base model. SurgCLIP achieves consistent improvements across phase, step, action, and tool recognition, surpassing prior state-of-the-art methods, often by large margins. These results validate that large-scale, semantically rich, and hierarchically structured datasets directly translate into stronger and more generalizable representations, establishing SurgLaVi as a key resource for developing surgical foundation models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10555","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:42:01Z","registered":"2025-09-16T02:42:02Z","published":null,"updated":"2026-02-06T03:20:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10561","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10561","identifiers":[{"identifier":"2509.10561","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Madhava","familyName":"Gaikwad","name":"Gaikwad, Madhava","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AVEC: Bootstrapping Privacy for Local LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"F.2.2; I.2.7; K.4.1","lang":"en","subjectScheme":"ACM"},{"subject":"68Q25, 68T50, 68P27","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-10T07:59:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:02:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This position paper presents AVEC (Adaptive Verifiable Edge Control), a framework for bootstrapping privacy for local language models by enforcing privacy at the edge with explicit verifiability for delegated queries. AVEC introduces an adaptive budgeting algorithm that allocates per-query differential privacy parameters based on sensitivity, local confidence, and historical usage, and uses verifiable transformation with on-device integrity checks. We formalize guarantees using Rényi differential privacy with odometer-based accounting, and establish utility ceilings, delegation-leakage bounds, and impossibility results for deterministic gating and hash-only certification. Our evaluation is simulation-based by design to study mechanism behavior and accounting; we do not claim deployment readiness or task-level utility with live LLMs. The contribution is a conceptual architecture and theoretical foundation that chart a pathway for empirical follow-up on privately bootstrapping local LLMs."},{"descriptionType":"Other","description":"12 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10561","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:42:09Z","registered":"2025-09-16T02:42:10Z","published":null,"updated":"2025-09-16T02:42:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10584","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10584","identifiers":[{"identifier":"2509.10584","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaofan","familyName":"Zhou","name":"Zhou, Xiaofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zisu","familyName":"Wang","name":"Wang, Zisu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Janice","familyName":"Krieger","name":"Krieger, Janice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohan","familyName":"Zalake","name":"Zalake, Mohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Cheng","name":"Cheng, Lu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Smart Trial: Evaluating the Use of Large Language Models for Recruiting Clinical Trial Participants via Social Media"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T01:34:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:03:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Clinical trials (CT) are essential for advancing medical research and treatment, yet efficiently recruiting eligible participants -- each of whom must meet complex eligibility criteria -- remains a significant challenge. Traditional recruitment approaches, such as advertisements or electronic health record screening within hospitals, are often time-consuming and geographically constrained. This work addresses the recruitment challenge by leveraging the vast amount of health-related information individuals share on social media platforms. With the emergence of powerful large language models (LLMs) capable of sophisticated text understanding, we pose the central research question: Can LLM-driven tools facilitate CT recruitment by identifying potential participants through their engagement on social media? To investigate this question, we introduce TRIALQA, a novel dataset comprising two social media collections from the subreddits on colon cancer and prostate cancer. Using eligibility criteria from public real-world CTs, experienced annotators are hired to annotate TRIALQA to indicate (1) whether a social media user meets a given eligibility criterion and (2) the user's stated reasons for interest in participating in CT. We benchmark seven widely used LLMs on these two prediction tasks, employing six distinct training and inference strategies. Our extensive experiments reveal that, while LLMs show considerable promise, they still face challenges in performing the complex, multi-hop reasoning needed to accurately assess eligibility criteria."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10584","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:42:41Z","registered":"2025-09-16T02:42:42Z","published":null,"updated":"2025-09-16T02:42:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10593","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10593","identifiers":[{"identifier":"2509.10593","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aoife","familyName":"McDonald-Bowyer","name":"McDonald-Bowyer, Aoife","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anjana","familyName":"Wijekoon","name":"Wijekoon, Anjana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan Laurance","familyName":"Love","name":"Love, Ryan Laurance","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Katie","familyName":"Allan","name":"Allan, Katie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Scott","familyName":"Colvin","name":"Colvin, Scott","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aleksandra","familyName":"Gentry-Maharaj","name":"Gentry-Maharaj, Aleksandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adeola","familyName":"Olaitan","name":"Olaitan, Adeola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danail","familyName":"Stoyanov","name":"Stoyanov, Danail","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Agostino","familyName":"Stilli","name":"Stilli, Agostino","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sophia","familyName":"Bano","name":"Bano, Sophia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automated Cervical Os Segmentation for Camera-Guided, Speculum-Free Screening"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T14:19:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:03:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Cervical cancer is highly preventable, yet persistent barriers to screening limit progress toward elimination goals. Speculum-free devices that integrate imaging and sampling could improve access, particularly in low-resource settings, but require reliable visual guidance. This study evaluates deep learning methods for real-time segmentation of the cervical os in transvaginal endoscopic images. Five encoder-decoder architectures were compared using 913 frames from 200 cases in the IARC Cervical Image Dataset, annotated by gynaecologists. Performance was assessed using IoU, DICE, detection rate, and distance metrics with ten-fold cross-validation. EndoViT/DPT, a vision transformer pre-trained on surgical video, achieved the highest DICE (0.50 \\pm 0.31) and detection rate (0.87 \\pm 0.33), outperforming CNN-based approaches. External validation with phantom data demonstrated robust segmentation under variable conditions at 21.5 FPS, supporting real-time feasibility. These results establish a foundation for integrating automated os recognition into speculum-free cervical screening devices to support non-expert use in both high- and low-resource contexts."},{"descriptionType":"Other","description":"2 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10593","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:42:53Z","registered":"2025-09-16T02:42:54Z","published":null,"updated":"2025-09-16T02:42:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10594","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10594","identifiers":[{"identifier":"2509.10594","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Iqbal H.","familyName":"Sarker","name":"Sarker, Iqbal H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Helge","familyName":"Janicke","name":"Janicke, Helge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmad","familyName":"Mohsin","name":"Mohsin, Ahmad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leandros","familyName":"Maglaras","name":"Maglaras, Leandros","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SME-TEAM: Leveraging Trust and Ethics for Secure and Responsible Use of AI and LLMs in SMEs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T14:59:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:03:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-05T16:07:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-06T01:52:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Artificial Intelligence (AI) and Large Language Models (LLMs) are revolutionizing today's business practices; however, their adoption within small and medium-sized enterprises (SMEs) raises serious trust, ethical, and technical issues. In this perspective paper, we introduce a structured, multi-phased framework, \"SME-TEAM\" for the secure and responsible use of these technologies in SMEs. Based on a conceptual structure of four key pillars, i.e., Data, Algorithms, Human Oversight, and Model Architecture, SME-TEAM bridges theoretical ethical principles with operational practice, enhancing AI capabilities across a wide range of applications in SMEs. Ultimately, this paper provides a structured roadmap for the adoption of these emerging technologies, positioning trust and ethics as a driving force for resilience, competitiveness, and sustainable innovation within the area of business analytics and SMEs."},{"descriptionType":"Other","description":"12 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10594","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:42:54Z","registered":"2025-09-16T02:42:55Z","published":null,"updated":"2025-11-06T03:15:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10620","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10620","identifiers":[{"identifier":"2509.10620","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emily","familyName":"Kaczmarek","name":"Kaczmarek, Emily","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Justin","familyName":"Szeto","name":"Szeto, Justin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brennan","familyName":"Nichyporuk","name":"Nichyporuk, Brennan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tal","familyName":"Arbel","name":"Arbel, Tal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Building a General SimCLR Self-Supervised Foundation Model Across Neurological Diseases to Advance 3D Brain MRI Diagnoses"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T18:05:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:03:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"3D structural Magnetic Resonance Imaging (MRI) brain scans are commonly acquired in clinical settings to monitor a wide range of neurological conditions, including neurodegenerative disorders and stroke. While deep learning models have shown promising results analyzing 3D MRI across a number of brain imaging tasks, most are highly tailored for specific tasks with limited labeled data, and are not able to generalize across tasks and/or populations. The development of self-supervised learning (SSL) has enabled the creation of large medical foundation models that leverage diverse, unlabeled datasets ranging from healthy to diseased data, showing significant success in 2D medical imaging applications. However, even the very few foundation models for 3D brain MRI that have been developed remain limited in resolution, scope, or accessibility. In this work, we present a general, high-resolution SimCLR-based SSL foundation model for 3D brain structural MRI, pre-trained on 18,759 patients (44,958 scans) from 11 publicly available datasets spanning diverse neurological diseases. We compare our model to Masked Autoencoders (MAE), as well as two supervised baselines, on four diverse downstream prediction tasks in both in-distribution and out-of-distribution settings. Our fine-tuned SimCLR model outperforms all other models across all tasks. Notably, our model still achieves superior performance when fine-tuned using only 20% of labeled training samples for predicting Alzheimer's disease. We use publicly available code and data, and release our trained model at https://github.com/emilykaczmarek/3D-Neuro-SimCLR, contributing a broadly applicable and accessible foundation model for clinical brain MRI analysis."},{"descriptionType":"Other","description":"Accepted to ICCV 2025 Workshop CVAMD"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10620","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:43:31Z","registered":"2025-09-16T02:43:32Z","published":null,"updated":"2025-09-16T02:43:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10641","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10641","identifiers":[{"identifier":"2509.10641","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nikita","familyName":"Rajaneesh","name":"Rajaneesh, Nikita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Zollo","name":"Zollo, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Zemel","name":"Zemel, Richard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Test-Time Warmup for Multimodal Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T18:58:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:05:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-06T12:24:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-07T01:39:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Large Language Models (MLLMs) hold great promise for advanced reasoning at the intersection of text and images, yet they have not fully realized this potential. MLLMs typically integrate an LLM, a vision encoder, and a connector that maps the vision encoder's embeddings into the LLM's text embedding space. Although each component is pretrained on massive datasets with billions of samples, the entire multimodal model is typically trained on only thousands (or a few million) samples, which can result in weak performance on complex reasoning tasks. To address these shortcomings, instead of relying on extensive labeled datasets for fine-tuning, we propose a Test-Time Warmup method that adapts the MLLM per test instance by leveraging data from weakly supervised auxiliary tasks. With our approach, we observe a relative performance improvement of 4.03% on MMMU, 5.28% on VQA-Rad, and 1.63% on GQA on the Llama-Vision-Instruct model. Our method demonstrates that 'warming up' before inference can enhance MLLMs' robustness across diverse reasoning tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10641","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:44:00Z","registered":"2025-09-16T02:44:01Z","published":null,"updated":"2025-11-07T03:05:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10647","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10647","identifiers":[{"identifier":"2509.10647","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Victor-Alexandru","familyName":"Pădurean","name":"Pădurean, Victor-Alexandru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tung","familyName":"Phung","name":"Phung, Tung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nachiket","familyName":"Kotalwar","name":"Kotalwar, Nachiket","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Liut","name":"Liut, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juho","familyName":"Leinonen","name":"Leinonen, Juho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Denny","name":"Denny, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adish","familyName":"Singla","name":"Singla, Adish","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Humanizing Automated Programming Feedback: Fine-Tuning Generative Models with Student-Written Feedback"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T19:23:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:06:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The growing need for automated and personalized feedback in programming education has led to recent interest in leveraging generative AI for feedback generation. However, current approaches tend to rely on prompt engineering techniques in which predefined prompts guide the AI to generate feedback. This can result in rigid and constrained responses that fail to accommodate the diverse needs of students and do not reflect the style of human-written feedback from tutors or peers. In this study, we explore learnersourcing as a means to fine-tune language models for generating feedback that is more similar to that written by humans, particularly peer students. Specifically, we asked students to act in the flipped role of a tutor and write feedback on programs containing bugs. We collected approximately 1,900 instances of student-written feedback on multiple programming problems and buggy programs. To establish a baseline for comparison, we analyzed a sample of 300 instances based on correctness, length, and how the bugs are described. Using this data, we fine-tuned open-access generative models, specifically Llama3 and Phi3. Our findings indicate that fine-tuning models on learnersourced data not only produces feedback that better matches the style of feedback written by students, but also improves accuracy compared to feedback generated through prompt engineering alone, even though some student-written feedback is incorrect. This surprising finding highlights the potential of student-centered fine-tuning to improve automated feedback systems in programming education."},{"descriptionType":"Other","description":"Published in International Conference on Educational Data Mining (EDM) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10647","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:44:09Z","registered":"2025-09-16T02:44:09Z","published":null,"updated":"2025-09-16T02:44:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10682","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10682","identifiers":[{"identifier":"2509.10682","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Vitor Hugo Galhardo","familyName":"Moia","name":"Moia, Vitor Hugo Galhardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Igor Jochem","familyName":"Sanz","name":"Sanz, Igor Jochem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriel Antonio Fontes","familyName":"Rebello","name":"Rebello, Gabriel Antonio Fontes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rodrigo Duarte","familyName":"de Meneses","name":"de Meneses, Rodrigo Duarte","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Briland","familyName":"Hitaj","name":"Hitaj, Briland","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ulf","familyName":"Lindqvist","name":"Lindqvist, Ulf","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM in the Middle: A Systematic Review of Threats and Mitigations to Real-World LLM-based Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T20:26:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:08:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The success and wide adoption of generative AI (GenAI), particularly large language models (LLMs), has attracted the attention of cybercriminals seeking to abuse models, steal sensitive data, or disrupt services. Moreover, providing security to LLM-based systems is a great challenge, as both traditional threats to software applications and threats targeting LLMs and their integration must be mitigated. In this survey, we shed light on security and privacy concerns of such LLM-based systems by performing a systematic review and comprehensive categorization of threats and defensive strategies considering the entire software and LLM life cycles. We analyze real-world scenarios with distinct characteristics of LLM usage, spanning from development to operation. In addition, threats are classified according to their severity level and to which scenarios they pertain, facilitating the identification of the most relevant threats. Recommended defense strategies are systematically categorized and mapped to the corresponding life cycle phase and possible attack strategies they attenuate. This work paves the way for consumers and vendors to understand and efficiently mitigate risks during integration of LLMs in their respective solutions or organizations. It also enables the research community to benefit from the discussion of open challenges and edge cases that may hinder the secure and privacy-preserving adoption of LLM-based systems."},{"descriptionType":"Other","description":"37 pages, 8 figures, 13 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10682","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:44:57Z","registered":"2025-09-16T02:44:58Z","published":null,"updated":"2025-09-16T02:44:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10683","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10683","identifiers":[{"identifier":"2509.10683","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Felicia","familyName":"Liu","name":"Liu, Felicia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jay J.","familyName":"Yoo","name":"Yoo, Jay J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farzad","familyName":"Khalvati","name":"Khalvati, Farzad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Comparison and Evaluation of Fine-tuned Convolutional Neural Networks to Large Language Models for Image Classification and Segmentation of Brain Tumors on MRI"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T20:26:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:08:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have shown strong performance in text-based healthcare tasks. However, their utility in image-based applications remains unexplored. We investigate the effectiveness of LLMs for medical imaging tasks, specifically glioma classification and segmentation, and compare their performance to that of traditional convolutional neural networks (CNNs). Using the BraTS 2020 dataset of multi-modal brain MRIs, we evaluated a general-purpose vision-language LLM (LLaMA 3.2 Instruct) both before and after fine-tuning, and benchmarked its performance against custom 3D CNNs. For glioma classification (Low-Grade vs. High-Grade), the CNN achieved 80% accuracy and balanced precision and recall. The general LLM reached 76% accuracy but suffered from a specificity of only 18%, often misclassifying Low-Grade tumors. Fine-tuning improved specificity to 55%, but overall performance declined (e.g., accuracy dropped to 72%). For segmentation, three methods - center point, bounding box, and polygon extraction, were implemented. CNNs accurately localized gliomas, though small tumors were sometimes missed. In contrast, LLMs consistently clustered predictions near the image center, with no distinction of glioma size, location, or placement. Fine-tuning improved output formatting but failed to meaningfully enhance spatial accuracy. The bounding polygon method yielded random, unstructured outputs. Overall, CNNs outperformed LLMs in both tasks. LLMs showed limited spatial understanding and minimal improvement from fine-tuning, indicating that, in their current form, they are not well-suited for image-based tasks. More rigorous fine-tuning or alternative training strategies may be needed for LLMs to achieve better performance, robustness, and utility in the medical space."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10683","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:44:59Z","registered":"2025-09-16T02:44:59Z","published":null,"updated":"2025-09-16T02:44:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10691","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10691","identifiers":[{"identifier":"2509.10691","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fardin Jalil","familyName":"Piran","name":"Piran, Fardin Jalil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiling","familyName":"Chen","name":"Chen, Zhiling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhang","name":"Zhang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianyu","familyName":"Zhou","name":"Zhou, Qianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiong","familyName":"Tang","name":"Tang, Jiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farhad","familyName":"Imani","name":"Imani, Farhad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Privacy-Preserving Decentralized Federated Learning via Explainable Adaptive Differential Privacy"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T20:52:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:09:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-06T18:31:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-09T01:35:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-16T06:49:00Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-18T00:48:04Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Decentralized federated learning enables collaborative model training without a central server, but shared model updates can still leak sensitive information through inversion, reconstruction, and membership inference attacks. Differential privacy offers formal protection, yet existing decentralized methods operate without visibility into the noise already injected by previous participants. Each client therefore adds a full, worst-case perturbation at every step, and the accumulated noise degrades accuracy well below what the privacy requirement actually demands. We present PrivateDFL, a decentralized and privacy-preserving framework that pairs hyperdimensional computing with a transparent noise accountant. The accountant tracks the cumulative perturbation present in the shared model and lets each client add only the minimal incremental noise needed to satisfy its privacy budget. We prove that every transmitted model satisfies the target privacy guarantee, and that under this accounting the cumulative noise grows only logarithmically in the number of clients and rounds, rather than the far faster super-linear growth incurred without accounting. This yields a substantially tighter balance between privacy and accuracy than prior approaches. Across image, speech, and wearable-sensor benchmarks, and under both identically and non-identically distributed data, PrivateDFL surpasses centrally trained Transformer-based and deep neural network baselines, improving accuracy by 16 percent on images, 62 percent on speech, and 14 percent on wearable sensing over the strongest baseline in each case, while reducing inference latency by up to 119 times and energy consumption by up to 143 times. These properties make PrivateDFL a practical solution for privacy-preserving collaborative learning in settings where sensitive data cannot be centralized, such as healthcare and human-activity monitoring."},{"descriptionType":"Other","description":"19 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10691","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:45:10Z","registered":"2025-09-16T02:45:11Z","published":null,"updated":"2026-08-18T03:56:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10695","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10695","identifiers":[{"identifier":"2509.10695","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoming","familyName":"Jing","name":"Jing, Haoming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oren","familyName":"Wright","name":"Wright, Oren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"José M. F.","familyName":"Moura","name":"Moura, José M. F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yorie","familyName":"Nakahira","name":"Nakahira, Yorie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kalman Bayesian Transformer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T21:15:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:09:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Sequential fine-tuning of transformers is useful when new data arrive sequentially, especially with shifting distributions. Unlike batch learning, sequential learning demands that training be stabilized despite a small amount of data by balancing new information and previously learned knowledge in the pre-trained models. This challenge is further complicated when training is to be completed in latency-critical environments and learning must additionally quantify and be mediated by uncertainty. Motivated by these challenges, we propose a novel method that frames sequential fine-tuning as a posterior inference problem within a Bayesian framework. Our approach integrates closed-form moment propagation of random variables, Kalman Bayesian Neural Networks, and Taylor approximations of the moments of softmax functions. By explicitly accounting for pre-trained models as priors and adaptively balancing them against new information based on quantified uncertainty, our method achieves robust and data-efficient sequential learning. The effectiveness of our method is demonstrated through numerical simulations involving sequential adaptation of a decision transformer to tasks characterized by distribution shifts and limited memory resources."},{"descriptionType":"Other","description":"Accepted to the 64th IEEE Conference on Decision and Control (CDC 2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10695","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:45:16Z","registered":"2025-09-16T02:45:17Z","published":null,"updated":"2025-09-16T02:45:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10698","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10698","identifiers":[{"identifier":"2509.10698","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rabeya Tus","familyName":"Sadia","name":"Sadia, Rabeya Tus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Cheng","name":"Cheng, Qiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CrunchLLM: Multitask LLMs for Structured Business Reasoning and Outcome Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T21:26:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:09:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-11T21:54:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:47:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Predicting the success of start-up companies, defined as achieving an exit through acquisition or IPO, is a critical problem in entrepreneurship and innovation research. Datasets such as Crunchbase provide both structured information (e.g., funding rounds, industries, investor networks) and unstructured text (e.g., company descriptions), but effectively leveraging this heterogeneous data for prediction remains challenging. Traditional machine learning approaches often rely only on structured features and achieve moderate accuracy, while large language models (LLMs) offer rich reasoning abilities but struggle to adapt directly to domain-specific business data. We present \\textbf{CrunchLLM}, a domain-adapted LLM framework for startup success prediction. CrunchLLM integrates structured company attributes with unstructured textual narratives and applies parameter-efficient fine-tuning strategies alongside prompt optimization to specialize foundation models for entrepreneurship data. Our approach achieves accuracy exceeding 80\\% on Crunchbase startup success prediction, significantly outperforming traditional classifiers and baseline LLMs. Beyond predictive performance, CrunchLLM provides interpretable reasoning traces that justify its predictions, enhancing transparency and trustworthiness for financial and policy decision makers. This work demonstrates how adapting LLMs with domain-aware fine-tuning and structured--unstructured data fusion can advance predictive modeling of entrepreneurial outcomes. CrunchLLM contributes a methodological framework and a practical tool for data-driven decision making in venture capital and innovation policy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10698","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:45:20Z","registered":"2025-09-16T02:45:21Z","published":null,"updated":"2025-10-14T04:20:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10708","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10708","identifiers":[{"identifier":"2509.10708","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Iman","familyName":"Barati","name":"Barati, Iman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mostafa","familyName":"Amiri","name":"Amiri, Mostafa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heshaam","familyName":"Faili","name":"Faili, Heshaam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SearchInstruct: Enhancing Domain Adaptation via Retrieval-Based Instruction Dataset Creation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T21:50:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:10:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Supervised Fine-Tuning (SFT) is essential for training large language models (LLMs), significantly enhancing critical capabilities such as instruction following and in-context learning. Nevertheless, creating suitable training datasets tailored for specific domains remains challenging due to unique domain constraints and data scarcity. In this paper, we propose SearchInstruct, an innovative method explicitly designed to construct high quality instruction datasets for SFT. Our approach begins with a limited set of domain specific, human generated questions, which are systematically expanded using a large language model. Subsequently, domain relevant resources are dynamically retrieved to generate accurate and contextually appropriate answers for each augmented question. Experimental evaluation demonstrates that SearchInstruct enhances both the diversity and quality of SFT datasets, leading to measurable improvements in LLM performance within specialized domains. Additionally, we show that beyond dataset generation, the proposed method can also effectively facilitate tasks such as model editing, enabling efficient updates to existing models. To facilitate reproducibility and community adoption, we provide full implementation details, the complete set of generated instruction response pairs, and the source code in a publicly accessible Git repository: [https://github.com/mostafaamiri/SearchInstruct](https://github.com/mostafaamiri/SearchInstruct)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10708","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:45:35Z","registered":"2025-09-16T02:45:35Z","published":null,"updated":"2025-09-16T02:45:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10729","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10729","identifiers":[{"identifier":"2509.10729","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ilker","familyName":"Demirel","name":"Demirel, Ilker","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karan","familyName":"Thakkar","name":"Thakkar, Karan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Elizalde","name":"Elizalde, Benjamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miquel Espi","familyName":"Marques","name":"Marques, Miquel Espi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya","familyName":"Sarathy","name":"Sarathy, Aditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Bai","name":"Bai, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Umamahesh","familyName":"Srinivas","name":"Srinivas, Umamahesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajie","familyName":"Xu","name":"Xu, Jiajie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shirley","familyName":"Ren","name":"Ren, Shirley","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaya","familyName":"Narain","name":"Narain, Jaya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Using LLMs for Late Multimodal Sensor Fusion for Activity Recognition"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T22:36:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:11:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-23T01:46:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-25T01:44:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-19T23:51:13Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-23T01:10:16Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Sensor data streams provide valuable information around activities and context for downstream applications, though integrating complementary information can be challenging. We show that large language models (LLMs) can be used for late fusion for activity classification from audio and motion time series data. We curated a subset of data for diverse activity recognition across contexts (e.g., household activities, sports) from the Ego4D dataset. Evaluated LLMs achieved 12-class zero- and one-shot classification F1-scores significantly above chance, with no task-specific training. Zero-shot classification via LLM-based fusion from modality-specific models can enable multimodal temporal applications where there is limited aligned training data for learning a shared embedding space. Additionally, LLM-based fusion can enable model deploying without requiring additional memory and computation for targeted application-specific multimodal models."},{"descriptionType":"Other","description":"NeurIPS Workshop on Learning from Time Series for Health"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10729","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:46:04Z","registered":"2025-09-16T02:46:05Z","published":null,"updated":"2025-12-23T04:23:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10737","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10737","identifiers":[{"identifier":"2509.10737","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zaur","familyName":"Gouliev","name":"Gouliev, Zaur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jennifer","familyName":"Waters","name":"Waters, Jennifer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengqian","familyName":"Wang","name":"Wang, Chengqian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PolyTruth: Multilingual Disinformation Detection using Transformer-Based Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; H.3.3","lang":"en","subjectScheme":"ACM"},{"subject":"68T50, 68T07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-12T22:53:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-12T01:57:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/978-3-032-19108-3_27","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Disinformation spreads rapidly across linguistic boundaries, yet most AI models are still benchmarked only on English. We address this gap with a systematic comparison of five multilingual transformer models: mBERT, XLM, XLM-RoBERTa, RemBERT, and mT5 on a common fake-vs-true machine learning classification task. While transformer-based language models have demonstrated notable success in detecting disinformation in English, their effectiveness in multilingual contexts still remains up for debate. To facilitate evaluation, we introduce PolyTruth Disinfo Corpus, a novel corpus of 60,486 statement pairs (false claim vs. factual correction) spanning over twenty five languages that collectively cover five language families and a broad topical range from politics, health, climate, finance, and conspiracy, half of which are fact-checked disinformation claims verified by an augmented MindBugs Discovery dataset. Our experiments revealed performance variations. Models such as RemBERT achieved better overall accuracy, particularly excelling in low-resource languages, whereas models like mBERT and XLM exhibit considerable limitations when training data is scarce. We provide a discussion of these performance patterns and implications for real-world deployment. The dataset is publicly available on our GitHub repository to encourage further experimentation and advancement. Our findings illuminate both the potential and the current limitations of AI systems for multilingual disinformation detection."},{"descriptionType":"Other","description":"11 pages, 5 figures, 4 tables. Submitted to arXiv in Computation and Language"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10737","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T02:46:16Z","registered":"2025-09-16T02:46:16Z","published":null,"updated":"2026-05-12T05:02:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10753","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10753","identifiers":[{"identifier":"2509.10753","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minh","familyName":"Vu","name":"Vu, Minh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brian K.","familyName":"Tran","name":"Tran, Brian K.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Syed A.","familyName":"Shah","name":"Shah, Syed A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Geigh","familyName":"Zollicoffer","name":"Zollicoffer, Geigh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nhat","familyName":"Hoang-Xuan","name":"Hoang-Xuan, Nhat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manish","familyName":"Bhattarai","name":"Bhattarai, Manish","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HalluField: Detecting LLM Hallucinations via Field-Theoretic Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T23:49:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:12:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) exhibit impressive reasoning and question-answering capabilities. However, they often produce inaccurate or unreliable content known as hallucinations. This unreliability significantly limits their deployment in high-stakes applications. Thus, there is a growing need for a general-purpose method to detect hallucinations in LLMs. In this work, we introduce HalluField, a novel field-theoretic approach for hallucination detection based on a parametrized variational principle and thermodynamics. Inspired by thermodynamics, HalluField models an LLM's response to a given query and temperature setting as a collection of discrete likelihood token paths, each associated with a corresponding energy and entropy. By analyzing how energy and entropy distributions vary across token paths under changes in temperature and likelihood, HalluField quantifies the semantic stability of a response. Hallucinations are then detected by identifying unstable or erratic behavior in this energy landscape. HalluField is computationally efficient and highly practical: it operates directly on the model's output logits without requiring fine-tuning or auxiliary neural networks. Notably, the method is grounded in a principled physical interpretation, drawing analogies to the first law of thermodynamics. Remarkably, by modeling LLM behavior through this physical lens, HalluField achieves state-of-the-art hallucination detection performance across models and datasets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10753","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:46:38Z","registered":"2025-09-16T02:46:39Z","published":null,"updated":"2025-09-16T02:46:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10765","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10765","identifiers":[{"identifier":"2509.10765","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Owen","familyName":"Mayer","name":"Mayer, Owen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shohei","familyName":"Noguchi","name":"Noguchi, Shohei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Berestov","name":"Berestov, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiro","familyName":"Takatori","name":"Takatori, Jiro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Language-based Color ISP Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T00:37:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:13:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a method for tuning the parameters of a color adjustment Image Signal Processor (ISP) algorithmic \"block\" using language prompts. This enables the user to impart a particular visual style to the ISP-processed image simply by describing it through a text prompt. To do this, we first implement the ISP block in a differentiable manner. Then, we define an objective function using an off-the-shelf, pretrained vision-language model (VLM) such that the objective is minimized when the ISP processed image is most visually similar to the input language prompt. Finally, we optimize the ISP parameters using gradient descent. Experimental results demonstrate tuning of ISP parameters with different language prompts, and compare the performance of different pretrained VLMs and optimization strategies."},{"descriptionType":"Other","description":"Accepted to Color and Imaging Conference (CIC) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10765","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:46:55Z","registered":"2025-09-16T02:46:55Z","published":null,"updated":"2025-09-16T02:46:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10769","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10769","identifiers":[{"identifier":"2509.10769","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tara","familyName":"Bogavelli","name":"Bogavelli, Tara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roshnee","familyName":"Sharma","name":"Sharma, Roshnee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hari","familyName":"Subramani","name":"Subramani, Hari","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AgentArch: A Comprehensive Benchmark to Evaluate Agent Architectures in Enterprise"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T01:18:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:13:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-06T18:18:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-07T01:56:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While individual components of agentic architectures have been studied in isolation, there remains limited empirical understanding of how different design dimensions interact within complex multi-agent systems. This study aims to address these gaps by providing a comprehensive enterprise-specific benchmark evaluating 18 distinct agentic configurations across state-of-the-art large language models. We examine four critical agentic system dimensions: orchestration strategy, agent prompt implementation (ReAct versus function calling), memory architecture, and thinking tool integration. Our benchmark reveals significant model-specific architectural preferences that challenge the prevalent one-size-fits-all paradigm in agentic AI systems. It also reveals significant weaknesses in overall agentic performance on enterprise tasks with the highest scoring models achieving a maximum of only 35.3\\% success on the more complex task and 70.8\\% on the simpler task. We hope these findings inform the design of future agentic systems by enabling more empirically backed decisions regarding architectural components and model selection."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10769","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:47:01Z","registered":"2025-09-16T02:47:02Z","published":null,"updated":"2026-01-07T02:59:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10781","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10781","identifiers":[{"identifier":"2509.10781","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaokang","familyName":"Li","name":"Li, Xiaokang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yicheng","familyName":"Gong","name":"Gong, Yicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dinghao","familyName":"Zou","name":"Zou, Dinghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Cao","name":"Cao, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunbowen","familyName":"Lee","name":"Lee, Sunbowen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Emoanti: audio anti-deepfake with refined emotion-guided representations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T01:58:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:14:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Audio deepfake is so sophisticated that the lack of effective detection methods is fatal. While most detection systems primarily rely on low-level acoustic features or pretrained speech representations, they frequently neglect high-level emotional cues, which can offer complementary and potentially anti-deepfake information to enhance generalization. In this work, we propose a novel audio anti-deepfake system that utilizes emotional features (EmoAnti) by exploiting a pretrained Wav2Vec2 (W2V2) model fine-tuned on emotion recognition tasks, which derives emotion-guided representations, then designing a dedicated feature extractor based on convolutional layers with residual connections to effectively capture and refine emotional characteristics from the transformer layers outputs. Experimental results show that our proposed architecture achieves state-of-the-art performance on both the ASVspoof2019LA and ASVspoof2021LA benchmarks, and demonstrates strong generalization on the ASVspoof2021DF dataset. Our proposed approach's code is available at Anonymous GitHub1."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10781","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:47:17Z","registered":"2025-09-16T02:47:18Z","published":null,"updated":"2025-09-16T02:47:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10784","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10784","identifiers":[{"identifier":"2509.10784","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jin","familyName":"Yang","name":"Yang, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel S.","familyName":"Marcus","name":"Marcus, Daniel S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aristeidis","familyName":"Sotiras","name":"Sotiras, Aristeidis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adapting Medical Vision Foundation Models for Volumetric Medical Image Segmentation via Active Learning and Selective Semi-supervised Fine-tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T02:05:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:14:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-21T13:56:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-22T00:55:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-06T03:44:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-05-07T00:21:22Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Medical vision foundation models remain limited in downstream tasks, particularly volumetric medical image segmentation. While fine-tuning on labeled target-domain data improves performance, existing approaches typically rely on randomly selected samples, which may fail to identify the most informative data and thus hinder adaptation. To address the limitations, we propose an Active Selective Semi-supervised Fine-tuning framework for efficient adaptation of Med-VFMs to generalize across volumetric medical image segmentation. ASSFT integrates a novel active learning strategy with selective semi-supervised learning to maximize adaptation performance under a limited annotation budget, without requiring access to source data. Specifically, we introduce an Active Test-Time Sample Query strategy that identifies informative samples from the target domain using two complementary query metrics: Diversified Knowledge Divergence and Anatomical Segmentation Difficulty. DKD quantifies both the knowledge gap between pre-training and target domains and the semantic diversity within the target dataset, enabling the selection of samples that contain previously unlearned knowledge while maintaining intra-domain diversity. ASD estimates the segmentation difficulty of target anatomical structures by measuring predictive uncertainty within foreground regions of interest, allowing the model to prioritize samples with complex anatomical patterns rather than those dominated by background uncertainty. Second, we propose a Selective Semi-supervised Fine-tuning strategy to further improve adaptation performance by leveraging unlabeled target samples. Instead of utilizing all pseudo-labeled data, the proposed method selectively incorporates reliable unlabeled samples based on predictive confidence and semantic distance to labeled samples, enabling stable semi-supervised training while avoiding noisy pseudo-labels."},{"descriptionType":"Other","description":"19 pages, 6 figures, 8 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10784","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:47:21Z","registered":"2025-09-16T02:47:22Z","published":null,"updated":"2026-05-07T02:18:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10790","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10790","identifiers":[{"identifier":"2509.10790","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luke","familyName":"Howard","name":"Howard, Luke","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GoldenTransformer: A Modular Fault Injection Framework for Transformer Robustness Research"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T02:52:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:15:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformers have become the foundation for a wide range of state--of--the--art models across natural language processing, computer vision, and other machine learning domains. Despite their widespread deployment, the robustness of these models under fault conditions remains underexplored. We present GoldenTransformer, a modular and extensible fault injection framework designed to evaluate the resiliency of Large Language Models to induced hardware faults. GoldenTransformer offers a unified Python-based platform for injecting diverse classes of faults--such as weight corruption, activation injections, and attention--level disruptions--into pretrained transformer--based models. Inspired by the GoldenEye simulator for DNNs, our framework focuses on the unique challenges of working with large transformer architectures, including considerations such as structural complexity, latent dependencies, and nonuniform layer definitions. GoldenTransformer is built atop PyTorch and HuggingFace Transformers, and it supports experiment reproducibility, metric logging, and visualization out of the box. We detail the technical design and use of GoldenTransformer and demonstrate through several example experiments on classification and generation tasks. By enabling controlled injection of faults at multiple logical and structural points in a transformer, GoldenTransformer offers researchers and practitioners a valuable tool for model robustness analysis and for guiding dependable system design in real-world LLM applications."},{"descriptionType":"Other","description":"4 Pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10790","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:47:29Z","registered":"2025-09-16T02:47:30Z","published":null,"updated":"2025-09-16T02:47:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10798","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10798","identifiers":[{"identifier":"2509.10798","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yijun","familyName":"Liu","name":"Liu, Yijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixuan","familyName":"Wang","name":"Wang, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuzhuang","familyName":"Xu","name":"Xu, Yuzhuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiyu","familyName":"Ji","name":"Ji, Shiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Xu","name":"Xu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingfu","familyName":"Zhu","name":"Zhu, Qingfu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanxiang","familyName":"Che","name":"Che, Wanxiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Judge Q: Trainable Queries for Optimized Information Retention in KV Cache Eviction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T03:34:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:16:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-15T09:11:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-16T01:31:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) utilize key-value (KV) cache to store historical information during sequence processing. The size of KV cache grows linearly as the length of the sequence extends, which seriously affects memory usage and decoding efficiency. Current methods for KV cache eviction typically utilize the last window from the pre-filling phase as queries to compute the KV importance scores for eviction. Although this scheme is simple to implement, it tends to overly focus on local information, potentially leading to the neglect or omission of crucial global information. To mitigate this issue, we propose Judge Q, a novel training method which incorporates a soft token list. This method only tunes the model's embedding layer at a low training cost. By concatenating the soft token list at the end of the input sequence, we train these tokens' attention map to the original input sequence to align with that of the actual decoded tokens. In this way, the queries corresponding to the soft tokens can effectively capture global information and better evaluate the importance of the keys and values within the KV cache, thus maintaining decoding quality when KV cache is evicted. Under the same eviction budget, our method exhibits less performance degradation compared to existing eviction approaches. We validate our approach through experiments conducted on models such as Llama-3.1-8B-Instruct and Mistral-7B-Instruct-v0.3, using benchmarks including LongBench, RULER, and Needle-in-a-Haystack. Results indicate an improvement of approximately 1 point on the LongBench and over 3 points on RULER. This proposed methodology can be seamlessly integrated into existing open-source models with minimal training overhead, thereby enhancing performance in KV cache eviction scenarios."},{"descriptionType":"Other","description":"Accepted in AAAI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10798","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:47:41Z","registered":"2025-09-16T02:47:41Z","published":null,"updated":"2026-01-16T03:10:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10860","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10860","identifiers":[{"identifier":"2509.10860","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shaohua","familyName":"Fang","name":"Fang, Shaohua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Li","name":"Li, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Cong","name":"Cong, Yan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Quantifier Scope Interpretation in Language Learners and LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T15:32:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:20:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Sentences with multiple quantifiers often lead to interpretive ambiguities, which can vary across languages. This study adopts a cross-linguistic approach to examine how large language models (LLMs) handle quantifier scope interpretation in English and Chinese, using probabilities to assess interpretive likelihood. Human similarity (HS) scores were used to quantify the extent to which LLMs emulate human performance across language groups. Results reveal that most LLMs prefer the surface scope interpretations, aligning with human tendencies, while only some differentiate between English and Chinese in the inverse scope preferences, reflecting human-similar patterns. HS scores highlight variability in LLMs' approximation of human behavior, but their overall potential to align with humans is notable. Differences in model architecture, scale, and particularly models' pre-training data language background, significantly influence how closely LLMs approximate human quantifier scope interpretations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10860","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:49:09Z","registered":"2025-09-16T02:49:09Z","published":null,"updated":"2025-09-16T02:49:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10875","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10875","identifiers":[{"identifier":"2509.10875","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jesse","familyName":"Gardner","name":"Gardner, Jesse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladimir A.","familyName":"Baulin","name":"Baulin, Vladimir A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Is the `Agent' Paradigm a Limiting Framework for Next-Generation Intelligent Systems?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Soft Condensed Matter (cond-mat.soft)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T16:11:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:21:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The concept of the 'agent' has profoundly shaped Artificial Intelligence (AI) research, guiding development from foundational theories to contemporary applications like Large Language Model (LLM)-based systems. This paper critically re-evaluates the necessity and optimality of this agent-centric paradigm. We argue that its persistent conceptual ambiguities and inherent anthropocentric biases may represent a limiting framework. We distinguish between agentic systems (AI inspired by agency, often semi-autonomous, e.g., LLM-based agents), agential systems (fully autonomous, self-producing systems, currently only biological), and non-agentic systems (tools without the impression of agency). Our analysis, based on a systematic review of relevant literature, deconstructs the agent paradigm across various AI frameworks, highlighting challenges in defining and measuring properties like autonomy and goal-directedness. We argue that the 'agentic' framing of many AI systems, while heuristically useful, can be misleading and may obscure the underlying computational mechanisms, particularly in Large Language Models (LLMs). As an alternative, we propose a shift in focus towards frameworks grounded in system-level dynamics, world modeling, and material intelligence. We conclude that investigating non-agentic and systemic frameworks, inspired by complex systems, biology, and unconventional computing, is essential for advancing towards robust, scalable, and potentially non-anthropomorphic forms of general intelligence. This requires not only new architectures but also a fundamental reconsideration of our understanding of intelligence itself, moving beyond the agent metaphor."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10875","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:49:30Z","registered":"2025-09-16T02:49:30Z","published":null,"updated":"2025-09-16T02:49:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10912","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10912","identifiers":[{"identifier":"2509.10912","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Prasanna. M.","familyName":"Joshi","name":"Joshi, Prasanna. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reinhard","familyName":"Prix","name":"Prix, Reinhard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transformer Networks for Continuous Gravitational-wave Searches"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"General Relativity and Quantum Cosmology (gr-qc)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T17:22:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-01-09T01:21:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-21T08:54:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-22T01:30:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/xgz9-qdkg","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Wide-parameter-space searches for continuous gravitational waves using semi-coherent matched-filter methods require enormous computing power, which limits their achievable sensitivity. Here we explore an alternative search method based on training neural networks as classifiers on detector strain data with minimal pre-processing. Contrary to previous studies using convolutional neural networks (CNNs), we investigate the suitability of the transformer architecture, specifically the Vision Transformer (ViT). We establish sensitivity benchmarks using the matched-filter $\\mathcal{F}$-statistic for ten targeted searches over a ten day timespan, and ten directed and six all-sky searches over a one day timespan. We train ViTs on each of these benchmark cases. The trained ViTs achieve essentially matched-filter sensitivity on the targeted benchmarks, and approach the $\\mathcal{F}$-statistic detection probability of $p_{\\mathrm{det}}$ = 90% on the directed ($p_{\\mathrm{det}} \\approx $ 85-89 %) and all-sky benchmarks ($p_{\\mathrm{det}} \\approx $ 78-88 %). Unlike the CNNs in our previous studies, which required extensive manual design and hyperparameter tuning, the ViT achieves better performance with a standard architecture and minimal tuning."},{"descriptionType":"Other","description":"10 pages, 4 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10912","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T02:50:22Z","registered":"2025-09-16T02:50:23Z","published":null,"updated":"2026-01-22T03:17:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10917","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10917","identifiers":[{"identifier":"2509.10917","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yekta","familyName":"Demirci","name":"Demirci, Yekta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillaume","familyName":"Mantelet","name":"Mantelet, Guillaume","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stéphane","familyName":"Martel","name":"Martel, Stéphane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean-François","familyName":"Frigon","name":"Frigon, Jean-François","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gunes Karabulut","familyName":"Kurt","name":"Kurt, Gunes Karabulut","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Forecasting Self-Similar User Traffic Demand Using Transformers in LEO Satellite Networks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T17:33:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:23:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-09T19:20:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-25T01:53:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/wisee57913.2025.11229871","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we propose the use of a transformer-based model to address the need for forecasting user traffic demand in the next generation Low Earth Orbit (LEO) satellite networks. Considering a LEO satellite constellation, we present the need to forecast the demand for the satellites in-orbit to utilize dynamic beam-hopping in high granularity. We adopt a traffic dataset with second-order self-similar characteristics. Given this traffic dataset, the Fractional Auto-regressive Integrated Moving Average (FARIMA) model is considered a benchmark forecasting solution. However, the constrained on-board processing capabilities of LEO satellites, combined with the need to fit a new model for each input sequence due to the nature of FARIMA, motivate the investigation of alternative solutions. As an alternative, a pretrained probabilistic time series model that utilizes transformers with a Prob-Sparse self-attention mechanism is considered. The considered solution is investigated under different time granularities with varying sequence and prediction lengths. Concluding this paper, we provide extensive simulation results where the transformer-based solution achieved up to six percent better forecasting accuracy on certain traffic conditions using mean squared error as the performance indicator."},{"descriptionType":"Other","description":"6 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10917","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T02:50:29Z","registered":"2025-09-16T02:50:30Z","published":null,"updated":"2025-11-25T04:49:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10918","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10918","identifiers":[{"identifier":"2509.10918","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenbo","familyName":"Lu","name":"Lu, Wenbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoyi","familyName":"Zheng","name":"Zheng, Shaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Xia","name":"Xia, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengjie","familyName":"Wang","name":"Wang, Shengjie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ToMA: Token Merge with Attention for Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T17:35:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:23:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T02:10:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:22:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-30T17:46:06Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-02T01:53:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models excel in high-fidelity image generation but face scalability limits due to transformers' quadratic attention complexity. Plug-and-play token reduction methods like ToMeSD and ToFu reduce FLOPs by merging redundant tokens in generated images but rely on GPU-inefficient operations (e.g., sorting, scattered writes), introducing overheads that negate theoretical speedups when paired with optimized attention implementations (e.g., FlashAttention). To bridge this gap, we propose Token Merge with Attention (ToMA), an off-the-shelf method that redesigns token reduction for GPU-aligned efficiency, with three key contributions: 1) a reformulation of token merge as a submodular optimization problem to select diverse tokens; 2) merge/unmerge as an attention-like linear transformation via GPU-friendly matrix operations; and 3) exploiting latent locality and sequential redundancy (pattern reuse) to minimize overhead. ToMA reduces SDXL/Flux generation latency by 24%/23%, respectively (with DINO $Δ\u0026lt; 0.07$), outperforming prior methods. This work bridges the gap between theoretical and practical efficiency for transformers in diffusion. Code available at https://github.com/WenboLuu/ToMA."},{"descriptionType":"Other","description":"In proceedings of the 42nd International Conference on Machine Learning (ICML 2025). Code available at https://github.com/wenboluu/ToMA"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10918","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:50:31Z","registered":"2025-09-16T02:50:31Z","published":null,"updated":"2025-12-02T04:46:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10919","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10919","identifiers":[{"identifier":"2509.10919","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohanad","familyName":"Albughdadi","name":"Albughdadi, Mohanad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lightweight Metadata-Aware Mixture-of-Experts Masked Autoencoder for Earth Observation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T17:35:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:23:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Earth Observation have focused on large-scale foundation models. However, these models are computationally expensive, limiting their accessibility and reuse for downstream tasks. In this work, we investigate compact architectures as a practical pathway toward smaller general-purpose EO models. We propose a Metadata-aware Mixture-of-Experts Masked Autoencoder (MoE-MAE) with only 2.5M parameters. The model combines sparse expert routing with geo-temporal conditioning, incorporating imagery alongside latitude/longitude and seasonal/daily cyclic encodings. We pretrain the MoE-MAE on the BigEarthNet-Landsat dataset and evaluate embeddings from its frozen encoder using linear probes. Despite its small size, the model competes with much larger architectures, demonstrating that metadata-aware pretraining improves transfer and label efficiency. To further assess generalization, we evaluate on the EuroSAT-Landsat dataset, which lacks explicit metadata, and still observe competitive performance compared to models with hundreds of millions of parameters. These results suggest that compact, metadata-aware MoE-MAEs are an efficient and scalable step toward future EO foundation models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10919","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:50:32Z","registered":"2025-09-16T02:50:33Z","published":null,"updated":"2025-09-16T02:50:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10931","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10931","identifiers":[{"identifier":"2509.10931","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seongho","familyName":"Joo","name":"Joo, Seongho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyukhun","familyName":"Koh","name":"Koh, Hyukhun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyomin","familyName":"Jung","name":"Jung, Kyomin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Harmful Prompt Laundering: Jailbreaking LLMs with Abductive Styles and Symbolic Encoding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T18:07:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:24:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have demonstrated remarkable capabilities across diverse tasks, but their potential misuse for harmful purposes remains a significant concern. To strengthen defenses against such vulnerabilities, it is essential to investigate universal jailbreak attacks that exploit intrinsic weaknesses in the architecture and learning paradigms of LLMs. In response, we propose \\textbf{H}armful \\textbf{P}rompt \\textbf{La}undering (HaPLa), a novel and broadly applicable jailbreaking technique that requires only black-box access to target models. HaPLa incorporates two primary strategies: 1) \\textit{abductive framing}, which instructs LLMs to infer plausible intermediate steps toward harmful activities, rather than directly responding to explicit harmful queries; and 2) \\textit{symbolic encoding}, a lightweight and flexible approach designed to obfuscate harmful content, given that current LLMs remain sensitive primarily to explicit harmful keywords. Experimental results show that HaPLa achieves over 95% attack success rate on GPT-series models and 70% across all targets. Further analysis with diverse symbolic encoding rules also reveals a fundamental challenge: it remains difficult to safely tune LLMs without significantly diminishing their helpfulness in responding to benign queries."},{"descriptionType":"Other","description":"EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10931","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:50:49Z","registered":"2025-09-16T02:50:50Z","published":null,"updated":"2025-09-16T02:50:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10932","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10932","identifiers":[{"identifier":"2509.10932","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seongho","familyName":"Joo","name":"Joo, Seongho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyukhun","familyName":"Koh","name":"Koh, Hyukhun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyomin","familyName":"Jung","name":"Jung, Kyomin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Public Data Assisted Differentially Private In-Context Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T18:11:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:24:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In-context learning (ICL) in Large Language Models (LLMs) has shown remarkable performance across various tasks without requiring fine-tuning. However, recent studies have highlighted the risk of private data leakage through the prompt in ICL, especially when LLMs are exposed to malicious attacks. While differential privacy (DP) provides strong privacy guarantees, it often significantly reduces the utility of in-context learning (ICL). To address this challenge, we incorporate task-related public data into the ICL framework while maintaining the DP guarantee. Based on this approach, we propose a private in-context learning algorithm that effectively balances privacy protection and model utility. Through experiments, we demonstrate that our approach significantly improves the utility of private ICL with the assistance of public data. Additionally, we show that our method is robust against membership inference attacks, demonstrating empirical privacy protection."},{"descriptionType":"Other","description":"EMNLP 2025 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10932","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:50:50Z","registered":"2025-09-16T02:50:51Z","published":null,"updated":"2025-09-16T02:50:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10935","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10935","identifiers":[{"identifier":"2509.10935","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ankan","familyName":"Mullick","name":"Mullick, Ankan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sombit","familyName":"Bose","name":"Bose, Sombit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rounak","familyName":"Saha","name":"Saha, Rounak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ayan Kumar","familyName":"Bhowmick","name":"Bhowmick, Ayan Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya","familyName":"Vempaty","name":"Vempaty, Aditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prasenjit","familyName":"Dey","name":"Dey, Prasenjit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ravi","familyName":"Kokku","name":"Kokku, Ravi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pawan","familyName":"Goyal","name":"Goyal, Pawan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niloy","familyName":"Ganguly","name":"Ganguly, Niloy","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Introducing Spotlight: A Novel Approach for Generating Captivating Key Information from Documents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T18:18:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:24:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T08:23:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T01:40:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-21T14:21:49Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-22T00:56:20Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we introduce Spotlight, a novel paradigm for information extraction that produces concise, engaging narratives by highlighting the most compelling aspects of a document. Unlike traditional summaries, which prioritize comprehensive coverage, spotlights selectively emphasize intriguing content to foster deeper reader engagement with the source material. We formally differentiate spotlights from related constructs and support our analysis with a detailed benchmarking study using new datasets curated for this work. To generate high-quality spotlights, we propose a two-stage approach: fine-tuning a large language model on our benchmark data, followed by alignment via Direct Preference Optimization (DPO). Our comprehensive evaluation demonstrates that the resulting model not only identifies key elements with precision but also enhances readability and boosts the engagement value of the original document."},{"descriptionType":"Other","description":"Paper accepted in EMNLP 2025 Main Conference (Full Paper)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10935","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:50:54Z","registered":"2025-09-16T02:50:55Z","published":null,"updated":"2025-10-22T02:20:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10972","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10972","identifiers":[{"identifier":"2509.10972","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ron","familyName":"Sun","name":"Sun, Ron","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Computational Cognitive Architectures with LLMs: A Case Study"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T20:14:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:27:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Computational cognitive architectures are broadly scoped models of the human mind that combine different psychological functionalities (as well as often different computational methods for these different functionalities) into one unified framework. They structure them in a psychologically plausible and validated way. However, such models thus far have only limited computational capabilities, mostly limited by the computational tools and techniques that were adopted. More recently, LLMs have proved to be more capable computationally than any other tools. Thus, in order to deal with both real-world complexity and psychological realism at the same time, incorporating LLMs into cognitive architectures naturally becomes an important task. In the present article, a synergistic combination of the Clarion cognitive architecture and LLMs is discussed as a case study. The implicit-explicit dichotomy that is fundamental to Clarion is leveraged for a seamless integration of Clarion and LLMs. As a result, computational power of LLMs is combined with psychological nicety of Clarion."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10972","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:51:46Z","registered":"2025-09-16T02:51:47Z","published":null,"updated":"2025-09-16T02:51:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10975","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10975","identifiers":[{"identifier":"2509.10975","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jielong","familyName":"Tang","name":"Tang, Jielong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Wang","name":"Wang, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenxing","familyName":"Wang","name":"Wang, Zhenxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianxing","familyName":"Yu","name":"Yu, Jianxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Yin","name":"Yin, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReFineG: Synergizing Small Supervised Models and LLMs for Low-Resource Grounded Multimodal NER"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T20:32:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:27:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-12T08:01:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-13T01:31:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Grounded Multimodal Named Entity Recognition (GMNER) extends traditional NER by jointly detecting textual mentions and grounding them to visual regions. While existing supervised methods achieve strong performance, they rely on costly multimodal annotations and often underperform in low-resource domains. Multimodal Large Language Models (MLLMs) show strong generalization but suffer from Domain Knowledge Conflict, producing redundant or incorrect mentions for domain-specific entities. To address these challenges, we propose ReFineG, a three-stage collaborative framework that integrates small supervised models with frozen MLLMs for low-resource GMNER. In the Training Stage, a domain-aware NER data synthesis strategy transfers LLM knowledge to small models with supervised training while avoiding domain knowledge conflicts. In the Refinement Stage, an uncertainty-based mechanism retains confident predictions from supervised models and delegates uncertain ones to the MLLM. In the Grounding Stage, a multimodal context selection algorithm enhances visual grounding through analogical reasoning. In the CCKS2025 GMNER Shared Task, ReFineG ranked second with an F1 score of 0.6461 on the online leaderboard, demonstrating its effectiveness with limited annotations."},{"descriptionType":"Other","description":"CCKS 2025 Shared Task Paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10975","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:51:50Z","registered":"2025-09-16T02:51:51Z","published":null,"updated":"2025-11-13T03:08:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11016","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11016","identifiers":[{"identifier":"2509.11016","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xu","familyName":"Yang","name":"Yang, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Wang","name":"Wang, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaiwen","familyName":"Li","name":"Li, Kaiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhua","familyName":"Li","name":"Li, Wenhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Wang","name":"Wang, Ling","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deep Reinforcement Learning-Assisted Component Auto-Configuration of Differential Evolution Algorithm for Constrained Optimization: A Foundation Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Neural and Evolutionary Computing (cs.NE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T00:14:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:29:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite significant efforts to manually design high-performance evolutionary algorithms, their adaptability remains limited due to the dynamic and ever-evolving nature of real-world problems. The \"no free lunch\" theorem highlights that no single algorithm performs optimally across all problems. While online adaptation methods have been proposed, they often suffer from inefficiency, weak convergence, and limited generalization on constrained optimization problems (COPs).\n To address these challenges, we introduce a novel framework for automated component configuration in Differential Evolution (DE) algorithm to address COPs, powered by Deep Reinforcement Learning (DRL). Specifically, we propose SuperDE, a foundation model that dynamically configures DE's evolutionary components based on real-time evolution. Trained offline through meta-learning across a wide variety of COPs, SuperDE is capable of recommending optimal per-generation configurations for unseen problems in a zero-shot manner. Utilizing a Double Deep Q-Network (DDQN), SuperDE adapts its configuration strategies in response to the evolving population states during optimization. Experimental results demonstrate that SuperDE significantly outperforms existing state-of-the-art algorithms on benchmark test suites, achieving superior generalization and optimization performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11016","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:52:48Z","registered":"2025-09-16T02:52:49Z","published":null,"updated":"2025-09-16T02:52:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11056","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11056","identifiers":[{"identifier":"2509.11056","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuhang","familyName":"Li","name":"Li, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Lu","name":"Lu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Chen","name":"Chen, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Ai","name":"Ai, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiguo","familyName":"Ding","name":"Ding, Zhiguo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BERT4beam: Large AI Model Enabled Generalized Beamforming Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T02:49:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:32:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-01T13:14:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T02:07:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Artificial intelligence (AI) is anticipated to emerge as a pivotal enabler for the forthcoming sixth-generation (6G) wireless communication systems. However, current research efforts regarding large AI models for wireless communications primarily focus on fine-tuning pre-trained large language models (LLMs) for specific tasks. This paper investigates the large-scale AI model designed for beamforming optimization to adapt and generalize to diverse tasks defined by system utilities and scales. We propose a novel framework based on bidirectional encoder representations from transformers (BERT), termed BERT4beam. We aim to formulate the beamforming optimization problem as a token-level sequence learning task, perform tokenization of the channel state information, construct the BERT model, and conduct task-specific pre-training and fine-tuning strategies. Based on the framework, we propose two BERT-based approaches for single-task and multi-task beamforming optimization, respectively. Both approaches are generalizable for varying user scales. Moreover, the former can adapt to varying system utilities and antenna configurations by re-configuring the input and output module of the BERT model, while the latter, termed UBERT, can directly generalize to diverse tasks, due to a finer-grained tokenization strategy. Extensive simulation results demonstrate that the two proposed approaches can achieve near-optimal performance and outperform existing AI models across various beamforming optimization tasks, showcasing strong adaptability and generalizability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11056","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:53:44Z","registered":"2025-09-16T02:53:45Z","published":null,"updated":"2026-06-02T04:52:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11063","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11063","identifiers":[{"identifier":"2509.11063","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaoyu","familyName":"Huang","name":"Huang, Xiaoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lauren M","familyName":"Maxson","name":"Maxson, Lauren M","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Trang","familyName":"Nguyen","name":"Nguyen, Trang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng Jack","familyName":"Song","name":"Song, Cheng Jack","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuankai","familyName":"Huo","name":"Huo, Yuankai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Organoid Tracker: A SAM2-Powered Platform for Zero-shot Cyst Analysis in Human Kidney Organoid Videos"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T03:11:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:32:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in organoid models have revolutionized the study of human kidney disease mechanisms and drug discovery by enabling scalable, cost-effective research without the need for animal sacrifice. Here, we present a kidney organoid platform optimized for efficient screening in polycystic kidney disease (PKD). While these systems generate rich spatial-temporal microscopy video datasets, current manual approaches to analysis remain limited to coarse classifications (e.g., hit vs. non-hit), often missing valuable pixel-level and longitudinal information. To help overcome this bottleneck, we developed Organoid Tracker, a graphical user interface (GUI) platform designed with a modular plugin architecture, which empowers researchers to extract detailed, quantitative metrics without programming expertise. Built on the cutting-edge vision foundation model Segment Anything Model 2 (SAM2), Organoid Tracker enables zero-shot segmentation and automated analysis of spatial-temporal microscopy videos. It quantifies key metrics such as cyst formation rate, growth velocity, and morphological changes, while generating comprehensive reports. By providing an extensible, open-source framework, Organoid Tracker offers a powerful solution for improving and accelerating research in kidney development, PKD modeling, and therapeutic discovery. The platform is publicly available as open-source software at https://github.com/hrlblab/OrganoidTracker."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11063","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:53:54Z","registered":"2025-09-16T02:53:55Z","published":null,"updated":"2025-09-16T02:53:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11071","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11071","identifiers":[{"identifier":"2509.11071","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinghan","familyName":"Peng","name":"Peng, Jinghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingwen","familyName":"Wang","name":"Wang, Jingwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Yu","name":"Yu, Xing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dehui","familyName":"Du","name":"Du, Dehui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The System Description of CPS Team for Track on Driving with Language of CVPR 2024 Autonomous Grand Challenge"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T03:37:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:32:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This report outlines our approach using vision language model systems for the Driving with Language track of the CVPR 2024 Autonomous Grand Challenge. We have exclusively utilized the DriveLM-nuScenes dataset for training our models. Our systems are built on the LLaVA models, which we enhanced through fine-tuning with the LoRA and DoRA methods. Additionally, we have integrated depth information from open-source depth estimation models to enrich the training and inference processes. For inference, particularly with multiple-choice and yes/no questions, we adopted a Chain-of-Thought reasoning approach to improve the accuracy of the results. This comprehensive methodology enabled us to achieve a top score of 0.7799 on the validation set leaderboard, ranking 1st on the leaderboard."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11071","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:05Z","registered":"2025-09-16T02:54:05Z","published":null,"updated":"2025-09-16T02:54:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11076","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11076","identifiers":[{"identifier":"2509.11076","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zibo","familyName":"Wang","name":"Wang, Zibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Zhou","name":"Zhou, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhibin","familyName":"Wang","name":"Wang, Zhibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shipeng","familyName":"Li","name":"Li, Shipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinjing","familyName":"Huang","name":"Huang, Xinjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chendong","familyName":"Cai","name":"Cai, Chendong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingxu","familyName":"Mu","name":"Mu, Bingxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Sun","name":"Sun, Yuqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiheng","familyName":"Hu","name":"Hu, Zhiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"She","name":"She, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shu","familyName":"You","name":"You, Shu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanghuan","familyName":"Fang","name":"Fang, Guanghuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rong","familyName":"Gu","name":"Gu, Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanchun","familyName":"Dou","name":"Dou, Wanchun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guihai","familyName":"Chen","name":"Chen, Guihai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Tian","name":"Tian, Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SmartSwap: Swap-Based Memory Optimization for LLM Training under Varying Operator Sequences"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T03:55:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:33:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-15T13:51:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-16T00:48:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The increasing size of large language models (LLMs) has led to a surge in memory requirements during training, often exceeding the capacity of high-bandwidth memory (HBM). Swap-based memory optimization incurs neither accuracy loss nor additional end-to-end overhead when effectively overlapped, thus being an attractive solution. However, existing swap methods assume consistent operator sequences, which is impractical in Eager Mode, where operator sequences can vary during change.\n We propose Chameleon, which redesigns the end-to-end process of swap-based memory optimization and is the first work to consider varying operator sequences in Eager Mode. Chameleon (i) introduces a lightweight online profiler to enable continuous profiling for monitoring operator sequences, (ii) generates effective swap policies with limited operator information, and (iii) optimizes the policy execution module for accurate policy application and better performance. Experimental results demonstrate that Chameleon reduces profiling overhead by 84.25%, enables training models up to 4x larger than hardware memory while adapting to changes in operator sequences, improves performance by up to 38.94% compared to recomputation or high-degree parallelism."},{"descriptionType":"Other","description":"Accepted to DAC 2026. Previously titled \"Chameleon: Taming Dynamic Operator Sequences for Memory-Intensive LLM Training.\""}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11076","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:12Z","registered":"2025-09-16T02:54:13Z","published":null,"updated":"2026-07-16T02:33:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11084","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11084","identifiers":[{"identifier":"2509.11084","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyeongju","familyName":"Kim","name":"Kim, Hyeongju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juheon","familyName":"Lee","name":"Lee, Juheon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinhyeok","familyName":"Yang","name":"Yang, Jinhyeok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacob","familyName":"Morton","name":"Morton, Jacob","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Length-Aware Rotary Position Embedding for Text-Speech Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T04:25:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:33:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Many recent text-to-speech (TTS) systems are built on transformer architectures and employ cross-attention mechanisms for text-speech alignment. Within these systems, rotary position embedding (RoPE) is commonly used to encode positional information in text and speech representations. In this work, we introduce length-aware RoPE (LARoPE), a simple yet effective extension of RoPE that improves text-speech alignment. Unlike RoPE, which relies on absolute indices, LARoPE computes relative distances between query and key positions using length-normalized indices. Experimental results show that LARoPE consistently outperforms RoPE, offering faster loss convergence, more accurate text-speech alignment, and higher overall TTS quality. Furthermore, LARoPE demonstrates greater resilience to variations in utterance duration and maintains stable performance in extended speech generation up to 30 seconds, whereas RoPE suffers from notable degradation. Notably, our method achieves a state-of-the-art word error rate on a standard zero-shot TTS benchmark."},{"descriptionType":"Other","description":"5 pages, 3 figures, preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11084","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:23Z","registered":"2025-09-16T02:54:24Z","published":null,"updated":"2025-09-16T02:54:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11104","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11104","identifiers":[{"identifier":"2509.11104","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jin","familyName":"Han","name":"Han, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin-Zheng","familyName":"Lu","name":"Lu, Xin-Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia-Rui","familyName":"Lin","name":"Lin, Jia-Rui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BIGNet: Pretrained Graph Neural Network for Embedding Semantic, Spatial, and Topological Data in BIM Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T05:43:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-30T01:33:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1111/mice.70073","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Foundation Models (LFMs) have demonstrated significant advantages in civil engineering, but they primarily focus on textual and visual data, overlooking the rich semantic, spatial, and topological features in BIM (Building Information Modelling) models. Therefore, this study develops the first large-scale graph neural network (GNN), BIGNet, to learn, and reuse multidimensional design features embedded in BIM models. Firstly, a scalable graph representation is introduced to encode the \"semantic-spatial-topological\" features of BIM components, and a dataset with nearly 1 million nodes and 3.5 million edges is created. Subsequently, BIGNet is proposed by introducing a new message-passing mechanism to GraphMAE2 and further pretrained with a node masking strategy. Finally, BIGNet is evaluated in various transfer learning tasks for BIM-based design checking. Results show that: 1) homogeneous graph representation outperforms heterogeneous graph in learning design features, 2) considering local spatial relationships in a 30 cm radius enhances performance, and 3) BIGNet with GAT (Graph Attention Network)-based feature extraction achieves the best transfer learning results. This innovation leads to a 72.7% improvement in Average F1-score over non-pretrained models, demonstrating its effectiveness in learning and transferring BIM design features and facilitating their automated application in future design and lifecycle management."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11104","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T02:54:50Z","registered":"2025-09-16T02:54:51Z","published":null,"updated":"2025-09-30T05:09:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11109","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11109","identifiers":[{"identifier":"2509.11109","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaxin","familyName":"Huang","name":"Huang, Jiaxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanyu","familyName":"Liu","name":"Liu, Hanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunsheng","familyName":"Ma","name":"Ma, Yunsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Shen","name":"Shen, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilin","familyName":"Zheng","name":"Zheng, Yilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Wen","name":"Wen, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhigong","familyName":"Song","name":"Song, Zhigong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FEWT: Frequency-Enhanced Wavelet-based Transformer for Multimodal Wheeled Bimanual Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T05:56:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:35:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T09:55:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:37:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-16T09:22:24Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-17T00:39:52Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-08-12T08:32:21Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-08-13T00:31:51Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Embodied intelligence bridges the physical world and information spaces, with robots demonstrating immense potential through imitation learning algorithms. In this study, a custom-built wheeled bimanual robotic platform equipped with an exoskeleton-style teleoperation system was utilized to realize intuitive remote manipulation and the efficient collection of anthropomorphic action data. To overcome the representation mismatch between spatial visual semantics and localized high-frequency physical dynamics, we propose a lightweight frequency-aligned imitation-learning framework, termed the Frequency-Enhanced Wavelet-based Transformer (FEWT). FEWT integrates two primary modules: Frequency-Enhanced Efficient Multi-Scale Attention (FE-EMA) and Time-Series Discrete Wavelet Transform (TS-DWT) to explicitly extract and align multi-scale features, improving the compatibility between spatial visual representations and temporal-frequency recalibration. Crucially, for real-world deployment, this framework is further extended into a multimodal system by seamlessly integrating a self-developed Smart Tactile Fabric (STF) sensor into the physical end-effectors, providing local contact-stress information that complements proprioceptive and chassis-motion cues in the shared multimodal representation. Experimental evaluations demonstrate that the core FEWT architecture significantly improves the success rate over the widely used Action Chunking with Transformers baseline, particularly during the most challenging phases of simulated bimanual insertion tasks. Furthermore, in complex real-world mobile and desktop manipulation tasks, the full STF-enhanced system effectively adapts to microscopic dynamic perturbations, yielding substantial performance enhancements."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11109","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:57Z","registered":"2025-09-16T02:54:58Z","published":null,"updated":"2026-08-13T02:10:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11112","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11112","identifiers":[{"identifier":"2509.11112","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Muhammad Baqer","familyName":"Mollah","name":"Mollah, Muhammad Baqer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Honggang","familyName":"Wang","name":"Wang, Honggang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hua","familyName":"Fang","name":"Fang, Hua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-Modal Sensing Aided mmWave Beamforming for V2V Communications with Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Networking and Internet Architecture (cs.NI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Theory (cs.IT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T06:03:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:35:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Beamforming techniques are utilized in millimeter wave (mmWave) communication to address the inherent path loss limitation, thereby establishing and maintaining reliable connections. However, adopting standard defined beamforming approach in highly dynamic vehicular environments often incurs high beam training overheads and reduces the available airtime for communications, which is mainly due to exchanging pilot signals and exhaustive beam measurements. To this end, we present a multi-modal sensing and fusion learning framework as a potential alternative solution to reduce such overheads. In this framework, we first extract the features individually from the visual and GPS coordinates sensing modalities by modality specific encoders, and subsequently fuse the multimodal features to obtain predicted top-k beams so that the best line-of-sight links can be proactively established. To show the generalizability of the proposed framework, we perform a comprehensive experiment in four different vehicle-to-vehicle (V2V) scenarios from real-world multi-modal sensing and communication dataset. From the experiment, we observe that the proposed framework achieves up to 77.58% accuracy on predicting top-15 beams correctly, outperforms single modalities, incurs roughly as low as 2.32 dB average power loss, and considerably reduces the beam searching space overheads by 76.56% for top-15 beams with respect to standard defined approach."},{"descriptionType":"Other","description":"6 Pages, Accepted to present at 2025 IEEE Global Communications Conference (GLOBECOM), Taipei, Taiwan"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11112","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:55:01Z","registered":"2025-09-16T02:55:02Z","published":null,"updated":"2025-09-16T02:55:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11127","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11127","identifiers":[{"identifier":"2509.11127","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongxu","familyName":"Zhou","name":"Zhou, Hongxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hylke","familyName":"Westerdijk","name":"Westerdijk, Hylke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khondoker Ittehadul","familyName":"Islam","name":"Islam, Khondoker Ittehadul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Joint Effects of Argumentation Theory, Audio Modality and Data Enrichment on LLM-Based Fallacy Classification"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T06:35:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:35:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study investigates how context and emotional tone metadata influence large language model (LLM) reasoning and performance in fallacy classification tasks, particularly within political debate settings. Using data from U.S. presidential debates, we classify six fallacy types through various prompting strategies applied to the Qwen-3 (8B) model. We introduce two theoretically grounded Chain-of-Thought frameworks: Pragma-Dialectics and the Periodic Table of Arguments, and evaluate their effectiveness against a baseline prompt under three input settings: text-only, text with context, and text with both context and audio-based emotional tone metadata. Results suggest that while theoretical prompting can improve interpretability and, in some cases, accuracy, the addition of context and especially emotional tone metadata often leads to lowered performance. Emotional tone metadata biases the model toward labeling statements as \\textit{Appeal to Emotion}, worsening logical reasoning. Overall, basic prompts often outperformed enhanced ones, suggesting that attention dilution from added inputs may worsen rather than improve fallacy classification in LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11127","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:55:22Z","registered":"2025-09-16T02:55:23Z","published":null,"updated":"2025-09-16T02:55:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11141","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11141","identifiers":[{"identifier":"2509.11141","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shiyao","familyName":"Cui","name":"Cui, Shiyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xijia","familyName":"Feng","name":"Feng, Xijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingkang","familyName":"Wang","name":"Wang, Yingkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junxiao","familyName":"Yang","name":"Yang, Junxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhexin","familyName":"Zhang","name":"Zhang, Zhexin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Biplab","familyName":"Sikdar","name":"Sikdar, Biplab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongning","familyName":"Wang","name":"Wang, Hongning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Qiu","name":"Qiu, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minlie","familyName":"Huang","name":"Huang, Minlie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Smiley Turns Hostile: Interpreting How Emojis Trigger LLMs' Toxicity"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T07:21:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:36:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Emojis are globally used non-verbal cues in digital communication, and extensive research has examined how large language models (LLMs) understand and utilize emojis across contexts. While usually associated with friendliness or playfulness, it is observed that emojis may trigger toxic content generation in LLMs. Motivated by such a observation, we aim to investigate: (1) whether emojis can clearly enhance the toxicity generation in LLMs and (2) how to interpret this phenomenon. We begin with a comprehensive exploration of emoji-triggered LLM toxicity generation by automating the construction of prompts with emojis to subtly express toxic intent. Experiments across 5 mainstream languages on 7 famous LLMs along with jailbreak tasks demonstrate that prompts with emojis could easily induce toxicity generation. To understand this phenomenon, we conduct model-level interpretations spanning semantic cognition, sequence generation and tokenization, suggesting that emojis can act as a heterogeneous semantic channel to bypass the safety mechanisms. To pursue deeper insights, we further probe the pre-training corpus and uncover potential correlation between the emoji-related data polution with the toxicity generation behaviors. Supplementary materials provide our implementation code and data. (Warning: This paper contains potentially sensitive contents)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11141","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:55:42Z","registered":"2025-09-16T02:55:43Z","published":null,"updated":"2025-09-16T02:55:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11155","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11155","identifiers":[{"identifier":"2509.11155","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Santhosh G","familyName":"S","name":"S, Santhosh G","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saurav","familyName":"Prakash","name":"Prakash, Saurav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Balaraman","familyName":"Ravindran","name":"Ravindran, Balaraman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AQUA: Attention via QUery mAgnitudes for Memory and Compute Efficient Inference in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T08:20:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:38:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The quadratic complexity of the attention mechanism remains a fundamental barrier to scaling Large Language Models (LLMs) to longer contexts, creating a critical bottleneck in both computation and memory. To address this, we introduce AQUA (Attention via QUery mAgnitudes) a novel and versatile approximation strategy that significantly reduces the cost of attention with a graceful performance trade-off. Our method operates in two phases: an efficient offline step where we compute a universal, language agnostic projection matrix via SVD on a calibration dataset, and an online inference step where we project query and key vectors and dynamically select a sparse subset of dimensions based on the query's magnitude. We provide a formal theoretical analysis of AQUA, establishing the break-even point at which it becomes more computationally efficient than standard attention. Our empirical evaluations on state-of-the-art models like Llama-3.1-8B demonstrate that a 25% reduction in the attention dot-product computation can be achieved with a statistically insignificant impact on performance across a wide range of benchmarks. We further showcase the versatility of AQUA by demonstrating its ability to synergistically accelerate existing token eviction methods like H2O and to directly reduce KV-cache memory size. By offering a controllable knob to balance efficiency and accuracy, AQUA provides a practical and powerful tool for making large-scale LLM inference more accessible and sustainable."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11155","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:02Z","registered":"2025-09-16T02:56:03Z","published":null,"updated":"2025-09-16T02:56:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11165","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11165","identifiers":[{"identifier":"2509.11165","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Waikit","familyName":"Xiu","name":"Xiu, Waikit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Lu","name":"Lu, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingchen","familyName":"Liu","name":"Liu, Bingchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Sun","name":"Sun, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiying","familyName":"Li","name":"Li, Xiying","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Traffic-MLLM: Curiosity-Regularized Supervised Learning for Traffic Scenario Case-Based Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T08:53:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:38:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-07T14:12:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T00:45:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For safe and robust autonomous driving, decision-making systems must effectively leverage past experiences to handle the inherent long-tail of traffic scenarios. Case-Based Reasoning (CBR) provides a natural paradigm for this by adapting solutions from prior cases. However, in complex and dynamic traffic environments, traditional CBR methods struggle to effectively abstract and adapt knowledge under uncertainty. Meanwhile, although multimodal large language models (MLLMs) exhibit strong perceptual and linguistic capabilities, their reasoning behavior often relies on empirical pattern fitting, limiting robustness under distribution shift and long-tail scenarios. We propose Traffic-MLLM, a retrieval-free neural case modeling framework for multimodal traffic reasoning. Instead of performing explicit case retrieval at inference time, Traffic-MLLM learns a structured and generalizable case space directly during training. To support this learning process, we construct a multi-source case base by integrating dynamic traffic videos and large-scale static visual question-answering data, serving as a unified training substrate for learning structured case representations. To further improve representation quality near knowledge boundaries, we introduce a curiosity-driven refinement mechanism based on Random Network Distillation (RND), encouraging the model to internalize cross-case structural regularities rather than surface correlations. Experiments on the SUTD-TrafficQA and DriveQA benchmarks demonstrate consistent improvements in dynamic reasoning, regulatory understanding, and cross-domain transfer. Traffic-MLLM achieves 50.8% accuracy on SUTD-TrafficQA, 74.8% on the CARLA-based DriveQA split, and 83.1% on the real-world Mapillary split, indicating that representation-level case-space refinement provides an effective alternative to explicit retrieval for scalable multimodal case adaptation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11165","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:16Z","registered":"2025-09-16T02:56:17Z","published":null,"updated":"2026-03-10T04:49:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11167","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11167","identifiers":[{"identifier":"2509.11167","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pouria","familyName":"Mahdavinia","name":"Mahdavinia, Pouria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hamed","familyName":"Mahdavi","name":"Mahdavi, Hamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niloofar","familyName":"Mireshghallah","name":"Mireshghallah, Niloofar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehrdad","familyName":"Mahdavi","name":"Mahdavi, Mehrdad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Harnessing Optimization Dynamics for Curvature-Informed Model Merging"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T08:59:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:39:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Model merging is an effective post-training strategy for composing capabilities in large language models without joint retraining. We study this in the supervised fine-tuning (SFT) stage, where multiple capability-based SFT checkpoints -- spanning math, code, precise instruction following, general instruction following, and knowledge recall -- must be consolidated into a single model. We introduce Optimization Trajectory Aware (OTA) Merging, a curvature-aware aggregation that leverages optimizer second-moment statistics as a diagonal curvature proxy to reweight parameter edits and mitigate interference. Complementing OTA, we propose Fast Fisher Grafting (FFG), a curvature-driven task-localization step that sparsifies conflicting or low-importance edits. FFG induces extremely low-rank masks concentrated in early attention query/key projections and token embeddings, exploiting shared curvature across capabilities. We further develop a memory-light compression of the second moments that preserves OTA's effect. Across diverse capability-based SFT checkpoints, OTA+FFG improves merged-model quality over strong weight-space baselines, reduces negative transfer, and remains robust across sparsity levels. Analyses reveal substantial curvature overlap between checkpoints, offering a novel lens on why simple linear merging can be effective in practice. Ablations confirm that FFG is critical for reducing task interference and that the compressed second moments retain the gains of the full formulation. To facilitate reproducibility, we open-source all code, training and evaluation scripts, visualization artifacts, and capability-specific SFT checkpoints at https://github.com/pmahdavi/ota-merge."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11167","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:20Z","registered":"2025-09-16T02:56:20Z","published":null,"updated":"2025-09-16T02:56:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11177","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11177","identifiers":[{"identifier":"2509.11177","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hang","familyName":"Guo","name":"Guo, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawei","familyName":"Li","name":"Li, Yawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Benini","name":"Benini, Luca","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimal Brain Restoration for Joint Quantization and Sparsification of LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T09:17:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:39:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T03:17:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:18:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Large Language Model (LLM) compression, such as quantization and pruning, have achieved notable success. However, as these techniques gradually approach their respective limits, relying on a single method for further compression has become increasingly challenging. In this work, we explore an alternative solution by combining quantization and sparsity. This joint approach, though promising, introduces new difficulties due to the inherently conflicting requirements on weight distributions: quantization favors compact ranges, while pruning benefits from high variance. To attack this problem, we propose Optimal Brain Restoration (OBR), a general and training-free framework that aligns pruning and quantization by error compensation between both. OBR minimizes performance degradation on downstream tasks by building on a second-order Hessian objective, which is then reformulated into a tractable problem through surrogate approximation and ultimately reaches a closed-form solution via group error compensation. Experiments show that OBR enables aggressive W4A4KV4 quantization with 50% sparsity on existing LLMs, and delivers up to 4.72x speedup and 6.4x memory reduction compared to the FP16-dense baseline."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11177","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:33Z","registered":"2025-09-16T02:56:34Z","published":null,"updated":"2025-09-17T02:12:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11191","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11191","identifiers":[{"identifier":"2509.11191","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jian","familyName":"Chen","name":"Chen, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyi","familyName":"Lv","name":"Lv, Shengyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leilei","familyName":"Su","name":"Su, Leilei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RanAT4BIE: Random Adversarial Training for Biomedical Information Extraction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T09:40:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:40:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce random adversarial training (RAT), a novel framework successfully applied to biomedical information extraction (BioIE) tasks. Building on PubMedBERT as the foundational architecture, our study first validates the effectiveness of conventional adversarial training in enhancing pre-trained language models' performance on BioIE tasks. While adversarial training yields significant improvements across various performance metrics, it also introduces considerable computational overhead. To address this limitation, we propose RAT as an efficiency solution for biomedical information extraction. This framework strategically integrates random sampling mechanisms with adversarial training principles, achieving dual objectives: enhanced model generalization and robustness while significantly reducing computational costs. Through comprehensive evaluations, RAT demonstrates superior performance compared to baseline models in BioIE tasks. The results highlight RAT's potential as a transformative framework for biomedical natural language processing, offering a balanced solution to the model performance and computational efficiency."},{"descriptionType":"Other","description":"Accepted for publication at the International Joint Conference on Neural Networks (IJCNN) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11191","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:52Z","registered":"2025-09-16T02:56:53Z","published":null,"updated":"2025-09-16T02:56:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11197","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11197","identifiers":[{"identifier":"2509.11197","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunheng","familyName":"Wang","name":"Wang, Yunheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuetong","familyName":"Fang","name":"Fang, Yuetong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taowen","familyName":"Wang","name":"Wang, Taowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixiao","familyName":"Feng","name":"Feng, Yixiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawen","familyName":"Tan","name":"Tan, Yawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuning","familyName":"Zhang","name":"Zhang, Shuning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peiran","familyName":"Liu","name":"Liu, Peiran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiding","familyName":"Ji","name":"Ji, Yiding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renjing","familyName":"Xu","name":"Xu, Renjing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DreamNav: A Trajectory-Based Imaginative Framework for Zero-Shot Vision-and-Language Navigation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T09:54:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:40:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-and-Language Navigation in Continuous Environments (VLN-CE), which links language instructions to perception and control in the real world, is a core capability of embodied robots. Recently, large-scale pretrained foundation models have been leveraged as shared priors for perception, reasoning, and action, enabling zero-shot VLN without task-specific training. However, existing zero-shot VLN methods depend on costly perception and passive scene understanding, collapsing control to point-level choices. As a result, they are expensive to deploy, misaligned in action semantics, and short-sighted in planning. To address these issues, we present DreamNav that focuses on the following three aspects: (1) for reducing sensory cost, our EgoView Corrector aligns viewpoints and stabilizes egocentric perception; (2) instead of point-level actions, our Trajectory Predictor favors global trajectory-level planning to better align with instruction semantics; and (3) to enable anticipatory and long-horizon planning, we propose an Imagination Predictor to endow the agent with proactive thinking capability. On VLN-CE and real-world tests, DreamNav sets a new zero-shot state-of-the-art (SOTA), outperforming the strongest egocentric baseline with extra information by up to 7.49\\% and 18.15\\% in terms of SR and SPL metrics. To our knowledge, this is the first zero-shot VLN method to unify trajectory-level planning and active imagination while using only egocentric inputs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11197","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:57:01Z","registered":"2025-09-16T02:57:01Z","published":null,"updated":"2025-09-16T02:57:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11208","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11208","identifiers":[{"identifier":"2509.11208","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leon","familyName":"Chlon","name":"Chlon, Leon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmed","familyName":"Karim","name":"Karim, Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maggie","familyName":"Chlon","name":"Chlon, Maggie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"MarcAntonio","familyName":"Awada","name":"Awada, MarcAntonio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predictable Compression Failures: Order Sensitivity and Information Budgeting for Evidence-Grounded Binary Adjudication"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T10:32:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:41:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-22T15:10:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-24T01:52:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-05T12:26:10Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-08T00:43:20Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformers used for evidence-grounded binary adjudication (e.g., support/refute, yes/no, or verifier-backed pass/fail decisions) can be sensitive to the order in which exchangeable evidence is presented, producing dispersion across permutations and unreliable attempted answers under a verifier-relative Bernoulli predicate. We treat evidence order as a nuisance variable and formalize an expectation-realization gap: next-token training can minimize expected conditional description length over orderings while a fixed ordering remains position-sensitive. Our Quantified Martingale Violation (QMV) bound predicts the dispersion induced by adjacent-rank positional sensitivity, with $O(\\log n)$ growth in the harmonic regime; our Expectation-level Decompression Law (EDFL) specializes a KL convexity/data-processing bound to Bernoulli predicates, yielding Bits-to-Trust (B2T), Risk-of-Hallucination (RoH), and an Information Sufficiency Ratio (ISR) gate for answer/abstain decisions. On 3,059 grounded items from FEVER, HotpotQA, NQ-Open, PopQA, and Controls, we observe logarithmic dispersion and positive Jensen gains from uniform permutation mixtures. In one pre-specified held-out audit (528 items), the analytically fixed ISR$=1$ gate attains 0.0-0.7% hallucination with 20.6-27.9% abstention (95% CIs), supporting the operating point without claiming universal calibration across all model families or unrestricted generation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11208","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:57:16Z","registered":"2025-09-16T02:57:16Z","published":null,"updated":"2026-06-08T02:01:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11218","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11218","identifiers":[{"identifier":"2509.11218","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Johann","familyName":"Schmidt","name":"Schmidt, Johann","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tom","familyName":"Siegl","name":"Siegl, Tom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Becker","name":"Becker, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Stober","name":"Stober, Sebastian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geometrically Constrained and Token-Based Probabilistic Spatial Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T11:30:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:42:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-17T08:50:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-18T01:23:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-29T08:23:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-30T01:01:30Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Spatial transformations such as rotation and scale obscure the morphological cues needed for accurate image classification. Careful consideration is required for reliable use in high stakes settings. A model should stay robust under such transformations, expose why a correction was applied, and signal when its input is ambiguous. While geometrically equivariant architectures provide a mathematically grounded solution, they often limit model flexibility through strict symmetry constraints and incur significant computational overhead. Spatial Transformer Networks (STNs) offer a data-driven, flexible alternative for learning pseudo-equivariances to affine transformations. However, STNs have historically been restricted to convolutional architectures and suffer from training instability. To address this, we introduce a novel STN framework. It leverages the global modeling capabilities of transformers to regress the affine transformation acting on the input. For this, we decompose affine transformations into interpretable primitives, regressed under adaptable geometric constraints, thereby preventing the training instability typically caused by degenerate transformations. By sharing weights between the localization network and the classification backbone, the framework requires minimal computational overhead. Extensive experiments on challenging insect biodiversity and medical imaging benchmarks demonstrate that our approach achieves superior predictive performance under diverse spatial transformations while maintaining high efficiency. Code is available at https://github.com/johSchm/TokenSTN."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11218","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:57:29Z","registered":"2025-09-16T02:57:30Z","published":null,"updated":"2026-09-30T04:01:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11241","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11241","identifiers":[{"identifier":"2509.11241","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Satyajeet","familyName":"Prabhu","name":"Prabhu, Satyajeet","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revisiting Meter Tracking in Carnatic Music using Deep Learning Approaches"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T12:33:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:43:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Beat and downbeat tracking, jointly referred to as Meter Tracking, is a fundamental task in Music Information Retrieval (MIR). Deep learning models have far surpassed traditional signal processing and classical machine learning approaches in this domain, particularly for Western (Eurogenetic) genres, where large annotated datasets are widely available. These systems, however, perform less reliably on underrepresented musical traditions. Carnatic music, a rich tradition from the Indian subcontinent, is renowned for its rhythmic intricacy and unique metrical structures (tālas). The most notable prior work on meter tracking in this context employed probabilistic Dynamic Bayesian Networks (DBNs). The performance of state-of-the-art (SOTA) deep learning models on Carnatic music, however, remains largely unexplored.\n In this study, we evaluate two models for meter tracking in Carnatic music: the Temporal Convolutional Network (TCN), a lightweight architecture that has been successfully adapted for Latin rhythms, and Beat This!, a transformer-based model designed for broad stylistic coverage without the need for post-processing. Replicating the experimental setup of the DBN baseline on the Carnatic Music Rhythm (CMR$_f$) dataset, we systematically assess the performance of these models in a directly comparable setting. We further investigate adaptation strategies, including fine-tuning the models on Carnatic data and the use of musically informed parameters. Results show that while off-the-shelf models do not always outperform the DBN, their performance improves substantially with transfer learning, matching or surpassing the baseline. These findings indicate that SOTA deep learning models can be effectively adapted to underrepresented traditions, paving the way for more inclusive and broadly applicable meter tracking systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11241","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:58:01Z","registered":"2025-09-16T02:58:02Z","published":null,"updated":"2025-09-16T02:58:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11243","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11243","identifiers":[{"identifier":"2509.11243","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haozhen","familyName":"Li","name":"Li, Haozhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruide","familyName":"Zhang","name":"Zhang, Ruide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongqing","familyName":"Zhang","name":"Zhang, Rongqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Cheng","name":"Cheng, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Synesthesia of Machines (SoM)-Empowered Wireless Image Transmission over Complex Dynamic Channel"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T12:35:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:43:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Wireless image transmission underpins diverse networked intelligent services and becomes an increasingly critical issue. Existing works have shown that deep learning-based joint source-channel coding (JSCC) is an effective framework to balance image transmission fidelity and data overhead. However, these studies oversimplify the communication system as a mere pipeline with noise, failing to account for the complex dynamics of wireless channels and concrete physical-layer transmission process. To address these limitations, we propose a Synesthesia of Machines (SoM)-empowered Dynamic Channel Adaptive Transmission (DCAT) scheme, designed for practical implementation in real communication scenarios. Building upon the Swin Transformer backbone, our DCAT scheme demonstrates robust adaptability to time-selective fading and channel aging effects by effectively utilizing the physical-layer transmission characteristics of wireless channels. Comprehensive experimental results confirm that DCAT consistently achieves superior performance compared with JSCC baseline approaches across all conditions. Furthermore, our neural network architecture demonstrates high scalability due to its interpretable design, offering substantial potential for cost-efficient deployment in practical applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11243","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:58:04Z","registered":"2025-09-16T02:58:05Z","published":null,"updated":"2025-09-16T02:58:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11250","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11250","identifiers":[{"identifier":"2509.11250","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yitong","familyName":"Zhang","name":"Zhang, Yitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ximo","familyName":"Li","name":"Li, Ximo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liyi","familyName":"Cai","name":"Cai, Liyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Li","name":"Li, Jia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Environmental Injection Attacks against GUI Agents in Realistic Dynamic Environments"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T12:47:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:43:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-31T08:50:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T01:34:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-24T12:04:58Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-25T01:35:03Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graphical User Interface (GUI) agents are increasingly deployed to interact with online web services, yet their exposure to open-world content renders them vulnerable to Environmental Injection Attacks (EIAs). In these attacks, an attacker can inject crafted triggers into website to manipulate the behavior of GUI agents used by other users. In this paper, we find that most existing EIA studies fall short of realism. In particular, they fail to capture the dynamic nature of real-world web content, often assuming that a trigger's on-screen position and surrounding visual context remain largely consistent between training and testing. To better reflect practice, we introduce a realistic dynamic-environment threat model in which the attacker is a regular user and the trigger is embedded within a dynamically changing environment. Under this threat model, existing approaches largely fail, suggesting that their effectiveness in exposing GUI agent vulnerabilities has been substantially overestimated.\n To expose the hidden vulnerabilities of existing GUI agents effectively, we propose Chameleon, an attack framework with two key novelties designed for dynamic environments. (1) To synthesize more realistic training data, we introduce LLM-Driven Environment Simulation, which automatically generates diverse, high-fidelity webpage simulations that mimic the variability of real-world dynamic environments. (2) To optimize the trigger more effectively, we introduce Attention Black Hole, which converts attention weights into explicit supervisory signals. This mechanism encourages the agent to remain insensitive to irrelevant surrounding content, thereby improving robustness in dynamic environments. We evaluate Chameleon on six realistic websites and four representative LVLM-powered GUI agents, where it significantly outperforms existing methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11250","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:58:15Z","registered":"2025-09-16T02:58:15Z","published":null,"updated":"2026-08-25T03:49:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11254","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11254","identifiers":[{"identifier":"2509.11254","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shengping","familyName":"Xie","name":"Xie, Shengping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuyan","familyName":"Chen","name":"Chen, Chuyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Yuan","name":"Yuan, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From PowerSGD to PowerSGD+: Low-Rank Gradient Compression for Distributed Optimization with Convergence Guarantees"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T12:54:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:43:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Low-rank gradient compression methods, such as PowerSGD, have gained attention in communication-efficient distributed optimization. However, the convergence guarantees of PowerSGD remain unclear, particularly in stochastic settings. In this paper, we show that PowerSGD does not always converge to the optimal solution and provide a clear counterexample to support this finding. To address this, we introduce PowerSGD+, which periodically updates the projection subspace via singular value decomposition, ensuring that it remains aligned with the optimal subspace. We prove that PowerSGD+ converges under standard assumptions and validate its effectiveness through empirical evaluation on large language model tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11254","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:58:21Z","registered":"2025-09-16T02:58:21Z","published":null,"updated":"2025-09-16T02:58:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11255","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11255","identifiers":[{"identifier":"2509.11255","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Can","familyName":"Lei","name":"Lei, Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hayat","familyName":"Rajani","name":"Rajani, Hayat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nuno","familyName":"Gracias","name":"Gracias, Nuno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafael","familyName":"Garcia","name":"Garcia, Rafael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huigang","familyName":"Wang","name":"Wang, Huigang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Geometrically Consistent Matching Framework for Side-Scan Sonar Mapping"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Instrumentation and Detectors (physics.ins-det)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T12:54:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:43:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-07T16:27:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-08T00:58:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-21T15:36:51Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-24T01:43:49Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Robust matching of side-scan sonar imagery remains a fundamental challenge in seafloor mapping due to view-dependent backscatter, shadows, and geometric distortion. This paper proposes a novel matching framework that combines physical decoupling and geometric consistency to enhance correspondence accuracy and consistency across viewpoints. A multi-branch network, derived from the Lambertian reflection model, decomposes raw sonar images into seabed reflectivity, terrain elevation, and acoustic path loss. The reflectivity map, serving as a stable matching domain, is used in conjunction with a training-free matching pipeline combining SuperPoint and MINIMA-LightGlue. Geometry-aware outlier rejection leverages both terrain elevation and its physically derived shadow map to further remove mismatches in acoustically occluded and topographically inconsistent regions, thereby improving registration accuracy. Quantitative and visual evaluations against traditional, CNN-, and Transformer-based state-of-the-art methods demonstrate that our method achieves lower matching error, higher geometric consistency, and greater robustness to viewpoint variations. The proposed approach provides a data-efficient, physically interpretable solution for high-precision side-scan sonar image matching in complex seafloor environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11255","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:58:22Z","registered":"2025-09-16T02:58:23Z","published":null,"updated":"2025-11-24T02:48:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11259","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11259","identifiers":[{"identifier":"2509.11259","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David","familyName":"Schiff","name":"Schiff, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ofir","familyName":"Lindenbaum","name":"Lindenbaum, Ofir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yonathan","familyName":"Efroni","name":"Efroni, Yonathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ICR-RL: Deep Reinforcement Learning via In-Context Regression"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T13:09:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:44:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-06T06:45:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T02:02:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in machine learning have largely been driven by foundation models (FMs) trained on large, diverse datasets, enabling them to generalize effectively to new, related tasks. However, extending this paradigm to reinforcement learning (RL), where an agent interacts with an environment to select actions, remains a significant challenge. Most existing approaches train FMs directly on sets of control tasks, but developing diverse RL environments and scaling training across them can be costly and complex. In this study, we explore a simpler alternative approach based on a classical reduction from RL to regression. We demonstrate that a foundation model pre-trained for regression tasks, when used as an in-context regression (ICR) model, can be directly applied to RL problems. Building on this insight, we introduce a gradient-free method, ICR-RL, that requires no additional training and leverages an ICR foundation model to tackle RL tasks. We evaluate our approach by applying the ICR model with the recently proposed TabPFN, which is trained on a wide range of regression tasks. Experiments conducted on the Gymnasium classic-control benchmark indicate that ICR-RL can compete with commonly used methods, including DQN, PPO and TRPO. These results show that ICR foundation models can effectively solve RL tasks without fine-tuning, demonstrating their potential as a foundation for RL-oriented models."},{"descriptionType":"Other","description":"Accepted to ICML 2026 Main Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11259","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:58:28Z","registered":"2025-09-16T02:58:28Z","published":null,"updated":"2026-07-07T04:57:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11287","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11287","identifiers":[{"identifier":"2509.11287","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifan","familyName":"Lu","name":"Lu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Zhang","name":"Zhang, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunfeng","familyName":"Yuan","name":"Yuan, Chunfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Gao","name":"Gao, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Congxuan","familyName":"Zhang","name":"Zhang, Congxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojuan","familyName":"Qi","name":"Qi, Xiaojuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Li","name":"Li, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiming","familyName":"Hu","name":"Hu, Weiming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mitigating Hallucinations in Large Vision-Language Models by Self-Injecting Hallucinations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T14:26:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:45:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Vision-Language Models (LVLMs) suffer from serious hallucination problems, where the model-generated responses are inconsistent with the visual inputs. Existing hallucination mitigation methods are mainly based on preference alignment and require external human annotations or auxiliary models for preference data collection, which increase costs and limit sustainable improvement. To tackle these challenges, we propose Autonomous Preference Alignment via Self-Injection (APASI), a novel and generalizable method that mitigates hallucinations without external dependencies. APASI leverages the target LVLM to self-inject hallucinations into a generated response, creating a pair of responses with varying preference levels. During the self-injection process, the dis-preferred response is generated based on three key observations of hallucinations, ensuring it simulates real hallucination patterns. This fidelity offers an accurate learning signal for hallucination mitigation. Moreover, APASI incorporates an iterative alignment training strategy combined with curriculum learning to periodically update the preference data with increasing challenge, enabling stable and continuous enhancement of the LVLM. Extensive experiments across six benchmarks show that APASI not only effectively mitigates hallucinations for three baseline models but also achieves comparable or even superior performance to alignment-based methods with external dependency, thereby demonstrating its effectiveness and generalization capability. The code is available at https://github.com/davidluciolu/APASI."},{"descriptionType":"Other","description":"emnlp 2025 accepted"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11287","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:59:07Z","registered":"2025-09-16T02:59:07Z","published":null,"updated":"2025-09-16T02:59:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11292","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11292","identifiers":[{"identifier":"2509.11292","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziling","familyName":"Liu","name":"Liu, Ziling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziwei","familyName":"Chen","name":"Chen, Ziwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingqi","familyName":"Gao","name":"Gao, Mingqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinyu","familyName":"Yang","name":"Yang, Jinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Zheng","name":"Zheng, Feng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Leveraging Geometric Priors for Unaligned Scene Change Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T14:31:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:45:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T06:25:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:26:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Unaligned Scene Change Detection aims to detect scene changes between image pairs captured at different times without assuming viewpoint alignment. To handle viewpoint variations, current methods rely solely on 2D visual cues to establish cross-image correspondence to assist change detection. However, large viewpoint changes can alter visual observations, causing appearance-based matching to drift or fail. Additionally, supervision limited to 2D change masks from small-scale SCD datasets restricts the learning of generalizable multi-view knowledge, making it difficult to reliably identify visual overlaps and handle occlusions. This lack of explicit geometric reasoning represents a critical yet overlooked limitation. In this work, we introduce geometric priors for the first time to address the core challenges of unaligned SCD, for reliable identification of visual overlaps, robust correspondence establishment, and explicit occlusion detection. Building on these priors, we propose a training-free framework that integrates them with the powerful representations of a visual foundation model to enable reliable change detection under viewpoint misalignment. Through extensive evaluation on the PSCD, ChangeSim, and PASLCD datasets, we demonstrate that our approach achieves superior and robust performance. Our code will be released at https://github.com/ZilingLiu/GeoSCD."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11292","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:59:14Z","registered":"2025-09-16T02:59:14Z","published":null,"updated":"2025-09-17T02:12:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11311","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11311","identifiers":[{"identifier":"2509.11311","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bingchen","familyName":"Wang","name":"Wang, Bingchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zi-Yu","familyName":"Khoo","name":"Khoo, Zi-Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingtan","familyName":"Wang","name":"Wang, Jingtan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prompts to Proxies: Emulating Human Preferences via a Compact LLM Ensemble"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T15:08:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:46:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-28T19:39:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-30T01:04:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models are increasingly used as proxies for human subjects in social science research, yet external validity requires that synthetic agents faithfully reflect the preferences of target human populations. We introduce *preference reconstruction theory*, a framework that formalizes preference alignment as a representation learning problem: constructing a functional basis of proxy agents and recovering population preferences through weighted aggregation. We implement this via *Prompts to Proxies* ($\\texttt{P2P}$), a modular two-stage system. Stage 1 uses structured prompting with entropy-based adaptive sampling to construct a diverse agent pool spanning the latent preference space. Stage 2 employs L1-regularized regression to select a compact ensemble whose aggregate response distributions align with observed data from the target population. $\\texttt{P2P}$ requires no finetuning and no access to sensitive demographic data, incurring only API inference costs. We validate the approach on 14 waves of the American Trends Panel, achieving an average test MSE of 0.014 across diverse topics at approximately 0.8 USD per survey. We additionally test it on the World Values Survey, demonstrating its potential to generalize across locales. When stress-tested against an SFT-aligned baseline, $\\texttt{P2P}$ achieves competitive performance using less than 3% of the training data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11311","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:59:40Z","registered":"2025-09-16T02:59:41Z","published":null,"updated":"2026-01-30T03:41:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11328","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11328","identifiers":[{"identifier":"2509.11328","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingyuan","familyName":"Meng","name":"Meng, Mingyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward Next-generation Medical Vision Backbones: Modeling Finer-grained Long-range Visual Dependency"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T16:14:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:48:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Medical Image Computing (MIC) is a broad research topic covering both pixel-wise (e.g., segmentation, registration) and image-wise (e.g., classification, regression) vision tasks. Effective analysis demands models that capture both global long-range context and local subtle visual characteristics, necessitating fine-grained long-range visual dependency modeling. Compared to Convolutional Neural Networks (CNNs) that are limited by intrinsic locality, transformers excel at long-range modeling; however, due to the high computational loads of self-attention, transformers typically cannot process high-resolution features (e.g., full-scale image features before downsampling or patch embedding) and thus face difficulties in modeling fine-grained dependency among subtle medical image details. Concurrently, Multi-layer Perceptron (MLP)-based visual models are recognized as computation/memory-efficient alternatives in modeling long-range visual dependency but have yet to be widely investigated in the MIC community. This doctoral research advances deep learning-based MIC by investigating effective long-range visual dependency modeling. It first presents innovative use of transformers for both pixel- and image-wise medical vision tasks. The focus then shifts to MLPs, pioneeringly developing MLP-based visual models to capture fine-grained long-range visual dependency in medical images. Extensive experiments confirm the critical role of long-range dependency modeling in MIC and reveal a key finding: MLPs provide feasibility in modeling finer-grained long-range dependency among higher-resolution medical features containing enriched anatomical/pathological details. This finding establishes MLPs as a superior paradigm over transformers/CNNs, consistently enhancing performance across various medical vision tasks and paving the way for next-generation medical vision backbones."},{"descriptionType":"Other","description":"Invited as Long Oral Presentation (Top 8) at MICCAI 2025 Doctoral Consortium"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11328","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:05Z","registered":"2025-09-16T03:00:06Z","published":null,"updated":"2025-09-16T03:00:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11348","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11348","identifiers":[{"identifier":"2509.11348","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Viet-Hoang","familyName":"Tran","name":"Tran, Viet-Hoang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Van Hoan","familyName":"Trinh","name":"Trinh, Van Hoan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khanh Vinh","familyName":"Bui","name":"Bui, Khanh Vinh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tan M.","familyName":"Nguyen","name":"Nguyen, Tan M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Linear Mode Connectivity of Mixture-of-Experts Architectures"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T16:51:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:49:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-25T03:12:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-28T00:23:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Linear Mode Connectivity (LMC) is a notable phenomenon in the loss landscapes of neural networks, wherein independently trained models have been observed to be connected--up to permutation symmetries--by linear paths in parameter space along which the loss remains consistently low. This observation challenges classical views of non-convex optimization and has implications for model ensembling, generalization, and our understanding of neural loss geometry. Inspired by recent studies on LMC in standard neural networks, we systematically investigate this phenomenon within Mixture-of-Experts (MoE) architectures--a class of models known for their scalability and computational efficiency, which combine traditional neural networks--referred to as experts--through a learnable gating mechanism. We begin by conducting a comprehensive analysis of both dense and sparse gating regimes, demonstrating that the symmetries inherent to MoE architectures are fully characterized by permutations acting on both the expert components and the gating function. Building on these foundational findings, we propose a matching algorithm that enables alignment between independently trained MoEs, thereby facilitating the discovery of LMC. Finally, we empirically validate the presence of LMC using our proposed algorithm across diverse MoE configurations--including dense, sparse, and shared-expert variants--under a wide range of model settings and datasets of varying scales and modalities. Our results confirm the existence of LMC in MoE architectures and offer fundamental insights into the functional landscape and optimization dynamics of deep learning models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11348","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:36Z","registered":"2025-09-16T03:00:37Z","published":null,"updated":"2025-10-28T04:02:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11353","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11353","identifiers":[{"identifier":"2509.11353","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanpei","familyName":"Fang","name":"Fang, Hanpei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sijie","familyName":"Tao","name":"Tao, Sijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nuo","familyName":"Chen","name":"Chen, Nuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai-Xin","familyName":"Chang","name":"Chang, Kai-Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tetsuya","familyName":"Sakai","name":"Sakai, Tetsuya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do Large Language Models Favor Recent Content? A Study on Recency Bias in LLM-Based Reranking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T17:11:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:49:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-21T16:59:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-22T02:16:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are increasingly deployed in information systems, including being used as second-stage rerankers in information retrieval pipelines, yet their susceptibility to recency bias has received little attention. We investigate whether LLMs implicitly favour newer documents by prepending artificial publication dates to passages in the TREC Deep Learning passage retrieval collections in 2021 (DL21) and 2022 (DL22). Across seven models, GPT-3.5-turbo, GPT-4o, GPT-4, LLaMA-3 8B/70B, and Qwen-2.5 7B/72B, \"fresh\" passages are consistently promoted, shifting the Top-10's mean publication year forward by up to 4.78 years and moving individual items by as many as 95 ranks in our listwise reranking experiments. Although larger models attenuate the effect, none eliminate it. We also observe that the preference of LLMs between two passages with an identical relevance level can be reversed by up to 25% on average after date injection in our pairwise preference experiments. These findings provide quantitative evidence of a pervasive recency bias in LLMs and highlight the importance of effective bias-mitigation strategies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11353","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:43Z","registered":"2025-09-16T03:00:44Z","published":null,"updated":"2026-09-22T04:42:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11361","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11361","identifiers":[{"identifier":"2509.11361","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yichen","familyName":"Han","name":"Han, Yichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Han","name":"Han, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siteng","familyName":"Huang","name":"Huang, Siteng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanyu","familyName":"Liu","name":"Liu, Guanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengpeng","familyName":"Zhou","name":"Zhou, Zhengpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bojun","familyName":"Liu","name":"Liu, Bojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujia","familyName":"Zhang","name":"Zhang, Yujia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isaac N","familyName":"Shi","name":"Shi, Isaac N","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lewei","familyName":"He","name":"He, Lewei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Shi","name":"Shi, Tianyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MAPGD: Multi-Agent Prompt Gradient Descent for Collaborative Prompt Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T17:28:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:49:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-07T09:25:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-08T00:35:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-03T09:31:40Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-04T01:46:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Prompt engineering is crucial for fully leveraging large language models (LLMs), yet most existing optimization methods follow a single trajectory, resulting in limited adaptability, gradient conflicts, and high computational overhead. We propose MAPGD (Multi-Agent Prompt Gradient Descent), a novel framework that reconceptualizes prompt optimization as a collaborative process among specialized agents. Each agent focuses on a distinct refinement dimension, such as instruction clarity, example selection, format structure, or stylistic adaptation, and their contributions are coordinated through semantic gradient embedding, conflict detection, and fusion. To further enhance robustness and stability, MAPGD introduces two new mechanisms: Hypersphere Constrained Gradient Clustering (HCGC), which enforces angular margin constraints for compact and well-separated clusters, and Channel Adaptive Agent Weighting (CAAW), which dynamically reweights agent contributions based on validation performance. Experiments on classification and reasoning benchmarks show that MAPGD consistently surpasses single-agent and random baselines in both accuracy and efficiency. Ablation studies confirm the effectiveness of gradient fusion, agent specialization, and conflict resolution. Together, these components establish MAPGD as a unified, gradient-based, and interpretable framework for robust prompt optimization with theoretical convergence guarantees."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11361","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:54Z","registered":"2025-09-16T03:00:55Z","published":null,"updated":"2026-02-04T03:40:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11374","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11374","identifiers":[{"identifier":"2509.11374","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bowen","familyName":"Jing","name":"Jing, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Cui","name":"Cui, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianpeng","familyName":"Huang","name":"Huang, Tianpeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transformer Enhanced Relation Classification: A Comparative Analysis of Contextuality, Data Efficiency and Sequence Complexity"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T18:11:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:50:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In the era of large language model, relation extraction (RE) plays an important role in information extraction through the transformation of unstructured raw text into structured data (Wadhwa et al., 2023). In this paper, we systematically compare the performance of deep supervised learning approaches without transformers and those with transformers. We used a series of non-transformer architectures such as PA-LSTM(Zhang et al., 2017), C-GCN(Zhang et al., 2018), and AGGCN(attention guide GCN)(Guo et al., 2019), and a series of transformer architectures such as BERT, RoBERTa, and R-BERT(Wu and He, 2019). Our comparison included traditional metrics like micro F1, as well as evaluations in different scenarios, varying sentence lengths, and different percentages of the dataset for training. Our experiments were conducted on TACRED, TACREV, and RE-TACRED. The results show that transformer-based models outperform non-transformer models, achieving micro F1 scores of 80-90% compared to 64-67% for non-transformer models. Additionally, we briefly review the research journey in supervised relation classification and discuss the role and current status of large language models (LLMs) in relation extraction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11374","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:01:12Z","registered":"2025-09-16T03:01:13Z","published":null,"updated":"2025-09-16T03:01:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11376","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11376","identifiers":[{"identifier":"2509.11376","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seyed Kourosh","familyName":"Mahjour","name":"Mahjour, Seyed Kourosh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seyed Saman","familyName":"Mahjour","name":"Mahjour, Seyed Saman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Intelligent Reservoir Decision Support: An Integrated Framework Combining Large Language Models, Advanced Prompt Engineering, and Multimodal Data Fusion for Real-Time Petroleum Operations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T18:13:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:50:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The petroleum industry faces unprecedented challenges in reservoir management, requiring rapid integration of complex multimodal datasets for real-time decision support. This study presents a novel integrated framework combining state-of-the-art large language models (GPT-4o, Claude 4 Sonnet, Gemini 2.5 Pro) with advanced prompt engineering techniques and multimodal data fusion for comprehensive reservoir analysis. The framework implements domain-specific retrieval-augmented generation (RAG) with over 50,000 petroleum engineering documents, chain-of-thought reasoning, and few-shot learning for rapid field adaptation. Multimodal integration processes seismic interpretations, well logs, and production data through specialized AI models with vision transformers. Field validation across 15 diverse reservoir environments demonstrates exceptional performance: 94.2% reservoir characterization accuracy, 87.6% production forecasting precision, and 91.4% well placement optimization success rate. The system achieves sub-second response times while maintaining 96.2% safety reliability with no high-risk incidents during evaluation. Economic analysis reveals 62-78% cost reductions (mean 72%) relative to traditional methods with 8-month payback period. Few-shot learning reduces field adaptation time by 72%, while automated prompt optimization achieves 89% improvement in reasoning quality. The framework processed real-time data streams with 96.2% anomaly detection accuracy and reduced environmental incidents by 45%. We provide detailed experimental protocols, baseline comparisons, ablation studies, and statistical significance testing to ensure reproducibility. This research demonstrates practical integration of cutting-edge AI technologies with petroleum domain expertise for enhanced operational efficiency, safety, and economic performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11376","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:01:15Z","registered":"2025-09-16T03:01:15Z","published":null,"updated":"2025-09-16T03:01:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11394","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11394","identifiers":[{"identifier":"2509.11394","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Syed Talal","familyName":"Wasim","name":"Wasim, Syed Talal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hamid","familyName":"Suleman","name":"Suleman, Hamid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Olga","familyName":"Zatsarynna","name":"Zatsarynna, Olga","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muzammal","familyName":"Naseer","name":"Naseer, Muzammal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juergen","familyName":"Gall","name":"Gall, Juergen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MixANT: Observation-dependent Memory Propagation for Stochastic Dense Action Anticipation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T19:07:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:51:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present MixANT, a novel architecture for stochastic long-term dense anticipation of human activities. While recent State Space Models (SSMs) like Mamba have shown promise through input-dependent selectivity on three key parameters, the critical forget-gate ($\\textbf{A}$ matrix) controlling temporal memory remains static. We address this limitation by introducing a mixture of experts approach that dynamically selects contextually relevant $\\textbf{A}$ matrices based on input features, enhancing representational capacity without sacrificing computational efficiency. Extensive experiments on the 50Salads, Breakfast, and Assembly101 datasets demonstrate that MixANT consistently outperforms state-of-the-art methods across all evaluation settings. Our results highlight the importance of input-dependent forget-gate mechanisms for reliable prediction of human behavior in diverse real-world scenarios."},{"descriptionType":"Other","description":"Accepted to ICCV 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11394","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:01:40Z","registered":"2025-09-16T03:01:40Z","published":null,"updated":"2025-09-16T03:01:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11413","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11413","identifiers":[{"identifier":"2509.11413","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Grigori","familyName":"Fursin","name":"Fursin, Grigori","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Altunay","name":"Altunay, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Framing AI System Benchmarking as a Learning Task: FlexBench and the Open MLPerf Dataset"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T20:02:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:52:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing AI system benchmarks such as MLPerf often struggle to keep pace with the rapidly evolving AI landscape, making it difficult to support informed deployment, optimization, and co-design decisions for AI systems. We suggest that benchmarking itself can be framed as an AI task - one in which models are continuously evaluated and optimized across diverse datasets, software, and hardware, using key metrics such as accuracy, latency, throughput, energy consumption, and cost. To support this perspective, we present FlexBench: a modular extension of the MLPerf LLM inference benchmark, integrated with HuggingFace and designed to provide relevant and actionable insights. Benchmarking results and metadata are collected into an Open MLPerf Dataset, which can be collaboratively curated, extended, and leveraged for predictive modeling and feature engineering. We successfully validated the FlexBench concept through MLPerf Inference submissions, including evaluations of DeepSeek R1 and LLaMA 3.3 on commodity servers. The broader objective is to enable practitioners to make cost-effective AI deployment decisions that reflect their available resources, requirements, and constraints."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11413","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:02:06Z","registered":"2025-09-16T03:02:07Z","published":null,"updated":"2025-09-16T03:02:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11414","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11414","identifiers":[{"identifier":"2509.11414","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abraham Toluwase","familyName":"Owodunni","name":"Owodunni, Abraham Toluwase","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sachin","familyName":"Kumar","name":"Kumar, Sachin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Continually Adding New Languages to Multilingual Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T20:08:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:52:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multilingual language models are trained on a fixed set of languages, and to support new languages, the models need to be retrained from scratch. This is an expensive endeavor and is often infeasible, as model developers tend not to release their pre-training data. Naive approaches, such as continued pretraining, suffer from catastrophic forgetting; however, mitigation strategies like experience replay cannot be applied due to the lack of original pretraining data. In this work, we investigate the problem of continually adding new languages to a multilingual model, assuming access to pretraining data in only the target languages. We explore multiple approaches to address this problem and propose Layer-Selective LoRA (LayRA), which adds Low-Rank Adapters (LoRA) to selected initial and final layers while keeping the rest of the model frozen. LayRA builds on two insights: (1) LoRA reduces forgetting, and (2) multilingual models encode inputs in the source language in the initial layers, reason in English in intermediate layers, and translate back to the source language in final layers. We experiment with adding multiple combinations of Galician, Swahili, and Urdu to pretrained language models and evaluate each method on diverse multilingual tasks. We find that LayRA provides the overall best tradeoff between preserving models' capabilities in previously supported languages, while being competitive with existing approaches such as LoRA in learning new languages. We also demonstrate that using model arithmetic, the adapted models can be equipped with strong instruction following abilities without access to any instruction tuning data in the target languages."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11414","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:02:07Z","registered":"2025-09-16T03:02:08Z","published":null,"updated":"2025-09-16T03:02:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11417","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11417","identifiers":[{"identifier":"2509.11417","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shresth","familyName":"Grover","name":"Grover, Shresth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akshay","familyName":"Gopalkrishnan","name":"Gopalkrishnan, Akshay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Ai","name":"Ai, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Henrik I.","familyName":"Christensen","name":"Christensen, Henrik I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Su","name":"Su, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanlin","familyName":"Li","name":"Li, Xuanlin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Generalization in Vision-Language-Action Models by Preserving Pretrained Representations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T20:08:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:52:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T02:41:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:18:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-language-action (VLA) models finetuned from vision-language models (VLMs) hold the promise of leveraging rich pretrained representations to build generalist robots across diverse tasks and environments. However, direct fine-tuning on robot data often disrupts these representations and limits generalization. We present a framework that better preserves pretrained features while adapting them for robot manipulation. Our approach introduces three components: (i) a dual-encoder design with one frozen vision encoder to retain pretrained features and another trainable for task adaptation, (ii) a string-based action tokenizer that casts continuous actions into character sequences aligned with the model's pretraining domain, and (iii) a co-training strategy that combines robot demonstrations with vision-language datasets emphasizing spatial reasoning and affordances. Evaluations in simulation and on real robots show that our method improves robustness to visual perturbations, generalization to novel instructions and environments, and overall task success compared to baselines."},{"descriptionType":"Other","description":"Project Page: https://gen-vla.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11417","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:02:12Z","registered":"2025-09-16T03:02:12Z","published":null,"updated":"2025-09-18T17:44:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11420","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11420","identifiers":[{"identifier":"2509.11420","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yijia","familyName":"Xiao","name":"Xiao, Yijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edward","familyName":"Sun","name":"Sun, Edward","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tong","familyName":"Chen","name":"Chen, Tong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fang","familyName":"Wu","name":"Wu, Fang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Luo","name":"Luo, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wang","name":"Wang, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Trading-R1: Financial Trading with LLM Reasoning via Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Trading and Market Microstructure (q-fin.TR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T20:13:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:52:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Developing professional, structured reasoning on par with human financial analysts and traders remains a central challenge in AI for finance, where markets demand interpretability and trust. Traditional time-series models lack explainability, while LLMs face challenges in turning natural-language analysis into disciplined, executable trades. Although reasoning LLMs have advanced in step-by-step planning and verification, their application to risk-sensitive financial decisions is underexplored. We present Trading-R1, a financially-aware model that incorporates strategic thinking and planning for comprehensive thesis composition, facts-grounded analysis, and volatility-adjusted decision making. Trading-R1 aligns reasoning with trading principles through supervised fine-tuning and reinforcement learning with a three-stage easy-to-hard curriculum. Training uses Tauric-TR1-DB, a 100k-sample corpus spanning 18 months, 14 equities, and five heterogeneous financial data sources. Evaluated on six major equities and ETFs, Trading-R1 demonstrates improved risk-adjusted returns and lower drawdowns compared to both open-source and proprietary instruction-following models as well as reasoning models. The system generates structured, evidence-based investment theses that support disciplined and interpretable trading decisions. Trading-R1 Terminal will be released at https://github.com/TauricResearch/Trading-R1."},{"descriptionType":"Other","description":"Tauric Research: https://github.com/TauricResearch"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11420","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:02:16Z","registered":"2025-09-16T03:02:17Z","published":null,"updated":"2025-09-16T03:02:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11431","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11431","identifiers":[{"identifier":"2509.11431","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aadil Gani","familyName":"Ganie","name":"Ganie, Aadil Gani","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Securing AI Agents: Implementing Role-Based Access Control for Industrial Applications"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T20:58:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:53:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The emergence of Large Language Models (LLMs) has significantly advanced solutions across various domains, from political science to software development. However, these models are constrained by their training data, which is static and limited to information available up to a specific date. Additionally, their generalized nature often necessitates fine-tuning -- whether for classification or instructional purposes -- to effectively perform specific downstream tasks. AI agents, leveraging LLMs as their core, mitigate some of these limitations by accessing external tools and real-time data, enabling applications such as live weather reporting and data analysis. In industrial settings, AI agents are transforming operations by enhancing decision-making, predictive maintenance, and process optimization. For example, in manufacturing, AI agents enable near-autonomous systems that boost productivity and support real-time decision-making. Despite these advancements, AI agents remain vulnerable to security threats, including prompt injection attacks, which pose significant risks to their integrity and reliability. To address these challenges, this paper proposes a framework for integrating Role-Based Access Control (RBAC) into AI agents, providing a robust security guardrail. This framework aims to support the effective and scalable deployment of AI agents, with a focus on on-premises implementations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11431","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:02:31Z","registered":"2025-09-16T03:02:31Z","published":null,"updated":"2025-09-16T03:02:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11442","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11442","identifiers":[{"identifier":"2509.11442","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ayhan Can","familyName":"Erdur","name":"Erdur, Ayhan Can","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Beischl","name":"Beischl, Christian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Scholz","name":"Scholz, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiazhen","familyName":"Pan","name":"Pan, Jiazhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benedikt","familyName":"Wiestler","name":"Wiestler, Benedikt","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Rueckert","name":"Rueckert, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan C","familyName":"Peeken","name":"Peeken, Jan C","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MultiMAE for Brain MRIs: Robustness to Missing Inputs Using Multi-Modal Masked Autoencoder"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T21:33:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:54:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-10T07:30:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-04T02:04:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/978-3-032-09513-8_55","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Missing input sequences are common in medical imaging data, posing a challenge for deep learning models reliant on complete input data. In this work, inspired by MultiMAE [2], we develop a masked autoencoder (MAE) paradigm for multi-modal, multi-task learning in 3D medical imaging with brain MRIs. Our method treats each MRI sequence as a separate input modality, leveraging a late-fusion-style transformer encoder to integrate multi-sequence information (multi-modal) and individual decoder streams for each modality for multi-task reconstruction. This pretraining strategy guides the model to learn rich representations per modality while also equipping it to handle missing inputs through cross-sequence reasoning. The result is a flexible and generalizable encoder for brain MRIs that infers missing sequences from available inputs and can be adapted to various downstream applications. We demonstrate the performance and robustness of our method against an MAE-ViT baseline in downstream segmentation and classification tasks, showing absolute improvement of $10.1$ overall Dice score and $0.46$ MCC over the baselines with missing input sequences. Our experiments demonstrate the strength of this pretraining strategy. The implementation is made available."},{"descriptionType":"Other","description":"Official implementation: https://github.com/chris-beischl/multimae-for-brain-mri"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11442","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:02:46Z","registered":"2025-09-16T03:02:47Z","published":null,"updated":"2026-02-04T03:40:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11443","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11443","identifiers":[{"identifier":"2509.11443","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Gaurab","familyName":"Chhetri","name":"Chhetri, Gaurab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Darrell","familyName":"Anderson","name":"Anderson, Darrell","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boniphace","familyName":"Kutela","name":"Kutela, Boniphace","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Subasish","familyName":"Das","name":"Das, Subasish","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Transformer-Based Cross-Platform Analysis of Public Discourse on the 15-Minute City Paradigm"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Social and Information Networks (cs.SI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T21:36:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-29T00:08:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icmla66185.2025.00062","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This study presents the first multi-platform sentiment analysis of public opinion on the 15-minute city concept across Twitter, Reddit, and news media. Using compressed transformer models and Llama-3-8B for annotation, we classify sentiment across heterogeneous text domains. Our pipeline handles long-form and short-form text, supports consistent annotation, and enables reproducible evaluation. We benchmark five models (DistilRoBERTa, DistilBERT, MiniLM, ELECTRA, TinyBERT) using stratified 5-fold cross-validation, reporting F1-score, AUC, and training time. DistilRoBERTa achieved the highest F1 (0.8292), TinyBERT the best efficiency, and MiniLM the best cross-platform consistency. Results show News data yields inflated performance due to class imbalance, Reddit suffers from summarization loss, and Twitter offers moderate challenge. Compressed models perform competitively, challenging assumptions that larger models are necessary. We identify platform-specific trade-offs and propose directions for scalable, real-world sentiment classification in urban planning discourse."},{"descriptionType":"Other","description":"This is the author's preprint version of a paper accepted for presentation at the 24th International Conference on Machine Learning and Applications (ICMLA 2025), December 3-5, 2025, Florida, USA. The final published version will appear in the official IEEE proceedings. Conference site: https://www.icmla-conference.org/icmla25/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11443","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:02:48Z","registered":"2025-09-16T03:02:48Z","published":null,"updated":"2026-04-29T02:31:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11449","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11449","identifiers":[{"identifier":"2509.11449","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shriyank","familyName":"Somvanshi","name":"Somvanshi, Shriyank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pavan","familyName":"Hebli","name":"Hebli, Pavan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaurab","familyName":"Chhetri","name":"Chhetri, Gaurab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Subasish","familyName":"Das","name":"Das, Subasish","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tabular Data with Class Imbalance: Predicting Electric Vehicle Crash Severity with Pretrained Transformers (TabPFN) and Mamba-Based Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T21:46:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-29T00:08:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icmla66185.2025.00222","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This study presents a deep tabular learning framework for predicting crash severity in electric vehicle (EV) collisions using real-world crash data from Texas (2017-2023). After filtering for electric-only vehicles, 23,301 EV-involved crash records were analyzed. Feature importance techniques using XGBoost and Random Forest identified intersection relation, first harmful event, person age, crash speed limit, and day of week as the top predictors, along with advanced safety features like automatic emergency braking. To address class imbalance, Synthetic Minority Over-sampling Technique and Edited Nearest Neighbors (SMOTEENN) resampling was applied. Three state-of-the-art deep tabular models, TabPFN, MambaNet, and MambaAttention, were benchmarked for severity prediction. While TabPFN demonstrated strong generalization, MambaAttention achieved superior performance in classifying severe injury cases due to its attention-based feature reweighting. The findings highlight the potential of deep tabular architectures for improving crash severity prediction and enabling data-driven safety interventions in EV crash contexts."},{"descriptionType":"Other","description":"This is the author's preprint version of a paper accepted for presentation at the 24th International Conference on Machine Learning and Applications (ICMLA 2025), December 3-5, 2025, Florida, USA. The final published version will appear in the official IEEE proceedings. Conference site: https://www.icmla-conference.org/icmla25/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11449","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:02:56Z","registered":"2025-09-16T03:02:57Z","published":null,"updated":"2026-04-29T02:31:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11451","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11451","identifiers":[{"identifier":"2509.11451","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ahaan","familyName":"Dabholkar","name":"Dabholkar, Ahaan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Atul","familyName":"Sharma","name":"Sharma, Atul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Z. Berkay","familyName":"Celik","name":"Celik, Z. Berkay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saurabh","familyName":"Bagchi","name":"Bagchi, Saurabh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MAUI: Reconstructing Private Client Data in Federated Transfer Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T21:52:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:54:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent works in federated learning (FL) have shown the utility of leveraging transfer learning for balancing the benefits of FL and centralized learning. In this setting, federated training happens after a stable point has been reached through conventional training. Global model weights are first centrally pretrained by the server on a public dataset following which only the last few linear layers (the classification head) of the model are finetuned across clients. In this scenario, existing data reconstruction attacks (DRAs) in FL show two key weaknesses. First, strongly input-correlated gradient information from the initial model layers is never shared, significantly degrading reconstruction accuracy. Second, DRAs in which the server makes highly specific, handcrafted manipulations to the model structure or parameters (for e.g., layers with all zero weights, identity mappings and rows with identical weight patterns) are easily detectable by an active client.\n Improving on these, we propose MAUI, a stealthy DRA that does not require any overt manipulations to the model architecture or weights, and relies solely on the gradients of the classification head. MAUI first extracts \"robust\" feature representations of the input batch from the gradients of the classification head and subsequently inverts these representations to the original inputs. We report highly accurate reconstructions on the CIFAR10 and ImageNet datasets on a variety of model architectures including convolution networks (CNN, VGG11), ResNets (18, 50), ShuffleNet-V2 and Vision Transformer (ViT B-32), regardless of the batch size. MAUI significantly outperforms prior DRAs in reconstruction quality, achieving 40-120% higher PSNR scores."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11451","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:02:58Z","registered":"2025-09-16T03:02:59Z","published":null,"updated":"2025-09-16T03:02:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11452","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11452","identifiers":[{"identifier":"2509.11452","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yining","familyName":"Lu","name":"Lu, Yining","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zilong","familyName":"Wang","name":"Wang, Zilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiyang","familyName":"Li","name":"Li, Shiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Liu","name":"Liu, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changlong","familyName":"Yu","name":"Yu, Changlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyu","familyName":"Yin","name":"Yin, Qingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhan","familyName":"Shi","name":"Shi, Zhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixuan","familyName":"Zhang","name":"Zhang, Zixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Jiang","name":"Jiang, Meng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning to Optimize Multi-Objective Alignment Through Dynamic Reward Weighting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T21:56:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:54:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-30T18:06:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-01T00:02:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Prior work in multi-objective reinforcement learning typically uses linear reward scalarization with fixed weights, which provably fails to capture non-convex Pareto fronts and thus yields suboptimal results. This limitation becomes especially critical in online preference alignment for large language models. Here, stochastic trajectories generated by parameterized policies create highly non-linear and non-convex mappings from parameters to objectives that no single static weighting scheme can find optimal trade-offs. We address this limitation by introducing dynamic reward weighting, which adaptively adjusts reward weights during the online reinforcement learning process. Unlike existing approaches that rely on fixed-weight interpolation, our dynamic weighting continuously balances and prioritizes objectives in training, facilitating effective exploration of Pareto fronts in objective space. We introduce two approaches of increasing sophistication and generalizability: hypervolume-guided weight adaptation and gradient-based weight optimization, offering a versatile toolkit for online multi-objective alignment. Our extensive experiments demonstrate their compatibility with commonly used online reinforcement learning algorithms, effectiveness across multiple datasets, and applicability to different model families, consistently achieving Pareto dominant solutions with fewer training steps than fixed-weight linear scalarization baselines."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11452","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:03:00Z","registered":"2025-09-16T03:03:01Z","published":null,"updated":"2026-04-01T02:30:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11465","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11465","identifiers":[{"identifier":"2509.11465","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amirhossein","familyName":"Abaskohi","name":"Abaskohi, Amirhossein","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raymond","familyName":"Li","name":"Li, Raymond","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuyuan","familyName":"Li","name":"Li, Chuyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shafiq","familyName":"Joty","name":"Joty, Shafiq","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe","familyName":"Carenini","name":"Carenini, Giuseppe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CEMTM: Contextual Embedding-based Multimodal Topic Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T23:07:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:55:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-05T16:11:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T01:00:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce CEMTM, a context-enhanced multimodal topic model designed to infer coherent and interpretable topic structures from both short and long documents containing text and images. CEMTM builds on fine-tuned large vision language models (LVLMs) to obtain contextualized embeddings, and employs a distributional attention mechanism to weight token-level contributions to topic inference. A reconstruction objective aligns topic-based representations with the document embedding, encouraging semantic consistency across modalities. Unlike existing approaches, CEMTM can process multiple images per document without repeated encoding and maintains interpretability through explicit word-topic and document-topic distributions. Extensive experiments on six multimodal benchmarks show that CEMTM consistently outperforms unimodal and multimodal baselines, achieving a remarkable average LLM score of 2.61. Further analysis shows its effectiveness in downstream few-shot retrieval and its ability to capture visually grounded semantics in complex domains such as scientific articles."},{"descriptionType":"Other","description":"EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11465","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:03:19Z","registered":"2025-09-16T03:03:19Z","published":null,"updated":"2025-10-07T03:49:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11466","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11466","identifiers":[{"identifier":"2509.11466","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yujian","familyName":"Gan","name":"Gan, Yujian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Liang","name":"Liang, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanni","familyName":"Lin","name":"Lin, Yanni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juntao","familyName":"Yu","name":"Yu, Juntao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Massimo","familyName":"Poesio","name":"Poesio, Massimo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improving LLMs' Learning for Coreference Resolution"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T23:08:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:55:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Coreference Resolution (CR) is crucial for many NLP tasks, but existing LLMs struggle with hallucination and under-performance. In this paper, we investigate the limitations of existing LLM-based approaches to CR-specifically the Question-Answering (QA) Template and Document Template methods and propose two novel techniques: Reversed Training with Joint Inference and Iterative Document Generation. Our experiments show that Reversed Training improves the QA Template method, while Iterative Document Generation eliminates hallucinations in the generated source text and boosts coreference resolution. Integrating these methods and techniques offers an effective and robust solution to LLM-based coreference resolution."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11466","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:03:20Z","registered":"2025-09-16T03:03:21Z","published":null,"updated":"2025-09-16T03:03:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11480","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11480","identifiers":[{"identifier":"2509.11480","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amir","familyName":"Taherin","name":"Taherin, Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juyi","familyName":"Lin","name":"Lin, Juyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arash","familyName":"Akbari","name":"Akbari, Arash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arman","familyName":"Akbari","name":"Akbari, Arman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pu","familyName":"Zhao","name":"Zhao, Pu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiwei","familyName":"Chen","name":"Chen, Weiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Kaeli","name":"Kaeli, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanzhi","familyName":"Wang","name":"Wang, Yanzhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cross-Platform Scaling of Vision-Language-Action Models from Edge to Cloud GPUs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T00:00:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:56:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-26T15:57:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-27T02:36:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language-Action (VLA) models have emerged as powerful generalist policies for robotic control, yet their performance scaling across model architectures and hardware platforms, as well as their associated power budgets, remain poorly understood. This work presents an evaluation of five representative VLA models -- spanning state-of-the-art baselines and two newly proposed architectures -- targeting edge and datacenter GPU platforms. Using the LIBERO benchmark, we measure accuracy alongside system-level metrics, including latency, throughput, and peak memory usage, under varying edge power constraints and high-performance datacenter GPU configurations. Our results identify distinct scaling trends: (1) architectural choices, such as action tokenization and model backbone size, strongly influence throughput and memory footprint; (2) power-constrained edge devices exhibit non-linear performance degradation, with some configurations matching or exceeding older datacenter GPUs; and (3) high-throughput variants can be achieved without significant accuracy loss. These findings provide actionable insights when selecting and optimizing VLAs across a range of deployment constraints. Our work challenges current assumptions about the superiority of datacenter hardware for robotic inference."},{"descriptionType":"Other","description":"To appear in the Asilomar Conference on Signals, Systems, and Computers 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11480","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:03:40Z","registered":"2025-09-16T03:03:41Z","published":null,"updated":"2026-01-27T04:34:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11492","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11492","identifiers":[{"identifier":"2509.11492","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anirban Saha","familyName":"Anik","name":"Anik, Anirban Saha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md Fahimul Kabir","familyName":"Chowdhury","name":"Chowdhury, Md Fahimul Kabir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Wyckoff","name":"Wyckoff, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sagnik Ray","familyName":"Choudhury","name":"Choudhury, Sagnik Ray","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ClaimIQ at CheckThat! 2025: Comparing Prompted and Fine-Tuned Language Models for Verifying Numerical Claims"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T01:03:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:57:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents our system for Task 3 of the CLEF 2025 CheckThat! Lab, which focuses on verifying numerical and temporal claims using retrieved evidence. We explore two complementary approaches: zero-shot prompting with instruction-tuned large language models (LLMs) and supervised fine-tuning using parameter-efficient LoRA. To enhance evidence quality, we investigate several selection strategies, including full-document input and top-k sentence filtering using BM25 and MiniLM. Our best-performing model LLaMA fine-tuned with LoRA achieves strong performance on the English validation set. However, a notable drop in the test set highlights a generalization challenge. These findings underscore the importance of evidence granularity and model adaptation for robust numerical fact verification."},{"descriptionType":"Other","description":"Notebook for the CheckThat! Lab at CLEF 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11492","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:03:57Z","registered":"2025-09-16T03:03:57Z","published":null,"updated":"2025-09-16T03:03:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11496","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11496","identifiers":[{"identifier":"2509.11496","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fabrycio Leite Nakano","familyName":"Almada","name":"Almada, Fabrycio Leite Nakano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kauan Divino Pouso","familyName":"Mariano","name":"Mariano, Kauan Divino Pouso","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maykon Adriell","familyName":"Dutra","name":"Dutra, Maykon Adriell","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor Emanuel da Silva","familyName":"Monteiro","name":"Monteiro, Victor Emanuel da Silva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juliana Resplande Sant'Anna","familyName":"Gomes","name":"Gomes, Juliana Resplande Sant'Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arlindo Rodrigues Galvão","familyName":"Filho","name":"Filho, Arlindo Rodrigues Galvão","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anderson da Silva","familyName":"Soares","name":"Soares, Anderson da Silva","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AKCIT-FN at CheckThat! 2025: Switching Fine-Tuned SLMs and LLM Prompting for Multilingual Claim Normalization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T01:19:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:57:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Claim normalization, the transformation of informal social media posts into concise, self-contained statements, is a crucial step in automated fact-checking pipelines. This paper details our submission to the CLEF-2025 CheckThat! Task~2, which challenges systems to perform claim normalization across twenty languages, divided into thirteen supervised (high-resource) and seven zero-shot (no training data) tracks.\n Our approach, leveraging fine-tuned Small Language Models (SLMs) for supervised languages and Large Language Model (LLM) prompting for zero-shot scenarios, achieved podium positions (top three) in fifteen of the twenty languages. Notably, this included second-place rankings in eight languages, five of which were among the seven designated zero-shot languages, underscoring the effectiveness of our LLM-based zero-shot strategy. For Portuguese, our initial development language, our system achieved an average METEOR score of 0.5290, ranking third. All implementation artifacts, including inference, training, evaluation scripts, and prompt configurations, are publicly available at https://github.com/ju-resplande/checkthat2025_normalization."},{"descriptionType":"Other","description":"15 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11496","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:04:02Z","registered":"2025-09-16T03:04:03Z","published":null,"updated":"2025-09-16T03:04:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11517","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11517","identifiers":[{"identifier":"2509.11517","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rodrigo M.","familyName":"Carrillo-Larco","name":"Carrillo-Larco, Rodrigo M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jesus Lovón","familyName":"Melgarejo","name":"Melgarejo, Jesus Lovón","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manuel","familyName":"Castillo-Cara","name":"Castillo-Cara, Manuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gusseppe","familyName":"Bravo-Rocca","name":"Bravo-Rocca, Gusseppe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PeruMedQA: Benchmarking Large Language Models (LLMs) on Peruvian Medical Exams -- Dataset Construction and Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T02:07:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T03:01:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-25T16:04:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-10T00:22:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/s40670-026-02692-w","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"BACKGROUND: Medical large language models (LLMs) have demonstrated remarkable performance in answering medical examinations. However, the extent to which this high performance is transferable to medical questions in Spanish and from a Latin American country remains unexplored. This knowledge is crucial as LLM-based medical applications gain traction in Latin America. AIMS: To build a dataset of questions medical examinations taken by Peruvian physicians pursuing specialty training; to fine-tune a LLM on this dataset; to evaluate and compare the performance in terms of accuracy between vanilla LLMs and the fine-tuned LLM. METHODS: We curated PeruMedQA, a multiple-choice question-answering (MCQA) dataset containing 8,380 questions spanning 12 specialties (2018-2025). We selected ten medical LLMs, including medgemma-4b-it and medgemma-27b-text-it, and developed zero-shot task specific prompts to answer the questions. We employed parameter-efficient fine tuning (PEFT) and low-rand adaptation (LoRA) to fine-tune medgemma-4b-it utilizing all questions except those from 2025 (test set). RESULTS: Medgemma-27b showed the highest accuracy across all specialities, achieving the highest score of 89.29% in Psychiatry; yet, in two specialties, OctoMed-7B exhibited slight superiority: Neurosurgery with 77.27% and 77.38, respectively; and Radiology with 76.13% and 77.39%, respectively. Across specialties, most LLMs with \u0026lt;10 billion parameters exhibited \u0026lt;50% of correct answers. The fine-tuned version of medgemma-4b-it emerged victorious against all LLMs with \u0026lt;10 billion parameters and rivaled a LLM with 70 billion parameters across various examinations. CONCLUSIONS: For medical AI applications and research that require knowledge bases from Spanish-speaking countries and those exhibiting similar epidemiological profile to Peru's, interested parties should utilize medgemma-27b-text-it."},{"descriptionType":"Other","description":"https://github.com/rodrigo-carrillo/PeruMedQA"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11517","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:04:32Z","registered":"2025-09-16T03:04:33Z","published":null,"updated":"2026-06-10T02:29:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11524","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11524","identifiers":[{"identifier":"2509.11524","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chengbing","familyName":"Wang","name":"Wang, Chengbing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhang","name":"Zhang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhicheng","familyName":"Wang","name":"Wang, Zhicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianhao","familyName":"Shi","name":"Shi, Tianhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keqin","familyName":"Bao","name":"Bao, Keqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuli","familyName":"Feng","name":"Feng, Fuli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tat-Seng","familyName":"Chua","name":"Chua, Tat-Seng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoding in Latent Spaces for Efficient Inference in LLM-based Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T02:30:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:58:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Fine-tuning large language models (LLMs) for recommendation in a generative manner has delivered promising results, but encounters significant inference overhead due to autoregressive decoding in the language space. This work explores bypassing language-space decoding by directly matching candidate items with the LLM's internal thought representations in the latent space, eliminating the time-consuming autoregressive process to reduce computational costs. Towards this, we introduce Light Latent-space Decoding (L2D), an effective and efficient latent-space decoding method. L2D represents user-preferred items by using the hidden states of test sequences reflecting the LLM's internal thought, and obtains candidate item representations from the hidden states of training sequences labeled with the corresponding candidate items. It then matches the two types of representations to decode items, achieving latent-space decoding. In this way, it enables efficient decoding without altering the LLM's generative tuning paradigm, thereby preserving performance. Extensive empirical results demonstrate that L2D is more than 10x faster than language-space decoding while maintaining or enhancing performance."},{"descriptionType":"Other","description":"Accepted for publication in EMNLP'25"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11524","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:04:42Z","registered":"2025-09-16T03:04:42Z","published":null,"updated":"2025-09-16T03:04:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11548","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11548","identifiers":[{"identifier":"2509.11548","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weiming","familyName":"Li","name":"Li, Weiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Shao","name":"Shao, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Yang","name":"Yang, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujing","familyName":"Lu","name":"Lu, Yujing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Zhong","name":"Zhong, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhan","familyName":"Wang","name":"Wang, Yuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Yu","name":"Yu, Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongxiao","familyName":"Ruan","name":"Ruan, Tongxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manni","familyName":"Duan","name":"Duan, Manni","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Auxiliary Reasoning Unleashes GUI Grounding in VLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T03:28:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:00:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-10T01:13:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-11T00:19:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graphical user interface (GUI) grounding is a fundamental task for building GUI agents. However, general vision-language models (VLMs) struggle with this task due to a lack of specific optimization. We identify a key gap in this paper: while VLMs exhibit significant latent grounding potential, as demonstrated by their performance measured by Pointing Game, they underperform when tasked with outputting explicit coordinates. To address this discrepancy and bypass the high data and annotation costs of current fine-tuning approaches, we propose three zero-shot auxiliary reasoning methods. By providing explicit spatial cues such as axes, grids and labeled intersections as part of the input image, these methods enable VLMs to better articulate their implicit spatial understanding capabilities. We evaluate these methods on four GUI grounding benchmarks across seven open-source and proprietary VLMs. Experimental results show substantial gains from auxiliary reasoning. Mark-Grid Scaffold boosts Gemini-3.1-Pro from 11.72\\% under direct inference to 95.20\\% on ScreenSpot-v2, achieves state-of-the-art performance on ScreenSpot, and approaches the strongest fine-tuned methods on ScreenSpot-v2 and UI-I2E-Bench. Our code is available at https://github.com/liweim/AuxiliaryReasoning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11548","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:05:16Z","registered":"2025-09-16T03:05:17Z","published":null,"updated":"2026-06-11T02:24:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11569","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11569","identifiers":[{"identifier":"2509.11569","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yue","familyName":"Ding","name":"Ding, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofang","familyName":"Zhu","name":"Zhu, Xiaofang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianze","familyName":"Xia","name":"Xia, Tianze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junfei","familyName":"Wu","name":"Wu, Junfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinlong","familyName":"Chen","name":"Chen, Xinlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Liu","name":"Liu, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Wang","name":"Wang, Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"D$^2$HScore: Reasoning-Aware Hallucination Detection via Semantic Breadth and Depth Analysis in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T04:28:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:01:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Although large Language Models (LLMs) have achieved remarkable success, their practical application is often hindered by the generation of non-factual content, which is called \"hallucination\". Ensuring the reliability of LLMs' outputs is a critical challenge, particularly in high-stakes domains such as finance, security, and healthcare. In this work, we revisit hallucination detection from the perspective of model architecture and generation dynamics. Leveraging the multi-layer structure and autoregressive decoding process of LLMs, we decompose hallucination signals into two complementary dimensions: the semantic breadth of token representations within each layer, and the semantic depth of core concepts as they evolve across layers. Based on this insight, we propose \\textbf{D$^2$HScore (Dispersion and Drift-based Hallucination Score)}, a training-free and label-free framework that jointly measures: (1) \\textbf{Intra-Layer Dispersion}, which quantifies the semantic diversity of token representations within each layer; and (2) \\textbf{Inter-Layer Drift}, which tracks the progressive transformation of key token representations across layers. To ensure drift reflects the evolution of meaningful semantics rather than noisy or redundant tokens, we guide token selection using attention signals. By capturing both the horizontal and vertical dynamics of representation during inference, D$^2$HScore provides an interpretable and lightweight proxy for hallucination detection. Extensive experiments across five open-source LLMs and five widely used benchmarks demonstrate that D$^2$HScore consistently outperforms existing training-free baselines."},{"descriptionType":"Other","description":"under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11569","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:05:46Z","registered":"2025-09-16T03:05:46Z","published":null,"updated":"2025-09-16T03:05:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11570","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11570","identifiers":[{"identifier":"2509.11570","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sampoorna","familyName":"Poria","name":"Poria, Sampoorna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolei","familyName":"Huang","name":"Huang, Xiaolei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bhaasha, Bhasa, Zaban: A Survey for Low-Resourced Languages in South Asia -- Current Stage and Challenges"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T04:31:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T02:59:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Rapid developments of large language models have revolutionized many NLP tasks for English data. Unfortunately, the models and their evaluations for low-resource languages are being overlooked, especially for languages in South Asia. Although there are more than 650 languages in South Asia, many of them either have very limited computational resources or are missing from existing language models. Thus, a concrete question to be answered is: Can we assess the current stage and challenges to inform our NLP community and facilitate model developments for South Asian languages? In this survey, we have comprehensively examined current efforts and challenges of NLP models for South Asian languages by retrieving studies since 2020, with a focus on transformer-based models, such as BERT, T5, \u0026amp; GPT. We present advances and gaps across 3 essential aspects: data, models, \u0026amp; tasks, such as available data sources, fine-tuning strategies, \u0026amp; domain applications. Our findings highlight substantial issues, including missing data in critical domains (e.g., health), code-mixing, and lack of standardized evaluation benchmarks. Our survey aims to raise awareness within the NLP community for more targeted data curation, unify benchmarks tailored to cultural and linguistic nuances of South Asia, and encourage an equitable representation of South Asian languages. The complete list of resources is available at: https://github.com/trust-nlp/LM4SouthAsia-Survey."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11570","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:05:47Z","registered":"2025-09-16T03:05:48Z","published":null,"updated":"2025-09-16T03:05:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11571","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11571","identifiers":[{"identifier":"2509.11571","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Liu","name":"Liu, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingyu","familyName":"Liu","name":"Liu, Qingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuhang","familyName":"Zhang","name":"Zhang, Shuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongliang","familyName":"Zhang","name":"Zhang, Hongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingyang","familyName":"Song","name":"Song, Lingyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Fine-Grained 3D Radio Map Construction Paradigm with Ultra-Low Sampling Rates by Large Generative Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T04:34:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:01:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-20T19:05:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-24T00:09:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A radio map captures the spatial distribution of wireless channel parameters, such as the strength of the signal received, across a geographic area. The problem of fine-grained three-dimensional (3D) radio map construction involves inferring a high-resolution radio map for the two-dimensional (2D) area at an arbitrary target height within a 3D region of interest, using radio samples collected by sensors sparsely distributed in that 3D region. Solutions to the problem are crucial for efficient spectrum management in 3D spaces, particularly for drones in the rapidly developing low-altitude economy. However, this problem is challenging due to ultra-sparse sampling, where the number of collected radio samples is far fewer than the desired resolution of the radio map to be estimated. In this paper, we design RadioLAM, a fine-grained 3D radio map construction paradigm built on generative Large Artificial Intelligence Models (LAMs). RadioLAM employs the creative power and the strong generalization capability of LAM to address the ultra-sparse sampling challenge. It consists of three key blocks: 1) an augmentation block, using the radio propagation model to project the radio samples collected at different heights to the 2D area at the target height; 2) a generation block, leveraging a diffusion-based LAM under an Mixture of Experts (MoE) architecture to generate a candidate set of fine-grained radio maps for the target 2D area; and 3) an election block, utilizing the radio propagation model as a guide to find the best map from the candidate set. Extensive simulations show that RadioLAM is able to solve the fine-grained 3D radio map construction problem efficiently from an ultra-low sampling rate of 0.1%, and significantly outperforms state-of-the-art (SOTA). Furthermore, real-world experiments confirm that RadioLAM achieves superior performance compared to SOTA."},{"descriptionType":"Other","description":"Accepted by IEEE JSAC"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11571","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:05:48Z","registered":"2025-09-16T03:05:49Z","published":null,"updated":"2026-03-24T04:15:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11589","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11589","identifiers":[{"identifier":"2509.11589","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yanyun","familyName":"Pu","name":"Pu, Yanyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kehan","familyName":"Li","name":"Li, Kehan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyi","familyName":"Huang","name":"Huang, Zeyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijie","familyName":"Zhong","name":"Zhong, Zhijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaixiang","familyName":"Yang","name":"Yang, Kaixiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MVQA-68K: A Multi-dimensional and Causally-annotated Dataset with Quality Interpretability for Video Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T05:16:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:03:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid advancement of video generation models such as Sora, video quality assessment (VQA) is becoming increasingly crucial for selecting high-quality videos from large-scale datasets used in pre-training. Traditional VQA methods, typically producing single numerical scores, often lack comprehensiveness and interpretability. To address these challenges, we introduce MVQA-68K, a novel multi-dimensional VQA dataset comprising over 68,000 carefully annotated videos, covering seven essential quality dimensions: overall aesthetics, camera movement, dynamic degree, texture detail, composition, visual quality, and factual consistency. Each annotation includes detailed chain-of-thought reasoning to facilitate interpretability and comprehensive understanding. Extensive experiments demonstrate that MVQA-68K significantly enhances the performance of various multimodal large language models (MLLMs) on the VQA task, achieving state-of-the-art results not only on our internal test set (Fig.1) but also on public benchmarks including LSVQ-test, LSVQ-1080p, and LIVE-VQC. Meantime, incorporating explicit reasoning process during VQA training substantially boosts the zero-shot generalization. Code and dataset will be available at github: https://github.com/Controller01-ai/MVQA-68K"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11589","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:06:13Z","registered":"2025-09-16T03:06:14Z","published":null,"updated":"2025-09-16T03:06:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11601","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11601","identifiers":[{"identifier":"2509.11601","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuan","familyName":"Gao","name":"Gao, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuelong","familyName":"Wang","name":"Wang, Xuelong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenguo","familyName":"Dong","name":"Dong, Zhenguo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Zhang","name":"Zhang, Yong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Adaptive Parsing of Temporal and Cross-Variable Patterns for Network State Classification"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T05:32:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:03:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Effective network state classification is a primary task for ensuring network security and optimizing performance. Existing deep learning models have shown considerable progress in this area. Some methods excel at analyzing the complex temporal periodicities found in traffic data, while graph-based approaches are adept at modeling the dynamic dependencies between different variables. However, a key trade-off remains, as these methods struggle to capture both characteristics simultaneously. Models focused on temporal patterns often overlook crucial variable dependencies, whereas those centered on dependencies may fail to capture fine-grained temporal details. To address this trade-off, we introduce DAPNet, a framework based on a Mixture-of-Experts architecture. DAPNet integrates three specialized networks for periodic analysis, dynamic cross-variable correlation modeling, and hybrid temporal feature extraction. A learnable gating network dynamically assigns weights to experts based on the input sample and computes a weighted fusion of their outputs. Furthermore, a hybrid regularization loss function ensures stable training and addresses the common issue of class imbalance. Extensive experiments on two large-scale network intrusion detection datasets (CICIDS2017/2018) validate DAPNet's higher accuracy for its target application. The generalizability of the architectural design is evaluated across ten public UEA benchmark datasets, positioning DAPNet as a specialized framework for network state classification."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11601","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:06:30Z","registered":"2025-09-16T03:06:31Z","published":null,"updated":"2025-09-16T03:06:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11604","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11604","identifiers":[{"identifier":"2509.11604","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md. Mithun","familyName":"Hossain","name":"Hossain, Md. Mithun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Organizational","affiliation":[],"name":"Sanjara","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md. Shakil","familyName":"Hossain","name":"Hossain, Md. Shakil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sudipto","familyName":"Chaki","name":"Chaki, Sudipto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Span Interaction and Graph-Aware Memory for Entity-Level Sentiment Classification"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T05:47:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:03:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-12T07:55:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:56:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Entity-level sentiment classification involves identifying the sentiment polarity linked to specific entities within text. This task poses several challenges: effectively modeling the subtle and complex interactions between entities and their surrounding sentiment expressions; capturing dependencies that may span across sentences; and ensuring consistent sentiment predictions for multiple mentions of the same entity through coreference resolution. Additionally, linguistic phenomena such as negation, ambiguity, and overlapping opinions further complicate the analysis. These complexities make entity-level sentiment classification a difficult problem, especially in real-world, noisy textual data. To address these issues, we propose SpanEIT, a novel framework integrating dynamic span interaction and graph-aware memory mechanisms for enhanced entity-sentiment relational modeling. SpanEIT builds span-based representations for entities and candidate sentiment phrases, employs bidirectional attention for fine-grained interactions, and uses a graph attention network to capture syntactic and co-occurrence relations. A coreference-aware memory module ensures entity-level consistency across documents. Experiments on FSAD, BARU, and IMDB datasets show SpanEIT outperforms state-of-the-art transformer and hybrid baselines in accuracy and F1 scores. Ablation and interpretability analyses validate the effectiveness of our approach, underscoring its potential for fine-grained sentiment analysis in applications like social media monitoring and customer feedback analysis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11604","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:06:34Z","registered":"2025-09-16T03:06:35Z","published":null,"updated":"2025-10-14T04:21:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11606","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11606","identifiers":[{"identifier":"2509.11606","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Milan","familyName":"Marocchi","name":"Marocchi, Milan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Fynn","name":"Fynn, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kayapanda","familyName":"Mandana","name":"Mandana, Kayapanda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Rong","name":"Rong, Yue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling to Multimodal and Multichannel Heart Sound Classification with Synthetic and Augmented Biosignals"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T05:52:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:03:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-26T03:27:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T00:27:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-08T09:10:10Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-09T02:21:12Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-02T08:03:08Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-03T00:34:04Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Cardiovascular diseases (CVDs) are the leading cause of death worldwide, accounting for approximately 17.9 million deaths each year. Early detection is critical, creating a demand for accurate and inexpensive pre-screening methods. Deep learning has recently been applied to classify abnormal heart sounds indicative of CVDs using synchronised phonocardiogram (PCG) and electrocardiogram (ECG) signals, as well as multichannel PCG (mPCG). However, state-of-the-art architectures remain underutilised due to the limited availability of synchronised and multichannel datasets. Augmented datasets and pre-trained models provide a pathway to overcome these limitations, enabling transformer-based architectures to be trained effectively. This work combines traditional signal processing with denoising diffusion models, WaveGrad and DiffWave, to create an augmented dataset to fine-tune a Wav2Vec 2.0-based classifier on multimodal and multichannel heart sound datasets. The approach achieves state-of-the-art performance. On the Computing in Cardiology (CinC) 2016 dataset of single channel PCG, accuracy, unweighted average recall (UAR), sensitivity, specificity and Matthew's correlation coefficient (MCC) reach 92.48%, 93.05%, 93.63%, 92.48%, 94.93% and 0.8283, respectively. Using the synchronised PCG and ECG signals of the training-a dataset from CinC, 93.14%, 92.21%, 94.35%, 90.10%, 95.12% and 0.8380 are achieved for accuracy, UAR, sensitivity, specificity and MCC, respectively. Using a wearable vest dataset consisting of mPCG data, the model achieves 77.13% accuracy, 74.25% UAR, 86.47% sensitivity, 62.04% specificity, and 0.5082 MCC. These results demonstrate the effectiveness of transformer-based models for CVD detection when supported by augmented datasets, highlighting their potential to advance multimodal and multichannel heart sound classification."},{"descriptionType":"Other","description":"35 pages, 37 figures, 19 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11606","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:06:37Z","registered":"2025-09-16T03:06:38Z","published":null,"updated":"2026-07-03T02:12:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11617","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11617","identifiers":[{"identifier":"2509.11617","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qi","familyName":"Zheng","name":"Zheng, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaoran","familyName":"Zhang","name":"Zhang, Chaoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijian","familyName":"Liang","name":"Liang, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"EnTe","familyName":"Lin","name":"Lin, EnTe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shubo","familyName":"Cui","name":"Cui, Shubo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinghongbing","familyName":"Xie","name":"Xie, Qinghongbing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaobo","familyName":"Xu","name":"Xu, Zhaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Zeng","name":"Zeng, Long","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AssemMate: Graph-Based LLM for Robotic Assembly Assistance"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T06:17:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:04:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-01T05:58:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:02:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Model (LLM)-based robotic assembly assistance has gained significant research attention. It requires the injection of domain-specific knowledge to guide the assembly process through natural language interaction with humans. Despite some progress, existing methods represent knowledge in the form of natural language text. Due to the long context and redundant content, they struggle to meet the robots' requirements for real-time and precise reasoning. In order to bridge this gap, we present AssemMate, which utilizes the graph\\textemdash a concise and accurate form of knowledge representation\\textemdash as input. This graph-based LLM enables knowledge graph question answering (KGQA), supporting human-robot interaction and assembly task planning for specific products. Beyond interactive QA, AssemMate also supports sensing stacked scenes and executing grasping to assist with assembly. Specifically, a self-supervised Graph Convolutional Network (GCN) encodes knowledge graph entities and relations into a latent space and aligns them with LLM's representation, enabling the LLM to understand graph information. In addition, a vision-enhanced strategy is employed to address stacked scenes in grasping. Through training and evaluation, AssemMate outperforms existing methods, achieving 6.4\\% higher accuracy, 3 times faster inference, and 28 times shorter context length, while demonstrating strong generalization ability on random graphs. And our approach further demonstrates superiority through robotic grasping experiments in both simulated and real-world settings. More details can be found on the project page: https://github.com/cristina304/AssemMate.git"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11617","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:06:52Z","registered":"2025-09-16T03:06:53Z","published":null,"updated":"2026-03-03T05:42:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11619","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11619","identifiers":[{"identifier":"2509.11619","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Spandan","familyName":"Anaokar","name":"Anaokar, Spandan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shrey","familyName":"Ganatra","name":"Ganatra, Shrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harshvivek","familyName":"Kashid","name":"Kashid, Harshvivek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Swapnil","familyName":"Bhattacharyya","name":"Bhattacharyya, Swapnil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shruti","familyName":"Nair","name":"Nair, Shruti","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reshma","familyName":"Sekhar","name":"Sekhar, Reshma","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siddharth","familyName":"Manohar","name":"Manohar, Siddharth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahul","familyName":"Hemrajani","name":"Hemrajani, Rahul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pushpak","familyName":"Bhattacharyya","name":"Bhattacharyya, Pushpak","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HalluDetect: Detecting, Mitigating, and Benchmarking Hallucinations in Conversational Systems in the Legal Domain"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T06:23:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:04:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-12T05:15:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T00:52:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are widely used in industry but remain prone to hallucinations, limiting their reliability in critical applications. This work addresses hallucination reduction in consumer grievance chatbots built using LLaMA 3.1 8B Instruct, a compact model frequently used in industry. We develop HalluDetect, an LLM-based hallucination detection system that achieves an F1 score of 68.92% outperforming baseline detectors by 22.47%. Benchmarking five hallucination mitigation architectures, we find that out of them, AgentBot minimizes hallucinations to 0.4159 per turn while maintaining the highest token accuracy (96.13%), making it the most effective mitigation strategy. Our findings provide a scalable framework for hallucination mitigation, demonstrating that optimized inference strategies can significantly improve factual accuracy."},{"descriptionType":"Other","description":"7 pages + references + appendix, 3 figures, 3 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11619","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:06:55Z","registered":"2025-09-16T03:06:55Z","published":null,"updated":"2025-10-14T04:21:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11629","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11629","identifiers":[{"identifier":"2509.11629","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chentao","familyName":"Cao","name":"Cao, Chentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojun","familyName":"Xu","name":"Xu, Xiaojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Han","name":"Han, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Li","name":"Li, Hang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reasoned Safety Alignment: Ensuring Jailbreak Defense via Answer-Then-Check"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T06:47:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:05:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-06T02:11:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-09T00:17:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As large language models (LLMs) continue to advance in capabilities, ensuring their safety against jailbreak attacks remains a critical challenge. In this paper, we introduce a novel safety alignment approach called Answer-Then-Check, which enhances LLM robustness against malicious prompts by applying thinking ability to mitigate jailbreaking problems before producing a final answer to the user. Our method enables models to answer the question in their thoughts directly and then critically evaluate its safety before deciding whether to provide it. To implement this approach, we construct the Reasoned Safety Alignment (ReSA) dataset, comprising 80K samples that teach models to reason through direct responses and then analyze their safety. Experimental results demonstrate that our approach achieves the Pareto frontier with superior safety capability while decreasing over-refusal rates. Notably, the fine-tuned model maintains general reasoning capabilities on benchmarks like MMLU, MATH500, and HumanEval. Besides, our method equips models with the ability to perform safe completion, while post-hoc detection methods can only directly reject sensitive, harmful queries (e.g., self-harm). Our results show that inference-time strategies alone are insufficient, highlighting the necessity of safety training, and we find even $500$ samples can yield performance comparable to the entire dataset, suggesting a promising path for data-efficient safety alignment. The dataset is publicly available at: https://huggingface.co/datasets/ByteDance-Seed/ReSA."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11629","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:07:09Z","registered":"2025-09-16T03:07:10Z","published":null,"updated":"2026-03-09T02:08:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11645","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11645","identifiers":[{"identifier":"2509.11645","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaolong","familyName":"Wu","name":"Wu, Zhaolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pu","familyName":"Luo","name":"Luo, Pu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Meng","name":"Meng, Nan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason Pui Yin","familyName":"Cheung","name":"Cheung, Jason Pui Yin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teng","familyName":"Zhang","name":"Zhang, Teng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adapting and Evaluating Multimodal Large Language Models for Adolescent Idiopathic Scoliosis Self-Management: A Divide and Conquer Framework"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T07:34:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:07:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T09:02:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-14T01:43:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/978-3-032-06004-4_28","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study presents the first comprehensive evaluation of Multimodal Large Language Models (MLLMs) for Adolescent Idiopathic Scoliosis (AIS) self-management. We constructed a database of approximately 3,000 anteroposterior X-rays with diagnostic texts and evaluated five MLLMs through a `Divide and Conquer' framework consisting of a visual question-answering task, a domain knowledge assessment task, and a patient education counseling assessment task. Our investigation revealed limitations of MLLMs' ability in interpreting complex spinal radiographs and comprehending AIS care knowledge. To address these, we pioneered enhancing MLLMs with spinal keypoint prompting and compiled an AIS knowledge base for retrieval augmented generation (RAG), respectively. Results showed varying effectiveness of visual prompting across different architectures, while RAG substantially improved models' performances on the knowledge assessment task. Our findings indicate current MLLMs are far from capable in realizing personalized assistant in AIS care. The greatest challenge lies in their abilities to obtain accurate detections of spinal deformity locations (best accuracy: 0.55) and directions (best accuracy: 0.13)."},{"descriptionType":"Other","description":"Accepted by MICCAI 2025 MLLMCP Workshop"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11645","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:07:36Z","registered":"2025-09-16T03:07:37Z","published":null,"updated":"2025-10-14T04:21:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11662","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11662","identifiers":[{"identifier":"2509.11662","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Feilong","familyName":"Chen","name":"Chen, Feilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijiang","familyName":"Liu","name":"Liu, Yijiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Huang","name":"Huang, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miren","familyName":"Tian","name":"Tian, Miren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ya-Qi","familyName":"Yu","name":"Yu, Ya-Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghui","familyName":"Liao","name":"Liao, Minghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jihao","familyName":"Wu","name":"Wu, Jihao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MindVL: Towards Efficient and Effective Training of Multimodal Large Language Models on Ascend NPUs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T08:00:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:08:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-29T09:44:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T01:49:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-30T02:27:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-01T00:25:27Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose MindVL, a multimodal large language model (MLLMs) trained on Ascend NPUs. The training of state-of-the-art MLLMs is often confined to a limited set of hardware platforms and relies heavily on massive, undisclosed data recipes, which hinders reproducibility and open research. To change the common perception that Ascend hardware is unsuitable for efficient full-stage MLLM training, we introduce MindSpeed-MLLM, a highly efficient training framework that supports stable and high-performance training of large-scale Dense and Mixture-of-Experts (MoE) models on Ascend hardware. Based on this, we provide a systematic and open description of the data production methods and mixing strategies for all training stages. Furthermore, we present MindVL, a data-efficient multimodal large language model trained end-to-end on Ascend NPUs. In addition, we find that averaging weights from checkpoints trained with different sequence lengths is particularly effective and yields further gains when combined with test-time resolution search. Our experiments demonstrate superior data efficiency: MindVL-8B matches the performance of Qwen2.5VL-7B using only 10\\% of its training data, while our MoE model, MindVL-671B-A37B, matches Qwen2.5VL-72B using only 3\\% of the Qwen2.5VL training data, and achieves comparable performance with other leading multimodal MoE models. Our work provides the community with a valuable hardware alternative, open data recipes, and effective performance-enhancing techniques."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11662","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:08:01Z","registered":"2025-09-16T03:08:02Z","published":null,"updated":"2025-10-01T03:00:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11667","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11667","identifiers":[{"identifier":"2509.11667","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"HG","familyName":"Ranjani","name":"Ranjani, HG","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rutuja","familyName":"Prabhudesai","name":"Prabhudesai, Rutuja","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Measuring Visual Understanding in Telecom domain: Performance Metrics for Image-to-UML conversion using VLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T08:08:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:08:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Telecom domain 3GPP documents are replete with images containing sequence diagrams. Advances in Vision-Language Large Models (VLMs) have eased conversion of such images to machine-readable PlantUML (puml) formats. However, there is a gap in evaluation of such conversions - existing works do not compare puml scripts for various components. In this work, we propose performance metrics to measure the effectiveness of such conversions. A dataset of sequence diagrams from 3GPP documents is chosen to be representative of domain-specific actual scenarios. We compare puml outputs from two VLMs - Claude Sonnet and GPT-4V - against manually created ground truth representations. We use version control tools to capture differences and introduce standard performance metrics to measure accuracies along various components: participant identification, message flow accuracy, sequence ordering, and grouping construct preservation. We demonstrate effectiveness of proposed metrics in quantifying conversion errors across various components of puml scripts. The results show that nodes, edges and messages are accurately captured. However, we observe that VLMs do not necessarily perform well on complex structures such as notes, box, groups. Our experiments and performance metrics indicates a need for better representation of these components in training data for fine-tuned VLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11667","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:08:09Z","registered":"2025-09-16T03:08:10Z","published":null,"updated":"2025-09-16T03:08:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11686","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11686","identifiers":[{"identifier":"2509.11686","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jian","familyName":"Wang","name":"Wang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofei","familyName":"Xie","name":"Xie, Xiaofei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Hu","name":"Hu, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shangqing","familyName":"Liu","name":"Liu, Shangqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Li","name":"Li, Yi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do Code Semantics Help? A Comprehensive Study on Execution Trace-Based Information for Code Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T08:38:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:09:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-18T11:44:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-19T00:36:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-24T07:06:41Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-25T00:29:37Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Code Large Language Models (Code LLMs) have opened a new era in programming with their impressive capabilities. However, recent research has revealed critical limitations in their ability to reason about runtime behavior and understand the actual functionality of programs, which poses significant challenges for their post-training and practical deployment. Specifically, Code LLMs encounter two principal issues: (1) a lack of proficiency in reasoning about program execution behavior, as they struggle to interpret what programs actually do during runtime, and (2) the inconsistent and fragmented representation of semantic information, such as execution traces, across existing methods, which hinders their ability to generalize and reason effectively. These challenges underscore the necessity for more systematic approaches to enhance the reasoning capabilities of Code LLMs. To address these issues, we introduce a generic framework to support integrating semantic information~(e.g., execution trace) to code task-relevant prompts, and conduct a comprehensive study to explore the role of semantic information in enhancing the reasoning ability of Code LLMs accordingly. Specifically, we focus on investigating the usefulness of trace-based semantic information in boosting supervised fine-tuning~(SFT) and post-phase inference of Code LLMs. The experimental results surprisingly disagree with previous works and demonstrate that semantic information has limited usefulness for SFT and test time scaling of Code LLM."},{"descriptionType":"Other","description":"EMNLP2025-findings https://openreview.net/forum?id=d4ICISW2T4"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11686","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:08:37Z","registered":"2025-09-16T03:08:38Z","published":null,"updated":"2025-09-25T02:25:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11703","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11703","identifiers":[{"identifier":"2509.11703","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Davide","familyName":"Bidoggia","name":"Bidoggia, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nataliia","familyName":"Manko","name":"Manko, Nataliia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria","familyName":"Peressi","name":"Peressi, Maria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antimo","familyName":"Marrazzo","name":"Marrazzo, Antimo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AiiDA-TrainsPot: Towards automated training of neural-network interatomic potentials"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Disordered Systems and Neural Networks (cond-mat.dis-nn)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T09:04:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:11:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-28T10:45:54Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-08T00:57:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1039/d6dd00005c","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Crafting neural-network interatomic potentials (NNIPs) remains a complex task, demanding specialized expertise in both machine learning and electronic-structure calculations. Here, we introduce AiiDA-TrainsPot, an automated, open-source, and user-friendly workflow that streamlines the creation of accurate NNIPs by orchestrating density-functional-theory calculations, data augmentation strategies, and classical molecular dynamics. Our active-learning strategy leverages on-the-fly calibration of committee disagreement against ab initio reference errors to ensure reliable uncertainty estimates. We use electronic-structure descriptors and dimensionality reduction to analyze the efficiency of this calibrated criterion, and show that it minimizes both false positives and false negatives when deciding what to compute from first principles. AiiDA-TrainsPot has a modular design that supports multiple NNIP backends, enabling both the training of NNIPs from scratch and the fine-tuning of foundation models. We demonstrate its capabilities through automated training campaigns targeting pristine and defective carbon allotropes, including amorphous carbon, as well as structural phase transitions in monolayer $\\mathrm{W_xMo_{1-x}Te_2}$ alloys."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11703","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:09:03Z","registered":"2025-09-16T03:09:04Z","published":null,"updated":"2026-05-11T02:42:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11714","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11714","identifiers":[{"identifier":"2509.11714","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hafza","familyName":"Eman","name":"Eman, Hafza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Furqan","familyName":"Shaukat","name":"Shaukat, Furqan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad Hamza","familyName":"Zafar","name":"Zafar, Muhammad Hamza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Syed Muhammad","familyName":"Anwar","name":"Anwar, Syed Muhammad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EMeRALDS: Electronic Medical Record Driven Automated Lung Nodule Detection and Classification in Thoracic CT Images"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T09:11:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:11:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Objective: Lung cancer is a leading cause of cancer-related mortality worldwide, primarily due to delayed diagnosis and poor early detection. This study aims to develop a computer-aided diagnosis (CAD) system that leverages large vision-language models (VLMs) for the accurate detection and classification of pulmonary nodules in computed tomography (CT) scans.\n Methods: We propose an end-to-end CAD pipeline consisting of two modules: (i) a detection module (CADe) based on the Segment Anything Model 2 (SAM2), in which the standard visual prompt is replaced with a text prompt encoded by CLIP (Contrastive Language-Image Pretraining), and (ii) a diagnosis module (CADx) that calculates similarity scores between segmented nodules and radiomic features. To add clinical context, synthetic electronic medical records (EMRs) were generated using radiomic assessments by expert radiologists and combined with similarity scores for final classification. The method was tested on the publicly available LIDC-IDRI dataset (1,018 CT scans).\n Results: The proposed approach demonstrated strong performance in zero-shot lung nodule analysis. The CADe module achieved a Dice score of 0.92 and an IoU of 0.85 for nodule segmentation. The CADx module attained a specificity of 0.97 for malignancy classification, surpassing existing fully supervised methods.\n Conclusions: The integration of VLMs with radiomics and synthetic EMRs allows for accurate and clinically relevant CAD of pulmonary nodules in CT scans. The proposed system shows strong potential to enhance early lung cancer detection, increase diagnostic confidence, and improve patient management in routine clinical workflows."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11714","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:09:20Z","registered":"2025-09-16T03:09:21Z","published":null,"updated":"2025-09-16T03:09:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11752","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11752","identifiers":[{"identifier":"2509.11752","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongyuan","familyName":"Zhang","name":"Zhang, Hongyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuheng","familyName":"Wu","name":"Wu, Yuheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyang","familyName":"Zhao","name":"Zhao, Mingyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwei","familyName":"Chen","name":"Chen, Zhiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rebecca","familyName":"Li","name":"Li, Rebecca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Zhu","name":"Zhu, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haohan","familyName":"Zhao","name":"Zhao, Haohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohua","familyName":"Yuan","name":"Yuan, Xiaohua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Yang","name":"Yang, Meng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunli","familyName":"Qiu","name":"Qiu, Chunli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Cong","name":"Cong, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyan","familyName":"Chen","name":"Chen, Haiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lina","familyName":"Luan","name":"Luan, Lina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Randolph H. L.","familyName":"Wong","name":"Wong, Randolph H. L.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huai","familyName":"Liao","name":"Liao, Huai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Colin A","familyName":"Graham","name":"Graham, Colin A","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shi","familyName":"Chang","name":"Chang, Shi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guowei","familyName":"Tao","name":"Tao, Guowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Yi","name":"Yi, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Lei","name":"Lei, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nassir","familyName":"Navab","name":"Navab, Nassir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastien","familyName":"Ourselin","name":"Ourselin, Sebastien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiebo","familyName":"Luo","name":"Luo, Jiebo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongbin","familyName":"Liu","name":"Liu, Hongbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaofeng","familyName":"Meng","name":"Meng, Gaofeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Fully Open and Generalizable Foundation Model for Ultrasound Clinical Applications"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T10:05:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:13:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Artificial intelligence (AI) that can effectively learn ultrasound representations by integrating multi-source data holds significant promise for advancing clinical care. However, the scarcity of large labeled datasets in real-world clinical environments and the limited generalizability of task-specific models have hindered the development of generalizable clinical AI models for ultrasound applications. In this study, we present EchoCare, a novel ultrasound foundation model for generalist clinical use, developed via self-supervised learning on our curated, publicly available, large-scale dataset EchoCareData. EchoCareData comprises 4.5 million ultrasound images, sourced from over 23 countries across 5 continents and acquired via a diverse range of distinct imaging devices, thus encompassing global cohorts that are multi-center, multi-device, and multi-ethnic. Unlike prior studies that adopt off-the-shelf vision foundation model architectures, we introduce a hierarchical classifier into EchoCare to enable joint learning of pixel-level and representation-level features, capturing both global anatomical contexts and local ultrasound characteristics. With minimal training, EchoCare outperforms state-of-the-art comparison models across 10 representative ultrasound benchmarks of varying diagnostic difficulties, spanning disease diagnosis, lesion segmentation, organ detection, landmark prediction, quantitative regression, imaging enhancement and report generation. The code and pretrained model are publicly released, rendering EchoCare accessible for fine-tuning and local adaptation, supporting extensibility to additional applications. EchoCare provides a fully open and generalizable foundation model to boost the development of AI technologies for diverse clinical ultrasound applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11752","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:10:18Z","registered":"2025-09-16T03:10:19Z","published":null,"updated":"2025-09-16T03:10:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11766","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11766","identifiers":[{"identifier":"2509.11766","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andy","familyName":"Zhai","name":"Zhai, Andy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brae","familyName":"Liu","name":"Liu, Brae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bruno","familyName":"Fang","name":"Fang, Bruno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chalse","familyName":"Cai","name":"Cai, Chalse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ellie","familyName":"Ma","name":"Ma, Ellie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ethan","familyName":"Yin","name":"Yin, Ethan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hugo","familyName":"Zhou","name":"Zhou, Hugo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Wang","name":"Wang, James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lights","familyName":"Shi","name":"Shi, Lights","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lucy","familyName":"Liang","name":"Liang, Lucy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Make","familyName":"Wang","name":"Wang, Make","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Wang","name":"Wang, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roy","familyName":"Gan","name":"Gan, Roy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Yu","name":"Yu, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shalfun","familyName":"Li","name":"Li, Shalfun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Starrick","familyName":"Liu","name":"Liu, Starrick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sylas","familyName":"Chen","name":"Chen, Sylas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vincent","familyName":"Chen","name":"Chen, Vincent","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zach","familyName":"Xu","name":"Xu, Zach","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Igniting VLMs toward the Embodied Space"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T10:40:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:15:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While foundation models show remarkable progress in language and vision, existing vision-language models (VLMs) still have limited spatial and embodiment understanding. Transferring VLMs to embodied domains reveals fundamental mismatches between modalities, pretraining distributions, and training objectives, leaving action comprehension and generation as a central bottleneck on the path to AGI.\n We introduce WALL-OSS, an end-to-end embodied foundation model that leverages large-scale multimodal pretraining to achieve (1) embodiment-aware vision-language understanding, (2) strong language-action association, and (3) robust manipulation capability.\n Our approach employs a tightly coupled architecture and multi-strategies training curriculum that enables Unified Cross-Level CoT-seamlessly unifying instruction reasoning, subgoal decomposition, and fine-grained action synthesis within a single differentiable framework.\n Our results show that WALL-OSS attains high success on complex long-horizon manipulations, demonstrates strong instruction-following capabilities, complex understanding and reasoning, and outperforms strong baselines, thereby providing a reliable and scalable path from VLMs to embodied foundation models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11766","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:10:40Z","registered":"2025-09-16T03:10:41Z","published":null,"updated":"2025-09-16T03:10:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11772","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11772","identifiers":[{"identifier":"2509.11772","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Diogo","familyName":"Mendonça","name":"Mendonça, Diogo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tiago","familyName":"Barros","name":"Barros, Tiago","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristiano","familyName":"Premebida","name":"Premebida, Cristiano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Urbano J.","familyName":"Nunes","name":"Nunes, Urbano J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Seg2Track-SAM2: SAM2-based Multi-object Tracking and Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T10:52:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:16:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T15:58:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T03:18:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous-driving perception systems require robust Multi-Object Tracking (MOT) to operate reliably in dynamic environments. MOT maintains consistent object identities across frames while preserving spatial accuracy. Recent foundation models, such as SAM2, provide promptable video segmentation without task-specific fine-tuning. However, their direct application to Multi-Object Tracking and Segmentation (MOTS) remains limited by the absence of explicit identity management mechanisms and by growing memory requirements during tracking. This work introduces Seg2Track-SAM2, a framework that integrates pretrained object detectors with SAM2 and a dedicated Seg2Track module to support track initialization, data association, and track refinement. The method operates without dataset-specific fine-tuning and remains detector-agnostic. Experimental evaluation on the KITTI MOTS and MOTS Challenge benchmarks shows that Seg2Track-SAM2 ranks fourth overall in both datasets while achieving the highest association accuracy (AssA) among compared methods. In addition, a sliding-window memory strategy reduces memory usage by up to 75% with minimal impact on tracking performance, enabling deployment under resource constraints. Together, these results indicate that Seg2Track-SAM2 improves identity consistency and memory efficiency in MOTS without requiring dataset-specific training. The code is available at https://github.com/hcmr-lab/Seg2Track-SAM2."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11772","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:10:49Z","registered":"2025-09-16T03:10:50Z","published":null,"updated":"2026-03-03T05:42:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11777","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11777","identifiers":[{"identifier":"2509.11777","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mikhail","familyName":"Kulyabin","name":"Kulyabin, Mikhail","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan","familyName":"Joosten","name":"Joosten, Jan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Choro Ulan","familyName":"uulu","name":"uulu, Choro Ulan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nuno Miguel Martins","familyName":"Pacheco","name":"Pacheco, Nuno Miguel Martins","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabian","familyName":"Ries","name":"Ries, Fabian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Filippos","familyName":"Petridis","name":"Petridis, Filippos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan","familyName":"Bosch","name":"Bosch, Jan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Helena Holmström","familyName":"Olsson","name":"Olsson, Helena Holmström","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"User eXperience Perception Insights Dataset (UXPID): Synthetic User Feedback from Public Industrial Forums"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T10:58:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:16:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-08T09:46:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-11T00:49:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Customer feedback in industrial forums offers rich but underexplored insights into real-world product experience. Yet systematic analysis remains challenging due to unstructured, domain-specific content and the scarcity of high-quality labeled datasets. This paper presents the User eXperience Perception Insights Dataset (UXPID), a collection of 7130 synthesized and anonymized user feedback branches extracted from a public industrial automation forum. Each JSON record contains multi-post comments enriched with metadata and annotated by a large language model (LLM) for UX insights, user expectations, severity ratings, sentiment, and topic classifications. UXPID is designed to facilitate research in user requirements, user experience (UX) analysis, and AI-driven feedback processing, particularly where privacy and licensing restrictions limit access to real-world data. It supports the training and evaluation of transformer-based models for tasks such as issue detection, sentiment analysis, and requirements extraction in technical forums, providing a valuable resource for advancing NLP methods within industrial product support and software engineering domains."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11777","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:10:56Z","registered":"2025-09-16T03:10:57Z","published":null,"updated":"2026-05-11T02:42:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11782","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11782","identifiers":[{"identifier":"2509.11782","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bozhen","familyName":"Hu","name":"Hu, Bozhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Tan","name":"Tan, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyuan","familyName":"Li","name":"Li, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangbin","familyName":"Zheng","name":"Zheng, Jiangbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sizhe","familyName":"Qiu","name":"Qiu, Sizhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Xia","name":"Xia, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stan Z.","familyName":"Li","name":"Li, Stan Z.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multimodal Regression for Enzyme Turnover Rates Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Biomolecules (q-bio.BM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T11:07:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:16:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The enzyme turnover rate is a fundamental parameter in enzyme kinetics, reflecting the catalytic efficiency of enzymes. However, enzyme turnover rates remain scarce across most organisms due to the high cost and complexity of experimental measurements. To address this gap, we propose a multimodal framework for predicting the enzyme turnover rate by integrating enzyme sequences, substrate structures, and environmental factors. Our model combines a pre-trained language model and a convolutional neural network to extract features from protein sequences, while a graph neural network captures informative representations from substrate molecules. An attention mechanism is incorporated to enhance interactions between enzyme and substrate representations. Furthermore, we leverage symbolic regression via Kolmogorov-Arnold Networks to explicitly learn mathematical formulas that govern the enzyme turnover rate, enabling interpretable and accurate predictions. Extensive experiments demonstrate that our framework outperforms both traditional and state-of-the-art deep learning approaches. This work provides a robust tool for studying enzyme kinetics and holds promise for applications in enzyme engineering, biotechnology, and industrial biocatalysis."},{"descriptionType":"Other","description":"9 pages, 5 figures. This paper was withdrawn from the IJCAI 2025 proceedings due to the lack of participation in the conference and presentation"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11782","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:11:04Z","registered":"2025-09-16T03:11:04Z","published":null,"updated":"2025-09-16T03:11:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11796","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11796","identifiers":[{"identifier":"2509.11796","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haodong","familyName":"Chen","name":"Chen, Haodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haojian","familyName":"Huang","name":"Huang, Haojian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"XinXiang","familyName":"Yin","name":"Yin, XinXiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dian","familyName":"Shao","name":"Shao, Dian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FineQuest: Adaptive Knowledge-Assisted Sports Video Understanding via Agent-of-Thoughts Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T11:27:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:17:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Video Question Answering (VideoQA) based on Large Language Models (LLMs) has shown potential in general video understanding but faces significant challenges when applied to the inherently complex domain of sports videos. In this work, we propose FineQuest, the first training-free framework that leverages dual-mode reasoning inspired by cognitive science: i) Reactive Reasoning for straightforward sports queries and ii) Deliberative Reasoning for more complex ones. To bridge the knowledge gap between general-purpose models and domain-specific sports understanding, FineQuest incorporates SSGraph, a multimodal sports knowledge scene graph spanning nine sports, which encodes both visual instances and domain-specific terminology to enhance reasoning accuracy. Furthermore, we introduce two new sports VideoQA benchmarks, Gym-QA and Diving-QA, derived from the FineGym and FineDiving datasets, enabling diverse and comprehensive evaluation. FineQuest achieves state-of-the-art performance on these benchmarks as well as the existing SPORTU dataset, while maintains strong general VideoQA capabilities."},{"descriptionType":"Other","description":"ACM MM 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11796","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:11:23Z","registered":"2025-09-16T03:11:24Z","published":null,"updated":"2025-09-16T03:11:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11815","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11815","identifiers":[{"identifier":"2509.11815","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haiduo","familyName":"Huang","name":"Huang, Haiduo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fuwei","familyName":"Yang","name":"Yang, Fuwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenhua","familyName":"Liu","name":"Liu, Zhenhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanwu","familyName":"Yin","name":"Yin, Xuanwu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Li","name":"Li, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengju","familyName":"Ren","name":"Ren, Pengju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emad","familyName":"Barsoum","name":"Barsoum, Emad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SpecVLM: Fast Speculative Decoding in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T11:53:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:18:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-21T03:35:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-23T00:45:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Speculative decoding is a powerful way to accelerate autoregressive large language models (LLMs), but directly porting it to vision-language models (VLMs) faces unique systems constraints: the prefill stage is dominated by visual tokens whose count scales with image resolution and video length, inflating both compute and memory, especially the key-value (KV) cache. We study speculative decoding for VLMs and introduce SpecVLM, a practical system that (1) establishes a strong EAGLE-2-style baseline, EagleVLM, delivering 1.5--2.3x end-to-end speedups over full autoregressive inference, and (2) further accelerates VLM inference with an elastic visual compressor that adaptively selects among pruning, pooling, convolution, and resampler primitives to balance FLOPs/parameters and accuracy per input. To avoid costly offline distillation corpora, we propose an online-logit distillation protocol that trains the draft model with on-the-fly teacher logits and penultimate features using a combined cross-entropy and Smooth L1 objective, eliminating storage and preprocessing while remaining compute-efficient. This protocol reveals a training-time scaling effect: longer online training monotonically increases the draft model's average accepted length, improving speculative efficiency. Empirically, SpecVLM achieves additional acceleration, culminating in 2.5--2.9x end-to-end speedups within 5 epochs across LLaVA and MMMU, consistently over resolutions and task difficulties, while preserving the target model's output distribution (lossless decoding). Our code is available at https://github.com/haiduo/SpecVLM."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11815","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:11:51Z","registered":"2025-09-16T03:11:52Z","published":null,"updated":"2025-09-23T03:56:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11816","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11816","identifiers":[{"identifier":"2509.11816","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Filip","familyName":"Sondej","name":"Sondej, Filip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yushi","familyName":"Yang","name":"Yang, Yushi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Collapse of Irrelevant Representations (CIR) Ensures Robust and Non-Disruptive LLM Unlearning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T11:55:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:18:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-13T17:23:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-14T01:55:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Current unlearning and safety training methods consistently fail to remove dangerous knowledge from language models. We identify the root cause - unlearning targets representations which are too general - and develop a highly selective technique that unlearns robustly while preserving general performance.\n Our method performs PCA on activations and module-output gradients to identify subspaces containing common representations, then collapses these subspaces before computing unlearning updates, a technique we term Collapse of Irrelevant Representations (CIR). This avoids unlearning general knowledge and targets only representations specific to the facts being unlearned.\n When unlearning bio- and cyber-hazardous facts from Llama-3.1-8B, we achieve over 30x greater reduction in post-attack accuracy than the best baseline (Circuit Breakers), while disrupting general performance 30x less, and using less than 3 GPU-seconds per fact.\n Thus, by disentangling harmful and benign capabilities at the level of representations, CIR enables robust and non-disruptive unlearning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11816","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:11:52Z","registered":"2025-09-16T03:11:53Z","published":null,"updated":"2025-11-14T03:10:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11817","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11817","identifiers":[{"identifier":"2509.11817","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liying","familyName":"Wang","name":"Wang, Liying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoli","familyName":"Zhang","name":"Zhang, Xiaoli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuanmin","familyName":"Jia","name":"Jia, Chuanmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siwei","familyName":"Ma","name":"Ma, Siwei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MAFS: Masked Autoencoder for Infrared-Visible Image Fusion and Semantic Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T11:55:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:18:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Infrared-visible image fusion methods aim at generating fused images with good visual quality and also facilitate the performance of high-level tasks. Indeed, existing semantic-driven methods have considered semantic information injection for downstream applications. However, none of them investigates the potential for reciprocal promotion between pixel-wise image fusion and cross-modal feature fusion perception tasks from a macroscopic task-level perspective. To address this limitation, we propose a unified network for image fusion and semantic segmentation. MAFS is a parallel structure, containing a fusion sub-network and a segmentation sub-network. On the one hand, We devise a heterogeneous feature fusion strategy to enhance semantic-aware capabilities for image fusion. On the other hand, by cascading the fusion sub-network and a segmentation backbone, segmentation-related knowledge is transferred to promote feature-level fusion-based segmentation. Within the framework, we design a novel multi-stage Transformer decoder to aggregate fine-grained multi-scale fused features efficiently. Additionally, a dynamic factor based on the max-min fairness allocation principle is introduced to generate adaptive weights of two tasks and guarantee smooth training in a multi-task manner. Extensive experiments demonstrate that our approach achieves competitive results compared with state-of-the-art methods. The code is available at https://github.com/Abraham-Einstein/MAFS/."},{"descriptionType":"Other","description":"Accepted by TIP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11817","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:11:54Z","registered":"2025-09-16T03:11:54Z","published":null,"updated":"2025-09-16T03:11:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11860","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11860","identifiers":[{"identifier":"2509.11860","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weishu","familyName":"Chen","name":"Chen, Weishu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinyi","familyName":"Tang","name":"Tang, Jinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhouhui","familyName":"Hou","name":"Hou, Zhouhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihao","familyName":"Han","name":"Han, Shihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingjie","familyName":"Zhan","name":"Zhan, Mingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Huang","name":"Huang, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Delong","familyName":"Liu","name":"Liu, Delong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Guo","name":"Guo, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhicheng","familyName":"Zhao","name":"Zhao, Zhicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Su","name":"Su, Fei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MOOM: Maintenance, Organization and Optimization of Memory in Ultra-Long Role-Playing Dialogues"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T12:35:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:20:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T07:36:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:28:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Memory extraction is crucial for maintaining coherent ultra-long dialogues in human-robot role-playing scenarios. However, existing methods often exhibit uncontrolled memory growth. To address this, we propose MOOM, the first dual-branch memory plugin that leverages literary theory by modeling plot development and character portrayal as core storytelling elements. Specifically, one branch summarizes plot conflicts across multiple time scales, while the other extracts the user's character profile. MOOM further integrates a forgetting mechanism, inspired by the ``competition-inhibition'' memory theory, to constrain memory capacity and mitigate uncontrolled growth. Furthermore, we present ZH-4O, a Chinese ultra-long dialogue dataset specifically designed for role-playing, featuring dialogues that average 600 turns and include manually annotated memory information. Experimental results demonstrate that MOOM outperforms all state-of-the-art memory extraction methods, requiring fewer large language model invocations while maintaining a controllable memory capacity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11860","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:12:56Z","registered":"2025-09-16T03:12:57Z","published":null,"updated":"2025-09-18T17:46:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11864","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11864","identifiers":[{"identifier":"2509.11864","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lichao","familyName":"Wu","name":"Wu, Lichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sasha","familyName":"Behrouzi","name":"Behrouzi, Sasha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamadreza","familyName":"Rostami","name":"Rostami, Mohamadreza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maximilian","familyName":"Thang","name":"Thang, Maximilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stjepan","familyName":"Picek","name":"Picek, Stjepan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmad-Reza","familyName":"Sadeghi","name":"Sadeghi, Ahmad-Reza","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"NeuroStrike: Neuron-Level Attacks on Aligned LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T12:38:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:20:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-17T13:02:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-18T02:47:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-26T08:18:42Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-27T00:37:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.14722/ndss.2026.230660","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Safety alignment is critical for the ethical deployment of large language models (LLMs), guiding them to avoid generating harmful or unethical content. Current alignment techniques, such as supervised fine-tuning and reinforcement learning from human feedback, remain fragile and can be bypassed by carefully crafted adversarial prompts. Unfortunately, such attacks rely on trial and error, lack generalizability across models, and are constrained by scalability and reliability.\n This paper presents NeuroStrike, a novel and generalizable attack framework that exploits a fundamental vulnerability introduced by alignment techniques: the reliance on sparse, specialized safety neurons responsible for detecting and suppressing harmful inputs. We apply NeuroStrike to both white-box and black-box settings: In the white-box setting, NeuroStrike identifies safety neurons through feedforward activation analysis and prunes them during inference to disable safety mechanisms. In the black-box setting, we propose the first LLM profiling attack, which leverages safety neuron transferability by training adversarial prompt generators on open-weight surrogate models and then deploying them against black-box and proprietary targets. We evaluate NeuroStrike on over 20 open-weight LLMs from major LLM developers. By removing less than 0.6% of neurons in targeted layers, NeuroStrike achieves an average attack success rate (ASR) of 76.9% using only vanilla malicious prompts. Moreover, Neurostrike generalizes to four multimodal LLMs with 100% ASR on unsafe image inputs. Safety neurons transfer effectively across architectures, raising ASR to 78.5% on 11 fine-tuned models and 77.7% on five distilled models. The black-box LLM profiling attack achieves an average ASR of 63.7% across five black-box models, including the Google Gemini family."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11864","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:13:02Z","registered":"2025-09-16T03:13:02Z","published":null,"updated":"2026-03-27T02:21:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11865","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11865","identifiers":[{"identifier":"2509.11865","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Travis","familyName":"Davies","name":"Davies, Travis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiqi","familyName":"Huang","name":"Huang, Yiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunxin","familyName":"Liu","name":"Liu, Yunxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huxian","familyName":"Liu","name":"Liu, Huxian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luhui","familyName":"Hu","name":"Hu, Luhui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tenma: Robust Cross-Embodiment Robot Manipulation with Diffusion Transformer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T12:39:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:20:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Scaling Transformer policies and diffusion models has advanced robotic manipulation, yet combining these techniques in lightweight, cross-embodiment learning settings remains challenging. We study design choices that most affect stability and performance for diffusion-transformer policies trained on heterogeneous, multimodal robot data, and introduce Tenma, a lightweight diffusion-transformer for bi-manual arm control. Tenma integrates multiview RGB, proprioception, and language via a cross-embodiment normalizer that maps disparate state/action spaces into a shared latent space; a Joint State-Time encoder for temporally aligned observation learning with inference speed boosts; and a diffusion action decoder optimized for training stability and learning capacity. Across benchmarks and under matched compute, Tenma achieves an average success rate of 88.95% in-distribution and maintains strong performance under object and scene shifts, substantially exceeding baseline policies whose best in-distribution average is 18.12%. Despite using moderate data scale, Tenma delivers robust manipulation and generalization, indicating the great potential for multimodal and cross-embodiment learning strategies for further augmenting the capacity of transformer-based imitation learning policies."},{"descriptionType":"Other","description":"8 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11865","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:13:03Z","registered":"2025-09-16T03:13:04Z","published":null,"updated":"2025-09-16T03:13:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11878","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11878","identifiers":[{"identifier":"2509.11878","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sofia","familyName":"Jamil","name":"Jamil, Sofia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kotla Sai","familyName":"Charan","name":"Charan, Kotla Sai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sriparna","familyName":"Saha","name":"Saha, Sriparna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Koustava","familyName":"Goswami","name":"Goswami, Koustava","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"K J","familyName":"Joseph","name":"Joseph, K J","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do It Yourself (DIY): Modifying Images for Poems in a Zero-Shot Setting Using Weighted Prompt Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T12:58:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:21:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Poetry is an expressive form of art that invites multiple interpretations, as readers often bring their own emotions, experiences, and cultural backgrounds into their understanding of a poem. Recognizing this, we aim to generate images for poems and improve these images in a zero-shot setting, enabling audiences to modify images as per their requirements. To achieve this, we introduce a novel Weighted Prompt Manipulation (WPM) technique, which systematically modifies attention weights and text embeddings within diffusion models. By dynamically adjusting the importance of specific words, WPM enhances or suppresses their influence in the final generated image, leading to semantically richer and more contextually accurate visualizations. Our approach exploits diffusion models and large language models (LLMs) such as GPT in conjunction with existing poetry datasets, ensuring a comprehensive and structured methodology for improved image generation in the literary domain. To the best of our knowledge, this is the first attempt at integrating weighted prompt manipulation for enhancing imagery in poetic language."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11878","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:13:21Z","registered":"2025-09-16T03:13:22Z","published":null,"updated":"2025-09-16T03:13:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11937","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11937","identifiers":[{"identifier":"2509.11937","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexandre","familyName":"Sallinen","name":"Sallinen, Alexandre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefan","familyName":"Krsteski","name":"Krsteski, Stefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Teiletche","name":"Teiletche, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc-Antoine","familyName":"Allard","name":"Allard, Marc-Antoine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baptiste","familyName":"Lecoeur","name":"Lecoeur, Baptiste","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Zhang","name":"Zhang, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabrice","familyName":"Nemo","name":"Nemo, Fabrice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Kalajdzic","name":"Kalajdzic, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Meyer","name":"Meyer, Matthias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mary-Anne","familyName":"Hartley","name":"Hartley, Mary-Anne","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MMORE: Massive Multimodal Open RAG \u0026amp; Extraction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"D.2.0; E.m","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-15T13:56:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:24:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce MMORE, an open-source pipeline for Massive Multimodal Open RetrievalAugmented Generation and Extraction, designed to ingest, transform, and retrieve knowledge from heterogeneous document formats at scale. MMORE supports more than fifteen file types, including text, tables, images, emails, audio, and video, and processes them into a unified format to enable downstream applications for LLMs. The architecture offers modular, distributed processing, enabling scalable parallelization across CPUs and GPUs. On processing benchmarks, MMORE demonstrates a 3.8-fold speedup over single-node baselines and 40% higher accuracy than Docling on scanned PDFs. The pipeline integrates hybrid dense-sparse retrieval and supports both interactive APIs and batch RAG endpoints. Evaluated on PubMedQA, MMORE-augmented medical LLMs improve biomedical QA accuracy with increasing retrieval depth. MMORE provides a robust, extensible foundation for deploying task-agnostic RAG systems on diverse, real-world multimodal data. The codebase is available at https://github.com/swiss-ai/mmore."},{"descriptionType":"Other","description":"This paper was originally submitted to the CODEML workshop for ICML 2025. 9 pages (including references and appendices)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11937","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:14:54Z","registered":"2025-09-16T03:14:55Z","published":null,"updated":"2025-09-16T03:14:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11943","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11943","identifiers":[{"identifier":"2509.11943","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Antonin","familyName":"Sulc","name":"Sulc, Antonin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thorsten","familyName":"Hellert","name":"Hellert, Thorsten","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agentic System with Modal Logic for Autonomous Diagnostics"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T14:03:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:25:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-09T16:39:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T01:08:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-18T00:10:05Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-21T00:14:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The development of intelligent agents, particularly those powered by language models (LMs), has shown a critical role in various environments that require intelligent and autonomous decision-making. Environments are not passive testing grounds, and they represent the data required for agents to learn and exhibit in very challenging conditions that require adaptive, complex, and autonomous capacity to make decisions. While the paradigm of scaling models and datasets has led to remarkable emergent capabilities, we argue that scaling the structure, fidelity, and logical consistency of agent reasoning within these environments is a crucial, yet underexplored, dimension of AI research. This paper introduces a neuro-symbolic multi-agent architecture where the belief states of individual agents are formally represented as Kripke models. This foundational choice enables them to reason about known concepts of \\emph{possibility} and \\emph{necessity} using the formal language of modal logic. In this work, we use immutable, domain-specific knowledge to make an informed root cause diagnosis, which is encoded as logical constraints essential for proper, reliable, and explainable diagnosis. In the proposed model, we show constraints that actively guide the hypothesis generation of LMs, effectively preventing them from reaching physically or logically untenable conclusions. In a high-fidelity simulated particle accelerator environment, our system successfully diagnoses complex, cascading failures by combining the powerful semantic intuition of LMs with the rigorous, verifiable validation of modal logic and a factual world model and showcasing a viable path toward more robust, reliable, and verifiable autonomous agents."},{"descriptionType":"Other","description":"10 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11943","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:15:04Z","registered":"2025-09-16T03:15:05Z","published":null,"updated":"2025-10-21T03:40:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11952","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11952","identifiers":[{"identifier":"2509.11952","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Debopom","familyName":"Sutradhar","name":"Sutradhar, Debopom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arefin Ittesafun","familyName":"Abian","name":"Abian, Arefin Ittesafun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohaimenul Azam Khan","familyName":"Raiaan","name":"Raiaan, Mohaimenul Azam Khan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reem E.","familyName":"Mohamed","name":"Mohamed, Reem E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sheikh Izzal","familyName":"Azid","name":"Azid, Sheikh Izzal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sami","familyName":"Azam","name":"Azam, Sami","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CLAIRE: A Dual Encoder Network with RIFT Loss and Phi-3 Small Language Model Based Interpretability for Cross-Modality Synthetic Aperture Radar and Optical Land Cover Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T14:10:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T02:56:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate land cover classification from satellite imagery is crucial in environmental monitoring and sustainable resource management. However, it remains challenging due to the complexity of natural landscapes, the visual similarity between classes, and the significant class imbalance in the available datasets. To address these issues, we propose a dual encoder architecture that independently extracts modality-specific features from optical and Synthetic Aperture Radar (SAR) imagery, which are then fused using a cross-modality attention-fusion module named Cross-modality Land cover segmentation with Attention and Imbalance-aware Reasoning-Enhanced Explanations (CLAIRE). This fusion mechanism highlights complementary spatial and textural features, enabling the network to better capture detailed and diverse land cover patterns. We incorporate a hybrid loss function that utilizes Weighted Focal Loss and Tversky Loss named RIFT (Rare-Instance Focal-Tversky) to address class imbalance and improve segmentation performance across underrepresented categories. Our model achieves competitive performance across multiple benchmarks: a mean Intersection over Union (mIoU) of 56.02% and Overall Accuracy (OA) of 84.56% on the WHU-OPT-SAR dataset; strong generalization with a mIoU of 59.89% and OA of 73.92% on the OpenEarthMap-SAR dataset; and remarkable robustness under cloud-obstructed conditions, achieving an mIoU of 86.86% and OA of 94.58% on the PIE-RGB-SAR dataset. Additionally, we introduce a metric-driven reasoning module generated by a Small Language Model (Phi-3), which generates expert-level, sample-specific justifications for model predictions, thereby enhancing transparency and interpretability."},{"descriptionType":"Other","description":"23 pages, 6 figures, 10 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11952","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:15:18Z","registered":"2025-09-16T03:15:19Z","published":null,"updated":"2025-09-16T03:15:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11957","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11957","identifiers":[{"identifier":"2509.11957","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wen-Yung","familyName":"Wu","name":"Wu, Wen-Yung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pei-Chin","familyName":"Hsieh","name":"Hsieh, Pei-Chin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tai-Shih","familyName":"Chi","name":"Chi, Tai-Shih","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EEND-SAA: Enrollment-Less Main Speaker Voice Activity Detection Using Self-Attention Attractors"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T14:13:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:26:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Voice activity detection (VAD) is essential in speech-based systems, but traditional methods detect only speech presence without identifying speakers. Target-speaker VAD (TS-VAD) extends this by detecting the speech of a known speaker using a short enrollment utterance, but this assumption fails in open-domain scenarios such as meetings or customer service calls, where the main speaker is unknown. We propose EEND-SAA, an enrollment-less, streaming-compatible framework for main-speaker VAD, which identifies the primary speaker without prior knowledge. Unlike TS-VAD, our method determines the main speaker as the one who talks more steadily and clearly, based on speech continuity and volume. We build our model on EEND using two self-attention attractors in a Transformer and apply causal masking for real-time use. Experiments on multi-speaker LibriSpeech mixtures show that EEND-SAA reduces main-speaker DER from 6.63% to 3.61% and improves F1 from 0.9667 to 0.9818 over the SA-EEND baseline, achieving state-of-the-art performance under conditions involving speaker overlap and noise."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11957","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:15:26Z","registered":"2025-09-16T03:15:26Z","published":null,"updated":"2025-09-16T03:15:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11963","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11963","identifiers":[{"identifier":"2509.11963","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mayank","familyName":"Agarwal","name":"Agarwal, Mayank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ibrahim","familyName":"Abdelaziz","name":"Abdelaziz, Ibrahim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kinjal","familyName":"Basu","name":"Basu, Kinjal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Merve","familyName":"Unuvar","name":"Unuvar, Merve","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luis A.","familyName":"Lastras","name":"Lastras, Luis A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yara","familyName":"Rizk","name":"Rizk, Yara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pavan","familyName":"Kapanipathi","name":"Kapanipathi, Pavan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ToolRM: Outcome Reward Models for Tool-Calling Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T14:17:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:26:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-07T18:19:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-08T01:57:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As large language models (LLMs) increasingly interact with external tools, reward modeling for tool use has emerged as a critical yet underexplored area of research. Existing reward models, trained primarily on natural language outputs, struggle to evaluate tool-based reasoning and execution. To quantify this gap, we introduce FC-RewardBench, the first benchmark to systematically evaluate reward models in tool-calling scenarios. Our analysis shows that current reward models frequently miss key signals of effective tool use, highlighting the need for domain-specific modeling. We address this by proposing a training framework for outcome reward models using data synthesized from permissively licensed, open-weight LLMs. We introduce ToolRM - a suite of reward models for tool-use ranging from 1.7B to 14B parameters. Across diverse settings, these models consistently outperform general-purpose baselines. Notably, they achieve up to a 25% improvement with Best-of-N sampling, while also improving robustness to input noise, enabling effective data filtering, and supporting RL-training of policy models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11963","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:15:34Z","registered":"2025-09-16T03:15:35Z","published":null,"updated":"2026-01-08T03:06:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11973","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11973","identifiers":[{"identifier":"2509.11973","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Markus J.","familyName":"Buehler","name":"Buehler, Markus J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MusicSwarm: Biologically Inspired Intelligence for Music Composition"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T14:23:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:27:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We show that coherent, long-form musical composition can emerge from a decentralized swarm of identical, frozen foundation models that coordinate via stigmergic, peer-to-peer signals, without any weight updates. We compare a centralized multi-agent system with a global critic to a fully decentralized swarm in which bar-wise agents sense and deposit harmonic, rhythmic, and structural cues, adapt short-term memory, and reach consensus. Across symbolic, audio, and graph-theoretic analyses, the swarm yields superior quality while delivering greater diversity and structural variety and leads across creativity metrics. The dynamics contract toward a stable configuration of complementary roles, and self-similarity networks reveal a small-world architecture with efficient long-range connectivity and specialized bridging motifs, clarifying how local novelties consolidate into global musical form. By shifting specialization from parameter updates to interaction rules, shared memory, and dynamic consensus, MusicSwarm provides a compute- and data-efficient route to long-horizon creative structure that is immediately transferable beyond music to collaborative writing, design, and scientific discovery."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11973","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:15:48Z","registered":"2025-09-16T03:15:48Z","published":null,"updated":"2025-09-16T03:15:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11983","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11983","identifiers":[{"identifier":"2509.11983","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chuan","familyName":"He","name":"He, Chuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhanwang","familyName":"Deng","name":"Deng, Zhanwang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaosong","familyName":"Lu","name":"Lu, Zhaosong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Low-rank Orthogonalization for Large-scale Matrix Optimization with Applications to Foundation Model Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"49M37, 90C30, 90C90","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-15T14:28:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:27:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-19T16:56:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-21T01:19:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-17T11:40:05Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-18T00:50:33Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Neural network (NN) training is inherently a large-scale matrix optimization problem, yet the matrix structure of NN parameters has long been overlooked. Recently, the optimizer Muon \\citep{jordanmuon}, which explicitly exploits this structure, has gained significant attention for its strong performance in foundation model training. A key component contributing to Muon's success is matrix orthogonalization. In this paper, we propose \\textit{low-rank orthogonalization}, which performs orthogonalization by leveraging the low-rank nature of gradients during NN training. Building on this, we introduce low-rank matrix-signed gradient descent (MSGD) and a low-rank variant of Muon. %Numerical experiments demonstrate the superior performance of low-rank orthogonalization, with low-rank Muon achieving promising results in GPT-2 and LLaMA pretraining---surpassing the carefully tuned vanilla Muon on tasks with large model sizes. {Numerical experiments demonstrate the advantages of low-rank orthogonalization: low-rank Muon generally matches or improves upon vanilla Muon on the GPT-2 and LLaMA pretraining tasks, with clearer improvements observed for relatively larger models.} Theoretically, we establish the iteration complexity of low-rank MSGD for finding an approximate stationary solution, and the iteration complexity of low-rank Muon for finding an approximate stochastic stationary solution under heavy-tailed noise. The code to reproduce our numerical experiments is available at https://github.com/dengzhanwang/Low-rank-Muon."},{"descriptionType":"Other","description":"26 pages, add numerical comparison with Galore and SOAP"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11983","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:16:03Z","registered":"2025-09-16T03:16:03Z","published":null,"updated":"2026-09-18T02:44:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11988","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11988","identifiers":[{"identifier":"2509.11988","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nutthawara","familyName":"Buatthaisong","name":"Buatthaisong, Nutthawara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Inigo Val","familyName":"Slijepcevic","name":"Slijepcevic, Inigo Val","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna M. M.","familyName":"Scaife","name":"Scaife, Anna M. M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Micah","familyName":"Bowles","name":"Bowles, Micah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Hopkins","name":"Hopkins, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Devina","familyName":"Mohan","name":"Mohan, Devina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stanislav S","familyName":"Shabala","name":"Shabala, Stanislav S","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"O. Ivy","familyName":"Wong","name":"Wong, O. Ivy","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Radio Galaxy Zoo: Morphological classification by Fanaroff-Riley designation using self-supervised pre-training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Instrumentation and Methods for Astrophysics (astro-ph.IM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T14:40:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-12-03T14:36:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1093/mnras/staf1942","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study, we examine over 14,000 radio galaxies finely selected from Radio Galaxy Zoo (RGZ) project and provide classifications for approximately 5,900 FRIs and 8,100 FRIIs. We present an analysis of these predicted radio galaxy morphologies for the RGZ catalogue, classified using a pre-trained radio galaxy foundation model that has been fine-tuned to predict Fanaroff-Riley (FR) morphology. As seen in previous studies, our results show overlap between morphologically classified FRI and FRII luminosity-size distributions and we find that the model's confidence in its predictions is lowest in this overlap region, suggesting that source morphologies are more ambiguous. We identify the presence of low-luminosity FRII sources, the proportion of which, with respect to the total number of FRIIs, is consistent with previous studies. However, a comparison of the low-luminosity FRII sources found in this work with those identified by previous studies reveals differences that may indicate their selection is influenced by the choice of classification methodology. We investigate the impacts of both pre-training and fine-tuning data selection on model performance for the downstream classification task, and show that while different pre-training data choices affect model confidence they do not appear to cause systematic generalisation biases for the range of physical and observational characteristics considered in this work; however, we note that the same is not necessarily true for fine-tuning. As automated approaches to astronomical source identification and classification become increasingly prevalent, we highlight training data choices that can affect the model outputs and propagate into downstream analyses."},{"descriptionType":"Other","description":"Submitted to MNRAS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11988","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:16:10Z","registered":"2025-09-16T03:16:10Z","published":null,"updated":"2025-12-05T03:06:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12019","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12019","identifiers":[{"identifier":"2509.12019","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sangjun","familyName":"Lee","name":"Lee, Sangjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seung-taek","familyName":"Woo","name":"Woo, Seung-taek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungyu","familyName":"Jin","name":"Jin, Jungyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changhun","familyName":"Lee","name":"Lee, Changhun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eunhyeok","familyName":"Park","name":"Park, Eunhyeok","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AMQ: Enabling AutoML for Mixed-precision Weight-Only Quantization of Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T14:59:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:30:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"To enable broader deployment of Large Language Models (LLMs), it is essential to identify the best-performing model under strict memory constraints. We present AMQ, Automated Mixed-Precision Weight-Only Quantization, a framework that assigns layer-wise quantization bit-widths to optimally balance model quality and memory usage. However, the combinatorial search space, with over 10^{100} possible configurations, makes conventional black-box optimization infeasible. AMQ overcomes this challenge through four key innovations:(1) search space pruning using prior knowledge to exclude unpromising configurations, (2) quantization proxy to bypass costly format conversions during search, (3) quality predictor to minimize evaluation overhead, and (4) iterative search-and-update strategy for fast and stable convergence. By integrating these components, AMQ efficiently explores the quality-efficiency landscape, reaching the Pareto frontier and yielding LLMs that are both compact and high-performing. Our code is available at https://github.com/dlwns147/amq."},{"descriptionType":"Other","description":"EMNLP 2025 Main Conference, Long Paper (Oral)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12019","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:16:57Z","registered":"2025-09-16T03:16:58Z","published":null,"updated":"2025-09-16T03:16:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12053","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12053","identifiers":[{"identifier":"2509.12053","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yujun","familyName":"Lin","name":"Lin, Yujun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhekai","familyName":"Zhang","name":"Zhang, Zhekai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Song","familyName":"Han","name":"Han, Song","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LEGO: Spatial Accelerator Generation and Optimization for Tensor Applications"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T15:36:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:32:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/hpca61900.2025.00101","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern tensor applications, especially foundation models and generative AI applications require multiple input modalities (both vision and language), which increases the demand for flexible accelerator architecture. Existing frameworks suffer from the trade-off between design flexibility and productivity of RTL generation: either limited to very few hand-written templates or cannot automatically generate the RTL. To address this challenge, we propose the LEGO framework, which targets tensor applications and automatically generates spatial architecture design and outputs synthesizable RTL code without handwritten RTL design templates. Leveraging the affine-transformation-based architecture representation, LEGO front end finds interconnections between function units, synthesizes the memory system, and fuses different spatial dataflow designs based on data reuse analysis. LEGO back end then translates the hardware in a primitive-level graph to perform lower-level optimizations, and applies a set of linear-programming algorithms to optimally insert pipeline registers and reduce the overhead of unused logic when switching spatial dataflows. Our evaluation demonstrates that LEGO can achieve 3.2x speedup and 2.4x energy efficiency compared to previous work Gemmini, and can generate one architecture for diverse modern foundation models in generative AI applications."},{"descriptionType":"Other","description":"The first two authors have equal contributions; Published as a conference paper in HPCA 2025; 13 pages, 14 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12053","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:17:50Z","registered":"2025-09-16T03:17:50Z","published":null,"updated":"2025-09-16T03:17:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12060","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12060","identifiers":[{"identifier":"2509.12060","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wei","familyName":"Cai","name":"Cai, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shujuan","familyName":"Liu","name":"Liu, Shujuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Zhao","name":"Zhao, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyan","familyName":"Shi","name":"Shi, Ziyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yusheng","familyName":"Zhao","name":"Zhao, Yusheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Yuan","name":"Yuan, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianle","familyName":"Zhang","name":"Zhang, Tianle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chi","familyName":"Zhang","name":"Zhang, Chi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuelong","familyName":"Li","name":"Li, Xuelong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Safe Unimodal Inputs Collide: Optimizing Reasoning Chains for Cross-Modal Safety in Multimodal Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T15:40:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:33:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T06:19:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:26:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Large Language Models (MLLMs) are susceptible to the implicit reasoning risk, wherein innocuous unimodal inputs synergistically assemble into risky multimodal data that produce harmful outputs. We attribute this vulnerability to the difficulty of MLLMs maintaining safety alignment through long-chain reasoning. To address this issue, we introduce Safe-Semantics-but-Unsafe-Interpretation (SSUI), the first dataset featuring interpretable reasoning paths tailored for such a cross-modal challenge. A novel training framework, Safety-aware Reasoning Path Optimization (SRPO), is also designed based on the SSUI dataset to align the MLLM's internal reasoning process with human safety values. Experimental results show that our SRPO-trained models achieve state-of-the-art results on key safety benchmarks, including the proposed Reasoning Path Benchmark (RSBench), significantly outperforming both open-source and top-tier commercial MLLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12060","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:18:00Z","registered":"2025-09-16T03:18:01Z","published":null,"updated":"2025-09-17T02:12:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12065","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12065","identifiers":[{"identifier":"2509.12065","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alina","familyName":"Klerings","name":"Klerings, Alina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jannik","familyName":"Brinkmann","name":"Brinkmann, Jannik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Ruffinelli","name":"Ruffinelli, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Ponzetto","name":"Ponzetto, Simone","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Steering Language Models in Multi-Token Generation: A Case Study on Tense and Aspect"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-15T15:48:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:33:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are able to generate grammatically well-formed text, but how do they encode their syntactic knowledge internally? While prior work has focused largely on binary grammatical contrasts, in this work, we study the representation and control of two multidimensional hierarchical grammar phenomena - verb tense and aspect - and for each, identify distinct, orthogonal directions in residual space using linear discriminant analysis. Next, we demonstrate causal control over both grammatical features through concept steering across three generation tasks. Then, we use these identified features in a case study to investigate factors influencing effective steering in multi-token generation. We find that steering strength, location, and duration are crucial parameters for reducing undesirable side effects such as topic shift and degeneration. Our findings suggest that models encode tense and aspect in structurally organized, human-like ways, but effective control of such features during generation is sensitive to multiple factors and requires manual tuning or automated optimization."},{"descriptionType":"Other","description":"to be published in The 2025 Conference on Empirical Methods in Natural Language Processing"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12065","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:18:08Z","registered":"2025-09-16T03:18:09Z","published":null,"updated":"2025-09-16T03:18:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12079","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12079","identifiers":[{"identifier":"2509.12079","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaodong","familyName":"Wang","name":"Wang, Xiaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Wang","name":"Wang, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijun","familyName":"He","name":"He, Zijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengjie","familyName":"Qin","name":"Qin, Mengjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Yuan","name":"Yuan, Xin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Progressive Flow-inspired Unfolding for Spectral Compressive Imaging"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:10:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:34:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Coded aperture snapshot spectral imaging (CASSI) retrieves a 3D hyperspectral image (HSI) from a single 2D compressed measurement, which is a highly challenging reconstruction task. Recent deep unfolding networks (DUNs), empowered by explicit data-fidelity updates and implicit deep denoisers, have achieved the state of the art in CASSI reconstruction. However, existing unfolding approaches suffer from uncontrollable reconstruction trajectories, leading to abrupt quality jumps and non-gradual refinement across stages. Inspired by diffusion trajectories and flow matching, we propose a novel trajectory-controllable unfolding framework that enforces smooth, continuous optimization paths from noisy initial estimates to high-quality reconstructions. To achieve computational efficiency, we design an efficient spatial-spectral Transformer tailored for hyperspectral reconstruction, along with a frequency-domain fusion module to gurantee feature consistency. Experiments on simulation and real data demonstrate that our method achieves better reconstruction quality and efficiency than prior state-of-the-art approaches."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12079","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:18:29Z","registered":"2025-09-16T03:18:30Z","published":null,"updated":"2025-09-16T03:18:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12080","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12080","identifiers":[{"identifier":"2509.12080","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zijian","familyName":"Wang","name":"Wang, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Tao","name":"Tao, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jifan","familyName":"Shi","name":"Shi, Jifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Bao","name":"Bao, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Liu","name":"Liu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luonan","familyName":"Chen","name":"Chen, Luonan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Time-Series Foundation Model by Universal Delay Embedding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:11:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:34:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study introduces Universal Delay Embedding (UDE), a pretrained foundation model designed to revolutionize time-series forecasting through principled integration of delay embedding representation and Koopman operator prediction. Leveraging Takens' embedding theorem, UDE as a dynamical representation of observed data constructs two-dimensional subspace patches from Hankel matrices, theoretically preserving dynamical and topological properties of underlying dynamical systems. Such patches are viewed as images, which can be efficiently processed by exploiting advanced deep learning technologies. Computationally, these patches further serve as tokens for learning a self-attention encoder, thus enabling accurate prediction of nonlinear time-series by a finite-dimensional Koopman operator in a linear manner in a latent space. Extensive evaluations across various benchmarks and real-world climate datasets demonstrate over 20% average reduction in mean squared error versus state-of-the-art foundation models, alongside superior generalization in fine-tuning scenarios. In particular, the learned dynamical representations and Koopman operator prediction forms from the patches exhibit exceptional interpretability, with consistent identification of topologically informative subspaces and robust encoding of domain-invariant dynamics, establishing UDE as a scalable, interpretable framework for universal time-series modeling and forecasting with broad scientific and industrial applicability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12080","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:18:31Z","registered":"2025-09-16T03:18:31Z","published":null,"updated":"2025-09-16T03:18:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12089","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12089","identifiers":[{"identifier":"2509.12089","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiying","familyName":"Hu","name":"Hu, Qiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaowen","familyName":"Li","name":"Li, Yaowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyi","familyName":"Zhang","name":"Zhang, Shengyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuan","familyName":"Huang","name":"Huang, Chuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Liu","name":"Liu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"You","familyName":"He","name":"He, You","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RadarPLM: Adapting Pre-trained Language Models for Marine Radar Target Detection by Selective Fine-tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:16:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:34:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T20:50:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-20T00:07:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-03T12:07:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-04T02:32:45Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-02T17:57:13Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-05T01:46:37Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-01-08T13:35:28Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-01-09T01:43:23Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-04-30T05:20:05Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-05-01T00:25:25Z","dateType":"Updated","dateInformation":"v6"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in pre-trained language models (PLMs) have demonstrated their capabilities in capturing universal knowledge, making them promising for radar signal processing applications. Nevertheless, directly fine-tuning PLMs on radar signals is both computationally expensive and prone to overfitting, particularly in low signal-to-clutter ratio (SCR) environments. To mitigate both issues, an effective fine-tuning framework for PLM-based marine radar target detection is proposed. First, we design a lightweight adaptation module, enabling computationally efficient fine-tuning while preserving the pre-trained model's general knowledge. Second, an effective selective fine-tuning strategy is developed to selectively optimize different feature patches based on their online-evaluated learning values, guiding the model to concentrate on those generalizable feature patterns and significantly reducing model overfitting to nosiy, anomalous, or overly simple patterns during optimization. Finally, a binary classification head is retrained based on autoencoder network to further enhance detection performance. Evaluations on real-world radar datasets highlight that the proposed RadarPLM framework considerably outperforms existing models, achieving a minimum of 6.35% gain in average detection performance under challenging low SCR conditions when using sequence features. In particular, under small-sample training conditions, RadarPLM also achieves highly significant average performance gains over prior methods, demonstrating the effectiveness of integrating the PLM."},{"descriptionType":"Other","description":"Preprint,in submission"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12089","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:18:44Z","registered":"2025-09-16T03:18:45Z","published":null,"updated":"2026-05-01T02:31:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12108","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12108","identifiers":[{"identifier":"2509.12108","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Min","familyName":"Zeng","name":"Zeng, Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingfei","familyName":"Sun","name":"Sun, Jingfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xueyou","familyName":"Luo","name":"Luo, Xueyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caiquan","familyName":"Liu","name":"Liu, Caiquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiqi","familyName":"Zhang","name":"Zhang, Shiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Xie","name":"Xie, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoxin","familyName":"Chen","name":"Chen, Xiaoxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GTA: Supervised-Guided Reinforcement Learning for Text Classification with Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:33:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:36:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T05:13:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:24:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In natural language processing tasks, pure reinforcement learning (RL) fine-tuning methods often suffer from inefficient exploration and slow convergence; while supervised fine-tuning (SFT) methods, although efficient in training, have limited performance ceiling and less solid theoretical foundation compared to RL. To address efficiency-capability trade-off, we propose the Guess-Think-Answer (GTA) framework that combines the efficiency of SFT with the capability gains of RL in a unified training paradigm. GTA works by having the model first produce a provisional guess (optimized via cross-entropy loss), then reflect on this guess before generating the final answer, with RL rewards shaping both the final output and the format of the entire GTA structure. This hybrid approach achieves both faster convergence than pure RL and higher performance ceiling than pure SFT. To mitigate gradient conflicts between the two training signals, we employ loss masking and gradient constraints. Empirical results on four text classification benchmarks demonstrate that GTA substantially accelerates convergence while outperforming both standalone SFT and RL baselines."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12108","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:11Z","registered":"2025-09-16T03:19:12Z","published":null,"updated":"2025-09-17T02:12:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12110","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12110","identifiers":[{"identifier":"2509.12110","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiying","familyName":"Hu","name":"Hu, Qiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linping","familyName":"Zhang","name":"Zhang, Linping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xueqian","familyName":"Wang","name":"Wang, Xueqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Li","name":"Li, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Liu","name":"Liu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao-Ping","familyName":"Zhang","name":"Zhang, Xiao-Ping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When marine radar target detection meets pretrained large language models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:38:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:36:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep learning (DL) methods are widely used to extract high-dimensional patterns from the sequence features of radar echo signals. However, conventional DL algorithms face challenges such as redundant feature segments, and constraints from restricted model sizes. To address these issues, we propose a framework that integrates feature preprocessing with large language models (LLMs). Our preprocessing module tokenizes radar sequence features, applies a patch selection algorithm to filter out uninformative segments, and projects the selected patches into embeddings compatible with the feature space of pre-trained LLMs. Leveraging these refined embeddings, we incorporate a pre-trained LLM, fine-tuning only the normalization layers to reduce training burdens while enhancing performance. Experiments on measured datasets demonstrate that the proposed method significantly outperforms the state-of-the-art baselines on supervised learning tests."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12110","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:14Z","registered":"2025-09-16T03:19:14Z","published":null,"updated":"2025-09-16T03:19:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12112","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12112","identifiers":[{"identifier":"2509.12112","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaxuan","familyName":"Zhao","name":"Zhao, Jiaxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naibin","familyName":"Gu","name":"Gu, Naibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Feng","name":"Feng, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiyu","familyName":"Liu","name":"Liu, Xiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Fu","name":"Fu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Lin","name":"Lin, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiping","familyName":"Wang","name":"Wang, Weiping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CBP-Tuning: Efficient Local Customization for Black-box Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:41:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:36:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The high costs of customizing large language models (LLMs) fundamentally limit their adaptability to user-specific needs. Consequently, LLMs are increasingly offered as cloud-based services, a paradigm that introduces critical limitations: providers struggle to support personalized customization at scale, while users face privacy risks when exposing sensitive data. To address this dual challenge, we propose Customized Black-box Prompt Tuning (CBP-Tuning), a novel framework that facilitates efficient local customization while preserving bidirectional privacy. Specifically, we design a two-stage framework: (1) a prompt generator trained on the server-side to capture domain-specific and task-agnostic capabilities, and (2) user-side gradient-free optimization that tailors soft prompts for individual tasks. This approach eliminates the need for users to access model weights or upload private data, requiring only a single customized vector per task while achieving effective adaptation. Furthermore, the evaluation of CBP-Tuning in the commonsense reasoning, medical and financial domain settings demonstrates superior performance compared to baselines, showcasing its advantages in task-agnostic processing and privacy preservation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12112","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:16Z","registered":"2025-09-16T03:19:17Z","published":null,"updated":"2025-09-16T03:19:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12129","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12129","identifiers":[{"identifier":"2509.12129","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiazhao","familyName":"Zhang","name":"Zhang, Jiazhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anqi","familyName":"Li","name":"Li, Anqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunpeng","familyName":"Qi","name":"Qi, Yunpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghan","familyName":"Li","name":"Li, Minghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahang","familyName":"Liu","name":"Liu, Jiahang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoan","familyName":"Wang","name":"Wang, Shaoan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoran","familyName":"Liu","name":"Liu, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gengze","familyName":"Zhou","name":"Zhou, Gengze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuze","familyName":"Wu","name":"Wu, Yuze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingxing","familyName":"Li","name":"Li, Xingxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxin","familyName":"Fan","name":"Fan, Yuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjun","familyName":"Li","name":"Li, Wenjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhibo","familyName":"Chen","name":"Chen, Zhibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Gao","name":"Gao, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Wu","name":"Wu, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhizheng","familyName":"Zhang","name":"Zhang, Zhizheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Wang","name":"Wang, He","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Embodied Navigation Foundation Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:52:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:37:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T18:15:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:03:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Navigation is a fundamental capability in embodied AI, representing the intelligence required to perceive and interact within physical environments following language instructions. Despite significant progress in large Vision-Language Models (VLMs), which exhibit remarkable zero-shot performance on general vision-language tasks, their generalization ability in embodied navigation remains largely confined to narrow task settings and embodiment-specific architectures. In this work, we introduce a cross-embodiment and cross-task Navigation Foundation Model (NavFoM), trained on eight million navigation samples that encompass quadrupeds, drones, wheeled robots, and vehicles, and spanning diverse tasks such as vision-and-language navigation, object searching, target tracking, and autonomous driving. NavFoM employs a unified architecture that processes multimodal navigation inputs from varying camera configurations and navigation horizons. To accommodate diverse camera setups and temporal horizons, NavFoM incorporates identifier tokens that embed camera view information of embodiments and the temporal context of tasks. Furthermore, to meet the demands of real-world deployment, NavFoM controls all observation tokens using a dynamically adjusted sampling strategy under a limited token length budget. Extensive evaluations on public benchmarks demonstrate that our model achieves state-of-the-art or highly competitive performance across multiple navigation tasks and embodiments without requiring task-specific fine-tuning. Additional real-world experiments further confirm the strong generalization capability and practical applicability of our approach."},{"descriptionType":"Other","description":"Project Page: https://pku-epic.github.io/NavFoM-Web/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12129","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:39Z","registered":"2025-09-16T03:19:40Z","published":null,"updated":"2025-09-18T17:36:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12130","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12130","identifiers":[{"identifier":"2509.12130","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ariana","familyName":"Sahitaj","name":"Sahitaj, Ariana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaao","familyName":"Li","name":"Li, Jiaao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pia Wenzel","familyName":"Neves","name":"Neves, Pia Wenzel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fedor","familyName":"Splitt","name":"Splitt, Fedor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Premtim","familyName":"Sahitaj","name":"Sahitaj, Premtim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charlott","familyName":"Jakob","name":"Jakob, Charlott","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Veronika","familyName":"Solopova","name":"Solopova, Veronika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vera","familyName":"Schmitt","name":"Schmitt, Vera","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"XplaiNLP at CheckThat! 2025: Multilingual Subjectivity Detection with Finetuned Transformers and Prompt-Based Inference with Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:53:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:37:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This notebook reports the XplaiNLP submission to the CheckThat! 2025 shared task on multilingual subjectivity detection. We evaluate two approaches: (1) supervised fine-tuning of transformer encoders, EuroBERT, XLM-RoBERTa, and German-BERT, on monolingual and machine-translated training data; and (2) zero-shot prompting using two LLMs: o3-mini for Annotation (rule-based labelling) and gpt-4.1-mini for DoubleDown (contrastive rewriting) and Perspective (comparative reasoning). The Annotation Approach achieves 1st place in the Italian monolingual subtask with an F_1 score of 0.8104, outperforming the baseline of 0.6941. In the Romanian zero-shot setting, the fine-tuned XLM-RoBERTa model obtains an F_1 score of 0.7917, ranking 3rd and exceeding the baseline of 0.6461. The same model also performs reliably in the multilingual task and improves over the baseline in Greek. For German, a German-BERT model fine-tuned on translated training data from typologically related languages yields competitive performance over the baseline. In contrast, performance in the Ukrainian and Polish zero-shot settings falls slightly below the respective baselines, reflecting the challenge of generalization in low-resource cross-lingual scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12130","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:41Z","registered":"2025-09-16T03:19:41Z","published":null,"updated":"2025-09-16T03:19:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12132","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12132","identifiers":[{"identifier":"2509.12132","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pu","familyName":"Jian","name":"Jian, Pu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhong","familyName":"Wu","name":"Wu, Junhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Sun","name":"Sun, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Wang","name":"Wang, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Ren","name":"Ren, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajun","familyName":"Zhang","name":"Zhang, Jiajun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Look Again, Think Slowly: Enhancing Visual Reflection in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:57:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:37:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in text-only \"slow-thinking\" reasoning have prompted efforts to transfer this capability to vision-language models (VLMs), for training visual reasoning models (\\textbf{VRMs}). owever, such transfer faces critical challenges: Effective \"slow thinking\" in VRMs requires \\textbf{visual reflection}, the ability to check the reasoning process based on visual information. Through quantitative analysis, we observe that current VRMs exhibit limited visual reflection, as their attention to visual information diminishes rapidly with longer generated responses. To address this challenge, we propose a new VRM \\textbf{Reflection-V}, which enhances visual reflection based on reasoning data construction for cold-start and reward design for reinforcement learning (RL). Firstly, we construct vision-centered reasoning data by leveraging an agent that interacts between VLMs and reasoning LLMs, enabling cold-start learning of visual reflection patterns. Secondly, a visual attention based reward model is employed during RL to encourage reasoning based on visual information. Therefore, \\textbf{Reflection-V} demonstrates significant improvements across multiple visual reasoning benchmarks. Furthermore, \\textbf{Reflection-V} maintains a stronger and more consistent reliance on visual information during visual reasoning, indicating effective enhancement in visual reflection capabilities."},{"descriptionType":"Other","description":"EMNLP2025 Main"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12132","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:43Z","registered":"2025-09-16T03:19:44Z","published":null,"updated":"2025-09-16T03:19:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12136","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12136","identifiers":[{"identifier":"2509.12136","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomer","familyName":"Bitan","name":"Bitan, Tomer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tal","familyName":"Kadosh","name":"Kadosh, Tal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erel","familyName":"Kaplan","name":"Kaplan, Erel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shira","familyName":"Meiri","name":"Meiri, Shira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Le","familyName":"Chen","name":"Chen, Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Morales","name":"Morales, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niranjan","familyName":"Hasabnis","name":"Hasabnis, Niranjan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gal","familyName":"Oren","name":"Oren, Gal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UniPar: A Unified LLM-Based Framework for Parallel and Accelerated Code Translation in HPC"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:03:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:38:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Translating programs between various parallel programming languages is an important problem in the high-performance computing (HPC) community. Existing tools for this problem are either too narrow in scope and/or outdated. Recent explosive growth in the popularity of large language models (LLMs) and their ability to generate and translate code offers a potential alternative approach. Toward that end, we first need to systematically evaluate the ability of LLMs to translate between parallel languages.\n In this work, we introduce UniPar, a systematic evaluation framework for LLM-based parallel code translation. Specifically, in this work, we target translations between serial code, CUDA, and OpenMP. Our goal is to assess how well current instruction-tuned LLMs -- specifically GPT-4o-mini and LLaMA-3.3-70B-Instruct -- can be used out of the box or enhanced through known strategies. We evaluated four major usage modes: hyperparameter optimization for decoding, zero- and few-shot prompting, supervised fine-tuning, and iterative feedback through compiler-based repair. As a part of the evaluation, we construct a new dataset called PARATRANS, covering both serial-to-parallel translation and cross-paradigm transformations.\n Our findings reveal that while off-the-shelf models struggle under the default settings (e.g., GPT-4o-mini achieves only 46% compilation and 15% functional correctness), our UniPar methodology -- combining fine-tuning, hyperparameter tuning, and compiler-guided repair -- improves performance by up to 2X (69% compilation and 33% correctness). We believe that our findings will provide useful insights for researchers to further improve LLMs for the parallel language translation problem.\n UniPar source code and PARATRANS dataset are available at our GitHub repository https://github.com/Scientific-Computing-Lab/UniPar_AI."},{"descriptionType":"Other","description":"Accepted to IEEE HPEC conference 2025. 9 pages, incl references"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12136","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:49Z","registered":"2025-09-16T03:19:49Z","published":null,"updated":"2025-09-16T03:19:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12141","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12141","identifiers":[{"identifier":"2509.12141","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weihao","familyName":"Zhu","name":"Zhu, Weihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Shi","name":"Shi, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Wei","name":"Wei, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Mei","name":"Mei, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Wang","name":"Wang, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaheng","familyName":"Wang","name":"Wang, Jiaheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Li","name":"Li, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When MoE Meets Blockchain: A Trustworthy Distributed Framework of Large Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:05:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:38:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T01:51:29Z","dateType":"Withdrawn","dateInformation":"v2; We need to revise the content of this article"},{"date":"2025-09-17T00:15:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As an enabling architecture of Large Models (LMs), Mixture of Experts (MoE) has become prevalent thanks to its sparsely-gated mechanism, which lowers computational overhead while maintaining learning performance comparable to dense LMs. The essence of MoE lies in utilizing a group of neural networks (called experts) with each specializing in different types of tasks, along with a trainable gating network that selectively activates a subset of these experts to handle specific tasks. Traditional cloud-based MoE encounters challenges such as prolonged response latency, high bandwidth consumption, and data privacy leakage. To address these issues, researchers have proposed to deploy MoE over distributed edge networks. However, a key concern of distributed MoE frameworks is the lack of trust in data interactions among distributed experts without the surveillance of any trusted authority, and thereby prone to potential attacks such as data manipulation. In response to the security issues of traditional distributed MoE, we propose a blockchain-aided trustworthy MoE (B-MoE) framework that consists of three layers: the edge layer, the blockchain layer, and the storage layer. In this framework, the edge layer employs the activated experts downloaded from the storage layer to process the learning tasks, while the blockchain layer functions as a decentralized trustworthy network to trace, verify, and record the computational results of the experts from the edge layer. The experimental results demonstrate that B-MoE is more robust to data manipulation attacks than traditional distributed MoE during both the training and inference processes."},{"descriptionType":"Other","description":"We need to revise the content of this article"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12141","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:55Z","registered":"2025-09-16T03:19:56Z","published":null,"updated":"2025-09-17T02:13:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12159","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12159","identifiers":[{"identifier":"2509.12159","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jingyu","familyName":"Xiao","name":"Xiao, Jingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongyi","familyName":"Zhang","name":"Zhang, Zhongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Wan","name":"Wan, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yintong","familyName":"Huo","name":"Huo, Yintong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Liu","name":"Liu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael R.","familyName":"Lyu","name":"Lyu, Michael R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EfficientUICoder: A Bidirectional Token Compression Framework for Efficient MLLM-Based UI Code Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:23:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:39:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-27T08:23:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-30T00:28:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3808114","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Large Language Models have demonstrated exceptional performance in UI2Code tasks, significantly enhancing website development efficiency. However, these tasks incur substantially higher computational overhead than traditional code generation due to the large number of input image tokens and extensive output code tokens required. Our comprehensive study identifies significant redundancies in both image and code tokens that exacerbate computational complexity and hinder focus on key UI elements, resulting in excessively lengthy and often invalid HTML files. We propose EfficientUICoder, a compression framework for efficient UI code generation with three key components. First, Element and Layout-aware Token Compression preserves essential UI information by detecting element regions and constructing UI element trees. Second, Region-aware Token Refinement leverages attention scores to discard low-attention tokens from selected regions while integrating high-attention tokens from unselected regions. Third, Adaptive Duplicate Token Suppression dynamically reduces repetitive generation by tracking HTML/CSS structure frequencies and applying exponential penalties. Extensive experiments show EfficientUICoder achieves a 55%-60% compression ratio without compromising webpage quality and delivers superior efficiency improvements: reducing computational cost by 44.9%, generated tokens by 41.4%, prefill time by 46.6%, and inference time by 48.8% on 34B-level MLLMs. Code is available at https://github.com/WebPAI/EfficientUICoder."},{"descriptionType":"Other","description":"Published in the Proceedings of the 2026 ACM International Conference on the Foundations of Software Engineering (FSE 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12159","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:20:21Z","registered":"2025-09-16T03:20:22Z","published":null,"updated":"2026-06-30T04:06:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12160","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12160","identifiers":[{"identifier":"2509.12160","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Quan","familyName":"Nguyen","name":"Nguyen, Quan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christine","familyName":"Holland","name":"Holland, Christine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siddharth","familyName":"Sridhar","name":"Sridhar, Siddharth","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Design and Optimization of EV Charging Infrastructure with Battery in Commercial Buildings"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:23:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:39:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-27T21:32:57Z","dateType":"Withdrawn","dateInformation":"v2; This paper contains references to several concepts that are not aligned with current DOE guidance (decarbonization, state mandates, green energy, etc.)"},{"date":"2025-10-29T00:12:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The installation of electric vehicle (EV) charging stations in buildings is inevitable, as states push for increased EV adoption to support decarbonization efforts. This transition could force the need for grid infrastructure upgrades and enhanced controls to support reliable power delivery to end-use loads, and overall economic operation. This paper evaluates strategies that address these needs on two fronts: i) optimal sizing of service transformers and battery energy storage systems (BESS), and ii) optimized coordination between EV charging, BESS operation, and building demand. These strategies are applied to a school campus setting, consisting of building and EV charging loads, to provide an illustration of energy management in commercial buildings with EV fleets. A rolling-window optimization approach is applied to determine i) optimal sizing of the service transformer and BESS and ii) optimal control of EV charging and BESS charge/discharge schedules. The design and control strategies are validated in a 20-year time horizon with an annually increasing number of EVs (buses and vans). In addition, an economic analysis is also carried out to show the costs and benefits of each design as a medium- and long-term investment."},{"descriptionType":"Other","description":"This paper contains references to several concepts that are not aligned with current DOE guidance (decarbonization, state mandates, green energy, etc.)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12160","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:20:22Z","registered":"2025-09-16T03:20:23Z","published":null,"updated":"2025-10-29T02:22:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12196","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12196","identifiers":[{"identifier":"2509.12196","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hunjae","familyName":"Lee","name":"Lee, Hunjae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Corey","familyName":"Clark","name":"Clark, Corey","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Relational Priming Improves Transformer in Multivariate Time Series"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:56:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:41:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-23T18:24:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-25T01:09:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Standard attention mechanisms in transformers employ static token representations that remain unchanged across all pair-wise computations in each layer. This limits their representational alignment with the potentially diverse relational dynamics of each token-pair interaction. While they excel in domains with relatively homogeneous relationships, standard attention's static relational learning struggles to capture the diverse, heterogeneous inter-channel dependencies of multivariate time series (MTS) data--where different channel-pair interactions within a single system may be governed by entirely different physical laws or temporal dynamics. To better align the attention mechanism for such domain phenomena, we propose attention with dynamic relational priming (prime attention). Unlike standard attention where each token presents an identical representation across all of its pair-wise interactions, prime attention tailors each token dynamically (or per interaction) through learnable modulations to best capture the unique relational dynamics of each token pair, optimizing each pair-wise interaction for that specific relationship. This representational plasticity of prime attention enables effective extraction of relationship-specific information in MTS while maintaining the same asymptotic computational complexity as standard attention. Our results demonstrate that prime attention consistently outperforms standard attention across benchmarks, achieving up to 6.5\\% improvement in forecasting accuracy. In addition, we find that prime attention achieves comparable or superior performance using up to 40\\% less sequence length compared to standard attention, further demonstrating its superior relational modeling capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12196","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:21:13Z","registered":"2025-09-16T03:21:14Z","published":null,"updated":"2026-08-25T03:49:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12203","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12203","identifiers":[{"identifier":"2509.12203","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zixin","familyName":"Yin","name":"Yin, Zixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xili","familyName":"Dai","name":"Dai, Xili","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duomin","familyName":"Wang","name":"Wang, Duomin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianfang","familyName":"Zeng","name":"Zeng, Xianfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lionel M.","familyName":"Ni","name":"Ni, Lionel M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Yu","name":"Yu, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heung-Yeung","familyName":"Shum","name":"Shum, Heung-Yeung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LazyDrag: Enabling Stable Drag-Based Editing on Multi-Modal Diffusion Transformers via Explicit Correspondence"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:59:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:42:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T03:37:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:20:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-03T11:16:36Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-04T01:53:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The reliance on implicit point matching via attention has become a core bottleneck in drag-based editing, resulting in a fundamental compromise on weakened inversion strength and costly test-time optimization (TTO). This compromise severely limits the generative capabilities of diffusion models, suppressing high-fidelity inpainting and text-guided creation. In this paper, we introduce LazyDrag, the first drag-based image editing method for Multi-Modal Diffusion Transformers, which directly eliminates the reliance on implicit point matching. In concrete terms, our method generates an explicit correspondence map from user drag inputs as a reliable reference to boost the attention control. This reliable reference opens the potential for a stable full-strength inversion process, which is the first in the drag-based editing task. It obviates the necessity for TTO and unlocks the generative capability of models. Therefore, LazyDrag naturally unifies precise geometric control with text guidance, enabling complex edits that were previously out of reach: opening the mouth of a dog and inpainting its interior, generating new objects like a ``tennis ball'', or for ambiguous drags, making context-aware changes like moving a hand into a pocket. Additionally, LazyDrag supports multi-round workflows with simultaneous move and scale operations. Evaluated on the DragBench, our method outperforms baselines in drag accuracy and perceptual quality, as validated by VIEScore and human evaluation. LazyDrag not only establishes new state-of-the-art performance, but also paves a new way to editing paradigms."},{"descriptionType":"Other","description":"https://zxyin.github.io/LazyDrag"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12203","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:21:23Z","registered":"2025-09-16T03:21:24Z","published":null,"updated":"2026-02-04T03:40:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":154,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?page%5Bsize%5D=1000\u0026sort=name\u0026client-id=arxiv.content\u0026query=registered%3A%5B2025-09-15T16%3A00%3A00Z+TO+2025-09-16T16%3A00%3A00Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+MoE+OR+MoEs+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+MoE+OR+MoEs+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29+AND+%28titles.title%3A%28architecture+OR+architectures+OR+attention+OR+optimization+OR+optimizer+OR+optimizers+OR+training+OR+pretraining+OR+%22pre-training%22+OR+%22post-training%22+OR+finetuning+OR+%22fine-tuning%22%29+OR+descriptions.description%3A%28architecture+OR+architectures+OR+attention+OR+optimization+OR+optimizer+OR+optimizers+OR+training+OR+pretraining+OR+%22pre-training%22+OR+%22post-training%22+OR+finetuning+OR+%22fine-tuning%22%29%29"}}