<td id="A1.T4.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T4.2.2.2.1" class="ltx_text" style="font-size:160%;">{<math id="A1.T4.m2" class="ltx_Math" alttext="1+\dfrac{1}{1+\exp(-\Delta\text{HV})}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.630em">1</mn><mo mathsize="0.630em">+</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.630em">1</mn><mrow><mn mathsize="0.630em">1</mn><mo mathsize="0.630em">+</mo><mrow><mi mathsize="0.630em">exp</mi><mo>⁡</mo><mrow><mo maxsize="0.630em" minsize="0.630em">(</mo><mrow><mo mathsize="0.630em">−</mo><mrow><mi mathsize="0.630em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mtext mathsize="0.630em">HV</mtext></mrow></mrow><mo maxsize="0.630em" minsize="0.630em">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">1+\dfrac{1}{1+\exp(-\Delta\text{HV})}</annotation></semantics></math></span>, <math id="A1.T4.m3" class="ltx_Math" alttext="\dfrac{2}{1+\exp(-\Delta\text{HV})}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mn>2</mn><mrow><mn>1</mn><mo>+</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>HV</mtext></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\dfrac{2}{1+\exp(-\Delta\text{HV})}</annotation></semantics></math>,</td></tr>
