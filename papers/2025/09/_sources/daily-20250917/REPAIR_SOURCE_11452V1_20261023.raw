<th id="A1.T5.2.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Rollout size <math id="A1.T5.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math></th>
<td id="A1.T5.2.12.2" class="ltx_td ltx_align_center">8</td></tr>
