<td id="A1.T4.2.3.1" class="ltx_td ltx_align_center"><math id="A1.T4.m4" class="ltx_Math" alttext="\mathbf{0.5+1.5\textbf{tanh}(\Delta\text{HV})}" display="inline" intent=":literal"><semantics><mrow><mn class="ltx_mathvariant_bold" mathvariant="bold">0.5</mn><mo>+</mo><mrow><mn class="ltx_mathvariant_bold" mathvariant="bold">1.5</mn><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_bold">tanh</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝚫</mi><mo lspace="0em" rspace="0em">​</mo><mtext>HV</mtext></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{0.5+1.5\textbf{tanh}(\Delta\text{HV})}</annotation></semantics></math>, <math id="A1.T4.m5" class="ltx_Math" alttext="0.5+1.5\tanh(3\Delta\text{HV})" display="inline" intent=":literal"><semantics><mrow><mn>0.5</mn><mo>+</mo><mrow><mn>1.5</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>tanh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>HV</mtext></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">0.5+1.5\tanh(3\Delta\text{HV})</annotation></semantics></math><span id="A1.T4.2.3.1.1" class="ltx_text" style="font-size:160%;">}</span></td></tr>
