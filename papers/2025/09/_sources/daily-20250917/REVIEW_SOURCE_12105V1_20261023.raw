<th id="S4.T1.7.1.7.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">SAM,DINOv2</th>
<td id="S4.T1.7.1.7.3" class="ltx_td ltx_align_center">67.7</td>
<td id="S4.T1.7.1.7.4" class="ltx_td ltx_align_center">70.7</td>
