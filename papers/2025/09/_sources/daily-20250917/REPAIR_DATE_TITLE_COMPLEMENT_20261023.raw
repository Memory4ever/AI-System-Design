{"data":[{"id":"10.48550/arxiv.2509.10663","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10663","identifiers":[{"identifier":"2509.10663","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zineddine","familyName":"Tighidet","name":"Tighidet, Zineddine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Mogini","name":"Mogini, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hedi","familyName":"Ben-younes","name":"Ben-younes, Hedi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiali","familyName":"Mei","name":"Mei, Jiali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrick","familyName":"Gallinari","name":"Gallinari, Patrick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Piwowarski","name":"Piwowarski, Benjamin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Context Copying Modulation: The Role of Entropy Neurons in Managing Parametric and Contextual Knowledge Conflicts"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T19:42:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:49:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T11:21:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:39:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The behavior of Large Language Models (LLMs) when facing contextual information that conflicts with their internal parametric knowledge is inconsistent, with no generally accepted explanation for the expected outcome distribution. Recent work has identified in autoregressive transformer models a class of neurons -- called entropy neurons -- that produce a significant effect on the model output entropy while having an overall moderate impact on the ranking of the predicted tokens. In this paper, we investigate the preliminary claim that these neurons are involved in inhibiting context copying behavior in transformers by looking at their role in resolving conflicts between contextual and parametric information. We show that entropy neurons are responsible for suppressing context copying across a range of LLMs, and that ablating them leads to a significant change in the generation process. These results enhance our understanding of the internal dynamics of LLMs when handling conflicting information."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10663","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:44:31Z","registered":"2025-09-16T02:44:32Z","published":null,"updated":"2025-09-18T17:47:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10852","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10852","identifiers":[{"identifier":"2509.10852","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sangyeop","familyName":"Kim","name":"Kim, Sangyeop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yohan","familyName":"Lee","name":"Lee, Yohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanghwa","familyName":"Kim","name":"Kim, Sanghwa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyunjong","familyName":"Kim","name":"Kim, Hyunjong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sungzoon","familyName":"Cho","name":"Cho, Sungzoon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pre-Storage Reasoning for Episodic Memory: Shifting Inference Burden to Memory for Personalized Dialogue"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T15:18:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:19:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Effective long-term memory in conversational AI requires synthesizing information across multiple sessions. However, current systems place excessive reasoning burden on response generation, making performance significantly dependent on model sizes. We introduce PREMem (Pre-storage Reasoning for Episodic Memory), a novel approach that shifts complex reasoning processes from inference to memory construction. PREMem extracts fine-grained memory fragments categorized into factual, experiential, and subjective information; it then establishes explicit relationships between memory items across sessions, capturing evolution patterns like extensions, transformations, and implications. By performing this reasoning during pre-storage rather than when generating a response, PREMem creates enriched representations while reducing computational demands during interactions. Experiments show significant performance improvements across all model sizes, with smaller models achieving results comparable to much larger baselines while maintaining effectiveness even with constrained token budgets. Code and dataset are available at https://github.com/sangyeop-kim/PREMem."},{"descriptionType":"Other","description":"Accepted by EMNLP 2025 (Findings)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10852","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:48:57Z","registered":"2025-09-16T02:48:58Z","published":null,"updated":"2025-09-16T02:48:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11106","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11106","identifiers":[{"identifier":"2509.11106","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Valentin","familyName":"Hofmann","name":"Hofmann, Valentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Heineman","name":"Heineman, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Magnusson","name":"Magnusson, Ian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyle","familyName":"Lo","name":"Lo, Kyle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jesse","familyName":"Dodge","name":"Dodge, Jesse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maarten","familyName":"Sap","name":"Sap, Maarten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pang Wei","familyName":"Koh","name":"Koh, Pang Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun","familyName":"Wang","name":"Wang, Chun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hannaneh","familyName":"Hajishirzi","name":"Hajishirzi, Hannaneh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noah A.","familyName":"Smith","name":"Smith, Noah A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fluid Language Model Benchmarking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T05:49:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:34:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Language model (LM) benchmarking faces several challenges: comprehensive evaluations are costly, benchmarks often fail to measure the intended capabilities, and evaluation quality can degrade due to labeling errors and benchmark saturation. Although various strategies have been proposed to mitigate these issues, they tend to address individual aspects in isolation, neglecting broader questions about overall evaluation quality. Here, we introduce Fluid Benchmarking, a new evaluation approach that advances LM benchmarking across multiple dimensions. Inspired by psychometrics, Fluid Benchmarking is based on the insight that the relative value of benchmark items depends on an LM's capability level, suggesting that evaluation should adapt to each LM. Methodologically, Fluid Benchmarking estimates an item response model based on existing LM evaluation results and uses the inferred quantities to select evaluation items dynamically, similar to computerized adaptive testing in education. In our experiments, we compare Fluid Benchmarking against the common practice of random item sampling as well as more sophisticated baselines, including alternative methods grounded in item response theory. We examine four dimensions -- efficiency, validity, variance, and saturation -- and find that Fluid Benchmarking achieves superior performance in all of them (e.g., higher validity and less variance on MMLU with fifty times fewer items). Our analysis shows that the two components of Fluid Benchmarking have distinct effects: item response theory, used to map performance into a latent ability space, increases validity, while dynamic item selection reduces variance. Overall, our results suggest that LM benchmarking can be substantially improved by moving beyond static evaluation."},{"descriptionType":"Other","description":"COLM 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11106","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":3,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:53Z","registered":"2025-09-16T02:54:53Z","published":null,"updated":"2025-09-16T02:54:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11176","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11176","identifiers":[{"identifier":"2509.11176","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Erion","familyName":"Çano","name":"Çano, Erion","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ivan","familyName":"Habernal","name":"Habernal, Ivan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Differentially-private text generation degrades output language quality"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T09:16:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:39:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ensuring user privacy by synthesizing data from large language models (LLMs) tuned under differential privacy (DP) has become popular recently. However, the impact of DP fine-tuned LLMs on the quality of the language and the utility of the texts they produce has not been investigated. In this work, we tune five LLMs with three corpora under four levels of privacy and assess the length, the grammatical correctness, and the lexical diversity of the text outputs they produce. We also probe the utility of the synthetic outputs in downstream classification tasks such as book genre recognition based on book descriptions and cause of death recognition based on verbal autopsies. The results indicate that LLMs tuned under stronger privacy constrains produce texts that are shorter by at least 77 %, that are less grammatically correct by at least 9 %, and are less diverse by at least 10 % in bi-gram diversity. Furthermore, the accuracy they reach in downstream classification tasks decreases, which might be detrimental to the usefulness of the generated synthetic data."},{"descriptionType":"Other","description":"20 pages, 3 figures, 35 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11176","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:32Z","registered":"2025-09-16T02:56:32Z","published":null,"updated":"2025-09-16T02:56:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11206","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11206","identifiers":[{"identifier":"2509.11206","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tae Soo","familyName":"Kim","name":"Kim, Tae Soo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heechan","familyName":"Lee","name":"Lee, Heechan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoonjoo","familyName":"Lee","name":"Lee, Yoonjoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph","familyName":"Seering","name":"Seering, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juho","familyName":"Kim","name":"Kim, Juho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evalet: Evaluating Large Language Models through Functional Fragmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T10:24:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:41:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T02:46:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:17:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-03T11:40:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-04T01:54:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-20T05:43:30Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-21T01:41:57Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Practitioners increasingly rely on Large Language Models (LLMs) to evaluate generative AI outputs through \"LLM-as-a-Judge\" approaches. However, these methods produce holistic scores that obscure which specific elements influenced the assessments. We propose functional fragmentation, a method that dissects each output into key fragments and interprets the rhetoric functions that each fragment serves relative to evaluation criteria -- surfacing the elements of interest and revealing how they fulfill or hinder user goals. We instantiate this approach in Evalet, an interactive system that visualizes fragment-level functions across many outputs to support inspection, rating, and comparison of evaluations. A user study (N=10) found that, while practitioners struggled to validate holistic scores, our approach helped them identify 48% more evaluation misalignments. This helped them calibrate trust in LLM evaluations and rely on them to find more actionable issues in model outputs. Our work shifts LLM evaluation from quantitative scores toward qualitative, fine-grained analysis of model behavior."},{"descriptionType":"Other","description":"The first two authors hold equal contribution. Presented at CHI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11206","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:57:13Z","registered":"2025-09-16T02:57:13Z","published":null,"updated":"2026-04-21T04:48:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11298","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11298","identifiers":[{"identifier":"2509.11298","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Madhava","familyName":"Gaikwad","name":"Gaikwad, Madhava","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Are Two RLHF Objectives the Same?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.2.7; I.2.8; G.3; G.1.6","lang":"en","subjectScheme":"ACM"},{"subject":"68T05, 68T07, 68Q32, 62H30, 62F15, 90C30","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-14T14:42:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:46:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-05T17:34:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-06T02:03:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The preference optimization literature contains many proposed objectives, often presented as distinct improvements. We introduce Opal, a canonicalization algorithm that determines whether two preference objectives are algebraically equivalent by producing either a canonical form or a concrete witness of non-equivalence. Applying Opal reveals that many widely used methods optimize the same underlying objective, while others are provably distinct. For example, batch normalization can cause the same response pair to receive different gradients depending on batch composition. We identify a small set of structural mechanisms that give rise to genuinely different objectives; most remaining differences are reparameterizations."},{"descriptionType":"Other","description":"21 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11298","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:59:22Z","registered":"2025-09-16T02:59:23Z","published":null,"updated":"2026-02-06T03:20:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11425","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11425","identifiers":[{"identifier":"2509.11425","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md Mubtasim","familyName":"Ahasan","name":"Ahasan, Md Mubtasim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafat Hasan","familyName":"Khan","name":"Khan, Rafat Hasan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tasnim","familyName":"Mohiuddin","name":"Mohiuddin, Tasnim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aman","familyName":"Chadha","name":"Chadha, Aman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tariq","familyName":"Iqbal","name":"Iqbal, Tariq","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M Ashraful","familyName":"Amin","name":"Amin, M Ashraful","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amin Ahsan","familyName":"Ali","name":"Ali, Amin Ahsan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md Mofijul","familyName":"Islam","name":"Islam, Md Mofijul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A K M Mahbubur","familyName":"Rahman","name":"Rahman, A K M Mahbubur","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FuseCodec: Semantic-Contextual Fusion and Supervision for Neural Codecs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T20:35:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:52:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-29T08:43:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T01:45:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Speech tokenization enables discrete representation and facilitates speech language modeling. However, existing neural codecs capture low-level acoustic features, overlooking the semantic and contextual cues inherent to human speech. While recent efforts introduced semantic representations from self-supervised speech models or incorporated contextual representations from pre-trained language models, challenges remain in aligning and unifying the semantic and contextual representations. We introduce FuseCodec, which unifies acoustic, semantic, and contextual representations through strong cross-modal alignment and globally informed supervision. We propose three complementary techniques: (i) Latent Representation Fusion, integrating semantic and contextual features directly into the encoder latent space for robust and unified representation learning; (ii) Global Semantic-Contextual Supervision, supervising discrete tokens with globally pooled and broadcasted representations to enhance temporal consistency and cross-modal alignment; and (iii) Temporally Aligned Contextual Supervision, strengthening alignment by dynamically matching contextual and speech tokens within a local window for fine-grained token-level supervision. We further introduce FuseCodec-TTS, demonstrating our methodology's applicability to zero-shot speech synthesis. Empirically, FuseCodec achieves state-of-the-art performance in LibriSpeech, surpassing EnCodec, SpeechTokenizer, and DAC in transcription accuracy, perceptual quality, intelligibility, and speaker similarity. Results highlight the effectiveness of contextually and semantically guided tokenization for speech tokenization and downstream tasks. Code and pretrained models are available at https://github.com/mubtasimahasan/FuseCodec."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11425","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:02:23Z","registered":"2025-09-16T03:02:23Z","published":null,"updated":"2025-09-30T05:19:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12101","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12101","identifiers":[{"identifier":"2509.12101","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jarod","familyName":"Duret","name":"Duret, Jarod","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salima","familyName":"Mdhaffar","name":"Mdhaffar, Salima","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaëlle","familyName":"Laperrière","name":"Laperrière, Gaëlle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Whetten","name":"Whetten, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Audrey","familyName":"Galametz","name":"Galametz, Audrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Catherine","familyName":"Kobus","name":"Kobus, Catherine","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marion-Cécile","familyName":"Martin","name":"Martin, Marion-Cécile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jo","familyName":"Oleiwan","name":"Oleiwan, Jo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yannick","familyName":"Estève","name":"Estève, Yannick","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"In-domain SSL pre-training and streaming ASR"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:25:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:35:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study, we investigate the benefits of domain-specific self-supervised pre-training for both offline and streaming ASR in Air Traffic Control (ATC) environments. We train BEST-RQ models on 4.5k hours of unlabeled ATC data, then fine-tune on a smaller supervised ATC set. To enable real-time processing, we propose using chunked attention and dynamic convolutions, ensuring low-latency inference. We compare these in-domain SSL models against state-of-the-art, general-purpose speech encoders such as w2v-BERT 2.0 and HuBERT. Results show that domain-adapted pre-training substantially improves performance on standard ATC benchmarks, significantly reducing word error rates when compared to models trained on broad speech corpora. Furthermore, the proposed streaming approach further improves word error rate under tighter latency constraints, making it particularly suitable for safety-critical aviation applications. These findings highlight that specializing SSL representations for ATC data is a practical path toward more accurate and efficient ASR systems in real-world operational settings."},{"descriptionType":"Other","description":"Accepted to SPECOM 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12101","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:01Z","registered":"2025-09-16T03:19:02Z","published":null,"updated":"2025-09-16T03:19:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12171","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12171","identifiers":[{"identifier":"2509.12171","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Marek","familyName":"Kubis","name":"Kubis, Marek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paweł","familyName":"Skórzewski","name":"Skórzewski, Paweł","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iwona","familyName":"Christop","name":"Christop, Iwona","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mateusz","familyName":"Czyżnikiewicz","name":"Czyżnikiewicz, Mateusz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jakub","familyName":"Kubiak","name":"Kubiak, Jakub","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Łukasz","familyName":"Bondaruk","name":"Bondaruk, Łukasz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcin","familyName":"Lewandowski","name":"Lewandowski, Marcin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Preservation of Language Understanding Capabilities in Speech-aware Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:34:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:40:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T12:28:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-17T00:49:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The paper presents C3T (Cross-modal Capabilities Conservation Test), a new benchmark for assessing the performance of speech-aware large language models. The benchmark utilizes textual tasks and a voice cloning text-to-speech model to quantify the extent to which language understanding capabilities are preserved when the model is accessed via speech input. C3T quantifies the fairness of the model for different categories of speakers and its robustness across text and speech modalities."},{"descriptionType":"Other","description":"5 pages, 1 figure; benchmark code available at https://github.com/SamsungLabs/C3T"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12171","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:20:38Z","registered":"2025-09-16T03:20:38Z","published":null,"updated":"2025-10-17T04:11:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":9,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=id%3A%28%2210.48550%2Farxiv.2509.10663%22+OR+%2210.48550%2Farxiv.2509.10852%22+OR+%2210.48550%2Farxiv.2509.11106%22+OR+%2210.48550%2Farxiv.2509.11176%22+OR+%2210.48550%2Farxiv.2509.11206%22+OR+%2210.48550%2Farxiv.2509.11298%22+OR+%2210.48550%2Farxiv.2509.11425%22+OR+%2210.48550%2Farxiv.2509.12101%22+OR+%2210.48550%2Farxiv.2509.12171%22%29\u0026page%5Bsize%5D=1000\u0026sort=name"}}