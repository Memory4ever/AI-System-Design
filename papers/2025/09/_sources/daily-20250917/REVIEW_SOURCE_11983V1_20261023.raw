</table>
<p id="S5.SS3.p5.2" class="ltx_p"><span id="S5.SS3.p5.2.1" class="ltx_text">Combining this with (<a href="#S5.E26" title="In 5.3 Proof of the main results in Section ‣ 5 Proof of the main results ‣ Low-rank orthogonalization for large-scale matrix optimization with applications to foundation model training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) and (<a href="#S5.E27" title="In Lemma 5. ‣ 5.3 Proof of the main results in Section ‣ 5 Proof of the main results ‣ Low-rank orthogonalization for large-scale matrix optimization with applications to foundation model training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>), we obtain that</span></p>
<table id="S5.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex29.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi^{k+1}}[\mathcal{P}_{k+1}]\overset{\eqref{def:pot-a}}{=}\mathbb{E}_{\xi^{k+1}}[f(X^{k+1})+p_{k+1}\|\nabla f(X^{k+1})-M^{k+1}\|_{F}^{\alpha}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><msup><mi>ξ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mo>=</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#S5.E26" title="In 5.3 Proof of the main results in Section ‣ 5 Proof of the main results ‣ Low-rank orthogonalization for large-scale matrix optimization with applications to foundation model training" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">26</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msup><mi>ξ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>p</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>M</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mi>α</mi></msubsup></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi^{k+1}}[\mathcal{P}_{k+1}]\overset{\eqref{def:pot-a}}{=}\mathbb{E}_{\xi^{k+1}}[f(X^{k+1})+p_{k+1}\|\nabla f(X^{k+1})-M^{k+1}\|_{F}^{\alpha}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex30.m1" class="ltx_Math" alttext="\displaystyle\overset{\eqref{ineq:rec-pm}\eqref{upbd:f-lem1-smuon}}{\leq}f(X^{k})-\eta_{k}\|\nabla f(X^{k})\|_{*}+2\eta_{k}\|\nabla f(X^{k})-M^{k}\|_{*}+2\eta_{k}\delta_{k}+\frac{L_{*}\eta_{k}^{2}}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mo>≤</mo><mrow><mtext mathsize="0.700em">(</mtext><mtext mathsize="0.700em"><a href="#S5.E27" title="In Lemma 5. ‣ 5.3 Proof of the main results in Section ‣ 5 Proof of the main results ‣ Low-rank orthogonalization for large-scale matrix optimization with applications to foundation model training" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">27</span></a></mtext><mtext mathsize="0.700em">)(</mtext><mtext mathsize="0.700em"><a href="#S5.E31" title="In Proof. ‣ 5.3 Proof of the main results in Section ‣ 5 Proof of the main results ‣ Low-rank orthogonalization for large-scale matrix optimization with applications to foundation model training" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">31</span></a></mtext><mtext mathsize="0.700em">)</mtext></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mi>k</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mi>k</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mi>k</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>M</mi><mi>k</mi></msup></mrow><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>k</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>L</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>k</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\overset{\eqref{ineq:rec-pm}\eqref{upbd:f-lem1-smuon}}{\leq}f(X^{k})-\eta_{k}\|\nabla f(X^{k})\|_{*}+2\eta_{k}\|\nabla f(X^{k})-M^{k}\|_{*}+2\eta_{k}\delta_{k}+\frac{L_{*}\eta_{k}^{2}}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex31.m1" class="ltx_Math" alttext="\displaystyle\qquad+(1-\theta_{k})p_{k+1}\|M^{k}-\nabla f(X^{k})\|_{F}^{\alpha}+3L_{*}^{\alpha}\theta_{k}^{1-\alpha}\eta_{k}^{\alpha}p_{k+1}+2\sigma^{\alpha}\theta_{k}^{\alpha}p_{k+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>θ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>M</mi><mi>k</mi></msup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mi>k</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mi>α</mi></msubsup></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mo>∗</mo><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mi>k</mi><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>k</mi><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mi>α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mi>k</mi><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+(1-\theta_{k})p_{k+1}\|M^{k}-\nabla f(X^{k})\|_{F}^{\alpha}+3L_{*}^{\alpha}\theta_{k}^{1-\alpha}\eta_{k}^{\alpha}p_{k+1}+2\sigma^{\alpha}\theta_{k}^{\alpha}p_{k+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
