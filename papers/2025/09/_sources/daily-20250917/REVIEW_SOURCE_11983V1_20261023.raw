<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E32.m1" class="ltx_Math" alttext="\displaystyle\qquad+(1-\theta_{k})p_{k}\|M^{k}-\nabla f(X^{k})\|_{F}^{\alpha}+3L_{*}^{\alpha}\theta_{k}^{1-\alpha}\eta_{k}^{\alpha}p_{k}+2\sigma^{\alpha}\theta_{k}^{\alpha}p_{k}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>θ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>M</mi><mi>k</mi></msup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mi>k</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi><mi>α</mi></msubsup></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mo>∗</mo><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mi>k</mi><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>k</mi><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mi>α</mi></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>θ</mi><mi>k</mi><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>k</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+(1-\theta_{k})p_{k}\|M^{k}-\nabla f(X^{k})\|_{F}^{\alpha}+3L_{*}^{\alpha}\theta_{k}^{1-\alpha}\eta_{k}^{\alpha}p_{k}+2\sigma^{\alpha}\theta_{k}^{\alpha}p_{k},</annotation></semantics></math></td>
