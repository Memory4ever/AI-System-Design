<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex32.m1" class="ltx_Math" alttext="\displaystyle\leq f(X^{k})-\eta_{k}\|\nabla f(X^{k})\|_{*}+2\eta_{k}\varrho^{1/2}\|\nabla f(X^{k})-M^{k}\|_{F}+2\eta_{k}\delta_{k}+\frac{L_{*}\eta_{k}^{2}}{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mi>k</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mi>k</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>∗</mo></msub></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϱ</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mi>k</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>M</mi><mi>k</mi></msup></mrow><mo stretchy="false">‖</mo></mrow><mi>F</mi></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>k</mi></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>L</mi><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>k</mi><mn>2</mn></msubsup></mrow><mn>2</mn></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq f(X^{k})-\eta_{k}\|\nabla f(X^{k})\|_{*}+2\eta_{k}\varrho^{1/2}\|\nabla f(X^{k})-M^{k}\|_{F}+2\eta_{k}\delta_{k}+\frac{L_{*}\eta_{k}^{2}}{2}</annotation></semantics></math></td>
