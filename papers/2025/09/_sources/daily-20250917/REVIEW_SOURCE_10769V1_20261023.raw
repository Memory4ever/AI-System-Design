<td id="S4.T5.1.1.3.15" class="ltx_td ltx_align_center ltx_border_t">0.0</td>
<td id="S4.T5.1.1.3.16" class="ltx_td ltx_align_center ltx_border_t">87.9</td>
<td id="S4.T5.1.1.3.17" class="ltx_td ltx_align_center ltx_border_t">68.0</td></tr>
<tr id="S4.T5.1.1.4" class="ltx_tr">
<td id="S4.T5.1.1.4.1" class="ltx_td ltx_align_left">Complete</td>
<td id="S4.T5.1.1.4.2" class="ltx_td ltx_align_left">Disabled</td>
<td id="S4.T5.1.1.4.3" class="ltx_td"></td>
<td id="S4.T5.1.1.4.4" class="ltx_td ltx_align_center">70.8</td>
<td id="S4.T5.1.1.4.5" class="ltx_td ltx_align_center">73.2</td>
<td id="S4.T5.1.1.4.6" class="ltx_td ltx_align_center">13.3</td>
