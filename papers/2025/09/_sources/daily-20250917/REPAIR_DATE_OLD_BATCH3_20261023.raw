{"data":[{"id":"10.48550/arxiv.2509.12888","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12888","identifiers":[{"identifier":"2509.12888","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weiming","familyName":"Chen","name":"Chen, Weiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihan","familyName":"Zhu","name":"Zhu, Zhihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijia","familyName":"Wang","name":"Wang, Yijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihai","familyName":"He","name":"He, Zhihai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Runge-Kutta Approximation and Decoupled Attention for Rectified Flow Inversion and Semantic Editing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T09:41:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:36:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Rectified flow (RF) models have recently demonstrated superior generative performance compared to DDIM-based diffusion models. However, in real-world applications, they suffer from two major challenges: (1) low inversion accuracy that hinders the consistency with the source image, and (2) entangled multimodal attention in diffusion transformers, which hinders precise attention control. To address the first challenge, we propose an efficient high-order inversion method for rectified flow models based on the Runge-Kutta solver of differential equations. To tackle the second challenge, we introduce Decoupled Diffusion Transformer Attention (DDTA), a novel mechanism that disentangles text and image attention inside the multimodal diffusion transformers, enabling more precise semantic control. Extensive experiments on image reconstruction and text-guided editing tasks demonstrate that our method achieves state-of-the-art performance in terms of fidelity and editability. Code is available at https://github.com/wmchen/RKSovler_DDTA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12888","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:50:55Z","registered":"2025-09-17T01:50:55Z","published":null,"updated":"2025-09-17T01:50:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12892","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12892","identifiers":[{"identifier":"2509.12892","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shiyu","familyName":"Li","name":"Li, Shiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Tang","name":"Tang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruijie","familyName":"Liu","name":"Liu, Ruijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shi-Zhe","familyName":"Chen","name":"Chen, Shi-Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"Chen","name":"Chen, Xi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conan-Embedding-v2: Training an LLM from Scratch for Text Embeddings"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T09:48:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:36:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have recently demonstrated excellent performance in text embedding tasks. Previous work usually use LoRA to fine-tune existing LLMs, which are limited by the data and training gap between LLMs and embedding models. In this work, we introduce Conan-embedding-v2, a new 1.4B-parameter LLM trained from scratch and fine-tuned as a text embedder. First, we add news data and multilingual pairs for LLM pretraining to bridge the data gap. Based on this, we propose a cross-lingual retrieval dataset that enables the LLM to better integrate embeddings across different languages. Second, whereas LLMs use a causal mask with token-level loss, embedding models use a bidirectional mask with sentence-level loss. This training gap makes full fine-tuning less effective than LoRA. We introduce a soft-masking mechanism to gradually transition between these two types of masks, enabling the model to learn more comprehensive representations. Based on this, we propose a dynamic hard negative mining method that exposes the model to more difficult negative examples throughout the training process. Being intuitive and effective, with only approximately 1.4B parameters, Conan-embedding-v2 achieves SOTA performance on both the Massive Text Embedding Benchmark (MTEB) and Chinese MTEB (May 19, 2025)."},{"descriptionType":"Other","description":"EMNLP 2025 Oral"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12892","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:51:01Z","registered":"2025-09-17T01:51:01Z","published":null,"updated":"2025-09-17T01:51:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12897","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12897","identifiers":[{"identifier":"2509.12897","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jianfei","familyName":"Zhao","name":"Zhao, Jianfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Zhang","name":"Zhang, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Sun","name":"Sun, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chong","familyName":"Feng","name":"Feng, Chong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhixing","familyName":"Tan","name":"Tan, Zhixing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cross-Layer Vision Smoothing: Enhancing Visual Understanding via Sustained Focus on Key Objects in Large Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T09:54:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:37:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-25T07:54:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-26T01:36:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Vision-Language Models (LVLMs) can accurately locate key objects in images, yet their attention to these objects tends to be very brief. Motivated by the hypothesis that sustained focus on key objects can improve LVLMs' visual capabilities, we propose Cross-Layer Vision Smoothing (CLVS). The core idea of CLVS is to incorporate a vision memory that smooths the attention distribution across layers. Specifically, we initialize this vision memory with position-unbiased visual attention in the first layer. In subsequent layers, the model's visual attention jointly considers the vision memory from previous layers, while the memory is updated iteratively, thereby maintaining smooth attention on key objects. Given that visual understanding primarily occurs in the early and middle layers of the model, we use uncertainty as an indicator of completed visual understanding and terminate the smoothing process accordingly. Experiments on four benchmarks across three LVLMs confirm the effectiveness and generalizability of our method. CLVS achieves state-of-the-art overall performance across a variety of visual understanding tasks and attains comparable results to the leading approaches on image captioning benchmarks."},{"descriptionType":"Other","description":"Under Review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12897","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:51:08Z","registered":"2025-09-17T01:51:08Z","published":null,"updated":"2025-11-26T03:24:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12908","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12908","identifiers":[{"identifier":"2509.12908","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Caiqi","familyName":"Zhang","name":"Zhang, Caiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Shu","name":"Shu, Chang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ehsan","familyName":"Shareghi","name":"Shareghi, Ehsan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nigel","familyName":"Collier","name":"Collier, Nigel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"All Roads Lead to Rome: Graph-Based Confidence Estimation for Large Language Model Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T10:02:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:38:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Confidence estimation is essential for the reliable deployment of large language models (LLMs). Existing methods are primarily designed for factual QA tasks and often fail to generalize to reasoning tasks. To address this gap, we propose a set of training-free, graph-based confidence estimation methods tailored to reasoning tasks. Our approach models reasoning paths as directed graphs and estimates confidence by exploiting graph properties such as centrality, path convergence, and path weighting. Experiments with two LLMs on three reasoning datasets demonstrate improved confidence estimation and enhanced performance on two downstream tasks."},{"descriptionType":"Other","description":"EMNLP 2025 Main"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12908","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:51:23Z","registered":"2025-09-17T01:51:24Z","published":null,"updated":"2025-09-17T01:51:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12917","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12917","identifiers":[{"identifier":"2509.12917","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sam","familyName":"McCallum","name":"McCallum, Sam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kamran","familyName":"Arora","name":"Arora, Kamran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Foster","name":"Foster, James","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reversible Deep Equilibrium Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T10:11:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:38:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-03T14:57:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-04T01:49:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep Equilibrium Models (DEQs) are an interesting class of implicit model where the model output is implicitly defined as the fixed point of a learned function. These models have been shown to outperform explicit (fixed-depth) models in large-scale tasks by trading many deep layers for a single layer that is iterated many times. However, gradient calculation through DEQs is approximate. This often leads to unstable training dynamics and requires regularisation or many function evaluations to fix. Here, we introduce Reversible Deep Equilibrium Models (RevDEQs) that allow for exact gradient calculation, no regularisation and far fewer function evaluations than DEQs. We show that RevDEQs significantly improve performance on language modelling and image classification tasks against comparable implicit and explicit models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12917","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:51:36Z","registered":"2025-09-17T01:51:37Z","published":null,"updated":"2025-12-04T18:40:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12927","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12927","identifiers":[{"identifier":"2509.12927","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xingxing","familyName":"Hong","name":"Hong, Xingxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yungong","familyName":"Wang","name":"Wang, Yungong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dexin","familyName":"Jin","name":"Jin, Dexin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye","familyName":"Yuan","name":"Yuan, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ximing","familyName":"Huang","name":"Huang, Ximing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijian","familyName":"Wu","name":"Wu, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxin","familyName":"Li","name":"Li, Wenxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HLSMAC: A New StarCraft Multi-Agent Challenge for High-Level Strategic Decision-Making"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T10:26:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:38:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Benchmarks are crucial for assessing multi-agent reinforcement learning (MARL) algorithms. While StarCraft II-related environments have driven significant advances in MARL, existing benchmarks like SMAC focus primarily on micromanagement, limiting comprehensive evaluation of high-level strategic intelligence. To address this, we introduce HLSMAC, a new cooperative MARL benchmark with 12 carefully designed StarCraft II scenarios based on classical stratagems from the Thirty-Six Stratagems. Each scenario corresponds to a specific stratagem and is designed to challenge agents with diverse strategic elements, including tactical maneuvering, timing coordination, and deception, thereby opening up avenues for evaluating high-level strategic decision-making capabilities. We also propose novel metrics across multiple dimensions beyond conventional win rate, such as ability utilization and advancement efficiency, to assess agents' overall performance within the HLSMAC environment. We integrate state-of-the-art MARL algorithms and LLM-based agents with our benchmark and conduct comprehensive experiments. The results demonstrate that HLSMAC serves as a robust testbed for advancing multi-agent strategic decision-making."},{"descriptionType":"Other","description":"30 pages, 13 figures with appendix"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12927","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:51:50Z","registered":"2025-09-17T01:51:50Z","published":null,"updated":"2025-09-17T01:51:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12936","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12936","identifiers":[{"identifier":"2509.12936","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Denis","familyName":"Janiak","name":"Janiak, Denis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julia","familyName":"Moska","name":"Moska, Julia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawid","familyName":"Motyka","name":"Motyka, Dawid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karolina","familyName":"Seweryn","name":"Seweryn, Karolina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paweł","familyName":"Walkowiak","name":"Walkowiak, Paweł","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bartosz","familyName":"Żuk","name":"Żuk, Bartosz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arkadiusz","familyName":"Janz","name":"Janz, Arkadiusz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rethinking the Evaluation of Alignment Methods: Insights into Diversity, Generalisation, and Safety"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T10:32:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:39:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) require careful alignment to balance competing objectives - factuality, safety, conciseness, proactivity, and diversity. Existing studies focus on individual techniques or specific dimensions, lacking a holistic assessment of the inherent trade-offs. We propose a unified evaluation framework that compares LLM alignment methods (PPO, DPO, ORPO, KTO) across these five axes, using both in-distribution and out-of-distribution datasets. Leveraging a specialized LLM-as-Judge prompt, validated through human studies, we reveal that DPO and KTO excel in factual accuracy, PPO and DPO lead in safety, and PPO best balances conciseness with proactivity. Our findings provide insights into trade-offs of common alignment methods, guiding the development of more balanced and reliable LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12936","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:52:02Z","registered":"2025-09-17T01:52:03Z","published":null,"updated":"2025-09-17T01:52:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12937","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12937","identifiers":[{"identifier":"2509.12937","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Johan","familyName":"Wahréus","name":"Wahréus, Johan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmed","familyName":"Hussain","name":"Hussain, Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Panos","familyName":"Papadimitratos","name":"Papadimitratos, Panos","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Jailbreaking Large Language Models Through Content Concretization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T10:34:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:39:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly deployed for task automation and content generation, yet their safety mechanisms remain vulnerable to circumvention through different jailbreaking techniques. In this paper, we introduce \\textit{Content Concretization} (CC), a novel jailbreaking technique that iteratively transforms abstract malicious requests into concrete, executable implementations. CC is a two-stage process: first, generating initial LLM responses using lower-tier, less constrained safety filters models, then refining them through higher-tier models that process both the preliminary output and original prompt. We evaluate our technique using 350 cybersecurity-specific prompts, demonstrating substantial improvements in jailbreak Success Rates (SRs), increasing from 7\\% (no refinements) to 62\\% after three refinement iterations, while maintaining a cost of 7.5\\textcent~per prompt. Comparative A/B testing across nine different LLM evaluators confirms that outputs from additional refinement steps are consistently rated as more malicious and technically superior. Moreover, manual code analysis reveals that generated outputs execute with minimal modification, although optimal deployment typically requires target-specific fine-tuning. With eventual improved harmful code generation, these results highlight critical vulnerabilities in current LLM safety frameworks."},{"descriptionType":"Other","description":"Accepted for presentation in the Conference on Game Theory and AI for Security (GameSec) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12937","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:52:04Z","registered":"2025-09-17T01:52:04Z","published":null,"updated":"2025-09-17T01:52:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12938","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12938","identifiers":[{"identifier":"2509.12938","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abdalla","familyName":"Arafa","name":"Arafa, Abdalla","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Didier","familyName":"Stricker","name":"Stricker, Didier","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Averages: Open-Vocabulary 3D Scene Understanding with Gaussian Splatting and Bag of Embeddings"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T10:39:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:39:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Novel view synthesis has seen significant advancements with 3D Gaussian Splatting (3DGS), enabling real-time photorealistic rendering. However, the inherent fuzziness of Gaussian Splatting presents challenges for 3D scene understanding, restricting its broader applications in AR/VR and robotics. While recent works attempt to learn semantics via 2D foundation model distillation, they inherit fundamental limitations: alpha blending averages semantics across objects, making 3D-level understanding impossible. We propose a paradigm-shifting alternative that bypasses differentiable rendering for semantics entirely. Our key insight is to leverage predecomposed object-level Gaussians and represent each object through multiview CLIP feature aggregation, creating comprehensive \"bags of embeddings\" that holistically describe objects. This allows: (1) accurate open-vocabulary object retrieval by comparing text queries to object-level (not Gaussian-level) embeddings, and (2) seamless task adaptation: propagating object IDs to pixels for 2D segmentation or to Gaussians for 3D extraction. Experiments demonstrate that our method effectively overcomes the challenges of 3D open-vocabulary object extraction while remaining comparable to state-of-the-art performance in 2D open-vocabulary segmentation, ensuring minimal compromise."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12938","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:52:05Z","registered":"2025-09-17T01:52:05Z","published":null,"updated":"2025-09-17T01:52:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12961","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12961","identifiers":[{"identifier":"2509.12961","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenye","familyName":"Zou","name":"Zou, Chenye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingyue","familyName":"Wen","name":"Wen, Xingyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyi","familyName":"Hu","name":"Hu, Tianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian Janice","familyName":"Wang","name":"Wang, Qian Janice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Hershcovich","name":"Hershcovich, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do LLMs Understand Wine Descriptors Across Cultures? A Benchmark for Cultural Adaptations of Wine Reviews"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T11:10:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:40:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in large language models (LLMs) have opened the door to culture-aware language tasks. We introduce the novel problem of adapting wine reviews across Chinese and English, which goes beyond literal translation by incorporating regional taste preferences and culture-specific flavor descriptors. In a case study on cross-cultural wine review adaptation, we compile the first parallel corpus of professional reviews, containing 8k Chinese and 16k Anglophone reviews. We benchmark both neural-machine-translation baselines and state-of-the-art LLMs with automatic metrics and human evaluation. For the latter, we propose three culture-oriented criteria -- Cultural Proximity, Cultural Neutrality, and Cultural Genuineness -- to assess how naturally a translated review resonates with target-culture readers. Our analysis shows that current models struggle to capture cultural nuances, especially in translating wine descriptions across different cultures. This highlights the challenges and limitations of translation models in handling cultural content."},{"descriptionType":"Other","description":"EMNLP 2025 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12961","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:52:36Z","registered":"2025-09-17T01:52:37Z","published":null,"updated":"2025-09-17T01:52:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12987","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12987","identifiers":[{"identifier":"2509.12987","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yarin","familyName":"Benyamin","name":"Benyamin, Yarin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Argaman","familyName":"Mordoch","name":"Mordoch, Argaman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shahaf S.","familyName":"Shperberg","name":"Shperberg, Shahaf S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roni","familyName":"Stern","name":"Stern, Roni","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward PDDL Planning Copilot"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T11:51:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:42:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly being used as autonomous agents capable of performing complicated tasks. However, they lack the ability to perform reliable long-horizon planning on their own. This paper bridges this gap by introducing the Planning Copilot, a chatbot that integrates multiple planning tools and allows users to invoke them through instructions in natural language. The Planning Copilot leverages the Model Context Protocol (MCP), a recently developed standard for connecting LLMs with external tools and systems. This approach allows using any LLM that supports MCP without domain-specific fine-tuning. Our Planning Copilot supports common planning tasks such as checking the syntax of planning problems, selecting an appropriate planner, calling it, validating the plan it generates, and simulating their execution. We empirically evaluate the ability of our Planning Copilot to perform these tasks using three open-source LLMs. The results show that the Planning Copilot highly outperforms using the same LLMs without the planning tools. We also conducted a limited qualitative comparison of our tool against Chat GPT-5, a very recent commercial LLM. Our results shows that our Planning Copilot significantly outperforms GPT-5 despite relying on a much smaller LLM. This suggests dedicated planning tools may be an effective way to enable LLMs to perform planning tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12987","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:53:12Z","registered":"2025-09-17T01:53:12Z","published":null,"updated":"2025-09-17T01:53:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12991","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12991","identifiers":[{"identifier":"2509.12991","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ya","familyName":"Zhou","name":"Zhou, Ya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujie","familyName":"Yang","name":"Yang, Yujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohan","familyName":"Fan","name":"Fan, Xiaohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Zhao","name":"Zhao, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bridging Performance Gaps for ECG Foundation Models: A Post-Training Strategy"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T12:02:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:42:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T12:14:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-30T01:50:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"ECG foundation models are increasingly popular due to their adaptability across various tasks. However, their clinical applicability is often limited by performance gaps compared to task-specific models, even after pre-training on large ECG datasets and fine-tuning on target data. This limitation is likely due to the lack of an effective post-training strategy. In this paper, we propose a simple yet effective post-training approach to enhance ECG foundation models. We evaluate it on a publicly available Transformer-based foundation model. Experiments across multiple ECG tasks show that our method consistently outperforms baseline fine-tuning. On the PTB-XL benchmarks, it improves macro AUROC by 0.7%-8.9% and macro AUPRC by 23.3%-77.9%, also outperforming several recent state-of-the-art approaches, including task-specific and advanced architectures. Further analyses demonstrate improved training dynamics and data efficiency, with only 30% of the training data outperforming the baseline trained on the full dataset. Ablation studies highlight the importance of stochastic depth and preview linear probing. These findings underscore the potential of post-training strategies to improve ECG foundation models, and we hope this work will contribute to the continued development of foundation models in the ECG domain."},{"descriptionType":"Other","description":"A Transformer-based model is used as an example; the proposed post-training strategy may also be applicable to CNN-based models. The manuscript is currently under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12991","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:53:17Z","registered":"2025-09-17T01:53:18Z","published":null,"updated":"2026-01-30T03:41:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12993","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12993","identifiers":[{"identifier":"2509.12993","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cenlin","familyName":"Duan","name":"Duan, Cenlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianlei","familyName":"Yang","name":"Yang, Jianlei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rubing","familyName":"Yang","name":"Yang, Rubing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yikun","familyName":"Wang","name":"Wang, Yikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiou","familyName":"Wang","name":"Wang, Yiou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingkun","familyName":"Long","name":"Long, Lingkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingjie","familyName":"Qi","name":"Qi, Yingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolin","familyName":"He","name":"He, Xiaolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ao","familyName":"Zhou","name":"Zhou, Ao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xueyan","familyName":"Wang","name":"Wang, Xueyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weisheng","familyName":"Zhao","name":"Zhao, Weisheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HPIM: Heterogeneous Processing-In-Memory-based Accelerator for Large Language Models Inference"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T12:04:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:42:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-31T06:25:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-03T01:29:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-03T09:21:53Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-07T00:34:59Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The deployment of large language models (LLMs) presents significant challenges due to their enormous memory footprints, low arithmetic intensity, and stringent latency requirements, particularly during the autoregressive decoding stage. Traditional compute-centric accelerators, such as GPUs, suffer from severe resource underutilization and memory bandwidth bottlenecks in these memory-bound workloads. To overcome these fundamental limitations, we propose HPIM, the first memory-centric heterogeneous Processing-In-Memory (PIM) accelerator that integrates SRAM-PIM and HBM-PIM subsystems designed specifically for LLM inference. HPIM employs a software-hardware co-design approach that combines a specialized compiler framework with a heterogeneous hardware architecture. It intelligently partitions workloads based on their characteristics: latency-critical attention operations are mapped to the SRAM-PIM subsystem to exploit its ultra-low latency and high computational flexibility, while weight-intensive GEMV computations are assigned to the HBM-PIM subsystem to leverage its high internal bandwidth and large storage capacity. Furthermore, HPIM introduces a tightly coupled pipeline strategy across SRAM-PIM and HBM-PIM subsystems to maximize intra-token parallelism, thereby significantly mitigating the serial dependency of the autoregressive decoding stage. Comprehensive evaluations using a cycle-accurate simulator demonstrate that HPIM significantly outperforms state-of-the-art accelerators, achieving a peak speedup of up to 23.1x compared to the NVIDIA A100 GPU. Moreover, HPIM exhibits superior performance over contemporary PIM-based accelerators, highlighting its potential as a highly practical and scalable solution for accelerating large-scale LLM inference."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12993","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:53:21Z","registered":"2025-09-17T01:53:21Z","published":null,"updated":"2026-07-07T04:57:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12994","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12994","identifiers":[{"identifier":"2509.12994","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jian","familyName":"Gao","name":"Gao, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fufangchen","familyName":"Zhao","name":"Zhao, Fufangchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiyang","familyName":"Zhang","name":"Zhang, Yiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danfeng","familyName":"Yan","name":"Yan, Danfeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SitLLM: Large Language Models for Sitting Posture Health Understanding via Pressure Sensor Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T12:06:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:43:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Poor sitting posture is a critical yet often overlooked factor contributing to long-term musculoskeletal disorders and physiological dysfunctions. Existing sitting posture monitoring systems, although leveraging visual, IMU, or pressure-based modalities, often suffer from coarse-grained recognition and lack the semantic expressiveness necessary for personalized feedback. In this paper, we propose \\textbf{SitLLM}, a lightweight multimodal framework that integrates flexible pressure sensing with large language models (LLMs) to enable fine-grained posture understanding and personalized health-oriented response generation. SitLLM comprises three key components: (1) a \\textit{Gaussian-Robust Sensor Embedding Module} that partitions pressure maps into spatial patches and injects local noise perturbations for robust feature extraction; (2) a \\textit{Prompt-Driven Cross-Modal Alignment Module} that reprograms sensor embeddings into the LLM's semantic space via multi-head cross-attention using the pre-trained vocabulary embeddings; and (3) a \\textit{Multi-Context Prompt Module} that fuses feature-level, structure-level, statistical-level, and semantic-level contextual information to guide instruction comprehension."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12994","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:53:22Z","registered":"2025-09-17T01:53:23Z","published":null,"updated":"2025-09-17T01:53:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12995","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12995","identifiers":[{"identifier":"2509.12995","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yue","familyName":"Zhou","name":"Zhou, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinan","familyName":"He","name":"He, Xinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaiqing","familyName":"Lin","name":"Lin, Kaiqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Fan","name":"Fan, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Ding","name":"Ding, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinhua","familyName":"Zeng","name":"Zeng, Jinhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Li","name":"Li, Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Brought a Gun to a Knife Fight: Modern VFM Baselines Outgun Specialized Detectors on In-the-Wild AI Image Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T12:06:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:43:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-18T02:30:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-19T00:15:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-15T03:04:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-16T00:21:11Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While specialized detectors for AI-generated images excel on curated benchmarks, they fail catastrophically in real-world scenarios, as evidenced by their critically high false-negative rates on `in-the-wild' benchmarks. Instead of crafting another specialized `knife' for this problem, we bring a `gun' to the fight: a simple linear classifier on a modern Vision Foundation Model (VFM). Trained on identical data, this baseline decisively `outguns' bespoke detectors, boosting in-the-wild accuracy by a striking margin of over 20\\%.\n Our analysis pinpoints the source of the VFM's `firepower': First, by probing text-image similarities, we find that recent VLMs (e.g., Perception Encoder, Meta CLIP2) have learned to align synthetic images with forgery-related concepts (e.g., `AI-generated'), unlike previous versions. Second, we speculate that this is due to data exposure, as both this alignment and overall accuracy plummet on a novel dataset scraped after the VFM's pre-training cut-off date, ensuring it was unseen during pre-training. Our findings yield two critical conclusions: 1) For the real-world `gunfight' of AI-generated image detection, the raw `firepower' of an updated VFM is far more effective than the `craftsmanship' of a static detector. 2) True generalization evaluation requires test data to be independent of the model's entire training history, including pre-training."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12995","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:53:23Z","registered":"2025-09-17T01:53:24Z","published":null,"updated":"2025-10-16T02:25:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13007","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13007","identifiers":[{"identifier":"2509.13007","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qitan","familyName":"Shi","name":"Shi, Qitan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Jin","name":"Jin, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Zhang","name":"Zhang, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuantao","familyName":"Gu","name":"Gu, Yuantao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReTrack: Data Unlearning in Diffusion Models through Redirecting the Denoising Trajectory"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T12:20:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:43:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-29T15:08:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-31T01:03:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models excel at generating high-quality, diverse images but suffer from training data memorization, raising critical privacy and safety concerns. Data unlearning has emerged to mitigate this issue by removing the influence of specific data without retraining from scratch. We propose ReTrack, a fast and effective data unlearning method for diffusion models. ReTrack employs importance sampling to construct a more efficient fine-tuning loss, which we approximate by retaining only dominant terms. This yields an interpretable objective that redirects denoising trajectories toward the $k$-nearest neighbors, enabling efficient unlearning while preserving generative quality. Experiments on MNIST T-Shirt, CelebA-HQ, CIFAR-10, and Stable Diffusion show that ReTrack achieves state-of-the-art performance, striking the best trade-off between unlearning strength and generation quality preservation."},{"descriptionType":"Other","description":"22 pages, 12 figures, accepted by AISTATS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13007","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:53:40Z","registered":"2025-09-17T01:53:41Z","published":null,"updated":"2026-03-31T04:01:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13011","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13011","identifiers":[{"identifier":"2509.13011","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuyang","familyName":"Tian","name":"Tian, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shunqiang","familyName":"Mao","name":"Mao, Shunqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenchang","familyName":"Gao","name":"Gao, Wenchang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lanlan","familyName":"Qiu","name":"Qiu, Lanlan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianxing","familyName":"He","name":"He, Tianxing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Visualized Framework for Event Cooperation with Generative Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T12:33:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:44:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have revolutionized the simulation of agent societies, enabling autonomous planning, memory formation, and social interactions. However, existing frameworks often overlook systematic evaluations for event organization and lack visualized integration with physically grounded environments, limiting agents' ability to navigate spaces and interact with items realistically. We develop MiniAgentPro, a visualization platform featuring an intuitive map editor for customizing environments and a simulation player with smooth animations. Based on this tool, we introduce a comprehensive test set comprising eight diverse event scenarios with basic and hard variants to assess agents' ability. Evaluations using GPT-4o demonstrate strong performance in basic settings but highlight coordination challenges in hard variants."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13011","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:53:45Z","registered":"2025-09-17T01:53:46Z","published":null,"updated":"2025-09-17T01:53:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13021","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13021","identifiers":[{"identifier":"2509.13021","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Phung Duc","familyName":"Luong","name":"Luong, Phung Duc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Le Tran Gia","familyName":"Bao","name":"Bao, Le Tran Gia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nguyen Vu Khai","familyName":"Tam","name":"Tam, Nguyen Vu Khai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong Huu Nguyen","familyName":"Khoa","name":"Khoa, Dong Huu Nguyen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nguyen Huu","familyName":"Quyen","name":"Quyen, Nguyen Huu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Van-Hau","familyName":"Pham","name":"Pham, Van-Hau","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Phan The","familyName":"Duy","name":"Duy, Phan The","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"xOffense: An Autonomous Multi-Agent Framework for Penetration Testing with Domain-Adapted Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T12:45:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:44:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-27T11:42:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-28T01:36:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This work introduces xOffense, an AI-driven, multi-agent penetration testing framework that shifts the process from labor-intensive, expert-driven manual efforts to fully automated, machine-executable workflows capable of scaling seamlessly with computational infrastructure. At its core, xOffense leverages a fine-tuned, mid-scale open-source LLM (Qwen3-32B) to drive reasoning and decision-making in penetration testing. The framework assigns specialized agents to reconnaissance, vulnerability scanning, and exploitation, with an orchestration layer ensuring seamless coordination across phases. Fine-tuning on Chain-of-Thought penetration testing data further enables the model to generate precise tool commands and perform consistent multi-step reasoning. We evaluate xOffense on two rigorous benchmarks: AutoPenBench and AI-Pentest-Benchmark. The results demonstrate that xOffense consistently outperforms contemporary methods, achieving a sub-task completion rate of 79.17%, decisively surpassing leading systems such as VulnBot and PentestGPT. These findings highlight the potential of domain-adapted mid-scale LLMs, when embedded within structured multi-agent orchestration, to deliver superior, cost-efficient, and reproducible solutions for autonomous penetration testing."},{"descriptionType":"Other","description":"17 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13021","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:54:00Z","registered":"2025-09-17T01:54:00Z","published":null,"updated":"2026-04-28T04:04:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13031","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13031","identifiers":[{"identifier":"2509.13031","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yan","familyName":"Chen","name":"Chen, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Li","name":"Li, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Teng","familyName":"Xi","name":"Xi, Teng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Long","familyName":"Zeng","name":"Zeng, Long","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingdong","familyName":"Wang","name":"Wang, Jingdong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Perception Before Reasoning: Two-Stage Reinforcement Learning for Visual Reasoning in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T12:51:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:45:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-17T10:09:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-20T00:37:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) has proven highly effective in eliciting the reasoning capabilities of large language models (LLMs). Inspired by this success, recent studies have explored applying similar techniques to vision-language models (VLMs), aiming to enhance their reasoning performance. However, directly transplanting RL methods from LLMs to VLMs is suboptimal, as the tasks faced by VLMs are inherently more complex. Specifically, VLMs must first accurately perceive and understand visual inputs before reasoning can be effectively performed. To address this challenge, we propose a two-stage reinforcement learning framework designed to jointly enhance both the perceptual and reasoning capabilities of VLMs. To mitigate the vanishing advantage issue commonly observed in RL training, we first perform dataset-level sampling to selectively strengthen specific capabilities using distinct data sources. During training, the first stage focuses on improving the model's visual perception through coarse- and fine-grained visual understanding, while the second stage targets the enhancement of reasoning abilities. After the proposed two-stage reinforcement learning process, we obtain PeBR-R1, a vision-language model with significantly enhanced perceptual and reasoning capabilities. Experimental results on seven benchmark datasets demonstrate the effectiveness of our approach and validate the superior performance of PeBR-R1 across diverse visual reasoning tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13031","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:54:13Z","registered":"2025-09-17T01:54:13Z","published":null,"updated":"2025-10-20T02:01:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13067","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13067","identifiers":[{"identifier":"2509.13067","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xu","familyName":"Li","name":"Li, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Liang","name":"Liang, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolei","familyName":"Chen","name":"Chen, Xiaolei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Zheng","name":"Zheng, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haotian","familyName":"Chen","name":"Chen, Haotian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Li","name":"Li, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyang","familyName":"Xue","name":"Xue, Xiangyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HERO: Rethinking Visual Token Early Dropping in High-Resolution Large Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T13:22:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:46:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-29T07:44:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T01:41:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"By cropping high-resolution images into local tiles and encoding them independently, High-Resolution Large Vision-Language Models (HR-LVLMs) have demonstrated remarkable fine-grained visual understanding capabilities. However, this divide-and-conquer paradigm significantly increases the number of visual tokens, resulting in substantial computational and memory overhead. To better understand and address this challenge, we empirically investigate visual token utilization in HR-LVLMs and uncover three key findings: (1) the local tiles have varying importance, jointly determined by visual saliency and task relevance; (2) the CLS token in CLIP-based vision encoders exhibits a two-stage attention pattern across layers, with each stage attending to different types of visual tokens; (3) the visual tokens emphasized at different stages encode information at varying levels of granularity, playing complementary roles within LVLMs. Building on these insights, we propose HERO, a High-resolution visual token early dropping framework that integrates content-adaptive token budget allocation with function-aware token selection. By accurately estimating tile-level importance and selectively retaining visual tokens with complementary roles, HERO achieves superior efficiency-accuracy trade-offs across diverse benchmarks and model scales, all in a training-free manner. This study provides both empirical insights and practical solutions toward efficient inference in HR-LVLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13067","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:55:02Z","registered":"2025-09-17T01:55:03Z","published":null,"updated":"2025-09-30T05:19:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13081","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13081","identifiers":[{"identifier":"2509.13081","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Francesco","familyName":"Pappone","name":"Pappone, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruggero Marino","familyName":"Lazzaroni","name":"Lazzaroni, Ruggero Marino","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Federico","familyName":"Califano","name":"Califano, Federico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niccolò","familyName":"Gentile","name":"Gentile, Niccolò","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roberto","familyName":"Marras","name":"Marras, Roberto","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Shaping Explanations: Semantic Reward Modeling with Encoder-Only Transformers for GRPO"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T13:39:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:47:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While Large Language Models (LLMs) excel at generating human-like text, aligning their outputs with complex, qualitative goals like pedagogical soundness remains a significant challenge. Standard reinforcement learning techniques often rely on slow and expensive LLM-as-a-judge evaluations or on brittle, keyword-based metrics like ROUGE, which fail to capture the semantic essence of a high-quality explanation. In this work, we introduce a novel approach to reward shaping within the Group Relative Policy Optimisation (GRPO) framework. Our central contribution is the use of a small, efficient encoder-only transformer as a semantic reward model. This model provides a dense, semantically rich reward signal based on the cosine similarity between a generated explanation and a ground-truth reference, guiding the policy towards explanations that are not just factually correct but also structurally and conceptually aligned with expert reasoning. We apply this method to the task of training a model for the Italian medical-school entrance examinations, following standard domain-adaptive continued pre-training (CPT) and supervised fine-tuning (SFT). Our results demonstrate that GRPO with our proposed semantic reward significantly improves explanation faithfulness and clarity over a strong SFT baseline, showcasing the power of using lightweight encoder models for nuanced reward shaping in complex generation tasks"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13081","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:55:28Z","registered":"2025-09-17T01:55:28Z","published":null,"updated":"2025-09-17T01:55:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13095","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13095","identifiers":[{"identifier":"2509.13095","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zijie","familyName":"Zhao","name":"Zhao, Zijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Honglei","familyName":"Guo","name":"Guo, Honglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengqian","familyName":"Chen","name":"Chen, Shengqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaixuan","familyName":"Xu","name":"Xu, Kaixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Jiang","name":"Jiang, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanheng","familyName":"Zhu","name":"Zhu, Yuanheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongbin","familyName":"Zhao","name":"Zhao, Dongbin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Empowering Multi-Robot Cooperation via Sequential World Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T13:52:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:48:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-26T02:55:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T00:25:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-04T14:43:35Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-07T00:33:23Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Model-based reinforcement learning (MBRL) has achieved remarkable success in robotics due to its high sample efficiency and planning capability. However, extending MBRL to physical multi-robot cooperation remains challenging due to the complexity of joint dynamics. To address this challenge, we propose the Sequential World Model (SeqWM), a novel framework that integrates the sequential paradigm into multi-robot MBRL. SeqWM employs independent, autoregressive agent-wise world models to represent joint dynamics, where each agent generates its future trajectory and plans its actions based on the predictions of its predecessors. This design lowers modeling complexity and enables the emergence of advanced cooperative behaviors through explicit intention sharing. Experiments on Bi-DexHands and Multi-Quadruped demonstrate that SeqWM outperforms existing state-of-the-art model-based and model-free baselines in both overall performance and sample efficiency, while exhibiting advanced cooperative behaviors such as predictive adaptation, temporal alignment, and role division. Furthermore, SeqWM has been successfully deployed on physical quadruped robots, validating its effectiveness in real-world multi-robot systems. Demos and code are available at: https://github.com/zhaozijie2022/seqwm"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13095","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:55:48Z","registered":"2025-09-17T01:55:49Z","published":null,"updated":"2026-04-07T03:25:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13127","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13127","identifiers":[{"identifier":"2509.13127","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sijia","familyName":"Cui","name":"Cui, Sijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Xu","name":"Xu, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aiyao","familyName":"He","name":"He, Aiyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanna","familyName":"Wang","name":"Wang, Yanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Xu","name":"Xu, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Empowering LLMs with Parameterized Skills for Adversarial Long-Horizon Planning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T14:36:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:50:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in Large Language Models(LLMs) have led to the development of LLM-based AI agents. A key challenge is the creation of agents that can effectively ground themselves in complex, adversarial long-horizon environments. Existing methods mainly focus on (1) using LLMs as policies to interact with the environment through generating low-level feasible actions, and (2) utilizing LLMs to generate high-level tasks or language guides to stimulate action generation. However, the former struggles to generate reliable actions, while the latter relies heavily on expert experience to translate high-level tasks into specific action sequences. To address these challenges, we introduce the Plan with Language, Act with Parameter (PLAP) planning framework that facilitates the grounding of LLM-based agents in long-horizon environments. The PLAP method comprises three key components: (1) a skill library containing environment-specific parameterized skills, (2) a skill planner powered by LLMs, and (3) a skill executor converting the parameterized skills into executable action sequences. We implement PLAP in MicroRTS, a long-horizon real-time strategy game that provides an unfamiliar and challenging environment for LLMs. The experimental results demonstrate the effectiveness of PLAP. In particular, GPT-4o-driven PLAP in a zero-shot setting outperforms 80% of baseline agents, and Qwen2-72B-driven PLAP, with carefully crafted few-shot examples, surpasses the top-tier scripted agent, CoacAI. Additionally, we design comprehensive evaluation metrics and test 6 closed-source and 2 open-source LLMs within the PLAP framework, ultimately releasing an LLM leaderboard ranking long-horizon skill planning ability. Our code is available at https://github.com/AI-Research-TeamX/PLAP."},{"descriptionType":"Other","description":"Accepted to IJCNN 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13127","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:56:32Z","registered":"2025-09-17T01:56:33Z","published":null,"updated":"2025-09-17T01:56:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13149","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13149","identifiers":[{"identifier":"2509.13149","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minqing","familyName":"Huang","name":"Huang, Minqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shouyi","familyName":"Lu","name":"Lu, Shouyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boyuan","familyName":"Zheng","name":"Zheng, Boyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyao","familyName":"Li","name":"Li, Ziyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Tang","name":"Tang, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guirong","familyName":"Zhuo","name":"Zhuo, Guirong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MSDNet: Efficient 4D Radar Super-Resolution via Multi-Stage Distillation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T15:05:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:52:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"4D radar super-resolution, which aims to reconstruct sparse and noisy point clouds into dense and geometrically consistent representations, is a foundational problem in autonomous perception. However, existing methods often suffer from high training cost or rely on complex diffusion-based sampling, resulting in high inference latency and poor generalization, making it difficult to balance accuracy and efficiency. To address these limitations, we propose MSDNet, a multi-stage distillation framework that efficiently transfers dense LiDAR priors to 4D radar features to achieve both high reconstruction quality and computational efficiency. The first stage performs reconstruction-guided feature distillation, aligning and densifying the student's features through feature reconstruction. In the second stage, we propose diffusion-guided feature distillation, which treats the stage-one distilled features as a noisy version of the teacher's representations and refines them via a lightweight diffusion network. Furthermore, we introduce a noise adapter that adaptively aligns the noise level of the feature with a predefined diffusion timestep, enabling a more precise denoising. Extensive experiments on the VoD and in-house datasets demonstrate that MSDNet achieves both high-fidelity reconstruction and low-latency inference in the task of 4D radar point cloud super-resolution, and consistently improves performance on downstream tasks. The code will be publicly available upon publication."},{"descriptionType":"Other","description":"8 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13149","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:57:02Z","registered":"2025-09-17T01:57:03Z","published":null,"updated":"2025-09-17T01:57:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13154","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13154","identifiers":[{"identifier":"2509.13154","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinxin","familyName":"Li","name":"Li, Jinxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Tu","name":"Tu, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"ShengYu","familyName":"Cheng","name":"Cheng, ShengYu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Hu","name":"Hu, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinting","familyName":"Wang","name":"Wang, Jinting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Chen","name":"Chen, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhilong","familyName":"Zhou","name":"Zhou, Zhilong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongbo","familyName":"Shan","name":"Shan, Dongbo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM Hallucination Detection: A Fast Fourier Transform Method Based on Hidden Layer Temporal Signals"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T15:08:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:52:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Hallucination remains a critical barrier for deploying large language models (LLMs) in reliability-sensitive applications. Existing detection methods largely fall into two categories: factuality checking, which is fundamentally constrained by external knowledge coverage, and static hidden-state analysis, that fails to capture deviations in reasoning dynamics. As a result, their effectiveness and robustness remain limited. We propose HSAD (Hidden Signal Analysis-based Detection), a novel hallucination detection framework that models the temporal dynamics of hidden representations during autoregressive generation. HSAD constructs hidden-layer signals by sampling activations across layers, applies Fast Fourier Transform (FFT) to obtain frequency-domain representations, and extracts the strongest non-DC frequency component as spectral features. Furthermore, by leveraging the autoregressive nature of LLMs, HSAD identifies optimal observation points for effective and reliable detection. Across multiple benchmarks, including TruthfulQA, HSAD achieves over 10 percentage points improvement compared to prior state-of-the-art methods. By integrating reasoning-process modeling with frequency-domain analysis, HSAD establishes a new paradigm for robust hallucination detection in LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13154","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:57:09Z","registered":"2025-09-17T01:57:10Z","published":null,"updated":"2025-09-17T01:57:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13160","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13160","identifiers":[{"identifier":"2509.13160","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liang","familyName":"Hu","name":"Hu, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianpeng","familyName":"Jiao","name":"Jiao, Jianpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiashuo","familyName":"Liu","name":"Liu, Jiashuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanle","familyName":"Ren","name":"Ren, Yanle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhoufutu","familyName":"Wen","name":"Wen, Zhoufutu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaiyuan","familyName":"Zhang","name":"Zhang, Kaiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanliang","familyName":"Zhang","name":"Zhang, Xuanliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Gao","name":"Gao, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianci","familyName":"He","name":"He, Tianci","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Hu","name":"Hu, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yali","familyName":"Liao","name":"Liao, Yali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zaiyuan","familyName":"Wang","name":"Wang, Zaiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenghao","familyName":"Yang","name":"Yang, Chenghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianyu","familyName":"Yang","name":"Yang, Qianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingren","familyName":"Yin","name":"Yin, Mingren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Zeng","name":"Zeng, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ge","familyName":"Zhang","name":"Zhang, Ge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Zhang","name":"Zhang, Xinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiying","familyName":"Zhao","name":"Zhao, Xiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenwei","familyName":"Zhu","name":"Zhu, Zhenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongseok","familyName":"Namkoong","name":"Namkoong, Hongseok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Huang","name":"Huang, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuwen","familyName":"Tang","name":"Tang, Yuwen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FinSearchComp: Towards a Realistic, Expert-Level Evaluation of Financial Search and Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T15:13:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:52:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Search has emerged as core infrastructure for LLM-based agents and is widely viewed as critical on the path toward more general intelligence. Finance is a particularly demanding proving ground: analysts routinely conduct complex, multi-step searches over time-sensitive, domain-specific data, making it ideal for assessing both search proficiency and knowledge-grounded reasoning. Yet no existing open financial datasets evaluate data searching capability of end-to-end agents, largely because constructing realistic, complicated tasks requires deep financial expertise and time-sensitive data is hard to evaluate. We present FinSearchComp, the first fully open-source agent benchmark for realistic, open-domain financial search and reasoning. FinSearchComp comprises three tasks -- Time-Sensitive Data Fetching, Simple Historical Lookup, and Complex Historical Investigation -- closely reproduce real-world financial analyst workflows. To ensure difficulty and reliability, we engage 70 professional financial experts for annotation and implement a rigorous multi-stage quality-assurance pipeline. The benchmark includes 635 questions spanning global and Greater China markets, and we evaluate 21 models (products) on it. Grok 4 (web) tops the global subset, approaching expert-level accuracy. DouBao (web) leads on the Greater China subset. Experimental analyses show that equipping agents with web search and financial plugins substantially improves results on FinSearchComp, and the country origin of models and tools impact performance significantly.By aligning with realistic analyst tasks and providing end-to-end evaluation, FinSearchComp offers a professional, high-difficulty testbed for complex financial search and reasoning."},{"descriptionType":"Other","description":"29 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13160","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:57:17Z","registered":"2025-09-17T01:57:18Z","published":null,"updated":"2025-09-17T01:57:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13164","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13164","identifiers":[{"identifier":"2509.13164","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiawei","familyName":"Wang","name":"Wang, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haowei","familyName":"Sun","name":"Sun, Haowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xintao","familyName":"Yan","name":"Yan, Xintao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Feng","name":"Feng, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Gao","name":"Gao, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Henry X.","familyName":"Liu","name":"Liu, Henry X.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TeraSim-World: Worldwide Safety-Critical Data Synthesis for End-to-End Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T15:14:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:53:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T04:40:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:21:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Safe and scalable deployment of end-to-end (E2E) autonomous driving requires extensive and diverse data, particularly safety-critical events. Existing data are mostly generated from simulators with a significant sim-to-real gap or collected from on-road testing that is costly and unsafe. This paper presents TeraSim-World, an automated pipeline that synthesizes realistic and geographically diverse safety-critical data for E2E autonomous driving at anywhere in the world. Starting from an arbitrary location, TeraSim-World retrieves real-world maps and traffic demand from geospatial data sources. Then, it simulates agent behaviors from naturalistic driving datasets, and orchestrates diverse adversities to create corner cases. Informed by street views of the same location, it achieves photorealistic, geographically grounded sensor rendering via the frontier video generation model Cosmos-Drive. By bridging agent and sensor simulations, TeraSim-World provides a scalable and critical data synthesis framework for training and evaluation of E2E autonomous driving systems. Codes and videos are available at https://wjiawei.com/terasim-world-web/ ."},{"descriptionType":"Other","description":"8 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13164","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:57:24Z","registered":"2025-09-17T01:57:25Z","published":null,"updated":"2025-09-18T17:44:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13175","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13175","identifiers":[{"identifier":"2509.13175","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yingtai","familyName":"Li","name":"Li, Yingtai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoran","familyName":"Lai","name":"Lai, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoqian","familyName":"Zhou","name":"Zhou, Xiaoqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Ming","name":"Ming, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxin","familyName":"Ma","name":"Ma, Wenxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wei","name":"Wei, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaohua Kevin","familyName":"Zhou","name":"Zhou, Shaohua Kevin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"More performant and scalable: Rethinking contrastive vision-language pre-training of radiology in the LLM era"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T15:27:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:53:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The emergence of Large Language Models (LLMs) presents unprecedented opportunities to revolutionize medical contrastive vision-language pre-training. In this paper, we show how LLMs can facilitate large-scale supervised pre-training, thereby advancing vision-language alignment. We begin by demonstrate that modern LLMs can automatically extract diagnostic labels from radiology reports with remarkable precision (\u0026gt;96\\% AUC in our experiments) without complex prompt engineering, enabling the creation of large-scale \"silver-standard\" datasets at a minimal cost (~\\$3 for 50k CT image-report pairs). Further, we find that vision encoder trained on this \"silver-standard\" dataset achieves performance comparable to those trained on labels extracted by specialized BERT-based models, thereby democratizing the access to large-scale supervised pre-training. Building on this foundation, we proceed to reveal that supervised pre-training fundamentally improves contrastive vision-language alignment. Our approach achieves state-of-the-art performance using only a 3D ResNet-18 with vanilla CLIP training, including 83.8\\% AUC for zero-shot diagnosis on CT-RATE, 77.3\\% AUC on RAD-ChestCT, and substantial improvements in cross-modal retrieval (MAP@50=53.7\\% for image-image, Recall@100=52.2\\% for report-image). These results demonstrate the potential of utilizing LLMs to facilitate {\\bf more performant and scalable} medical AI systems. Our code is avaiable at https://github.com/SadVoxel/More-performant-and-scalable."},{"descriptionType":"Other","description":"MICCAI 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13175","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:57:39Z","registered":"2025-09-17T01:57:40Z","published":null,"updated":"2025-09-17T01:57:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13179","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13179","identifiers":[{"identifier":"2509.13179","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yushang","familyName":"Zhao","name":"Zhao, Yushang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyue","familyName":"Han","name":"Han, Xinyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Leng","name":"Leng, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianyi","familyName":"Sun","name":"Sun, Qianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haotian","familyName":"Lyu","name":"Lyu, Haotian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengrui","familyName":"Zhou","name":"Zhou, Chengrui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Cold-Start Recommendation via BPE Token-Level Embedding Initialization with LLM"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T15:32:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:54:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The cold-start issue is the challenge when we talk about recommender systems, especially in the case when we do not have the past interaction data of new users or new items. Content-based features or hybrid solutions are common as conventional solutions, but they can only work in a sparse metadata environment with shallow patterns. In this paper, the efficient cold-start recommendation strategy is presented, which is based on the sub word-level representations by applying Byte Pair Encoding (BPE) tokenization and pre-trained Large Language Model (LLM) embedding in the initialization procedure. We obtain fine-grained token-level vectors that are aligned with the BPE vocabulary as opposed to using coarse-grained sentence embeddings. Together, these token embeddings can be used as dense semantic priors on unseen entities, making immediate recommendation performance possible without user-item interaction history. Our mechanism can be compared to collaborative filtering systems and tested over benchmark datasets with stringent cold-start assumptions. Experimental findings show that the given BPE-LLM method achieves higher Recall@k, NDCG@k, and Hit Rate measurements compared to the standard baseline and displays the same capability of sufficient computational performance. Furthermore, we demonstrate that using subword-aware embeddings yields better generalizability and is more interpretable, especially within a multilingual and sparse input setting. The practical application of token-level semantic initialization as a lightweight, but nevertheless effective extension to modern recommender systems in the zero-shot setting is indicated within this work."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13179","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:57:45Z","registered":"2025-09-17T01:57:45Z","published":null,"updated":"2025-09-17T01:57:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13181","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13181","identifiers":[{"identifier":"2509.13181","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shyam Nandan","familyName":"Rai","name":"Rai, Shyam Nandan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shyamgopal","familyName":"Karthik","name":"Karthik, Shyamgopal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mariana-Iuliana","familyName":"Georgescu","name":"Georgescu, Mariana-Iuliana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Barbara","familyName":"Caputo","name":"Caputo, Barbara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlo","familyName":"Masone","name":"Masone, Carlo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeynep","familyName":"Akata","name":"Akata, Zeynep","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Road Obstacle Video Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T15:34:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:54:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the growing deployment of autonomous driving agents, the detection and segmentation of road obstacles have become critical to ensure safe autonomous navigation. However, existing road-obstacle segmentation methods are applied on individual frames, overlooking the temporal nature of the problem, leading to inconsistent prediction maps between consecutive frames. In this work, we demonstrate that the road-obstacle segmentation task is inherently temporal, since the segmentation maps for consecutive frames are strongly correlated. To address this, we curate and adapt four evaluation benchmarks for road-obstacle video segmentation and evaluate 11 state-of-the-art image- and video-based segmentation methods on these benchmarks. Moreover, we introduce two strong baseline methods based on vision foundation models. Our approach establishes a new state-of-the-art in road-obstacle video segmentation for long-range video sequences, providing valuable insights and direction for future research."},{"descriptionType":"Other","description":"GCPR 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13181","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:57:48Z","registered":"2025-09-17T01:57:48Z","published":null,"updated":"2025-09-17T01:57:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13232","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13232","identifiers":[{"identifier":"2509.13232","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhongwen","familyName":"Xu","name":"Xu, Zhongwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zihan","familyName":"Ding","name":"Ding, Zihan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Single-stream Policy Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T16:39:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:56:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T14:19:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:56:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We revisit policy-gradient optimization for Large Language Models (LLMs) from a single-stream perspective. Prevailing group-based methods like GRPO reduce variance with on-the-fly baselines but suffer from critical flaws: frequent degenerate groups erase learning signals, and synchronization barriers hinder scalability. We introduce Single-stream Policy Optimization (SPO), which eliminates these issues by design. SPO replaces per-group baselines with a persistent, KL-adaptive value tracker and normalizes advantages globally across the batch, providing a stable, low-variance learning signal for every sample. Being group-free, SPO enables higher throughput and scales effectively in long-horizon or tool-integrated settings where generation times vary. Furthermore, the persistent value tracker naturally enables an adaptive curriculum via prioritized sampling. Experiments using Qwen3-8B show that SPO converges more smoothly and attains higher accuracy than GRPO, while eliminating computation wasted on degenerate groups. Ablation studies confirm that SPO's gains stem from its principled approach to baseline estimation and advantage normalization, offering a more robust and efficient path for LLM reasoning. Across five hard math benchmarks with Qwen3 8B, SPO improves the average maj@32 by +3.4 percentage points (pp) over GRPO, driven by substantial absolute point gains on challenging datasets, including +7.3 pp on BRUMO 25, +4.4 pp on AIME 25, +3.3 pp on HMMT 25, and achieves consistent relative gain in pass@$k$ across the evaluated $k$ values. SPO's success challenges the prevailing trend of adding incidental complexity to RL algorithms, highlighting a path where fundamental principles, not architectural workarounds, drive the next wave of progress in LLM reasoning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13232","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:58:58Z","registered":"2025-09-17T01:58:59Z","published":null,"updated":"2025-09-24T02:38:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13305","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13305","identifiers":[{"identifier":"2509.13305","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kuan","familyName":"Li","name":"Li, Kuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongwang","familyName":"Zhang","name":"Zhang, Zhongwang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huifeng","familyName":"Yin","name":"Yin, Huifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Ye","name":"Ye, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yida","familyName":"Zhao","name":"Zhao, Yida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liwen","familyName":"Zhang","name":"Zhang, Liwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Litu","familyName":"Ou","name":"Ou, Litu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingchu","familyName":"Zhang","name":"Zhang, Dingchu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xixi","familyName":"Wu","name":"Wu, Xixi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialong","familyName":"Wu","name":"Wu, Jialong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Wang","name":"Wang, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zile","familyName":"Qiao","name":"Qiao, Zile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Zhang","name":"Zhang, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Jiang","name":"Jiang, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengjun","familyName":"Xie","name":"Xie, Pengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Huang","name":"Huang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingren","familyName":"Zhou","name":"Zhou, Jingren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WebSailor-V2: Bridging the Chasm to Proprietary Agents via Synthetic Data and Scalable Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T17:57:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:59:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transcending human cognitive limitations represents a critical frontier in LLM training. Proprietary agentic systems like DeepResearch have demonstrated superhuman capabilities on extremely complex information-seeking benchmarks such as BrowseComp, a feat previously unattainable. We posit that their success hinges on a sophisticated reasoning pattern absent in open-source models: the ability to systematically reduce extreme uncertainty when navigating vast information landscapes. Based on this insight, we introduce WebSailor, a complete post-training methodology designed to instill this crucial capability. Our approach involves generating novel, high-uncertainty tasks through structured sampling and information obfuscation, RFT cold start, and an efficient agentic RL training algorithm, Duplicating Sampling Policy Optimization (DUPO). With this integrated pipeline, WebSailor significantly outperforms all open-source agents in complex information-seeking tasks, matching proprietary agents' performance and closing the capability gap."},{"descriptionType":"Other","description":"https://tongyi-agent.github.io/blog/introducing-tongyi-deep-research/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13305","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T02:00:44Z","registered":"2025-09-17T02:00:44Z","published":null,"updated":"2025-09-17T02:00:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13309","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13309","identifiers":[{"identifier":"2509.13309","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zile","familyName":"Qiao","name":"Qiao, Zile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoxin","familyName":"Chen","name":"Chen, Guoxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanzhong","familyName":"Chen","name":"Chen, Xuanzhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donglei","familyName":"Yu","name":"Yu, Donglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenbiao","familyName":"Yin","name":"Yin, Wenbiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Wang","name":"Wang, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Zhang","name":"Zhang, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baixuan","familyName":"Li","name":"Li, Baixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huifeng","familyName":"Yin","name":"Yin, Huifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuan","familyName":"Li","name":"Li, Kuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Min","name":"Min, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minpeng","familyName":"Liao","name":"Liao, Minpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Jiang","name":"Jiang, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengjun","familyName":"Xie","name":"Xie, Pengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Huang","name":"Huang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingren","familyName":"Zhou","name":"Zhou, Jingren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WebResearcher: Unleashing unbounded reasoning capability in Long-Horizon Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T17:57:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:59:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-20T14:27:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-23T00:32:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in deep-research systems have demonstrated the potential for AI agents to autonomously discover and synthesize knowledge from external sources. In this paper, we introduce WebResearcher, a novel framework for building such agents through two key components: (1) WebResearcher, an iterative deep-research paradigm that reformulates deep research as a Markov Decision Process, where agents periodically consolidate findings into evolving reports while maintaining focused workspaces, overcoming the context suffocation and noise contamination that plague existing mono-contextual approaches; and (2) WebFrontier, a scalable data synthesis engine that generates high-quality training data through tool-augmented complexity escalation, enabling systematic creation of research tasks that bridge the gap between passive knowledge recall and active knowledge construction. Notably, we find that the training data from our paradigm significantly enhances tool-use capabilities even for traditional mono-contextual methods. Furthermore, our paradigm naturally scales through parallel thinking, enabling concurrent multi-agent exploration for more comprehensive conclusions. Extensive experiments across 6 challenging benchmarks demonstrate that WebResearcher achieves state-of-the-art performance, even surpassing frontier proprietary systems."},{"descriptionType":"Other","description":"https://tongyi-agent.github.io/blog/introducing-tongyi-deep-research/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13309","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T02:00:50Z","registered":"2025-09-17T02:00:50Z","published":null,"updated":"2025-09-23T03:56:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13310","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13310","identifiers":[{"identifier":"2509.13310","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liangcai","familyName":"Su","name":"Su, Liangcai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Zhang","name":"Zhang, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangyu","familyName":"Li","name":"Li, Guangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuo","familyName":"Chen","name":"Chen, Zhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxi","familyName":"Wang","name":"Wang, Chenxi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maojia","familyName":"Song","name":"Song, Maojia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Wang","name":"Wang, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuan","familyName":"Li","name":"Li, Kuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialong","familyName":"Wu","name":"Wu, Jialong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanzhong","familyName":"Chen","name":"Chen, Xuanzhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zile","familyName":"Qiao","name":"Qiao, Zile","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongwang","familyName":"Zhang","name":"Zhang, Zhongwang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huifeng","familyName":"Yin","name":"Yin, Huifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihao","familyName":"Cai","name":"Cai, Shihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runnan","familyName":"Fang","name":"Fang, Runnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengwei","familyName":"Tao","name":"Tao, Zhengwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenbiao","familyName":"Yin","name":"Yin, Wenbiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxiong","familyName":"Qian","name":"Qian, Chenxiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Jiang","name":"Jiang, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengjun","familyName":"Xie","name":"Xie, Pengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Huang","name":"Huang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingren","familyName":"Zhou","name":"Zhou, Jingren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scaling Agents via Continual Pre-training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T17:57:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:59:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have evolved into agentic systems capable of autonomous tool use and multi-step reasoning for complex problem-solving. However, post-training approaches building upon general-purpose foundation models consistently underperform in agentic tasks, particularly in open-source implementations. We identify the root cause: the absence of robust agentic foundation models forces models during post-training to simultaneously learn diverse agentic behaviors while aligning them to expert demonstrations, thereby creating fundamental optimization tensions. To this end, we are the first to propose incorporating Agentic Continual Pre-training (Agentic CPT) into the deep research agents training pipeline to build powerful agentic foundational models. Based on this approach, we develop a deep research agent model named AgentFounder. We evaluate our AgentFounder-30B on 10 benchmarks and achieve state-of-the-art performance while retains strong tool-use ability, notably 39.9% on BrowseComp-en, 43.3% on BrowseComp-zh, and 31.5% Pass@1 on HLE."},{"descriptionType":"Other","description":"https://tongyi-agent.github.io/blog/introducing-tongyi-deep-research/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13310","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T02:00:51Z","registered":"2025-09-17T02:00:52Z","published":null,"updated":"2025-09-17T02:00:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13311","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13311","identifiers":[{"identifier":"2509.13311","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Runnan","familyName":"Fang","name":"Fang, Runnan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihao","familyName":"Cai","name":"Cai, Shihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baixuan","familyName":"Li","name":"Li, Baixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialong","familyName":"Wu","name":"Wu, Jialong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangyu","familyName":"Li","name":"Li, Guangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenbiao","familyName":"Yin","name":"Yin, Wenbiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Wang","name":"Wang, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobin","familyName":"Wang","name":"Wang, Xiaobin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liangcai","familyName":"Su","name":"Su, Liangcai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Zhang","name":"Zhang, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shibin","familyName":"Wu","name":"Wu, Shibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengwei","familyName":"Tao","name":"Tao, Zhengwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Jiang","name":"Jiang, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengjun","familyName":"Xie","name":"Xie, Pengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Huang","name":"Huang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingren","familyName":"Zhou","name":"Zhou, Jingren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards General Agentic Intelligence via Environment Scaling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T17:57:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:59:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Advanced agentic intelligence is a prerequisite for deploying Large Language Models in practical, real-world applications. Diverse real-world APIs demand precise, robust function-calling intelligence, which needs agents to develop these capabilities through interaction in varied environments. The breadth of function-calling competence is closely tied to the diversity of environments in which agents are trained. In this work, we scale up environments as a step towards advancing general agentic intelligence. This gives rise to two central challenges: (i) how to scale environments in a principled manner, and (ii) how to effectively train agentic capabilities from experiences derived through interactions with these environments. To address these, we design a scalable framework that automatically constructs heterogeneous environments that are fully simulated, systematically broadening the space of function-calling scenarios. We further adapt a two-phase agent fine-tuning strategy: first endowing agents with fundamental agentic capabilities, then specializing them for domain-specific contexts. Extensive experiments on agentic benchmarks, tau-bench, tau2-Bench, and ACEBench, demonstrate that our trained model, AgentScaler, significantly enhances the function-calling capability of models."},{"descriptionType":"Other","description":"https://tongyi-agent.github.io/blog/introducing-tongyi-deep-research/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13311","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T02:00:52Z","registered":"2025-09-17T02:00:53Z","published":null,"updated":"2025-09-17T02:00:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13312","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13312","identifiers":[{"identifier":"2509.13312","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zijian","familyName":"Li","name":"Li, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Guan","name":"Guan, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Zhang","name":"Zhang, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shen","familyName":"Huang","name":"Huang, Shen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Houquan","familyName":"Zhou","name":"Zhou, Houquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaopeng","familyName":"Lai","name":"Lai, Shaopeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Yan","name":"Yan, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Jiang","name":"Jiang, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengjun","familyName":"Xie","name":"Xie, Pengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Huang","name":"Huang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Zhang","name":"Zhang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingren","familyName":"Zhou","name":"Zhou, Jingren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WebWeaver: Structuring Web-Scale Evidence with Dynamic Outlines for Open-Ended Deep Research"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T17:57:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:59:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-29T14:27:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T02:06:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-07T11:47:57Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-08T00:42:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper tackles \\textbf{open-ended deep research (OEDR)}, a complex challenge where AI agents must synthesize vast web-scale information into insightful reports. Current approaches are plagued by dual-fold limitations: static research pipelines that decouple planning from evidence acquisition and monolithic generation paradigms that include redundant, irrelevant evidence, suffering from hallucination issues and low citation accuracy. To address these challenges, we introduce \\textbf{WebWeaver}, a novel dual-agent framework that emulates the human research process. The planner operates in a dynamic cycle, iteratively interleaving evidence acquisition with outline optimization to produce a comprehensive, citation-grounded outline linking to a memory bank of evidence. The writer then executes a hierarchical retrieval and writing process, composing the report section by section. By performing targeted retrieval of only the necessary evidence from the memory bank via citations for each part, it effectively mitigates long-context issues and citation hallucinations. Our framework establishes a new state-of-the-art across major OEDR benchmarks, including DeepResearch Bench, DeepConsult, and DeepResearchGym. These results validate our human-centric, iterative methodology, demonstrating that adaptive planning and focused synthesis are crucial for producing comprehensive, trusted, and well-structured reports."},{"descriptionType":"Other","description":"An agent system for open-ended deep research"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13312","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T02:00:54Z","registered":"2025-09-17T02:00:54Z","published":null,"updated":"2025-10-08T02:24:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13313","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13313","identifiers":[{"identifier":"2509.13313","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xixi","familyName":"Wu","name":"Wu, Xixi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuan","familyName":"Li","name":"Li, Kuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yida","familyName":"Zhao","name":"Zhao, Yida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liwen","familyName":"Zhang","name":"Zhang, Liwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Litu","familyName":"Ou","name":"Ou, Litu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huifeng","familyName":"Yin","name":"Yin, Huifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongwang","familyName":"Zhang","name":"Zhang, Zhongwang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinmiao","familyName":"Yu","name":"Yu, Xinmiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingchu","familyName":"Zhang","name":"Zhang, Dingchu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Jiang","name":"Jiang, Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengjun","familyName":"Xie","name":"Xie, Pengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Huang","name":"Huang, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minhao","familyName":"Cheng","name":"Cheng, Minhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Wang","name":"Wang, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Cheng","name":"Cheng, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingren","familyName":"Zhou","name":"Zhou, Jingren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReSum: Unlocking Long-Horizon Search Intelligence via Context Summarization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T17:57:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:59:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-15T15:51:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-16T01:00:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-26T06:50:32Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-27T00:32:00Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Model (LLM)-based web agents excel at knowledge-intensive tasks but face a fundamental conflict between the need for extensive exploration and the constraints of limited context windows. Current solutions typically rely on architectural modifications, e.g., internal memory tokens, which break compatibility with pre-existing agents and necessitate costly end-to-end retraining. To overcome these limitations, we introduce ReSum, a lightweight, plug-and-play paradigm that enables unbounded exploration by periodically invoking an external tool to condense interaction histories into compact summaries. Although this paradigm functions without training, standard agents are not inherently aligned to reason over such compressed contexts. To bridge this gap, we propose ReSum-GRPO, which adapts Group Relative Policy Optimization (GRPO) via advantage broadcasting to propagate final rewards across segmented trajectories, enabling credit assignments over long-horizons. Extensive experiments show that ReSum achieves a 4.5% improvement over ReAct in training-free settings, with ReSum-GRPO yielding a further 8.2% gain. Notably, with only 1K training samples, a ReSum-enhanced 30B agent achieves competitive performance with leading open-source models, showing ReSum's effectiveness."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13313","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T02:00:55Z","registered":"2025-09-17T02:00:56Z","published":null,"updated":"2026-03-27T02:21:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13317","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13317","identifiers":[{"identifier":"2509.13317","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"An-Chieh","familyName":"Cheng","name":"Cheng, An-Chieh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Fu","name":"Fu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yukang","familyName":"Chen","name":"Chen, Yukang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijian","familyName":"Liu","name":"Liu, Zhijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolong","familyName":"Li","name":"Li, Xiaolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Subhashree","familyName":"Radhakrishnan","name":"Radhakrishnan, Subhashree","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Song","familyName":"Han","name":"Han, Song","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Lu","name":"Lu, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan","familyName":"Kautz","name":"Kautz, Jan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pavlo","familyName":"Molchanov","name":"Molchanov, Pavlo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongxu","familyName":"Yin","name":"Yin, Hongxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaolong","familyName":"Wang","name":"Wang, Xiaolong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sifei","familyName":"Liu","name":"Liu, Sifei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"3D Aware Region Prompted Vision Language Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T17:59:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T01:00:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present Spatial Region 3D (SR-3D) aware vision-language model that connects single-view 2D images and multi-view 3D data through a shared visual token space. SR-3D supports flexible region prompting, allowing users to annotate regions with bounding boxes, segmentation masks on any frame, or directly in 3D, without the need for exhaustive multi-frame labeling. We achieve this by enriching 2D visual features with 3D positional embeddings, which allows the 3D model to draw upon strong 2D priors for more accurate spatial reasoning across frames, even when objects of interest do not co-occur within the same view. Extensive experiments on both general 2D vision language and specialized 3D spatial benchmarks demonstrate that SR-3D achieves state-of-the-art performance, underscoring its effectiveness for unifying 2D and 3D representation space on scene understanding. Moreover, we observe applicability to in-the-wild videos without sensory 3D inputs or ground-truth 3D annotations, where SR-3D accurately infers spatial relationships and metric measurements."},{"descriptionType":"Other","description":"Project Website: https://www.anjiecheng.me/sr3d"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13317","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T02:01:01Z","registered":"2025-09-17T02:01:01Z","published":null,"updated":"2025-09-17T02:01:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13368","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13368","identifiers":[{"identifier":"2509.13368","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuan","familyName":"Wei","name":"Wei, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohan","familyName":"Shan","name":"Shan, Xiaohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ran","familyName":"Miao","name":"Miao, Ran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianmin","familyName":"Li","name":"Li, Jianmin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"$Agent^2$: An Agent-Generates-Agent Framework for Reinforcement Learning Automation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T02:14:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:01:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-30T05:06:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-01T00:34:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) agent development traditionally requires substantial expertise and iterative effort, often leading to high failure rates and limited accessibility. This paper introduces Agent$^2$, an LLM-driven agent-generates-agent framework for fully automated RL agent design. Agent$^2$ autonomously translates natural language task descriptions and environment code into executable RL solutions without human intervention. The framework adopts a dual-agent architecture: a Generator Agent that analyzes tasks and designs agents, and a Target Agent that is automatically generated and executed. To better support automation, RL development is decomposed into two stages, MDP modeling and algorithmic optimization, facilitating targeted and effective agent generation. Built on the Model Context Protocol, Agent$^2$ provides a unified framework for standardized agent creation across diverse environments and algorithms, incorporating adaptive training management and intelligent feedback analysis for continuous refinement. Extensive experiments on benchmarks including MuJoCo, MetaDrive, MPE, and SMAC show that Agent$^2$ outperforms manually designed baselines across all tasks, achieving up to 55\\% performance improvement with consistent average gains. By enabling a closed-loop, end-to-end automation pipeline, this work advances a new paradigm in which agents can design and optimize other agents, underscoring the potential of agent-generates-agent systems for automated AI development."},{"descriptionType":"Other","description":"19 pages, 5 figures,4 Tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13368","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:34:04Z","registered":"2025-09-18T17:34:04Z","published":null,"updated":"2025-10-01T03:01:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13375","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13375","identifiers":[{"identifier":"2509.13375","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuxiao","familyName":"Lee","name":"Lee, Yuxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofeng","familyName":"Cao","name":"Cao, Xiaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Ye","name":"Ye, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangchao","familyName":"Yao","name":"Yao, Jiangchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingkuan","familyName":"Song","name":"Song, Jingkuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng Tao","familyName":"Shen","name":"Shen, Heng Tao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An Empirical Analysis of VLM-based OOD Detection: Mechanisms, Advantages, and Sensitivity"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T06:11:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:01:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs), such as CLIP, have demonstrated remarkable zero-shot out-of-distribution (OOD) detection capabilities, vital for reliable AI systems. Despite this promising capability, a comprehensive understanding of (1) why they work so effectively, (2) what advantages do they have over single-modal methods, and (3) how is their behavioral robustness -- remains notably incomplete within the research community. This paper presents a systematic empirical analysis of VLM-based OOD detection using in-distribution (ID) and OOD prompts. (1) Mechanisms: We systematically characterize and formalize key operational properties within the VLM embedding space that facilitate zero-shot OOD detection. (2) Advantages: We empirically quantify the superiority of these models over established single-modal approaches, attributing this distinct advantage to the VLM's capacity to leverage rich semantic novelty. (3) Sensitivity: We uncovers a significant and previously under-explored asymmetry in their robustness profile: while exhibiting resilience to common image noise, these VLM-based methods are highly sensitive to prompt phrasing. Our findings contribute a more structured understanding of the strengths and critical vulnerabilities inherent in VLM-based OOD detection, offering crucial, empirically-grounded guidance for developing more robust and reliable future designs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13375","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:34:20Z","registered":"2025-09-18T17:34:21Z","published":null,"updated":"2025-09-18T17:34:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":40,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=id%3A%28%2210.48550%2Farxiv.2509.12888%22+OR+%2210.48550%2Farxiv.2509.12892%22+OR+%2210.48550%2Farxiv.2509.12897%22+OR+%2210.48550%2Farxiv.2509.12908%22+OR+%2210.48550%2Farxiv.2509.12917%22+OR+%2210.48550%2Farxiv.2509.12927%22+OR+%2210.48550%2Farxiv.2509.12936%22+OR+%2210.48550%2Farxiv.2509.12937%22+OR+%2210.48550%2Farxiv.2509.12938%22+OR+%2210.48550%2Farxiv.2509.12961%22+OR+%2210.48550%2Farxiv.2509.12987%22+OR+%2210.48550%2Farxiv.2509.12991%22+OR+%2210.48550%2Farxiv.2509.12993%22+OR+%2210.48550%2Farxiv.2509.12994%22+OR+%2210.48550%2Farxiv.2509.12995%22+OR+%2210.48550%2Farxiv.2509.13007%22+OR+%2210.48550%2Farxiv.2509.13011%22+OR+%2210.48550%2Farxiv.2509.13021%22+OR+%2210.48550%2Farxiv.2509.13031%22+OR+%2210.48550%2Farxiv.2509.13067%22+OR+%2210.48550%2Farxiv.2509.13081%22+OR+%2210.48550%2Farxiv.2509.13095%22+OR+%2210.48550%2Farxiv.2509.13127%22+OR+%2210.48550%2Farxiv.2509.13149%22+OR+%2210.48550%2Farxiv.2509.13154%22+OR+%2210.48550%2Farxiv.2509.13160%22+OR+%2210.48550%2Farxiv.2509.13164%22+OR+%2210.48550%2Farxiv.2509.13175%22+OR+%2210.48550%2Farxiv.2509.13179%22+OR+%2210.48550%2Farxiv.2509.13181%22+OR+%2210.48550%2Farxiv.2509.13232%22+OR+%2210.48550%2Farxiv.2509.13305%22+OR+%2210.48550%2Farxiv.2509.13309%22+OR+%2210.48550%2Farxiv.2509.13310%22+OR+%2210.48550%2Farxiv.2509.13311%22+OR+%2210.48550%2Farxiv.2509.13312%22+OR+%2210.48550%2Farxiv.2509.13313%22+OR+%2210.48550%2Farxiv.2509.13317%22+OR+%2210.48550%2Farxiv.2509.13368%22+OR+%2210.48550%2Farxiv.2509.13375%22%29\u0026page%5Bsize%5D=1000\u0026sort=name"}}