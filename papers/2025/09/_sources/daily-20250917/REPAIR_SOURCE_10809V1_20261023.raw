<th id="A4.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">KL <math id="A4.T3.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<th id="A4.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">MaxSkew <math id="A4.T3.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
