<th id="A4.T3.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">0.293723</th>
<th id="A4.T3.2.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">0.754743</th></tr>
