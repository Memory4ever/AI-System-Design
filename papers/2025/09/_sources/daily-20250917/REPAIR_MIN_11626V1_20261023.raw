<span id="Sx4.T2.1.8.14.1.1" class="ltx_p">92.0</span>
</span></td>
<td id="Sx4.T2.1.8.15" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="Sx4.T2.1.8.15.1" class="ltx_inline-block ltx_align_top" style="width:12.8pt;">
<span id="Sx4.T2.1.8.15.1.1" class="ltx_p">15.1</span>
</span></td>
<td id="Sx4.T2.1.8.16" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="Sx4.T2.1.8.16.1" class="ltx_inline-block ltx_align_top" style="width:14.2pt;">
<span id="Sx4.T2.1.8.16.1.1" class="ltx_p">1.3</span>
</span></td>
<td id="Sx4.T2.1.8.17" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="Sx4.T2.1.8.17.1" class="ltx_inline-block ltx_align_top" style="width:14.2pt;">
