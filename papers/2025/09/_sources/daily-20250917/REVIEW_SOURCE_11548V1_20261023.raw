<td id="S3.T1.5.1.33.6" class="ltx_td ltx_align_left"><math id="S3.T1.m106" class="ltx_Math" style="--ltx-bg-color:#F2F2F2;" alttext="13.00" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2" mathsize="0.900em">13.00</mn><annotation encoding="application/x-tex">13.00</annotation></semantics></math></td>
