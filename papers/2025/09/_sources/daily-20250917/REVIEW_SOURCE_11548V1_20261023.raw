<span id="S3.T1.5.1.2.4.2.1.1.2" class="ltx_tr">
<span id="S3.T1.5.1.2.4.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.5.1.2.4.2.1.1.2.1.1" class="ltx_text ltx_font_bold">3.5-Sonnet</span></span></span>
</span></span><span id="S3.T1.5.1.2.4.2.2" class="ltx_text"></span></span></td>
<td id="S3.T1.5.1.2.5" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T1.5.1.2.5.1" class="ltx_text"></span><span id="S3.T1.5.1.2.5.2" class="ltx_text" style="font-size:90%;"> <span id="S3.T1.5.1.2.5.2.1" class="ltx_text">
<span id="S3.T1.5.1.2.5.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S3.T1.5.1.2.5.2.1.1.1" class="ltx_tr">
<span id="S3.T1.5.1.2.5.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.5.1.2.5.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Qwen2-</span></span></span>
<span id="S3.T1.5.1.2.5.2.1.1.2" class="ltx_tr">
<span id="S3.T1.5.1.2.5.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.5.1.2.5.2.1.1.2.1.1" class="ltx_text ltx_font_bold">VL-7B</span></span></span>
</span></span><span id="S3.T1.5.1.2.5.2.2" class="ltx_text"></span></span></td>
<td id="S3.T1.5.1.2.6" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T1.5.1.2.6.1" class="ltx_text"></span><span id="S3.T1.5.1.2.6.2" class="ltx_text" style="font-size:90%;"> <span id="S3.T1.5.1.2.6.2.1" class="ltx_text">
