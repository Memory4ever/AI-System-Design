<th id="A2.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A2.T3.m5" class="ltx_Math" alttext="k{=}3" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">k{=}3</annotation></semantics></math></th>
<td id="A2.T3.2.3.2" class="ltx_td ltx_align_center">23.98</td>
<td id="A2.T3.2.3.3" class="ltx_td ltx_align_center">24.39</td>
