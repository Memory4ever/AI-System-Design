<th id="A2.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A2.T3.m1" class="ltx_Math" alttext="\varepsilon{=}1" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\varepsilon{=}1</annotation></semantics></math></th>
<th id="A2.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A2.T3.m2" class="ltx_Math" alttext="\varepsilon{=}3" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\varepsilon{=}3</annotation></semantics></math></th>
<th id="A2.T3.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A2.T3.m3" class="ltx_Math" alttext="\varepsilon{=}8" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">\varepsilon{=}8</annotation></semantics></math></th></tr>
