<span id="S4.T3.2.1.1.4.1.1.1" class="ltx_p ltx_align_center">LLaVA</span>
<span id="S4.T3.2.1.1.4.1.1.2" class="ltx_p ltx_align_center">BENCH</span>
</span></span></th></tr>
<tr id="S4.T3.2.1.2" class="ltx_tr">
<th id="S4.T3.2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">C-s <math id="S4.T3.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<th id="S4.T3.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">C-i <math id="S4.T3.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T3.2.1.3" class="ltx_tr">
<th id="S4.T3.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">LLaVA-v1.6-7B</th>
<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">38.1</td>
<td id="S4.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">8.8</td>
<td id="S4.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">42.5</td>
<td id="S4.T3.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">75.6</td></tr>
<tr id="S4.T3.2.1.4" class="ltx_tr">
<th id="S4.T3.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.3pt;padding-right:2.3pt;">+ APASI-Base</th>
<td id="S4.T3.2.1.4.2" class="ltx_td ltx_align_center" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S4.T3.2.1.4.2.1" class="ltx_text ltx_font_bold">28.8</span></td>
<td id="S4.T3.2.1.4.3" class="ltx_td ltx_align_center" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S4.T3.2.1.4.3.1" class="ltx_text ltx_font_bold">7.2</span></td>
<td id="S4.T3.2.1.4.4" class="ltx_td ltx_align_center" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S4.T3.2.1.4.4.1" class="ltx_text ltx_font_bold">44.2</span></td>
<td id="S4.T3.2.1.4.5" class="ltx_td ltx_align_center" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S4.T3.2.1.4.5.1" class="ltx_text ltx_font_bold">80.4</span></td></tr>
<tr id="S4.T3.2.1.5" class="ltx_tr">
<th id="S4.T3.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">Qwen2-VL-7B</th>
<td id="S4.T3.2.1.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">44.4</td>
<td id="S4.T3.2.1.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">9.5</td>
<td id="S4.T3.2.1.5.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">62.0</td>
<td id="S4.T3.2.1.5.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.3pt;padding-right:2.3pt;">92.3</td></tr>
<tr id="S4.T3.2.1.6" class="ltx_tr">
<th id="S4.T3.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:2.3pt;padding-right:2.3pt;">+ APASI-Base</th>
<td id="S4.T3.2.1.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S4.T3.2.1.6.2.1" class="ltx_text ltx_font_bold">23.8</span></td>
<td id="S4.T3.2.1.6.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.3pt;padding-right:2.3pt;"><span id="S4.T3.2.1.6.3.1" class="ltx_text ltx_font_bold">6.2</span></td>
