r.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"Image\"]\n26:I[366829,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/2hwbhylgw726z.js\",\"/_next/static/chunks/3p5jmm60ya981.js\",\"/_next/static/chunks/2jb2vo5bbt4aq.js\",\"/_next/static/chunks/3uj_4q3griim_.js\",\"/_next/static/chunks/1nhl105b9imrb.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"default\"]\n29:I[645533,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/2hwbhylgw726z.js\",\"/_next/static/chunks/3p5jmm60ya981.js\",\"/_next/static/chunks/2jb2vo5bbt4aq.js\",\"/_next/static/chunks/3uj_4q3griim_.js\",\"/_next/static/chunks/1nhl105b9imrb.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"IconX\"]\n2a:I[645533,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/2hwbhylgw726z.js\",\"/_next/static/chunks/3p5jmm60ya981.js\",\"/_next/static/chunks/2jb2vo5bbt4aq.js\",\"/_next/static/chunks/3uj_4q3griim_.js\",\"/_next/static/chunks/1nhl105b9imrb.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"IconLinkedIn\"]\n2b:I[474716,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/2hwbhylgw726z.js\",\"/_next/static/chunks/3p5jmm60ya981.js\",\"/_next/static/chunks/2jb2vo5bbt4aq.js\",\"/_next/static/chunks/3uj_4q3griim_.js\",\"/_next/static/chunks/1nhl105b9imrb.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"default\"]\n2c:I[645533,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/2hwbhylgw726z.js\",\"/_next/static/chunks/3p5jmm60ya981.js\",\"/_next/static/chunks/2jb2vo5bbt4aq.js\",\"/_next/static/chunks/3uj_4q3griim_.js\",\"/_next/static/chunks/1nhl105b9imrb.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"IconArrowRight\"]\n2d:I[645533,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/2hwbhylgw726z.js\",\"/_next/static/chunks/3p5jmm60ya981.js\",\"/_next/static/chunks/2jb2vo5bbt4aq.js\",\"/_next/static/chunks/3uj_4q3griim_.js\",\"/_next/static/chunks/1nhl105b9imrb.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"IconLogoMark\"]\n19:[\"$\",\"span\",\"0\",{\"children\":\"Economics\"}]\n1a:[\"$\",\"h1\",null,{\"className\":\"headline-1 PostDetail-module-scss-module__UQuRMa__title\",\"children\":\"Anthropic Economic Index report: Uneven geographic and enterprise AI adoption\"}]\n1b:[\"$\",\"div\",null,{\"className\":\"body-3 agate\",\"children\":[\"$\",\"time\",null,{\"dateTime\":\"2025-09-15T20:33:00.000Z\",\"children\":\"Sep 15, 2025\"}]}]\n1c:[\"$\",\"div\",null,{\"data-theme\":\"ivory\",\"children\":[\"$\",\"$L24\",null,{\"ctaPosition\":\"hero\",\"link\":{\"_type\":\"link\",\"fileAsset\":null,\"modalId\":null,\"page\":null,\"text\":\"Download PDF\",\"url\":\"https://assets.anthropic.com/m/218c82b858610fac/original/Economic-Index.pdf\"}}]}]\n1d:[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__illustrationHeroWrapper\",\"children\":[\"$\",\"div\",null,{\"className\":\"Illustration-module-scss-module__WyGOtq__root Illustration-module-scss-module__WyGOtq__aspect-wide Illustration-module-scss-module__WyGOtq__padding-lg Illustration-module-scss-module__WyGOtq__radius-lg bg-cactus\",\"children\":[\"$\",\"div\",null,{\"className\":\"Illustration-module-scss-module__WyGOtq__inner\",\"children\":[\"$\",\"$L25\",null,{\"src\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/1576ae23eaf481f33bd36ab468171cc69d12361a-1000x1000.svg\",\"alt\":\"Anthropic Economic Index report: Uneven geographic and enterprise AI adoption\",\"width\":1000,\"height\":1000,\"className\":\"\"}]}]}]}]\n27:T432,9. To isolate the relationship between automation preference and Claude usage accounting for task composition differences, we do the following: First, we calculate each country’s expected automation percentage by taking a weighted average. For each O*NET task (e.g., coding, writing, or analysis), we multiply that task's share of the country's usage by the global automation rate for that task type (the percentage of that task that Claude completes via directive/feedback loop patterns globally). Summing these gives us the expected values for each country's automation percentage given the country’s specific task mix. We then regress both the actual automation % and AUI on this expected automation %. The residuals from these regressions represent the variation in each variable that cannot be explained by task composition. By examining the relationship between these residuals (known as partial regression analysis), we can determine whether countries that have higher AI usage than their task mix would predict tend also to have higher-than-predicted automation.28:[]\n1e:[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[\"$\",\"$L26\",null,{\"body\":[{\"_key\":\"9c0240e860a6\",\"_type\":\"block\",\"children\":[{\"_key\":\"8c049b686cd60\",\"_type\":\"span\",\"marks\":[],\"text\":\"Introduction\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"fa72bc13616e\",\"_type\":\"block\",\"children\":[{\"_key\":\"6a0e365166590\",\"_type\":\"span\",\"marks\":[],\"text\":\"AI differs from prior technologies in its unprecedented adoption speed. In the US alone, 40% of employees report using AI at work, up from 20% in 2023 two years ago.\"},{\"_key\":\"47251a6fcdbd\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"1\"},{\"_key\":\"8e0d29e0a805\",\"_type\":\"span\",\"marks\":[],\"text\":\" Such rapid adoption reflects how useful this technology already is for a wide range of applications, its deployability on existing digital infrastructure, and its ease of use—by just typing or speaking—without specialized training. Rapid improvement of frontier AI likely reinforces fast adoption along each of these dimensions.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9a0b187c3d42\",\"_type\":\"block\",\"children\":[{\"_key\":\"6771c23951f80\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"163883611af0\",\"_type\":\"block\",\"children\":[{\"_key\":\"4629f61ff6d10\",\"_type\":\"span\",\"marks\":[],\"text\":\"Historically, new technologies took decades to reach widespread adoption. Electricity took over 30 years to reach farm households after urban electrification. The first mass-market personal computer reached early adopters in 1981, but did not reach the majority of homes in the US for another 20 years. Even the rapidly-adopted internet took around five years to hit adoption rates that AI reached in just two years.\"},{\"_key\":\"6c342942f3f0\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"2\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f57a500abd8d\",\"_type\":\"block\",\"children\":[{\"_key\":\"ffa3cdaf652b\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d170a36ff838\",\"_type\":\"block\",\"children\":[{\"_key\":\"1d162e630a170\",\"_type\":\"span\",\"marks\":[],\"text\":\"Why is this? In short, it takes time for new technologies—even transformative ones—to diffuse throughout the economy, for consumer adoption to become less geographically concentrated, and for firms to restructure business operations to best unlock new technical capabilities. Firm adoption, first for a narrow set of tasks, then for more general purpose applications, is an important way that consequential technologies spread and have transformative economic effects.\"},{\"_key\":\"4550f26de145\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"3\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bd53402600a8\",\"_type\":\"block\",\"children\":[{\"_key\":\"2c53cb575fe60\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5ea2e2e1316f\",\"_type\":\"block\",\"children\":[{\"_key\":\"85aaa790cd940\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"In other words, a hallmark of early technological adoption is that it is \"},{\"_key\":\"85aaa790cd941\",\"_type\":\"span\",\"marks\":[\"strong\",\"em\"],\"text\":\"concentrated\"},{\"_key\":\"85aaa790cd942\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"—in both a small number of geographic regions and a small number of tasks in firms. \"},{\"_key\":\"85aaa790cd943\",\"_type\":\"span\",\"marks\":[],\"text\":\"As we document in this report, AI adoption appears to be following a similar pattern in the 21st century, albeit on shorter timelines and with greater intensity than the diffusion of technologies in the 20th century.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"31bad7617e46\",\"_type\":\"block\",\"children\":[{\"_key\":\"8440c53f2a7f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1fb4d1c67db7\",\"_type\":\"block\",\"children\":[{\"_key\":\"41c2613c5f180\",\"_type\":\"span\",\"marks\":[],\"text\":\"To study such patterns of early AI adoption, we extend the \"},{\"_key\":\"41c2613c5f181\",\"_type\":\"span\",\"marks\":[\"dc48906f7772\"],\"text\":\"Anthropic Economic Index\"},{\"_key\":\"41c2613c5f182\",\"_type\":\"span\",\"marks\":[],\"text\":\" along two important dimensions, introducing a geographic analysis of Claude.ai conversations and a first-of-its-kind examination of enterprise API use. We show how Claude usage has evolved over time, how adoption patterns differ across regions, and—for the first time—how firms are deploying frontier AI to solve business problems.\"}],\"markDefs\":[{\"_key\":\"dc48906f7772\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/economic-index\"}],\"style\":\"normal\"},{\"_key\":\"019d4954926d\",\"_type\":\"block\",\"children\":[{\"_key\":\"4bf23fb2b27b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Changing patterns of usage on Claude.ai over time\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"19916789fd42\",\"_type\":\"block\",\"children\":[{\"_key\":\"ec38bf70c5e00\",\"_type\":\"span\",\"marks\":[],\"text\":\"In the first chapter of this report, we identify notable changes in usage on Claude.ai over the previous eight months, occurring alongside improvements in underlying model capabilities, new product features, and a broadening of the Claude consumer base.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3ac3150b7ee7\",\"_type\":\"block\",\"children\":[{\"_key\":\"f00d3eea26520\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"424621cefcde\",\"_type\":\"block\",\"children\":[{\"_key\":\"1b094640256e0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"We find:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1a678305a0c9\",\"_type\":\"block\",\"children\":[{\"_key\":\"cfab834e84450\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Education and science usage shares are on the rise: \"},{\"_key\":\"cfab834e84451\",\"_type\":\"span\",\"marks\":[],\"text\":\"While the use of Claude for coding continues to dominate our total sample at 36%, educational tasks surged from 9.3% to 12.4%, and scientific tasks from 6.3% to 7.2%.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"52f2525ecb7c\",\"_type\":\"block\",\"children\":[{\"_key\":\"13dffb61533b0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Users are entrusting Claude with more autonomy: \"},{\"_key\":\"df33ee1f1ae9\",\"_type\":\"span\",\"marks\":[],\"text\":\"“Directive” conversations, where users delegate complete tasks to Claude, jumped from 27% to 39%. We see increased program creation in coding (+4.5pp) and a reduction in debugging (-2.9pp)—suggesting that users might be able to achieve more of their goals in a single exchange.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f823062a832b\",\"_type\":\"block\",\"children\":[{\"_key\":\"d39cd55688d40\",\"_type\":\"span\",\"marks\":[],\"text\":\"The geography of AI adoption\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"cfc25187c04f\",\"_type\":\"block\",\"children\":[{\"_key\":\"7668042726ca0\",\"_type\":\"span\",\"marks\":[],\"text\":\"For the first time, we release geographic cuts of Claude.ai usage data across 150+ countries and all U.S. states. To study diffusion patterns, we introduce the Anthropic AI Usage Index (AUI) to measure whether Claude.ai use is over- or underrepresented in an economy relative to its working age population.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b9c55a4013d7\",\"_type\":\"block\",\"children\":[{\"_key\":\"3649f7006ada0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"231457f1b60f\",\"_type\":\"block\",\"children\":[{\"_key\":\"b74f428ecace0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"We find:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"14ea8d49c821\",\"_type\":\"block\",\"children\":[{\"_key\":\"1891973f76f60\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"The AUI strongly correlates with income across countries: \"},{\"_key\":\"1891973f76f61\",\"_type\":\"span\",\"marks\":[],\"text\":\"As with previous technologies, we see that AI usage is geographically concentrated. Singapore and Canada are among the highest countries in terms of usage per capita at 4.6x and 2.9x what would be expected based on their population, respectively. In contrast, emerging economies, including Indonesia at 0.36x, India at 0.27x and Nigeria at 0.2x, use Claude less.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1e660b1d4ae8\",\"_type\":\"block\",\"children\":[{\"_key\":\"3fd0ef6ecedf0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"In the U.S., local economy factors shape patterns of use: \"},{\"_key\":\"3fd0ef6ecedf1\",\"_type\":\"span\",\"marks\":[],\"text\":\"DC leads per-capita usage (3.82x population share), but Utah is close behind (3.78x). We see evidence that regional usage patterns reflect distinctive features of the local economy: For example, elevated use for IT in California, for financial services in Florida, and for document editing and career assistance in DC.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5ea50c67342b\",\"_type\":\"block\",\"children\":[{\"_key\":\"44f7cf0393380\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Leading countries have more diverse usage: \"},{\"_key\":\"44f7cf0393381\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lower-adoption countries tend to see more coding usage, while high-adoption regions show diverse applications across education, science, and business. For example, coding tasks are over half of all usage in India versus roughly a third of all usage globally.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"71a1f644dd40\",\"_type\":\"block\",\"children\":[{\"_key\":\"9323f885eb1a0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"High-adoption countries show less automated, more augmented use: \"},{\"_key\":\"9323f885eb1a1\",\"_type\":\"span\",\"marks\":[],\"text\":\"After controlling for task mix by country, low AUI countries are more likely to delegate complete tasks (automation), while high-adoption areas tend toward greater learning and human-AI iteration (augmentation).\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9f1a0691a7ad\",\"_type\":\"block\",\"children\":[{\"_key\":\"ccb94ec98d9a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"df14b35d47ce\",\"_type\":\"block\",\"children\":[{\"_key\":\"c7d895f7c5d80\",\"_type\":\"span\",\"marks\":[],\"text\":\"The uneven geography of early AI adoption raises important questions about economic convergence. Transformative technologies of the late 19th century and the early 20th centuries—widespread electrification, the internal combustion engine, indoor plumbing—not only ushered in the era of modern economic growth but accompanied a large divergence in living standards around the world.\"},{\"_key\":\"b76bf84c4cff\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"4\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1200ab97a0cf\",\"_type\":\"block\",\"children\":[{\"_key\":\"674c1a92ba7a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"74b7350b917c\",\"_type\":\"block\",\"children\":[{\"_key\":\"f956bed59d840\",\"_type\":\"span\",\"marks\":[],\"text\":\"If the productivity gains are larger for high-adoption economies, current usage patterns suggest that the benefits of AI may concentrate in already-rich regions—possibly increasing global economic inequality and reversing growth convergence seen in recent decades.\"},{\"_key\":\"26580c54f92b\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"5\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3f811a811a98\",\"_type\":\"block\",\"children\":[{\"_key\":\"7a76f8ae1d820\",\"_type\":\"span\",\"marks\":[],\"text\":\"Systematic enterprise deployment of AI\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"d49c7ad9145e\",\"_type\":\"block\",\"children\":[{\"_key\":\"2d4b996cf79c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"In the final chapter, we present first-of-its-kind insight on a large fraction of our first-party (1P) API traffic, revealing the tasks companies and developers are using Claude to accomplish. Importantly, API users access Claude programmatically, rather than through a web user interface (as with Claude.ai). This shows how early-adopting businesses are deploying frontier AI capabilities.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2c4a236f8b15\",\"_type\":\"block\",\"children\":[{\"_key\":\"87db6d1c2d730\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"807ec50e7910\",\"_type\":\"block\",\"children\":[{\"_key\":\"76da64b131d20\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"We find:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"304b63603c09\",\"_type\":\"block\",\"children\":[{\"_key\":\"28a491da073e0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"1P API usage, while similar to Claude.ai use, differs in specialized ways: \"},{\"_key\":\"28a491da073e1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Both 1P API usage and Claude.ai usage focus heavily on coding tasks. However, 1P API usage is higher for coding and office/admin tasks, while Claude.ai usage is higher for educational and writing tasks. \"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5acb0c631ed2\",\"_type\":\"block\",\"children\":[{\"_key\":\"2aa183b1ec1c0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"1P API usage is automation dominant: \"},{\"_key\":\"2aa183b1ec1c1\",\"_type\":\"span\",\"marks\":[],\"text\":\"77% of business uses involve automation usage patterns, compared to about 50% for Claude.ai users. This reflects the programmatic nature of API usage. \"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"486b9d712a94\",\"_type\":\"block\",\"children\":[{\"_key\":\"85d319fd8dad0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Capabilities seem to matter more than cost in shaping business deployment: \"},{\"_key\":\"85d319fd8dad1\",\"_type\":\"span\",\"marks\":[],\"text\":\"The most-used tasks in our API data tend to cost more than the less frequent ones. Overall, we find evidence of weak price sensitivity. Model capabilities and the economic value of feasibly automating a given task appears to play a larger role in shaping businesses’ usage patterns.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"74becfb7de47\",\"_type\":\"block\",\"children\":[{\"_key\":\"f785bf8f4b160\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Context constrains sophisticated use: \"},{\"_key\":\"f785bf8f4b161\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our analysis suggests that curating the right context for models will be important for high-impact deployments of AI in complex domains. This implies that for some firms costly data modernization and organizational investments to elicit contextual information may be a bottleneck for AI adoption.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6274b95163d9\",\"_type\":\"block\",\"children\":[{\"_key\":\"96aae6a256e30\",\"_type\":\"span\",\"marks\":[],\"text\":\"Open source data to catalyze independent research\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"7c2de18b11af\",\"_type\":\"block\",\"children\":[{\"_key\":\"6304174d02d50\",\"_type\":\"span\",\"marks\":[],\"text\":\"As with previous reports, we have open-sourced the underlying data to support independent research on the economic effects of AI. This comprehensive dataset includes task-level usage patterns for both Claude.ai and 1P API traffic (mapped to the O*NET taxonomy as well as bottom-up categories), collaboration mode breakdowns by task, and detailed documentation of our methodology. At present, geographic usage patterns are only available for Claude.ai traffic.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cab6e1fc3c02\",\"_type\":\"block\",\"children\":[{\"_key\":\"55cadd5d91520\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f03b4c9af537\",\"_type\":\"block\",\"children\":[{\"_key\":\"0b939b8d20010\",\"_type\":\"span\",\"marks\":[],\"text\":\"Key questions we hope this data will help others to investigate include:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8737df496322\",\"_type\":\"block\",\"children\":[{\"_key\":\"2a7e55a5ae1d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"What are the local labor market consequences for workers and firms of AI usage \u0026 adoption?\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ff738980b853\",\"_type\":\"block\",\"children\":[{\"_key\":\"8ec91ecd013a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"What determines AI adoption across countries and within the US? What can be done to ensure that the benefits of AI do not only accrue to already-rich economies?\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8b940025fc33\",\"_type\":\"block\",\"children\":[{\"_key\":\"aafb2ab110680\",\"_type\":\"span\",\"marks\":[],\"text\":\"What role, if any, does cost-per-task play in shaping enterprise deployment patterns?\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"18b7d7a711ab\",\"_type\":\"block\",\"children\":[{\"_key\":\"cfe02eb45b810\",\"_type\":\"span\",\"marks\":[],\"text\":\"Why are firms able to automate some tasks and not others? What implications does this have for which types of workers will experience better or worse employment prospects?\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d7ee9af48221\",\"_type\":\"block\",\"children\":[{\"_key\":\"9cfd3e57abb5\",\"_type\":\"span\",\"marks\":[],\"text\":\"1. Gallup 2025, \"},{\"_key\":\"4bec9e9a98c0\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"AI Use at Work Has Nearly Doubled in Two Years.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"e7754c9bf5ca\",\"_type\":\"block\",\"children\":[{\"_key\":\"542e323286990\",\"_type\":\"span\",\"marks\":[],\"text\":\"2. Bick, Blandin, Deming, 2024 \"},{\"_key\":\"542e323286991\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"The Rapid Adoption of Generative AI\"},{\"_key\":\"542e323286992\",\"_type\":\"span\",\"marks\":[],\"text\":\" benchmark AI adoption against adoption of PC and the internet; Lewis \u0026 Severnini, 2020 \"},{\"_key\":\"542e323286993\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Short- and long-run impacts of rural electrification: Evidence from the historical rollout of the U.S. power grid\"},{\"_key\":\"542e323286994\",\"_type\":\"span\",\"marks\":[],\"text\":\" analyze the impact of bringing electricity to rural areas on economic outcomes.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"9ff1fa705c35\",\"_type\":\"block\",\"children\":[{\"_key\":\"624d47df9ee2\",\"_type\":\"span\",\"marks\":[],\"text\":\"3. Kalyani, Bloom, Carvalho, Hassan, Lerner and Ahmed Tahoun 2025 \"},{\"_key\":\"81129c136124\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Diffusion of New Technologies.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"52102da34d6c\",\"_type\":\"block\",\"children\":[{\"_key\":\"afd25fdc3bff\",\"_type\":\"span\",\"marks\":[],\"text\":\"4. See Gordon, 2012 \"},{\"_key\":\"2d5f78b0f558\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Is U.S. Economic Growth Over? Faltering Innovation Confronts the Six Headwinds\"},{\"_key\":\"f1b6c98e52eb\",\"_type\":\"span\",\"marks\":[],\"text\":\" for a comparison of early and late 20th century innovations and their impact on productivity. Pritchett, 1997. \"},{\"_key\":\"efe0f4adb701\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Divergence, Big Time \"},{\"_key\":\"d5fd56d84f72\",\"_type\":\"span\",\"marks\":[],\"text\":\"documents economic divergence that accompanied transition to era of modern economic growth.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"8e73a441207d\",\"_type\":\"block\",\"children\":[{\"_key\":\"0686c3a050ad0\",\"_type\":\"span\",\"marks\":[],\"text\":\"5. Kremer, Willis, You, 2022 \"},{\"_key\":\"0686c3a050ad1\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Converging to Convergence \"},{\"_key\":\"0686c3a050ad2\",\"_type\":\"span\",\"marks\":[],\"text\":\"present evidence of growth convergence in recent decades. See Jones, Jones, and Aghion, 2017 \"},{\"_key\":\"0686c3a050ad3\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Artificial Intelligence and Economic Growth\"},{\"_key\":\"0686c3a050ad4\",\"_type\":\"span\",\"marks\":[],\"text\":\" for discussion of growth implications AI-powered automation of innovation.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"00f0fedee149\",\"_type\":\"block\",\"children\":[{\"_key\":\"38bd7ee1659a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a28436d89f50\",\"_type\":\"block\",\"children\":[{\"_key\":\"189715b4649e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2549a9d02f80\",\"_type\":\"block\",\"children\":[{\"_key\":\"195a7d52748a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Chapter 1: Claude.ai usage over time\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"648a794c5679\",\"_type\":\"block\",\"children\":[{\"_key\":\"9c9ecf7e957d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Overview\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"517d5fa82350\",\"_type\":\"block\",\"children\":[{\"_key\":\"1bbfa267cc300\",\"_type\":\"span\",\"marks\":[],\"text\":\"Understanding how AI adoption evolves over time can help predict its economic impacts—from productivity gains to workforce changes. With data spanning from  December 2024 and January 2025 (from our first report, ‘V1’) to February and March 2025 (‘V2’) to our newest insights from August 2025 (‘V3’), we can track how AI usage has shifted over the past eight months as capabilities and product features have improved, new kinds of users have adopted the technology, and uses have become more sophisticated. We view the evidence presented below as suggesting that new product features have enabled new forms of work rather than simply accelerating adoption for existing tasks.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"97909ee8a752\",\"_type\":\"block\",\"children\":[{\"_key\":\"878ebf981bdd0\",\"_type\":\"span\",\"marks\":[],\"text\":\"How Claude.ai usage for economic tasks has changed\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"df04077eff4b\",\"_type\":\"block\",\"children\":[{\"_key\":\"d2bb2b326306\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"43f920c2b6e1\",\"_type\":\"block\",\"children\":[{\"_key\":\"77531d2993cf0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Educational and scientific tasks continue their rise in relative importance\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"1724af8913b1\",\"_type\":\"block\",\"children\":[{\"_key\":\"bd09f95aa3840\",\"_type\":\"span\",\"marks\":[],\"text\":\"While computer and mathematical tasks still dominate overall usage at 36%, we are seeing sustained growth in knowledge-intensive fields. Educational Instruction and Library tasks rose from 9% in V1 to 12% in V3. Life, Physical, and Social Science tasks increased from 6% to 7%. Meanwhile, the \"},{\"_key\":\"bd09f95aa3841\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"relative\"},{\"_key\":\"bd09f95aa3842\",\"_type\":\"span\",\"marks\":[],\"text\":\" share of Business and Financial Operations tasks fell from 6% to 3%, and Management dropped from 5% to 3%.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e195d2da7f88\",\"_type\":\"block\",\"children\":[{\"_key\":\"f0dca93e597a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"This divergence suggests AI usage may be diffusing especially quickly among tasks involving knowledge synthesis and explanation, compared to traditional business operations—possibly because these tasks benefit more from Claude's reasoning capabilities.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"34de1358ff9e\",\"_type\":\"block\",\"children\":[{\"_key\":\"c5332f50b913\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"46ec50d41842\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-09c42417533614699b30cdfbd770a2f044cb6ce2-2965x2092-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"3ae7d6efa82e\",\"_type\":\"block\",\"children\":[{\"_key\":\"be8fb3dd6b390\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 1.1: Claude.ai usage over time. \"},{\"_key\":\"be8fb3dd6b391\",\"_type\":\"span\",\"marks\":[],\"text\":\"Each panel shows the share of sampled conversations on Claude.ai associated with tasks from each SOC major group. We see notable increases in usage for scientific and educational tasks. SOC major groups ranked by usage in our first report.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c1a807cdbdbc\",\"_type\":\"block\",\"children\":[{\"_key\":\"1590c3a5b097\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 1.1: Claude.ai usage over time. Each panel shows the share of sampled conversations on Claude.ai associated with tasks from each SOC major group. We see notable increases in usage for scientific and educational tasks. SOC major groups ranked by usage in our first report.\",\"height\":2092,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/09c42417533614699b30cdfbd770a2f044cb6ce2-2965x2092.png\",\"width\":2965},{\"_key\":\"9654df11fb59\",\"_type\":\"block\",\"children\":[{\"_key\":\"be14b89564320\",\"_type\":\"span\",\"marks\":[],\"text\":\"New capabilities are shaping usage patterns\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"1ca69b8efd0c\",\"_type\":\"block\",\"children\":[{\"_key\":\"0509e72e2b670\",\"_type\":\"span\",\"marks\":[],\"text\":\"At a more granular level, we document changes in task composition that appear linked to features launched between V2 and V3. For example, searching electronic sources and databases grew substantially (0.03% → 0.49%), likely reflecting our \"},{\"_key\":\"0509e72e2b671\",\"_type\":\"span\",\"marks\":[\"b188ad342571\"],\"text\":\"web search release\"},{\"_key\":\"0509e72e2b672\",\"_type\":\"span\",\"marks\":[],\"text\":\" in March. In addition, we also see a rise in internet-based research tasks (0.003% → 0.27%), which aligns with the \"},{\"_key\":\"0509e72e2b673\",\"_type\":\"span\",\"marks\":[\"aeee96d4297e\"],\"text\":\"Research\"},{\"_key\":\"0509e72e2b674\",\"_type\":\"span\",\"marks\":[],\"text\":\" mode we released in April.\"},{\"_key\":\"a474f620132c\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"1\"}],\"markDefs\":[{\"_key\":\"b188ad342571\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/web-search\"},{\"_key\":\"aeee96d4297e\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/research\"}],\"style\":\"normal\"},{\"_key\":\"9dca336e14d1\",\"_type\":\"block\",\"children\":[{\"_key\":\"3a28633b78cb0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"814fc9e91405\",\"_type\":\"block\",\"children\":[{\"_key\":\"0226b2d606d00\",\"_type\":\"span\",\"marks\":[],\"text\":\"We also see other kinds of changes. Tasks relating to developing instructional materials increased by 1.3pp, growing from a base of 0.2% to 1.5%—a more than 6-fold increase that may reflect growing \"},{\"_key\":\"0226b2d606d01\",\"_type\":\"span\",\"marks\":[\"d1ec6c9e174f\"],\"text\":\"adoption among educators\"},{\"_key\":\"0226b2d606d02\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"},{\"_key\":\"9e484f2685d6\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"2\"},{\"_key\":\"60575d4126c0\",\"_type\":\"span\",\"marks\":[],\"text\":\" Creating multimedia documents rose 0.4pp, nearly tripling from 0.16% to 0.55%, potentially driven by continued use of our \"},{\"_key\":\"0226b2d606d03\",\"_type\":\"span\",\"marks\":[\"f2cc754be80d\"],\"text\":\"Artifacts feature\"},{\"_key\":\"0226b2d606d04\",\"_type\":\"span\",\"marks\":[],\"text\":\" for building traditional and AI-powered apps within Claude.ai.\"}],\"markDefs\":[{\"_key\":\"d1ec6c9e174f\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/anthropic-education-report-how-educators-use-claude\"},{\"_key\":\"f2cc754be80d\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/news/build-artifacts\"}],\"style\":\"normal\"},{\"_key\":\"0311afc39d65\",\"_type\":\"block\",\"children\":[{\"_key\":\"72300198549d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f4d008286fab\",\"_type\":\"block\",\"children\":[{\"_key\":\"39f8c1adec7e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Interestingly, the share of tasks involving creating new code more than doubled, increasing by 4.5 percentage points (from 4.1% to 8.6%), while debugging and error correction tasks fell by 2.8 percentage points (from 16.1% to 13.3%)—a net 7.4pp shift toward creation over fixing code. This may suggest that models have become increasingly reliable, such that users spend less time fixing problems and more time creating things in a single interaction.\"},{\"_key\":\"cb4d936ec8ee\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"3\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8b7b6131cf72\",\"_type\":\"block\",\"children\":[{\"_key\":\"1f4002b0d9910\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6e83ac2085c9\",\"_type\":\"block\",\"children\":[{\"_key\":\"1424d19c51350\",\"_type\":\"span\",\"marks\":[],\"text\":\"Directive automation is accelerating\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"66f63f965073\",\"_type\":\"block\",\"children\":[{\"_key\":\"0c2296cf04920\",\"_type\":\"span\",\"marks\":[],\"text\":\"As in previous reports, we also track not just \"},{\"_key\":\"0c2296cf04921\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"what\"},{\"_key\":\"0c2296cf04922\",\"_type\":\"span\",\"marks\":[],\"text\":\" people use Claude for but \"},{\"_key\":\"0c2296cf04923\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"how\"},{\"_key\":\"0c2296cf04924\",\"_type\":\"span\",\"marks\":[],\"text\":\" they collaborate with or delegate to Claude on Claude.ai.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"22c2dec90869\",\"_type\":\"block\",\"children\":[{\"_key\":\"15572cabaae60\",\"_type\":\"span\",\"marks\":[],\"text\":\"At a high level, we distinguish between \"},{\"_key\":\"15572cabaae61\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"automation\"},{\"_key\":\"15572cabaae62\",\"_type\":\"span\",\"marks\":[],\"text\":\" and \"},{\"_key\":\"15572cabaae63\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"augmentation\"},{\"_key\":\"15572cabaae64\",\"_type\":\"span\",\"marks\":[],\"text\":\" modes of using Claude:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ddce6d9ebc90\",\"_type\":\"block\",\"children\":[{\"_key\":\"76900ef8f0240\",\"_type\":\"span\",\"marks\":[\"strong\",\"em\"],\"text\":\"Automation\"},{\"_key\":\"76900ef8f0241\",\"_type\":\"span\",\"marks\":[],\"text\":\" encompasses interaction patterns focused on task completion:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3d53b32785bd\",\"_type\":\"block\",\"children\":[{\"_key\":\"adec206208460\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Directive\"},{\"_key\":\"adec206208461\",\"_type\":\"span\",\"marks\":[],\"text\":\": Users give Claude a task and it completes it with minimal back-and-forth\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"de5ebfa9489f\",\"_type\":\"block\",\"children\":[{\"_key\":\"c75c5a55c83d0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Feedback Loops\"},{\"_key\":\"c75c5a55c83d1\",\"_type\":\"span\",\"marks\":[],\"text\":\": Users automate tasks and provide feedback to Claude as needed\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e17148b6be14\",\"_type\":\"block\",\"children\":[{\"_key\":\"aff0c59e31760\",\"_type\":\"span\",\"marks\":[\"strong\",\"em\"],\"text\":\"Augmentation\"},{\"_key\":\"aff0c59e31761\",\"_type\":\"span\",\"marks\":[],\"text\":\" focuses on collaborative interaction patterns:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d690608c3253\",\"_type\":\"block\",\"children\":[{\"_key\":\"5339db05f2180\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Learning\"},{\"_key\":\"5339db05f2181\",\"_type\":\"span\",\"marks\":[],\"text\":\": Users ask Claude for information or explanations about various topics\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"74f7101116d8\",\"_type\":\"block\",\"children\":[{\"_key\":\"5f8b1a2b99330\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Task Iteration\"},{\"_key\":\"5f8b1a2b99331\",\"_type\":\"span\",\"marks\":[],\"text\":\": Users iterate on tasks collaboratively with Claude\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e2b7fb7584d3\",\"_type\":\"block\",\"children\":[{\"_key\":\"7ff03f4764330\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Validation\"},{\"_key\":\"7ff03f4764331\",\"_type\":\"span\",\"marks\":[],\"text\":\": Users ask Claude for feedback on their work\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8c082a9a430d\",\"_type\":\"block\",\"children\":[{\"_key\":\"212cea2e70600\",\"_type\":\"span\",\"marks\":[],\"text\":\"The share of \"},{\"_key\":\"212cea2e70601\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"directive\"},{\"_key\":\"212cea2e70602\",\"_type\":\"span\",\"marks\":[],\"text\":\" conversations sampled from Claude.ai conversations jumped from 27% in V1 in late 2024 to 39% in V3. This increase came primarily at the expense of \"},{\"_key\":\"212cea2e70603\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"task iteration\"},{\"_key\":\"212cea2e70604\",\"_type\":\"span\",\"marks\":[],\"text\":\" and \"},{\"_key\":\"212cea2e70605\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"learning\"},{\"_key\":\"212cea2e70606\",\"_type\":\"span\",\"marks\":[],\"text\":\" interactions, implying a sizable net increase in the share of conversations exhibiting automative patterns of use – a notable increase in just eight months. This is the first report where automation usage exceeds augmentation usage.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4fd616520071\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-4293d3c60d5b4c1edc6211fbb0a4a24e33d194ae-2200x1236-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"03cadde214ff\",\"_type\":\"block\",\"children\":[{\"_key\":\"1cb5a8e3cbd10\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 1.2: Collaboration mode frequencies across Anthropic Economic Index Reports. \"},{\"_key\":\"1cb5a8e3cbd11\",\"_type\":\"span\",\"marks\":[],\"text\":\"The left panel calculates the share of conversations exhibiting either automation or augmentation forms of use. The right panel breaks this out by collaboration mode. Claude tends to be used in more automated ways over time, driven primarily by an increase in directive use.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4a353930f735\",\"_type\":\"block\",\"children\":[{\"_key\":\"30691b14798a\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 1.2: Collaboration mode frequencies across Anthropic Economic Index Reports. The left panel calculates the share of conversations exhibiting either automation or augmentation forms of use. The right panel breaks this out by collaboration mode. Claude tends to be used in more automated ways over time, driven primarily by an increase in directive use.\",\"height\":1236,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/4293d3c60d5b4c1edc6211fbb0a4a24e33d194ae-2200x1236.png\",\"width\":2200},{\"_key\":\"dbf24732561b\",\"_type\":\"block\",\"children\":[{\"_key\":\"08e9dc0fe6bc0\",\"_type\":\"span\",\"marks\":[],\"text\":\"One interpretation is that this is a result of increasing model capabilities. As models improve at anticipating user needs and producing high-quality outputs on first attempts, users may need fewer follow-up refinements. The jump in directive usage could also signal growing confidence in delegating complete tasks to AI, a form of learning-by-doing.\"},{\"_key\":\"97d0e6569523\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"4\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2c78295378cf\",\"_type\":\"block\",\"children\":[{\"_key\":\"154876616bbd0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Whether the growth in directive usage is attributable to improving model capabilities or learning-by-doing could signal very different labor market implications. If more advanced models simply expand the set of automated tasks, then the risk increases that workers performing such tasks will be displaced. However, if instead the rise in directive use reflects learning-by-doing, then workers most able to adapt to new AI-powered workflows are likely to see greater demand and higher wages. In other words, AI may benefit some workers more than others: it may lead to higher wages for those with the greatest ability to adapt to technological change, even as those with lower ability to adapt face job disruption.\"},{\"_key\":\"70834f1878ec\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"5\"},{\"_key\":\"e5f029cbda86\",\"_type\":\"span\",\"marks\":[],\"text\":\" This will be an important area of inquiry for future research.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e8b4adfe1294\",\"_type\":\"block\",\"children\":[{\"_key\":\"6c6aa89a98000\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"44e25dec3d6e\",\"_type\":\"block\",\"children\":[{\"_key\":\"283546154ce40\",\"_type\":\"span\",\"marks\":[],\"text\":\"Looking ahead\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"8ab96f00ac40\",\"_type\":\"block\",\"children\":[{\"_key\":\"e059bb32dcb70\",\"_type\":\"span\",\"marks\":[],\"text\":\"The V3 data reveals that AI capabilities and adoption are continuing to progress. Knowledge-based tasks, including educational and scientific applications, continue their fast growth rate, and new product features appear to be enabling different types of work rather than just accelerating existing tasks.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f5977f66940f\",\"_type\":\"block\",\"children\":[{\"_key\":\"70b7dcfedd120\",\"_type\":\"span\",\"marks\":[],\"text\":\"Most strikingly, the data point toward increased delegation of tasks to AI systems–perhaps due to some combination of user trust in the technology as well as improvement of underlying model capabilities. This could also be due to changes in the underlying user base. The next chapter of this report for the first time breaks down usage across geography, allowing us to disentangle temporal vs. geographic changes more clearly going forward. We will continue to track these trends closely in future reports.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d028e0990be9\",\"_type\":\"block\",\"children\":[{\"_key\":\"fe81d8e4525f\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8fd5dd557bc2\",\"_type\":\"block\",\"children\":[{\"_key\":\"0021f5123d240\",\"_type\":\"span\",\"marks\":[],\"text\":\"1. “Search electronic sources, such as databases or repositories, or manual sources for information” increased from 0.03% to 0.49%. “Conduct internet-based and library research” increased from 0.003% to 0.27%.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"10807f029274\",\"_type\":\"block\",\"children\":[{\"_key\":\"459d86202f45\",\"_type\":\"span\",\"marks\":[],\"text\":\"2. Statistic computed from tasks containing the string “develop instructional materials”.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"f0af0c7e6c5d\",\"_type\":\"block\",\"children\":[{\"_key\":\"361a736258a90\",\"_type\":\"span\",\"marks\":[],\"text\":\"3. Tasks were collated from the set of tasks whose frequency has changed by a magnitude greater than or equal to 0.2 percentage points. Programming creation tasks include: “write new programs or modify existing programs” (1.5% → 4.9%), “design, build, or maintain web sites” (1.2% → 2.0%), “write, analyze, review, and rewrite programs” (1.2% → 0.5%), “develop new software applications” (0.06% → 0.6%), “develop transactional web applications” (0.1% → 0.3%), and “develop application-specific software” (0.05% → 0.3%). Debugging/error correction tasks include: “modify existing software to correct errors” (two variants: 2.5% → 3.8% and 4.8% → 2.7%), “correct errors by making appropriate changes” (3.0% → 2.1%), “perform initial debugging procedures” (2.0% → 0.9%), “diagnose, troubleshoot, and resolve hardware/software problems” (1.6% → 2.5%), “review and analyze computer printouts to locate code problems” (1.3% → 0.9%), and “determine sources of web page or server problems” (0.9% → 0.4%).\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"93ce14c4df09\",\"_type\":\"block\",\"children\":[{\"_key\":\"502387d890600\",\"_type\":\"span\",\"marks\":[],\"text\":\"4. We note that V3 uses Claude Sonnet 4 for classification, while V2 used Sonnet 3.7, which complicates direct comparison. To address this, we reran V3 data with Sonnet 3.7 and still found directive interactions rising significantly (though to a lower absolute level of 45% automation versus 49% with Sonnet 4). We also verified this trend is not driven by changes in task mix—the shift toward directive interactions appears across a wide range of occupational categories, suggesting it reflects genuine changes in how people interact with Claude rather than compositional effects.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"3a3aea7ad35e\",\"_type\":\"block\",\"children\":[{\"_key\":\"5ac5d68cdabc0\",\"_type\":\"span\",\"marks\":[],\"text\":\"5. Nelson and Phelps, 1966 \"},{\"_key\":\"e348989c6aec\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Investment in Humans, Technological Diffusion, and Economic Growth\"},{\"_key\":\"28d1e979857a\",\"_type\":\"span\",\"marks\":[],\"text\":\" is a classic reference for the value of education in equipping workers to adapt to change. See also Goldin and Katz, 2008 \"},{\"_key\":\"c70b20622444\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"The Race between Education and Technology\"},{\"_key\":\"2d8d26800f49\",\"_type\":\"span\",\"marks\":[],\"text\":\". We thank Anton Korinek for the observation that AI itself might accelerate the diffusion and economic impact of AI to the extent that it plays the role that skilled workers played in the past in figuring out how to effectively wield new technologies in novel settings.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"f68d78024dbb\",\"_type\":\"block\",\"children\":[{\"_key\":\"31f60b8cef010\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c6e9abaff0ba\",\"_type\":\"block\",\"children\":[{\"_key\":\"a94f2f0144260\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6f19bff2bed7\",\"_type\":\"block\",\"children\":[{\"_key\":\"2671cd2b78b00\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\nChapter 2: Claude usage across the United States and the globe\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"e8583d84e1cd\",\"_type\":\"block\",\"children\":[{\"_key\":\"6cbdc5a5251e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Overview\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"fd26e585bb96\",\"_type\":\"block\",\"children\":[{\"_key\":\"5f62548bf5270\",\"_type\":\"span\",\"marks\":[],\"text\":\"Where AI gets adopted first—and how it’s used—will shape economic outcomes across the world. By analyzing Claude usage patterns across 150+ countries and all US states, we uncover three key dynamics: where early adopters are, what they’re using AI for, and how usage evolves as adoption matures. These geographic patterns provide real-world evidence about AI’s economic diffusion, helping track whether different regions are converging or diverging in their AI adoption, and revealing how local economic characteristics shape technology deployment.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"90cb24203c01\",\"_type\":\"block\",\"children\":[{\"_key\":\"11fded6da9830\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"558f52fc8502\",\"_type\":\"block\",\"children\":[{\"_key\":\"8ae16e12289b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our data, relying on a \"},{\"_key\":\"8ae16e12289b1\",\"_type\":\"span\",\"marks\":[\"6cff82538069\"],\"text\":\"privacy-preserving\"},{\"_key\":\"75663c8ef480\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"1\"},{\"_key\":\"308287592bbd\",\"_type\":\"span\",\"marks\":[],\"text\":\" analysis of 1 million Claude.ai conversations\"},{\"_key\":\"a17d2f0799ef\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"2\"},{\"_key\":\"3d32b988ee82\",\"_type\":\"span\",\"marks\":[],\"text\":\", confirmed some of our expectations while challenging others. The US dominates total usage at 21.6%, which is unsurprising given its size and high income. But even when adjusting for the working-age population size, higher-income countries tend to have higher usage. For example, Singapore’s usage rate is 4.5 times what its working-age population would suggest, while large regions of the globe show minimal usage. Interestingly, within the US, DC and Utah outpace California in usage per capita.\"}],\"markDefs\":[{\"_key\":\"6cff82538069\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/research/clio\"}],\"style\":\"normal\"},{\"_key\":\"8f68e9583684\",\"_type\":\"block\",\"children\":[{\"_key\":\"e2769151ec2e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3c901f36c27b\",\"_type\":\"block\",\"children\":[{\"_key\":\"982dc1de23530\",\"_type\":\"span\",\"marks\":[],\"text\":\"We also observe changes in AI use cases as adoption per capita deepens. Countries with lower AI adoption per capita concentrate overwhelmingly on coding tasks—over half of all usage in India, compared to roughly a third globally. As adoption matures, usage diversifies, with a rising emphasis on education, science, and business operations.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b9a0f5a62ec1\",\"_type\":\"block\",\"children\":[{\"_key\":\"dca3f5c19f470\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"aeb1216abfcc\",\"_type\":\"block\",\"children\":[{\"_key\":\"5c596422f64c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Even more striking: mature markets tend to use AI more collaboratively, while emerging markets are more likely to delegate complete tasks to it—perhaps reflecting differences in how AI is deployed by economies at different stages of structural transformation. Our data provides a window into these patterns across geographies, and going forward, will enable us to track whether these adoption gaps narrow, widen, or change in structure over time.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"73a16578516b\",\"_type\":\"block\",\"children\":[{\"_key\":\"c9427551400a\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a9033a688964\",\"_type\":\"block\",\"children\":[{\"_key\":\"6c2497113c670\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude diffusion across the globe\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"9603d09a2c7c\",\"_type\":\"block\",\"children\":[{\"_key\":\"78209d4071f3\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8812422ea1a3\",\"_type\":\"block\",\"children\":[{\"_key\":\"52f2311d3e290\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Total Claude usage is highest in the US\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"626925e3cc1d\",\"_type\":\"block\",\"children\":[{\"_key\":\"8678949b01fd0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude adoption overall is highly geographically concentrated. In terms of total global usage, the United States accounts for the highest share (21.6%), with the next highest usage countries showing significantly lower shares (India at 7.2%, Brazil at 3.7%, see Figure 2.1). However, this concentration is affected by the population size of each country\"},{\"_key\":\"48257f3b735e\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"3\"},{\"_key\":\"682e1a9e61ea\",\"_type\":\"span\",\"marks\":[],\"text\":\" – larger countries may have larger usage shares purely because of their population size.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a3b3283f3c7e\",\"_type\":\"block\",\"children\":[{\"_key\":\"542887ec7437\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b17d27e99036\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-21db2a6e87fadf19e2ae69ef479b32f3e6dfd1aa-5980x4437-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"119cd0f9677b\",\"_type\":\"block\",\"children\":[{\"_key\":\"8c11d571e1c10\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.1: Leading countries in terms of global Claude.ai usage share. \"},{\"_key\":\"8c11d571e1c11\",\"_type\":\"span\",\"marks\":[],\"text\":\"The data includes Claude.ai Free and Pro conversations.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.1: Leading countries in terms of global Claude.ai usage share. The data includes Claude.ai Free and Pro conversations.\",\"height\":4437,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/21db2a6e87fadf19e2ae69ef479b32f3e6dfd1aa-5980x4437.png\",\"width\":5980},{\"_key\":\"debb4dd04216\",\"_type\":\"block\",\"children\":[{\"_key\":\"1ffe0bb40aef\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c1e2baabde3b\",\"_type\":\"block\",\"children\":[{\"_key\":\"57dc82dbfa110\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Per capita usage of Claude is concentrated in technologically advanced countries\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"09fb63d3f487\",\"_type\":\"block\",\"children\":[{\"_key\":\"a5f4264fcdbd0\",\"_type\":\"span\",\"marks\":[],\"text\":\"To account for differences in population size, we analyze usage adjusted for the working-age population, introducing a new measure called the Anthropic AI Usage Index (AUI): For each geography, we calculate its share of Claude usage, and its share of the working-age population (ages 15-64). We then calculate the AUI by dividing these shares:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7e773d7aa337\",\"_type\":\"block\",\"children\":[{\"_key\":\"f6ff069293c9\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0ae5d2b9de36\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-fd30ac8c8775748b57f00658dbe7efdd3e298b46-2861x388-png\",\"_type\":\"reference\"},\"caption\":null,\"description\":\"Anthropic AI Usage Index equation\",\"height\":388,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/fd30ac8c8775748b57f00658dbe7efdd3e298b46-2861x388.png\",\"width\":2861},{\"_key\":\"35905a607724\",\"_type\":\"block\",\"children\":[{\"_key\":\"cffc515153e6\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"56901d9ab5a0\",\"_type\":\"block\",\"children\":[{\"_key\":\"8dc0d123bac80\",\"_type\":\"span\",\"marks\":[],\"text\":\"This index reveals whether countries use Claude more or less than expected relative to their working-age population. A region with an AUI \u003e 1 has higher usage than expected after adjusting for population, while a region with an AUI \u003c 1 has lower usage.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c0b5ebdc032d\",\"_type\":\"block\",\"children\":[{\"_key\":\"bf24fd3bc3d70\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"714e6cb997c3\",\"_type\":\"block\",\"children\":[{\"_key\":\"47b5a840746a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"The results reveal a striking pattern of concentration among small, technologically advanced economies. Israel leads global per capita Claude usage with an Anthropic AI Usage Index of 7 — meaning its working-age population uses Claude 7x more than expected based on its population. Singapore follows at 4.57, while Australia (4.10), New Zealand (4.05) and South Korea (3.73) round out the top five countries in terms of per capita Claude usage.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5abf572e4b8c\",\"_type\":\"block\",\"children\":[{\"_key\":\"b332967884f7\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ca36bbbf57ab\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-5303d8780f4f566e994b12b2d0549947160711ba-6308x4197-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"044451cfe502\",\"_type\":\"block\",\"children\":[{\"_key\":\"6b0f89f0da2b0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.2: Small, technologically advanced countries are leading in Claude adoption per capita. \"},{\"_key\":\"6b0f89f0da2b1\",\"_type\":\"span\",\"marks\":[],\"text\":\"The figure shows the top 20 countries based on the Anthropic AI Usage Index. We only include countries with at least 200 observations in our sample for this figure because of the uncertainty of the measure for low-usage countries in our random sample. The underlying data includes Claude.ai Free and Pro usage.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.2: Small, technologically advanced countries are leading in Claude adoption per capita. The figure shows the top 20 countries based on the Anthropic AI Usage Index. We only include countries with at least 200 observations in our sample for this figure because of the uncertainty of the measure for low-usage countries in our random sample. The underlying data includes Claude.ai Free and Pro usage.\",\"height\":4197,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/5303d8780f4f566e994b12b2d0549947160711ba-6308x4197.png\",\"width\":6308},{\"_key\":\"c40342b1c238\",\"_type\":\"block\",\"children\":[{\"_key\":\"a86e3728be210\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"34e4b162b837\",\"_type\":\"block\",\"children\":[{\"_key\":\"1a4c98a9636e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Next, we create per capita usage tiers based on the AUI. We look at countries with at least 200 conversations in our random sample of 1 million conversations, and set thresholds for different usage tiers-based quartiles, i.e. \"},{\"_key\":\"1a4c98a9636e1\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Leading\"},{\"_key\":\"1a4c98a9636e2\",\"_type\":\"span\",\"marks\":[],\"text\":\" (top 25%), \"},{\"_key\":\"1a4c98a9636e3\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Upper Middle\"},{\"_key\":\"1a4c98a9636e4\",\"_type\":\"span\",\"marks\":[],\"text\":\" (50-75%), \"},{\"_key\":\"1a4c98a9636e5\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Lower Middle\"},{\"_key\":\"1a4c98a9636e6\",\"_type\":\"span\",\"marks\":[],\"text\":\" (25%-75%) and \"},{\"_key\":\"1a4c98a9636e7\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Emerging\"},{\"_key\":\"1a4c98a9636e8\",\"_type\":\"span\",\"marks\":[],\"text\":\" (bottom 25%). We then assign countries, even if they have fewer than 200 observations, to a tier based on their AUI. We assign countries for which we have population data, but no usage in our sample, to a \"},{\"_key\":\"1a4c98a9636e9\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Minimal\"},{\"_key\":\"1a4c98a9636e10\",\"_type\":\"span\",\"marks\":[],\"text\":\" tier.\"},{\"_key\":\"f0957afb1156\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"4\"},{\"_key\":\"ed4bda874b2a\",\"_type\":\"span\",\"marks\":[],\"text\":\" Figure 2.3 illustrates the Anthropic AI Usage Index tiers across the globe, Table 2.1 shows an overview of the tiers and country examples.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d399690c4465\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-7019b971db2d08b320fcab99257a19213bdafa9c-6287x3371-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"30e9541bf142\",\"_type\":\"block\",\"children\":[{\"_key\":\"fe740626b2f00\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.3: Claude diffusion varies across countries, with countries in North America, Europe and Oceania leading in Claude adoption per working-age capita. \"},{\"_key\":\"fe740626b2f01\",\"_type\":\"span\",\"marks\":[],\"text\":\"The different tiers reflect a country’s position within the global distribution of the Anthropic AI Usage Index as defined in this chapter. \"},{\"_key\":\"c3a3116e9733\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"5,6\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.3: Claude diffusion varies across countries, with countries in North America, Europe and Oceania leading in Claude adoption per working-age capita. The different tiers reflect a country’s position within the global distribution of the Anthropic AI Usage Index as defined in this chapter.\",\"height\":3371,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/7019b971db2d08b320fcab99257a19213bdafa9c-6287x3371.png\",\"width\":6287},{\"_key\":\"7ba325ac9f81\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-31e0f802cf62df20a641c409b0ae5cd4d709ba3c-1725x360-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"f768f8fc3e46\",\"_type\":\"block\",\"children\":[{\"_key\":\"c4784eb877e10\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Table 2.1: Anthropic Economic Index tiers with examples, number of countries, and AUI range for each tier.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0b06b8743bbe\",\"_type\":\"block\",\"children\":[{\"_key\":\"ae233c2454040\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Table 2.1: Anthropic Economic Index tiers with examples, number of countries, and AUI range for each tier.\",\"height\":360,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/31e0f802cf62df20a641c409b0ae5cd4d709ba3c-1725x360.png\",\"width\":1725},{\"_key\":\"755234769f05\",\"_type\":\"block\",\"children\":[{\"_key\":\"6798c7a084c90\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Zooming into leading and emerging countries in terms of per capita usage\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"20bb0f772e2c\",\"_type\":\"block\",\"children\":[{\"_key\":\"e35c7ad74d2b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"701148ff268d\",\"_type\":\"block\",\"children\":[{\"_key\":\"848356fc215a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"This concentration in advanced economies with limited population sizes reflects their established patterns as technology pioneers. For example, both Israel and Singapore rank highly in the \"},{\"_key\":\"848356fc215a1\",\"_type\":\"span\",\"marks\":[\"3f48b785a234\"],\"text\":\"Global Innovation Index\"},{\"_key\":\"848356fc215a2\",\"_type\":\"span\",\"marks\":[],\"text\":\"—a measure of how innovative different economies across the globe are—suggesting that general investments in information technology position economies well for rapid adoption of frontier AI. Overall, these economies can leverage their educated workforces, robust digital infrastructure, and innovation-friendly policies to create fertile conditions for AI.\"}],\"markDefs\":[{\"_key\":\"3f48b785a234\",\"_type\":\"link\",\"href\":\"https://www.wipo.int/web-publications/global-innovation-index-2024/en/gii-2024-at-a-glance.html\"}],\"style\":\"normal\"},{\"_key\":\"099f04fcbdc7\",\"_type\":\"block\",\"children\":[{\"_key\":\"1d0e4580dd830\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"befe68ce7b85\",\"_type\":\"block\",\"children\":[{\"_key\":\"8118987650750\",\"_type\":\"span\",\"marks\":[],\"text\":\"Notable is the position of major developed economies in Claude usage. The United States (3.62) ranks among leading countries in terms of per capita adoption, with Canada (2.91) and the United Kingdom (2.67) having elevated but more moderate rates of adoption as compared to their population. Other major economies show lower adoption, including France at 1.94, Japan at 1.86, and Germany at 1.84.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0f4d6c9baad7\",\"_type\":\"block\",\"children\":[{\"_key\":\"cc63ce647dc80\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"317c51c07566\",\"_type\":\"block\",\"children\":[{\"_key\":\"6a9289e0102b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Meanwhile, many lower and middle-income economies show minimal Claude usage, with many countries across Africa, Latin America, and parts of Asia showing Claude adoption below what would be expected based on their working-age population. This includes Bolivia (0.48), Indonesia (0.36), India (0.27), and Nigeria (0.2).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"04cb34811a70\",\"_type\":\"block\",\"children\":[{\"_key\":\"41fd2363788b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0da36b068769\",\"_type\":\"block\",\"children\":[{\"_key\":\"71ed517403000\",\"_type\":\"span\",\"marks\":[],\"text\":\"This variation in usage is reflective of income differences across these economies. We see a strong positive correlation between Claude adoption and Gross Domestic Product per working-age capita (see Figure 2.4), with a 1% increase in GDP per capita being associated with a 0.7% increase in Claude usage per capita.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e6dd578f8ab6\",\"_type\":\"block\",\"children\":[{\"_key\":\"c8ee82206125\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4e761fb1e9eb\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-9dd4784a7787d188ad5b4580a12ad8a0703f2997-6072x4322-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"bfe42e80e25e\",\"_type\":\"block\",\"children\":[{\"_key\":\"44f9a231351d0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.4: Claude usage per capita is positively correlated with income per capita across countries. \"},{\"_key\":\"44f9a231351d1\",\"_type\":\"span\",\"marks\":[],\"text\":\"We only include countries with at least 200 observations in our sample for this figure because of the uncertainty of the measure for low-usage countries in our random sample. Axes are on a log scale, highlighting a power law distribution. Each country is represented by its 3-letter ISO code.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fa193f391238\",\"_type\":\"block\",\"children\":[{\"_key\":\"6d72386e1bed0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"db36ae8d96ef\",\"_type\":\"block\",\"children\":[{\"_key\":\"9aa4fc2a53400\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.4: Claude usage per capita is positively correlated with income per capita across countries. We only include countries with at least 200 observations in our sample for this figure because of the uncertainty of the measure for low-usage countries in our random sample. Axes are on a log scale, highlighting a power law distribution. Each country is represented by its 3-letter ISO code.\",\"height\":4322,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/9dd4784a7787d188ad5b4580a12ad8a0703f2997-6072x4322.png\",\"width\":6072},{\"_key\":\"9affaa4ddad5\",\"_type\":\"block\",\"children\":[{\"_key\":\"8d749a3076bc0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"064767640417\",\"_type\":\"block\",\"children\":[{\"_key\":\"8d8bcda947be0\",\"_type\":\"span\",\"marks\":[],\"text\":\"The disparities in Claude usage likely reflect a confluence of factors, some of which are correlated with income:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bb17445d382b\",\"_type\":\"block\",\"children\":[{\"_key\":\"e8598716e60d0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Digital infrastructure:\"},{\"_key\":\"3c25fa07ea3d\",\"_type\":\"span\",\"marks\":[],\"text\":\" High-usage countries typically have robust internet connectivity and cloud computing access needed to access AI assistants.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fd9fc7e170aa\",\"_type\":\"block\",\"children\":[{\"_key\":\"a7a944803c4a0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Economic structure:\"},{\"_key\":\"6481a37afbde\",\"_type\":\"span\",\"marks\":[],\"text\":\" As documented in this and previous reports, Claude capabilities are well-suited to various tasks typical of knowledge workers. Advanced economies tend to have a greater share of the workforce in such roles as compared to lower-income economies with a larger employment share in manufacturing.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7352f198c3b2\",\"_type\":\"block\",\"children\":[{\"_key\":\"27db01ede8230\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regulatory environment:\"},{\"_key\":\"a601194d7f77\",\"_type\":\"span\",\"marks\":[],\"text\":\" Governments differ in how actively they encourage the use of AI across different industries and in how heavily they regulate the technology.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ce1d933ecb64\",\"_type\":\"block\",\"children\":[{\"_key\":\"777234acb8d70\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Awareness and access:\"},{\"_key\":\"b8a1648687f1\",\"_type\":\"span\",\"marks\":[],\"text\":\" Countries with stronger connections to Silicon Valley and AI research communities may have greater awareness of and access to Claude.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e7f457491dff\",\"_type\":\"block\",\"children\":[{\"_key\":\"052d98fb09b70\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Trust and comfort:\"},{\"_key\":\"28962cffb373\",\"_type\":\"span\",\"marks\":[],\"text\":\" Public opinion on trust in AI varies substantially \"},{\"_key\":\"052d98fb09b71\",\"_type\":\"span\",\"marks\":[\"96618f27dc69\"],\"text\":\"across\"},{\"_key\":\"052d98fb09b72\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"},{\"_key\":\"052d98fb09b73\",\"_type\":\"span\",\"marks\":[\"62c422cbbed8\"],\"text\":\"countries\"},{\"_key\":\"052d98fb09b74\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[{\"_key\":\"96618f27dc69\",\"_type\":\"link\",\"href\":\"https://hai.stanford.edu/ai-index/2025-ai-index-report/public-opinion\"},{\"_key\":\"62c422cbbed8\",\"_type\":\"link\",\"href\":\"https://www.ipsos.com/sites/default/files/ct/publication/documents/2025-06/Ipsos-AI-Monitor-2025.pdf\"}],\"style\":\"normal\"},{\"_key\":\"76606d25a0a1\",\"_type\":\"block\",\"children\":[{\"_key\":\"1334929f1d040\",\"_type\":\"span\",\"marks\":[],\"text\":\"Claude diffusion across the United States\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"e088243cf8c1\",\"_type\":\"block\",\"children\":[{\"_key\":\"5d6f52d4032d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Within the US, California overwhelmingly leads with 25.3% of usage. Other states with major tech centers like New York (9.3%), Texas (6.7%), and Virginia (4.0%) also rank highly. Though not adjusted for population, we suspect that these strong adoption figures partly reflect rapid adoption in technology hubs—in keeping with how economically consequential technologies have historically tended to diffuse.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"53dc0b28a07c\",\"_type\":\"block\",\"children\":[{\"_key\":\"f723290451cb0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d426db2e33b8\",\"_type\":\"block\",\"children\":[{\"_key\":\"b3c2c7623c560\",\"_type\":\"span\",\"marks\":[],\"text\":\"This narrative becomes more complex, however, when we adjust for the population size of each state. Surprisingly, the District of Columbia leads with an Anthropic AI Usage Index of 3.82, indicating that Claude usage in DC is 3.82x greater than its share of the country’s working-age population. Closely following is Utah (3.78), notably ahead of California (2.13), New York (1.58) and Virginia (1.57).\"},{\"_key\":\"127c82b2ba8c\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"7\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a7945b6f86e6\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-c037fb48747a54cb01c39cd56d64bde375a0696f-6415x4197-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"6d161fc208c1\",\"_type\":\"block\",\"children\":[{\"_key\":\"51cd3c6cb52a0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.5: Leading US states in terms of Claude adoption per working-age capita include the District of Columbia, Utah, California, New York and Virginia. \"},{\"_key\":\"51cd3c6cb52a1\",\"_type\":\"span\",\"marks\":[],\"text\":\"The figure shows the top 20 US states based on the Anthropic AI Usage Index. We only include states with at least 100 observations in our sample for this figure because of the uncertainty of the measure for low-usage states in our random sample. The underlying data includes Claude.ai Free and Pro usage.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5ffbc2d872ac\",\"_type\":\"block\",\"children\":[{\"_key\":\"2e232ee80ebb0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.5: Leading US states in terms of Claude adoption per working-age capita include the District of Columbia, Utah, California, New York and Virginia. The figure shows the top 20 US states based on the Anthropic AI Usage Index. We only include states with at least 100 observations in our sample for this figure because of the uncertainty of the measure for low-usage states in our random sample. The underlying data includes Claude.ai Free and Pro usage.\",\"height\":4197,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/c037fb48747a54cb01c39cd56d64bde375a0696f-6415x4197.png\",\"width\":6415},{\"_key\":\"535535871442\",\"_type\":\"block\",\"children\":[{\"_key\":\"d7059771aa0a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"We document a similar, but weaker correlation than at the global level between Claude adoption and income per capita across US states. Income differences explain less than half the variation in cross-state adoption rates. Despite this weaker correlation, we find that Claude adoption rises faster with income: Each 1% increase in state GDP per capita is associated with a 1.8% increase in the AI Usage Index.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"38abc7550476\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-91987a83370e2d6c3558e416f1376e823df4bb69-6287x3270-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"2f16493aeb76\",\"_type\":\"block\",\"children\":[{\"_key\":\"932eae2a93120\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.6: Claude usage varies across US states, with high per-capita usage in the West Coast, but also higher usage in Nevada, Utah, Colorado, Missouri, and Virginia. \"},{\"_key\":\"932eae2a93121\",\"_type\":\"span\",\"marks\":[],\"text\":\"The different tiers reflect a US state’s position within the US distribution of the Anthropic AI Usage Index as defined in this chapter.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4600d5fc77cb\",\"_type\":\"block\",\"children\":[{\"_key\":\"e75d99d599960\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.6: Claude usage varies across US states, with high per-capita usage in the West Coast, but also higher usage in Nevada, Utah, Colorado, Missouri, and Virginia. The different tiers reflect a US state’s position within the US distribution of the Anthropic AI Usage Index as defined in this chapter.\",\"height\":3270,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/91987a83370e2d6c3558e416f1376e823df4bb69-6287x3270.png\",\"width\":6287},{\"_key\":\"6c83942c5e25\",\"_type\":\"block\",\"children\":[{\"_key\":\"c4c7f8d882fb0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"1a09ebf4c2ae\",\"_type\":\"block\",\"children\":[{\"_key\":\"98e6bdb745a60\",\"_type\":\"span\",\"marks\":[],\"text\":\"Task usage patterns across countries\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"2960d89a3bf0\",\"_type\":\"block\",\"children\":[{\"_key\":\"367ebf41829c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"We observe notable variation in how Claude is used in different countries. As in past reports, we analyze these trends using two different approaches. First, we classify conversations into tasks according to O*NET, a US taxonomy that maps specific tasks to occupations and occupation groups (e.g., a task involving software debugging would fall into the Computer and Mathematical occupation group).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"87943948a578\",\"_type\":\"block\",\"children\":[{\"_key\":\"7f56269e94ea0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"206ff81086fa\",\"_type\":\"block\",\"children\":[{\"_key\":\"cbf049c35b650\",\"_type\":\"span\",\"marks\":[],\"text\":\"Second, we use Claude to construct a bottom-up taxonomy of user requests on Claude.ai, which provides insight into usage patterns that do not fit neatly into existing taxonomies. For example, the request cluster “help write and improve cover letters for job applications” (lowest level) feeds into the higher-level cluster “help with job applications, resumes, and career documents” (middle level), which in turn feeds into the cluster “help with job applications, resumes, and career advancement” (highest level). These two complementary approaches allow us to both report results aligned with standard labor statistics, and provide flexibility to capture tasks that standard taxonomies miss.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ac19b9abf9bf\",\"_type\":\"block\",\"children\":[{\"_key\":\"4ea412cc519c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"48fbb3c617fe\",\"_type\":\"block\",\"children\":[{\"_key\":\"23aee1e0ced50\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Higher per capita Claude usage is associated with more diverse task usage\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"829e09c3a00e\",\"_type\":\"block\",\"children\":[{\"_key\":\"c78c7414df8c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"When analyzing O*NET tasks aggregated at the highest level (in terms of the Standard Occupation Classification occupation groups they belong to), we notice strong variation across countries. While the overall pattern is noisy–especially for countries with fewer observations–Figure 2.7 suggests that as we progress from lower to higher per capita Claude adoption, usage shifts away from tasks in the Computer and Mathematical occupation group (e.g., programming) to more diverse tasks in areas such as education, office and administrative uses, and arts. We also see increased usage in the life, physical and social sciences.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b3d3f82e01b7\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-ac265e6d4eab543df80fcad980ca1c8e5cc6bfd8-5937x6610-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"265249d830b1\",\"_type\":\"block\",\"children\":[{\"_key\":\"fd925836214f0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.7: As we move from lower to higher adoption countries, Claude usage appears to shift away from programming-dominant tasks to a more diverse mix of tasks, though the overall pattern is noisy.\"},{\"_key\":\"fd925836214f1\",\"_type\":\"span\",\"marks\":[],\"text\":\"This figure shows the relationship between the Anthropic AI Usage Index and the most frequent Standard Occupation Classification (SOC) occupation groups. Each panel shows a different SOC group. SOC share is based on how many O*NET tasks in a given geography fall into a given SOC group. The color indicates which AUI tier a country falls into. The bubble size indicates the usage count for each country. We only include countries with at least 200 observations in our sample for this figure because of the uncertainty of the measure for low-usage countries in our random sample. The regression weights every country equally.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e41529a451a7\",\"_type\":\"block\",\"children\":[{\"_key\":\"1f645e97ae920\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.7: As we move from lower to higher adoption countries, Claude usage appears to shift away from programming-dominant tasks to a more diverse mix of tasks, though the overall pattern is noisy.This figure shows the relationship between the Anthropic AI Usage Index and the most frequent Standard Occupation Classification (SOC) occupation groups. Each panel shows a different SOC group. SOC share is based on how many O*NET tasks in a given geography fall into a given SOC group. The color indicates which AUI tier a country falls into. The bubble size indicates the usage count for each country. We only include countries with at least 200 observations in our sample for this figure because of the uncertainty of the measure for low-usage countries in our random sample. The regression weights every country equally.\",\"height\":6610,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/ac265e6d4eab543df80fcad980ca1c8e5cc6bfd8-5937x6610.png\",\"width\":5937},{\"_key\":\"99a2046d5b97\",\"_type\":\"block\",\"children\":[{\"_key\":\"28a26ef168690\",\"_type\":\"span\",\"marks\":[],\"text\":\"Country idiosyncrasies also emerge when looking at our bottom-up request taxonomy.\"},{\"_key\":\"7451c68554d1\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"8\"},{\"_key\":\"c1efa3f19ea7\",\"_type\":\"span\",\"marks\":[],\"text\":\" Take, for example, the United States, Brazil, Vietnam, and India, which represent the country with the highest total usage within a given Anthropic AI Usage Index tier. Users in the United States disproportionately use Claude for household management purposes, to search for jobs, and for medical guidance compared to the global average. By contrast, Claude users in Brazil have comparatively high usage for both translation and legal services. Vietnam’s top disproportionate requests are related to software development and education, and India’s top disproportionate requests focus almost exclusively on software development. This likely reflects local specialization: Brazil has been an \"},{\"_key\":\"28a26ef168691\",\"_type\":\"span\",\"marks\":[\"995f91c69888\"],\"text\":\"early adopter of AI in the judicial system\"},{\"_key\":\"28a26ef168692\",\"_type\":\"span\",\"marks\":[],\"text\":\", and India has a large information technology sector.\"}],\"markDefs\":[{\"_key\":\"995f91c69888\",\"_type\":\"link\",\"href\":\"https://www.sciencespo.fr/public/chaire-numerique/en/2023/03/03/article-artificial-intelligence-the-brazilian-judiciary-and-some-conundrums/\"}],\"style\":\"normal\"},{\"_key\":\"6702d9615a78\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-919df84f22bccb18f6f0432b7a23ca314a7e2665-4990x2974-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"267f30cb7001\",\"_type\":\"block\",\"children\":[{\"_key\":\"db575f0e88ca0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.8: Overrepresented request clusters for the United States, Brazil, Vietnam and India. \"},{\"_key\":\"db575f0e88ca1\",\"_type\":\"span\",\"marks\":[],\"text\":\"A request is overrepresented in a country when the share of conversations containing that request is higher for that country than globally. For this figure, we focus on request clusters at the middle level of granularity, i.e. more aggregated than the lowest level request clusters, but less aggregated than the highest level request clusters. Only includes requests with at least 1% frequency globally and for that country.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"89a8cc3e720b\",\"_type\":\"block\",\"children\":[{\"_key\":\"6b449c0a541f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.8: Overrepresented request clusters for the United States, Brazil, Vietnam and India. A request is overrepresented in a country when the share of conversations containing that request is higher for that country than globally. For this figure, we focus on request clusters at the middle level of granularity, i.e. more aggregated than the lowest level request clusters, but less aggregated than the highest level request clusters. Only includes requests with at least 1% frequency globally and for that country.\",\"height\":2974,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/919df84f22bccb18f6f0432b7a23ca314a7e2665-4990x2974.png\",\"width\":4990},{\"_key\":\"74570518ee08\",\"_type\":\"block\",\"children\":[{\"_key\":\"de7b9c95ffd10\",\"_type\":\"span\",\"marks\":[],\"text\":\"Across all countries, software development emerges as the most common use of Claude. Why do developer tasks consistently lead in overall Claude usage patterns? Several factors likely contribute to this effect:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"030924dffa80\",\"_type\":\"block\",\"children\":[{\"_key\":\"8b00ed8aac640\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Model-task fit:\"},{\"_key\":\"0a23e84844d9\",\"_type\":\"span\",\"marks\":[],\"text\":\" Claude is a very strong coding model and readily deployed across code generation, debugging, and technical problem-solving tasks.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b72f70c5931f\",\"_type\":\"block\",\"children\":[{\"_key\":\"f56f47b4b9c00\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Developer receptivity:\"},{\"_key\":\"5254a4f76000\",\"_type\":\"span\",\"marks\":[],\"text\":\" Developer communities embrace new tools rapidly, and this usage diffuses through their social and professional networks.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"83cc265551bb\",\"_type\":\"block\",\"children\":[{\"_key\":\"26c12abde5470\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Low organizational barriers:\"},{\"_key\":\"e09de93d4e79\",\"_type\":\"span\",\"marks\":[],\"text\":\" Individual developers can typically adopt Claude without complex approval processes—in contrast to, say, medical use cases.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"330ea4c4ddba\",\"_type\":\"block\",\"children\":[{\"_key\":\"a575d70ec0f60\",\"_type\":\"span\",\"marks\":[],\"text\":\"Task usage patterns across the United States\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"dfa61bea13f4\",\"_type\":\"block\",\"children\":[{\"_key\":\"db3725c375330\",\"_type\":\"span\",\"marks\":[],\"text\":\"In this section we explore patterns of Claude usage across states within the US, giving us further insight into how local economic conditions shape usage patterns. As we discuss above, cross-state differences in the Anthropic AI Usage Index account for less than half of the variation in income differences across US states. This suggests that other regional differences—including the compatibility of Claude capabilities with the occupational composition of the local workforce—play a larger role in determining why usage is more concentrated in some states than others.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a0815a581fe2\",\"_type\":\"block\",\"children\":[{\"_key\":\"b0573eb484530\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3e65a2dcfaa0\",\"_type\":\"block\",\"children\":[{\"_key\":\"ff88ccd89ed70\",\"_type\":\"span\",\"marks\":[],\"text\":\"In a number of states, we see evidence that local patterns of AI use aligns with distinctive features of the local economy. When analyzing the top states in each usage tier—California for leading, Texas for upper middle, Florida for lower middle, and South Carolina for emerging—we see strong variation in terms of our bottom-up request taxonomy (see Figure 2.9).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"74d30f0c9c31\",\"_type\":\"block\",\"children\":[{\"_key\":\"a37545488a580\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4a193d219d09\",\"_type\":\"block\",\"children\":[{\"_key\":\"45dda25a83830\",\"_type\":\"span\",\"marks\":[],\"text\":\"For example, California shows disproportionate use for IT-related requests, digital marketing and translation, likely reflecting its tech sector and linguistically diverse population. California also has disproportionately frequent requests for help with basic numerical tasks, which may represent tests of model capabilities or abuse. Florida sees disproportionate use for business advice and fitness, potentially tied to its role as a financial hub with relatively low tax rates and a warm climate amenable to outdoor activities.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2f952d5e03ff\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-c9694abd62dfb18e153e3b3b2f2b76c3e4ec734d-4990x2974-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"06596503af94\",\"_type\":\"block\",\"children\":[{\"_key\":\"caa3278ddbd90\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.9: Overrepresented request categories for California, Texas, Florida and South Carolina. \"},{\"_key\":\"caa3278ddbd91\",\"_type\":\"span\",\"marks\":[],\"text\":\"A request is overrepresented in a state when the share of conversations containing that request is higher for that state than in the US as a whole. For this figure, we focus on request clusters at the middle level of granularity, i.e. more aggregated than the lowest level request clusters, but less aggregated than the highest level request clusters. Only includes requests with at least 1% frequency in the United States and for that state.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b4663d26d328\",\"_type\":\"block\",\"children\":[{\"_key\":\"b5ab30a94a3d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.9: Overrepresented request categories for California, Texas, Florida and South Carolina. A request is overrepresented in a state when the share of conversations containing that request is higher for that state than in the US as a whole. For this figure, we focus on request clusters at the middle level of granularity, i.e. more aggregated than the lowest level request clusters, but less aggregated than the highest level request clusters. Only includes requests with at least 1% frequency in the United States and for that state.\",\"height\":2974,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/c9694abd62dfb18e153e3b3b2f2b76c3e4ec734d-4990x2974.png\",\"width\":4990},{\"_key\":\"1e4c89820b23\",\"_type\":\"block\",\"children\":[{\"_key\":\"2f2ff74ee3e20\",\"_type\":\"span\",\"marks\":[],\"text\":\"Within the US, D.C. leads in terms of per capita Claude usage, with a disproportionate focus on document editing, information provision and job applications across both the O*NET task classification and bottom-up categorization (see Figure 2.10). For example, help with job applications is 1.84x as common in DC as in the US overall. Our \"},{\"_key\":\"2f2ff74ee3e21\",\"_type\":\"span\",\"marks\":[\"4c108c9524cf\"],\"text\":\"interactive dashboard\"},{\"_key\":\"2f2ff74ee3e22\",\"_type\":\"span\",\"marks\":[],\"text\":\" allows everyone to explore the full range of variation and patterns across US states.\"}],\"markDefs\":[{\"_key\":\"4c108c9524cf\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/economic-index#us-usage\"}],\"style\":\"normal\"},{\"_key\":\"414118fda0e2\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-23a030e827b026d1575b5ec40091042aed21cc6e-4940x2469-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"e4e1331e4ddb\",\"_type\":\"block\",\"children\":[{\"_key\":\"4d7c1eb62ed90\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.10: Washington, DC has the highest Claude usage per capita, with disproportionate tasks and requests focusing on document editing, information provision and job applications\"},{\"_key\":\"b6169cc279f2\",\"_type\":\"span\",\"marks\":[\"strong\",\"em\"],\"text\":\". \"},{\"_key\":\"4d7c1eb62ed91\",\"_type\":\"span\",\"marks\":[],\"text\":\"O*NET tasks refer to tasks in the O*NET taxonomy. Requests are based on the bottom-up request categories that describe what requests users make of Claude. A task or request is overrepresented in a state when the share of conversations containing that task or request is higher for that state than in the US as a whole. For this figure, we focus on request clusters at the middle level of granularity. Only includes requests with at least 1% frequency in the United States and for that state.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f4ed6c48f36b\",\"_type\":\"block\",\"children\":[{\"_key\":\"622c77f9f2be0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d35efce7bcc2\",\"_type\":\"block\",\"children\":[{\"_key\":\"b49cdc398676\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.10: Washington, DC has the highest Claude usage per capita, with disproportionate tasks and requests focusing on document editing, information provision and job applications. O*NET tasks refer to tasks in the O*NET taxonomy. Requests are based on the bottom-up request categories that describe what requests users make of Claude. A task or request is overrepresented in a state when the share of conversations containing that task or request is higher for that state than in the US as a whole. For this figure, we focus on request clusters at the middle level of granularity. Only includes requests with at least 1% frequency in the United States and for that state.\",\"height\":2469,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/23a030e827b026d1575b5ec40091042aed21cc6e-4940x2469.png\",\"width\":4940},{\"_key\":\"92ac59d420d5\",\"_type\":\"block\",\"children\":[{\"_key\":\"2abfc4a429cb0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Geographic patterns in human-AI collaboration\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"af0d28f0e23f\",\"_type\":\"block\",\"children\":[{\"_key\":\"5d44bf83cd7f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"While previous sections examined \"},{\"_key\":\"5d44bf83cd7f1\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"what\"},{\"_key\":\"5d44bf83cd7f2\",\"_type\":\"span\",\"marks\":[],\"text\":\" tasks people use Claude for, an equally revealing pattern emerges in \"},{\"_key\":\"5d44bf83cd7f3\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"how\"},{\"_key\":\"5d44bf83cd7f4\",\"_type\":\"span\",\"marks\":[],\"text\":\" they interact with it. Here, we use the same augmentation and automation collaboration patterns as defined in Chapter 1.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f7e8d2f4b3f4\",\"_type\":\"block\",\"children\":[{\"_key\":\"50a20bb469290\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"058e6d380cd8\",\"_type\":\"block\",\"children\":[{\"_key\":\"5e5bb0f90b380\",\"_type\":\"span\",\"marks\":[],\"text\":\"Countries have different task mixes, meaning that they focus on different economic tasks, which may partly explain differences in automation patterns. In this section, we investigate whether automated use is systematically different among low and high per capita adoption economies—even when controlling for differences in task mix.\"},{\"_key\":\"3e6caf1c5c36\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"9\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"88fcab954b8f\",\"_type\":\"block\",\"children\":[{\"_key\":\"30eff7b260df0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"433fba4ad4e0\",\"_type\":\"block\",\"children\":[{\"_key\":\"8d668b1ef3640\",\"_type\":\"span\",\"marks\":[],\"text\":\"We find that even when controlling for the task mix of a country, users from different countries show notably different preferences for autonomous delegation versus collaborative interaction. As Claude usage per capita increases, countries shift from automation-focused to augmentation-focused usage. This is somewhat counter-intuitive, since we are controlling for the more diverse task composition across different countries. We speculate that cultural and economic factors might affect the automation share, or perhaps that early adopters in each country tend to use AI in a more automotive way—but more research is needed here.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"aafb61431543\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-2e22aad0068e526ebd532fc7bf3d5d231b270a27-4886x3773-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"11bc9d9542f0\",\"_type\":\"block\",\"children\":[{\"_key\":\"53e056de69e30\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2.11: Countries with higher Anthropic AI Usage Index tend to use Claude in a more collaborative manner (augmentation), rather than have it operate independently (automation). \"},{\"_key\":\"53e056de69e31\",\"_type\":\"span\",\"marks\":[],\"text\":\"This figure shows the relationship between the Anthropic AI Usage Index and the automation share in a given country. We plot the relationship after accounting for a geography’s task mix, thus we show the regression residuals. We only include countries with at least 200 observations in our sample for this figure because of the uncertainty of the measure for low-usage countries in our random sample. Each country is represented by its 3-letter ISO code.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5758e056949c\",\"_type\":\"block\",\"children\":[{\"_key\":\"ca51a40ac3cc0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 2.11: Countries with higher Anthropic AI Usage Index tend to use Claude in a more collaborative manner (augmentation), rather than have it operate independently (automation). This figure shows the relationship between the Anthropic AI Usage Index and the automation share in a given country. We plot the relationship after accounting for a geography’s task mix, thus we show the regression residuals. We only include countries with at least 200 observations in our sample for this figure because of the uncertainty of the measure for low-usage countries in our random sample. Each country is represented by its 3-letter ISO code.\",\"height\":3773,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/2e22aad0068e526ebd532fc7bf3d5d231b270a27-4886x3773.png\",\"width\":4886},{\"_key\":\"533878f1cbf8\",\"_type\":\"block\",\"children\":[{\"_key\":\"c580dfb1e3e70\",\"_type\":\"span\",\"marks\":[],\"text\":\"Conclusion\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"18babe1b69d1\",\"_type\":\"block\",\"children\":[{\"_key\":\"e4363ac0642f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our analysis of Claude usage patterns across geographies reveals several key insights. One of the most striking is the geographic concentration of Claude usage. The leadership of the US and California in terms of Claude usage overall, and the strong correlation of Claude usage and income per capita, suggest parallels to past technologies in which initial geographic concentration and specialized use were a key feature. Drawing parallels to the diffusion patterns of prior technologies may help us better understand the diffusion and impact of AI.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c9467e4e4118\",\"_type\":\"block\",\"children\":[{\"_key\":\"d231167b24e00\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"821fde4f140b\",\"_type\":\"block\",\"children\":[{\"_key\":\"32640b9dfd270\",\"_type\":\"span\",\"marks\":[],\"text\":\"Surprisingly, geography shapes not just \"},{\"_key\":\"32640b9dfd271\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"what\"},{\"_key\":\"32640b9dfd272\",\"_type\":\"span\",\"marks\":[],\"text\":\" AI tools are used for, but \"},{\"_key\":\"32640b9dfd273\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"how\"},{\"_key\":\"32640b9dfd274\",\"_type\":\"span\",\"marks\":[],\"text\":\" they are used. Users in economies with relatively low per capita usage have a relative preference for delegating tasks to Claude (automation), whereas users in economies with high per capita usage are somewhat more likely to prefer more collaborative or learning-based interactions with Claude (augmentation), even when controlling for the task mix. Similar to the local specialization in task use, the local specialization in AI collaboration patterns suggests that impact of AI could be very different in different regions.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0a54f665d2ed\",\"_type\":\"block\",\"children\":[{\"_key\":\"cd782a147a330\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"245eaac42974\",\"_type\":\"block\",\"children\":[{\"_key\":\"79ee91374c1f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"The geographic patterns of AI adoption—where it is used, for which tasks, and how—suggest that in order to realize the potential of AI to benefit people across the globe, policymakers need to pay attention to local concentration of AI use and adoption, and address the risk of deepening digital divides.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4bfef7f0b0dc\",\"_type\":\"block\",\"children\":[{\"_key\":\"a97051f30478\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"584144788b40\",\"_type\":\"block\",\"children\":[{\"_key\":\"ffb67ab4ea1b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"1. For privacy reasons, our automated analysis system filters out any cells—e.g., countries, and (country, task) intersections—with fewer than 15 conversations and 5 unique user accounts. For bottom-up request clusters, we have an even higher privacy filter of at least 500 conversations and 250 unique accounts.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"0774f579770e\",\"_type\":\"block\",\"children\":[{\"_key\":\"413f4a4598de\",\"_type\":\"span\",\"marks\":[],\"text\":\"2. Data in this section covers 1 million Claude.ai Free and Pro conversations from August 4 to 11, 2025, randomly sampled from all conversations in that period that were not flagged as potential trust and safety violations. The unit of observation is a conversation with Claude on Claude.ai, not a user, so it is possible that multiple conversations from the same user are included, though our \"},{\"_key\":\"3fe028a2c1c9\",\"_type\":\"span\",\"marks\":[\"a7150a0ed241\"],\"text\":\"past work\"},{\"_key\":\"f8ac9b32c6c5\",\"_type\":\"span\",\"marks\":[],\"text\":\" suggests that sampling conversations at random versus stratified by user does not yield substantively different results. Aggregate geographic statistics at the country and US state level were assessed and tabulated from the IP address of each conversation. For geolocation, we use ISO-3166 codes since our provider for IP geolocation uses this standard. International locations use ISO-3166-1 country codes, US state level data use ISO-3166-2 region codes, which include all 50 US states and Washington DC. We exclude conversations originating from VPN, anycast, or hosting services, as determined by our IP geolocation provider.\"}],\"markDefs\":[{\"_key\":\"a7150a0ed241\",\"_type\":\"link\",\"href\":\"https://doi.org/10.48550/arXiv.2412.13678\"}],\"style\":\"footnote\"},{\"_key\":\"32b2d3ec5cd3\",\"_type\":\"block\",\"children\":[{\"_key\":\"3773fc8be4340\",\"_type\":\"span\",\"marks\":[],\"text\":\"3. International locations use ISO-3166-1 country codes, which includes countries and some territories.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"0f0fc8fcd7c4\",\"_type\":\"block\",\"children\":[{\"_key\":\"28b9b500c203\",\"_type\":\"span\",\"marks\":[],\"text\":\"4. Tier thresholds (quartiles) are based on countries with at least 200 observations for the global level, and on US states with at least 100 observations for the US level. Countries with no observed usage are assigned to the Minimal tier since we do not know if they have exactly zero usage or little usage that our random sample did not capture. Future work, for example using stratified sampling, will allow us to explore these patterns with higher accuracy given limited observations for smaller countries and states.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"60acc4b5e998\",\"_type\":\"block\",\"children\":[{\"_key\":\"4848f4d795cc0\",\"_type\":\"span\",\"marks\":[],\"text\":\"5. The world map is based on Natural Earth’s world map with the ISO standard point of view for disputed territories, which means that the map may not contain some disputed territories. We note that in addition to the countries shown in gray (“Claude not available”), we do not operate in the Ukrainian regions Crimea, Donetsk, Kherson, Luhansk, and Zaporizhzhia. In accordance with international sanctions and our commitment to supporting Ukraine's territorial integrity, our services are not available in areas under Russian occupation.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"718055dab075\",\"_type\":\"block\",\"children\":[{\"_key\":\"1583dcd68f3c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"6. “No data” applies to countries with partially missing data. Some territories (e.g., Western Sahara, French Guiana) have their own ISO-3611 code. Some of these have some usage, others have none. Since the Anthropic AI Usage Index is calculated per working-age capita based on working age population data from the World Bank, and population data is not readily available for all of these territories, we cannot calculate the AUI for these territories.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"6514ee0c0370\",\"_type\":\"block\",\"children\":[{\"_key\":\"8a52fff7929a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"7. When further investigating Utah’s activity, we discovered a notable fraction of its usage appeared to be possibly associated with coordinated abuse. This is also reflected in a much higher “directive” automation score than average. However, we ran robustness checks and believe that this activity is not driving the results.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"8aaa647b1667\",\"_type\":\"block\",\"children\":[{\"_key\":\"158164ce863c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"8. Requests were filtered to those that represent at least 1% of requests at the global level and 1% of the local level.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"19a0c36ea661\",\"_type\":\"block\",\"children\":[{\"_key\":\"0f38b09d27630\",\"_type\":\"span\",\"marks\":[],\"text\":\"$27\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"7dece7e9b85f\",\"_type\":\"block\",\"children\":[{\"_key\":\"c2e4324f19c90\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"de13473d971e\",\"_type\":\"block\",\"children\":[{\"_key\":\"feb7f57bfe780\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"125948210f62\",\"_type\":\"block\",\"children\":[{\"_key\":\"1b1153050833\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c1aa010d0661\",\"_type\":\"block\",\"children\":[{\"_key\":\"4964abce52620\",\"_type\":\"span\",\"marks\":[],\"text\":\"Chapter 3: API enterprise deployment of Claude\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"7d957d54882a\",\"_type\":\"block\",\"children\":[{\"_key\":\"2c4c055ecdc20\",\"_type\":\"span\",\"marks\":[],\"text\":\"Overview\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"81738f72bc61\",\"_type\":\"block\",\"children\":[{\"_key\":\"a71cd34e34ad0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Whether frontier AI capabilities make us more productive, reshape labor markets, and accelerate growth will depend on when and how firms choose to deploy AI. Even when businesses recognize the potential of AI, profitably adopting it may require costly restructuring of production processes, training new workers, and other sunk-cost investments to facilitate effective deployment.\"},{\"_key\":\"18c77627daf1\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"1\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"031085e57e0e\",\"_type\":\"block\",\"children\":[{\"_key\":\"5039f25921cf0\",\"_type\":\"span\",\"marks\":[],\"text\":\"To understand business adoption patterns of AI, we turn to a new data source: Anthropic's first-party (1P) API customers—again relying on \"},{\"_key\":\"5039f25921cf1\",\"_type\":\"span\",\"marks\":[\"378eca554cff\"],\"text\":\"privacy-preserving methods\"},{\"_key\":\"5039f25921cf2\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"},{\"_key\":\"5039998b3b34\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"2\"},{\"_key\":\"31b66e8449e3\",\"_type\":\"span\",\"marks\":[],\"text\":\" Our API allows customers to integrate Claude directly into their own products and applications, and charges by the token used, rather than a flat subscription fee. This represents a fundamentally different product experience to \"},{\"_key\":\"5039f25921cf3\",\"_type\":\"span\",\"marks\":[\"7e063091a9b0\"],\"text\":\"Claude.ai\"},{\"_key\":\"5039f25921cf4\",\"_type\":\"span\",\"marks\":[],\"text\":\", which we focused on in the previous two chapters.\"}],\"markDefs\":[{\"_key\":\"378eca554cff\",\"_type\":\"link\",\"href\":\"https://www.anthropic.com/research/clio\"},{\"_key\":\"7e063091a9b0\",\"_type\":\"link\",\"href\":\"http://claude.ai\"}],\"style\":\"normal\"},{\"_key\":\"ca149a4e6007\",\"_type\":\"block\",\"children\":[{\"_key\":\"058c263846470\",\"_type\":\"span\",\"marks\":[],\"text\":\"Institutional inertia, alongside fixed costs of adoption, suggests that early examples of enterprise use of AI is likely to be concentrated among specialized tasks where deployment is easy, capabilities are robust, and the economic benefits from adoption are high.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9b6918e6f40d\",\"_type\":\"block\",\"children\":[{\"_key\":\"258127d866cf0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Indeed, we see evidence along these lines in the data presented in this chapter. Our analysis uncovers several patterns:\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d03fdaeb1dc7\",\"_type\":\"block\",\"children\":[{\"_key\":\"107d7f15704d0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Businesses use Claude in similar but more specialized ways than individual users: \"},{\"_key\":\"107d7f15704d1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Businesses concentrate use in tasks where AI deployment is well suited to programmatic access, like coding or administrative tasks. Compared to Claude.ai users, businesses use Claude less for educational or creative tasks and in more automated ways overall.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6ab9e5c36f62\",\"_type\":\"block\",\"children\":[{\"_key\":\"261370d0c6fe0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"API customers tend to prefer higher cost tasks: \"},{\"_key\":\"261370d0c6fe1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Despite tasks varying dramatically in cost, the most expensive tasks tend to have higher usage, suggesting that model capability, ease of deployment, and economic value of automation determine adoption much more than the cost of the interaction itself. \"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"87699df12bd7\",\"_type\":\"block\",\"children\":[{\"_key\":\"fe2e901856630\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Access to appropriate contextual information is needed for sophisticated deployment: \"},{\"_key\":\"fe2e901856631\",\"_type\":\"span\",\"marks\":[],\"text\":\"We find evidence of an important potential bottleneck for the usefulness of AI for businesses. API customers that use Claude for complex tasks tend to provide Claude with lengthy inputs. This could represent a barrier to broader enterprise deployment for some important tasks that rely on dispersed context that is not already centralized or digitized. Correcting for this bottleneck may require firms to restructure their organization, invest in new data infrastructure, and centralize information for effective model deployment.\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b3e9f52df336\",\"_type\":\"block\",\"children\":[{\"_key\":\"4da474d7e0130\",\"_type\":\"span\",\"marks\":[],\"text\":\"Setting the stage: AI adoption patterns in public data\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"a19790cdea76\",\"_type\":\"block\",\"children\":[{\"_key\":\"910428f14fa40\",\"_type\":\"span\",\"marks\":[],\"text\":\"Before diving into our API data, it's worth grounding ourselves in the broader landscape of business AI adoption.According to the Census Bureau’s Business Trends and Outlook Survey, AI adoption among US firms has more than doubled in the past two years, rising from 3.7% in fall 2023 to 9.7% in early August 2025 (Figure 3.1).\"},{\"_key\":\"df4c19d10dbb\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"3\"},{\"_key\":\"3139df7c28c0\",\"_type\":\"span\",\"marks\":[],\"text\":\" Despite this rapid rate of growth, the vast majority of firms in the US do not report using AI in their production processes.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6df9bebeaf87\",\"_type\":\"block\",\"children\":[{\"_key\":\"cb58d678692d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"But these aggregate numbers mask large variation across sectors. For example, in early August 2025, one in four businesses in the Information sector reported using AI, which is roughly ten times the rate for Accommodation and Food Services.\"},{\"_key\":\"00f6f90bf962\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"4\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"19eb52ab4173\",\"_type\":\"block\",\"children\":[{\"_key\":\"1ff78ef94cf40\",\"_type\":\"span\",\"marks\":[],\"text\":\"The picture from this public data is clear: enterprise use of AI is growing rapidly, but we are still in the early stages of AI adoption. Usage remains unevenly distributed across the economy, with the sectors most able to quickly adopt and benefit from this technology doing so.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0d51016e7e20\",\"_type\":\"block\",\"children\":[{\"_key\":\"5783ebdb18d90\",\"_type\":\"span\",\"marks\":[],\"text\":\"As we will see below, our 1P API data yields a complementary conclusion: early enterprise use of Claude is likewise unevenly distributed across the economy and primarily deployed for tasks typical of Information sector occupations.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cefc08f880d0\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-79a1d9290675b8033c77e2c89b67fed2bc2db425-6950x3950-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"136bf8723661\",\"_type\":\"block\",\"children\":[{\"_key\":\"b96c763c331b0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 3.1:\"},{\"_key\":\"b96c763c331b1\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"},{\"_key\":\"b96c763c331b2\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"AI adoption rates among US firms, Business Trends \u0026 Outlook Survey (Census). \"},{\"_key\":\"b96c763c331b3\",\"_type\":\"span\",\"marks\":[],\"text\":\"Note:\"},{\"_key\":\"b96c763c331b4\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\" \"},{\"_key\":\"b96c763c331b5\",\"_type\":\"span\",\"marks\":[],\"text\":\"AI adoption rates are calculated as the share of firms responding “yes” to the question “In the last two weeks, did this business use Artificial Intelligence (AI) in producing goods or services? (Examples of AI: machine learning, natural language processing, virtual agents, voice recognition, etc.)”.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"125d02605f1b\",\"_type\":\"block\",\"children\":[{\"_key\":\"577a4ebda7b80\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 3.1: AI adoption rates among US firms, Business Trends \u0026 Outlook Survey (Census). Note: AI adoption rates are calculated as the share of firms responding “yes” to the question “In the last two weeks, did this business use Artificial Intelligence (AI) in producing goods or services? (Examples of AI: machine learning, natural language processing, virtual agents, voice recognition, etc.)”.\",\"height\":3950,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/79a1d9290675b8033c77e2c89b67fed2bc2db425-6950x3950.png\",\"width\":6950},{\"_key\":\"fa01c78b01b4\",\"_type\":\"block\",\"children\":[{\"_key\":\"18c0641d64290\",\"_type\":\"span\",\"marks\":[],\"text\":\"Specialized use among Anthropic API customers\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"da562a14f57c\",\"_type\":\"block\",\"children\":[{\"_key\":\"50327a3bf1940\",\"_type\":\"span\",\"marks\":[],\"text\":\"To analyze API traffic, we apply the same privacy-preserving classification methods from previous chapters—categorizing anonymized API transcripts by O*NET tasks and into a bottom-up taxonomy. The patterns that emerge show enterprise usage concentrated in specialized tasks particularly suited for automation.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c81c8678c81f\",\"_type\":\"block\",\"children\":[{\"_key\":\"cf5abca8880f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Overall, software development dominates the landscape. Among the top 15 use clusters—representing about half of all API traffic—the majority relate to coding and development tasks. Debugging web applications and resolving technical issues each account for roughly 6% of usage, while building professional business software represents another significant chunk. Of note, around 5% of API traffic focuses specifically on developing and evaluating AI systems themselves (Figure 3.2).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"512423c683bd\",\"_type\":\"block\",\"children\":[{\"_key\":\"f4e247fe109a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"But not all API usage is for coding. API customers also deploy Claude to create marketing materials (4.7%) and to process business \u0026 recruitment data (1.9%). These two categories reveal that AI is being deployed not just for direct production of goods and services but also for talent acquisition and external communications.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"76901e98642b\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-6b6abc82cd10d131fc92c7a016f204015efd9c2e-6964x4943-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"41462456a8b5\",\"_type\":\"block\",\"children\":[{\"_key\":\"2511598584bb0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 3.2:\"},{\"_key\":\"2511598584bb1\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"},{\"_key\":\"2511598584bb2\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Bottom-Up taxonomy of Claude usage among sampled 1P API transcripts. \"},{\"_key\":\"2511598584bb3\",\"_type\":\"span\",\"marks\":[],\"text\":\"Using privacy-preserving methods we classified 1P API transcripts into a bottom-up taxonomy reflective of underlying usage. This figure reports the leading use cases at the broadest level of this taxonomy.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7c49283303b0\",\"_type\":\"block\",\"children\":[{\"_key\":\"98876edd8c69\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 3.2: Bottom-Up taxonomy of Claude usage among sampled 1P API transcripts. Using privacy-preserving methods we classified 1P API transcripts into a bottom-up taxonomy reflective of underlying usage. This figure reports the leading use cases at the broadest level of this taxonomy.\",\"height\":4943,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/6b6abc82cd10d131fc92c7a016f204015efd9c2e-6964x4943.png\",\"width\":6964},{\"_key\":\"e0f01b16238d\",\"_type\":\"block\",\"children\":[{\"_key\":\"623ae3445e560\",\"_type\":\"span\",\"marks\":[],\"text\":\"The O*NET classification makes these patterns even clearer. Little less than half of all API traffic maps to computer and mathematical tasks—more than 8 percentage points higher than Claude.ai usage. Office and administrative tasks come second at roughly 10% of transcripts, reflecting their suitability for automation.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b487d90ddf37\",\"_type\":\"block\",\"children\":[{\"_key\":\"4e43c464e5ae0\",\"_type\":\"span\",\"marks\":[],\"text\":\"On the other hand, several interaction-heavy tasks prominent on Claude.ai have a much smaller share in API usage: education and library tasks drop from 12.3% to 3.6%, while arts and entertainment fall from 8.2% to 5.2%.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"eca5e5bff2f7\",\"_type\":\"block\",\"children\":[{\"_key\":\"2c4efe4a41450\",\"_type\":\"span\",\"marks\":[],\"text\":\"In many cases however, occupational categories are reasonably close between Claude.ai and API data, suggesting that underlying model capabilities, rather than the specific product surface, drives adoption in many instances.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1441538db511\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-230d1026eecd5b749f2a3679bdb9142b1d6a61c6-5938x3944-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"d57116df9439\",\"_type\":\"block\",\"children\":[{\"_key\":\"41d9d62e73a80\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 3.3:\"},{\"_key\":\"41d9d62e73a81\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"},{\"_key\":\"41d9d62e73a82\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Leading Occupational Categories by Overall Usage: Claude.ai vs 1P API. \"},{\"_key\":\"41d9d62e73a83\",\"_type\":\"span\",\"marks\":[],\"text\":\"After determining usage shares for tasks, we calculate the share of traffic from Claude.ai and 1P API customers assigned to top-level occupations in the O*NET taxonomy. For example, this figure shows that 44% of API traffic in our sample was matched to a task characteristic of a Computer and Mathematical occupation.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"82081906f4e2\",\"_type\":\"block\",\"children\":[{\"_key\":\"2625aeb64f430\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 3.3: Leading Occupational Categories by Overall Usage: Claude.ai vs 1P API. After determining usage shares for tasks, we calculate the share of traffic from Claude.ai and 1P API customers assigned to top-level occupations in the O*NET taxonomy. For example, this figure shows that 44% of API traffic in our sample was matched to a task characteristic of a Computer and Mathematical occupation.\",\"height\":3944,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/230d1026eecd5b749f2a3679bdb9142b1d6a61c6-5938x3944.png\",\"width\":5938},{\"_key\":\"d0b55fe6ac64\",\"_type\":\"block\",\"children\":[{\"_key\":\"111cd1c05a110\",\"_type\":\"span\",\"marks\":[],\"text\":\"Occupational segmentation vs. task specialization\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"7697d8643270\",\"_type\":\"block\",\"children\":[{\"_key\":\"c23aee2d68490\",\"_type\":\"span\",\"marks\":[],\"text\":\"Despite serving different users with different interfaces, API and Claude.ai usage follows remarkably similar power law distributions across tasks. Among Claude.ai conversations, the bottom 80% of task categories account for only 12.7% of usage; for API customers it's somewhat more concentrated at 10.5% (Figure 3.4). These extreme concentrations (Gini coefficients\"},{\"_key\":\"f1ac6780e260\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"5\"},{\"_key\":\"fa0e248ae2ff\",\"_type\":\"span\",\"marks\":[],\"text\":\" of 0.84 and 0.86) reveal massive variation in AI-task fit—the best-matched tasks see orders of magnitude more usage than poorly-matched ones.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2ca358549f73\",\"_type\":\"block\",\"children\":[{\"_key\":\"8d85e9db7e5b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"The similarity across platforms is particularly striking given their different user bases and use cases. Both converge on comparable concentration levels, suggesting a common matching process between AI capabilities and associated economic tasks.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2f530cd3322d\",\"_type\":\"block\",\"children\":[{\"_key\":\"da820f5f59d70\",\"_type\":\"span\",\"marks\":[],\"text\":\"Tasks like code generation dominate because they hit a sweet spot where model capabilities excel, deployment barriers are minimal, and employees can adopt the new technology quickly. The long tail of rarely used tasks could reflect several factors.\"},{\"_key\":\"cd0544e2382f\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"6\"},{\"_key\":\"17c6812e5a64\",\"_type\":\"span\",\"marks\":[],\"text\":\" For example, some tasks are simply less common—debugging software happens far more often than negotiating circus contracts. The extreme concentration also suggests the potential role of O-Ring\"},{\"_key\":\"5251e7f36bfe\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"7\"},{\"_key\":\"70d78d18b728\",\"_type\":\"span\",\"marks\":[],\"text\":\" forces: if a task needs a level of reasoning Claude can't handle, internal data the firm can't access, or regulatory approval that doesn't exist, any single barrier could prevent adoption.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f8a9db03e919\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-b6addfe01f1b9fc2a2a79460ce0d64deedcce7b5-7931x3812-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"7aab6d57c382\",\"_type\":\"block\",\"children\":[{\"_key\":\"9870c5021ce00\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 3.4: Visualizing concentration of usage among a small number of tasks: Claude.ai versus 1P API. \"},{\"_key\":\"9870c5021ce01\",\"_type\":\"span\",\"marks\":[],\"text\":\"The left panel of this chart calculates Lorenz curves across O*NET tasks for both our Claude.ai and 1P API samples. The highlighted points on the curves indicate how much overall usage the bottom 80% of tasks account for. The right panel plots task rank against task usage share for tasks representing at least 0.1% of overall usage in our samples. Zipf’s law, in which the coefficient of the best-fit-line is equal to -1, occurs with some regularity in various economic settings.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"83e790264616\",\"_type\":\"block\",\"children\":[{\"_key\":\"2ebccf5515ad0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 3.4: Visualizing concentration of usage among a small number of tasks: Claude.ai versus 1P API. The left panel of this chart calculates Lorenz curves across O*NET tasks for both our Claude.ai and 1P API samples. The highlighted points on the curves indicate how much overall usage the bottom 80% of tasks account for. The right panel plots task rank against task usage share for tasks representing at least 0.1% of overall usage in our samples. Zipf’s law, in which the coefficient of the best-fit-line is equal to -1, occurs with some regularity in various economic settings.\",\"height\":3812,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/b6addfe01f1b9fc2a2a79460ce0d64deedcce7b5-7931x3812.png\",\"width\":7931},{\"_key\":\"69c5df93a0b6\",\"_type\":\"block\",\"children\":[{\"_key\":\"4f3137eae8800\",\"_type\":\"span\",\"marks\":[],\"text\":\"Automation vs. augmentation among API transcripts\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"aa9ee168572e\",\"_type\":\"block\",\"children\":[{\"_key\":\"6c75b7729f730\",\"_type\":\"span\",\"marks\":[],\"text\":\"The clearest distinction between API and Claude.ai usage lies in \"},{\"_key\":\"6c75b7729f731\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"how\"},{\"_key\":\"6c75b7729f732\",\"_type\":\"span\",\"marks\":[],\"text\":\" humans and AI divide the work. When businesses embed Claude into their applications, they largely delegate individual tasks rather than collaborate iteratively with models.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2aa3d6fd85e2\",\"_type\":\"block\",\"children\":[{\"_key\":\"c0aae3701a6b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"In our data, 77% of API transcripts show automation patterns (especially full task delegation) versus just 12% for augmentation (e.g., collaborative refinement and learning). Based on a sample of conversations from Claude.ai, the split between automation and augmentation is nearly even. Looking across economic tasks, the degree of Claude automation through the API is even starker: 97% of tasks show automation-dominant patterns in API usage, compared to only 47% on Claude.ai (Figure 3.6).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"04caccf76483\",\"_type\":\"block\",\"children\":[{\"_key\":\"d8114bf871750\",\"_type\":\"span\",\"marks\":[],\"text\":\"This makes intuitive sense. Programmatic API access naturally lends itself to automation: businesses provide context, Claude executes the task, and the output flows directly to end users or downstream systems.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c10e8cdf1476\",\"_type\":\"block\",\"children\":[{\"_key\":\"7629251d9cf30\",\"_type\":\"span\",\"marks\":[],\"text\":\"This pattern echoes how economically consequential technologies become transformative: becoming embedded in systems that let workers access productivity gains without needing specialized skills. While both augmented and automated approaches enhance human capabilities, system-level automation is likely to yield both larger productivity gains across the economy as well as more significant changes in the labor market: Fully automating some tasks, changing which tasks are important for various jobs, and even producing new forms of work altogether.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4cc547b86fd2\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-21d94606a95e865db62e9a367a4900f8e1faa077-7936x3812-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"47e9aa7ffec4\",\"_type\":\"block\",\"children\":[{\"_key\":\"1d5feb6c3a310\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 3.5: Automation versus augmentation collaboration modes across O*NET tasks: Claude.ai versus 1P API. \"},{\"_key\":\"1d5feb6c3a311\",\"_type\":\"span\",\"marks\":[],\"text\":\"This figure reports the share of Claude.ai conversations and 1P API transcripts that exhibit automation or augmentation patterns of usage for each O*NET task. Automation and augmentation modes are defined in Chapter 1. When for privacy-preserving reasons we do not observe usage shares for a particular collaboration mode we give that category a value of 0% in this figure. Automation dominance is defined as a task having a greater observed share of automation usage. Likewise for augmentation dominance.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b39a7261e254\",\"_type\":\"block\",\"children\":[{\"_key\":\"7d6f5da69e720\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 3.5: Automation versus augmentation collaboration modes across O*NET tasks: Claude.ai versus 1P API. This figure reports the share of Claude.ai conversations and 1P API transcripts that exhibit automation or augmentation patterns of usage for each O*NET task. Automation and augmentation modes are defined in Chapter 1. When for privacy-preserving reasons we do not observe usage shares for a particular collaboration mode we give that category a value of 0% in this figure. Automation dominance is defined as a task having a greater observed share of automation usage. Likewise for augmentation dominance.\",\"height\":3812,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/21d94606a95e865db62e9a367a4900f8e1faa077-7936x3812.png\",\"width\":7936},{\"_key\":\"6c43ca6cfbae\",\"_type\":\"block\",\"children\":[{\"_key\":\"b5d30dd06d4a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"The more Claude does, the more Claude needs to know\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"0340e80a644d\",\"_type\":\"block\",\"children\":[{\"_key\":\"85273145b07e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Why do our API customers use Claude for some tasks more than others? Beyond fundamental model capabilities, a potentially important explanation is that it is easier to provide Claude with the information needed for successful deployment for some tasks than others.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"972b2ac34c4f\",\"_type\":\"block\",\"children\":[{\"_key\":\"d016f24c3ad90\",\"_type\":\"span\",\"marks\":[],\"text\":\"For example, if the goal is to have Claude refactor a module in a complex software development project, Claude may need to read—or at least explore—the entire codebase to understand which changes to make and where. For software development with centralized code repositories, access to this information is in principle straightforward.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"60056c32e56c\",\"_type\":\"block\",\"children\":[{\"_key\":\"fedd47e3fc5c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"For other tasks, the appropriate context might not be readily available, or it might be challenging to access. For example, asking Claude to develop a sales strategy for a key account might require Claude having access not only to information contained within a Customer Relationship Management system, but also to tacit knowledge located in the minds of account executives, marketers, and external contacts. All else equal, lacking access to such contextual information will make Claude less capable.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7be9ed69e5ab\",\"_type\":\"block\",\"children\":[{\"_key\":\"fb456263470a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"We explore this question by looking at the relationship across tasks between the average API input length (i.e., the context given to Claude) and Claude’s average output length (i.e., what the model produces in response).\"},{\"_key\":\"cd00098b36f8\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"8\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6c813636c3fd\",\"_type\":\"block\",\"children\":[{\"_key\":\"239c9d143748\",\"_type\":\"span\",\"marks\":[],\"text\":\"For each O*NET task in our sample, we calculate the average input and output length of associated API transcripts. We then divide these values by the average lengths across all tasks appearing in our sample. This produces an input token index and an output token index for each task. An index value of 1.5, for example, means that the API transcripts associated with that task are 50% longer than the average across tasks.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1be2e9aec0b1\",\"_type\":\"block\",\"children\":[{\"_key\":\"1ac2ff1b81940\",\"_type\":\"span\",\"marks\":[],\"text\":\"There is considerable variation across tasks in how long Claude’s API outputs are. For example, tasks at the 90th percentile of output length are more than 4x longer than tasks at the 10th percentile. Table 3.1 provides example O*NET tasks, along with a Claude Sonnet 4 summarization of the group of tasks at that part of the distribution.\"},{\"_key\":\"59777199367d\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"9\"},{\"_key\":\"76f5bbbbf41d\",\"_type\":\"span\",\"marks\":[],\"text\":\" Figure 3.7 shows that output length varies systematically across occupational categories as well.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"852348ce10b3\",\"_type\":\"block\",\"children\":[{\"_key\":\"b2a4f899676e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1055a1f7c4bd\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-11499cb8ed2f64f50d412964b96503b875523b16-2200x1236-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"e4451505e87c\",\"_type\":\"block\",\"children\":[{\"_key\":\"2b184b3d7e43\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Table 3.1: Example O*NET tasks with shorter and longer output lengths with Claude’s summaries. \"},{\"_key\":\"57a53a3234d2\",\"_type\":\"span\",\"marks\":[],\"text\":\"For each O*NET task matched to 1P API traffic we calculate an output token index: Dividing the average output length across transcripts associated with that task by the average (unweighted) value across all tasks in our sample. Claude was prompted to identify tasks at the 10th, 50th, and 90th percentile of the output token index distribution with the minimal guidance: “The columns should be ‘Example tasks’, ‘Index Value’, ‘Summary’ where you provide a summary”. Claude associated output length with task complexity.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Table 3.1: Example O*NET tasks with shorter and longer output lengths with Claude’s summaries. For each O*NET task matched to 1P API traffic we calculate an output token index: Dividing the average output length across transcripts associated with that task by the average (unweighted) value across all tasks in our sample. Claude was prompted to identify tasks at the 10th, 50th, and 90th percentile of the output token index distribution with the minimal guidance: “The columns should be ‘Example tasks’, ‘Index Value’, ‘Summary’ where you provide a summary”. Claude associated output length with task complexity.\",\"height\":1236,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/11499cb8ed2f64f50d412964b96503b875523b16-2200x1236.png\",\"width\":2200},{\"_key\":\"1d9de3974b3b\",\"_type\":\"block\",\"children\":[{\"_key\":\"0e79720a39510\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d3f3e2cf1d98\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-a81014f4f8a3fea424da0531ceb34e9ae4061429-5953x3943-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"492dd5d70595\",\"_type\":\"block\",\"children\":[{\"_key\":\"544bea9ba9b30\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 3.6: Average output token index across O*NET tasks among leading occupational categories. \"},{\"_key\":\"544bea9ba9b31\",\"_type\":\"span\",\"marks\":[],\"text\":\"For each O*NET task matched to 1P API traffic we calculate an output token index: Dividing the average output length across transcripts associated with that task by the average (unweighted) value across all tasks in our sample. We then average across tasks for a given top-level occupational categories in the O*NET taxonomy for top use occupational groups. ‘All Other’ combines remaining occupational groups into a single category.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0762e9252f81\",\"_type\":\"block\",\"children\":[{\"_key\":\"7a0277b9e4180\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 3.6: Average output token index across O*NET tasks among leading occupational categories. For each O*NET task matched to 1P API traffic we calculate an output token index: Dividing the average output length across transcripts associated with that task by the average (unweighted) value across all tasks in our sample. We then average across tasks for a given top-level occupational categories in the O*NET taxonomy for top use occupational groups. ‘All Other’ combines remaining occupational groups into a single category.\",\"height\":3943,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/a81014f4f8a3fea424da0531ceb34e9ae4061429-5953x3943.png\",\"width\":5953},{\"_key\":\"6b0face7c093\",\"_type\":\"block\",\"children\":[{\"_key\":\"4eff7e1cffc80\",\"_type\":\"span\",\"marks\":[],\"text\":\"What stands out from Claude’s assessment of tasks is that longer output tasks tend to represent increasingly complex uses. Of course, output length does not capture all dimensions of task complexity, but it appears to be a sensible, easily measured proxy.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"faae3bd8863f\",\"_type\":\"block\",\"children\":[{\"_key\":\"3f7912620bfe0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fe282f20a61f\",\"_type\":\"block\",\"children\":[{\"_key\":\"cb1c7b9d97140\",\"_type\":\"span\",\"marks\":[],\"text\":\"Because API customers are priced on the margin for both input tokens and output tokens, they have an incentive to optimize model prompting to minimize both input and output tokens when using Claude. In turn, any systematic relationship between input length and output produced by Claude partly captures the underlying contextual constraints in deploying Claude for sophisticated tasks. Stated differently, API customers are incentivized to only provide Claude with just enough context to accomplish their objective and no more. And so we learn about contextual requirements for tasks with varying output length.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a55393318b11\",\"_type\":\"block\",\"children\":[{\"_key\":\"e13d56428b8b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a1a9dfcd3b55\",\"_type\":\"block\",\"children\":[{\"_key\":\"fb9ce51d7d350\",\"_type\":\"span\",\"marks\":[],\"text\":\"Looking across tasks, we see a very stable relationship between how much context API customers provide to Claude and how much Claude actually produces. Across economic tasks, each 1% increase in input length is associated with a less-than-proportional 0.38% increase in output length (Figure 3.7). This elasticity of 0.38 suggests that there are strong diminishing marginal returns in translating longer contextual inputs into longer outputs for these economically useful tasks.\"},{\"_key\":\"cf83ab25bb3c\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"10\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5e14c82d9334\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-fa03325a341f62e2119fad5f56faa682f964e1a0-5929x3939-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"b996d9f4d08e\",\"_type\":\"block\",\"children\":[{\"_key\":\"7f0709d3af1c0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 3.7: Scatter plot of output token index and input token index across O*NET Tasks. \"},{\"_key\":\"7f0709d3af1c1\",\"_type\":\"span\",\"marks\":[],\"text\":\"For each O*NET task matched to 1P API traffic we calculate an output token index: Dividing the average output length across transcripts associated with that task by the average (unweighted) value across all tasks in our sample. The input token index is constructed similarly. The elasticity of 0.38 implies that each 1% increase in the input token index is associated with a 0.38% increase in the output token index.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"37980d40de12\",\"_type\":\"block\",\"children\":[{\"_key\":\"241482cc31da0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 3.7: Scatter plot of output token index and input token index across O*NET Tasks. For each O*NET task matched to 1P API traffic we calculate an output token index: Dividing the average output length across transcripts associated with that task by the average (unweighted) value across all tasks in our sample. The input token index is constructed similarly. The elasticity of 0.38 implies that each 1% increase in the input token index is associated with a 0.38% increase in the output token index.\",\"height\":3939,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/fa03325a341f62e2119fad5f56faa682f964e1a0-5929x3939.png\",\"width\":5929},{\"_key\":\"6184bd055493\",\"_type\":\"block\",\"children\":[{\"_key\":\"22aab1acabb50\",\"_type\":\"span\",\"marks\":[],\"text\":\"The upshot is that deploying AI for complex tasks might be constrained more by access to information than on underlying model capabilities. Companies that can't effectively gather and organize contextual data may struggle with sophisticated AI deployment, creating a potential bottleneck for broader enterprise adoption—particularly for occupations and in industries where tacit, diffuse knowledge is crucial to business operations.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0e31efeb9103\",\"_type\":\"block\",\"children\":[{\"_key\":\"0e69ff597008\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"655f71b0d849\",\"_type\":\"block\",\"children\":[{\"_key\":\"ea505b3df5e90\",\"_type\":\"span\",\"marks\":[],\"text\":\"Cost per task and substitution patterns across tasks\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"c87779021695\",\"_type\":\"block\",\"children\":[{\"_key\":\"929c92baf2bd0\",\"_type\":\"span\",\"marks\":[],\"text\":\"API customers pay per token, creating variation in the cost of deploying Claude for different tasks. More sophisticated tasks will tend to cost more, given their higher input and output token counts. This variation helps us explore whether cost is a major factor in determining which tasks businesses choose to automate with Claude.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"16a99b642430\",\"_type\":\"block\",\"children\":[{\"_key\":\"b5eb036b09520\",\"_type\":\"span\",\"marks\":[],\"text\":\"The data suggests it is not, at least relatively speaking.\"},{\"_key\":\"08a6e7763739\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"11\"},{\"_key\":\"38cf55da7def\",\"_type\":\"span\",\"marks\":[],\"text\":\" For example, tasks typical of computer and mathematical occupations cost more than 50% more than sales-related tasks, yet dominate usage.\"},{\"_key\":\"a09463271013\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"12\"},{\"_key\":\"c5ab7d322f8d\",\"_type\":\"span\",\"marks\":[],\"text\":\" Overall, we find a positive correlation between cost and usage: higher-cost tasks tend to have higher usage rates (Figure 3.9).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9b7e8874b9a5\",\"_type\":\"block\",\"children\":[{\"_key\":\"98337f4c95360\",\"_type\":\"span\",\"marks\":[],\"text\":\"The positive correlation between cost and usage suggests that cost plays an immaterial role in shaping patterns of enterprise AI deployment. Instead, businesses likely prioritize use in domains where model capabilities are strong and where Claude-powered automation generates enough economic value in excess of the API cost.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d6c32080c84e\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-cf5aac6a42b702f06fcd081b33c28c4f25aa0dc0-5932x3941-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"32468b8b20fd\",\"_type\":\"block\",\"children\":[{\"_key\":\"50a66b3aa0300\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 3.8: API cost per task and usage share across occupational categories. \"},{\"_key\":\"50a66b3aa0301\",\"_type\":\"span\",\"marks\":[],\"text\":\"For each O*NET task matched to 1P API traffic we calculate an API cost index: Dividing the average API cost across transcripts associated with that task by the average (unweighted) value across all tasks in our sample. This figure plots the average API cost index across tasks in a given occupational category against usage share. The estimated elasticity of 3 implies that each 1% increase in the average cost of a task is associated with a 3% increase in prevalence in our sample.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d88469c8cd80\",\"_type\":\"block\",\"children\":[{\"_key\":\"38d970b5efa90\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 3.8: API cost per task and usage share across occupational categories. For each O*NET task matched to 1P API traffic we calculate an API cost index: Dividing the average API cost across transcripts associated with that task by the average (unweighted) value across all tasks in our sample. This figure plots the average API cost index across tasks in a given occupational category against usage share. The estimated elasticity of 3 implies that each 1% increase in the average cost of a task is associated with a 3% increase in prevalence in our sample.\",\"height\":3941,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/cf5aac6a42b702f06fcd081b33c28c4f25aa0dc0-5932x3941.png\",\"width\":5932},{\"_key\":\"39f6f8b3a051\",\"_type\":\"block\",\"children\":[{\"_key\":\"5ab78a22fe720\",\"_type\":\"span\",\"marks\":[],\"text\":\"While this positive correlation holds overall, we next ask whether demand for Claude capabilities is lower among otherwise similar but costlier tasks. With the important caveat that this should be viewed as a preliminary exploration, this is what we find.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4a05776e28a6\",\"_type\":\"block\",\"children\":[{\"_key\":\"fefdac4b66b10\",\"_type\":\"span\",\"marks\":[],\"text\":\"Controlling for task characteristics, we find that each 1% cost increase is associated with a 0.29% reduction in usage frequency in our sample of API transcripts (Figure 3.10).\"},{\"_key\":\"2508111dce5b\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"13\"},{\"_key\":\"1299acebc57c\",\"_type\":\"span\",\"marks\":[],\"text\":\" While consistent with standard economic theory that higher prices lead to lower demand, the implied increase in usage to a drop in cost is limited. According to this estimate, a 10% cost reduction for a particular task would only increase usage by around 3%.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fc7ccf7959e4\",\"_type\":\"block\",\"children\":[{\"_key\":\"1689a51b8de80\",\"_type\":\"span\",\"marks\":[],\"text\":\"Other factors, beyond the cost of using Claude for particular tasks, appear to matter more for patterns of use.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"92169922a946\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-b5e7fc2931519b78a227d36c6e751466732daacf-6937x4941-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"01946e1e5b5e\",\"_type\":\"block\",\"children\":[{\"_key\":\"93694bcf37d50\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 3.9: Scatter plot of API cost per task and usage share controlling for task characteristics. \"},{\"_key\":\"93694bcf37d51\",\"_type\":\"span\",\"marks\":[],\"text\":\"For each O*NET task matched to 1P API traffic we calculate an API cost index: Dividing the average API cost across transcripts associated with that task by the average (unweighted) value across all tasks in our sample. We then restrict the sample to tasks appearing in both our 1P API and Claude.ai samples. This partial scatter plot controls for the following task-level characteristics: fixed effects for occupational category, collaboration mode share from Claude.ai, and indicators for whether a given collaboration mode was censored for privacy-preserving reasons in the Claude.ai sample. The estimated elasticity of -0.29 implies that each 1% increase in the API cost index for a given task is associated with a 0.29% decrease in prevalence in our sample, after controlling for task characteristics.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"356ad5c811d1\",\"_type\":\"block\",\"children\":[{\"_key\":\"35a556f5e9700\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"description\":\"Figure 3.9: Scatter plot of API cost per task and usage share controlling for task characteristics. For each O*NET task matched to 1P API traffic we calculate an API cost index: Dividing the average API cost across transcripts associated with that task by the average (unweighted) value across all tasks in our sample. We then restrict the sample to tasks appearing in both our 1P API and Claude.ai samples. This partial scatter plot controls for the following task-level characteristics: fixed effects for occupational category, collaboration mode share from Claude.ai, and indicators for whether a given collaboration mode was censored for privacy-preserving reasons in the Claude.ai sample. The estimated elasticity of -0.29 implies that each 1% increase in the API cost index for a given task is associated with a 0.29% decrease in prevalence in our sample, after controlling for task characteristics.\",\"height\":4941,\"markDefs\":null,\"style\":\"inline\",\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/b5e7fc2931519b78a227d36c6e751466732daacf-6937x4941.png\",\"width\":6937},{\"_key\":\"d2f20a69c198\",\"_type\":\"block\",\"children\":[{\"_key\":\"98ce22941fa80\",\"_type\":\"span\",\"marks\":[],\"text\":\"Conclusion\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"9f755a3d99d5\",\"_type\":\"block\",\"children\":[{\"_key\":\"c8dd7f1d062a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our API data captures enterprise AI adoption in its early stages: highly concentrated, automation-focused, and surprisingly price-insensitive (at least among the tasks our API customers use Claude for).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"32cee3b2bd5b\",\"_type\":\"block\",\"children\":[{\"_key\":\"6b12513c768c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"The 77% automation rate suggests enterprises use Claude to delegate tasks, rather than as a collaborative tool. Such systematic deployment is likely to be an important conduit by which AI delivers broader productivity gains within the economy. Given clear automation patterns in business deployment, this may also bring disruption in labor markets, potentially displacing those workers whose roles are most likely to face automation.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"b9fb4930d8f3\",\"_type\":\"block\",\"children\":[{\"_key\":\"315c5e27a3b50\",\"_type\":\"span\",\"marks\":[],\"text\":\"But the implications for the labor market are not entirely clear. As we document above, complex tasks require disproportionately more context. Such information may be scattered across organizations. In such conditions, workers with tacit knowledge about business operations may stand to benefit as complements to sophisticated AI-powered automation.\"},{\"_key\":\"6da01e2e9810\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"14\"},{\"_key\":\"e3f4399e3f42\",\"_type\":\"span\",\"marks\":[],\"text\":\" Understanding the uneven labor market implications of AI adoption is an important area for future research.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0255553d2b4f\",\"_type\":\"block\",\"children\":[{\"_key\":\"0b6ef24a2dda0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Businesses looking to adopt AI effectively may need to restructure how they organize and maintain the information that frontier systems rely on. Whether today's narrow, automation-heavy adoption evolves toward broader deployment will likely determine AI's future economic impacts.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"716eb95aab0e\",\"_type\":\"block\",\"children\":[{\"_key\":\"11f6d6214870\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"3b684de6b8e1\",\"_type\":\"block\",\"children\":[{\"_key\":\"53f50066cda20\",\"_type\":\"span\",\"marks\":[],\"text\":\"1. In the presence of fixed costs of adjustment, the question businesses face is not necessarily if they will adopt AI, but when. See Hall and Kahn 2003, \"},{\"_key\":\"53f50066cda21\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Adoption of New Technology\"},{\"_key\":\"53f50066cda22\",\"_type\":\"span\",\"marks\":[],\"text\":\": “The most important thing to observe about this kind of decision is that at any point in time the choice being made is not a choice between adopting and not adopting but a choice between adopting now or deferring the decision until later.”\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"f97c3fc9e7a4\",\"_type\":\"block\",\"children\":[{\"_key\":\"4086ed610bb40\",\"_type\":\"span\",\"marks\":[],\"text\":\"2. Data in this section covers 1 million transcripts from August 2025, sampled randomly from a pool of 1P API customers constituting roughly half of our 1P API usage. We continue to manage data according to our privacy and retention policies, and our analysis is consistent with our terms, policies, and contractual agreements. Each record is a prompt-response pair from our sample period which in some instances is mid-session for multi-turn interactions.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"8a87b3f916dd\",\"_type\":\"block\",\"children\":[{\"_key\":\"6c1edf8f8853\",\"_type\":\"span\",\"marks\":[],\"text\":\"3. Note that this is a different measure of adoption than in the introduction to this report. Reported adoption by consumers and employees of AI reached 40% in 2024 whereas when measured at the firm-level, nine out of ten businesses in the US report not using AI.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"ce6b8b18a035\",\"_type\":\"block\",\"children\":[{\"_key\":\"9049b742d60a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"4. The Business Trends and Outlook Survey (BTOS), published by the Census Bureau, is a reputable barometer of AI adoption by firms in the US. The survey question we use to measure AI adoption is “In the last two weeks, did this business use Artificial Intelligence (AI) in producing goods or services? (Examples of AI: machine learning, natural language processing, virtual agents, voice recognition, etc.)”. See Crane, Green, and Soto 2025\"},{\"_key\":\"0b9bb056a852\",\"_type\":\"span\",\"marks\":[\"underline\"],\"text\":\", \"},{\"_key\":\"be1ac673f835\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Measuring AI Uptake in the Workplace\"},{\"_key\":\"021767d130ff\",\"_type\":\"span\",\"marks\":[],\"text\":\" for a comparison of BTOS with other measures of overall AI adoption among firms.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"04ed7ad71a6f\",\"_type\":\"block\",\"children\":[{\"_key\":\"04fda559acb40\",\"_type\":\"span\",\"marks\":[],\"text\":\"5. The Gini coefficient is a measure used to quantify inequality within a distribution, such as the distribution of task usage. It ranges from 0 to 1, where 0 represents perfect equality (every task has exactly the same usage share) and 1 represents perfect inequality (where one task accounts for all usage, and every other task has none).\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"15696e8bd5ef\",\"_type\":\"block\",\"children\":[{\"_key\":\"e9ffba8759c40\",\"_type\":\"span\",\"marks\":[],\"text\":\"6. Power laws in economic settings are an empirical regularity with notable examples of Zipf’s law in particular. Models that generate this type of outcome feature both underlying heterogeneity and intentional, optimizing decision-making. For more, see Gabaix 2016, \"},{\"_key\":\"e5ca9b057add\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Power Laws in Economics: An Introduction.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"8ed36e67ada1\",\"_type\":\"block\",\"children\":[{\"_key\":\"02ff05efa88d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"7. Kremer 1993, \"},{\"_key\":\"6da2179da4fe\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"The O-Ring Theory of Economic Development.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"8a5281081737\",\"_type\":\"block\",\"children\":[{\"_key\":\"d3e64fa2e77f0\",\"_type\":\"span\",\"marks\":[],\"text\":\"8. API input length refers to the text in API messages, system prompts, and any additional content sent to the model, including files and datasets relevant to the task at hand. Output length refers to Claude’s generated response to an API call.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"1ff0792d5fed\",\"_type\":\"block\",\"children\":[{\"_key\":\"fc12d75744ab0\",\"_type\":\"span\",\"marks\":[],\"text\":\"9. Claude was prompted to identify tasks at the 10th, 50th, and 90th percentile of the ONET task distribution with the minimal organization of “The columns should be ‘Example tasks’, ‘Index Value’, ‘Summary’ where you provide a summary”.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"17790296e1d3\",\"_type\":\"block\",\"children\":[{\"_key\":\"d503f04150fb0\",\"_type\":\"span\",\"marks\":[],\"text\":\"10. Another contributing factor could be the degradation in performance some models experience at longer context lengths. See Liu et al, 2023, \"},{\"_key\":\"1206b24ebddb\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Lost in the Middle: How Language Models Use Long Contexts.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"644f41066229\",\"_type\":\"block\",\"children\":[{\"_key\":\"16212c545597\",\"_type\":\"span\",\"marks\":[],\"text\":\"11.\"},{\"_key\":\"c72bfa6eb3b9\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\" \"},{\"_key\":\"87a9a490aac3\",\"_type\":\"span\",\"marks\":[],\"text\":\"The question we ask in this section is whether, all else equal, cost differences across tasks shapes relative usage patterns. This is different from studying whether overall Claude usage is sensitive to external competitive pricing pressures.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"369fc0904d1f\",\"_type\":\"block\",\"children\":[{\"_key\":\"5bffa90047b30\",\"_type\":\"span\",\"marks\":[],\"text\":\"12. To see that this is the case, we first aggregate O*NET tasks that we identify in our API sample by broad occupational category to measure overall usage shares and the average cost per task in each category. As with the input and output tokens reported by O*NET task, we normalize average cost per task by the average value across tasks observed in our sample.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"1b3c4fd3830b\",\"_type\":\"block\",\"children\":[{\"_key\":\"8208c186b9d60\",\"_type\":\"span\",\"marks\":[],\"text\":\"13. Controls include fixed effects for broad occupational categories as well as collaboration mode shares by task from our concurrently sampled Claude.ai conversations. Because some tasks have censored collaboration mode shares, we also include indicators for whether that a particular mode has missing data. We restrict attention to the set of tasks identified in both our API sample and our Claude.ai samples.\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"fa1a3f2d943c\",\"_type\":\"block\",\"children\":[{\"_key\":\"33fa26c890830\",\"_type\":\"span\",\"marks\":[],\"text\":\"14. For example, see Ide and Talamaś, 2025, \"},{\"_key\":\"76e1a9022b9d\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Artificial Intelligence in the Knowledge Economy\"},{\"_key\":\"1e520006e3a0\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"94b94a65ef5d\",\"_type\":\"block\",\"children\":[{\"_key\":\"876b6cd754e80\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fdf4d89de349\",\"_type\":\"block\",\"children\":[{\"_key\":\"7eba1579ccc3\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f8167bfeb0c2\",\"_type\":\"block\",\"children\":[{\"_key\":\"e6ab4125eec30\",\"_type\":\"span\",\"marks\":[],\"text\":\"Concluding remarks\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"e1f08e27612d\",\"_type\":\"block\",\"children\":[{\"_key\":\"7d794b2445d50\",\"_type\":\"span\",\"marks\":[],\"text\":\"This third iteration of the Anthropic Economic Index report captures AI adoption at a critical juncture. Existing capabilities of Claude and other frontier AI systems are already poised to transform economic activity, given how broadly applicable the technology is. Rapidly advancing AI capabilities only reinforce the conclusion that immense change is on the horizon.And yet early AI adoption is strikingly uneven. Usage currently clusters in a small set of tasks, with strong geographic variation that is highly correlated with income—particularly across countries. Such concentration reflects where AI capabilities, ease of deployment, and economic value align: coding and data analysis have high usage, while tasks requiring dispersed context or complex regulatory navigation are further behind.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"abb495681da2\",\"_type\":\"block\",\"children\":[{\"_key\":\"2765050616b50\",\"_type\":\"span\",\"marks\":[],\"text\":\"Early business adoption of Claude is at once both similar to consumer use (coding is the most common use for both), and different in several consequential ways. In particular, with programmatic access to Claude through the API, businesses tend to use Claude with greater automation. Such systematic enterprise deployment reflects how AI is poised to reshape economic activity: increasing overall productivity, but with uncertain implications for those workers whose existing responsibilities have been automated.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cbc013953672\",\"_type\":\"block\",\"children\":[{\"_key\":\"63abbeb849290\",\"_type\":\"span\",\"marks\":[],\"text\":\"These patterns risk creating divergence. If AI's productivity gains concentrate in already-prosperous regions and automation-ready sectors, existing inequalities could widen rather than narrow. If AI automation improves the productivity of workers with tacit organizational knowledge—as some of our evidence suggests—then more experienced workers could see rising demand and higher wages even as entry-level workers face worse labor market prospects.\"},{\"_key\":\"c3e96079d1ac\",\"_type\":\"span\",\"marks\":[\"strong\",\"sup\"],\"text\":\"1\"},{\"_key\":\"830b3d14c485\",\"_type\":\"span\",\"marks\":[],\"text\":\" \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7e85a8afbbdd\",\"_type\":\"block\",\"children\":[{\"_key\":\"0edf1bbcea71\",\"_type\":\"span\",\"marks\":[],\"text\":\"Building on our previous releases, this iteration of the Index’s reports marks a significant expansion in both scope and transparency. We are now open-sourcing comprehensive API usage data alongside our existing Claude.ai consumer data (now including geographic breakdowns at state and country levels), all intersected with detailed task-level classifications.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7b7935811ccd\",\"_type\":\"block\",\"children\":[{\"_key\":\"af17414cc9d50\",\"_type\":\"span\",\"marks\":[],\"text\":\"By making this data public, we hope to enable others to investigate questions we haven't considered, test hypotheses about AI's economic impacts, and develop policy responses grounded in empirical evidence.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"26b6a295fadb\",\"_type\":\"block\",\"children\":[{\"_key\":\"af17414cc9d51\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Ultimately, the economic effects of transformative AI will be shaped as much by technical capabilities as by the policy choices societies make.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"82a052322a92\",\"_type\":\"block\",\"children\":[{\"_key\":\"821b353fcac60\",\"_type\":\"span\",\"marks\":[],\"text\":\"History shows that the patterns of technological adoption aren’t fixed: they shift as the technologies mature, as complementary innovations emerge, and as societies make deliberate choices about their deployment. The patterns of highly concentrated use that we observe today may yet evolve towards a broader distribution—one that captures more of AI’s productivity-enhancing potential, accelerates innovation in lagging sectors, and enables new forms of economic value creation. We are still in the early stages of this AI-driven economic transformation. The actions that policymakers, business leaders and the public take now will shape the years to come. We’ll continue tracking these patterns as AI capabilities advance, and provide empirical grounding for navigating one of the most significant economic transitions of our time.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a6adc8860652\",\"_type\":\"block\",\"children\":[{\"_key\":\"0df2c83109f1\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"41f33a5bbfc6\",\"_type\":\"block\",\"children\":[{\"_key\":\"efd87197f7490\",\"_type\":\"span\",\"marks\":[],\"text\":\"1. Brynjolfsson, Chandar, and Chen 2025, \"},{\"_key\":\"f9954e292851\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Canaries in the Coal Mine? Six Facts about the RecentEmployment Effects of Artificial Intelligence \"},{\"_key\":\"8644058a9f78\",\"_type\":\"span\",\"marks\":[],\"text\":\"documents clear evidence that entry-level workers with high AI exposure have had relatively worse employment prospects since late 2022. Setting aside questions of causality, the straightforward interpretation is that this is due to AI substituting for work previously done by early-career workers. An alternative interpretation is presented by Gans 2025, \"},{\"_key\":\"a45fbef73042\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"If AI and workers were strong complements, what would we see?\"},{\"_key\":\"0c79e3bb549d\",\"_type\":\"span\",\"marks\":[],\"text\":\": That relatively faster employment growth for experienced workers reflects AI making such workers more productive and thus in high demand. Whether AI compliments or substitutes work is perhaps the most important question that we hope our data will help answer.\\n\"}],\"markDefs\":[],\"style\":\"footnote\"},{\"_key\":\"8d8c1e94fe4e\",\"_type\":\"block\",\"children\":[{\"_key\":\"544ddb5f55f5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Authors and Acknowledgments\"}],\"markDefs\":[],\"style\":\"h2\"},{\"_key\":\"dfbae6d82231\",\"_type\":\"block\",\"children\":[{\"_key\":\"b3d425bdd3e8\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"274332e8151c\",\"_type\":\"block\",\"children\":[{\"_key\":\"c880f196763d0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Authors\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"4ebcadd6f719\",\"_type\":\"block\",\"children\":[{\"_key\":\"fefca06834730\",\"_type\":\"span\",\"marks\":[],\"text\":\"Ruth Appel*, Peter McCrory*, Alex Tamkin*\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"013decb92d7d\",\"_type\":\"block\",\"children\":[{\"_key\":\"f827c6b672010\",\"_type\":\"span\",\"marks\":[],\"text\":\"Miles McCain, Tyler Neylon, Michael Stern\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"794ea5db59fc\",\"_type\":\"block\",\"children\":[{\"_key\":\"d99c31b056090\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"*Lead authors. Contributed equally to this report\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"bd9c043ba445\",\"_type\":\"block\",\"children\":[{\"_key\":\"0fc783f26a340\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c457a05bcfda\",\"_type\":\"block\",\"children\":[{\"_key\":\"00a90ac3e8c90\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Acknowledgements\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"8588db0363ed\",\"_type\":\"block\",\"children\":[{\"_key\":\"f08f13e349830\",\"_type\":\"span\",\"marks\":[],\"text\":\"Helpful comments, discussions, and other assistance: Alex Sanchez, Andrew Ho, Ankur Rathi, Asa Kittner, Ben Merkel, Bianca Lindner, Biran Shah, Carl De Torres, Cecilia Callas, Daisy McGregor, Dario Amodei, Deep Ganguli, Dexter Callender III, Esin Durmus, Evan Frondorf, Heather Whitney, Jack Clark, Jakob Kerr, Janel Thamkul, Jared Kaplan, Jared Mueller, Jennifer Martinez, Kaileen Kelly, Kamya Jagadish, Katie Streu, Keir Bradwell, Kelsey Nanan, Kevin Troy, Kim O'Rourke, Kunal Handa, Landon Goldberg, Linsey Fields, Lisa Cohen, Lisa Rager, Maria Gonzalez, Mengyi Xu, Michael Sellitto, Mike Schiraldi, Olivia Chen, Paola Renteria, Rebecca Jacobs, Rebecca Lee, Ronan Davy, Ryan Donegan, Saffron Huang, Sarah Heck, Stuart Ritchie, Sylvie Carr, Tim Belonax, Tina Chin, Zoe Richards\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f9a4b3535e50\",\"_type\":\"block\",\"children\":[{\"_key\":\"83a426c33c5e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"40df2ec68588\",\"_type\":\"block\",\"children\":[{\"_key\":\"db637f96f8b70\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Citation\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"2f2f6fa81b75\",\"_type\":\"codeBlock\",\"code\":\"@online{appelmccrorytamkin2025geoapi,\\n\\nauthor = {Ruth Appel and Peter McCrory and Alex Tamkin and Michael Stern and Miles McCain and Tyler Neylon},\\n\\ntitle = {Anthropic Economic Index report: Uneven geographic and enterprise AI adoption},\\n\\ndate = {2025-09-15},\\n\\nyear = {2025},\\n\\nurl = {www.anthropic.com/research/anthropic-economic-index-september-2025-report},\\n\\n}\",\"markDefs\":null},{\"_key\":\"ee751135dd75\",\"_type\":\"block\",\"children\":[{\"_key\":\"4d3d1fabd20c\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\\n\\n\"}],\"markDefs\":[],\"style\":\"normal\"}],\"footnotes\":{\"body\":\"$1e:props:children:props:body\",\"count\":0,\"numberByListItemKey\":{},\"referenced\":\"$W28\"},\"sidebar\":{\"isVisible\":true}}]}]\n1f:[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__postFooter\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__socialShare\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://twitter.com/intent/tweet?text=https://www.anthropic.com/research/anthropic-economic-index-september-2025-report\",\"target\":\"_blank\",\"rel\":\"noopener\",\"aria-label\":\"Share on Twitter\",\"children\":[\"$\",\"$L29\",null,{}]}],[\"$\",\"a\",null,{\"href\":\"https://www.linkedin.com/shareArticle?mini=true\u0026url=https://www.anthropic.com/research/anthropic-economic-index-september-2025-report\",\"target\":\"_blank\",\"rel\":\"noopener\",\"aria-label\":\"Share on LinkedIn\",\"children\":[\"$\",\"$L2a\",null,{}]}]]}]]}]\n20:[\"$\",\"section\",null,{\"className\":\"LandingPageSection-module-scss-module__ZSMdoa__root\",\"id\":\"$undefined\",\"ref\":\"$undefined\",\"style\":\"$undefined\",\"data-theme\":\"ivory\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[[\"$\",\"div\",null,{\"className\":\"SectionIntro-module-scss-module__i9TRza__root LinkGrid-module-scss-module__wTN57W__intro\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"headline-4 SectionIntro-module-scss-module__i9TRza__title\",\"children\":\"Related content\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__root\",\"children\":[false,[\"$\",\"div\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__items LinkGrid-module-scss-module__wTN57W__threeItems\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\"Investigating unintended model actions in our evaluations and internal use\"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"This report describes examples of unintended model actions we’ve observed during evaluations and internal use of Claude. \"}],[\"$\",\"$L2b\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/investigating-unintended-model-actions\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L2c\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}],[\"$\",\"div\",\"1\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\" The missing map of the sky\"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"Brice Ménard, an astrophysicist at Johns Hopkins University and a researcher at Anthropic, explains how he worked with Claude Science to produce the first complete map of the sky in UV light.\"}],[\"$\",\"$L2b\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/the-missing-map-of-the-sky\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L2c\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LinkGrid-module-scss-module__wTN57W__item\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"headline-6\",\"children\":\"Launching an opt-in vulnerability-finding service for open-source software\"}],[\"$\",\"p\",null,{\"className\":\"body-3 serif\",\"children\":\"We’re making available OSS Scanner, an opt-in vulnerability scanner for the open-source ecosystem that’s informed by our experience using Claude to find vulnerabilities during Project Glasswing.\"}],[\"$\",\"$L2b\",null,{\"className\":\"LinkGrid-module-scss-module__wTN57W__cta\",\"link\":{\"text\":\"Read more\",\"url\":\"/research/launching-opt-in-vuln-finding-service-for-open-source\"},\"ctaPosition\":\"linkGrid\",\"icon\":[\"$\",\"$L2c\",null,{\"fill\":\"currentColor\"}],\"iconPosition\":\"right\"}]]}]]}]]}]]}]]}]\n21:null\n22:[\"$\",\"footer\",null,{\"id\":\"footer\",\"className\":\"SiteFooter-module-scss-module__JdOqwq__root\",\"role\":\"contentinfo\",\"aria-label\":\"Site footer\",\"children\":[\"$\",\"div\",null,{\"className\":\"page-wrapper SiteFooter-module-scss-module__JdOqwq__footer\",\"children\":[[\"$\",\"div\",null,{\"className\":\"SiteFooter-module-scss-module__JdOqwq__logoWrapper\",\"children\":[\"$\",\"a\",null,{\"href\":\"/\",\"aria-label\":\"Return to homepage\",\"className\":\"$undefined\",\"children\":[\"$\",\"$L2d\",null,{\"fill\":\"#faf9f5\",\"aria-hidden\":\"true\"}]}]}],[\"$\",\"nav\",null,{\"className\":\"SiteFooter-module-scss-module__JdOqwq__linksWrapper\",\"aria-label\":\"Footer navigation\",\"style\":{\"--footer-columns\":4},\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"SiteFooter-module-scss-module__JdOqwq__columnSection\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"SiteFooter-module-scss-module__JdOqwq__listSection\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"body-4 bold\",\"children\":\"Products\"}],[\"$\",\"ul\",null,{\"className\":\"SiteFooter-module-scss-module__JdOqwq__list\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://claude.com/product/overview\",\"className\":\"SiteFooter-module-scss-module__JdOqwq__listItem body-4\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"Claude\"}]}],[\"$\",\"li\",\"1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://claude.com/product/claude-code\",\"className\":\"SiteFooter-module-scss-module__JdOqwq__listItem body-4\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"Claude Code\"}]}],[\"$\",\"li\",\"2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://claude.com/product/claude-code/enterprise\",\"className\":\"SiteFooter-module-scss-module__JdOqwq__listItem body-4\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"Claude Code Enterpris