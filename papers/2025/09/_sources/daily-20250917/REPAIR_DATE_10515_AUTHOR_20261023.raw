        <section class="ah-section ah-projects" id="projects">
          <h2>Projects</h2>
          <article class="ah-project">
            <h3>RSIHub</h3>
            <p>A research framework for principled agent self-improvement under frozen evaluators and declared mutation boundaries, with verifiable lineage for reproducibility and auditing.</p>
            <div class="ah-resources"><a href="https://github.com/simple-agent-lab/RSIHub" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://simpleagentlab.com/rsihub" target="_blank" rel="noopener noreferrer">Project Page</a></div>
          </article>
          <article class="ah-project">
            <h3>Belief Context Graph</h3>
            <p>A confidence-aware belief context graph that drives more deterministic reasoning in long-horizon agents.</p>
            <div class="ah-resources"><a href="https://github.com/bigai-nlco/belief-context-graph" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://bigai-nlco.github.io/belief-context-graph/" target="_blank" rel="noopener noreferrer">Project Page</a></div>
          </article>
        </section>
