            <math id="algorithm1.m32" class="ltx_Math" alttext="res\_lines" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">res\_lines</annotation></semantics></math> <math id="algorithm1.m33" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> GetResLines(<math id="algorithm1.m34" class="ltx_math_unparsed" alttext="GCP_{1:k}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mi>C</mi><mi>P</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">GCP_{1:k}</annotation></semantics></math>);
