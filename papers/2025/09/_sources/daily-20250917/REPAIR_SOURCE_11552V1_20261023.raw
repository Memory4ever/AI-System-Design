<td id="A1.T1.7.1.2.9" class="ltx_td ltx_align_center ltx_border_r">DuReader</td></tr>
<tr id="A1.T1.7.1.3" class="ltx_tr">
<td id="A1.T1.7.1.3.1" class="ltx_td ltx_align_center ltx_border_t" colspan="10"><span id="A1.T1.7.1.3.1.1" class="ltx_text ltx_font_bold">Llama3.1-8B</span></td></tr>
