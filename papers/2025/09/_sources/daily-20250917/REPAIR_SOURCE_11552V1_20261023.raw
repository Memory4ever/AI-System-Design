<td id="A1.T1.7.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="4"><span id="A1.T1.7.1.1.2.1" class="ltx_text ltx_font_bold">Single-Doc QA</span></td>
<td id="A1.T1.7.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" colspan="4"><span id="A1.T1.7.1.1.3.1" class="ltx_text ltx_font_bold">Multi-Doc QA</span></td>
<td id="A1.T1.7.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="A1.T1.7.1.1.4.1" class="ltx_text ltx_font_bold">Avg</span></td></tr>
<tr id="A1.T1.7.1.2" class="ltx_tr">
<td id="A1.T1.7.1.2.1" class="ltx_td ltx_align_left ltx_border_r"><span id="A1.T1.7.1.2.1.1" class="ltx_text ltx_font_bold">Method</span></td>
