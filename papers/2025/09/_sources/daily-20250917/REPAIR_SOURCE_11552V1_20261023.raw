            <span id="algorithm2.4.18.2" class="ltx_text ltx_font_bold">return</span> <span id="algorithm2.4.18.3" class="ltx_text ltx_font_sansserif">ctx</span> <math id="algorithm2.m45" class="ltx_math_unparsed" alttext="[:T]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mo rspace="0.278em">:</mo><mi>T</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[:T]</annotation></semantics></math>

