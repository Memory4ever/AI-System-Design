an><span id="lstnumberx2.54" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">of</span><span id="lstnumberx2.55" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.56" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">each</span><span id="lstnumberx2.57" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.58" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">section</span><span id="lstnumberx2.59" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.60" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">and</span><span id="lstnumberx2.61" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx2.62" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">subsection</span><span id="lstnumberx2.63" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span>
