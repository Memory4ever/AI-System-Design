            <span id="algorithm2.4.16.2" class="ltx_text ltx_font_bold">if</span> <em id="algorithm2.4.16.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m43" class="ltx_Math" alttext="tk_{cur}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub></mrow><annotation encoding="application/x-tex">tk_{cur}</annotation></semantics></math> <math id="algorithm2.m44" class="ltx_Math" alttext="\geq T" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\geq T</annotation></semantics></math></em> <span id="algorithm2.4.16.4" class="ltx_text ltx_font_bold">then</span>
</div>
