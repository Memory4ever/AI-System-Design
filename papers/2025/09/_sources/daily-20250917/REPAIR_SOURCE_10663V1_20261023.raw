<span id="S1.T1.2.3.3.1.1" class="ltx_p"><span id="S1.T1.2.3.3.1.1.1" class="ltx_text" style="--ltx-bg-color:#FFCCCC;">English</span></span>
</span></td></tr>
<tr id="S1.T1.2.4" class="ltx_tr">
<td id="S1.T1.2.4.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S1.T1.2.4.1.1" class="ltx_inline-block ltx_align_top" style="width:213.9pt;">
<span id="S1.T1.2.4.1.1.1" class="ltx_p">Mac OS X Panther is a product released by <span id="S1.T1.2.4.1.1.1.1" class="ltx_text" style="--ltx-bg-color:#FFCCCC;">Google</span>. Mac OS X Panther is a product released by</span>
</span></td>
<td id="S1.T1.2.4.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S1.T1.2.4.2.1" class="ltx_inline-block ltx_align_top" style="width:44.9pt;">
<span id="S1.T1.2.4.2.1.1" class="ltx_p"><span id="S1.T1.2.4.2.1.1.1" class="ltx_text" style="--ltx-bg-color:#D9FFFF;">Apple</span></span>
</span></td>
<td id="S1.T1.2.4.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
