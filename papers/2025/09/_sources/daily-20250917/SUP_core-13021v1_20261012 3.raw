</span></span><span id="S6.T2.5.1.3.2.2" class="ltx_text"></span></span></td>
<td id="S6.T2.5.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.T2.5.1.4.1" class="ltx_text"></span><span id="S6.T2.5.1.4.2" class="ltx_text" style="font-size:90%;"> <span id="S6.T2.5.1.4.2.1" class="ltx_text">
<span id="S6.T2.5.1.4.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S6.T2.5.1.4.2.1.1.1" class="ltx_tr">
<span id="S6.T2.5.1.4.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S6.T2.5.1.4.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Llama3.1-405B</span></span></span>
<span id="S6.T2.5.1.4.2.1.1.2" class="ltx_tr">
<span id="S6.T2.5.1.4.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S6.T2.5.1.4.2.1.1.2.1.1" class="ltx_text ltx_font_bold">(VulnBot)</span></span></span>
</span></span><span id="S6.T2.5.1.4.2.2" class="ltx_text"></span></span></td>
<td id="S6.T2.5.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.T2.5.1.5.1" class="ltx_text"></span><span id="S6.T2.5.1.5.2" class="ltx_text" style="font-size:90%;"> <span id="S6.T2.5.1.5.2.1" class="ltx_text">
<span id="S6.T2.5.1.5.2.1.1" class="ltx_tabular ltx_align_middle">
<span id="S6.T2.5.1.5.2.1.1.1" class="ltx_tr">
<span id="S6.T2.5.1.5.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S6.T2.5.1.5.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Llama3.1-405B</span></span></span>
<span id="S6.T2.5.1.5.2.1.1.2" class="ltx_tr">
