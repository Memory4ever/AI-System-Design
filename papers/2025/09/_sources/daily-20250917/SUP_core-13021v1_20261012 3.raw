<span id="S2.T1.5.1.1.1.2.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t" style="padding:0.55pt 3.8pt;">PentestGPT <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite></span>
<span id="S2.T1.5.1.1.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:0.55pt 3.8pt;">SA</span>
<span id="S2.T1.5.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:0.55pt 3.8pt;">Web+Net (multi-phase)</span>
