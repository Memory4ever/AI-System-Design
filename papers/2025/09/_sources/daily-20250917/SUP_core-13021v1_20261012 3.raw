<span id="S6.T4.5.1.1.1.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">65 (6.19%)</span>
<span id="S6.T4.5.1.1.1.5.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">75 (7.14%)</span>
<span id="S6.T4.5.1.1.1.5.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">68 (6.48%)</span>
<span id="S6.T4.5.1.1.1.5.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">44 (4.19%)</span>
