<td id="Ax4.T3.2.3.5" class="ltx_td ltx_align_center"><math id="Ax4.T3.m2" class="ltx_Math" alttext="1\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-4}</annotation></semantics></math></td>
