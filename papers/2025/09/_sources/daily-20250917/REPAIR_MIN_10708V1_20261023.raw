<td id="Ax4.T3.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="Ax4.T3.2.1.2.1" class="ltx_text ltx_font_bold">LoRA Rank</span></td>
<td id="Ax4.T3.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="Ax4.T3.2.1.3.1" class="ltx_text ltx_font_bold">LoRA Alpha</span></td>
<td id="Ax4.T3.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="Ax4.T3.2.1.4.1" class="ltx_text ltx_font_bold">DeepSpeed Stage</span></td>
<td id="Ax4.T3.2.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="Ax4.T3.2.1.5.1" class="ltx_text ltx_font_bold">Learning Rate</span></td>
<td id="Ax4.T3.2.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="Ax4.T3.2.1.6.1" class="ltx_text ltx_font_bold">Dropout</span></td>
<td id="Ax4.T3.2.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="Ax4.T3.2.1.7.1" class="ltx_text ltx_font_bold">Batch Size</span></td>
<td id="Ax4.T3.2.1.8" class="ltx_td ltx_align_center ltx_border_tt"><span id="Ax4.T3.2.1.8.1" class="ltx_text ltx_font_bold">Epochs</span></td>
<td id="Ax4.T3.2.1.9" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt"><span id="Ax4.T3.2.1.9.1" class="ltx_text ltx_font_bold">Pref. <math id="Ax4.T3.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math></span></td></tr>
