<div id="algorithm1.6.22" class="ltx_listingline"><span id="algorithm1.6.22.1" class="ltx_text" style="font-size:90%;"> </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.22.2" class="ltx_text" style="font-size:90%;">   </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm1.6.22.3" class="ltx_text" style="font-size:90%;">  Select top-k experts: </span><math id="algorithm1.m20" class="ltx_Math" alttext="\{j_{1},j_{2}\}=\text{top-k}(\mathbf{p}_{d},k=2)" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">{</mo><msub><mi mathsize="0.900em">j</mi><mn mathsize="0.900em">1</mn></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">j</mi><mn mathsize="0.900em">2</mn></msub><mo maxsize="0.900em" minsize="0.900em">}</mo></mrow><mo mathsize="0.900em">=</mo><mrow><mtext mathsize="0.900em">top-k</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">𝐩</mi><mi mathsize="0.900em">d</mi></msub><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">k</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">2</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{j_{1},j_{2}\}=\text{top-k}(\mathbf{p}_{d},k=2)</annotation></semantics></math>
