an><span id="lstnumberx18.31" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;--ltx-fg-color:#FFFFFF;"> </span><span id="lstnumberx18.32" class="ltx_text ltx_font_typewriter" style="font-size:50%;--ltx-fg-color:#FFFFFF;">0</span>
