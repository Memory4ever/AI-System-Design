<td id="S4.T3.2.4.2" class="ltx_td ltx_align_center ltx_border_r"><math id="S4.T3.m6" class="ltx_Math" alttext="N=4" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">N=4</annotation></semantics></math></td>
<td id="S4.T3.2.4.3" class="ltx_td ltx_align_center ltx_border_r">69.1</td></tr>
<tr id="S4.T3.2.5" class="ltx_tr">
<td id="S4.T3.2.5.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r"><math id="S4.T3.m7" class="ltx_Math" alttext="N=2" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">N=2</annotation></semantics></math></td>
<td id="S4.T3.2.5.2" class="ltx_td ltx_align_center ltx_border_r"><math id="S4.T3.m8" class="ltx_Math" alttext="N=3" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">N=3</annotation></semantics></math></td>
<td id="S4.T3.2.5.3" class="ltx_td ltx_align_center ltx_border_r">57.9</td></tr>
<tr id="S4.T3.2.6" class="ltx_tr">
<td id="S4.T3.2.6.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r"><math id="S4.T3.m9" class="ltx_Math" alttext="N=2" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">N=2</annotation></semantics></math></td>
