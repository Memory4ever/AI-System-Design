               Compute <math id="alg2.l27.m1" class="ltx_Math" alttext="\boldsymbol{\mu}^{+}_{\mathbf{u}^{j}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝁</mi><msup><mi>𝐮</mi><mi>j</mi></msup><mo>+</mo></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mu}^{+}_{\mathbf{u}^{j}}</annotation></semantics></math> and <math id="alg2.l27.m2" class="ltx_Math" alttext="\boldsymbol{\Sigma}^{+}_{\mathbf{u}^{j},\mathbf{u}^{j}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝚺</mi><mrow><msup><mi>𝐮</mi><mi>j</mi></msup><mo>,</mo><msup><mi>𝐮</mi><mi>j</mi></msup></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">\boldsymbol{\Sigma}^{+}_{\mathbf{u}^{j},\mathbf{u}^{j}}</annotation></semantics></math> using (<a href="#S4.E38" title="In IV-C2 Weight Update ‣ IV-C Backward Pass ‣ IV Proposed Method ‣ Kalman Bayesian Transformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>), (<a href="#S4.E39" title="In IV-C2 Weight Update ‣ IV-C Backward Pass ‣ IV Proposed Method ‣ Kalman Bayesian Transformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>), and (<a href="#S4.E37" title="In IV-C2 Weight Update ‣ IV-C Backward Pass ‣ IV Proposed Method ‣ Kalman Bayesian Transformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>)

