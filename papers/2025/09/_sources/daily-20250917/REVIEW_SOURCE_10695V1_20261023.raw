               Compute <math id="alg2.l28.m1" class="ltx_Math" alttext="\boldsymbol{\mu}^{+}_{\mathbf{w}^{j}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝁</mi><msup><mi>𝐰</mi><mi>j</mi></msup><mo>+</mo></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mu}^{+}_{\mathbf{w}^{j}}</annotation></semantics></math> and <math id="alg2.l28.m2" class="ltx_Math" alttext="\boldsymbol{\Sigma}^{+}_{\mathbf{w}^{j},\mathbf{w}^{j}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝚺</mi><mrow><msup><mi>𝐰</mi><mi>j</mi></msup><mo>,</mo><msup><mi>𝐰</mi><mi>j</mi></msup></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">\boldsymbol{\Sigma}^{+}_{\mathbf{w}^{j},\mathbf{w}^{j}}</annotation></semantics></math> using (<a href="#S4.E41" title="In IV-C2 Weight Update ‣ IV-C Backward Pass ‣ IV Proposed Method ‣ Kalman Bayesian Transformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">41</span></a>), (<a href="#S4.E42" title="In IV-C2 Weight Update ‣ IV-C Backward Pass ‣ IV Proposed Method ‣ Kalman Bayesian Transformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">42</span></a>), and (<a href="#S4.E40" title="In IV-C2 Weight Update ‣ IV-C Backward Pass ‣ IV Proposed Method ‣ Kalman Bayesian Transformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>)

</div>
<div id="alg2.l29" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l29.1" class="ltx_text" style="font-size:80%;">29:</span></span>
              
               Compute <math id="alg2.l29.m1" class="ltx_Math" alttext="\boldsymbol{\mu}^{+}_{\mathbf{z}^{j-1}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝝁</mi><msup><mi>𝐳</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>+</mo></msubsup><annotation encoding="application/x-tex">\boldsymbol{\mu}^{+}_{\mathbf{z}^{j-1}}</annotation></semantics></math> and <math id="alg2.l29.m2" class="ltx_Math" alttext="\boldsymbol{\Sigma}^{+}_{\mathbf{z}^{j-1},\mathbf{z}^{j-1}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝚺</mi><mrow><msup><mi>𝐳</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo><msup><mi>𝐳</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>+</mo></msubsup><annotation encoding="application/x-tex">\boldsymbol{\Sigma}^{+}_{\mathbf{z}^{j-1},\mathbf{z}^{j-1}}</annotation></semantics></math> using (<a href="#S4.E44" title="In IV-C2 Weight Update ‣ IV-C Backward Pass ‣ IV Proposed Method ‣ Kalman Bayesian Transformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a>), (<a href="#S4.E45" title="In IV-C2 Weight Update ‣ IV-C Backward Pass ‣ IV Proposed Method ‣ Kalman Bayesian Transformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>), and (<a href="#S4.E43" title="In IV-C2 Weight Update ‣ IV-C Backward Pass ‣ IV Proposed Method ‣ Kalman Bayesian Transformer" class="ltx_ref"><span class="ltx_text ltx_ref_tag">43</span></a>)

</div>
<div id="alg2.l30" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l30.1" class="ltx_text" style="font-size:80%;">30:</span></span>
              
               <math id="alg2.l30.m1" class="ltx_Math" alttext="\boldsymbol{\mu}_{\mathbf{w}^{j}}\leftarrow\boldsymbol{\mu}^{+}_{\mathbf{w}^{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝝁</mi><msup><mi>𝐰</mi><mi>j</mi></msup></msub><mo stretchy="false">←</mo><msubsup><mi>𝝁</mi><msup><mi>𝐰</mi><mi>j</mi></msup><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">\boldsymbol{\mu}_{\mathbf{w}^{j}}\leftarrow\boldsymbol{\mu}^{+}_{\mathbf{w}^{j}}</annotation></semantics></math>

</div>
<div id="alg2.l31" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l31.1" class="ltx_text" style="font-size:80%;">31:</span></span>
              
               <math id="alg2.l31.m1" class="ltx_Math" alttext="\boldsymbol{\Sigma}_{\mathbf{w}^{j},\mathbf{w}^{j}}\leftarrow\boldsymbol{\Sigma}^{+}_{\mathbf{w}^{j},\mathbf{w}^{j}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚺</mi><mrow><msup><mi>𝐰</mi><mi>j</mi></msup><mo>,</mo><msup><mi>𝐰</mi><mi>j</mi></msup></mrow></msub><mo stretchy="false">←</mo><msubsup><mi>𝚺</mi><mrow><msup><mi>𝐰</mi><mi>j</mi></msup><mo>,</mo><msup><mi>𝐰</mi><mi>j</mi></msup></mrow><mo>+</mo></msubsup></mrow><annotation encoding="application/x-tex">\boldsymbol{\Sigma}_{\mathbf{w}^{j},\mathbf{w}^{j}}\leftarrow\boldsymbol{\Sigma}^{+}_{\mathbf{w}^{j},\mathbf{w}^{j}}</annotation></semantics></math>

</div>
<div id="alg2.l32" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l32.1" class="ltx_text" style="font-size:80%;">32:</span></span>
              
              <span id="alg2.l32.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l32.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l33" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l33.1" class="ltx_text" style="font-size:80%;">33:</span></span>
              
            <span id="alg2.l33.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l33.3" class="ltx_text ltx_font_bold">for</span>
