              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              <math id="alg2.l22.m1" class="ltx_Math" alttext="\boldsymbol{\Sigma}_{\mathbf{u}^{L},\mathbf{z}^{L}}\leftarrow\boldsymbol{\Sigma}_{\mathbf{u}^{L},\mathbf{p}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝚺</mi><mrow><msup><mi>𝐮</mi><mi>L</mi></msup><mo>,</mo><msup><mi>𝐳</mi><mi>L</mi></msup></mrow></msub><mo stretchy="false">←</mo><msub><mi>𝚺</mi><mrow><msup><mi>𝐮</mi><mi>L</mi></msup><mo>,</mo><mi>𝐩</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{\Sigma}_{\mathbf{u}^{L},\mathbf{z}^{L}}\leftarrow\boldsymbol{\Sigma}_{\mathbf{u}^{L},\mathbf{p}}</annotation></semantics></math>

</div>
<div id="alg2.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
              
              <math id="alg2.l23.m1" class="ltx_Math" alttext="[\mathbf{y}_{1},\mathbf{y}_{2},\cdots]^{T}\leftarrow\hat{\mathbf{Y}}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>𝐲</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝐲</mi><mn>2</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo></mrow><mo stretchy="false">]</mo></mrow><mi>T</mi></msup><mo stretchy="false">←</mo><mover accent="true"><mi>𝐘</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">[\mathbf{y}_{1},\mathbf{y}_{2},\cdots]^{T}\leftarrow\hat{\mathbf{Y}}</annotation></semantics></math>

</div>
<div id="alg2.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
              <math id="alg2.l24.m1" class="ltx_Math" alttext="\boldsymbol{\mu}^{+}_{\mathbf{z}^{L}}\leftarrow[(\mathbf{y}_{1})^{T},(\mathbf{y}_{2})^{T},\cdots]^{T}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝝁</mi><msup><mi>𝐳</mi><mi>L</mi></msup><mo>+</mo></msubsup><mo stretchy="false">←</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo>,</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝐲</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo></mrow><mo stretchy="false">]</mo></mrow><mi>T</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{\mu}^{+}_{\mathbf{z}^{L}}\leftarrow[(\mathbf{y}_{1})^{T},(\mathbf{y}_{2})^{T},\cdots]^{T}</annotation></semantics></math>

</div>
<div id="alg2.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
              
              <math id="alg2.l25.m1" class="ltx_Math" alttext="\boldsymbol{\Sigma}^{+}_{\mathbf{z}^{L},\mathbf{z}^{L}}\leftarrow\boldsymbol{\Sigma}_{\text{data}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝚺</mi><mrow><msup><mi>𝐳</mi><mi>L</mi></msup><mo>,</mo><msup><mi>𝐳</mi><mi>L</mi></msup></mrow><mo>+</mo></msubsup><mo stretchy="false">←</mo><msub><mi>𝚺</mi><mtext>data</mtext></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{\Sigma}^{+}_{\mathbf{z}^{L},\mathbf{z}^{L}}\leftarrow\boldsymbol{\Sigma}_{\text{data}}</annotation></semantics></math>

</div>
