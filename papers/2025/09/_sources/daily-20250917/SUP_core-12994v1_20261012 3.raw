</thead>
<tbody class="ltx_tbody">
<tr id="Sx5.T2.1.3" class="ltx_tr">
<th id="Sx5.T2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding:-1pt 4.0pt;">Qwen2.5-1.5B</th>
<td id="Sx5.T2.1.3.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-1pt 4.0pt;">0.548</td>
