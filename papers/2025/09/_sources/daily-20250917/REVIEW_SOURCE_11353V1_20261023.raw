<td id="S4.T3.6.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T3.6.1.3.3.1" class="ltx_text ltx_font_bold">+3.238<sup id="S4.T3.6.1.3.3.1.1" class="ltx_sup">*</sup></span></td>
