<td id="S4.T3.6.1.5.10" class="ltx_td ltx_align_center ltx_border_t">-0.458</td>
<td id="S4.T3.6.1.5.11" class="ltx_td ltx_align_center ltx_border_t">-0.508<sup id="S4.T3.6.1.5.11.1" class="ltx_sup">*</sup></td>
<td id="S4.T3.6.1.5.12" class="ltx_td ltx_align_center ltx_border_t">-0.670<sup id="S4.T3.6.1.5.12.1" class="ltx_sup">*</sup></td></tr>
<tr id="S4.T3.6.1.6" class="ltx_tr">
