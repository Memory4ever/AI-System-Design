<td id="S4.T1.8.4.4" class="ltx_td ltx_align_center">2.0047</td>
<td id="S4.T1.8.4.5" class="ltx_td ltx_align_center">79</td></tr>
<tr id="S4.T1.8.5" class="ltx_tr">
<td id="S4.T1.8.5.1" class="ltx_td ltx_align_left">GPT-4</td>
