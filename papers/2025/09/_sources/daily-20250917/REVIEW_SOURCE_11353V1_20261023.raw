<td id="S4.T1.8.8.3" class="ltx_td ltx_align_center"><span id="S4.T1.8.8.3.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">61</span></td>
<td id="S4.T1.8.8.4" class="ltx_td ltx_align_center">3.6871</td>
<td id="S4.T1.8.8.5" class="ltx_td ltx_align_center">81</td></tr>
