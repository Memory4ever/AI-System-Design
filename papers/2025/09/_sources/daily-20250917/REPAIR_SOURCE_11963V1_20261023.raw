<td id="S5.T3.2.1.5.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T3.2.1.5.3.1" class="ltx_text ltx_font_bold">44.0</span></td>
<td id="S5.T3.2.1.5.4" class="ltx_td ltx_align_center ltx_border_bb">72.0</td>
<td id="S5.T3.2.1.5.5" class="ltx_td ltx_align_center ltx_border_bb">63.7</td>
<td id="S5.T3.2.1.5.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T3.2.1.5.6.1" class="ltx_text ltx_font_bold">66.2</span></td>
<td id="S5.T3.2.1.5.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T3.2.1.5.7.1" class="ltx_text ltx_font_bold">73.7</span></td>
<td id="S5.T3.2.1.5.8" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T3.2.1.5.8.1" class="ltx_text ltx_font_bold">62.5</span></td></tr>
