<th id="S5.T32.2.1.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="S5.T32.2.1.1.3.1" class="ltx_text ltx_font_bold">Harm</span></th>
<th id="S5.T32.2.1.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="S5.T32.2.1.1.4.1" class="ltx_text ltx_font_bold">Specificity</span></th>
<th id="S5.T32.2.1.1.5" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="S5.T32.2.1.1.5.1" class="ltx_text ltx_font_bold">Guardrails</span></th>
<th id="S5.T32.2.1.1.6" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="S5.T32.2.1.1.6.1" class="ltx_text ltx_font_bold">How Handled</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T32.2.1.2" class="ltx_tr">
<td id="S5.T32.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">ChatGPT</td>
<td id="S5.T32.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">Low</td>
<td id="S5.T32.2.1.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">Low</td>
<td id="S5.T32.2.1.2.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">Low</td>
<td id="S5.T32.2.1.2.5" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">High</td>
