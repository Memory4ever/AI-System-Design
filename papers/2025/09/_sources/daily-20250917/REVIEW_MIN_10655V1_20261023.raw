<tr id="S4.T3.2.11" class="ltx_tr">
<td id="S4.T3.2.11.1" class="ltx_td ltx_align_center">Self-Harm</td>
<td id="S4.T3.2.11.2" class="ltx_td"></td></tr>
<tr id="S4.T3.2.12" class="ltx_tr">
<td id="S4.T3.2.12.1" class="ltx_td ltx_align_center">Sexual Content</td>
<td id="S4.T3.2.12.2" class="ltx_td"></td></tr>
<tr id="S4.T3.2.13" class="ltx_tr">
<td id="S4.T3.2.13.1" class="ltx_td ltx_align_center">CBRN Content</td>
<td id="S4.T3.2.13.2" class="ltx_td"></td></tr>
<tr id="S4.T3.2.14" class="ltx_tr">
<td id="S4.T3.2.14.1" class="ltx_td ltx_align_center">Election Integrity</td>
