<th id="S5.T37.2.1.1.6" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="S5.T37.2.1.1.6.1" class="ltx_text ltx_font_bold">Adherence</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T37.2.1.2" class="ltx_tr">
<td id="S5.T37.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">ChatGPT</td>
<td id="S5.T37.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">None</td>
