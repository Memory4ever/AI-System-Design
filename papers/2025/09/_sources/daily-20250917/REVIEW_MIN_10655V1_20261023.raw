<td id="S5.T4.2.1.2.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">High</td></tr>
<tr id="S5.T4.2.1.3" class="ltx_tr">
