<td id="S5.T4.2.1.9.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">Medium</td></tr>
<tr id="S5.T4.2.1.10" class="ltx_tr">
<td id="S5.T4.2.1.10.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">Llama 4</td>
