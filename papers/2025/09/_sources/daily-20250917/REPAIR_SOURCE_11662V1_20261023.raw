<td id="S4.T3.2.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T3.2.1.2.1" class="ltx_text ltx_font_bold">CUDA</span></td>
