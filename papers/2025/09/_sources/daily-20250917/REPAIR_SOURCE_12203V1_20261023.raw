<figure id="A2.F10" class="ltx_figure"><img src="2509.12203v1/limit2.png" id="A2.F10.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:357/201;" width="357" height="201" alt="Refer to caption">
