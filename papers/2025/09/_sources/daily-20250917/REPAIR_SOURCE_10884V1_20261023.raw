<tbody class="ltx_tbody">
<tr id="S5.T5.4.1.3" class="ltx_tr">
<th id="S5.T5.4.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">NaVILA <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite></th>
<td id="S5.T5.4.1.3.2" class="ltx_td ltx_align_center ltx_border_t">2.06</td>
