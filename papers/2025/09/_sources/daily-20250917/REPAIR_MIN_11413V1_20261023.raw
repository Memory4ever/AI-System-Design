<span id="Sx3.p3.p15.1" class="ltx_p">  "system.accelerator.total\_count": 1,</span>
</span></span></span><span id="Sx3.p3.1.16" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:80%;width:345.0pt;"><span id="Sx3.p3.1.16.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:345.0pt;">
<span id="Sx3.p3.p16" class="ltx_para ltx_noindent">
<span id="Sx3.p3.p16.1" class="ltx_p">  "system.accelerator.vendor": "NVIDIA",</span>
</span></span></span><span id="Sx3.p3.1.17" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:80%;width:345.0pt;"><span id="Sx3.p3.1.17.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="Sx3.p3.1.17.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="Sx3.p3.1.17.3" class="ltx_text ltx_inline-block" style="width:17.0pt;"> </span><span id="Sx3.p3.1.17.4" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:328.0pt;">
