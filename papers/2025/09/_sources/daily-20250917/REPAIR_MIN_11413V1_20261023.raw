</span></span></span><span id="Sx3.p3.1.15" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:80%;width:345.0pt;"><span id="Sx3.p3.1.15.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:345.0pt;">
