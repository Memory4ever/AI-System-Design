<span id="S3.T2.5.1.4.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="S3.T2.5.1.4.1.1" class="ltx_p"><span id="S3.T2.5.1.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:50%;">Examples-Java</span></span>
</span></th>
<th id="S3.T2.5.1.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt" style="padding:0.7pt 1.5pt;">
<span id="S3.T2.5.1.5.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S3.T2.5.1.5.1.1" class="ltx_p"><span id="S3.T2.5.1.5.1.1.1" class="ltx_text ltx_font_bold" style="font-size:50%;">Examples-C++</span></span>
</span></th>
<th id="S3.T2.5.1.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.7pt 1.5pt;"><span id="S3.T2.5.1.6.1" class="ltx_text ltx_font_bold" style="font-size:50%;">#Tasks</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T2.5.2" class="ltx_tr">
<td id="S3.T2.5.2.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top ltx_border_t" style="padding:0.7pt 1.5pt;">
<span id="S3.T2.5.2.1.1" class="ltx_inline-block ltx_align_top" style="width:45.5pt;">
