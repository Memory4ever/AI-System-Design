<td id="S4.T3.5.5.3" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.5.3.1" class="ltx_text" style="font-size:50%;">2025-01</span></td>
