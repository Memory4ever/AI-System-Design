<td id="S4.T3.5.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.2.5.1" class="ltx_text" style="font-size:50%;">671B</span></td>
<td id="S4.T3.5.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.2.6.1" class="ltx_text" style="font-size:50%;">Yes</span></td>
<td id="S4.T3.5.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.2.7.1" class="ltx_text" style="font-size:50%;">Yes</span></td>
<td id="S4.T3.5.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.2.8.1" class="ltx_text" style="font-size:50%;">14.8 trillion</span></td>
<td id="S4.T3.5.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.2.9.1" class="ltx_text" style="font-size:50%;">64k / 4096</span></td></tr>
<tr id="S4.T3.5.3" class="ltx_tr">
<td id="S4.T3.5.3.1" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.3.1.1" class="ltx_text" style="font-size:50%;">GPT-4o <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">Ope, 2025</a>)</cite></span></td>
<td id="S4.T3.5.3.2" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.3.2.1" class="ltx_text" style="font-size:50%;">-</span></td>
<td id="S4.T3.5.3.3" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.3.3.1" class="ltx_text" style="font-size:50%;">2024-05</span></td>
<td id="S4.T3.5.3.4" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><math id="S4.T3.m1" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo mathsize="0.500em">∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math><span id="S4.T3.5.3.4.1" class="ltx_text" style="font-size:50%;">200B <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Abacha et al., 2024</a>)</cite></span></td>
<td id="S4.T3.5.3.5" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.3.5.1" class="ltx_text" style="font-size:50%;">Yes</span></td>
<td id="S4.T3.5.3.6" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.3.6.1" class="ltx_text" style="font-size:50%;">Yes</span></td>
<td id="S4.T3.5.3.7" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.3.7.1" class="ltx_text" style="font-size:50%;">-</span></td>
