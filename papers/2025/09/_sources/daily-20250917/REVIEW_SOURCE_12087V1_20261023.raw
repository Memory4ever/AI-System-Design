<tr id="S4.T3.5.4" class="ltx_tr">
<td id="S4.T3.5.4.1" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.4.1.1" class="ltx_text" style="font-size:50%;">GPT-3.5-Turbo</span></td>
<td id="S4.T3.5.4.2" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.4.2.1" class="ltx_text" style="font-size:50%;">-</span></td>
<td id="S4.T3.5.4.3" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.4.3.1" class="ltx_text" style="font-size:50%;">2023-03</span></td>
<td id="S4.T3.5.4.4" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.4.4.1" class="ltx_text" style="font-size:50%;">-</span></td>
<td id="S4.T3.5.4.5" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.4.5.1" class="ltx_text" style="font-size:50%;">No</span></td>
<td id="S4.T3.5.4.6" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.4.6.1" class="ltx_text" style="font-size:50%;">Yes</span></td>
<td id="S4.T3.5.4.7" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.4.7.1" class="ltx_text" style="font-size:50%;">-</span></td>
<td id="S4.T3.5.4.8" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.4.8.1" class="ltx_text" style="font-size:50%;">4k / 4096</span></td></tr>
