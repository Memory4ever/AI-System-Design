<td id="S4.T3.5.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.2.2.1" class="ltx_text" style="font-size:50%;">DeepSeek-V3 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib16" title="" class="ltx_ref">DeepSeek Team, 2024</a>)</cite></span></td>
<td id="S4.T3.5.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.2.3.1" class="ltx_text" style="font-size:50%;">-</span></td>
