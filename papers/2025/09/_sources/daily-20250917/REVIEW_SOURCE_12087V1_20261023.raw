<th id="S2.T1.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.4pt 2.0pt;"><span id="S2.T1.5.1.1.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Practical</span></th>
<th id="S2.T1.5.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.4pt 2.0pt;"><span id="S2.T1.5.1.1.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Granularity</span></th>
