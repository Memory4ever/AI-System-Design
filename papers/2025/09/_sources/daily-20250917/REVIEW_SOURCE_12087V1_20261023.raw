<td id="S4.T3.5.5.5" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.5.5.1" class="ltx_text" style="font-size:50%;">Yes</span></td>
<td id="S4.T3.5.5.6" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.5.6.1" class="ltx_text" style="font-size:50%;">Yes</span></td>
<td id="S4.T3.5.5.7" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.5.7.1" class="ltx_text" style="font-size:50%;">20 trillion</span></td>
<td id="S4.T3.5.5.8" class="ltx_td ltx_align_center" style="padding-left:6.4pt;padding-right:6.4pt;"><span id="S4.T3.5.5.8.1" class="ltx_text" style="font-size:50%;">30k / 8192</span></td></tr>
