<td id="S5.T1.2.3.4" class="ltx_td ltx_align_center"><span id="S5.T1.2.3.4.1" class="ltx_text ltx_font_bold">46.4</span> (<math id="S5.T1.m4" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> 4.03%)</td></tr>
