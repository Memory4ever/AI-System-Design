<td id="S5.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t">62.2 (<math id="S5.T1.m2" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> 1.63%)</td></tr>
