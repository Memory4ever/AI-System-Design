<td id="S5.T1.2.5.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.2.5.4.1" class="ltx_text ltx_font_bold">73.84</span> (<math id="S5.T1.m8" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> 0.27%)</td></tr>
