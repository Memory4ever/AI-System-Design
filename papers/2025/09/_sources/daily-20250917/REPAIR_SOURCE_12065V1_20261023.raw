<th id="S3.T1.2.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S3.T1.2.1.2.1" class="ltx_inline-block ltx_align_top" style="width:34.5pt;">
