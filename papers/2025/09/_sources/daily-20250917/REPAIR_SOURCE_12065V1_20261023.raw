<span id="S3.T1.2.2.4.1.1" class="ltx_p ltx_align_center">0.93</span>
</span></td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<th id="S3.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;">Qwen-7B</th>
<td id="S3.T1.2.3.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-left:4.0pt;padding-right:4.0pt;">
