<figure id="A8.T10" class="ltx_table">
<table id="A8.T10.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A8.T10.2.1" class="ltx_tr">
<th id="A8.T10.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="A8.T10.2.1.1.1" class="ltx_text ltx_font_bold">Model</span></th>
<th id="A8.T10.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="A8.T10.2.1.2.1" class="ltx_text ltx_font_bold">Task</span></th>
<th id="A8.T10.2.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="A8.T10.2.1.3.1" class="ltx_text ltx_font_bold">Method</span></th>
<th id="A8.T10.2.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="A8.T10.2.1.4.1" class="ltx_text ltx_font_bold">Target</span></th>
<th id="A8.T10.2.1.5" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="A8.T10.2.1.5.1" class="ltx_text ltx_font_bold">Layer</span></th>
<th id="A8.T10.2.1.6" class="ltx_td ltx_align_left ltx_th ltx_th_column"><span id="A8.T10.2.1.6.1" class="ltx_text ltx_font_bold">Alpha</span></th></tr>
