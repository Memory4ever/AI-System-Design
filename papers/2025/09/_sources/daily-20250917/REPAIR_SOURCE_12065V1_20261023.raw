<span id="S3.T1.2.2.2.1" class="ltx_inline-block ltx_align_top" style="width:34.5pt;">
<span id="S3.T1.2.2.2.1.1" class="ltx_p ltx_align_center">1.0</span>
</span></td>
<td id="S3.T1.2.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">
<span id="S3.T1.2.2.3.1" class="ltx_inline-block ltx_align_top" style="width:44.9pt;">
<span id="S3.T1.2.2.3.1.1" class="ltx_p ltx_align_center">0.98</span>
