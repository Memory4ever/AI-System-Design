<th id="A4.T14.2.1.1.2" class="ltx_td ltx_align_center ltx_align_top ltx_th ltx_th_column ltx_border_tt"><span id="A4.T14.2.1.1.2.1" class="ltx_text ltx_font_bold">Generated</span></th>
<th id="A4.T14.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T14.2.1.1.3.1" class="ltx_text ltx_font_bold">Acc-U</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A4.T14.2.1.2" class="ltx_tr">
