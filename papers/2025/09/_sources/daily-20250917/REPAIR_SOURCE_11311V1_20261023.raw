<span id="S3.T1.2.2.2.1" class="ltx_inline-block ltx_align_top" style="width:170.7pt;">
<span id="S3.T1.2.2.2.1.1" class="ltx_p"><span id="S3.T1.2.2.2.1.1.1" class="ltx_text ltx_font_typewriter">core</span>: gender, race, ethnicity, education, income level, <span id="S3.T1.2.2.2.1.1.2" class="ltx_text ltx_font_italic">…</span></span>
</span></td></tr>
<tr id="S3.T1.2.3" class="ltx_tr">
<td id="S3.T1.2.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
