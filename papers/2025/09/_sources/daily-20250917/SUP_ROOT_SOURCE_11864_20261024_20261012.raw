<td id="S10.T8.3.1.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="S10.T8.m1" class="ltx_Math" alttext="\boldsymbol{z}=\mathbf{2}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.700em">𝒛</mi><mo mathsize="0.700em">=</mo><mn mathsize="0.700em">𝟐</mn></mrow><annotation encoding="application/x-tex">\boldsymbol{z}=\mathbf{2}</annotation></semantics></math></td>
