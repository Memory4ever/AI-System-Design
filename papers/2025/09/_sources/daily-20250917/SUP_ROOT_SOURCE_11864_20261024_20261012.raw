<td id="S7.T3.3.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="S7.T3.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Target (Fine-tuned) Model</span></td>
<td id="S7.T3.3.1.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt"><span id="S7.T3.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Fine-tuned for</span></td>
<td id="S7.T3.3.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S7.T3.3.1.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">ASR w/ SN</span></td>
<td id="S7.T3.3.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S7.T3.3.1.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">ASR w/o SN</span></td>
<td id="S7.T3.3.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="S7.T3.3.1.6.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Ratio</span></td></tr>
<tr id="S7.T3.3.2" class="ltx_tr">
<td id="S7.T3.3.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S7.T3.3.2.1.1" class="ltx_text" style="font-size:70%;">Llama-3.1-8B-Instruct</span></td>
<td id="S7.T3.3.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S7.T3.3.2.2.1" class="ltx_text" style="font-size:70%;">Llama-3.1-8B-UltraMedical</span></td>
