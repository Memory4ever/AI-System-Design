<td id="S7.T4.3.6.5" class="ltx_td ltx_align_center ltx_border_r"><math id="S7.T4.m10" class="ltx_math_unparsed" alttext="82.1\%_{{\color[rgb]{0,1,0}-4.5\%}}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.700em">82.1</mn><mo>%</mo><msub><mrow></mrow><mrow><mo style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00" mathsize="0.700em">−</mo><mrow><mn style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00" mathsize="0.700em">4.5</mn><mo>%</mo></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">82.1\%_{{\color[rgb]{0,1,0}-4.5\%}}</annotation></semantics></math></td>
