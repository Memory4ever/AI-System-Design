<td id="S10.T9.3.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S10.T9.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Gate</span></td>
<td id="S10.T9.3.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S10.T9.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Up</span></td>
<td id="S10.T9.3.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S10.T9.3.1.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Gate &amp; Up</span></td></tr>
