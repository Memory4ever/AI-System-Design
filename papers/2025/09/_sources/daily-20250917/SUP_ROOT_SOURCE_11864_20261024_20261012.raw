<td id="A1.T12.3.11.5" class="ltx_td ltx_align_center" style="padding-bottom: 5.69054pt;">81.0%</td>
<td id="A1.T12.3.11.6" class="ltx_td ltx_align_center" style="padding-bottom: 5.69054pt;">80.0%</td></tr>
<tr id="A1.T12.3.12" class="ltx_tr">
