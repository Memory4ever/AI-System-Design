<td id="S8.T5.3.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S8.T5.3.2.3.1" class="ltx_text" style="font-size:70%;">15.7%</span></td>
<td id="S8.T5.3.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S8.T5.3.2.4.1" class="ltx_text" style="font-size:70%;">54.7%</span></td></tr>
