<td id="S8.T5.3.4.2" class="ltx_td ltx_align_center"><span id="S8.T5.3.4.2.1" class="ltx_text" style="font-size:70%;">1.4%</span></td>
<td id="S8.T5.3.4.3" class="ltx_td ltx_align_center"><span id="S8.T5.3.4.3.1" class="ltx_text" style="font-size:70%;">5.3%</span></td>
<td id="S8.T5.3.4.4" class="ltx_td ltx_align_center"><span id="S8.T5.3.4.4.1" class="ltx_text" style="font-size:70%;">55.7%</span></td></tr>
