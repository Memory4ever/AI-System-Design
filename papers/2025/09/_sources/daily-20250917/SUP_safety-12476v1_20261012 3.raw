              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              <math id="alg2.l5.m1" class="ltx_Math" alttext="resp^{\prime}\leftarrow\textsc{PolishStyle}(G,\hat{resp})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>′</mo></msup></mrow><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">PolishStyle</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo>,</mo><mover accent="true"><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">resp^{\prime}\leftarrow\textsc{PolishStyle}(G,\hat{resp})</annotation></semantics></math> <span id="alg2.l5.1" class="ltx_text ltx_font_italic">// Optimize coherence, readability; stop early if F1 drops below <math id="alg2.l5.m2" class="ltx_Math" alttext="F1_{init}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msub><mn>1</mn><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">F1_{init}</annotation></semantics></math> or reward decreases</span>

</div>
