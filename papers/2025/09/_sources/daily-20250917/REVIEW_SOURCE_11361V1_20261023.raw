<tr id="S4.T3.5.1" class="ltx_tr">
<th id="S4.T3.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt">Search Strategy</th>
<th id="S4.T3.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Best F1 Score</th></tr>
</thead>
<tbody class="ltx_tbody">
