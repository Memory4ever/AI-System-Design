<tr id="S4.T1.1.8" class="ltx_tr">
<td id="S4.T1.1.8.1" class="ltx_td ltx_align_center ltx_border_t">In the Wild Texting</td>
<td id="S4.T1.1.8.2" class="ltx_td ltx_align_center ltx_border_t">age</td>
<td id="S4.T1.1.8.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.1.8.3.1" class="ltx_text ltx_font_italic">Concept Sliders</span></td>
<td id="S4.T1.1.8.4" class="ltx_td ltx_align_center ltx_border_t">21.92</td>
