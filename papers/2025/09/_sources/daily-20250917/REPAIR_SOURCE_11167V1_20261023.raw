<td id="A2.T4.5.3.2" class="ltx_td ltx_align_center">2</td>
<td id="A2.T4.5.3.3" class="ltx_td ltx_nopad_r ltx_align_center">Per GPU</td></tr>
<tr id="A2.T4.5.4" class="ltx_tr">
<td id="A2.T4.5.4.1" class="ltx_td ltx_align_left">Gradient Accumulation</td>
<td id="A2.T4.5.4.2" class="ltx_td ltx_align_center">32</td>
<td id="A2.T4.5.4.3" class="ltx_td ltx_nopad_r"></td></tr>
