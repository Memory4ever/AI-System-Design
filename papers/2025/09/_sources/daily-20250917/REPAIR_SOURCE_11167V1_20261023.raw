<td id="A2.T4.5.5.1" class="ltx_td ltx_align_left">Effective Batch Size</td>
<td id="A2.T4.5.5.2" class="ltx_td ltx_align_center">128</td>
<td id="A2.T4.5.5.3" class="ltx_td ltx_nopad_r ltx_align_center">Across GPUs</td></tr>
<tr id="A2.T4.5.6" class="ltx_tr">
<td id="A2.T4.5.6.1" class="ltx_td ltx_align_left">Max Token Length</td>
<td id="A2.T4.5.6.2" class="ltx_td ltx_align_center">4096</td>
<td id="A2.T4.5.6.3" class="ltx_td ltx_nopad_r"></td></tr>
<tr id="A2.T4.5.7" class="ltx_tr">
<td id="A2.T4.5.7.1" class="ltx_td ltx_align_left">Learning Rate</td>
<td id="A2.T4.5.7.2" class="ltx_td ltx_align_center"><math id="A2.T4.m1" class="ltx_Math" alttext="5\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5\times 10^{-6}</annotation></semantics></math></td>
<td id="A2.T4.5.7.3" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A2.T4.m2" class="ltx_Math" alttext="1\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-5}</annotation></semantics></math> for Precise IF</td></tr>
