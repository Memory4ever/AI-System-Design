</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S5.F7.fig3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.11167v1/Figures/curvature_heatmaps/layers_11_self_attn_v_proj_exp_avg_sq_model_1_code_weights_heatmap.jpg" id="S5.F7.g3" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/381;" width="476" height="381" alt="Refer to caption">
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
