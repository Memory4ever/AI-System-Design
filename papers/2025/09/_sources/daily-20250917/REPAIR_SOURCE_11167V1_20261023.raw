<figure id="A3.F14.fig7" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.11167v1/Figures/curvature_heatmaps/layers_11_mlp_gate_proj_exp_avg_sq_max-min_weight_ratio_heatmap_linear_code_vs_code2.png" id="A3.F14.g7" class="ltx_graphics ltx_img_square" style="aspect-ratio:476/443;" width="476" height="443" alt="Refer to caption">
