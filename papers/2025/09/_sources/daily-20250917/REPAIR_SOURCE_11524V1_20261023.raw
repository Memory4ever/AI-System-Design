<td id="S3.T1.4.1.1.2" class="ltx_td ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"></td>
<td id="S3.T1.4.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;" colspan="6">CDs</td>
<td id="S3.T1.4.1.1.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;" colspan="6">Games</td></tr>
<tr id="S3.T1.4.1.2" class="ltx_tr">
<td id="S3.T1.4.1.2.1" class="ltx_td ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"></td>
<td id="S3.T1.4.1.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">Model</td>
<td id="S3.T1.4.1.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">R@20</td>
<td id="S3.T1.4.1.2.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">R@50</td>
<td id="S3.T1.4.1.2.5" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">R@100</td>
<td id="S3.T1.4.1.2.6" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">N@20</td>
<td id="S3.T1.4.1.2.7" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">N@50</td>
<td id="S3.T1.4.1.2.8" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">N@100</td>
<td id="S3.T1.4.1.2.9" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">R@20</td>
<td id="S3.T1.4.1.2.10" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">R@50</td>
<td id="S3.T1.4.1.2.11" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">R@100</td>
<td id="S3.T1.4.1.2.12" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">N@20</td>
<td id="S3.T1.4.1.2.13" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">N@50</td>
<td id="S3.T1.4.1.2.14" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">N@100</td></tr>
<tr id="S3.T1.4.1.3" class="ltx_tr">
<td id="S3.T1.4.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;" rowspan="2"><span id="S3.T1.4.1.3.1.1" class="ltx_text">Traditional</span></td>
<td id="S3.T1.4.1.3.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">SASRec</td>
<td id="S3.T1.4.1.3.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.1015</td>
<td id="S3.T1.4.1.3.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.1271</td>
<td id="S3.T1.4.1.3.5" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.1522</td>
<td id="S3.T1.4.1.3.6" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.0602</td>
<td id="S3.T1.4.1.3.7" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.0653</td>
<td id="S3.T1.4.1.3.8" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.0693</td>
<td id="S3.T1.4.1.3.9" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.0684</td>
<td id="S3.T1.4.1.3.10" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.1117</td>
<td id="S3.T1.4.1.3.11" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.1564</td>
<td id="S3.T1.4.1.3.12" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.0332</td>
<td id="S3.T1.4.1.3.13" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">0.0417</td>
