<td id="S4.T6.fig2.1.3.2" class="ltx_td ltx_align_left ltx_border_t"><math id="S4.T6.m3" class="ltx_Math" alttext="0.319" display="inline" intent=":literal"><semantics><mn>0.319</mn><annotation encoding="application/x-tex">0.319</annotation></semantics></math></td>
<td id="S4.T6.fig2.1.3.3" class="ltx_td ltx_align_left ltx_border_t"><math id="S4.T6.m4" class="ltx_Math" alttext="0.156" display="inline" intent=":literal"><semantics><mn>0.156</mn><annotation encoding="application/x-tex">0.156</annotation></semantics></math></td></tr>
