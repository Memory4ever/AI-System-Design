</span></th>
<th id="S4.T8.2.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_r ltx_border_t">
<span id="S4.T8.2.1.3.1" class="ltx_inline-block ltx_align_top" style="width:35.0pt;">
<span id="S4.T8.2.1.3.1.1" class="ltx_p"><span id="S4.T8.2.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Effective</span></span>
</span></th></tr>
