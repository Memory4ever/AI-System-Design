<span id="S6.T1.8.1.1.2.1.1" class="ltx_inline-block">
<span id="S6.T1.8.1.1.2.1.1.1" class="ltx_p"><math id="S6.T1.m3" class="ltx_Math" alttext="k_{ratio}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi></mrow></msub><annotation encoding="application/x-tex">k_{ratio}</annotation></semantics></math></span>
