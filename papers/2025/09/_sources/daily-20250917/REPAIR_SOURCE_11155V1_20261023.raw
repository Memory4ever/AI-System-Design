<td id="S6.T1.8.1.3.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="4"><span id="S6.T1.8.1.3.1.1" class="ltx_text">
<span id="S6.T1.8.1.3.1.1.1" class="ltx_inline-block">
<span id="S6.T1.8.1.3.1.1.1.1" class="ltx_p">Llama-3.1-8B</span>
<span id="S6.T1.8.1.3.1.1.1.2" class="ltx_p">Instruct</span>
</span></span></td>
<td id="S6.T1.8.1.3.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S6.T1.8.1.3.2.1" class="ltx_text ltx_font_bold">B</span></td>
<td id="S6.T1.8.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T1.m11" class="ltx_Math" alttext="\bm{0.687\pm 0.004}" display="inline" intent=":literal"><semantics><mrow><mn class="ltx_mathvariant_bold" mathvariant="bold">0.687</mn><mo class="ltx_mathvariant_bold" mathvariant="bold">±</mo><mn class="ltx_mathvariant_bold" mathvariant="bold">0.004</mn></mrow><annotation encoding="application/x-tex">\bm{0.687\pm 0.004}</annotation></semantics></math></td>
