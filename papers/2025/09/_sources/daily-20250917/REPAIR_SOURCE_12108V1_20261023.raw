<td id="S5.T3.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.8pt;padding-right:3.8pt;">58.60</td>
<td id="S5.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.8pt;padding-right:3.8pt;">57.42</td>
<td id="S5.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.8pt;padding-right:3.8pt;">61.58</td></tr>
<tr id="S5.T3.2.3" class="ltx_tr">
<th id="S5.T3.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b" style="padding-left:3.8pt;padding-right:3.8pt;">F<sub id="S5.T3.2.3.1.1" class="ltx_sub">1</sub></th>
<td id="S5.T3.2.3.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:3.8pt;padding-right:3.8pt;">57.05</td>
<td id="S5.T3.2.3.3" class="ltx_td ltx_align_center ltx_border_b" style="padding-left:3.8pt;padding-right:3.8pt;">56.52</td>
