<th id="S5.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:3.8pt;padding-right:3.8pt;">GRPO</th>
<th id="S5.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:3.8pt;padding-right:3.8pt;">GTA (RL)</th>
<th id="S5.T3.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:3.8pt;padding-right:3.8pt;">GTA (SFT+RL)</th></tr>
</thead>
