<figure id="S5.F6.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.12108v1/test_sst5_3b-eps-converted-to.svg" id="S5.F6.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/318;" width="476" height="318"></object>
