<td id="A9.T3.2.1.7.6" class="ltx_td ltx_align_center ltx_border_bb">+0.16 <math id="A9.T3.m32" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#00FF00;" mathcolor="#00FF00" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="A9.T3.2.1.7.7" class="ltx_td ltx_align_center ltx_border_bb">0.0</td>
