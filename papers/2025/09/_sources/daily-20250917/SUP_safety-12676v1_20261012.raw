<td id="S6.T4.2.3.3" class="ltx_td ltx_align_center"><span id="S6.T4.2.3.3.1" class="ltx_text" style="font-size:80%;">74.27</span></td>
<td id="S6.T4.2.3.4" class="ltx_td ltx_align_center"><span id="S6.T4.2.3.4.1" class="ltx_text" style="font-size:80%;">6.82<math id="S6.T4.m3" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></td></tr>
<tr id="S6.T4.2.4" class="ltx_tr">
<th id="S6.T4.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S6.T4.2.4.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Decision Tree</span></th>
<td id="S6.T4.2.4.2" class="ltx_td ltx_align_center"><span id="S6.T4.2.4.2.1" class="ltx_text" style="font-size:80%;">2794.60</span></td>
<td id="S6.T4.2.4.3" class="ltx_td ltx_align_center"><span id="S6.T4.2.4.3.1" class="ltx_text" style="font-size:80%;">409.19</span></td>
<td id="S6.T4.2.4.4" class="ltx_td ltx_align_center"><span id="S6.T4.2.4.4.1" class="ltx_text" style="font-size:80%;">6.83<math id="S6.T4.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></td></tr>
<tr id="S6.T4.2.5" class="ltx_tr">
