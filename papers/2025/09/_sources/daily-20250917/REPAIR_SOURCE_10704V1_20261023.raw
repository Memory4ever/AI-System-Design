<td id="S4.T1.5.1.3.2" class="ltx_td ltx_align_left ltx_border_t">0.826<sub id="S4.T1.5.1.3.2.1" class="ltx_sub"><math id="S4.T1.m11" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.17</sub></td>
