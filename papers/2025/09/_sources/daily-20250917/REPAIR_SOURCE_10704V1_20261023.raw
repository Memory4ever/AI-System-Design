          <span id="alg1.l6.3" class="ltx_text" style="font-size:80%;">   </span><span id="alg1.l6.4" class="ltx_text ltx_font_bold" style="font-size:80%;">(§<a href="#S3.SS3" title="3.3 Generating New Prompt Proposals (Blocks 7-9) ‣ 3 Methodology ‣ Maestro: Self-Improving Text-to-Image Generation via Agent Orchestration" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>)</span><span id="alg1.l6.5" class="ltx_text" style="font-size:80%;"> Generate new prompt proposals with targeted editing and/or implicit improvements: </span><math id="alg1.l6.m1" class="ltx_math_unparsed" alttext="p^{(t)}\leftarrow\texttt{TargetedEdit}_{\text{LLM}}(p^{*}_{:t-1},Q,R^{*}_{:t-1})\cup\texttt{ImpImprove}_{\text{MLLM}}(p^{*}_{:t-1},p_{u},I^{*}_{:t-1})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathsize="0.800em">p</mi><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">t</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></msup><mo mathsize="0.800em" stretchy="false">←</mo><msub><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">TargetedEdit</mtext><mtext mathsize="0.800em">LLM</mtext></msub><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msubsup><mi mathsize="0.800em">p</mi><mrow><mphantom></mphantom><mo lspace="0.278em" mathsize="0.800em" rspace="0.278em">:</mo><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow></mrow><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">Q</mi><mo mathsize="0.800em">,</mo><msubsup><mi mathsize="0.800em">R</mi><mrow><mphantom></mphantom><mo lspace="0.278em" mathsize="0.800em" rspace="0.278em">:</mo><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow></mrow><mo mathsize="0.800em">∗</mo></msubsup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∪</mo><msub><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">ImpImprove</mtext><mtext mathsize="0.800em">MLLM</mtext></msub><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msubsup><mi mathsize="0.800em">p</mi><mrow><mphantom></mphantom><mo lspace="0.278em" mathsize="0.800em" rspace="0.278em">:</mo><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow></mrow><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">p</mi><mi mathsize="0.800em">u</mi></msub><mo mathsize="0.800em">,</mo><msubsup><mi mathsize="0.800em">I</mi><mrow><mphantom></mphantom><mo lspace="0.278em" mathsize="0.800em" rspace="0.278em">:</mo><mrow><mi mathsize="0.800em">t</mi><mo mathsize="0.800em">−</mo><mn mathsize="0.800em">1</mn></mrow></mrow><mo mathsize="0.800em">∗</mo></msubsup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><annotation encoding="application/x-tex">p^{(t)}\leftarrow\texttt{TargetedEdit}_{\text{LLM}}(p^{*}_{:t-1},Q,R^{*}_{:t-1})\cup\texttt{ImpImprove}_{\text{MLLM}}(p^{*}_{:t-1},p_{u},I^{*}_{:t-1})</annotation></semantics></math><span id="alg1.l6.6" class="ltx_text" style="font-size:80%;">
</span>
