ation encoding="application/x-tex">p^{(0)}\leftarrow\texttt{Init}_{\text{LLM}}(p_{u})</annotation></semantics></math><span id="alg1.l4.7" class="ltx_text" style="font-size:80%;"> and set </span><math id="alg1.l4.m3" class="ltx_math_unparsed" alttext="\{p^{*}_{:t},I^{*}_{:t}\}\leftarrow\texttt{None}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msubsup><mi mathsize="0.800em">p</mi><mrow><mphantom></mphantom><mo lspace="0.278em" mathsize="0.800em" rspace="0.278em">:</mo><mi mathsize="0.800em">t</mi></mrow><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><msubsup><mi mathsize="0.800em">I</mi><mrow><mphantom></mphantom><mo lspace="0.278em" mathsize="0.800em" rspace="0.278em">:</mo><mi mathsize="0.800em">t</mi></mrow><mo mathsize="0.800em">∗</mo></msubsup><mo stretchy="false">}</mo></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">None</mtext></mrow><annotation encoding="application/x-tex">\{p^{*}_{:t},I^{*}_{:t}\}\leftarrow\texttt{None}</annotation></semantics></math><span id="alg1.l4.8" class="ltx_text" style="font-size:80%;">.
