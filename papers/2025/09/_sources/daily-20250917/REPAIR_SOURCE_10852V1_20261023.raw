<span id="A4.T6.2.1.3.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:8.8pt;height:37.5pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:37.5pt;transform:translate(-14.4pt,-14.4pt) rotate(-90deg) ;">
