<td id="A3.T4.2.1.5.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T4.2.1.5.2.1" class="ltx_text ltx_font_bold">72.7</span></td>
<td id="A3.T4.2.1.5.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T4.2.1.5.3.1" class="ltx_text ltx_font_bold">4.3</span></td>
