<th id="Sx4.T3.7.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="Sx4.T3.7.1.2.1" class="ltx_text ltx_font_bold">L–R Cons.</span></th>
<th id="Sx4.T3.7.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="Sx4.T3.7.1.3.1" class="ltx_text ltx_font_bold">Front</span></th>
