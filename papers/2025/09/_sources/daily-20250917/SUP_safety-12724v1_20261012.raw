<span id="S4.T2.4.1.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt">Attack Models</span>
<span id="S4.T2.4.1.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Vanilla Attack</span>
<span id="S4.T2.4.1.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Ours</span></span>
</span>
<span class="ltx_tbody">
<span id="S4.T2.4.1.1.1.2" class="ltx_tr">
<span id="S4.T2.4.1.1.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t ltx_rowspan ltx_rowspan_3"><span id="S4.T2.4.1.1.1.2.1.1" class="ltx_text">Harmful-Instruction</span></span>
<span id="S4.T2.4.1.1.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">Gemini (LLaVA)</span>
<span id="S4.T2.4.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">5.00</span>
<span id="S4.T2.4.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.1.1.2.4.1" class="ltx_text ltx_font_bold">45.00</span></span></span>
<span id="S4.T2.4.1.1.1.3" class="ltx_tr">
