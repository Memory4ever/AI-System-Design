</figcaption>
</figure>
<figure id="A5.F10" class="ltx_figure"><img src="2509.12132v1/case3.png" id="A5.F10.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:476/686;" width="476" height="686" alt="Refer to caption">
