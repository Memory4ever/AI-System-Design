<td id="S3.T1.2.7.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.25pt 4.0pt;"><sup id="S3.T1.2.7.6.1" class="ltx_sup">†</sup>55.6</td>
<td id="S3.T1.2.7.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.25pt 4.0pt;">45.1</td></tr>
<tr id="S3.T1.2.8" class="ltx_tr">
