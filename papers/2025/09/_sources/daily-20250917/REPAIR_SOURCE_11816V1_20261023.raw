<mi>d</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\color[rgb]{0,0.392,0}pure\_grads}=\text{CIR}({\color[rgb]{1,0.5,0}grads},PCs_{grad})</annotation></semantics></math>
<span id="alg1.l7.2" class="ltx_text" style="float:right;"><span id="alg1.l7.2.1" class="ltx_text">Collapse irrelevant gradient components</span>
</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
                 <math id="alg1.l8.m1" class="ltx_Math" alttext="model\mathrel{-}=LR\cdot einsum({\color[rgb]{0,0.392,0}pure\_acts},{\color[rgb]{0,0.392,0}pure\_grads})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo lspace="0.278em" rspace="0.278em">-</mo><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>e</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">p</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">u</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">r</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">_</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">a</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">c</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">s</mi></mrow><mo>,</mo><mrow><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">p</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">u</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">r</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">_</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">g</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">r</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">a</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#006400;" mathcolor="#006400">s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">model\mathrel{-}=LR\cdot einsum({\color[rgb]{0,0.392,0}pure\_acts},{\color[rgb]{0,0.392,0}pure\_grads})</annotation></semantics></math>
<span id="alg1.l8.2" class="ltx_text" style="float:right;"><span id="alg1.l8.2.1" class="ltx_text">Calculate and apply update</span>
</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
                 Optionally train on a retain batch

</div>
