<th id="S5.T1.4.15.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b"><span id="S5.T1.4.15.1.1" class="ltx_text ltx_font_bold">HARP(Ours)</span></th>
<th id="S5.T1.4.15.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b ltx_border_r"><math id="S5.T1.m14" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi>✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></th>
