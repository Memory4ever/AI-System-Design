<td id="S3.T2.10.1.16.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.10.1.16.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F2F2F2;">6.45</span></td>
