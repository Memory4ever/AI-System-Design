<td id="A4.T6.14.1.7.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T6.14.1.7.7.1" class="ltx_text ltx_font_bold">3.13</span></td>
<td id="A4.T6.14.1.7.8" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T6.14.1.7.8.1" class="ltx_text ltx_underline">3.63</span></td>
