<span id="S1.T1.2.11.6.1" class="ltx_inline-block ltx_align_top" style="width:12.8pt;">
<span id="S1.T1.2.11.6.1.1" class="ltx_p ltx_align_center">✓</span>
</span></td>
<td id="S1.T1.2.11.7" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">
<span id="S1.T1.2.11.7.1" class="ltx_inline-block ltx_align_top" style="width:12.8pt;">
<span id="S1.T1.2.11.7.1.1" class="ltx_p ltx_align_center">✓</span>
