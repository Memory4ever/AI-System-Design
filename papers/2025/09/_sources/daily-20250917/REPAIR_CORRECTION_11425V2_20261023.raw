<td id="S1.T1.2.11.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">✓</td>
<td id="S1.T1.2.11.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">
<span id="S1.T1.2.11.5.1" class="ltx_inline-block ltx_align_top" style="width:12.8pt;">
