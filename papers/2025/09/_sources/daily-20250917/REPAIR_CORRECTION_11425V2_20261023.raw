<td id="S3.T2.10.1.16.9" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.10.1.16.9.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">0.995</span></td></tr>
