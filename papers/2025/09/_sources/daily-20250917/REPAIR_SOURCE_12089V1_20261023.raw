<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS2.6" class="ltx_text">IV-B</span> </span><span id="S4.SS2.7" class="ltx_text ltx_font_italic">Comparison of Detection Performance, Speed, and Network Parameters Under Sufficient Training Samples</span></h3>

<figure id="S4.F7" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<div id="S4.F7.2" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:165.6pt;"><object type="image/svg+xml" data="2509.12089v1/HH.svg" id="S4.F7.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:229/170;" width="229" height="170"></object>
<p id="S4.F7.2.1" class="ltx_p ltx_align_center"><span id="S4.F7.2.1.1" class="ltx_text ltx_font_bold">(1). HH</span></p>
</div></div><div class="ltx_flex_cell ltx_flex_size_2">
<div id="S4.F7.3" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:165.6pt;"><object type="image/svg+xml" data="2509.12089v1/HV.svg" id="S4.F7.g2" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:229/170;" width="229" height="170"></object>
<p id="S4.F7.3.1" class="ltx_p ltx_align_center"><span id="S4.F7.3.1.1" class="ltx_text ltx_font_bold">(2). HV</span></p>
