<td id="A1.T9.2.2.2" class="ltx_td ltx_align_left ltx_border_t">Aesop</td>
<td id="A1.T9.2.2.3" class="ltx_td ltx_align_left ltx_border_t"><a href="https://www.gutenberg.org/files/19994/19994-h/19994-h.htm" title="" class="ltx_ref ltx_href">Project Gutenberg</a></td></tr>
<tr id="A1.T9.2.3" class="ltx_tr">
<td id="A1.T9.2.3.1" class="ltx_td ltx_align_left"><span id="A1.T9.2.3.1.1" class="ltx_text ltx_font_italic">Aesop Fables</span></td>
<td id="A1.T9.2.3.2" class="ltx_td ltx_align_left">Aesop / G. F. Townsend</td>
<td id="A1.T9.2.3.3" class="ltx_td ltx_align_left"><a href="https://www.gutenberg.org/files/21/21-h/21-h.htm" title="" class="ltx_ref ltx_href">Project Gutenberg</a></td></tr>
<tr id="A1.T9.2.4" class="ltx_tr">
<td id="A1.T9.2.4.1" class="ltx_td ltx_align_left"><span id="A1.T9.2.4.1.1" class="ltx_text ltx_font_italic">The fables of Aesop</span></td>
<td id="A1.T9.2.4.2" class="ltx_td ltx_align_left">Aesop / Croxall, La Fontaine, L’Estrange</td>
