<th id="A1.T9.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">Author / Translator</th>
<th id="A1.T9.2.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">Source link</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T9.2.2" class="ltx_tr">
