<div id="A4.T14.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:182.9pt;height:32.8pt;vertical-align:-14.2pt;"><span class="ltx_transformed_inner" style="transform:translate(-12.5pt,2.2pt) scale(0.9,0.9) ;">
