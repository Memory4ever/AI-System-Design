<td id="A5.T16.2.1.7.2" class="ltx_td ltx_align_center">78.0 <math id="A5.T16.m10" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.4</td>
<td id="A5.T16.2.1.7.3" class="ltx_td ltx_align_center">84.0 <math id="A5.T16.m11" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.5</td>
