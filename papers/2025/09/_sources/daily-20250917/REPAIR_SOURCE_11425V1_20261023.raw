<th id="S7.T7.8.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">ViSQOL<math id="S7.T7.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S7.T7.8.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">PESQ<math id="S7.T7.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S7.T7.8.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">UTMOS<math id="S7.T7.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
