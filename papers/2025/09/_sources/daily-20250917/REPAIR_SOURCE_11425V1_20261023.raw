<td id="S5.T2.2.1.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S5.T2.2.1.3.7.1" class="ltx_text ltx_underline">0.78</span></td>
<td id="S5.T2.2.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">2.93</td>
