<td id="S7.T7.8.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T7.8.1.3.6.1" class="ltx_text ltx_font_bold">3.18</span></td>
<td id="S7.T7.8.1.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T7.8.1.3.7.1" class="ltx_text ltx_font_bold">2.85</span></td>
<td id="S7.T7.8.1.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T7.8.1.3.8.1" class="ltx_text ltx_font_bold">3.65</span></td>
