<td id="S3.T6.3.4.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S3.T6.3.4.3.1" class="ltx_text ltx_font_italic">94.9</span></td>
<td id="S3.T6.3.4.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S3.T6.3.4.4.1" class="ltx_text ltx_font_italic">66.7</span></td></tr>
<tr id="S3.T6.3.5" class="ltx_tr">
