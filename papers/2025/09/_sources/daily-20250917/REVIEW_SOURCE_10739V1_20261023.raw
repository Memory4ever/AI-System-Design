<td id="A7.T6.7.3.5" class="ltx_td ltx_align_center" style="padding:1.3pt 7.0pt;"><span id="A7.T6.7.3.5.1" class="ltx_text" style="font-size:80%;">0.28</span></td></tr>
<tr id="A7.T6.7.4" class="ltx_tr">
