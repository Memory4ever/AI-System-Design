</span><span class="ltx_author_notes"><span class="ltx_author_notes_content">
<span class="ltx_contact ltx_role_email"><span class="ltx_contact_name">Email: </span><a href="mailto:mganti@cs.washington.edu">mganti@cs.washington.edu</a>
</span></span></span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Zixian Ma
</span><span class="ltx_author_notes"><span class="ltx_author_notes_content">
<span class="ltx_contact ltx_role_email"><span class="ltx_contact_name">Email: </span><a href="mailto:zixianma@cs.washington.edu">zixianma@cs.washington.edu</a>
</span></span></span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Helena Vasconcelos
</span><span class="ltx_author_notes"><span class="ltx_author_notes_content">
<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span>Stanford University
</span>
