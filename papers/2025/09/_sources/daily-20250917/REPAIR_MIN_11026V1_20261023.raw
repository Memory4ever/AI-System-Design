<figure id="A1.F40" class="ltx_figure"><img src="2509.11026v1/Images/Human_Mt_Bench_scores_Difference.png" id="A1.F40.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:439/271;" width="439" height="271" alt="Refer to caption">
