ze:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="51.81"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F7.pic1.1" class="ltx_text">Prompts</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 -106.42 129)"><foreignObject style="--ltx-fo-width:11.42em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="158.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F7.pic1.2" class="ltx_text">Total Processing Time (s)</span></span></span></foreignObject></g></g></g></g></svg></span>
