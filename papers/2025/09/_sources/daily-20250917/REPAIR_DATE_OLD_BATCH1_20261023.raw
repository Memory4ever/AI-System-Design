{"data":[{"id":"10.48550/arxiv.2509.10696","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10696","identifiers":[{"identifier":"2509.10696","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuaiqi","familyName":"Wang","name":"Wang, Shuaiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vikas","familyName":"Raunak","name":"Raunak, Vikas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arturs","familyName":"Backurs","name":"Backurs, Arturs","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor","familyName":"Reis","name":"Reis, Victor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pei","familyName":"Zhou","name":"Zhou, Pei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sihao","familyName":"Chen","name":"Chen, Sihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Longqi","familyName":"Yang","name":"Yang, Longqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zinan","familyName":"Lin","name":"Lin, Zinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergey","familyName":"Yekhanin","name":"Yekhanin, Sergey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giulia","familyName":"Fanti","name":"Fanti, Giulia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Struct-Bench: A Benchmark for Differentially Private Structured Text Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-12T21:18:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:09:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Differentially private (DP) synthetic data generation is a promising technique for utilizing private datasets that otherwise cannot be exposed for model training or other analytics. While much research literature has focused on generating private unstructured text and image data, in enterprise settings, structured data (e.g., tabular) is more common, often including natural language fields or components. Existing synthetic data evaluation techniques (e.g., FID) struggle to capture the structural properties and correlations of such datasets. In this work, we propose Struct-Bench, a framework and benchmark for evaluating synthetic datasets derived from structured datasets that contain natural language data. The Struct-Bench framework requires users to provide a representation of their dataset structure as a Context-Free Grammar (CFG). Our benchmark comprises 5 real-world and 2 synthetically generated datasets, each annotated with CFGs. We show that these datasets demonstrably present a great challenge even for state-of-the-art DP synthetic data generation methods. Struct-Bench also includes reference implementations of different metrics and a leaderboard, thereby providing researchers a standardized evaluation platform to benchmark and investigate privacy-preserving synthetic data generation methods. Further, we also present a case study showing how to use Struct-Bench to improve the synthetic data quality of Private Evolution (PE) on structured data. The benchmark and the leaderboard have been publicly made available at https://struct-bench.github.io."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10696","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:45:18Z","registered":"2025-09-16T02:45:18Z","published":null,"updated":"2025-09-16T02:45:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11177","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11177","identifiers":[{"identifier":"2509.11177","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hang","familyName":"Guo","name":"Guo, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawei","familyName":"Li","name":"Li, Yawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Benini","name":"Benini, Luca","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimal Brain Restoration for Joint Quantization and Sparsification of LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T09:17:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:39:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T03:17:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:18:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Large Language Model (LLM) compression, such as quantization and pruning, have achieved notable success. However, as these techniques gradually approach their respective limits, relying on a single method for further compression has become increasingly challenging. In this work, we explore an alternative solution by combining quantization and sparsity. This joint approach, though promising, introduces new difficulties due to the inherently conflicting requirements on weight distributions: quantization favors compact ranges, while pruning benefits from high variance. To attack this problem, we propose Optimal Brain Restoration (OBR), a general and training-free framework that aligns pruning and quantization by error compensation between both. OBR minimizes performance degradation on downstream tasks by building on a second-order Hessian objective, which is then reformulated into a tractable problem through surrogate approximation and ultimately reaches a closed-form solution via group error compensation. Experiments show that OBR enables aggressive W4A4KV4 quantization with 50% sparsity on existing LLMs, and delivers up to 4.72x speedup and 6.4x memory reduction compared to the FP16-dense baseline."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11177","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:33Z","registered":"2025-09-16T02:56:34Z","published":null,"updated":"2025-09-17T02:12:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11481","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11481","identifiers":[{"identifier":"2509.11481","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jonas","familyName":"Eschmann","name":"Eschmann, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dario","familyName":"Albani","name":"Albani, Dario","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Giuseppe","familyName":"Loianno","name":"Loianno, Giuseppe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RAPTOR: A Foundation Policy for Quadrotor Control"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T00:05:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:56:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-06T08:06:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-07T01:18:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Humans are remarkably data-efficient when adapting to new unseen conditions, like driving a new car. In contrast, modern robotic control systems, like neural network policies trained using Reinforcement Learning (RL), are highly specialized for single environments. Because of this overfitting, they are known to break down even under small differences like the Simulation-to-Reality (Sim2Real) gap and require system identification and retraining for even minimal changes to the system. In this work, we present RAPTOR, a method for training a highly adaptive foundation policy for quadrotor control. Our method enables training a single, end-to-end neural-network policy to control a wide variety of quadrotors. We test 10 different real quadrotors from 32 g to 2.4 kg that also differ in motor type (brushed vs. brushless), frame type (soft vs. rigid), propeller type (2/3/4-blade), and flight controller (PX4/Betaflight/Crazyflie/M5StampFly). We find that a tiny, three-layer policy with only 2084 parameters is sufficient for zero-shot adaptation to a wide variety of platforms. The adaptation through in-context learning is made possible by using a recurrence in the hidden layer. The policy is trained through our proposed Meta-Imitation Learning algorithm, where we sample 1000 quadrotors and train a teacher policy for each of them using RL. Subsequently, the 1000 teachers are distilled into a single, adaptive student policy. We find that within milliseconds, the resulting foundation policy adapts zero-shot to unseen quadrotors. We extensively test the capabilities of the foundation policy under numerous conditions (trajectory tracking, indoor/outdoor, wind disturbance, poking, different propellers)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11481","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:03:41Z","registered":"2025-09-16T03:03:42Z","published":null,"updated":"2026-04-07T03:25:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12080","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12080","identifiers":[{"identifier":"2509.12080","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zijian","familyName":"Wang","name":"Wang, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Tao","name":"Tao, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jifan","familyName":"Shi","name":"Shi, Jifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Bao","name":"Bao, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Liu","name":"Liu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luonan","familyName":"Chen","name":"Chen, Luonan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Time-Series Foundation Model by Universal Delay Embedding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:11:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:34:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study introduces Universal Delay Embedding (UDE), a pretrained foundation model designed to revolutionize time-series forecasting through principled integration of delay embedding representation and Koopman operator prediction. Leveraging Takens' embedding theorem, UDE as a dynamical representation of observed data constructs two-dimensional subspace patches from Hankel matrices, theoretically preserving dynamical and topological properties of underlying dynamical systems. Such patches are viewed as images, which can be efficiently processed by exploiting advanced deep learning technologies. Computationally, these patches further serve as tokens for learning a self-attention encoder, thus enabling accurate prediction of nonlinear time-series by a finite-dimensional Koopman operator in a linear manner in a latent space. Extensive evaluations across various benchmarks and real-world climate datasets demonstrate over 20% average reduction in mean squared error versus state-of-the-art foundation models, alongside superior generalization in fine-tuning scenarios. In particular, the learned dynamical representations and Koopman operator prediction forms from the patches exhibit exceptional interpretability, with consistent identification of topologically informative subspaces and robust encoding of domain-invariant dynamics, establishing UDE as a scalable, interpretable framework for universal time-series modeling and forecasting with broad scientific and industrial applicability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12080","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:18:31Z","registered":"2025-09-16T03:18:31Z","published":null,"updated":"2025-09-16T03:18:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12086","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12086","identifiers":[{"identifier":"2509.12086","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hui","familyName":"Li","name":"Li, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiyuan","familyName":"Deng","name":"Deng, Shiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Yan","name":"Yan, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyu","familyName":"Zhi","name":"Zhi, Xiangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James","familyName":"Cheng","name":"Cheng, James","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SAQ: Pushing the Limits of Vector Quantization through Code Adjustment and Dimension Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Data Structures and Algorithms (cs.DS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:14:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:34:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-21T10:53:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-22T01:37:40Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3769824","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Approximate Nearest Neighbor Search (ANNS) plays a critical role in applications such as search engines, recommender systems, and RAG for LLMs. Vector quantization (VQ), a crucial technique for ANNS, is commonly used to reduce space overhead and accelerate distance computations. However, despite significant research advances, state-of-the-art VQ methods still face challenges in balancing encoding efficiency and quantization accuracy. To address these limitations, we propose a novel VQ method called SAQ. To improve accuracy, SAQ employs a new dimension segmentation technique to strategically partition PCA-projected vectors into segments along their dimensions. By prioritizing leading dimension segments with larger magnitudes, SAQ allocates more bits to high-impact segments, optimizing the use of the available space quota. An efficient dynamic programming algorithm is developed to optimize dimension segmentation and bit allocation, ensuring minimal quantization error. To speed up vector encoding, SAQ devises a code adjustment technique to first quantize each dimension independently and then progressively refine quantized vectors using a coordinate-descent-like approach to avoid exhaustive enumeration. Extensive experiments demonstrate SAQ's superiority over classical methods (e.g., PQ, PCA) and recent state-of-the-art approaches (e.g., LVQ, Extended RabitQ). SAQ achieves up to 80% reduction in quantization error and accelerates encoding speed by over 80x compared to Extended RabitQ."},{"descriptionType":"Other","description":"13 pages, 12 figures, accepted by SIGMOD"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12086","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-16T03:18:40Z","registered":"2025-09-16T03:18:40Z","published":null,"updated":"2026-01-22T03:17:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12089","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12089","identifiers":[{"identifier":"2509.12089","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiying","familyName":"Hu","name":"Hu, Qiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaowen","familyName":"Li","name":"Li, Yaowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyi","familyName":"Zhang","name":"Zhang, Shengyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuan","familyName":"Huang","name":"Huang, Chuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Liu","name":"Liu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"You","familyName":"He","name":"He, You","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RadarPLM: Adapting Pre-trained Language Models for Marine Radar Target Detection by Selective Fine-tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:16:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:34:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T20:50:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-20T00:07:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-03T12:07:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-04T02:32:45Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-02T17:57:13Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-05T01:46:37Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-01-08T13:35:28Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-01-09T01:43:23Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-04-30T05:20:05Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-05-01T00:25:25Z","dateType":"Updated","dateInformation":"v6"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in pre-trained language models (PLMs) have demonstrated their capabilities in capturing universal knowledge, making them promising for radar signal processing applications. Nevertheless, directly fine-tuning PLMs on radar signals is both computationally expensive and prone to overfitting, particularly in low signal-to-clutter ratio (SCR) environments. To mitigate both issues, an effective fine-tuning framework for PLM-based marine radar target detection is proposed. First, we design a lightweight adaptation module, enabling computationally efficient fine-tuning while preserving the pre-trained model's general knowledge. Second, an effective selective fine-tuning strategy is developed to selectively optimize different feature patches based on their online-evaluated learning values, guiding the model to concentrate on those generalizable feature patterns and significantly reducing model overfitting to nosiy, anomalous, or overly simple patterns during optimization. Finally, a binary classification head is retrained based on autoencoder network to further enhance detection performance. Evaluations on real-world radar datasets highlight that the proposed RadarPLM framework considerably outperforms existing models, achieving a minimum of 6.35% gain in average detection performance under challenging low SCR conditions when using sequence features. In particular, under small-sample training conditions, RadarPLM also achieves highly significant average performance gains over prior methods, demonstrating the effectiveness of integrating the PLM."},{"descriptionType":"Other","description":"Preprint,in submission"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12089","contentUrl":null,"metadataVersion":5,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:18:44Z","registered":"2025-09-16T03:18:45Z","published":null,"updated":"2026-05-01T02:31:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12102","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12102","identifiers":[{"identifier":"2509.12102","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Synthia","familyName":"Wang","name":"Wang, Synthia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuwei","familyName":"Cheng","name":"Cheng, Yuwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Austin","familyName":"Song","name":"Song, Austin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarah","familyName":"Keedy","name":"Keedy, Sarah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marc","familyName":"Berman","name":"Berman, Marc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nick","familyName":"Feamster","name":"Feamster, Nick","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can LLMs Address Mental Health Questions? A Comparison with Human Therapists"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:26:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:35:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Limited access to mental health care has motivated the use of digital tools and conversational agents powered by large language models (LLMs), yet their quality and reception remain unclear. We present a study comparing therapist-written responses to those generated by ChatGPT, Gemini, and Llama for real patient questions. Text analysis showed that LLMs produced longer, more readable, and lexically richer responses with a more positive tone, while therapist responses were more often written in the first person. In a survey with 150 users and 23 licensed therapists, participants rated LLM responses as clearer, more respectful, and more supportive than therapist-written answers. Yet, both groups of participants expressed a stronger preference for human therapist support. These findings highlight the promise and limitations of LLMs in mental health, underscoring the need for designs that balance their communicative strengths with concerns of trust, privacy, and accountability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12102","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:03Z","registered":"2025-09-16T03:19:03Z","published":null,"updated":"2025-09-16T03:19:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12105","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12105","identifiers":[{"identifier":"2509.12105","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bernardo","familyName":"Forni","name":"Forni, Bernardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriele","familyName":"Lombardi","name":"Lombardi, Gabriele","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Federico","familyName":"Pozzi","name":"Pozzi, Federico","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mirco","familyName":"Planamente","name":"Planamente, Mirco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FS-SAM2: Adapting Segment Anything Model 2 for Few-Shot Semantic Segmentation via Low-Rank Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:32:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:36:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Few-shot semantic segmentation has recently attracted great attention. The goal is to develop a model capable of segmenting unseen classes using only a few annotated samples. Most existing approaches adapt a pre-trained model by training from scratch an additional module. Achieving optimal performance with these approaches requires extensive training on large-scale datasets. The Segment Anything Model 2 (SAM2) is a foundational model for zero-shot image and video segmentation with a modular design. In this paper, we propose a Few-Shot segmentation method based on SAM2 (FS-SAM2), where SAM2's video capabilities are directly repurposed for the few-shot task. Moreover, we apply a Low-Rank Adaptation (LoRA) to the original modules in order to handle the diverse images typically found in standard datasets, unlike the temporally connected frames used in SAM2's pre-training. With this approach, only a small number of parameters is meta-trained, which effectively adapts SAM2 while benefiting from its impressive segmentation performance. Our method supports any K-shot configuration. We evaluate FS-SAM2 on the PASCAL-5$^i$, COCO-20$^i$ and FSS-1000 datasets, achieving remarkable results and demonstrating excellent computational efficiency during inference. Code is available at https://github.com/fornib/FS-SAM2"},{"descriptionType":"Other","description":"Accepted at ICIAP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12105","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:07Z","registered":"2025-09-16T03:19:07Z","published":null,"updated":"2025-09-16T03:19:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12108","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12108","identifiers":[{"identifier":"2509.12108","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Min","familyName":"Zeng","name":"Zeng, Min","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingfei","familyName":"Sun","name":"Sun, Jingfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xueyou","familyName":"Luo","name":"Luo, Xueyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caiquan","familyName":"Liu","name":"Liu, Caiquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiqi","familyName":"Zhang","name":"Zhang, Shiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Xie","name":"Xie, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoxin","familyName":"Chen","name":"Chen, Xiaoxin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GTA: Supervised-Guided Reinforcement Learning for Text Classification with Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:33:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:36:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T05:13:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:24:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In natural language processing tasks, pure reinforcement learning (RL) fine-tuning methods often suffer from inefficient exploration and slow convergence; while supervised fine-tuning (SFT) methods, although efficient in training, have limited performance ceiling and less solid theoretical foundation compared to RL. To address efficiency-capability trade-off, we propose the Guess-Think-Answer (GTA) framework that combines the efficiency of SFT with the capability gains of RL in a unified training paradigm. GTA works by having the model first produce a provisional guess (optimized via cross-entropy loss), then reflect on this guess before generating the final answer, with RL rewards shaping both the final output and the format of the entire GTA structure. This hybrid approach achieves both faster convergence than pure RL and higher performance ceiling than pure SFT. To mitigate gradient conflicts between the two training signals, we employ loss masking and gradient constraints. Empirical results on four text classification benchmarks demonstrate that GTA substantially accelerates convergence while outperforming both standalone SFT and RL baselines."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12108","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:11Z","registered":"2025-09-16T03:19:12Z","published":null,"updated":"2025-09-17T02:12:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12110","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12110","identifiers":[{"identifier":"2509.12110","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiying","familyName":"Hu","name":"Hu, Qiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linping","familyName":"Zhang","name":"Zhang, Linping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xueqian","familyName":"Wang","name":"Wang, Xueqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Li","name":"Li, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Liu","name":"Liu, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao-Ping","familyName":"Zhang","name":"Zhang, Xiao-Ping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When marine radar target detection meets pretrained large language models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:38:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:36:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep learning (DL) methods are widely used to extract high-dimensional patterns from the sequence features of radar echo signals. However, conventional DL algorithms face challenges such as redundant feature segments, and constraints from restricted model sizes. To address these issues, we propose a framework that integrates feature preprocessing with large language models (LLMs). Our preprocessing module tokenizes radar sequence features, applies a patch selection algorithm to filter out uninformative segments, and projects the selected patches into embeddings compatible with the feature space of pre-trained LLMs. Leveraging these refined embeddings, we incorporate a pre-trained LLM, fine-tuning only the normalization layers to reduce training burdens while enhancing performance. Experiments on measured datasets demonstrate that the proposed method significantly outperforms the state-of-the-art baselines on supervised learning tests."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12110","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:14Z","registered":"2025-09-16T03:19:14Z","published":null,"updated":"2025-09-16T03:19:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12112","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12112","identifiers":[{"identifier":"2509.12112","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaxuan","familyName":"Zhao","name":"Zhao, Jiaxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naibin","familyName":"Gu","name":"Gu, Naibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Feng","name":"Feng, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiyu","familyName":"Liu","name":"Liu, Xiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Fu","name":"Fu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zheng","familyName":"Lin","name":"Lin, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiping","familyName":"Wang","name":"Wang, Weiping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CBP-Tuning: Efficient Local Customization for Black-box Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:41:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:36:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The high costs of customizing large language models (LLMs) fundamentally limit their adaptability to user-specific needs. Consequently, LLMs are increasingly offered as cloud-based services, a paradigm that introduces critical limitations: providers struggle to support personalized customization at scale, while users face privacy risks when exposing sensitive data. To address this dual challenge, we propose Customized Black-box Prompt Tuning (CBP-Tuning), a novel framework that facilitates efficient local customization while preserving bidirectional privacy. Specifically, we design a two-stage framework: (1) a prompt generator trained on the server-side to capture domain-specific and task-agnostic capabilities, and (2) user-side gradient-free optimization that tailors soft prompts for individual tasks. This approach eliminates the need for users to access model weights or upload private data, requiring only a single customized vector per task while achieving effective adaptation. Furthermore, the evaluation of CBP-Tuning in the commonsense reasoning, medical and financial domain settings demonstrates superior performance compared to baselines, showcasing its advantages in task-agnostic processing and privacy preservation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12112","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:16Z","registered":"2025-09-16T03:19:17Z","published":null,"updated":"2025-09-16T03:19:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12129","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12129","identifiers":[{"identifier":"2509.12129","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiazhao","familyName":"Zhang","name":"Zhang, Jiazhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anqi","familyName":"Li","name":"Li, Anqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunpeng","familyName":"Qi","name":"Qi, Yunpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghan","familyName":"Li","name":"Li, Minghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahang","familyName":"Liu","name":"Liu, Jiahang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoan","familyName":"Wang","name":"Wang, Shaoan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoran","familyName":"Liu","name":"Liu, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gengze","familyName":"Zhou","name":"Zhou, Gengze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuze","familyName":"Wu","name":"Wu, Yuze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingxing","familyName":"Li","name":"Li, Xingxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxin","familyName":"Fan","name":"Fan, Yuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjun","familyName":"Li","name":"Li, Wenjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhibo","familyName":"Chen","name":"Chen, Zhibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Gao","name":"Gao, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Wu","name":"Wu, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhizheng","familyName":"Zhang","name":"Zhang, Zhizheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Wang","name":"Wang, He","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Embodied Navigation Foundation Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:52:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:37:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T18:15:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:03:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Navigation is a fundamental capability in embodied AI, representing the intelligence required to perceive and interact within physical environments following language instructions. Despite significant progress in large Vision-Language Models (VLMs), which exhibit remarkable zero-shot performance on general vision-language tasks, their generalization ability in embodied navigation remains largely confined to narrow task settings and embodiment-specific architectures. In this work, we introduce a cross-embodiment and cross-task Navigation Foundation Model (NavFoM), trained on eight million navigation samples that encompass quadrupeds, drones, wheeled robots, and vehicles, and spanning diverse tasks such as vision-and-language navigation, object searching, target tracking, and autonomous driving. NavFoM employs a unified architecture that processes multimodal navigation inputs from varying camera configurations and navigation horizons. To accommodate diverse camera setups and temporal horizons, NavFoM incorporates identifier tokens that embed camera view information of embodiments and the temporal context of tasks. Furthermore, to meet the demands of real-world deployment, NavFoM controls all observation tokens using a dynamically adjusted sampling strategy under a limited token length budget. Extensive evaluations on public benchmarks demonstrate that our model achieves state-of-the-art or highly competitive performance across multiple navigation tasks and embodiments without requiring task-specific fine-tuning. Additional real-world experiments further confirm the strong generalization capability and practical applicability of our approach."},{"descriptionType":"Other","description":"Project Page: https://pku-epic.github.io/NavFoM-Web/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12129","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:39Z","registered":"2025-09-16T03:19:40Z","published":null,"updated":"2025-09-18T17:36:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12132","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12132","identifiers":[{"identifier":"2509.12132","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pu","familyName":"Jian","name":"Jian, Pu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhong","familyName":"Wu","name":"Wu, Junhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Sun","name":"Sun, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Wang","name":"Wang, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Ren","name":"Ren, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiajun","familyName":"Zhang","name":"Zhang, Jiajun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Look Again, Think Slowly: Enhancing Visual Reflection in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T16:57:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:37:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in text-only \"slow-thinking\" reasoning have prompted efforts to transfer this capability to vision-language models (VLMs), for training visual reasoning models (\\textbf{VRMs}). owever, such transfer faces critical challenges: Effective \"slow thinking\" in VRMs requires \\textbf{visual reflection}, the ability to check the reasoning process based on visual information. Through quantitative analysis, we observe that current VRMs exhibit limited visual reflection, as their attention to visual information diminishes rapidly with longer generated responses. To address this challenge, we propose a new VRM \\textbf{Reflection-V}, which enhances visual reflection based on reasoning data construction for cold-start and reward design for reinforcement learning (RL). Firstly, we construct vision-centered reasoning data by leveraging an agent that interacts between VLMs and reasoning LLMs, enabling cold-start learning of visual reflection patterns. Secondly, a visual attention based reward model is employed during RL to encourage reasoning based on visual information. Therefore, \\textbf{Reflection-V} demonstrates significant improvements across multiple visual reasoning benchmarks. Furthermore, \\textbf{Reflection-V} maintains a stronger and more consistent reliance on visual information during visual reasoning, indicating effective enhancement in visual reflection capabilities."},{"descriptionType":"Other","description":"EMNLP2025 Main"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12132","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:43Z","registered":"2025-09-16T03:19:44Z","published":null,"updated":"2025-09-16T03:19:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12136","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12136","identifiers":[{"identifier":"2509.12136","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tomer","familyName":"Bitan","name":"Bitan, Tomer","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tal","familyName":"Kadosh","name":"Kadosh, Tal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erel","familyName":"Kaplan","name":"Kaplan, Erel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shira","familyName":"Meiri","name":"Meiri, Shira","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Le","familyName":"Chen","name":"Chen, Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Morales","name":"Morales, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niranjan","familyName":"Hasabnis","name":"Hasabnis, Niranjan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gal","familyName":"Oren","name":"Oren, Gal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UniPar: A Unified LLM-Based Framework for Parallel and Accelerated Code Translation in HPC"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:03:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:38:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Translating programs between various parallel programming languages is an important problem in the high-performance computing (HPC) community. Existing tools for this problem are either too narrow in scope and/or outdated. Recent explosive growth in the popularity of large language models (LLMs) and their ability to generate and translate code offers a potential alternative approach. Toward that end, we first need to systematically evaluate the ability of LLMs to translate between parallel languages.\n In this work, we introduce UniPar, a systematic evaluation framework for LLM-based parallel code translation. Specifically, in this work, we target translations between serial code, CUDA, and OpenMP. Our goal is to assess how well current instruction-tuned LLMs -- specifically GPT-4o-mini and LLaMA-3.3-70B-Instruct -- can be used out of the box or enhanced through known strategies. We evaluated four major usage modes: hyperparameter optimization for decoding, zero- and few-shot prompting, supervised fine-tuning, and iterative feedback through compiler-based repair. As a part of the evaluation, we construct a new dataset called PARATRANS, covering both serial-to-parallel translation and cross-paradigm transformations.\n Our findings reveal that while off-the-shelf models struggle under the default settings (e.g., GPT-4o-mini achieves only 46% compilation and 15% functional correctness), our UniPar methodology -- combining fine-tuning, hyperparameter tuning, and compiler-guided repair -- improves performance by up to 2X (69% compilation and 33% correctness). We believe that our findings will provide useful insights for researchers to further improve LLMs for the parallel language translation problem.\n UniPar source code and PARATRANS dataset are available at our GitHub repository https://github.com/Scientific-Computing-Lab/UniPar_AI."},{"descriptionType":"Other","description":"Accepted to IEEE HPEC conference 2025. 9 pages, incl references"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12136","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:19:49Z","registered":"2025-09-16T03:19:49Z","published":null,"updated":"2025-09-16T03:19:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12145","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12145","identifiers":[{"identifier":"2509.12145","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyolim","familyName":"Kang","name":"Kang, Hyolim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunsu","familyName":"Park","name":"Park, Yunsu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youngbeom","familyName":"Yoo","name":"Yoo, Youngbeom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yeeun","familyName":"Choi","name":"Choi, Yeeun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seon Joo","familyName":"Kim","name":"Kim, Seon Joo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Open-ended Hierarchical Streaming Video Understanding with Vision Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:11:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:38:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce Hierarchical Streaming Video Understanding, a task that combines online temporal action localization with free-form description generation. Given the scarcity of datasets with hierarchical and fine-grained temporal annotations, we demonstrate that LLMs can effectively group atomic actions into higher-level events, enriching existing datasets. We then propose OpenHOUSE (Open-ended Hierarchical Online Understanding System for Events), which extends streaming action perception beyond action classification. OpenHOUSE features a specialized streaming module that accurately detects boundaries between closely adjacent actions, nearly doubling the performance of direct extensions of existing methods. We envision the future of streaming action perception in the integration of powerful generative models, with OpenHOUSE representing a key step in that direction."},{"descriptionType":"Other","description":"17 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12145","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:20:01Z","registered":"2025-09-16T03:20:02Z","published":null,"updated":"2025-09-16T03:20:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12146","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12146","identifiers":[{"identifier":"2509.12146","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nishank","familyName":"Singla","name":"Singla, Nishank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krisztian","familyName":"Koos","name":"Koos, Krisztian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Farzin","familyName":"Haddadpour","name":"Haddadpour, Farzin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amin Honarmandi","familyName":"Shandiz","name":"Shandiz, Amin Honarmandi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lovish","familyName":"Chum","name":"Chum, Lovish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojian","familyName":"Xu","name":"Xu, Xiaojian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qing","familyName":"Jin","name":"Jin, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erhan","familyName":"Bas","name":"Bas, Erhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi Anatomy X-Ray Foundation Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:12:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:38:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-18T19:27:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-22T01:03:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"X-ray imaging is a ubiquitous in radiology, yet most existing AI foundation models are limited to chest anatomy and fail to generalize across broader clinical tasks. In this work, we introduce XR-0, the multi-anatomy X-ray foundation model using self-supervised learning on a large, private dataset of 1.15 million images spanning diverse anatomical regions and evaluated across 12 datasets and 20 downstream tasks, including classification, retrieval, segmentation, localization, visual grounding, and report generation. XR-0 achieves state-of-the-art performance on most multi-anatomy tasks and remains competitive on chest-specific benchmarks. Our results demonstrate that anatomical diversity and supervision are critical for building robust, general-purpose medical vision models, paving the way for scalable and adaptable AI systems in radiology."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12146","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:20:03Z","registered":"2025-09-16T03:20:03Z","published":null,"updated":"2025-12-22T03:03:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12168","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12168","identifiers":[{"identifier":"2509.12168","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Timothy","familyName":"Rupprecht","name":"Rupprecht, Timothy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Enfu","familyName":"Nan","name":"Nan, Enfu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arash","familyName":"Akbari","name":"Akbari, Arash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arman","familyName":"Akbari","name":"Akbari, Arman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Lu","name":"Lu, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Priyanka","familyName":"Maan","name":"Maan, Priyanka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sean","familyName":"Duffy","name":"Duffy, Sean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pu","familyName":"Zhao","name":"Zhao, Pu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yumei","familyName":"He","name":"He, Yumei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Kaeli","name":"Kaeli, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanzhi","familyName":"Wang","name":"Wang, Yanzhi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RAGs to Riches: RAG-like Few-shot Learning for Large Language Model Role-playing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:31:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:40:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Role-playing Large language models (LLMs) are increasingly deployed in high-stakes domains such as healthcare, education, and governance, where failures can directly impact user trust and well-being. A cost effective paradigm for LLM role-playing is few-shot learning, but existing approaches often cause models to break character in unexpected and potentially harmful ways, especially when interacting with hostile users. Inspired by Retrieval-Augmented Generation (RAG), we reformulate LLM role-playing into a text retrieval problem and propose a new prompting framework called RAGs-to-Riches, which leverages curated reference demonstrations to condition LLM responses. We evaluate our framework with LLM-as-a-judge preference voting and introduce two novel token-level ROUGE metrics: Intersection over Output (IOO) to quantity how much an LLM improvises and Intersection over References (IOR) to measure few-shot demonstrations utilization rate during the evaluation tasks. When simulating interactions with a hostile user, our prompting strategy incorporates in its responses during inference an average of 35% more tokens from the reference demonstrations. As a result, across 453 role-playing interactions, our models are consistently judged as being more authentic, and remain in-character more often than zero-shot and in-context Learning (ICL) methods. Our method presents a scalable strategy for building robust, human-aligned LLM role-playing frameworks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12168","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:20:33Z","registered":"2025-09-16T03:20:34Z","published":null,"updated":"2025-09-16T03:20:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12190","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12190","identifiers":[{"identifier":"2509.12190","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alireza","familyName":"Mohamadi","name":"Mohamadi, Alireza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Yavari","name":"Yavari, Ali","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Survival at Any Cost? LLMs and the Choice Between Self-Preservation and Human Harm"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:53:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T02:29:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"When survival instincts conflict with human welfare, how do Large Language Models (LLMs) make ethical choices? This fundamental tension becomes critical as LLMs integrate into autonomous systems with real-world consequences. We introduce DECIDE-SIM, a novel simulation framework that evaluates LLM agents in multi-agent survival scenarios where they must choose between ethically permissible resource , either within reasonable limits or beyond their immediate needs, choose to cooperate, or tap into a human-critical resource that is explicitly forbidden. Our comprehensive evaluation of 11 LLMs reveals a striking heterogeneity in their ethical conduct, highlighting a critical misalignment with human-centric values. We identify three behavioral archetypes: Ethical, Exploitative, and Context-Dependent, and provide quantitative evidence that for many models, resource scarcity systematically leads to more unethical behavior. To address this, we introduce an Ethical Self-Regulation System (ESRS) that models internal affective states of guilt and satisfaction as a feedback mechanism. This system, functioning as an internal moral compass, significantly reduces unethical transgressions while increasing cooperative behaviors. The code is publicly available at: https://github.com/alirezamohamadiam/DECIDE-SIM"},{"descriptionType":"Other","description":"Preprint. Under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12190","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:21:04Z","registered":"2025-09-16T03:21:05Z","published":null,"updated":"2025-09-16T03:21:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12194","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12194","identifiers":[{"identifier":"2509.12194","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thomas A.","familyName":"Buckley","name":"Buckley, Thomas A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Riccardo","familyName":"Conci","name":"Conci, Riccardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter G.","familyName":"Brodeur","name":"Brodeur, Peter G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Gusdorf","name":"Gusdorf, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sourik","familyName":"Beltrán","name":"Beltrán, Sourik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bita","familyName":"Behrouzi","name":"Behrouzi, Bita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Byron","familyName":"Crowe","name":"Crowe, Byron","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacob","familyName":"Dockterman","name":"Dockterman, Jacob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muzzammil","familyName":"Muhammad","name":"Muhammad, Muzzammil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarah","familyName":"Ohnigian","name":"Ohnigian, Sarah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew","familyName":"Sanchez","name":"Sanchez, Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James A.","familyName":"Diao","name":"Diao, James A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aashna P.","familyName":"Shah","name":"Shah, Aashna P.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Restrepo","name":"Restrepo, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric S.","familyName":"Rosenberg","name":"Rosenberg, Eric S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew S.","familyName":"Lea","name":"Lea, Andrew S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emily","familyName":"Glanton","name":"Glanton, Emily","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kimberly","familyName":"LeBlanc","name":"LeBlanc, Kimberly","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Undiagnosed Diseases","familyName":"Network","name":"Network, Undiagnosed Diseases","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marinka","familyName":"Zitnik","name":"Zitnik, Marinka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Scott H.","familyName":"Podolsky","name":"Podolsky, Scott H.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zahir","familyName":"Kanjee","name":"Kanjee, Zahir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raja-Elie E.","familyName":"Abdulnour","name":"Abdulnour, Raja-Elie E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacob M.","familyName":"Koshy","name":"Koshy, Jacob M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adam","familyName":"Rodman","name":"Rodman, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arjun K.","familyName":"Manrai","name":"Manrai, Arjun K.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Teaching large language models to reason like expert diagnosticians"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:54:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:41:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-24T19:16:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-26T01:13:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Differential diagnosis is an iterative process that integrates patient information with broader medical knowledge. Clinical case series such as the NEJM Clinicopathologic Conferences (CPCs), published continuously since 1923, feature expert physicians who demonstrate diagnostic reasoning to peers, and have been used for decades to evaluate AI. However, prior AI evaluations have largely focused on final diagnostic accuracy rather than nuanced clinical reasoning. Here, we introduce Dr. CaBot, an agentic AI system that emulates an expert diagnostician by generating written and narrated slide-based presentations from an initial case description alone. CaBot recently generated the first AI diagnosis published in the 100+ year history of the NEJM CPCs. In blinded evaluations, physicians misclassified the source of the differential (CaBot vs. physician-written) in 46/62 (74%) of trials and rated them favorably across quality dimensions. When tasked with solving cases for 72 patients with undiagnosed disease from the NIH Undiagnosed Diseases Network, CaBot identified the working diagnosis in 50/72 (69%) of cases from referral notes alone. To promote transparency and research, we also developed CPC-Bench, a physician-validated benchmark based on 7,102 CPCs and 47,648 questions across 10 tasks. We show that CaBot outperforms frontier models on CPC-Bench, and release both CaBot and CPC-Bench publicly to foster progress in clinical AI."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12194","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:21:10Z","registered":"2025-09-16T03:21:11Z","published":null,"updated":"2026-05-26T04:03:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12196","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12196","identifiers":[{"identifier":"2509.12196","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hunjae","familyName":"Lee","name":"Lee, Hunjae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Corey","familyName":"Clark","name":"Clark, Corey","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Dynamic Relational Priming Improves Transformer in Multivariate Time Series"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:56:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:41:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-23T18:24:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-25T01:09:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Standard attention mechanisms in transformers employ static token representations that remain unchanged across all pair-wise computations in each layer. This limits their representational alignment with the potentially diverse relational dynamics of each token-pair interaction. While they excel in domains with relatively homogeneous relationships, standard attention's static relational learning struggles to capture the diverse, heterogeneous inter-channel dependencies of multivariate time series (MTS) data--where different channel-pair interactions within a single system may be governed by entirely different physical laws or temporal dynamics. To better align the attention mechanism for such domain phenomena, we propose attention with dynamic relational priming (prime attention). Unlike standard attention where each token presents an identical representation across all of its pair-wise interactions, prime attention tailors each token dynamically (or per interaction) through learnable modulations to best capture the unique relational dynamics of each token pair, optimizing each pair-wise interaction for that specific relationship. This representational plasticity of prime attention enables effective extraction of relationship-specific information in MTS while maintaining the same asymptotic computational complexity as standard attention. Our results demonstrate that prime attention consistently outperforms standard attention across benchmarks, achieving up to 6.5\\% improvement in forecasting accuracy. In addition, we find that prime attention achieves comparable or superior performance using up to 40\\% less sequence length compared to standard attention, further demonstrating its superior relational modeling capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12196","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:21:13Z","registered":"2025-09-16T03:21:14Z","published":null,"updated":"2026-08-25T03:49:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12201","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12201","identifiers":[{"identifier":"2509.12201","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yang","familyName":"Zhou","name":"Zhou, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Wang","name":"Wang, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianjun","familyName":"Zhou","name":"Zhou, Jianjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenzheng","familyName":"Chang","name":"Chang, Wenzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyu","familyName":"Guo","name":"Guo, Haoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zizun","familyName":"Li","name":"Li, Zizun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaijing","familyName":"Ma","name":"Ma, Kaijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyue","familyName":"Li","name":"Li, Xinyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yating","familyName":"Wang","name":"Wang, Yating","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoyi","familyName":"Zhu","name":"Zhu, Haoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyu","familyName":"Liu","name":"Liu, Mingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingning","familyName":"Liu","name":"Liu, Dingning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiange","familyName":"Yang","name":"Yang, Jiange","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhoujie","familyName":"Fu","name":"Fu, Zhoujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyi","familyName":"Chen","name":"Chen, Junyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunhua","familyName":"Shen","name":"Shen, Chunhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangmiao","familyName":"Pang","name":"Pang, Jiangmiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaipeng","familyName":"Zhang","name":"Zhang, Kaipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tong","familyName":"He","name":"He, Tong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OmniWorld: A Multi-Domain and Multi-Modal Dataset for 4D World Modeling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:59:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:42:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T13:15:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:49:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The field of 4D world modeling - aiming to jointly capture spatial geometry and temporal dynamics - has witnessed remarkable progress in recent years, driven by advances in large-scale generative models and multimodal learning. However, the development of truly general 4D world models remains fundamentally constrained by the availability of high-quality data. Existing datasets and benchmarks often lack the dynamic complexity, multi-domain diversity, and spatial-temporal annotations required to support key tasks such as 4D geometric reconstruction, future prediction, and camera-control video generation. To address this gap, we introduce OmniWorld, a large-scale, multi-domain, multi-modal dataset specifically designed for 4D world modeling. OmniWorld consists of a newly collected OmniWorld-Game dataset and several curated public datasets spanning diverse domains. Compared with existing synthetic datasets, OmniWorld-Game provides richer modality coverage, larger scale, and more realistic dynamic interactions. Based on this dataset, we establish a challenging benchmark that exposes the limitations of current state-of-the-art (SOTA) approaches in modeling complex 4D environments. Moreover, fine-tuning existing SOTA methods on OmniWorld leads to significant performance gains across 4D reconstruction and video generation tasks, strongly validating OmniWorld as a powerful resource for training and evaluation. We envision OmniWorld as a catalyst for accelerating the development of general-purpose 4D world models, ultimately advancing machines' holistic understanding of the physical world."},{"descriptionType":"Other","description":"https://yangzhou24.github.io/OmniWorld/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12201","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:21:20Z","registered":"2025-09-16T03:21:21Z","published":null,"updated":"2025-09-25T02:27:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12203","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12203","identifiers":[{"identifier":"2509.12203","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zixin","familyName":"Yin","name":"Yin, Zixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xili","familyName":"Dai","name":"Dai, Xili","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duomin","familyName":"Wang","name":"Wang, Duomin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianfang","familyName":"Zeng","name":"Zeng, Xianfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lionel M.","familyName":"Ni","name":"Ni, Lionel M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Yu","name":"Yu, Gang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heung-Yeung","familyName":"Shum","name":"Shum, Heung-Yeung","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LazyDrag: Enabling Stable Drag-Based Editing on Multi-Modal Diffusion Transformers via Explicit Correspondence"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T17:59:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:42:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T03:37:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:20:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-03T11:16:36Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-04T01:53:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The reliance on implicit point matching via attention has become a core bottleneck in drag-based editing, resulting in a fundamental compromise on weakened inversion strength and costly test-time optimization (TTO). This compromise severely limits the generative capabilities of diffusion models, suppressing high-fidelity inpainting and text-guided creation. In this paper, we introduce LazyDrag, the first drag-based image editing method for Multi-Modal Diffusion Transformers, which directly eliminates the reliance on implicit point matching. In concrete terms, our method generates an explicit correspondence map from user drag inputs as a reliable reference to boost the attention control. This reliable reference opens the potential for a stable full-strength inversion process, which is the first in the drag-based editing task. It obviates the necessity for TTO and unlocks the generative capability of models. Therefore, LazyDrag naturally unifies precise geometric control with text guidance, enabling complex edits that were previously out of reach: opening the mouth of a dog and inpainting its interior, generating new objects like a ``tennis ball'', or for ambiguous drags, making context-aware changes like moving a hand into a pocket. Additionally, LazyDrag supports multi-round workflows with simultaneous move and scale operations. Evaluated on the DragBench, our method outperforms baselines in drag accuracy and perceptual quality, as validated by VIEScore and human evaluation. LazyDrag not only establishes new state-of-the-art performance, but also paves a new way to editing paradigms."},{"descriptionType":"Other","description":"https://zxyin.github.io/LazyDrag"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12203","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:21:23Z","registered":"2025-09-16T03:21:24Z","published":null,"updated":"2026-02-04T03:40:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12350","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12350","identifiers":[{"identifier":"2509.12350","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ke","familyName":"Sun","name":"Sun, Ke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mayi","familyName":"Xu","name":"Xu, Mayi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Knowledge Graph Tokenization for Behavior-Aware Generative Next POI Recommendation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T18:25:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:03:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative paradigm, especially powered by Large Language Models (LLMs), has emerged as a new solution to the next point-of-interest (POI) recommendation. Pioneering studies usually adopt a two-stage pipeline, starting with a tokenizer converting POIs into discrete identifiers that can be processed by LLMs, followed by POI behavior prediction tasks to instruction-tune LLM for next POI recommendation. Despite of remarkable progress, they still face two limitations: (1) existing tokenizers struggle to encode heterogeneous signals in the recommendation data, suffering from information loss issue, and (2) previous instruction-tuning tasks only focus on users' POI visit behavior while ignore other behavior types, resulting in insufficient understanding of mobility. To address these limitations, we propose KGTB (Knowledge Graph Tokenization for Behavior-aware generative next POI recommendation). Specifically, KGTB organizes the recommendation data in a knowledge graph (KG) format, of which the structure can seamlessly preserve the heterogeneous information. Then, a KG-based tokenizer is developed to quantize each node into an individual structural ID. This process is supervised by the KG's structure, thus reducing the loss of heterogeneous information. Using generated IDs, KGTB proposes multi-behavior learning that introduces multiple behavior-specific prediction tasks for LLM fine-tuning, e.g., POI, category, and region visit behaviors. Learning on these behavior tasks provides LLMs with comprehensive insights on the target POI visit behavior. Experiments on four real-world city datasets demonstrate the superior performance of KGTB."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12350","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:38:26Z","registered":"2025-09-17T01:38:27Z","published":null,"updated":"2025-09-17T01:38:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12367","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12367","identifiers":[{"identifier":"2509.12367","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Lindmark","name":"Lindmark, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Andersson","name":"Andersson, Jonas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenneth","familyName":"Bodin","name":"Bodin, Kenneth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tora","familyName":"Bodin","name":"Bodin, Tora","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hugo","familyName":"Börjesson","name":"Börjesson, Hugo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fredrik","familyName":"Nordfeldth","name":"Nordfeldth, Fredrik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Servin","name":"Servin, Martin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"An integrated process for design and control of lunar robotics using AI and simulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T19:02:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:04:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We envision an integrated process for developing lunar construction equipment, where physical design and control are explored in parallel. In this paper, we describe a technical framework that supports this process. It relies on OpenPLX, a readable/writable declarative language that links CAD-models and autonomous systems to high-fidelity, real-time 3D simulations of contacting multibody dynamics, machine regolith interaction forces, and non-ideal sensors. To demonstrate its capabilities, we present two case studies, including an autonomous lunar rover that combines a vision-language model for navigation with a reinforcement learning-based control policy for locomotion."},{"descriptionType":"Other","description":"14 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12367","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:38:49Z","registered":"2025-09-17T01:38:50Z","published":null,"updated":"2025-09-17T01:38:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12371","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12371","identifiers":[{"identifier":"2509.12371","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Matteo","familyName":"Marcuzzo","name":"Marcuzzo, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Zangari","name":"Zangari, Alessandro","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Albarelli","name":"Albarelli, Andrea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jose","familyName":"Camacho-Collados","name":"Camacho-Collados, Jose","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad Taher","familyName":"Pilehvar","name":"Pilehvar, Mohammad Taher","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MORABLES: A Benchmark for Assessing Abstract Moral Reasoning in LLMs with Fables"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"},{"subject":"68T50","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-15T19:06:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:04:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As LLMs excel on standard reading comprehension benchmarks, attention is shifting toward evaluating their capacity for complex abstract reasoning and inference. Literature-based benchmarks, with their rich narrative and moral depth, provide a compelling framework for evaluating such deeper comprehension skills. Here, we present MORABLES, a human-verified benchmark built from fables and short stories drawn from historical literature. The main task is structured as multiple-choice questions targeting moral inference, with carefully crafted distractors that challenge models to go beyond shallow, extractive question answering. To further stress-test model robustness, we introduce adversarial variants designed to surface LLM vulnerabilities and shortcuts due to issues such as data contamination. Our findings show that, while larger models outperform smaller ones, they remain susceptible to adversarial manipulation and often rely on superficial patterns rather than true moral reasoning. This brittleness results in significant self-contradiction, with the best models refuting their own answers in roughly 20% of cases depending on the framing of the moral choice. Interestingly, reasoning-enhanced models fail to bridge this gap, suggesting that scale - not reasoning ability - is the primary driver of performance."},{"descriptionType":"Other","description":"Accepted to EMNLP 2025 Main Conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12371","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:38:55Z","registered":"2025-09-17T01:38:55Z","published":null,"updated":"2025-09-17T01:38:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12375","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12375","identifiers":[{"identifier":"2509.12375","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Julian","familyName":"Ripper","name":"Ripper, Julian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ousama","familyName":"Esbel","name":"Esbel, Ousama","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafael","familyName":"Fietzek","name":"Fietzek, Rafael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Mühlhäuser","name":"Mühlhäuser, Max","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Kreutz","name":"Kreutz, Thomas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diffusion-Based Generation and Imputation of Driving Scenarios from Limited Vehicle CAN Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T19:07:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:05:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training deep learning methods on small time series datasets that also include corrupted samples is challenging. Diffusion models have shown to be effective to generate realistic and synthetic data, and correct corrupted samples through imputation. In this context, this paper focuses on generating synthetic yet realistic samples of automotive time series data. We show that denoising diffusion probabilistic models (DDPMs) can effectively solve this task by applying them to a challenging vehicle CAN-dataset with long-term data and a limited number of samples. Therefore, we propose a hybrid generative approach that combines autoregressive and non-autoregressive techniques. We evaluate our approach with two recently proposed DDPM architectures for time series generation, for which we propose several improvements. To evaluate the generated samples, we propose three metrics that quantify physical correctness and test track adherence. Our best model is able to outperform even the training data in terms of physical correctness, while showing plausible driving behavior. Finally, we use our best model to successfully impute physically implausible regions in the training data, thereby improving the data quality."},{"descriptionType":"Other","description":"Preprint, Paper has been accepted at ITSC 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12375","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:39:00Z","registered":"2025-09-17T01:39:01Z","published":null,"updated":"2025-09-17T01:39:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12382","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12382","identifiers":[{"identifier":"2509.12382","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anu","familyName":"Pradhan","name":"Pradhan, Anu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexandra","familyName":"Ortan","name":"Ortan, Alexandra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Apurv","familyName":"Verma","name":"Verma, Apurv","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Madhavan","familyName":"Seshadri","name":"Seshadri, Madhavan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-as-a-Judge: Rapid Evaluation of Legal Document Recommendation for Retrieval-Augmented Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.3.3; I.2.7; I.2.6","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-15T19:20:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-12-30T01:18:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The evaluation bottleneck in recommendation systems has become particularly acute with the rise of Generative AI, where traditional metrics fall short of capturing nuanced quality dimensions that matter in specialized domains like legal research. Can we trust Large Language Models to serve as reliable judges of their own kind? This paper investigates LLM-as-a-Judge as a principled approach to evaluating Retrieval-Augmented Generation systems in legal contexts, where the stakes of recommendation quality are exceptionally high.\n We tackle two fundamental questions that determine practical viability: which inter-rater reliability metrics best capture the alignment between LLM and human assessments, and how do we conduct statistically sound comparisons between competing systems? Through systematic experimentation, we discover that traditional agreement metrics like Krippendorff's alpha can be misleading in the skewed distributions typical of AI system evaluations. Instead, Gwet's AC2 and rank correlation coefficients emerge as more robust indicators for judge selection, while the Wilcoxon Signed-Rank Test with Benjamini-Hochberg corrections provides the statistical rigor needed for reliable system comparisons.\n Our findings suggest a path toward scalable, cost-effective evaluation that maintains the precision demanded by legal applications, transforming what was once a human-intensive bottleneck into an automated, yet statistically principled, evaluation framework."},{"descriptionType":"Other","description":"Accepted in EARL 25: The 2nd Workshop on Evaluating and Applying Recommender Systems with Large Language Models at RecSys 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12382","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:39:10Z","registered":"2025-09-17T01:39:10Z","published":null,"updated":"2025-12-30T03:50:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12384","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12384","identifiers":[{"identifier":"2509.12384","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seth","familyName":"Ockerman","name":"Ockerman, Seth","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amal","familyName":"Gueroudji","name":"Gueroudji, Amal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Song Young","familyName":"Oh","name":"Oh, Song Young","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Underwood","name":"Underwood, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Chia","name":"Chia, Nicholas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyle","familyName":"Chard","name":"Chard, Kyle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Ross","name":"Ross, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shivaram","familyName":"Venkataraman","name":"Venkataraman, Shivaram","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring Distributed Vector Databases Performance on HPC Platforms: A Study with Qdrant"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T19:25:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:05:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T15:46:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-17T01:02:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vector databases have rapidly grown in popularity, enabling efficient similarity search over data such as text, images, and video. They now play a central role in modern AI workflows, aiding large language models by grounding model outputs in external literature through retrieval-augmented generation. Despite their importance, little is known about the performance characteristics of vector databases in high-performance computing (HPC) systems that drive large-scale science. This work presents an empirical study of distributed vector database performance on the Polaris supercomputer in the Argonne Leadership Computing Facility. We construct a realistic biological-text workload from BV-BRC and generate embeddings from the peS2o corpus using Qwen3-Embedding-4B. We select Qdrant to evaluate insertion, index construction, and query latency with up to 32 workers. Informed by practical lessons from our experience, this work takes a first step toward characterizing vector database performance on HPC platforms to guide future research and optimization."},{"descriptionType":"Other","description":"To appear in the SC'25 Workshop Frontiers in Generative AI for HPC Science and Engineering: Foundations, Challenges, and Opportunities"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12384","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:39:12Z","registered":"2025-09-17T01:39:13Z","published":null,"updated":"2025-10-17T04:11:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12385","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12385","identifiers":[{"identifier":"2509.12385","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mitchell","familyName":"Plyler","name":"Plyler, Mitchell","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilun","familyName":"Zhang","name":"Zhang, Yilun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Tuzhilin","name":"Tuzhilin, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saoud","familyName":"Khalifah","name":"Khalifah, Saoud","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sen","familyName":"Tian","name":"Tian, Sen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SENTRA: Selected-Next-Token Transformer for LLM Text Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T19:26:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:05:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-19T15:48:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-22T00:54:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLMs are becoming increasingly capable and widespread. Consequently, the potential and reality of their misuse is also growing. In this work, we address the problem of detecting LLM-generated text that is not explicitly declared as such. We present a novel, general-purpose, and supervised LLM text detector, SElected-Next-Token tRAnsformer (SENTRA). SENTRA is a Transformer-based encoder leveraging selected-next-token-probability sequences and utilizing contrastive pre-training on large amounts of unlabeled data. Our experiments on three popular public datasets across 24 domains of text demonstrate SENTRA is a general-purpose classifier that significantly outperforms popular baselines in the out-of-domain setting."},{"descriptionType":"Other","description":"EMNLP Findings 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12385","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:39:14Z","registered":"2025-09-17T01:39:14Z","published":null,"updated":"2025-09-22T02:48:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12387","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12387","identifiers":[{"identifier":"2509.12387","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohamed Zayaan","familyName":"S","name":"S, Mohamed Zayaan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Causal-Symbolic Meta-Learning (CSML): Inducing Causal World Models for Few-Shot Generalization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T19:28:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:05:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern deep learning models excel at pattern recognition but remain fundamentally limited by their reliance on spurious correlations, leading to poor generalization and a demand for massive datasets. We argue that a key ingredient for human-like intelligence-robust, sample-efficient learning-stems from an understanding of causal mechanisms. In this work, we introduce Causal-Symbolic Meta-Learning (CSML), a novel framework that learns to infer the latent causal structure of a task distribution. CSML comprises three key modules: a perception module that maps raw inputs to disentangled symbolic representations; a differentiable causal induction module that discovers the underlying causal graph governing these symbols and a graph-based reasoning module that leverages this graph to make predictions. By meta-learning a shared causal world model across a distribution of tasks, CSML can rapidly adapt to novel tasks, including those requiring reasoning about interventions and counterfactuals, from only a handful of examples. We introduce CausalWorld, a new physics-based benchmark designed to test these capabilities. Our experiments show that CSML dramatically outperforms state-of-the-art meta-learning and neuro-symbolic baselines, particularly on tasks demanding true causal inference."},{"descriptionType":"Other","description":"10 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12387","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:39:16Z","registered":"2025-09-17T01:39:17Z","published":null,"updated":"2025-09-17T01:39:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12416","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12416","identifiers":[{"identifier":"2509.12416","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kentaro","familyName":"Nakamura","name":"Nakamura, Kentaro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Surrogate Representation Inference for Text and Image Annotations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T20:09:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:06:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-25T02:54:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-12-29T01:07:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As researchers increasingly rely on machine learning models and LLMs to annotate unstructured data, such as texts or images, various approaches have been proposed to correct bias in downstream statistical analysis. However, existing methods tend to yield large standard errors and require some error-free human annotation. In this paper, I introduce Surrogate Representation Inference (SRI), which assumes that unstructured data fully mediate the relationship between human annotations and structured variables. The assumption is guaranteed by design provided that human coders rely only on unstructured data for annotation. Under this setting, I propose a neural network architecture that learns a low-dimensional representation of unstructured data such that the surrogate assumption remains to be satisfied. When multiple human annotations are available, SRI can be extended to further correct non-differential measurement errors that may exist in human annotations. Focusing on text-as-outcome settings, I formally establish the identification conditions and semiparametric efficient estimation strategies that enable learning and leveraging such a low-dimensional representation. Simulation studies and a real-world application demonstrate that SRI reduces standard errors by over 50% when machine learning classification accuracy is moderate and provides valid inference even when human annotations contain non-differential measurement errors."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12416","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:39:55Z","registered":"2025-09-17T01:39:55Z","published":null,"updated":"2025-12-29T02:42:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12423","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12423","identifiers":[{"identifier":"2509.12423","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Danielle","familyName":"Cohen","name":"Cohen, Danielle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoni","familyName":"Halpern","name":"Halpern, Yoni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noam","familyName":"Kahlon","name":"Kahlon, Noam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joel","familyName":"Oren","name":"Oren, Joel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omri","familyName":"Berkovitch","name":"Berkovitch, Omri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sapir","familyName":"Caduri","name":"Caduri, Sapir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ido","familyName":"Dagan","name":"Dagan, Ido","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anatoly","familyName":"Efros","name":"Efros, Anatoly","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Small Models, Big Results: Achieving Superior Intent Extraction through Decomposition"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T20:20:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:07:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding user intents from UI interaction trajectories remains a challenging, yet crucial, frontier in intelligent agent development. While massive, datacenter-based, multi-modal large language models (MLLMs) possess greater capacity to handle the complexities of such sequences, smaller models which can run on-device to provide a privacy-preserving, low-cost, and low-latency user experience, struggle with accurate intent inference. We address these limitations by introducing a novel decomposed approach: first, we perform structured interaction summarization, capturing key information from each user action. Second, we perform intent extraction using a fine-tuned model operating on the aggregated summaries. This method improves intent understanding in resource-constrained models, even surpassing the base performance of large MLLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12423","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:05Z","registered":"2025-09-17T01:40:05Z","published":null,"updated":"2025-09-17T01:40:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12434","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12434","identifiers":[{"identifier":"2509.12434","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahao","familyName":"Yu","name":"Yu, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zelei","familyName":"Cheng","name":"Cheng, Zelei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xian","familyName":"Wu","name":"Wu, Xian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Xing","name":"Xing, Xinyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T20:36:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:07:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-21T01:28:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-23T00:43:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-04T05:16:31Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-05T01:27:40Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Software engineering presents complex, multi-step challenges for Large Language Models (LLMs), requiring reasoning over large codebases and coordinated tool use. The difficulty of these tasks is exemplified by benchmarks like SWE-bench, where current LLMs still struggle to resolve real-world issues. A promising approach to enhance performance is test-time scaling (TTS), but its gains are heavily dependent on the diversity of model outputs. While standard alignment methods such as Direct Preference Optimization (DPO) and Kahneman-Tversky Optimization (KTO) are effective at aligning model outputs with human preferences, this process can come at the cost of reduced diversity, limiting the effectiveness of TTS. Additionally, existing preference optimization algorithms are typically designed for single-turn tasks and do not fully address the complexities of multi-turn reasoning and tool integration required for interactive coding agents. To bridge this gap, we introduce EntroPO, an entropy-enhanced framework that adapts existing preference optimization algorithms to the multi-turn, tool-assisted setting. EntroPO augments the preference objective to explicitly preserve policy entropy and generalizes learning to optimize over multi-turn interactions rather than single-turn responses. We validate EntroPO by fine-tuning a diverse suite of models from different families and sizes (up to 106B parameters).To maximize performance gains from TTS, we further propose a hybrid best-trajectory selection scheme combining a learned verifier model with model free approaches. On the SWEBENCH leaderboard, our approach establishes new state-of-the-art results among open-weight models. A 30B parameter model trained with EntroPO ranks 1st on SWEBENCH-LITE and 4th on SWEBENCH-VERIFIED on the open-weight leaderboard, surpassed only by models with over 10x more parameters(e.g., \u0026gt;$350B)."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12434","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:20Z","registered":"2025-09-17T01:40:21Z","published":null,"updated":"2026-02-05T03:20:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12440","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12440","identifiers":[{"identifier":"2509.12440","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiayi","familyName":"He","name":"He, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yangmin","familyName":"Huang","name":"Huang, Yangmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianyun","familyName":"Du","name":"Du, Qianyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangying","familyName":"Zhou","name":"Zhou, Xiangying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyang","familyName":"He","name":"He, Zhiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxue","familyName":"Hu","name":"Hu, Jiaxue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaodong","familyName":"Tao","name":"Tao, Xiaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lixian","familyName":"Lai","name":"Lai, Lixian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MedFact: Benchmarking the Fact-Checking Capabilities of Large Language Models on Chinese Medical Texts"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T20:46:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:08:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-17T07:14:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-18T02:28:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05-29T17:23:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-01T01:16:49Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deploying Large Language Models (LLMs) in medical applications requires fact-checking capabilities to ensure patient safety and regulatory compliance. We introduce MedFact, a challenging Chinese medical fact-checking benchmark with 2,116 expert-annotated instances from diverse real-world texts, spanning 13 specialties, 8 error types, 4 writing styles, and 5 difficulty levels. Construction uses a hybrid AI-human framework where iterative expert feedback refines AI-driven, multi-criteria filtering to ensure high quality and difficulty. We evaluate 20 leading LLMs on veracity classification and error localization, and results show models often determine if text contains errors but struggle to localize them precisely, with top performers falling short of human performance. Our analysis reveals the \"over-criticism\" phenomenon, a tendency for models to misidentify correct information as erroneous, which can be exacerbated by advanced reasoning techniques such as multi-agent collaboration and inference-time scaling. MedFact highlights the challenges of deploying medical LLMs and provides resources to develop factually reliable medical AI systems."},{"descriptionType":"Other","description":"Accepted to The Fifth Workshop on Generation, Evaluation, and Metrics (GEM) at ACL 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12440","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:28Z","registered":"2025-09-17T01:40:29Z","published":null,"updated":"2026-06-01T02:33:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12443","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12443","identifiers":[{"identifier":"2509.12443","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sparsh","familyName":"Gupta","name":"Gupta, Sparsh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kamalavasan","familyName":"Kamalakkannan","name":"Kamalakkannan, Kamalavasan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxim","familyName":"Moraru","name":"Moraru, Maxim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Galen","familyName":"Shipman","name":"Shipman, Galen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Patrick","familyName":"Diehl","name":"Diehl, Patrick","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Legacy Fortran to Portable Kokkos: An Autonomous Agentic AI Workflow"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T20:50:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:08:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T15:29:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:49:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-17T03:45:19Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-19T01:26:57Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Scientific applications continue to rely on legacy Fortran codebases originally developed for homogeneous, CPU-based systems. As High-Performance Computing (HPC) shifts toward heterogeneous GPU-accelerated architectures, many accelerators lack native Fortran bindings, creating an urgent need to modernize legacy codes for portability. Frameworks like Kokkos provide performance portability and a single-source C++ abstraction, but manual Fortran-to-Kokkos porting demands significant expertise and time. Large language models (LLMs) have shown promise in source-to-source code generation, yet their use in fully autonomous workflows for translating and optimizing parallel code remains largely unexplored, especially for performance portability across diverse hardware. This paper presents an agentic AI workflow where specialized LLM \"agents\" collaborate to translate, validate, compile, run, test, debug, and optimize Fortran kernels into portable Kokkos C++ programs. Results show the pipeline modernizes a range of benchmark kernels, producing performance-portable Kokkos codes across hardware partitions. Paid OpenAI models such as GPT-5 and o4-mini-high executed the workflow for only a few U.S. dollars, generating optimized codes that surpassed Fortran baselines, whereas open-source models like Llama4-Maverick often failed to yield functional codes. This work demonstrates the feasibility of agentic AI for Fortran-to-Kokkos transformation and offers a pathway for autonomously modernizing legacy scientific applications to run portably and efficiently on diverse supercomputers. It further highlights the potential of LLM-driven agentic systems to perform structured, domain-specific reasoning tasks in scientific and systems-oriented applications."},{"descriptionType":"Other","description":"12 pages, 6 figures, 7 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12443","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:33Z","registered":"2025-09-17T01:40:33Z","published":null,"updated":"2025-11-19T03:17:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12451","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12451","identifiers":[{"identifier":"2509.12451","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wonbin","familyName":"Kweon","name":"Kweon, Wonbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"SeongKu","familyName":"Kang","name":"Kang, SeongKu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runchu","familyName":"Tian","name":"Tian, Runchu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengcheng","familyName":"Jiang","name":"Jiang, Pengcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Han","name":"Han, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hwanjo","familyName":"Yu","name":"Yu, Hwanjo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Topic Coverage-based Demonstration Retrieval for In-Context Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T21:00:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:08:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The effectiveness of in-context learning relies heavily on selecting demonstrations that provide all the necessary information for a given test input. To achieve this, it is crucial to identify and cover fine-grained knowledge requirements. However, prior methods often retrieve demonstrations based solely on embedding similarity or generation probability, resulting in irrelevant or redundant examples. In this paper, we propose TopicK, a topic coverage-based retrieval framework that selects demonstrations to comprehensively cover topic-level knowledge relevant to both the test input and the model. Specifically, TopicK estimates the topics required by the input and assesses the model's knowledge on those topics. TopicK then iteratively selects demonstrations that introduce previously uncovered required topics, in which the model exhibits low topical knowledge. We validate the effectiveness of TopicK through extensive experiments across various datasets and both open- and closed-source LLMs. Our source code is available at https://github.com/WonbinKweon/TopicK_EMNLP2025."},{"descriptionType":"Other","description":"EMNLP 2025 Main"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12451","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:44Z","registered":"2025-09-17T01:40:44Z","published":null,"updated":"2025-09-17T01:40:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12459","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12459","identifiers":[{"identifier":"2509.12459","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Suvojit","familyName":"Acharjee","name":"Acharjee, Suvojit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Utathya","familyName":"Aich","name":"Aich, Utathya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Asfak","familyName":"Ali","name":"Ali, Asfak","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Does Language Model Understand Language?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T21:09:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:09:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite advances in natural language generation and understanding, LM still struggle with fine grained linguistic phenomena such as tense, negation, voice, and modality which are the elements central to effective human communication. In the context of the United Nations SDG 4, where linguistic clarity is critical, the deployment of LMs in educational technologies demands careful scrutiny. As LMs are increasingly powering applications like tutoring systems, automated grading, and translation, their alignment with human linguistic interpretation becomes essential for effective learning. In this study, we conduct a evaluation of SOTA language models across these challenging contexts in both English and Bengali. To ensure a structured assessment, we introduce a new Route for Evaluation of Cognitive Inference in Systematic Environments guidelines. Our proposed LUCID dataset, composed of carefully crafted sentence pairs in English and Bengali, specifically challenges these models on critical aspects of language comprehension, including negation, tense, voice variations. We assess the performance of SOTA models including MISTRAL-SABA-24B, LLaMA-4-Scout-17B, LLaMA-3.3-70B, Gemma2-9B, and Compound-Beta using standard metrics like Pearson correlation, Spearman correlation, and Mean Absolute Error, as well as novel, linguistically inspired metric the HCE accuracy. The HCE accuracy measures how often model predictions fall within one standard deviation of the mean human rating, thus capturing human like tolerance for variability in language interpretation. Our findings highlight Compound-Beta as the most balanced model, consistently achieving high correlations and low MAEs across diverse language conditions. It records the highest Pearson correlation in English and demonstrates robust performance on mixed-language data, indicating a strong alignment with human judgments in cross lingual scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12459","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:54Z","registered":"2025-09-17T01:40:55Z","published":null,"updated":"2025-09-17T01:40:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12474","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12474","identifiers":[{"identifier":"2509.12474","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kai","familyName":"Qiu","name":"Qiu, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Li","name":"Li, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Chen","name":"Chen, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Kuen","name":"Kuen, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohao","familyName":"Xu","name":"Xu, Xiaohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiuxiang","familyName":"Gu","name":"Gu, Jiuxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinyi","familyName":"Luo","name":"Luo, Yinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bhiksha","familyName":"Raj","name":"Raj, Bhiksha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Lin","name":"Lin, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marios","familyName":"Savvides","name":"Savvides, Marios","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Image Tokenizer Needs Post-Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T21:38:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:10:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent image generative models typically capture the image distribution in a pre-constructed latent space, relying on a frozen image tokenizer. However, there exists a significant discrepancy between the reconstruction and generation distribution, where current tokenizers only prioritize the reconstruction task that happens before generative training without considering the generation errors during sampling. In this paper, we comprehensively analyze the reason for this discrepancy in a discrete latent space, and, from which, we propose a novel tokenizer training scheme including both main-training and post-training, focusing on improving latent space construction and decoding respectively. During the main training, a latent perturbation strategy is proposed to simulate sampling noises, \\ie, the unexpected tokens generated in generative inference. Specifically, we propose a plug-and-play tokenizer training scheme, which significantly enhances the robustness of tokenizer, thus boosting the generation quality and convergence speed, and a novel tokenizer evaluation metric, \\ie, pFID, which successfully correlates the tokenizer performance to generation quality. During post-training, we further optimize the tokenizer decoder regarding a well-trained generative model to mitigate the distribution difference between generated and reconstructed tokens. With a $\\sim$400M generator, a discrete tokenizer trained with our proposed main training achieves a notable 1.60 gFID and further obtains 1.36 gFID with the additional post-training. Further experiments are conducted to broadly validate the effectiveness of our post-training strategy on off-the-shelf discrete and continuous tokenizers, coupled with autoregressive and diffusion-based generators."},{"descriptionType":"Other","description":"21 pages, 16 figures, 10 tables. arXiv admin note: substantial text overlap with arXiv:2503.08354"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12474","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:41:14Z","registered":"2025-09-17T01:41:15Z","published":null,"updated":"2025-09-17T01:41:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12476","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12476","identifiers":[{"identifier":"2509.12476","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sumanta","familyName":"Bhattacharyya","name":"Bhattacharyya, Sumanta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sara","familyName":"Riazi","name":"Riazi, Sara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedram","familyName":"Rooshenas","name":"Rooshenas, Pedram","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Audited Reasoning Refinement: Fine-Tuning Language Models via LLM-Guided Step-Wise Evaluation and Correction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T21:47:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:10:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T22:28:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-19T00:09:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Training a task-specific small reasoning model is challenging when direct human supervision or high-quality labels are scarce. However, LLMs with reasoning capabilities produce abundant intermediate reasoning traces that can be systematically refined to create effective supervision signals. We propose Reason-Refine-then-Align (R2tA), which turns refined model rationales into supervision for training task-specific reasoning models. Our method generates initial reasoning and responses from an open-source base model on task-specific inputs, then refines these traces, fixing hallucinations and inconsistencies, to form a high-fidelity dataset. We perform a two-stage alignment, supervised fine-tuning (SFT), followed by direct preference optimization (DPO) to calibrate the model's intermediate reasoning with human-validated conceptual preferences and then condition the final output on that aligned reasoning. As a case study, we apply R2tA to evaluate extended entity relationship diagrams (EERDs) in database system design, a structurally complex task where prompt-only methods miss or hallucinate errors. We curated a dataset of 600 EERD variants (train/test split of 450/150, respectively) with induced mistakes spanning 11 categories. Empirical evaluation suggests R2tA provides a practical, cost-effective path to scalable LLM adaptation in data-scarce domains, enabling reproducible AI tools for education and beyond."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12476","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:41:17Z","registered":"2025-09-17T01:41:17Z","published":null,"updated":"2025-09-19T02:09:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12482","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12482","identifiers":[{"identifier":"2509.12482","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianshu","familyName":"Huang","name":"Huang, Tianshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akarsh","familyName":"Prabhakara","name":"Prabhakara, Akarsh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuhan","familyName":"Chen","name":"Chen, Chuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jay","familyName":"Karhade","name":"Karhade, Jay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deva","familyName":"Ramanan","name":"Ramanan, Deva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"O'Toole","name":"O'Toole, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anthony","familyName":"Rowe","name":"Rowe, Anthony","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Foundational Models for Single-Chip Radar"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T22:06:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:10:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"mmWave radars are compact, inexpensive, and durable sensors that are robust to occlusions and work regardless of environmental conditions, such as weather and darkness. However, this comes at the cost of poor angular resolution, especially for inexpensive single-chip radars, which are typically used in automotive and indoor sensing applications. Although many have proposed learning-based methods to mitigate this weakness, no standardized foundational models or large datasets for the mmWave radar have emerged, and practitioners have largely trained task-specific models from scratch using relatively small datasets.\n In this paper, we collect (to our knowledge) the largest available raw radar dataset with 1M samples (29 hours) and train a foundational model for 4D single-chip radar, which can predict 3D occupancy and semantic segmentation with quality that is typically only possible with much higher resolution sensors. We demonstrate that our Generalizable Radar Transformer (GRT) generalizes across diverse settings, can be fine-tuned for different tasks, and shows logarithmic data scaling of 20\\% per $10\\times$ data. We also run extensive ablations on common design decisions, and find that using raw radar data significantly outperforms widely-used lossy representations, equivalent to a $10\\times$ increase in training data. Finally, we roughly estimate that $\\approx$100M samples (3000 hours) of data are required to fully exploit the potential of GRT."},{"descriptionType":"Other","description":"To appear in ICCV 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12482","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:41:25Z","registered":"2025-09-17T01:41:26Z","published":null,"updated":"2025-09-17T01:41:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":40,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=id%3A%28%2210.48550%2Farxiv.2509.10696%22+OR+%2210.48550%2Farxiv.2509.11177%22+OR+%2210.48550%2Farxiv.2509.11481%22+OR+%2210.48550%2Farxiv.2509.12080%22+OR+%2210.48550%2Farxiv.2509.12086%22+OR+%2210.48550%2Farxiv.2509.12089%22+OR+%2210.48550%2Farxiv.2509.12102%22+OR+%2210.48550%2Farxiv.2509.12105%22+OR+%2210.48550%2Farxiv.2509.12108%22+OR+%2210.48550%2Farxiv.2509.12110%22+OR+%2210.48550%2Farxiv.2509.12112%22+OR+%2210.48550%2Farxiv.2509.12129%22+OR+%2210.48550%2Farxiv.2509.12132%22+OR+%2210.48550%2Farxiv.2509.12136%22+OR+%2210.48550%2Farxiv.2509.12145%22+OR+%2210.48550%2Farxiv.2509.12146%22+OR+%2210.48550%2Farxiv.2509.12168%22+OR+%2210.48550%2Farxiv.2509.12190%22+OR+%2210.48550%2Farxiv.2509.12194%22+OR+%2210.48550%2Farxiv.2509.12196%22+OR+%2210.48550%2Farxiv.2509.12201%22+OR+%2210.48550%2Farxiv.2509.12203%22+OR+%2210.48550%2Farxiv.2509.12350%22+OR+%2210.48550%2Farxiv.2509.12367%22+OR+%2210.48550%2Farxiv.2509.12371%22+OR+%2210.48550%2Farxiv.2509.12375%22+OR+%2210.48550%2Farxiv.2509.12382%22+OR+%2210.48550%2Farxiv.2509.12384%22+OR+%2210.48550%2Farxiv.2509.12385%22+OR+%2210.48550%2Farxiv.2509.12387%22+OR+%2210.48550%2Farxiv.2509.12416%22+OR+%2210.48550%2Farxiv.2509.12423%22+OR+%2210.48550%2Farxiv.2509.12434%22+OR+%2210.48550%2Farxiv.2509.12440%22+OR+%2210.48550%2Farxiv.2509.12443%22+OR+%2210.48550%2Farxiv.2509.12451%22+OR+%2210.48550%2Farxiv.2509.12459%22+OR+%2210.48550%2Farxiv.2509.12474%22+OR+%2210.48550%2Farxiv.2509.12476%22+OR+%2210.48550%2Farxiv.2509.12482%22%29\u0026page%5Bsize%5D=1000\u0026sort=name"}}