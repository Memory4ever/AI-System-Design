<th id="S4.T3.8.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Content accuracy</th>
<td id="S4.T3.8.2.2" class="ltx_td ltx_align_center ltx_border_t">5.59 (1.05)</td>
<td id="S4.T3.8.2.3" class="ltx_td ltx_align_center ltx_border_t">4.96 (0.92)</td>
<td id="S4.T3.8.2.4" class="ltx_td ltx_align_center ltx_border_t">2.80</td>
<td id="S4.T3.8.2.5" class="ltx_td ltx_align_center ltx_border_t">.026</td>
<td id="S4.T3.8.2.6" class="ltx_td ltx_align_center ltx_border_t">0.99</td></tr>
<tr id="S4.T3.8.3" class="ltx_tr">
<th id="S4.T3.8.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Information density</th>
<td id="S4.T3.8.3.2" class="ltx_td ltx_align_center">4.38 (1.12)</td>
