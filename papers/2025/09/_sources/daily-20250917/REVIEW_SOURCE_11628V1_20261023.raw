<td id="A4.T7.4.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T7.4.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">CLIP Score<span id="A4.T7.4.1.2.1.1" class="ltx_text ltx_font_medium"> <math id="A4.T7.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></span></td>
