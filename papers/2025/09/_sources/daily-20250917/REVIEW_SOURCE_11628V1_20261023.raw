<td id="A4.T7.4.5.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T7.4.5.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#E6E6E6;">1.010</span></td></tr>
