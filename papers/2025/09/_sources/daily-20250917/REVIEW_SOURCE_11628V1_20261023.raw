<td id="A5.T8.4.3.3" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">0.978</td></tr>
<tr id="A5.T8.4.4" class="ltx_tr">
<td id="A5.T8.4.4.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-left:10.0pt;padding-right:10.0pt;"><math id="A5.T8.m3" class="ltx_Math" alttext="\ell_{\infty}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\ell_{\infty}</annotation></semantics></math>-norm</td>
<td id="A5.T8.4.4.2" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;">19.18</td>
