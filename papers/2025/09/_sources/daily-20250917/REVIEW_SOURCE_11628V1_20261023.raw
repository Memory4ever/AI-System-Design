<td id="A4.T7.4.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T7.4.3.3.1" class="ltx_text" style="font-size:90%;">0.923</span></td></tr>
<tr id="A4.T7.4.4" class="ltx_tr">
<td id="A4.T7.4.4.1" class="ltx_td ltx_align_left ltx_border_r"><span id="A4.T7.4.4.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Speca(Adams-Bashforth)</span></td>
