<th id="Sx4.T2.1.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:0.0pt;padding-right:0.0pt;">Non-Causal</th>
<td id="Sx4.T2.1.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:0.0pt;padding-right:0.0pt;"><span id="Sx4.T2.1.2.3.1" class="ltx_text ltx_font_bold">15.63</span></td>
