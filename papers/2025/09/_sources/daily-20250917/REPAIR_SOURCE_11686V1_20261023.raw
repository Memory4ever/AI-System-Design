<td id="S4.T1.2.1.4.5" class="ltx_td ltx_align_center ltx_border_t" colspan="2">Code Reasoning</td></tr>
<tr id="S4.T1.2.1.5" class="ltx_tr">
<td id="S4.T1.2.1.5.1" class="ltx_td ltx_align_center">HumanEval</td>
<td id="S4.T1.2.1.5.2" class="ltx_td ltx_align_center">MBPP</td>
<td id="S4.T1.2.1.5.3" class="ltx_td ltx_align_center">LiveCodeBench(easy)</td>
<td id="S4.T1.2.1.5.4" class="ltx_td ltx_align_center ltx_border_r">BigcodeBench(full)</td>
<td id="S4.T1.2.1.5.5" class="ltx_td ltx_align_center">huamnevalpack(HE-R)</td>
<td id="S4.T1.2.1.5.6" class="ltx_td ltx_align_center ltx_border_r">MBPP-R</td>
