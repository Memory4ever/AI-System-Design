<td id="S4.T1.2.1.6.4" class="ltx_td ltx_align_center ltx_border_bb">880</td>
<td id="S4.T1.2.1.6.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">1140/148</td>
<td id="S4.T1.2.1.6.6" class="ltx_td ltx_align_center ltx_border_bb">164</td>
