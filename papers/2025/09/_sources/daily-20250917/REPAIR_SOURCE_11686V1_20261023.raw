<td id="S4.T1.2.1.4.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" rowspan="3"><span id="S4.T1.2.1.4.1.1" class="ltx_text ltx_font_bold">Evaluation</span></td>
<td id="S4.T1.2.1.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T1.2.1.4.2.1" class="ltx_text">Task</span></td>
<td id="S4.T1.2.1.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="4">Code Synthesis</td>
