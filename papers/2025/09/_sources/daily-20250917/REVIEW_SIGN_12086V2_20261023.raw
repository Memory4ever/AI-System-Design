<td id="S5.T3.2.6.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T3.m20" class="ltx_math_unparsed" alttext="7.7\times" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">7.7</mn><mo lspace="0.222em" mathsize="0.900em">×</mo></mrow><annotation encoding="application/x-tex">7.7\times</annotation></semantics></math></td>
<td id="S5.T3.2.6.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T3.m21" class="ltx_math_unparsed" alttext="4.1\times" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">4.1</mn><mo lspace="0.222em" mathsize="0.900em">×</mo></mrow><annotation encoding="application/x-tex">4.1\times</annotation></semantics></math></td>
<td id="S5.T3.2.6.5" class="ltx_td ltx_align_center ltx_border_bb"><math id="S5.T3.m22" class="ltx_math_unparsed" alttext="4.7\times" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">4.7</mn><mo lspace="0.222em" mathsize="0.900em">×</mo></mrow><annotation encoding="application/x-tex">4.7\times</annotation></semantics></math></td></tr>
