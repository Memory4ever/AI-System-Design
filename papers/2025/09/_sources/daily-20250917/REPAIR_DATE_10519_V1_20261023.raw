<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S6.F6.sf1.3" class="ltx_text" style="font-size:80%;">(a)</span> </span><span id="S6.F6.sf1.4" class="ltx_text" style="font-size:80%;">7-bit AppMults.</span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
