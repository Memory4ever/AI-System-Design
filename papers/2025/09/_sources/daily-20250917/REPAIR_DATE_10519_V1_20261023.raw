<td id="S6.T5.6.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S6.T5.6.3.4.1" class="ltx_text" style="--ltx-fg-color:#00B050;"><span id="S6.T5.6.3.4.1.1" class="ltx_text ltx_font_bold">67.59%</span></span></td>
<td id="S6.T5.6.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S6.T5.6.3.5.1" class="ltx_text" style="--ltx-fg-color:#00B050;"><span id="S6.T5.6.3.5.1.1" class="ltx_text ltx_font_bold">0.29%</span></span></td></tr>
