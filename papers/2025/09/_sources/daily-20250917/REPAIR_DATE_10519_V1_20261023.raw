</span></span><span id="S5.T1.2.1.1.3" class="ltx_text"></span></td>
<td id="S5.T1.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S5.T1.2.1.2.1" class="ltx_text"></span> <span id="S5.T1.2.1.2.2" class="ltx_text">
