</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.78 11.73)"><foreignObject style="--ltx-fo-width:40.78em;--ltx-fo-height:10.13em;--ltx-fo-depth:0.14em;font-size:10pt;" height="141.98" overflow="visible" transform="matrix(1 0 0 -1 0 140.1)" width="564.28"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
