<br class="ltx_break">7: Do not ask back anything about the user’s instructions.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</figure>
<figure id="S4.SS3.tab2" class="ltx_float ltx_float_tcbfloat"><span class="ltx_inline-block"><svg id="S4.SS3.pic2" class="ltx_picture" height="251.23" overflow="visible" version="1.1" viewBox="0 0 477.38 251.23" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,251.23) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 245.32 C 0 248.58 2.64 251.23 5.91 251.23 L 471.47 251.23 C 474.73 251.23 477.38 248.58 477.38 245.32 L 477.38 5.91 C 477.38 2.64 474.73 0 471.47 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 208.97 L 475.41 208.97 L 475.41 5.91 C 475.41 3.73 473.65 1.97 471.47 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.78 218.34)"><foreignObject style="--ltx-fo-width:28.27em;--ltx-fo-height:1.95em;--ltx-fo-depth:0.25em;font-size:10pt;" height="30.44" overflow="visible" transform="matrix(1 0 0 -1 0 26.98)" width="391.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
