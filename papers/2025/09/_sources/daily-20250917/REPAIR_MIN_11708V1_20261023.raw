<th id="S5.T5.6.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.T5.6.1.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Reject</span></th>
<th id="S5.T5.6.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.T5.6.1.2.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Accept &amp; Reject</span></th></tr>
</thead>
