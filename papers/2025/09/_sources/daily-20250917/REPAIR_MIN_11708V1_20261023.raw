<td id="A2.T6.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.3.1" class="ltx_text" style="font-size:90%;">8</span></td>
<td id="A2.T6.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.4.1" class="ltx_text" style="font-size:90%;">9</span></td>
<td id="A2.T6.5.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.5.1" class="ltx_text" style="font-size:90%;">13</span></td>
<td id="A2.T6.5.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.6.1" class="ltx_text" style="font-size:90%;">24</span></td>
<td id="A2.T6.5.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.7.1" class="ltx_text" style="font-size:90%;">31</span></td>
<td id="A2.T6.5.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.8.1" class="ltx_text" style="font-size:90%;">33</span></td>
<td id="A2.T6.5.2.9" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.9.1" class="ltx_text" style="font-size:90%;">35</span></td>
<td id="A2.T6.5.2.10" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.10.1" class="ltx_text" style="font-size:90%;">36</span></td>
<td id="A2.T6.5.2.11" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.11.1" class="ltx_text" style="font-size:90%;">37</span></td>
<td id="A2.T6.5.2.12" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.12.1" class="ltx_text" style="font-size:90%;">39</span></td>
<td id="A2.T6.5.2.13" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T6.5.2.13.1" class="ltx_text" style="font-size:90%;">40</span></td>
