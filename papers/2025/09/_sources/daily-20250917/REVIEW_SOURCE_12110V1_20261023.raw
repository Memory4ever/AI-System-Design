<p id="S2.F3.6.1" class="ltx_p ltx_align_center"><span id="S2.F3.6.1.1" class="ltx_text ltx_font_bold">(d) Amp feature</span></p>
</div></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<div id="S2.F3.7" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_bottom" style="width:169.1pt;"><object type="image/svg+xml" data="2509.12110v1/IGARSS_DP1.svg" id="S2.F3.g5" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:234/179;" width="234" height="179"></object>
<p id="S2.F3.7.1" class="ltx_p ltx_align_center"><span id="S2.F3.7.1.1" class="ltx_text ltx_font_bold">(e) DP feature (T)</span></p>
