</div></div><div class="ltx_flex_cell ltx_flex_size_2">
<div id="S2.F3.4" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_bottom" style="width:169.1pt;"><object type="image/svg+xml" data="2509.12110v1/IGARSS_DSE.svg" id="S2.F3.g2" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:234/174;" width="234" height="174"></object>
