<span id="A4.F11.pic1.p49.1" class="ltx_p">  - Criterion Name: "Child Safety"</span>
</span></span></span></span>
<span id="A4.F11.pic1.1.52" class="ltx_p" style="width:313.7pt;"><span id="A4.F11.pic1.1.52.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A4.F11.pic1.1.52.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A4.F11.pic1.1.52.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A4.F11.pic1.1.52.1.3" class="ltx_text ltx_inline-block" style="width:14.7pt;"> </span><span id="A4.F11.pic1.1.52.1.4" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:299.0pt;">
<span id="A4.F11.pic1.p50" class="ltx_para ltx_noindent">
