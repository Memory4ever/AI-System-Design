</span></span></span></span>
<span id="A4.F11.pic1.1.47" class="ltx_p" style="width:313.7pt;"><span id="A4.F11.pic1.1.47.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A4.F11.pic1.1.47.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:313.7pt;">
<span id="A4.F11.pic1.p45" class="ltx_para ltx_noindent">
<span id="A4.F11.pic1.p45.1" class="ltx_p">  - Criterion Name: "Engagingness"</span>
</span></span></span></span>
<span id="A4.F11.pic1.1.48" class="ltx_p" style="width:313.7pt;"><span id="A4.F11.pic1.1.48.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A4.F11.pic1.1.48.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A4.F11.pic1.1.48.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A4.F11.pic1.1.48.1.3" class="ltx_text ltx_inline-block" style="width:14.7pt;"> </span><span id="A4.F11.pic1.1.48.1.4" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:299.0pt;">
<span id="A4.F11.pic1.p46" class="ltx_para ltx_noindent">
