<span id="Sx4.T3.1.1.1.1.1.1.1.1.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:0.5pt;padding-right:0.5pt;">VGG-11</span>
<span id="Sx4.T3.1.1.1.1.1.1.1.1.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:0.5pt;padding-right:0.5pt;">VGG-16</span>
<span id="Sx4.T3.1.1.1.1.1.1.1.1.2.5" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:0.5pt;padding-right:0.5pt;">AlexNet</span></span>
</span>
