<tr id="S3.T2.4.1.6" class="ltx_tr">
<td id="S3.T2.4.1.6.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.75pt 5.0pt;">Stage 4: Discrete Tokenization</td>
