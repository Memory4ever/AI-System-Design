<td id="S5.T11.8.1.1.8" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T11.8.1.1.8.1" class="ltx_text ltx_font_bold">Rec.<math id="S5.T11.m7" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
