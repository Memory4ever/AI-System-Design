<td id="S5.T11.8.1.2.5" class="ltx_td ltx_align_center ltx_border_t">4.60</td>
<td id="S5.T11.8.1.2.6" class="ltx_td ltx_align_center ltx_border_t">278.2</td>
<td id="S5.T11.8.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T11.8.1.2.7.1" class="ltx_text ltx_font_bold">0.83</span></td>
<td id="S5.T11.8.1.2.8" class="ltx_td ltx_align_center ltx_border_t">0.57</td></tr>
