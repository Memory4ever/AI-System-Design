<td id="S5.T9.8.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="5"><span id="S5.T9.8.1.1.4.1" class="ltx_text ltx_font_bold">General &amp; Knowledge</span></td>
<td id="S5.T9.8.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S5.T9.8.1.1.5.1" class="ltx_text ltx_font_bold">TextRich</span></td></tr>
<tr id="S5.T9.8.1.2" class="ltx_tr">
<td id="S5.T9.8.1.2.1" class="ltx_td"></td>
