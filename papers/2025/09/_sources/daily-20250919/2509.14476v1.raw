<td id="S5.T9.8.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T9.8.1.2.3.1" class="ltx_text ltx_font_bold">AI2D</span></td>
<td id="S5.T9.8.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T9.8.1.2.4.1" class="ltx_text ltx_font_bold">SQA</span></td>
