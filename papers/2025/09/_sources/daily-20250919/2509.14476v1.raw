<td id="S5.T11.8.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T11.8.1.1.5.1" class="ltx_text ltx_font_bold">sFID<math id="S5.T11.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S5.T11.8.1.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T11.8.1.1.6.1" class="ltx_text ltx_font_bold">IS<math id="S5.T11.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
