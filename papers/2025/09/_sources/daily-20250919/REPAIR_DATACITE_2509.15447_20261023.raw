{"data":{"id":"10.48550/arxiv.2509.15447","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.15447","prefix":"10.48550","suffix":"arxiv.2509.15447","identifiers":[{"identifier":"2509.15447","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.15447"}],"creators":[{"name":"Cisar, Caitlin","nameType":"Personal","givenName":"Caitlin","familyName":"Cisar","affiliation":[],"nameIdentifiers":[]},{"name":"Sheffield, Emily","nameType":"Personal","givenName":"Emily","familyName":"Sheffield","affiliation":[],"nameIdentifiers":[]},{"name":"Drake, Joshua","nameType":"Personal","givenName":"Joshua","familyName":"Drake","affiliation":[],"nameIdentifiers":[]},{"name":"Harrell, Alden","nameType":"Personal","givenName":"Alden","familyName":"Harrell","affiliation":[],"nameIdentifiers":[]},{"name":"Chidambaram, Subramanian","nameType":"Personal","givenName":"Subramanian","familyName":"Chidambaram","affiliation":[],"nameIdentifiers":[]},{"name":"Nangia, Nikita","nameType":"Personal","givenName":"Nikita","familyName":"Nangia","affiliation":[],"nameIdentifiers":[]},{"name":"Arannil, Vinayak","nameType":"Personal","givenName":"Vinayak","familyName":"Arannil","affiliation":[],"nameIdentifiers":[]},{"name":"Williams, Alex","nameType":"Personal","givenName":"Alex","familyName":"Williams","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PILOT: Steering Synthetic Data Generation with Psychological \u0026amp; Linguistic Output Targeting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-18T21:43:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-22T00:09:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Generative AI applications commonly leverage user personas as a steering mechanism for synthetic data generation, but reliance on natural language representations forces models to make unintended inferences about which attributes to emphasize, limiting precise control over outputs. We introduce PILOT (Psychological and Linguistic Output Targeting), a two-phase framework for steering large language models with structured psycholinguistic profiles. In Phase 1, PILOT translates natural language persona descriptions into multidimensional profiles with normalized scores across linguistic and psychological dimensions. In Phase 2, these profiles guide generation along measurable axes of variation. We evaluate PILOT across three state-of-the-art LLMs (Mistral Large 2, Deepseek-R1, LLaMA 3.3 70B) using 25 synthetic personas under three conditions: Natural-language Persona Steering (NPS), Schema-Based Steering (SBS), and Hybrid Persona-Schema Steering (HPS). Results demonstrate that schema-based approaches significantly reduce artificial-sounding persona repetition while improving output coherence, with silhouette scores increasing from 0.098 to 0.237 and topic purity from 0.773 to 0.957. Our analysis reveals a fundamental trade-off: SBS produces more concise outputs with higher topical consistency, while NPS offers greater lexical diversity but reduced predictability. HPS achieves a balance between these extremes, maintaining output variety while preserving structural consistency. Expert linguistic evaluation confirms that PILOT maintains high response quality across all conditions, with no statistically significant differences between steering approaches.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.15447","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-22T01:39:53.000Z","registered":"2025-09-22T01:39:53.000Z","published":"2025","updated":"2025-09-22T01:39:54.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.15447","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}