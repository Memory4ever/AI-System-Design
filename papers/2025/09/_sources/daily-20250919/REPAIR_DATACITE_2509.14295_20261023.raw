{"data":{"id":"10.48550/arxiv.2509.14295","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14295","prefix":"10.48550","suffix":"arxiv.2509.14295","identifiers":[{"identifier":"2509.14295","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.14295"}],"creators":[{"name":"Kong, Fanqi","nameType":"Personal","givenName":"Fanqi","familyName":"Kong","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Ruijie","nameType":"Personal","givenName":"Ruijie","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Yin, Huaxiao","nameType":"Personal","givenName":"Huaxiao","familyName":"Yin","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Guibin","nameType":"Personal","givenName":"Guibin","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Xiaofei","nameType":"Personal","givenName":"Xiaofei","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Ziang","nameType":"Personal","givenName":"Ziang","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Zhaowei","nameType":"Personal","givenName":"Zhaowei","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Xiaoyuan","nameType":"Personal","givenName":"Xiaoyuan","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Song-Chun","nameType":"Personal","givenName":"Song-Chun","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Feng, Xue","nameType":"Personal","givenName":"Xue","familyName":"Feng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Aegis: Automated Error Generation and Attribution for Multi-Agent Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Multiagent Systems (cs.MA)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T02:31:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T00:01:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-22T06:46:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:25:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-25T12:30:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-26T00:45:46Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10-10T08:32:56Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-13T00:33:30Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-03-19T04:45:30Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-03-20T00:34:44Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-04-27T01:35:16Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2026-04-28T01:11:28Z","dateType":"Updated","dateInformation":"v6"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"6","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large language model based multi-agent systems (MAS) have unlocked significant advancements in tackling complex problems, but their increasing capability introduces a structural fragility that makes them difficult to debug. A key obstacle to improving their reliability is the severe scarcity of large-scale, diverse datasets for error attribution, as existing resources rely on costly and unscalable manual annotation. To address this bottleneck, we introduce Aegis, a novel framework for Automated error generation and attribution for multi-agent systems. Aegis constructs a large dataset of 9,533 trajectories with annotated faulty agents and error modes, covering diverse MAS architectures and task domains. This is achieved using a LLM-based manipulator that can adaptively inject context-aware errors into successful execution trajectories. Leveraging fine-grained labels and the structured arrangement of positive-negative sample pairs, Aegis supports three different learning paradigms: Supervised Fine-Tuning, Reinforcement Learning, and Contrastive Learning. We develop learning methods for each paradigm. Comprehensive experiments show that trained models consistently achieve substantial improvements in error attribution. Notably, several of our fine-tuned LLMs demonstrate performance competitive with or superior to proprietary models an order of magnitude larger, validating our automated data generation framework as a crucial resource for developing more robust and interpretable multi-agent systems. Our project website is available at https://kfq20.github.io/Aegis-Website/.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.14295","contentUrl":null,"metadataVersion":6,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:28:41.000Z","registered":"2025-09-19T01:28:42.000Z","published":"2025","updated":"2026-04-28T04:04:28.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.14295","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}