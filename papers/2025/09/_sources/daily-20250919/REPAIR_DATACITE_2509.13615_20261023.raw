{"data":{"id":"10.48550/arxiv.2509.13615","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13615","prefix":"10.48550","suffix":"arxiv.2509.13615","identifiers":[{"identifier":"2509.13615","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.13615"}],"creators":[{"name":"Wu, Zongru","nameType":"Personal","givenName":"Zongru","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Mao, Rui","nameType":"Personal","givenName":"Rui","familyName":"Mao","affiliation":[],"nameIdentifiers":[]},{"name":"Tian, Zhiyuan","nameType":"Personal","givenName":"Zhiyuan","familyName":"Tian","affiliation":[],"nameIdentifiers":[]},{"name":"Cheng, Pengzhou","nameType":"Personal","givenName":"Pengzhou","familyName":"Cheng","affiliation":[],"nameIdentifiers":[]},{"name":"Ju, Tianjie","nameType":"Personal","givenName":"Tianjie","familyName":"Ju","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Zheng","nameType":"Personal","givenName":"Zheng","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Dong, Lingzhong","nameType":"Personal","givenName":"Lingzhong","familyName":"Dong","affiliation":[],"nameIdentifiers":[]},{"name":"Sheng, Haiyue","nameType":"Personal","givenName":"Haiyue","familyName":"Sheng","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Zhuosheng","nameType":"Personal","givenName":"Zhuosheng","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Gongshen","nameType":"Personal","givenName":"Gongshen","familyName":"Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"See, Think, Act: Teaching Multimodal Agents to Effectively Interact with GUI by Identifying Toggles"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Human-Computer Interaction (cs.HC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T01:14:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:14:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-28T03:35:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T01:25:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-03T14:25:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-04T01:55:36Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03-04T02:51:29Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-03-05T01:24:08Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-03-18T08:12:54Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-03-19T00:55:17Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The advent of multimodal agents facilitates effective interaction within graphical user interface (GUI), especially in ubiquitous GUI control. However, their inability to reliably execute toggle control instructions remains a key bottleneck. To investigate this, we construct a state control benchmark with binary toggle instructions derived from public datasets. Evaluation results of existing agents demonstrate their notable unreliability, particularly when the current toggle state already matches the desired state. To address the challenge, we propose State-aware Reasoning (StaR), a multimodal reasoning method that enables agents to perceive the current toggle state, infer the desired state from the instruction, and act accordingly. Experiments on four multimodal agents demonstrate that StaR can improve toggle instruction execution accuracy by over 30\\%. Further evaluations on three public agentic benchmarks show that StaR also enhances general agentic task performance. Finally, evaluations on a dynamic environment highlight the potential of StaR for real-world applications. Code and benchmark: https://github.com/ZrW00/StaR.","descriptionType":"Abstract"},{"description":"Accepted at CVPR 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.13615","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:52:55.000Z","registered":"2025-09-18T17:52:56.000Z","published":"2025","updated":"2026-03-19T02:53:42.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.13615","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}