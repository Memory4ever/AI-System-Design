<td id="S4.T5.2.11.4" class="ltx_td ltx_align_left" style="padding-left:12.0pt;padding-right:12.0pt;">0.280<sup id="S4.T5.2.11.4.1" class="ltx_sup"><span id="S4.T5.2.11.4.1.1" class="ltx_text ltx_font_italic">∗</span></sup></td>
