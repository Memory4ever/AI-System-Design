<td id="S3.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.9pt;padding-right:4.9pt;" colspan="11"><span id="S3.T2.2.2.1.1" class="ltx_text ltx_font_italic">First-stage retrieval (dense)<span class="ltx_rule" style="width:0.0pt;height:8.0pt;--ltx-bg-color:black;display:inline-block;"></span></span></td></tr>
<tr id="S3.T2.2.3" class="ltx_tr">
<td id="S3.T2.2.3.1" class="ltx_td ltx_align_left" style="padding-left:4.9pt;padding-right:4.9pt;">(1a) mGTE</td>
<td id="S3.T2.2.3.2" class="ltx_td ltx_align_left" style="padding-left:4.9pt;padding-right:4.9pt;"><span id="S3.T2.2.3.2.1" class="ltx_text ltx_font_bold">0.324</span></td>
<td id="S3.T2.2.3.3" class="ltx_td ltx_align_left" style="padding-left:4.9pt;padding-right:4.9pt;">0.302</td>
