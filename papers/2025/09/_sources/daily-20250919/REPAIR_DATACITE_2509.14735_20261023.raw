{"data":{"id":"10.48550/arxiv.2509.14735","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14735","prefix":"10.48550","suffix":"arxiv.2509.14735","identifiers":[{"identifier":"2509.14735","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.14735"}],"creators":[{"name":"Tan, Chenkun","nameType":"Personal","givenName":"Chenkun","familyName":"Tan","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Pengyu","nameType":"Personal","givenName":"Pengyu","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Shaojun","nameType":"Personal","givenName":"Shaojun","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Botian","nameType":"Personal","givenName":"Botian","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Zhaowei","nameType":"Personal","givenName":"Zhaowei","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Dong","nameType":"Personal","givenName":"Dong","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Xinghao","nameType":"Personal","givenName":"Xinghao","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Yaqian","nameType":"Personal","givenName":"Yaqian","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Qiu, Xipeng","nameType":"Personal","givenName":"Xipeng","familyName":"Qiu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoupled Proxy Alignment: Mitigating Language Prior Conflict for Multimodal Alignment in MLLM"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-18T08:37:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T00:28:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Multimodal large language models (MLLMs) have gained significant attention due to their impressive ability to integrate vision and language modalities. Recent advancements in MLLMs have primarily focused on improving performance through high-quality datasets, novel architectures, and optimized training strategies. However, in this paper, we identify a previously overlooked issue, language prior conflict, a mismatch between the inherent language priors of large language models (LLMs) and the language priors in training datasets. This conflict leads to suboptimal vision-language alignment, as MLLMs are prone to adapting to the language style of training samples. To address this issue, we propose a novel training method called Decoupled Proxy Alignment (DPA). DPA introduces two key innovations: (1) the use of a proxy LLM during pretraining to decouple the vision-language alignment process from language prior interference, and (2) dynamic loss adjustment based on visual relevance to strengthen optimization signals for visually relevant tokens. Extensive experiments demonstrate that DPA significantly mitigates the language prior conflict, achieving superior alignment performance across diverse datasets, model families, and scales. Our method not only improves the effectiveness of MLLM training but also shows exceptional generalization capabilities, making it a robust approach for vision-language alignment. Our code is available at https://github.com/fnlp-vision/DPA.","descriptionType":"Abstract"},{"description":"Accepted by Findings of EMNLP2025","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.14735","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:39:08.000Z","registered":"2025-09-19T01:39:09.000Z","published":"2025","updated":"2025-09-19T01:39:09.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.14735","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}