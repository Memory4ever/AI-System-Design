<td id="A1.T5.2.1.1.2" class="ltx_td ltx_align_right ltx_border_tt"><span id="A1.T5.2.1.1.2.1" class="ltx_text ltx_font_bold">English</span></td>
<td id="A1.T5.2.1.1.3" class="ltx_td ltx_align_right ltx_border_tt"><span id="A1.T5.2.1.1.3.1" class="ltx_text ltx_font_bold">Singlish</span></td>
<td id="A1.T5.2.1.1.4" class="ltx_td ltx_align_right ltx_border_tt"><span id="A1.T5.2.1.1.4.1" class="ltx_text ltx_font_bold">Chinese</span></td>
<td id="A1.T5.2.1.1.5" class="ltx_td ltx_align_right ltx_border_tt"><span id="A1.T5.2.1.1.5.1" class="ltx_text ltx_font_bold">Malay</span></td>
<td id="A1.T5.2.1.1.6" class="ltx_td ltx_align_right ltx_border_tt"><span id="A1.T5.2.1.1.6.1" class="ltx_text ltx_font_bold">Tamil</span></td></tr>
<tr id="A1.T5.2.1.2" class="ltx_tr">
