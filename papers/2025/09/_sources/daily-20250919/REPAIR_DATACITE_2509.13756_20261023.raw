{"data":{"id":"10.48550/arxiv.2509.13756","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13756","prefix":"10.48550","suffix":"arxiv.2509.13756","identifiers":[{"identifier":"2509.13756","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.13756"}],"creators":[{"name":"Yang, Yuqi","nameType":"Personal","givenName":"Yuqi","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Chang, Dongliang","nameType":"Personal","givenName":"Dongliang","familyName":"Chang","affiliation":[],"nameIdentifiers":[]},{"name":"Fang, Yuanchen","nameType":"Personal","givenName":"Yuanchen","familyName":"Fang","affiliation":[],"nameIdentifiers":[]},{"name":"SonG, Yi-Zhe","nameType":"Personal","givenName":"Yi-Zhe","familyName":"SonG","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Zhanyu","nameType":"Personal","givenName":"Zhanyu","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Jun","nameType":"Personal","givenName":"Jun","familyName":"Guo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Controllable-Continuous Color Editing in Diffusion Model via Color Mapping"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T07:12:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:27:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"In recent years, text-driven image editing has made significant progress. However, due to the inherent ambiguity and discreteness of natural language, color editing still faces challenges such as insufficient precision and difficulty in achieving continuous control. Although linearly interpolating the embedding vectors of different textual descriptions can guide the model to generate a sequence of images with varying colors, this approach lacks precise control over the range of color changes in the output images. Moreover, the relationship between the interpolation coefficient and the resulting image color is unknown and uncontrollable. To address these issues, we introduce a color mapping module that explicitly models the correspondence between the text embedding space and image RGB values. This module predicts the corresponding embedding vector based on a given RGB value, enabling precise color control of the generated images while maintaining semantic consistency. Users can specify a target RGB range to generate images with continuous color variations within the desired range, thereby achieving finer-grained, continuous, and controllable color editing. Experimental results demonstrate that our method performs well in terms of color continuity and controllability.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.13756","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:58:34.000Z","registered":"2025-09-18T17:58:35.000Z","published":"2025","updated":"2025-09-18T17:58:35.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.13756","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}