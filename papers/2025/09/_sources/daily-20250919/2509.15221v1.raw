<span id="A1.SS9.SSS1.p3.pic1.2.57" class="ltx_p" style="width:366.2pt;"><span id="A1.SS9.SSS1.p3.pic1.2.57.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A1.SS9.SSS1.p3.pic1.2.57.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:366.2pt;"></span></span></span>
