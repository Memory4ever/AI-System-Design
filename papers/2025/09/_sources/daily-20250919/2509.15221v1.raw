<span id="A1.SS9.SSS1.p3.pic1.p50.1" class="ltx_p">def long_press(x: float, y: float, duration: int = 1) -&gt; None:</span>
</span></span></span></span>
<span id="A1.SS9.SSS1.p3.pic1.2.51" class="ltx_p" style="width:366.2pt;"><span id="A1.SS9.SSS1.p3.pic1.2.51.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A1.SS9.SSS1.p3.pic1.2.51.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A1.SS9.SSS1.p3.pic1.2.51.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A1.SS9.SSS1.p3.pic1.2.51.1.3" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:366.2pt;">
