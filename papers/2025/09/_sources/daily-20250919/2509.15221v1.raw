<span id="A1.T13.2.1.12.3.1" class="ltx_inline-block ltx_align_top" style="width:227.6pt;">
<span id="A1.T13.2.1.12.3.1.1" class="ltx_p">Drag the mouse to (x, y) while holding the specified button.</span>
</span></td></tr>
<tr id="A1.T13.2.1.13" class="ltx_tr">
<td id="A1.T13.2.1.13.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;"><span id="A1.T13.2.1.13.1.1" class="ltx_text ltx_font_typewriter">press(keys, presses)</span></td>
<td id="A1.T13.2.1.13.2" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1pt;padding-bottom:1pt;">Desktop &amp; Web</td>
<td id="A1.T13.2.1.13.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:1pt;padding-bottom:1pt;">
