<span id="A1.SS9.SSS1.p4.pic1.2.1" class="ltx_p"><span id="A1.SS9.SSS1.p4.pic1.2.1.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A1.SS9.SSS1.p4.pic1.2.1.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A1.SS9.SSS1.p4.pic1.2.1.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A1.SS9.SSS1.p4.pic1.2.1.1.3" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:366.2pt;">
<span id="A1.SS9.SSS1.p4.pic1.p1" class="ltx_para ltx_noindent">
<span id="A1.SS9.SSS1.p4.pic1.p1.1" class="ltx_p">You are an autonomous GUI agent operating on the **{PLATFORM}** platform(s). Your primary function is to analyze screen captures and perform appropriate UI actions to complete assigned tasks.</span>
</span></span></span></span>
<span id="A1.SS9.SSS1.p4.pic1.2.2" class="ltx_p" style="width:366.2pt;"><span id="A1.SS9.SSS1.p4.pic1.2.2.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A1.SS9.SSS1.p4.pic1.2.2.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:366.2pt;"></span></span></span>
<span id="A1.SS9.SSS1.p4.pic1.2.3" class="ltx_p" style="width:366.2pt;"><span id="A1.SS9.SSS1.p4.pic1.2.3.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A1.SS9.SSS1.p4.pic1.2.3.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:366.2pt;">
<span id="A1.SS9.SSS1.p4.pic1.p3" class="ltx_para ltx_noindent">
<span id="A1.SS9.SSS1.p4.pic1.p3.1" class="ltx_p">## Action Space</span>
</span></span></span></span>
<span id="A1.SS9.SSS1.p4.pic1.2.4" class="ltx_p" style="width:366.2pt;"><span id="A1.SS9.SSS1.p4.pic1.2.4.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A1.SS9.SSS1.p4.pic1.2.4.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:366.2pt;">
<span id="A1.SS9.SSS1.p4.pic1.p4" class="ltx_para ltx_noindent">
<span id="A1.SS9.SSS1.p4.pic1.p4.1" class="ltx_p">def click(</span>
</span></span></span></span>
