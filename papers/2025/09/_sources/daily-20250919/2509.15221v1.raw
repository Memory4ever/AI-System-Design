<span id="A1.SS9.SSS1.p5.pic1.p85" class="ltx_para ltx_noindent">
<span id="A1.SS9.SSS1.p5.pic1.p85.1" class="ltx_p">def terminate(status: str = "success", info: str | None = None) -&gt; None:</span>
</span></span></span></span>
<span id="A1.SS9.SSS1.p5.pic1.2.86" class="ltx_p" style="width:366.2pt;"><span id="A1.SS9.SSS1.p5.pic1.2.86.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A1.SS9.SSS1.p5.pic1.2.86.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A1.SS9.SSS1.p5.pic1.2.86.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A1.SS9.SSS1.p5.pic1.2.86.1.3" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:366.2pt;">
<span id="A1.SS9.SSS1.p5.pic1.p86" class="ltx_para ltx_noindent">
<span id="A1.SS9.SSS1.p5.pic1.p86.1" class="ltx_p">    """Terminate the current task with a status. The `status` specifies the termination status (’success’, ’failure’), and the `info` can provide additional information about the termination."""</span>
</span></span></span></span>
<span id="A1.SS9.SSS1.p5.pic1.2.87" class="ltx_p" style="width:366.2pt;"><span id="A1.SS9.SSS1.p5.pic1.2.87.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A1.SS9.SSS1.p5.pic1.2.87.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:366.2pt;">
<span id="A1.SS9.SSS1.p5.pic1.p87" class="ltx_para ltx_noindent">
<span id="A1.SS9.SSS1.p5.pic1.p87.1" class="ltx_p">    pass</span>
</span></span></span></span>
<span id="A1.SS9.SSS1.p5.pic1.2.88" class="ltx_p" style="width:366.2pt;"><span id="A1.SS9.SSS1.p5.pic1.2.88.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A1.SS9.SSS1.p5.pic1.2.88.1.1" class="ltx_inline-logical-block ltx_parbox ltx_pruned_first ltx_align_top" style="width:366.2pt;"></span></span></span>
