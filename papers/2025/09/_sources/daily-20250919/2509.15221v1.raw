<span id="A1.SS9.SSS1.p5.pic1.p102.1" class="ltx_p">[A set of executable action command]</span>
</span></span></span></span>
<span id="A1.SS9.SSS1.p5.pic1.2.103" class="ltx_p" style="width:366.2pt;"><span id="A1.SS9.SSS1.p5.pic1.2.103.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:366.2pt;--ltx-fg-color:#000000;"><span id="A1.SS9.SSS1.p5.pic1.2.103.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:366.2pt;">
