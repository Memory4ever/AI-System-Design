<td id="A2.T12.2.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_tt">
<span id="A2.T12.2.1.2.1" class="ltx_inline-block" style="width:307.2pt;">
<span id="A2.T12.2.1.2.1.1" class="ltx_block ltx_parbox ltx_align_middle" style="width:307.2pt;">
