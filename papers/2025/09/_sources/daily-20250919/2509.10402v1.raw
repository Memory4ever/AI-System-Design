80%;--ltx-fg-color:#0000FF;">9</span><span id="lstnumberx17.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">T00</span><span id="lstnumberx17.20" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#FF0000;">:</span><span id="lstnumberx17.21" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#0000FF;">0</span><span id="lstnumberx17.22" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#0000FF;">2</span><span id="lstnumberx17.23" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#FF0000;">:</span><span id="lstnumberx17.24" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#0000FF;">5</span><span id="lstnumberx17.25" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#0000FF;">3</span><span id="lstnumberx17.26" class="ltx_text ltx_font_typewriter" style="font-size:80%;">+</span><span id="lstnumberx17.27" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#0000FF;">0</span><span id="lstnumberx17.28" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#0000FF;">0</span><span id="lstnumberx17.29" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#FF0000;">:</span><span id="lstnumberx17.30" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#0000FF;">0</span><span id="lstnumberx17.31" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#0000FF;">0</span><span id="lstnumberx17.32" class="ltx_text ltx_font_typewriter" style="font-size:80%;">"</span>
