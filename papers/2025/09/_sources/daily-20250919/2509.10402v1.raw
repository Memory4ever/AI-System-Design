<span id="S4.T7.5.1.1.1.1.1.1.42.2" class="ltx_td ltx_align_right ltx_border_t">623</span>
<span id="S4.T7.5.1.1.1.1.1.1.42.3" class="ltx_td ltx_align_right ltx_border_t">10.0%</span>
<span id="S4.T7.5.1.1.1.1.1.1.42.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">IDE0040:AddAccessModifiers</span></span>
