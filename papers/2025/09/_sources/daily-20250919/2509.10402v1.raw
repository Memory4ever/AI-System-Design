<span id="S4.T8.5.1.1.1.12.3" class="ltx_td ltx_nopad_r ltx_align_right">1.1%</span></span>
<span id="S4.T8.5.1.1.1.13" class="ltx_tr">
<span id="S4.T8.5.1.1.1.13.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T8.5.1.1.1.13.1.1" class="ltx_text ltx_font_bold">Total</span></span>
<span id="S4.T8.5.1.1.1.13.2" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T8.5.1.1.1.13.2.1" class="ltx_text ltx_font_bold">267</span></span>
<span id="S4.T8.5.1.1.1.13.3" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t"><span id="S4.T8.5.1.1.1.13.3.1" class="ltx_text ltx_font_bold">100.0%</span></span></span>
<span id="S4.T8.5.1.1.1.14" class="ltx_tr">
