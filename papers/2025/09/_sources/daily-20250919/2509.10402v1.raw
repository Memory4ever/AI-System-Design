<span id="S4.T8.5.1.1.1.5.3" class="ltx_td ltx_nopad_r ltx_align_right">13.9%</span></span>
<span id="S4.T8.5.1.1.1.6" class="ltx_tr">
<span id="S4.T8.5.1.1.1.6.1" class="ltx_td ltx_align_left"><span id="S4.T8.5.1.1.1.6.1.1" class="ltx_text ltx_font_bold">Request Full Code<sup id="S4.T8.5.1.1.1.6.1.1.1" class="ltx_sup"><span id="S4.T8.5.1.1.1.6.1.1.1.1" class="ltx_text ltx_font_italic">∗</span></sup></span></span>
<span id="S4.T8.5.1.1.1.6.2" class="ltx_td ltx_align_right"><span id="S4.T8.5.1.1.1.6.2.1" class="ltx_text ltx_font_bold">29</span></span>
<span id="S4.T8.5.1.1.1.6.3" class="ltx_td ltx_nopad_r ltx_align_right"><span id="S4.T8.5.1.1.1.6.3.1" class="ltx_text ltx_font_bold">10.9%</span></span></span>
<span id="S4.T8.5.1.1.1.7" class="ltx_tr">
<span id="S4.T8.5.1.1.1.7.1" class="ltx_td ltx_align_left">Add more context</span>
<span id="S4.T8.5.1.1.1.7.2" class="ltx_td ltx_align_right">19</span>
