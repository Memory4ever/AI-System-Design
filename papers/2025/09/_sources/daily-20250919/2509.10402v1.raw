<span id="S4.T8.5.1.1.1.9.1" class="ltx_td ltx_align_left"><span id="S4.T8.5.1.1.1.9.1.1" class="ltx_text ltx_font_bold">Change Use Cases<sup id="S4.T8.5.1.1.1.9.1.1.1" class="ltx_sup"><span id="S4.T8.5.1.1.1.9.1.1.1.1" class="ltx_text ltx_font_italic">∗</span></sup></span></span>
<span id="S4.T8.5.1.1.1.9.2" class="ltx_td ltx_align_right"><span id="S4.T8.5.1.1.1.9.2.1" class="ltx_text ltx_font_bold">8</span></span>
<span id="S4.T8.5.1.1.1.9.3" class="ltx_td ltx_nopad_r ltx_align_right"><span id="S4.T8.5.1.1.1.9.3.1" class="ltx_text ltx_font_bold">3.0%</span></span></span>
<span id="S4.T8.5.1.1.1.10" class="ltx_tr">
<span id="S4.T8.5.1.1.1.10.1" class="ltx_td ltx_align_left">Request examples</span>
<span id="S4.T8.5.1.1.1.10.2" class="ltx_td ltx_align_right">6</span>
<span id="S4.T8.5.1.1.1.10.3" class="ltx_td ltx_nopad_r ltx_align_right">2.2%</span></span>
<span id="S4.T8.5.1.1.1.11" class="ltx_tr">
<span id="S4.T8.5.1.1.1.11.1" class="ltx_td ltx_align_left">Request alternative code generation</span>
<span id="S4.T8.5.1.1.1.11.2" class="ltx_td ltx_align_right">3</span>
<span id="S4.T8.5.1.1.1.11.3" class="ltx_td ltx_nopad_r ltx_align_right">1.1%</span></span>
