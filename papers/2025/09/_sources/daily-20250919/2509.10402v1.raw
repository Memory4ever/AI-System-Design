<span id="S4.T8.5.1.1.1.1.2" class="ltx_td ltx_align_right ltx_border_tt"><span id="S4.T8.5.1.1.1.1.2.1" class="ltx_text ltx_font_bold">Frequency</span></span>
<span id="S4.T8.5.1.1.1.1.3" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_tt"><span id="S4.T8.5.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Percentage</span></span></span>
