<span id="S3.F5.p2.1.1.1.1.1.1.1.2.4.1.1" class="ltx_p">31.35</span>
</span></span>
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.5.1" class="ltx_inline-block ltx_align_top" style="width:18.2pt;">
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.5.1.1" class="ltx_p">8.75</span>
</span></span>
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.6.1" class="ltx_inline-block ltx_align_top" style="width:18.2pt;">
