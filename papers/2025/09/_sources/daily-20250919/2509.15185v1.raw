</span></span></span>
<span id="S3.F5.p2.1.1.1.1.1.1.1.2" class="ltx_tr">
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.1.1" class="ltx_inline-block ltx_align_top" style="width:65.4pt;">
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.1.1.1" class="ltx_p">LlamaGen-B</span>
</span></span>
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:21.1pt;">
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.2.1.1" class="ltx_p">111M</span>
</span></span>
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.3.1" class="ltx_inline-block ltx_align_top" style="width:18.8pt;">
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.3.1.1" class="ltx_p">50</span>
</span></span>
<span id="S3.F5.p2.1.1.1.1.1.1.1.2.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
