<span id="S4.T1.2.1.1.1.1.1.1.9.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_t"><span id="S4.T1.2.1.1.1.1.1.1.9.2.1" class="ltx_text ltx_font_bold">61.88</span> : 38.12</span>
<span id="S4.T1.2.1.1.1.1.1.1.9.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_t"><span id="S4.T1.2.1.1.1.1.1.1.9.3.1" class="ltx_text ltx_font_bold">83.46</span> : 16.54</span>
<span id="S4.T1.2.1.1.1.1.1.1.9.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="S4.T1.2.1.1.1.1.1.1.9.4.1" class="ltx_text ltx_font_bold">82.58</span> : 17.42</span>
