<span id="S5.T4.2.1.1.1.1.1.11.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#EFEFEF;"><span id="S5.T4.2.1.1.1.1.1.11.4.1" class="ltx_text" style="--ltx-bg-color:#EFEFEF;">89.83</span></span>
