<span id="A3.T18.2.1.1.1.1.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="A3.T18.2.1.1.1.1.1.1.2.1" class="ltx_text ltx_font_typewriter">PEJ</span></span>
<span id="A3.T18.2.1.1.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T18.2.1.1.1.1.1.1.3.1" class="ltx_text ltx_font_typewriter">MRJ</span></span></span>
<span id="A3.T18.2.1.1.1.1.1.2" class="ltx_tr">
