               predict<sub id="alg1.l17.2" class="ltx_sub"><span id="alg1.l17.2.1" class="ltx_text ltx_font_italic">i</span></sub> <math id="alg1.l17.m2" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> best_PLM<sub id="alg1.l17.3" class="ltx_sub"><span id="alg1.l17.3.1" class="ltx_text ltx_font_italic">i</span></sub>(comment)

</div>
<div id="alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">18:</span>
              
              
              <span id="alg1.l18.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l18.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">19:</span>
              
              
              label <math id="alg1.l19.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> vote(predict<sub id="alg1.l19.2" class="ltx_sub">1</sub>, …, predict<sub id="alg1.l19.3" class="ltx_sub">5</sub>)

</div>
<div id="alg1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">20:</span>
              
              
            <span id="alg1.l20.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l20.3" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.5" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> <span id="alg2.6" class="ltx_text ltx_font_bold">Prompt-variants Ensemble Judgment</span> (<span id="alg2.7" class="ltx_text ltx_font_typewriter">PEJ</span>)</figcaption>
<div id="alg2.8" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            OL <math id="alg2.l1.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> refers to offensive language

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            <span id="alg2.l2.2" class="ltx_text ltx_font_bold">for</span> comment <math id="alg2.l2.m1" class="ltx_Math" alttext="\in" display="inline" intent=":literal"><semantics><mo>∈</mo><annotation encoding="application/x-tex">\in</annotation></semantics></math> <span id="alg2.l2.3" class="ltx_text ltx_font_bold ltx_font_italic">PoliticalK.O<span id="alg2.l2.3.1" class="ltx_text ltx_font_medium ltx_font_upright" style="position:relative; bottom:-0.4pt;"><img src="" id="alg2.l2.g1" class="ltx_graphics ltx_missing ltx_missing_image" alt="[Uncaptioned image]"></span></span> <span id="alg2.l2.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
              <span id="alg2.l3.2" class="ltx_text" style="--ltx-fg-color:#0000FF;">## prompt construction</span>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
              prompt<math id="alg2.l4.m1" class="ltx_math_unparsed" alttext="{}_{\textit{V}}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mtext class="ltx_mathvariant_italic">V</mtext></msub><mo stretchy="false">←</mo></mrow><annotation encoding="application/x-tex">{}_{\textit{V}}\leftarrow</annotation></semantics></math> (<span id="alg2.l4.2" class="ltx_text ltx_font_italic">basic instruction</span> for OL, comment)

</div>
<div id="alg2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              prompt<math id="alg2.l5.m1" class="ltx_math_unparsed" alttext="{}_{\textit{D}}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mrow></mrow><mtext class="ltx_mathvariant_italic">D</mtext></msub><mo stretchy="false">←</mo></mrow><annotation encoding="application/x-tex">{}_{\textit{D}}\leftarrow</annotation></semantics></math> prompt<math id="alg2.l5.m2" class="ltx_Math" alttext="{}_{\textit{V}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_italic">V</mtext></msub><annotation encoding="application/x-tex">{}_{\textit{V}}</annotation></semantics></math> + <span id="alg2.l5.2" class="ltx_text ltx_font_italic">refined definition</span> for OL

</div>
<div id="alg2.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
