<span id="S4.T2.2.1.1.1.1.1.7.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T2.2.1.1.1.1.1.7.2.1" class="ltx_text" style="--ltx-bg-color:#EFEFEF;">38.47</span></span>
<span id="S4.T2.2.1.1.1.1.1.7.3" class="ltx_td ltx_align_center"><span id="S4.T2.2.1.1.1.1.1.7.3.1" class="ltx_text" style="--ltx-bg-color:#EFEFEF;">27.51</span></span>
<span id="S4.T2.2.1.1.1.1.1.7.4" class="ltx_td ltx_align_center"><span id="S4.T2.2.1.1.1.1.1.7.4.1" class="ltx_text" style="--ltx-bg-color:#EFEFEF;">64.27</span></span></span>
