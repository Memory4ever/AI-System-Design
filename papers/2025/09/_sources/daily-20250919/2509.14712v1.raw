<span id="A2.T8.2.1.1.1.1.1.5.2" class="ltx_td ltx_align_center ltx_border_r"><span id="A2.T8.2.1.1.1.1.1.5.2.1" class="ltx_text" style="--ltx-bg-color:#EFEFEF;">(3.98, 0.39)</span></span>
<span id="A2.T8.2.1.1.1.1.1.5.3" class="ltx_td ltx_align_center ltx_border_r"><span id="A2.T8.2.1.1.1.1.1.5.3.1" class="ltx_text" style="--ltx-bg-color:#EFEFEF;">(4.73, 0.53)</span></span>
<span id="A2.T8.2.1.1.1.1.1.5.4" class="ltx_td ltx_align_center"><span id="A2.T8.2.1.1.1.1.1.5.4.1" class="ltx_text" style="--ltx-bg-color:#EFEFEF;">(4.82, 0.78)</span></span></span>
<span id="A2.T8.2.1.1.1.1.1.6" class="ltx_tr">
<span id="A2.T8.2.1.1.1.1.1.6.1" class="ltx_td ltx_align_left ltx_border_r">
