<tr id="A2.T9.2.6" class="ltx_tr">
<th id="A2.T9.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Claude-3.5</th>
<td id="A2.T9.2.6.2" class="ltx_td ltx_align_center ltx_border_bb">6.0</td>
