<td id="A2.T8.2.3.2" class="ltx_td ltx_align_center" style="padding-left:20.0pt;padding-right:20.0pt;">  <math id="A2.T8.m2" class="ltx_Math" alttext="31.2\,\text{{\color[rgb]{0.55,0.55,0.55}\,±\,1.47}}" display="inline" intent=":literal"><semantics><mrow><mn>31.2</mn><mo lspace="0.170em" rspace="0em">​</mo><mtext style="--ltx-fg-color:#8C8C8C;" mathcolor="#8C8C8C"> ± 1.47</mtext></mrow><annotation encoding="application/x-tex">31.2\,\text{{\color[rgb]{0.55,0.55,0.55}\,±\,1.47}}</annotation></semantics></math></td></tr>
<tr id="A2.T8.2.4" class="ltx_tr">
<th id="A2.T8.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:20.0pt;padding-right:20.0pt;">  Qwen2.5-7B</th>
<td id="A2.T8.2.4.2" class="ltx_td ltx_align_center" style="padding-left:20.0pt;padding-right:20.0pt;">  <math id="A2.T8.m3" class="ltx_Math" alttext="69.0\,\text{{\color[rgb]{0.55,0.55,0.55}\,±\,0.63}}" display="inline" intent=":literal"><semantics><mrow><mn>69.0</mn><mo lspace="0.170em" rspace="0em">​</mo><mtext style="--ltx-fg-color:#8C8C8C;" mathcolor="#8C8C8C"> ± 0.63</mtext></mrow><annotation encoding="application/x-tex">69.0\,\text{{\color[rgb]{0.55,0.55,0.55}\,±\,0.63}}</annotation></semantics></math></td></tr>
<tr id="A2.T8.2.5" class="ltx_tr">
<th id="A2.T8.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:20.0pt;padding-right:20.0pt;">  GPT-4o</th>
