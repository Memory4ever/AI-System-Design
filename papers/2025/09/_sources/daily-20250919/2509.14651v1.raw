<td id="S5.T1.2.1.6.2" class="ltx_td ltx_align_center" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S5.T1.2.1.6.2.1" class="ltx_text ltx_font_bold">24.0</span></td>
