<td id="A2.T9.2.3.2" class="ltx_td ltx_align_center">44.5</td>
<td id="A2.T9.2.3.3" class="ltx_td ltx_align_center">5.15</td></tr>
<tr id="A2.T9.2.4" class="ltx_tr">
<th id="A2.T9.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Qwen2.5</th>
<td id="A2.T9.2.4.2" class="ltx_td ltx_align_center">78.5</td>
<td id="A2.T9.2.4.3" class="ltx_td ltx_align_center">6.00</td></tr>
