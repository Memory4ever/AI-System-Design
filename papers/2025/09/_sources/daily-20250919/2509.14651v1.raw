<td id="S5.T4.2.1.6.3" class="ltx_td ltx_align_center ltx_border_bb">63.5 / <span id="S5.T4.2.1.6.3.1" class="ltx_text ltx_font_bold">41.0</span></td>
<td id="S5.T4.2.1.6.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T4.2.1.6.4.1" class="ltx_text ltx_font_bold">75.0</span> / 75.5</td></tr>
