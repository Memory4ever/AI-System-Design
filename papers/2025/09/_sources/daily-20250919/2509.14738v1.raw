<figure id="S5.F4.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.14738v1/Figures/radar_plot_emu3.png" id="S5.F4.sf3.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/422;" width="476" height="422" alt="Refer to caption">
