<tr id="S1.T1.2.1.16" class="ltx_tr">
<td id="S1.T1.2.1.16.1" class="ltx_td ltx_align_left">Minicpm (T<math id="S1.T1.m13" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math>T)</td>
<td id="S1.T1.2.1.16.2" class="ltx_td ltx_align_center">4.47</td>
<td id="S1.T1.2.1.16.3" class="ltx_td ltx_align_center">4.10</td>
<td id="S1.T1.2.1.16.4" class="ltx_td ltx_align_center">63.11</td>
<td id="S1.T1.2.1.16.5" class="ltx_td ltx_align_center">59.42</td>
<td id="S1.T1.2.1.16.6" class="ltx_td ltx_align_center">82.86</td>
<td id="S1.T1.2.1.16.7" class="ltx_td ltx_align_center">47.73</td>
<td id="S1.T1.2.1.16.8" class="ltx_td ltx_align_center">98.84</td>
