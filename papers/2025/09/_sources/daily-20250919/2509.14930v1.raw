<tr id="S1.T1.2.1.17" class="ltx_tr">
<td id="S1.T1.2.1.17.1" class="ltx_td ltx_align_left">Minicpm (S<math id="S1.T1.m14" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math>T)</td>
