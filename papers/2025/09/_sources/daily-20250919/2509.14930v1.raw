<td id="S1.T1.2.1.17.3" class="ltx_td ltx_align_center">4.15</td>
<td id="S1.T1.2.1.17.4" class="ltx_td ltx_align_center">50.72</td>
<td id="S1.T1.2.1.17.5" class="ltx_td ltx_align_center">54.78</td>
<td id="S1.T1.2.1.17.6" class="ltx_td ltx_align_center">78.02</td>
<td id="S1.T1.2.1.17.7" class="ltx_td ltx_align_center">45.25</td>
<td id="S1.T1.2.1.17.8" class="ltx_td ltx_align_center">97.69</td>
<td id="S1.T1.2.1.17.9" class="ltx_td ltx_align_center">71.04</td></tr>
<tr id="S1.T1.2.1.18" class="ltx_tr">
<td id="S1.T1.2.1.18.1" class="ltx_td ltx_align_left">Qwen2.5-Omni (T<math id="S1.T1.m15" class="ltx_Math" alttext="\to" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\to</annotation></semantics></math>T)</td>
<td id="S1.T1.2.1.18.2" class="ltx_td ltx_align_center">4.61</td>
<td id="S1.T1.2.1.18.3" class="ltx_td ltx_align_center">4.24</td>
<td id="S1.T1.2.1.18.4" class="ltx_td ltx_align_center">61.39</td>
<td id="S1.T1.2.1.18.5" class="ltx_td ltx_align_center">67.94</td>
<td id="S1.T1.2.1.18.6" class="ltx_td ltx_align_center">84.40</td>
<td id="S1.T1.2.1.18.7" class="ltx_td ltx_align_center">59.70</td>
<td id="S1.T1.2.1.18.8" class="ltx_td ltx_align_center">99.80</td>
