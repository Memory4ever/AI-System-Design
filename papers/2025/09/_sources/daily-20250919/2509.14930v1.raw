<td id="S1.T1.2.1.15.4" class="ltx_td ltx_align_center ltx_border_t">68.45</td>
<td id="S1.T1.2.1.15.5" class="ltx_td ltx_align_center ltx_border_t">71.65</td>
<td id="S1.T1.2.1.15.6" class="ltx_td ltx_align_center ltx_border_t">83.74</td>
<td id="S1.T1.2.1.15.7" class="ltx_td ltx_align_center ltx_border_t">71.15</td>
<td id="S1.T1.2.1.15.8" class="ltx_td ltx_align_center ltx_border_t">98.85</td>
