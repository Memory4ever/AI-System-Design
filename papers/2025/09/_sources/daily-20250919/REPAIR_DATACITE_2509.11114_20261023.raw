{"data":{"id":"10.48550/arxiv.2509.11114","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11114","prefix":"10.48550","suffix":"arxiv.2509.11114","identifiers":[{"identifier":"2509.11114","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.11114"}],"creators":[{"name":"Liu, Yuqiu","nameType":"Personal","givenName":"Yuqiu","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Song, Jialin","nameType":"Personal","givenName":"Jialin","familyName":"Song","affiliation":[],"nameIdentifiers":[]},{"name":"Savva, Manolis","nameType":"Personal","givenName":"Manolis","familyName":"Savva","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Wuyang","nameType":"Personal","givenName":"Wuyang","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WildSmoke: Ready-to-Use Dynamic 3D Smoke Assets from a Single Video in the Wild"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T06:06:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:35:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"We propose a pipeline to extract and reconstruct dynamic 3D smoke assets from a single in-the-wild video, and further integrate interactive simulation for smoke design and editing. Recent developments in 3D vision have significantly improved reconstructing and rendering fluid dynamics, supporting realistic and temporally consistent view synthesis. However, current fluid reconstructions rely heavily on carefully controlled clean lab environments, whereas real-world videos captured in the wild are largely underexplored. We pinpoint three key challenges of reconstructing smoke in real-world videos and design targeted techniques, including smoke extraction with background removal, initialization of smoke particles and camera poses, and inferring multi-view videos. Our method not only outperforms previous reconstruction and generation methods with high-quality smoke reconstructions (+2.22 average PSNR on wild videos), but also enables diverse and realistic editing of fluid dynamics by simulating our smoke assets. We provide our models, data, and 4D smoke assets at [https://autumnyq.github.io/WildSmoke](https://autumnyq.github.io/WildSmoke).","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.11114","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:55:04.000Z","registered":"2025-09-16T02:55:05.000Z","published":"2025","updated":"2025-09-16T02:55:05.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.11114","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}