<span id="A6.T7.2.2.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A6.T7.m11" class="ltx_Math" alttext="1.596" display="inline" intent=":literal"><semantics><mn>1.596</mn><annotation encoding="application/x-tex">1.596</annotation></semantics></math> <math id="A6.T7.m12" class="ltx_Math" alttext="\pm 0.279" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.279</mn></mrow><annotation encoding="application/x-tex">\pm 0.279</annotation></semantics></math></span></span>
</span></span><span id="A6.T7.2.2.4.3" class="ltx_text"></span></td>
<td id="A6.T7.2.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A6.T7.2.2.5.1" class="ltx_text"></span> <span id="A6.T7.2.2.5.2" class="ltx_text">
<span id="A6.T7.2.2.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="A6.T7.2.2.5.2.1.1" class="ltx_tr">
<span id="A6.T7.2.2.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A6.T7.m13" class="ltx_Math" alttext="1.832" display="inline" intent=":literal"><semantics><mn>1.832</mn><annotation encoding="application/x-tex">1.832</annotation></semantics></math> <math id="A6.T7.m14" class="ltx_Math" alttext="\pm 0.250" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.250</mn></mrow><annotation encoding="application/x-tex">\pm 0.250</annotation></semantics></math></span></span>
