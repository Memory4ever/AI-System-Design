<span id="S5.T1.2.3.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S5.T1.m3" class="ltx_Math" alttext="0.231" display="inline" intent=":literal"><semantics><mn>0.231</mn><annotation encoding="application/x-tex">0.231</annotation></semantics></math> <math id="S5.T1.m4" class="ltx_Math" alttext="\pm 0.126" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.126</mn></mrow><annotation encoding="application/x-tex">\pm 0.126</annotation></semantics></math></span></span>
</span></span><span id="S5.T1.2.3.3.3" class="ltx_text"></span></td>
<td id="S5.T1.2.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.2.3.4.1" class="ltx_text"></span> <span id="S5.T1.2.3.4.2" class="ltx_text">
<span id="S5.T1.2.3.4.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T1.2.3.4.2.1.1" class="ltx_tr">
<span id="S5.T1.2.3.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S5.T1.m5" class="ltx_Math" alttext="0.393" display="inline" intent=":literal"><semantics><mn>0.393</mn><annotation encoding="application/x-tex">0.393</annotation></semantics></math> <math id="S5.T1.m6" class="ltx_Math" alttext="\pm 0.153" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.153</mn></mrow><annotation encoding="application/x-tex">\pm 0.153</annotation></semantics></math></span></span>
</span></span><span id="S5.T1.2.3.4.3" class="ltx_text"></span></td>
<td id="S5.T1.2.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.2.3.5.1" class="ltx_text"></span> <span id="S5.T1.2.3.5.2" class="ltx_text">
