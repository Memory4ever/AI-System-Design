<span id="S5.T1.2.3.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S5.T1.m1" class="ltx_Math" alttext="0.224" display="inline" intent=":literal"><semantics><mn>0.224</mn><annotation encoding="application/x-tex">0.224</annotation></semantics></math> <math id="S5.T1.m2" class="ltx_Math" alttext="\pm 0.120" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.120</mn></mrow><annotation encoding="application/x-tex">\pm 0.120</annotation></semantics></math></span></span>
</span></span><span id="S5.T1.2.3.2.3" class="ltx_text"></span></td>
<td id="S5.T1.2.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.2.3.3.1" class="ltx_text"></span> <span id="S5.T1.2.3.3.2" class="ltx_text">
<span id="S5.T1.2.3.3.2.1" class="ltx_tabular ltx_align_middle">
