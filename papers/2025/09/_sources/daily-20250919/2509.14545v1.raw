<td id="S5.T1.2.2.6" class="ltx_td ltx_align_center ltx_border_t">0.935</td>
<td id="S5.T1.2.2.7" class="ltx_td ltx_align_center ltx_border_t">0.913</td>
<td id="S5.T1.2.2.8" class="ltx_td ltx_align_center ltx_border_t">0.790</td></tr>
<tr id="S5.T1.2.3" class="ltx_tr">
<td id="S5.T1.2.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">Dilaprix</td>
<td id="S5.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T1.2.3.2.1" class="ltx_text"></span> <span id="S5.T1.2.3.2.2" class="ltx_text">
