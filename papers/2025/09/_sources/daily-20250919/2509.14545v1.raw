<td id="S5.T1.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.2.1.3.1" class="ltx_text ltx_font_bold">A1</span></td>
<td id="S5.T1.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.2.1.4.1" class="ltx_text ltx_font_bold">A2</span></td>
<td id="S5.T1.2.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.2.1.5.1" class="ltx_text ltx_font_bold">B1</span></td>
<td id="S5.T1.2.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.2.1.6.1" class="ltx_text ltx_font_bold">B2</span></td>
<td id="S5.T1.2.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.2.1.7.1" class="ltx_text ltx_font_bold">C1</span></td>
<td id="S5.T1.2.1.8" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.2.1.8.1" class="ltx_text ltx_font_bold">C2</span></td></tr>
