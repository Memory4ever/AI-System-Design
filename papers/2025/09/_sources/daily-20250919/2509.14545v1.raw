><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 64.12 43.99)"><foreignObject style="--ltx-fo-width:1.45em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="20.13"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.F4.sf4.pic1.m2" class="ltx_Math" alttext="F_{G}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>G</mi></msub><annotation encoding="application/x-tex">F_{G}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 26.59 76.53)"><foreignObject style="--ltx-fo-width:1.45em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="20.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.F4.sf4.pic1.m3" class="ltx_Math" alttext="G_{F}" display="inline" intent=":literal"><semantics><msub><mi>G</mi><mi>F</mi></msub><annotation encoding="application/x-tex">G_{F}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -22.14 83.6)"><foreignObject style="--ltx-fo-width:1.38em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.15em;font-size:10pt;" height="11.53" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="19.16"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S6.F4.sf4.pic1.m4" class="ltx_Math" alttext="C_{L}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>L</mi></msub><annotation encoding="application/x-tex">C_{L}</annotation></semantics></math></span></span></foreignObj