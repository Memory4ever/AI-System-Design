<span id="A6.T7.2.2.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="A6.T7.m9" class="ltx_Math" alttext="1.109" display="inline" intent=":literal"><semantics><mn>1.109</mn><annotation encoding="application/x-tex">1.109</annotation></semantics></math> <math id="A6.T7.m10" class="ltx_Math" alttext="\pm 0.254" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.254</mn></mrow><annotation encoding="application/x-tex">\pm 0.254</annotation></semantics></math></span></span>
