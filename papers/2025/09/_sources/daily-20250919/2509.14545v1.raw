<td id="A6.T7.2.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T7.2.1.5.1" class="ltx_text ltx_font_bold">B2 (<math id="A6.T7.m4" class="ltx_Math" alttext="t=0.6" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0.6</mn></mrow><annotation encoding="application/x-tex">t=0.6</annotation></semantics></math>)</span></td>
<td id="A6.T7.2.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T7.2.1.6.1" class="ltx_text ltx_font_bold">C1 (<math id="A6.T7.m5" class="ltx_Math" alttext="t=0.8" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0.8</mn></mrow><annotation encoding="application/x-tex">t=0.8</annotation></semantics></math>)</span></td>
<td id="A6.T7.2.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T7.2.1.7.1" class="ltx_text ltx_font_bold">C2 (<math id="A6.T7.m6" class="ltx_Math" alttext="t=1.0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">t=1.0</annotation></semantics></math>)</span></td></tr>
<tr id="A6.T7.2.2" class="ltx_tr">
