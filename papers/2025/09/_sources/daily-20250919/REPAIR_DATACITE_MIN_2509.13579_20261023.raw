{"data":{"id":"10.48550/arxiv.2509.13579","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13579","prefix":"10.48550","suffix":"arxiv.2509.13579","identifiers":[{"identifier":"2509.13579","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.13579"}],"creators":[{"name":"Tomov, Momchil S.","nameType":"Personal","givenName":"Momchil S.","familyName":"Tomov","affiliation":[],"nameIdentifiers":[]},{"name":"Lee, Sang Uk","nameType":"Personal","givenName":"Sang Uk","familyName":"Lee","affiliation":[],"nameIdentifiers":[]},{"name":"Hendrago, Hansford","nameType":"Personal","givenName":"Hansford","familyName":"Hendrago","affiliation":[],"nameIdentifiers":[]},{"name":"Huh, Jinwook","nameType":"Personal","givenName":"Jinwook","familyName":"Huh","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Teawon","nameType":"Personal","givenName":"Teawon","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Howington, Forbes","nameType":"Personal","givenName":"Forbes","familyName":"Howington","affiliation":[],"nameIdentifiers":[]},{"name":"da Silva, Rafael","nameType":"Personal","givenName":"Rafael","familyName":"da Silva","affiliation":[],"nameIdentifiers":[]},{"name":"Bernasconi, Gianmarco","nameType":"Personal","givenName":"Gianmarco","familyName":"Bernasconi","affiliation":[],"nameIdentifiers":[]},{"name":"Heim, Marc","nameType":"Personal","givenName":"Marc","familyName":"Heim","affiliation":[],"nameIdentifiers":[]},{"name":"Findler, Samuel","nameType":"Personal","givenName":"Samuel","familyName":"Findler","affiliation":[],"nameIdentifiers":[]},{"name":"Ji, Xiaonan","nameType":"Personal","givenName":"Xiaonan","familyName":"Ji","affiliation":[],"nameIdentifiers":[]},{"name":"Boule, Alexander","nameType":"Personal","givenName":"Alexander","familyName":"Boule","affiliation":[],"nameIdentifiers":[]},{"name":"Napoli, Michael","nameType":"Personal","givenName":"Michael","familyName":"Napoli","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Kuo","nameType":"Personal","givenName":"Kuo","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Miller, Jesse","nameType":"Personal","givenName":"Jesse","familyName":"Miller","affiliation":[],"nameIdentifiers":[]},{"name":"Floor, Boaz","nameType":"Personal","givenName":"Boaz","familyName":"Floor","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Yunqing","nameType":"Personal","givenName":"Yunqing","familyName":"Hu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TreeIRL: Safe Urban Driving with Tree Search and Inverse Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T22:37:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:11:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-28T13:16:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T01:09:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-06T18:30:30Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-08T00:05:08Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10-25T12:00:58Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-28T00:34:35Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"We present TreeIRL, a novel planner for autonomous driving that combines Monte Carlo tree search (MCTS) and inverse reinforcement learning (IRL) to achieve state-of-the-art performance in simulation and in real-world driving. The core idea is to use MCTS to find a promising set of safe candidate trajectories and a deep IRL scoring function to select the most human-like among them. We evaluate TreeIRL against both classical and state-of-the-art planners in large-scale simulations and on 500+ miles of real-world autonomous driving in the Las Vegas metropolitan area. Test scenarios include dense urban traffic, adaptive cruise control, cut-ins, and traffic lights. TreeIRL achieves the best overall performance, striking a balance between safety, progress, comfort, and human-likeness. To our knowledge, our work is the first demonstration of MCTS-based planning on public roads and underscores the importance of evaluating planners across a diverse set of metrics and in real-world environments. TreeIRL is highly extensible and could be further improved with reinforcement learning and imitation learning, providing a framework for exploring different combinations of classical and learning-based approaches to solve the planning bottleneck in autonomous driving.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.13579","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:51:29.000Z","registered":"2025-09-18T17:51:30.000Z","published":"2025","updated":"2025-10-28T04:02:13.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.13579","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}