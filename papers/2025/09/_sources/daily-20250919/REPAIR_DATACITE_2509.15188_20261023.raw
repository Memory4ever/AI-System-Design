{"data":{"id":"10.48550/arxiv.2509.15188","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.15188","prefix":"10.48550","suffix":"arxiv.2509.15188","identifiers":[{"identifier":"2509.15188","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.15188"}],"creators":[{"name":"Seo, Yeongbin","nameType":"Personal","givenName":"Yeongbin","familyName":"Seo","affiliation":[],"nameIdentifiers":[]},{"name":"Lee, Dongha","nameType":"Personal","givenName":"Dongha","familyName":"Lee","affiliation":[],"nameIdentifiers":[]},{"name":"Kim, Jaehyung","nameType":"Personal","givenName":"Jaehyung","familyName":"Kim","affiliation":[],"nameIdentifiers":[]},{"name":"Yeo, Jinyoung","nameType":"Personal","givenName":"Jinyoung","familyName":"Yeo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fast and Fluent Diffusion Language Models via Convolutional Decoding and Rejective Fine-tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"I.2.7","subjectScheme":"ACM"},{"lang":"en","subject":"68T50","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-18T17:48:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T00:53:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-29T07:50:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T01:41:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-24T14:56:21Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-27T00:55:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Autoregressive (AR) language models generate text one token at a time, which limits their inference speed. Diffusion-based language models offer a promising alternative, as they can decode multiple tokens in parallel. However, we identify a key bottleneck in current diffusion LMs: the long decoding-window problem, where tokens generated far from the input context often become irrelevant or repetitive. Previous solutions like semi-autoregressive address this issue by splitting windows into blocks (sacrificing bidirectionality), but we find that this also leads to time-interval expansion problem, sacrificing the speed. Therefore, semi-AR eliminates the main advantages of diffusion models. To overcome this, we propose Convolutional decoding (Conv), a normalization-based method that narrows the decoding window without hard segmentation, leading to better fluency and flexibility. Additionally, we introduce Rejecting Rule-based Fine-Tuning (R2FT), a post-hoc training scheme that better aligns tokens at positions far from context. Our methods achieve state-of-the-art results on open-ended generation benchmarks (e.g., AlpacaEval) among diffusion LM baselines, with significantly lower step size than previous works, demonstrating both speed and quality improvements.","descriptionType":"Abstract"},{"description":"NeurIPS 2025 spotlight","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.15188","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:49:51.000Z","registered":"2025-09-19T01:49:51.000Z","published":"2025","updated":"2025-10-27T02:11:30.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.15188","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}