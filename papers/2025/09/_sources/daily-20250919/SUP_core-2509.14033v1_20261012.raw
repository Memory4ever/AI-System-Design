<tr id="S2.T1.2.1.3" class="ltx_tr" style="--ltx-bg-color:#ECECEC;">
<td id="S2.T1.2.1.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;" colspan="6"><span id="S2.T1.2.1.3.1.1" class="ltx_text ltx_font_italic">Dense Models</span></td></tr>
<tr id="S2.T1.2.1.4" class="ltx_tr">
