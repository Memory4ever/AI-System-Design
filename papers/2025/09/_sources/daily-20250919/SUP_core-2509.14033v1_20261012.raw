</table></td>
<td id="S6.T6.2.1.1.4" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S6.T6.2.1.1.4.1" class="ltx_text ltx_font_bold">SAIL-ViT-Large</span></td>
<td id="S6.T6.2.1.1.5" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S6.T6.2.1.1.5.1" class="ltx_text ltx_font_bold">AIMv2-Huge</span></td>
<td id="S6.T6.2.1.1.6" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S6.T6.2.1.1.6.1" class="ltx_text ltx_font_bold">SAIL-ViT-Huge</span></td>
<td id="S6.T6.2.1.1.7" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S6.T6.2.1.1.7.1" class="ltx_text ltx_font_bold">SAIL-ViT-Huge-v2</span></td>
<td id="S6.T6.2.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;">
<table id="S6.T6.2.1.1.8.1" class="ltx_tabular ltx_align_middle">
<tr id="S6.T6.2.1.1.8.1.1" class="ltx_tr">
<td id="S6.T6.2.1.1.8.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S6.T6.2.1.1.8.1.1.1.1" class="ltx_text ltx_font_bold">InternViT-6B-</span></td></tr>
<tr id="S6.T6.2.1.1.8.1.2" class="ltx_tr">
