<td id="S6.T6.2.1.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S6.T6.2.1.1.2.1" class="ltx_text ltx_font_bold">AIMv2-Large</span></td>
<td id="S6.T6.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;">
