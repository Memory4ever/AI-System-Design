<td id="S3.T1.2.1.6.5" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">5.50</td>
<td id="S3.T1.2.1.6.6" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">5.02</td>
<td id="S3.T1.2.1.6.7" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">13.15</td>
<td id="S3.T1.2.1.6.8" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">3.97</td>
<td id="S3.T1.2.1.6.9" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">21.05</td>
