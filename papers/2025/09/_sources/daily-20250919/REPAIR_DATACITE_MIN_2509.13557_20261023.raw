{"data":{"id":"10.48550/arxiv.2509.13557","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13557","prefix":"10.48550","suffix":"arxiv.2509.13557","identifiers":[{"identifier":"2509.13557","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.13557"}],"creators":[{"name":"Jiang, Zesong","nameType":"Personal","givenName":"Zesong","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Yuqi","nameType":"Personal","givenName":"Yuqi","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Zhong, Qing","nameType":"Personal","givenName":"Qing","familyName":"Zhong","affiliation":[],"nameIdentifiers":[]},{"name":"Krishna, Mahathi","nameType":"Personal","givenName":"Mahathi","familyName":"Krishna","affiliation":[],"nameIdentifiers":[]},{"name":"Patil, Deepak","nameType":"Personal","givenName":"Deepak","familyName":"Patil","affiliation":[],"nameIdentifiers":[]},{"name":"Tan, Cheng","nameType":"Personal","givenName":"Cheng","familyName":"Tan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Jeff","nameType":"Personal","givenName":"Jeff","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MACO: A Multi-Agent LLM Framework for Automated CGRA Hardware/Software Co-Design"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T21:52:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:10:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-18T15:34:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-19T00:47:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-19T16:25:03Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-22T00:55:58Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09-22T16:46:17Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-09-23T01:47:20Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-11-07T17:21:08Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2025-11-10T01:52:29Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-12-09T22:47:32Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2025-12-11T01:11:07Z","dateType":"Updated","dateInformation":"v6"},{"date":"2026-05-30T18:21:39Z","dateType":"Submitted","dateInformation":"v7"},{"date":"2026-06-02T00:47:33Z","dateType":"Updated","dateInformation":"v7"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"7","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Designing optimal Coarse-Grained Reconfigurable Arrays (CGRAs) requires navigating a vast, interdependent hardware/software space bottlenecked by costly manual iteration. We present MACO, an open-source, multi-agent LLM framework that automates CGRA HW/SW co-design. MACO decomposes the design loop into four collaborative stages, HW/SW Co-design, Error Correction, Best-Design Selection, and Evaluation \u0026amp; Feedback, to iteratively optimize power, performance, and area (PPA). To accelerate convergence and efficiently traverse the design space, MACO introduces an exponentially decaying exploration strategy, EDA-guided LLM self-learning, and robust rule-based error correction. Evaluated against state-of-the-art baselines, MACO reduces power consumption by 25.9%, improves performance by 20.0%, and accelerates the search process by 5x. Finally, we validate MACO's physical design through a complete 7nm ASIC design flow.","descriptionType":"Abstract"},{"description":"new version","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.13557","contentUrl":null,"metadataVersion":6,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:42:43.000Z","registered":"2025-09-18T17:42:44.000Z","published":"2025","updated":"2026-06-02T04:52:32.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.13557","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}