<section id="S6.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.4 </span>Analysis on Router</h3>

<figure id="S6.T6" class="ltx_table">
<table id="S6.T6.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S6.T6.2.1" class="ltx_tr">
<td id="S6.T6.2.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="S6.T6.2.1.1.1" class="ltx_text ltx_font_bold">Method</span></td>
<td id="S6.T6.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S6.T6.2.1.2.1" class="ltx_text ltx_font_bold">Router</span></td>
<td id="S6.T6.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S6.T6.2.1.3.1" class="ltx_text ltx_font_bold">Acc.</span></td>
<td id="S6.T6.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S6.T6.2.1.4.1" class="ltx_text ltx_font_bold">Prec.</span></td>
<td id="S6.T6.2.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S6.T6.2.1.5.1" class="ltx_text ltx_font_bold">Recall</span></td>
<td id="S6.T6.2.1.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt"><span id="S6.T6.2.1.6.1" class="ltx_text ltx_font_bold">F1</span></td></tr>
<tr id="S6.T6.2.2" class="ltx_tr">
<td id="S6.T6.2.2.1" class="ltx_td ltx_align_center ltx_border_t">Qwen2VL</td>
<td id="S6.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_t">trained</td>
<td id="S6.T6.2.2.3" class="ltx_td ltx_align_center ltx_border_t">88.42</td>
<td id="S6.T6.2.2.4" class="ltx_td ltx_align_center ltx_border_t">83.19</td>
