          <math id="algx1.l9.m1" class="ltx_Math" alttext="\text{mask}_{\text{enhanced}}\leftarrow\alpha\cdot\text{mask}_{\text{norm}}" display="inline" intent=":literal"><semantics><mrow><msub><mtext>mask</mtext><mtext>enhanced</mtext></msub><mo stretchy="false">←</mo><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mtext>mask</mtext><mtext>norm</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\text{mask}_{\text{enhanced}}\leftarrow\alpha\cdot\text{mask}_{\text{norm}}</annotation></semantics></math> <span id="algx1.l9.2" class="ltx_text" style="float:right;"><math id="algx1.l9.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Enhancement
