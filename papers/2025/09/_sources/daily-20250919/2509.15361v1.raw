<span id="S4.T4.2.12.6.1.1" class="ltx_p ltx_align_center"><span id="S4.T4.2.12.6.1.1.1" class="ltx_text ltx_font_bold">87.20</span></span>
</span></td>
<td id="S4.T4.2.12.7" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:2.6pt;padding-right:2.6pt;">
<span id="S4.T4.2.12.7.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T4.2.12.7.1.1" class="ltx_p ltx_align_center">72.08</span>
</span></td>
<td id="S4.T4.2.12.8" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:2.6pt;padding-right:2.6pt;">
