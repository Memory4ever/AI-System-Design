<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F19.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.13353v1/x16.svg" id="S3.F19.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/341;" width="476" height="341"></object>
