<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S3.F20.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S3.F20.sf1.4" class="ltx_text" style="font-size:90%;">Training samples</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F20.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.13353v1/x19.png" id="S3.F20.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/79;" width="476" height="79" alt="Refer to caption">
