</span></td>
<td id="S2.T2.8.1.4.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb" style="padding-top:1.15pt;padding-bottom:1.15pt;">
<span id="S2.T2.8.1.4.5.1" class="ltx_inline-block ltx_align_middle" style="width:34.5pt;--ltx-bg-color:#F2F2F2;">
<span id="S2.T2.8.1.4.5.1.1" class="ltx_p ltx_align_center"><span id="S2.T2.8.1.4.5.1.1.1" class="ltx_text" style="font-size:90%;">Hard</span></span>
</span></td>
<td id="S2.T2.8.1.4.6" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb" style="padding-top:1.15pt;padding-bottom:1.15pt;">
