<span id="A4.I3.i1.I1.i3.p1.1" class="ltx_p"><span id="A4.I3.i1.I1.i3.p1.1.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">stockanalysis.com</span></span>
</span></span>
<span id="A4.I3.i1.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A4.I3.i1.I1.i4.1" class="ltx_text ltx_font_bold">–</span></span> 
