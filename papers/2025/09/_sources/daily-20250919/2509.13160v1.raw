<td id="A2.T5.3.26.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="A2.T5.m191" class="ltx_Math" alttext="2.5" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">2.5</mn><annotation encoding="application/x-tex">2.5</annotation></semantics></math></td>
<td id="A2.T5.3.26.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="A2.T5.m192" class="ltx_Math" alttext="1.2" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">1.2</mn><annotation encoding="application/x-tex">1.2</annotation></semantics></math></td>
<td id="A2.T5.3.26.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="A2.T5.m193" class="ltx_Math" alttext="1.2" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">1.2</mn><annotation encoding="application/x-tex">1.2</annotation></semantics></math></td>
<td id="A2.T5.3.26.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="A2.T5.m194" class="ltx_Math" alttext="0.0" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.0</mn><annotation encoding="application/x-tex">0.0</annotation></semantics></math></td>
<td id="A2.T5.3.26.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="A2.T5.m195" class="ltx_Math" alttext="0.0" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.0</mn><annotation encoding="application/x-tex">0.0</annotation></semantics></math></td>
<td id="A2.T5.3.26.10" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="A2.T5.m196" class="ltx_Math" alttext="1.1" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">1.1</mn><annotation encoding="application/x-tex">1.1</annotation></semantics></math></td>
<td id="A2.T5.3.26.11" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="A2.T5.m197" class="ltx_Math" alttext="0.4" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.4</mn><annotation encoding="application/x-tex">0.4</annotation></semantics></math></td>
