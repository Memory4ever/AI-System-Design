<td id="A2.T5.3.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" rowspan="2"><span id="A2.T5.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Reasoning</span></td>
<td id="A2.T5.3.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" rowspan="2"><span id="A2.T5.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Search</span></td>
<td id="A2.T5.3.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="4"><span id="A2.T5.3.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Global</span></td>
<td id="A2.T5.3.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="4"><span id="A2.T5.3.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Greater China</span></td>
<td id="A2.T5.3.1.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" rowspan="2"><span id="A2.T5.3.1.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Avg.</span></td></tr>
<tr id="A2.T5.3.2" class="ltx_tr">
<td id="A2.T5.3.2.1" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A2.T5.3.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">T1</span></td>
<td id="A2.T5.3.2.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A2.T5.3.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">T2</span></td>
