<tr id="S3.T1.2.1.5" class="ltx_tr">
<td id="S3.T1.2.1.5.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T1.2.1.5.1.1" class="ltx_text ltx_font_italic">KE</span></td>
<td id="S3.T1.2.1.5.2" class="ltx_td ltx_align_center ltx_border_t">3.30</td>
<td id="S3.T1.2.1.5.3" class="ltx_td ltx_align_center ltx_border_t">0.83</td>
<td id="S3.T1.2.1.5.4" class="ltx_td ltx_align_center ltx_border_t">1.0</td>
<td id="S3.T1.2.1.5.5" class="ltx_td ltx_align_center ltx_border_t">
