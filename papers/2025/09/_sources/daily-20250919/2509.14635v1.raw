<td id="S2.T2.7.6.8" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S2.T2.7.6.8.1" class="ltx_text" style="font-size:90%;">131.7</span></td></tr>
<tr id="S2.T2.7.7" class="ltx_tr">
