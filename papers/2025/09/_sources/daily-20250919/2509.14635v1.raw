<td id="S2.T2.7.6.2" class="ltx_td ltx_align_center"><span id="S2.T2.7.6.2.1" class="ltx_text" style="font-size:90%;">2,308</span></td>
<td id="S2.T2.7.6.3" class="ltx_td ltx_align_center"><span id="S2.T2.7.6.3.1" class="ltx_text" style="font-size:90%;">2,287</span></td>
