{"data":{"id":"10.48550/arxiv.2509.13577","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13577","prefix":"10.48550","suffix":"arxiv.2509.13577","identifiers":[{"identifier":"2509.13577","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.13577"}],"creators":[{"name":"Guo, Tongfei","nameType":"Personal","givenName":"Tongfei","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Su, Lili","nameType":"Personal","givenName":"Lili","familyName":"Su","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adaptive Multi-Mode Out-of-Distribution Detection for Trajectory Prediction in Autonomous Vehicles"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T22:37:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T03:03:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-13T15:28:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-16T00:55:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-24T20:56:32Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-26T00:09:43Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Trustworthy trajectory prediction grounds autonomous vehicle (AV) safety, yet deployed models inevitably face out-of-distribution (OOD) scenes. Prior AV OOD detection targets perception, but planners act on predicted futures rather than raw scenes, so erroneous forecasts can slip past frame-level checks and corrupt control. We therefore tackle OOD detection at the trajectory-prediction level. Our analysis of real-world benchmarks reveals that prediction errors are often multi-modal, exhibiting distinct low- and high-error modes that evolve with open-world driving context. Observing this, we propose Mode-Aware CUSUM, which explicitly models multiple error modes while retaining the efficiency and general compatibility of classical CUSUM. By dynamically identifying the active error mode and adapting detection thresholds, our method enables robust monitoring across heterogeneous conditions. Experiments on large-scale trajectory benchmarks demonstrate consistent reductions in detection delay and false alarms.","descriptionType":"Abstract"},{"description":"Accepted to the 2026 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS 2026)","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.13577","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:51:24.000Z","registered":"2025-09-18T17:51:25.000Z","published":"2025","updated":"2026-08-26T02:36:35.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.13577","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}