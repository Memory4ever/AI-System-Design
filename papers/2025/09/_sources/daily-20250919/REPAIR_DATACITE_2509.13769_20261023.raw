{"data":{"id":"10.48550/arxiv.2509.13769","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13769","prefix":"10.48550","suffix":"arxiv.2509.13769","identifiers":[{"identifier":"2509.13769","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.13769"}],"creators":[{"name":"Luo, Yuechen","nameType":"Personal","givenName":"Yuechen","familyName":"Luo","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Fang","nameType":"Personal","givenName":"Fang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Shaoqing","nameType":"Personal","givenName":"Shaoqing","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Lai, Zhiyi","nameType":"Personal","givenName":"Zhiyi","familyName":"Lai","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Lei","nameType":"Personal","givenName":"Lei","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Qimao","nameType":"Personal","givenName":"Qimao","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Luo, Ziang","nameType":"Personal","givenName":"Ziang","familyName":"Luo","affiliation":[],"nameIdentifiers":[]},{"name":"Xie, Zixun","nameType":"Personal","givenName":"Zixun","familyName":"Xie","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Shengyin","nameType":"Personal","givenName":"Shengyin","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Jiaxin","nameType":"Personal","givenName":"Jiaxin","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Long","nameType":"Personal","givenName":"Long","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Bing","nameType":"Personal","givenName":"Bing","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Zhi-xin","nameType":"Personal","givenName":"Zhi-xin","familyName":"Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AdaThinkDrive: Adaptive Thinking via Reinforcement Learning for Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T07:35:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:28:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"While reasoning technology like Chain of Thought (CoT) has been widely adopted in Vision Language Action (VLA) models, it demonstrates promising capabilities in end to end autonomous driving. However, recent efforts to integrate CoT reasoning often fall short in simple scenarios, introducing unnecessary computational overhead without improving decision quality. To address this, we propose AdaThinkDrive, a novel VLA framework with a dual mode reasoning mechanism inspired by fast and slow thinking. First, our framework is pretrained on large scale autonomous driving (AD) scenarios using both question answering (QA) and trajectory datasets to acquire world knowledge and driving commonsense. During supervised fine tuning (SFT), we introduce a two mode dataset, fast answering (w/o CoT) and slow thinking (with CoT), enabling the model to distinguish between scenarios that require reasoning. Furthermore, an Adaptive Think Reward strategy is proposed in conjunction with the Group Relative Policy Optimization (GRPO), which rewards the model for selectively applying CoT by comparing trajectory quality across different reasoning modes. Extensive experiments on the Navsim benchmark show that AdaThinkDrive achieves a PDMS of 90.3, surpassing the best vision only baseline by 1.7 points. Moreover, ablations show that AdaThinkDrive surpasses both the never Think and always Think baselines, improving PDMS by 2.0 and 1.4, respectively. It also reduces inference time by 14% compared to the always Think baseline, demonstrating its ability to balance accuracy and efficiency through adaptive reasoning.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.13769","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:59:05.000Z","registered":"2025-09-18T17:59:06.000Z","published":"2025","updated":"2025-09-18T17:59:06.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.13769","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}