<td id="S3.T2.6.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:1.25pt 3.0pt;" colspan="5"><span id="S3.T2.6.1.3.1" class="ltx_text ltx_font_bold">EmuEdit-Test</span></td></tr>
<tr id="S3.T2.6.2" class="ltx_tr">
<td id="S3.T2.6.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.25pt 3.0pt;">CLIP<sub id="S3.T2.6.2.1.1" class="ltx_sub">img</sub><math id="S3.T2.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
