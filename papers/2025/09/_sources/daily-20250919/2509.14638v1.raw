<td id="S1.T1.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:2pt 5.0pt;" rowspan="2"><span id="S1.T1.2.1.2.6.1" class="ltx_text">10,051</span></td></tr>
