<td id="S3.T1.2.1.6.4" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S3.T1.2.1.6.4.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">+10.7</span>/<span id="S3.T1.2.1.6.4.2" class="ltx_text" style="--ltx-fg-color:#FF0000;">+11.3</span></td>
<td id="S3.T1.2.1.6.5" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S3.T1.2.1.6.5.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">+8.9</span>/<span id="S3.T1.2.1.6.5.2" class="ltx_text" style="--ltx-fg-color:#FF0000;">+5.1</span></td>
<td id="S3.T1.2.1.6.6" class="ltx_td ltx_align_center" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S3.T1.2.1.6.6.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">+0.7</span>/<span id="S3.T1.2.1.6.6.2" class="ltx_text" style="--ltx-fg-color:#FF0000;">+7.3</span></td></tr>
<tr id="S3.T1.2.1.7" class="ltx_tr">
