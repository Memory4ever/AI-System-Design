<td id="S3.T2.2.1.11.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1.1pt;padding-bottom:1.1pt;">17.7/35.6</td>
<td id="S3.T2.2.1.11.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1.1pt;padding-bottom:1.1pt;">15.9/37.4</td>
