{"data":{"id":"10.48550/arxiv.2509.14651","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14651","prefix":"10.48550","suffix":"arxiv.2509.14651","identifiers":[{"identifier":"2509.14651","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.14651"}],"creators":[{"name":"Yan, Siyu","nameType":"Personal","givenName":"Siyu","familyName":"Yan","affiliation":[],"nameIdentifiers":[]},{"name":"Zeng, Long","nameType":"Personal","givenName":"Long","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Xuecheng","nameType":"Personal","givenName":"Xuecheng","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Chengcheng","nameType":"Personal","givenName":"Chengcheng","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Kongcheng","nameType":"Personal","givenName":"Kongcheng","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Peng, Chong","nameType":"Personal","givenName":"Chong","familyName":"Peng","affiliation":[],"nameIdentifiers":[]},{"name":"Cao, Xuezhi","nameType":"Personal","givenName":"Xuezhi","familyName":"Cao","affiliation":[],"nameIdentifiers":[]},{"name":"Cai, Xunliang","nameType":"Personal","givenName":"Xunliang","familyName":"Cai","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Chenjuan","nameType":"Personal","givenName":"Chenjuan","familyName":"Guo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MUSE: MCTS-Driven Red Teaming Framework for Enhanced Multi-Turn Dialogue Safety in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-18T06:12:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T00:23:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"As large language models~(LLMs) become widely adopted, ensuring their alignment with human values is crucial to prevent jailbreaks where adversaries manipulate models to produce harmful content. While most defenses target single-turn attacks, real-world usage often involves multi-turn dialogues, exposing models to attacks that exploit conversational context to bypass safety measures. We introduce MUSE, a comprehensive framework tackling multi-turn jailbreaks from both attack and defense angles. For attacks, we propose MUSE-A, a method that uses frame semantics and heuristic tree search to explore diverse semantic trajectories. For defense, we present MUSE-D, a fine-grained safety alignment approach that intervenes early in dialogues to reduce vulnerabilities. Extensive experiments on various models show that MUSE effectively identifies and mitigates multi-turn vulnerabilities. Code is available at \\href{https://github.com/yansiyu02/MUSE}{https://github.com/yansiyu02/MUSE}.","descriptionType":"Abstract"},{"description":"EMNLP 2025 main conference","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.14651","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:37:04.000Z","registered":"2025-09-19T01:37:05.000Z","published":"2025","updated":"2025-09-19T01:37:05.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.14651","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}