<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>Attention Head Modulating Assessment</h2>

<figure id="S6.T4" class="ltx_table">
<div id="S6.T4.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:165.6pt;height:35.5pt;vertical-align:-16.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-61.1pt,13.1pt) scale(0.57553713994342,0.57553713994342) ;">
