<span id="A1.T8.2.1.2.3.2.1.6" class="ltx_tr">
<span id="A1.T8.2.1.2.3.2.1.6.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="A1.T8.2.1.2.3.2.1.6.1.1" class="ltx_text ltx_font_bold">ASSISTANT:</span></span></span>
</span></span><span id="A1.T8.2.1.2.3.3" class="ltx_text"></span></td></tr>
<tr id="A1.T8.2.1.3" class="ltx_tr">
<td id="A1.T8.2.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;">InstructBLIP</td>
