<span id="S5.T2.2.1.2.3.1.1" class="ltx_p"><span id="S5.T2.2.1.2.3.1.1.1" class="ltx_text ltx_font_bold">Positive Heads</span></span>
</span></td>
<td id="S5.T2.2.1.2.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">
