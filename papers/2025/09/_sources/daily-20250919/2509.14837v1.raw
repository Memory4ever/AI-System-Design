<td id="S5.T2.2.1.1.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding-top:1.5pt;padding-bottom:1.5pt;" rowspan="2"><span id="S5.T2.2.1.1.1.1" class="ltx_text ltx_font_bold">Semantic Type</span></td>
<td id="S5.T2.2.1.1.2" class="ltx_td ltx_align_center ltx_align_top ltx_border_tt" style="padding-top:1.5pt;padding-bottom:1.5pt;" colspan="2"><span id="S5.T2.2.1.1.2.1" class="ltx_text ltx_font_bold">LLaVA</span></td>
