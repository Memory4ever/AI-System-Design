</span></td></tr>
<tr id="S5.T2.2.1.3" class="ltx_tr">
<td id="S5.T2.2.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S5.T2.2.1.3.1.1" class="ltx_text ltx_font_bold">Attribute</span></td>
<td id="S5.T2.2.1.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">
<span id="S5.T2.2.1.3.2.1" class="ltx_inline-block ltx_align_top" style="width:91.0pt;">
<span id="S5.T2.2.1.3.2.1.1" class="ltx_p">L16.H1, L15.H7, 
<br class="ltx_break">L22.H11</span>
</span></td>
<td id="S5.T2.2.1.3.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">
<span id="S5.T2.2.1.3.3.1" class="ltx_inline-block ltx_align_top" style="width:102.4pt;">
<span id="S5.T2.2.1.3.3.1.1" class="ltx_p">L31.H11, L30.H11,
