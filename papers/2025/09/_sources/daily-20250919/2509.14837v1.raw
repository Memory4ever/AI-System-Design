</span></span><span id="A1.T8.2.1.3.2.3" class="ltx_text"></span></td></tr>
<tr id="A1.T8.2.1.4" class="ltx_tr">
<td id="A1.T8.2.1.4.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;" rowspan="2"><span id="A1.T8.2.1.4.1.1" class="ltx_text">Closed-form Binary Judgment Tasks (e.g., Color, Material, Indoor, POPE)</span></td>
<td id="A1.T8.2.1.4.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;">LLaVA</td>
<td id="A1.T8.2.1.4.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="A1.T8.2.1.4.3.1" class="ltx_text"></span><span id="A1.T8.2.1.4.3.2" class="ltx_text">
<span id="A1.T8.2.1.4.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="A1.T8.2.1.4.3.2.1.1" class="ltx_tr">
<span id="A1.T8.2.1.4.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="A1.T8.2.1.4.3.2.1.1.1.1" class="ltx_text ltx_font_bold">USER:</span></span></span>
<span id="A1.T8.2.1.4.3.2.1.2" class="ltx_tr">
<span id="A1.T8.2.1.4.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="A1.T8.2.1.4.3.2.1.2.1.1" class="ltx_text ltx_font_typewriter">&lt;Image&gt;</span></span></span>
<span id="A1.T8.2.1.4.3.2.1.3" class="ltx_tr">
<span id="A1.T8.2.1.4.3.2.1.3.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="A1.T8.2.1.4.3.2.1.3.1.1" class="ltx_text ltx_font_typewriter">{Role Description}</span>*</span></span>
<span id="A1.T8.2.1.4.3.2.1.4" class="ltx_tr">
