<table id="A1.T6.2.1" class="ltx_tabular ltx_align_middle">
<tr id="A1.T6.2.1.1" class="ltx_tr">
<td id="A1.T6.2.1.1.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="A1.T6.2.1.1.1.1" class="ltx_text ltx_font_bold">Semantic Type</span></td>
