<td id="S5.T4.2.5.7" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T4.2.5.7.1" class="ltx_text" style="font-size:80%;">2.54</span></td></tr>
