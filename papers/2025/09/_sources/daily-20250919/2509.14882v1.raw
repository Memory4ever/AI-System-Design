<td id="S5.T4.2.5.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T4.2.5.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">5.66</span></td>
