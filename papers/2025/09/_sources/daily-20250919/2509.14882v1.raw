<th id="S5.T4.2.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T4.2.6.1.1" class="ltx_text" style="font-size:80%;">Ground Truth</span></th>
