{"data":{"id":"10.48550/arxiv.2509.13782","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13782","prefix":"10.48550","suffix":"arxiv.2509.13782","identifiers":[{"identifier":"2509.13782","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.13782"}],"creators":[{"name":"Ge, Yu","nameType":"Personal","givenName":"Yu","familyName":"Ge","affiliation":["Nanjing University"],"nameIdentifiers":[]},{"name":"Xie, Linna","nameType":"Personal","givenName":"Linna","familyName":"Xie","affiliation":["Nanjing University"],"nameIdentifiers":[]},{"name":"Li, Zhong","nameType":"Personal","givenName":"Zhong","familyName":"Li","affiliation":["Nanjing University"],"nameIdentifiers":[]},{"name":"Pei, Yu","nameType":"Personal","givenName":"Yu","familyName":"Pei","affiliation":["The Hong Kong Polytechnic University"],"nameIdentifiers":[]},{"name":"Zhang, Tian","nameType":"Personal","givenName":"Tian","familyName":"Zhang","affiliation":["Nanjing University"],"nameIdentifiers":[]}],"titles":[{"title":"Who is Introducing the Failure? Automatically Attributing Failures of Multi-Agent Systems via Spectrum Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Software Engineering (cs.SE)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Multiagent Systems (cs.MA)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"D.2.2; I.2.1","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-17T07:50:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:29:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Large Language Model Powered Multi-Agent Systems (MASs) are increasingly employed to automate complex real-world problems, such as programming and scientific discovery. Despite their promising, MASs are not without their flaws. However, failure attribution in MASs - pinpointing the specific agent actions responsible for failures - remains underexplored and labor-intensive, posing significant challenges for debugging and system improvement. To bridge this gap, we propose FAMAS, the first spectrum-based failure attribution approach for MASs, which operates through systematic trajectory replay and abstraction, followed by spectrum analysis.The core idea of FAMAS is to estimate, from variations across repeated MAS executions, the likelihood that each agent action is responsible for the failure. In particular, we propose a novel suspiciousness formula tailored to MASs, which integrates two key factor groups, namely the agent behavior group and the action behavior group, to account for the agent activation patterns and the action activation patterns within the execution trajectories of MASs. Through expensive evaluations against 12 baselines on the Who and When benchmark, FAMAS demonstrates superior performance by outperforming all the methods in comparison.","descriptionType":"Abstract"},{"description":"20 pages, 6 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.13782","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:59:37.000Z","registered":"2025-09-18T17:59:38.000Z","published":"2025","updated":"2025-09-18T17:59:38.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.13782","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}