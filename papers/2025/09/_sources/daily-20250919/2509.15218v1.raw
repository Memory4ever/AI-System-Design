<section id="A6.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Case 2: Nested Parentheses Parsing</h5>

<div id="A6.SS0.SSS0.Px2.p1" class="ltx_para">
<p id="A6.SS0.SSS0.Px2.p1.1" class="ltx_p"><span id="A6.SS0.SSS0.Px2.p1.1.1" class="ltx_text"></span>
<br class="ltx_break"><span id="A6.SS0.SSS0.Px2.p1.1.2" class="ltx_text ltx_font_bold">Prompt:</span></p>
<div id="A6.SS0.SSS0.Px2.p1.2" class="ltx_listing ltx_lst_language_Python ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx15" class="ltx_listingline"><span id="lstnumberx15.1" class="ltx_text ltx_lst_keyword ltx_font_bold">from</span><span id="lstnumberx15.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.3" class="ltx_text ltx_lst_identifier">typing</span><span id="lstnumberx15.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.5" class="ltx_text ltx_lst_keyword ltx_font_bold">import</span><span id="lstnumberx15.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.7" class="ltx_text ltx_lst_identifier">List</span>
</div>
<div id="lstnumberx16" class="ltx_listingline">
</div>
<div id="lstnumberx17" class="ltx_listingline">
</div>
<div id="lstnumberx18" class="ltx_listingline"><span id="lstnumberx18.1" class="ltx_text ltx_lst_keyword ltx_font_bold">def</span><span id="lstnumberx18.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx18.3" class="ltx_text ltx_lst_identifier">parse_nested_parens</span>(<span id="lstnumberx18.4" class="ltx_text ltx_lst_identifier">paren_string</span>:<span id="lstnumberx18.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx18.6" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold">str</span>)<span id="lstnumberx18.7" class="ltx_text ltx_lst_space"> </span>-&gt;<span id="lstnumberx18.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx18.9" class="ltx_text ltx_lst_identifier">List</span>[<span id="lstnumberx18.10" class="ltx_text ltx_lst_keyword ltx_lst_keywords2 ltx_font_bold">int</span>]:
</div>
<div id="lstnumberx19" class="ltx_listingline"><span id="lstnumberx19.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx19.2" class="ltx_text ltx_lst_string">""</span><span id="lstnumberx19.3" class="ltx_text ltx_lst_string">"<span id="lstnumberx19.3.1" class="ltx_text ltx_lst_space"> </span>Input<span id="lstnumberx19.3.2" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx19.3.3" class="ltx_text ltx_lst_space"> </span>this<span id="lstnumberx19.3.4" class="ltx_text ltx_lst_space"> </span>function<span id="lstnumberx19.3.5" class="ltx_text ltx_lst_space"> </span>is<span id="lstnumberx19.3.6" class="ltx_text ltx_lst_space"> </span>a<span id="lstnumberx19.3.7" class="ltx_text ltx_lst_space"> </span>string<span id="lstnumberx19.3.8" class="ltx_text ltx_lst_space"> </span>represented<span id="lstnumberx19.3.9" class="ltx_text ltx_lst_space"> </span>multiple<span id="lstnumberx19.3.10" class="ltx_text ltx_lst_space"> </span>groups<span id="lstnumberx19.3.11" class="ltx_text ltx_lst_space"> </span>for<span id="lstnumberx19.3.12" class="ltx_text ltx_lst_space"> </span>nested<span id="lstnumberx19.3.13" class="ltx_text ltx_lst_space"> </span>parentheses<span id="lstnumberx19.3.14" class="ltx_text ltx_lst_space"> </span>separated<span id="lstnumberx19.3.15" class="ltx_text ltx_lst_space"> </span>by<span id="lstnumberx19.3.16" class="ltx_text ltx_lst_space"> </span>spaces.</span>
</div>
<div id="lstnumberx20" class="ltx_listingline"><span id="lstnumberx20.1" class="ltx_text ltx_lst_space">    </span>For<span id="lstnumberx20.2" class="ltx_text ltx_lst_space"> </span>each<span id="lstnumberx20.3" class="ltx_text ltx_lst_space"> </span>of<span id="lstnumberx20.4" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx20.5" class="ltx_text ltx_lst_space"> </span>group,<span id="lstnumberx20.6" class="ltx_text ltx_lst_space"> </span>output<span id="lstnumberx20.7" class="ltx_text ltx_lst_space"> </span>the<span id="lstnumberx20.8" class="ltx_text ltx_lst_space"> </span>deepest<span id="lstnumberx20.9" class="ltx_text ltx_lst_space"> </span>level<span id="lstnumberx20.10" class="ltx_text ltx_lst_space"> </span>of<span id="lstnumberx20.11" class="ltx_text ltx_lst_space"> </span>nesting<span id="lstnumberx20.12" class="ltx_text ltx_lst_space"> </span>of<span id="lstnumberx20.13" class="ltx_text ltx_lst_space"> </span>parentheses.
</div>
<div id="lstnumberx21" class="ltx_listingline"><span id="lstnumberx21.1" class="ltx_text ltx_lst_space">    </span>E.g.<span id="lstnumberx21.2" class="ltx_text ltx_lst_space"> </span>(()())<span id="lstnumberx21.3" class="ltx_text ltx_lst_space"> </span>has<span id="lstnumberx21.4" class="ltx_text ltx_lst_space"> </span>maximum<span id="lstnumberx21.5" class="ltx_text ltx_lst_space"> </span>two<span id="lstnumberx21.6" class="ltx_text ltx_lst_space"> </span>levels<span id="lstnumberx21.7" class="ltx_text ltx_lst_space"> </span>of<span id="lstnumberx21.8" class="ltx_text ltx_lst_space"> </span>nesting<span id="lstnumberx21.9" class="ltx_text ltx_lst_space"> </span>while<span id="lstnumberx21.10" class="ltx_text ltx_lst_space"> </span>((()))<span id="lstnumberx21.11" class="ltx_text ltx_lst_space"> </span>has<span id="lstnumberx21.12" class="ltx_text ltx_lst_space"> </span>three.
</div>
<div id="lstnumberx22" class="ltx_listingline">
</div>
<div id="lstnumberx23" class="ltx_listingline"><span id="lstnumberx23.1" class="ltx_text ltx_lst_space">    </span>&gt;&gt;&gt;<span id="lstnumberx23.2" class="ltx_text ltx_lst_space"> </span>parse_nested_parens(’(()())<span id="lstnumberx23.3" class="ltx_text ltx_lst_space"> </span>((()))<span id="lstnumberx23.4" class="ltx_text ltx_lst_space"> </span>()<span id="lstnumberx23.5" class="ltx_text ltx_lst_space"> </span>((())()())’)
</div>
<div id="lstnumberx24" class="ltx_listingline"><span id="lstnumberx24.1" class="ltx_text ltx_lst_space">    </span>[2,<span id="lstnumberx24.2" class="ltx_text ltx_lst_space"> </span>3,<span id="lstnumberx24.3" class="ltx_text ltx_lst_space"> </span>1,<span id="lstnumberx24.4" class="ltx_text ltx_lst_space"> </span>3]
</div>
<div id="lstnumberx25" class="ltx_listingline"><span id="lstnumberx25.1" class="ltx_text ltx_lst_space">    </span>"<span id="lstnumberx25.2" class="ltx_text ltx_lst_string">""</span>
</div>
</div>
</div>
<div id="A6.SS0.SSS0.Px2.p2" class="ltx_para">
<p id="A6.SS0.SSS0.Px2.p2.1" class="ltx_p"><span id="A6.SS0.SSS0.Px2.p2.1.1" class="ltx_text ltx_font_bold">Generated Content before LNE-Blocking:</span></p>
<div id="A6.SS0.SSS0.Px2.p2.2" class="ltx_listing ltx_lst_language_Python ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx26" class="ltx_listingline"><span id="lstnumberx26.1" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx26.2" class="ltx_text ltx_lst_keyword ltx_font_bold">def</span><span id="lstnumberx26.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx26.4" class="ltx_text ltx_lst_identifier">parse_paren_group</span>(<span id="lstnumberx26.5" class="ltx_text ltx_lst_identifier">s</span>):
</div>
<div id="lstnumberx27" class="ltx_listingline"><span id="lstnumberx27.1" class="ltx_text ltx_lst_space">        </span><span id="lstnumberx27.2" class="ltx_text ltx_lst_identifier">depth</span><span id="lstnumberx27.3" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx27.4" class="ltx_text ltx_lst_space"> </span>0
</div>
<div id="lstnumberx28" class="ltx_listingline"><span id="lstnumberx28.1" class="ltx_text ltx_lst_space">        </span><span id="lstnumberx28.2" class="ltx_text ltx_lst_identifier">max_depth</span><span id="lstnumberx28.3" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx28.4" class="ltx_text ltx_lst_space"> </span>0
</div>
<div id="lstnumberx29" class="ltx_listingline"><span id="lstnumberx29.1" class="ltx_text ltx_lst_space">        </span><span id="lstnumberx29.2" class="ltx_text ltx_lst_keyword ltx_font_bold">for</span><span id="lstnumberx29.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx29.4" class="ltx_text ltx_lst_identifier">c</span><span id="lstnumberx29.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx29.6" class="ltx_text ltx_lst_keyword ltx_font_bold">in</span><span id="lstnumberx29.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx29.8" class="ltx_text ltx_lst_identifier">s</span>:
</div>
<div id="lstnumberx30" class="ltx_listingline"><span id="lstnumberx30.1" class="ltx_text ltx_lst_space">            </span><span id="lstnumberx30.2" class="ltx_text ltx_lst_keyword ltx_font_bold">if</span><span id="lstnumberx30.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx30.4" class="ltx_text ltx_lst_identifier">c</span><span id="lstnumberx30.5" class="ltx_text ltx_lst_space"> </span>==<span id="lstnumberx30.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx30.7" class="ltx_text ltx_lst_string">’(’</span>:
</div>
<div id="lstnumberx31" class="ltx_listingline"><span id="lstnumberx31.1" class="ltx_text ltx_lst_space">                </span><span id="lstnumberx31.2" class="ltx_text ltx_lst_identifier">depth</span><span id="lstnumberx31.3" class="ltx_text ltx_lst_space"> </span>+=<span id="lstnumberx31.4" class="ltx_text ltx_lst_space"> </span>1
</div>
