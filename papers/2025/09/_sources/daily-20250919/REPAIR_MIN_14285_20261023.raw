<span id="S3.T1.4.4.1.1.1" class="ltx_p">Exfiltration</span>
</span></td>
<td id="S3.T1.4.4.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S3.T1.4.4.2.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
