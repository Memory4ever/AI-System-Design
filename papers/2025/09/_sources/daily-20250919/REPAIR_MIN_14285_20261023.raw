<td id="S5.T4.2.6.5" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><span id="S5.T4.2.6.5.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">30.0%</span></td>
