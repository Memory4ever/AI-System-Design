<span id="S4.T2.2.1.1.1.1.1.1.18.4" class="ltx_td ltx_align_center">73.3</span>
<span id="S4.T2.2.1.1.1.1.1.1.18.5" class="ltx_td ltx_align_center">52.2</span></span>
