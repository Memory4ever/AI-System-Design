{"data":{"id":"10.48550/arxiv.2509.14030","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14030","prefix":"10.48550","suffix":"arxiv.2509.14030","identifiers":[{"identifier":"2509.14030","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.14030"}],"creators":[{"name":"Qin, Maosheng","nameType":"Personal","givenName":"Maosheng","familyName":"Qin","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Renyu","nameType":"Personal","givenName":"Renyu","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Xia, Mingxuan","nameType":"Personal","givenName":"Mingxuan","familyName":"Xia","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Chenkai","nameType":"Personal","givenName":"Chenkai","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Zhen","nameType":"Personal","givenName":"Zhen","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Minmin","nameType":"Personal","givenName":"Minmin","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Junbo","nameType":"Personal","givenName":"Junbo","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Lu","nameType":"Personal","givenName":"Lu","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Fan, Changjie","nameType":"Personal","givenName":"Changjie","familyName":"Fan","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Runze","nameType":"Personal","givenName":"Runze","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Haobo","nameType":"Personal","givenName":"Haobo","familyName":"Wang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CrowdAgent: Multi-Agent Managed Multi-Source Annotation System"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T14:31:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:46:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"High-quality annotated data is a cornerstone of modern Natural Language Processing (NLP). While recent methods begin to leverage diverse annotation sources-including Large Language Models (LLMs), Small Language Models (SLMs), and human experts-they often focus narrowly on the labeling step itself. A critical gap remains in the holistic process control required to manage these sources dynamically, addressing complex scheduling and quality-cost trade-offs in a unified manner. Inspired by real-world crowdsourcing companies, we introduce CrowdAgent, a multi-agent system that provides end-to-end process control by integrating task assignment, data annotation, and quality/cost management. It implements a novel methodology that rationally assigns tasks, enabling LLMs, SLMs, and human experts to advance synergistically in a collaborative annotation workflow. We demonstrate the effectiveness of CrowdAgent through extensive experiments on six diverse multimodal classification tasks. The source code and video demo are available at https://github.com/QMMMS/CrowdAgent.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.14030","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T18:09:40.000Z","registered":"2025-09-18T18:09:41.000Z","published":"2025","updated":"2025-09-18T18:09:41.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.14030","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}