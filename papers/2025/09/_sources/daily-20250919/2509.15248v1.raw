<td id="S4.T1.4.14.4" class="ltx_td ltx_align_right ltx_border_bb ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S4.T1.4.14.4.1" class="ltx_text ltx_font_bold">+5.09</span></td>
