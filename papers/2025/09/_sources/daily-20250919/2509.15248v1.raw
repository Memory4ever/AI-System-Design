<td id="S4.T1.4.13.3" class="ltx_td ltx_align_right" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S4.T1.4.13.3.1" class="ltx_text" style="--ltx-fg-color:#B81C04;">+1.26</span></td>
<td id="S4.T1.4.13.4" class="ltx_td ltx_align_right ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;">+2.40</td>
<td id="S4.T1.4.13.5" class="ltx_td ltx_align_right" style="padding-top:1.5pt;padding-bottom:1.5pt;">63.93</td>
<td id="S4.T1.4.13.6" class="ltx_td ltx_align_right" style="padding-top:1.5pt;padding-bottom:1.5pt;"><span id="S4.T1.4.13.6.1" class="ltx_text" style="--ltx-fg-color:#B81C04;">+0.14</span></td>
