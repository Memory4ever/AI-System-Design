<td id="A1.T6.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><math id="A1.T6.m2" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></td></tr>
<tr id="A1.T6.2.2" class="ltx_tr">
