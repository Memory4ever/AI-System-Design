<td id="S5.T4.2.1.14.3" class="ltx_td ltx_align_right ltx_border_bb" style="padding-top:-0.85pt;padding-bottom:-0.85pt;"><span id="S5.T4.2.1.14.3.1" class="ltx_text ltx_font_bold">42.1</span></td>
<td id="S5.T4.2.1.14.4" class="ltx_td ltx_align_right ltx_border_bb" style="padding-top:-0.85pt;padding-bottom:-0.85pt;">98.0</td>
<td id="S5.T4.2.1.14.5" class="ltx_td ltx_align_right ltx_border_bb" style="padding-top:-0.85pt;padding-bottom:-0.85pt;"><span id="S5.T4.2.1.14.5.1" class="ltx_text ltx_font_bold">53.1</span></td>
