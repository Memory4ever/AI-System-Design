<td id="S5.T3.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T3.m4" class="ltx_Math" alttext="\text{diff}(\pi_{\text{7B-sft}}-\pi_{\text{7B-ref}})" display="inline" intent=":literal"><semantics><mrow><mtext>diff</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>π</mi><mtext>7B-sft</mtext></msub><mo>−</mo><msub><mi>π</mi><mtext>7B-ref</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{diff}(\pi_{\text{7B-sft}}-\pi_{\text{7B-ref}})</annotation></semantics></math></td>
<td id="S5.T3.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">✓</td></tr>
<tr id="S5.T3.2.1.3" class="ltx_tr">
<td id="S5.T3.2.1.3.1" class="ltx_td ltx_align_center ltx_border_r"><math id="S5.T3.m5" class="ltx_Math" alttext="V_{2}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>2</mn></msub><annotation encoding="application/x-tex">V_{2}</annotation></semantics></math></td>
<td id="S5.T3.2.1.3.2" class="ltx_td ltx_align_center"><math id="S5.T3.m6" class="ltx_Math" alttext="\pi_{\text{3B-sft}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>3B-sft</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{3B-sft}}</annotation></semantics></math></td>
<td id="S5.T3.2.1.3.3" class="ltx_td ltx_align_center"><math id="S5.T3.m7" class="ltx_Math" alttext="\pi_{\text{7B-sft}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>7B-sft</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{7B-sft}}</annotation></semantics></math></td>
