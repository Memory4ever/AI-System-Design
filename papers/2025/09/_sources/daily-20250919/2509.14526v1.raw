<td id="S5.T3.2.1.5.1" class="ltx_td ltx_align_center ltx_border_r"><math id="S5.T3.m13" class="ltx_Math" alttext="V_{4}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mn>4</mn></msub><annotation encoding="application/x-tex">V_{4}</annotation></semantics></math></td>
