<td id="S4.T2.2.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Qwen2.5-7B-Instruct</td>
<td id="S4.T2.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.5726</td>
<td id="S4.T2.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">0.2974</td>
<td id="S4.T2.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">0.3707</td></tr>
