<td id="S5.T3.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T3.m2" class="ltx_Math" alttext="\pi_{\text{3B-sft}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>3B-sft</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{3B-sft}}</annotation></semantics></math></td>
