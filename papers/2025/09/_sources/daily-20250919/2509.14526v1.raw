</figure>
<figure id="S4.T2" class="ltx_table">
<div id="S4.T2.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:176.0pt;height:18.4pt;vertical-align:-8.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-92.1pt,9.6pt) scale(0.488594758638083,0.488594758638083) ;">
