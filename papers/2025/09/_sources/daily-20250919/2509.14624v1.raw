<th id="S4.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T1.2.1.2.1" class="ltx_text ltx_font_bold">Avg. Similarity</span></th>
<th id="S4.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S4.T1.2.1.3.1" class="ltx_text ltx_font_bold">Std. Dev.</span></th></tr>
</thead>
<tbody class="ltx_tbody">
