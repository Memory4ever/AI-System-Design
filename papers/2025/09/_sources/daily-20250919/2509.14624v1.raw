<figure id="A3.T12" class="ltx_table">
<table id="A3.T12.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A3.T12.2.1" class="ltx_tr">
<th id="A3.T12.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_t"><span id="A3.T12.2.1.1.1" class="ltx_text ltx_font_bold">Model</span></th>
