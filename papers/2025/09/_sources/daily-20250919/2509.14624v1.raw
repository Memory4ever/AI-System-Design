<th id="S4.T4.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r"><span id="S4.T4.2.7.1.1" class="ltx_text ltx_font_bold">Ours</span></th>
