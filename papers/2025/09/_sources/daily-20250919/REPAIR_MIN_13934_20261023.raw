<span id="S5.T2.3.6.3.1" class="ltx_inline-block ltx_align_top" style="width:45.5pt;">
<span id="S5.T2.3.6.3.1.1" class="ltx_p"><span id="S5.T2.3.6.3.1.1.1" class="ltx_text" style="font-size:90%;">127,918,288</span></span>
</span></td>
<td id="S5.T2.3.6.4" class="ltx_td ltx_align_left ltx_align_top">
<span id="S5.T2.3.6.4.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S5.T2.3.6.4.1.1" class="ltx_p"><span id="S5.T2.3.6.4.1.1.1" class="ltx_text" style="font-size:90%;">2.72%</span></span>
</span></td></tr>
<tr id="S5.T2.3.7" class="ltx_tr">
<td id="S5.T2.3.7.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_b ltx_border_r">
<span id="S5.T2.3.7.1.1" class="ltx_inline-block ltx_align_top" style="width:48.4pt;">
