<div id="S6.T3.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:24.9pt;vertical-align:-11.2pt;"><span class="ltx_transformed_inner" style="transform:translate(-172.3pt,12.4pt) scale(0.500338210796177,0.500338210796177) ;">
