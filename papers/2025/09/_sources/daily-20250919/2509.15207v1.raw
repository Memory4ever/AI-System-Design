<td id="S6.T3.3.1.1.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S6.T3.3.1.1.7.1" class="ltx_text ltx_font_bold">Olympiad</span></td>
<td id="S6.T3.3.1.1.8" class="ltx_td ltx_align_center ltx_border_tt"><span id="S6.T3.3.1.1.8.1" class="ltx_text ltx_font_bold">Avg</span></td></tr>
<tr id="S6.T3.3.1.2" class="ltx_tr">
<td id="S6.T3.3.1.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">FlowRL</td>
<td id="S6.T3.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t">15.41</td>
<td id="S6.T3.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t">10.83</td>
<td id="S6.T3.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t">54.53</td>
<td id="S6.T3.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t">66.96</td>
