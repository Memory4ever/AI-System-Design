<td id="S6.T3.3.1.4.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r ltx_border_t"><cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib80" title="" class="ltx_ref">Zhang et al. [2025a]</a></cite></td>
<td id="S6.T3.3.1.4.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">10.41</td>
