<td id="A3.T5.3.1.1.5" class="ltx_td ltx_align_left ltx_border_tt"><span id="A3.T5.3.1.1.5.1" class="ltx_text ltx_font_bold">MATH-500</span></td>
<td id="A3.T5.3.1.1.6" class="ltx_td ltx_align_left ltx_border_tt"><span id="A3.T5.3.1.1.6.1" class="ltx_text ltx_font_bold">Minerva</span></td>
<td id="A3.T5.3.1.1.7" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt"><span id="A3.T5.3.1.1.7.1" class="ltx_text ltx_font_bold">Olympiad</span></td>
<td id="A3.T5.3.1.1.8" class="ltx_td ltx_align_left ltx_border_tt"><span id="A3.T5.3.1.1.8.1" class="ltx_text ltx_font_bold">Avg</span></td></tr>
<tr id="A3.T5.3.1.2" class="ltx_tr" style="--ltx-bg-color:#EDEDED;">
<td id="A3.T5.3.1.2.1" class="ltx_td ltx_align_center ltx_border_t" colspan="8"><span id="A3.T5.3.1.2.1.1" class="ltx_text ltx_font_typewriter">Qwen2.5-7B Base Model</span></td></tr>
<tr id="A3.T5.3.1.3" class="ltx_tr">
<td id="A3.T5.3.1.3.1" class="ltx_td ltx_align_left ltx_border_r"><span id="A3.T5.3.1.3.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#808080;">Backbone</span></td>
<td id="A3.T5.3.1.3.2" class="ltx_td ltx_align_left"><span id="A3.T5.3.1.3.2.1" class="ltx_text" style="--ltx-fg-color:#808080;">4.37</span></td>
<td id="A3.T5.3.1.3.3" class="ltx_td ltx_align_left"><span id="A3.T5.3.1.3.3.1" class="ltx_text" style="--ltx-fg-color:#808080;">2.08</span></td>
<td id="A3.T5.3.1.3.4" class="ltx_td ltx_align_left"><span id="A3.T5.3.1.3.4.1" class="ltx_text" style="--ltx-fg-color:#808080;">30.78</span></td>
<td id="A3.T5.3.1.3.5" class="ltx_td ltx_align_left"><span id="A3.T5.3.1.3.5.1" class="ltx_text" style="--ltx-fg-color:#808080;">54.48</span></td>
<td id="A3.T5.3.1.3.6" class="ltx_td ltx_align_left"><span id="A3.T5.3.1.3.6.1" class="ltx_text" style="--ltx-fg-color:#808080;">22.38</span></td>
<td id="A3.T5.3.1.3.7" class="ltx_td ltx_align_left ltx_border_r"><span id="A3.T5.3.1.3.7.1" class="ltx_text" style="--ltx-fg-color:#808080;">24.02</span></td>
<td id="A3.T5.3.1.3.8" class="ltx_td ltx_align_left"><span id="A3.T5.3.1.3.8.1" class="ltx_text" style="--ltx-fg-color:#808080;">23.02</span></td></tr>
<tr id="A3.T5.3.1.4" class="ltx_tr">
<td id="A3.T5.3.1.4.1" class="ltx_td ltx_align_left ltx_border_r">R++</td>
<td id="A3.T5.3.1.4.2" class="ltx_td ltx_align_left"><math id="A3.T5.m1" class="ltx_Math" alttext="10.57_{{\color[rgb]{0.1328,0.5469,0.1328}+6.20}}" display="inline" intent=":literal"><semantics><msub><mn>10.57</mn><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">+</mo><mn style="--ltx-fg-color:#228B22;" mathcolor="#228B22">6.20</mn></mrow></msub><annotation encoding="application/x-tex">10.57_{{\color[rgb]{0.1328,0.5469,0.1328}+6.20}}</annotation></semantics></math></td>
<td id="A3.T5.3.1.4.3" class="ltx_td ltx_align_left"><math id="A3.T5.m2" class="ltx_Math" alttext="5.10_{{\color[rgb]{0.1328,0.5469,0.1328}+3.02}}" display="inline" intent=":literal"><semantics><msub><mn>5.10</mn><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">+</mo><mn style="--ltx-fg-color:#228B22;" mathcolor="#228B22">3.02</mn></mrow></msub><annotation encoding="application/x-tex">5.10_{{\color[rgb]{0.1328,0.5469,0.1328}+3.02}}</annotation></semantics></math></td>
<td id="A3.T5.3.1.4.4" class="ltx_td ltx_align_left"><math id="A3.T5.m3" class="ltx_Math" alttext="66.02_{{\color[rgb]{0.1328,0.5469,0.1328}+35.24}}" display="inline" intent=":literal"><semantics><msub><mn>66.02</mn><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">+</mo><mn style="--ltx-fg-color:#228B22;" mathcolor="#228B22">35.24</mn></mrow></msub><annotation encoding="application/x-tex">66.02_{{\color[rgb]{0.1328,0.5469,0.1328}+35.24}}</annotation></semantics></math></td>
<td id="A3.T5.3.1.4.5" class="ltx_td ltx_align_left"><math id="A3.T5.m4" class="ltx_Math" alttext="54.29_{{\color[rgb]{1,0,0}-0.19}}" display="inline" intent=":literal"><semantics><msub><mn>54.29</mn><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">0.19</mn></mrow></msub><annotation encoding="application/x-tex">54.29_{{\color[rgb]{1,0,0}-0.19}}</annotation></semantics></math></td>
<td id="A3.T5.3.1.4.6" class="ltx_td ltx_align_left"><math id="A3.T5.m5" class="ltx_Math" alttext="24.47_{{\color[rgb]{0.1328,0.5469,0.1328}+2.09}}" display="inline" intent=":literal"><semantics><msub><mn>24.47</mn><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">+</mo><mn style="--ltx-fg-color:#228B22;" mathcolor="#228B22">2.09</mn></mrow></msub><annotation encoding="application/x-tex">24.47_{{\color[rgb]{0.1328,0.5469,0.1328}+2.09}}</annotation></semantics></math></td>
<td id="A3.T5.3.1.4.7" class="ltx_td ltx_align_left ltx_border_r"><math id="A3.T5.m6" class="ltx_Math" alttext="27.30_{{\color[rgb]{0.1328,0.5469,0.1328}+3.28}}" display="inline" intent=":literal"><semantics><msub><mn>27.30</mn><mrow><mo style="--ltx-fg-color:#228B22;" mathcolor="#228B22">+</mo><mn style="--ltx-fg-color:#228B22;" mathcolor="#228B22">3.28</mn></mrow></msub><annotation encoding="application/x-tex">27.30_{{\color[rgb]{0.1328,0.5469,0.1328}+3.28}}</annotation></semantics></math></td>
<td id="A3.T5.3.1.4.8" class="ltx_td ltx_align_left">31.29</td></tr>
