      <a href="/search/?searchtype=author&amp;query=Yang%2C+D">Dingkang Yang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+J">Jiacong Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+H">Han Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+W">Wenzhuo Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liang%2C+X">Xiao Liang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yan%2C+S">Shuicheng Yan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Feng%2C+C">Chao Feng</a>
      
