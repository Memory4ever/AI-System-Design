<td id="S4.T4.2.9.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S4.T4.2.9.7.1" class="ltx_text ltx_font_bold">47.70</span></td>
