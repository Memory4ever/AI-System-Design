<td id="S4.T5.2.4.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T5.2.4.4.1" class="ltx_text ltx_font_bold">45.59</span></td>
