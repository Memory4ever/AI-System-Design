<tr id="A1.T3.2.3" class="ltx_tr">
<th id="A1.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">CE</th>
<td id="A1.T3.2.3.2" class="ltx_td ltx_align_center">Lex</td>
<td id="A1.T3.2.3.3" class="ltx_td ltx_align_center">76.4</td>
