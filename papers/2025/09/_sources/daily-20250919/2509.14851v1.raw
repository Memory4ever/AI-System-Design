<td id="S4.T4.2.3.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T4.2.3.4.1" class="ltx_text ltx_font_bold">0.054</span></td>
<td id="S4.T4.2.3.5" class="ltx_td ltx_align_center ltx_border_b">0.309</td>
