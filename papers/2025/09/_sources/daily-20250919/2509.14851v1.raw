<span id="S4.T2.18" class="ltx_text ltx_font_bold">R-L</span> = ROUGE-L, <span id="S4.T2.19" class="ltx_text ltx_font_bold">MET.</span> = METEOR, <span id="S4.T2.20" class="ltx_text ltx_font_bold">NAvg</span> = Normalized Average Score.
