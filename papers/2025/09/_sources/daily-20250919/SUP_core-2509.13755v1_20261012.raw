<tr id="S5.T4.fig1.9.8" class="ltx_tr">
<td id="S5.T4.fig1.9.8.1" class="ltx_td ltx_align_left ltx_border_r" style="padding:0.25pt 5.0pt;"><span id="S5.T4.fig1.9.8.1.1" class="ltx_text" style="font-size:90%;">CU</span></td>
