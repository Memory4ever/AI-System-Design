<li class="ltx_tocentry ltx_tocentry_section"><a href="#S7" title="In TreeIRL: Safe Urban Driving with Tree Search and Inverse Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VII </span><span class="ltx_text ltx_font_smallcaps">General discussion and conclusions</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In TreeIRL: Safe Urban Driving with Tree Search and Inverse Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
</ol></nav>
</nav>
<div class="ltx_page_main">
<div id="infobox" class="infobox">
