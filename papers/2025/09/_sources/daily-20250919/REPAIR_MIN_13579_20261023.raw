<tr id="S6.T5.1.17" class="ltx_tr">
<td id="S6.T5.1.17.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">Brake taps (mi/event) <math id="S6.T5.m12" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S6.T5.1.17.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><span id="S6.T5.1.17.2.1" class="ltx_text ltx_font_bold">1.57</span></td>
