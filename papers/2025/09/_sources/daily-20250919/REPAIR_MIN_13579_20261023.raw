<td id="S5.T1.1.12.4" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="S5.T1.m48" class="ltx_Math" alttext="\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>IDM</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{IDM}}</annotation></semantics></math></td>
<td id="S5.T1.1.12.5" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="S5.T1.m49" class="ltx_Math" alttext="\pi_{\text{CS}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>CS</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{CS}}</annotation></semantics></math></td>
<td id="S5.T1.1.12.6" class="ltx_td ltx_align_right" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">6.00 <math id="S5.T1.m50" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.14</td></tr>
<tr id="S5.T1.1.13" class="ltx_tr">
<td id="S5.T1.1.13.1" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">400</td>
<td id="S5.T1.1.13.2" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">100</td>
<td id="S5.T1.1.13.3" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="S5.T1.m51" class="ltx_Math" alttext="\mathcal{U}_{\mathcal{A}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><annotation encoding="application/x-tex">\mathcal{U}_{\mathcal{A}}</annotation></semantics></math></td>
<td id="S5.T1.1.13.4" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="S5.T1.m52" class="ltx_Math" alttext="\pi_{\text{CS}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>CS</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{CS}}</annotation></semantics></math></td>
<td id="S5.T1.1.13.5" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="S5.T1.m53" class="ltx_Math" alttext="\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>IDM</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{IDM}}</annotation></semantics></math></td>
<td id="S5.T1.1.13.6" class="ltx_td ltx_align_right" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">4.88 <math id="S5.T1.m54" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.10</td></tr>
<tr id="S5.T1.1.14" class="ltx_tr">
<td id="S5.T1.1.14.1" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">400</td>
<td id="S5.T1.1.14.2" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">100</td>
<td id="S5.T1.1.14.3" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="S5.T1.m55" class="ltx_Math" alttext="\mathcal{U}_{\mathcal{A}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><annotation encoding="application/x-tex">\mathcal{U}_{\mathcal{A}}</annotation></semantics></math></td>
<td id="S5.T1.1.14.4" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="S5.T1.m56" class="ltx_Math" alttext="\pi_{\text{CS}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>CS</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{CS}}</annotation></semantics></math></td>
<td id="S5.T1.1.14.5" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="S5.T1.m57" class="ltx_Math" alttext="\pi_{\text{CS}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>CS</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{CS}}</annotation></semantics></math></td>
<td id="S5.T1.1.14.6" class="ltx_td ltx_align_right" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">4.93 <math id="S5.T1.m58" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.14</td></tr>
<tr id="S5.T1.1.15" class="ltx_tr">
<td id="S5.T1.1.15.1" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">0</td>
<td id="S5.T1.1.15.2" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">1</td>
<td id="S5.T1.1.15.3" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">n/a</td>
<td id="S5.T1.1.15.4" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">n/a</td>
<td id="S5.T1.1.15.5" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="S5.T1.m59" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math></td>
<td id="S5.T1.1.15.6" class="ltx_td ltx_align_right" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">2.21 <math id="S5.T1.m60" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.05</td></tr>
<tr id="S5.T1.1.16" class="ltx_tr">
<td id="S5.T1.1.16.1" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">0</td>
<td id="S5.T1.1.16.2" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">1</td>
<td id="S5.T1.1.16.3" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">n/a</td>
<td id="S5.T1.1.16.4" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">n/a</td>
<td id="S5.T1.1.16.5" class="ltx_td ltx_align_center" style="padding-top:-0.75pt;padding-bottom:-0.75pt;"><math id="S5.T1.m61" class="ltx_Math" alttext="\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>IDM</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{IDM}}</annotation></semantics></math></td>
<td id="S5.T1.1.16.6" class="ltx_td ltx_align_right" style="padding-top:-0.75pt;padding-bottom:-0.75pt;">0.03 <math id="S5.T1.m62" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.001</td></tr>
<tr id="S5.T1.1.17" class="ltx_tr">
<td id="S5.T1.1.17.1" class="ltx_td ltx_align_left ltx_border_tt" style="padding-top:-0.75pt;padding-bottom:-0.75pt;" colspan="6"><span id="S5.T1.1.17.1.1" class="ltx_text" style="font-size:70%;">* – configuration chosen for subsequent experiments.</span></td></tr>
</table>
</figure>
<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">We first compare different configurations of MCTS by taking only the top 1 trajectory (i.e., <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="k=1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k=1</annotation></semantics></math>; Fig <a href="#S3.F2" title="Fig. 2 ‣ III Theoretical background ‣ TreeIRL: Safe Urban Driving with Tree Search and Inverse Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, bottom left), while treating the IRL scorer as pass-through. By effectively disabling the IRL scorer, we can evaluate MCTS on its own as a standalone planner, as is typically done. This allows us to explore the parameter space of the MCTS trajectory generator without having to retrain the IRL scorer for every MCTS configuration.</p>
</div>
<div id="S5.SS1.p2" class="ltx_para">
<p id="S5.SS1.p2.1" class="ltx_p"><span id="S5.SS1.p2.1.1" class="ltx_text ltx_font_bold">MCTS configurations</span>. We explore different combinations of:</p>
</div>
<div id="S5.SS1.p3" class="ltx_para">
<ul id="S5.I2" class="ltx_itemize">
<li id="S5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i1.p1" class="ltx_para">
<p id="S5.I2.i1.p1.1" class="ltx_p">prior policy <math id="S5.I2.i1.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>: RL policy (<math id="S5.I2.i1.p1.m2" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math>) or uniform policy (<math id="S5.I2.i1.p1.m3" class="ltx_Math" alttext="\mathcal{U_{\mathcal{A}}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub><annotation encoding="application/x-tex">\mathcal{U_{\mathcal{A}}}</annotation></semantics></math>),</p>
</div></li>
<li id="S5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i2.p1" class="ltx_para">
<p id="S5.I2.i2.p1.1" class="ltx_p">evaluation function: RL critic (<math id="S5.I2.i2.p1.m1" class="ltx_Math" alttext="\hat{V}_{\theta}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>θ</mi></msub><annotation encoding="application/x-tex">\hat{V}_{\theta}</annotation></semantics></math>) or RL rollout (<math id="S5.I2.i2.p1.m2" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math>) or IDM rollout (<math id="S5.I2.i2.p1.m3" class="ltx_Math" alttext="\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>IDM</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{IDM}}</annotation></semantics></math>) or constant speed rollout (<math id="S5.I2.i2.p1.m4" class="ltx_Math" alttext="\pi_{\text{CS}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>CS</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{CS}}</annotation></semantics></math>),</p>
</div></li>
<li id="S5.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i3.p1" class="ltx_para">
<p id="S5.I2.i3.p1.1" class="ltx_p">padding policy: RL (<math id="S5.I2.i3.p1.m1" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math>) or IDM (<math id="S5.I2.i3.p1.m2" class="ltx_Math" alttext="\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>IDM</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{IDM}}</annotation></semantics></math>) or constant speed (<math id="S5.I2.i3.p1.m3" class="ltx_Math" alttext="\pi_{\text{CS}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>CS</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{CS}}</annotation></semantics></math>).</p>
</div></li>
</ul>
</div>
<div id="S5.SS1.p4" class="ltx_para">
<p id="S5.SS1.p4.1" class="ltx_p">We also evaluate against the standalone RL (<math id="S5.SS1.p4.m1" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math>) and IDM (<math id="S5.SS1.p4.m2" class="ltx_Math" alttext="\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>IDM</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{IDM}}</annotation></semantics></math>) policies, which correspond to the special case of the MCTS generator when each of them is set the padding policy <math id="S5.SS1.p4.m3" class="ltx_Math" alttext="\pi_{\text{padding}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>padding</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{padding}}</annotation></semantics></math> and the number of iterations is set to <math id="S5.SS1.p4.m4" class="ltx_Math" alttext="n=0" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">n=0</annotation></semantics></math>.</p>
</div>
<div id="S5.SS1.p5" class="ltx_para">
<p id="S5.SS1.p5.1" class="ltx_p"><span id="S5.SS1.p5.1.1" class="ltx_text ltx_font_bold">Progress vs. safety</span>.
With <math id="S5.SS1.p5.m1" class="ltx_Math" alttext="n=400" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>400</mn></mrow><annotation encoding="application/x-tex">n=400</annotation></semantics></math> iterations, using the RL policy either as a prior (<math id="S5.SS1.p5.m2" class="ltx_Math" alttext="P\equiv\pi_{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>≡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">P\equiv\pi_{\theta}</annotation></semantics></math>) or as a rollout policy (<math id="S5.SS1.p5.m3" class="ltx_Math" alttext="\pi_{\text{rollout}}\equiv\pi_{\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mtext>rollout</mtext></msub><mo>≡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{\text{rollout}}\equiv\pi_{\theta}</annotation></semantics></math>) tends to produce more conservative behavior, with fewer collisions but also less progress (Fig. <a href="#S5.F5" title="Fig. 5 ‣ V-A Tuning MCTS ‣ V NuPlan experiments ‣ TreeIRL: Safe Urban Driving with Tree Search and Inverse Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>). Results are similar when using the RL critic <math id="S5.SS1.p5.m4" class="ltx_Math" alttext="\hat{V}_{\theta}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>θ</mi></msub><annotation encoding="application/x-tex">\hat{V}_{\theta}</annotation></semantics></math>. In contrast, a uniform prior (<math id="S5.SS1.p5.m5" class="ltx_Math" alttext="P\equiv\mathcal{U}_{\mathcal{A}}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>≡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow><annotation encoding="application/x-tex">P\equiv\mathcal{U}_{\mathcal{A}}</annotation></semantics></math>) results in more aggressive behavior overall, with more progress but also more collisions. With a uniform prior, the IDM rollout policy (<math id="S5.SS1.p5.m6" class="ltx_Math" alttext="\pi_{\text{rollout}}\equiv\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mtext>rollout</mtext></msub><mo>≡</mo><msub><mi>π</mi><mtext>IDM</mtext></msub></mrow><annotation encoding="application/x-tex">\pi_{\text{rollout}}\equiv\pi_{\text{IDM}}</annotation></semantics></math>) is strictly better than the constant speed rollout policy (<math id="S5.SS1.p5.m7" class="ltx_Math" alttext="\pi_{\text{rollout}}\equiv\pi_{\text{CS}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mtext>rollout</mtext></msub><mo>≡</mo><msub><mi>π</mi><mtext>CS</mtext></msub></mrow><annotation encoding="application/x-tex">\pi_{\text{rollout}}\equiv\pi_{\text{CS}}</annotation></semantics></math>).</p>
</div>
<div id="S5.SS1.p6" class="ltx_para">
<p id="S5.SS1.p6.1" class="ltx_p"><span id="S5.SS1.p6.1.1" class="ltx_text ltx_font_bold">Iterations</span>.
With a uniform prior (<math id="S5.SS1.p6.m1" class="ltx_Math" alttext="P\equiv\mathcal{U}_{\mathcal{A}}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>≡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow><annotation encoding="application/x-tex">P\equiv\mathcal{U}_{\mathcal{A}}</annotation></semantics></math>), IDM rollout (<math id="S5.SS1.p6.m2" class="ltx_Math" alttext="\pi_{\text{rollout}}\equiv\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mtext>rollout</mtext></msub><mo>≡</mo><msub><mi>π</mi><mtext>IDM</mtext></msub></mrow><annotation encoding="application/x-tex">\pi_{\text{rollout}}\equiv\pi_{\text{IDM}}</annotation></semantics></math>), and IDM padding (<math id="S5.SS1.p6.m3" class="ltx_Math" alttext="\pi_{\text{padding}}\equiv\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mtext>padding</mtext></msub><mo>≡</mo><msub><mi>π</mi><mtext>IDM</mtext></msub></mrow><annotation encoding="application/x-tex">\pi_{\text{padding}}\equiv\pi_{\text{IDM}}</annotation></semantics></math>), performance plateaus around <math id="S5.SS1.p6.m4" class="ltx_Math" alttext="n=400" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>400</mn></mrow><annotation encoding="application/x-tex">n=400</annotation></semantics></math> iterations (Fig. <a href="#S5.F6" title="Fig. 6 ‣ V-A Tuning MCTS ‣ V NuPlan experiments ‣ TreeIRL: Safe Urban Driving with Tree Search and Inverse Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>).</p>
</div>
<div id="S5.SS1.p7" class="ltx_para">
<p id="S5.SS1.p7.1" class="ltx_p"><span id="S5.SS1.p7.1.1" class="ltx_text ltx_font_bold">Latency</span>.
Real-world deployment makes latency a critical consideration, as the benefit of an improved planner can be lost if it is too slow to react. We compare the latency of different MCTS trajectory generators with <math id="S5.SS1.p7.m1" class="ltx_Math" alttext="k=100" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>100</mn></mrow><annotation encoding="application/x-tex">k=100</annotation></semantics></math> trajectories – as they would be used with IRL – on 100 scenarios each. Latency is measured on a Lenovo ThinkPad laptop running Ubuntu 22.04 with an Intel Core i9-10885H CPU (2.40 GHz base, up to 5.30 GHz turbo, 8 cores/16 threads) and 16 MB L3 cache, restricted to a single CPU thread (as on the car).</p>
</div>
<div id="S5.SS1.p8" class="ltx_para">
<p id="S5.SS1.p8.1" class="ltx_p">Relying on the learned policy <math id="S5.SS1.p8.m1" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> for the rollouts is around two orders of magnitude slower than relying on the IDM policy <math id="S5.SS1.p8.m2" class="ltx_Math" alttext="\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>IDM</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{IDM}}</annotation></semantics></math> (Tab. <a href="#S5.T1" title="TABLE I ‣ V-A Tuning MCTS ‣ V NuPlan experiments ‣ TreeIRL: Safe Urban Driving with Tree Search and Inverse Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I</span></a>). For padding, the difference is around one order of magnitude. Our goal is to run the planner on the car at 10 Hz or more, so any latency above 100 ms is unacceptable. This effectively excludes configurations with <math id="S5.SS1.p8.m3" class="ltx_Math" alttext="\pi_{\text{rollout}}\equiv\pi_{\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mtext>rollout</mtext></msub><mo>≡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{\text{rollout}}\equiv\pi_{\theta}</annotation></semantics></math> or <math id="S5.SS1.p8.m4" class="ltx_Math" alttext="\pi_{\text{padding}}\equiv\pi_{\theta}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mtext>padding</mtext></msub><mo>≡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{\text{padding}}\equiv\pi_{\theta}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS1.p9" class="ltx_para">
<p id="S5.SS1.p9.1" class="ltx_p"><span id="S5.SS1.p9.1.1" class="ltx_text ltx_font_bold">Intermediate discussion</span>. The relatively conservative behavior of the learned policy <math id="S5.SS1.p9.m1" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> is likely due to the low-dimensional state space, which only captures the ego and lead vehicles. Since the RL policy is model-free, this is the only information it can use to make decisions. As a result, the RL policy is effectively “blind” to any agent that is not immediately in front of it, until that agent actually appears. Because of this, the RL policy cannot anticipate, for example, that an agent would cut in from an adjacent lane; so in order to avoid collisions, it converges on more conservative behavior overall.</p>
</div>
<div id="S5.SS1.p10" class="ltx_para">
<p id="S5.SS1.p10.1" class="ltx_p">In contrast, MCTS is model-based and, in our case, it can use the predictions to evaluate the consequences of its actions. As a result, despite using the same low-dimensional state space, MCTS can anticipate cut-ins and other kinds of interactions. For example, if a cut-in is unlikely, it will evaluate actions that make progress as more rewarding; conversely, if a cut-in is likely, it will prefer conservative actions that avoid collisions. This leads to improved progress and safety compared to the standalone RL and IDM planners.</p>
</div>
<div id="S5.SS1.p11" class="ltx_para">
<p id="S5.SS1.p11.1" class="ltx_p">Given the latency costs of the learned policy <math id="S5.SS1.p11.m1" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> and its overly conservative bias (as well as that of <math id="S5.SS1.p11.m2" class="ltx_Math" alttext="\hat{V}_{\theta}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>V</mi><mo>^</mo></mover><mi>θ</mi></msub><annotation encoding="application/x-tex">\hat{V}_{\theta}</annotation></semantics></math>), we use the following parameters for the MCTS generator in subsequent experiments: <math id="S5.SS1.p11.m3" class="ltx_Math" alttext="n=400,k=100,P\equiv\mathcal{U}_{\mathcal{A}},\pi_{\text{rollout}}\equiv\pi_{\text{IDM}},\pi_{\text{padding}}\equiv\pi_{\text{IDM}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>400</mn></mrow><mo>,</mo><mrow><mi>k</mi><mo>=</mo><mn>100</mn></mrow><mo>,</mo><mrow><mi>P</mi><mo>≡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒰</mi><mi class="ltx_font_mathcaligraphic">𝒜</mi></msub></mrow><mo>,</mo><mrow><msub><mi>π</mi><mtext>rollout</mtext></msub><mo>≡</mo><msub><mi>π</mi><mtext>IDM</mtext></msub></mrow><mo>,</mo><mrow><msub><mi>π</mi><mtext>padding</mtext></msub><mo>≡</mo><msub><mi>π</mi><mtext>IDM</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">n=400,k=100,P\equiv\mathcal{U}_{\mathcal{A}},\pi_{\text{rollout}}\equiv\pi_{\text{IDM}},\pi_{\text{padding}}\equiv\pi_{\text{IDM}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS2.4" class="ltx_text">V-B</span> </span><span id="S5.SS2.5" class="ltx_text ltx_font_italic">TreeIRL evaluation</span></h3>

