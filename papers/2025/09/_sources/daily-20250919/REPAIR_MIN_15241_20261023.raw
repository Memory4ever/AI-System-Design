<td id="S6.T4.4.1.24.7" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:0.8pt;padding-bottom:0.8pt;"><span id="S6.T4.4.1.24.7.1" class="ltx_text" style="font-size:70%;">96.22</span></td>
