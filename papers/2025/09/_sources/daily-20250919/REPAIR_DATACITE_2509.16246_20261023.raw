{"data":{"id":"10.48550/arxiv.2509.16246","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16246","prefix":"10.48550","suffix":"arxiv.2509.16246","identifiers":[{"identifier":"2509.16246","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.16246"}],"creators":[{"name":"Niu, Juxin","nameType":"Personal","givenName":"Juxin","familyName":"Niu","affiliation":[],"nameIdentifiers":[]},{"name":"Du, Yuxin","nameType":"Personal","givenName":"Yuxin","familyName":"Du","affiliation":[],"nameIdentifiers":[]},{"name":"Niu, Dan","nameType":"Personal","givenName":"Dan","familyName":"Niu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Xi","nameType":"Personal","givenName":"Xi","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Zhe","nameType":"Personal","givenName":"Zhe","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Guan, Nan","nameType":"Personal","givenName":"Nan","familyName":"Guan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VerilogMonkey: Exploring Parallel Scaling for Automated Verilog Code Generation with LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Programming Languages (cs.PL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T10:12:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:01:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"We present VerilogMonkey, an empirical study of parallel scaling for the under-explored task of automated Verilog generation. Parallel scaling improves LLM performance by sampling many outputs in parallel. Across multiple benchmarks and mainstream LLMs, we find that scaling to hundreds of samples is cost-effective in both time and money and, even without any additional enhancements such as post-training or agentic methods, surpasses prior results on LLM-based Verilog generation. We further dissect why parallel scaling delivers these gains and show how output randomness in LLMs affects its effectiveness.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.16246","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:43:52.000Z","registered":"2025-09-23T02:43:53.000Z","published":"2025","updated":"2025-09-23T02:43:53.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.16246","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}