</figure>
<figure id="S4.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S4.T2.6" class="ltx_text" style="font-size:90%;">Table 2</span>: </span><span id="S4.T2.7" class="ltx_text" style="font-size:90%;">Cumulative ablation study (PSNR) on the <span id="S4.T2.7.1" class="ltx_text ltx_framed ltx_framed_underline" style="--ltx-border-color:#000000;">synthetic smoke video</span>. <span id="S4.T2.7.2" class="ltx_text ltx_font_italic">Novel view</span> uses the camera pose at <math id="S4.T2.m2" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>, and <span id="S4.T2.7.3" class="ltx_text ltx_font_italic">input view</span> means the camera poses along the source video.
</span></figcaption>
<div id="S4.T2.8" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:233.5pt;height:58.7pt;vertical-align:-27.6pt;"><span class="ltx_transformed_inner" style="transform:translate(-52.8pt,13.3pt) scale(0.688576702108815,0.688576702108815) ;">
<table id="S4.T2.8.1" class="ltx_tabular ltx_align_middle">
<tr id="S4.T2.8.1.1" class="ltx_tr">
<td id="S4.T2.8.1.1.1" class="ltx_td ltx_border_tt" style="padding-left:2.5pt;padding-right:2.5pt;"></td>
<td id="S4.T2.8.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.5pt;padding-right:2.5pt;">
<table id="S4.T2.8.1.1.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S4.T2.8.1.1.2.1.1" class="ltx_tr">
<td id="S4.T2.8.1.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;">Novel View</td></tr>
<tr id="S4.T2.8.1.1.2.1.2" class="ltx_tr">
<td id="S4.T2.8.1.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;">Synthesis</td></tr>
</table></td>
