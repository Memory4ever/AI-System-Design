{"data":{"id":"10.48550/arxiv.2509.18165","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18165","prefix":"10.48550","suffix":"arxiv.2509.18165","identifiers":[{"identifier":"2509.18165","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.18165"}],"creators":[{"name":"Cai, Xiuding","nameType":"Personal","givenName":"Xiuding","familyName":"Cai","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Yaoyao","nameType":"Personal","givenName":"Yaoyao","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Fu, Linjie","nameType":"Personal","givenName":"Linjie","familyName":"Fu","affiliation":[],"nameIdentifiers":[]},{"name":"Miao, Dong","nameType":"Personal","givenName":"Dong","familyName":"Miao","affiliation":[],"nameIdentifiers":[]},{"name":"Yao, Yu","nameType":"Personal","givenName":"Yu","familyName":"Yao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Self Identity Mapping"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T07:52:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-24T00:01:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Regularization is essential in deep learning to enhance generalization and mitigate overfitting. However, conventional techniques often rely on heuristics, making them less reliable or effective across diverse settings. We propose Self Identity Mapping (SIM), a simple yet effective, data-intrinsic regularization framework that leverages an inverse mapping mechanism to enhance representation learning. By reconstructing the input from its transformed output, SIM reduces information loss during forward propagation and facilitates smoother gradient flow. To address computational inefficiencies, We instantiate SIM as $ ρ\\text{SIM} $ by incorporating patch-level feature sampling and projection-based method to reconstruct latent features, effectively lowering complexity. As a model-agnostic, task-agnostic regularizer, SIM can be seamlessly integrated as a plug-and-play module, making it applicable to different network architectures and tasks.\n We extensively evaluate $ρ\\text{SIM}$ across three tasks: image classification, few-shot prompt learning, and domain generalization. Experimental results show consistent improvements over baseline methods, highlighting $ρ\\text{SIM}$'s ability to enhance representation learning across various tasks. We also demonstrate that $ρ\\text{SIM}$ is orthogonal to existing regularization methods, boosting their effectiveness. Moreover, our results confirm that $ρ\\text{SIM}$ effectively preserves semantic information and enhances performance in dense-to-dense tasks, such as semantic segmentation and image translation, as well as in non-visual domains including audio classification and time series anomaly detection. The code is publicly available at https://github.com/XiudingCai/SIM-pytorch.","descriptionType":"Abstract"},{"description":"Early accepted by Neural Networks 2025","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.18165","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-24T01:51:49.000Z","registered":"2025-09-24T01:51:50.000Z","published":"2025","updated":"2025-09-24T01:51:50.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.18165","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}