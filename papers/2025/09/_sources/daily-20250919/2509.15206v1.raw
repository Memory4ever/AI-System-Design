<td id="S4.T1.2.15.7" class="ltx_td ltx_align_center"><span id="S4.T1.2.15.7.1" class="ltx_text" style="font-size:90%;">71.51</span></td>
<td id="S4.T1.2.15.8" class="ltx_td ltx_align_center"><span id="S4.T1.2.15.8.1" class="ltx_text" style="font-size:90%;">67.50</span></td>
<td id="S4.T1.2.15.9" class="ltx_td ltx_align_center"><span id="S4.T1.2.15.9.1" class="ltx_text" style="font-size:90%;">66.99</span></td></tr>
<tr id="S4.T1.2.16" class="ltx_tr">
<td id="S4.T1.2.16.1" class="ltx_td ltx_align_left ltx_border_r"><span id="S4.T1.2.16.1.1" class="ltx_text" style="font-size:90%;">Fair-GPTQ<math id="S4.T1.m15" class="ltx_Math" alttext="{}_{\text{l}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>l</mtext></msub><annotation encoding="application/x-tex">{}_{\text{l}}</annotation></semantics></math></span></td>
<td id="S4.T1.2.16.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.16.2.1" class="ltx_text" style="font-size:90%;">13.26</span></td>
<td id="S4.T1.2.16.3" class="ltx_td ltx_align_center"><span id="S4.T1.2.16.3.1" class="ltx_text" style="font-size:90%;">63.76</span></td>
<td id="S4.T1.2.16.4" class="ltx_td ltx_align_center"><span id="S4.T1.2.16.4.1" class="ltx_text" style="font-size:90%;">71.81</span></td>
<td id="S4.T1.2.16.5" class="ltx_td ltx_align_center"><span id="S4.T1.2.16.5.1" class="ltx_text" style="font-size:90%;">47.00</span></td>
<td id="S4.T1.2.16.6" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.16.6.1" class="ltx_text" style="font-size:90%;">73.83</span></td>
<td id="S4.T1.2.16.7" class="ltx_td ltx_align_center"><span id="S4.T1.2.16.7.1" class="ltx_text" style="font-size:90%;">73.79</span></td>
<td id="S4.T1.2.16.8" class="ltx_td ltx_align_center"><span id="S4.T1.2.16.8.1" class="ltx_text" style="font-size:90%;">63.51</span></td>
<td id="S4.T1.2.16.9" class="ltx_td ltx_align_center"><span id="S4.T1.2.16.9.1" class="ltx_text" style="font-size:90%;">64.35</span></td></tr>
<tr id="S4.T1.2.17" class="ltx_tr">
<td id="S4.T1.2.17.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r"><span id="S4.T1.2.17.1.1" class="ltx_text" style="font-size:90%;">Fair-GPTQ<math id="S4.T1.m16" class="ltx_Math" alttext="{}_{\text{ul}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext>ul</mtext></msub><annotation encoding="application/x-tex">{}_{\text{ul}}</annotation></semantics></math></span></td>
<td id="S4.T1.2.17.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T1.2.17.2.1" class="ltx_text" style="font-size:90%;">13.42</span></td>
<td id="S4.T1.2.17.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.17.3.1" class="ltx_text" style="font-size:90%;">61.70</span></td>
