<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\displaystyle\;-\lambda^{2}\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}+\lambda\left[-\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}+w_{q}-\operatorname{quant}(w_{q})\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐞</mi><mi>q</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>q</mi></msub></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>−</mo><mrow><msubsup><mi>𝐞</mi><mi>q</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐉</mi><mi>𝐰</mi></msub></mrow></mrow><mo>+</mo><msub><mi>w</mi><mi>q</mi></msub></mrow><mo>−</mo><mrow><mi>quant</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\;-\lambda^{2}\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}+\lambda\left[-\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}+w_{q}-\operatorname{quant}(w_{q})\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex18.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex18.m2" class="ltx_Math" alttext="\displaystyle\;-\dfrac{\lambda^{2}}{2}\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}-\lambda(\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}-(w_{q}-\operatorname{quant}(w_{q})))-\dfrac{1}{2}\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>λ</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐞</mi><mi>q</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>q</mi></msub></mrow></mrow><mo>−</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>𝐞</mi><mi>q</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐉</mi><mi>𝐰</mi></msub></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>w</mi><mi>q</mi></msub><mo>−</mo><mrow><mi>quant</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐉</mi><mi>𝐰</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐉</mi><mi>𝐰</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\;-\dfrac{\lambda^{2}}{2}\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}-\lambda(\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}-(w_{q}-\operatorname{quant}(w_{q})))-\dfrac{1}{2}\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}.</annotation></semantics></math></td>
