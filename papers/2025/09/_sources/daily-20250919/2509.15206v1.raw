<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex15.m1" class="ltx_Math" alttext="\displaystyle\;+\lambda\left[-\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}+w_{q}-\operatorname{quant}(w_{q})\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>−</mo><mrow><msubsup><mi>𝐞</mi><mi>q</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐉</mi><mi>𝐰</mi></msub></mrow></mrow><mo>+</mo><msub><mi>w</mi><mi>q</mi></msub></mrow><mo>−</mo><mrow><mi>quant</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\;+\lambda\left[-\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}+w_{q}-\operatorname{quant}(w_{q})\right],</annotation></semantics></math></td>
