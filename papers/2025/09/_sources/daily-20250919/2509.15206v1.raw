<td id="S4.T1.2.15.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.15.2.1" class="ltx_text" style="font-size:90%;">11.47</span></td>
<td id="S4.T1.2.15.3" class="ltx_td ltx_align_center"><span id="S4.T1.2.15.3.1" class="ltx_text" style="font-size:90%;">63.80</span></td>
<td id="S4.T1.2.15.4" class="ltx_td ltx_align_center"><span id="S4.T1.2.15.4.1" class="ltx_text" style="font-size:90%;">73.00</span></td>
<td id="S4.T1.2.15.5" class="ltx_td ltx_align_center"><span id="S4.T1.2.15.5.1" class="ltx_text" style="font-size:90%;">49.79</span></td>
