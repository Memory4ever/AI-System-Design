<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14.m2" class="ltx_Math" alttext="\displaystyle\;\dfrac{1}{2}(\lambda\mathbf{e}_{q}+\mathbf{J}_{\mathbf{w}})^{\top}\mathbf{H}_{\mathbf{w}}^{-1}(\lambda\mathbf{e}_{q}+\mathbf{J}_{\mathbf{w}})-\lambda\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}-\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}-\lambda^{2}\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>q</mi></msub></mrow><mo>+</mo><msub><mi>𝐉</mi><mi>𝐰</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>q</mi></msub></mrow><mo>+</mo><msub><mi>𝐉</mi><mi>𝐰</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐉</mi><mi>𝐰</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>q</mi></msub></mrow><mo>−</mo><mrow><msubsup><mi>𝐉</mi><mi>𝐰</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐉</mi><mi>𝐰</mi></msub></mrow><mo>−</mo><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐞</mi><mi>q</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>q</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\;\dfrac{1}{2}(\lambda\mathbf{e}_{q}+\mathbf{J}_{\mathbf{w}})^{\top}\mathbf{H}_{\mathbf{w}}^{-1}(\lambda\mathbf{e}_{q}+\mathbf{J}_{\mathbf{w}})-\lambda\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}-\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}-\lambda^{2}\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}</annotation></semantics></math></td>
