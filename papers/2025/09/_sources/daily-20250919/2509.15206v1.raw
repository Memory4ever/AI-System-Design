<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16.m2" class="ltx_Math" alttext="\displaystyle\;\dfrac{\lambda^{2}}{2}\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}+\dfrac{1}{2}\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}-\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}+{\color[rgb]{1,0,0.2}{\underbrace{\lambda\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}-\lambda\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}}_{=0}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>λ</mi><mn>2</mn></msup><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐞</mi><mi>q</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐞</mi><mi>q</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐉</mi><mi>𝐰</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐉</mi><mi>𝐰</mi></msub></mrow></mrow><mo>−</mo><mrow><msubsup><mi>𝐉</mi><mi>𝐰</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐇</mi><mi>𝐰</mi><mrow><mo>−</mo><mn>1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐉</mi><mi>𝐰</mi></msub></mrow></mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mrow><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">𝐉</mi><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">𝐰</mi><mo style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">𝐇</mi><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">𝐰</mi><mrow><mo style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">−</mo><mn style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">𝐞</mi><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">q</mi></msub></mrow><mo style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">−</mo><mrow><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">𝐉</mi><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">𝐰</mi><mo style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">𝐇</mi><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">𝐰</mi><mrow><mo style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">−</mo><mn style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">1</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">𝐞</mi><mi style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">q</mi></msub></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">=</mo><mn style="--ltx-fg-color:#FF0033;" mathcolor="#FF0033">0</mn></mrow></munder></mrow><annotation encoding="application/x-tex">\displaystyle\;\dfrac{\lambda^{2}}{2}\mathbf{e}_{q}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}+\dfrac{1}{2}\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}-\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{J}_{\mathbf{w}}+{\color[rgb]{1,0,0.2}{\underbrace{\lambda\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}-\lambda\mathbf{J}_{\mathbf{w}}^{\top}\mathbf{H}_{\mathbf{w}}^{-1}\mathbf{e}_{q}}_{=0}}}</annotation></semantics></math></td>
