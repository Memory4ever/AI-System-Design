<th id="A4.T9.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T9.2.1.3.1" class="ltx_text ltx_font_bold">Gender</span></th>
<th id="A4.T9.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T9.2.1.4.1" class="ltx_text ltx_font_bold">Race</span></th>
<th id="A4.T9.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T9.2.1.5.1" class="ltx_text ltx_font_bold">Disabled</span></th></tr>
