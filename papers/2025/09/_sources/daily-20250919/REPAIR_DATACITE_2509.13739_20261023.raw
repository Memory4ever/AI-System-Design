{"data":{"id":"10.48550/arxiv.2509.13739","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13739","prefix":"10.48550","suffix":"arxiv.2509.13739","identifiers":[{"identifier":"2509.13739","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.13739"}],"creators":[{"name":"Wu, Zihou","nameType":"Personal","givenName":"Zihou","familyName":"Wu","affiliation":["School of Computer Science and Engineering, Sun Yat-sen University, Guangzhou, China"],"nameIdentifiers":[]},{"name":"Li, Yuecheng","nameType":"Personal","givenName":"Yuecheng","familyName":"Li","affiliation":["School of Computer Science and Engineering, Sun Yat-sen University, Guangzhou, China"],"nameIdentifiers":[]},{"name":"Liao, Tianchi","nameType":"Personal","givenName":"Tianchi","familyName":"Liao","affiliation":["School of Software Engineering, Sun Yat-sen University, Zhuhai, China"],"nameIdentifiers":[]},{"name":"Lou, Jian","nameType":"Personal","givenName":"Jian","familyName":"Lou","affiliation":["School of Software Engineering, Sun Yat-sen University, Zhuhai, China"],"nameIdentifiers":[]},{"name":"Chen, Chuan","nameType":"Personal","givenName":"Chuan","familyName":"Chen","affiliation":["School of Computer Science and Engineering, Sun Yat-sen University, Guangzhou, China"],"nameIdentifiers":[]}],"titles":[{"title":"ParaAegis: Parallel Protection for Flexible Privacy-preserved Federated Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T06:45:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:26:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Federated learning (FL) faces a critical dilemma: existing protection mechanisms like differential privacy (DP) and homomorphic encryption (HE) enforce a rigid trade-off, forcing a choice between model utility and computational efficiency. This lack of flexibility hinders the practical implementation. To address this, we introduce ParaAegis, a parallel protection framework designed to give practitioners flexible control over the privacy-utility-efficiency balance. Our core innovation is a strategic model partitioning scheme. By applying lightweight DP to the less critical, low norm portion of the model while protecting the remainder with HE, we create a tunable system. A distributed voting mechanism ensures consensus on this partitioning. Theoretical analysis confirms the adjustments between efficiency and utility with the same privacy. Crucially, the experimental results demonstrate that by adjusting the hyperparameters, our method enables flexible prioritization between model accuracy and training time.","descriptionType":"Abstract"},{"description":"8 pages, 1 figure","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.13739","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:57:53.000Z","registered":"2025-09-18T17:57:53.000Z","published":"2025","updated":"2025-09-18T17:57:53.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.13739","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}