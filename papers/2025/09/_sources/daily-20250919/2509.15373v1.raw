<td id="S3.T1.2.8.7" class="ltx_td ltx_align_left"><span id="S3.T1.2.8.7.1" class="ltx_text" style="font-size:90%;">3326</span></td>
<td id="S3.T1.2.8.8" class="ltx_td ltx_align_left"><span id="S3.T1.2.8.8.1" class="ltx_text" style="font-size:90%;">491</span></td>
<td id="S3.T1.2.8.9" class="ltx_td ltx_align_left"><span id="S3.T1.2.8.9.1" class="ltx_text" style="font-size:90%;">58.9</span></td>
<td id="S3.T1.2.8.10" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S3.T1.2.8.10.1" class="ltx_text" style="font-size:90%;">99.9</span></td></tr>
<tr id="S3.T1.2.9" class="ltx_tr">
<td id="S3.T1.2.9.1" class="ltx_td ltx_align_left"><span id="S3.T1.2.9.1.1" class="ltx_text" style="font-size:90%;">   LibriSpeech-324</span></td>
