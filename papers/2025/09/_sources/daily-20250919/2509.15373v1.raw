<td id="S3.T1.2.9.4" class="ltx_td ltx_align_left"><span id="S3.T1.2.9.4.1" class="ltx_text" style="font-size:90%;">52576</span></td>
<td id="S3.T1.2.9.5" class="ltx_td ltx_align_left"><span id="S3.T1.2.9.5.1" class="ltx_text" style="font-size:90%;">8138</span></td>
<td id="S3.T1.2.9.6" class="ltx_td ltx_align_left"><span id="S3.T1.2.9.6.1" class="ltx_text" style="font-size:90%;">36842</span></td>
<td id="S3.T1.2.9.7" class="ltx_td ltx_align_left"><span id="S3.T1.2.9.7.1" class="ltx_text" style="font-size:90%;">6644</span></td>
<td id="S3.T1.2.9.8" class="ltx_td ltx_align_left"><span id="S3.T1.2.9.8.1" class="ltx_text" style="font-size:90%;">592</span></td>
<td id="S3.T1.2.9.9" class="ltx_td ltx_align_left"><span id="S3.T1.2.9.9.1" class="ltx_text" style="font-size:90%;">63.9</span></td>
<td id="S3.T1.2.9.10" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S3.T1.2.9.10.1" class="ltx_text" style="font-size:90%;">99.9</span></td></tr>
<tr id="S3.T1.2.10" class="ltx_tr">
<td id="S3.T1.2.10.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S3.T1.2.10.1.1" class="ltx_text" style="font-size:90%;">   LibriSpeech-1207</span></td>
