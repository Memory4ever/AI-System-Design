<th id="S5.T4.1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GPT-Image-1</th>
<td id="S5.T4.1.1.3.2" class="ltx_td ltx_align_center"><span id="S5.T4.1.1.3.2.1" class="ltx_text ltx_font_bold">38.35</span></td>
<td id="S5.T4.1.1.3.3" class="ltx_td ltx_align_center">28.78</td></tr>
<tr id="S5.T4.1.1.4" class="ltx_tr">
<th id="S5.T4.1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Gemini 2.0 Flash</th>
<td id="S5.T4.1.1.4.2" class="ltx_td ltx_align_center"><span id="S5.T4.1.1.4.2.1" class="ltx_text ltx_font_bold">28.42</span></td>
<td id="S5.T4.1.1.4.3" class="ltx_td ltx_align_center">21.89</td></tr>
