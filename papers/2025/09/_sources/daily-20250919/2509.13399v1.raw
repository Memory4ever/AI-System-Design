<td id="S5.T2.10.1.7.4" class="ltx_td ltx_align_center">61.89</td>
<td id="S5.T2.10.1.7.5" class="ltx_td ltx_align_center">34.97</td>
<td id="S5.T2.10.1.7.6" class="ltx_td ltx_align_center">17.83</td>
<td id="S5.T2.10.1.7.7" class="ltx_td ltx_align_center">92.76</td>
<td id="S5.T2.10.1.7.8" class="ltx_td ltx_align_center">88.52</td>
