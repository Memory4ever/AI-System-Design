<th id="S5.T4.1.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Nano Banana</th>
<td id="S5.T4.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T4.1.1.2.3.1" class="ltx_text ltx_font_bold">35.35</span></td>
