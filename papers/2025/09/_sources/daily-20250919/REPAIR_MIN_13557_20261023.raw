bject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.3" class="ltx_text" style="font-size:70%;">fft</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 48.37 0) translate(7.47,0)"><path style="fill:none" d="M 0 0 L 9.04 0 C 10.57 0 13.05 0 14.58 0 L 23.62 0"></path><path d="M 14.58 2.77 L 9.04 2.77 L 9.04 -2.77 L 14.58 -2.77 Z M 9.04 -2.77"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 80.02 0) translate(6.64,0) matrix(1.0 0.0 0.0 1.0 3.04 -1.05)"><foreignObject style="--ltx-fo-width:2.3em;--ltx-fo-height:0.38em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="25.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.4" class="ltx_text" style="font-size:70%;">spmv</span></span></span></foreignObject></g><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.8pt" transform="matrix(1 0 0 -1 117.57 0) translate(7.47,0)"><path style="fill:none" d="M 0 0 L 9.04 0 C 10.57 0 13.05 0 14.58 0 L 23.62 0"></path><path d="M 11.81 2.77 L 14.21 -1.38 L 9.41 -1.38 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 149.22 0) translate(6.64,0) matrix(1.0 0.0 0.0 1.0 3.04 -1.05)"><foreignObject style="--ltx-fo-width:2.59em;--ltx-fo-height:0.38em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="6.05" overflow="visible" transform="matrix(1 0 0 -1 0 4.17)" width="28.62"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.5" class="ltx_text" style="font-size:70%;">gemm</span></span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F5.2" class="ltx_text" style="font-size:90%;">Fig. 5</span>: </span><span id="S3.F5.3" class="ltx_text" style="font-size:90%;">Power efficiency improvement of typical kernels (fft, spmv, gemm) across iterations using MACO.</span></figcaption>
</figure>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">IV </span><span id="S4.1" class="ltx_text ltx_font_smallcaps">Evaluation</span></h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">This section evaluates MACO and compared it with other LLM-based approaches for CGRA design.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS1.4" class="ltx_text">IV-A</span> </span><span id="S4.SS1.5" class="ltx_text ltx_font_italic">Experiment Setup</span></h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">To validate the effectiveness of MACO framework, we evaluate not only the success rate of the generated CGRA architectures but also their performance, power, and runtime, using multiple metrics that reflect real CGRA performance and overall design quality.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">Experiments are conducted on 8 representative kernels from three different domains. All evaluations are performed on a server equipped with an Intel(R) Xeon(R) Gold 6444Y processor, with physical design carried out using the ASAP 7nm technology library. CGRA RTL design is implemented using the Open-CGRA tool <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">26</a>]</cite>. Power, area, and performance evaluation is conducted with the DC Compiler.</p>
</div>
<figure id="S4.T4" class="ltx_table">
