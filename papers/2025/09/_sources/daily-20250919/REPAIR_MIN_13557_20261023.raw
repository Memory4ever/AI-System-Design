<td id="S2.T1.2.4.1" class="ltx_td ltx_align_left" style="padding:0.85pt 2.0pt;"><span id="S2.T1.2.4.1.1" class="ltx_text" style="font-size:80%;">GPT4AI Chip <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite></span></td>
