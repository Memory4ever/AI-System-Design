<br class="ltx_break">What would the user purchase after 
<br class="ltx_break"><math id="A2.SS4.p4.pic1.m1" class="ltx_Math" alttext="\tilde{i}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><annotation encoding="application/x-tex">\tilde{i}_{1}</annotation></semantics></math> (after <math id="A2.SS4.p4.pic1.m2" class="ltx_Math" alttext="t_{2}-t_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow><annotation encoding="application/x-tex">t_{2}-t_{1}</annotation></semantics></math>),
<math id="A2.SS4.p4.pic1.m3" class="ltx_Math" alttext="\tilde{i}_{2}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><annotation encoding="application/x-tex">\tilde{i}_{2}</annotation></semantics></math> (after <math id="A2.SS4.p4.pic1.m4" class="ltx_Math" alttext="t_{3}-t_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><annotation encoding="application/x-tex">t_{3}-t_{2}</annotation></semantics></math>), 
