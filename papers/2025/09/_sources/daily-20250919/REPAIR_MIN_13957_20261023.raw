<br class="ltx_break"><math id="A2.SS4.p5.pic1.m5" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math>,
