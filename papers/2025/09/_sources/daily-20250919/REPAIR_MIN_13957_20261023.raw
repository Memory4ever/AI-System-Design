</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS4.p5" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS4.p5.pic1" class="ltx_picture" height="91.9" overflow="visible" version="1.1" viewBox="0 0 653.15 91.9" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,91.9) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 86 C 0 89.26 2.64 91.9 5.91 91.9 L 647.24 91.9 C 650.51 91.9 653.15 89.26 653.15 86 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 86 C 1.97 88.17 3.73 89.93 5.91 89.93 L 647.24 89.93 C 649.42 89.93 651.18 88.17 651.18 86 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 18.7)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:4.29em;--ltx-fo-depth:0.36em;font-size:10pt;" height="64.34" overflow="visible" transform="matrix(1 0 0 -1 0 59.42)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS4.p5.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:44.07em;">
<span id="A2.SS4.p5.pic1.1.1" class="ltx_p"><span id="A2.SS4.p5.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Target-relative<span id="A2.SS4.p5.pic1.1.1.1.1" class="ltx_text ltx_font_medium">: 
<br class="ltx_break">What would the user purchase after 
<br class="ltx_break"><math id="A2.SS4.p5.pic1.m1" class="ltx_Math" alttext="\tilde{i}_{1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><annotation encoding="application/x-tex">\tilde{i}_{1}</annotation></semantics></math> (<math id="A2.SS4.p5.pic1.m2" class="ltx_Math" alttext="t_{|s_{u}|+1}-t_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mrow><annotation encoding="application/x-tex">t_{|s_{u}|+1}-t_{1}</annotation></semantics></math> ago),
