<math id="A2.SS4.p3.pic1.m3" class="ltx_Math" alttext="\tilde{i}_{2}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><annotation encoding="application/x-tex">\tilde{i}_{2}</annotation></semantics></math> (<math id="A2.SS4.p3.pic1.m4" class="ltx_Math" alttext="t_{2}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub><annotation encoding="application/x-tex">t_{2}</annotation></semantics></math>),
