<td id="S1.T1.2.1.9.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S1.T1.m12" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi>✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td></tr>
