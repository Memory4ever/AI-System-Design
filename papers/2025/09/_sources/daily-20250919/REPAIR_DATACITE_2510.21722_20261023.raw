{"data":{"id":"10.48550/arxiv.2510.21722","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21722","prefix":"10.48550","suffix":"arxiv.2510.21722","identifiers":[{"identifier":"2510.21722","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2510.21722"}],"creators":[{"name":"Tian, Beitong","nameType":"Personal","givenName":"Beitong","familyName":"Tian","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Lingzhi","nameType":"Personal","givenName":"Lingzhi","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Bo","nameType":"Personal","givenName":"Bo","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Haozhen","nameType":"Personal","givenName":"Haozhen","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Jingcheng","nameType":"Personal","givenName":"Jingcheng","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Mingyuan","nameType":"Personal","givenName":"Mingyuan","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Vasisht, Deepak","nameType":"Personal","givenName":"Deepak","familyName":"Vasisht","affiliation":[],"nameIdentifiers":[]},{"name":"Nahrstedt, Klara","nameType":"Personal","givenName":"Klara","familyName":"Nahrstedt","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AquaVLM: Improving Underwater Situation Awareness with Mobile Vision Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Human-Computer Interaction (cs.HC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T04:16:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:00:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Underwater activities like scuba diving enable millions annually to explore marine environments for recreation and scientific research. Maintaining situational awareness and effective communication are essential for diver safety. Traditional underwater communication systems are often bulky and expensive, limiting their accessibility to divers of all levels. While recent systems leverage lightweight smartphones and support text messaging, the messages are predefined and thus restrict context-specific communication.\n In this paper, we present AquaVLM, a tap-and-send underwater communication system that automatically generates context-aware messages and transmits them using ubiquitous smartphones. Our system features a mobile vision-language model (VLM) fine-tuned on an auto-generated underwater conversation dataset and employs a hierarchical message generation pipeline. We co-design the VLM and transmission, incorporating error-resilient fine-tuning to improve the system's robustness to transmission errors. We develop a VR simulator to enable users to experience AquaVLM in a realistic underwater environment and create a fully functional prototype on the iOS platform for real-world experiments. Both subjective and objective evaluations validate the effectiveness of AquaVLM and highlight its potential for personal underwater communication as well as broader mobile VLM applications.","descriptionType":"Abstract"},{"description":"12 pages, 10 figures, under review","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2510.21722","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T02:58:24.000Z","registered":"2025-10-28T02:58:25.000Z","published":"2025","updated":"2025-10-28T02:58:25.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2510.21722","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}