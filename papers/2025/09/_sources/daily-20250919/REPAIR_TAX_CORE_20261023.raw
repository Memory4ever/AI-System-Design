ter" style="font-size:80%;">*</span><span id="lstnumberx31.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx31.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">t_rate</span><span id="lstnumberx31.22" class="ltx_text ltx_font_typewriter" style="font-size:80%;">",</span><span id="lstnumberx31.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx31.24" class="ltx_text ltx_font_typewriter" style="font-size:80%;">...</span><span id="lstnumberx31.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx31.26" class="ltx_text ltx_font_typewriter" style="font-size:80%;">}</span>
