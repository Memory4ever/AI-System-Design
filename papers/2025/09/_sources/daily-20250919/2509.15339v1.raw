<tr id="S3.T2.6.1.5" class="ltx_tr">
<td id="S3.T2.6.1.5.1" class="ltx_td ltx_align_left">AQE<sub id="S3.T2.6.1.5.1.1" class="ltx_sub"><span id="S3.T2.6.1.5.1.1.1" class="ltx_text ltx_font_italic">acc</span></sub></td>
