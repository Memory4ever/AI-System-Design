<tr id="A5.T9.7.1.6" class="ltx_tr">
<td id="A5.T9.7.1.6.1" class="ltx_td ltx_align_center ltx_border_bb">AQE<sub id="A5.T9.7.1.6.1.1" class="ltx_sub"><span id="A5.T9.7.1.6.1.1.1" class="ltx_text ltx_font_italic">auc</span></sub></td>
