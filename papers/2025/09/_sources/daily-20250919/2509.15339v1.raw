<td id="S5.T4.st1.7.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.st1.m1" class="ltx_Math" alttext="\mathcal{A}(\phi(s_{M}))" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>M</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}(\phi(s_{M}))</annotation></semantics></math></td>
<td id="S5.T4.st1.7.1.3.4" class="ltx_td ltx_align_center ltx_border_t">auroc</td>
<td id="S5.T4.st1.7.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.st1.m2" class="ltx_Math" alttext="\mathcal{A}(\phi(s_{M}))" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>M</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}(\phi(s_{M}))</annotation></semantics></math></td>
<td id="S5.T4.st1.7.1.3.6" class="ltx_td ltx_align_center ltx_border_t">auroc</td>
<td id="S5.T4.st1.7.1.3.7" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.st1.m3" class="ltx_Math" alttext="\mathcal{A}(\phi(s_{M}))" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>M</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}(\phi(s_{M}))</annotation></semantics></math></td>
<td id="S5.T4.st1.7.1.3.8" class="ltx_td ltx_align_center ltx_border_t">auroc</td>
