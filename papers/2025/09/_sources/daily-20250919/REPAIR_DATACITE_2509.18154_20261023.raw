qing","familyName":"Ruan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Luoyuan","nameType":"Personal","givenName":"Luoyuan","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Hanyu","nameType":"Personal","givenName":"Hanyu","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Jingkun","nameType":"Personal","givenName":"Jingkun","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Hongyuan","nameType":"Personal","givenName":"Hongyuan","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Qining","nameType":"Personal","givenName":"Qining","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Wenhao","nameType":"Personal","givenName":"Wenhao","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"He, Bingxiang","nameType":"Personal","givenName":"Bingxiang","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Jie","nameType":"Personal","givenName":"Jie","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Cai, Jie","nameType":"Personal","givenName":"Jie","familyName":"Cai","affiliation":[],"nameIdentifiers":[]},{"name":"Qi, Ji","nameType":"Personal","givenName":"Ji","familyName":"Qi","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Zonghao","nameType":"Personal","givenName":"Zonghao","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Chi","nameType":"Personal","givenName":"Chi","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Zeng, Guoyang","nameType":"Personal","givenName":"Guoyang","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Yuxuan","nameType":"Personal","givenName":"Yuxuan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Cui, Ganqu","nameType":"Personal","givenName":"Ganqu","familyName":"Cui","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Ning","nameType":"Personal","givenName":"Ning","familyName":"Ding","affiliation":[],"nameIdentifiers":[]},{"name":"Han, Xu","nameType":"Personal","givenName":"Xu","familyName":"Han","affiliation":[],"nameIdentifiers":[]},{"name":"Yao, Yuan","nameType":"Personal","givenName":"Yuan","familyName":"Yao","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Zhiyuan","nameType":"Personal","givenName":"Zhiyuan","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Maosong","nameType":"Personal","givenName":"Maosong","familyName":"Sun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MiniCPM-V 4.5: Cooking Efficient MLLMs via Architecture, Data, and Training Recipe"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T19:41:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-24T00:01:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Multimodal Large Language Models (MLLMs) are undergoing rapid progress and represent the frontier of AI development. However, their training and inference efficiency have emerged as a core bottleneck in making MLLMs more accessible and scalable. To address the challenges, we present MiniCPM-V 4.5, an 8B parameter model designed for high efficiency and strong performance. We introduce three core improvements in model architecture, data strategy and training method: a unified 3D-Resampler model architecture for highly compact encoding over images and videos, a unified learning paradigm for document knowledge and text recognition without heavy data engineering, and a hybrid reinforcement learning strategy for proficiency in both short and long reasoning modes. Comprehensive experimental results in OpenCompass evaluation show that MiniCPM-V 4.5 surpasses widely used proprietary models such as GPT-4o-latest, and significantly larger open-source models such as Qwen2.5-VL 72B. Notably, the strong performance is achieved with remarkable efficiency. For example, on the widely adopted VideoMME benchmark, MiniCPM-V 4.5 achieves state-of-the-art performance among models under 30B size, using just 46.7\\% GPU memory cost and 8.7\\% inference time of Qwen2.5-VL 7B.","descriptionType":"Abstract"},{"description":"Project Website: https://github.com/OpenBMB/MiniCPM-V","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.18154","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-24T01:51:34.000Z","registered":"2025-09-24T01:51:35.000Z","published":"2025","updated":"2025-09-24T01:51:35.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.18154","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}