<th id="S4.T1.2.1.17.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">DeepSeek-V3</th>
<td id="S4.T1.2.1.17.2" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#F9BEBE;">

