<div id="S4.T1.13.1.4.3.1" class="ltx_inline-block ltx_transformed_outer" style="width:9.0pt;height:10.8pt;vertical-align:-2.4pt;"><span class="ltx_transformed_inner" style="transform:translate(0.8pt,-0.9pt) scale(1.2,1.2) ;">
<p id="S4.T1.13.1.4.3.1.1" class="ltx_p"><span id="S4.T1.13.1.4.3.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></p>
