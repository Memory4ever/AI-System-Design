<tr id="S3.T2.6.1.4" class="ltx_tr">
<td id="S3.T2.6.1.4.1" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;">ConvNeXt <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx28" title="" class="ltx_ref">28</a>]</cite></td>
