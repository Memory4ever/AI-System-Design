<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Monte Carlo Sample Construction (<span id="alg2.5" class="ltx_text ltx_font_smallcaps">SampleMC</span>)</figcaption>
<div id="alg2.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algx2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
            Denoising timestep <math id="algx2.l1.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, Noisy model-free sample <math id="algx2.l1.m2" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math>, Noisy model-based sample <math id="algx2.l1.m3" class="ltx_Math" alttext="k_{i}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>i</mi></msub><annotation encoding="application/x-tex">k_{i}</annotation></semantics></math>

</div>
<div id="algx2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
            Diffusion model <math id="algx2.l2.m1" class="ltx_Math" alttext="p_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">p_{\theta}</annotation></semantics></math>, Joint forward noise schedule <math id="algx2.l2.m2" class="ltx_Math" alttext="\alpha_{i}^{y}" display="inline" intent=":literal"><semantics><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup><annotation encoding="application/x-tex">\alpha_{i}^{y}</annotation></semantics></math>

</div>
<div id="algx2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
            Sample <math id="algx2.l3.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> clean model-free samples <math id="algx2.l3.m2" class="ltx_Math" alttext="\hat{x}_{0}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{x}_{0}^{(j)}</annotation></semantics></math> from <math id="algx2.l3.m3" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> via reverse steps:

</div>
<div id="algx2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
            <span id="algx2.l4.2" class="ltx_text ltx_font_bold">for</span> <math id="algx2.l4.m1" class="ltx_Math" alttext="\tau=i" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">\tau=i</annotation></semantics></math> to <math id="algx2.l4.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> <span id="algx2.l4.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="algx2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              <math id="algx2.l5.m1" class="ltx_Math" alttext="\hat{x}_{\tau-1}^{(j)}\sim p_{\theta}(x_{\tau-1}^{(j)}\mid\hat{x}_{\tau}^{(j)})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∼</mo><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msubsup><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi>τ</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{x}_{\tau-1}^{(j)}\sim p_{\theta}(x_{\tau-1}^{(j)}\mid\hat{x}_{\tau}^{(j)})</annotation></semantics></math>, for <math id="algx2.l5.m2" class="ltx_math_unparsed" alttext="j=1\cdots N" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mn>1</mn><mo lspace="0em" rspace="0em">⋯</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">j=1\cdots N</annotation></semantics></math>

</div>
<div id="algx2.l6" class="ltx_listingline">
