0\end{bmatrix},\quad z\sim\mathcal{N}(0,I)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mi>α</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mi>x</mi></msubsup><mo>−</mo><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msubsup><mi>α</mi><mi>i</mi><mi>x</mi></msubsup></mrow></msqrt><mo lspace="0.167em" rspace="0em">​</mo><msub><mo>∇</mo><msub><mi>x</mi><mi>i</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>z</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\begin{bmatrix}\sqrt{1-\alpha_{i-1}^{x}-\sigma_{i}^{2}}\sqrt{1-\alpha_{i}^{x}}\nabla_{x_{i}}\log p_{i}(y_{i})+\sigma_{i}z\\
