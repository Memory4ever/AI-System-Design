<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbb{E}_{\hat{k}_{0}\sim q^{k}(\cdot\mid k_{i})}\left[s_{\alpha^{k}_{i}}(\hat{k}_{0}\mid k_{i})V^{k}(\hat{k}_{0})\right]}{\mathbb{E}_{\hat{k}_{0}\sim q^{k}(\cdot\mid k_{i})}\left[V^{k}(\hat{k}_{0})\right]}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mover accent="true"><mi>k</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo>∼</mo><mi>q</mi><msup><mrow></mrow><mi>k</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>k</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>s</mi><msub><mrow></mrow><msubsup><mi>α</mi><mi>i</mi><mi>k</mi></msubsup></msub><mo stretchy="false">(</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>k</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mi>V</mi><msup><mrow></mrow><mi>k</mi></msup><mo stretchy="false">(</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>]</mo></mrow><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mover accent="true"><mi>k</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo>∼</mo><mi>q</mi><msup><mrow></mrow><mi>k</mi></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>k</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>V</mi><msup><mrow></mrow><mi>k</mi></msup><mo stretchy="false">(</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>]</mo></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbb{E}_{\hat{k}_{0}\sim q^{k}(\cdot\mid k_{i})}\left[s_{\alpha^{k}_{i}}(\hat{k}_{0}\mid k_{i})V^{k}(\hat{k}_{0})\right]}{\mathbb{E}_{\hat{k}_{0}\sim q^{k}(\cdot\mid k_{i})}\left[V^{k}(\hat{k}_{0})\right]}.</annotation></semantics></math></td>
