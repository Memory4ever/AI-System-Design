\sim p^{x}_{0\mid i}(\cdot\mid x_{i})}\left[V^{x}(\hat{x}_{0})\right]}\cdot\mathbb{E}_{\hat{k}_{0}\sim q^{k}(\cdot\mid k_{i})}\left[V^{k}(\hat{k}_{0})\right]}</annotation></semantics></math></td>
