<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Additional Derivations</h2>

<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Derivation of Eq. (<a href="#S4.E4" title="Equation 4 ‣ 4.2 Monte-Carlo Joint Score Approximation ‣ 4 Method ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>)</h3>

<div id="A1.SS1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS1.p1.1" class="ltx_p">We detail the derivation of (<a href="#S4.E4" title="Equation 4 ‣ 4.2 Monte-Carlo Joint Score Approximation ‣ 4 Method ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), which expresses the joint score function prior to applying importance sampling.</p>
<table id="A1.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E8.m1" class="ltx_Math" alttext="\displaystyle\nabla_{y_{i}}\log p_{i}(y_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>y</mi><mi>i</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{y_{i}}\log p_{i}(y_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E8.m2" class="ltx_Math" alttext="\displaystyle=\frac{\nabla_{y_{i}}p_{i}(y_{i})}{p_{i}(y_{i})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mo>∇</mo><msub><mi>y</mi><mi>i</mi></msub></msub><msub><mi>p</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\nabla_{y_{i}}p_{i}(y_{i})}{p_{i}(y_{i})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
<tbody id="A1.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E9.m1" class="ltx_Math" alttext="\displaystyle=\frac{\nabla_{y_{i}}\int p_{\alpha^{y}_{i}}(y_{i}|y_{0})p_{0}(y_{0})\,dy_{0}}{p_{i}(y_{i})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∇</mo><msub><mrow></mrow><msub><mi>y</mi><mi>i</mi></msub></msub><mo>∫</mo><mi>p</mi><msub><mrow></mrow><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup></msub><mo stretchy="false">(</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>y</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mi>p</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mi>y</mi><msub><mrow></mrow><mn>0</mn></msub><mo rspace="0.170em" stretchy="false">)</mo><mi>d</mi><mi>y</mi><msub><mrow></mrow><mn>0</mn></msub></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\nabla_{y_{i}}\int p_{\alpha^{y}_{i}}(y_{i}|y_{0})p_{0}(y_{0})\,dy_{0}}{p_{i}(y_{i})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
<tbody id="A1.E10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E10.m1" class="ltx_Math" alttext="\displaystyle=\frac{\int\nabla_{y_{i}}\log p_{\alpha^{y}_{i}}(y_{i}|y_{0})p_{\alpha^{y}_{i}}(y_{i}|y_{0})p_{0}(y_{0})\,dy_{0}}{p_{i}(y_{i})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>∫</mo><mrow><msub><mo>∇</mo><msub><mi>y</mi><mi>i</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>0</mn></msub></mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\int\nabla_{y_{i}}\log p_{\alpha^{y}_{i}}(y_{i}|y_{0})p_{\alpha^{y}_{i}}(y_{i}|y_{0})p_{0}(y_{0})\,dy_{0}}{p_{i}(y_{i})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
<tbody id="A1.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E11.m1" class="ltx_Math" alttext="\displaystyle=\int\nabla_{y_{i}}\log p_{\alpha^{y}_{i}}(y_{i}|y_{0})\,p_{0|i}(y_{0}|y_{i})\,dy_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mo>∇</mo><msub><mi>y</mi><mi>i</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>0</mn></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int\nabla_{y_{i}}\log p_{\alpha^{y}_{i}}(y_{i}|y_{0})\,p_{0|i}(y_{0}|y_{i})\,dy_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
<tbody id="A1.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E12.m1" class="ltx_Math" alttext="\displaystyle=\int s_{\alpha^{y}_{i}}(y_{0}|y_{i})\,p_{0|i}(y_{0}|y_{i})\,dy_{0}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>s</mi><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>y</mi><mn>0</mn></msub></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\int s_{\alpha^{y}_{i}}(y_{0}|y_{i})\,p_{0|i}(y_{0}|y_{i})\,dy_{0}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="A1.SS1.p1.2" class="ltx_p">We first marginalize the forward perturbation kernel from (<a href="#A1.E8" title="Equation 8 ‣ A.1 Derivation of Eq. () ‣ Appendix A Additional Derivations ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>) to (<a href="#A1.E9" title="Equation 9 ‣ A.1 Derivation of Eq. () ‣ Appendix A Additional Derivations ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), then apply the log-derivative trick from (<a href="#A1.E9" title="Equation 9 ‣ A.1 Derivation of Eq. () ‣ Appendix A Additional Derivations ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) to (<a href="#A1.E10" title="Equation 10 ‣ A.1 Derivation of Eq. () ‣ Appendix A Additional Derivations ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>). Using Bayes’ rule, we obtain (<a href="#A1.E11" title="Equation 11 ‣ A.1 Derivation of Eq. () ‣ Appendix A Additional Derivations ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>), and finally substitute the score term with the predefined Tweedie score <math id="A1.SS1.p1.m1" class="ltx_Math" alttext="s_{\alpha^{y}_{i}}(y_{0}|y_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s_{\alpha^{y}_{i}}(y_{0}|y_{i})</annotation></semantics></math> in (<a href="#A1.E12" title="Equation 12 ‣ A.1 Derivation of Eq. () ‣ Appendix A Additional Derivations ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>).
Here, <math id="A1.SS1.p1.m2" class="ltx_Math" alttext="p_{0|i}(y_{0}|y_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{0|i}(y_{0}|y_{i})</annotation></semantics></math> is the target distribution for sampling, but it is intractable—motivating the use of importance sampling.</p>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.2 </span>Proof of <a href="#Thmdefn2" title="Theorem 2. ‣ 4.2 Monte-Carlo Joint Score Approximation ‣ 4 Method ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2</span></a></h3>

<div id="A1.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS2.p1" class="ltx_para">
<p id="A1.SS2.p1.1" class="ltx_p"><span id="A1.SS2.p1.1.1" class="ltx_text">It is sufficient to show that importance weight
<math id="A1.SS2.p1.m1" class="ltx_Math" alttext="\frac{p_{0|i}(y_{0}|y_{i})}{q(y_{0}|y_{i})}" display="inline" intent=":literal"><semantics><mfrac><mrow><msub><mi>p</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{p_{0|i}(y_{0}|y_{i})}{q(y_{0}|y_{i})}</annotation></semantics></math> becomes proportional to <math id="A1.SS2.p1.m2" class="ltx_Math" alttext="V(x_{0},k_{0})p^{k}_{0}(k_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mn>0</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V(x_{0},k_{0})p^{k}_{0}(k_{0})</annotation></semantics></math> under the proposal distribution <math id="A1.SS2.p1.m3" class="ltx_Math" alttext="q(y_{0}|y_{i})" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(y_{0}|y_{i})</annotation></semantics></math> given in (<a href="#S4.E6" title="Equation 6 ‣ 4.2 Monte-Carlo Joint Score Approximation ‣ 4 Method ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>). Since we use a self-normalized importance sampling scheme, any term independent of <math id="A1.SS2.p1.m4" class="ltx_Math" alttext="y_{0}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mn>0</mn></msub><annotation encoding="application/x-tex">y_{0}</annotation></semantics></math> cancels out.
Hence we show:</span></p>
<table id="A1.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex6.m1" class="ltx_Math" alttext="\displaystyle\frac{p_{0|i}(y_{0}\mid y_{i})}{q(y_{0}\mid y_{i})}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{p_{0|i}(y_{0}\mid y_{i})}{q(y_{0}\mid y_{i})}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex6.m2" class="ltx_Math" alttext="\displaystyle=\frac{p_{0|i}(y_{0}\mid y_{i})}{p^{x}_{0|i}(x_{0}\mid x_{i})q^{k}(k_{0}\mid k_{i})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>p</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>i</mi></mrow><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{p_{0|i}(y_{0}\mid y_{i})}{p^{x}_{0|i}(x_{0}\mid x_{i})q^{k}(k_{0}\mid k_{i})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\displaystyle=\frac{p_{\alpha^{y}_{i}}(y_{i}\mid y_{0})p_{0}(y_{0})}{p_{i}(y_{i})}\cdot\frac{p^{x}_{i}(x_{i})}{p^{x}_{\alpha^{x}_{i}}(x_{i}\mid x_{0})p^{x}_{0}(x_{0})q^{k}(k_{0}\mid k_{i})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>y</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>p</mi><mi>i</mi><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>p</mi><msubsup><mi>α</mi><mi>i</mi><mi>x</mi></msubsup><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mn>0</mn><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{p_{\alpha^{y}_{i}}(y_{i}\mid y_{0})p_{0}(y_{0})}{p_{i}(y_{i})}\cdot\frac{p^{x}_{i}(x_{i})}{p^{x}_{\alpha^{x}_{i}}(x_{i}\mid x_{0})p^{x}_{0}(x_{0})q^{k}(k_{0}\mid k_{i})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex8.m1" class="ltx_Math" alttext="\displaystyle=\frac{p^{x}_{i}(x_{i})}{p_{i}(y_{i})}\cdot\frac{p_{\alpha^{y}_{i}}(y_{i}\mid y_{0})}{p^{x}_{\alpha^{x}_{i}}(x_{i}\mid x_{0})q^{k}(k_{0}\mid k_{i})}\cdot\frac{p_{0}(y_{0})}{p_{0}^{x}(x_{0})}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>p</mi><mi>i</mi><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>y</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>p</mi><msubsup><mi>α</mi><mi>i</mi><mi>x</mi></msubsup><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>p</mi><mn>0</mn><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{p^{x}_{i}(x_{i})}{p_{i}(y_{i})}\cdot\frac{p_{\alpha^{y}_{i}}(y_{i}\mid y_{0})}{p^{x}_{\alpha^{x}_{i}}(x_{i}\mid x_{0})q^{k}(k_{0}\mid k_{i})}\cdot\frac{p_{0}(y_{0})}{p_{0}^{x}(x_{0})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex9.m1" class="ltx_Math" alttext="\displaystyle=\frac{p^{x}_{i}(x_{i})}{p_{i}(y_{i})}\cdot\frac{\cancel{p^{x}_{\alpha^{y}_{i}}(x_{i}\mid x_{0})}p^{k}_{\alpha^{k}_{i}}(k_{i}\mid k_{0})}{\cancel{p^{x}_{\alpha^{x}_{i}}(x_{i}\mid x_{0})}q^{k}(k_{0}\mid k_{i})}\cdot\frac{\cancel{p_{0}^{x}(x_{0})}p^{k}_{0}(k_{0})V(x_{0},k_{0})}{\cancel{p_{0}^{x}(x_{0})}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>p</mi><mi>i</mi><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><menclose notation="updiagonalstrike"><mrow><msubsup><mi>p</mi><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></menclose><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><msubsup><mi>α</mi><mi>i</mi><mi>k</mi></msubsup><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><menclose notation="updiagonalstrike"><mrow><msubsup><mi>p</mi><msubsup><mi>α</mi><mi>i</mi><mi>x</mi></msubsup><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></menclose><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><menclose notation="updiagonalstrike"><mrow><msubsup><mi>p</mi><mn>0</mn><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></menclose><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>p</mi><mn>0</mn><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><menclose notation="updiagonalstrike"><mrow><msubsup><mi>p</mi><mn>0</mn><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></menclose></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{p^{x}_{i}(x_{i})}{p_{i}(y_{i})}\cdot\frac{\cancel{p^{x}_{\alpha^{y}_{i}}(x_{i}\mid x_{0})}p^{k}_{\alpha^{k}_{i}}(k_{i}\mid k_{0})}{\cancel{p^{x}_{\alpha^{x}_{i}}(x_{i}\mid x_{0})}q^{k}(k_{0}\mid k_{i})}\cdot\frac{\cancel{p_{0}^{x}(x_{0})}p^{k}_{0}(k_{0})V(x_{0},k_{0})}{\cancel{p_{0}^{x}(x_{0})}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex10.m1" class="ltx_Math" alttext="\displaystyle=Z(y_{i},i)\cdot p_{0}^{k}(k_{0})V(x_{0},k_{0})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>,</mo><mi>i</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msubsup><mi>p</mi><mn>0</mn><mi>k</mi></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=Z(y_{i},i)\cdot p_{0}^{k}(k_{0})V(x_{0},k_{0})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS2.p1.2" class="ltx_p"><span id="A1.SS2.p1.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Proof of <a href="#Thmdefn3" title="Corollary 3. ‣ 4.3 Special Cases: Conditional Generation and Model-Based Diffusion ‣ 4 Method ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">3</span></a></h3>

<div id="A1.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A1.SS3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.p1.1" class="ltx_p"><span id="A1.SS3.p1.1.1" class="ltx_text">From <a href="#Thmdefn2" title="Theorem 2. ‣ 4.2 Monte-Carlo Joint Score Approximation ‣ 4 Method ‣ Joint Model-based Model-free Diffusion for Planning with Constraints" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">2</span></a>, we represent the joint score as</span></p>
<table id="A1.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex11.m1" class="ltx_Math" alttext="\displaystyle\nabla_{y_{i}}\log p_{i}(y_{i})=\frac{\mathbb{E}_{\hat{y}_{0}\sim q(\cdot\mid y_{i})}\left[s_{\alpha^{y}_{i}}(\hat{y}_{0}\mid y_{i})V(\hat{x}_{0},\hat{k}_{0})p^{k}_{0}(\hat{k}_{0})\right]}{\mathbb{E}_{\hat{y}_{0}\sim q(\cdot\mid y_{i})}\left[V(\hat{x}_{0},\hat{k}_{0})p^{k}_{0}(\hat{k}_{0})\right]}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><msub><mi>y</mi><mi>i</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mover accent="true"><mi>y</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>s</mi><msub><mrow></mrow><msubsup><mi>α</mi><mi>i</mi><mi>y</mi></msubsup></msub><mo stretchy="false">(</mo><mover accent="true"><mi>y</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mi>V</mi><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mi>p</mi><msup><mrow></mrow><mi>k</mi></msup><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>]</mo></mrow><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mover accent="true"><mi>y</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo>∼</mo><mi>q</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>y</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>V</mi><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo>,</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mi>p</mi><msup><mrow></mrow><mi>k</mi></msup><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mover accent="true"><mi>k</mi><mo>^</mo></mover><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mo>]</mo></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{y_{i}}\log p_{i}(y_{i})=\frac{\mathbb{E}_{\hat{y}_{0}\sim q(\cdot\mid y_{i})}\left[s_{\alpha^{y}_{i}}(\hat{y}_{0}\mid y_{i})V(\hat{x}_{0},\hat{k}_{0})p^{k}_{0}(\hat{k}_{0})\right]}{\mathbb{E}_{\hat{y}_{0}\sim q(\cdot\mid y_{i})}\left[V(\hat{x}_{0},\hat{k}_{0})p^{k}_{0}(\hat{k}_{0})\right]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p2" class="ltx_para ltx_noindent">
<p id="A1.SS3.p2.1" class="ltx_p"><span id="A1.SS3.p2.1.1" class="ltx_text">Since the proposal distribution factorizes as</span></p>
<table id="A1.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex12.m1" class="ltx_Math" alttext="q(y_{0}\mid y_{i})=p^{x}_{0\mid i}(x_{0}\mid x_{i})\cdot q^{k}(k_{0}\mid k_{i})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msubsup><mi>p</mi><mrow><mn>0</mn><mo fence="false">|</mo><mi>i</mi></mrow><mi>x</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>x</mi><mi>i</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>q</mi><mi>k</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>k</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q(y_{0}\mid y_{i})=p^{x}_{0\mid i}(x_{0}\mid x_{i})\cdot q^{k}(k_{0}\mid k_{i}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p2.2" class="ltx_p"><span id="A1.SS3.p2.2.1" class="ltx_text">and the interaction potential also factorizes as</span></p>
<table id="A1.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex13.m1" class="ltx_Math" alttext="V(x_{0},k_{0})=V^{x}(x_{0})\cdot V^{k}(k_{0})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><msup><mi>V</mi><mi>x</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><msup><mi>V</mi><mi>k</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>k</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">V(x_{0},k_{0})=V^{x}(x_{0})\cdot V^{k}(k_{0}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS3.p2.3" class="ltx_p"><span id="A1.SS3.p2.3.1" class="ltx_text">we can decompose the joint score into separate expectations.</span></p>
</div>
</div>
<section id="A1.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Score with respect to <math id="A1.SS3.SSS0.Px1.m1" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math>:</h5>

<div id="A1.SS3.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<table id="A1.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex14.m1" class="ltx_Math" alttext="\displaystyle\nabla_{x_{i}}\log p_{i}(y_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><msub><mi>x</mi><mi>i</mi></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{x_{i}}\log p_{i}(y_{i})</annotation></semantics></math></td>
