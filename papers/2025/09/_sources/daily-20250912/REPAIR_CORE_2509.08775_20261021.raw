<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex3.m1" class="ltx_Math" alttext="\displaystyle y_{i-1}\leftarrow\ " display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo rspace="0.778em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle y_{i-1}\leftarrow\ </annotation></semantics></math></td>
