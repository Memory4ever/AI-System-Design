</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F13.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.08803v1/dk_prompt3.svg" id="S6.F13.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/282;" width="476" height="282"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S6.F13.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S6.F13.sf3.4" class="ltx_text" style="font-size:90%;">Prompt 3</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F13.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.08803v1/dk_prompt4.svg" id="S6.F13.sf4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/282;" width="476" height="282"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S6.F13.sf4.3" class="ltx_text" style="font-size:90%;">(d)</span> </span><span id="S6.F13.sf4.4" class="ltx_text" style="font-size:90%;">Prompt 4</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S6.F13.3" class="ltx_text" style="font-size:90%;">Figure 13</span>: </span><span id="S6.F13.4" class="ltx_text" style="font-size:90%;">Quartile performance analysis on each individual prompt also displays the Dunning-Kruger effect pattern where less capable models show high confidence but low selective accuracy, and more capable models show lower confidence but higher selective accuracy.</span></figcaption>
</figure>
<figure id="S6.F14" class="ltx_figure"><img src="2509.08803v1/figures/generalization_heatmap.png" id="S6.F14.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/193;" width="476" height="193" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S6.F14.3" class="ltx_text" style="font-size:90%;">Figure 14</span>: </span><span id="S6.F14.4" class="ltx_text" style="font-size:90%;">Performance of LLMs across claims dated pre and post their training period.</span></figcaption>
</figure>
<div class="ltx_pagination ltx_role_newpage"></div>
<figure id="S6.F15" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="S6.F15.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.08803v1/dk_post_cutoff.svg" id="S6.F15.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/282;" width="476" height="282"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S6.F15.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span></figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="S6.F15.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.08803v1/dk_post_cutoff_mmlu.svg" id="S6.F15.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/282;" width="476" height="282"></object>
