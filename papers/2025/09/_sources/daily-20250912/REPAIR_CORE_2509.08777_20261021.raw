</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A5.F6.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.08777v1/images/qualitative/10_3x10.png" id="A5.F6.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:685/213;" width="685" height="213" alt="Refer to caption">
