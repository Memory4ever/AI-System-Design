<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A3.Ex12.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex12.m2" class="ltx_math_unparsed" alttext="\displaystyle\left[\sum_{z}p(z|x)\sum_{a}q(a|z)\log p(y|x,a)\right]-\left[\sum_{z}p(z|x)KL(q(a|z)||p(a|z))\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>[</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>z</mi></munder></mstyle><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>log</mi><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mrow><mo>[</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>z</mi></munder></mstyle><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mi>K</mi><mi>L</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left[\sum_{z}p(z|x)\sum_{a}q(a|z)\log p(y|x,a)\right]-\left[\sum_{z}p(z|x)KL(q(a|z)||p(a|z))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A3.Ex13.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex13.m2" class="ltx_math_unparsed" alttext="\displaystyle\sum_{z}p(z|x)\left[\left[\sum_{a}q(a|z)\log p(y|x,a)\right]-KL\left(q(a|z)||p(a|z)\right)\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>z</mi></munder></mstyle><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mo>[</mo><mrow><mo>[</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><mi>log</mi><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi>K</mi><mi>L</mi><mrow><mo>(</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{z}p(z|x)\left[\left[\sum_{a}q(a|z)\log p(y|x,a)\right]-KL\left(q(a|z)||p(a|z)\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p2" class="ltx_para ltx_noindent">
<p id="A3.p2.1" class="ltx_p">Assuming uniform priors for <math id="A3.p2.m1" class="ltx_Math" alttext="p(a{\mid}z)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(a{\mid}z)</annotation></semantics></math> and parameterizing <math id="A3.p2.m2" class="ltx_Math" alttext="q(a|z)=w_{za}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo lspace="0em" rspace="0em">|</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>w</mi><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub></mrow><annotation encoding="application/x-tex">q(a|z)=w_{za}</annotation></semantics></math>, we can write the training objective for <span id="A3.p2.1.1" class="ltx_text ltx_font_bold">M</span>ultimodal <span id="A3.p2.1.2" class="ltx_text ltx_font_bold">M</span>ixture-of-<span id="A3.p2.1.3" class="ltx_text ltx_font_bold">B</span>ayesian Prompt Ensembles to maximize this lower-bound on the log-likelihood of all <math id="A3.p2.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> datapoints in <math id="A3.p2.m4" class="ltx_Math" alttext="\mathcal{D}_{val}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{D}_{val}</annotation></semantics></math> as:</p>
<table id="A3.EGx11" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A3.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E11.m1" class="ltx_math_unparsed" alttext="\displaystyle\operatorname*{arg\,max}_{\bf w}\sum_{j=1}^{M}\sum_{z}p(z|x_{j})\left[\sum_{a}w_{za}\log p(y_{j}^{*}|x_{j},a)-\sum_{a}w_{za}\log w_{za}~~\right]" display="inline" intent=":literal"><semantics><mrow><munder><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mi>𝐰</mi></munder><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>z</mi></munder></mstyle><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>[</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><msub><mi>w</mi><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mi>log</mi><mi>p</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>y</mi><mi>j</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><msub><mi>x</mi><mi>j</mi></msub><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>a</mi></munder></mstyle><msub><mi>w</mi><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mi>log</mi><msub><mi>w</mi><mrow><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\operatorname*{arg\,max}_{\bf w}\sum_{j=1}^{M}\sum_{z}p(z|x_{j})\left[\sum_{a}w_{za}\log p(y_{j}^{*}|x_{j},a)-\sum_{a}w_{za}\log w_{za}~~\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div>
