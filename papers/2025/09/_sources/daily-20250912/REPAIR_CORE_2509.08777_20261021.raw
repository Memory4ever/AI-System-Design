<td id="A1.T5.3.18.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A1.T5.3.18.1.1" class="ltx_text" style="font-size:80%;">Weights</span></td>
