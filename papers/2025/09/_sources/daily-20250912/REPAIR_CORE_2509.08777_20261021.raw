<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Additional Qualitative Examples</h2>

<figure id="A5.F6" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A5.F6.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.08777v1/images/qualitative/1_3x10.png" id="A5.F6.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:685/213;" width="685" height="213" alt="Refer to caption">
