<table id="S4.T4.6" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T4.6.1" class="ltx_tr">
<th id="S4.T4.6.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S4.T4.6.1.1.1" class="ltx_text ltx_font_bold">Architecture</span></th>
<th id="S4.T4.6.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.6.1.2.1" class="ltx_text ltx_font_bold">mAP</span> <math id="S4.T4.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S4.T4.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.6.1.3.1" class="ltx_text ltx_font_bold">AR<sub id="S4.T4.6.1.3.1.1" class="ltx_sub">0</sub></span> <math id="S4.T4.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S4.T4.6.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.6.1.4.1" class="ltx_text ltx_font_bold">AR<sub id="S4.T4.6.1.4.1.1" class="ltx_sub">1</sub></span> <math id="S4.T4.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S4.T4.6.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.6.1.5.1" class="ltx_text ltx_font_bold">AR<sub id="S4.T4.6.1.5.1.1" class="ltx_sub">2</sub></span> <math id="S4.T4.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T4.6.2" class="ltx_tr">
<th id="S4.T4.6.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S4.T4.6.2.1.1" class="ltx_text ltx_font_bold">DS</span> <math id="S4.T4.m5" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> SA <math id="S4.T4.m6" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> D <math id="S4.T4.m7" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> SA <math id="S4.T4.m8" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> V</th>
<td id="S4.T4.6.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T4.6.2.2.1" class="ltx_text ltx_font_bold">52.7</span></td>
<td id="S4.T4.6.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T4.6.2.3.1" class="ltx_text ltx_font_bold">74.4</span></td>
<td id="S4.T4.6.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T4.6.2.4.1" class="ltx_text ltx_font_bold">65.7</span></td>
<td id="S4.T4.6.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T4.6.2.5.1" class="ltx_text ltx_font_bold">57.6</span></td></tr>
<tr id="S4.T4.6.3" class="ltx_tr">
<th id="S4.T4.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">D <math id="S4.T4.m9" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> SA <math id="S4.T4.m10" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> <span id="S4.T4.6.3.1.1" class="ltx_text ltx_font_bold">DS</span> <math id="S4.T4.m11" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> SA <math id="S4.T4.m12" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> V</th>
<td id="S4.T4.6.3.2" class="ltx_td ltx_align_center ltx_border_bb">51.4</td>
<td id="S4.T4.6.3.3" class="ltx_td ltx_align_center ltx_border_bb">73.5</td>
<td id="S4.T4.6.3.4" class="ltx_td ltx_align_center ltx_border_bb">64.4</td>
