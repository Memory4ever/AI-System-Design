<td id="Sx3.T1.3.1.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx3.T1.3.1.1.2.1" class="ltx_text ltx_font_bold">Agent Acc. (%)</span></td>
<td id="Sx3.T1.3.1.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx3.T1.3.1.1.3.1" class="ltx_text ltx_font_bold">Step Acc. (%)</span></td></tr>
