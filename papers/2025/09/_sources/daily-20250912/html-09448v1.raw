<td id="S2.T1.2.1.20.8" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6F0FA;"><span id="S2.T1.2.1.20.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F0FA;">0.3459</span></td>
<td id="S2.T1.2.1.20.9" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6F0FA;"><span id="S2.T1.2.1.20.9.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F0FA;">0.5774</span></td></tr>
