<td id="S2.T1.2.1.20.2" class="ltx_td ltx_border_bb"></td>
<td id="S2.T1.2.1.20.3" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6F0FA;"><span id="S2.T1.2.1.20.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F0FA;">0.4375</span></td>
<td id="S2.T1.2.1.20.4" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6F0FA;"><span id="S2.T1.2.1.20.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F0FA;">0.7925</span></td>
<td id="S2.T1.2.1.20.5" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6F0FA;"><span id="S2.T1.2.1.20.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F0FA;">0.5906</span></td>
<td id="S2.T1.2.1.20.6" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6F0FA;"><span id="S2.T1.2.1.20.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6F0FA;">0.7437</span></td>
