</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS9.SSS1.Px2.p19" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS9.SSS1.Px2.p19.pic1" class="ltx_picture" height="50.87" overflow="visible" version="1.1" viewBox="0 0 429.64 50.87" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,50.87) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 46.24 C 0 48.8 2.07 50.87 4.63 50.87 L 425.01 50.87 C 427.56 50.87 429.64 48.8 429.64 46.24 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 32 L 428.94 32 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 36.63)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
