</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS2.Px1.p10.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS11.SSS2.Px1.p10.pic1.2.1" class="ltx_p"><span id="A2.SS11.SSS2.Px1.p10.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">0/2</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS11.SSS2.Px1.p11" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS11.SSS2.Px1.p11.pic1" class="ltx_picture" height="87.46" overflow="visible" version="1.1" viewBox="0 0 429.64 87.46" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,87.46) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 82.83 C 0 85.39 2.07 87.46 4.63 87.46 L 425.01 87.46 C 427.56 87.46 429.64 85.39 429.64 82.83 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 68.59 L 428.94 68.59 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 73.22)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS2.Px1.p11.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS11.SSS2.Px1.p11.pic1.1.1" class="ltx_p"><span id="A2.SS11.SSS2.Px1.p11.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:3em;--ltx-fo-depth:0.2em;font-size:10pt;" height="44.28" overflow="visible" transform="matrix(1 0 0 -1 0 41.51)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS2.Px1.p11.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS11.SSS2.Px1.p11.pic1.2.1" class="ltx_p"><span id="A2.SS11.SSS2.Px1.p11.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">It is not even clear that the claimed generalization in (i) is well-defined if the fiber bundle is not trivialized. Similarly, the claimed generalization in (ii) does not make sense.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="A2.SS11.SSS2.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#FF0000;">Problem 11b2 </h5>

<div id="A2.SS11.SSS2.Px2.p1" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p1.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS11.SSS2.Px2.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS11.SSS2.Px2.p2.pic1" class="ltx_picture" height="199.33" overflow="visible" version="1.1" viewBox="0 0 429.64 199.33" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,199.33) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 194.7 C 0 197.26 2.07 199.33 4.63 199.33 L 425.01 199.33 C 427.56 199.33 429.64 197.26 429.64 194.7 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 180.46 L 428.94 180.46 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 185.09)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS2.Px2.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS11.SSS2.Px2.p2.pic1.1.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:11.13em;--ltx-fo-depth:0.16em;font-size:10pt;" height="156.15" overflow="visible" transform="matrix(1 0 0 -1 0 154)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS2.Px2.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS11.SSS2.Px2.p2.pic1.2.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">A clock is built based on the following repeating sequence <math id="A2.SS11.SSS2.Px2.p2.pic1.m1" class="ltx_Math" alttext="1,2,3,4,3,2,1,2,3,4,3,2,\dots" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">1,2,3,4,3,2,1,2,3,4,3,2,\dots</annotation></semantics></math>. At the first
hour it strikes 1 time. At the second hour it strikes 2 times. At the third hour it strikes 3 times. At
the fourth hour it strikes 4 times. At the fifth hour it strikes 3+2 times. At the sixth hour it strikes
1+2+3 times. Etc. Explain what is going on, develop the theory that explains why it works, and
then suggest some generalizations.</span></span><span class="ltx_inline-block"><svg id="A2.SS11.SSS2.Px2.p2.pic1.pic1" class="ltx_picture" color="#FF0000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 0 L 15.75 15.75 M 0 15.75 L 15.75 0"></path></g></svg></span>
<span id="A2.SS11.SSS2.Px2.p2.pic1.2.2" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;">GPT-5 thinking failed</span></span>
<span id="A2.SS11.SSS2.Px2.p2.pic1.2.3" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p2.pic1.2.3.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Tahsin Saffat</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS11.SSS2.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS11.SSS2.Px2.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS11.SSS2.Px2.p3" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p3.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p3.1.1" class="ltx_text">Here’s a clean way to see what that clock is doing and why it never gets “stuck.”</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p4" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p4.1" class="ltx_p"><math id="A2.SS11.SSS2.Px2.p4.m1" class="ltx_Math" alttext="\#\#" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi></mrow><annotation encoding="application/x-tex">\#\#</annotation></semantics></math><span id="A2.SS11.SSS2.Px2.p4.1.1" class="ltx_text"> What the clock is actually doing</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p5" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p5.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p5.1.1" class="ltx_text">Write the infinite periodic word</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p6" class="ltx_para">
<table id="A2.Ex331" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex331.m1" class="ltx_Math" alttext="p=\overline{1,2,3,4,3,2}" display="block" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mover accent="true"><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="true">¯</mo></mover></mrow><annotation encoding="application/x-tex">p=\overline{1,2,3,4,3,2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p7" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p7.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p7.1.1" class="ltx_text">and let <math id="A2.SS11.SSS2.Px2.p7.m1" class="ltx_Math" alttext="a_{1},a_{2},a_{3},\dots" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>2</mn></msub><mo>,</mo><msub><mi>a</mi><mn>3</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">a_{1},a_{2},a_{3},\dots</annotation></semantics></math> be the entries of <math id="A2.SS11.SSS2.Px2.p7.m2" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>. Define the running sums</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p8" class="ltx_para">
<table id="A2.Ex332" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex332.m1" class="ltx_Math" alttext="S_{n}=\sum_{i=1}^{n}a_{i}\qquad(n\geq 1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>S</mi><mi>n</mi></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi>a</mi><mi>i</mi></msub></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>≥</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{n}=\sum_{i=1}^{n}a_{i}\qquad(n\geq 1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p9" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p9.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p9.1.1" class="ltx_text">Now **cut this infinite word into consecutive blocks** so that the <math id="A2.SS11.SSS2.Px2.p9.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th block has total <math id="A2.SS11.SSS2.Px2.p9.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. In other words, choose cut points</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p10" class="ltx_para">
<table id="A2.Ex333" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex333.m1" class="ltx_Math" alttext="0=n_{0}&lt;n_{1}&lt;n_{2}&lt;\dots" display="block" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msub><mi>n</mi><mn>0</mn></msub><mo>&lt;</mo><msub><mi>n</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>n</mi><mn>2</mn></msub><mo>&lt;</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">0=n_{0}&lt;n_{1}&lt;n_{2}&lt;\dots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p11" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p11.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p11.1.1" class="ltx_text">with</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p12" class="ltx_para">
<table id="A2.Ex334" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex334.m1" class="ltx_Math" alttext="\sum_{i=n_{k-1}+1}^{n_{k}}a_{i}=k." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mrow><msub><mi>n</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><mn>1</mn></mrow></mrow><msub><mi>n</mi><mi>k</mi></msub></munderover><msub><mi>a</mi><mi>i</mi></msub></mrow><mo>=</mo><mi>k</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{i=n_{k-1}+1}^{n_{k}}a_{i}=k.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p13" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p13.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p13.1.1" class="ltx_text">The <math id="A2.SS11.SSS2.Px2.p13.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th hour simply plays the entries in the <math id="A2.SS11.SSS2.Px2.p13.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th block. That’s why the first hours look like</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p14" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p14.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p14.1.1" class="ltx_text">* 1: <math id="A2.SS11.SSS2.Px2.p14.m1" class="ltx_Math" alttext="[1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1]</annotation></semantics></math>
* 2: <math id="A2.SS11.SSS2.Px2.p14.m2" class="ltx_Math" alttext="[2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[2]</annotation></semantics></math>
* 3: <math id="A2.SS11.SSS2.Px2.p14.m3" class="ltx_Math" alttext="[3]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[3]</annotation></semantics></math>
* 4: <math id="A2.SS11.SSS2.Px2.p14.m4" class="ltx_Math" alttext="[4]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>4</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[4]</annotation></semantics></math>
* 5: <math id="A2.SS11.SSS2.Px2.p14.m5" class="ltx_Math" alttext="[3,2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>3</mn><mo>,</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[3,2]</annotation></semantics></math>
* 6: <math id="A2.SS11.SSS2.Px2.p14.m6" class="ltx_Math" alttext="[1,2,3]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1,2,3]</annotation></semantics></math>
* 7: <math id="A2.SS11.SSS2.Px2.p14.m7" class="ltx_Math" alttext="[4,3]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>4</mn><mo>,</mo><mn>3</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[4,3]</annotation></semantics></math>
* 8: <math id="A2.SS11.SSS2.Px2.p14.m8" class="ltx_Math" alttext="[2,1,2,3]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>2</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[2,1,2,3]</annotation></semantics></math>
* 9: <math id="A2.SS11.SSS2.Px2.p14.m9" class="ltx_Math" alttext="[4,3,2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>4</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[4,3,2]</annotation></semantics></math>
* 10: <math id="A2.SS11.SSS2.Px2.p14.m10" class="ltx_Math" alttext="[1,2,3,4]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1,2,3,4]</annotation></semantics></math>
* 11: <math id="A2.SS11.SSS2.Px2.p14.m11" class="ltx_Math" alttext="[3,2,1,2,3]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>3</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[3,2,1,2,3]</annotation></semantics></math>
* 12: <math id="A2.SS11.SSS2.Px2.p14.m12" class="ltx_Math" alttext="[4,3,2,1,2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>4</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[4,3,2,1,2]</annotation></semantics></math>,</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p15" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p15.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p15.1.1" class="ltx_text">etc.</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p16" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p16.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p16.1.1" class="ltx_text">Equivalently,</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p17" class="ltx_para">
<table id="A2.Ex335" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex335.m1" class="ltx_Math" alttext="S_{n_{k}}=\frac{k(k+1)}{2}\quad\text{(the $k$-th triangular number).}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><msub><mi>n</mi><mi>k</mi></msub></msub><mo>=</mo><mfrac><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>(the </mtext><mi>k</mi><mtext>-th triangular number).</mtext></mrow></mrow><annotation encoding="application/x-tex">S_{n_{k}}=\frac{k(k+1)}{2}\quad\text{(the $k$-th triangular number).}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p18" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p18.1" class="ltx_p"><math id="A2.SS11.SSS2.Px2.p18.m1" class="ltx_Math" alttext="\#\#" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi></mrow><annotation encoding="application/x-tex">\#\#</annotation></semantics></math><span id="A2.SS11.SSS2.Px2.p18.1.1" class="ltx_text"> Why it works (the invariant)</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p19" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p19.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p19.1.1" class="ltx_text">Two simple facts about the period <math id="A2.SS11.SSS2.Px2.p19.m1" class="ltx_Math" alttext="1,2,3,4,3,2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1,2,3,4,3,2</annotation></semantics></math>:</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p20" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p20.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p20.1.1" class="ltx_text">1. **Any 6 consecutive terms sum to 15.**
(That’s the period sum.)</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p21" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p21.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p21.1.1" class="ltx_text">2. **From any starting position, the 6 prefix-sums you can make with 1–6 terms are one of the following six sets**</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p22" class="ltx_para">
<table id="A2.Ex336" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex336X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex336X.m2" class="ltx_Math" alttext="\displaystyle\{1,3,6,10,13,15\}," display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>10</mn><mo>,</mo><mn>13</mn><mo>,</mo><mn>15</mn></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\{1,3,6,10,13,15\},</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex336X.m4" class="ltx_Math" alttext="\displaystyle\{2,5,9,12,14,15\}," display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>9</mn><mo>,</mo><mn>12</mn><mo>,</mo><mn>14</mn><mo>,</mo><mn>15</mn></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\{2,5,9,12,14,15\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex336Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex336Xa.m2" class="ltx_Math" alttext="\displaystyle\{3,7,10,12,13,15\}," display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>3</mn><mo>,</mo><mn>7</mn><mo>,</mo><mn>10</mn><mo>,</mo><mn>12</mn><mo>,</mo><mn>13</mn><mo>,</mo><mn>15</mn></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\{3,7,10,12,13,15\},</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex336Xa.m4" class="ltx_Math" alttext="\displaystyle\{4,7,9,10,12,15\}," display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>4</mn><mo>,</mo><mn>7</mn><mo>,</mo><mn>9</mn><mo>,</mo><mn>10</mn><mo>,</mo><mn>12</mn><mo>,</mo><mn>15</mn></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\{4,7,9,10,12,15\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex336Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex336Xb.m2" class="ltx_Math" alttext="\displaystyle\{3,5,6,8,11,15\}," display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>11</mn><mo>,</mo><mn>15</mn></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\{3,5,6,8,11,15\},</annotation></semantics></math></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex336Xb.m4" class="ltx_Math" alttext="\displaystyle\{2,3,5,8,12,15\}," display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>12</mn><mo>,</mo><mn>15</mn></mrow><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\{2,3,5,8,12,15\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p23" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p23.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p23.1.1" class="ltx_text">depending on where in the period you start. **Across the six starts, their union is exactly <math id="A2.SS11.SSS2.Px2.p23.m1" class="ltx_Math" alttext="\{1,2,\dots,15\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>15</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,2,\dots,15\}</annotation></semantics></math>.**</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p24" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p24.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p24.1.1" class="ltx_text">Now argue by induction on the hour <math id="A2.SS11.SSS2.Px2.p24.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p25" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p25.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p25.1.1" class="ltx_text">* Suppose after hour <math id="A2.SS11.SSS2.Px2.p25.m1" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math> the total strikes equal <math id="A2.SS11.SSS2.Px2.p25.m2" class="ltx_Math" alttext="T_{k-1}=\frac{(k-1)k}{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">T_{k-1}=\frac{(k-1)k}{2}</annotation></semantics></math>. Let the next starting position (within the 6-step period) be <math id="A2.SS11.SSS2.Px2.p25.m3" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>.
* We need to add **exactly <math id="A2.SS11.SSS2.Px2.p25.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>** more strikes. Write <math id="A2.SS11.SSS2.Px2.p25.m5" class="ltx_Math" alttext="k=15q+r" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mrow><mn>15</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">k=15q+r</annotation></semantics></math> with <math id="A2.SS11.SSS2.Px2.p25.m6" class="ltx_Math" alttext="r\in\{1,\dots,15\}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>15</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">r\in\{1,\dots,15\}</annotation></semantics></math>.
* Take <math id="A2.SS11.SSS2.Px2.p25.m7" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> whole periods (that adds <math id="A2.SS11.SSS2.Px2.p25.m8" class="ltx_Math" alttext="15q" display="inline" intent=":literal"><semantics><mrow><mn>15</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">15q</annotation></semantics></math> and returns to the same start <math id="A2.SS11.SSS2.Px2.p25.m9" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>), then take the **shortest prefix** (1–6 terms) from start <math id="A2.SS11.SSS2.Px2.p25.m10" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> whose sum is <math id="A2.SS11.SSS2.Px2.p25.m11" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. This exists because the “menu” of 6 prefix-sums at start <math id="A2.SS11.SSS2.Px2.p25.m12" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> covers some six distinct residues mod 15, and the process (checked once in the first few hours) lines up so that the needed <math id="A2.SS11.SSS2.Px2.p25.m13" class="ltx_Math" alttext="r=k\bmod 15" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mi>k</mi><mo>mod</mo><mn>15</mn></mrow></mrow><annotation encoding="application/x-tex">r=k\bmod 15</annotation></semantics></math> is always in the current menu.
* Therefore we can always realize “add <math id="A2.SS11.SSS2.Px2.p25.m14" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>” with at most <math id="A2.SS11.SSS2.Px2.p25.m15" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math> more items (after some number of full periods), so the <math id="A2.SS11.SSS2.Px2.p25.m16" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th block exists. Consequently <math id="A2.SS11.SSS2.Px2.p25.m17" class="ltx_Math" alttext="S_{n_{k}}=T_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><msub><mi>n</mi><mi>k</mi></msub></msub><mo>=</mo><msub><mi>T</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">S_{n_{k}}=T_{k}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p26" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p26.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p26.1.1" class="ltx_text">That’s all the clock is: it walks along the fixed 6-term wave and, at each hour, takes just enough consecutive entries to add exactly <math id="A2.SS11.SSS2.Px2.p26.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. The two-period facts above ensure this is always possible.</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p27" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p27.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p27.1.1" class="ltx_text">*(A nice side remark: the specific partial sums you see—1,3,6,10,13,15—are triangular numbers up to <math id="A2.SS11.SSS2.Px2.p27.m1" class="ltx_Math" alttext="T_{4}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>4</mn></msub><annotation encoding="application/x-tex">T_{4}</annotation></semantics></math>, then <math id="A2.SS11.SSS2.Px2.p27.m2" class="ltx_Math" alttext="T_{5}-2" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>5</mn></msub><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T_{5}-2</annotation></semantics></math>, then <math id="A2.SS11.SSS2.Px2.p27.m3" class="ltx_Math" alttext="T_{5}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>5</mn></msub><annotation encoding="application/x-tex">T_{5}</annotation></semantics></math>.)*</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p28" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p28.1" class="ltx_p"><math id="A2.SS11.SSS2.Px2.p28.m1" class="ltx_Math" alttext="\#\#" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi></mrow><annotation encoding="application/x-tex">\#\#</annotation></semantics></math><span id="A2.SS11.SSS2.Px2.p28.1.1" class="ltx_text"> Why this period is special, and how to generalize</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p29" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p29.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p29.1.1" class="ltx_text">The pattern you used is a **“sawtooth” of height <math id="A2.SS11.SSS2.Px2.p29.m1" class="ltx_Math" alttext="M=4" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">M=4</annotation></semantics></math>**:</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p30" class="ltx_para">
<table id="A2.Ex337" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex337.m1" class="ltx_Math" alttext="1,2,\dots,M,\dots,2\quad\text{(period length }2M-2=6\text{)}." display="block" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>2</mn><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mrow><mtext>(period length </mtext><mo lspace="0em" rspace="0em">​</mo><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>−</mo><mn>2</mn></mrow><mo>=</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mtext>)</mtext></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">1,2,\dots,M,\dots,2\quad\text{(period length }2M-2=6\text{)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p31" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p31.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p31.1.1" class="ltx_text">Its period-sum is</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p32" class="ltx_para">
<table id="A2.Ex338" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex338.m1" class="ltx_Math" alttext="(1+2+\cdots+M)+(M-1+\cdots+2)\;=\;M^{2}-1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><mn>2</mn></mrow><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><msup><mi>M</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(1+2+\cdots+M)+(M-1+\cdots+2)\;=\;M^{2}-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p33" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p33.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p33.1.1" class="ltx_text">For <math id="A2.SS11.SSS2.Px2.p33.m1" class="ltx_Math" alttext="M=4" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">M=4</annotation></semantics></math> this equals <math id="A2.SS11.SSS2.Px2.p33.m2" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math>, which is the triangular number <math id="A2.SS11.SSS2.Px2.p33.m3" class="ltx_Math" alttext="T_{5}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>5</mn></msub><annotation encoding="application/x-tex">T_{5}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p34" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p34.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p34.1.1" class="ltx_text">This triangularity is exactly what makes the modular bookkeeping so clean. More generally, the same hourly trick works for the sawtooth of height <math id="A2.SS11.SSS2.Px2.p34.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> **whenever the period-sum <math id="A2.SS11.SSS2.Px2.p34.m2" class="ltx_Math" alttext="M^{2}-1" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M^{2}-1</annotation></semantics></math> itself is triangular**, i.e.</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p35" class="ltx_para">
<table id="A2.Ex339" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex339.m1" class="ltx_Math" alttext="M^{2}-1=\frac{t(t+1)}{2}\quad\text{for some integer }t." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>M</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mo>=</mo><mfrac><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>for some integer </mtext><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M^{2}-1=\frac{t(t+1)}{2}\quad\text{for some integer }t.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p36" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p36.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p36.1.1" class="ltx_text">Equivalently,</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p37" class="ltx_para">
<table id="A2.Ex340" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex340.m1" class="ltx_Math" alttext="8M^{2}-7=(2t+1)^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mn>2</mn></msup></mrow><mo>−</mo><mn>7</mn></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">8M^{2}-7=(2t+1)^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p38" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p38.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p38.1.1" class="ltx_text">so <math id="A2.SS11.SSS2.Px2.p38.m1" class="ltx_Math" alttext="(2t+1,M)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2t+1,M)</annotation></semantics></math> is an integer solution of the Pell-type equation</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p39" class="ltx_para">
<table id="A2.Ex341" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex341.m1" class="ltx_Math" alttext="x^{2}-8y^{2}=-7." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mn>2</mn></msup></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mn>7</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x^{2}-8y^{2}=-7.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p40" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p40.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p40.1.1" class="ltx_text">This has infinitely many solutions, giving an infinite family of valid heights <math id="A2.SS11.SSS2.Px2.p40.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. The first few are</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p41" class="ltx_para">
<table id="A2.Ex342" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex342.m1" class="ltx_Math" alttext="M=2,\;4,\;11,\;64,\;373,\;\dots" display="block" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mn> 4</mn><mo>,</mo><mn> 11</mn><mo>,</mo><mn> 64</mn><mo>,</mo><mn> 373</mn><mo rspace="0.447em">,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">M=2,\;4,\;11,\;64,\;373,\;\dots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p42" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p42.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p42.1.1" class="ltx_text">For each such <math id="A2.SS11.SSS2.Px2.p42.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, use the period</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p43" class="ltx_para">
<table id="A2.Ex343" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex343.m1" class="ltx_Math" alttext="1,2,\dots,M,\dots,2" display="block" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1,2,\dots,M,\dots,2</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p44" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p44.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p44.1.1" class="ltx_text">(length <math id="A2.SS11.SSS2.Px2.p44.m1" class="ltx_Math" alttext="2M-2" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2M-2</annotation></semantics></math>, sum <math id="A2.SS11.SSS2.Px2.p44.m2" class="ltx_Math" alttext="M^{2}-1=T_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>M</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mo>=</mo><msub><mi>T</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">M^{2}-1=T_{t}</annotation></semantics></math>). Then the exact same induction goes through with “mod <math id="A2.SS11.SSS2.Px2.p44.m3" class="ltx_Math" alttext="M^{2}-1" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M^{2}-1</annotation></semantics></math>” replacing “mod 15.”</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p45" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p45.1" class="ltx_p"><math id="A2.SS11.SSS2.Px2.p45.m1" class="ltx_Math" alttext="\#\#\#" display="inline" intent=":literal"><semantics><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><mi>#</mi></mrow><annotation encoding="application/x-tex">\#\#\#</annotation></semantics></math><span id="A2.SS11.SSS2.Px2.p45.1.1" class="ltx_text"> Other directions to play with</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p46" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p46.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p46.1.1" class="ltx_text">* **Different target sequences.** We hit triangular numbers because the needed increment at hour <math id="A2.SS11.SSS2.Px2.p46.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is exactly <math id="A2.SS11.SSS2.Px2.p46.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. If you want a clock whose hour-<math id="A2.SS11.SSS2.Px2.p46.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> block adds some other prescribed increment <math id="A2.SS11.SSS2.Px2.p46.m4" class="ltx_Math" alttext="d_{k}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>k</mi></msub><annotation encoding="application/x-tex">d_{k}</annotation></semantics></math> (e.g., <math id="A2.SS11.SSS2.Px2.p46.m5" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math>, or bounded sequences), you can ask for a short periodic word whose 1–period prefix sums, taken from the current start, always offer the residue class of <math id="A2.SS11.SSS2.Px2.p46.m6" class="ltx_Math" alttext="d_{k}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>k</mi></msub><annotation encoding="application/x-tex">d_{k}</annotation></semantics></math> modulo the period-sum. This is a tidy finite-state/automaton design problem.</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p47" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p47.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p47.1.1" class="ltx_text">* **Different “waves.”** You can try other symmetric waves (e.g., <math id="A2.SS11.SSS2.Px2.p47.m1" class="ltx_Math" alttext="1,2,3,4,5,4,3,2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1,2,3,4,5,4,3,2</annotation></semantics></math>) and check whether their period-sum is triangular. If it is, you’ll get the same phenomenon. If it isn’t, the method eventually fails (you’ll land at a start whose 1–period prefix menu does not contain the needed residue).</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p48" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p48.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p48.1.1" class="ltx_text">* **Minute/quarter chimes.** If you want blocks to line up with a natural cycle (like 60 minutes), pick a sawtooth whose period-sum is <math id="A2.SS11.SSS2.Px2.p48.m1" class="ltx_Math" alttext="60" display="inline" intent=":literal"><semantics><mn>60</mn><annotation encoding="application/x-tex">60</annotation></semantics></math> (or divides it and then combine periods), and run the same residue argument.</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p49" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p49.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p49.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p50" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p50.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p50.1.1" class="ltx_text">In short: the clock slices a fixed periodic sequence into blocks whose sums are <math id="A2.SS11.SSS2.Px2.p50.m1" class="ltx_Math" alttext="1,2,3,\dots" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">1,2,3,\dots</annotation></semantics></math>. It works because the 6-term wave <math id="A2.SS11.SSS2.Px2.p50.m2" class="ltx_Math" alttext="1,2,3,4,3,2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1,2,3,4,3,2</annotation></semantics></math> has period-sum <math id="A2.SS11.SSS2.Px2.p50.m3" class="ltx_Math" alttext="15=T_{5}" display="inline" intent=":literal"><semantics><mrow><mn>15</mn><mo>=</mo><msub><mi>T</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">15=T_{5}</annotation></semantics></math> and, from any start, the six prefix-sums cover exactly one representative of each residue class you will need as you move from <math id="A2.SS11.SSS2.Px2.p50.m4" class="ltx_Math" alttext="T_{k-1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">T_{k-1}</annotation></semantics></math> to <math id="A2.SS11.SSS2.Px2.p50.m5" class="ltx_Math" alttext="T_{k}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>k</mi></msub><annotation encoding="application/x-tex">T_{k}</annotation></semantics></math>. The same idea works for the sawtooth of any height <math id="A2.SS11.SSS2.Px2.p50.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> with <math id="A2.SS11.SSS2.Px2.p50.m7" class="ltx_Math" alttext="M^{2}-1" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M^{2}-1</annotation></semantics></math> triangular—yielding a whole family of “triangular clocks.”</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p51" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p51.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p51.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS11.SSS2.Px2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS11.SSS2.Px2.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS11.SSS2.Px2.p52" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p52.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p52.1.1" class="ltx_text">Adapted from <a href="https://www.math.utoronto.ca/barbeau/vig13.pdf" title="" class="ltx_ref ltx_href">https://www.math.utoronto.ca/barbeau/vig13.pdf</a></span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p53" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p53.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p53.1.1" class="ltx_text">The repeating sequence is cut into infinitely many blocks such that the <math id="A2.SS11.SSS2.Px2.p53.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>th block has sum <math id="A2.SS11.SSS2.Px2.p53.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. We describe all such possible sequences. Suppose we have a sequence whose basic repeating unit is <math id="A2.SS11.SSS2.Px2.p53.m3" class="ltx_Math" alttext="a_{1},\dots,a_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">a_{1},\dots,a_{n}</annotation></semantics></math> with sum <math id="A2.SS11.SSS2.Px2.p53.m4" class="ltx_Math" alttext="S:=\sum_{i=1}^{n}a_{i}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo rspace="0.111em">:=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msub><mi>a</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">S:=\sum_{i=1}^{n}a_{i}</annotation></semantics></math>. Then the set <math id="A2.SS11.SSS2.Px2.p53.m5" class="ltx_Math" alttext="a_{1},a_{1}+a_{2},\dots,a_{1}+a_{2}+\dots+a_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><msub><mi>a</mi><mn>2</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>a</mi><mn>1</mn></msub><mo>+</mo><msub><mi>a</mi><mn>2</mn></msub><mo>+</mo><mi mathvariant="normal">⋯</mi><mo>+</mo><msub><mi>a</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">a_{1},a_{1}+a_{2},\dots,a_{1}+a_{2}+\dots+a_{n}</annotation></semantics></math> is exactly the set of unique residue classes modulo <math id="A2.SS11.SSS2.Px2.p53.m6" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> of the sequence of triangular numbers</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p54" class="ltx_para">
<table id="A2.Ex344" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex344.m1" class="ltx_Math" alttext="1,1+2,1+2+3,\dots" display="block" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mrow><mn>1</mn><mo>+</mo><mn>2</mn></mrow><mo>,</mo><mrow><mn>1</mn><mo>+</mo><mn>2</mn><mo>+</mo><mn>3</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">1,1+2,1+2+3,\dots</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p55" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p55.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p55.1.1" class="ltx_text">For example when <math id="A2.SS11.SSS2.Px2.p55.m1" class="ltx_Math" alttext="N=15" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">N=15</annotation></semantics></math>, the set of residues modulo <math id="A2.SS11.SSS2.Px2.p55.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> of triangular numbers is exactly <math id="A2.SS11.SSS2.Px2.p55.m3" class="ltx_Math" alttext="0,1,3,6,10,13,15" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>10</mn><mo>,</mo><mn>13</mn><mo>,</mo><mn>15</mn></mrow><annotation encoding="application/x-tex">0,1,3,6,10,13,15</annotation></semantics></math>. Taking differences we obtain <math id="A2.SS11.SSS2.Px2.p55.m4" class="ltx_Math" alttext="n=7" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">n=7</annotation></semantics></math> and the sequence <math id="A2.SS11.SSS2.Px2.p55.m5" class="ltx_Math" alttext="1,2,3,4,3,2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1,2,3,4,3,2</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px2.p56" class="ltx_para">
<table id="A2.Ex345" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex345.m1" class="ltx_math_unparsed" alttext="-|--|---|----|---|--|-|" display="block" intent=":literal"><semantics><mrow><mo rspace="0em">−</mo><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">−</mo><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">−</mo><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">−</mo><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">−</mo><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" rspace="0em">−</mo><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0em">−</mo><mo fence="false" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">-|--|---|----|---|--|-|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px2.p57" class="ltx_para">
<p id="A2.SS11.SSS2.Px2.p57.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p57.1.1" class="ltx_text">If <math id="A2.SS11.SSS2.Px2.p57.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is even, then the sequence you obtain is the two copies of the sequence for <math id="A2.SS11.SSS2.Px2.p57.m2" class="ltx_Math" alttext="N/2" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">N/2</annotation></semantics></math>. For every odd <math id="A2.SS11.SSS2.Px2.p57.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> we obtain a primitive sequence. This is summarized in the table below for small <math id="A2.SS11.SSS2.Px2.p57.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>.</span></p>
</div>
