<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S2.SS11" title="In 2 Math Skills Breakdown ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">11 </span>Generalization</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S2.SS12" title="In 2 Math Skills Breakdown ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">12 </span>Creativity</span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S3" title="In GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3 </span>Skills Profile for GPT-5 thinking and Comparison with o4-mini-high</span></a></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S4" title="In GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">4 </span>Future Directions</span></a></li>
<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A1" title="In GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">A </span>Evaluation Pipeline</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A2" title="In GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">B </span>Model Responses and Evaluations</span></a>
<ol class="ltx_toclist ltx_toclist_appendix">
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS1" title="In Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">1 </span>Memory of Math Knowledge</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS2" title="In Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">2 </span>Understanding Knowledge and Theory Mastery</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS3" title="In Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">3 </span>Computational and Analytical Skills</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS4" title="In Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">4 </span>Problem-Solving Framework</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS5" title="In Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">5 </span>Logical Thinking and Reasoning</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS6" title="In Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">6 </span>Writing and Presentation</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS7" title="In Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">7 </span>Intuition</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS8" title="In Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">8 </span>Meta Skills</span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A2.SS9" title="In Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">9 </span>Learning New Knowledge</span></a></li>
