</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:1.76em;--ltx-fo-depth:0.16em;font-size:10pt;" height="26.44" overflow="visible" transform="matrix(1 0 0 -1 0 24.29)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
