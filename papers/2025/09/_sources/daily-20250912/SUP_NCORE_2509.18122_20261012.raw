<section id="A2.SS1.SSS2.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#FF0000;">Problem 1b2</h5>

<div id="A2.SS1.SSS2.Px2.p1" class="ltx_para">
<p id="A2.SS1.SSS2.Px2.p1.1" class="ltx_p"><span id="A2.SS1.SSS2.Px2.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS1.SSS2.Px2.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS1.SSS2.Px2.p2.pic1" class="ltx_picture" height="100.93" overflow="visible" version="1.1" viewBox="0 0 429.64 100.93" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,100.93) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 96.3 C 0 98.86 2.07 100.93 4.63 100.93 L 425.01 100.93 C 427.56 100.93 429.64 98.86 429.64 96.3 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 82.06 L 428.94 82.06 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 86.69)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
