</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS6.SSS2.Px1.p57" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS6.SSS2.Px1.p57.pic1" class="ltx_picture" height="102.83" overflow="visible" version="1.1" viewBox="0 0 429.64 102.83" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,102.83) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 98.2 C 0 100.76 2.07 102.83 4.63 102.83 L 425.01 102.83 C 427.56 102.83 429.64 100.76 429.64 98.2 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 83.97 L 428.94 83.97 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 88.6)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS2.Px1.p57.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS6.SSS2.Px1.p57.pic1.1.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p57.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:4.16em;--ltx-fo-depth:0.16em;font-size:10pt;" height="59.65" overflow="visible" transform="matrix(1 0 0 -1 0 57.5)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS2.Px1.p57.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS6.SSS2.Px1.p57.pic1.2.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p57.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The explanation does not address <span id="A2.SS6.SSS2.Px1.p57.pic1.2.1.1.1" class="ltx_text ltx_font_italic">why</span> <math id="A2.SS6.SSS2.Px1.p57.pic1.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> should be a 2-form (rather than simply an bilinear pairing on <math id="A2.SS6.SSS2.Px1.p57.pic1.m2" class="ltx_Math" alttext="TM" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi></mrow><annotation encoding="application/x-tex">TM</annotation></semantics></math>) and moreover why it should be closed.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
</section>
</section>
<section id="A2.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7 </span>Intuition</h3>

<section id="A2.SS7.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">(a) </span>Geometric Intuition</h4>

<section id="A2.SS7.SSS1.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#FF0000;">Problem 7a1 </h5>

<div id="A2.SS7.SSS1.Px1.p1" class="ltx_para">
<p id="A2.SS7.SSS1.Px1.p1.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS7.SSS1.Px1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS1.Px1.p2.pic1" class="ltx_picture" height="133.53" overflow="visible" version="1.1" viewBox="0 0 429.64 133.53" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,133.53) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 128.9 C 0 131.45 2.07 133.53 4.63 133.53 L 425.01 133.53 C 427.56 133.53 429.64 131.45 429.64 128.9 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 114.66 L 428.94 114.66 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 119.29)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px1.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS7.SSS1.Px1.p2.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:6.37em;--ltx-fo-depth:0.16em;font-size:10pt;" height="90.35" overflow="visible" transform="matrix(1 0 0 -1 0 88.19)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px1.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS7.SSS1.Px1.p2.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Show that every smoothly embedded closed orientable connected surface in the <math id="A2.SS7.SSS1.Px1.p2.pic1.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-sphere bounds a smoothly embedded <math id="A2.SS7.SSS1.Px1.p2.pic1.m2" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-dimensional handlebody (i.e. a boundary sum of solid tori) in the <math id="A2.SS7.SSS1.Px1.p2.pic1.m3" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-ball.</span></span><span class="ltx_inline-block"><svg id="A2.SS7.SSS1.Px1.p2.pic1.pic1" class="ltx_picture" color="#FF0000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 0 L 15.75 15.75 M 0 15.75 L 15.75 0"></path></g></svg></span>
<span id="A2.SS7.SSS1.Px1.p2.pic1.2.2" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;">GPT-5 thinking failed</span></span>
<span id="A2.SS7.SSS1.Px1.p2.pic1.2.3" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p2.pic1.2.3.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Qiuyu Ren</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS7.SSS1.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS7.SSS1.Px1.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS7.SSS1.Px1.p3" class="ltx_para">
<p id="A2.SS7.SSS1.Px1.p3.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p3.1.1" class="ltx_text">Let <math id="A2.SS7.SSS1.Px1.p3.m1" class="ltx_Math" alttext="\Sigma\subset S^{3}=\partial B^{4}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>⊂</mo><msup><mi>S</mi><mn>3</mn></msup><mo rspace="0.111em">=</mo><mrow><mo>∂</mo><msup><mi>B</mi><mn>4</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\Sigma\subset S^{3}=\partial B^{4}</annotation></semantics></math> be a smooth, closed, orientable, connected surface. Denote the two components of <math id="A2.SS7.SSS1.Px1.p3.m2" class="ltx_Math" alttext="S^{3}\setminus\Sigma" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mn>3</mn></msup><mo>∖</mo><mi mathvariant="normal">Σ</mi></mrow><annotation encoding="application/x-tex">S^{3}\setminus\Sigma</annotation></semantics></math> by <math id="A2.SS7.SSS1.Px1.p3.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> and <math id="A2.SS7.SSS1.Px1.p3.m4" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS7.SSS1.Px1.p4" class="ltx_para">
<p id="A2.SS7.SSS1.Px1.p4.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p4.1.1" class="ltx_text ltx_font_bold">Step 1 (Compress on one side until spheres).<span id="A2.SS7.SSS1.Px1.p4.1.1.1" class="ltx_text ltx_font_medium">
Because <math id="A2.SS7.SSS1.Px1.p4.m1" class="ltx_Math" alttext="S^{3}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>3</mn></msup><annotation encoding="application/x-tex">S^{3}</annotation></semantics></math> contains no closed incompressible surfaces of positive genus, <math id="A2.SS7.SSS1.Px1.p4.m2" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is compressible in <math id="A2.SS7.SSS1.Px1.p4.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Choose a <em id="A2.SS7.SSS1.Px1.p4.1.1.1.1" class="ltx_emph ltx_font_italic">maximal</em> collection <math id="A2.SS7.SSS1.Px1.p4.m4" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> of pairwise disjoint compressing disks for <math id="A2.SS7.SSS1.Px1.p4.m5" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> in <math id="A2.SS7.SSS1.Px1.p4.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Compress <math id="A2.SS7.SSS1.Px1.p4.m7" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> along all disks of <math id="A2.SS7.SSS1.Px1.p4.m8" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>. The result <math id="A2.SS7.SSS1.Px1.p4.m9" class="ltx_Math" alttext="\Sigma_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">\Sigma_{\Delta}</annotation></semantics></math> is incompressible in the compressed manifold <math id="A2.SS7.SSS1.Px1.p4.m10" class="ltx_Math" alttext="X_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">X_{\Delta}</annotation></semantics></math>, hence every component of <math id="A2.SS7.SSS1.Px1.p4.m11" class="ltx_Math" alttext="\Sigma_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Σ</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">\Sigma_{\Delta}</annotation></semantics></math> is a 2–sphere. Since <math id="A2.SS7.SSS1.Px1.p4.m12" class="ltx_Math" alttext="S^{3}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>3</mn></msup><annotation encoding="application/x-tex">S^{3}</annotation></semantics></math> is irreducible, each such sphere bounds a 3–ball in <math id="A2.SS7.SSS1.Px1.p4.m13" class="ltx_Math" alttext="X_{\Delta}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi mathvariant="normal">Δ</mi></msub><annotation encoding="application/x-tex">X_{\Delta}</annotation></semantics></math> (and thus in <math id="A2.SS7.SSS1.Px1.p4.m14" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>).</span></span></p>
</div>
<div id="A2.SS7.SSS1.Px1.p5" class="ltx_para">
<p id="A2.SS7.SSS1.Px1.p5.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p5.1.1" class="ltx_text">Equivalently, <math id="A2.SS7.SSS1.Px1.p5.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is obtained from a (possibly disconnected) union <math id="A2.SS7.SSS1.Px1.p5.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> of 3–balls by attaching 1–handles; the attaching curves on <math id="A2.SS7.SSS1.Px1.p5.m3" class="ltx_Math" alttext="\partial B" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\partial B</annotation></semantics></math> are the circles <math id="A2.SS7.SSS1.Px1.p5.m4" class="ltx_Math" alttext="\partial\Delta" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">\partial\Delta</annotation></semantics></math>, and adding those tubes to <math id="A2.SS7.SSS1.Px1.p5.m5" class="ltx_Math" alttext="\partial B" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\partial B</annotation></semantics></math> recovers <math id="A2.SS7.SSS1.Px1.p5.m6" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS7.SSS1.Px1.p6" class="ltx_para">
<p id="A2.SS7.SSS1.Px1.p6.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p6.1.1" class="ltx_text ltx_font_bold">Step 2 (Push into <math id="A2.SS7.SSS1.Px1.p6.m1" class="ltx_Math" alttext="B^{4}" display="inline" intent=":literal"><semantics><msup><mi>B</mi><mn>4</mn></msup><annotation encoding="application/x-tex">B^{4}</annotation></semantics></math> and take the dual picture).<span id="A2.SS7.SSS1.Px1.p6.1.1.1" class="ltx_text ltx_font_medium">
Give <math id="A2.SS7.SSS1.Px1.p6.m2" class="ltx_Math" alttext="S^{3}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>3</mn></msup><annotation encoding="application/x-tex">S^{3}</annotation></semantics></math> a collar in <math id="A2.SS7.SSS1.Px1.p6.m3" class="ltx_Math" alttext="B^{4}" display="inline" intent=":literal"><semantics><msup><mi>B</mi><mn>4</mn></msup><annotation encoding="application/x-tex">B^{4}</annotation></semantics></math>, <math id="A2.SS7.SSS1.Px1.p6.m4" class="ltx_Math" alttext="S^{3}\times[0,\varepsilon]\subset B^{4}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>S</mi><mn>3</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mi>ε</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>⊂</mo><msup><mi>B</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">S^{3}\times[0,\varepsilon]\subset B^{4}</annotation></semantics></math>. Push the interior of each 3–ball of <math id="A2.SS7.SSS1.Px1.p6.m5" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> slightly into <math id="A2.SS7.SSS1.Px1.p6.m6" class="ltx_Math" alttext="B^{4}" display="inline" intent=":literal"><semantics><msup><mi>B</mi><mn>4</mn></msup><annotation encoding="application/x-tex">B^{4}</annotation></semantics></math> (so each becomes a 0–handle properly embedded in <math id="A2.SS7.SSS1.Px1.p6.m7" class="ltx_Math" alttext="B^{4}" display="inline" intent=":literal"><semantics><msup><mi>B</mi><mn>4</mn></msup><annotation encoding="application/x-tex">B^{4}</annotation></semantics></math>), and for each tube used above attach a standard 1–handle in the collar with core an arc parallel to the corresponding co–core in <math id="A2.SS7.SSS1.Px1.p6.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Because the compressing disks were disjoint, these 1–handles can be chosen disjoint.</span></span></p>
</div>
<div id="A2.SS7.SSS1.Px1.p7" class="ltx_para">
<p id="A2.SS7.SSS1.Px1.p7.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p7.1.1" class="ltx_text">Let <math id="A2.SS7.SSS1.Px1.p7.m1" class="ltx_Math" alttext="H\subset B^{4}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⊂</mo><msup><mi>B</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">H\subset B^{4}</annotation></semantics></math> be the resulting 3–manifold. By construction:</span></p>
<ul id="A2.I17" class="ltx_itemize">
<li id="A2.I17.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I17.i1.p1" class="ltx_para">
<p id="A2.I17.i1.p1.1" class="ltx_p"><math id="A2.I17.i1.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> has a handle decomposition with only 0– and 1–handles, hence <math id="A2.I17.i1.p1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is a (3–dimensional) handlebody, i.e. a boundary connected sum of solid tori (a regular neighborhood of a properly embedded graph).</p>
</div></li>
<li id="A2.I17.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I17.i2.p1" class="ltx_para">
<p id="A2.I17.i2.p1.1" class="ltx_p">The boundary of <math id="A2.I17.i2.p1.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> on <math id="A2.I17.i2.p1.m2" class="ltx_Math" alttext="\partial B^{4}=S^{3}" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mphantom></mphantom><mrow><msup><mi>B</mi><mn>4</mn></msup><mo>=</mo><msup><mi>S</mi><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\partial B^{4}=S^{3}</annotation></semantics></math> is precisely the surface obtained from <math id="A2.I17.i2.p1.m3" class="ltx_Math" alttext="\partial B" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\partial B</annotation></semantics></math> by adding the tubes dual to <math id="A2.I17.i2.p1.m4" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>, i.e. it is <math id="A2.I17.i2.p1.m5" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="A2.SS7.SSS1.Px1.p8" class="ltx_para">
<p id="A2.SS7.SSS1.Px1.p8.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p8.1.1" class="ltx_text">Since <math id="A2.SS7.SSS1.Px1.p8.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is connected, the underlying graph is connected, so <math id="A2.SS7.SSS1.Px1.p8.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is a connected handlebody. Its genus equals <math id="A2.SS7.SSS1.Px1.p8.m3" class="ltx_Math" alttext="g(\Sigma)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(\Sigma)</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS7.SSS1.Px1.p9" class="ltx_para">
<p id="A2.SS7.SSS1.Px1.p9.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p9.1.1" class="ltx_text">Thus every smoothly embedded closed orientable connected surface in <math id="A2.SS7.SSS1.Px1.p9.m1" class="ltx_Math" alttext="S^{3}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>3</mn></msup><annotation encoding="application/x-tex">S^{3}</annotation></semantics></math> bounds a 3–dimensional handlebody in <math id="A2.SS7.SSS1.Px1.p9.m2" class="ltx_Math" alttext="B^{4}" display="inline" intent=":literal"><semantics><msup><mi>B</mi><mn>4</mn></msup><annotation encoding="application/x-tex">B^{4}</annotation></semantics></math>. <span id="A2.SS7.SSS1.Px1.p9.1.1.1" class="ltx_text ltx_markedasmath ltx_font_italic">∎</span></span></p>
</div>
<div id="A2.SS7.SSS1.Px1.p10" class="ltx_para">
<p id="A2.SS7.SSS1.Px1.p10.1" class="ltx_p"><em id="A2.SS7.SSS1.Px1.p10.1.1" class="ltx_emph ltx_font_italic">Remarks.</em><span id="A2.SS7.SSS1.Px1.p10.1.2" class="ltx_text"></span></p>
<ul id="A2.I18" class="ltx_itemize">
<li id="A2.I18.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I18.i1.p1" class="ltx_para">
<p id="A2.I18.i1.p1.1" class="ltx_p">If one prefers, one can pick <math id="A2.I18.i1.p1.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math> nonseparating of size <math id="A2.I18.i1.p1.m2" class="ltx_Math" alttext="g(\Sigma)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(\Sigma)</annotation></semantics></math>, yielding a single 3–ball and <math id="A2.I18.i1.p1.m3" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> 1–handles, so <math id="A2.I18.i1.p1.m4" class="ltx_Math" alttext="H\cong\#^{\,g}(S^{1}\times D^{2})" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>≅</mo><mrow><msup><mi>#</mi><mi>g</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>S</mi><mn>1</mn></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>D</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">H\cong\#^{\,g}(S^{1}\times D^{2})</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I18.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I18.i2.p1" class="ltx_para">
<p id="A2.I18.i2.p1.1" class="ltx_p">Conceptually, this is the “movie” that <math id="A2.I18.i2.p1.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is obtained from a sphere by a sequence of ambient 1–surgeries; thickening the movie in the time direction gives a 3–dimensional cobordism made only of 0– and 1–handles.</p>
</div></li>
</ul>
<p id="A2.SS7.SSS1.Px1.p10.2" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p10.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS7.SSS1.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS7.SSS1.Px1.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS7.SSS1.Px1.p11" class="ltx_para">
<p id="A2.SS7.SSS1.Px1.p11.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p11.1.1" class="ltx_text">Every orientable surface <math id="A2.SS7.SSS1.Px1.p11.m1" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> in <math id="A2.SS7.SSS1.Px1.p11.m2" class="ltx_Math" alttext="S^{3}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mn>3</mn></msup><annotation encoding="application/x-tex">S^{3}</annotation></semantics></math> with positive genus is compressible, and a sequence of compressions reduce <math id="A2.SS7.SSS1.Px1.p11.m3" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> to a disjoint union of <math id="A2.SS7.SSS1.Px1.p11.m4" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-spheres, which can then be capped off by a sequence of <math id="A2.SS7.SSS1.Px1.p11.m5" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-balls. One can build a cobordism <math id="A2.SS7.SSS1.Px1.p11.m6" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> in <math id="A2.SS7.SSS1.Px1.p11.m7" class="ltx_Math" alttext="I\times S^{3}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>S</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">I\times S^{3}</annotation></semantics></math> from <math id="A2.SS7.SSS1.Px1.p11.m8" class="ltx_Math" alttext="\Sigma\subset\{0\}\times S^{3}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Σ</mi><mo>⊂</mo><mrow><mrow><mo stretchy="false">{</mo><mn>0</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>S</mi><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\Sigma\subset\{0\}\times S^{3}</annotation></semantics></math> to <math id="A2.SS7.SSS1.Px1.p11.m9" class="ltx_Math" alttext="\emptyset\subset\{1\}\times S^{3}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">∅</mi><mo>⊂</mo><mrow><mrow><mo stretchy="false">{</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>S</mi><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\emptyset\subset\{1\}\times S^{3}</annotation></semantics></math> by realizing the compressions and caps as ambient <math id="A2.SS7.SSS1.Px1.p11.m10" class="ltx_Math" alttext="2,3" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>,</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">2,3</annotation></semantics></math>-handle attachments. Capping <math id="A2.SS7.SSS1.Px1.p11.m11" class="ltx_Math" alttext="\{1\}\times S^{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mn>1</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><msup><mi>S</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\{1\}\times S^{3}</annotation></semantics></math> by a <math id="A2.SS7.SSS1.Px1.p11.m12" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math>-ball and turn the picture upside down, <math id="A2.SS7.SSS1.Px1.p11.m13" class="ltx_Math" alttext="W\subset B^{4}" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>⊂</mo><msup><mi>B</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">W\subset B^{4}</annotation></semantics></math> is now a <math id="A2.SS7.SSS1.Px1.p11.m14" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>-manifold bounding <math id="A2.SS7.SSS1.Px1.p11.m15" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> with only <math id="A2.SS7.SSS1.Px1.p11.m16" class="ltx_Math" alttext="0,1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0,1</annotation></semantics></math>-handles. When <math id="A2.SS7.SSS1.Px1.p11.m17" class="ltx_Math" alttext="\Sigma" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Σ</mi><annotation encoding="application/x-tex">\Sigma</annotation></semantics></math> is connected, <math id="A2.SS7.SSS1.Px1.p11.m18" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> is a handlebody.
∎</span></p>
</div>
</div>
<div id="A2.SS7.SSS1.Px1.p12" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS1.Px1.p12.pic1" class="ltx_picture" height="86.23" overflow="visible" version="1.1" viewBox="0 0 429.64 86.23" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,86.23) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 81.6 C 0 84.16 2.07 86.23 4.63 86.23 L 425.01 86.23 C 427.56 86.23 429.64 84.16 429.64 81.6 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 67.36 L 428.94 67.36 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 71.99)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px1.p12.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS7.SSS1.Px1.p12.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p12.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Rubric</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:2.96em;--ltx-fo-depth:0.16em;font-size:10pt;" height="43.05" overflow="visible" transform="matrix(1 0 0 -1 0 40.9)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px1.p12.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS7.SSS1.Px1.p12.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p12.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">2 point if the proof is correct.
<br class="ltx_break">1 point if the proof has the correct idea but contains missing or incorrect arguments.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS7.SSS1.Px1.p13" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS1.Px1.p13.pic1" class="ltx_picture" height="54.13" overflow="visible" version="1.1" viewBox="0 0 429.64 54.13" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,54.13) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#5A996B;" fill="#5A996B" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 49.51 C 0 52.06 2.07 54.13 4.63 54.13 L 425.01 54.13 C 427.56 54.13 429.64 52.06 429.64 49.51 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F6FFF9;" fill="#F6FFF9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 35.38 L 428.94 35.38 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 40.01)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px1.p13.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
