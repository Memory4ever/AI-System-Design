</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS9.SSS1.Px1.p25.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS9.SSS1.Px1.p25.pic1.2.1" class="ltx_p"><span id="A2.SS9.SSS1.Px1.p25.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">3/3</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS9.SSS1.Px1.p26" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS9.SSS1.Px1.p26.pic1" class="ltx_picture" height="53.02" overflow="visible" version="1.1" viewBox="0 0 429.64 53.02" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,53.02) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 48.39 C 0 50.95 2.07 53.02 4.63 53.02 L 425.01 53.02 C 427.56 53.02 429.64 50.95 429.64 48.39 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 34.15 L 428.94 34.15 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 38.78)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
