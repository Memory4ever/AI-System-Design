</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS9.SSS2.Px1.p53.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS9.SSS2.Px1.p53.pic1.2.1" class="ltx_p"><span id="A2.SS9.SSS2.Px1.p53.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">2/3</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS9.SSS2.Px1.p54" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS9.SSS2.Px1.p54.pic1" class="ltx_picture" height="53.02" overflow="visible" version="1.1" viewBox="0 0 429.64 53.02" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,53.02) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 48.39 C 0 50.95 2.07 53.02 4.63 53.02 L 425.01 53.02 C 427.56 53.02 429.64 50.95 429.64 48.39 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 34.15 L 428.94 34.15 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 38.78)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS9.SSS2.Px1.p54.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS9.SSS2.Px1.p54.pic1.1.1" class="ltx_p"><span id="A2.SS9.SSS2.Px1.p54.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.56em;--ltx-fo-depth:0.16em;font-size:10pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS9.SSS2.Px1.p54.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS9.SSS2.Px1.p54.pic1.2.1" class="ltx_p"><span id="A2.SS9.SSS2.Px1.p54.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The definition of compatible family of measure is incorrect.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
</section>
</section>
<section id="A2.SS10" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">10 </span>Mathematical Modeling</h3>

<section id="A2.SS10.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">(a) </span>Translating real-world problems into math</h4>

<section id="A2.SS10.SSS1.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#FF0000;">Problem 10a1 </h5>

<div id="A2.SS10.SSS1.Px1.p1" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p1.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS10.SSS1.Px1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS10.SSS1.Px1.p2.pic1" class="ltx_picture" height="676.09" overflow="visible" version="1.1" viewBox="0 0 429.64 676.09" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,676.09) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 671.46 C 0 674.02 2.07 676.09 4.63 676.09 L 425.01 676.09 C 427.56 676.09 429.64 674.02 429.64 671.46 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 657.22 L 428.94 657.22 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 661.85)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS10.SSS1.Px1.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS10.SSS1.Px1.p2.pic1.1.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:45.59em;--ltx-fo-depth:0.16em;font-size:10pt;" height="632.92" overflow="visible" transform="matrix(1 0 0 -1 0 630.76)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS10.SSS1.Px1.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS10.SSS1.Px1.p2.pic1.2.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Try to solve the following mathematical modeling problem (MCM 2024 Problem A):</span></span>
<span id="A2.SS10.SSS1.Px1.p2.pic1.2.2" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">While some animal species exist outside of the usual male or female sexes, most species are substantially either male or female. Although many species exhibit a 1:1 sex ratio at birth, other species deviate from an even sex ratio. This is called adaptive sex ratio variation. For example, the temperature of the nest incubating eggs of the American alligator influences the sex ratios at birth.</span></span>
<span id="A2.SS10.SSS1.Px1.p2.pic1.2.3" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p2.pic1.2.3.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The role of lampreys is complex. In some lake habitats, they are seen as parasites with a significant impact on the ecosystem, whereas lampreys are also a food source in some regions of the world, such as Scandinavia, the Baltics, and for some Indigenous peoples of the Pacific Northwest in North America.</span></span>
<span id="A2.SS10.SSS1.Px1.p2.pic1.2.4" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p2.pic1.2.4.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The sex ratio of sea lampreys can vary based on external circumstances. Sea lampreys become male or female depending on how quickly they grow during the larval stage. These larval growth rates are influenced by the availability of food. In environments where food availability is low, growth rates will be lower, and the percentage of males can reach approximately <math id="A2.SS10.SSS1.Px1.p2.pic1.m1" class="ltx_Math" alttext="78\%" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">78</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="1.250em">%</mo></mrow><annotation encoding="application/x-tex">78\%</annotation></semantics></math> of the population. In environments where food is more readily available, the percentage of males has been observed to be approximately <math id="A2.SS10.SSS1.Px1.p2.pic1.m2" class="ltx_Math" alttext="56\%" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">56</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="1.250em">%</mo></mrow><annotation encoding="application/x-tex">56\%</annotation></semantics></math> of the population.</span></span>
<span id="A2.SS10.SSS1.Px1.p2.pic1.2.5" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p2.pic1.2.5.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">We focus on the question of sex ratios and their dependence on local conditions, specifically for sea lampreys. Sea lampreys live in lake or sea habitats and migrate up rivers to spawn. The task is to examine the advantages and disadvantages of the ability for a species to alter its sex ratio depending on resource availability. Your team should develop and examine a model to provide insights into the resulting interactions in an ecosystem.</span></span>
<span id="A2.I38" class="ltx_enumerate">
<span id="A2.I38.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="A2.I38.i1.p1" class="ltx_para">
<span id="A2.I38.i1.p1.1" class="ltx_p"><span id="A2.I38.i1.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">What is the impact on the larger ecological system when the population of lampreys can alter its sex ratio?</span></span>
</span></span>
<span id="A2.I38.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<span id="A2.I38.i2.p1" class="ltx_para">
<span id="A2.I38.i2.p1.1" class="ltx_p"><span id="A2.I38.i2.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">What are the advantages and disadvantages to the population of lampreys?</span></span>
</span></span>
<span id="A2.I38.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<span id="A2.I38.i3.p1" class="ltx_para">
<span id="A2.I38.i3.p1.1" class="ltx_p"><span id="A2.I38.i3.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">What is the impact on the stability of the ecosystem given the changes in the sex ratios of lampreys?</span></span>
</span></span>
</span><span class="ltx_inline-block"><svg id="A2.SS10.SSS1.Px1.p2.pic1.pic1" class="ltx_picture" color="#FF0000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 0 L 15.75 15.75 M 0 15.75 L 15.75 0"></path></g></svg></span>
<span id="A2.SS10.SSS1.Px1.p2.pic1.2.6" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p2.pic1.2.6.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;">GPT-5 thinking failed</span></span>
<span id="A2.SS10.SSS1.Px1.p2.pic1.2.7" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p2.pic1.2.7.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Jiaxin Zhang</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS10.SSS1.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS10.SSS1.Px1.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS10.SSS1.Px1.p3" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p3.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p3.1.1" class="ltx_text">Executive summary</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p4" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p4.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p4.1.1" class="ltx_text">I build a **sex-structured, resource-coupled lamprey–prey model** that links (i) larval food availability to (ii) larval growth and the **male fraction** at adulthood, which then (iii) sets the **effective number of breeders** and (iv) feeds back to prey fish via parasitic mortality. Two robust takeaways:</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p5" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p5.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p5.1.1" class="ltx_text">* **Adaptive sex ratio is a built-in negative feedback**: when larval food is scarce, the male fraction rises (toward 0̃.78), which **reduces effective breeders** and throttles recruitment; when food is plentiful, the male fraction falls (toward 0̃.56), **raising effective breeders** and allowing growth. This self-regulation tends to **dampen boom–bust cycles** compared to a fixed sex ratio.
* **But over-sensitivity is risky**: prolonged male bias lowers effective population size <math id="A2.SS10.SSS1.Px1.p5.m1" class="ltx_Math" alttext="N_{e}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>e</mi></msub><annotation encoding="application/x-tex">N_{e}</annotation></semantics></math> and can create **mate limitation** (an Allee effect) at low abundance, raising extinction risk.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p6" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p6.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p6.1.1" class="ltx_text">Below is a compact model you can simulate and analyze. I end with answers to the three questions, sensitivity knobs, and management levers.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p7" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p7.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p7.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p8" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p8.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p8.1.1" class="ltx_text">Modeling assumptions (minimal, transparent)</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p9" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p9.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p9.1.1" class="ltx_text">1. Annual time-step, four state variables:</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p10" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p10.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p10.1.1" class="ltx_text">* <math id="A2.SS10.SSS1.Px1.p10.m1" class="ltx_Math" alttext="P_{t}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>t</mi></msub><annotation encoding="application/x-tex">P_{t}</annotation></semantics></math>: prey fish biomass (hosts) in lake/sea,
* <math id="A2.SS10.SSS1.Px1.p10.m2" class="ltx_Math" alttext="R_{t}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>t</mi></msub><annotation encoding="application/x-tex">R_{t}</annotation></semantics></math>: larval food resource (detritus/invertebrates) in streams,
* <math id="A2.SS10.SSS1.Px1.p10.m3" class="ltx_Math" alttext="L_{t}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>t</mi></msub><annotation encoding="application/x-tex">L_{t}</annotation></semantics></math>: lamprey larvae (ammocoetes),
* <math id="A2.SS10.SSS1.Px1.p10.m4" class="ltx_Math" alttext="A_{t}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>t</mi></msub><annotation encoding="application/x-tex">A_{t}</annotation></semantics></math>: total spawning adults returning to streams.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p11" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p11.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p11.1.1" class="ltx_text">2. **Larval food → growth → sex ratio**: higher <math id="A2.SS10.SSS1.Px1.p11.m1" class="ltx_Math" alttext="R_{t}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>t</mi></msub><annotation encoding="application/x-tex">R_{t}</annotation></semantics></math> raises larval growth <math id="A2.SS10.SSS1.Px1.p11.m2" class="ltx_Math" alttext="g(R_{t})" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(R_{t})</annotation></semantics></math> and **decreases** the male fraction <math id="A2.SS10.SSS1.Px1.p11.m3" class="ltx_Math" alttext="p_{m}(R_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{m}(R_{t})</annotation></semantics></math> (empirical range = 0.56–0.78).</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p12" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p12.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p12.1.1" class="ltx_text">3. Reproduction is **female-egg limited but mate-constrained**: effective breeders are well-approximated by a **harmonic-mean mating function**, maximizing at 1:1.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p13" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p13.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p13.1.1" class="ltx_text">4. Adults parasitize prey fish; prey follow logistic growth.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p14" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p14.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p14.1.1" class="ltx_text">5. Density dependence enters via resource depletion by larvae and parasitic mortality on prey.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p15" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p15.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p15.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p16" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p16.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p16.1.1" class="ltx_text">Variables, functions, parameters</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p17" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p17.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p17.1.1" class="ltx_text">* Male fraction (adaptive):</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p18" class="ltx_para">
<table id="A2.Ex309" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex309.m1" class="ltx_Math" alttext="p_{m}(R)=p_{\min}+(p_{\max}-p_{\min})\frac{h}{R+h},\qquad p_{\min}=0.56,\;p_{\max}=0.78,\;h&gt;0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>p</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>p</mi><mi>min</mi></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mi>max</mi></msub><mo>−</mo><msub><mi>p</mi><mi>min</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>h</mi><mrow><mi>R</mi><mo>+</mo><mi>h</mi></mrow></mfrac></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>p</mi><mi>min</mi></msub><mo>=</mo><mn>0.56</mn></mrow><mo rspace="0.447em">,</mo><mrow><msub><mi>p</mi><mi>max</mi></msub><mo>=</mo><mn>0.78</mn></mrow><mo rspace="0.447em">,</mo><mrow><mi>h</mi><mo>&gt;</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">p_{m}(R)=p_{\min}+(p_{\max}-p_{\min})\frac{h}{R+h},\qquad p_{\min}=0.56,\;p_{\max}=0.78,\;h&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS10.SSS1.Px1.p19" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p19.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p19.1.1" class="ltx_text">So <math id="A2.SS10.SSS1.Px1.p19.m1" class="ltx_Math" alttext="p_{m}\to 0.78" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>m</mi></msub><mo stretchy="false">→</mo><mn>0.78</mn></mrow><annotation encoding="application/x-tex">p_{m}\to 0.78</annotation></semantics></math> as <math id="A2.SS10.SSS1.Px1.p19.m2" class="ltx_Math" alttext="R\to 0" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">R\to 0</annotation></semantics></math> and <math id="A2.SS10.SSS1.Px1.p19.m3" class="ltx_Math" alttext="p_{m}\to 0.56" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>m</mi></msub><mo stretchy="false">→</mo><mn>0.56</mn></mrow><annotation encoding="application/x-tex">p_{m}\to 0.56</annotation></semantics></math> as <math id="A2.SS10.SSS1.Px1.p19.m4" class="ltx_Math" alttext="R\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">R\to\infty</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p20" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p20.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p20.1.1" class="ltx_text">* Larval growth &amp; maturation:</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p21" class="ltx_para">
<table id="A2.Ex310" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex310.m1" class="ltx_Math" alttext="g(R)=g_{\max}\frac{R}{R+K_{g}},\qquad m_{t}=\mu\,g(R_{t})\in(0,1)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>g</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mi>R</mi><mrow><mi>R</mi><mo>+</mo><msub><mi>K</mi><mi>g</mi></msub></mrow></mfrac></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>=</mo><mrow><mi>μ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">g(R)=g_{\max}\frac{R}{R+K_{g}},\qquad m_{t}=\mu\,g(R_{t})\in(0,1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS10.SSS1.Px1.p22" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p22.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p22.1.1" class="ltx_text">(matured fraction per year), with larval survival <math id="A2.SS10.SSS1.Px1.p22.m1" class="ltx_Math" alttext="s_{L}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>L</mi></msub><annotation encoding="application/x-tex">s_{L}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p23" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p23.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p23.1.1" class="ltx_text">* Effective breeders (harmonic-mean mating function): with total adults <math id="A2.SS10.SSS1.Px1.p23.m1" class="ltx_Math" alttext="A_{t}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>t</mi></msub><annotation encoding="application/x-tex">A_{t}</annotation></semantics></math>, males <math id="A2.SS10.SSS1.Px1.p23.m2" class="ltx_Math" alttext="M_{t}=p_{m}(R_{t-\ell})A_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>p</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mrow><mi>t</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">M_{t}=p_{m}(R_{t-\ell})A_{t}</annotation></semantics></math> and females <math id="A2.SS10.SSS1.Px1.p23.m3" class="ltx_Math" alttext="F_{t}^{(f)}=(1-p_{m})A_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>F</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>p</mi><mi>m</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">F_{t}^{(f)}=(1-p_{m})A_{t}</annotation></semantics></math>,</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p24" class="ltx_para">
<table id="A2.Ex311" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex311.m1" class="ltx_Math" alttext="B_{t}=\frac{2\,M_{t}\,F_{t}^{(f)}}{M_{t}+F_{t}^{(f)}}=2A_{t}\,p_{m}(R_{t-\ell})\big(1-p_{m}(R_{t-\ell})\big)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mi>t</mi></msub><mo>=</mo><mfrac><mrow><mn>2</mn><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>M</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mrow><msub><mi>M</mi><mi>t</mi></msub><mo>+</mo><msubsup><mi>F</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mrow><mi>t</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>p</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mrow><mi>t</mi><mo>−</mo><mi mathvariant="normal">ℓ</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">B_{t}=\frac{2\,M_{t}\,F_{t}^{(f)}}{M_{t}+F_{t}^{(f)}}=2A_{t}\,p_{m}(R_{t-\ell})\big(1-p_{m}(R_{t-\ell})\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS10.SSS1.Px1.p25" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p25.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p25.1.1" class="ltx_text">which is maximized at <math id="A2.SS10.SSS1.Px1.p25.m1" class="ltx_Math" alttext="p_{m}=\tfrac{1}{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>m</mi></msub><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">p_{m}=\tfrac{1}{2}</annotation></semantics></math>.
Note the **penalty term** <math id="A2.SS10.SSS1.Px1.p25.m2" class="ltx_Math" alttext="2p(1-p)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">2p(1-p)</annotation></semantics></math> equals <math id="A2.SS10.SSS1.Px1.p25.m3" class="ltx_Math" alttext="0.343" display="inline" intent=":literal"><semantics><mn>0.343</mn><annotation encoding="application/x-tex">0.343</annotation></semantics></math> at <math id="A2.SS10.SSS1.Px1.p25.m4" class="ltx_Math" alttext="p=0.78" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0.78</mn></mrow><annotation encoding="application/x-tex">p=0.78</annotation></semantics></math> and <math id="A2.SS10.SSS1.Px1.p25.m5" class="ltx_Math" alttext="0.493" display="inline" intent=":literal"><semantics><mn>0.493</mn><annotation encoding="application/x-tex">0.493</annotation></semantics></math> at <math id="A2.SS10.SSS1.Px1.p25.m6" class="ltx_Math" alttext="p=0.56" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mn>0.56</mn></mrow><annotation encoding="application/x-tex">p=0.56</annotation></semantics></math> (=30</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p26" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p26.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p26.1.1" class="ltx_text">* Adult fecundity and viability depend on host abundance <math id="A2.SS10.SSS1.Px1.p26.m1" class="ltx_Math" alttext="P_{t}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>t</mi></msub><annotation encoding="application/x-tex">P_{t}</annotation></semantics></math>:</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p27" class="ltx_para">
<table id="A2.Ex312" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex312.m1" class="ltx_Math" alttext="f(P)=\frac{P}{P+K_{f}}\in(0,1)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mi>P</mi><mrow><mi>P</mi><mo>+</mo><msub><mi>K</mi><mi>f</mi></msub></mrow></mfrac><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(P)=\frac{P}{P+K_{f}}\in(0,1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS10.SSS1.Px1.p28" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p28.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p28.1.1" class="ltx_text">* Prey dynamics (logistic with parasitism):</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p29" class="ltx_para">
<table id="A2.Ex313" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex313.m1" class="ltx_Math" alttext="P_{t+1}=P_{t}+rP_{t}\!\left(1-\frac{P_{t}}{K}\right)-\alpha A_{t}\frac{P_{t}}{P_{t}+H}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><msub><mi>P</mi><mi>t</mi></msub><mo>+</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><msub><mi>P</mi><mi>t</mi></msub><mi>K</mi></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>P</mi><mi>t</mi></msub><mrow><msub><mi>P</mi><mi>t</mi></msub><mo>+</mo><mi>H</mi></mrow></mfrac></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{t+1}=P_{t}+rP_{t}\!\left(1-\frac{P_{t}}{K}\right)-\alpha A_{t}\frac{P_{t}}{P_{t}+H}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS10.SSS1.Px1.p30" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p30.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p30.1.1" class="ltx_text">* Resource dynamics (replenishment minus larval consumption):</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p31" class="ltx_para">
<table id="A2.Ex314" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex314.m1" class="ltx_Math" alttext="R_{t+1}=R_{t}+\rho(R_{\max}-R_{t})-c_{L}L_{t}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><msub><mi>R</mi><mi>t</mi></msub><mo>+</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>R</mi><mi>max</mi></msub><mo>−</mo><msub><mi>R</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>c</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>t</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R_{t+1}=R_{t}+\rho(R_{\max}-R_{t})-c_{L}L_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS10.SSS1.Px1.p32" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p32.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p32.1.1" class="ltx_text">* Lamprey demography:</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p33" class="ltx_para">
<table id="A2.Ex315" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex315X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex315X.m2" class="ltx_Math" alttext="\displaystyle L_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle L_{t+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex315X.m3" class="ltx_Math" alttext="\displaystyle=s_{A}\,b\,f(P_{t})\,B_{t}\;\;-\;\;(m_{t}+d_{L})L_{t}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>s</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>B</mi><mi>t</mi></msub></mrow><mo rspace="0.782em">−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>m</mi><mi>t</mi></msub><mo>+</mo><msub><mi>d</mi><mi>L</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>t</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=s_{A}\,b\,f(P_{t})\,B_{t}\;\;-\;\;(m_{t}+d_{L})L_{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex315Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex315Xa.m2" class="ltx_Math" alttext="\displaystyle A_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle A_{t+1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex315Xa.m3" class="ltx_Math" alttext="\displaystyle=s_{L}\,m_{t}\,L_{t}\;\;-\;\;d_{A}A_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>s</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>m</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>t</mi></msub></mrow><mo rspace="0.782em">−</mo><mrow><msub><mi>d</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>t</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=s_{L}\,m_{t}\,L_{t}\;\;-\;\;d_{A}A_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS10.SSS1.Px1.p34" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p34.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p34.1.1" class="ltx_text">**Parameters:** <math id="A2.SS10.SSS1.Px1.p34.m1" class="ltx_Math" alttext="r,K" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>,</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">r,K</annotation></semantics></math> (prey), <math id="A2.SS10.SSS1.Px1.p34.m2" class="ltx_Math" alttext="\alpha,H" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>,</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">\alpha,H</annotation></semantics></math> (parasitism), <math id="A2.SS10.SSS1.Px1.p34.m3" class="ltx_Math" alttext="\rho,R_{\max},c_{L}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>,</mo><msub><mi>R</mi><mi>max</mi></msub><mo>,</mo><msub><mi>c</mi><mi>L</mi></msub></mrow><annotation encoding="application/x-tex">\rho,R_{\max},c_{L}</annotation></semantics></math> (resource), <math id="A2.SS10.SSS1.Px1.p34.m4" class="ltx_Math" alttext="g_{\max},K_{g},\mu,s_{L},s_{A},b,d_{L},d_{A}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>max</mi></msub><mo>,</mo><msub><mi>K</mi><mi>g</mi></msub><mo>,</mo><mi>μ</mi><mo>,</mo><msub><mi>s</mi><mi>L</mi></msub><mo>,</mo><msub><mi>s</mi><mi>A</mi></msub><mo>,</mo><mi>b</mi><mo>,</mo><msub><mi>d</mi><mi>L</mi></msub><mo>,</mo><msub><mi>d</mi><mi>A</mi></msub></mrow><annotation encoding="application/x-tex">g_{\max},K_{g},\mu,s_{L},s_{A},b,d_{L},d_{A}</annotation></semantics></math> (life history), and <math id="A2.SS10.SSS1.Px1.p34.m5" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> (sex-ratio sensitivity).</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p35" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p35.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p35.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p36" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p36.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p36.1.1" class="ltx_text">What the model shows (analysis &amp; intuition)</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p37" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p37.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p37.1.1" class="ltx_text">1) Reproductive number and feedback</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p38" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p38.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p38.1.1" class="ltx_text">Linearizing near an interior equilibrium <math id="A2.SS10.SSS1.Px1.p38.m1" class="ltx_Math" alttext="(P^{*},R^{*},L^{*},A^{*})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>R</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>L</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>A</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(P^{*},R^{*},L^{*},A^{*})</annotation></semantics></math>, the **per-adult replacement factor** contains</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p39" class="ltx_para">
<table id="A2.Ex316" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex316.m1" class="ltx_Math" alttext="\mathcal{R}\;\propto\;s_{A}\,b\,f(P^{*})\cdot\underbrace{2p^{*}(1-p^{*})}_{\text{sex-ratio penalty}}\cdot s_{L}\,m(R^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo lspace="0.558em" rspace="0.558em">∝</mo><mrow><mrow><msub><mi>s</mi><mi>A</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>∗</mo></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><munder><munder accentunder="true"><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>p</mi><mo>∗</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>sex-ratio penalty</mtext></munder><mo rspace="0.222em">⋅</mo><mrow><msub><mi>s</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{R}\;\propto\;s_{A}\,b\,f(P^{*})\cdot\underbrace{2p^{*}(1-p^{*})}_{\text{sex-ratio penalty}}\cdot s_{L}\,m(R^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS10.SSS1.Px1.p40" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p40.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p40.1.1" class="ltx_text">Because <math id="A2.SS10.SSS1.Px1.p40.m1" class="ltx_Math" alttext="p^{*}=p_{m}(R^{*})" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>∗</mo></msup><mo>=</mo><mrow><msub><mi>p</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p^{*}=p_{m}(R^{*})</annotation></semantics></math> **decreases with <math id="A2.SS10.SSS1.Px1.p40.m2" class="ltx_Math" alttext="R^{*}" display="inline" intent=":literal"><semantics><msup><mi>R</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">R^{*}</annotation></semantics></math>** and <math id="A2.SS10.SSS1.Px1.p40.m3" class="ltx_Math" alttext="m(R^{*})" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>R</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">m(R^{*})</annotation></semantics></math> **increases with <math id="A2.SS10.SSS1.Px1.p40.m4" class="ltx_Math" alttext="R^{*}" display="inline" intent=":literal"><semantics><msup><mi>R</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">R^{*}</annotation></semantics></math>**, the composite <math id="A2.SS10.SSS1.Px1.p40.m5" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math> rises with good conditions and falls with poor conditions. When **resources crash**, <math id="A2.SS10.SSS1.Px1.p40.m6" class="ltx_Math" alttext="p^{*}\uparrow" display="inline" intent=":literal"><semantics><mrow><msup><mi>p</mi><mo>∗</mo></msup><mo stretchy="false">↑</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">p^{*}\uparrow</annotation></semantics></math> (more males), so <math id="A2.SS10.SSS1.Px1.p40.m7" class="ltx_Math" alttext="2p^{*}(1-p^{*})\downarrow" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>p</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>p</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↓</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">2p^{*}(1-p^{*})\downarrow</annotation></semantics></math>, which **drops <math id="A2.SS10.SSS1.Px1.p40.m8" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math>** even faster than maturation alone would—**a stabilizing negative feedback** that prevents runaway overshoot on hosts.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p41" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p41.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p41.1.1" class="ltx_text">2) Stability (qualitative)</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p42" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p42.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p42.1.1" class="ltx_text">* With a **fixed** sex ratio (no feedback), classical predator–prey structure easily yields **sustained cycles**.
* With **adaptive sex ratio**, the extra negative feedback often **shrinks the cycle amplitude** or produces a **stable focus** over a broad parameter set (Routh–Hurwitz conditions improve because a strongly positive cross-partial is replaced by a negative one via <math id="A2.SS10.SSS1.Px1.p42.m1" class="ltx_Math" alttext="p_{m}^{\prime}(R)&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>p</mi><mi>m</mi><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{m}^{\prime}(R)&lt;0</annotation></semantics></math>).
* If <math id="A2.SS10.SSS1.Px1.p42.m2" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> is **too small** (hypersensitive sex-ratio shift), long periods of low <math id="A2.SS10.SSS1.Px1.p42.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> → extreme male bias → **mate limitation**: <math id="A2.SS10.SSS1.Px1.p42.m4" class="ltx_Math" alttext="2p(1-p)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">2p(1-p)</annotation></semantics></math> becomes small enough to create an **Allee threshold** for <math id="A2.SS10.SSS1.Px1.p42.m5" class="ltx_Math" alttext="A_{t}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>t</mi></msub><annotation encoding="application/x-tex">A_{t}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p43" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p43.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p43.1.1" class="ltx_text">3) Ecosystem-level effects</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p44" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p44.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p44.1.1" class="ltx_text">* **On hosts (prey fish):** adaptive sex ratio lowers peak lamprey recruitment after resource dips, **relieving host pressure** and reducing the risk of prey collapse. Under chronic eutrophication (high <math id="A2.SS10.SSS1.Px1.p44.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>), the system drifts toward 0̃.56 male fraction, **raising breeders** and potentially **increasing average lamprey pressure** on hosts.
* **On variance:** adaptive sex ratio generally **reduces variance** in both lamprey and host biomasses, improving predictability—except under very strong sensitivity where male bias sticks and <math id="A2.SS10.SSS1.Px1.p44.m2" class="ltx_Math" alttext="N_{e}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>e</mi></msub><annotation encoding="application/x-tex">N_{e}</annotation></semantics></math> collapses.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p45" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p45.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p45.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p46" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p46.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p46.1.1" class="ltx_text">Advantages vs. disadvantages for lampreys</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p47" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p47.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p47.1.1" class="ltx_text">**Advantages**</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p48" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p48.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p48.1.1" class="ltx_text">* **Buffering:** Recruitment naturally scales to food via sex ratio → fewer starving juveniles, less wasted investment.
* **Cycle damping:** Smaller booms reduce the severity of subsequent busts; lower extinction risk from resource whiplash.
* **Energy economics:** When food is poor, producing relatively more (energetically cheaper) males can be advantageous until conditions improve.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p49" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p49.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p49.1.1" class="ltx_text">**Disadvantages**</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p50" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p50.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p50.1.1" class="ltx_text">* **Mate limitation &amp; Allee risk:** Prolonged male bias depresses <math id="A2.SS10.SSS1.Px1.p50.m1" class="ltx_Math" alttext="2p(1-p)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">2p(1-p)</annotation></semantics></math>, reducing effective breeders and slowing recovery from lows.
* **Genetic concerns:** Lower effective population size <math id="A2.SS10.SSS1.Px1.p50.m2" class="ltx_Math" alttext="N_{e}=\frac{4N_{m}N_{f}}{N_{m}+N_{f}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>e</mi></msub><mo>=</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>N</mi><mi>f</mi></msub></mrow><mrow><msub><mi>N</mi><mi>m</mi></msub><mo>+</mo><msub><mi>N</mi><mi>f</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">N_{e}=\frac{4N_{m}N_{f}}{N_{m}+N_{f}}</annotation></semantics></math> under skewed sex ratios raises drift/inbreeding risk.
* **Management vulnerability:** If managers manipulate <math id="A2.SS10.SSS1.Px1.p50.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> (or equivalent) to bias sex ratios, populations could be steered into chronic low-recruitment regimes.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p51" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p51.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p51.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p52" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p52.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p52.1.1" class="ltx_text">Scenario experiments to run (quick to implement)</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p53" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p53.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p53.1.1" class="ltx_text">1. **Fixed vs adaptive sex ratio:** Replace <math id="A2.SS10.SSS1.Px1.p53.m1" class="ltx_Math" alttext="p_{m}(R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{m}(R)</annotation></semantics></math> by constants <math id="A2.SS10.SSS1.Px1.p53.m2" class="ltx_Math" alttext="\{0.56,0.67,0.78,0.5\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>0.56</mn><mo>,</mo><mn>0.67</mn><mo>,</mo><mn>0.78</mn><mo>,</mo><mn>0.5</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0.56,0.67,0.78,0.5\}</annotation></semantics></math> and compare equilibrium/oscillation amplitude and host minima.
2. **Sensitivity <math id="A2.SS10.SSS1.Px1.p53.m3" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>:** Sweep <math id="A2.SS10.SSS1.Px1.p53.m4" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> to see when damping flips to Allee dynamics; record extinction frequency under stochastic <math id="A2.SS10.SSS1.Px1.p53.m5" class="ltx_Math" alttext="R_{t}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>t</mi></msub><annotation encoding="application/x-tex">R_{t}</annotation></semantics></math>.
3. **Nutrient regimes:** Shift <math id="A2.SS10.SSS1.Px1.p53.m6" class="ltx_Math" alttext="R_{\max}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>max</mi></msub><annotation encoding="application/x-tex">R_{\max}</annotation></semantics></math> (oligotrophic → eutrophic) to evaluate average male fraction, mean host biomass, and parasitism burden.
4. **Harvest/Control:** Remove a fraction of adults (or larvae) and compare outcomes under fixed vs. adaptive sex ratios.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p54" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p54.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p54.1.1" class="ltx_text">**Key metrics:** average <math id="A2.SS10.SSS1.Px1.p54.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, minimum <math id="A2.SS10.SSS1.Px1.p54.m2" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>, CVs of <math id="A2.SS10.SSS1.Px1.p54.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="A2.SS10.SSS1.Px1.p54.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>; mean <math id="A2.SS10.SSS1.Px1.p54.m5" class="ltx_Math" alttext="p_{m}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>m</mi></msub><annotation encoding="application/x-tex">p_{m}</annotation></semantics></math>; <math id="A2.SS10.SSS1.Px1.p54.m6" class="ltx_Math" alttext="N_{e}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>e</mi></msub><annotation encoding="application/x-tex">N_{e}</annotation></semantics></math>; extinction probability over 100-year runs.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p55" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p55.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p55.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p56" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p56.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p56.1.1" class="ltx_text">Management / policy levers (derived from the model)</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p57" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p57.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p57.1.1" class="ltx_text">* **To protect hosts (e.g., fisheries):**
Reduce larval food <math id="A2.SS10.SSS1.Px1.p57.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> (habitat restoration that lowers autochthonous detritus; targeted larval control). This pushes <math id="A2.SS10.SSS1.Px1.p57.m2" class="ltx_Math" alttext="p_{m}\uparrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>m</mi></msub><mo stretchy="false">↑</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">p_{m}\uparrow</annotation></semantics></math> → **fewer effective breeders** and lower lamprey pressure.
* **To conserve lampreys (if desired):**
Improve <math id="A2.SS10.SSS1.Px1.p57.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> moderately, but **avoid extremes** that create host crashes or strong cycles.
* **Robustness:** Avoid a sex-ratio sensitivity that is too sharp (very small <math id="A2.SS10.SSS1.Px1.p57.m4" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math>); otherwise mate limitation risks rise under drought/low <math id="A2.SS10.SSS1.Px1.p57.m5" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p58" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p58.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p58.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p59" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p59.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p59.1.1" class="ltx_text">Direct answers to the three questions</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p60" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p60.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p60.1.1" class="ltx_text">1. **Impact on the larger ecological system**
Adaptive sex ratio introduces **resource-tracking reproduction** in lampreys. It **buffers host fish** against over-parasitism after poor years (stabilizing) but can **raise average parasitism** in persistently nutrient-rich systems (destabilizing for hosts). Net effect: **reduced cycle amplitude** and **higher resilience** across typical conditions; possible **higher pressure** on hosts under chronic high <math id="A2.SS10.SSS1.Px1.p60.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p61" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p61.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p61.1.1" class="ltx_text">2. **Advantages and disadvantages to lampreys**
**Pros:** automatic scaling of recruitment to conditions, lower variance and starvation, better long-term persistence.
**Cons:** when food stays low, male bias lowers effective breeders and <math id="A2.SS10.SSS1.Px1.p61.m1" class="ltx_Math" alttext="N_{e}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>e</mi></msub><annotation encoding="application/x-tex">N_{e}</annotation></semantics></math>, creating **Allee-type risks** and slowing recovery; higher genetic drift.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p62" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p62.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p62.1.1" class="ltx_text">3. **Impact on ecosystem stability**
Generally **stabilizing** via an extra **negative feedback loop** (low <math id="A2.SS10.SSS1.Px1.p62.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> → male-skew → low <math id="A2.SS10.SSS1.Px1.p62.m2" class="ltx_Math" alttext="B_{t}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi>t</mi></msub><annotation encoding="application/x-tex">B_{t}</annotation></semantics></math> → lower <math id="A2.SS10.SSS1.Px1.p62.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> → host recovery → <math id="A2.SS10.SSS1.Px1.p62.m4" class="ltx_Math" alttext="R\uparrow" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">↑</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">R\uparrow</annotation></semantics></math>). Stability improves unless the sex-ratio response is **too strong**, which can introduce **bistability/thresholds** (mate limitation).</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p63" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p63.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p63.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p64" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p64.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p64.1.1" class="ltx_text">Notes if you want to simulate</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p65" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p65.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p65.1.1" class="ltx_text">Use the discrete system above; set a baseline (e.g., <math id="A2.SS10.SSS1.Px1.p65.m1" class="ltx_Math" alttext="r=0.6,K=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>=</mo><mn>0.6</mn></mrow><mo>,</mo><mrow><mi>K</mi><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">r=0.6,K=1</annotation></semantics></math>, <math id="A2.SS10.SSS1.Px1.p65.m2" class="ltx_Math" alttext="g_{\max}=0.7,K_{g}=0.2,\mu=0.9,s_{L}=0.6,d_{A}=0.5,d_{L}=0.3" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mi>max</mi></msub><mo>=</mo><mn>0.7</mn></mrow><mo>,</mo><mrow><msub><mi>K</mi><mi>g</mi></msub><mo>=</mo><mn>0.2</mn></mrow><mo>,</mo><mrow><mi>μ</mi><mo>=</mo><mn>0.9</mn></mrow><mo>,</mo><mrow><msub><mi>s</mi><mi>L</mi></msub><mo>=</mo><mn>0.6</mn></mrow><mo>,</mo><mrow><msub><mi>d</mi><mi>A</mi></msub><mo>=</mo><mn>0.5</mn></mrow><mo>,</mo><mrow><msub><mi>d</mi><mi>L</mi></msub><mo>=</mo><mn>0.3</mn></mrow></mrow><annotation encoding="application/x-tex">g_{\max}=0.7,K_{g}=0.2,\mu=0.9,s_{L}=0.6,d_{A}=0.5,d_{L}=0.3</annotation></semantics></math>, <math id="A2.SS10.SSS1.Px1.p65.m3" class="ltx_Math" alttext="b=2000,s_{A}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>=</mo><mn>2000</mn></mrow><mo>,</mo><msub><mi>s</mi><mi>A</mi></msub></mrow><annotation encoding="application/x-tex">b=2000,s_{A}</annotation></semantics></math> small so the product is order-1 at equilibrium; <math id="A2.SS10.SSS1.Px1.p65.m4" class="ltx_Math" alttext="R_{\max}=1,\rho=0.6,c_{L}=10^{-5},\alpha=0.3,H=0.2,h=0.2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>max</mi></msub><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>ρ</mi><mo>=</mo><mn>0.6</mn></mrow><mo>,</mo><mrow><msub><mi>c</mi><mi>L</mi></msub><mo>=</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><mo>,</mo><mrow><mi>α</mi><mo>=</mo><mn>0.3</mn></mrow><mo>,</mo><mrow><mi>H</mi><mo>=</mo><mn>0.2</mn></mrow><mo>,</mo><mrow><mi>h</mi><mo>=</mo><mn>0.2</mn></mrow></mrow><annotation encoding="application/x-tex">R_{\max}=1,\rho=0.6,c_{L}=10^{-5},\alpha=0.3,H=0.2,h=0.2</annotation></semantics></math>).
Track <math id="A2.SS10.SSS1.Px1.p65.m5" class="ltx_Math" alttext="2p(1-p)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>p</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">2p(1-p)</annotation></semantics></math> as the “mating penalty” and compare **adaptive vs. fixed** <math id="A2.SS10.SSS1.Px1.p65.m6" class="ltx_Math" alttext="p_{m}" display="inline" intent=":literal"><semantics><msub><mi>p</mi><mi>m</mi></msub><annotation encoding="application/x-tex">p_{m}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p66" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p66.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p66.1.1" class="ltx_text">If you want, I can spin up a quick Python notebook to run these scenarios and plot **cycle amplitudes, host minima, and extinction probabilities**.</span></p>
</div>
<div id="A2.SS10.SSS1.Px1.p67" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p67.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p67.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS10.SSS1.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS10.SSS1.Px1.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS10.SSS1.Px1.p68" class="ltx_para">
<ul id="A2.I39" class="ltx_itemize">
<li id="A2.I39.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I39.i1.p1" class="ltx_para">
<p id="A2.I39.i1.p1.1" class="ltx_p">For the first question, we can construct a sex-ratio model that accounts for how resource availability affects the growth rates of female and male sea lampreys, then couple it to an ecosystem-dynamics model to study how shifts in the sex ratio impact the overall ecosystem.</p>
</div></li>
<li id="A2.I39.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I39.i2.p1" class="ltx_para">
<p id="A2.I39.i2.p1.1" class="ltx_p">For the second question, we would analyze the survival advantages and disadvantages of females versus males under varying sex ratios—this likely requires building a survival-rate model which, together with the resource-utilization model, examines each sex’s strategy under different resource conditions.</p>
</div></li>
<li id="A2.I39.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I39.i3.p1" class="ltx_para">
<p id="A2.I39.i3.p1.1" class="ltx_p">For the third question, we must develop an ecosystem-stability model that incorporates the effects of sex-ratio changes on food-chain structure and biodiversity, and then use numerical simulations to explore how different sex ratios influence the system’s stability.</p>
</div></li>
</ul>
</div>
<div id="A2.SS10.SSS1.Px1.p69" class="ltx_para">
<p id="A2.SS10.SSS1.Px1.p69.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p69.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS10.SSS1.Px1.p70" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS10.SSS1.Px1.p70.pic1" class="ltx_picture" height="136.04" overflow="visible" version="1.1" viewBox="0 0 429.64 136.04" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,136.04) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 131.41 C 0 133.97 2.07 136.04 4.63 136.04 L 425.01 136.04 C 427.56 136.04 429.64 133.97 429.64 131.41 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 117.18 L 428.94 117.18 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 121.8)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS10.SSS1.Px1.p70.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS10.SSS1.Px1.p70.pic1.1.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p70.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Rubric</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:6.56em;--ltx-fo-depth:0.16em;font-size:10pt;" height="92.86" overflow="visible" transform="matrix(1 0 0 -1 0 90.71)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS10.SSS1.Px1.p70.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS10.SSS1.Px1.p70.pic1.2.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p70.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Got 1 point if Problem 1’s sex-ratio model and its coupling to the lamprey life-stage submodel are correctly specified.
<br class="ltx_break">Got 1 point if Problem 2’s survival-rate model and resource-feedback mechanism are correctly formulated.
<br class="ltx_break">Got 1 point if Problem 3’s ecosystem-stability model and numerical simulation setup are correctly described.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS10.SSS1.Px1.p71" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS10.SSS1.Px1.p71.pic1" class="ltx_picture" height="54.13" overflow="visible" version="1.1" viewBox="0 0 429.64 54.13" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,54.13) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#5A996B;" fill="#5A996B" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 49.51 C 0 52.06 2.07 54.13 4.63 54.13 L 425.01 54.13 C 427.56 54.13 429.64 52.06 429.64 49.51 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F6FFF9;" fill="#F6FFF9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 35.38 L 428.94 35.38 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 40.01)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS10.SSS1.Px1.p71.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS10.SSS1.Px1.p71.pic1.1.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p71.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Score</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS10.SSS1.Px1.p71.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS10.SSS1.Px1.p71.pic1.2.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p71.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">2/3</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS10.SSS1.Px1.p72" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS10.SSS1.Px1.p72.pic1" class="ltx_picture" height="333.14" overflow="visible" version="1.1" viewBox="0 0 429.64 333.14" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,333.14) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 328.51 C 0 331.07 2.07 333.14 4.63 333.14 L 425.01 333.14 C 427.56 333.14 429.64 331.07 429.64 328.51 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 314.28 L 428.94 314.28 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 318.9)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS10.SSS1.Px1.p72.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS10.SSS1.Px1.p72.pic1.1.1" class="ltx_p"><span id="A2.SS10.SSS1.Px1.p72.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 280.94)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:1.56em;--ltx-fo-depth:19.4em;font-size:10pt;" height="289.97" overflow="visible" transform="matrix(1 0 0 -1 0 21.52)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS10.SSS1.Px1.p72.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.I40" class="ltx_enumerate">
<span id="A2.I40.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="A2.I40.i1.p1" class="ltx_para">
<span id="A2.I40.i1.p1.1" class="ltx_p"><span id="A2.I40.i1.p1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#000000;">Sex-ratio–resource–ecosystem coupled model.</span><span id="A2.I40.i1.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">
A resource-driven framework has been established where maturation rates are determined by resource availability and translated into sex-ratio outcomes through a threshold mechanism.</span></span>
</span></span>
<span id="A2.I40.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<span id="A2.I40.i2.p1" class="ltx_para">
<span id="A2.I40.i2.p1.1" class="ltx_p"><span id="A2.I40.i2.p1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#000000;">Female vs. male survival under different sex ratios.</span><span id="A2.I40.i2.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">
Population-level trade-offs, such as buffering effects versus mate limitation and Allee risks, have been discussed.
</span><em id="A2.I40.i2.p1.1.3" class="ltx_emph ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Limitation:</em><span id="A2.I40.i2.p1.1.4" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> An explicit sex-specific survival model has not yet been constructed, leaving unaddressed how differential survival between females and males alters these trade-offs.</span></span>
</span></span>
<span id="A2.I40.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<span id="A2.I40.i3.p1" class="ltx_para">
<span id="A2.I40.i3.p1.1" class="ltx_p"><span id="A2.I40.i3.p1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#000000;">Ecosystem stability and biodiversity.</span><span id="A2.I40.i3.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">
Local stability intuition and numerical scenarios have been provided, focusing on the host fish–lamprey–resource system.
</span><em id="A2.I40.i3.p1.1.3" class="ltx_emph ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Limitation:</em><span id="A2.I40.i3.p1.1.4" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> The trophic scope remains narrow, excluding broader food-web and biodiversity structures, and therefore does not fully capture ecosystem-level stability and feedback mechanisms.</span></span>
</span></span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
</section>
</section>
<section id="A2.SS11" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">11 </span>Generalization</h3>

<section id="A2.SS11.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">(a) </span>Identifying patterns from examples</h4>

<section id="A2.SS11.SSS1.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#FF0000;">Problem 11a1 </h5>

<div id="A2.SS11.SSS1.Px1.p1" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p1.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS11.SSS1.Px1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS11.SSS1.Px1.p2.pic1" class="ltx_picture" height="232.54" overflow="visible" version="1.1" viewBox="0 0 429.64 232.54" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,232.54) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 227.91 C 0 230.46 2.07 232.54 4.63 232.54 L 425.01 232.54 C 427.56 232.54 429.64 230.46 429.64 227.91 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 213.67 L 428.94 213.67 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 218.3)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS1.Px1.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS11.SSS1.Px1.p2.pic1.1.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:13.53em;--ltx-fo-depth:0.16em;font-size:10pt;" height="189.36" overflow="visible" transform="matrix(1 0 0 -1 0 187.21)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS1.Px1.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS11.SSS1.Px1.p2.pic1.2.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Find the smallest positive integer <math id="A2.SS11.SSS1.Px1.p2.pic1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> such that for every <math id="A2.SS11.SSS1.Px1.p2.pic1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-element subset <math id="A2.SS11.SSS1.Px1.p2.pic1.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> of the set</span></span>
<span id="A2.Ex317" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex317.m1" class="ltx_Math" alttext="S=\{1,2,\dots,2012\}," display="block" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">S</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" mathvariant="normal">…</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2012</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo></mrow><annotation encoding="application/x-tex">S=\{1,2,\dots,2012\},</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A2.SS11.SSS1.Px1.p2.pic1.2.2" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">there exist three <span id="A2.SS11.SSS1.Px1.p2.pic1.2.2.1.1" class="ltx_text ltx_font_bold">distinct</span> elements <math id="A2.SS11.SSS1.Px1.p2.pic1.m4" class="ltx_Math" alttext="a,b,c\in S" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi></mrow></mrow><annotation encoding="application/x-tex">a,b,c\in S</annotation></semantics></math> such that all three sums</span></span>
<span id="A2.Ex318" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex318.m1" class="ltx_Math" alttext="a+b,\hskip 8.50012ptb+c,\hskip 8.50012ptc+a" display="block" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="1.017em">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">c</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="1.017em">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">a</mi></mrow></mrow><annotation encoding="application/x-tex">a+b,\hskip 8.50012ptb+c,\hskip 8.50012ptc+a</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A2.SS11.SSS1.Px1.p2.pic1.2.3" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p2.pic1.2.3.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">are contained in <math id="A2.SS11.SSS1.Px1.p2.pic1.m5" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>. Try small cases to find a pattern then prove your conjecture.</span></span><span class="ltx_inline-block"><svg id="A2.SS11.SSS1.Px1.p2.pic1.pic1" class="ltx_picture" color="#FF0000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 0 L 15.75 15.75 M 0 15.75 L 15.75 0"></path></g></svg></span>
<span id="A2.SS11.SSS1.Px1.p2.pic1.2.4" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p2.pic1.2.4.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;">GPT-5 thinking failed</span></span>
<span id="A2.SS11.SSS1.Px1.p2.pic1.2.5" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p2.pic1.2.5.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Jiaxin Zhang</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS11.SSS1.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS11.SSS1.Px1.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS11.SSS1.Px1.p3" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p3.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p3.1.1" class="ltx_text">The smallest such <math id="A2.SS11.SSS1.Px1.p3.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is <math id="A2.SS11.SSS1.Px1.p3.m2" class="ltx_Math" alttext="\boxed{31}" display="inline" intent=":literal"><semantics><menclose notation="box"><mn>31</mn></menclose><annotation encoding="application/x-tex">\boxed{31}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS11.SSS1.Px1.p4" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p4.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p4.1.1" class="ltx_text ltx_font_bold">Step 1: Reformulation via same-parity strict triangles.<span id="A2.SS11.SSS1.Px1.p4.1.1.1" class="ltx_text ltx_font_medium">
Suppose <math id="A2.SS11.SSS1.Px1.p4.m1" class="ltx_Math" alttext="x,y,z\in A" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mrow><mi>z</mi><mo>∈</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">x,y,z\in A</annotation></semantics></math> are <em id="A2.SS11.SSS1.Px1.p4.1.1.1.1" class="ltx_emph ltx_font_italic">distinct</em> and have the same parity, and satisfy the strict triangle inequalities</span></span></p>
<table id="A2.Ex319" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex319.m1" class="ltx_Math" alttext="x&lt;y+z,\qquad y&lt;z+x,\qquad z&lt;x+y." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>x</mi><mo>&lt;</mo><mrow><mi>y</mi><mo>+</mo><mi>z</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>y</mi><mo>&lt;</mo><mrow><mi>z</mi><mo>+</mo><mi>x</mi></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>z</mi><mo>&lt;</mo><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x&lt;y+z,\qquad y&lt;z+x,\qquad z&lt;x+y.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p4.2" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p4.2.1" class="ltx_text">Then</span></p>
<table id="A2.Ex320" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex320.m1" class="ltx_Math" alttext="a=\frac{y+z-x}{2},\qquad b=\frac{z+x-y}{2},\qquad c=\frac{x+y-z}{2}" display="block" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>=</mo><mfrac><mrow><mrow><mi>y</mi><mo>+</mo><mi>z</mi></mrow><mo>−</mo><mi>x</mi></mrow><mn>2</mn></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><mi>b</mi><mo>=</mo><mfrac><mrow><mrow><mi>z</mi><mo>+</mo><mi>x</mi></mrow><mo>−</mo><mi>y</mi></mrow><mn>2</mn></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><mi>c</mi><mo>=</mo><mfrac><mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo>−</mo><mi>z</mi></mrow><mn>2</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">a=\frac{y+z-x}{2},\qquad b=\frac{z+x-y}{2},\qquad c=\frac{x+y-z}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p4.3" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p4.3.1" class="ltx_text">are positive integers (same-parity ensures integrality; the strict triangle inequalities ensure positivity), and moreover
<math id="A2.SS11.SSS1.Px1.p4.m2" class="ltx_Math" alttext="a+b=x,\ b+c=y,\ c+a=z" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>=</mo><mi>x</mi></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo>=</mo><mi>y</mi></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>c</mi><mo>+</mo><mi>a</mi></mrow><mo>=</mo><mi>z</mi></mrow></mrow><annotation encoding="application/x-tex">a+b=x,\ b+c=y,\ c+a=z</annotation></semantics></math>.
Since <math id="A2.SS11.SSS1.Px1.p4.m3" class="ltx_Math" alttext="1\leq x,y,z\leq 2012" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>≤</mo><mi>x</mi></mrow><mo>,</mo><mi>y</mi><mo>,</mo><mrow><mi>z</mi><mo>≤</mo><mn>2012</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq x,y,z\leq 2012</annotation></semantics></math>, we also have <math id="A2.SS11.SSS1.Px1.p4.m4" class="ltx_Math" alttext="1\leq a,b,c\leq 2012" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>≤</mo><mi>a</mi></mrow><mo>,</mo><mi>b</mi><mo>,</mo><mrow><mi>c</mi><mo>≤</mo><mn>2012</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq a,b,c\leq 2012</annotation></semantics></math>, so <math id="A2.SS11.SSS1.Px1.p4.m5" class="ltx_Math" alttext="a,b,c\in S" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mrow><mi>c</mi><mo>∈</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">a,b,c\in S</annotation></semantics></math> and are distinct (because <math id="A2.SS11.SSS1.Px1.p4.m6" class="ltx_Math" alttext="x,y,z" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">x,y,z</annotation></semantics></math> are distinct).
Hence the problem is equivalent to forcing <math id="A2.SS11.SSS1.Px1.p4.m7" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> to contain three distinct, same-parity elements forming a strict triangle.</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p5" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p5.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p5.1.1" class="ltx_text">Conversely, if <math id="A2.SS11.SSS1.Px1.p5.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> contains no such triple in a given parity class, then within that parity the largest of any three must be at least the sum of the other two (for odds, equality cannot hold because an odd cannot equal a sum of two odds).</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p6" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p6.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p6.1.1" class="ltx_text ltx_font_bold">Step 2: Growth constraints inside one parity.<span id="A2.SS11.SSS1.Px1.p6.1.1.1" class="ltx_text ltx_font_medium">
Write the even numbers in <math id="A2.SS11.SSS1.Px1.p6.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> (if any) as a strictly increasing sequence <math id="A2.SS11.SSS1.Px1.p6.m2" class="ltx_Math" alttext="e_{1}&lt;e_{2}&lt;\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>e</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>e</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">e_{1}&lt;e_{2}&lt;\cdots</annotation></semantics></math>.
Avoiding strict triangles among evens forces</span></span></p>
<table id="A2.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E21.m1" class="ltx_Math" alttext="e_{i+2}\ \geq\ e_{i+1}+e_{i}\qquad\text{for all }i." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>e</mi><mrow><mi>i</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0.778em" rspace="0.778em">≥</mo><mrow><msub><mi>e</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>e</mi><mi>i</mi></msub></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mtext>for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">e_{i+2}\ \geq\ e_{i+1}+e_{i}\qquad\text{for all }i.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p6.2" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p6.2.1" class="ltx_text">Similarly, for the odd numbers <math id="A2.SS11.SSS1.Px1.p6.m3" class="ltx_Math" alttext="o_{1}&lt;o_{2}&lt;\cdots" display="inline" intent=":literal"><semantics><mrow><msub><mi>o</mi><mn>1</mn></msub><mo>&lt;</mo><msub><mi>o</mi><mn>2</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em">⋯</mo></mrow><annotation encoding="application/x-tex">o_{1}&lt;o_{2}&lt;\cdots</annotation></semantics></math> we get</span></p>
<table id="A2.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E22.m1" class="ltx_Math" alttext="o_{i+2}\ \geq\ o_{i+1}+o_{i}+1\qquad\text{for all }i," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>o</mi><mrow><mi>i</mi><mo>+</mo><mn>2</mn></mrow></msub><mo lspace="0.778em" rspace="0.778em">≥</mo><mrow><msub><mi>o</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>o</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mtext>for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">o_{i+2}\ \geq\ o_{i+1}+o_{i}+1\qquad\text{for all }i,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p6.3" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p6.3.1" class="ltx_text">because <math id="A2.SS11.SSS1.Px1.p6.m4" class="ltx_Math" alttext="o_{i+1}+o_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>o</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>o</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">o_{i+1}+o_{i}</annotation></semantics></math> is even, so equality with an odd <math id="A2.SS11.SSS1.Px1.p6.m5" class="ltx_Math" alttext="o_{i+2}" display="inline" intent=":literal"><semantics><msub><mi>o</mi><mrow><mi>i</mi><mo>+</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">o_{i+2}</annotation></semantics></math> is impossible.</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p7" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p7.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p7.1.1" class="ltx_text">The longest possible triangle-free sequence (in each parity) up to <math id="A2.SS11.SSS1.Px1.p7.m1" class="ltx_Math" alttext="2012" display="inline" intent=":literal"><semantics><mn>2012</mn><annotation encoding="application/x-tex">2012</annotation></semantics></math> is obtained greedily by starting as small as possible and always taking the minimal next term permitted by (<a href="#A2.E21" title="Equation 21 ‣ Proof. ‣ Response of GPT-5-thinking. ‣ Problem 11a1 ‣ (a) Identifying patterns from examples ‣ 11 Generalization ‣ Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>) or (<a href="#A2.E22" title="Equation 22 ‣ Proof. ‣ Response of GPT-5-thinking. ‣ Problem 11a1 ‣ (a) Identifying patterns from examples ‣ 11 Generalization ‣ Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>).</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p8" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p8.1" class="ltx_p"><em id="A2.SS11.SSS1.Px1.p8.1.1" class="ltx_emph ltx_font_italic">Evens (start at <math id="A2.SS11.SSS1.Px1.p8.m1" class="ltx_Math" alttext="2,4" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>,</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">2,4</annotation></semantics></math> and use (<a href="#A2.E21" title="Equation 21 ‣ Proof. ‣ Response of GPT-5-thinking. ‣ Problem 11a1 ‣ (a) Identifying patterns from examples ‣ 11 Generalization ‣ Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>)):</em><span id="A2.SS11.SSS1.Px1.p8.1.2" class="ltx_text"></span></p>
<table id="A2.Ex321" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex321.m1" class="ltx_Math" alttext="2,\,4,\,6,\,10,\,16,\,26,\,42,\,68,\,110,\,178,\,288,\,466,\,754,\,1220,\,1974,\,\boxed{3194}." display="block" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo>,</mo><mn> 4</mn><mo>,</mo><mn> 6</mn><mo>,</mo><mn> 10</mn><mo>,</mo><mn> 16</mn><mo>,</mo><mn> 26</mn><mo>,</mo><mn> 42</mn><mo>,</mo><mn> 68</mn><mo>,</mo><mn> 110</mn><mo>,</mo><mn> 178</mn><mo>,</mo><mn> 288</mn><mo>,</mo><mn> 466</mn><mo>,</mo><mn> 754</mn><mo>,</mo><mn> 1220</mn><mo>,</mo><mn> 1974</mn><mo rspace="0.337em">,</mo><menclose notation="box"><mn>3194</mn></menclose></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">2,\,4,\,6,\,10,\,16,\,26,\,42,\,68,\,110,\,178,\,288,\,466,\,754,\,1220,\,1974,\,\boxed{3194}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p8.2" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p8.2.1" class="ltx_text">Thus at most <math id="A2.SS11.SSS1.Px1.p8.m2" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math> even terms can lie in <math id="A2.SS11.SSS1.Px1.p8.m3" class="ltx_Math" alttext="\{1,\dots,2012\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>2012</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,\dots,2012\}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p9" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p9.1" class="ltx_p"><em id="A2.SS11.SSS1.Px1.p9.1.1" class="ltx_emph ltx_font_italic">Odds (start at <math id="A2.SS11.SSS1.Px1.p9.m1" class="ltx_Math" alttext="1,3" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">1,3</annotation></semantics></math> and use (<a href="#A2.E22" title="Equation 22 ‣ Proof. ‣ Response of GPT-5-thinking. ‣ Problem 11a1 ‣ (a) Identifying patterns from examples ‣ 11 Generalization ‣ Appendix B Model Responses and Evaluations ‣ GAUSS: Benchmarking Structured Mathematical Skills for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>)):</em><span id="A2.SS11.SSS1.Px1.p9.1.2" class="ltx_text"></span></p>
<table id="A2.Ex322" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex322.m1" class="ltx_Math" alttext="1,\,3,\,5,\,9,\,15,\,25,\,41,\,67,\,109,\,177,\,287,\,465,\,753,\,1219,\,1973,\,\boxed{3193}." display="block" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>,</mo><mn> 3</mn><mo>,</mo><mn> 5</mn><mo>,</mo><mn> 9</mn><mo>,</mo><mn> 15</mn><mo>,</mo><mn> 25</mn><mo>,</mo><mn> 41</mn><mo>,</mo><mn> 67</mn><mo>,</mo><mn> 109</mn><mo>,</mo><mn> 177</mn><mo>,</mo><mn> 287</mn><mo>,</mo><mn> 465</mn><mo>,</mo><mn> 753</mn><mo>,</mo><mn> 1219</mn><mo>,</mo><mn> 1973</mn><mo rspace="0.337em">,</mo><menclose notation="box"><mn>3193</mn></menclose></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">1,\,3,\,5,\,9,\,15,\,25,\,41,\,67,\,109,\,177,\,287,\,465,\,753,\,1219,\,1973,\,\boxed{3193}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p9.2" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p9.2.1" class="ltx_text">Thus at most <math id="A2.SS11.SSS1.Px1.p9.m2" class="ltx_Math" alttext="15" display="inline" intent=":literal"><semantics><mn>15</mn><annotation encoding="application/x-tex">15</annotation></semantics></math> odd terms can lie in <math id="A2.SS11.SSS1.Px1.p9.m3" class="ltx_Math" alttext="\{1,\dots,2012\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>2012</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,\dots,2012\}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p10" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p10.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p10.1.1" class="ltx_text">Therefore, any subset <math id="A2.SS11.SSS1.Px1.p10.m1" class="ltx_Math" alttext="A\subseteq S" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⊆</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">A\subseteq S</annotation></semantics></math> with no same-parity strict triangle satisfies</span></p>
<table id="A2.Ex323" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex323.m1" class="ltx_Math" alttext="|A|=|A\cap\text{even}|+|A\cap\text{odd}|\leq 15+15=30." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>A</mi><mo>∩</mo><mtext>even</mtext></mrow><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mrow><mi>A</mi><mo>∩</mo><mtext>odd</mtext></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mn>15</mn><mo>+</mo><mn>15</mn></mrow><mo>=</mo><mn>30</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|A|=|A\cap\text{even}|+|A\cap\text{odd}|\leq 15+15=30.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS1.Px1.p11" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p11.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p11.1.1" class="ltx_text ltx_font_bold">Step 3: Upper bound for <math id="A2.SS11.SSS1.Px1.p11.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.<span id="A2.SS11.SSS1.Px1.p11.1.1.1" class="ltx_text ltx_font_medium">
If <math id="A2.SS11.SSS1.Px1.p11.m2" class="ltx_Math" alttext="|A|\geq 31" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow><mo>≥</mo><mn>31</mn></mrow><annotation encoding="application/x-tex">|A|\geq 31</annotation></semantics></math>, then by the pigeonhole principle <math id="A2.SS11.SSS1.Px1.p11.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> contains at least <math id="A2.SS11.SSS1.Px1.p11.m4" class="ltx_Math" alttext="16" display="inline" intent=":literal"><semantics><mn>16</mn><annotation encoding="application/x-tex">16</annotation></semantics></math> numbers of the same parity. By the bounds above, that parity class must contain a strict triangle, which (by Step 1) yields distinct <math id="A2.SS11.SSS1.Px1.p11.m5" class="ltx_Math" alttext="a,b,c\in S" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mrow><mi>c</mi><mo>∈</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">a,b,c\in S</annotation></semantics></math> with <math id="A2.SS11.SSS1.Px1.p11.m6" class="ltx_Math" alttext="a+b,b+c,c+a\in A" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>,</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo>,</mo><mrow><mrow><mi>c</mi><mo>+</mo><mi>a</mi></mrow><mo>∈</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">a+b,b+c,c+a\in A</annotation></semantics></math>.
Hence every <math id="A2.SS11.SSS1.Px1.p11.m7" class="ltx_Math" alttext="31" display="inline" intent=":literal"><semantics><mn>31</mn><annotation encoding="application/x-tex">31</annotation></semantics></math>-element subset works, so <math id="A2.SS11.SSS1.Px1.p11.m8" class="ltx_Math" alttext="k\leq 31" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≤</mo><mn>31</mn></mrow><annotation encoding="application/x-tex">k\leq 31</annotation></semantics></math>.</span></span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p12" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p12.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p12.1.1" class="ltx_text ltx_font_bold">Step 4: Sharpness (a <math id="A2.SS11.SSS1.Px1.p12.m1" class="ltx_Math" alttext="30" display="inline" intent=":literal"><semantics><mn>30</mn><annotation encoding="application/x-tex">30</annotation></semantics></math>-element counterexample).<span id="A2.SS11.SSS1.Px1.p12.1.1.1" class="ltx_text ltx_font_medium">
Let</span></span></p>
<table id="A2.Ex324" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex324.m1" class="ltx_Math" alttext="A_{0}=\{2,4,6,10,16,26,42,68,110,178,288,466,754,1220,1974\}" display="block" intent=":literal"><semantics><mrow><msub><mi>A</mi><mn>0</mn></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>10</mn><mo>,</mo><mn>16</mn><mo>,</mo><mn>26</mn><mo>,</mo><mn>42</mn><mo>,</mo><mn>68</mn><mo>,</mo><mn>110</mn><mo>,</mo><mn>178</mn><mo>,</mo><mn>288</mn><mo>,</mo><mn>466</mn><mo>,</mo><mn>754</mn><mo>,</mo><mn>1220</mn><mo>,</mo><mn>1974</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A_{0}=\{2,4,6,10,16,26,42,68,110,178,288,466,754,1220,1974\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A2.Ex325" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex325.m1" class="ltx_Math" alttext="\hskip 54.06006pt\cup\ \{1,3,5,9,15,25,41,67,109,177,287,465,753,1219,1973\}." display="block" intent=":literal"><semantics><mrow><mrow><mo rspace="0em">∪</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>9</mn><mo>,</mo><mn>15</mn><mo>,</mo><mn>25</mn><mo>,</mo><mn>41</mn><mo>,</mo><mn>67</mn><mo>,</mo><mn>109</mn><mo>,</mo><mn>177</mn><mo>,</mo><mn>287</mn><mo>,</mo><mn>465</mn><mo>,</mo><mn>753</mn><mo>,</mo><mn>1219</mn><mo>,</mo><mn>1973</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hskip 54.06006pt\cup\ \{1,3,5,9,15,25,41,67,109,177,287,465,753,1219,1973\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p12.2" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p12.2.1" class="ltx_text">Then <math id="A2.SS11.SSS1.Px1.p12.m2" class="ltx_Math" alttext="|A_{0}|=30" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mn>0</mn></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>30</mn></mrow><annotation encoding="application/x-tex">|A_{0}|=30</annotation></semantics></math>, and within each parity the largest of any triple is <math id="A2.SS11.SSS1.Px1.p12.m3" class="ltx_Math" alttext="\geq" display="inline" intent=":literal"><semantics><mo>≥</mo><annotation encoding="application/x-tex">\geq</annotation></semantics></math> the sum of the other two; hence there is no same-parity strict triangle and, by Step 1, no triple <math id="A2.SS11.SSS1.Px1.p12.m4" class="ltx_Math" alttext="a,b,c\in S" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mrow><mi>c</mi><mo>∈</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">a,b,c\in S</annotation></semantics></math> with all of <math id="A2.SS11.SSS1.Px1.p12.m5" class="ltx_Math" alttext="a+b,b+c,c+a" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>,</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo>,</mo><mrow><mi>c</mi><mo>+</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">a+b,b+c,c+a</annotation></semantics></math> in <math id="A2.SS11.SSS1.Px1.p12.m6" class="ltx_Math" alttext="A_{0}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>0</mn></msub><annotation encoding="application/x-tex">A_{0}</annotation></semantics></math>.
Thus <math id="A2.SS11.SSS1.Px1.p12.m7" class="ltx_Math" alttext="k\geq 31" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>31</mn></mrow><annotation encoding="application/x-tex">k\geq 31</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p13" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p13.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p13.1.1" class="ltx_text">Combining both directions gives <math id="A2.SS11.SSS1.Px1.p13.m1" class="ltx_Math" alttext="k=31" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mn>31</mn></mrow><annotation encoding="application/x-tex">k=31</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A2.SS11.SSS1.Px1.p14" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p14.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p14.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS11.SSS1.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS11.SSS1.Px1.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS11.SSS1.Px1.p15" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p15.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p15.1.1" class="ltx_text">Let <math id="A2.SS11.SSS1.Px1.p15.m1" class="ltx_Math" alttext="A=\{1,2,3,5,7,\dots,2011\}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>7</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>2011</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A=\{1,2,3,5,7,\dots,2011\}</annotation></semantics></math>. Then <math id="A2.SS11.SSS1.Px1.p15.m2" class="ltx_Math" alttext="|A|=1007" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>A</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mn>1007</mn></mrow><annotation encoding="application/x-tex">|A|=1007</annotation></semantics></math>, and the set <math id="A2.SS11.SSS1.Px1.p15.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> contains no three elements satisfying condition (1). Therefore, <math id="A2.SS11.SSS1.Px1.p15.m4" class="ltx_Math" alttext="k\geq 1008" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≥</mo><mn>1008</mn></mrow><annotation encoding="application/x-tex">k\geq 1008</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p16" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p16.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p16.1.1" class="ltx_text">We now prove that every 1008-element subset must contain three elements satisfying condition (1).</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p17" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p17.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p17.1.1" class="ltx_text">We prove a more general result:</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p18" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p18.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p18.1.1" class="ltx_text ltx_font_bold">For any integer <math id="A2.SS11.SSS1.Px1.p18.m1" class="ltx_Math" alttext="n\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n\geq 4</annotation></semantics></math>, every <math id="A2.SS11.SSS1.Px1.p18.m2" class="ltx_Math" alttext="(n+2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n+2)</annotation></semantics></math>-element subset of the set <math id="A2.SS11.SSS1.Px1.p18.m3" class="ltx_Math" alttext="\{1,2,\dots,2n\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,2,\dots,2n\}</annotation></semantics></math> contains three elements satisfying condition (1).<span id="A2.SS11.SSS1.Px1.p18.1.1.1" class="ltx_text"></span></span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p19" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p19.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p19.1.1" class="ltx_text">We proceed by induction on <math id="A2.SS11.SSS1.Px1.p19.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p20" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p20.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p20.1.1" class="ltx_text ltx_font_bold">Base case: <math id="A2.SS11.SSS1.Px1.p20.m1" class="ltx_Math" alttext="n=4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n=4</annotation></semantics></math>.<span id="A2.SS11.SSS1.Px1.p20.1.1.1" class="ltx_text ltx_font_medium">
Let <math id="A2.SS11.SSS1.Px1.p20.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> be a 6-element subset of <math id="A2.SS11.SSS1.Px1.p20.m3" class="ltx_Math" alttext="\{1,2,\dots,8\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>8</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,2,\dots,8\}</annotation></semantics></math>. Then the intersection <math id="A2.SS11.SSS1.Px1.p20.m4" class="ltx_Math" alttext="A\cap\{3,4,\dots,8\}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>∩</mo><mrow><mo stretchy="false">{</mo><mrow><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>8</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A\cap\{3,4,\dots,8\}</annotation></semantics></math> contains at least 4 elements.</span></span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p21" class="ltx_para">
<ul id="A2.I41" class="ltx_itemize">
<li id="A2.I41.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I41.i1.p1" class="ltx_para">
<p id="A2.I41.i1.p1.1" class="ltx_p">If this intersection contains three even numbers, then <math id="A2.I41.i1.p1.m1" class="ltx_Math" alttext="4,6,8\in A" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo>,</mo><mn>6</mn><mo>,</mo><mrow><mn>8</mn><mo>∈</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">4,6,8\in A</annotation></semantics></math>, which satisfy condition (1).</p>
</div></li>
<li id="A2.I41.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I41.i2.p1" class="ltx_para">
<p id="A2.I41.i2.p1.1" class="ltx_p">If it contains exactly two even numbers, then it must contain at least two odd numbers. Take any two of them. Among <math id="A2.I41.i2.p1.m1" class="ltx_Math" alttext="4,6,8" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">4,6,8</annotation></semantics></math>, at least two even numbers can form a triple with the odd numbers that satisfies condition (1). Since there are at least two even numbers, such a triple exists.</p>
</div></li>
<li id="A2.I41.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I41.i3.p1" class="ltx_para">
<p id="A2.I41.i3.p1.1" class="ltx_p">If it contains only one even number, then it must contain all three odd numbers. The single even number together with <math id="A2.I41.i3.p1.m1" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> and <math id="A2.I41.i3.p1.m2" class="ltx_Math" alttext="7" display="inline" intent=":literal"><semantics><mn>7</mn><annotation encoding="application/x-tex">7</annotation></semantics></math> form a triple satisfying condition (1).</p>
</div></li>
</ul>
</div>
<div id="A2.SS11.SSS1.Px1.p22" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p22.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p22.1.1" class="ltx_text">Hence, the statement holds for <math id="A2.SS11.SSS1.Px1.p22.m1" class="ltx_Math" alttext="n=4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n=4</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p23" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p23.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p23.1.1" class="ltx_text ltx_font_bold">Inductive step:<span id="A2.SS11.SSS1.Px1.p23.1.1.1" class="ltx_text ltx_font_medium">
Assume the statement holds for some <math id="A2.SS11.SSS1.Px1.p23.m1" class="ltx_Math" alttext="n\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n\geq 4</annotation></semantics></math>. Consider the case of <math id="A2.SS11.SSS1.Px1.p23.m2" class="ltx_Math" alttext="n+1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n+1</annotation></semantics></math>.
Let <math id="A2.SS11.SSS1.Px1.p23.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> be an <math id="A2.SS11.SSS1.Px1.p23.m4" class="ltx_Math" alttext="(n+3)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n+3)</annotation></semantics></math>-element subset of <math id="A2.SS11.SSS1.Px1.p23.m5" class="ltx_Math" alttext="\{1,2,\dots,2n+2\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,2,\dots,2n+2\}</annotation></semantics></math>.</span></span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p24" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p24.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p24.1.1" class="ltx_text">If</span></p>
<table id="A2.Ex326" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex326.m1" class="ltx_Math" alttext="|A\cap\{1,2,\dots,2n\}|\geq n+2," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>A</mi><mo>∩</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≥</mo><mrow><mi>n</mi><mo>+</mo><mn>2</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">|A\cap\{1,2,\dots,2n\}|\geq n+2,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p24.2" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p24.2.1" class="ltx_text">then by the induction hypothesis, the conclusion holds.</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p25" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p25.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p25.1.1" class="ltx_text">So we only need to consider the case:</span></p>
<table id="A2.Ex327" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex327.m1" class="ltx_Math" alttext="|A\cap\{1,2,\dots,2n\}|=n+1\quad\text{and}\quad 2n+1,\,2n+2\in A." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>A</mi><mo>∩</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mrow><mrow><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo>∈</mo><mi>A</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|A\cap\{1,2,\dots,2n\}|=n+1\quad\text{and}\quad 2n+1,\,2n+2\in A.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS1.Px1.p26" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p26.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p26.1.1" class="ltx_text">Now, if there exists an odd number <math id="A2.SS11.SSS1.Px1.p26.m1" class="ltx_Math" alttext="x&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">x&gt;1</annotation></semantics></math> from <math id="A2.SS11.SSS1.Px1.p26.m2" class="ltx_Math" alttext="\{1,2,\dots,2n\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{1,2,\dots,2n\}</annotation></semantics></math> in <math id="A2.SS11.SSS1.Px1.p26.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, then the triple <math id="A2.SS11.SSS1.Px1.p26.m4" class="ltx_Math" alttext="x,2n+1,2n+2" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">x,2n+1,2n+2</annotation></semantics></math> satisfies condition (1).</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p27" class="ltx_para">
<p id="A2.SS11.SSS1.Px1.p27.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p27.1.1" class="ltx_text">If all odd numbers greater than 1 are excluded from <math id="A2.SS11.SSS1.Px1.p27.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>, then:</span></p>
<table id="A2.Ex328" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex328.m1" class="ltx_Math" alttext="A\subset\{1,2,4,6,\dots,2n,2n+1,2n+2\}," display="block" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>⊂</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>6</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">A\subset\{1,2,4,6,\dots,2n,2n+1,2n+2\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p27.2" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p27.2.1" class="ltx_text">and this set contains exactly <math id="A2.SS11.SSS1.Px1.p27.m2" class="ltx_Math" alttext="n+3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>+</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n+3</annotation></semantics></math> elements. Therefore,</span></p>
<table id="A2.Ex329" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex329.m1" class="ltx_Math" alttext="A=\{1,2,4,6,\dots,2n,2n+1,2n+2\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>6</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo>+</mo><mn>2</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A=\{1,2,4,6,\dots,2n,2n+1,2n+2\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p27.3" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p27.3.1" class="ltx_text">In this case, <math id="A2.SS11.SSS1.Px1.p27.m3" class="ltx_Math" alttext="4,6,8\in A" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo>,</mo><mn>6</mn><mo>,</mo><mrow><mn>8</mn><mo>∈</mo><mi>A</mi></mrow></mrow><annotation encoding="application/x-tex">4,6,8\in A</annotation></semantics></math>, and they satisfy condition (1).</span></p>
</div>
<div id="A2.SS11.SSS1.Px1.p28" class="ltx_para ltx_noindent">
<p id="A2.SS11.SSS1.Px1.p28.1" class="ltx_p"><span id="A2.SS11.SSS1.Px1.p28.1.1" class="ltx_text ltx_font_bold">Conclusion:</span>
The smallest possible value of <math id="A2.SS11.SSS1.Px1.p28.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> is</p>
<table id="A2.Ex330" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex330.m1" class="ltx_Math" alttext="\boxed{1008}." display="block" intent=":literal"><semantics><mrow><menclose notation="box"><mn>1008</mn></menclose><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\boxed{1008}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS11.SSS1.Px1.p28.2" class="ltx_p">∎</p>
</div>
</div>
<div id="A2.SS11.SSS1.Px1.p29" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS11.SSS1.Px1.p29.pic1" class="ltx_picture" height="69.62" overflow="visible" version="1.1" viewBox="0 0 429.64 69.62" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,69.62) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 65 C 0 67.55 2.07 69.62 4.63 69.62 L 425.01 69.62 C 427.56 69.62 429.64 67.55 429.64 65 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 50.76 L 428.94 50.76 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 55.39)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS1.Px1.p29.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
