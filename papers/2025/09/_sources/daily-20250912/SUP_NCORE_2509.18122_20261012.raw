</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS3.SSS1.Px1.p17" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS3.SSS1.Px1.p17.pic1" class="ltx_picture" height="54.25" overflow="visible" version="1.1" viewBox="0 0 429.64 54.25" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,54.25) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 49.62 C 0 52.18 2.07 54.25 4.63 54.25 L 425.01 54.25 C 427.56 54.25 429.64 52.18 429.64 49.62 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 35.38 L 428.94 35.38 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 40.01)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS3.SSS1.Px1.p17.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS3.SSS1.Px1.p17.pic1.1.1" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p17.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS3.SSS1.Px1.p17.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS3.SSS1.Px1.p17.pic1.2.1" class="ltx_p"><span id="A2.SS3.SSS1.Px1.p17.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The solution is incorrect.
Correct answer:
<math id="A2.SS3.SSS1.Px1.p17.pic1.m1" class="ltx_Math" alttext="\frac{\pi^{2}}{12}\,(1-\sqrt{3})+\log(2)\,\log(1+\sqrt{3})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">12</mn></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msqrt></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\frac{\pi^{2}}{12}\,(1-\sqrt{3})+\log(2)\,\log(1+\sqrt{3}).</annotation></semantics></math></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
</section>
<section id="A2.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">(b) </span>Symbolic manipulation</h4>

<section id="A2.SS3.SSS2.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#FF0000;">Problem 3b1 </h5>

<div id="A2.SS3.SSS2.Px1.p1" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p1.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS3.SSS2.Px1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS3.SSS2.Px1.p2.pic1" class="ltx_picture" height="226.23" overflow="visible" version="1.1" viewBox="0 0 429.64 226.23" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,226.23) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 221.6 C 0 224.16 2.07 226.23 4.63 226.23 L 425.01 226.23 C 427.56 226.23 429.64 224.16 429.64 221.6 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 207.37 L 428.94 207.37 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 212)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS3.SSS2.Px1.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS3.SSS2.Px1.p2.pic1.1.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:13.07em;--ltx-fo-depth:0.16em;font-size:10pt;" height="183.05" overflow="visible" transform="matrix(1 0 0 -1 0 180.9)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS3.SSS2.Px1.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.I7" class="ltx_itemize">
<span id="A2.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i1.p1" class="ltx_para">
<span id="A2.I7.i1.p1.1" class="ltx_p"><span id="A2.I7.i1.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Let </span><math id="A2.I7.i1.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="A2.I7.i1.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> be a homogenous expression in terms of </span><math id="A2.I7.i1.p1.m2" class="ltx_Math" alttext="a,b,c" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">c</mi></mrow><annotation encoding="application/x-tex">a,b,c</annotation></semantics></math><span id="A2.I7.i1.p1.1.3" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">, and suppose we want to prove </span><math id="A2.I7.i1.p1.m3" class="ltx_Math" alttext="X\geq 0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">0</mn></mrow><annotation encoding="application/x-tex">X\geq 0</annotation></semantics></math><span id="A2.I7.i1.p1.1.4" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A2.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I7.i2.p1" class="ltx_para">
<span id="A2.I7.i2.p1.1" class="ltx_p"><span id="A2.I7.i2.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Write </span><math id="A2.I7.i2.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="A2.I7.i2.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> in the following form:</span></span>
<span id="A2.Ex92" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex92.m1" class="ltx_Math" alttext="(a-b)^{2}\cdot S_{c}+(b-c)^{2}\cdot S_{a}+(c-a)^{2}\cdot S_{b}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" mathsize="0.800em" rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">S</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">c</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mrow><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">c</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em" rspace="0.055em">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">S</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">a</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mrow><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">a</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em" rspace="0.055em">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">S</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">b</mi></msub></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">.</mo></mrow><annotation encoding="application/x-tex">(a-b)^{2}\cdot S_{c}+(b-c)^{2}\cdot S_{a}+(c-a)^{2}\cdot S_{b}.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></span>
</span>
<span id="A2.SS3.SSS2.Px1.p2.pic1.2.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Apply the sum of squares (SOS) method to show that:</span></span>
<span id="A2.Ex93" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex93.m1" class="ltx_Math" alttext="16\sum x^{4}-20\sum x^{3}(y+z)+9\sum y^{2}z^{2}+25\sum x^{2}yz\geq 0" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">16</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em" movablelimits="false" stretchy="true">∑</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">x</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">4</mn></msup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">−</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">20</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em" movablelimits="false" stretchy="true">∑</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">x</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">z</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">9</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em" movablelimits="false" stretchy="true">∑</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">y</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">z</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msup></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">25</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em" movablelimits="false" stretchy="true">∑</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">x</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">y</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">z</mi></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">0</mn></mrow><annotation encoding="application/x-tex">16\sum x^{4}-20\sum x^{3}(y+z)+9\sum y^{2}z^{2}+25\sum x^{2}yz\geq 0</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span><span class="ltx_inline-block"><svg id="A2.SS3.SSS2.Px1.p2.pic1.pic1" class="ltx_picture" color="#FF0000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 0 L 15.75 15.75 M 0 15.75 L 15.75 0"></path></g></svg></span>
<span id="A2.SS3.SSS2.Px1.p2.pic1.2.2" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;">GPT-5 thinking failed</span></span>
<span id="A2.SS3.SSS2.Px1.p2.pic1.2.3" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p2.pic1.2.3.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Jiaxin Zhang</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS3.SSS2.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS3.SSS2.Px1.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS3.SSS2.Px1.p3" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p3.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p3.1.1" class="ltx_text">Alright, here’s a clean SOS route you can use and reuse.</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p4" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p4.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p4.1.1" class="ltx_text">Notation</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p5" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p5.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p5.1.1" class="ltx_text">Write</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p6" class="ltx_para">
<table id="A2.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex94.m1" class="ltx_Math" alttext="\sum x^{4}=x^{4}+y^{4}+z^{4},\quad\sum x^{3}(y+z)=\sum_{\text{sym}}x^{3}y," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo movablelimits="false">∑</mo><msup><mi>x</mi><mn>4</mn></msup></mrow><mo>=</mo><mrow><msup><mi>x</mi><mn>4</mn></msup><mo>+</mo><msup><mi>y</mi><mn>4</mn></msup><mo>+</mo><msup><mi>z</mi><mn>4</mn></msup></mrow></mrow><mo rspace="1.000em">,</mo><mrow><mrow><mo movablelimits="false">∑</mo><mrow><msup><mi>x</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>+</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mtext>sym</mtext></munder><mrow><msup><mi>x</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sum x^{4}=x^{4}+y^{4}+z^{4},\quad\sum x^{3}(y+z)=\sum_{\text{sym}}x^{3}y,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A2.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex95.m1" class="ltx_Math" alttext="\sum y^{2}z^{2}=x^{2}y^{2}+y^{2}z^{2}+z^{2}x^{2},\quad\sum x^{2}yz=x^{2}yz+y^{2}zx+z^{2}xy." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo movablelimits="false">∑</mo><mrow><msup><mi>y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mrow></mrow><mo rspace="1.000em">,</mo><mrow><mrow><mo movablelimits="false">∑</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo>+</mo><mrow><msup><mi>y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>+</mo><mrow><msup><mi>z</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum y^{2}z^{2}=x^{2}y^{2}+y^{2}z^{2}+z^{2}x^{2},\quad\sum x^{2}yz=x^{2}yz+y^{2}zx+z^{2}xy.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS2.Px1.p7" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p7.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p7.1.1" class="ltx_text">SOS template</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p8" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p8.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p8.1.1" class="ltx_text">For a symmetric homogeneous quartic <math id="A2.SS3.SSS2.Px1.p8.m1" class="ltx_Math" alttext="X(x,y,z)" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">X(x,y,z)</annotation></semantics></math>, the “SOS method” seeks</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p9" class="ltx_para">
<table id="A2.Ex96" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex96.m1" class="ltx_Math" alttext="X=\sum_{\text{cyc}}(x-y)^{2}\,S_{z}," display="block" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mtext>cyc</mtext></munder><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>z</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">X=\sum_{\text{cyc}}(x-y)^{2}\,S_{z},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS2.Px1.p10" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p10.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p10.1.1" class="ltx_text">with each <math id="A2.SS3.SSS2.Px1.p10.m1" class="ltx_Math" alttext="S_{z}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>z</mi></msub><annotation encoding="application/x-tex">S_{z}</annotation></semantics></math> a (nonnegative) quadratic form in <math id="A2.SS3.SSS2.Px1.p10.m2" class="ltx_Math" alttext="x,y,z" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">x,y,z</annotation></semantics></math>. A convenient ansatz is</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p11" class="ltx_para">
<table id="A2.Ex97" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex97.m1" class="ltx_Math" alttext="S_{z}=\alpha(x^{2}+y^{2})+\beta\,xy+\gamma\,z^{2}+\delta\,z(x+y)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>z</mi></msub><mo>=</mo><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi>δ</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{z}=\alpha(x^{2}+y^{2})+\beta\,xy+\gamma\,z^{2}+\delta\,z(x+y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS2.Px1.p12" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p12.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p12.1.1" class="ltx_text">and <math id="A2.SS3.SSS2.Px1.p12.m1" class="ltx_Math" alttext="S_{x},S_{y}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>x</mi></msub><mo>,</mo><msub><mi>S</mi><mi>y</mi></msub></mrow><annotation encoding="application/x-tex">S_{x},S_{y}</annotation></semantics></math> obtained by cyclic permutation. Matching coefficients of the monomials <math id="A2.SS3.SSS2.Px1.p12.m2" class="ltx_Math" alttext="x^{4},x^{3}y,x^{2}y^{2},x^{2}yz" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mn>4</mn></msup><mo>,</mo><mrow><msup><mi>x</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>,</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>y</mi><mn>2</mn></msup></mrow><mo>,</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><annotation encoding="application/x-tex">x^{4},x^{3}y,x^{2}y^{2},x^{2}yz</annotation></semantics></math> gives a linear system for <math id="A2.SS3.SSS2.Px1.p12.m3" class="ltx_Math" alttext="\alpha,\beta,\gamma,\delta" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>,</mo><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\alpha,\beta,\gamma,\delta</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p13" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p13.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p13.1.1" class="ltx_text">Matching step for the given polynomial</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p14" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p14.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p14.1.1" class="ltx_text">For</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p15" class="ltx_para">
<table id="A2.Ex98" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex98.m1" class="ltx_Math" alttext="F=16\sum x^{4}-20\sum x^{3}(y+z)+9\sum y^{2}z^{2}+25\sum x^{2}yz," display="block" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>=</mo><mrow><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><msup><mi>x</mi><mn>4</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>20</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><mrow><msup><mi>x</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>+</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><mrow><msup><mi>y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></mrow></mrow><mo>+</mo><mrow><mn>25</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F=16\sum x^{4}-20\sum x^{3}(y+z)+9\sum y^{2}z^{2}+25\sum x^{2}yz,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS2.Px1.p16" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p16.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p16.1.1" class="ltx_text">a straightforward coefficient match from
<math id="A2.SS3.SSS2.Px1.p16.m1" class="ltx_Math" alttext="\displaystyle\sum_{\text{cyc}}(x-y)^{2}S_{z}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mtext>cyc</mtext></munder></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>z</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\text{cyc}}(x-y)^{2}S_{z}</annotation></semantics></math>
yields</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p17" class="ltx_para">
<table id="A2.Ex99" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex99.m1" class="ltx_Math" alttext="\alpha=8,\qquad\beta=\frac{10}{3},\qquad\gamma=\frac{13}{6},\qquad\delta=-\frac{32}{3}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>α</mi><mo>=</mo><mn>8</mn></mrow><mo rspace="2.167em">,</mo><mrow><mi>β</mi><mo>=</mo><mfrac><mn>10</mn><mn>3</mn></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><mi>γ</mi><mo>=</mo><mfrac><mn>13</mn><mn>6</mn></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><mi>δ</mi><mo>=</mo><mrow><mo>−</mo><mfrac><mn>32</mn><mn>3</mn></mfrac></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\alpha=8,\qquad\beta=\frac{10}{3},\qquad\gamma=\frac{13}{6},\qquad\delta=-\frac{32}{3},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS2.Px1.p18" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p18.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p18.1.1" class="ltx_text">i.e.</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p19" class="ltx_para">
<table id="A2.Ex100" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex100.m1" class="ltx_Math" alttext="\boxed{\;F=\sum_{\text{cyc}}(x-y)^{2}\Big[\,8(x^{2}+y^{2})+\tfrac{10}{3}xy+\tfrac{13}{6}z^{2}-\tfrac{32}{3}z(x+y)\Big].\;}" display="block" intent=":literal"><semantics><menclose notation="box"><mrow><mrow><mi>F</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mtext>cyc</mtext></munder><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mn> 8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mn>10</mn><mn>3</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><mfrac><mn>13</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="false"><mfrac><mn>32</mn><mn>3</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></menclose><annotation encoding="application/x-tex">\boxed{\;F=\sum_{\text{cyc}}(x-y)^{2}\Big[\,8(x^{2}+y^{2})+\tfrac{10}{3}xy+\tfrac{13}{6}z^{2}-\tfrac{32}{3}z(x+y)\Big].\;}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS2.Px1.p20" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p20.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p20.1.1" class="ltx_text">Making <math id="A2.SS3.SSS2.Px1.p20.m1" class="ltx_Math" alttext="S_{z}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>z</mi></msub><annotation encoding="application/x-tex">S_{z}</annotation></semantics></math> a sum of squares</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p21" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p21.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p21.1.1" class="ltx_text">Complete squares in the bracket (still cyclically):</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p22" class="ltx_para">
<table id="A2.Ex101" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex101X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex101X.m2" class="ltx_Math" alttext="\displaystyle S_{z}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>z</mi></msub><annotation encoding="application/x-tex">\displaystyle S_{z}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex101X.m3" class="ltx_Math" alttext="\displaystyle=\frac{19}{6}(x-y)^{2}+\frac{29}{6}\Big(x+y-\frac{32}{29}z\Big)^{2}\;-\;\frac{14848}{2523}\,z^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>19</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>29</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>32</mn><mn>29</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="0.502em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>14848</mn><mn>2523</mn></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{19}{6}(x-y)^{2}+\frac{29}{6}\Big(x+y-\frac{32}{29}z\Big)^{2}\;-\;\frac{14848}{2523}\,z^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex101Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex101Xa.m2" class="ltx_Math" alttext="\displaystyle=\underbrace{\frac{19}{6}(x-y)^{2}}_{\geq 0}\;+\;\underbrace{\frac{29}{6}\Big(x+y-\frac{32}{29}z\Big)^{2}}_{\geq 0}\;-\;\frac{14848}{2523}\,z^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mn>19</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></munder><mo rspace="0.502em">+</mo><munder><munder accentunder="true"><mrow><mstyle displaystyle="true"><mfrac><mn>29</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>32</mn><mn>29</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></munder></mrow><mo rspace="0.502em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>14848</mn><mn>2523</mn></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\underbrace{\frac{19}{6}(x-y)^{2}}_{\geq 0}\;+\;\underbrace{\frac{29}{6}\Big(x+y-\frac{32}{29}z\Big)^{2}}_{\geq 0}\;-\;\frac{14848}{2523}\,z^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS2.Px1.p23" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p23.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p23.1.1" class="ltx_text">The negative <math id="A2.SS3.SSS2.Px1.p23.m1" class="ltx_Math" alttext="z^{2}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mn>2</mn></msup><annotation encoding="application/x-tex">z^{2}</annotation></semantics></math>-tail can be neutralized uniformly by adding the *same* nonnegative cyclic square to each <math id="A2.SS3.SSS2.Px1.p23.m2" class="ltx_Math" alttext="S_{z}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>z</mi></msub><annotation encoding="application/x-tex">S_{z}</annotation></semantics></math>. A standard choice is to add a positive multiple of <math id="A2.SS3.SSS2.Px1.p23.m3" class="ltx_Math" alttext="(x-y)^{2}+(y-z)^{2}+(z-x)^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">(x-y)^{2}+(y-z)^{2}+(z-x)^{2}</annotation></semantics></math> split evenly among the three <math id="A2.SS3.SSS2.Px1.p23.m4" class="ltx_Math" alttext="S_{z}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>z</mi></msub><annotation encoding="application/x-tex">S_{z}</annotation></semantics></math>’s; algebraically this amounts to adding</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p24" class="ltx_para">
<table id="A2.Ex102" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex102.m1" class="ltx_Math" alttext="\lambda\sum_{\text{cyc}}(x-y)^{2}(y-z)^{2}" display="block" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mtext>cyc</mtext></munder><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\sum_{\text{cyc}}(x-y)^{2}(y-z)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS2.Px1.p25" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p25.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p25.1.1" class="ltx_text">to <math id="A2.SS3.SSS2.Px1.p25.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math>, and then subtracting it back using the identity</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p26" class="ltx_para">
<table id="A2.Ex103" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex103.m1" class="ltx_Math" alttext="\sum_{\text{cyc}}(x-y)^{2}(y-z)^{2}=(x-y)^{2}\!\left((y-z)^{2}+(z-x)^{2}\right)\quad\text{(cyclic)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mtext>cyc</mtext></munder><mrow><msup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>z</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>(cyclic)</mtext></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{\text{cyc}}(x-y)^{2}(y-z)^{2}=(x-y)^{2}\!\left((y-z)^{2}+(z-x)^{2}\right)\quad\text{(cyclic)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS2.Px1.p27" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p27.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p27.1.1" class="ltx_text">Choosing <math id="A2.SS3.SSS2.Px1.p27.m1" class="ltx_Math" alttext="\lambda=\tfrac{91}{6}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mfrac><mn>91</mn><mn>6</mn></mfrac></mrow><annotation encoding="application/x-tex">\lambda=\tfrac{91}{6}</annotation></semantics></math> (the minimal value that completes the square) makes each modified <math id="A2.SS3.SSS2.Px1.p27.m2" class="ltx_Math" alttext="S_{z}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>z</mi></msub><annotation encoding="application/x-tex">S_{z}</annotation></semantics></math> a manifest sum of two squares, hence nonnegative; since we add and subtract the same nonnegative cyclic SOS, the original <math id="A2.SS3.SSS2.Px1.p27.m3" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is an SOS as well.</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p28" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p28.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p28.1.1" class="ltx_text">Conclusion</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p29" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p29.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p29.1.1" class="ltx_text">Thus <math id="A2.SS3.SSS2.Px1.p29.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> admits an SOS decomposition of the form</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p30" class="ltx_para">
<table id="A2.Ex104" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex104.m1" class="ltx_Math" alttext="F=\sum_{\text{cyc}}(x-y)^{2}\;\widetilde{S}_{z}\quad\text{with}\quad\widetilde{S}_{z}=\text{(sum of squares of linear forms)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mtext>cyc</mtext></munder><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>z</mi></msub></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>with</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mover accent="true"><mi>S</mi><mo>~</mo></mover><mi>z</mi></msub><mo>=</mo><mtext>(sum of squares of linear forms)</mtext></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F=\sum_{\text{cyc}}(x-y)^{2}\;\widetilde{S}_{z}\quad\text{with}\quad\widetilde{S}_{z}=\text{(sum of squares of linear forms)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS3.SSS2.Px1.p31" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p31.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p31.1.1" class="ltx_text">so <math id="A2.SS3.SSS2.Px1.p31.m1" class="ltx_Math" alttext="F\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">F\geq 0</annotation></semantics></math> for all real <math id="A2.SS3.SSS2.Px1.p31.m2" class="ltx_Math" alttext="x,y,z" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">x,y,z</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p32" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p32.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p32.1.1" class="ltx_text">If you want, I can write the fully expanded “final SOS” with the exact square terms (no parameters left), but it’s a bit long; the steps above give the method and the working coefficients so you can reproduce or CAS-check it quickly.</span></p>
</div>
<div id="A2.SS3.SSS2.Px1.p33" class="ltx_para">
<p id="A2.SS3.SSS2.Px1.p33.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p33.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS3.SSS2.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS3.SSS2.Px1.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS3.SSS2.Px1.p34" class="ltx_para">
<table id="A2.Ex105" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex105.m1" class="ltx_Math" alttext="16\sum x^{4}-20\sum x^{3}(y+z)+9\sum y^{2}z^{2}+25\sum x^{2}yz=\frac{1}{4}\sum(5x-3y-3z)^{2}(y-z)^{2}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><msup><mi>x</mi><mn>4</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>20</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><mrow><msup><mi>x</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>+</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><mrow><msup><mi>y</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>z</mi><mn>2</mn></msup></mrow></mrow></mrow><mo>+</mo><mrow><mn>25</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false">∑</mo><mrow><msup><mi>x</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo movablelimits="false" rspace="0em">∑</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">16\sum x^{4}-20\sum x^{3}(y+z)+9\sum y^{2}z^{2}+25\sum x^{2}yz=\frac{1}{4}\sum(5x-3y-3z)^{2}(y-z)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.Px1.p34.1" class="ltx_p"><span id="A2.SS3.SSS2.Px1.p34.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS3.SSS2.Px1.p35" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS3.SSS2.Px1.p35.pic1" class="ltx_picture" height="54.25" overflow="visible" version="1.1" viewBox="0 0 429.64 54.25" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,54.25) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 49.62 C 0 52.18 2.07 54.25 4.63 54.25 L 425.01 54.25 C 427.56 54.25 429.64 52.18 429.64 49.62 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 35.38 L 428.94 35.38 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 40.01)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
