<span id="S3.T3.5.29.2.1" class="ltx_inline-block ltx_align_middle" style="width:56.9pt;">
<span id="S3.T3.5.29.2.1.1" class="ltx_p"><span id="S3.T3.5.29.2.1.1.1" class="ltx_text" style="--ltx-bg-color:#C8FFC8;">100</span></span>
</span></td>
