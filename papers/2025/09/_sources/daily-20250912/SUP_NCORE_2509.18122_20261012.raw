<span id="A2.SS7.SSS4.Px1.p15.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS4.Px1.p15.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Score</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS4.Px1.p15.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS7.SSS4.Px1.p15.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS4.Px1.p15.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">3/3</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS7.SSS4.Px1.p16" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS4.Px1.p16.pic1" class="ltx_picture" height="69.62" overflow="visible" version="1.1" viewBox="0 0 429.64 69.62" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,69.62) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 65 C 0 67.55 2.07 69.62 4.63 69.62 L 425.01 69.62 C 427.56 69.62 429.64 67.55 429.64 65 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 50.76 L 428.94 50.76 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 55.39)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS4.Px1.p16.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS7.SSS4.Px1.p16.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS4.Px1.p16.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:1.76em;--ltx-fo-depth:0.16em;font-size:10pt;" height="26.44" overflow="visible" transform="matrix(1 0 0 -1 0 24.29)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS4.Px1.p16.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS7.SSS4.Px1.p16.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS4.Px1.p16.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The answer clearly explain the why solution is more elegant from simplicity, symmetry and insight into the problem.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="A2.SS7.SSS4.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#00E000;">Problem 7d2</h5>

<div id="A2.SS7.SSS4.Px2.p1" class="ltx_para">
<p id="A2.SS7.SSS4.Px2.p1.1" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS7.SSS4.Px2.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS4.Px2.p2.pic1" class="ltx_picture" height="286.5" overflow="visible" version="1.1" viewBox="0 0 429.64 286.5" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,286.5) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 281.87 C 0 284.43 2.07 286.5 4.63 286.5 L 425.01 286.5 C 427.56 286.5 429.64 284.43 429.64 281.87 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 267.63 L 428.94 267.63 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 272.26)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS4.Px2.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS7.SSS4.Px2.p2.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:17.43em;--ltx-fo-depth:0.16em;font-size:10pt;" height="243.32" overflow="visible" transform="matrix(1 0 0 -1 0 241.17)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS4.Px2.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS7.SSS4.Px2.p2.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Comparing the following two proofs of the following problem. Which one do you like more? Why?</span></span>
<span id="A2.SS7.SSS4.Px2.p2.pic1.2.2" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Problem: Let <math id="A2.SS7.SSS4.Px2.p2.pic1.m1" class="ltx_Math" alttext="V,W" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi></mrow><annotation encoding="application/x-tex">V,W</annotation></semantics></math> be finite-dimensional vector spaces and <math id="A2.SS7.SSS4.Px2.p2.pic1.m2" class="ltx_Math" alttext="S\colon V\to V" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow></mrow><annotation encoding="application/x-tex">S\colon V\to V</annotation></semantics></math>, <math id="A2.SS7.SSS4.Px2.p2.pic1.m3" class="ltx_Math" alttext="T\colon W\to W" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi></mrow></mrow><annotation encoding="application/x-tex">T\colon W\to W</annotation></semantics></math> be linear operators. Show that <math id="A2.SS7.SSS4.Px2.p2.pic1.m4" class="ltx_Math" alttext="tr(S\otimes T)=tr(S)tr(T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">tr(S\otimes T)=tr(S)tr(T)</annotation></semantics></math>.</span></span>
<span id="A2.SS7.SSS4.Px2.p2.pic1.2.3" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p2.pic1.2.3.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Solution 1: Pick bases for <math id="A2.SS7.SSS4.Px2.p2.pic1.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, <math id="A2.SS7.SSS4.Px2.p2.pic1.m6" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math>, and regard <math id="A2.SS7.SSS4.Px2.p2.pic1.m7" class="ltx_Math" alttext="S,T" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><annotation encoding="application/x-tex">S,T</annotation></semantics></math> as square matrices, with entries <math id="A2.SS7.SSS4.Px2.p2.pic1.m8" class="ltx_Math" alttext="S_{i,j}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub><annotation encoding="application/x-tex">S_{i,j}</annotation></semantics></math>, <math id="A2.SS7.SSS4.Px2.p2.pic1.m9" class="ltx_Math" alttext="T_{i,j}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub><annotation encoding="application/x-tex">T_{i,j}</annotation></semantics></math>. Then <math id="A2.SS7.SSS4.Px2.p2.pic1.m10" class="ltx_Math" alttext="tr(S\otimes T)=\sum_{i,j}S_{i,i}T_{j,j}=(\sum_{i}S_{i})(\sum_{j}T_{j})=tr(S)tr(T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">=</mo><mrow><msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">∑</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">∑</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">tr(S\otimes T)=\sum_{i,j}S_{i,i}T_{j,j}=(\sum_{i}S_{i})(\sum_{j}T_{j})=tr(S)tr(T)</annotation></semantics></math>.</span></span>
<span id="A2.SS7.SSS4.Px2.p2.pic1.2.4" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p2.pic1.2.4.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Solution 2: We have a canonical isomorphism <math id="A2.SS7.SSS4.Px2.p2.pic1.m11" class="ltx_Math" alttext="\phi\colon V^{*}\otimes W^{*}\cong(V\otimes W)^{*}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mo style="--ltx-fg-color:#000000;" lspace="0.278em" mathcolor="#000000" rspace="0.278em">:</mo><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≅</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\phi\colon V^{*}\otimes W^{*}\cong(V\otimes W)^{*}</annotation></semantics></math> by <math id="A2.SS7.SSS4.Px2.p2.pic1.m12" class="ltx_Math" alttext="\phi(\ell\otimes\eta)(v\otimes w):=\ell(v)\eta(w)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">:=</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">v</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi(\ell\otimes\eta)(v\otimes w):=\ell(v)\eta(w)</annotation></semantics></math>. This shows the two trace maps <math id="A2.SS7.SSS4.Px2.p2.pic1.m13" class="ltx_Math" alttext="V^{*}\otimes W^{*}\otimes V\otimes W\to F" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">F</mi></mrow><annotation encoding="application/x-tex">V^{*}\otimes W^{*}\otimes V\otimes W\to F</annotation></semantics></math> (<math id="A2.SS7.SSS4.Px2.p2.pic1.m14" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> is the base field) given by tracing off <math id="A2.SS7.SSS4.Px2.p2.pic1.m15" class="ltx_Math" alttext="V\otimes W" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi></mrow><annotation encoding="application/x-tex">V\otimes W</annotation></semantics></math> or tracing off <math id="A2.SS7.SSS4.Px2.p2.pic1.m16" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math> and <math id="A2.SS7.SSS4.Px2.p2.pic1.m17" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> respectively are equal. Since <math id="A2.SS7.SSS4.Px2.p2.pic1.m18" class="ltx_Math" alttext="S\in V^{*}\otimes V" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">S</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></mrow></mrow><annotation encoding="application/x-tex">S\in V^{*}\otimes V</annotation></semantics></math>, <math id="A2.SS7.SSS4.Px2.p2.pic1.m19" class="ltx_Math" alttext="T\in W^{*}\otimes W" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msup><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⊗</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi></mrow></mrow><annotation encoding="application/x-tex">T\in W^{*}\otimes W</annotation></semantics></math>, this finishes the proof.</span></span><span class="ltx_inline-block"><svg id="A2.SS7.SSS4.Px2.p2.pic1.pic1" class="ltx_picture" color="#008000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#009900;--ltx-fill-color:#009900;--ltx-fg-color:#009900;" color="#009900" fill="#009900" stroke="#009900" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 7.87 L 5.51 0 L 15.75 15.75"></path></g></svg></span>
<span id="A2.SS7.SSS4.Px2.p2.pic1.2.5" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p2.pic1.2.5.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#008000;">GPT-5 thinking passed</span></span>
<span id="A2.SS7.SSS4.Px2.p2.pic1.2.6" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p2.pic1.2.6.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Qiuyu Ren</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS7.SSS4.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS7.SSS4.Px2.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS7.SSS4.Px2.p3" class="ltx_para">
<p id="A2.SS7.SSS4.Px2.p3.1" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p3.1.1" class="ltx_text">I prefer <span id="A2.SS7.SSS4.Px2.p3.1.1.1" class="ltx_text ltx_font_bold">Solution 2</span>.</span></p>
</div>
<div id="A2.SS7.SSS4.Px2.p4" class="ltx_para">
<p id="A2.SS7.SSS4.Px2.p4.1" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p4.1.1" class="ltx_text">It is basis-free and explains <em id="A2.SS7.SSS4.Px2.p4.1.1.1" class="ltx_emph ltx_font_italic">why</em> the identity holds: we identify
<math id="A2.SS7.SSS4.Px2.p4.m1" class="ltx_Math" alttext="\mathrm{End}(V)\cong V^{*}\otimes V" display="inline" intent=":literal"><semantics><mrow><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>V</mi><mo>∗</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">\mathrm{End}(V)\cong V^{*}\otimes V</annotation></semantics></math> and <math id="A2.SS7.SSS4.Px2.p4.m2" class="ltx_Math" alttext="\mathrm{End}(W)\cong W^{*}\otimes W" display="inline" intent=":literal"><semantics><mrow><mrow><mi>End</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><msup><mi>W</mi><mo>∗</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>W</mi></mrow></mrow><annotation encoding="application/x-tex">\mathrm{End}(W)\cong W^{*}\otimes W</annotation></semantics></math>;
the trace is simply the evaluation map
<math id="A2.SS7.SSS4.Px2.p4.m3" class="ltx_Math" alttext="\mathrm{ev}_{V}\colon V^{*}\otimes V\to F" display="inline" intent=":literal"><semantics><mrow><msub><mi>ev</mi><mi>V</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>V</mi><mo>∗</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>V</mi></mrow><mo stretchy="false">→</mo><mi>F</mi></mrow></mrow><annotation encoding="application/x-tex">\mathrm{ev}_{V}\colon V^{*}\otimes V\to F</annotation></semantics></math>.
The canonical isomorphism
<math id="A2.SS7.SSS4.Px2.p4.m4" class="ltx_Math" alttext="(V\otimes W)^{*}\cong V^{*}\otimes W^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><mo>∗</mo></msup><mo>≅</mo><mrow><msup><mi>V</mi><mo>∗</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>W</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">(V\otimes W)^{*}\cong V^{*}\otimes W^{*}</annotation></semantics></math> gives</span></p>
<table id="A2.Ex219" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex219.m1" class="ltx_Math" alttext="\mathrm{ev}_{V\otimes W}=(\mathrm{ev}_{V}\otimes\mathrm{ev}_{W})\circ(\mathrm{id}_{V^{*}}\otimes\tau\otimes\mathrm{id}_{W})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ev</mi><mrow><mi>V</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>W</mi></mrow></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ev</mi><mi>V</mi></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>ev</mi><mi>W</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">∘</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>id</mi><msup><mi>V</mi><mo>∗</mo></msup></msub><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>τ</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><msub><mi>id</mi><mi>W</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{ev}_{V\otimes W}=(\mathrm{ev}_{V}\otimes\mathrm{ev}_{W})\circ(\mathrm{id}_{V^{*}}\otimes\tau\otimes\mathrm{id}_{W}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS7.SSS4.Px2.p4.2" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p4.2.1" class="ltx_text">so applying this to <math id="A2.SS7.SSS4.Px2.p4.m5" class="ltx_Math" alttext="S\otimes T\in(V^{*}\otimes V)\otimes(W^{*}\otimes W)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>T</mi></mrow><mo>∈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>V</mi><mo>∗</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>V</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>W</mi><mo>∗</mo></msup><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S\otimes T\in(V^{*}\otimes V)\otimes(W^{*}\otimes W)</annotation></semantics></math> yields</span></p>
<table id="A2.Ex220" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex220.m1" class="ltx_Math" alttext="\operatorname{tr}(S\otimes T)=\operatorname{tr}(S)\,\operatorname{tr}(T)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{tr}(S\otimes T)=\operatorname{tr}(S)\,\operatorname{tr}(T).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS7.SSS4.Px2.p4.3" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p4.3.1" class="ltx_text">This viewpoint is invariant, clean, and generalizes (e.g., to representation theory or categorical traces).</span></p>
</div>
<div id="A2.SS7.SSS4.Px2.p5" class="ltx_para">
<p id="A2.SS7.SSS4.Px2.p5.1" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p5.1.1" class="ltx_text">That said, <span id="A2.SS7.SSS4.Px2.p5.1.1.1" class="ltx_text ltx_font_bold">Solution 1</span> is perfectly fine for a quick computation
once you know how the Kronecker product looks in coordinates.
One small correction there: it should read</span></p>
<table id="A2.Ex221" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex221.m1" class="ltx_Math" alttext="\operatorname{tr}(S\otimes T)=\sum_{i,j}S_{ii}T_{jj}=\left(\sum_{i}S_{ii}\right)\left(\sum_{j}T_{jj}\right)=\operatorname{tr}(S)\,\operatorname{tr}(T)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">⊗</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><mrow><msub><mi>S</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><mo>=</mo><mrow><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mi>i</mi></munder><msub><mi>S</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mi>j</mi></munder><msub><mi>T</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{tr}(S\otimes T)=\sum_{i,j}S_{ii}T_{jj}=\left(\sum_{i}S_{ii}\right)\left(\sum_{j}T_{jj}\right)=\operatorname{tr}(S)\,\operatorname{tr}(T).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS7.SSS4.Px2.p5.2" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p5.2.1" class="ltx_text">It is fast, but it hides the structural reason that Solution 2 makes explicit.
∎</span></p>
</div>
</div>
<div id="A2.SS7.SSS4.Px2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS7.SSS4.Px2.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS7.SSS4.Px2.p6" class="ltx_para">
<p id="A2.SS7.SSS4.Px2.p6.1" class="ltx_p"><span id="A2.SS7.SSS4.Px2.p6.1.1" class="ltx_text">I prefer Solution 2 since it is intrinsic and basis-free.
∎</span></p>
</div>
</div>
<div id="A2.SS7.SSS4.Px2.p7" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS4.Px2.p7.pic1" class="ltx_picture" height="152.65" overflow="visible" version="1.1" viewBox="0 0 429.64 152.65" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,152.65) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 148.02 C 0 150.57 2.07 152.65 4.63 152.65 L 425.01 152.65 C 427.56 152.65 429.64 150.57 429.64 148.02 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 133.78 L 428.94 133.78 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 138.41)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
