</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 12.5)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.56em;--ltx-fo-depth:0em;font-size:10pt;" height="7.69" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
