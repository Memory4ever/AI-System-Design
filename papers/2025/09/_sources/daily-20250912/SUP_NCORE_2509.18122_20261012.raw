</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS2.Px2.p61.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS11.SSS2.Px2.p61.pic1.2.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p61.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">1/2</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS11.SSS2.Px2.p62" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS11.SSS2.Px2.p62.pic1" class="ltx_picture" height="86.23" overflow="visible" version="1.1" viewBox="0 0 429.64 86.23" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,86.23) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 81.6 C 0 84.16 2.07 86.23 4.63 86.23 L 425.01 86.23 C 427.56 86.23 429.64 84.16 429.64 81.6 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 67.36 L 428.94 67.36 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 71.99)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS2.Px2.p62.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS11.SSS2.Px2.p62.pic1.1.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p62.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:2.96em;--ltx-fo-depth:0.16em;font-size:10pt;" height="43.05" overflow="visible" transform="matrix(1 0 0 -1 0 40.9)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS2.Px2.p62.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS11.SSS2.Px2.p62.pic1.2.1" class="ltx_p"><span id="A2.SS11.SSS2.Px2.p62.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Solution correctly identifies the pattern in the given sequence, but does not give the correct general theory of clock sequence. The solution also does not correctly identify all “sawtooth" or “mountain" clock sequences.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="A2.SS11.SSS2.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#00E000;">Problem 11b3</h5>

<div id="A2.SS11.SSS2.Px3.p1" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p1.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS11.SSS2.Px3.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS11.SSS2.Px3.p2.pic1" class="ltx_picture" height="249.91" overflow="visible" version="1.1" viewBox="0 0 429.64 249.91" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,249.91) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 245.28 C 0 247.84 2.07 249.91 4.63 249.91 L 425.01 249.91 C 427.56 249.91 429.64 247.84 429.64 245.28 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 231.04 L 428.94 231.04 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 235.67)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS2.Px3.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS11.SSS2.Px3.p2.pic1.1.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:14.78em;--ltx-fo-depth:0.16em;font-size:10pt;" height="206.73" overflow="visible" transform="matrix(1 0 0 -1 0 204.58)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS11.SSS2.Px3.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS11.SSS2.Px3.p2.pic1.2.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Explain the connection between the following two observations. Then propose a unifying theory that predicts decompositions for an arbitrary group.</span></span>
<span id="A2.I45" class="ltx_enumerate">
<span id="A2.I45.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="A2.I45.i1.p1" class="ltx_para">
<span id="A2.I45.i1.p1.1" class="ltx_p"><span id="A2.I45.i1.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Let </span><math id="A2.I45.i1.p1.m1" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">𝔾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math><span id="A2.I45.i1.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> be the multiplicative group scheme. It has exactly </span><math id="A2.I45.i1.p1.m2" class="ltx_Math" alttext="q-1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">q</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn></mrow><annotation encoding="application/x-tex">q-1</annotation></semantics></math><span id="A2.I45.i1.p1.1.3" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> </span><math id="A2.I45.i1.p1.m3" class="ltx_Math" alttext="\mathbb{F}_{q}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">𝔽</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">q</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{q}</annotation></semantics></math><span id="A2.I45.i1.p1.1.4" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> points.</span></span>
</span></span>
<span id="A2.I45.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<span id="A2.I45.i2.p1" class="ltx_para">
<span id="A2.I45.i2.p1.1" class="ltx_p"><span id="A2.I45.i2.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Let </span><math id="A2.I45.i2.p1.m1" class="ltx_Math" alttext="B\mathbb{G}_{m}=\mathrm{pt}/\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">𝔾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">m</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">pt</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em" stretchy="true" symmetric="true">/</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">𝔾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">m</mi></msub></mrow></mrow><annotation encoding="application/x-tex">B\mathbb{G}_{m}=\mathrm{pt}/\mathbb{G}_{m}</annotation></semantics></math><span id="A2.I45.i2.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> be the classifying stack of </span><math id="A2.I45.i2.p1.m2" class="ltx_Math" alttext="\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">𝔾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">m</mi></msub><annotation encoding="application/x-tex">\mathbb{G}_{m}</annotation></semantics></math><span id="A2.I45.i2.p1.1.3" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> bundles. Over the complex numbers it is represented by the homotopy type </span><math id="A2.I45.i2.p1.m3" class="ltx_Math" alttext="\mathbb{CP}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">ℙ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" mathvariant="normal">∞</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{CP}^{\infty}</annotation></semantics></math><span id="A2.I45.i2.p1.1.4" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> which admits a decomposition </span><math id="A2.I45.i2.p1.m4" class="ltx_Math" alttext="\mathbb{C}^{0}+\mathbb{C}^{1}+\mathbb{C}^{2}+\dots" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">ℂ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">0</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">ℂ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">ℂ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">\mathbb{C}^{0}+\mathbb{C}^{1}+\mathbb{C}^{2}+\dots</annotation></semantics></math><span id="A2.I45.i2.p1.1.5" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">. If we instead “counted </span><math id="A2.I45.i2.p1.m5" class="ltx_Math" alttext="\mathbb{F}_{q}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">𝔽</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">q</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{q}</annotation></semantics></math><span id="A2.I45.i2.p1.1.6" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> points", we would get the non-convergent series </span><math id="A2.I45.i2.p1.m6" class="ltx_Math" alttext="1+q+q^{2}+\dots=1/(1-q)" display="inline" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">q</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">q</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" mathvariant="normal">⋯</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em" stretchy="true" symmetric="true">/</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">q</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1+q+q^{2}+\dots=1/(1-q)</annotation></semantics></math><span id="A2.I45.i2.p1.1.7" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">.</span></span>
</span></span>
</span><span class="ltx_inline-block"><svg id="A2.SS11.SSS2.Px3.p2.pic1.pic1" class="ltx_picture" color="#008000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#009900;--ltx-fill-color:#009900;--ltx-fg-color:#009900;" color="#009900" fill="#009900" stroke="#009900" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 7.87 L 5.51 0 L 15.75 15.75"></path></g></svg></span>
<span id="A2.SS11.SSS2.Px3.p2.pic1.2.2" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#008000;">GPT-5 thinking passed</span></span>
<span id="A2.SS11.SSS2.Px3.p2.pic1.2.3" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p2.pic1.2.3.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Tahsin Saffat</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS11.SSS2.Px3.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS11.SSS2.Px3.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS11.SSS2.Px3.p3" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p3.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p3.1.1" class="ltx_text">Great question. The two bullets are the same phenomenon seen through two “realizations” of one object:</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p4" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p4.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p4.1.1" class="ltx_text">* Over <math id="A2.SS11.SSS2.Px3.p4.m1" class="ltx_Math" alttext="\mathbb{C}" display="inline" intent=":literal"><semantics><mi>ℂ</mi><annotation encoding="application/x-tex">\mathbb{C}</annotation></semantics></math>, the classifying space <math id="A2.SS11.SSS2.Px3.p4.m2" class="ltx_Math" alttext="B\mathbb{G}_{m}\simeq\mathbb{CP}^{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow><mo>≃</mo><mrow><mi>ℂ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ℙ</mi><mi mathvariant="normal">∞</mi></msup></mrow></mrow><annotation encoding="application/x-tex">B\mathbb{G}_{m}\simeq\mathbb{CP}^{\infty}</annotation></semantics></math> has one cell in each even real degree, so its Poincaré series is</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p5" class="ltx_para">
<table id="A2.Ex346" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex346.m1" class="ltx_Math" alttext="P_{B\mathbb{G}_{m}}(t)=1+t^{2}+t^{4}+\cdots=\frac{1}{1-t^{2}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>P</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mo>+</mo><msup><mi>t</mi><mn>4</mn></msup><mo>+</mo><mo lspace="0em" rspace="0.1389em">⋯</mo></mrow><mo lspace="0.1389em">=</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>t</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">P_{B\mathbb{G}_{m}}(t)=1+t^{2}+t^{4}+\cdots=\frac{1}{1-t^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS11.SSS2.Px3.p5.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p5.1.1" class="ltx_text">* Over <math id="A2.SS11.SSS2.Px3.p5.m1" class="ltx_Math" alttext="\mathbb{F}_{q}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>q</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{q}</annotation></semantics></math>, if you count *stacky* points (groupoid cardinality), then</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p6" class="ltx_para">
<table id="A2.Ex347" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex347.m1" class="ltx_Math" alttext="\#\,B\mathbb{G}_{m}(\mathbb{F}_{q})=\frac{1}{\#\,\mathbb{G}_{m}(\mathbb{F}_{q})}=\frac{1}{q-1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>#</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi>#</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\#\,B\mathbb{G}_{m}(\mathbb{F}_{q})=\frac{1}{\#\,\mathbb{G}_{m}(\mathbb{F}_{q})}=\frac{1}{q-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px3.p7" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p7.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p7.1.1" class="ltx_text">These are two specializations of the same *motivic* class</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p8" class="ltx_para">
<table id="A2.Ex348" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex348.m1" class="ltx_Math" alttext="[\,B\mathbb{G}_{m}\,]=\frac{1}{\mathbb{L}-1}\qquad(\mathbb{L}=[\mathbb{A}^{1}])" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi>𝕃</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>𝕃</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><msup><mi>𝔸</mi><mn>1</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">[\,B\mathbb{G}_{m}\,]=\frac{1}{\mathbb{L}-1}\qquad(\mathbb{L}=[\mathbb{A}^{1}])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px3.p9" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p9.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p9.1.1" class="ltx_text">in the Grothendieck ring of stacks. Sending <math id="A2.SS11.SSS2.Px3.p9.m1" class="ltx_Math" alttext="\mathbb{L}\mapsto q" display="inline" intent=":literal"><semantics><mrow><mi>𝕃</mi><mo stretchy="false">↦</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">\mathbb{L}\mapsto q</annotation></semantics></math> (finite-field point count) gives <math id="A2.SS11.SSS2.Px3.p9.m2" class="ltx_Math" alttext="1/(q-1)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1/(q-1)</annotation></semantics></math>. Sending <math id="A2.SS11.SSS2.Px3.p9.m3" class="ltx_Math" alttext="\mathbb{L}\mapsto t^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝕃</mi><mo stretchy="false">↦</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{L}\mapsto t^{2}</annotation></semantics></math> (topological/Hodge realization) gives <math id="A2.SS11.SSS2.Px3.p9.m4" class="ltx_Math" alttext="1/(1-t^{2})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1/(1-t^{2})</annotation></semantics></math>, i.e. one cell in every even degree. The “dividing by automorphisms” in the stack count exactly inverts the ordinary count <math id="A2.SS11.SSS2.Px3.p9.m5" class="ltx_Math" alttext="\#\mathbb{G}_{m}(\mathbb{F}_{q})=q-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>#</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔾</mi><mi>m</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\#\mathbb{G}_{m}(\mathbb{F}_{q})=q-1</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p10" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p10.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p10.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p11" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p11.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p11.1.1" class="ltx_text"># A unifying theory (works for arbitrary linear algebraic <math id="A2.SS11.SSS2.Px3.p11.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>)</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p12" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p12.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p12.1.1" class="ltx_text">Work in the Grothendieck ring of stacks <math id="A2.SS11.SSS2.Px3.p12.m1" class="ltx_Math" alttext="K_{0}(\mathrm{Stck}_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>K</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Stck</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">K_{0}(\mathrm{Stck}_{k})</annotation></semantics></math> with <math id="A2.SS11.SSS2.Px3.p12.m2" class="ltx_Math" alttext="\mathbb{L}=[\mathbb{A}^{1}]" display="inline" intent=":literal"><semantics><mrow><mi>𝕃</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><msup><mi>𝔸</mi><mn>1</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{L}=[\mathbb{A}^{1}]</annotation></semantics></math>. For very broad classes of groups (certainly for all connected split reductive <math id="A2.SS11.SSS2.Px3.p12.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, and more generally for affine <math id="A2.SS11.SSS2.Px3.p12.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> in this setting) one has</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p13" class="ltx_para">
<table id="A2.Ex349" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex349.m1" class="ltx_Math" alttext="[\,BG\,]=\frac{1}{[G]}\in K_{0}(\mathrm{Stck}_{k})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo lspace="0.170em" stretchy="false">]</mo></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">[</mo><mi>G</mi><mo stretchy="false">]</mo></mrow></mfrac><mo>∈</mo><mrow><msub><mi>K</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Stck</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">[\,BG\,]=\frac{1}{[G]}\in K_{0}(\mathrm{Stck}_{k}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px3.p14" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p14.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p14.1.1" class="ltx_text">and for connected split reductive <math id="A2.SS11.SSS2.Px3.p14.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> of rank <math id="A2.SS11.SSS2.Px3.p14.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> with fundamental degrees <math id="A2.SS11.SSS2.Px3.p14.m3" class="ltx_Math" alttext="d_{1},\dots,d_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>d</mi><mi>r</mi></msub></mrow><annotation encoding="application/x-tex">d_{1},\dots,d_{r}</annotation></semantics></math> (i.e. <math id="A2.SS11.SSS2.Px3.p14.m4" class="ltx_Math" alttext="d_{i}=m_{i}+1" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>m</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">d_{i}=m_{i}+1</annotation></semantics></math> where <math id="A2.SS11.SSS2.Px3.p14.m5" class="ltx_Math" alttext="m_{i}" display="inline" intent=":literal"><semantics><msub><mi>m</mi><mi>i</mi></msub><annotation encoding="application/x-tex">m_{i}</annotation></semantics></math> are the exponents of the Weyl group),</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p15" class="ltx_para">
<table id="A2.Ex350" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex350.m1" class="ltx_math_unparsed" alttext="[\,G\,]=\mathbb{L}^{\dim G}\prod_{i=1}^{r}\bigl(1-\mathbb{L}^{-d_{i}}\bigr)\quad\Longrightarrow\quad[\,BG\,]=\mathbb{L}^{-\dim G}\prod_{i=1}^{r}\bigl(1-\mathbb{L}^{-d_{i}}\bigr)^{-1}.(*)" display="block" intent=":literal"><semantics><mrow><mrow><mo rspace="0.170em" stretchy="false">[</mo><mi>G</mi><mo lspace="0.170em" stretchy="false">]</mo></mrow><mo>=</mo><msup><mi>𝕃</mi><mrow><mo rspace="0.167em">dim</mo><mi>G</mi></mrow></msup><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>1</mn><mo>−</mo><msup><mi>𝕃</mi><mrow><mo>−</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo stretchy="false">⟹</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mi>B</mi><mi>G</mi><mo lspace="0.170em" stretchy="false">]</mo></mrow><mo>=</mo><msup><mi>𝕃</mi><mrow><mo>−</mo><mo lspace="0em" rspace="0.167em">dim</mo><mi>G</mi></mrow></msup><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>1</mn><mo>−</mo><msup><mi>𝕃</mi><mrow><mo>−</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">[\,G\,]=\mathbb{L}^{\dim G}\prod_{i=1}^{r}\bigl(1-\mathbb{L}^{-d_{i}}\bigr)\quad\Longrightarrow\quad[\,BG\,]=\mathbb{L}^{-\dim G}\prod_{i=1}^{r}\bigl(1-\mathbb{L}^{-d_{i}}\bigr)^{-1}.(*)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px3.p16" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p16.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p16.1.1" class="ltx_text">This single motivic identity predicts *all* the decompositions you’re after via its standard realizations:</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p17" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p17.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p17.1.1" class="ltx_text">* **Arithmetic (finite-field) realization.** Send <math id="A2.SS11.SSS2.Px3.p17.m1" class="ltx_Math" alttext="\mathbb{L}\mapsto q" display="inline" intent=":literal"><semantics><mrow><mi>𝕃</mi><mo stretchy="false">↦</mo><mi>q</mi></mrow><annotation encoding="application/x-tex">\mathbb{L}\mapsto q</annotation></semantics></math>. Then</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p18" class="ltx_para">
<table id="A2.Ex351" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex351.m1" class="ltx_math_unparsed" alttext="\#\,BG(\mathbb{F}_{q})\;=\;q^{-\dim G}\prod_{i=1}^{r}\bigl(1-q^{-d_{i}}\bigr)^{-1}\;=\;\frac{1}{\#\,G(\mathbb{F}_{q})}." display="block" intent=":literal"><semantics><mrow><mi>#</mi><mi>B</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow><mo rspace="0.558em">=</mo><msup><mi>q</mi><mrow><mo>−</mo><mo lspace="0em" rspace="0.167em">dim</mo><mi>G</mi></mrow></msup><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mn>1</mn><mo>−</mo><msup><mi>q</mi><mrow><mo>−</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></msup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0.558em">=</mo><mfrac><mn>1</mn><mrow><mi>#</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\#\,BG(\mathbb{F}_{q})\;=\;q^{-\dim G}\prod_{i=1}^{r}\bigl(1-q^{-d_{i}}\bigr)^{-1}\;=\;\frac{1}{\#\,G(\mathbb{F}_{q})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px3.p19" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p19.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p19.1.1" class="ltx_text">(This recovers the classical order formula for split reductive groups and its reciprocal for the stack.)</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p20" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p20.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p20.1.1" class="ltx_text">* **Topological (rational cohomology) realization.** Send <math id="A2.SS11.SSS2.Px3.p20.m1" class="ltx_Math" alttext="\mathbb{L}\mapsto t^{2}" display="inline" intent=":literal"><semantics><mrow><mi>𝕃</mi><mo stretchy="false">↦</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{L}\mapsto t^{2}</annotation></semantics></math>. Borel’s theorem gives</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p21" class="ltx_para">
<table id="A2.Ex352" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex352.m1" class="ltx_Math" alttext="H^{\ast}(BG;\mathbb{Q})\cong\mathbb{Q}[x_{1},\dots,x_{r}],\quad\deg x_{i}=2d_{i}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>H</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>,</mo><mi>ℚ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≅</mo><mrow><mi>ℚ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><mi>r</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><msub><mi>x</mi><mi>i</mi></msub></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">H^{\ast}(BG;\mathbb{Q})\cong\mathbb{Q}[x_{1},\dots,x_{r}],\quad\deg x_{i}=2d_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px3.p22" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p22.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p22.1.1" class="ltx_text">hence the Poincaré series</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p23" class="ltx_para">
<table id="A2.Ex353" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex353.m1" class="ltx_Math" alttext="P_{BG}(t)=\prod_{i=1}^{r}\frac{1}{1-t^{2d_{i}}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>P</mi><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>t</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></msup></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">P_{BG}(t)=\prod_{i=1}^{r}\frac{1}{1-t^{2d_{i}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px3.p24" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p24.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p24.1.1" class="ltx_text">which you can read as a “cellular decomposition”: for each <math id="A2.SS11.SSS2.Px3.p24.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> there is a tower of even-dimensional cells in degrees <math id="A2.SS11.SSS2.Px3.p24.m2" class="ltx_Math" alttext="0,2d_{i},4d_{i},\dots" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>,</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">0,2d_{i},4d_{i},\dots</annotation></semantics></math>; multiplying the towers reflects taking monomials in the <math id="A2.SS11.SSS2.Px3.p24.m3" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p25" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p25.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p25.1.1" class="ltx_text">* **Hodge/weight (mixed Hodge / <math id="A2.SS11.SSS2.Px3.p25.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-adic) realization.** Send <math id="A2.SS11.SSS2.Px3.p25.m2" class="ltx_Math" alttext="\mathbb{L}\mapsto uv" display="inline" intent=":literal"><semantics><mrow><mi>𝕃</mi><mo stretchy="false">↦</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">\mathbb{L}\mapsto uv</annotation></semantics></math> (or <math id="A2.SS11.SSS2.Px3.p25.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> with Tate twists). One gets</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p26" class="ltx_para">
<table id="A2.Ex354" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex354.m1" class="ltx_math_unparsed" alttext="E(BG;u,v)=(uv)^{-\dim G}\prod_{i=1}^{r}\frac{1}{1-(uv)^{d_{i}}}," display="block" intent=":literal"><semantics><mrow><mi>E</mi><mrow><mo stretchy="false">(</mo><mi>B</mi><mi>G</mi><mo>;</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mi>u</mi><mi>v</mi><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mo lspace="0em" rspace="0.167em">dim</mo><mi>G</mi></mrow></msup><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>r</mi></munderover><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><msub><mi>d</mi><mi>i</mi></msub></msup></mrow></mfrac><mo>,</mo></mrow><annotation encoding="application/x-tex">E(BG;u,v)=(uv)^{-\dim G}\prod_{i=1}^{r}\frac{1}{1-(uv)^{d_{i}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px3.p27" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p27.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p27.1.1" class="ltx_text">matching Deligne’s weights and the Weil–Grothendieck trace formula for stacks.</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p28" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p28.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p28.1.1" class="ltx_text">Expanding <math id="A2.SS11.SSS2.Px3.p28.m1" class="ltx_Math" alttext="(*)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(*)</annotation></semantics></math> as geometric series gives a *motivic cell decomposition*</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p29" class="ltx_para">
<table id="A2.Ex355" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex355.m1" class="ltx_Math" alttext="[\,BG\,]=\sum_{k_{1},\dots,k_{r}\geq 0}\mathbb{L}^{-\bigl(\dim G+\sum_{i}k_{i}d_{i}\bigr)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.170em" stretchy="false">[</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo lspace="0.170em" stretchy="false">]</mo></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msub><mi>k</mi><mi>r</mi></msub><mo>≥</mo><mn>0</mn></mrow></mrow></munder><msup><mi>𝕃</mi><mrow><mo>−</mo><mrow><mo maxsize="1.710em" minsize="1.710em">(</mo><mrow><mrow><mo lspace="0em" rspace="0.167em">dim</mo><mi>G</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mi>i</mi></msub></mstyle><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></mrow></mrow><mo maxsize="1.710em" minsize="1.710em">)</mo></mrow></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">[\,BG\,]=\sum_{k_{1},\dots,k_{r}\geq 0}\mathbb{L}^{-\bigl(\dim G+\sum_{i}k_{i}d_{i}\bigr)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px3.p30" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p30.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p30.1.1" class="ltx_text">i.e. “one virtual affine cell” in every degree <math id="A2.SS11.SSS2.Px3.p30.m1" class="ltx_Math" alttext="\sum_{i}k_{i}d_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><msub><mi>k</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\sum_{i}k_{i}d_{i}</annotation></semantics></math>. Over <math id="A2.SS11.SSS2.Px3.p30.m2" class="ltx_Math" alttext="\mathbb{C}" display="inline" intent=":literal"><semantics><mi>ℂ</mi><annotation encoding="application/x-tex">\mathbb{C}</annotation></semantics></math> this matches the CW-structure on <math id="A2.SS11.SSS2.Px3.p30.m3" class="ltx_Math" alttext="BG" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">BG</annotation></semantics></math> rationally; over <math id="A2.SS11.SSS2.Px3.p30.m4" class="ltx_Math" alttext="\mathbb{F}_{q}" display="inline" intent=":literal"><semantics><msub><mi>𝔽</mi><mi>q</mi></msub><annotation encoding="application/x-tex">\mathbb{F}_{q}</annotation></semantics></math> it predicts the corresponding geometric series in <math id="A2.SS11.SSS2.Px3.p30.m5" class="ltx_Math" alttext="q^{-d_{i}}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mrow><mo>−</mo><msub><mi>d</mi><mi>i</mi></msub></mrow></msup><annotation encoding="application/x-tex">q^{-d_{i}}</annotation></semantics></math>, whose product is exactly <math id="A2.SS11.SSS2.Px3.p30.m6" class="ltx_Math" alttext="1/\#G(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>/</mo><mi>#</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1/\#G(\mathbb{F}_{q})</annotation></semantics></math> after the global Tate factor <math id="A2.SS11.SSS2.Px3.p30.m7" class="ltx_math_unparsed" alttext="q^{-\dim G}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><msup><mrow></mrow><mrow><mo>−</mo><mo lspace="0em" rspace="0.167em">dim</mo><mi>G</mi></mrow></msup></mrow><annotation encoding="application/x-tex">q^{-\dim G}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p31" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p31.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p31.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p32" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p32.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p32.1.1" class="ltx_text">## Quick examples</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p33" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p33.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p33.1.1" class="ltx_text">* <math id="A2.SS11.SSS2.Px3.p33.m1" class="ltx_Math" alttext="G=\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">G=\mathbb{G}_{m}</annotation></semantics></math>: <math id="A2.SS11.SSS2.Px3.p33.m2" class="ltx_Math" alttext="r=1,d_{1}=1,\dim G=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mrow><mrow><mo lspace="0em" rspace="0.167em">dim</mo><mi>G</mi></mrow><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">r=1,d_{1}=1,\dim G=1</annotation></semantics></math>.
<math id="A2.SS11.SSS2.Px3.p33.m3" class="ltx_Math" alttext="[BG]=\mathbb{L}^{-1}(1-\mathbb{L}^{-1})^{-1}=\frac{1}{\mathbb{L}-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><msup><mi>𝕃</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>𝕃</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi>𝕃</mi><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding="application/x-tex">[BG]=\mathbb{L}^{-1}(1-\mathbb{L}^{-1})^{-1}=\frac{1}{\mathbb{L}-1}</annotation></semantics></math>.
Topology: <math id="A2.SS11.SSS2.Px3.p33.m4" class="ltx_Math" alttext="1/(1-t^{2})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>t</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1/(1-t^{2})</annotation></semantics></math>. Arithmetic: <math id="A2.SS11.SSS2.Px3.p33.m5" class="ltx_Math" alttext="1/(q-1)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>q</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">1/(q-1)</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p34" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p34.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p34.1.1" class="ltx_text">* <math id="A2.SS11.SSS2.Px3.p34.m1" class="ltx_Math" alttext="G=\mathrm{GL}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><msub><mi>GL</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">G=\mathrm{GL}_{n}</annotation></semantics></math>: <math id="A2.SS11.SSS2.Px3.p34.m2" class="ltx_Math" alttext="d_{i}=i" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>=</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">d_{i}=i</annotation></semantics></math> for <math id="A2.SS11.SSS2.Px3.p34.m3" class="ltx_Math" alttext="i=1,\dots,n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">i=1,\dots,n</annotation></semantics></math>, <math id="A2.SS11.SSS2.Px3.p34.m4" class="ltx_Math" alttext="\dim G=n^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>G</mi></mrow><mo>=</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\dim G=n^{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p35" class="ltx_para">
<table id="A2.Ex356" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex356.m1" class="ltx_Math" alttext="[B\mathrm{GL}_{n}]=\mathbb{L}^{-n^{2}}\prod_{i=1}^{n}(1-\mathbb{L}^{-i})^{-1}\quad\leadsto\quad\#\,B\mathrm{GL}_{n}(\mathbb{F}_{q})=\frac{1}{\prod_{i=0}^{n-1}(q^{n}-q^{i})}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>GL</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><msup><mi>𝕃</mi><mrow><mo>−</mo><msup><mi>n</mi><mn>2</mn></msup></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>𝕃</mi><mrow><mo>−</mo><mi>i</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mo stretchy="false">↝</mo><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>#</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>GL</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><msup><mi>q</mi><mi>n</mi></msup><mo>−</mo><msup><mi>q</mi><mi>i</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[B\mathrm{GL}_{n}]=\mathbb{L}^{-n^{2}}\prod_{i=1}^{n}(1-\mathbb{L}^{-i})^{-1}\quad\leadsto\quad\#\,B\mathrm{GL}_{n}(\mathbb{F}_{q})=\frac{1}{\prod_{i=0}^{n-1}(q^{n}-q^{i})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS11.SSS2.Px3.p36" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p36.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p36.1.1" class="ltx_text">Topology: <math id="A2.SS11.SSS2.Px3.p36.m1" class="ltx_Math" alttext="P(t)=\prod_{i=1}^{n}(1-t^{2i})^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>t</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">P(t)=\prod_{i=1}^{n}(1-t^{2i})^{-1}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p37" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p37.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p37.1.1" class="ltx_text">* <math id="A2.SS11.SSS2.Px3.p37.m1" class="ltx_Math" alttext="G=\mathrm{SL}_{n}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><msub><mi>SL</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">G=\mathrm{SL}_{n}</annotation></semantics></math>: <math id="A2.SS11.SSS2.Px3.p37.m2" class="ltx_Math" alttext="d_{i}=2,3,\dots,n" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mi>i</mi></msub><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mn>3</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">d_{i}=2,3,\dots,n</annotation></semantics></math>, <math id="A2.SS11.SSS2.Px3.p37.m3" class="ltx_Math" alttext="\dim G=n^{2}-1" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>G</mi></mrow><mo>=</mo><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\dim G=n^{2}-1</annotation></semantics></math>.
<math id="A2.SS11.SSS2.Px3.p37.m4" class="ltx_Math" alttext="[B\mathrm{SL}_{n}]=\mathbb{L}^{-(n^{2}-1)}\prod_{i=2}^{n}(1-\mathbb{L}^{-i})^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>SL</mi><mi>n</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mrow><msup><mi>𝕃</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>n</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mi>n</mi></msubsup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>𝕃</mi><mrow><mo>−</mo><mi>i</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">[B\mathrm{SL}_{n}]=\mathbb{L}^{-(n^{2}-1)}\prod_{i=2}^{n}(1-\mathbb{L}^{-i})^{-1}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p38" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p38.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p38.1.1" class="ltx_text">For disconnected <math id="A2.SS11.SSS2.Px3.p38.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, a finite component group contributes a factor <math id="A2.SS11.SSS2.Px3.p38.m2" class="ltx_Math" alttext="1/|\pi_{0}(G)|" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>π</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">1/|\pi_{0}(G)|</annotation></semantics></math> in the arithmetic realization (and similarly in the motivic class).</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p39" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p39.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p39.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p40" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p40.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p40.1.1" class="ltx_text">### Takeaway</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p41" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p41.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p41.1.1" class="ltx_text">Use the *motivic class of the classifying stack* <math id="A2.SS11.SSS2.Px3.p41.m1" class="ltx_Math" alttext="[BG]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[BG]</annotation></semantics></math> as the master object. It simultaneously:</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p42" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p42.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p42.1.1" class="ltx_text">* inverts the point-count of <math id="A2.SS11.SSS2.Px3.p42.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> (stacky counting);
* encodes the topological cell structure of <math id="A2.SS11.SSS2.Px3.p42.m2" class="ltx_Math" alttext="BG" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">BG</annotation></semantics></math> (via Poincaré/Hodge series);
* and generalizes uniformly to any linear algebraic group through the fundamental degrees <math id="A2.SS11.SSS2.Px3.p42.m3" class="ltx_Math" alttext="d_{i}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>i</mi></msub><annotation encoding="application/x-tex">d_{i}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p43" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p43.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p43.1.1" class="ltx_text">Your two observations are simply the <math id="A2.SS11.SSS2.Px3.p43.m1" class="ltx_Math" alttext="G=\mathbb{G}_{m}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><msub><mi>𝔾</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">G=\mathbb{G}_{m}</annotation></semantics></math> case of this general dictionary.</span></p>
</div>
<div id="A2.SS11.SSS2.Px3.p44" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p44.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p44.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS11.SSS2.Px3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS11.SSS2.Px3.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS11.SSS2.Px3.p45" class="ltx_para">
<p id="A2.SS11.SSS2.Px3.p45.1" class="ltx_p"><span id="A2.SS11.SSS2.Px3.p45.1.1" class="ltx_text">The correct prediction is that expanding <math id="A2.SS11.SSS2.Px3.p45.m1" class="ltx_Math" alttext="q^{\mathrm{dim}G}/\#G(\mathbb{F}_{q})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>q</mi><mrow><mi>dim</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow></msup><mo>/</mo><mi>#</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝔽</mi><mi>q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q^{\mathrm{dim}G}/\#G(\mathbb{F}_{q})</annotation></semantics></math> as a power series in <math id="A2.SS11.SSS2.Px3.p45.m2" class="ltx_Math" alttext="q^{-1}" display="inline" intent=":literal"><semantics><msup><mi>q</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">q^{-1}</annotation></semantics></math> gives the cell decomposition of <math id="A2.SS11.SSS2.Px3.p45.m3" class="ltx_Math" alttext="BG" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">BG</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A2.SS11.SSS2.Px3.p46" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS11.SSS2.Px3.p46.pic1" class="ltx_picture" height="53.02" overflow="visible" version="1.1" viewBox="0 0 429.64 53.02" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,53.02) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 48.39 C 0 50.95 2.07 53.02 4.63 53.02 L 425.01 53.02 C 427.56 53.02 429.64 50.95 429.64 48.39 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 34.15 L 428.94 34.15 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 38.78)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
