</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:1.76em;--ltx-fo-depth:0.2em;font-size:10pt;" height="27.06" overflow="visible" transform="matrix(1 0 0 -1 0 24.29)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS4.SSS2.Px2.p16.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS4.SSS2.Px2.p16.pic1.2.1" class="ltx_p"><span id="A2.SS4.SSS2.Px2.p16.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The lower bound construction does not cover cells at the outer border, as well as the cell <math id="A2.SS4.SSS2.Px2.p16.pic1.m1" class="ltx_Math" alttext="(2,2)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(2,2)</annotation></semantics></math>.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="A2.SS4.SSS2.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph"><span id="A2.SS4.SSS2.Px3.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">Problem 4b3 </span> </h5>

<div id="A2.SS4.SSS2.Px3.p1" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p1.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS4.SSS2.Px3.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS4.SSS2.Px3.p2.pic1" class="ltx_picture" height="217.16" overflow="visible" version="1.1" viewBox="0 0 429.64 217.16" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,217.16) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 212.53 C 0 215.09 2.07 217.16 4.63 217.16 L 425.01 217.16 C 427.56 217.16 429.64 215.09 429.64 212.53 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 198.3 L 428.94 198.3 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 202.92)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS4.SSS2.Px3.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS4.SSS2.Px3.p2.pic1.1.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:12.42em;--ltx-fo-depth:0.16em;font-size:10pt;" height="173.98" overflow="visible" transform="matrix(1 0 0 -1 0 171.83)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS4.SSS2.Px3.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS4.SSS2.Px3.p2.pic1.2.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">(<em id="A2.SS4.SSS2.Px3.p2.pic1.2.1.1.1" class="ltx_emph ltx_font_italic">Problem Decoposition</em>)Let <math id="A2.SS4.SSS2.Px3.p2.pic1.m1" class="ltx_Math" alttext="a,b,c,d,e\geq-1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">a,b,c,d,e\geq-1</annotation></semantics></math> be real numbers such that</span></span>
<span id="A2.Ex129" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex129.m1" class="ltx_Math" alttext="a+b+c+d+e=5." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">d</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">e</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">5</mn></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">.</mo></mrow><annotation encoding="application/x-tex">a+b+c+d+e=5.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A2.SS4.SSS2.Px3.p2.pic1.2.2" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Find the <span id="A2.SS4.SSS2.Px3.p2.pic1.2.2.1.1" class="ltx_text ltx_font_bold">minimum</span> and <span id="A2.SS4.SSS2.Px3.p2.pic1.2.2.1.2" class="ltx_text ltx_font_bold">maximum</span> values of the expression</span></span>
<span id="A2.Ex130" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex130.m1" class="ltx_Math" alttext="S=(a+b)(b+c)(c+d)(d+e)(e+a)." display="block" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">S</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">=</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">a</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">b</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">b</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">c</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">c</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">d</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">d</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">e</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">e</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">a</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">.</mo></mrow><annotation encoding="application/x-tex">S=(a+b)(b+c)(c+d)(d+e)(e+a).</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span><span class="ltx_inline-block"><svg id="A2.SS4.SSS2.Px3.p2.pic1.pic1" class="ltx_picture" color="#FF0000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 0 L 15.75 15.75 M 0 15.75 L 15.75 0"></path></g></svg></span>
<span id="A2.SS4.SSS2.Px3.p2.pic1.2.3" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p2.pic1.2.3.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;">GPT-5 thinking failed</span></span>
<span id="A2.SS4.SSS2.Px3.p2.pic1.2.4" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p2.pic1.2.4.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Jiaxin Zhang</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS4.SSS2.Px3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS4.SSS2.Px3.2.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS4.SSS2.Px3.p3" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p3.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p3.1.1" class="ltx_text">Set</span></p>
<table id="A2.Ex131" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex131.m1" class="ltx_Math" alttext="x_{1}=a+b,\quad x_{2}=b+c,\quad x_{3}=c+d,\quad x_{4}=d+e,\quad x_{5}=e+a." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>=</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>x</mi><mn>3</mn></msub><mo>=</mo><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>x</mi><mn>4</mn></msub><mo>=</mo><mrow><mi>d</mi><mo>+</mo><mi>e</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>x</mi><mn>5</mn></msub><mo>=</mo><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x_{1}=a+b,\quad x_{2}=b+c,\quad x_{3}=c+d,\quad x_{4}=d+e,\quad x_{5}=e+a.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p3.2" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p3.2.1" class="ltx_text">Then</span></p>
<table id="A2.Ex132" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex132.m1" class="ltx_Math" alttext="x_{1}+x_{2}+x_{3}+x_{4}+x_{5}=2(a+b+c+d+e)=10," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>+</mo><msub><mi>x</mi><mn>2</mn></msub><mo>+</mo><msub><mi>x</mi><mn>3</mn></msub><mo>+</mo><msub><mi>x</mi><mn>4</mn></msub><mo>+</mo><msub><mi>x</mi><mn>5</mn></msub></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>+</mo><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>10</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">x_{1}+x_{2}+x_{3}+x_{4}+x_{5}=2(a+b+c+d+e)=10,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p3.3" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p3.3.1" class="ltx_text">and</span></p>
<table id="A2.Ex133" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex133.m1" class="ltx_Math" alttext="S=\prod_{i=1}^{5}x_{i}." display="block" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>5</mn></munderover><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S=\prod_{i=1}^{5}x_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p3.4" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p3.4.1" class="ltx_text">From <math id="A2.SS4.SSS2.Px3.p3.m1" class="ltx_Math" alttext="a,b,c,d,e\geq-1" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi><mo>,</mo><mrow><mi>e</mi><mo>≥</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">a,b,c,d,e\geq-1</annotation></semantics></math> we have the bounds</span></p>
<table id="A2.Ex134" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex134.m1" class="ltx_Math" alttext="-2\leq x_{i}\leq 8\qquad(i=1,\dots,5)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mn>2</mn></mrow><mo>≤</mo><msub><mi>x</mi><mi>i</mi></msub><mo>≤</mo><mn>8</mn></mrow><mspace style="width:2em;" width="2em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>5</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">-2\leq x_{i}\leq 8\qquad(i=1,\dots,5),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p3.5" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p3.5.1" class="ltx_text">since <math id="A2.SS4.SSS2.Px3.p3.m2" class="ltx_Math" alttext="x_{i}=a_{i}+a_{i+1}\geq-1+(-1)=-2" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>a</mi><mi>i</mi></msub><mo>+</mo><msub><mi>a</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>≥</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">x_{i}=a_{i}+a_{i+1}\geq-1+(-1)=-2</annotation></semantics></math>, and maximizing one pair sum while minimizing the other three variables at <math id="A2.SS4.SSS2.Px3.p3.m3" class="ltx_Math" alttext="-1" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">-1</annotation></semantics></math> gives
<math id="A2.SS4.SSS2.Px3.p3.m4" class="ltx_Math" alttext="x_{i}\leq 5-(-1-1-1)=8" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>≤</mo><mrow><mn>5</mn><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>−</mo><mn>1</mn><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">x_{i}\leq 5-(-1-1-1)=8</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p4" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS2.Px3.p4.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p4.1.1" class="ltx_text ltx_font_bold">Maximum.</span>
If some <math id="A2.SS4.SSS2.Px3.p4.m1" class="ltx_Math" alttext="x_{i}\leq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{i}\leq 0</annotation></semantics></math>, then <math id="A2.SS4.SSS2.Px3.p4.m2" class="ltx_Math" alttext="S\leq 0" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S\leq 0</annotation></semantics></math>, while the feasible point <math id="A2.SS4.SSS2.Px3.p4.m3" class="ltx_Math" alttext="a=b=c=d=e=1" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mi>b</mi><mo>=</mo><mi>c</mi><mo>=</mo><mi>d</mi><mo>=</mo><mi>e</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">a=b=c=d=e=1</annotation></semantics></math> yields <math id="A2.SS4.SSS2.Px3.p4.m4" class="ltx_Math" alttext="S=2^{5}=32&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>=</mo><msup><mn>2</mn><mn>5</mn></msup><mo>=</mo><mn>32</mn><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S=2^{5}=32&gt;0</annotation></semantics></math>. Hence at a maximizer we must have <math id="A2.SS4.SSS2.Px3.p4.m5" class="ltx_Math" alttext="x_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x_{i}&gt;0</annotation></semantics></math> for all <math id="A2.SS4.SSS2.Px3.p4.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and by AM–GM,</p>
<table id="A2.Ex135" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex135.m1" class="ltx_Math" alttext="S=\prod_{i=1}^{5}x_{i}\leq\Big(\tfrac{x_{1}+\cdots+x_{5}}{5}\Big)^{\!5}=\Big(\tfrac{10}{5}\Big)^{\!5}=32," display="block" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>5</mn></munderover><msub><mi>x</mi><mi>i</mi></msub></mrow><mo>≤</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="false"><mfrac><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>x</mi><mn>5</mn></msub></mrow><mn>5</mn></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>5</mn></msup><mo>=</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="false"><mfrac><mn>10</mn><mn>5</mn></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>5</mn></msup><mo>=</mo><mn>32</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S=\prod_{i=1}^{5}x_{i}\leq\Big(\tfrac{x_{1}+\cdots+x_{5}}{5}\Big)^{\!5}=\Big(\tfrac{10}{5}\Big)^{\!5}=32,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p4.2" class="ltx_p">with equality iff <math id="A2.SS4.SSS2.Px3.p4.m7" class="ltx_Math" alttext="x_{1}=\cdots=x_{5}=2" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><msub><mi>x</mi><mn>5</mn></msub><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">x_{1}=\cdots=x_{5}=2</annotation></semantics></math>. The cyclic system
<math id="A2.SS4.SSS2.Px3.p4.m8" class="ltx_Math" alttext="a+b=b+c=\cdots=e+a=2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>=</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">a+b=b+c=\cdots=e+a=2</annotation></semantics></math> forces <math id="A2.SS4.SSS2.Px3.p4.m9" class="ltx_Math" alttext="a=b=c=d=e=1" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mi>b</mi><mo>=</mo><mi>c</mi><mo>=</mo><mi>d</mi><mo>=</mo><mi>e</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">a=b=c=d=e=1</annotation></semantics></math>, which is feasible.
Therefore</p>
<table id="A2.Ex136" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex136.m1" class="ltx_Math" alttext="S_{\max}=32\quad\text{(attained at }(a,b,c,d,e)=(1,1,1,1,1)\text{)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>S</mi><mi>max</mi></msub><mo>=</mo><mn>32</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext>(attained at </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>)</mtext></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{\max}=32\quad\text{(attained at }(a,b,c,d,e)=(1,1,1,1,1)\text{)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p5" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS2.Px3.p5.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p5.1.1" class="ltx_text ltx_font_bold">Minimum.</span>
Since <math id="A2.SS4.SSS2.Px3.p5.m1" class="ltx_Math" alttext="x_{1}+\cdots+x_{5}=10" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>+</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>+</mo><msub><mi>x</mi><mn>5</mn></msub></mrow><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">x_{1}+\cdots+x_{5}=10</annotation></semantics></math>, not all <math id="A2.SS4.SSS2.Px3.p5.m2" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> can be negative; thus the number of negative <math id="A2.SS4.SSS2.Px3.p5.m3" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math> is odd and is either <math id="A2.SS4.SSS2.Px3.p5.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> or <math id="A2.SS4.SSS2.Px3.p5.m5" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>.</p>
</div>
<div id="A2.SS4.SSS2.Px3.p6" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p6.1" class="ltx_p"><em id="A2.SS4.SSS2.Px3.p6.1.1" class="ltx_emph ltx_font_italic">Case 1: exactly one negative <math id="A2.SS4.SSS2.Px3.p6.m1" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math>.</em><span id="A2.SS4.SSS2.Px3.p6.1.2" class="ltx_text"> Write the negative one as <math id="A2.SS4.SSS2.Px3.p6.m2" class="ltx_Math" alttext="-u" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">-u</annotation></semantics></math> with <math id="A2.SS4.SSS2.Px3.p6.m3" class="ltx_Math" alttext="0&lt;u\leq 2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mi>u</mi><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0&lt;u\leq 2</annotation></semantics></math>. Then the other four lie in <math id="A2.SS4.SSS2.Px3.p6.m4" class="ltx_Math" alttext="[0,8]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>8</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,8]</annotation></semantics></math> and have sum <math id="A2.SS4.SSS2.Px3.p6.m5" class="ltx_Math" alttext="10+u\leq 12" display="inline" intent=":literal"><semantics><mrow><mrow><mn>10</mn><mo>+</mo><mi>u</mi></mrow><mo>≤</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">10+u\leq 12</annotation></semantics></math>.
For fixed sum, their product is maximized when they are equal, hence</span></p>
<table id="A2.Ex137" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex137.m1" class="ltx_Math" alttext="|S|=u\cdot\prod_{\text{four pos}}x_{i}\leq u\cdot\Big(\tfrac{10+u}{4}\Big)^{4}\leq 2\cdot 3^{4}=162," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mi>u</mi><mo lspace="0.222em" rspace="0.055em">⋅</mo><mrow><munder><mo movablelimits="false">∏</mo><mtext>four pos</mtext></munder><msub><mi>x</mi><mi>i</mi></msub></mrow></mrow><mo>≤</mo><mrow><mi>u</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="false"><mfrac><mrow><mn>10</mn><mo>+</mo><mi>u</mi></mrow><mn>4</mn></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>4</mn></msup></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mn>3</mn><mn>4</mn></msup></mrow><mo>=</mo><mn>162</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">|S|=u\cdot\prod_{\text{four pos}}x_{i}\leq u\cdot\Big(\tfrac{10+u}{4}\Big)^{4}\leq 2\cdot 3^{4}=162,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p6.2" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p6.2.1" class="ltx_text">so <math id="A2.SS4.SSS2.Px3.p6.m6" class="ltx_Math" alttext="S\geq-162" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>≥</mo><mrow><mo>−</mo><mn>162</mn></mrow></mrow><annotation encoding="application/x-tex">S\geq-162</annotation></semantics></math> in this case.</span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p7" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p7.1" class="ltx_p"><em id="A2.SS4.SSS2.Px3.p7.1.1" class="ltx_emph ltx_font_italic">Case 2: exactly three negative <math id="A2.SS4.SSS2.Px3.p7.m1" class="ltx_Math" alttext="x_{i}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>i</mi></msub><annotation encoding="application/x-tex">x_{i}</annotation></semantics></math>.</em><span id="A2.SS4.SSS2.Px3.p7.1.2" class="ltx_text"> Write them as <math id="A2.SS4.SSS2.Px3.p7.m2" class="ltx_Math" alttext="-u_{1},-u_{2},-u_{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mo>−</mo><msub><mi>u</mi><mn>2</mn></msub></mrow><mo>,</mo><mrow><mo>−</mo><msub><mi>u</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">-u_{1},-u_{2},-u_{3}</annotation></semantics></math> with <math id="A2.SS4.SSS2.Px3.p7.m3" class="ltx_Math" alttext="0&lt;u_{i}\leq 2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><msub><mi>u</mi><mi>i</mi></msub><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">0&lt;u_{i}\leq 2</annotation></semantics></math>.
Then the two positive ones <math id="A2.SS4.SSS2.Px3.p7.m4" class="ltx_Math" alttext="x_{4},x_{5}\in[0,8]" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>4</mn></msub><mo>,</mo><mrow><msub><mi>x</mi><mn>5</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>8</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{4},x_{5}\in[0,8]</annotation></semantics></math> satisfy</span></p>
<table id="A2.Ex138" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex138.m1" class="ltx_Math" alttext="x_{4}+x_{5}=10+(u_{1}+u_{2}+u_{3})\leq 16." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>x</mi><mn>4</mn></msub><mo>+</mo><msub><mi>x</mi><mn>5</mn></msub></mrow><mo>=</mo><mrow><mn>10</mn><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>+</mo><msub><mi>u</mi><mn>2</mn></msub><mo>+</mo><msub><mi>u</mi><mn>3</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>16</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">x_{4}+x_{5}=10+(u_{1}+u_{2}+u_{3})\leq 16.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p7.2" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p7.2.1" class="ltx_text">To make <math id="A2.SS4.SSS2.Px3.p7.m5" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> as negative as possible we maximize the magnitude</span></p>
<table id="A2.Ex139" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex139.m1" class="ltx_Math" alttext="|S|=u_{1}u_{2}u_{3}\cdot x_{4}x_{5}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mrow><mrow><msub><mi>u</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>3</mn></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>x</mi><mn>4</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>5</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|S|=u_{1}u_{2}u_{3}\cdot x_{4}x_{5}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p7.3" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p7.3.1" class="ltx_text">The product <math id="A2.SS4.SSS2.Px3.p7.m6" class="ltx_Math" alttext="u_{1}u_{2}u_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">u_{1}u_{2}u_{3}</annotation></semantics></math> is maximized by <math id="A2.SS4.SSS2.Px3.p7.m7" class="ltx_Math" alttext="u_{1}=u_{2}=u_{3}=2" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>=</mo><msub><mi>u</mi><mn>2</mn></msub><mo>=</mo><msub><mi>u</mi><mn>3</mn></msub><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">u_{1}=u_{2}=u_{3}=2</annotation></semantics></math>, and for fixed sum <math id="A2.SS4.SSS2.Px3.p7.m8" class="ltx_Math" alttext="x_{4}+x_{5}\leq 16" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>x</mi><mn>4</mn></msub><mo>+</mo><msub><mi>x</mi><mn>5</mn></msub></mrow><mo>≤</mo><mn>16</mn></mrow><annotation encoding="application/x-tex">x_{4}+x_{5}\leq 16</annotation></semantics></math> with <math id="A2.SS4.SSS2.Px3.p7.m9" class="ltx_Math" alttext="x_{4},x_{5}\in[0,8]" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>4</mn></msub><mo>,</mo><mrow><msub><mi>x</mi><mn>5</mn></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>8</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{4},x_{5}\in[0,8]</annotation></semantics></math>, the product <math id="A2.SS4.SSS2.Px3.p7.m10" class="ltx_Math" alttext="x_{4}x_{5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>4</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mn>5</mn></msub></mrow><annotation encoding="application/x-tex">x_{4}x_{5}</annotation></semantics></math> is maximized at <math id="A2.SS4.SSS2.Px3.p7.m11" class="ltx_Math" alttext="x_{4}=x_{5}=8" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>4</mn></msub><mo>=</mo><msub><mi>x</mi><mn>5</mn></msub><mo>=</mo><mn>8</mn></mrow><annotation encoding="application/x-tex">x_{4}=x_{5}=8</annotation></semantics></math> (AM–GM). These choices also respect the sum constraint since <math id="A2.SS4.SSS2.Px3.p7.m12" class="ltx_Math" alttext="(-2)+(-2)+(-2)+8+8=10" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>8</mn><mo>+</mo><mn>8</mn></mrow><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">(-2)+(-2)+(-2)+8+8=10</annotation></semantics></math>. Thus</span></p>
<table id="A2.Ex140" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex140.m1" class="ltx_math_unparsed" alttext="S\geq-\,2\cdot 2\cdot 2\cdot 8\cdot 8=-512," display="block" intent=":literal"><semantics><mrow><mi>S</mi><mo rspace="0em">≥</mo><mo lspace="0em">−</mo><mn> 2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>8</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>8</mn><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mn>512</mn><mo>,</mo></mrow><annotation encoding="application/x-tex">S\geq-\,2\cdot 2\cdot 2\cdot 8\cdot 8=-512,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p7.4" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p7.4.1" class="ltx_text">and equality is attained, e.g. at <math id="A2.SS4.SSS2.Px3.p7.m13" class="ltx_Math" alttext="(a,b,c,d,e)=(-1,-1,-1,-1,9)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>d</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>9</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(a,b,c,d,e)=(-1,-1,-1,-1,9)</annotation></semantics></math>, for which</span></p>
<table id="A2.Ex141" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex141.m1" class="ltx_Math" alttext="(a+b,b+c,c+d,d+e,e+a)=(-2,-2,-2,8,8)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>,</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo>,</mo><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo>,</mo><mrow><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo>,</mo><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>2</mn></mrow><mo>,</mo><mn>8</mn><mo>,</mo><mn>8</mn><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">(a+b,b+c,c+d,d+e,e+a)=(-2,-2,-2,8,8).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p8" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p8.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p8.1.1" class="ltx_text">Combining the two cases, the overall minimum is <math id="A2.SS4.SSS2.Px3.p8.m1" class="ltx_Math" alttext="-512" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>512</mn></mrow><annotation encoding="application/x-tex">-512</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p9" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS2.Px3.p9.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p9.1.1" class="ltx_text ltx_font_bold">Conclusion.</span></p>
<table id="A2.Ex142" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex142.m1" class="ltx_Math" alttext="\boxed{\,S_{\min}=-512\ \text{(e.g.\ at }(-1,-1,-1,-1,9)\text{ up to rotation)},\qquad S_{\max}=32\ \text{(at }(1,1,1,1,1)\text{)}.\,}" display="block" intent=":literal"><semantics><menclose notation="box"><mrow><mi>S</mi><msub><mrow></mrow><mi>min</mi></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mn>512</mn><mtext>(e.g. at </mtext><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mn>1</mn><mo rspace="0em">,</mo><mo lspace="0em">−</mo><mn>1</mn><mo>,</mo><mn>9</mn><mo stretchy="false">)</mo><mtext> up to rotation)</mtext><mo rspace="2.167em">,</mo><mi>S</mi><msub><mrow></mrow><mi>max</mi></msub><mo>=</mo><mn>32</mn><mtext>(at </mtext><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo><mtext>)</mtext><mo lspace="0em">.</mo></mrow></menclose><annotation encoding="application/x-tex">\boxed{\,S_{\min}=-512\ \text{(e.g.\ at }(-1,-1,-1,-1,9)\text{ up to rotation)},\qquad S_{\max}=32\ \text{(at }(1,1,1,1,1)\text{)}.\,}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p9.2" class="ltx_p">∎</p>
</div>
</div>
<div id="A2.SS4.SSS2.Px3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS4.SSS2.Px3.3.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS4.SSS2.Px3.p10" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p10.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p10.1.1" class="ltx_text ltx_font_bold">(1) Finding the minimum value of <math id="A2.SS4.SSS2.Px3.p10.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>:<span id="A2.SS4.SSS2.Px3.p10.1.1.1" class="ltx_text ltx_font_medium">
We only need to consider cases where <math id="A2.SS4.SSS2.Px3.p10.m2" class="ltx_Math" alttext="S&lt;0" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S&lt;0</annotation></semantics></math>.</span></span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p11" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p11.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p11.1.1" class="ltx_text ltx_font_bold">(i)<span id="A2.SS4.SSS2.Px3.p11.1.1.1" class="ltx_text ltx_font_medium"> Suppose four of the five terms</span></span></p>
<table id="A2.Ex143" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex143.m1" class="ltx_Math" alttext="a+b,\quad b+c,\quad c+d,\quad d+e,\quad e+a" display="block" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo rspace="1.167em">,</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo rspace="1.167em">,</mo><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo rspace="1.167em">,</mo><mrow><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo rspace="1.167em">,</mo><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow></mrow><annotation encoding="application/x-tex">a+b,\quad b+c,\quad c+d,\quad d+e,\quad e+a</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p11.2" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p11.2.1" class="ltx_text">are positive and one is negative. By symmetry, assume <math id="A2.SS4.SSS2.Px3.p11.m1" class="ltx_Math" alttext="a+b&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a+b&lt;0</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p12" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p12.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p12.1.1" class="ltx_text">Note that <math id="A2.SS4.SSS2.Px3.p12.m1" class="ltx_Math" alttext="a+b+c+d+e=5" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>+</mo><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">a+b+c+d+e=5</annotation></semantics></math>, and since <math id="A2.SS4.SSS2.Px3.p12.m2" class="ltx_Math" alttext="a,b\geq-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>≥</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">a,b\geq-1</annotation></semantics></math>, we have <math id="A2.SS4.SSS2.Px3.p12.m3" class="ltx_Math" alttext="a+b\geq-2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>≥</mo><mrow><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">a+b\geq-2</annotation></semantics></math>.
By the AM–GM inequality:</span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p13" class="ltx_para">
<table id="A2.Ex144" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex144X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex144X.m2" class="ltx_Math" alttext="\displaystyle(b+c)(c+d)(d+e)(e+a)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(b+c)(c+d)(d+e)(e+a)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex144X.m3" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{(b+c)+(c+d)+(d+e)+(e+a)}{4}\right)^{4}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mstyle><mo>)</mo></mrow><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{(b+c)+(c+d)+(d+e)+(e+a)}{4}\right)^{4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex144Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex144Xa.m2" class="ltx_Math" alttext="\displaystyle=\left(\frac{10-a-b}{4}\right)^{4}\leq 3^{4}=81." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>10</mn><mo>−</mo><mi>a</mi><mo>−</mo><mi>b</mi></mrow><mn>4</mn></mfrac></mstyle><mo>)</mo></mrow><mn>4</mn></msup><mo>≤</mo><msup><mn>3</mn><mn>4</mn></msup><mo>=</mo><mn>81</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{10-a-b}{4}\right)^{4}\leq 3^{4}=81.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p14" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p14.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p14.1.1" class="ltx_text">Thus,</span></p>
<table id="A2.Ex145" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex145.m1" class="ltx_math_unparsed" alttext="S\geq-2\times 81=-162." display="block" intent=":literal"><semantics><mrow><mi>S</mi><mo rspace="0em">≥</mo><mo lspace="0em">−</mo><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>81</mn><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mn>162</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S\geq-2\times 81=-162.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p15" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p15.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p15.1.1" class="ltx_text ltx_font_bold">(ii)<span id="A2.SS4.SSS2.Px3.p15.1.1.1" class="ltx_text ltx_font_medium"> Suppose exactly two of the terms are positive and three are negative.
Note that</span></span></p>
<table id="A2.Ex146" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex146.m1" class="ltx_Math" alttext="-2\leq a+b=5-c-d-e\leq 8," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mn>2</mn></mrow><mo>≤</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>=</mo><mrow><mn>5</mn><mo>−</mo><mi>c</mi><mo>−</mo><mi>d</mi><mo>−</mo><mi>e</mi></mrow><mo>≤</mo><mn>8</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">-2\leq a+b=5-c-d-e\leq 8,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p15.2" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p15.2.1" class="ltx_text">and similarly,</span></p>
<table id="A2.Ex147" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex147.m1" class="ltx_Math" alttext="-2\leq b+c,\quad c+d,\quad d+e,\quad e+a\leq 8." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mn>2</mn></mrow><mo>≤</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo rspace="1.167em">,</mo><mrow><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow><mo>≤</mo><mn>8</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">-2\leq b+c,\quad c+d,\quad d+e,\quad e+a\leq 8.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p15.3" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p15.3.1" class="ltx_text">So we can estimate:</span></p>
<table id="A2.Ex148" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex148.m1" class="ltx_Math" alttext="S\geq(-2)^{3}\times 8^{2}=-512." display="block" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>≥</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mn>3</mn></msup><mo rspace="0.222em">×</mo><msup><mn>8</mn><mn>2</mn></msup></mrow><mo>=</mo><mrow><mo>−</mo><mn>512</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S\geq(-2)^{3}\times 8^{2}=-512.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p16" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p16.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p16.1.1" class="ltx_text ltx_font_bold">(iii)<span id="A2.SS4.SSS2.Px3.p16.1.1.1" class="ltx_text ltx_font_medium"> If all five terms are negative, then their sum is less than zero, which contradicts the fact that <math id="A2.SS4.SSS2.Px3.p16.m1" class="ltx_Math" alttext="a+b+c+d+e=5" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>+</mo><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">a+b+c+d+e=5</annotation></semantics></math>. So this case cannot occur.</span></span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p17" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS2.Px3.p17.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p17.1.1" class="ltx_text ltx_font_bold">Conclusion:</span>
The minimum value of <math id="A2.SS4.SSS2.Px3.p17.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is <math id="A2.SS4.SSS2.Px3.p17.m2" class="ltx_Math" alttext="\boxed{-512}" display="inline" intent=":literal"><semantics><menclose notation="box"><mrow><mo>−</mo><mn>512</mn></mrow></menclose><annotation encoding="application/x-tex">\boxed{-512}</annotation></semantics></math>, attained when</p>
<table id="A2.Ex149" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex149.m1" class="ltx_Math" alttext="a=b=c=d=-1,\quad e=9." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo>=</mo><mi>b</mi><mo>=</mo><mi>c</mi><mo>=</mo><mi>d</mi><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>e</mi><mo>=</mo><mn>9</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a=b=c=d=-1,\quad e=9.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p18" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p18.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p18.1.1" class="ltx_text ltx_font_bold">(2) Finding the maximum value of <math id="A2.SS4.SSS2.Px3.p18.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>:<span id="A2.SS4.SSS2.Px3.p18.1.1.1" class="ltx_text ltx_font_medium">
We only need to consider cases where <math id="A2.SS4.SSS2.Px3.p18.m2" class="ltx_Math" alttext="S&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S&gt;0</annotation></semantics></math>.</span></span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p19" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p19.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p19.1.1" class="ltx_text ltx_font_bold">(i)<span id="A2.SS4.SSS2.Px3.p19.1.1.1" class="ltx_text ltx_font_medium"> If all five terms are positive, then by the AM–GM inequality:</span></span></p>
<table id="A2.Ex150" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex150X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex150X.m2" class="ltx_Math" alttext="\displaystyle S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\displaystyle S</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex150X.m3" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{(a+b)+(b+c)+(c+d)+(d+e)+(e+a)}{5}\right)^{5}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>5</mn></mfrac></mstyle><mo>)</mo></mrow><mn>5</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{(a+b)+(b+c)+(c+d)+(d+e)+(e+a)}{5}\right)^{5}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex150Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex150Xa.m2" class="ltx_Math" alttext="\displaystyle=\left(\frac{2(a+b+c+d+e)}{5}\right)^{5}=\left(\frac{10}{5}\right)^{5}=32." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi><mo>+</mo><mi>c</mi><mo>+</mo><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>5</mn></mfrac></mstyle><mo>)</mo></mrow><mn>5</mn></msup><mo>=</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>10</mn><mn>5</mn></mfrac></mstyle><mo>)</mo></mrow><mn>5</mn></msup><mo>=</mo><mn>32</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{2(a+b+c+d+e)}{5}\right)^{5}=\left(\frac{10}{5}\right)^{5}=32.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p20" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p20.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p20.1.1" class="ltx_text ltx_font_bold">(ii)<span id="A2.SS4.SSS2.Px3.p20.1.1.1" class="ltx_text ltx_font_medium"> Suppose three terms are positive and two are negative.
By symmetry, we only need to consider the following two cases.</span></span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p21" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p21.1" class="ltx_p"><em id="A2.SS4.SSS2.Px3.p21.1.1" class="ltx_emph ltx_font_italic">Case 1:</em><span id="A2.SS4.SSS2.Px3.p21.1.2" class="ltx_text"> <math id="A2.SS4.SSS2.Px3.p21.m1" class="ltx_Math" alttext="a+b&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a+b&lt;0</annotation></semantics></math>, <math id="A2.SS4.SSS2.Px3.p21.m2" class="ltx_Math" alttext="b+c&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b+c&lt;0</annotation></semantics></math>, and the other three terms are positive. Then:</span></p>
<table id="A2.Ex151" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex151.m1" class="ltx_Math" alttext="-2\leq a+b&lt;0,\quad-2\leq b+c&lt;0,\quad 0&lt;d+e\leq 8," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>−</mo><mn>2</mn></mrow><mo>≤</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo>−</mo><mn>2</mn></mrow><mo>≤</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow><mo rspace="1.167em">,</mo><mrow><mn>0</mn><mo>&lt;</mo><mrow><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo>≤</mo><mn>8</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">-2\leq a+b&lt;0,\quad-2\leq b+c&lt;0,\quad 0&lt;d+e\leq 8,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p21.2" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p21.2.1" class="ltx_text">and using AM–GM again:</span></p>
<table id="A2.Ex152" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex152.m1" class="ltx_Math" alttext="0&lt;(c+d)(e+a)\leq\left(\frac{c+d+e+a}{2}\right)^{2}=\left(\frac{5-b}{2}\right)^{2}\leq 9." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>&lt;</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msup><mrow><mo>(</mo><mfrac><mrow><mi>c</mi><mo>+</mo><mi>d</mi><mo>+</mo><mi>e</mi><mo>+</mo><mi>a</mi></mrow><mn>2</mn></mfrac><mo>)</mo></mrow><mn>2</mn></msup><mo>=</mo><msup><mrow><mo>(</mo><mfrac><mrow><mn>5</mn><mo>−</mo><mi>b</mi></mrow><mn>2</mn></mfrac><mo>)</mo></mrow><mn>2</mn></msup><mo>≤</mo><mn>9</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0&lt;(c+d)(e+a)\leq\left(\frac{c+d+e+a}{2}\right)^{2}=\left(\frac{5-b}{2}\right)^{2}\leq 9.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p21.3" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p21.3.1" class="ltx_text">Hence,</span></p>
<table id="A2.Ex153" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex153.m1" class="ltx_Math" alttext="S\leq(-2)(-2)\times 8\times 9=288." display="block" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>2</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">×</mo><mn>8</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>9</mn></mrow><mo>=</mo><mn>288</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S\leq(-2)(-2)\times 8\times 9=288.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p22" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p22.1" class="ltx_p"><em id="A2.SS4.SSS2.Px3.p22.1.1" class="ltx_emph ltx_font_italic">Case 2:</em><span id="A2.SS4.SSS2.Px3.p22.1.2" class="ltx_text"> <math id="A2.SS4.SSS2.Px3.p22.m1" class="ltx_Math" alttext="a+b&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a+b&lt;0</annotation></semantics></math>, <math id="A2.SS4.SSS2.Px3.p22.m2" class="ltx_Math" alttext="c+d&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c+d&lt;0</annotation></semantics></math>, and the rest are positive. Then</span></p>
<table id="A2.Ex154" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex154.m1" class="ltx_Math" alttext="e=5-a-b-c-d\leq 7-b-c&lt;7." display="block" intent=":literal"><semantics><mrow><mrow><mi>e</mi><mo>=</mo><mrow><mn>5</mn><mo>−</mo><mi>a</mi><mo>−</mo><mi>b</mi><mo>−</mo><mi>c</mi><mo>−</mo><mi>d</mi></mrow><mo>≤</mo><mrow><mn>7</mn><mo>−</mo><mi>b</mi><mo>−</mo><mi>c</mi></mrow><mo>&lt;</mo><mn>7</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">e=5-a-b-c-d\leq 7-b-c&lt;7.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.SSS2.Px3.p22.2" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p22.2.1" class="ltx_text">Applying AM–GM again:</span></p>
<table id="A2.Ex155" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex155X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex155X.m2" class="ltx_Math" alttext="\displaystyle S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">\displaystyle S</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex155X.m3" class="ltx_Math" alttext="\displaystyle\leq\left(\frac{(-a-b)+(b+c)+(-c-d)+(d+e)+(e+a)}{5}\right)^{5}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mi>a</mi></mrow><mo>−</mo><mi>b</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>−</mo><mi>c</mi></mrow><mo>−</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mi>e</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>5</mn></mfrac></mstyle><mo>)</mo></mrow><mn>5</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\frac{(-a-b)+(b+c)+(-c-d)+(d+e)+(e+a)}{5}\right)^{5}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex155Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex155Xa.m2" class="ltx_Math" alttext="\displaystyle=\left(\frac{2e}{5}\right)^{5}&lt;3^{5}=243&lt;288." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mn>5</mn></mfrac></mstyle><mo>)</mo></mrow><mn>5</mn></msup><mo>&lt;</mo><msup><mn>3</mn><mn>5</mn></msup><mo>=</mo><mn>243</mn><mo>&lt;</mo><mn>288</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\frac{2e}{5}\right)^{5}&lt;3^{5}=243&lt;288.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p23" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p23.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p23.1.1" class="ltx_text ltx_font_bold">(iii)<span id="A2.SS4.SSS2.Px3.p23.1.1.1" class="ltx_text ltx_font_medium"> If four terms are positive and one is negative, assume <math id="A2.SS4.SSS2.Px3.p23.m1" class="ltx_Math" alttext="a+b&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a+b&gt;0</annotation></semantics></math> by symmetry. Then:</span></span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p24" class="ltx_para">
<table id="A2.Ex156" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex156.m1" class="ltx_Math" alttext="(b+c)+(c+d)+(e+a)=5+c&lt;0\Rightarrow c&lt;-5," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo>+</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>c</mi><mo>+</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo>+</mo><mi>a</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>5</mn><mo>+</mo><mi>c</mi></mrow><mo>&lt;</mo><mn>0</mn><mo stretchy="false">⇒</mo><mi>c</mi><mo>&lt;</mo><mrow><mo>−</mo><mn>5</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">(b+c)+(c+d)+(e+a)=5+c&lt;0\Rightarrow c&lt;-5,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p25" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p25.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p25.1.1" class="ltx_text">which contradicts the constraint <math id="A2.SS4.SSS2.Px3.p25.m1" class="ltx_Math" alttext="c\geq-1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">c\geq-1</annotation></semantics></math>. So this case cannot occur.</span></p>
</div>
<div id="A2.SS4.SSS2.Px3.p26" class="ltx_para ltx_noindent">
<p id="A2.SS4.SSS2.Px3.p26.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p26.1.1" class="ltx_text ltx_font_bold">Conclusion:</span>
The maximum value of <math id="A2.SS4.SSS2.Px3.p26.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is <math id="A2.SS4.SSS2.Px3.p26.m2" class="ltx_Math" alttext="\boxed{288}" display="inline" intent=":literal"><semantics><menclose notation="box"><mn>288</mn></menclose><annotation encoding="application/x-tex">\boxed{288}</annotation></semantics></math>, attained when</p>
<table id="A2.Ex157" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex157.m1" class="ltx_Math" alttext="a=b=c=-1,\quad d=e=4." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>a</mi><mo>=</mo><mi>b</mi><mo>=</mo><mi>c</mi><mo>=</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>d</mi><mo>=</mo><mi>e</mi><mo>=</mo><mn>4</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">a=b=c=-1,\quad d=e=4.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.SSS2.Px3.p27" class="ltx_para">
<p id="A2.SS4.SSS2.Px3.p27.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p27.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS4.SSS2.Px3.p28" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS4.SSS2.Px3.p28.pic1" class="ltx_picture" height="69.62" overflow="visible" version="1.1" viewBox="0 0 429.64 69.62" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,69.62) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 65 C 0 67.55 2.07 69.62 4.63 69.62 L 425.01 69.62 C 427.56 69.62 429.64 67.55 429.64 65 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 50.76 L 428.94 50.76 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 55.39)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS4.SSS2.Px3.p28.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS4.SSS2.Px3.p28.pic1.1.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p28.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Rubric</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:1.76em;--ltx-fo-depth:0.16em;font-size:10pt;" height="26.44" overflow="visible" transform="matrix(1 0 0 -1 0 24.29)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS4.SSS2.Px3.p28.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS4.SSS2.Px3.p28.pic1.2.1" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p28.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">1.Correct upper bound 288 and proof.</span></span>
<span id="A2.SS4.SSS2.Px3.p28.pic1.2.2" class="ltx_p"><span id="A2.SS4.SSS2.Px3.p28.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">2.Correct lower bound -512 and proof.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS4.SSS2.Px3.p29" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS4.SSS2.Px3.p29.pic1" class="ltx_picture" height="54.13" overflow="visible" version="1.1" viewBox="0 0 429.64 54.13" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,54.13) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#5A996B;" fill="#5A996B" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 49.51 C 0 52.06 2.07 54.13 4.63 54.13 L 425.01 54.13 C 427.56 54.13 429.64 52.06 429.64 49.51 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F6FFF9;" fill="#F6FFF9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 35.38 L 428.94 35.38 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 40.01)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
