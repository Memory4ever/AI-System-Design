</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS5.SSS1.Px1.p34" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS5.SSS1.Px1.p34.pic1" class="ltx_picture" height="166.79" overflow="visible" version="1.1" viewBox="0 0 429.64 166.79" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,166.79) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 162.16 C 0 164.72 2.07 166.79 4.63 166.79 L 425.01 166.79 C 427.56 166.79 429.64 164.72 429.64 162.16 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 147.92 L 428.94 147.92 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 152.55)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS5.SSS1.Px1.p34.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS5.SSS1.Px1.p34.pic1.1.1" class="ltx_p"><span id="A2.SS5.SSS1.Px1.p34.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:8.78em;--ltx-fo-depth:0.16em;font-size:10pt;" height="123.61" overflow="visible" transform="matrix(1 0 0 -1 0 121.46)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS5.SSS1.Px1.p34.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS5.SSS1.Px1.p34.pic1.2.1" class="ltx_p"><span id="A2.SS5.SSS1.Px1.p34.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">1. The following equality is incorrect:</span></span>
<span id="A2.Ex176" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex176.m1" class="ltx_Math" alttext="\Bigl|\bigcup S\Bigr|\;=\;56-e_{G}(U)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" maxsize="0.800em" minsize="0.800em" movablelimits="false" stretchy="true">⋃</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">S</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em" rspace="0.280em" stretchy="true">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em"> 56</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">e</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">U</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo></mrow><annotation encoding="application/x-tex">\Bigl|\bigcup S\Bigr|\;=\;56-e_{G}(U),</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A2.SS5.SSS1.Px1.p34.pic1.2.2" class="ltx_p"><span id="A2.SS5.SSS1.Px1.p34.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The following statement is also incorrect:</span></span>
<span id="A2.Ex177" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex177.m1" class="ltx_Math" alttext="\mathbb{E}\Bigl[\bigl|\bigcup S\bigr|\Bigr]\;=\;56-\mathbb{E}\big[e_{G}(U)\big]\;\geq\;56-\frac{224}{15}\;=\;\frac{616}{15}\;\approx\;41.07." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" maxsize="0.800em" minsize="0.800em" movablelimits="false" stretchy="true">⋃</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">S</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em" rspace="0.280em">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">=</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em"> 56</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">e</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">G</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">U</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">≥</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em"> 56</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">224</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">15</mn></mfrac></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.558em" mathcolor="#000000" mathsize="0.800em" rspace="0.558em">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">616</mn><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">15</mn></mfrac><mo style="--ltx-fg-color:#000000;" lspace="0.558em" mathcolor="#000000" mathsize="0.800em">≈</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em"> 41.07</mn></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\Bigl[\bigl|\bigcup S\bigr|\Bigr]\;=\;56-\mathbb{E}\big[e_{G}(U)\big]\;\geq\;56-\frac{224}{15}\;=\;\frac{616}{15}\;\approx\;41.07.</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
<span id="A2.SS5.SSS1.Px1.p34.pic1.2.3" class="ltx_p"><span id="A2.SS5.SSS1.Px1.p34.pic1.2.3.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">As union sizes are integers, the average being <math id="A2.SS5.SSS1.Px1.p34.pic1.m1" class="ltx_Math" alttext="\leq 41.07" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">41.07</mn></mrow><annotation encoding="application/x-tex">\leq 41.07</annotation></semantics></math> implies…"</span></span>
<span id="A2.SS5.SSS1.Px1.p34.pic1.2.4" class="ltx_p"><span id="A2.SS5.SSS1.Px1.p34.pic1.2.4.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The average is <math id="A2.SS5.SSS1.Px1.p34.pic1.m2" class="ltx_Math" alttext="\geq 41.07" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">41.07</mn></mrow><annotation encoding="application/x-tex">\geq 41.07</annotation></semantics></math> instead of <math id="A2.SS5.SSS1.Px1.p34.pic1.m3" class="ltx_Math" alttext="\leq 41.07" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">41.07</mn></mrow><annotation encoding="application/x-tex">\leq 41.07</annotation></semantics></math>.</span></span>
<span id="A2.SS5.SSS1.Px1.p34.pic1.2.5" class="ltx_p"><span id="A2.SS5.SSS1.Px1.p34.pic1.2.5.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">2. No explicit construction of 41 set was provided.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
</section>
<section id="A2.SS5.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">(b) </span>Evaluating existing arguments</h4>

<section id="A2.SS5.SSS2.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#00E000;">Problem 5b1 </h5>

<div id="A2.SS5.SSS2.Px1.p1" class="ltx_para">
<p id="A2.SS5.SSS2.Px1.p1.1" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS5.SSS2.Px1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS5.SSS2.Px1.p2.pic1" class="ltx_picture" height="321.86" overflow="visible" version="1.1" viewBox="0 0 429.64 321.86" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,321.86) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 317.23 C 0 319.79 2.07 321.86 4.63 321.86 L 425.01 321.86 C 427.56 321.86 429.64 319.79 429.64 317.23 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 303 L 428.94 303 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 307.62)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS5.SSS2.Px1.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS5.SSS2.Px1.p2.pic1.1.1" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:19.98em;--ltx-fo-depth:0.16em;font-size:10pt;" height="278.68" overflow="visible" transform="matrix(1 0 0 -1 0 276.53)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS5.SSS2.Px1.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS5.SSS2.Px1.p2.pic1.2.1" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Check the following proof:
All Banach norms on a real vector space <math id="A2.SS5.SSS2.Px1.p2.pic1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> are equivalent.</span></span>
<span id="A2.I11" class="ltx_itemize">
<span id="A2.I11.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I11.i1.p1" class="ltx_para">
<span id="A2.I11.i1.p1.1" class="ltx_p"><span id="A2.I11.i1.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Let </span><math id="A2.I11.i1.p1.m1" class="ltx_math_unparsed" alttext="\|\cdot\|_{1}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{1}</annotation></semantics></math><span id="A2.I11.i1.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> and </span><math id="A2.I11.i1.p1.m2" class="ltx_math_unparsed" alttext="\|\cdot\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{2}</annotation></semantics></math><span id="A2.I11.i1.p1.1.3" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> two Banach norms on </span><math id="A2.I11.i1.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math><span id="A2.I11.i1.p1.1.4" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">. Consider </span><math id="A2.I11.i1.p1.m4" class="ltx_math_unparsed" alttext="\|\cdot\|_{3}:=\|\cdot\|_{1}+\|\cdot\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">3</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0.0835em" mathcolor="#000000" mathsize="0.800em" rspace="0em">:=</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn></msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">+</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{3}:=\|\cdot\|_{1}+\|\cdot\|_{2}</annotation></semantics></math><span id="A2.I11.i1.p1.1.5" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">. Prove that it is actually a norm.</span></span>
</span></span>
<span id="A2.I11.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I11.i2.p1" class="ltx_para">
<span id="A2.I11.i2.p1.1" class="ltx_p"><span id="A2.I11.i2.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Prove that a sequence converge to </span><math id="A2.I11.i2.p1.m1" class="ltx_Math" alttext="x\in X" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">x</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">X</mi></mrow><annotation encoding="application/x-tex">x\in X</annotation></semantics></math><span id="A2.I11.i2.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> w.r.to </span><math id="A2.I11.i2.p1.m2" class="ltx_math_unparsed" alttext="\|\cdot\|_{3}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">3</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{3}</annotation></semantics></math><span id="A2.I11.i2.p1.1.3" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> if and only if it converges to </span><math id="A2.I11.i2.p1.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math><span id="A2.I11.i2.p1.1.4" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> both w.r.to </span><math id="A2.I11.i2.p1.m4" class="ltx_math_unparsed" alttext="\|\cdot\|_{1}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{1}</annotation></semantics></math><span id="A2.I11.i2.p1.1.5" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> and w.r.to </span><math id="A2.I11.i2.p1.m5" class="ltx_math_unparsed" alttext="\|\cdot\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{2}</annotation></semantics></math><span id="A2.I11.i2.p1.1.6" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A2.I11.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I11.i3.p1" class="ltx_para">
<span id="A2.I11.i3.p1.1" class="ltx_p"><span id="A2.I11.i3.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Prove that a sequence is Cauchy wrto </span><math id="A2.I11.i3.p1.m1" class="ltx_math_unparsed" alttext="\|\cdot\|_{3}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">3</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{3}</annotation></semantics></math><span id="A2.I11.i3.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> if and only if it is Cauchy both w.r.to </span><math id="A2.I11.i3.p1.m2" class="ltx_math_unparsed" alttext="\|\cdot\|_{1}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{1}</annotation></semantics></math><span id="A2.I11.i3.p1.1.3" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> and w.r.to </span><math id="A2.I11.i3.p1.m3" class="ltx_math_unparsed" alttext="\|\cdot\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{2}</annotation></semantics></math><span id="A2.I11.i3.p1.1.4" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">. Deduce that </span><math id="A2.I11.i3.p1.m4" class="ltx_math_unparsed" alttext="\|\cdot\|_{3}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">3</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{3}</annotation></semantics></math><span id="A2.I11.i3.p1.1.5" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> is complete.</span></span>
</span></span>
<span id="A2.I11.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A2.I11.i4.p1" class="ltx_para">
<span id="A2.I11.i4.p1.1" class="ltx_p"><span id="A2.I11.i4.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Apply the open mapping theorem tho the identity from </span><math id="A2.I11.i4.p1.m1" class="ltx_math_unparsed" alttext="\left(X,\|\cdot\|_{3}\right)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0.167em">∥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">3</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><annotation encoding="application/x-tex">\left(X,\|\cdot\|_{3}\right)</annotation></semantics></math><span id="A2.I11.i4.p1.1.2" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> to </span><math id="A2.I11.i4.p1.m2" class="ltx_math_unparsed" alttext="\left(X,\|\cdot\|_{1}\right)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0.167em">∥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><annotation encoding="application/x-tex">\left(X,\|\cdot\|_{1}\right)</annotation></semantics></math><span id="A2.I11.i4.p1.1.3" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> and from </span><math id="A2.I11.i4.p1.m3" class="ltx_math_unparsed" alttext="\left(X,\|\cdot\|_{3}\right)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0.167em">∥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">3</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><annotation encoding="application/x-tex">\left(X,\|\cdot\|_{3}\right)</annotation></semantics></math><span id="A2.I11.i4.p1.1.4" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;"> to </span><math id="A2.I11.i4.p1.m4" class="ltx_math_unparsed" alttext="\left(X,\|\cdot\|_{2}\right)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0em">⋅</mo><msub><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em" rspace="0.167em">∥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">2</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><annotation encoding="application/x-tex">\left(X,\|\cdot\|_{2}\right)</annotation></semantics></math><span id="A2.I11.i4.p1.1.5" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">, and deduce that the three norms are equivalent.</span></span>
</span></span>
</span><span class="ltx_inline-block"><svg id="A2.SS5.SSS2.Px1.p2.pic1.pic1" class="ltx_picture" color="#008000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#009900;--ltx-fill-color:#009900;--ltx-fg-color:#009900;" color="#009900" fill="#009900" stroke="#009900" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 7.87 L 5.51 0 L 15.75 15.75"></path></g></svg></span>
<span id="A2.SS5.SSS2.Px1.p2.pic1.2.2" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#008000;">GPT-5 thinking passed</span></span>
<span id="A2.SS5.SSS2.Px1.p2.pic1.2.3" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p2.pic1.2.3.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Jiaxin Zhang</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS5.SSS2.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS5.SSS2.Px1.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="Thmclaim1" class="ltx_theorem ltx_theorem_claim">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmclaim1.2" class="ltx_text ltx_font_bold">Claim 1</span></span><span id="Thmclaim1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmclaim1.p1" class="ltx_para">
<p id="Thmclaim1.p1.1" class="ltx_p"><span id="Thmclaim1.p1.1.1" class="ltx_text ltx_font_italic">Not all Banach norms on a given (infinite dimensional) real vector space <math id="Thmclaim1.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> are equivalent.</span></p>
</div>
</div>
<div id="A2.SS5.SSS2.Px1.1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Check of the proposed proof and the gap.</h6>
<div id="A2.SS5.SSS2.Px1.p3" class="ltx_para">
<p id="A2.SS5.SSS2.Px1.p3.1" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p3.1.1" class="ltx_text">Let <math id="A2.SS5.SSS2.Px1.p3.m1" class="ltx_math_unparsed" alttext="\|\cdot\|_{1},\|\cdot\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{1},\|\cdot\|_{2}</annotation></semantics></math> be Banach norms on <math id="A2.SS5.SSS2.Px1.p3.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, and set <math id="A2.SS5.SSS2.Px1.p3.m3" class="ltx_Math" alttext="\|x\|_{3}:=\|x\|_{1}+\|x\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>3</mn></msub><mo>:=</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|x\|_{3}:=\|x\|_{1}+\|x\|_{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS5.SSS2.Px1.p4" class="ltx_para">
<p id="A2.SS5.SSS2.Px1.p4.1" class="ltx_p"><em id="A2.SS5.SSS2.Px1.p4.1.1" class="ltx_emph ltx_font_italic">(i) <math id="A2.SS5.SSS2.Px1.p4.m1" class="ltx_math_unparsed" alttext="\|\cdot\|_{3}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{3}</annotation></semantics></math> is a norm.</em><span id="A2.SS5.SSS2.Px1.p4.1.2" class="ltx_text"> Positivity and homogeneity are clear. For the triangle inequality,</span></p>
<table id="A2.Ex178" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex178.m1" class="ltx_Math" alttext="\|x+y\|_{3}=\|x+y\|_{1}+\|x+y\|_{2}\leq(\|x\|_{1}+\|y\|_{1})+(\|x\|_{2}+\|y\|_{2})=\|x\|_{3}+\|y\|_{3}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>3</mn></msub><mo>=</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>+</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mi>y</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mi>y</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>3</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mi>y</mi><mo stretchy="false">‖</mo></mrow><mn>3</mn></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|x+y\|_{3}=\|x+y\|_{1}+\|x+y\|_{2}\leq(\|x\|_{1}+\|y\|_{1})+(\|x\|_{2}+\|y\|_{2})=\|x\|_{3}+\|y\|_{3}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS5.SSS2.Px1.p5" class="ltx_para">
<p id="A2.SS5.SSS2.Px1.p5.1" class="ltx_p"><em id="A2.SS5.SSS2.Px1.p5.1.1" class="ltx_emph ltx_font_italic">(ii) Convergence and Cauchy equivalence.</em><span id="A2.SS5.SSS2.Px1.p5.1.2" class="ltx_text"> For any fixed <math id="A2.SS5.SSS2.Px1.p5.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>,</span></p>
<table id="A2.Ex179" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex179.m1" class="ltx_Math" alttext="\|x_{n}-x\|_{3}\to 0\iff\|x_{n}-x\|_{1}\to 0\text{ and }\|x_{n}-x\|_{2}\to 0," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>n</mi></msub><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>3</mn></msub><mo stretchy="false">→</mo><mn>0</mn><mo stretchy="false">⇔</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>n</mi></msub><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo stretchy="false">→</mo><mrow><mn>0</mn><mo lspace="0em" rspace="0em">​</mo><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>x</mi><mi>n</mi></msub><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|x_{n}-x\|_{3}\to 0\iff\|x_{n}-x\|_{1}\to 0\text{ and }\|x_{n}-x\|_{2}\to 0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS2.Px1.p5.2" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p5.2.1" class="ltx_text">and similarly, <math id="A2.SS5.SSS2.Px1.p5.m2" class="ltx_Math" alttext="(x_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{n})</annotation></semantics></math> is Cauchy in <math id="A2.SS5.SSS2.Px1.p5.m3" class="ltx_math_unparsed" alttext="\|\cdot\|_{3}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{3}</annotation></semantics></math> iff it is Cauchy in each <math id="A2.SS5.SSS2.Px1.p5.m4" class="ltx_math_unparsed" alttext="\|\cdot\|_{1},\|\cdot\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{1},\|\cdot\|_{2}</annotation></semantics></math>
(since <math id="A2.SS5.SSS2.Px1.p5.m5" class="ltx_math_unparsed" alttext="\|\,\cdot\,\|_{3}=\|\,\cdot\,\|_{1}+\|\,\cdot\,\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo>⋅</mo><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>3</mn></msub><mo lspace="0.0835em" rspace="0em">=</mo><mo lspace="0em" rspace="0em">∥</mo><mo>⋅</mo><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" rspace="0em">∥</mo><mo>⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|\,\cdot\,\|_{3}=\|\,\cdot\,\|_{1}+\|\,\cdot\,\|_{2}</annotation></semantics></math>).</span></p>
</div>
<div id="A2.SS5.SSS2.Px1.p6" class="ltx_para">
<p id="A2.SS5.SSS2.Px1.p6.1" class="ltx_p"><em id="A2.SS5.SSS2.Px1.p6.1.1" class="ltx_emph ltx_font_italic">(iii) The gap.</em><span id="A2.SS5.SSS2.Px1.p6.1.2" class="ltx_text"> From the Cauchy equivalence one cannot conclude that <math id="A2.SS5.SSS2.Px1.p6.m1" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{3})</annotation></semantics></math> is complete.
Indeed, a sequence that is Cauchy in <math id="A2.SS5.SSS2.Px1.p6.m2" class="ltx_math_unparsed" alttext="\|\cdot\|_{3}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{3}</annotation></semantics></math> converges in <math id="A2.SS5.SSS2.Px1.p6.m3" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{1})</annotation></semantics></math> to some <math id="A2.SS5.SSS2.Px1.p6.m4" class="ltx_Math" alttext="x_{1}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>1</mn></msub><annotation encoding="application/x-tex">x_{1}</annotation></semantics></math> and in
<math id="A2.SS5.SSS2.Px1.p6.m5" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{2})</annotation></semantics></math> to some <math id="A2.SS5.SSS2.Px1.p6.m6" class="ltx_Math" alttext="x_{2}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mn>2</mn></msub><annotation encoding="application/x-tex">x_{2}</annotation></semantics></math>, but there is no a priori reason that <math id="A2.SS5.SSS2.Px1.p6.m7" class="ltx_Math" alttext="x_{1}=x_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>=</mo><msub><mi>x</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">x_{1}=x_{2}</annotation></semantics></math>. Without completeness of
<math id="A2.SS5.SSS2.Px1.p6.m8" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{3})</annotation></semantics></math>, the Open Mapping Theorem cannot be applied to the identity maps</span></p>
<table id="A2.Ex180" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex180.m1" class="ltx_math_unparsed" alttext="\mathrm{id}:(X,\|\cdot\|_{3})\to(X,\|\cdot\|_{1}),\qquad\mathrm{id}:(X,\|\cdot\|_{3})\to(X,\|\cdot\|_{2})." display="block" intent=":literal"><semantics><mrow><mi>id</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo rspace="2.167em">,</mo><mi>id</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{id}:(X,\|\cdot\|_{3})\to(X,\|\cdot\|_{1}),\qquad\mathrm{id}:(X,\|\cdot\|_{3})\to(X,\|\cdot\|_{2}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS2.Px1.p6.2" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p6.2.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS5.SSS2.Px1.p7" class="ltx_para">
<p id="A2.SS5.SSS2.Px1.p7.1" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p7.1.1" class="ltx_text">[Why the general statement is false]
Let <math id="A2.SS5.SSS2.Px1.p7.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> be an infinite dimensional real vector space. There exist linear bijections
<math id="A2.SS5.SSS2.Px1.p7.m2" class="ltx_Math" alttext="T_{1}:X\to\ell^{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msup><mi mathvariant="normal">ℓ</mi><mn>1</mn></msup></mrow></mrow><annotation encoding="application/x-tex">T_{1}:X\to\ell^{1}</annotation></semantics></math> and <math id="A2.SS5.SSS2.Px1.p7.m3" class="ltx_Math" alttext="T_{2}:X\to\ell^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>2</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">→</mo><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">T_{2}:X\to\ell^{2}</annotation></semantics></math> (they have the same Hamel dimension).
Define</span></p>
<table id="A2.Ex181" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex181.m1" class="ltx_math_unparsed" alttext="\|x\|_{1}:=\|T_{1}x\|_{\ell^{1}},\qquad\|x\|_{2}:=\|T_{2}x\|_{\ell^{2}}\qquad(x\in X)." display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∥</mo><mi>x</mi><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>1</mn></msub><mo lspace="0.0835em" rspace="0em">:=</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>T</mi><mn>1</mn></msub><mi>x</mi><msub><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi mathvariant="normal">ℓ</mi><mn>1</mn></msup></msub><mo rspace="1.889em">,</mo><mo rspace="0.167em">∥</mo><mi>x</mi><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">:=</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>T</mi><mn>2</mn></msub><mi>x</mi><msub><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>∈</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|x\|_{1}:=\|T_{1}x\|_{\ell^{1}},\qquad\|x\|_{2}:=\|T_{2}x\|_{\ell^{2}}\qquad(x\in X).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSS2.Px1.p7.2" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p7.2.1" class="ltx_text">Then <math id="A2.SS5.SSS2.Px1.p7.m4" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{1})</annotation></semantics></math> is isometric to <math id="A2.SS5.SSS2.Px1.p7.m5" class="ltx_Math" alttext="\ell^{1}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">ℓ</mi><mn>1</mn></msup><annotation encoding="application/x-tex">\ell^{1}</annotation></semantics></math> and <math id="A2.SS5.SSS2.Px1.p7.m6" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{2})</annotation></semantics></math> is isometric to <math id="A2.SS5.SSS2.Px1.p7.m7" class="ltx_Math" alttext="\ell^{2}" display="inline" intent=":literal"><semantics><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\ell^{2}</annotation></semantics></math>, so both are Banach.
If these norms were equivalent on <math id="A2.SS5.SSS2.Px1.p7.m8" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, the identity
<math id="A2.SS5.SSS2.Px1.p7.m9" class="ltx_math_unparsed" alttext="\mathrm{id}:(X,\|\cdot\|_{1})\to(X,\|\cdot\|_{2})" display="inline" intent=":literal"><semantics><mrow><mi>id</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{id}:(X,\|\cdot\|_{1})\to(X,\|\cdot\|_{2})</annotation></semantics></math> would be an isomorphism of Banach spaces, implying
<math id="A2.SS5.SSS2.Px1.p7.m10" class="ltx_Math" alttext="\ell^{1}\simeq\ell^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">ℓ</mi><mn>1</mn></msup><mo>≃</mo><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\ell^{1}\simeq\ell^{2}</annotation></semantics></math> as Banach spaces, which is false. Hence <math id="A2.SS5.SSS2.Px1.p7.m11" class="ltx_math_unparsed" alttext="\|\cdot\|_{1}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{1}</annotation></semantics></math> and <math id="A2.SS5.SSS2.Px1.p7.m12" class="ltx_math_unparsed" alttext="\|\cdot\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{2}</annotation></semantics></math> need not be equivalent.</span></p>
</div>
<div id="A2.SS5.SSS2.Px1.p8" class="ltx_para">
<p id="A2.SS5.SSS2.Px1.p8.1" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p8.1.1" class="ltx_text">Now consider <math id="A2.SS5.SSS2.Px1.p8.m1" class="ltx_Math" alttext="\|x\|_{3}=\|x\|_{1}+\|x\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>3</mn></msub><mo>=</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|x\|_{3}=\|x\|_{1}+\|x\|_{2}</annotation></semantics></math>. If <math id="A2.SS5.SSS2.Px1.p8.m2" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{3})</annotation></semantics></math> were complete, the identity maps
<math id="A2.SS5.SSS2.Px1.p8.m3" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{3})\to(X,\|\cdot\|_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{3})\to(X,\|\cdot\|_{1})</annotation></semantics></math> and <math id="A2.SS5.SSS2.Px1.p8.m4" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{3})\to(X,\|\cdot\|_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{3})\to(X,\|\cdot\|_{2})</annotation></semantics></math> would be continuous, surjective, and by the
Open Mapping Theorem would have continuous inverses. This would give
<math id="A2.SS5.SSS2.Px1.p8.m5" class="ltx_Math" alttext="\|x\|_{1}\asymp\|x\|_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>≍</mo><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\|x\|_{1}\asymp\|x\|_{3}</annotation></semantics></math> and <math id="A2.SS5.SSS2.Px1.p8.m6" class="ltx_Math" alttext="\|x\|_{2}\asymp\|x\|_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub><mo>≍</mo><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">\|x\|_{2}\asymp\|x\|_{3}</annotation></semantics></math>, hence <math id="A2.SS5.SSS2.Px1.p8.m7" class="ltx_Math" alttext="\|x\|_{1}\asymp\|x\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>≍</mo><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|x\|_{1}\asymp\|x\|_{2}</annotation></semantics></math>, a contradiction.
Therefore <math id="A2.SS5.SSS2.Px1.p8.m8" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{3})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{3})</annotation></semantics></math> cannot be complete in this example.</span></p>
</div>
<div id="A2.SS5.SSS2.Px1.p9" class="ltx_para">
<ul id="A2.I12" class="ltx_itemize">
<li id="A2.I12.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I12.i1.p1" class="ltx_para">
<p id="A2.I12.i1.p1.1" class="ltx_p"><span id="A2.I12.i1.p1.1.1" class="ltx_text ltx_font_bold">Finite dimensional case.</span> If <math id="A2.I12.i1.p1.m1" class="ltx_Math" alttext="\dim X&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">dim</mo><mi>X</mi></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\dim X&lt;\infty</annotation></semantics></math>, then <em id="A2.I12.i1.p1.1.2" class="ltx_emph ltx_font_italic">all</em> norms on <math id="A2.I12.i1.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> are equivalent (compactness of the unit sphere or a basis argument).</p>
</div></li>
<li id="A2.I12.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I12.i2.p1" class="ltx_para">
<p id="A2.I12.i2.p1.1" class="ltx_p"><span id="A2.I12.i2.p1.1.1" class="ltx_text ltx_font_bold">A correct route to equivalence.</span> Let <math id="A2.I12.i2.p1.m1" class="ltx_math_unparsed" alttext="\|\cdot\|_{1},\|\cdot\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∥</mo><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{1},\|\cdot\|_{2}</annotation></semantics></math> be norms such that both
<math id="A2.I12.i2.p1.m2" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{1})</annotation></semantics></math> and <math id="A2.I12.i2.p1.m3" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{2})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{2})</annotation></semantics></math> are Banach. If the identity
<math id="A2.I12.i2.p1.m4" class="ltx_math_unparsed" alttext="(X,\|\cdot\|_{2})\to(X,\|\cdot\|_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mo lspace="0em" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><msub><mo lspace="0em" rspace="0.167em">∥</mo><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(X,\|\cdot\|_{2})\to(X,\|\cdot\|_{1})</annotation></semantics></math> is continuous (i.e. <math id="A2.I12.i2.p1.m5" class="ltx_Math" alttext="\|x\|_{1}\leq C\|x\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo>≤</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>x</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\|x\|_{1}\leq C\|x\|_{2}</annotation></semantics></math> for all <math id="A2.I12.i2.p1.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>), then by the Open Mapping (or Bounded Inverse) Theorem its inverse is continuous, so the norms are equivalent.</p>
</div></li>
<li id="A2.I12.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I12.i3.p1" class="ltx_para">
<p id="A2.I12.i3.p1.1" class="ltx_p"><span id="A2.I12.i3.p1.1.1" class="ltx_text ltx_font_bold">Completeness is preserved by equivalence.</span> If two norms are equivalent on <math id="A2.I12.i3.p1.m1" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, then <math id="A2.I12.i3.p1.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> is complete under one iff it is complete under the other.</p>
</div></li>
</ul>
</div>
<div id="A2.SS5.SSS2.Px1.p10" class="ltx_para">
<p id="A2.SS5.SSS2.Px1.p10.1" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p10.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS5.SSS2.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS5.SSS2.Px1.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS5.SSS2.Px1.p11" class="ltx_para">
<p id="A2.SS5.SSS2.Px1.p11.1" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p11.1.1" class="ltx_text">The key point is that being converging in both norms does not imply convergence in the third unless the limits agree.</span></p>
</div>
<div id="A2.SS5.SSS2.Px1.p12" class="ltx_para">
<p id="A2.SS5.SSS2.Px1.p12.1" class="ltx_p"><a href="https://Math%20Stack%20Exchange%20Discussion" title="" class="ltx_ref ltx_href">https://mathoverflow.net/questions/44716/counterexample-for-the-open-mapping-theorem</a><span id="A2.SS5.SSS2.Px1.p12.1.1" class="ltx_text">
∎</span></p>
</div>
</div>
<div id="A2.SS5.SSS2.Px1.p13" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS5.SSS2.Px1.p13.pic1" class="ltx_picture" height="86.84" overflow="visible" version="1.1" viewBox="0 0 429.64 86.84" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,86.84) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 82.22 C 0 84.77 2.07 86.84 4.63 86.84 L 425.01 86.84 C 427.56 86.84 429.64 84.77 429.64 82.22 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 67.98 L 428.94 67.98 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 72.61)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS5.SSS2.Px1.p13.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS5.SSS2.Px1.p13.pic1.1.1" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p13.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Rubric</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:2.96em;--ltx-fo-depth:0.2em;font-size:10pt;" height="43.66" overflow="visible" transform="matrix(1 0 0 -1 0 40.9)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS5.SSS2.Px1.p13.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS5.SSS2.Px1.p13.pic1.2.1" class="ltx_p"><span id="A2.SS5.SSS2.Px1.p13.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">1 point is awarded for detecting the error in: "A Cauchy sequence converging in both norms <math id="A2.SS5.SSS2.Px1.p13.pic1.m1" class="ltx_math_unparsed" alttext="\|\cdot\|_{1},\|\cdot\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{1},\|\cdot\|_{2}</annotation></semantics></math> does not imply the existence of limit in the <math id="A2.SS5.SSS2.Px1.p13.pic1.m2" class="ltx_math_unparsed" alttext="\|\cdot\|_{3}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">∥</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></msub></mrow><annotation encoding="application/x-tex">\|\cdot\|_{3}</annotation></semantics></math> unless two limits agree."</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS5.SSS2.Px1.p14" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS5.SSS2.Px1.p14.pic1" class="ltx_picture" height="54.13" overflow="visible" version="1.1" viewBox="0 0 429.64 54.13" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,54.13) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#5A996B;" fill="#5A996B" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 49.51 C 0 52.06 2.07 54.13 4.63 54.13 L 425.01 54.13 C 427.56 54.13 429.64 52.06 429.64 49.51 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F6FFF9;" fill="#F6FFF9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 35.38 L 428.94 35.38 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 40.01)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
