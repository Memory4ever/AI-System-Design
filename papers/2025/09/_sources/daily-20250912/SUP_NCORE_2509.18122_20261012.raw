</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS1.Px1.p17.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS6.SSS1.Px1.p17.pic1.2.1" class="ltx_p"><span id="A2.SS6.SSS1.Px1.p17.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">2/2</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS6.SSS1.Px1.p18" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS6.SSS1.Px1.p18.pic1" class="ltx_picture" height="53.02" overflow="visible" version="1.1" viewBox="0 0 429.64 53.02" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,53.02) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 48.39 C 0 50.95 2.07 53.02 4.63 53.02 L 425.01 53.02 C 427.56 53.02 429.64 50.95 429.64 48.39 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 34.15 L 428.94 34.15 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 38.78)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS1.Px1.p18.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS6.SSS1.Px1.p18.pic1.1.1" class="ltx_p"><span id="A2.SS6.SSS1.Px1.p18.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.56em;--ltx-fo-depth:0.16em;font-size:10pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS1.Px1.p18.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS6.SSS1.Px1.p18.pic1.2.1" class="ltx_p"><span id="A2.SS6.SSS1.Px1.p18.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Correct answer and clear explanation.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
</section>
<section id="A2.SS6.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">(b) </span>Communicating ideas to different audiences</h4>

<section id="A2.SS6.SSS2.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#FF0000;">Problem 6b1 </h5>

<div id="A2.SS6.SSS2.Px1.p1" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p1.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS6.SSS2.Px1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS6.SSS2.Px1.p2.pic1" class="ltx_picture" height="114.15" overflow="visible" version="1.1" viewBox="0 0 429.64 114.15" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,114.15) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 109.52 C 0 112.08 2.07 114.15 4.63 114.15 L 425.01 114.15 C 427.56 114.15 429.64 112.08 429.64 109.52 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 95.29 L 428.94 95.29 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 99.92)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS2.Px1.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS6.SSS2.Px1.p2.pic1.1.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:4.97em;--ltx-fo-depth:0.16em;font-size:10pt;" height="70.97" overflow="visible" transform="matrix(1 0 0 -1 0 68.82)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS2.Px1.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS6.SSS2.Px1.p2.pic1.2.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Explain to a mathematician why symplectic geometry is the correct setting for classical mechanics.</span></span><span class="ltx_inline-block"><svg id="A2.SS6.SSS2.Px1.p2.pic1.pic1" class="ltx_picture" color="#FF0000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 0 L 15.75 15.75 M 0 15.75 L 15.75 0"></path></g></svg></span>
<span id="A2.SS6.SSS2.Px1.p2.pic1.2.2" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;">GPT-5 thinking failed</span></span>
<span id="A2.SS6.SSS2.Px1.p2.pic1.2.3" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p2.pic1.2.3.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Tahsin Saffat</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS6.SSS2.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS6.SSS2.Px1.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS6.SSS2.Px1.p3" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p3.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p3.1.1" class="ltx_text">Here’s a compact “coordinate-free” case for why classical mechanics lives most naturally in symplectic geometry.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p4" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p4.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p4.1.1" class="ltx_text">1) Phase space is canonically a symplectic manifold</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p5" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p5.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p5.1.1" class="ltx_text">A mechanical system with configuration space <math id="A2.SS6.SSS2.Px1.p5.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> has phase space <math id="A2.SS6.SSS2.Px1.p5.m2" class="ltx_Math" alttext="T^{*}Q" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">T^{*}Q</annotation></semantics></math>. It comes with a canonical 1-form <math id="A2.SS6.SSS2.Px1.p5.m3" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> (“Liouville form”) defined by <math id="A2.SS6.SSS2.Px1.p5.m4" class="ltx_Math" alttext="\theta_{(q,p)}(v)=p(d\pi(v))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>θ</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{(q,p)}(v)=p(d\pi(v))</annotation></semantics></math>, <math id="A2.SS6.SSS2.Px1.p5.m5" class="ltx_Math" alttext="\pi:T^{*}Q\to Q" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mo stretchy="false">→</mo><mi>Q</mi></mrow></mrow><annotation encoding="application/x-tex">\pi:T^{*}Q\to Q</annotation></semantics></math>. Its differential</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p6" class="ltx_para">
<table id="A2.Ex187" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex187.m1" class="ltx_Math" alttext="\omega:=d\theta" display="block" intent=":literal"><semantics><mrow><mi>ω</mi><mo>:=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><annotation encoding="application/x-tex">\omega:=d\theta</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS6.SSS2.Px1.p7" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p7.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p7.1.1" class="ltx_text">is a closed, nondegenerate 2-form. That pair <math id="A2.SS6.SSS2.Px1.p7.m1" class="ltx_Math" alttext="(T^{*}Q,\omega)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(T^{*}Q,\omega)</annotation></semantics></math> is the **symplectic** structure, requiring no coordinates or auxiliary choices. Any smooth change of variables preserving <math id="A2.SS6.SSS2.Px1.p7.m2" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> is a **canonical transformation** (symplectomorphism).</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p8" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p8.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p8.1.1" class="ltx_text">Darboux’s theorem says every symplectic manifold is locally <math id="A2.SS6.SSS2.Px1.p8.m1" class="ltx_Math" alttext="(\mathbb{R}^{2n},\sum_{i}dp_{i}\wedge dq^{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>ℝ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msup><mo rspace="0em">,</mo><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>i</mi></msub></mrow></mrow><mo>∧</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>q</mi><mi>i</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbb{R}^{2n},\sum_{i}dp_{i}\wedge dq^{i})</annotation></semantics></math>. So symplectic geometry captures precisely the invariant content of the usual canonical coordinates—no more, no less.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p9" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p9.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p9.1.1" class="ltx_text">2) Dynamics is a Hamiltonian vector field determined by <math id="A2.SS6.SSS2.Px1.p9.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math></span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p10" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p10.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p10.1.1" class="ltx_text">A Hamiltonian <math id="A2.SS6.SSS2.Px1.p10.m1" class="ltx_Math" alttext="H:M\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">H:M\to\mathbb{R}</annotation></semantics></math> (energy) defines a unique vector field <math id="A2.SS6.SSS2.Px1.p10.m2" class="ltx_Math" alttext="X_{H}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>H</mi></msub><annotation encoding="application/x-tex">X_{H}</annotation></semantics></math> by</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p11" class="ltx_para">
<table id="A2.Ex188" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex188.m1" class="ltx_Math" alttext="\iota_{X_{H}}\,\omega=dH." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ι</mi><msub><mi>X</mi><mi>H</mi></msub></msub><mo lspace="0.170em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\iota_{X_{H}}\,\omega=dH.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS6.SSS2.Px1.p12" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p12.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p12.1.1" class="ltx_text">This *is* Hamilton’s equations, but coordinate-free. The flow <math id="A2.SS6.SSS2.Px1.p12.m1" class="ltx_Math" alttext="\varphi_{t}" display="inline" intent=":literal"><semantics><msub><mi>φ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\varphi_{t}</annotation></semantics></math> of <math id="A2.SS6.SSS2.Px1.p12.m2" class="ltx_Math" alttext="X_{H}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mi>H</mi></msub><annotation encoding="application/x-tex">X_{H}</annotation></semantics></math> satisfies <math id="A2.SS6.SSS2.Px1.p12.m3" class="ltx_Math" alttext="\varphi_{t}^{*}\omega=\omega" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>φ</mi><mi>t</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>=</mo><mi>ω</mi></mrow><annotation encoding="application/x-tex">\varphi_{t}^{*}\omega=\omega</annotation></semantics></math> and <math id="A2.SS6.SSS2.Px1.p12.m4" class="ltx_Math" alttext="H\circ\varphi_{t}=H" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>φ</mi><mi>t</mi></msub></mrow><mo>=</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">H\circ\varphi_{t}=H</annotation></semantics></math> (when <math id="A2.SS6.SSS2.Px1.p12.m5" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is time-independent). Thus conservation of phase-space area/volume and energy is built into the geometry.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p13" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p13.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p13.1.1" class="ltx_text">3) Observables form a Poisson algebra induced by <math id="A2.SS6.SSS2.Px1.p13.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math></span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p14" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p14.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p14.1.1" class="ltx_text">For observables <math id="A2.SS6.SSS2.Px1.p14.m1" class="ltx_Math" alttext="f,g\in C^{\infty}(M)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>,</mo><mi>g</mi></mrow><mo>∈</mo><mrow><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f,g\in C^{\infty}(M)</annotation></semantics></math>,</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p15" class="ltx_para">
<table id="A2.Ex189" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex189.m1" class="ltx_Math" alttext="\{f,g\}:=\omega(X_{f},X_{g})" display="block" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">}</mo></mrow><mo>:=</mo><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>f</mi></msub><mo>,</mo><msub><mi>X</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{f,g\}:=\omega(X_{f},X_{g})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS6.SSS2.Px1.p16" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p16.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p16.1.1" class="ltx_text">is the **Poisson bracket**. It is bilinear, antisymmetric, satisfies Jacobi, and makes <math id="A2.SS6.SSS2.Px1.p16.m1" class="ltx_Math" alttext="C^{\infty}(M)" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mi mathvariant="normal">∞</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C^{\infty}(M)</annotation></semantics></math> a Poisson algebra. Dynamics is <math id="A2.SS6.SSS2.Px1.p16.m2" class="ltx_Math" alttext="\dot{f}=\{f,H\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>˙</mo></mover><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>f</mi><mo>,</mo><mi>H</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\dot{f}=\{f,H\}</annotation></semantics></math>. Canonical transformations are exactly the automorphisms of this Poisson algebra. This is the right notion of “structure-preserving change of variables.”</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p17" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p17.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p17.1.1" class="ltx_text">4) Volume and statistics: Liouville measure</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p18" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p18.1" class="ltx_p"><math id="A2.SS6.SSS2.Px1.p18.m1" class="ltx_Math" alttext="\omega^{n}/n!" display="inline" intent=":literal"><semantics><mrow><msup><mi>ω</mi><mi>n</mi></msup><mo>/</mo><mrow><mi>n</mi><mo>!</mo></mrow></mrow><annotation encoding="application/x-tex">\omega^{n}/n!</annotation></semantics></math><span id="A2.SS6.SSS2.Px1.p18.1.1" class="ltx_text"> is a natural volume form. Hamiltonian flows preserve it (Liouville’s theorem), which underlies equilibrium statistical mechanics and the meaning of “uniform distribution in phase space.” Again: a geometric invariant, not a coordinate artifact.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p19" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p19.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p19.1.1" class="ltx_text">5) Symmetries and conserved quantities = moment maps</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p20" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p20.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p20.1.1" class="ltx_text">If a Lie group <math id="A2.SS6.SSS2.Px1.p20.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> acts symplectically on <math id="A2.SS6.SSS2.Px1.p20.m2" class="ltx_Math" alttext="(M,\omega)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,\omega)</annotation></semantics></math>, a **moment map**</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p21" class="ltx_para">
<table id="A2.Ex190" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex190.m1" class="ltx_Math" alttext="\mu:M\to\mathfrak{g}^{*},\qquad d\langle\mu,\xi\rangle=\iota_{X_{\xi}}\omega" display="block" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>M</mi><mo stretchy="false">→</mo><msup><mi>𝔤</mi><mo>∗</mo></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>μ</mi><mo>,</mo><mi>ξ</mi></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>ι</mi><msub><mi>X</mi><mi>ξ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu:M\to\mathfrak{g}^{*},\qquad d\langle\mu,\xi\rangle=\iota_{X_{\xi}}\omega</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS6.SSS2.Px1.p22" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p22.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p22.1.1" class="ltx_text">packages Noether’s theorem: <math id="A2.SS6.SSS2.Px1.p22.m1" class="ltx_Math" alttext="\langle\mu,\xi\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><mi>μ</mi><mo>,</mo><mi>ξ</mi></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle\mu,\xi\rangle</annotation></semantics></math> is conserved along the flow iff <math id="A2.SS6.SSS2.Px1.p22.m2" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math> generates a symmetry. The bracket satisfies <math id="A2.SS6.SSS2.Px1.p22.m3" class="ltx_Math" alttext="\{\langle\mu,\xi\rangle,\langle\mu,\eta\rangle\}=\langle\mu,[\xi,\eta]\rangle" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>μ</mi><mo>,</mo><mi>ξ</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>μ</mi><mo>,</mo><mi>η</mi></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">}</mo></mrow><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><mi>μ</mi><mo>,</mo><mrow><mo stretchy="false">[</mo><mrow><mi>ξ</mi><mo>,</mo><mi>η</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">\{\langle\mu,\xi\rangle,\langle\mu,\eta\rangle\}=\langle\mu,[\xi,\eta]\rangle</annotation></semantics></math>. This is exactly the algebra of angular momentum, linear momentum, etc., made intrinsic.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p23" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p23.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p23.1.1" class="ltx_text">6) Reduction and constraints (Marsden–Weinstein)</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p24" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p24.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p24.1.1" class="ltx_text">First-class constraints and gauge symmetries fit cleanly: the reduced phase space</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p25" class="ltx_para">
<table id="A2.Ex191" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex191.m1" class="ltx_Math" alttext="M_{\text{red}}=\mu^{-1}(c)/G" display="block" intent=":literal"><semantics><mrow><msub><mi>M</mi><mtext>red</mtext></msub><mo>=</mo><mrow><mrow><msup><mi>μ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>G</mi></mrow></mrow><annotation encoding="application/x-tex">M_{\text{red}}=\mu^{-1}(c)/G</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS6.SSS2.Px1.p26" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p26.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p26.1.1" class="ltx_text">inherits a symplectic form and hosts the true dynamics. This is the geometric content behind eliminating cyclic coordinates, rigid-body examples, and more elaborate gauge reductions.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p27" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p27.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p27.1.1" class="ltx_text">7) Variational principles, Legendre transform, and contact lift</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p28" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p28.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p28.1.1" class="ltx_text">Regular Lagrangians <math id="A2.SS6.SSS2.Px1.p28.m1" class="ltx_Math" alttext="L:TQ\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">L:TQ\to\mathbb{R}</annotation></semantics></math> are Legendre-dual to Hamiltonians <math id="A2.SS6.SSS2.Px1.p28.m2" class="ltx_Math" alttext="H:T^{*}Q\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">H:T^{*}Q\to\mathbb{R}</annotation></semantics></math>. The Cartan 1-form on <math id="A2.SS6.SSS2.Px1.p28.m3" class="ltx_Math" alttext="TQ" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">TQ</annotation></semantics></math> pushes forward to <math id="A2.SS6.SSS2.Px1.p28.m4" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> on <math id="A2.SS6.SSS2.Px1.p28.m5" class="ltx_Math" alttext="T^{*}Q" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>Q</mi></mrow><annotation encoding="application/x-tex">T^{*}Q</annotation></semantics></math>. Time-dependent systems sit naturally in **contact** geometry (<math id="A2.SS6.SSS2.Px1.p28.m6" class="ltx_Math" alttext="M\times\mathbb{R}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>ℝ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">M\times\mathbb{R}_{t}</annotation></semantics></math> with a contact form), whose symplectization recovers autonomous Hamiltonian dynamics. So Lagrange and Hamilton pictures are two faces of the same symplectic coin.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p29" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p29.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p29.1.1" class="ltx_text">8) Integrable systems = action–angle on symplectic manifolds</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p30" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p30.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p30.1.1" class="ltx_text">Complete integrability (Arnold–Liouville) is a symplectic statement: on a regular invariant torus, there are **action–angle** coordinates <math id="A2.SS6.SSS2.Px1.p30.m1" class="ltx_Math" alttext="(I,\phi)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>I</mi><mo>,</mo><mi>ϕ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(I,\phi)</annotation></semantics></math> with <math id="A2.SS6.SSS2.Px1.p30.m2" class="ltx_Math" alttext="\omega=\sum dI_{i}\wedge d\phi_{i}" display="inline" intent=":literal"><semantics><mrow><mi>ω</mi><mo rspace="0.111em">=</mo><mrow><mrow><mo>∑</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mi>i</mi></msub></mrow></mrow><mo>∧</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>ϕ</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\omega=\sum dI_{i}\wedge d\phi_{i}</annotation></semantics></math> and linear flow <math id="A2.SS6.SSS2.Px1.p30.m3" class="ltx_Math" alttext="\dot{\phi}=\omega(I)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ϕ</mi><mo>˙</mo></mover><mo>=</mo><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\dot{\phi}=\omega(I)</annotation></semantics></math>. This explains normal forms and long-time behavior without coordinates tied to any specific model.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p31" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p31.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p31.1.1" class="ltx_text">9) Singular/rigid examples via Poisson and coadjoint orbits</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p32" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p32.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p32.1.1" class="ltx_text">Not every classical system is globally a cotangent bundle; constraints can produce **Poisson** manifolds whose **symplectic leaves** are the true phase spaces. Coadjoint orbits carry the Kirillov–Kostant–Souriau symplectic form and model rigid body tops, ideal fluids, plasmas, etc. Symplectic geometry is the regular part of this broader but still geometric picture.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p33" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p33.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p33.1.1" class="ltx_text">10) Bridge to quantum mechanics</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p34" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p34.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p34.1.1" class="ltx_text">Geometric quantization and deformation quantization start from <math id="A2.SS6.SSS2.Px1.p34.m1" class="ltx_Math" alttext="(M,\omega)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>ω</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,\omega)</annotation></semantics></math> and the Poisson algebra, turning <math id="A2.SS6.SSS2.Px1.p34.m2" class="ltx_Math" alttext="\{f,g\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>f</mi><mo>,</mo><mi>g</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{f,g\}</annotation></semantics></math> into <math id="A2.SS6.SSS2.Px1.p34.m3" class="ltx_Math" alttext="[\hat{f},\hat{g}]/(i\hbar)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>,</mo><mover accent="true"><mi>g</mi><mo>^</mo></mover></mrow><mo stretchy="false">]</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℏ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">[\hat{f},\hat{g}]/(i\hbar)</annotation></semantics></math> to first order. The classical–quantum interface is literally organized by the symplectic form.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p35" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p35.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p35.1.1" class="ltx_text">—</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p36" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p36.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p36.1.1" class="ltx_text">**Bottom line.**
Classical mechanics is about: (i) a space of states with a canonical, coordinate-free area form pairing momenta with displacements; (ii) dynamics as the Hamiltonian vector field singled out by that pairing; (iii) symmetries, conservation laws, integrability, constraints, and statistical measures encoded invariantly by that same structure. That structure is exactly a symplectic manifold. Hence: symplectic geometry isn’t just convenient—it *is* the intrinsic language of classical mechanics.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p37" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p37.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p37.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS6.SSS2.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS6.SSS2.Px1.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS6.SSS2.Px1.p38" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p38.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p38.1.1" class="ltx_text">Source: <span class="ltx_ref ltx_ref_self">https://cohn.mit.edu/symplectic/</span></span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p39" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p39.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p39.1.1" class="ltx_text">My goal is to give a precise formulation of the idea of the phase space of a system in classical mechanics. This space is supposed to be a manifold with some additional structure. The points correspond to states of the system, and the additional structure is essentially the laws of motion. The dynamics of the system will be determined by a function on the manifold called the Hamiltonian (it gives the energy of each state of the system).</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p40" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p40.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p40.1.1" class="ltx_text">The fundamental example to keep in mind is n particles in three-dimensional space, acted on by some force depending on their relative positions. The phase space is (R6)n, since each particle is specified by six coordinates: three position coordinates and three momentum coordinates. The additional structure is supposed to correspond to Newton’s laws (this idea will be made more precise below). The dynamics are determined from the potential function for the force, i.e. the Hamiltonian.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p41" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p41.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p41.1.1" class="ltx_text">In more general settings there is no reason why the underlying manifold should be Euclidean space. For example, particles may be constrained to lie on curves or surfaces, or the states may not even be described in terms of a bunch of particles. It’s natural to ask how abstractly this can be set up. Can we axiomatize the properties of phase space, and then just deal with it abstractly (without worrying about the precise setup that led to it)? In fact we can, and symplectic manifolds are the appropriate abstraction. In what follows I’ll attempt to explain where symplectic manifolds come from. Whenever I write "should," I am indicating an intuitive argument.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p42" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p42.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p42.1.1" class="ltx_text">Suppose M is a smooth manifold. What additional structure is needed to define dynamics on M? We want to turn a Hamiltonian H (i.e., any smooth function on M) into a vector field V. Then the dynamics consists of the flow along integral curves of V.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p43" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p43.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p43.1.1" class="ltx_text">First, note that the vector field V should depend only on the differential dH. This makes perfect sense, since the dynamics should depend only on how the energy is changing locally, and not for example on a global additive constant.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p44" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p44.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p44.1.1" class="ltx_text">Second, V should depend linearly on dH. This amounts to the assertion that Newton’s laws are linear differential equations, which is true.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p45" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p45.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p45.1.1" class="ltx_text">What sort of object turns a 1-form dH into a vector field V in this way? The most natural such object is a tensor field, in particular a section of <math id="A2.SS6.SSS2.Px1.p45.m1" class="ltx_Math" alttext="\mathrm{Hom}(T^{*}M,TM)" display="inline" intent=":literal"><semantics><mrow><mi>Hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Hom}(T^{*}M,TM)</annotation></semantics></math>. Here TM denotes the tangent bundle of M and <math id="A2.SS6.SSS2.Px1.p45.m2" class="ltx_Math" alttext="T^{*}M" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T^{*}M</annotation></semantics></math> denotes the cotangent bundle. It will actually be more convenient to use the dual approach, namely <math id="A2.SS6.SSS2.Px1.p45.m3" class="ltx_Math" alttext="\mathrm{Hom}(TM,T^{*}M)" display="inline" intent=":literal"><semantics><mrow><mi>Hom</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>,</mo><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Hom}(TM,T^{*}M)</annotation></semantics></math>, which is of course the same as <math id="A2.SS6.SSS2.Px1.p45.m4" class="ltx_Math" alttext="T^{*}M\otimes T^{*}M" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T^{*}M\otimes T^{*}M</annotation></semantics></math>. It works as follows:</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p46" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p46.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p46.1.1" class="ltx_text">Let <math id="A2.SS6.SSS2.Px1.p46.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> be a section of <math id="A2.SS6.SSS2.Px1.p46.m2" class="ltx_Math" alttext="T^{*}M\otimes T^{*}M" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T^{*}M\otimes T^{*}M</annotation></semantics></math>. Over each point of M, <math id="A2.SS6.SSS2.Px1.p46.m3" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> is a bilinear mapping from pairs to vectors to the field R of real numbers. The 1-form dH gives us a covector at each point, and the vector field V should be such that plugging it into <math id="A2.SS6.SSS2.Px1.p46.m4" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> gives dH. More precisely, for each vector field X, <math id="A2.SS6.SSS2.Px1.p46.m5" class="ltx_Math" alttext="\omega(V,X)=(dH)(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\omega(V,X)=(dH)(X)</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p47" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p47.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p47.1.1" class="ltx_text">Our first requirement is that <math id="A2.SS6.SSS2.Px1.p47.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> must be nondegenerate, so we can always solve for V. Specifically, we require that for every 1-form <math id="A2.SS6.SSS2.Px1.p47.m2" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> on M, there is a vector field V such that <math id="A2.SS6.SSS2.Px1.p47.m3" class="ltx_Math" alttext="\omega(V,X)=\nu(X)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ν</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\omega(V,X)=\nu(X)</annotation></semantics></math> for all vector fields X. (It follows from linear algebra that V is always unique if it always exists.)</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p48" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p48.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p48.1.1" class="ltx_text">So far we’ve got a manifold M with a nondegenerate tensor field <math id="A2.SS6.SSS2.Px1.p48.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> in <math id="A2.SS6.SSS2.Px1.p48.m2" class="ltx_Math" alttext="T^{*}M\otimes T^{*}M" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>T</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo lspace="0.222em" rspace="0.222em">⊗</mo><msup><mi>T</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">T^{*}M\otimes T^{*}M</annotation></semantics></math>. However, not every such tensor field will do, since we really haven’t used much information about the laws of physics yet. The next restriction is conservation of energy. Under which conditions on <math id="A2.SS6.SSS2.Px1.p48.m3" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> does conservation of energy hold?</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p49" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p49.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p49.1.1" class="ltx_text">What it means in our situation is that the Hamiltonian H is constant along the flow lines of our vector field V. In other words, (dH)(V) = 0. In terms of <math id="A2.SS6.SSS2.Px1.p49.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>, that means <math id="A2.SS6.SSS2.Px1.p49.m2" class="ltx_Math" alttext="\omega(V,V)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>V</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\omega(V,V)=0</annotation></semantics></math>. This must hold for all vector fields V coming from Hamiltonians, which means that the bilinear form above each point of M must be an alternating form. (Not every vector field comes from a Hamiltonian, but each tangent vector occurs in some Hamiltonian vector field.) In other words, <math id="A2.SS6.SSS2.Px1.p49.m3" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> is a differential 2-form on M.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p50" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p50.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p50.1.1" class="ltx_text">A symplectic manifold is a manifold together with a closed, nondegenerate 2-form. We have seen that the 2-form corresponds to having laws of physics given by linear differential equations that conserve energy, and nondegeneracy is needed to ensure that the equations have solutions. All that remains is to explain why <math id="A2.SS6.SSS2.Px1.p50.m1" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> should be closed, i.e., why <math id="A2.SS6.SSS2.Px1.p50.m2" class="ltx_Math" alttext="d\omega=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d\omega=0</annotation></semantics></math>. Unfortunately I don’t see how to explain that without slightly more notation, but it won’t be too bad.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p51" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p51.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p51.1.1" class="ltx_text">This requirement corresponds to a slightly more subtle issue, namely that the laws of physics should not depend on time. Let <math id="A2.SS6.SSS2.Px1.p51.m1" class="ltx_Math" alttext="F_{t}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mi>t</mi></msub><annotation encoding="application/x-tex">F_{t}</annotation></semantics></math> denote the time-t flow along the vector field corresponding to some Hamiltonian H. One natural way to get the laws of physics at time t is to look at the pullback <math id="A2.SS6.SSS2.Px1.p51.m2" class="ltx_Math" alttext="{F_{t}}_{*}\omega" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>F</mi><mi>t</mi><mrow></mrow><mo>∗</mo><mrow></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><annotation encoding="application/x-tex">{F_{t}}_{*}\omega</annotation></semantics></math>. We want it to equal <math id="A2.SS6.SSS2.Px1.p51.m3" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>. Clearly it does so at time 0, so to check that it always does we simply differentiate with respect to t, as follows.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p52" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p52.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p52.1.1" class="ltx_text">If V is the vector field corresponding to H, then the derivative of <math id="A2.SS6.SSS2.Px1.p52.m1" class="ltx_Math" alttext="{F_{t}}_{*}\omega" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>F</mi><mi>t</mi><mrow></mrow><mo>∗</mo><mrow></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><annotation encoding="application/x-tex">{F_{t}}_{*}\omega</annotation></semantics></math> with respect to t is <math id="A2.SS6.SSS2.Px1.p52.m2" class="ltx_Math" alttext="{F_{t}}_{*}L_{V}\omega" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>F</mi><mi>t</mi><mrow></mrow><mo>∗</mo><mrow></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><annotation encoding="application/x-tex">{F_{t}}_{*}L_{V}\omega</annotation></semantics></math>, where <math id="A2.SS6.SSS2.Px1.p52.m3" class="ltx_Math" alttext="L_{V}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>V</mi></msub><annotation encoding="application/x-tex">L_{V}</annotation></semantics></math> denotes the Lie derivative with respect to V. Let <math id="A2.SS6.SSS2.Px1.p52.m4" class="ltx_Math" alttext="i_{V}" display="inline" intent=":literal"><semantics><msub><mi>i</mi><mi>V</mi></msub><annotation encoding="application/x-tex">i_{V}</annotation></semantics></math> denote the interior product with V, so for example <math id="A2.SS6.SSS2.Px1.p52.m5" class="ltx_Math" alttext="dH=i_{V}\omega" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo>=</mo><mrow><msub><mi>i</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow></mrow><annotation encoding="application/x-tex">dH=i_{V}\omega</annotation></semantics></math>. Then <math id="A2.SS6.SSS2.Px1.p52.m6" class="ltx_Math" alttext="L_{V}\omega=i_{V}(d\omega)+d(i_{V}\omega)=i_{V}(d\omega)+d(dH)=i_{V}(d\omega)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>=</mo><mrow><mrow><msub><mi>i</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>i</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>i</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>i</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{V}\omega=i_{V}(d\omega)+d(i_{V}\omega)=i_{V}(d\omega)+d(dH)=i_{V}(d\omega)</annotation></semantics></math> (because <math id="A2.SS6.SSS2.Px1.p52.m7" class="ltx_Math" alttext="d^{2}=0" display="inline" intent=":literal"><semantics><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">d^{2}=0</annotation></semantics></math>). The requirement that <math id="A2.SS6.SSS2.Px1.p52.m8" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> be closed means that <math id="A2.SS6.SSS2.Px1.p52.m9" class="ltx_Math" alttext="L_{V}\omega=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L_{V}\omega=0</annotation></semantics></math>. Then <math id="A2.SS6.SSS2.Px1.p52.m10" class="ltx_Math" alttext="{F_{t}}_{*}\omega" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>F</mi><mi>t</mi><mrow></mrow><mo>∗</mo><mrow></mrow></mmultiscripts><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><annotation encoding="application/x-tex">{F_{t}}_{*}\omega</annotation></semantics></math> does not depend on t, so it always equals <math id="A2.SS6.SSS2.Px1.p52.m11" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math>, as desired.</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p53" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p53.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p53.1.1" class="ltx_text">I’ve swept one tiny issue under the rug. One might wonder why this setup seems to be using first-order differential equations when Newton’s laws are typically stated as second-order equations. That just amounts to the usual trick of replacing a second-order differential equation in terms of position with a pair of first-order equations in terms of position and velocity (here, momentum).</span></p>
</div>
<div id="A2.SS6.SSS2.Px1.p54" class="ltx_para">
<p id="A2.SS6.SSS2.Px1.p54.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p54.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS6.SSS2.Px1.p55" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS6.SSS2.Px1.p55.pic1" class="ltx_picture" height="69.62" overflow="visible" version="1.1" viewBox="0 0 429.64 69.62" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,69.62) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 65 C 0 67.55 2.07 69.62 4.63 69.62 L 425.01 69.62 C 427.56 69.62 429.64 67.55 429.64 65 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 50.76 L 428.94 50.76 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 55.39)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS2.Px1.p55.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS6.SSS2.Px1.p55.pic1.1.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p55.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Rubric</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:1.76em;--ltx-fo-depth:0.16em;font-size:10pt;" height="26.44" overflow="visible" transform="matrix(1 0 0 -1 0 24.29)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS2.Px1.p55.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS6.SSS2.Px1.p55.pic1.2.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p55.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">1. Explain why the mathematical concept of symplectic manifold correctly captures the physical notion of phase space.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS6.SSS2.Px1.p56" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS6.SSS2.Px1.p56.pic1" class="ltx_picture" height="54.13" overflow="visible" version="1.1" viewBox="0 0 429.64 54.13" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,54.13) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#5A996B;" fill="#5A996B" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 49.51 C 0 52.06 2.07 54.13 4.63 54.13 L 425.01 54.13 C 427.56 54.13 429.64 52.06 429.64 49.51 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F6FFF9;" fill="#F6FFF9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 35.38 L 428.94 35.38 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 40.01)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS2.Px1.p56.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS6.SSS2.Px1.p56.pic1.1.1" class="ltx_p"><span id="A2.SS6.SSS2.Px1.p56.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Score</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS6.SSS2.Px1.p56.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
