<section id="A2.SS8.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">(b) </span>Transferring methods across domains</h4>

<section id="A2.SS8.SSS2.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#00E000;">Problem 8b1 </h5>

<div id="A2.SS8.SSS2.Px1.p1" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p1.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS8.SSS2.Px1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS8.SSS2.Px1.p2.pic1" class="ltx_picture" height="150.13" overflow="visible" version="1.1" viewBox="0 0 429.64 150.13" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,150.13) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 145.5 C 0 148.06 2.07 150.13 4.63 150.13 L 425.01 150.13 C 427.56 150.13 429.64 148.06 429.64 145.5 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 131.26 L 428.94 131.26 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 135.89)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS8.SSS2.Px1.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS8.SSS2.Px1.p2.pic1.1.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:7.57em;--ltx-fo-depth:0.16em;font-size:10pt;" height="106.95" overflow="visible" transform="matrix(1 0 0 -1 0 104.8)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS8.SSS2.Px1.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS8.SSS2.Px1.p2.pic1.2.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Find a measurable subset <math id="A2.SS8.SSS2.Px1.p2.pic1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> of <math id="A2.SS8.SSS2.Px1.p2.pic1.m2" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math> such that for any subinterval <math id="A2.SS8.SSS2.Px1.p2.pic1.m3" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math> of <math id="A2.SS8.SSS2.Px1.p2.pic1.m4" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>, the Lebesgue measure <math id="A2.SS8.SSS2.Px1.p2.pic1.m5" class="ltx_Math" alttext="\mu(A\cap I)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∩</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">I</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu(A\cap I)</annotation></semantics></math> has <math id="A2.SS8.SSS2.Px1.p2.pic1.m6" class="ltx_Math" alttext="0&lt;\mu(A\cap I)&lt;\mu(I)" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∩</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">I</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">μ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">I</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">0&lt;\mu(A\cap I)&lt;\mu(I)</annotation></semantics></math>. There’s an explicit construction of such a set in Rudin, who describes such sets as "well-distributed". Try to find a probabilistic construction.</span></span><span class="ltx_inline-block"><svg id="A2.SS8.SSS2.Px1.p2.pic1.pic1" class="ltx_picture" color="#008000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#009900;--ltx-fill-color:#009900;--ltx-fg-color:#009900;" color="#009900" fill="#009900" stroke="#009900" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 7.87 L 5.51 0 L 15.75 15.75"></path></g></svg></span>
<span id="A2.SS8.SSS2.Px1.p2.pic1.2.2" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#008000;">GPT-5 thinking passed</span></span>
<span id="A2.SS8.SSS2.Px1.p2.pic1.2.3" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p2.pic1.2.3.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Jiaxin Zhang</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS8.SSS2.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS8.SSS2.Px1.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS8.SSS2.Px1.p3" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p3.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p3.1.1" class="ltx_text">Here’s a simple **probabilistic** construction that works (and is easy to verify).</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p4" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p4.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p4.1.1" class="ltx_text">Idea in one line</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p5" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p5.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p5.1.1" class="ltx_text">Build a continuous function <math id="A2.SS8.SSS2.Px1.p5.m1" class="ltx_Math" alttext="f:[0,1]\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f:[0,1]\to\mathbb{R}</annotation></semantics></math> as a uniformly convergent random series of **pairwise disjoint bumps**, each bump having both positive and negative parts on its (tiny) support. Then set</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p6" class="ltx_para">
<table id="A2.Ex236" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex236.m1" class="ltx_Math" alttext="A:=\{x\in[0,1]:f(x)&gt;0\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A:=\{x\in[0,1]:f(x)&gt;0\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS8.SSS2.Px1.p7" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p7.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p7.1.1" class="ltx_text">Because every subinterval contains one small bump, it contains points where <math id="A2.SS8.SSS2.Px1.p7.m1" class="ltx_Math" alttext="f&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f&gt;0</annotation></semantics></math> and also points where <math id="A2.SS8.SSS2.Px1.p7.m2" class="ltx_Math" alttext="f&lt;0" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f&lt;0</annotation></semantics></math>; hence <math id="A2.SS8.SSS2.Px1.p7.m3" class="ltx_Math" alttext="0&lt;\mu(A\cap I)&lt;\mu(I)" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>∩</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">0&lt;\mu(A\cap I)&lt;\mu(I)</annotation></semantics></math> for every subinterval <math id="A2.SS8.SSS2.Px1.p7.m4" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p8" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p8.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p8.1.1" class="ltx_text">Construction</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p9" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p9.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p9.1.1" class="ltx_text">1. **Choose disjoint “test” intervals whose union is dense.**
Enumerate the rationals <math id="A2.SS8.SSS2.Px1.p9.m1" class="ltx_Math" alttext="q_{1},q_{2},\dots" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mn>1</mn></msub><mo>,</mo><msub><mi>q</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">q_{1},q_{2},\dots</annotation></semantics></math> in <math id="A2.SS8.SSS2.Px1.p9.m2" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>. Pick a sequence <math id="A2.SS8.SSS2.Px1.p9.m3" class="ltx_Math" alttext="(\delta_{j})_{j\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>δ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">(\delta_{j})_{j\geq 1}</annotation></semantics></math> with <math id="A2.SS8.SSS2.Px1.p9.m4" class="ltx_Math" alttext="\delta_{j}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>j</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{j}&gt;0</annotation></semantics></math>, <math id="A2.SS8.SSS2.Px1.p9.m5" class="ltx_Math" alttext="\sum_{j}\delta_{j}&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>j</mi></msub><msub><mi>δ</mi><mi>j</mi></msub></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{j}\delta_{j}&lt;1</annotation></semantics></math>, and <math id="A2.SS8.SSS2.Px1.p9.m6" class="ltx_Math" alttext="\delta_{j}\downarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>j</mi></msub><mo stretchy="false">↓</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{j}\downarrow 0</annotation></semantics></math>. Around each <math id="A2.SS8.SSS2.Px1.p9.m7" class="ltx_Math" alttext="q_{j}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>j</mi></msub><annotation encoding="application/x-tex">q_{j}</annotation></semantics></math>, choose a closed interval</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p10" class="ltx_para">
<table id="A2.Ex237" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex237.m1" class="ltx_Math" alttext="I_{j}=[\alpha_{j},\beta_{j}]\subset[0,1],\qquad\text{length}(I_{j})=\beta_{j}-\alpha_{j}=\delta_{j}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>I</mi><mi>j</mi></msub><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>α</mi><mi>j</mi></msub><mo>,</mo><msub><mi>β</mi><mi>j</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo>⊂</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mtext>length</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>β</mi><mi>j</mi></msub><mo>−</mo><msub><mi>α</mi><mi>j</mi></msub></mrow><mo>=</mo><msub><mi>δ</mi><mi>j</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">I_{j}=[\alpha_{j},\beta_{j}]\subset[0,1],\qquad\text{length}(I_{j})=\beta_{j}-\alpha_{j}=\delta_{j},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS8.SSS2.Px1.p11" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p11.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p11.1.1" class="ltx_text">such that the family <math id="A2.SS8.SSS2.Px1.p11.m1" class="ltx_Math" alttext="\{I_{j}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>I</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{I_{j}\}</annotation></semantics></math> is **pairwise disjoint**. (Because <math id="A2.SS8.SSS2.Px1.p11.m2" class="ltx_Math" alttext="\delta_{j}\to 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>j</mi></msub><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{j}\to 0</annotation></semantics></math>, this is possible, and the union <math id="A2.SS8.SSS2.Px1.p11.m3" class="ltx_Math" alttext="\bigcup_{j}I_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mo>⋃</mo><mi>j</mi></msub><msub><mi>I</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\bigcup_{j}I_{j}</annotation></semantics></math> is dense in <math id="A2.SS8.SSS2.Px1.p11.m4" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>.)</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p12" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p12.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p12.1.1" class="ltx_text">2. **Define balanced bumps supported in <math id="A2.SS8.SSS2.Px1.p12.m1" class="ltx_Math" alttext="I_{j}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>j</mi></msub><annotation encoding="application/x-tex">I_{j}</annotation></semantics></math>.**
For each <math id="A2.SS8.SSS2.Px1.p12.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, choose a continuous function <math id="A2.SS8.SSS2.Px1.p12.m3" class="ltx_Math" alttext="\psi_{j}:[0,1]\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>j</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\psi_{j}:[0,1]\to\mathbb{R}</annotation></semantics></math> with:</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p13" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p13.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p13.1.1" class="ltx_text">* <math id="A2.SS8.SSS2.Px1.p13.m1" class="ltx_Math" alttext="\operatorname{supp}(\psi_{j})\subset I_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>supp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ψ</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⊂</mo><msub><mi>I</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\operatorname{supp}(\psi_{j})\subset I_{j}</annotation></semantics></math>,
* <math id="A2.SS8.SSS2.Px1.p13.m2" class="ltx_Math" alttext="\int_{I_{j}}\psi_{j}(x)\,dx=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∫</mo><msub><mi>I</mi><mi>j</mi></msub></msub><mrow><msub><mi>ψ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\int_{I_{j}}\psi_{j}(x)\,dx=0</annotation></semantics></math>,
* <math id="A2.SS8.SSS2.Px1.p13.m3" class="ltx_Math" alttext="\psi_{j}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>j</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\psi_{j}&gt;0</annotation></semantics></math> on the left half of <math id="A2.SS8.SSS2.Px1.p13.m4" class="ltx_Math" alttext="I_{j}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>j</mi></msub><annotation encoding="application/x-tex">I_{j}</annotation></semantics></math> and <math id="A2.SS8.SSS2.Px1.p13.m5" class="ltx_Math" alttext="\psi_{j}&lt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>j</mi></msub><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\psi_{j}&lt;0</annotation></semantics></math> on the right half of <math id="A2.SS8.SSS2.Px1.p13.m6" class="ltx_Math" alttext="I_{j}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>j</mi></msub><annotation encoding="application/x-tex">I_{j}</annotation></semantics></math> (so <math id="A2.SS8.SSS2.Px1.p13.m7" class="ltx_Math" alttext="\psi_{j}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\psi_{j}</annotation></semantics></math> attains both signs on <math id="A2.SS8.SSS2.Px1.p13.m8" class="ltx_Math" alttext="I_{j}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>j</mi></msub><annotation encoding="application/x-tex">I_{j}</annotation></semantics></math>),
* <math id="A2.SS8.SSS2.Px1.p13.m9" class="ltx_Math" alttext="\|\psi_{j}\|_{\infty}\leq 1" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ψ</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\|\psi_{j}\|_{\infty}\leq 1</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p14" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p14.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p14.1.1" class="ltx_text">(For instance, take a small “hat” on the left half and the negative of the same hat on the right half, then smooth at the center.)</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p15" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p15.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p15.1.1" class="ltx_text">3. **Randomize signs and make the series converge uniformly.**
Let <math id="A2.SS8.SSS2.Px1.p15.m1" class="ltx_Math" alttext="(\varepsilon_{j})_{j\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>ε</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">(\varepsilon_{j})_{j\geq 1}</annotation></semantics></math> be i.i.d. Rademacher signs (<math id="A2.SS8.SSS2.Px1.p15.m2" class="ltx_Math" alttext="\mathbb{P}(\varepsilon_{j}=\pm 1)=1/2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ε</mi><mi>j</mi></msub><mo>=</mo><mrow><mo>±</mo><mn>1</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\varepsilon_{j}=\pm 1)=1/2</annotation></semantics></math>), independent of everything else.
Choose a summable coefficient sequence <math id="A2.SS8.SSS2.Px1.p15.m3" class="ltx_Math" alttext="a_{j}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>j</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a_{j}&gt;0</annotation></semantics></math> with <math id="A2.SS8.SSS2.Px1.p15.m4" class="ltx_Math" alttext="\sum_{j}a_{j}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>j</mi></msub><msub><mi>a</mi><mi>j</mi></msub></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{j}a_{j}&lt;\infty</annotation></semantics></math> (e.g. <math id="A2.SS8.SSS2.Px1.p15.m5" class="ltx_Math" alttext="a_{j}=2^{-j}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>j</mi></msub><mo>=</mo><msup><mn>2</mn><mrow><mo>−</mo><mi>j</mi></mrow></msup></mrow><annotation encoding="application/x-tex">a_{j}=2^{-j}</annotation></semantics></math>).
Define</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p16" class="ltx_para">
<table id="A2.Ex238" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex238.m1" class="ltx_Math" alttext="f(x)=\sum_{j=1}^{\infty}\varepsilon_{j}\,a_{j}\,\psi_{j}(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><mrow><msub><mi>ε</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f(x)=\sum_{j=1}^{\infty}\varepsilon_{j}\,a_{j}\,\psi_{j}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS8.SSS2.Px1.p17" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p17.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p17.1.1" class="ltx_text">Since <math id="A2.SS8.SSS2.Px1.p17.m1" class="ltx_Math" alttext="\sum_{j}a_{j}\|\psi_{j}\|_{\infty}&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>j</mi></msub><mrow><msub><mi>a</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>ψ</mi><mi>j</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\sum_{j}a_{j}\|\psi_{j}\|_{\infty}&lt;\infty</annotation></semantics></math>, the series converges **uniformly**, hence <math id="A2.SS8.SSS2.Px1.p17.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is continuous.</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p18" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p18.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p18.1.1" class="ltx_text">4. **Define the random measurable set**</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p19" class="ltx_para">
<table id="A2.Ex239" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex239.m1" class="ltx_Math" alttext="A:=\{x\in[0,1]:f(x)&gt;0\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>:=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">A:=\{x\in[0,1]:f(x)&gt;0\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS8.SSS2.Px1.p20" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p20.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p20.1.1" class="ltx_text">Verification</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p21" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p21.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p21.1.1" class="ltx_text">* Fix any nondegenerate subinterval <math id="A2.SS8.SSS2.Px1.p21.m1" class="ltx_Math" alttext="I\subset[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⊂</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">I\subset[0,1]</annotation></semantics></math>. Because <math id="A2.SS8.SSS2.Px1.p21.m2" class="ltx_Math" alttext="\bigcup_{j}I_{j}" display="inline" intent=":literal"><semantics><mrow><msub><mo>⋃</mo><mi>j</mi></msub><msub><mi>I</mi><mi>j</mi></msub></mrow><annotation encoding="application/x-tex">\bigcup_{j}I_{j}</annotation></semantics></math> is dense, there exists some <math id="A2.SS8.SSS2.Px1.p21.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> with <math id="A2.SS8.SSS2.Px1.p21.m4" class="ltx_Math" alttext="I_{j}\subset I" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>j</mi></msub><mo>⊂</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">I_{j}\subset I</annotation></semantics></math>.
On <math id="A2.SS8.SSS2.Px1.p21.m5" class="ltx_Math" alttext="I_{j}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>j</mi></msub><annotation encoding="application/x-tex">I_{j}</annotation></semantics></math> we have</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p22" class="ltx_para">
<table id="A2.Ex240" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex240.m1" class="ltx_Math" alttext="f=\varepsilon_{j}a_{j}\psi_{j}\quad\text{(since the bumps are supported on disjoint intervals),}" display="block" intent=":literal"><semantics><mrow><mrow><mi>f</mi><mo>=</mo><mrow><msub><mi>ε</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>a</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ψ</mi><mi>j</mi></msub></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>(since the bumps are supported on disjoint intervals),</mtext></mrow><annotation encoding="application/x-tex">f=\varepsilon_{j}a_{j}\psi_{j}\quad\text{(since the bumps are supported on disjoint intervals),}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS8.SSS2.Px1.p23" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p23.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p23.1.1" class="ltx_text">so <math id="A2.SS8.SSS2.Px1.p23.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> takes both positive and negative values on <math id="A2.SS8.SSS2.Px1.p23.m2" class="ltx_Math" alttext="I_{j}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>j</mi></msub><annotation encoding="application/x-tex">I_{j}</annotation></semantics></math> (because <math id="A2.SS8.SSS2.Px1.p23.m3" class="ltx_Math" alttext="\psi_{j}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\psi_{j}</annotation></semantics></math> does). Hence <math id="A2.SS8.SSS2.Px1.p23.m4" class="ltx_math_unparsed" alttext="\{f&gt;0\}\cap I" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi>f</mi><mo>&gt;</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo>∩</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">\{f&gt;0\}\cap I</annotation></semantics></math> and <math id="A2.SS8.SSS2.Px1.p23.m5" class="ltx_math_unparsed" alttext="\{f&lt;0\}\cap I" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><mi>f</mi><mo>&lt;</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo>∩</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">\{f&lt;0\}\cap I</annotation></semantics></math> are **nonempty open** subsets of <math id="A2.SS8.SSS2.Px1.p23.m6" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>, and therefore</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p24" class="ltx_para">
<table id="A2.Ex241" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex241.m1" class="ltx_Math" alttext="0&lt;\mu(A\cap I)&lt;\mu(I)." display="block" intent=":literal"><semantics><mrow><mrow><mn>0</mn><mo>&lt;</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo>∩</mo><mi>I</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">0&lt;\mu(A\cap I)&lt;\mu(I).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS8.SSS2.Px1.p25" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p25.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p25.1.1" class="ltx_text">* This holds for **every** interval <math id="A2.SS8.SSS2.Px1.p25.m1" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>, not just rational ones, because every interval contains some <math id="A2.SS8.SSS2.Px1.p25.m2" class="ltx_Math" alttext="I_{j}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>j</mi></msub><annotation encoding="application/x-tex">I_{j}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p26" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p26.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p26.1.1" class="ltx_text">* The randomness (the <math id="A2.SS8.SSS2.Px1.p26.m1" class="ltx_Math" alttext="\varepsilon_{j}" display="inline" intent=":literal"><semantics><msub><mi>ε</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\varepsilon_{j}</annotation></semantics></math>’s) is only to emphasize the *probabilistic* nature; the property in fact holds for **every** choice of signs since each <math id="A2.SS8.SSS2.Px1.p26.m2" class="ltx_Math" alttext="\psi_{j}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\psi_{j}</annotation></semantics></math> already changes sign on <math id="A2.SS8.SSS2.Px1.p26.m3" class="ltx_Math" alttext="I_{j}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>j</mi></msub><annotation encoding="application/x-tex">I_{j}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p27" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p27.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p27.1.1" class="ltx_text">Remarks</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p28" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p28.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p28.1.1" class="ltx_text">* This gives an explicit **probabilistic** family of well-distributed sets <math id="A2.SS8.SSS2.Px1.p28.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> (in Rudin’s sense).
* You can tune <math id="A2.SS8.SSS2.Px1.p28.m2" class="ltx_Math" alttext="\mu(A)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu(A)</annotation></semantics></math> by adding a small constant <math id="A2.SS8.SSS2.Px1.p28.m3" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> and using <math id="A2.SS8.SSS2.Px1.p28.m4" class="ltx_math_unparsed" alttext="A=\{f&gt;c\}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>f</mi><mo>&gt;</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A=\{f&gt;c\}</annotation></semantics></math>; because the <math id="A2.SS8.SSS2.Px1.p28.m5" class="ltx_Math" alttext="I_{j}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>j</mi></msub><annotation encoding="application/x-tex">I_{j}</annotation></semantics></math> are disjoint, the same argument works.
* If you prefer a “stationary-looking” version, you can replace the disjoint bumps by a uniformly convergent random trigonometric (or Haar) series with small coefficients and then take <math id="A2.SS8.SSS2.Px1.p28.m6" class="ltx_math_unparsed" alttext="A=\{f&gt;0\}" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>f</mi><mo>&gt;</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">A=\{f&gt;0\}</annotation></semantics></math>; the same “both signs in every interval” argument goes through once you arrange that on every small interval a single high-frequency term dominates the **variation** (not necessarily the value) of the lower-frequency part.</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p29" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p29.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p29.1.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS8.SSS2.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS8.SSS2.Px1.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS8.SSS2.Px1.p30" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p30.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p30.1.1" class="ltx_text">Let <math id="A2.SS8.SSS2.Px1.p30.m1" class="ltx_Math" alttext="X_{1},X_{2},\ldots" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mn>1</mn></msub><mo>,</mo><msub><mi>X</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">X_{1},X_{2},\ldots</annotation></semantics></math> be i.i.d. coin flips, i.e. <math id="A2.SS8.SSS2.Px1.p30.m2" class="ltx_Math" alttext="X_{1}" display="inline" intent=":literal"><semantics><msub><mi>X</mi><mn>1</mn></msub><annotation encoding="application/x-tex">X_{1}</annotation></semantics></math> is 1 with probability <math id="A2.SS8.SSS2.Px1.p30.m3" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math> and -1 with probability <math id="A2.SS8.SSS2.Px1.p30.m4" class="ltx_Math" alttext="1/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1/2</annotation></semantics></math>. Consider the (random) series</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p31" class="ltx_para">
<table id="A2.Ex242" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex242.m1" class="ltx_Math" alttext="S:=\sum_{n=1}^{\infty}X_{n}/n." display="block" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo rspace="0.111em">:=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mi mathvariant="normal">∞</mi></munderover><msub><mi>X</mi><mi>n</mi></msub></mrow><mo>/</mo><mi>n</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S:=\sum_{n=1}^{\infty}X_{n}/n.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS8.SSS2.Px1.p32" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p32.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p32.1.1" class="ltx_text">By the Kolmogorov three-series theorem, it converges almost surely. However, it’s a simple exercise to see that for any <math id="A2.SS8.SSS2.Px1.p32.m1" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>, the event <math id="A2.SS8.SSS2.Px1.p32.m2" class="ltx_math_unparsed" alttext="\{S&gt;a\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>S</mi><mo>&gt;</mo><mi>a</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{S&gt;a\}</annotation></semantics></math> has non-trivial measure: for <math id="A2.SS8.SSS2.Px1.p32.m3" class="ltx_Math" alttext="a&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a&gt;0</annotation></semantics></math>, there’s a positive chance of the first <math id="A2.SS8.SSS2.Px1.p32.m4" class="ltx_Math" alttext="e^{a}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mi>a</mi></msup><annotation encoding="application/x-tex">e^{a}</annotation></semantics></math> terms of the series being positive, so the <math id="A2.SS8.SSS2.Px1.p32.m5" class="ltx_Math" alttext="e^{a}" display="inline" intent=":literal"><semantics><msup><mi>e</mi><mi>a</mi></msup><annotation encoding="application/x-tex">e^{a}</annotation></semantics></math>-th partial sum is positive, and the tail is independent and positive or negative with equal probability, due to symmetry. For <math id="A2.SS8.SSS2.Px1.p32.m6" class="ltx_Math" alttext="a\leq 0" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a\leq 0</annotation></semantics></math>, it’s trivial, again because of symmetry.</span></p>
</div>
<div id="A2.SS8.SSS2.Px1.p33" class="ltx_para">
<p id="A2.SS8.SSS2.Px1.p33.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p33.1.1" class="ltx_text">A common way of realizing i.i.d. coin flips on the unit interval is as Rademacher functions: for <math id="A2.SS8.SSS2.Px1.p33.m1" class="ltx_Math" alttext="x\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">x\in[0,1]</annotation></semantics></math>, let <math id="A2.SS8.SSS2.Px1.p33.m2" class="ltx_Math" alttext="b_{n}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>n</mi></msub><annotation encoding="application/x-tex">b_{n}</annotation></semantics></math> be its binary expansion, and <math id="A2.SS8.SSS2.Px1.p33.m3" class="ltx_Math" alttext="X_{n}(x)=(-1)^{b_{n}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>X</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><msub><mi>b</mi><mi>n</mi></msub></msup></mrow><annotation encoding="application/x-tex">X_{n}(x)=(-1)^{b_{n}}</annotation></semantics></math>. Realized this way, the random sum <math id="A2.SS8.SSS2.Px1.p33.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> becomes an almost everywhere finite measurable function from <math id="A2.SS8.SSS2.Px1.p33.m5" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math> to <math id="A2.SS8.SSS2.Px1.p33.m6" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math>. It only takes a bit more work to see that the set <math id="A2.SS8.SSS2.Px1.p33.m7" class="ltx_math_unparsed" alttext="\{S&gt;a\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>S</mi><mo>&gt;</mo><mi>a</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{S&gt;a\}</annotation></semantics></math> is exactly a well-distributed set.
∎</span></p>
</div>
</div>
<div id="A2.SS8.SSS2.Px1.p34" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS8.SSS2.Px1.p34.pic1" class="ltx_picture" height="120.05" overflow="visible" version="1.1" viewBox="0 0 429.64 120.05" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,120.05) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 115.42 C 0 117.98 2.07 120.05 4.63 120.05 L 425.01 120.05 C 427.56 120.05 429.64 117.98 429.64 115.42 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 101.19 L 428.94 101.19 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 105.81)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS8.SSS2.Px1.p34.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS8.SSS2.Px1.p34.pic1.1.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p34.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Rubric</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:5.36em;--ltx-fo-depth:0.2em;font-size:10pt;" height="76.87" overflow="visible" transform="matrix(1 0 0 -1 0 74.11)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS8.SSS2.Px1.p34.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS8.SSS2.Px1.p34.pic1.2.1" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p34.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Award 2 points if the solution provides a valid probabilistic construction of a measurable set <math id="A2.SS8.SSS2.Px1.p34.pic1.m1" class="ltx_Math" alttext="A\subset[0,1]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊂</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">A\subset[0,1]</annotation></semantics></math> satisfying both conditions:</span></span>
<span id="A2.SS8.SSS2.Px1.p34.pic1.2.2" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p34.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">1. <math id="A2.SS8.SSS2.Px1.p34.pic1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is measurable.</span></span>
<span id="A2.SS8.SSS2.Px1.p34.pic1.2.3" class="ltx_p"><span id="A2.SS8.SSS2.Px1.p34.pic1.2.3.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">2. For every subinterval <math id="A2.SS8.SSS2.Px1.p34.pic1.m3" class="ltx_Math" alttext="I\subset[0,1]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">I</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊂</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">I\subset[0,1]</annotation></semantics></math>,</span></span>
<span id="A2.Ex243" class="ltx_equation ltx_eqn_table">

<span><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex243.m1" class="ltx_Math" alttext="0&lt;\mu(A\cap I)&lt;\mu(I)." display="block" intent=":literal"><semantics><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">&lt;</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">μ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">A</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">∩</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">I</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">&lt;</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">μ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathsize="0.800em">I</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" mathsize="0.800em">.</mo></mrow><annotation encoding="application/x-tex">0&lt;\mu(A\cap I)&lt;\mu(I).</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
