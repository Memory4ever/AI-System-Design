</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS3.SSS2.Px1.p37" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS3.SSS2.Px1.p37.pic1" class="ltx_picture" height="68.09" overflow="visible" version="1.1" viewBox="0 0 429.64 68.09" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,68.09) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 63.46 C 0 66.01 2.07 68.09 4.63 68.09 L 425.01 68.09 C 427.56 68.09 429.64 66.01 429.64 63.46 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 49.22 L 428.94 49.22 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 53.85)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
