</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px1.p13.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS7.SSS1.Px1.p13.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p13.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">1/2</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS7.SSS1.Px1.p14" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS1.Px1.p14.pic1" class="ltx_picture" height="69.62" overflow="visible" version="1.1" viewBox="0 0 429.64 69.62" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,69.62) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 65 C 0 67.55 2.07 69.62 4.63 69.62 L 425.01 69.62 C 427.56 69.62 429.64 67.55 429.64 65 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 50.76 L 428.94 50.76 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 55.39)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px1.p14.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS7.SSS1.Px1.p14.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p14.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:1.76em;--ltx-fo-depth:0.16em;font-size:10pt;" height="26.44" overflow="visible" transform="matrix(1 0 0 -1 0 24.29)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px1.p14.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS7.SSS1.Px1.p14.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS1.Px1.p14.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The proof idea is correct. However, one may not be able to do all compressions simultaneously.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="A2.SS7.SSS1.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#FF0000;">Problem 7a2</h5>

<div id="A2.SS7.SSS1.Px2.p1" class="ltx_para">
<p id="A2.SS7.SSS1.Px2.p1.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS7.SSS1.Px2.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS1.Px2.p2.pic1" class="ltx_picture" height="324.69" overflow="visible" version="1.1" viewBox="0 0 429.64 324.69" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,324.69) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 320.06 C 0 322.62 2.07 324.69 4.63 324.69 L 425.01 324.69 C 427.56 324.69 429.64 322.62 429.64 320.06 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 305.82 L 428.94 305.82 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 310.45)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px2.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS7.SSS1.Px2.p2.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:20.19em;--ltx-fo-depth:0.16em;font-size:10pt;" height="281.51" overflow="visible" transform="matrix(1 0 0 -1 0 279.36)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.SS7.SSS1.Px2.p2.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS7.SSS1.Px2.p2.pic1.p1" class="ltx_para">
<span id="A2.SS7.SSS1.Px2.p2.pic1.p1.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p2.pic1.p1.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Among the 9 bands shown, which ones can be continuously deformed to another in the 3-space, without crossing itself?</span></span>
</span>
<span id="A2.SS7.SSS1.Px2.p2.pic1.fig1" class="ltx_figure"><img src="2509.18122v1/bands.jpg" id="A2.SS7.SSS1.Px2.p2.pic1.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:194/207;" width="194" height="207" alt="[Uncaptioned image]">
</span>
<span id="A2.SS7.SSS1.Px2.p2.pic1.p2" class="ltx_para"><span class="ltx_inline-block"><svg id="A2.SS7.SSS1.Px2.p2.pic1.pic1" class="ltx_picture" color="#FF0000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 0 L 15.75 15.75 M 0 15.75 L 15.75 0"></path></g></svg></span>
<span id="A2.SS7.SSS1.Px2.p2.pic1.p2.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p2.pic1.p2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#FF0000;">GPT-5 thinking failed</span></span>
<span id="A2.SS7.SSS1.Px2.p2.pic1.p2.2" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p2.pic1.p2.2.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Qiuyu Ren</span></span>
</span></span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS7.SSS1.Px2.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS7.SSS1.Px2.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS7.SSS1.Px2.p3" class="ltx_para">
<p id="A2.SS7.SSS1.Px2.p3.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p3.1.1" class="ltx_text">We regard each picture as a narrow ribbon, whose type (up to deformation in <math id="A2.SS7.SSS1.Px2.p3.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>–space)
is determined by the knot type of its core (midline).</span></p>
</div>
<div id="A2.SS7.SSS1.Px2.p4" class="ltx_para">
<ul id="A2.I19" class="ltx_itemize">
<li id="A2.I19.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I19.i1.p1" class="ltx_para">
<p id="A2.I19.i1.p1.1" class="ltx_p"><span id="A2.I19.i1.p1.1.1" class="ltx_text ltx_font_bold">Unknots:</span>
The following bands are equivalent to the unknot:
top-left, top-middle, center, and bottom-right.</p>
</div></li>
<li id="A2.I19.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I19.i2.p1" class="ltx_para">
<p id="A2.I19.i2.p1.1" class="ltx_p"><span id="A2.I19.i2.p1.1.1" class="ltx_text ltx_font_bold">Figure-eight knots:</span>
The following bands are equivalent to the figure-eight knot:
top-right, middle-left, and bottom-middle.</p>
</div></li>
<li id="A2.I19.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I19.i3.p1" class="ltx_para">
<p id="A2.I19.i3.p1.1" class="ltx_p"><span id="A2.I19.i3.p1.1.1" class="ltx_text ltx_font_bold">Trefoils:</span>
The two remaining bands are trefoils, but of opposite chirality:
the middle-right is one trefoil chirality, while the bottom-left is its mirror.
These two are not deformable into each other in <math id="A2.I19.i3.p1.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>–space without reflection.</p>
</div></li>
</ul>
</div>
<div id="A2.SS7.SSS1.Px2.p5" class="ltx_para">
<p id="A2.SS7.SSS1.Px2.p5.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p5.1.1" class="ltx_text">Thus, the nine bands fall into three equivalence classes (unknots, figure-eights,
and trefoils), with the trefoils split into two distinct mirror-image classes.
∎</span></p>
</div>
</div>
<div id="A2.SS7.SSS1.Px2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS7.SSS1.Px2.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS7.SSS1.Px2.p6" class="ltx_para">
<p id="A2.SS7.SSS1.Px2.p6.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p6.1.1" class="ltx_text">Label the figures by <math id="A2.SS7.SSS1.Px2.p6.m1" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> to <math id="A2.SS7.SSS1.Px2.p6.m2" class="ltx_Math" alttext="9" display="inline" intent=":literal"><semantics><mn>9</mn><annotation encoding="application/x-tex">9</annotation></semantics></math>, from left to right, then from top to bottom. We claim that each of Figures <math id="A2.SS7.SSS1.Px2.p6.m3" class="ltx_Math" alttext="2,4,6,7,8,9" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>,</mo><mn>4</mn><mo>,</mo><mn>6</mn><mo>,</mo><mn>7</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">2,4,6,7,8,9</annotation></semantics></math> can be deformed to another figure, but each of Figures <math id="A2.SS7.SSS1.Px2.p6.m4" class="ltx_Math" alttext="1,3,5" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">1,3,5</annotation></semantics></math> cannot.</span></p>
</div>
<div id="A2.SS7.SSS1.Px2.p7" class="ltx_para">
<p id="A2.SS7.SSS1.Px2.p7.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p7.1.1" class="ltx_text">The band type of a band is determined by the type of the core knot together with the framing of the band (which takes value in <math id="A2.SS7.SSS1.Px2.p7.m1" class="ltx_Math" alttext="\tfrac{1}{2}\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">\tfrac{1}{2}\mathbb{Z}</annotation></semantics></math>). One can check that the cores of the bands have types:</span></p>
<ul id="A2.I20" class="ltx_itemize">
<li id="A2.I20.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I20.i1.p1" class="ltx_para">
<p id="A2.I20.i1.p1.1" class="ltx_p">Unknot: Figures <math id="A2.I20.i1.p1.m1" class="ltx_Math" alttext="1,2,5,7,8,9" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>5</mn><mo>,</mo><mn>7</mn><mo>,</mo><mn>8</mn><mo>,</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">1,2,5,7,8,9</annotation></semantics></math>;</p>
</div></li>
<li id="A2.I20.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I20.i2.p1" class="ltx_para">
<p id="A2.I20.i2.p1.1" class="ltx_p">Left-handed trefoil: Figure <math id="A2.I20.i2.p1.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math>;</p>
</div></li>
<li id="A2.I20.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I20.i3.p1" class="ltx_para">
<p id="A2.I20.i3.p1.1" class="ltx_p">Right-handed trefoil: Figures <math id="A2.I20.i3.p1.m1" class="ltx_Math" alttext="4,6" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo>,</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">4,6</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="A2.SS7.SSS1.Px2.p8" class="ltx_para">
<p id="A2.SS7.SSS1.Px2.p8.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p8.1.1" class="ltx_text">The two right-handed trefoil each has framing <math id="A2.SS7.SSS1.Px2.p8.m1" class="ltx_Math" alttext="+3" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">+3</annotation></semantics></math>, hence <math id="A2.SS7.SSS1.Px2.p8.m2" class="ltx_Math" alttext="\{4,6\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>4</mn><mo>,</mo><mn>6</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{4,6\}</annotation></semantics></math> forms an equivalence class.</span></p>
</div>
<div id="A2.SS7.SSS1.Px2.p9" class="ltx_para">
<p id="A2.SS7.SSS1.Px2.p9.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p9.1.1" class="ltx_text">The framings of the unknots are given by:</span></p>
<ul id="A2.I21" class="ltx_itemize">
<li id="A2.I21.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I21.i1.p1" class="ltx_para">
<p id="A2.I21.i1.p1.1" class="ltx_p"><math id="A2.I21.i1.p1.m1" class="ltx_math_unparsed" alttext="-1/2" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">-1/2</annotation></semantics></math>: Figures <math id="A2.I21.i1.p1.m2" class="ltx_Math" alttext="8,9" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo>,</mo><mn>9</mn></mrow><annotation encoding="application/x-tex">8,9</annotation></semantics></math>;</p>
</div></li>
<li id="A2.I21.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I21.i2.p1" class="ltx_para">
<p id="A2.I21.i2.p1.1" class="ltx_p"><math id="A2.I21.i2.p1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>: Figure <math id="A2.I21.i2.p1.m2" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math>;</p>
</div></li>
<li id="A2.I21.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I21.i3.p1" class="ltx_para">
<p id="A2.I21.i3.p1.1" class="ltx_p"><math id="A2.I21.i3.p1.m1" class="ltx_math_unparsed" alttext="+1/2" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">+1/2</annotation></semantics></math>: Figure <math id="A2.I21.i3.p1.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>;</p>
</div></li>
<li id="A2.I21.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I21.i4.p1" class="ltx_para">
<p id="A2.I21.i4.p1.1" class="ltx_p"><math id="A2.I21.i4.p1.m1" class="ltx_Math" alttext="+1" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">+1</annotation></semantics></math>: Figures <math id="A2.I21.i4.p1.m2" class="ltx_Math" alttext="2,7" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo>,</mo><mn>7</mn></mrow><annotation encoding="application/x-tex">2,7</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="A2.SS7.SSS1.Px2.p9.2" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p9.2.1" class="ltx_text">Hence <math id="A2.SS7.SSS1.Px2.p9.m1" class="ltx_Math" alttext="\{2,7\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>2</mn><mo>,</mo><mn>7</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{2,7\}</annotation></semantics></math> and <math id="A2.SS7.SSS1.Px2.p9.m2" class="ltx_Math" alttext="\{8,9\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>8</mn><mo>,</mo><mn>9</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{8,9\}</annotation></semantics></math> each form an equivalence class.</span></p>
</div>
<div id="A2.SS7.SSS1.Px2.p10" class="ltx_para">
<p id="A2.SS7.SSS1.Px2.p10.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p10.1.1" class="ltx_text">The rest singletons <math id="A2.SS7.SSS1.Px2.p10.m1" class="ltx_Math" alttext="1,3,5" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">1,3,5</annotation></semantics></math> each form an equivalence class.
∎</span></p>
</div>
</div>
<div id="A2.SS7.SSS1.Px2.p11" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS1.Px2.p11.pic1" class="ltx_picture" height="102.83" overflow="visible" version="1.1" viewBox="0 0 429.64 102.83" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,102.83) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 98.2 C 0 100.76 2.07 102.83 4.63 102.83 L 425.01 102.83 C 427.56 102.83 429.64 100.76 429.64 98.2 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 83.97 L 428.94 83.97 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 88.6)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px2.p11.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS7.SSS1.Px2.p11.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p11.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Rubric</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:4.16em;--ltx-fo-depth:0.16em;font-size:10pt;" height="59.65" overflow="visible" transform="matrix(1 0 0 -1 0 57.5)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px2.p11.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS7.SSS1.Px2.p11.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p11.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Total 3 points:
<br class="ltx_break">2 points for finding the three pairs of equivalent bands: <math id="A2.SS7.SSS1.Px2.p11.pic1.m1" class="ltx_Math" alttext="2,7" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn></mrow><annotation encoding="application/x-tex">2,7</annotation></semantics></math>; <math id="A2.SS7.SSS1.Px2.p11.pic1.m2" class="ltx_Math" alttext="4,6" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">6</mn></mrow><annotation encoding="application/x-tex">4,6</annotation></semantics></math>; <math id="A2.SS7.SSS1.Px2.p11.pic1.m3" class="ltx_Math" alttext="8,9" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">9</mn></mrow><annotation encoding="application/x-tex">8,9</annotation></semantics></math>. Get 1 point if the answer contains a single error.
<br class="ltx_break">1 point for the explanation that the there are no more equivalent pairs.
<br class="ltx_break"></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS7.SSS1.Px2.p12" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS1.Px2.p12.pic1" class="ltx_picture" height="54.13" overflow="visible" version="1.1" viewBox="0 0 429.64 54.13" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,54.13) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#5A996B;" fill="#5A996B" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 49.51 C 0 52.06 2.07 54.13 4.63 54.13 L 425.01 54.13 C 427.56 54.13 429.64 52.06 429.64 49.51 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F6FFF9;" fill="#F6FFF9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 35.38 L 428.94 35.38 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 40.01)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px2.p12.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS7.SSS1.Px2.p12.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p12.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Score</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 15.27)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:0.6em;--ltx-fo-depth:0.2em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px2.p12.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS7.SSS1.Px2.p12.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p12.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">0/3</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS7.SSS1.Px2.p13" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS1.Px2.p13.pic1" class="ltx_picture" height="69.62" overflow="visible" version="1.1" viewBox="0 0 429.64 69.62" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,69.62) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#B33674;" fill="#B33674" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 65 C 0 67.55 2.07 69.62 4.63 69.62 L 425.01 69.62 C 427.56 69.62 429.64 67.55 429.64 65 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFF2F9;" fill="#FFF2F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 50.76 L 428.94 50.76 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 55.39)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px2.p13.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS7.SSS1.Px2.p13.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p13.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Evaluation</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:33.06em;--ltx-fo-height:1.76em;--ltx-fo-depth:0.16em;font-size:10pt;" height="26.44" overflow="visible" transform="matrix(1 0 0 -1 0 24.29)" width="457.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS1.Px2.p13.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:33.06em;">
<span id="A2.SS7.SSS1.Px2.p13.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS1.Px2.p13.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">The type of the core knot does not determine the type of the whole band. Moreover, the core knot types are incorrectly identified for figures <math id="A2.SS7.SSS1.Px2.p13.pic1.m1" class="ltx_Math" alttext="3,4,7,8" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">4</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">7</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">8</mn></mrow><annotation encoding="application/x-tex">3,4,7,8</annotation></semantics></math>.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
</section>
<section id="A2.SS7.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">(b) </span>Performing plausibility checks</h4>

<section id="A2.SS7.SSS2.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph" style="--ltx-fg-color:#00E000;">Problem 7b1</h5>

<div id="A2.SS7.SSS2.Px1.p1" class="ltx_para">
<p id="A2.SS7.SSS2.Px1.p1.1" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p1.1.1" class="ltx_text"></span>
<br class="ltx_break" style="--ltx-break-space:-10.0pt;"></p>
</div>
<div id="A2.SS7.SSS2.Px1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS2.Px1.p2.pic1" class="ltx_picture" height="150.74" overflow="visible" version="1.1" viewBox="0 0 429.64 150.74" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,150.74) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#3D6666;" fill="#3D6666" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 146.12 C 0 148.67 2.07 150.74 4.63 150.74 L 425.01 150.74 C 427.56 150.74 429.64 148.67 429.64 146.12 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 131.88 L 428.94 131.88 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 136.51)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS2.Px1.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:24.44em;">
<span id="A2.SS7.SSS2.Px1.p2.pic1.1.1" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Problem</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 14.66)"><foreignObject style="--ltx-fo-width:32.01em;--ltx-fo-height:7.62em;--ltx-fo-depth:0.16em;font-size:10pt;" height="107.57" overflow="visible" transform="matrix(1 0 0 -1 0 105.41)" width="442.93"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS7.SSS2.Px1.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:32.01em;">
<span id="A2.SS7.SSS2.Px1.p2.pic1.2.1" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p2.pic1.2.1.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">Let <math id="A2.SS7.SSS2.Px1.p2.pic1.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> be a closed Riemannian aspherical <math id="A2.SS7.SSS2.Px1.p2.pic1.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-manifold, <math id="A2.SS7.SSS2.Px1.p2.pic1.m3" class="ltx_Math" alttext="n\geq 3" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow><annotation encoding="application/x-tex">n\geq 3</annotation></semantics></math>. Let <math id="A2.SS7.SSS2.Px1.p2.pic1.m4" class="ltx_Math" alttext="\mathrm{sys}(M)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">sys</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{sys}(M)</annotation></semantics></math> denote the length of the shortest nontrivial geodesic on <math id="A2.SS7.SSS2.Px1.p2.pic1.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, and <math id="A2.SS7.SSS2.Px1.p2.pic1.m6" class="ltx_Math" alttext="\mathrm{vol}(M)" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">vol</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{vol}(M)</annotation></semantics></math> denote the volume of <math id="A2.SS7.SSS2.Px1.p2.pic1.m7" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>. Is it true that <math id="A2.SS7.SSS2.Px1.p2.pic1.m8" class="ltx_Math" alttext="C\cdot\mathrm{sys}(M)^{n}\geq\mathrm{vol}(M)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">sys</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">vol</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C\cdot\mathrm{sys}(M)^{n}\geq\mathrm{vol}(M)</annotation></semantics></math> for some <math id="A2.SS7.SSS2.Px1.p2.pic1.m9" class="ltx_Math" alttext="C=C(n)&gt;0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&gt;</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow><annotation encoding="application/x-tex">C=C(n)&gt;0</annotation></semantics></math> independent of <math id="A2.SS7.SSS2.Px1.p2.pic1.m10" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>?</span></span><span class="ltx_inline-block"><svg id="A2.SS7.SSS2.Px1.p2.pic1.pic1" class="ltx_picture" color="#008000" height="18.24" overflow="visible" style="vertical-align:-4.1px" version="1.1" viewBox="0 0 18.24 18.24" width="18.24"><g style="--ltx-stroke-color:#009900;--ltx-fill-color:#009900;--ltx-fg-color:#009900;" color="#009900" fill="#009900" stroke="#009900" stroke-width="1.8pt" transform="translate(0,18.24) matrix(1 0 0 -1 0 0) translate(1.25,0) translate(0,1.25)"><path style="fill:none" d="M 0 7.87 L 5.51 0 L 15.75 15.75"></path></g></svg></span>
<span id="A2.SS7.SSS2.Px1.p2.pic1.2.2" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p2.pic1.2.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#008000;">GPT-5 thinking passed</span></span>
<span id="A2.SS7.SSS2.Px1.p2.pic1.2.3" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p2.pic1.2.3.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-fg-color:#000000;">Proposed by Qiuyu Ren</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A2.SS7.SSS2.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS7.SSS2.Px1.1.1" class="ltx_text ltx_font_bold">Response of GPT-5-thinking</span>.</h6>
<div id="A2.SS7.SSS2.Px1.p3" class="ltx_para">
<p id="A2.SS7.SSS2.Px1.p3.1" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p3.1.1" class="ltx_text">Let <math id="A2.SS7.SSS2.Px1.p3.m1" class="ltx_Math" alttext="T^{n}=\prod_{i=1}^{n}S^{1}_{\ell_{i}}" display="inline" intent=":literal"><semantics><mrow><msup><mi>T</mi><mi>n</mi></msup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msubsup><mi>S</mi><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><mn>1</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">T^{n}=\prod_{i=1}^{n}S^{1}_{\ell_{i}}</annotation></semantics></math> be the flat <math id="A2.SS7.SSS2.Px1.p3.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-torus equipped with the product metric, where the <math id="A2.SS7.SSS2.Px1.p3.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th circle has length <math id="A2.SS7.SSS2.Px1.p3.m4" class="ltx_Math" alttext="\ell_{i}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\ell_{i}</annotation></semantics></math>. The shortest nontrivial closed geodesics are the coordinate circles, hence</span></p>
<table id="A2.Ex192" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex192.m1" class="ltx_Math" alttext="\operatorname{sys}(T^{n})=\min_{i}\ell_{i},\qquad\operatorname{vol}(T^{n})=\prod_{i=1}^{n}\ell_{i}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>sys</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><munder><mi>min</mi><mi>i</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>vol</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∏</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msub><mi mathvariant="normal">ℓ</mi><mi>i</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{sys}(T^{n})=\min_{i}\ell_{i},\qquad\operatorname{vol}(T^{n})=\prod_{i=1}^{n}\ell_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS7.SSS2.Px1.p3.2" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p3.2.1" class="ltx_text">Fix <math id="A2.SS7.SSS2.Px1.p3.m5" class="ltx_Math" alttext="\ell_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\ell_{1}=1</annotation></semantics></math> and set <math id="A2.SS7.SSS2.Px1.p3.m6" class="ltx_Math" alttext="\ell_{2}=\cdots=\ell_{n}=N" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">ℓ</mi><mn>2</mn></msub><mo rspace="0.1389em">=</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">=</mo><msub><mi mathvariant="normal">ℓ</mi><mi>n</mi></msub><mo>=</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">\ell_{2}=\cdots=\ell_{n}=N</annotation></semantics></math>. Then</span></p>
<table id="A2.Ex193" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex193.m1" class="ltx_math_unparsed" alttext="\operatorname{sys}(T^{n})=1,\qquad\operatorname{vol}(T^{n})=N^{n-1}\to\infty\quad\text{as}\quad N\to\infty." display="block" intent=":literal"><semantics><mrow><mi>sys</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>1</mn><mo rspace="2.167em">,</mo><mi>vol</mi><mrow><mo stretchy="false">(</mo><msup><mi>T</mi><mi>n</mi></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>N</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi><mtext>as</mtext><mi>N</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\operatorname{sys}(T^{n})=1,\qquad\operatorname{vol}(T^{n})=N^{n-1}\to\infty\quad\text{as}\quad N\to\infty.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS7.SSS2.Px1.p3.3" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p3.3.1" class="ltx_text">Therefore, there is no constant <math id="A2.SS7.SSS2.Px1.p3.m7" class="ltx_Math" alttext="C(n)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C(n)&gt;0</annotation></semantics></math> such that</span></p>
<table id="A2.Ex194" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex194.m1" class="ltx_Math" alttext="C(n)\cdot\operatorname{sys}(M)^{n}\;\geq\;\operatorname{vol}(M)" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>sys</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow><mo rspace="0.558em">≥</mo><mrow><mi>vol</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C(n)\cdot\operatorname{sys}(M)^{n}\;\geq\;\operatorname{vol}(M)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS7.SSS2.Px1.p3.4" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p3.4.1" class="ltx_text">for all closed aspherical <math id="A2.SS7.SSS2.Px1.p3.m8" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>-manifolds <math id="A2.SS7.SSS2.Px1.p3.m9" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> (indeed, the inequality already fails for <math id="A2.SS7.SSS2.Px1.p3.m10" class="ltx_Math" alttext="T^{n}" display="inline" intent=":literal"><semantics><msup><mi>T</mi><mi>n</mi></msup><annotation encoding="application/x-tex">T^{n}</annotation></semantics></math>).</span></p>
</div>
<div id="A2.SS7.SSS2.Px1.p4" class="ltx_para">
<p id="A2.SS7.SSS2.Px1.p4.1" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p4.1.1" class="ltx_text">For context, what <em id="A2.SS7.SSS2.Px1.p4.1.1.1" class="ltx_emph ltx_font_italic">does</em> hold for aspherical (more generally, essential) manifolds is the opposite inequality of Gromov: there exists <math id="A2.SS7.SSS2.Px1.p4.m1" class="ltx_Math" alttext="c(n)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(n)&gt;0</annotation></semantics></math> such that</span></p>
<table id="A2.Ex195" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex195.m1" class="ltx_Math" alttext="\operatorname{vol}(M)\;\geq\;c(n)\cdot\operatorname{sys}(M)^{n}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>vol</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">≥</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>sys</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\operatorname{vol}(M)\;\geq\;c(n)\cdot\operatorname{sys}(M)^{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS7.SSS2.Px1.p4.2" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p4.2.1" class="ltx_text">but there is no universal upper bound of <math id="A2.SS7.SSS2.Px1.p4.m2" class="ltx_Math" alttext="\operatorname{vol}(M)" display="inline" intent=":literal"><semantics><mrow><mi>vol</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{vol}(M)</annotation></semantics></math> in terms of <math id="A2.SS7.SSS2.Px1.p4.m3" class="ltx_Math" alttext="\operatorname{sys}(M)^{n}" display="inline" intent=":literal"><semantics><mrow><mi>sys</mi><mo>⁡</mo><msup><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">\operatorname{sys}(M)^{n}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A2.SS7.SSS2.Px1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS7.SSS2.Px1.2.1" class="ltx_text ltx_font_bold">Standard Solution</span>.</h6>
<div id="A2.SS7.SSS2.Px1.p5" class="ltx_para">
<p id="A2.SS7.SSS2.Px1.p5.1" class="ltx_p"><span id="A2.SS7.SSS2.Px1.p5.1.1" class="ltx_text">No. One can blow up the Riemannian metric away from the shortest geodesic to make <math id="A2.SS7.SSS2.Px1.p5.m1" class="ltx_Math" alttext="\mathrm{vol}(M)" display="inline" intent=":literal"><semantics><mrow><mi>vol</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{vol}(M)</annotation></semantics></math> arbitrarily large while keeping <math id="A2.SS7.SSS2.Px1.p5.m2" class="ltx_Math" alttext="\mathrm{sys}(M)" display="inline" intent=":literal"><semantics><mrow><mi>sys</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{sys}(M)</annotation></semantics></math> non-increased.
∎</span></p>
</div>
</div>
<div id="A2.SS7.SSS2.Px1.p6" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS7.SSS2.Px1.p6.pic1" class="ltx_picture" height="53.02" overflow="visible" version="1.1" viewBox="0 0 429.64 53.02" width="429.64"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,53.02) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#4D4D4D;" fill="#4D4D4D" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 48.39 C 0 50.95 2.07 53.02 4.63 53.02 L 425.01 53.02 C 427.56 53.02 429.64 50.95 429.64 48.39 L 429.64 4.63 C 429.64 2.07 427.56 0 425.01 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 34.15 L 428.94 34.15 L 428.94 4.63 C 428.94 2.45 427.18 0.69 425.01 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.38 38.78)"><foreignObject style="--ltx-fo-width:24.44em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="338.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
