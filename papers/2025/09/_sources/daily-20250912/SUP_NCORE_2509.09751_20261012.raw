<th id="A1.T6.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T6.2.1.1.4.1" class="ltx_text ltx_font_bold">Relevance</span></th>
<th id="A1.T6.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T6.2.1.1.5.1" class="ltx_text ltx_font_bold">Avg. Score</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T6.2.1.2" class="ltx_tr">
