<td id="S4.T1.4.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Training set</span></td>
<td id="S4.T1.4.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.1.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Test set</span></td></tr>
