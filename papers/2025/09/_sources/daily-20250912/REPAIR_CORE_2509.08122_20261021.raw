<td id="S4.T1.4.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 4.0pt;"><span id="S4.T1.4.2.3.1" class="ltx_text" style="font-size:80%;">67,801</span></td></tr>
