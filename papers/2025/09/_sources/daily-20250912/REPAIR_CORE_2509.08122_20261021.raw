<td id="S5.T7.2.6.3" class="ltx_td ltx_align_center ltx_border_b" style="padding:0.45pt 4.0pt;"><span id="S5.T7.2.6.3.1" class="ltx_text" style="font-size:80%;">22.298</span></td>
<td id="S5.T7.2.6.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding:0.45pt 4.0pt;"><span id="S5.T7.2.6.4.1" class="ltx_text" style="font-size:80%;">20.259</span></td></tr>
