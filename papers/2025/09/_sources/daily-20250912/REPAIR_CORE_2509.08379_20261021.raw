             <math id="alg3.l1.m1" class="ltx_Math" alttext="\bm{\mathbf{s}}\leftarrow\mathsf{SpeakerEncoder}(\bm{\mathbf{x}}_{\rm ref})" display="inline" intent=":literal"><semantics><mrow><mi>𝐬</mi><mo stretchy="false">←</mo><mrow><mi>𝖲𝗉𝖾𝖺𝗄𝖾𝗋𝖤𝗇𝖼𝗈𝖽𝖾𝗋</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>ref</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\mathbf{s}}\leftarrow\mathsf{SpeakerEncoder}(\bm{\mathbf{x}}_{\rm ref})</annotation></semantics></math>

