             Draw <math id="alg3.l3.m1" class="ltx_Math" alttext="\bm{\mathbf{\epsilon}}\sim\mathcal{N}(\bm{\mathbf{0}},\bm{\mathbf{I}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϵ</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>𝟎</mn><mo>,</mo><mi>𝐈</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\mathbf{\epsilon}}\sim\mathcal{N}(\bm{\mathbf{0}},\bm{\mathbf{I}})</annotation></semantics></math>

