<section id="S4.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS6.4" class="ltx_text">IV-F</span> </span><span id="S4.SS6.5" class="ltx_text ltx_font_italic">Impact of Adversarial Training in LatentVoiceGrad</span></h3>

<figure id="S4.T4" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">TABLE IV: </span>Baseline Comparison</figcaption>
<table id="S4.T4.1" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T4.1.1" class="ltx_tr">
<th id="S4.T4.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" colspan="4"><span class="ltx_rule" style="width:100%;height:1.2pt;--ltx-bg-color:black;display:inline-block;"> </span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T4.1.2" class="ltx_tr">
<th id="S4.T4.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T4.1.2.1.1" class="ltx_text ltx_font_bold">Method</span></th>
