</div>
<div id="alg1.l8" class="ltx_listingline">
              
             <span id="alg1.l8.1" class="ltx_text ltx_font_bold">return</span>  <math id="alg1.l8.m1" class="ltx_Math" alttext="\bm{\mathbf{y}}" display="inline" intent=":literal"><semantics><mi>𝐲</mi><annotation encoding="application/x-tex">\bm{\mathbf{y}}</annotation></semantics></math>

