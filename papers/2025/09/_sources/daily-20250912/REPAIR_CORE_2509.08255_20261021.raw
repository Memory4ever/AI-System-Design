<td id="A4.T7.2.1.24.5" class="ltx_td ltx_align_center ltx_border_t">0.6053</td>
<td id="A4.T7.2.1.24.6" class="ltx_td ltx_align_center ltx_border_t">0.5223</td>
<td id="A4.T7.2.1.24.7" class="ltx_td ltx_align_center ltx_border_t">0.5864</td>
<td id="A4.T7.2.1.24.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.861</td>
<td id="A4.T7.2.1.24.9" class="ltx_td ltx_align_center ltx_border_t">0.7559</td>
<td id="A4.T7.2.1.24.10" class="ltx_td ltx_align_center ltx_border_t">0.7760</td>
<td id="A4.T7.2.1.24.11" class="ltx_td ltx_align_center ltx_border_t">0.6407</td>
<td id="A4.T7.2.1.24.12" class="ltx_td ltx_align_center ltx_border_t">0.7073</td>
<td id="A4.T7.2.1.24.13" class="ltx_td ltx_align_center ltx_border_t">0.7199</td>
<td id="A4.T7.2.1.24.14" class="ltx_td ltx_align_center ltx_border_t">0.851</td></tr>
<tr id="A4.T7.2.1.25" class="ltx_tr">
<td id="A4.T7.2.1.25.1" class="ltx_td ltx_align_center">Wanda</td>
<td id="A4.T7.2.1.25.2" class="ltx_td ltx_align_center">0.4705</td>
