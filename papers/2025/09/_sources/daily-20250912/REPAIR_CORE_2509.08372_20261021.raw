<th id="S5.T5.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_tt">FedAvg</th>
<td id="S5.T5.5.1.1.5" class="ltx_td ltx_align_center ltx_border_tt">FedProx</td>
<td id="S5.T5.5.1.1.6" class="ltx_td ltx_align_center ltx_border_tt">FedETF</td></tr>
<tr id="S5.T5.5.1.2" class="ltx_tr">
<th id="S5.T5.5.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">OH</th>
<td id="S5.T5.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">ResNet-50</td>
<td id="S5.T5.5.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Cl<math id="S5.T5.m1" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>Pr</td>
