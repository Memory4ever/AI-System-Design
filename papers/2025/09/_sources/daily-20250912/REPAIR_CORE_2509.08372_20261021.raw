<td id="S5.T5.5.1.25.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">–</td>
<th id="S5.T5.5.1.25.4" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">78.3</th>
<td id="S5.T5.5.1.25.5" class="ltx_td ltx_align_center ltx_border_bb">78.2</td>
