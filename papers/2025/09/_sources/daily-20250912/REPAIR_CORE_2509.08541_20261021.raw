<td id="S4.T4.2.1.17.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T4.2.1.17.7.1" class="ltx_text ltx_font_bold">48.58</span></td>
<td id="S4.T4.2.1.17.8" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T4.2.1.17.8.1" class="ltx_text ltx_font_bold">81.47</span></td>
<td id="S4.T4.2.1.17.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T4.2.1.17.9.1" class="ltx_text ltx_font_bold">62.41</span></td>
<td id="S4.T4.2.1.17.10" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T4.2.1.17.10.1" class="ltx_text ltx_font_bold">71.94</span></td>
<td id="S4.T4.2.1.17.11" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T4.2.1.17.11.1" class="ltx_text ltx_font_bold">55.26</span></td></tr>
