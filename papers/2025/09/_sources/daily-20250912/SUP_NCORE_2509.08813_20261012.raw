<td id="S6.T2.1.4.2" class="ltx_td ltx_align_center ltx_border_r"><math id="S6.T2.m7" class="ltx_Math" alttext="0.41" display="inline" intent=":literal"><semantics><mn>0.41</mn><annotation encoding="application/x-tex">0.41</annotation></semantics></math></td>
<td id="S6.T2.1.4.3" class="ltx_td ltx_align_center ltx_border_r"><math id="S6.T2.m8" class="ltx_Math" alttext="0.027" display="inline" intent=":literal"><semantics><mn>0.027</mn><annotation encoding="application/x-tex">0.027</annotation></semantics></math></td>
<td id="S6.T2.1.4.4" class="ltx_td ltx_align_center"><math id="S6.T2.m9" class="ltx_Math" alttext="13.67" display="inline" intent=":literal"><semantics><mn>13.67</mn><annotation encoding="application/x-tex">13.67</annotation></semantics></math></td></tr>
