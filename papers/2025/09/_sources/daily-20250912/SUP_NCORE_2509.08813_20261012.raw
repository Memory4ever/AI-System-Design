<td id="S6.T2.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S6.T2.m5" class="ltx_Math" alttext="0.091" display="inline" intent=":literal"><semantics><mn>0.091</mn><annotation encoding="application/x-tex">0.091</annotation></semantics></math></td>
