<div class="row-card">
  <div class="row-card__container">
    
    <div class="row-card__body">
        
          <a class="row-card__heading glue-link" href=https://research.google/pubs/turboslice-reusing-quantized-codes-for-fast-jl-style-search/ >
            
              TurboSlice: Reusing Quantized Codes for Fast JL-Style Search
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        <a class="row-card__small-link" href="/people/107587/">
                          Rajesh Jayaram
                        </a>
                      
                    </div>
                
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Lars Gottesbüren
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        Guy Blelloch
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
