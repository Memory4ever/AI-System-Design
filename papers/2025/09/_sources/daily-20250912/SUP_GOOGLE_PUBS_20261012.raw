                        <a class="row-card__small-link" href="/people/vinodkumarprabhakaran/">
                          Vinodkumar Prabhakaran
                        </a>
                      
                    </div>
                  
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
                        <a class="row-card__small-link" href="/people/remi-denton/">
                          Remi Denton
                        </a>
                      
                    </div>
                  
              
            
          
          
