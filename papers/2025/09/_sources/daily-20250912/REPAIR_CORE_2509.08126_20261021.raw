<tr id="S4.T2.6.3" class="ltx_tr">
<th id="S4.T2.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">LAVT <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib26" title="" class="ltx_ref">26</a>]</cite></th>
<th id="S4.T2.6.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">95.62</th>
<td id="S4.T2.6.3.3" class="ltx_td ltx_align_center ltx_border_r">85.83</td>
<td id="S4.T2.6.3.4" class="ltx_td ltx_align_center ltx_border_r">95.34</td>
