<td id="S4.T2.6.5.5" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T2.6.5.5.1" class="ltx_text ltx_font_bold">95.69</span></td>
<td id="S4.T2.6.5.6" class="ltx_td ltx_align_center">93.64</td></tr>
