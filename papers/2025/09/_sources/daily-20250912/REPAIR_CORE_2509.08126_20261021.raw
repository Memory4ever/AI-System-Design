<th id="S4.T2.6.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">93.67</th>
<td id="S4.T2.6.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">84.35</td>
<td id="S4.T2.6.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">92.85</td>
<td id="S4.T2.6.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">91.28</td>
