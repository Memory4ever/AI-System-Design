<span id="S4.T2.14.16.1.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S4.T2.14.16.1.1.1" class="ltx_p"><span id="S4.T2.14.16.1.1.1.1" class="ltx_text ltx_font_bold">Ours</span></span>
</span></td>
<td id="S4.T2.14.16.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding:2.5pt 4.0pt;">
<span id="S4.T2.14.16.2.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
<span id="S4.T2.14.16.2.1.1" class="ltx_p">AutoVeriFix with GPT-3.5</span>
</span></td>
<td id="S4.T2.14.16.3" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E0F7FA;padding:2.5pt 4.0pt;"><span id="S4.T2.14.16.3.1" class="ltx_text" style="--ltx-bg-color:#E0F7FA;">58.5</span></td>
<td id="S4.T2.14.16.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E0F7FA;padding:2.5pt 4.0pt;"><span id="S4.T2.14.16.4.1" class="ltx_text" style="--ltx-bg-color:#E0F7FA;">71.8</span></td>
<td id="S4.T2.14.16.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#E0F7FA;padding:2.5pt 4.0pt;"><span id="S4.T2.14.16.5.1" class="ltx_text" style="--ltx-bg-color:#E0F7FA;">73.7</span></td>
<td id="S4.T2.14.16.6" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E8F5E9;padding:2.5pt 4.0pt;"><span id="S4.T2.14.16.6.1" class="ltx_text" style="--ltx-bg-color:#E8F5E9;">69.5</span></td>
