<td id="S4.T2.14.4.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding:2.5pt 4.0pt;">
<span id="S4.T2.14.4.1.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
