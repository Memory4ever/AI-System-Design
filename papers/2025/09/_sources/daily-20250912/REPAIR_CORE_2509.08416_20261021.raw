<td id="S4.T2.14.14.9" class="ltx_td ltx_align_center ltx_border_r" style="--ltx-bg-color:#E8F5E9;padding:2.5pt 4.0pt;"><span id="S4.T2.14.14.9.1" class="ltx_text" style="--ltx-bg-color:#E8F5E9;">65.5</span></td>
<td id="S4.T2.14.14.10" class="ltx_td ltx_align_center" style="padding:2.5pt 4.0pt;">58.7</td></tr>
