<th id="S4.T2.4.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t"><span id="S4.T2.4.1.6.1.1" class="ltx_text ltx_font_bold">Environment Average</span></th>
