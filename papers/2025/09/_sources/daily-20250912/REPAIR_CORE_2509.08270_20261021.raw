<th id="S4.T3.4.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T3.4.1.1.3.1" class="ltx_text ltx_font_bold">Memory (GB)</span></th>
<th id="S4.T3.4.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T3.4.1.1.4.1" class="ltx_text ltx_font_bold">Perf./Efficiency</span></th>
<th id="S4.T3.4.1.1.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T3.4.1.1.5.1" class="ltx_text ltx_font_bold">Energy (Wh)</span></th></tr>
</thead>
