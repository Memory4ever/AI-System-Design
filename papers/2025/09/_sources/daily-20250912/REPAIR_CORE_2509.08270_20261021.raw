<td id="S4.T1.4.2.4" class="ltx_td ltx_align_center ltx_border_t">0.85</td>
<td id="S4.T1.4.2.5" class="ltx_td ltx_align_center ltx_border_t">0.78</td>
<td id="S4.T1.4.2.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">[0.800, 0.830]</td></tr>
<tr id="S4.T1.4.3" class="ltx_tr">
<th id="S4.T1.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">2</th>
<td id="S4.T1.4.3.2" class="ltx_td ltx_align_center">LLaMA-3.2-Vision-11B</td>
<td id="S4.T1.4.3.3" class="ltx_td ltx_align_center">0.765</td>
