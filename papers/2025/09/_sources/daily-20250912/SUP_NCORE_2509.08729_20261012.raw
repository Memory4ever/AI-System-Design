<th id="S4.T2.4.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.4.1.2.1" class="ltx_text ltx_font_bold">Templates Tested</span></th>
<th id="S4.T2.4.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.4.1.3.1" class="ltx_text ltx_font_bold">Success Rate</span></th>
<th id="S4.T2.4.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.4.1.4.1" class="ltx_text ltx_font_bold">Decision</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T2.4.2" class="ltx_tr">
<th id="S4.T2.4.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">1</th>
<td id="S4.T2.4.2.2" class="ltx_td ltx_align_center ltx_border_t">3 base templates</td>
<td id="S4.T2.4.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T2.m3" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>50%</td>
<td id="S4.T2.4.2.4" class="ltx_td ltx_align_center ltx_border_t">Continue</td></tr>
<tr id="S4.T2.4.3" class="ltx_tr">
<th id="S4.T2.4.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">2</th>
<td id="S4.T2.4.3.2" class="ltx_td ltx_align_center">3 templates</td>
<td id="S4.T2.4.3.3" class="ltx_td ltx_align_center"><math id="S4.T2.m4" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>45%</td>
<td id="S4.T2.4.3.4" class="ltx_td ltx_align_center">Continue</td></tr>
<tr id="S4.T2.4.4" class="ltx_tr">
<th id="S4.T2.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">3</th>
<td id="S4.T2.4.4.2" class="ltx_td ltx_align_center">3 templates</td>
<td id="S4.T2.4.4.3" class="ltx_td ltx_align_center"><math id="S4.T2.m5" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>43%</td>
<td id="S4.T2.4.4.4" class="ltx_td ltx_align_center">Continue</td></tr>
