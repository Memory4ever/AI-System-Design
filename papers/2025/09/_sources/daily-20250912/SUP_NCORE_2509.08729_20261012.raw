<th id="S4.T2.4.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">4</th>
<td id="S4.T2.4.5.2" class="ltx_td ltx_align_center">2 evolved templates</td>
<td id="S4.T2.4.5.3" class="ltx_td ltx_align_center"><math id="S4.T2.m6" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math>47%</td>
