</div></li>
<li id="A6.I36.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I36.i3.p1" class="ltx_para ltx_noindent">
<p id="A6.I36.i3.p1.1" class="ltx_p"><span id="A6.I36.i3.p1.1.1" class="ltx_text ltx_font_bold">Dataset Links:</span> <a href="https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/DZZ0OM" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://dataverse.harvard.edu/dataset.xhtml?persistentId=doi:10.7910/DVN/DZZ0OM</a></p>
</div></li>
<li id="A6.I36.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I36.i4.p1" class="ltx_para">
<p id="A6.I36.i4.p1.1" class="ltx_p"><span id="A6.I36.i4.p1.1.1" class="ltx_text ltx_font_bold">Dataset citation:</span> <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib14" title="" class="ltx_ref">Carlson and Montgomery [14]</a></cite></p>
</div></li>
</ul>
</div>
<section id="A6.SS15.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">F.15.1 </span>
<span id="A6.SS15.SSS1.2" class="ltx_inline-block fas fa-edit" aria-hidden="true">
</span>  tone task</h4>

