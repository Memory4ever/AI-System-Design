<span id="S4.T1.8.1.1.1.1.1.1.38.7" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S4.T1.8.1.1.1.1.1.1.38.7.1" class="ltx_inline-block ltx_align_top" style="width:59.8pt;">
<span id="S4.T1.8.1.1.1.1.1.1.38.7.1.1" class="ltx_p">1</span>
</span></span></span>
<span id="S4.T1.8.1.1.1.1.1.1.39" class="ltx_tr">
<span id="S4.T1.8.1.1.1.1.1.1.39.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="S4.T1.8.1.1.1.1.1.1.39.1.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S4.T1.8.1.1.1.1.1.1.39.1.1.1" class="ltx_p"><span id="S4.T1.8.1.1.1.1.1.1.39.1.1.1.1" class="ltx_text ltx_font_bold">21 datasets</span></span>
</span></span>
<span id="S4.T1.8.1.1.1.1.1.1.39.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="S4.T1.8.1.1.1.1.1.1.39.2.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
<span id="S4.T1.8.1.1.1.1.1.1.39.2.1.1" class="ltx_p"><span id="S4.T1.8.1.1.1.1.1.1.39.2.1.1.1" class="ltx_text ltx_font_bold">37 tasks</span></span>
</span></span>
<span id="S4.T1.8.1.1.1.1.1.1.39.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="S4.T1.8.1.1.1.1.1.1.39.3.1" class="ltx_inline-block ltx_align_top" style="width:54.1pt;">
<span id="S4.T1.8.1.1.1.1.1.1.39.3.1.1" class="ltx_p"><span id="S4.T1.8.1.1.1.1.1.1.39.3.1.1.1" class="ltx_text ltx_font_bold">145277/1533400</span></span>
</span></span>
<span id="S4.T1.8.1.1.1.1.1.1.39.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="S4.T1.8.1.1.1.1.1.1.39.4.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S4.T1.8.1.1.1.1.1.1.39.4.1.1" class="ltx_p"><span id="S4.T1.8.1.1.1.1.1.1.39.4.1.1.1" class="ltx_text ltx_font_bold">266</span></span>
</span></span>
<span id="S4.T1.8.1.1.1.1.1.1.39.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="S4.T1.8.1.1.1.1.1.1.39.5.1" class="ltx_inline-block ltx_align_top" style="width:76.3pt;">
<span id="S4.T1.8.1.1.1.1.1.1.39.5.1.1" class="ltx_p"><span id="S4.T1.8.1.1.1.1.1.1.39.5.1.1.1" class="ltx_text ltx_font_bold">199 (36.2%) (89.4%)</span></span>
</span></span>
<span id="S4.T1.8.1.1.1.1.1.1.39.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
