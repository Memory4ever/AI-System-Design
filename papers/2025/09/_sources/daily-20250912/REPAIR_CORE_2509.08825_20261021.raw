<span id="S5.T4.5.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:702.5pt;height:157.6pt;vertical-align:-76.3pt;"><span class="ltx_transformed_inner" style="transform:translate(0.0pt,0.0pt) scale(1,1) ;">
