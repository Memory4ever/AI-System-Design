<td id="S5.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><math id="S5.T2.m1" class="ltx_Math" alttext="J^{(\ell)}" display="inline" intent=":literal"><semantics><msup><mi>J</mi><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">J^{(\ell)}</annotation></semantics></math> in hidden layers</td>
<td id="S5.T2.2.1.4" class="ltx_td ltx_align_center ltx_border_tt">Learning rate</td></tr>
<tr id="S5.T2.2.2" class="ltx_tr">
