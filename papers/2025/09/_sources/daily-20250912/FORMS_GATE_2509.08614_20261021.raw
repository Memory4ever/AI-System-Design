<span id="S5.T2.2.2.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T2.2.2.1.2.1.1" class="ltx_tr">
<span id="S5.T2.2.2.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Specific PE-Formers/</span></span>
<span id="S5.T2.2.2.1.2.1.2" class="ltx_tr">
<span id="S5.T2.2.2.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">PE-MoFormer</span></span>
</span></span><span id="S5.T2.2.2.1.3" class="ltx_text"></span></td>
