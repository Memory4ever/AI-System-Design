<td id="S5.T2.2.2.4" class="ltx_td ltx_align_center ltx_border_t">0.002</td></tr>
<tr id="S5.T2.2.3" class="ltx_tr">
<td id="S5.T2.2.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">2D-Former</td>
<td id="S5.T2.2.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">3</td>
<td id="S5.T2.2.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">[32,32,32]</td>
<td id="S5.T2.2.3.4" class="ltx_td ltx_align_center ltx_border_t">0.002</td></tr>
<tr id="S5.T2.2.4" class="ltx_tr">
<td id="S5.T2.2.4.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Edge-GCN</td>
