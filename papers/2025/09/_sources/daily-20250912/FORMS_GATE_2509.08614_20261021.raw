</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S5.F6.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.08614v1/gen_K_CB.svg" id="S5.F6.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:148/78;" width="148" height="78"></object>
