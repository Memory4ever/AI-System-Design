<td id="A1.T6.2.1.41.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" colspan="2">GSM8K</td>
<td id="A1.T6.2.1.41.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">Grade-school math word problems</td>
<td id="A1.T6.2.1.41.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">239</td>
