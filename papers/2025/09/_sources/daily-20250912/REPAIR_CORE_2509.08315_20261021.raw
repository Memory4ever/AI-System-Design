<th id="S4.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="S4.T1.2.1.1.2.1" class="ltx_text ltx_font_bold">Single-Document QA</span></th>
