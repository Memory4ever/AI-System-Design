<tr id="S4.T1.2.1.3" class="ltx_tr">
<th id="S4.T1.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Full</th>
<th id="S4.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">26.95</th>
<th id="S4.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">32.99</th>
<th id="S4.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">49.78</th>
