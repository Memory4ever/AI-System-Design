<tr id="A1.T6.2.1.40" class="ltx_tr">
<td id="A1.T6.2.1.40.1" class="ltx_td ltx_align_left ltx_border_t" colspan="2">Needle-in-a-Haystack</td>
<td id="A1.T6.2.1.40.2" class="ltx_td ltx_align_center ltx_border_t">PaulGrahamEssays</td>
<td id="A1.T6.2.1.40.3" class="ltx_td ltx_align_center ltx_border_t">–</td>
<td id="A1.T6.2.1.40.4" class="ltx_td ltx_align_center ltx_border_t">Recall</td>
<td id="A1.T6.2.1.40.5" class="ltx_td ltx_align_center ltx_border_t">English</td>
<td id="A1.T6.2.1.40.6" class="ltx_td ltx_align_center ltx_border_t">–</td></tr>
