<td id="S7.T10.4.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T10.4.2.4.1" class="ltx_text ltx_font_bold">CW PA</span></td>
<td id="S7.T10.4.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T10.4.2.5.1" class="ltx_text ltx_font_bold">PA</span></td>
<td id="S7.T10.4.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T10.4.2.6.1" class="ltx_text ltx_font_bold">CW PA</span></td></tr>
<tr id="S7.T10.4.3" class="ltx_tr">
