<th id="S7.T10.4.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt" rowspan="2"><span id="S7.T10.4.1.2.1" class="ltx_text ltx_font_bold">Question Name</span></th>
<td id="S7.T10.4.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S7.T10.4.1.3.1" class="ltx_text ltx_font_bold">Gemini 2.0</span></td>
<td id="S7.T10.4.1.4" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S7.T10.4.1.4.1" class="ltx_text ltx_font_bold">GPT-4o</span></td>
<td id="S7.T10.4.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S7.T10.4.1.5.1" class="ltx_text ltx_font_bold">LLaVa-Next-Video</span></td></tr>
