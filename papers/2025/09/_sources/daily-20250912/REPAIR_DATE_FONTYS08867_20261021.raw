            <div id="cite-harvard" class="tab " role="tabpanel" aria-labelledby="tab-3" tabindex="-1" aria-hidden="true">
                <div class="rendering rendering_researchoutput  rendering_researchoutput_harvard rendering_workingpaper rendering_harvard rendering_workingpaper_harvard">Pronk, K<a rel="Person" href="https://onderzoeksportaal.fontys.nl/en/persons/qin-zhao/" class="link"><span> &amp; Zhao, Q</span></a> 2025 '<a rel="WorkingPaper" href="https://onderzoeksportaal.fontys.nl/en/publications/benchmarking-energy-efficiency-of-large-language-models-using-vll/" class="link harvard_title"><span>Benchmarking Energy Efficiency of Large Language Models Using vLLM</span></a>'. <a onclick="window.open(this.href, '_blank','noopener,noreferrer'); return false;" href="https://doi.org/10.48550/arXiv.2509.08867" class="link"><span>https://doi.org/10.48550/arXiv.2509.08867</span></a></div>
