<th id="S4.T2.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r ltx_border_t"><span id="S4.T2.2.1.5.1.1" class="ltx_text ltx_font_bold">TCPO (Ours)</span></th>
<td id="S4.T2.2.1.5.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.2.1.5.2.1" class="ltx_text ltx_font_bold">42.9</span></td>
<td id="S4.T2.2.1.5.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T2.2.1.5.3.1" class="ltx_text ltx_font_bold">26.7</span></td></tr>
