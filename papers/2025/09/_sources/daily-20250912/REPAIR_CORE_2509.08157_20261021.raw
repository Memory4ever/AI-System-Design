<tr id="A1.T2.tab1.1.1.1.1.1" class="ltx_tr">
<td id="A1.T2.tab1.1.1.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A1.T2.tab1.1.1.1.1.1.1.1" class="ltx_text ltx_font_bold">Problem</span></td></tr>
<tr id="A1.T2.tab1.1.1.1.1.2" class="ltx_tr">
<td id="A1.T2.tab1.1.1.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A1.T2.tab1.1.1.1.1.2.1.1" class="ltx_text ltx_font_bold">Configurations</span></td></tr>
</table></th>
