<th id="A1.T2.tab1.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_t"><math id="A1.T2.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math><span id="A1.T2.tab1.1.2.2.1" class="ltx_text ltx_font_bold"> (%)</span></th>
<th id="A1.T2.tab1.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">
<table id="A1.T2.tab1.1.2.3.1" class="ltx_tabular ltx_align_middle">
<tr id="A1.T2.tab1.1.2.3.1.1" class="ltx_tr">
<td id="A1.T2.tab1.1.2.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A1.T2.tab1.1.2.3.1.1.1.1" class="ltx_text ltx_font_bold">Constrained</span></td></tr>
<tr id="A1.T2.tab1.1.2.3.1.2" class="ltx_tr">
<td id="A1.T2.tab1.1.2.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A1.T2.tab1.1.2.3.1.2.1.1" class="ltx_text ltx_font_bold">Policy</span></td></tr>
</table><span id="A1.T2.tab1.1.2.3.2" class="ltx_text"></span></th>
<th id="A1.T2.tab1.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">
<table id="A1.T2.tab1.1.2.4.1" class="ltx_tabular ltx_align_middle">
<tr id="A1.T2.tab1.1.2.4.1.1" class="ltx_tr">
<td id="A1.T2.tab1.1.2.4.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A1.T2.tab1.1.2.4.1.1.1.1" class="ltx_text ltx_font_bold">Constrained</span></td></tr>
<tr id="A1.T2.tab1.1.2.4.1.2" class="ltx_tr">
<td id="A1.T2.tab1.1.2.4.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A1.T2.tab1.1.2.4.1.2.1.1" class="ltx_text ltx_font_bold">Risk Search</span></td></tr>
