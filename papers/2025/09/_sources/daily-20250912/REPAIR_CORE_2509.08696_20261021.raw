<span id="S4.p3.3.2.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.p3.3.2.1.2.1" class="ltx_text ltx_font_bold">WER(%)<math id="S4.p3.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></span>
