<span id="S4.p3.3.2.2.2" class="ltx_td ltx_align_center ltx_border_t">1.58</span>
<span id="S4.p3.3.2.2.3" class="ltx_td ltx_align_center ltx_border_t">0.68</span>
<span id="S4.p3.3.2.2.4" class="ltx_td ltx_align_center ltx_border_t">3.69</span>
<span id="S4.p3.3.2.2.5" class="ltx_td ltx_align_center ltx_border_t">4.01</span>
