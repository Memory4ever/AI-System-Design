<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.3.2.1" class="ltx_text" style="--ltx-fg-color:#800000;">✗</span></td>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_center"><span id="S3.T1.2.1.3.3.1" class="ltx_text" style="--ltx-fg-color:#800000;">✗</span></td>
