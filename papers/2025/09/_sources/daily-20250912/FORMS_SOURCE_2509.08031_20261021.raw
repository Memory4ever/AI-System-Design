<th id="S5.T5.4.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.T5.4.1.1.3.1" class="ltx_text ltx_font_bold">Librispeech-clean</span></th>
<th id="S5.T5.4.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S5.T5.4.1.1.4.1" class="ltx_text ltx_font_bold">ClothoAQA</span></th></tr>
