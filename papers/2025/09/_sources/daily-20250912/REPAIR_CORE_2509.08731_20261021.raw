<tr id="S4.T2.3.4" class="ltx_tr">
<th id="S4.T2.3.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" rowspan="3"><span id="S4.T2.3.4.1.1" class="ltx_text">RL</span></th>
<th id="S4.T2.3.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_rr ltx_border_t">Split</th>
<td id="S4.T2.3.4.3" class="ltx_td ltx_align_center ltx_border_t">1.0857</td>
<td id="S4.T2.3.4.4" class="ltx_td ltx_align_center ltx_border_t">0.0264</td>
<td id="S4.T2.3.4.5" class="ltx_td ltx_align_center ltx_border_t">0.5273</td></tr>
<tr id="S4.T2.3.5" class="ltx_tr">
