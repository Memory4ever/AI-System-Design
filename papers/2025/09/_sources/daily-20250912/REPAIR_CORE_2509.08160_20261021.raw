<td id="A1.T6.2.4.5" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A1.T6.2.4.5.1" class="ltx_text ltx_font_bold">0.970</span></td></tr>
<tr id="A1.T6.2.5" class="ltx_tr">
<th id="A1.T6.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">5</th>
<td id="A1.T6.2.5.2" class="ltx_td ltx_align_center">0.075</td>
<td id="A1.T6.2.5.3" class="ltx_td ltx_align_center">0.934</td>
<td id="A1.T6.2.5.4" class="ltx_td ltx_align_center">0.945</td>
<td id="A1.T6.2.5.5" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A1.T6.2.5.5.1" class="ltx_text ltx_font_bold">0.955</span></td></tr>
<tr id="A1.T6.2.6" class="ltx_tr">
<th id="A1.T6.2.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">6</th>
<td id="A1.T6.2.6.2" class="ltx_td ltx_align_center">0.055</td>
<td id="A1.T6.2.6.3" class="ltx_td ltx_align_center">0.906</td>
<td id="A1.T6.2.6.4" class="ltx_td ltx_align_center"><span id="A1.T6.2.6.4.1" class="ltx_text ltx_font_bold">0.928</span></td>
<td id="A1.T6.2.6.5" class="ltx_td ltx_nopad_r ltx_align_center">0.923</td></tr>
<tr id="A1.T6.2.7" class="ltx_tr">
<th id="A1.T6.2.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">7</th>
<td id="A1.T6.2.7.2" class="ltx_td ltx_align_center">0.038</td>
<td id="A1.T6.2.7.3" class="ltx_td ltx_align_center">0.917</td>
<td id="A1.T6.2.7.4" class="ltx_td ltx_align_center"><span id="A1.T6.2.7.4.1" class="ltx_text ltx_font_bold">0.926</span></td>
<td id="A1.T6.2.7.5" class="ltx_td ltx_nopad_r ltx_align_center">0.924</td></tr>
