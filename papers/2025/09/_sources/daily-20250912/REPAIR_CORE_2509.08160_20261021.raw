<td id="S4.T1.2.1.8.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.1.8.5.1" class="ltx_text ltx_font_bold">0.933</span></td>
<td id="S4.T1.2.1.8.6" class="ltx_td ltx_align_center ltx_border_bb">-</td>
<td id="S4.T1.2.1.8.7" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.1.8.7.1" class="ltx_text ltx_font_bold">0.888</span></td>
