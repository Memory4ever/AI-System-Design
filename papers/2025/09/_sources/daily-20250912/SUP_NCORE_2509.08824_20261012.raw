<th id="S4.T5.2.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding-left:11.4pt;padding-right:11.4pt;"><span id="S4.T5.2.2.4.1" class="ltx_text ltx_font_bold">Dataset</span></th></tr>
</thead>
<tbody class="ltx_tbody">
