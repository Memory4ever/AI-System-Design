<th id="S4.T5.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:11.4pt;padding-right:11.4pt;"><span id="S4.T5.2.1.2.1" class="ltx_text ltx_font_bold">Starting</span></th>
