<span id="A5.T9.p1.1.2.1.2" class="ltx_tr">
<span id="A5.T9.p1.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:-0.5pt 3.0pt;">XNLI (base)</span></span>
</span></span><span id="A5.T9.p1.1.3" class="ltx_text"></span></span>
</span></span></td>
