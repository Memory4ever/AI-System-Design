<td id="A5.T9.2.3.3" class="ltx_td ltx_align_center" style="padding:-0.5pt 3.0pt;">48.7</td>
<td id="A5.T9.2.3.4" class="ltx_td ltx_align_center" style="padding:-0.5pt 3.0pt;">48.3</td>
