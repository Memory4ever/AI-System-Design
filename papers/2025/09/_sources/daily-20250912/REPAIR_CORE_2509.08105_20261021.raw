<span id="A5.T9.2.1.1.1.1" class="ltx_p"><span id="A5.T9.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Model</span></span>
</span></td>
<td id="A5.T9.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.5pt 3.0pt;"><span id="A5.T9.2.1.2.1" class="ltx_text ltx_font_bold">Aymara</span></td>
<td id="A5.T9.2.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.5pt 3.0pt;"><span id="A5.T9.2.1.3.1" class="ltx_text ltx_font_bold">Guarani</span></td>
<td id="A5.T9.2.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.5pt 3.0pt;"><span id="A5.T9.2.1.4.1" class="ltx_text ltx_font_bold">Quechua</span></td>
<td id="A5.T9.2.1.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt" style="padding:-0.5pt 3.0pt;"><span id="A5.T9.2.1.5.1" class="ltx_text ltx_font_bold">Avg.</span></td></tr>
<tr id="A5.T9.2.2" class="ltx_tr">
