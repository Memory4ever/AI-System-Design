<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.4 </span>Generalizability</h3>

<figure id="S4.T5" class="ltx_table">
<div id="S4.T5.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:38.3pt;vertical-align:-17.9pt;"><span class="ltx_transformed_inner" style="transform:translate(-164.4pt,18.2pt) scale(0.512084315331902,0.512084315331902) ;">
