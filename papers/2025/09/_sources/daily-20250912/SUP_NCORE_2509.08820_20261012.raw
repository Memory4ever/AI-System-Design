<th id="S4.T5.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding:1pt 8.0pt;"><span id="S4.T5.2.1.1.3.1" class="ltx_text ltx_font_bold">Generalized Tasks</span></th></tr>
</thead>
