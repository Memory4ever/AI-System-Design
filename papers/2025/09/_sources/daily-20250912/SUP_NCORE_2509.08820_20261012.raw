<li id="A1.I1.i5.I1.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A1.I1.i5.I1.i2.I1.i3.1" class="ltx_text ltx_font_bold">–</span></span> 
