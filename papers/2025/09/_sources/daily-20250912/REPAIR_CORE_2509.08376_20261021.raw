<figure id="A2.F7" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<p id="A2.F7.3" class="ltx_p ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:64.6pt;"><span id="A2.F7.3.1" class="ltx_text" style="font-size:70%;">Content Ref.</span></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="A2.F7.4" class="ltx_p ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:64.6pt;"><span id="A2.F7.4.1" class="ltx_text" style="font-size:70%;">Motion Ref.</span></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="A2.F7.5" class="ltx_p ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:64.6pt;"><span id="A2.F7.5.1" class="ltx_text" style="font-size:70%;">2kbps</span></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
