</div></div><div class="ltx_flex_cell ltx_flex_size_3">
<div id="A3.F8.5" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:159.0pt;"><img src="2509.08376v1/images/csim/0006_csim0.501.png" id="A3.F8.g3" class="ltx_graphics ltx_img_square" style="aspect-ratio:220/220;" width="220" height="220" alt="Refer to caption">
