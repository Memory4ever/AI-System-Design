<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.sf4.3" class="ltx_text" style="font-size:90%;">(d)</span> </span><span id="S4.F3.sf4.4" class="ltx_text" style="font-size:90%;">Blackjack — PPO</span></figcaption>
