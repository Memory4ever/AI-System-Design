</div>
<div id="lstnumberx15" class="ltx_listingline"><span id="lstnumberx15.1" class="ltx_text ltx_lst_identifier">Please</span><span id="lstnumberx15.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.3" class="ltx_text ltx_lst_identifier">clarify</span><span id="lstnumberx15.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.5" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx15.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.7" class="ltx_text ltx_lst_identifier">current</span><span id="lstnumberx15.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.9" class="ltx_text ltx_lst_identifier">state</span><span id="lstnumberx15.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.11" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx15.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.13" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx15.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.15" class="ltx_text ltx_lst_identifier">game</span><span id="lstnumberx15.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.17" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx15.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.19" class="ltx_text ltx_lst_identifier">determine</span><span id="lstnumberx15.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx15.21" class="ltx_text ltx_lst_identifier">what</span>
</div>
<div id="lstnumberx16" class="ltx_listingline"><span id="lstnumberx16.1" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx16.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.3" class="ltx_text ltx_lst_identifier">agent</span><span id="lstnumberx16.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.5" class="ltx_text ltx_lst_identifier">should</span><span id="lstnumberx16.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.7" class="ltx_text ltx_lst_identifier">do</span><span id="lstnumberx16.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.9" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx16.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.11" class="ltx_text ltx_lst_identifier">this</span><span id="lstnumberx16.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.13" class="ltx_text ltx_lst_identifier">current</span><span id="lstnumberx16.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.15" class="ltx_text ltx_lst_identifier">state</span>.
</div>
<div id="lstnumberx17" class="ltx_listingline"><span id="lstnumberx17.1" class="ltx_text ltx_lst_identifier">Finally</span>,<span id="lstnumberx17.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.3" class="ltx_text ltx_lst_identifier">please</span><span id="lstnumberx17.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.5" class="ltx_text ltx_lst_identifier">suggest</span><span id="lstnumberx17.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.7" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx17.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.9" class="ltx_text ltx_lst_identifier">correct</span><span id="lstnumberx17.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.11" class="ltx_text ltx_lst_identifier">action</span><span id="lstnumberx17.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.13" class="ltx_text ltx_lst_identifier">and</span>
</div>
<div id="lstnumberx18" class="ltx_listingline"><span id="lstnumberx18.1" class="ltx_text ltx_lst_identifier">output</span><span id="lstnumberx18.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx18.3" class="ltx_text ltx_lst_identifier">its</span><span id="lstnumberx18.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx18.5" class="ltx_text ltx_lst_identifier">index</span><span id="lstnumberx18.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx18.7" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx18.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx18.9" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx18.10" class="ltx_text ltx_lst_space"> </span>&lt;<span id="lstnumberx18.11" class="ltx_text ltx_lst_identifier">action</span>&gt;&lt;/<span id="lstnumberx18.12" class="ltx_text ltx_lst_identifier">action</span>&gt;<span id="lstnumberx18.13" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx18.14" class="ltx_text ltx_lst_identifier">tags</span>.
</div>
<div id="lstnumberx19" class="ltx_listingline"><span id="lstnumberx19.1" class="ltx_text ltx_lst_identifier">Do</span><span id="lstnumberx19.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx19.3" class="ltx_text ltx_lst_identifier">not</span><span id="lstnumberx19.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx19.5" class="ltx_text ltx_lst_identifier">provide</span><span id="lstnumberx19.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx19.7" class="ltx_text ltx_lst_identifier">reasoning</span>.
</div>
</div>
</figure>
<div id="S3.SS1.SSS4.p3" class="ltx_para">
<p id="S3.SS1.SSS4.p3.1" class="ltx_p">Furthermore, listing <a href="#LST2" title="Listing 2 ‣ 3.1.4 Prompt engineering ‣ 3.1 Student-teacher architecture for LLM-RL with repeated advice mechanism ‣ 3 Methods and Materials ‣ Accelerating Reinforcement Learning Algorithms Convergence using Pre-trained Large Language Models as Tutors With Advice Reusing" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> displays a model file template. We used this template for all LLMs in this study. This template includes several prompt engineering concepts:Instruction and Structured Output prompting, Role Prompting <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx97" title="" class="ltx_ref">97</a>]</cite>, Contextual Grounding <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx92" title="" class="ltx_ref">92</a>]</cite>, and Constrained Action Prompting <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bibx98" title="" class="ltx_ref">98</a>]</cite>, to ensure a robust and relevant response from the LLMs.</p>
</div>
<figure id="LST2" class="ltx_float ltx_lstlisting">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float">Listing 2: </span>Template of a system message</figcaption>
<div id="LST2.2" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx20" class="ltx_listingline"><span id="lstnumberx20.1" class="ltx_text ltx_lst_identifier">You</span><span id="lstnumberx20.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.3" class="ltx_text ltx_lst_identifier">are</span><span id="lstnumberx20.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.5" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx20.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.7" class="ltx_text ltx_lst_identifier">system</span><span id="lstnumberx20.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.9" class="ltx_text ltx_lst_identifier">used</span><span id="lstnumberx20.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.11" class="ltx_text ltx_lst_identifier">as</span><span id="lstnumberx20.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.13" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx20.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.15" class="ltx_text ltx_lst_identifier">teacher</span><span id="lstnumberx20.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.17" class="ltx_text ltx_lst_identifier">for</span><span id="lstnumberx20.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.19" class="ltx_text ltx_lst_identifier">Reinforcement</span>
</div>
<div id="lstnumberx21" class="ltx_listingline"><span id="lstnumberx21.1" class="ltx_text ltx_lst_identifier">learning</span><span id="lstnumberx21.2" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx21.3" class="ltx_text ltx_lst_identifier">RL</span>)<span id="lstnumberx21.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.5" class="ltx_text ltx_lst_identifier">agent</span>.<span id="lstnumberx21.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.7" class="ltx_text ltx_lst_identifier">Your</span><span id="lstnumberx21.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.9" class="ltx_text ltx_lst_identifier">goal</span><span id="lstnumberx21.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.11" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx21.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.13" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx21.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.15" class="ltx_text ltx_lst_identifier">use</span><span id="lstnumberx21.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.17" class="ltx_text ltx_lst_identifier">your</span><span id="lstnumberx21.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.19" class="ltx_text ltx_lst_identifier">reasoning</span>
</div>
<div id="lstnumberx22" class="ltx_listingline"><span id="lstnumberx22.1" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx22.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.3" class="ltx_text ltx_lst_identifier">help</span><span id="lstnumberx22.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.5" class="ltx_text ltx_lst_identifier">with</span><span id="lstnumberx22.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.7" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx22.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.9" class="ltx_text ltx_lst_identifier">convergence</span><span id="lstnumberx22.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.11" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx22.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.13" class="ltx_text ltx_lst_identifier">optimal</span><span id="lstnumberx22.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.15" class="ltx_text ltx_lst_identifier">policy</span><span id="lstnumberx22.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.17" class="ltx_text ltx_lst_identifier">of</span>
</div>
