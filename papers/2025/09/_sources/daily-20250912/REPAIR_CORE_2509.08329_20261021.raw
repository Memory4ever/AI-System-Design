<td id="S3.T1.5.2.2" class="ltx_td ltx_align_center ltx_border_tt">0.0001</td>
<td id="S3.T1.5.2.3" class="ltx_td ltx_align_center ltx_border_tt">0.0003</td>
<td id="S3.T1.5.2.4" class="ltx_td ltx_align_center ltx_border_tt">0.0007</td></tr>
<tr id="S3.T1.5.3" class="ltx_tr">
<td id="S3.T1.5.3.1" class="ltx_td ltx_align_left">Gamma (Discount Factor)</td>
<td id="S3.T1.5.3.2" class="ltx_td ltx_align_center">0.99</td>
<td id="S3.T1.5.3.3" class="ltx_td ltx_align_center">0.99</td>
<td id="S3.T1.5.3.4" class="ltx_td ltx_align_center">0.99</td></tr>
<tr id="S3.T1.5.4" class="ltx_tr">
<td id="S3.T1.5.4.1" class="ltx_td ltx_align_left">Optimizer</td>
<td id="S3.T1.5.4.2" class="ltx_td ltx_align_center">Adam</td>
<td id="S3.T1.5.4.3" class="ltx_td ltx_align_center">Adam</td>
<td id="S3.T1.5.4.4" class="ltx_td ltx_align_center">Adam</td></tr>
<tr id="S3.T1.5.5" class="ltx_tr">
<td id="S3.T1.5.5.1" class="ltx_td ltx_align_left">Clip Range</td>
<td id="S3.T1.5.5.2" class="ltx_td ltx_align_center">-</td>
<td id="S3.T1.5.5.3" class="ltx_td ltx_align_center">0.2</td>
<td id="S3.T1.5.5.4" class="ltx_td ltx_align_center">-</td></tr>
