<th id="Sx4.T1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:2.8pt;padding-right:2.8pt;">R23*</th>
<td id="Sx4.T1.1.3.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">126 s</td>
<td id="Sx4.T1.1.3.3" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">0.71</td>
<td id="Sx4.T1.1.3.4" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">4.68</td>
<td id="Sx4.T1.1.3.5" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">6.31</td>
