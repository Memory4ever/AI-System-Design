<td id="A3.T5.1.7.4" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">0.999</td>
<td id="A3.T5.1.7.5" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">0.830</td>
<td id="A3.T5.1.7.6" class="ltx_td ltx_align_center" style="padding-left:5.7pt;padding-right:5.7pt;">0.183</td>
