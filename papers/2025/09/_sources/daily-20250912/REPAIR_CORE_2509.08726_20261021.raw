</table>
<p id="A5.p1.2" class="ltx_p"><span id="A5.p1.2.1" class="ltx_text">The update in line <a href="#alg2.l10" title="In Algorithm 2 ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> of Algorithm <a href="#alg2" title="Algorithm 2 ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> implies</span></p>
<table id="A5.EGx45" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A5.E17.m1" class="ltx_Math" alttext="\displaystyle\small\begin{split}&amp;\left\|{\bf V}^{t+1}-{\bf{1}}{\bar{\bf{v}}}^{t+1}\right\|\\
=&amp;\left\|{\rm AccGossip}({\bf V}^{t}+{\bf G}^{t+1}-{\bf G}^{t}),K)-\frac{1}{m}{\bf{1}}{\bf{1}}^{\top}{\rm AccGossip}({\bf V}^{t}+{\bf G}^{t+1}-{\bf G}^{t}),K)\right\|\\
\leq&amp;\rho\left\|{\bf V}^{t}+{\bf G}^{t+1}-{\bf G}^{t}-\frac{1}{m}{\bf{1}}{\bf{1}}^{\top}({\bf V}^{t}+{\bf G}^{t+1}-{\bf G}^{t})\right\|\\
\leq&amp;\rho\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\rho\left\|{\bf G}^{t+1}-{\bf G}^{t}-\frac{1}{m}{\bf{1}}{\bf{1}}^{\top}({\bf G}^{t+1}-{\bf G}^{t})\right\|\\
\leq&amp;\rho\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\rho\left\|{\bf G}^{t+1}-{\bf G}^{t}\right\|\\
\leq&amp;\rho\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\rho\underbrace{\left\|\nabla{\bf{f}}({\bf X}^{t+1})-\nabla{\bf{f}}({\bf X}^{t})\right\|}_{C_{1}}+\rho\underbrace{\left\|{\bf G}^{t+1}-\nabla{\bf{f}}({\bf X}^{t+1})\right\|}_{C_{2}}+\rho\underbrace{\left\|{\bf G}^{t}-\nabla{\bf{f}}({\bf X}^{t})\right\|}_{C_{3}},\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐕</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐯</mi><mo>¯</mo></mover><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></mrow><mo>‖</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo mathsize="0.900em">=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>‖</mo><mi mathsize="0.900em">AccGossip</mi><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝐕</mi><msup><mrow></mrow><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">𝐆</mi><msup><mrow></mrow><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">𝐆</mi><msup><mrow></mrow><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">K</mi><mo maxsize="0.900em" minsize="0.900em">)</mo><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">m</mi></mfrac></mstyle><mn mathsize="0.900em">𝟏𝟏</mn><msup><mrow></mrow><mo mathsize="0.900em">⊤</mo></msup><mi mathsize="0.900em">AccGossip</mi><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">𝐕</mi><msup><mrow></mrow><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">𝐆</mi><msup><mrow></mrow><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><mi mathsize="0.900em">𝐆</mi><msup><mrow></mrow><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">K</mi><mo maxsize="0.900em" minsize="0.900em">)</mo><mo>‖</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo mathsize="0.900em">≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi mathsize="0.900em">ρ</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><mrow><msup><mi mathsize="0.900em">𝐕</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">+</mo><msup><mi mathsize="0.900em">𝐆</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow><mo mathsize="0.900em">−</mo><msup><mi mathsize="0.900em">𝐆</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mn mathsize="0.900em">𝟏𝟏</mn><mo mathsize="0.900em">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mrow><msup><mi mathsize="0.900em">𝐕</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">+</mo><msup><mi mathsize="0.900em">𝐆</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow><mo mathsize="0.900em">−</mo><msup><mi mathsize="0.900em">𝐆</mi><mi mathsize="0.900em">t</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo mathsize="0.900em">≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi mathsize="0.900em">ρ</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐕</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐯</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup></mrow></mrow><mo>‖</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">ρ</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐆</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><msup><mi mathsize="0.900em">𝐆</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mstyle displaystyle="true"><mfrac><mn mathsize="0.900em">1</mn><mi mathsize="0.900em">m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mn mathsize="0.900em">𝟏𝟏</mn><mo mathsize="0.900em">⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><msup><mi mathsize="0.900em">𝐆</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><msup><mi mathsize="0.900em">𝐆</mi><mi mathsize="0.900em">t</mi></msup></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo mathsize="0.900em">≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi mathsize="0.900em">ρ</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐕</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐯</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup></mrow></mrow><mo>‖</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">ρ</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐆</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><msup><mi mathsize="0.900em">𝐆</mi><mi mathsize="0.900em">t</mi></msup></mrow><mo>‖</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo mathsize="0.900em">≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi mathsize="0.900em">ρ</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐕</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐯</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup></mrow></mrow><mo>‖</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">ρ</mi><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><mo>‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">𝐗</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">𝐗</mi><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mi mathsize="0.900em">C</mi><mn mathsize="0.900em">1</mn></msub></munder></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">ρ</mi><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐆</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">𝐗</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mi mathsize="0.900em">C</mi><mn mathsize="0.900em">2</mn></msub></munder></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">ρ</mi><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐆</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mi mathsize="0.900em">𝐗</mi><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="true">⏟</mo></munder><msub><mi mathsize="0.900em">C</mi><mn mathsize="0.900em">3</mn></msub></munder></mrow></mrow><mo mathsize="0.900em">,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\small\begin{split}&amp;\left\|{\bf V}^{t+1}-{\bf{1}}{\bar{\bf{v}}}^{t+1}\right\|\\
=&amp;\left\|{\rm AccGossip}({\bf V}^{t}+{\bf G}^{t+1}-{\bf G}^{t}),K)-\frac{1}{m}{\bf{1}}{\bf{1}}^{\top}{\rm AccGossip}({\bf V}^{t}+{\bf G}^{t+1}-{\bf G}^{t}),K)\right\|\\
\leq&amp;\rho\left\|{\bf V}^{t}+{\bf G}^{t+1}-{\bf G}^{t}-\frac{1}{m}{\bf{1}}{\bf{1}}^{\top}({\bf V}^{t}+{\bf G}^{t+1}-{\bf G}^{t})\right\|\\
\leq&amp;\rho\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\rho\left\|{\bf G}^{t+1}-{\bf G}^{t}-\frac{1}{m}{\bf{1}}{\bf{1}}^{\top}({\bf G}^{t+1}-{\bf G}^{t})\right\|\\
\leq&amp;\rho\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\rho\left\|{\bf G}^{t+1}-{\bf G}^{t}\right\|\\
\leq&amp;\rho\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\rho\underbrace{\left\|\nabla{\bf{f}}({\bf X}^{t+1})-\nabla{\bf{f}}({\bf X}^{t})\right\|}_{C_{1}}+\rho\underbrace{\left\|{\bf G}^{t+1}-\nabla{\bf{f}}({\bf X}^{t+1})\right\|}_{C_{2}}+\rho\underbrace{\left\|{\bf G}^{t}-\nabla{\bf{f}}({\bf X}^{t})\right\|}_{C_{3}},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A5.p1.3" class="ltx_p"><span id="A5.p1.3.1" class="ltx_text">where the first three step follows the derivation of equation (<a href="#A4.E16" title="In Proof. ‣ Appendix D The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>);
the fourth step is based on Lemma <a href="#Thmlem4" title="Lemma 4 ( [ , Lemma 12] ). ‣ Appendix A Some Technical Lemmas ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>;
the last step is based on triangle inequality.</span></p>
</div>
<div id="A5.p2" class="ltx_para ltx_noindent">
<p id="A5.p2.1" class="ltx_p"><span id="A5.p2.1.1" class="ltx_text">We first consider term <math id="A5.p2.m1" class="ltx_Math" alttext="C_{1}1" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">C_{1}1</annotation></semantics></math>.
The setting of <math id="A5.p2.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> in this lemma implies</span></p>
<table id="A5.EGx46" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex41.m1" class="ltx_Math" alttext="\displaystyle\rho\leq\frac{1}{1+m\eta L_{1}}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\rho\leq\frac{1}{1+m\eta L_{1}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.2" class="ltx_p"><span id="A5.p2.2.1" class="ltx_text">which leads to</span></p>
<table id="A5.EGx47" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E18.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bf{x}}_{t}^{i}-{\bar{\bf{x}}}^{t}\right\|\leq\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|\leq\frac{\rho m\eta}{1-\rho}\leq\frac{1}{L_{1}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>‖</mo><mrow><msubsup><mi>𝐱</mi><mi>t</mi><mi>i</mi></msubsup><mo>−</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow><mo>‖</mo></mrow><mo>≤</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>L</mi><mn>1</mn></msub></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|{\bf{x}}_{t}^{i}-{\bar{\bf{x}}}^{t}\right\|\leq\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|\leq\frac{\rho m\eta}{1-\rho}\leq\frac{1}{L_{1}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A5.p2.3" class="ltx_p"><span id="A5.p2.3.1" class="ltx_text">Therefore, we have</span></p>
<table id="A5.EGx48" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex42.m1" class="ltx_Math" alttext="\displaystyle\left\|\nabla f({\bf{x}}^{t+1}_{i})-\nabla f({\bf{x}}^{t}_{i})\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\nabla f({\bf{x}}^{t+1}_{i})-\nabla f({\bf{x}}^{t}_{i})\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex43.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex43.m2" class="ltx_Math" alttext="\displaystyle\left\|\nabla f({\bf{x}}^{t+1}_{i})-\nabla f({\bar{\bf{x}}}^{t+1})\right\|+\left\|\nabla f({\bar{\bf{x}}}^{t+1})-\nabla f({\bar{\bf{x}}}^{t})\right\|+\left\|\nabla f({\bar{\bf{x}}}^{t}_{i})-\nabla f({\bf{x}}^{t}_{i})\right\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo>+</mo><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo>+</mo><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\nabla f({\bf{x}}^{t+1}_{i})-\nabla f({\bar{\bf{x}}}^{t+1})\right\|+\left\|\nabla f({\bar{\bf{x}}}^{t+1})-\nabla f({\bar{\bf{x}}}^{t})\right\|+\left\|\nabla f({\bar{\bf{x}}}^{t}_{i})-\nabla f({\bf{x}}^{t}_{i})\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex44.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex44.m2" class="ltx_Math" alttext="\displaystyle\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t+1})\right\|\right)\left\|{\bf{x}}^{t+1}_{i}-{\bar{\bf{x}}}^{t+1}\right\|+\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\left\|{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\|" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msubsup><mi>𝐱</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo>−</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow><mo>‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t+1})\right\|\right)\left\|{\bf{x}}^{t+1}_{i}-{\bar{\bf{x}}}^{t+1}\right\|+\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\left\|{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex45.m1" class="ltx_Math" alttext="\displaystyle+\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\left\|{\bf{x}}^{t}_{i}-{\bar{\bf{x}}}^{t}\right\|," display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo>−</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow><mo>‖</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\left\|{\bf{x}}^{t}_{i}-{\bar{\bf{x}}}^{t}\right\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p2.4" class="ltx_p"><span id="A5.p2.4.1" class="ltx_text">where the first step is based on the triangle inequality and the last step is based on Proposition <a href="#Thmprop1" title="Proposition 1. ‣ 2 Preliminaries ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and equation (<a href="#A5.E18" title="In Proof. ‣ Appendix E The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>).
Summing over above result with <math id="A5.p2.m3" class="ltx_Math" alttext="i=1,\dots,m" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">i=1,\dots,m</annotation></semantics></math>, we have</span></p>
<table id="A5.EGx49" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A5.E19.m1" class="ltx_Math" alttext="\displaystyle\small\begin{split}C_{1}=&amp;\sum_{i=1}^{m}\left\|\nabla f({\bf{x}}^{t+1}_{i})-\nabla f({\bf{x}}^{t}_{i})\right\|^{2}\\
=&amp;3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t+1})\right\|\right)^{2}\sum_{i=1}^{m}\left\|{\bf{x}}^{t+1}_{i}-{\bar{\bf{x}}}^{t+1}\right\|^{2}\\
&amp;+3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\sum_{i=1}^{m}\left\|{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\|^{2}+3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\sum_{i=1}^{m}\left\|{\bf{x}}^{t}_{i}-{\bar{\bf{x}}}^{t}\right\|^{2}\\
\leq&amp;3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t+1})\right\|\right)^{2}\left\|{\bf X}^{t+1}-{\bf{1}}{\bar{\bf{x}}}^{t+1}\right\|^{2}\\
&amp;+3m\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\eta^{2}+3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|^{2},\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi mathsize="0.900em">C</mi><mn mathsize="0.900em">1</mn></msub><mo mathsize="0.900em">=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">m</mi></munderover></mstyle><msup><mrow><mo>‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">𝐱</mi><mi mathsize="0.900em">i</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msubsup><mi mathsize="0.900em">𝐱</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">t</mi></msubsup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn mathsize="0.900em">2</mn></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo mathsize="0.900em">=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">f</mi></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">L</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn mathsize="0.900em">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">m</mi></munderover></mstyle><msup><mrow><mo>‖</mo><mrow><msubsup><mi mathsize="0.900em">𝐱</mi><mi mathsize="0.900em">i</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msubsup><mo mathsize="0.900em">−</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow><mo>‖</mo></mrow><mn mathsize="0.900em">2</mn></msup></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">3</mn><mo>(</mo><mi mathsize="0.900em">L</mi><msub><mrow></mrow><mi mathsize="0.900em">f</mi></msub><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">L</mi><msub><mrow></mrow><mn mathsize="0.900em">1</mn></msub><mo>‖</mo><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi><mo maxsize="0.900em" minsize="0.900em">(</mo><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><msup><mrow></mrow><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo><mo>‖</mo><mo rspace="0.167em">)</mo><msup><mrow></mrow><mn mathsize="0.900em">2</mn></msup><mstyle displaystyle="true"><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow></msub><msup><mrow></mrow><mi mathsize="0.900em">m</mi></msup><mo>‖</mo><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><msup><mrow></mrow><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><msup><mrow></mrow><mi mathsize="0.900em">t</mi></msup><mo>‖</mo><msup><mrow></mrow><mn mathsize="0.900em">2</mn></msup><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">3</mn><mo>(</mo><mi mathsize="0.900em">L</mi><msub><mrow></mrow><mi mathsize="0.900em">f</mi></msub><mo mathsize="0.900em">+</mo><mi mathsize="0.900em">L</mi><msub><mrow></mrow><mn mathsize="0.900em">1</mn></msub><mo>‖</mo><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi><mo maxsize="0.900em" minsize="0.900em">(</mo><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><msup><mrow></mrow><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo><mo>‖</mo><mo rspace="0.167em">)</mo><msup><mrow></mrow><mn mathsize="0.900em">2</mn></msup><mstyle displaystyle="true"><mo maxsize="0.900em" minsize="0.900em" movablelimits="false" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow></msub><msup><mrow></mrow><mi mathsize="0.900em">m</mi></msup><mo>‖</mo><mi mathsize="0.900em">𝐱</mi><msup><mrow></mrow><mi mathsize="0.900em">t</mi></msup><msub><mrow></mrow><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">−</mo><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><msup><mrow></mrow><mi mathsize="0.900em">t</mi></msup><mo>‖</mo><msup><mrow></mrow><mn mathsize="0.900em">2</mn></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo mathsize="0.900em">≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">f</mi></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">L</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn mathsize="0.900em">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐗</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></mrow><mo>‖</mo></mrow><mn mathsize="0.900em">2</mn></msup></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">f</mi></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">L</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn mathsize="0.900em">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mn mathsize="0.900em">3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">f</mi></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">L</mi><mn mathsize="0.900em">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn mathsize="0.900em">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐗</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mn mathsize="0.900em">2</mn></msup></mrow></mrow><mo mathsize="0.900em">,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\small\begin{split}C_{1}=&amp;\sum_{i=1}^{m}\left\|\nabla f({\bf{x}}^{t+1}_{i})-\nabla f({\bf{x}}^{t}_{i})\right\|^{2}\\
=&amp;3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t+1})\right\|\right)^{2}\sum_{i=1}^{m}\left\|{\bf{x}}^{t+1}_{i}-{\bar{\bf{x}}}^{t+1}\right\|^{2}\\
&amp;+3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\sum_{i=1}^{m}\left\|{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\|^{2}+3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\sum_{i=1}^{m}\left\|{\bf{x}}^{t}_{i}-{\bar{\bf{x}}}^{t}\right\|^{2}\\
\leq&amp;3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t+1})\right\|\right)^{2}\left\|{\bf X}^{t+1}-{\bf{1}}{\bar{\bf{x}}}^{t+1}\right\|^{2}\\
&amp;+3m\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\eta^{2}+3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|^{2},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="A5.p2.5" class="ltx_p"><span id="A5.p2.5.1" class="ltx_text">where the last step is based on Lemma <a href="#Thmlem8" title="Lemma 8. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>.</span></p>
</div>
<div id="A5.p3" class="ltx_para ltx_noindent">
<p id="A5.p3.1" class="ltx_p"><span id="A5.p3.1.1" class="ltx_text">Substituting equations (<a href="#A4.E16" title="In Proof. ‣ Appendix D The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) and (<a href="#A3.E10" title="In Proof. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) into equation (<a href="#A5.E19" title="In Proof. ‣ Appendix E The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>), we have</span></p>
<table id="A5.EGx50" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A5.E20.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\left\|\nabla{\bf{f}}({\bf X}^{t+1})-\nabla{\bf{f}}({\bf X}^{t})\right\|^{2}\\
\leq&amp;3\rho^{2}\left(L_{f}+L_{1}\left(L_{f}\eta+(L_{1}\eta+1)\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\right)^{2}\left(\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+m\eta\right)^{2}\\
&amp;+3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|^{2}+3m\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\eta^{2}\\
\leq&amp;\left(M_{2}+M_{3}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\left(\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+m\eta\right)^{2},\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><msup><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ρ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>M</mi><mn>2</mn></msub><mo>+</mo><mrow><msub><mi>M</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\left\|\nabla{\bf{f}}({\bf X}^{t+1})-\nabla{\bf{f}}({\bf X}^{t})\right\|^{2}\\
\leq&amp;3\rho^{2}\left(L_{f}+L_{1}\left(L_{f}\eta+(L_{1}\eta+1)\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\right)^{2}\left(\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+m\eta\right)^{2}\\
&amp;+3\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|^{2}+3m\left(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\eta^{2}\\
\leq&amp;\left(M_{2}+M_{3}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\left(\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+m\eta\right)^{2},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A5.p3.2" class="ltx_p"><span id="A5.p3.2.1" class="ltx_text">where we take <math id="A5.p3.m1" class="ltx_Math" alttext="M_{2}=(\rho+1)L_{f}+\rho L_{f}L_{1}\eta" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>2</mn></msub><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ρ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mo>+</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{2}=(\rho+1)L_{f}+\rho L_{f}L_{1}\eta</annotation></semantics></math> and
<math id="A5.p3.m2" class="ltx_Math" alttext="M_{3}=\rho L_{1}(L_{1}\eta+1)+L_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>3</mn></msub><mo>=</mo><mrow><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">M_{3}=\rho L_{1}(L_{1}\eta+1)+L_{1}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.p4" class="ltx_para ltx_noindent">
<p id="A5.p4.1" class="ltx_p"><span id="A5.p4.1.1" class="ltx_text">For the term <math id="A5.p4.m1" class="ltx_Math" alttext="C_{2}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>2</mn></msub><annotation encoding="application/x-tex">C_{2}</annotation></semantics></math>, we have</span></p>
<table id="A5.EGx51" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A5.E21.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&{\mathbb{E}}\left[\left\|{\bf G}^{t+1}-\nabla{\bf{f}}({\bf X}^{t+1})\right\|^{2}\right]\\
=&{\mathbb{E}}\left[\sum_{i=1}^{m}\left\|{\bf{g}}_{i}^{t+1}-\nabla f_{i}({\bf{x}}_{i}^{t+1})\right\|^{2}\right]\\
=&{\mathbb{E}}\left[\sum_{i=1}^{m}\left\|\frac{1}{b}\sum_{k=1}^{b}\nabla F_{i}({\bf{x}}_{i}^{t+1};{\bm{\xi}}_{i,k}^{t+1})-\nabla f_{i}({\bf{x}}_{i}^{t+1})\right\|^{2}\right]\\
\leq&amp;\frac{m\sigma^{2}}{b},\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝐆</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝐠</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>b</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>F</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>b</mi></mfrac></mstyle><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;{\mathbb{E}}\left[\left\|{\bf G}^{t+1}-\nabla{\bf{f}}({\bf X}^{t+1})\right\|^{2}\right]\\
=&amp;{\mathbb{E}}\left[\sum_{i=1}^{m}\left\|{\bf{g}}_{i}^{t+1}-\nabla f_{i}({\bf{x}}_{i}^{t+1})\right\|^{2}\right]\\
=&amp;{\mathbb{E}}\left[\sum_{i=1}^{m}\left\|\frac{1}{b}\sum_{k=1}^{b}\nabla F_{i}({\bf{x}}_{i}^{t+1};{\bm{\xi}}_{i,k}^{t+1})-\nabla f_{i}({\bf{x}}_{i}^{t+1})\right\|^{2}\right]\\
\leq&amp;\frac{m\sigma^{2}}{b},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A5.p4.2" class="ltx_p"><span id="A5.p4.2.1" class="ltx_text">for given <math id="A5.p4.m2" class="ltx_Math" alttext="\{{\bf{x}}_{i}^{t+1}\}_{i=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐱</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">\{{\bf{x}}_{i}^{t+1}\}_{i=1}^{m}</annotation></semantics></math>,
where the inequality is based on Assumption <a href="#Thmasm4" title="Assumption 4. ‣ 2 Preliminaries ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.
Consequently, we have</span></p>
<table id="A5.EGx52" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A5.E22.m1" class="ltx_Math" alttext="\displaystyle\begin{split}C_{2}=&{\mathbb{E}}\left[\left\|{\bf G}^{t+1}-\nabla{\bf{f}}({\bf X}^{t+1})\right\|\right]\\
=&amp;\sqrt{({\mathbb{E}}\left\|{\bf G}^{t+1}-\nabla{\bf{f}}({\bf X}^{t+1})\right\|)^{2}}\\
\leq&amp;\sqrt{{\mathbb{E}}\left[\left\|{\bf G}^{t+1}-\nabla{\bf{f}}({\bf X}^{t+1})\right\|^{2}\right]}\\
\overset{(\ref{eq:sub-G})}{\leq}&amp;\frac{\sqrt{m}\sigma}{\sqrt{b}},\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐆</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><msqrt><msup><mrow><mo stretchy="false">(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐆</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></msqrt></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝐆</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></msqrt></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mtext class="ltx_mathvariant_italic" mathsize="0.700em"><a href="#A5.E21" title="In Proof. ‣ Appendix E The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">21</span></a></mtext><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}C_{2}=&amp;{\mathbb{E}}\left[\left\|{\bf G}^{t+1}-\nabla{\bf{f}}({\bf X}^{t+1})\right\|\right]\\
=&amp;\sqrt{({\mathbb{E}}\left\|{\bf G}^{t+1}-\nabla{\bf{f}}({\bf X}^{t+1})\right\|)^{2}}\\
\leq&amp;\sqrt{{\mathbb{E}}\left[\left\|{\bf G}^{t+1}-\nabla{\bf{f}}({\bf X}^{t+1})\right\|^{2}\right]}\\
\overset{(\ref{eq:sub-G})}{\leq}&amp;\frac{\sqrt{m}\sigma}{\sqrt{b}},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A5.p4.3" class="ltx_p"><span id="A5.p4.3.1" class="ltx_text">where the first inequality is based on Jensen’s inequality.</span></p>
</div>
<div id="A5.p5" class="ltx_para ltx_noindent">
<p id="A5.p5.1" class="ltx_p"><span id="A5.p5.1.1" class="ltx_text">Similarly, the term <math id="A5.p5.m1" class="ltx_Math" alttext="C_{3}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>3</mn></msub><annotation encoding="application/x-tex">C_{3}</annotation></semantics></math> holds</span></p>
<table id="A5.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E23.m1" class="ltx_Math" alttext="\displaystyle C_{3}={\mathbb{E}}\left[\left\|{\bf G}^{t}-\nabla{\bf{f}}({\bf X}^{t})\right\|\right]\leq\frac{\sqrt{m}\sigma}{\sqrt{b}}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>3</mn></msub><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐆</mi><mi>t</mi></msup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle C_{3}={\mathbb{E}}\left[\left\|{\bf G}^{t}-\nabla{\bf{f}}({\bf X}^{t})\right\|\right]\leq\frac{\sqrt{m}\sigma}{\sqrt{b}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
</div>
<div id="A5.p6" class="ltx_para">
<p id="A5.p6.1" class="ltx_p"><span id="A5.p6.1.1" class="ltx_text">Combining the results of (<a href="#A5.E17" title="In Proof. ‣ Appendix E The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>), (<a href="#A5.E20" title="In Proof. ‣ Appendix E The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>), (<a href="#A5.E22" title="In Proof. ‣ Appendix E The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), and (<a href="#A5.E23" title="In Proof. ‣ Appendix E The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>), we have</span></p>
<table id="A5.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A5.Ex46.m1" class="ltx_Math" alttext="\displaystyle\small\begin{split}&{\mathbb{E}}\left[\left\|{\bf V}^{t+1}-{\bf{1}}{\bar{\bf{v}}}^{t+1}\right\|\right]\\
\leq&amp;\rho\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\rho\left(M_{2}+M_{3}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\left(\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+m\eta\right)+\frac{2\rho\sqrt{m}\sigma}{b}\\
\leq&amp;\rho\left(\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\left(M_{2}+M_{3}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+\left(M_{2}+M_{3}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)m\eta+\frac{2\sqrt{m}\sigma}{\sqrt{b}}\right),\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi mathsize="0.900em">𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐕</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐯</mi><mo>¯</mo></mover><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow></msup></mrow></mrow><mo>‖</mo></mrow><mo>]</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo mathsize="0.900em">≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi mathsize="0.900em">ρ</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐕</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐯</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup></mrow></mrow><mo>‖</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mi mathsize="0.900em">ρ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi mathsize="0.900em">M</mi><mn mathsize="0.900em">2</mn></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">M</mi><mn mathsize="0.900em">3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐗</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">ρ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi></mrow><mi mathsize="0.900em">b</mi></mfrac></mstyle></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo mathsize="0.900em">≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi mathsize="0.900em">ρ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐕</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐯</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi mathsize="0.900em">M</mi><mn mathsize="0.900em">2</mn></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">M</mi><mn mathsize="0.900em">3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐗</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup></mrow></mrow><mo>‖</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi mathsize="0.900em">M</mi><mn mathsize="0.900em">2</mn></msub><mo mathsize="0.900em">+</mo><mrow><msub><mi mathsize="0.900em">M</mi><mn mathsize="0.900em">3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi mathsize="0.900em">m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">σ</mi></mrow><msqrt><mi mathsize="0.900em">b</mi></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo mathsize="0.900em">,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\small\begin{split}&amp;{\mathbb{E}}\left[\left\|{\bf V}^{t+1}-{\bf{1}}{\bar{\bf{v}}}^{t+1}\right\|\right]\\
\leq&amp;\rho\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\rho\left(M_{2}+M_{3}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\left(\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+m\eta\right)+\frac{2\rho\sqrt{m}\sigma}{b}\\
\leq&amp;\rho\left(\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\left(M_{2}+M_{3}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+\left(M_{2}+M_{3}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)m\eta+\frac{2\sqrt{m}\sigma}{\sqrt{b}}\right),\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p6.2" class="ltx_p"><span id="A5.p6.2.1" class="ltx_text">for given <math id="A5.p6.m1" class="ltx_Math" alttext="\{{\bf{x}}_{i}^{t+1}\}_{i=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐱</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">\{{\bf{x}}_{i}^{t+1}\}_{i=1}^{m}</annotation></semantics></math> and <math id="A5.p6.m2" class="ltx_Math" alttext="\{{\bf{v}}_{i}^{t+1}\}_{i=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐯</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">\{{\bf{v}}_{i}^{t+1}\}_{i=1}^{m}</annotation></semantics></math>, which finishes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>The proof of Theorem <a href="#Thmthm1" title="Theorem 1. ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h2>

<div id="A6.p1" class="ltx_para ltx_noindent">
<p id="A6.p1.1" class="ltx_p">For given <math id="A6.p1.m1" class="ltx_Math" alttext="{\bf X}^{t}" display="inline" intent=":literal"><semantics><msup><mi>𝐗</mi><mi>t</mi></msup><annotation encoding="application/x-tex">{\bf X}^{t}</annotation></semantics></math> and <math id="A6.p1.m2" class="ltx_Math" alttext="{\bf V}^{t}" display="inline" intent=":literal"><semantics><msup><mi>𝐕</mi><mi>t</mi></msup><annotation encoding="application/x-tex">{\bf V}^{t}</annotation></semantics></math>,
we apply Lemmas <a href="#Thmlem1" title="Lemma 1. ‣ 4 The Complexity Analysis ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, <a href="#Thmlem2" title="Lemma 2. ‣ 4 The Complexity Analysis ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, <a href="#Thmlem3" title="Lemma 3. ‣ 4 The Complexity Analysis ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, and <a href="#Thmlem9" title="Lemma 9. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> to achieve</p>
<table id="A6.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex47.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi^{t+1}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi^{t+1}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex48.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex48.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[f({\bar{\bf{x}}}^{t+1})+\frac{3\eta}{\sqrt{m}}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{t+1})\right\|\right)\left\|{\bf X}^{t+1}-{\bf{1}}{\bar{\bf{x}}}^{t+1}\right\|+\frac{2\eta}{\sqrt{m}}\left\|{\bf V}^{t+1}-{\bf{1}}{\bar{\bf{v}}}^{t+1}\right\|\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐕</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[f({\bar{\bf{x}}}^{t+1})+\frac{3\eta}{\sqrt{m}}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{t+1})\right\|\right)\left\|{\bf X}^{t+1}-{\bf{1}}{\bar{\bf{x}}}^{t+1}\right\|+\frac{2\eta}{\sqrt{m}}\left\|{\bf V}^{t+1}-{\bf{1}}{\bar{\bf{v}}}^{t+1}\right\|\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex49.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
