p><mi mathsize="0.900em">𝐯</mi><mi mathsize="0.900em">i</mi><mi mathsize="0.900em">t</mi></msubsup></mrow><mo>‖</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">f</mi></msub></mrow><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo mathsize="0.900em">≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mn mathsize="0.900em">2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">−</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐯</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup></mrow><mo>‖</mo></mrow></mrow><mo mathsize="0.900em">−</mo><mrow><mrow><mi mathsize="0.900em">η</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">−</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathsize="0.900em">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mn mathsize="0.900em">1</mn></msub></mrow><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo mathsize="0.900em" rspace="0.167em">∇</mo><mi mathsize="0.900em">f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐱</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><mstyle displaystyle="true"><mfrac><mi mathsize="0.900em">η</mi><msqrt><mi mathsize="0.900em">m</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mi mathsize="0.900em">𝐕</mi><mi mathsize="0.900em">t</mi></msup><mo mathsize="0.900em">−</mo><mrow><mn mathsize="0.900em">𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathsize="0.900em">𝐯</mi><mo>¯</mo></mover><mi mathsize="0.900em">t</mi></msup></mrow></mrow><mo>‖</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi mathsize="0.900em">η</mi><mn mathsize="0.900em">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">L</mi><mi mathsize="0.900em">f</mi></msub></mrow><mn mathsize="0.900em">2</mn></mfrac></mstyle></mrow><mo mathsize="0.900em">,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\small\begin{split}&amp;f({\bar{\bf{x}}}^{t+1})-f({\bar{\bf{x}}}^{t})\\
\overset{~(\ref{eq:smooth-descent})~}{\leq}&amp;\left\langle\nabla f({\bar{\bf{x}}}^{t}),{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\rangle+\frac{L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|}{2}\left\|{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\|^{2}\\
\overset{(\ref{eq:bx-eta})}{\leq}&amp;\left\langle\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t},{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\rangle+\left\langle{\bar{\bf{v}}}^{t},{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\rangle+\frac{\eta^{2}}{2}(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|)\\
\overset{~(\ref{eq:diff-bar-x})~}{\leq}&amp;\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|\left\|{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\|-\eta\left\langle{\bar{\bf{v}}}^{t},\frac{1}{m}\sum_{i=1}^{m}\frac{{\bf{v}}_{i}^{t}}{\left\|{\bf{v}}_{i}^{t}\right\|}\right\rangle+\frac{\eta^{2}}{2}(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|)\\
\overset{(\ref{eq:bx-eta})}{\leq}&amp;\eta\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|+\eta\left\langle{\bar{\bf{v}}}^{t},\frac{{\bar{\bf{v}}}^{t}}{\left\|{\bar{\bf{v}}}^{t}\right\|}-\frac{{\bar{\bf{v}}}^{t}}{\left\|{\bar{\bf{v}}}^{t}\right\|}-\frac{1}{m}\sum_{i=1}^{m}\frac{{\bf{v}}_{i}^{t}}{\left\|{\bf{v}}_{i}^{t}\right\|}\right\rangle+\frac{\eta^{2}}{2}(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|)\\
~=~&amp;\eta\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|-\eta\left\|{\bar{\bf{v}}}^{t}\right\|+\eta\left\langle{\bar{\bf{v}}}^{t},\frac{{\bar{\bf{v}}}^{t}}{\left\|{\bar{\bf{v}}}^{t}\right\|}-\frac{1}{m}\sum_{i=1}^{m}\frac{{\bf{v}}_{i}^{t}}{\left\|{\bf{v}}_{i}^{t}\right\|}\right\rangle+\frac{\eta^{2}}{2}(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|)\\
~\leq~&amp;\eta\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|-\eta\left\|{\bar{\bf{v}}}^{t}\right\|+\eta\left\|{\bar{\bf{v}}}^{t}\right\|\left\|\frac{{\bar{\bf{v}}}^{t}}{\left\|{\bar{\bf{v}}}^{t}\right\|}-\frac{1}{m}\sum_{i=1}^{m}\frac{{\bf{v}}_{i}^{t}}{\left\|{\bf{v}}_{i}^{t}\right\|}\right\|+\frac{\eta^{2}L_{f}}{2}+\frac{\eta^{2}L_{1}}{2}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\\
~\leq~&amp;\eta\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|+\eta(\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|-\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|)\\
&amp;+\eta\left\|{\bar{\bf{v}}}^{t}\right\|\left\|\frac{{\bar{\bf{v}}}^{t}}{\left\|{\bar{\bf{v}}}^{t}\right\|}-\frac{1}{m}\sum_{i=1}^{m}\frac{{\bf{v}}_{i}^{t}}{\left\|{\bf{v}}_{i}^{t}\right\|}\right\|+\frac{\eta^{2}L_{f}}{2}+\frac{\eta^{2}L_{1}}{2}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\\
\overset{~(\ref{eq:consensus-error-1})~}{\leq}&amp;2\eta\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|-\eta\left(1-\frac{\eta L_{1}}{2}\right)\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|+\frac{\eta}{m}\sum_{i=1}^{m}\left\|{\bar{\bf{v}}}^{t}-{\bf{v}}^{t}_{i}\right\|+\frac{\eta^{2}L_{f}}{2}\\
~\leq~&amp;2\eta\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|-\eta\left(1-\frac{\eta L_{1}}{2}\right)\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|+\frac{\eta}{\sqrt{m}}\left\|{\bf V}^{t}-{\bf{1}}{\bar{\bf{v}}}^{t}\right\|+\frac{\eta^{2}L_{f}}{2},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="A3.p6.2" class="ltx_p"><span id="A3.p6.2.1" class="ltx_text">where the first inequality is based on Lemma <a href="#Thmlem7" title="Lemma 7 ( [ , Appendix A.1] ). ‣ Appendix A Some Technical Lemmas ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> and the fact <math id="A3.p6.m1" class="ltx_Math" alttext="\left\|{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\|\leq 1/(2L_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow><mo>‖</mo></mrow><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|{\bar{\bf{x}}}^{t+1}-{\bar{\bf{x}}}^{t}\right\|\leq 1/(2L_{1})</annotation></semantics></math> from Lemma <a href="#A3.E8" title="In Proof. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>;
the forth to last line is based on Cauchy–Schwarz inequality;
the third to last line is based on the triangle inequality;
the last line is based on the vector AM-QM inequality.</span></p>
</div>
<div id="A3.p7" class="ltx_para ltx_noindent">
<p id="A3.p7.1" class="ltx_p"><span id="A3.p7.1.1" class="ltx_text">We bound the term <math id="A3.p7.m1" class="ltx_Math" alttext="\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow><mo>‖</mo></mrow><annotation encoding="application/x-tex">\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|</annotation></semantics></math> in equation (<a href="#A3.E11" title="In Proof. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) as</span></p>
<table id="A3.EGx36" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A3.E12.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|^{2}=\left\|\frac{1}{m}\sum_{i=1}^{m}(\nabla f_{i}({\bar{\bf{x}}}^{t})-{\bf{g}}_{i}^{t}))\right\|^{2}\\
\leq&amp;2\underbrace{\left\|\frac{1}{m}\sum_{i=1}^{m}(\nabla f_{i}({\bar{\bf{x}}}^{t})-\nabla f_{i}({\bf{x}}_{i}^{t}))\right\|^{2}}_{B_{1}}+2\underbrace{\left\|\frac{1}{m}\sum_{i=1}^{m}(\nabla f_{i}({\bf{x}}_{i}^{t})-{\bf{g}}_{i}^{t})\right\|^{2}}_{B_{2}}.\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>‖</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><msup><mrow></mrow><mi>t</mi></msup><mo stretchy="false">)</mo><mo>−</mo><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><msup><mrow></mrow><mi>t</mi></msup><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>=</mo><mo>‖</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>m</mi></msup><mo stretchy="false">(</mo><mo rspace="0.167em">∇</mo><mi>f</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">(</mo><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><msup><mrow></mrow><mi>t</mi></msup><mo stretchy="false">)</mo><mo>−</mo><mi>𝐠</mi><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mi>t</mi></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo stretchy="true">⏟</mo></munder><msub><mi>B</mi><mn>1</mn></msub></munder></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><munder><munder accentunder="true"><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msubsup><mi>𝐠</mi><mi>i</mi><mi>t</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo stretchy="true">⏟</mo></munder><msub><mi>B</mi><mn>2</mn></msub></munder></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|^{2}=\left\|\frac{1}{m}\sum_{i=1}^{m}(\nabla f_{i}({\bar{\bf{x}}}^{t})-{\bf{g}}_{i}^{t}))\right\|^{2}\\
\leq&amp;2\underbrace{\left\|\frac{1}{m}\sum_{i=1}^{m}(\nabla f_{i}({\bar{\bf{x}}}^{t})-\nabla f_{i}({\bf{x}}_{i}^{t}))\right\|^{2}}_{B_{1}}+2\underbrace{\left\|\frac{1}{m}\sum_{i=1}^{m}(\nabla f_{i}({\bf{x}}_{i}^{t})-{\bf{g}}_{i}^{t})\right\|^{2}}_{B_{2}}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p8" class="ltx_para ltx_noindent">
<p id="A3.p8.1" class="ltx_p"><span id="A3.p8.1.1" class="ltx_text">We bound term <math id="A3.p8.m1" class="ltx_Math" alttext="B_{1}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>1</mn></msub><annotation encoding="application/x-tex">B_{1}</annotation></semantics></math> as</span></p>
<table id="A3.EGx37" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A3.E13.m1" class="ltx_Math" alttext="\displaystyle\begin{split}B_{1}=&amp;\left\|\frac{1}{m}\sum_{i=1}^{m}(\nabla f_{i}({\bar{\bf{x}}}^{t})-\nabla f_{i}({\bf{x}}_{i}^{t}))\right\|^{2}\\
\leq&amp;\frac{1}{m}\sum_{i=1}^{m}\left\|\nabla f_{i}({\bar{\bf{x}}}^{t})-\nabla f_{i}({\bf{x}}_{i}^{t})\right\|^{2}\\
\leq&amp;\frac{1}{m}\sum_{i=1}^{m}2\left(L_{0}^{2}+L_{1}^{2}\left\|\nabla f_{i}({\bar{\bf{x}}}^{t})\right\|^{2}\right)\left\|{\bar{\bf{x}}}^{t}-{\bf{x}}_{i}^{t}\right\|^{2}\\
\leq&amp;\frac{1}{m}\sum_{i=1}^{m}2\left(L_{0}^{2}+L_{1}^{2}\left(\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|+\zeta\right)^{2}\right)\left\|{\bar{\bf{x}}}^{t}-{\bf{x}}_{i}^{t}\right\|^{2}\\
\leq&amp;\frac{1}{m}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|^{2},\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>B</mi><mn>1</mn></msub><mo>=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>L</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><mrow><msubsup><mi>L</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo>−</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mi>L</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><mrow><msubsup><mi>L</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>+</mo><mi>ζ</mi></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo>−</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}B_{1}=&amp;\left\|\frac{1}{m}\sum_{i=1}^{m}(\nabla f_{i}({\bar{\bf{x}}}^{t})-\nabla f_{i}({\bf{x}}_{i}^{t}))\right\|^{2}\\
\leq&amp;\frac{1}{m}\sum_{i=1}^{m}\left\|\nabla f_{i}({\bar{\bf{x}}}^{t})-\nabla f_{i}({\bf{x}}_{i}^{t})\right\|^{2}\\
\leq&amp;\frac{1}{m}\sum_{i=1}^{m}2\left(L_{0}^{2}+L_{1}^{2}\left\|\nabla f_{i}({\bar{\bf{x}}}^{t})\right\|^{2}\right)\left\|{\bar{\bf{x}}}^{t}-{\bf{x}}_{i}^{t}\right\|^{2}\\
\leq&amp;\frac{1}{m}\sum_{i=1}^{m}2\left(L_{0}^{2}+L_{1}^{2}\left(\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|+\zeta\right)^{2}\right)\left\|{\bar{\bf{x}}}^{t}-{\bf{x}}_{i}^{t}\right\|^{2}\\
\leq&amp;\frac{1}{m}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|^{2},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="A3.p8.2" class="ltx_p"><span id="A3.p8.2.1" class="ltx_text">where we denote <math id="A3.p8.m2" class="ltx_Math" alttext="M_{0}=\sqrt{2(L_{0}^{2}+L_{1}^{2}\zeta^{2})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>=</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>L</mi><mn>0</mn><mn>2</mn></msubsup><mo>+</mo><mrow><msubsup><mi>L</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ζ</mi><mn>2</mn></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">M_{0}=\sqrt{2(L_{0}^{2}+L_{1}^{2}\zeta^{2})}</annotation></semantics></math> and <math id="A3.p8.m3" class="ltx_Math" alttext="M_{1}=\sqrt{2}L_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>1</mn></msub><mo>=</mo><mrow><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">M_{1}=\sqrt{2}L_{1}</annotation></semantics></math>.
Here, the first inequality is based on vector AM-QM inequality;
the second inequality is based on Young’s inequality and Assumption <a href="#Thmasm2" title="Assumption 2 (relaxed smoothness). ‣ 2 Preliminaries ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>;
the third inequality is based on Assumption <a href="#Thmasm3" title="Assumption 3 (bounded gradient dissimilarity). ‣ 2 Preliminaries ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</span></p>
</div>
<div id="A3.p9" class="ltx_para ltx_noindent">
<p id="A3.p9.1" class="ltx_p"><span id="A3.p9.1.1" class="ltx_text">For given <math id="A3.p9.m1" class="ltx_Math" alttext="\{{\bf{x}}_{i}^{t}\}_{i=1}^{m}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><annotation encoding="application/x-tex">\{{\bf{x}}_{i}^{t}\}_{i=1}^{m}</annotation></semantics></math>, we bound expectation of term <math id="A3.p9.m2" class="ltx_Math" alttext="B_{2}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>2</mn></msub><annotation encoding="application/x-tex">B_{2}</annotation></semantics></math> as</span></p>
<table id="A3.EGx38" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A3.E14.m1" class="ltx_Math" alttext="\displaystyle\begin{split}{\mathbb{E}}[B_{2}]=&{\mathbb{E}}\left\|\frac{1}{m}\sum_{i=1}^{m}({\bf{g}}_{i}^{t}-\nabla f_{i}({\bf{x}}_{i}^{t}))\right\|^{2}\\
=&amp;\frac{1}{m^{2}}\sum_{i=1}^{m}{\mathbb{E}}\left\|{\bf{g}}_{i}^{t}-\nabla f_{i}({\bf{x}}_{i}^{t})\right\|^{2}\\
\leq&amp;\frac{1}{m^{2}}\sum_{i=1}^{m}\frac{\sigma^{2}}{b}=\frac{\sigma^{2}}{mb},\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>B</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>𝐠</mi><mi>i</mi><mi>t</mi></msubsup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>m</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mi>𝐠</mi><mi>i</mi><mi>t</mi></msubsup><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>m</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>2</mn></msup><mi>b</mi></mfrac></mstyle></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>2</mn></msup><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}{\mathbb{E}}[B_{2}]=&amp;{\mathbb{E}}\left\|\frac{1}{m}\sum_{i=1}^{m}({\bf{g}}_{i}^{t}-\nabla f_{i}({\bf{x}}_{i}^{t}))\right\|^{2}\\
=&amp;\frac{1}{m^{2}}\sum_{i=1}^{m}{\mathbb{E}}\left\|{\bf{g}}_{i}^{t}-\nabla f_{i}({\bf{x}}_{i}^{t})\right\|^{2}\\
\leq&amp;\frac{1}{m^{2}}\sum_{i=1}^{m}\frac{\sigma^{2}}{b}=\frac{\sigma^{2}}{mb},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A3.p9.2" class="ltx_p"><span id="A3.p9.2.1" class="ltx_text">where the inequality is based on
the setting <math id="A3.p9.m3" class="ltx_Math" alttext="{\bf{g}}_{i}^{t}=\frac{1}{b}\sum_{k=1}^{b}\nabla F_{i}({\bf{x}}_{i}^{t+1};{\bm{\xi}}_{i,k}^{t+1})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐠</mi><mi>i</mi><mi>t</mi></msubsup><mo>=</mo><mrow><mfrac><mn>1</mn><mi>b</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\bf{g}}_{i}^{t}=\frac{1}{b}\sum_{k=1}^{b}\nabla F_{i}({\bf{x}}_{i}^{t+1};{\bm{\xi}}_{i,k}^{t+1})</annotation></semantics></math> in line <a href="#alg2.l9" title="In Algorithm 2 ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> of Algorithm <a href="#alg2" title="Algorithm 2 ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and Assumption <a href="#Thmasm4" title="Assumption 4. ‣ 2 Preliminaries ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</span></p>
</div>
<div id="A3.p10" class="ltx_para ltx_noindent">
<p id="A3.p10.1" class="ltx_p"><span id="A3.p10.1.1" class="ltx_text">Combining results (<a href="#A3.E12" title="In Proof. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>), (<a href="#A3.E13" title="In Proof. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) and (<a href="#A3.E14" title="In Proof. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), we have</span></p>
<table id="A3.EGx39" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A3.E15.m1" class="ltx_Math" alttext="\displaystyle\begin{split}{\mathbb{E}}\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|\leq&amp;\sqrt{\frac{2}{m}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|^{2}+\frac{\sigma^{2}}{mb}}\\
\leq&amp;\sqrt{\frac{2}{m}}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+\frac{\sigma}{\sqrt{mb}},\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow><mo>‖</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>2</mn></msup><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></mfrac></mstyle></mrow></msqrt></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><msqrt><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>m</mi></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><msqrt><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msqrt></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}{\mathbb{E}}\left\|\nabla f({\bar{\bf{x}}}^{t})-{\bar{\bf{v}}}^{t}\right\|\leq&amp;\sqrt{\frac{2}{m}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)^{2}\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|^{2}+\frac{\sigma^{2}}{mb}}\\
\leq&amp;\sqrt{\frac{2}{m}}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right)\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+\frac{\sigma}{\sqrt{mb}},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A3.p10.2" class="ltx_p"><span id="A3.p10.2.1" class="ltx_text">for given <math id="A3.p10.m1" class="ltx_Math" alttext="{\bf X}^{t}" display="inline" intent=":literal"><semantics><msup><mi>𝐗</mi><mi>t</mi></msup><annotation encoding="application/x-tex">{\bf X}^{t}</annotation></semantics></math>, where the first step is based on the Jensen’s inequality
and the second step is based on the elementary inequality <math id="A3.p10.m2" class="ltx_Math" alttext="\sqrt{a^{2}+b^{2}}\leq a+b" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></mrow></msqrt><mo>≤</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">\sqrt{a^{2}+b^{2}}\leq a+b</annotation></semantics></math> for <math id="A3.p10.m3" class="ltx_Math" alttext="a,b&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">a,b&gt;0</annotation></semantics></math>.</span></p>
</div>
<div id="A3.p11" class="ltx_para">
<p id="A3.p11.1" class="ltx_p"><span id="A3.p11.1.1" class="ltx_text">Combining equations (<a href="#A3.E11" title="In Proof. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) and (<a href="#A3.E15" title="In Proof. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>), we finish the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>The Proof of Lemma <a href="#Thmlem2" title="Lemma 2. ‣ 4 The Complexity Analysis ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></h2>

<div id="A4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p"><span id="A4.p1.1.1" class="ltx_text">Recall that line <a href="#alg2.l6" title="In Algorithm 2 ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> of Algorithm <a href="#alg2" title="Algorithm 2 ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> set</span></p>
<table id="A4.EGx40" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex37.m1" class="ltx_Math" alttext="\displaystyle{\bf U}^{t}=\begin{bmatrix}\dfrac{{\bf{v}}^{t}_{1}}{\left\|{\bf{v}}^{t}_{1}\right\|}&amp;\dots&amp;\dfrac{{\bf{v}}^{t}_{1}}{\left\|{\bf{v}}^{t}_{m}\right\|}\end{bmatrix}^{\top}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>𝐔</mi><mi>t</mi></msup><mo>=</mo><msup><mrow><mo>[</mo><mtable columnspacing="5pt"><mtr><mtd><mstyle displaystyle="true"><mfrac><msubsup><mi>𝐯</mi><mn>1</mn><mi>t</mi></msubsup><mrow><mo>‖</mo><msubsup><mi>𝐯</mi><mn>1</mn><mi>t</mi></msubsup><mo>‖</mo></mrow></mfrac></mstyle></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mstyle displaystyle="true"><mfrac><msubsup><mi>𝐯</mi><mn>1</mn><mi>t</mi></msubsup><mrow><mo>‖</mo><msubsup><mi>𝐯</mi><mi>m</mi><mi>t</mi></msubsup><mo>‖</mo></mrow></mfrac></mstyle></mtd></mtr></mtable><mo>]</mo></mrow><mo>⊤</mo></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\bf U}^{t}=\begin{bmatrix}\dfrac{{\bf{v}}^{t}_{1}}{\left\|{\bf{v}}^{t}_{1}\right\|}&amp;\dots&amp;\dfrac{{\bf{v}}^{t}_{1}}{\left\|{\bf{v}}^{t}_{m}\right\|}\end{bmatrix}^{\top},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.2" class="ltx_p"><span id="A4.p1.2.1" class="ltx_text">which implies <math id="A4.p1.m1" class="ltx_Math" alttext="\left\|{\bf U}^{t}\right\|^{2}=m" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><msup><mi>𝐔</mi><mi>t</mi></msup><mo>‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mi>m</mi></mrow><annotation encoding="application/x-tex">\left\|{\bf U}^{t}\right\|^{2}=m</annotation></semantics></math>.
Based on equation (<a href="#A3.E8" title="In Proof. ‣ Appendix C The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>), we have</span></p>
<table id="A4.EGx41" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A4.E16.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\left\|{\bf X}^{t+1}-{\bf{1}}{\bar{\bf{x}}}^{t+1}\right\|\\
=&amp;\left\|{\rm AccGossip}({\bf X}^{t}-\eta{\bf U}^{t},K)-\frac{1}{m}{\bf{1}}{\bf{1}}^{\top}{\rm AccGossip}({\bf X}^{t}-\eta{\bf U}^{t},K)\right\|\\
\leq&amp;\rho\left\|{\bf X}^{t}-\eta{\bf U}^{t}-\frac{1}{m}{\bf{1}}{\bf{1}}^{\top}({\bf X}^{t}-\eta{\bf U}^{t})\right\|\\
=&amp;\rho\left\|{\bf X}^{t}-\eta{\bf U}^{t}-{\bf{1}}({\bar{\bf{x}}}^{t}-\eta{\bar{\bf{u}}}^{t})\right\|\\
\leq&amp;\rho\left(\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+\eta\left\|{\bf U}^{t}-{\bf{1}}{\bar{\bf{u}}}^{t}\right\|\right)\\
\leq&amp;\rho\left(\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+m\eta\right),\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow></mrow><mo>‖</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>‖</mo><mrow><mrow><mi>AccGossip</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐔</mi><mi>t</mi></msup></mrow></mrow><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mn>𝟏𝟏</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>AccGossip</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐔</mi><mi>t</mi></msup></mrow></mrow><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐔</mi><mi>t</mi></msup></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mn>𝟏𝟏</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐔</mi><mi>t</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐔</mi><mi>t</mi></msup></mrow><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo>−</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐮</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mo>+</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐔</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐮</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\left\|{\bf X}^{t+1}-{\bf{1}}{\bar{\bf{x}}}^{t+1}\right\|\\
=&amp;\left\|{\rm AccGossip}({\bf X}^{t}-\eta{\bf U}^{t},K)-\frac{1}{m}{\bf{1}}{\bf{1}}^{\top}{\rm AccGossip}({\bf X}^{t}-\eta{\bf U}^{t},K)\right\|\\
\leq&amp;\rho\left\|{\bf X}^{t}-\eta{\bf U}^{t}-\frac{1}{m}{\bf{1}}{\bf{1}}^{\top}({\bf X}^{t}-\eta{\bf U}^{t})\right\|\\
=&amp;\rho\left\|{\bf X}^{t}-\eta{\bf U}^{t}-{\bf{1}}({\bar{\bf{x}}}^{t}-\eta{\bar{\bf{u}}}^{t})\right\|\\
\leq&amp;\rho\left(\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+\eta\left\|{\bf U}^{t}-{\bf{1}}{\bar{\bf{u}}}^{t}\right\|\right)\\
\leq&amp;\rho\left(\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|+m\eta\right),\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A4.p1.3" class="ltx_p"><span id="A4.p1.3.1" class="ltx_text">where the first inequality is based on Proposition <a href="#Thmprop2" title="Proposition 2 ( [ , Proposition 1] ). ‣ 2 Preliminaries ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>;
the second inequality is based on the triangle inequality;
the last step applies Lemma <a href="#Thmlem4" title="Lemma 4 ( [ , Lemma 12] ). ‣ Appendix A Some Technical Lemmas ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> which leads to</span></p>
<table id="A4.EGx42" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex38.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bf U}^{t}-{\bf{1}}{\bar{\bf{u}}}^{t}\right\|^{2}\leq\left\|{\bf U}^{t}\right\|^{2}=m." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>‖</mo><mrow><msup><mi>𝐔</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐮</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><msup><mrow><mo>‖</mo><msup><mi>𝐔</mi><mi>t</mi></msup><mo>‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mi>m</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|{\bf U}^{t}-{\bf{1}}{\bar{\bf{u}}}^{t}\right\|^{2}\leq\left\|{\bf U}^{t}\right\|^{2}=m.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.p2" class="ltx_para ltx_noindent">
<p id="A4.p2.1" class="ltx_p"><span id="A4.p2.1.1" class="ltx_text">Based on equation (<a href="#A4.E16" title="In Proof. ‣ Appendix D The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), we have</span></p>
<table id="A4.EGx43" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex39.m1" class="ltx_Math" alttext="\displaystyle\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex39.m2" class="ltx_Math" alttext="\displaystyle\rho^{t}\left(\left\|{\bf X}^{0}-{\bf{1}}{\bar{\bf{x}}}^{0}\right\|-\frac{\rho m\eta}{1-\rho}\right)+\frac{\rho m\eta}{1-\rho}\leq\frac{\rho m\eta}{1-\rho}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msup><mi>ρ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mn>0</mn></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mn>0</mn></msup></mrow></mrow><mo>‖</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow></mfrac></mstyle></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\rho^{t}\left(\left\|{\bf X}^{0}-{\bf{1}}{\bar{\bf{x}}}^{0}\right\|-\frac{\rho m\eta}{1-\rho}\right)+\frac{\rho m\eta}{1-\rho}\leq\frac{\rho m\eta}{1-\rho},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.2" class="ltx_p"><span id="A4.p2.2.1" class="ltx_text">where the first inequality is based on the initialization such that <math id="A4.p2.m1" class="ltx_Math" alttext="{\bf{x}}_{i}^{0}=\bar{\bf{x}}^{0}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐱</mi><mi>i</mi><mn>0</mn></msubsup><mo>=</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mn>0</mn></msup></mrow><annotation encoding="application/x-tex">{\bf{x}}_{i}^{0}=\bar{\bf{x}}^{0}</annotation></semantics></math> for each <math id="A4.p2.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</span></p>
</div>
<div id="A4.p3" class="ltx_para">
<p id="A4.p3.1" class="ltx_p"><span id="A4.p3.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>The Proof of Lemma <a href="#Thmlem3" title="Lemma 3. ‣ 4 The Complexity Analysis ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h2>

<div id="A5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p1" class="ltx_para ltx_noindent">
<p id="A5.p1.1" class="ltx_p"><span id="A5.p1.1.1" class="ltx_text">We denote</span></p>
<table id="A5.EGx44" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex40.m1" class="ltx_Math" alttext="\displaystyle\nabla{\bf{f}}({\bf X}^{t})=\begin{bmatrix}\nabla f_{1}({\bf{x}}_{1}^{t})^{\top}\\
\vdots\\
\nabla f_{m}({\bf{x}}_{m}^{t})^{\top}\\
\end{bmatrix}\in{\mathbb{R}}^{m\times d}\qquad\text{and}\qquad\nabla{\bf{f}}({\bf X}^{t+1})=\begin{bmatrix}\nabla f_{1}({\bf{x}}_{1}^{t+1})^{\top}\\
\vdots\\
\nabla f_{m}({\bf{x}}_{m}^{t+1})^{\top}\\
\end{bmatrix}\in{\mathbb{R}}^{m\times d}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mo rspace="0.167em">∇</mo><mi>f</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mi>𝐱</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mi>t</mi></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><mo rspace="0.167em">∇</mo><mi>f</mi><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">(</mo><mi>𝐱</mi><msub><mrow></mrow><mi>m</mi></msub><msup><mrow></mrow><mi>t</mi></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><mspace style="width:2em;" width="2em"></mspace><mtext>and</mtext><mspace style="width:2.167em;" width="2.167em"></mspace><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>𝐟</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mo rspace="0.167em">∇</mo><mi>f</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mi>𝐱</mi><msub><mrow></mrow><mn>1</mn></msub><msup><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><mrow><mo rspace="0.167em">∇</mo><mi>f</mi><msub><mrow></mrow><mi>m</mi></msub><mo stretchy="false">(</mo><mi>𝐱</mi><msub><mrow></mrow><mi>m</mi></msub><msup><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla{\bf{f}}({\bf X}^{t})=\begin{bmatrix}\nabla f_{1}({\bf{x}}_{1}^{t})^{\top}\\
\vdots\\
\nabla f_{m}({\bf{x}}_{m}^{t})^{\top}\\
\end{bmatrix}\in{\mathbb{R}}^{m\times d}\qquad\text{and}\qquad\nabla{\bf{f}}({\bf X}^{t+1})=\begin{bmatrix}\nabla f_{1}({\bf{x}}_{1}^{t+1})^{\top}\\
\vdots\\
\nabla f_{m}({\bf{x}}_{m}^{t+1})^{\top}\\
\end{bmatrix}\in{\mathbb{R}}^{m\times d}.</annotation></semantics></math></td>
