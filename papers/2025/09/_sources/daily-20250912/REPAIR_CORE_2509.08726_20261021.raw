<td id="S6.F1.2.1.2" class="ltx_td ltx_align_center"><object type="image/svg+xml" data="2509.08726v1/mnist_gn_com.svg" id="S6.F1.g2" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:219/146;" width="219" height="146"></object></td></tr>
