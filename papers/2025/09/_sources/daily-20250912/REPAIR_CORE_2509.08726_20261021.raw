<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex61.m1" class="ltx_Math" alttext="\displaystyle\begin{cases}2\sqrt{2}M_{0}+\rho(3(M_{0}+M_{1}L_{f}\eta)+2M_{2})\leq 3M_{0},\\[2.84544pt]
2\sqrt{2}M_{1}+\rho\left(3M_{1}(1+L_{1}\eta)+2M_{3}\right)\leq 3M_{1},\\[2.84544pt]
\eta+2\rho\eta\leq 2\eta,\\[4.26773pt]
\rho\Big(3\sqrt{m}\eta M_{1}(1+L_{1}\eta)+2\sqrt{m}\eta M_{3}\Big)\leq\dfrac{1}{8},\\[7.11317pt]
\dfrac{2\sigma}{\sqrt{mb}}+\rho\Big(3\sqrt{m}\eta(M_{0}+M_{1}L_{f}\eta)+2\sqrt{m}\eta M_{2}\Big)\leq\dfrac{\eta L_{f}}{4}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>3</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>η</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>3</mn></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>8</mn></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msqrt><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msqrt></mfrac></mstyle><mo>+</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mn>4</mn></mfrac></mstyle></mrow></mtd><mtd></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}2\sqrt{2}M_{0}+\rho(3(M_{0}+M_{1}L_{f}\eta)+2M_{2})\leq 3M_{0},\\[2.84544pt]
2\sqrt{2}M_{1}+\rho\left(3M_{1}(1+L_{1}\eta)+2M_{3}\right)\leq 3M_{1},\\[2.84544pt]
\eta+2\rho\eta\leq 2\eta,\\[4.26773pt]
\rho\Big(3\sqrt{m}\eta M_{1}(1+L_{1}\eta)+2\sqrt{m}\eta M_{3}\Big)\leq\dfrac{1}{8},\\[7.11317pt]
\dfrac{2\sigma}{\sqrt{mb}}+\rho\Big(3\sqrt{m}\eta(M_{0}+M_{1}L_{f}\eta)+2\sqrt{m}\eta M_{2}\Big)\leq\dfrac{\eta L_{f}}{4}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p1.3" class="ltx_p">that holds by taking <math id="A6.p1.m3" class="ltx_Math" alttext="b\geq\left\lceil{256\sigma^{2}}/(m\eta^{2}L_{f}^{2})\right\rceil" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>≥</mo><mrow><mo>⌈</mo><mrow><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mi>f</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⌉</mo></mrow></mrow><annotation encoding="application/x-tex">b\geq\left\lceil{256\sigma^{2}}/(m\eta^{2}L_{f}^{2})\right\rceil</annotation></semantics></math>
and</p>
<table id="A6.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex62.m1" class="ltx_math_unparsed" alttext="\displaystyle\rho\leq\min\Bigg\{" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>≤</mo><mi>min</mi><mo stretchy="false">{</mo></mrow><annotation encoding="application/x-tex">\displaystyle\rho\leq\min\Bigg\{</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex62.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{1+m\eta L_{1}},\frac{(3-2\sqrt{2})M_{0}}{3(M_{0}+M_{1}L_{f}\eta)+2M_{2}},\frac{(3-2\sqrt{2})M_{1}}{3M_{1}(1+L_{1}\eta)+2M_{3}},\frac{1}{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>3</mn></msub></mrow></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{1+m\eta L_{1}},\frac{(3-2\sqrt{2})M_{0}}{3(M_{0}+M_{1}L_{f}\eta)+2M_{2}},\frac{(3-2\sqrt{2})M_{1}}{3M_{1}(1+L_{1}\eta)+2M_{3}},\frac{1}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex63.m1" class="ltx_math_unparsed" alttext="\displaystyle\dfrac{1}{8(3\sqrt{m}\eta M_{1}(1+L_{1}\eta)+2\sqrt{m}\eta M_{3})},\dfrac{\eta L_{f}}{8(3\sqrt{m}\eta(M_{0}+M_{1}L_{f}\eta)+2\sqrt{m}\eta M_{2})}\Bigg\}." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>3</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>+</mo><mrow><msub><mi>M</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo stretchy="false">}</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\dfrac{1}{8(3\sqrt{m}\eta M_{1}(1+L_{1}\eta)+2\sqrt{m}\eta M_{3})},\dfrac{\eta L_{f}}{8(3\sqrt{m}\eta(M_{0}+M_{1}L_{f}\eta)+2\sqrt{m}\eta M_{2})}\Bigg\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p1.4" class="ltx_p">Recall that we have
<math id="A6.p1.m4" class="ltx_Math" alttext="L_{1}\eta\leq 1/2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">L_{1}\eta\leq 1/2</annotation></semantics></math>, <math id="A6.p1.m5" class="ltx_Math" alttext="M_{0}=\Theta(L_{f})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>0</mn></msub><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{0}=\Theta(L_{f})</annotation></semantics></math>, <math id="A6.p1.m6" class="ltx_Math" alttext="M_{1}=\Theta(L_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>1</mn></msub><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{1}=\Theta(L_{1})</annotation></semantics></math>, <math id="A6.p1.m7" class="ltx_Math" alttext="M_{2}\leq\Theta(L_{f})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>2</mn></msub><mo>≤</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>f</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{2}\leq\Theta(L_{f})</annotation></semantics></math>, and <math id="A6.p1.m8" class="ltx_Math" alttext="M_{3}\leq\Theta(L_{1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mn>3</mn></msub><mo>≤</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{3}\leq\Theta(L_{1})</annotation></semantics></math>,
which means we require</p>
<table id="A6.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex64.m1" class="ltx_Math" alttext="\displaystyle\rho\leq{\mathcal{O}}\left(\frac{1}{\sqrt{m}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\rho\leq{\mathcal{O}}\left(\frac{1}{\sqrt{m}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p1.5" class="ltx_p">This can be achieved by taking</p>
<table id="A6.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex65.m1" class="ltx_Math" alttext="\displaystyle K={\mathcal{O}}\left(\frac{\log m}{\sqrt{\gamma}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>m</mi></mrow><msqrt><mi>γ</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle K={\mathcal{O}}\left(\frac{\log m}{\sqrt{\gamma}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.p2" class="ltx_para ltx_noindent">
<p id="A6.p2.1" class="ltx_p">Following the setting <math id="A6.p2.m1" class="ltx_Math" alttext="\eta=\min\left\{\epsilon/(4L_{f}+1),1/(2L_{1})\right\}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>ϵ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta=\min\left\{\epsilon/(4L_{f}+1),1/(2L_{1})\right\}</annotation></semantics></math>, we have</p>
<table id="A6.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex66.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]\leq\frac{{\mathbb{E}}[8(\Phi^{t}-\Phi^{t+1})]}{5\eta}+\frac{6\eta L_{f}}{5}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mi>t</mi></msup><mo>−</mo><msup><mi mathvariant="normal">Φ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mn>5</mn></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]\leq\frac{{\mathbb{E}}[8(\Phi^{t}-\Phi^{t+1})]}{5\eta}+\frac{6\eta L_{f}}{5}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A6.p3" class="ltx_para ltx_noindent">
<p id="A6.p3.1" class="ltx_p">Taking the average on above inequalities with <math id="A6.p3.m1" class="ltx_Math" alttext="t=0,\dots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=0,\dots,T-1</annotation></semantics></math>, we have</p>
<table id="A6.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex67.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]\leq{\mathbb{E}}\left[\frac{8(\Phi^{0}-\Phi^{T})}{5\eta T}+\frac{6\eta L_{f}}{5}\right]\leq\frac{8\Delta_{\Phi}}{5\eta T}+\frac{6\eta L_{f}}{5}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mn>0</mn></msup><mo>−</mo><msup><mi mathvariant="normal">Φ</mi><mi>T</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mn>5</mn></mfrac></mstyle></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mn>5</mn></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]\leq{\mathbb{E}}\left[\frac{8(\Phi^{0}-\Phi^{T})}{5\eta T}+\frac{6\eta L_{f}}{5}\right]\leq\frac{8\Delta_{\Phi}}{5\eta T}+\frac{6\eta L_{f}}{5},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p3.2" class="ltx_p">where the last step holds due to</p>
<table id="A6.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex68.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi^{0}-\Phi^{T}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi mathvariant="normal">Φ</mi><mn>0</mn></msup><mo>−</mo><msup><mi mathvariant="normal">Φ</mi><mi>T</mi></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi^{0}-\Phi^{T}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex69.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex69.m2" class="ltx_math_unparsed" alttext="\displaystyle{\mathbb{E}}\Bigg[f({\bar{\bf{x}}}^{0})+\frac{3\eta}{\sqrt{m}}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{0})\right\|\right)\left\|{\bf X}^{0}-{\bf{1}}{\bar{\bf{x}}}^{0}\right\|+\frac{2\eta}{\sqrt{m}}\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mn>0</mn></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mrow><mo>(</mo><msub><mi>M</mi><mn>0</mn></msub><mo>+</mo><msub><mi>M</mi><mn>1</mn></msub><mrow><mo>‖</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mn>0</mn></msup><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mo>)</mo></mrow><mrow><mo>‖</mo><msup><mi>𝐗</mi><mn>0</mn></msup><mo>−</mo><mn>𝟏</mn><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mn>0</mn></msup><mo>‖</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mrow><mo>‖</mo><msup><mi>𝐕</mi><mn>0</mn></msup><mo>−</mo><mn>𝟏</mn><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mn>0</mn></msup><mo>‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\Bigg[f({\bar{\bf{x}}}^{0})+\frac{3\eta}{\sqrt{m}}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{0})\right\|\right)\left\|{\bf X}^{0}-{\bf{1}}{\bar{\bf{x}}}^{0}\right\|+\frac{2\eta}{\sqrt{m}}\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex70.m1" class="ltx_math_unparsed" alttext="\displaystyle-\left(f({\bar{\bf{x}}}^{T})+\frac{3\eta}{\sqrt{m}}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{T})\right\|\right)\left\|{\bf X}^{T}-{\bf{1}}{\bar{\bf{x}}}^{T}\right\|+\frac{2\eta}{\sqrt{m}}\left\|{\bf V}^{T}-{\bf{1}}{\bar{\bf{v}}}^{T}\right\|\right)\Bigg]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo>(</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>T</mi></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mrow><mo>(</mo><msub><mi>M</mi><mn>0</mn></msub><mo>+</mo><msub><mi>M</mi><mn>1</mn></msub><mrow><mo>‖</mo><mo rspace="0.167em">∇</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>T</mi></msup><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mo>)</mo></mrow><mrow><mo>‖</mo><msup><mi>𝐗</mi><mi>T</mi></msup><mo>−</mo><mn>𝟏</mn><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>T</mi></msup><mo>‖</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mrow><mo>‖</mo><msup><mi>𝐕</mi><mi>T</mi></msup><mo>−</mo><mn>𝟏</mn><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mi>T</mi></msup><mo>‖</mo></mrow><mo>)</mo></mrow><mo maxsize="2.600em" minsize="2.600em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\left(f({\bar{\bf{x}}}^{T})+\frac{3\eta}{\sqrt{m}}\left(M_{0}+M_{1}\left\|\nabla f({\bar{\bf{x}}}^{T})\right\|\right)\left\|{\bf X}^{T}-{\bf{1}}{\bar{\bf{x}}}^{T}\right\|+\frac{2\eta}{\sqrt{m}}\left\|{\bf V}^{T}-{\bf{1}}{\bar{\bf{v}}}^{T}\right\|\right)\Bigg]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A6.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.Ex71.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex71.m2" class="ltx_Math" alttext="\displaystyle f({\bar{\bf{x}}}^{0})-\inf_{{\bf{x}}\in{\mathbb{R}}^{d}}f({\bf{x}})+\frac{2\eta}{\sqrt{m}}{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|\right]=\Delta_{\Phi}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mn>0</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></munder><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐕</mi><mn>0</mn></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mn>0</mn></msup></mrow></mrow><mo>‖</mo></mrow><mo>]</mo></mrow></mrow></mrow><mo>=</mo><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle f({\bar{\bf{x}}}^{0})-\inf_{{\bf{x}}\in{\mathbb{R}}^{d}}f({\bf{x}})+\frac{2\eta}{\sqrt{m}}{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|\right]=\Delta_{\Phi}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.p3.3" class="ltx_p">We consider the following case for the choice of <math id="A6.p3.m2" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>:</p>
<ol id="A6.I1" class="ltx_enumerate">
<li id="A6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A6.I1.i1.p1" class="ltx_para ltx_noindent">
<p id="A6.I1.i1.p1.1" class="ltx_p">In the case of <math id="A6.I1.i1.p1.m1" class="ltx_Math" alttext="\epsilon/(4L_{f}+1)\leq 1/(2L_{1})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϵ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\epsilon/(4L_{f}+1)\leq 1/(2L_{1})</annotation></semantics></math>, we follow the setting</p>
<table id="A6.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E24.m1" class="ltx_math_unparsed" alttext="\displaystyle\eta=\frac{\epsilon}{4L_{f}+1},\quad b\geq\left\lceil\frac{256(4L_{f}+1)^{2}\sigma^{2}}{mL_{f}^{2}\epsilon^{2}}\right\rceil,\quad\text{and}\quad T\geq\frac{8\Delta_{\Phi}}{\eta\epsilon}=\frac{8(4L_{f}+1)\Delta_{\Phi}}{\epsilon^{2}}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo rspace="1.167em">,</mo><mi>b</mi><mo>≥</mo><mrow><mo>⌈</mo><mstyle displaystyle="true"><mfrac><mrow><mn>256</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mi>f</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>⌉</mo></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext><mi>T</mi><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub></mrow><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\eta=\frac{\epsilon}{4L_{f}+1},\quad b\geq\left\lceil\frac{256(4L_{f}+1)^{2}\sigma^{2}}{mL_{f}^{2}\epsilon^{2}}\right\rceil,\quad\text{and}\quad T\geq\frac{8\Delta_{\Phi}}{\eta\epsilon}=\frac{8(4L_{f}+1)\Delta_{\Phi}}{\epsilon^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A6.I1.i1.p1.2" class="ltx_p">to obtain</p>
<table id="A6.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex72.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]\leq\frac{\epsilon}{5}+\frac{3\epsilon}{10}=\frac{\epsilon}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>5</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mn>10</mn></mfrac></mstyle></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>2</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]\leq\frac{\epsilon}{5}+\frac{3\epsilon}{10}=\frac{\epsilon}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A6.I1.i2.p1" class="ltx_para">
<p id="A6.I1.i2.p1.1" class="ltx_p">In the case of <math id="A6.I1.i2.p1.m1" class="ltx_Math" alttext="1/(2L_{1})\leq\epsilon/(4L_{f}+1)" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>ϵ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1/(2L_{1})\leq\epsilon/(4L_{f}+1)</annotation></semantics></math>, we follow the setting</p>
<table id="A6.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A6.E25.m1" class="ltx_math_unparsed" alttext="\displaystyle\eta=\frac{1}{2L_{1}},\qquad b\geq\left\lceil\frac{1024L_{1}^{2}\sigma^{2}}{mL_{f}^{2}}\right\rceil,\qquad\text{and}\qquad T\geq\frac{16L_{1}\Delta_{\Phi}}{\epsilon}." display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo rspace="2.167em">,</mo><mi>b</mi><mo>≥</mo><mrow><mo>⌈</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1024</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mi>f</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>⌉</mo></mrow><mo rspace="2.167em">,</mo><mtext>and</mtext><mi>T</mi><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mi>ϵ</mi></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta=\frac{1}{2L_{1}},\qquad b\geq\left\lceil\frac{1024L_{1}^{2}\sigma^{2}}{mL_{f}^{2}}\right\rceil,\qquad\text{and}\qquad T\geq\frac{16L_{1}\Delta_{\Phi}}{\epsilon}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A6.I1.i2.p1.2" class="ltx_p">to obtain</p>
<table id="A6.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A6.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex73.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]\leq\frac{\epsilon}{5}+\frac{3\epsilon}{10}=\frac{\epsilon}{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>5</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mn>10</mn></mfrac></mstyle></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>2</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]\leq\frac{\epsilon}{5}+\frac{3\epsilon}{10}=\frac{\epsilon}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="A6.p3.4" class="ltx_p">Hence, we finish the proof.</p>
</div>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>The Proof of Corollary <a href="#Thmcor1" title="Corollary 1. ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></h2>

<div id="A7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A7.p1" class="ltx_para ltx_noindent">
<p id="A7.p1.1" class="ltx_p"><span id="A7.p1.1.1" class="ltx_text">We first provide the upper bound for <math id="A7.p1.m1" class="ltx_Math" alttext="{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐕</mi><mn>0</mn></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mn>0</mn></msup></mrow></mrow><mo>‖</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|\right]</annotation></semantics></math>.
Let <math id="A7.p1.m2" class="ltx_Math" alttext="{\bar{\bf{g}}}^{0}=\frac{1}{m}{\bf{1}}^{\top}{\bf G}^{0}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>𝐠</mi><mo>¯</mo></mover><mn>0</mn></msup><mo>=</mo><mrow><mfrac><mn>1</mn><mi>m</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mn>𝟏</mn><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐆</mi><mn>0</mn></msup></mrow></mrow><annotation encoding="application/x-tex">{\bar{\bf{g}}}^{0}=\frac{1}{m}{\bf{1}}^{\top}{\bf G}^{0}</annotation></semantics></math>, then we have</span></p>
<table id="A7.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex74.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|^{2}\right]\leq{\mathbb{E}}\left[\hat{\rho}^{2}\left\|{\bf G}^{0}-{\bf{1}}{\bar{\bf{g}}}^{0}\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝐕</mi><mn>0</mn></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mn>0</mn></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝐆</mi><mn>0</mn></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐠</mi><mo>¯</mo></mover><mn>0</mn></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|^{2}\right]\leq{\mathbb{E}}\left[\hat{\rho}^{2}\left\|{\bf G}^{0}-{\bf{1}}{\bar{\bf{g}}}^{0}\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex75.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex75.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\hat{\rho}^{2}\left\|{\bf G}^{0}\right\|^{2}\right]=\hat{\rho}^{2}\sum_{i=1}^{m}{\mathbb{E}}\left\|\frac{1}{b}\sum_{k=1}^{b}\nabla F_{i}({\bf{x}}_{i}^{0};{\bm{\xi}}_{i,k}^{0})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><msup><mi>𝐆</mi><mn>0</mn></msup><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>b</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>F</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mn>0</mn></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\hat{\rho}^{2}\left\|{\bf G}^{0}\right\|^{2}\right]=\hat{\rho}^{2}\sum_{i=1}^{m}{\mathbb{E}}\left\|\frac{1}{b}\sum_{k=1}^{b}\nabla F_{i}({\bf{x}}_{i}^{0};{\bm{\xi}}_{i,k}^{0})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex76.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex76.m2" class="ltx_Math" alttext="\displaystyle 2\hat{\rho}^{2}\sum_{i=1}^{m}\left({\mathbb{E}}\left[\left\|\frac{1}{b}\sum_{k=1}^{b}\nabla F_{i}({\bf{x}}_{i}^{0};{\bm{\xi}}_{i,k}^{0})-\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}+\left\|\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}\right]\right)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msup><mrow><mo>‖</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>b</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>b</mi></munderover></mstyle><mrow><mrow><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>F</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mn>0</mn></msubsup><mo>,</mo><msubsup><mi>𝝃</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\hat{\rho}^{2}\sum_{i=1}^{m}\left({\mathbb{E}}\left[\left\|\frac{1}{b}\sum_{k=1}^{b}\nabla F_{i}({\bf{x}}_{i}^{0};{\bm{\xi}}_{i,k}^{0})-\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}+\left\|\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}\right]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex77.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex77.m2" class="ltx_Math" alttext="\displaystyle 2\hat{\rho}^{2}\sum_{i=1}^{m}\left(\frac{\sigma^{2}}{b}+\left\|\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}\right)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>2</mn></msup><mi>b</mi></mfrac></mstyle><mo>+</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\hat{\rho}^{2}\sum_{i=1}^{m}\left(\frac{\sigma^{2}}{b}+\left\|\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex78.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex78.m2" class="ltx_Math" alttext="\displaystyle 2\hat{\rho}^{2}\left(\frac{m\sigma^{2}}{b}+\sum_{i=1}^{m}\left\|\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mi>b</mi></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></munderover></mstyle><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\hat{\rho}^{2}\left(\frac{m\sigma^{2}}{b}+\sum_{i=1}^{m}\left\|\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p1.2" class="ltx_p"><span id="A7.p1.2.1" class="ltx_text">Hence, we require</span></p>
<table id="A7.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex79.m1" class="ltx_Math" alttext="\displaystyle\hat{\rho}\leq\frac{\sqrt{m}\Delta_{f}}{2\sqrt{2}\eta\sqrt{{m\sigma^{2}}/{b}+\sum_{i=1}^{m}\left\|\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>f</mi></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>b</mi></mrow><mo rspace="0.055em">+</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\rho}\leq\frac{\sqrt{m}\Delta_{f}}{2\sqrt{2}\eta\sqrt{{m\sigma^{2}}/{b}+\sum_{i=1}^{m}\left\|\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p1.3" class="ltx_p"><span id="A7.p1.3.1" class="ltx_text">to guarantee</span></p>
<table id="A7.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.E26.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|\right]\leq\sqrt{{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|^{2}\right]}\leq\frac{\sqrt{m}\Delta_{f}}{2\eta}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐕</mi><mn>0</mn></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mn>0</mn></msup></mrow></mrow><mo>‖</mo></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msup><mi>𝐕</mi><mn>0</mn></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mn>0</mn></msup></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></msqrt><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>f</mi></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|\right]\leq\sqrt{{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|^{2}\right]}\leq\frac{\sqrt{m}\Delta_{f}}{2\eta},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A7.p1.4" class="ltx_p"><span id="A7.p1.4.1" class="ltx_text">where the first step is based on Jensen’s inequality.
Consequently, we have</span></p>
<table id="A7.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex80.m1" class="ltx_Math" alttext="\displaystyle\Delta_{\Phi}=f({\bar{\bf{x}}}^{0})-\inf_{{\bf{x}}\in{\mathbb{R}}^{d}}f({\bf{x}})+\frac{2\eta}{\sqrt{m}}{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|\right]\leq 2\Delta_{f}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo>=</mo><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mn>0</mn></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mi>𝐱</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></munder><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><msqrt><mi>m</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐕</mi><mn>0</mn></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐯</mi><mo>¯</mo></mover><mn>0</mn></msup></mrow></mrow><mo>‖</mo></mrow><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>f</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{\Phi}=f({\bar{\bf{x}}}^{0})-\inf_{{\bf{x}}\in{\mathbb{R}}^{d}}f({\bf{x}})+\frac{2\eta}{\sqrt{m}}{\mathbb{E}}\left[\left\|{\bf V}^{0}-{\bf{1}}{\bar{\bf{v}}}^{0}\right\|\right]\leq 2\Delta_{f}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p1.5" class="ltx_p"><span id="A7.p1.5.1" class="ltx_text">and the requirement of above <math id="A7.p1.m3" class="ltx_Math" alttext="\hat{\rho}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\rho}</annotation></semantics></math> can be satasfied by taking</span></p>
<table id="A7.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex81.m1" class="ltx_Math" alttext="\displaystyle\hat{K}\geq\left\lceil\frac{1}{\sqrt{\gamma}}\log\frac{2\sqrt{2}\eta\sqrt{{m\sigma^{2}}/{b}+\sum_{i=1}^{m}\left\|\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}}}{\sqrt{m}\Delta_{f}}\right\rceil=\tilde{\mathcal{O}}\left(\frac{1}{\sqrt{\gamma}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>≥</mo><mrow><mo>⌈</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>γ</mi></msqrt></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mn>2</mn></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>b</mi></mrow><mo rspace="0.055em">+</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mrow><mrow><msqrt><mi>m</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>f</mi></msub></mrow></mfrac></mstyle></mrow></mrow><mo>⌉</mo></mrow><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>γ</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hat{K}\geq\left\lceil\frac{1}{\sqrt{\gamma}}\log\frac{2\sqrt{2}\eta\sqrt{{m\sigma^{2}}/{b}+\sum_{i=1}^{m}\left\|\nabla f_{i}({\bf{x}}_{i}^{0})\right\|^{2}}}{\sqrt{m}\Delta_{f}}\right\rceil=\tilde{\mathcal{O}}\left(\frac{1}{\sqrt{\gamma}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p1.6" class="ltx_p"><span id="A7.p1.6.1" class="ltx_text">Therefore, the term <math id="A7.p1.m4" class="ltx_Math" alttext="\Delta_{\Phi}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><annotation encoding="application/x-tex">\Delta_{\Phi}</annotation></semantics></math> in the setting of <math id="A7.p1.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> presented in Theorem <a href="#Thmthm1" title="Theorem 1. ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> can be replaced by <math id="A7.p1.m6" class="ltx_Math" alttext="2\Delta_{f}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>f</mi></msub></mrow><annotation encoding="application/x-tex">2\Delta_{f}</annotation></semantics></math>.</span></p>
</div>
<div id="A7.p2" class="ltx_para ltx_noindent">
<p id="A7.p2.1" class="ltx_p"><span id="A7.p2.1.1" class="ltx_text">We then consider how to making the gradient small on each node.
Specifically, we have</span></p>
<table id="A7.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex82.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\left\|\nabla f(\hat{\bf{x}}_{i})\right\|\right]=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝐱</mi><mo>^</mo></mover><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\left\|\nabla f(\hat{\bf{x}}_{i})\right\|\right]=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex82.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bf{x}}_{i}^{t})\right\|\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bf{x}}_{i}^{t})\right\|\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex83.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex83.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bf{x}}_{i}^{t})-\nabla f({\bar{\bf{x}}}^{t})\right\|+\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bf{x}}_{i}^{t})-\nabla f({\bar{\bf{x}}}^{t})\right\|+\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex84.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex84.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\big(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\big)\left\|{\bf{x}}_{i}^{t}-{\bar{\bf{x}}}^{t}\right\|+\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msubsup><mi>𝐱</mi><mi>i</mi><mi>t</mi></msubsup><mo>−</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\big(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\big)\left\|{\bf{x}}_{i}^{t}-{\bar{\bf{x}}}^{t}\right\|+\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex85.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex85.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\big(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\big)\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|\right]+\frac{\epsilon}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msup><mi>𝐗</mi><mi>t</mi></msup><mo>−</mo><mrow><mn>𝟏</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup></mrow></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\big(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\big)\left\|{\bf X}^{t}-{\bf{1}}{\bar{\bf{x}}}^{t}\right\|\right]+\frac{\epsilon}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex86.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex86.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\frac{\rho m\eta\big(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\big)}{1-\rho}\right]+\frac{\epsilon}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow></mfrac></mstyle></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\frac{1}{T}\sum_{t=0}^{T-1}\frac{\rho m\eta\big(L_{f}+L_{1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\big)}{1-\rho}\right]+\frac{\epsilon}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex87.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex87.m2" class="ltx_Math" alttext="\displaystyle\frac{\rho m\eta\left(L_{f}+{\mathbb{E}}\left[\frac{L_{1}}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]\right)}{1-\rho}+\frac{\epsilon}{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mfrac><msub><mi>L</mi><mn>1</mn></msub><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\rho m\eta\left(L_{f}+{\mathbb{E}}\left[\frac{L_{1}}{T}\sum_{t=0}^{T-1}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|\right]\right)}{1-\rho}+\frac{\epsilon}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A7.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex88.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A7.Ex88.m2" class="ltx_Math" alttext="\displaystyle\frac{\rho m\eta\big(L_{f}+L_{1}\epsilon/2\big)}{1-\rho}+\frac{\epsilon}{2}\leq\epsilon," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>L</mi><mi>f</mi></msub><mo>+</mo><mrow><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mo>/</mo><mn>2</mn></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mn>2</mn></mfrac></mstyle></mrow><mo>≤</mo><mi>ϵ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\rho m\eta\big(L_{f}+L_{1}\epsilon/2\big)}{1-\rho}+\frac{\epsilon}{2}\leq\epsilon,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p2.2" class="ltx_p"><span id="A7.p2.2.1" class="ltx_text">where the first step is based on the triangle inequality;
the second step is based on Proposition <a href="#Thmprop1" title="Proposition 1. ‣ 2 Preliminaries ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and equation (<a href="#A5.E18" title="In Proof. ‣ Appendix E The Proof of Lemma ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>);
the third step is based on Theorem <a href="#Thmthm1" title="Theorem 1. ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>;
the fourth step is based on Lemma <a href="#Thmlem2" title="Lemma 2. ‣ 4 The Complexity Analysis ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>;
the last line requires</span></p>
<table id="A7.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex89.m1" class="ltx_Math" alttext="\displaystyle\rho\leq\frac{\epsilon}{2m\eta L_{f}+(m\eta L_{1}+1)\epsilon}," display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>≤</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\rho\leq\frac{\epsilon}{2m\eta L_{f}+(m\eta L_{1}+1)\epsilon},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p2.3" class="ltx_p"><span id="A7.p2.3.1" class="ltx_text">which can be satisfies by taking <math id="A7.p2.m1" class="ltx_Math" alttext="K=\tilde{\mathcal{O}}(\sqrt{1/\gamma})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mn>1</mn><mo>/</mo><mi>γ</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K=\tilde{\mathcal{O}}(\sqrt{1/\gamma})</annotation></semantics></math>.</span></p>
</div>
<div id="A7.p3" class="ltx_para">
<p id="A7.p3.1" class="ltx_p"><span id="A7.p3.1.1" class="ltx_text">In summary, the communication complexity is</span></p>
<table id="A7.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex90.m1" class="ltx_Math" alttext="\displaystyle\hat{K}+TK=\tilde{\mathcal{O}}\left(\left(\frac{L_{f}}{\epsilon^{2}}+\frac{L_{1}}{\epsilon}\right)\frac{\Delta_{f}}{\sqrt{\gamma}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>K</mi><mo>^</mo></mover><mo>+</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>L</mi><mi>f</mi></msub><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>L</mi><mn>1</mn></msub><mi>ϵ</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mi mathvariant="normal">Δ</mi><mi>f</mi></msub><msqrt><mi>γ</mi></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hat{K}+TK=\tilde{\mathcal{O}}\left(\left(\frac{L_{f}}{\epsilon^{2}}+\frac{L_{1}}{\epsilon}\right)\frac{\Delta_{f}}{\sqrt{\gamma}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p3.2" class="ltx_p"><span id="A7.p3.2.1" class="ltx_text">Following equations (<a href="#A6.E24" title="In item 1 ‣ Appendix F The proof of Theorem ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>), (<a href="#A6.E25" title="In item 2 ‣ Appendix F The proof of Theorem ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>), and (<a href="#A7.E26" title="In Proof. ‣ Appendix G The Proof of Corollary ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>), the sample complexity on each node is</span></p>
<table id="A7.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A7.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A7.Ex91.m1" class="ltx_Math" alttext="\displaystyle Tb={\mathcal{O}}\left(\frac{1}{m}\left(\frac{L_{f}\sigma^{2}\Delta}{\epsilon^{4}}+\frac{\sigma^{2}}{\epsilon^{2}}+\frac{L_{1}^{3}\sigma^{2}\Delta}{L_{f}^{2}\epsilon}+\frac{L_{1}^{2}\sigma^{2}}{L_{f}^{2}}\right)\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>L</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><msup><mi>ϵ</mi><mn>4</mn></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mi>σ</mi><mn>2</mn></msup><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>L</mi><mn>1</mn><mn>3</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><mrow><msubsup><mi>L</mi><mi>f</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>L</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><msubsup><mi>L</mi><mi>f</mi><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle Tb={\mathcal{O}}\left(\frac{1}{m}\left(\frac{L_{f}\sigma^{2}\Delta}{\epsilon^{4}}+\frac{\sigma^{2}}{\epsilon^{2}}+\frac{L_{1}^{3}\sigma^{2}\Delta}{L_{f}^{2}\epsilon}+\frac{L_{1}^{2}\sigma^{2}}{L_{f}^{2}}\right)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A7.p3.3" class="ltx_p"><span id="A7.p3.3.1" class="ltx_text">where the terms <math id="A7.p3.m1" class="ltx_Math" alttext="\sigma^{2}/\epsilon^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>/</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\sigma^{2}/\epsilon^{2}</annotation></semantics></math> and <math id="A7.p3.m2" class="ltx_Math" alttext="L_{1}^{2}\sigma^{2}/L_{f}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>L</mi><mn>1</mn><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>/</mo><msubsup><mi>L</mi><mi>f</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">L_{1}^{2}\sigma^{2}/L_{f}^{2}</annotation></semantics></math> come from the initialization on <math id="A7.p3.m3" class="ltx_Math" alttext="{\bf G}^{0}" display="inline" intent=":literal"><semantics><msup><mi>𝐆</mi><mn>0</mn></msup><annotation encoding="application/x-tex">{\bf G}^{0}</annotation></semantics></math> in line <a href="#alg2.l3" title="In Algorithm 2 ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> of Algorithm <a href="#alg2" title="Algorithm 2 ‣ 3 The Algorithm and Main Results ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.
∎</span></p>
</div>
</div>
</section>
<section id="A8" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix H </span>The Proof of Proposition <a href="#Thmprop3" title="Proposition 3. ‣ 5 Discussion and Related Work ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></h2>

<div id="A8.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A8.p1" class="ltx_para ltx_noindent">
<p id="A8.p1.1" class="ltx_p"><span id="A8.p1.1.1" class="ltx_text">We can verify that the (second-order) derivatives of functions <math id="A8.p1.m1" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math>, <math id="A8.p1.m2" class="ltx_Math" alttext="f_{2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>2</mn></msub><annotation encoding="application/x-tex">f_{2}</annotation></semantics></math>, and <math id="A8.p1.m3" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> have the form of</span></p>
<table id="A8.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex92.m1" class="ltx_math_unparsed" alttext="\displaystyle f^{\prime}_{1}(x)=L\exp(Lx),\quad f^{\prime}_{2}(x)=-L\exp(-Lx),\quad\text{and}\quad f^{\prime}(x)=\frac{L\exp(Lx)-L\exp(-Lx)}{2}." display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mn>1</mn><mo>′</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>L</mi><mi>exp</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><msubsup><mi>f</mi><mn>2</mn><mo>′</mo></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>L</mi><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mi>L</mi><mi>x</mi><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext><msup><mi>f</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle f^{\prime}_{1}(x)=L\exp(Lx),\quad f^{\prime}_{2}(x)=-L\exp(-Lx),\quad\text{and}\quad f^{\prime}(x)=\frac{L\exp(Lx)-L\exp(-Lx)}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.p1.2" class="ltx_p"><span id="A8.p1.2.1" class="ltx_text">Note that the function</span></p>
<table id="A8.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex93.m1" class="ltx_Math" alttext="\displaystyle h(z)=\frac{|1-\exp(Lz)|}{L|z|}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>z</mi><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle h(z)=\frac{|1-\exp(Lz)|}{L|z|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.p1.3" class="ltx_p"><span id="A8.p1.3.1" class="ltx_text">is increasing.
Taking <math id="A8.p1.m4" class="ltx_Math" alttext="z=y-x" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>=</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">z=y-x</annotation></semantics></math>, we have</span></p>
<table id="A8.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.E27.m1" class="ltx_Math" alttext="\displaystyle\frac{|1-\exp(L(y-x))|}{L|y-x|}=h(y-x)\leq h\left(\frac{1}{L_{1}}\right)=\frac{|1-\exp(L/L_{1})|}{L/L_{1}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mo>=</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>L</mi><mn>1</mn></msub></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>/</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>L</mi><mo>/</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{|1-\exp(L(y-x))|}{L|y-x|}=h(y-x)\leq h\left(\frac{1}{L_{1}}\right)=\frac{|1-\exp(L/L_{1})|}{L/L_{1}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A8.p1.4" class="ltx_p"><span id="A8.p1.4.1" class="ltx_text">for all <math id="A8.p1.m5" class="ltx_Math" alttext="x,y\in{\mathbb{R}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">x,y\in{\mathbb{R}}</annotation></semantics></math> with <math id="A8.p1.m6" class="ltx_math_unparsed" alttext="|y-x|\in[-1/L_{1},1/L_{1}]" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>y</mi><mo>−</mo><mi>x</mi><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">∈</mo><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><mn>1</mn><mo>/</mo><msub><mi>L</mi><mn>1</mn></msub><mo>,</mo><mn>1</mn><mo>/</mo><msub><mi>L</mi><mn>1</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">|y-x|\in[-1/L_{1},1/L_{1}]</annotation></semantics></math>.</span></p>
</div>
<div id="A8.p2" class="ltx_para ltx_noindent">
<p id="A8.p2.1" class="ltx_p"><span id="A8.p2.1.1" class="ltx_text">For the function <math id="A8.p2.m1" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math>, we have</span></p>
<table id="A8.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex94.m1" class="ltx_Math" alttext="\displaystyle|f^{\prime}_{1}(x)-f^{\prime}_{1}(y)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><msubsup><mi>f</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>f</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|f^{\prime}_{1}(x)-f^{\prime}_{1}(y)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex95.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex95.m2" class="ltx_Math" alttext="\displaystyle|L\exp(Lx)-L\exp(Ly)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|L\exp(Lx)-L\exp(Ly)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex96.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex96.m2" class="ltx_Math" alttext="\displaystyle L\exp(Lx)|1-\exp(L(y-x))|" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle L\exp(Lx)|1-\exp(L(y-x))|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex97.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex97.m2" class="ltx_Math" alttext="\displaystyle L\exp(Lx)\cdot L_{1}|1-\exp(L/L_{1})||y-x|" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>/</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle L\exp(Lx)\cdot L_{1}|1-\exp(L/L_{1})||y-x|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex98.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex98.m2" class="ltx_Math" alttext="\displaystyle L\exp(Lx)|y-x|L_{1}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle L\exp(Lx)|y-x|L_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex99.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex99.m2" class="ltx_Math" alttext="\displaystyle L_{1}f_{1}^{\prime}(x)|x-y|," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>f</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle L_{1}f_{1}^{\prime}(x)|x-y|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.p2.2" class="ltx_p"><span id="A8.p2.2.1" class="ltx_text">where the inequality is based on equation (<a href="#A8.E27" title="In Proof. ‣ Appendix H The Proof of Proposition ‣ Decentralized Stochastic Nonconvex Optimization under the Relaxed Smoothness" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>) and the last two steps are based on <math id="A8.p2.m2" class="ltx_Math" alttext="f^{\prime}_{1}(x)=L\exp(Lx)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>f</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>L</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{\prime}_{1}(x)=L\exp(Lx)</annotation></semantics></math> and the setting <math id="A8.p2.m3" class="ltx_Math" alttext="L_{1}=L/\log 2" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mn>1</mn></msub><mo>=</mo><mrow><mi>L</mi><mo>/</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mn>2</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{1}=L/\log 2</annotation></semantics></math>.
Therefore, we have shown that <math id="A8.p2.m4" class="ltx_Math" alttext="f_{1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>1</mn></msub><annotation encoding="application/x-tex">f_{1}</annotation></semantics></math> is <math id="A8.p2.m5" class="ltx_Math" alttext="(0,L_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>L</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,L_{1})</annotation></semantics></math>-smooth.
Similarly, we can also show that <math id="A8.p2.m6" class="ltx_Math" alttext="f_{2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>2</mn></msub><annotation encoding="application/x-tex">f_{2}</annotation></semantics></math> is <math id="A8.p2.m7" class="ltx_Math" alttext="(0,L_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>L</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,L_{1})</annotation></semantics></math>-smooth.</span></p>
</div>
<div id="A8.p3" class="ltx_para">
<p id="A8.p3.1" class="ltx_p"><span id="A8.p3.1.1" class="ltx_text">Let <math id="A8.p3.m1" class="ltx_Math" alttext="x=0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x=0</annotation></semantics></math> and <math id="A8.p3.m2" class="ltx_Math" alttext="y=(\log 2)/L" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">y=(\log 2)/L</annotation></semantics></math>, which holds <math id="A8.p3.m3" class="ltx_Math" alttext="|x-y|=1/L_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mn>1</mn><mo>/</mo><msub><mi>L</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">|x-y|=1/L_{1}</annotation></semantics></math>.
We also have</span></p>
<table id="A8.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex100.m1" class="ltx_Math" alttext="\displaystyle|f^{\prime}(x)-f^{\prime}(y)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|f^{\prime}(x)-f^{\prime}(y)|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex101.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex101.m2" class="ltx_Math" alttext="\displaystyle\frac{L}{2}\left|\exp(Lx)-\exp(-Lx)-(\exp(Ly)-\exp(-Ly))\right|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{L}{2}\left|\exp(Lx)-\exp(-Lx)-(\exp(Ly)-\exp(-Ly))\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A8.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex102.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A8.Ex102.m2" class="ltx_Math" alttext="\displaystyle\frac{L}{2}\left|\exp(0)-\exp(0)-\left(2-\frac{1}{2}\right)\right|=\frac{3L}{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>4</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{L}{2}\left|\exp(0)-\exp(0)-\left(2-\frac{1}{2}\right)\right|=\frac{3L}{4}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.p3.2" class="ltx_p"><span id="A8.p3.2.1" class="ltx_text">and</span></p>
<table id="A8.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A8.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A8.Ex103.m1" class="ltx_Math" alttext="\displaystyle L_{1}f^{\prime}(x)|y-x|=\frac{L_{1}L(\exp(Lx)-\exp(-Lx))|y-x|}{2}=0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">|</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle L_{1}f^{\prime}(x)|y-x|=\frac{L_{1}L(\exp(Lx)-\exp(-Lx))|y-x|}{2}=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.p3.3" class="ltx_p"><span id="A8.p3.3.1" class="ltx_text">Therefore, the inequality <math id="A8.p3.m4" class="ltx_Math" alttext="|f^{\prime}(x)-f^{\prime}(y)|\leq L_{1}f^{\prime}(x)|y-x|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><msub><mi>L</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>f</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>y</mi><mo>−</mo><mi>x</mi></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|f^{\prime}(x)-f^{\prime}(y)|\leq L_{1}f^{\prime}(x)|y-x|</annotation></semantics></math> does not hold, which means the function <math id="A8.p3.m5" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> is not <math id="A8.p3.m6" class="ltx_Math" alttext="(0,L_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>L</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0,L_{1})</annotation></semantics></math>-smooth.
∎</span></p>
</div>
</div>
</section>
