<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.Ex60.m2" class="ltx_Math" alttext="\displaystyle\Phi^{t}-\frac{5\eta}{8}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|+\frac{3\eta^{2}L_{f}}{4}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi mathvariant="normal">Φ</mi><mi>t</mi></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mn>8</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>𝐱</mi><mo>¯</mo></mover><mi>t</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mn>4</mn></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Phi^{t}-\frac{5\eta}{8}\left\|\nabla f({\bar{\bf{x}}}^{t})\right\|+\frac{3\eta^{2}L_{f}}{4},</annotation></semantics></math></td>
