<tr id="A4.T7.2.1.7" class="ltx_tr">
<td id="A4.T7.2.1.7.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;" rowspan="2"><span id="A4.T7.2.1.7.1.1" class="ltx_text">Social Network</span></td>
<td id="A4.T7.2.1.7.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">Reddit</td>
