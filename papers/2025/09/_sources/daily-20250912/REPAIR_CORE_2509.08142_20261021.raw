            <span id="alg3.l9.2" class="ltx_text" style="font-size:90%;">  </span><math id="alg3.l9.m1" class="ltx_Math" alttext="\hat{\boldsymbol{S}}\leftarrow R_{\lambda}(\hat{\boldsymbol{A}},\hat{\boldsymbol{i}}|\mathcal{K})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathsize="0.900em">𝑺</mi><mo>^</mo></mover><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.900em">R</mi><mi mathsize="0.900em">λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mover accent="true"><mi mathsize="0.900em">𝑨</mi><mo>^</mo></mover><mo mathsize="0.900em">,</mo><mover accent="true"><mi mathsize="0.900em">𝒊</mi><mo>^</mo></mover></mrow><mo lspace="0em" mathsize="0.900em" rspace="0em">|</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒦</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\boldsymbol{S}}\leftarrow R_{\lambda}(\hat{\boldsymbol{A}},\hat{\boldsymbol{i}}|\mathcal{K})</annotation></semantics></math><span id="alg3.l9.3" class="ltx_text" style="font-size:90%;">
</span>
