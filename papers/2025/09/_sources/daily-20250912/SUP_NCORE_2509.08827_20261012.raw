<td id="S2.T1.5.1.52.6" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="S2.T1.5.1.52.6.1" class="ltx_text">MPO/GSPO</span></td>
<td id="S2.T1.5.1.52.7" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="S2.T1.5.1.52.7.1" class="ltx_text">T/I/V</span></td>
<td id="S2.T1.5.1.52.8" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="S2.T1.5.1.52.8.1" class="ltx_text"><a href="https://github.com/OpenGVLab/InternVL" title="" class="ltx_ref ltx_href">
<span class="ltx_inline-block fas fa-github" aria-hidden="true">
</span></a> 
<a href="https://huggingface.co/spaces/OpenGVLab/InternVL" title="" class="ltx_ref ltx_href"><span class="ltx_text" style="position:relative; bottom:-1.3pt;"><img src="2509.08827v1/figures/hf-logo.png" class="ltx_graphics ltx_img_square" style="aspect-ratio:15/14;" width="15" height="14" alt="[Uncaptioned image]"></span></a></span></td></tr>
