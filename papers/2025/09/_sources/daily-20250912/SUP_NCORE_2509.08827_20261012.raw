<span id="S3.T2.5.5.1.1.1" class="ltx_p">Turn (Agent)</span>
</span></td>
<td id="S3.T2.5.5.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb" style="padding-top:1pt;padding-bottom:1pt;">
<span id="S3.T2.5.5.2.1" class="ltx_inline-block ltx_align_top" style="width:156.5pt;">
<span id="S3.T2.5.5.2.1.1" class="ltx_p">Agent response <math id="S3.T2.m15" class="ltx_Math" alttext="y^{(u)}" display="inline" intent=":literal"><semantics><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">y^{(u)}</annotation></semantics></math> per turn</span>
</span></td>
