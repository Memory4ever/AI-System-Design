<td id="S5.T4.8.1.34.4" class="ltx_td ltx_align_center"><math id="S5.T4.m97" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#006400;" class="ltx_mathvariant_bold" mathcolor="#006400" mathvariant="bold">✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td>
