<span id="S3.T2.5.2.2.1.1" class="ltx_p">Entire sequence <math id="S3.T2.m6" class="ltx_Math" alttext="y=(a_{1},\dots,a_{T})" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>a</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">y=(a_{1},\dots,a_{T})</annotation></semantics></math></span>
