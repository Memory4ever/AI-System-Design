<li id="Sx1.I1.i8.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="Sx1.I1.i8.I1.i4.1" class="ltx_text ltx_font_bold">–</span></span> 
<div id="Sx1.I1.i8.I1.i4.p1" class="ltx_para">
