<span id="S1.T1.5.1.4.4.1" class="ltx_inline-block ltx_align_middle" style="width:130.9pt;--ltx-bg-color:#FFFFFF;">
<span id="S1.T1.5.1.4.4.1.1" class="ltx_p">Any party with public verification keys</span>
</span></td></tr>
<tr id="S1.T1.5.1.5" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="S1.T1.5.1.5.1" class="ltx_td ltx_align_left ltx_align_middle">
