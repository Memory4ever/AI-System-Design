<span id="S1.T1.5.1.4.3.1" class="ltx_inline-block ltx_align_middle" style="width:122.3pt;--ltx-bg-color:#FFFFFF;">
<span id="S1.T1.5.1.4.3.1.1" class="ltx_p">Content Recipient</span>
</span></td>
