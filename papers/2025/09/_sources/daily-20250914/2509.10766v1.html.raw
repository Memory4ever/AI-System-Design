</span></td>
<td id="S1.T1.5.1.4.2" class="ltx_td ltx_align_left ltx_align_middle">
<span id="S1.T1.5.1.4.2.1" class="ltx_inline-block ltx_align_middle" style="width:122.3pt;--ltx-bg-color:#FFFFFF;">
<span id="S1.T1.5.1.4.2.1.1" class="ltx_p">Content owner</span>
</span></td>
