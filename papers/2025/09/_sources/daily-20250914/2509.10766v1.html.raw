<span id="S1.T1.5.1.1.1.1.1" class="ltx_p"><span id="S1.T1.5.1.1.1.1.1.1" class="ltx_text ltx_font_bold">Aspect</span></span>
</span></th>
<th id="S1.T1.5.1.1.2" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_column ltx_border_tt">
<span id="S1.T1.5.1.1.2.1" class="ltx_inline-block ltx_align_middle" style="width:122.3pt;">
<span id="S1.T1.5.1.1.2.1.1" class="ltx_p"><span id="S1.T1.5.1.1.2.1.1.1" class="ltx_text ltx_font_bold">Copyright Protection</span></span>
</span></th>
<th id="S1.T1.5.1.1.3" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_column ltx_border_tt">
<span id="S1.T1.5.1.1.3.1" class="ltx_inline-block ltx_align_middle" style="width:122.3pt;">
<span id="S1.T1.5.1.1.3.1.1" class="ltx_p"><span id="S1.T1.5.1.1.3.1.1.1" class="ltx_text ltx_font_bold">Authentication</span></span>
</span></th>
<th id="S1.T1.5.1.1.4" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_column ltx_border_tt">
<span id="S1.T1.5.1.1.4.1" class="ltx_inline-block ltx_align_middle" style="width:130.9pt;">
<span id="S1.T1.5.1.1.4.1.1" class="ltx_p"><span id="S1.T1.5.1.1.4.1.1.1" class="ltx_text ltx_font_bold">Attribution (Ours)</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S1.T1.5.1.2" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="S1.T1.5.1.2.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="S1.T1.5.1.2.1.1" class="ltx_inline-block ltx_align_middle" style="width:85.4pt;--ltx-bg-color:#FFFFFF;">
<span id="S1.T1.5.1.2.1.1.1" class="ltx_p"><span id="S1.T1.5.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Objective</span></span>
</span></td>
<td id="S1.T1.5.1.2.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="S1.T1.5.1.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:122.3pt;--ltx-bg-color:#FFFFFF;">
<span id="S1.T1.5.1.2.2.1.1" class="ltx_p">Assert ownership or detect AIGC</span>
</span></td>
<td id="S1.T1.5.1.2.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="S1.T1.5.1.2.3.1" class="ltx_inline-block ltx_align_middle" style="width:122.3pt;--ltx-bg-color:#FFFFFF;">
<span id="S1.T1.5.1.2.3.1.1" class="ltx_p">Detect Modification</span>
</span></td>
<td id="S1.T1.5.1.2.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="S1.T1.5.1.2.4.1" class="ltx_inline-block ltx_align_middle" style="width:130.9pt;--ltx-bg-color:#FFFFFF;">
<span id="S1.T1.5.1.2.4.1.1" class="ltx_p">Trace rightful creator or source</span>
</span></td></tr>
<tr id="S1.T1.5.1.3" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<td id="S1.T1.5.1.3.1" class="ltx_td ltx_align_left ltx_align_middle">
