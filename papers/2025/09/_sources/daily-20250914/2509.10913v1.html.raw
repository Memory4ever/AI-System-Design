<th id="S4.T3.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">0.5</th>
<th id="S4.T3.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">1.0</th>
<th id="S4.T3.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">1.5</th>
