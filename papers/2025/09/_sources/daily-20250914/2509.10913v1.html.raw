</thead>
<tbody class="ltx_tbody">
<tr id="S4.T3.2.1.3" class="ltx_tr">
<th id="S4.T3.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">DDS (Pretrained) <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib2" title="" class="ltx_ref">Carlini et al. [2022]</a></cite></th>
<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T3.m2" class="ltx_Math" alttext="62_{(73)}" display="inline" intent=":literal"><semantics><msub><mn>62</mn><mrow><mo stretchy="false">(</mo><mn>73</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">62_{(73)}</annotation></semantics></math></td>
<td id="S4.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T3.m3" class="ltx_Math" alttext="54_{(73)}" display="inline" intent=":literal"><semantics><msub><mn>54</mn><mrow><mo stretchy="false">(</mo><mn>73</mn><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">54_{(73)}</annotation></semantics></math></td>
