<tr id="S4.T12.2.1.2" class="ltx_tr">
<td id="S4.T12.2.1.2.1" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T12.2.1.2.1.1" class="ltx_text ltx_font_bold">Encoders</span></td>
<td id="S4.T12.2.1.2.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T12.2.1.2.2.1" class="ltx_text ltx_font_bold">mIoU</span></td>
<td id="S4.T12.2.1.2.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T12.2.1.2.3.1" class="ltx_text ltx_font_bold">mIoU</span></td>
<td id="S4.T12.2.1.2.4" class="ltx_td ltx_align_center"><span id="S4.T12.2.1.2.4.1" class="ltx_text ltx_font_bold">mIoU</span></td></tr>
<tr id="S4.T12.2.1.3" class="ltx_tr">
