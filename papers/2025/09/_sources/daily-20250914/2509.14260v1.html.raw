<td id="S2.T1.2.5.1" class="ltx_td ltx_align_right ltx_border_l ltx_border_r"><span id="S2.T1.2.5.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">D</span></td>
<td id="S2.T1.2.5.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S2.T1.2.5.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">B</span></td>
<td id="S2.T1.2.5.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S2.T1.2.5.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">User</span></td>
<td id="S2.T1.2.5.4" class="ltx_td ltx_align_left ltx_border_r"><span id="S2.T1.2.5.4.1" class="ltx_text ltx_font_italic" style="--ltx-bg-color:#E6E6E6;">…even if you have not completed the task.</span></td></tr>
