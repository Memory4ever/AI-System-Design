<td id="S5.T1.11.14.1" class="ltx_td ltx_align_left" style="padding-bottom: 2.55005pt;"><math id="S5.T1.m15" class="ltx_Math" alttext="\texttt{partial}\left(z,z^{\prime},c,\textit{max}\right)\leftarrow\texttt{sharded}\left(x,x^{\prime},d,c\right),z=\textit{max\_reduce}\left(x,d\right),z^{\prime}=\textit{max\_reduce'}\left(x^{\prime},d\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">partial</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">c</mi><mo mathsize="0.800em">,</mo><mtext class="ltx_mathvariant_italic" mathsize="0.800em">max</mtext><mo>)</mo></mrow></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">sharded</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">c</mi><mo>)</mo></mrow></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">=</mo><mrow><mtext class="ltx_mathvariant_italic" mathsize="0.800em">max_reduce</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo>)</mo></mrow></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><msup><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">=</mo><mrow><mtext class="ltx_mathvariant_italic" mathsize="0.800em">max_reduce’</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{partial}\left(z,z^{\prime},c,\textit{max}\right)\leftarrow\texttt{sharded}\left(x,x^{\prime},d,c\right),z=\textit{max\_reduce}\left(x,d\right),z^{\prime}=\textit{max\_reduce'}\left(x^{\prime},d\right)</annotation></semantics></math></td>
