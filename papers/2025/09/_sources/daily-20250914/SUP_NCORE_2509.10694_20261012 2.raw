<td id="S5.T1.11.15.1" class="ltx_td ltx_align_left" style="padding-bottom: 2.55005pt;"><math id="S5.T1.m16" class="ltx_Math" alttext="\texttt{slice}\left(z,z^{\prime},r,b,d,j,l\right)\leftarrow\texttt{sharded}\left(x,x^{\prime},d,c\right),z=\textit{slice}\left(x,d,j,l\right),z^{\prime}=\textit{slice}\left(x^{\prime},d,k,l\right),\texttt{rank}\left(z^{\prime}\right)=r,k=rl" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">slice</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">j</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">l</mi><mo>)</mo></mrow></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">sharded</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">c</mi><mo>)</mo></mrow></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">=</mo><mrow><mtext class="ltx_mathvariant_italic" mathsize="0.800em">slice</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">j</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">l</mi><mo>)</mo></mrow></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><msup><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">=</mo><mrow><mtext class="ltx_mathvariant_italic" mathsize="0.800em">slice</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">k</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">l</mi><mo>)</mo></mrow></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">rank</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">′</mo></msup><mo>)</mo></mrow></mrow><mo mathsize="0.800em">=</mo><mi mathsize="0.800em">r</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">k</mi><mo mathsize="0.800em">=</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{slice}\left(z,z^{\prime},r,b,d,j,l\right)\leftarrow\texttt{sharded}\left(x,x^{\prime},d,c\right),z=\textit{slice}\left(x,d,j,l\right),z^{\prime}=\textit{slice}\left(x^{\prime},d,k,l\right),\texttt{rank}\left(z^{\prime}\right)=r,k=rl</annotation></semantics></math></td>
