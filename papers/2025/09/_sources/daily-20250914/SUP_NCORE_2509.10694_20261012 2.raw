<br class="ltx_break"><math id="S5.F7.m6" class="ltx_Math" alttext="|" display="inline" intent=":literal"><semantics><mo fence="false" stretchy="false">|</mo><annotation encoding="application/x-tex">|</annotation></semantics></math><math id="S5.F7.m7" class="ltx_Math" alttext="\mathit{op}" display="inline" intent=":literal"><semantics><mi>𝑜𝑝</mi><annotation encoding="application/x-tex">\mathit{op}</annotation></semantics></math><span id="S5.F7.4.1.2" class="ltx_text ltx_font_typewriter">(<math id="S5.F7.m8" class="ltx_Math" alttext="t_{1}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mn>1</mn></msub><annotation encoding="application/x-tex">t_{1}</annotation></semantics></math>, …, <math id="S5.F7.m9" class="ltx_Math" alttext="t_{n}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>n</mi></msub><annotation encoding="application/x-tex">t_{n}</annotation></semantics></math>)</span> operations
