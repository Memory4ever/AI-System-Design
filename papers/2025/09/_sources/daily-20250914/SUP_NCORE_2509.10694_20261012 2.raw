<td id="S5.T1.11.17.1" class="ltx_td ltx_align_left" style="padding-bottom: 2.55005pt;"><math id="S5.T1.m18" class="ltx_Math" alttext="\texttt{loop\_red\_B}\left(\mathit{add},d,z,xs\cup\{x_{1}\},b\right)\leftarrow z=\mathit{add}(x,x_{1}),\texttt{loop\_red\_B}\left(\mathit{add},d,x,xs,b\right),\texttt{slice}\left(x_{1},x_{1}^{\prime},r,b,d,k,l\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">loop_red_B</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">𝑎𝑑𝑑</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">,</mo><mrow><mrow><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi></mrow><mo mathsize="0.800em">∪</mo><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.800em">x</mi><mn mathsize="0.800em">1</mn></msub><mo stretchy="false">}</mo></mrow></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo>)</mo></mrow></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">=</mo><mrow><mi mathsize="0.800em">𝑎𝑑𝑑</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">x</mi><mn mathsize="0.800em">1</mn></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">loop_red_B</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">𝑎𝑑𝑑</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo>)</mo></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">slice</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi mathsize="0.800em">x</mi><mn mathsize="0.800em">1</mn></msub><mo mathsize="0.800em">,</mo><msubsup><mi mathsize="0.800em">x</mi><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">′</mo></msubsup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">k</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">l</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{loop\_red\_B}\left(\mathit{add},d,z,xs\cup\{x_{1}\},b\right)\leftarrow z=\mathit{add}(x,x_{1}),\texttt{loop\_red\_B}\left(\mathit{add},d,x,xs,b\right),\texttt{slice}\left(x_{1},x_{1}^{\prime},r,b,d,k,l\right)</annotation></semantics></math></td>
