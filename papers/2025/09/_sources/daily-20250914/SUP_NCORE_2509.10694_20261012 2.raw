 mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo>)</mo></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">slice</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi mathsize="0.800em">x</mi><mn mathsize="0.800em">1</mn></msub><mo mathsize="0.800em">,</mo><msubsup><mi mathsize="0.800em">x</mi><mn mathsize="0.800em">1</mn><mo mathsize="0.800em">′</mo></msubsup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">k</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">l</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{loop\_red\_D}\left(\mathit{add},d,z^{\prime},xs\cup\{x_{1}^{\prime}\},b,r\right)\leftarrow z^{\prime}=\mathit{add}(x^{\prime},x_{1}^{\prime}),\texttt{loop\_red\_D}\left(\mathit{add},d,x^{\prime},xs,b\right),\texttt{slice}\left(x_{1},x_{1}^{\prime},r,b,d,k,l\right)</annotation></semantics></math></td>
<td id="S5.T1.11.19.2" class="ltx_td ltx_align_left" style="padding-bottom: 2.55005pt;"><span id="S5.T1.11.19.2.1" class="ltx_text" style="font-size:80%;">Slicing + Unroll</span></td></tr>
<tr id="S5.T1.11.20" class="ltx_tr">
<td id="S5.T1.11.20.1" class="ltx_td ltx_align_left" style="padding-bottom: 2.55005pt;"><math id="S5.T1.m21" class="ltx_Math" alttext="\texttt{loop\_red\_D}\left(\mathit{add},d,z^{\prime},\bigcup_{r}xs_{r},b\right)\leftarrow z^{\prime}=\textit{all-reduce'}\left(x^{\prime},c,\mathit{add}\right),\forall r.\texttt{loop\_red\_D}\left(\mathit{add},d,x^{\prime},xs_{r},b,r\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">loop_red_D</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">𝑎𝑑𝑑</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em" rspace="0em">,</mo><mrow><msub><mo maxsize="0.800em" minsize="0.800em" stretchy="true">⋃</mo><mi mathsize="0.800em">r</mi></msub><mrow><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">r</mi></msub></mrow></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo>)</mo></mrow></mrow><mo mathsize="0.800em" stretchy="false">←</mo><msup><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">=</mo><mrow><mtext class="ltx_mathvariant_italic" mathsize="0.800em">all-reduce’</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">c</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">𝑎𝑑𝑑</mi><mo>)</mo></mrow></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><mo mathsize="0.800em" rspace="0.167em">∀</mo><mi mathsize="0.800em">r</mi></mrow></mrow><mo lspace="0em" mathsize="0.800em" rspace="0.167em">.</mo><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">loop_red_D</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">𝑎𝑑𝑑</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">x</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">r</mi></msub></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">r</mi><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{loop\_red\_D}\left(\mathit{add},d,z^{\prime},\bigcup_{r}xs_{r},b\right)\leftarrow z^{\prime}=\textit{all-reduce'}\left(x^{\prime},c,\mathit{add}\right),\forall r.\texttt{loop\_red\_D}\left(\mathit{add},d,x^{\prime},xs_{r},b,r\right)</annotation></semantics></math></td>
<td id="S5.T1.11.20.2" class="ltx_td ltx_align_left" style="padding-bottom: 2.55005pt;"><span id="S5.T1.11.20.2.1" class="ltx_text" style="font-size:80%;">Unroll</span></td></tr>
<tr id="S5.T1.11.21" class="ltx_tr">
<td id="S5.T1.11.21.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-bottom: 2.55005pt;"><math id="S5.T1.m22" class="ltx_Math" alttext="\texttt{duplicate}\left(z,z^{\prime},c\right)\leftarrow\texttt{loop\_red\_B}\left(\mathit{add},d,z,xs,b\right),\texttt{loop\_red\_D}\left(\mathit{add},d,z^{\prime},xs,b,r\right),b=\mathit{cat}((xs_{1},\dots,xs_{n}),\textit{dim}=d)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">duplicate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">c</mi><mo>)</mo></mrow></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">loop_red_B</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">𝑎𝑑𝑑</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo>)</mo></mrow></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">loop_red_D</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi mathsize="0.800em">𝑎𝑑𝑑</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">z</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">r</mi><mo>)</mo></mrow></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">b</mi><mo mathsize="0.800em">=</mo><mrow><mi mathsize="0.800em">𝑐𝑎𝑡</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">s</mi><mn mathsize="0.800em">1</mn></msub></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em" mathvariant="normal">…</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">n</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">,</mo><mrow><mtext class="ltx_mathvariant_italic" mathsize="0.800em">dim</mtext><mo mathsize="0.800em">=</mo><mi mathsize="0.800em">d</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\texttt{duplicate}\left(z,z^{\prime},c\right)\leftarrow\texttt{loop\_red\_B}\left(\mathit{add},d,z,xs,b\right),\texttt{loop\_red\_D}\left(\mathit{add},d,z^{\prime},xs,b,r\right),b=\mathit{cat}((xs_{1},\dots,xs_{n}),\textit{dim}=d)</annotation></semantics></math></td>
<td id="S5.T1.11.21.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-bottom: 2.55005pt;"><span id="S5.T1.11.21.2.1" class="ltx_text" style="font-size:80%;">Unroll</span></td></tr>
</tbody>
</table>
</figure>
<div id="S5.SS2.SSS2.p4" class="ltx_para">
<p id="S5.SS2.SSS2.p4.1" class="ltx_p"><span id="S5.SS2.SSS2.p4.1.1" class="ltx_text ltx_font_bold">Partition and layout analysis.</span>
Partition analysis handles relations linking a baseline tensor <math id="S5.SS2.SSS2.p4.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> with its distributed counterpart <math id="S5.SS2.SSS2.p4.m2" class="ltx_Math" alttext="t^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>t</mi><mo>′</mo></msup><annotation encoding="application/x-tex">t^{\prime}</annotation></semantics></math> and records placement, <em id="S5.SS2.SSS2.p4.1.2" class="ltx_emph ltx_font_italic">e.g.,</em> <em id="S5.SS2.SSS2.p4.1.3" class="ltx_emph ltx_font_italic">sharded</em> along dimension <math id="S5.SS2.SSS2.p4.m3" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> across <math id="S5.SS2.SSS2.p4.m4" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> devices. Layout analysis tracks how a <em id="S5.SS2.SSS2.p4.1.4" class="ltx_emph ltx_font_italic">layout</em> relation <math id="S5.SS2.SSS2.p4.m5" class="ltx_Math" alttext="\texttt{layout}(t,t^{\prime},\ell)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">layout</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msup><mi>t</mi><mo>′</mo></msup><mo>,</mo><mi mathvariant="normal">ℓ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\texttt{layout}(t,t^{\prime},\ell)</annotation></semantics></math>, which states that <math id="S5.SS2.SSS2.p4.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and <math id="S5.SS2.SSS2.p4.m7" class="ltx_Math" alttext="t^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>t</mi><mo>′</mo></msup><annotation encoding="application/x-tex">t^{\prime}</annotation></semantics></math> are connected by a <em id="S5.SS2.SSS2.p4.1.5" class="ltx_emph ltx_font_italic">bijective</em> layout <math id="S5.SS2.SSS2.p4.m8" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>.</p>
</div>
<div id="S5.SS2.SSS2.p5" class="ltx_para">
<p id="S5.SS2.SSS2.p5.1" class="ltx_p">Here we walkthrough Figure <a href="#S5.F6" title="Figure 6 ‣ 5.2. Processing: Incremental E-Graph Construction ‣ 5. System Design ‣ Verifying Computational Graphs in Production-Grade Distributed Machine Learning Frameworks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> to demonstrate how relations propagate in the constructed e-graph.
The top row is the baseline graph (yellow), the middle row the distributed graph (blue), and the bottom row the derived relations.
It starts with the sharded relation between <math id="S5.SS2.SSS2.p5.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="S5.SS2.SSS2.p5.m2" class="ltx_Math" alttext="A^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>A</mi><mo>′</mo></msup><annotation encoding="application/x-tex">A^{\prime}</annotation></semantics></math>
as well as <math id="S5.SS2.SSS2.p5.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> and <math id="S5.SS2.SSS2.p5.m4" class="ltx_Math" alttext="B^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>B</mi><mo>′</mo></msup><annotation encoding="application/x-tex">B^{\prime}</annotation></semantics></math>.
Because the contracted dimension is sharded, Table Table <a href="#S5.T1" title="Table 1 ‣ 5.2.2. Propagating Relations with Layout and Partition Analysis ‣ 5.2. Processing: Incremental E-Graph Construction ‣ 5. System Design ‣ Verifying Computational Graphs in Production-Grade Distributed Machine Learning Frameworks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>’s partial-from-reduction rule fires, and produces a partial relation <math id="S5.SS2.SSS2.p5.m5" class="ltx_Math" alttext="P(n)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(n)</annotation></semantics></math>, where n stands for the number of cores. The tool symbolizes the shape of tensors to be <math id="S5.SS2.SSS2.p5.m6" class="ltx_Math" alttext="(i,j)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j)</annotation></semantics></math> and <math id="S5.SS2.SSS2.p5.m7" class="ltx_Math" alttext="(i^{\prime},j^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i^{\prime},j^{\prime})</annotation></semantics></math>. Next,
baseline applies transpose then reshape; the distributed side performs the dual sequence plus allreduce. We align the two paths by inferring a bijective layout (we explain in more details in Section <a href="#S5.SS2.SSS3" title="5.2.3. Extending Relation Propagation with Bijection Inference ‣ 5.2. Processing: Incremental E-Graph Construction ‣ 5. System Design ‣ Verifying Computational Graphs in Production-Grade Distributed Machine Learning Frameworks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2.3</span></a>),
which yields an axis correspondence <math id="S5.SS2.SSS2.p5.m8" class="ltx_Math" alttext="(i_{2}^{\prime},i_{1}^{\prime},j^{\prime})\leftrightarrow(j,i_{1},i_{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msubsup><mi>i</mi><mn>2</mn><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>i</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">↔</mo><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><msub><mi>i</mi><mn>1</mn></msub><mo>,</mo><msub><mi>i</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(i_{2}^{\prime},i_{1}^{\prime},j^{\prime})\leftrightarrow(j,i_{1},i_{2})</annotation></semantics></math>. The allreduce node
eliminates the partial relation and restores a normal tensor relation according to the collective discharge rule.
The subsequent steps repeat similar patterns. The final layout step plus collective yields a duplicate output whose axes are aligned (rightmost column).</p>
</div>
<figure id="S5.F8" class="ltx_figure"><object type="image/svg+xml" data="2509.10694v1/slicing.svg" id="S5.F8.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:176/132;" width="176" height="132"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F8.3" class="ltx_text" style="font-size:90%;">Figure 8</span>. </span><span id="S5.F8.4" class="ltx_text" style="font-size:90%;">A computation graph with fine-grained slicing and unroll loop analysis. </span></figcaption>
</figure>
<div id="S5.SS2.SSS2.p6" class="ltx_para">
<p id="S5.SS2.SSS2.p6.1" class="ltx_p"><span id="S5.SS2.SSS2.p6.1.1" class="ltx_text ltx_font_bold">Fine-grained slicing.</span>
Some parallelization strategies introduce slicing patterns that cannot be fully captured by partition analysis.
For these fine-grained slicing operations, <span id="S5.SS2.SSS2.p6.1.2" class="ltx_text ltx_font_smallcaps">Scalify</span> utilizes slice relations to relate specific distributed tensors to the single-device versions.
This case arises when simply concatenating the distributed slices reconstructs the baseline tensor.
For example, Figure <a href="#S5.F8" title="Figure 8 ‣ 5.2.2. Propagating Relations with Layout and Partition Analysis ‣ 5.2. Processing: Incremental E-Graph Construction ‣ 5. System Design ‣ Verifying Computational Graphs in Production-Grade Distributed Machine Learning Frameworks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> illustrates how fine-grained slicing produces equally sized sub-tensors whose equivalence must be inferred explicitly (tensor <math id="S5.SS2.SSS2.p6.m1" class="ltx_Math" alttext="A_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">A_{1}</annotation></semantics></math> is equivalent to tensor <math id="S5.SS2.SSS2.p6.m2" class="ltx_Math" alttext="A_{1}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>1</mn></msub><annotation encoding="application/x-tex">A_{1}</annotation></semantics></math> and <math id="S5.SS2.SSS2.p6.m3" class="ltx_Math" alttext="A^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">A^{\prime}_{1}</annotation></semantics></math> is also equivalent to tensor <math id="S5.SS2.SSS2.p6.m4" class="ltx_Math" alttext="A_{3}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mn>3</mn></msub><annotation encoding="application/x-tex">A_{3}</annotation></semantics></math> at different devices).
Slice analysis can be viewed as a special case of partition analysis, extending it to finer levels of granularity.</p>
</div>
<div id="S5.SS2.SSS2.p7" class="ltx_para">
<p id="S5.SS2.SSS2.p7.1" class="ltx_p"><span id="S5.SS2.SSS2.p7.1.1" class="ltx_text ltx_font_bold">Unroll loop analysis.</span>
Some distributed parallelization strategies unroll recursive element-wise operations into loops, thus it would require an unbounded set of rules if hard-coding the operator count. To address this, <span id="S5.SS2.SSS2.p7.1.2" class="ltx_text ltx_font_smallcaps">Scalify</span> introduces <em id="S5.SS2.SSS2.p7.1.3" class="ltx_emph ltx_font_italic">reduce relations</em>, which relate a distributed tensor to the collection of partial tensors produced in the baseline graph.
As illustrated in Figure <a href="#S5.F8" title="Figure 8 ‣ 5.2.2. Propagating Relations with Layout and Partition Analysis ‣ 5.2. Processing: Incremental E-Graph Construction ‣ 5. System Design ‣ Verifying Computational Graphs in Production-Grade Distributed Machine Learning Frameworks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, although tensors <math id="S5.SS2.SSS2.p7.m1" class="ltx_Math" alttext="B^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">B^{\prime}_{1}</annotation></semantics></math> and <math id="S5.SS2.SSS2.p7.m2" class="ltx_Math" alttext="B_{1}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>1</mn></msub><annotation encoding="application/x-tex">B_{1}</annotation></semantics></math> share the same shape, they are not equivalent. Instead, <math id="S5.SS2.SSS2.p7.m3" class="ltx_Math" alttext="B^{\prime}_{1}" display="inline" intent=":literal"><semantics><msubsup><mi>B</mi><mn>1</mn><mo>′</mo></msubsup><annotation encoding="application/x-tex">B^{\prime}_{1}</annotation></semantics></math> corresponds to the reduction of multiple baseline tensors (<math id="S5.SS2.SSS2.p7.m4" class="ltx_Math" alttext="B_{1}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>1</mn></msub><annotation encoding="application/x-tex">B_{1}</annotation></semantics></math>–<math id="S5.SS2.SSS2.p7.m5" class="ltx_Math" alttext="B_{3}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mn>3</mn></msub><annotation encoding="application/x-tex">B_{3}</annotation></semantics></math>).
By representing these equivalences as reduce relations, <span id="S5.SS2.SSS2.p7.1.4" class="ltx_text ltx_font_smallcaps">Scalify</span> can correctly reason about unrolled loops and recursive elementwise computations.</p>
</div>
<figure id="S5.F9" class="ltx_figure"><object type="image/svg+xml" data="2509.10694v1/bijection_case_study.svg" id="S5.F9.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:452/64;" width="452" height="64"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F9.3" class="ltx_text" style="font-size:90%;">Figure 9</span>. </span><span id="S5.F9.4" class="ltx_text" style="font-size:90%;">The bijection inference process described in Algorithm <a href="#alg2" title="Algorithm 2 ‣ 5.2.3. Extending Relation Propagation with Bijection Inference ‣ 5.2. Processing: Incremental E-Graph Construction ‣ 5. System Design ‣ Verifying Computational Graphs in Production-Grade Distributed Machine Learning Frameworks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.
</span></figcaption>
</figure>
</section>
<section id="S5.SS2.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">5.2.3. </span>Extending Relation Propagation with Bijection Inference</h4>

<div id="S5.SS2.SSS3.p1" class="ltx_para">
<p id="S5.SS2.SSS3.p1.1" class="ltx_p">The propagation of layout relations becomes especially challenging when both graphs are consumed by different reshape-transpose sequences. For example, relating <span id="S5.SS2.SSS3.p1.1.1" class="ltx_text ltx_font_typewriter">reshape(transpose(x))</span> with <span id="S5.SS2.SSS3.p1.1.2" class="ltx_text ltx_font_typewriter">transpose(y)</span> is difficult if <span id="S5.SS2.SSS3.p1.1.3" class="ltx_text ltx_font_smallcaps">Scalify</span> uses relation propagation because the structure between them is different.
Encoding rules to relate different and equivalent layout transformations is infeasible due to the huge number of possible layout transformations.
<span id="S5.SS2.SSS3.p1.1.4" class="ltx_text ltx_font_smallcaps">Scalify</span> resolves this issue by inferring a bijection that relates two different layout transformations with each other.
<span id="S5.SS2.SSS3.p1.1.5" class="ltx_text ltx_font_smallcaps">Scalify</span> aims to relate two layout transformations because many optimization techniques encode different layout transformations, and ensuring the equivalence of them is crucial to maintain correctness. The bijection inference checks whether the different layout transformations are indeed equivalent to each other. If not, <span id="S5.SS2.SSS3.p1.1.6" class="ltx_text ltx_font_smallcaps">Scalify</span> generates a concrete sequence of reshape-transpose sequence that converts the layout of the distributed tensor to be equivalent to the baseline tensor, and <span id="S5.SS2.SSS3.p1.1.7" class="ltx_text ltx_font_smallcaps">Scalify</span> checks whether this bijection is defined later in the computation graphs.</p>
</div>
<div id="S5.SS2.SSS3.p2" class="ltx_para">
<p id="S5.SS2.SSS3.p2.1" class="ltx_p"><span id="S5.SS2.SSS3.p2.1.1" class="ltx_text ltx_font_bold">Inference algorithm.</span>
Algorithm <a href="#alg2" title="Algorithm 2 ‣ 5.2.3. Extending Relation Propagation with Bijection Inference ‣ 5.2. Processing: Incremental E-Graph Construction ‣ 5. System Design ‣ Verifying Computational Graphs in Production-Grade Distributed Machine Learning Frameworks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> shows how <span id="S5.SS2.SSS3.p2.1.2" class="ltx_text ltx_font_smallcaps">Scalify</span> calculates the bijection between different layout transformations.
We model each path’s layout sequence as symbolic axis expressions <math id="S5.SS2.SSS3.p2.m1" class="ltx_Math" alttext="E_{b}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>b</mi></msub><annotation encoding="application/x-tex">E_{b}</annotation></semantics></math> and <math id="S5.SS2.SSS3.p2.m2" class="ltx_Math" alttext="E_{d}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>d</mi></msub><annotation encoding="application/x-tex">E_{d}</annotation></semantics></math> (Step 1).
As shown in Figure <a href="#S5.F9" title="Figure 9 ‣ 5.2.2. Propagating Relations with Layout and Partition Analysis ‣ 5.2. Processing: Incremental E-Graph Construction ‣ 5. System Design ‣ Verifying Computational Graphs in Production-Grade Distributed Machine Learning Frameworks" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, <span id="S5.SS2.SSS3.p2.1.3" class="ltx_text ltx_font_smallcaps">Scalify</span> symbolizes shapes (4, 64, 4096) as <math id="S5.SS2.SSS3.p2.m3" class="ltx_Math" alttext="(i,j,k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j,k)</annotation></semantics></math>, changing it to <math id="S5.SS2.SSS3.p2.m4" class="ltx_math_unparsed" alttext="(\otimes(i,j),k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.222em">⊗</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\otimes(i,j),k)</annotation></semantics></math> when consumed by <span id="S5.SS2.SSS3.p2.1.4" class="ltx_text ltx_font_typewriter">reshape</span> to reflect the merging of axes. <span id="S5.SS2.SSS3.p2.1.5" class="ltx_text ltx_font_smallcaps">Scalify</span> normalizes the ranks so that they have the same rank by merging or splitting (Step 2).
<span id="S5.SS2.SSS3.p2.1.6" class="ltx_text ltx_font_smallcaps">Scalify</span> then computes the permutation between <math id="S5.SS2.SSS3.p2.m5" class="ltx_Math" alttext="\hat{E}_{\text{d}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>^</mo></mover><mtext>d</mtext></msub><annotation encoding="application/x-tex">\hat{E}_{\text{d}}</annotation></semantics></math> and <math id="S5.SS2.SSS3.p2.m6" class="ltx_Math" alttext="\hat{E}_{\text{b}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>^</mo></mover><mtext>b</mtext></msub><annotation encoding="application/x-tex">\hat{E}_{\text{b}}</annotation></semantics></math> by finding index <math id="S5.SS2.SSS3.p2.m7" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> in <math id="S5.SS2.SSS3.p2.m8" class="ltx_Math" alttext="\hat{E}_{\text{d}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>^</mo></mover><mtext>d</mtext></msub><annotation encoding="application/x-tex">\hat{E}_{\text{d}}</annotation></semantics></math> such that it is structurally equal to index <math id="S5.SS2.SSS3.p2.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> in <math id="S5.SS2.SSS3.p2.m10" class="ltx_Math" alttext="\hat{E}_{\text{b}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>^</mo></mover><mtext>b</mtext></msub><annotation encoding="application/x-tex">\hat{E}_{\text{b}}</annotation></semantics></math> (Step 3).
<span id="S5.SS2.SSS3.p2.1.7" class="ltx_text ltx_font_smallcaps">Scalify</span> converts the distributed axes map <math id="S5.SS2.SSS3.p2.m11" class="ltx_Math" alttext="(j^{\prime},i^{\prime},k^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo>,</mo><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>k</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(j^{\prime},i^{\prime},k^{\prime})</annotation></semantics></math> into <math id="S5.SS2.SSS3.p2.m12" class="ltx_Math" alttext="(i^{\prime},j^{\prime},k^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>i</mi><mo>′</mo></msup><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup><mo>,</mo><msup><mi>k</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i^{\prime},j^{\prime},k^{\prime})</annotation></semantics></math> because it has the same structure as the baseline axes map <math id="S5.SS2.SSS3.p2.m13" class="ltx_Math" alttext="(i,j,k)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i,j,k)</annotation></semantics></math>. The generated permutation indices is (1, 0, 2), which is represented as a transpose operation. Finally, <span id="S5.SS2.SSS3.p2.1.8" class="ltx_text ltx_font_smallcaps">Scalify</span> constructs the final operation sequence in Step 4. <span id="S5.SS2.SSS3.p2.1.9" class="ltx_text ltx_font_smallcaps">Scalify</span> adds a final reshape operation to <math id="S5.SS2.SSS3.p2.m14" class="ltx_Math" alttext="Ops" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><annotation encoding="application/x-tex">Ops</annotation></semantics></math> so that <math id="S5.SS2.SSS3.p2.m15" class="ltx_Math" alttext="E_{\text{b}}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mtext>b</mtext></msub><annotation encoding="application/x-tex">E_{\text{b}}</annotation></semantics></math> has same shape as <math id="S5.SS2.SSS3.p2.m16" class="ltx_Math" alttext="E_{\text{d}}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mtext>d</mtext></msub><annotation encoding="application/x-tex">E_{\text{d}}</annotation></semantics></math>. <math id="S5.SS2.SSS3.p2.m17" class="ltx_Math" alttext="E_{\text{d}}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mtext>d</mtext></msub><annotation encoding="application/x-tex">E_{\text{d}}</annotation></semantics></math> is reshaped to (256, 4096) so that it has same shape as <math id="S5.SS2.SSS3.p2.m18" class="ltx_Math" alttext="E_{\text{b}}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mtext>b</mtext></msub><annotation encoding="application/x-tex">E_{\text{b}}</annotation></semantics></math>. The generated bijection is <span id="S5.SS2.SSS3.p2.1.10" class="ltx_text ltx_font_typewriter">[reshape(64, 4, 4096), transpose(1, 0, 2), reshape(256, 4096)]</span>. <span id="S5.SS2.SSS3.p2.1.11" class="ltx_text ltx_font_smallcaps">Scalify</span> checks whether this bijection makes the distributed layout sequence equivalent to the baseline version. If not, <span id="S5.SS2.SSS3.p2.1.12" class="ltx_text ltx_font_smallcaps">Scalify</span> returns None.</p>
</div>
<div id="S5.SS2.SSS3.p3" class="ltx_para">
<p id="S5.SS2.SSS3.p3.1" class="ltx_p"><span id="S5.SS2.SSS3.p3.1.1" class="ltx_text ltx_font_smallcaps">Scalify</span> limits symbolic execution to structurally different layout transformations, unlike TrainVerify <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib59" title="" class="ltx_ref">Lu
et al., 2025</a>)</cite> which applies it to entire graphs. This narrower scope avoids unnecessary heavy reasoning for operators that don’t require it.</p>
</div>
<figure id="alg2" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="font-size:80%;"><span class="ltx_tag ltx_tag_float"><span id="alg2.5" class="ltx_text ltx_font_bold">Algorithm 2</span> </span>Inferring bijection mapping</figcaption>
<div id="alg2.6" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.6.1" class="ltx_listingline"><span id="alg2.6.1.1" class="ltx_text" style="font-size:80%;">
<span id="alg2.6.1.1.1" class="ltx_text"><span id="alg2.6.1.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>
<math id="alg2.m1" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>: existing layout relation between baseline tensor <span id="alg2.6.1.1.2" class="ltx_text ltx_font_typewriter">b</span> and distributed tensor <span id="alg2.6.1.1.3" class="ltx_text ltx_font_typewriter">d</span>;</span>
</div>
<div id="alg2.6.2" class="ltx_listingline"><math id="alg2.m2" class="ltx_Math" alttext="S_{\text{b}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">S</mi><mtext mathsize="0.800em">b</mtext></msub><annotation encoding="application/x-tex">S_{\text{b}}</annotation></semantics></math><span id="alg2.6.2.1" class="ltx_text" style="font-size:80%;">: list of layout ops on baseline path;</span>
</div>
<div id="alg2.6.3" class="ltx_listingline"><math id="alg2.m3" class="ltx_Math" alttext="S_{\text{d}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">S</mi><mtext mathsize="0.800em">d</mtext></msub><annotation encoding="application/x-tex">S_{\text{d}}</annotation></semantics></math><span id="alg2.6.3.1" class="ltx_text" style="font-size:80%;">: list of layout ops on distributed path.
</span>
</div>
<div id="alg2.6.4" class="ltx_listingline"><span id="alg2.6.4.1" class="ltx_text" style="font-size:80%;"><span id="alg2.6.4.1.1" class="ltx_text ltx_font_bold">Output:</span> </span><span id="alg2.6.4.2" class="ltx_text" style="font-size:80%;">
A </span><math id="alg2.m4" class="ltx_Math" alttext="\textit{bijection}\left(s_{1},p,s_{2}\right)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic" mathsize="0.800em">bijection</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi mathsize="0.800em">s</mi><mn mathsize="0.800em">1</mn></msub><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">p</mi><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">s</mi><mn mathsize="0.800em">2</mn></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\textit{bijection}\left(s_{1},p,s_{2}\right)</annotation></semantics></math><span id="alg2.6.4.3" class="ltx_text" style="font-size:80%;"> that maps </span><span id="alg2.6.4.4" class="ltx_text ltx_font_typewriter" style="font-size:80%;">d</span><span id="alg2.6.4.5" class="ltx_text" style="font-size:80%;"> to </span><span id="alg2.6.4.6" class="ltx_text ltx_font_typewriter" style="font-size:80%;">b</span><span id="alg2.6.4.7" class="ltx_text" style="font-size:80%;">,
or </span><math id="alg2.m5" class="ltx_Math" alttext="\bot" display="inline" intent=":literal"><semantics><mo mathsize="0.800em">⊥</mo><annotation encoding="application/x-tex">\bot</annotation></semantics></math><span id="alg2.6.4.8" class="ltx_text" style="font-size:80%;"> if no bijection exists.
</span>
</div>
<div id="alg2.6.5" class="ltx_listingline"><span id="alg2.6.5.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">// </span><span id="alg2.6.5.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Step 1: Generate symbolic expression and mapping between symbolic axes of b and d </span>
</div>
<div id="alg2.6.6" class="ltx_listingline"><math id="alg2.m6" class="ltx_math_unparsed" alttext="M\leftarrow\mathrm{ExtractAxisMap}\left(\ell,b.\mathit{shape},d.\mathit{shape}\right)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">M</mi><mo mathsize="0.800em" stretchy="false">←</mo><mi mathsize="0.800em">ExtractAxisMap</mi><mrow><mo>(</mo><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">b</mi><mo lspace="0em" mathsize="0.800em" rspace="0.167em">.</mo><mi mathsize="0.800em">𝑠ℎ𝑎𝑝𝑒</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">d</mi><mo lspace="0em" mathsize="0.800em" rspace="0.167em">.</mo><mi mathsize="0.800em">𝑠ℎ𝑎𝑝𝑒</mi><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">M\leftarrow\mathrm{ExtractAxisMap}\left(\ell,b.\mathit{shape},d.\mathit{shape}\right)</annotation></semantics></math><span id="alg2.6.6.1" class="ltx_text" style="font-size:80%;">,
</span><math id="alg2.m7" class="ltx_Math" alttext="E_{\text{b}}\leftarrow\mathrm{GenExp}\left(S_{\text{b}}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">E</mi><mtext mathsize="0.800em">b</mtext></msub><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">GenExp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi mathsize="0.800em">S</mi><mtext mathsize="0.800em">b</mtext></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{\text{b}}\leftarrow\mathrm{GenExp}\left(S_{\text{b}}\right)</annotation></semantics></math><span id="alg2.6.6.2" class="ltx_text" style="font-size:80%;">,
</span><math id="alg2.m8" class="ltx_Math" alttext="E_{\text{d}}\leftarrow\mathrm{GenExp}\left(S_{\text{d}}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">E</mi><mtext mathsize="0.800em">d</mtext></msub><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">GenExp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi mathsize="0.800em">S</mi><mtext mathsize="0.800em">d</mtext></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{\text{d}}\leftarrow\mathrm{GenExp}\left(S_{\text{d}}\right)</annotation></semantics></math><span id="alg2.6.6.3" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg2.6.7" class="ltx_listingline"><span id="alg2.6.7.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">// </span><span id="alg2.6.7.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Step 2: Rank normalization </span>
</div>
<div id="alg2.6.8" class="ltx_listingline"><math id="alg2.m9" class="ltx_Math" alttext="(\hat{E}_{\text{b}},\hat{E}_{\text{d}},impossible)\leftarrow\mathrm{NormalizeRank}\left(E_{\text{b}},E_{\text{d}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mover accent="true"><mi mathsize="0.800em">E</mi><mo>^</mo></mover><mtext mathsize="0.800em">b</mtext></msub><mo mathsize="0.800em">,</mo><msub><mover accent="true"><mi mathsize="0.800em">E</mi><mo>^</mo></mover><mtext mathsize="0.800em">d</mtext></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">NormalizeRank</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi mathsize="0.800em">E</mi><mtext mathsize="0.800em">b</mtext></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">E</mi><mtext mathsize="0.800em">d</mtext></msub><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\hat{E}_{\text{b}},\hat{E}_{\text{d}},impossible)\leftarrow\mathrm{NormalizeRank}\left(E_{\text{b}},E_{\text{d}}\right)</annotation></semantics></math><span id="alg2.6.8.1" class="ltx_text" style="font-size:80%;"> </span>
</div>
<div id="alg2.6.9" class="ltx_listingline"><span id="alg2.6.9.1" class="ltx_text ltx_font_bold" style="font-size:80%;">if</span><span id="alg2.6.9.2" class="ltx_text" style="font-size:80%;"> </span><em id="alg2.6.9.3" class="ltx_emph ltx_font_italic" style="font-size:80%;">impossible</em><span id="alg2.6.9.4" class="ltx_text" style="font-size:80%;"> </span><span id="alg2.6.9.5" class="ltx_text ltx_font_bold" style="font-size:80%;">then</span><span id="alg2.6.9.6" class="ltx_text" style="font-size:80%;"> </span><span id="alg2.6.9.7" class="ltx_text ltx_font_bold" style="font-size:80%;">return</span><span id="alg2.6.9.8" class="ltx_text" style="font-size:80%;"> </span><math id="alg2.m10" class="ltx_Math" alttext="\bot" display="inline" intent=":literal"><semantics><mo mathsize="0.800em">⊥</mo><annotation encoding="application/x-tex">\bot</annotation></semantics></math>
</div>
<div id="alg2.6.10" class="ltx_listingline"><span id="alg2.6.10.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">// </span><span id="alg2.6.10.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Step 3: Find permutation bijection </span>
</div>
<div id="alg2.6.11" class="ltx_listingline"><math id="alg2.m11" class="ltx_Math" alttext="p\leftarrow" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">p</mi><mo mathsize="0.800em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">p\leftarrow</annotation></semantics></math><span id="alg2.6.11.1" class="ltx_text" style="font-size:80%;"> an empty permutation of length </span><math id="alg2.m12" class="ltx_Math" alttext="\mathrm{rank}\left(\hat{E}_{\text{b}}\right)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">rank</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mover accent="true"><mi mathsize="0.800em">E</mi><mo>^</mo></mover><mtext mathsize="0.800em">b</mtext></msub><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{rank}\left(\hat{E}_{\text{b}}\right)</annotation></semantics></math><span id="alg2.6.11.2" class="ltx_text" style="font-size:80%;"> </span>
</div>
<div id="alg2.6.12" class="ltx_listingline"><span id="alg2.6.12.1" class="ltx_text ltx_font_bold" style="font-size:80%;">for</span><span id="alg2.6.12.2" class="ltx_text" style="font-size:80%;"> </span><em id="alg2.6.12.3" class="ltx_emph ltx_font_italic" style="font-size:80%;"><math id="alg2.m13" class="ltx_Math" alttext="i\leftarrow 0~\textnormal{{to}}~\mathrm{rank}\left(\hat{E}_{\text{b}}-1\right)" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mrow><mn>0</mn><mo lspace="0.280em" rspace="0em">​</mo><mtext class="ltx_mathvariant_monospace">to</mtext><mo lspace="0.280em" rspace="0em">​</mo><mi>rank</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>E</mi><mo mathsize="1.250em">^</mo></mover><mtext class="ltx_mathvariant_italic">b</mtext></msub><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i\leftarrow 0~\textnormal{{to}}~\mathrm{rank}\left(\hat{E}_{\text{b}}-1\right)</annotation></semantics></math></em><span id="alg2.6.12.4" class="ltx_text" style="font-size:80%;"> </span><span id="alg2.6.12.5" class="ltx_text ltx_font_bold" style="font-size:80%;">do</span>
</div>
<div id="alg2.6.13" class="ltx_listingline"><span id="alg2.6.13.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg2.6.13.2" class="ltx_text" style="font-size:80%;">  find </span><math id="alg2.m14" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="alg2.6.13.3" class="ltx_text" style="font-size:80%;"> such that </span><math id="alg2.m15" class="ltx_Math" alttext="\hat{E}_{\text{d}}\left[j\right]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathsize="0.800em">E</mi><mo>^</mo></mover><mtext mathsize="0.800em">d</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi mathsize="0.800em">j</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{E}_{\text{d}}\left[j\right]</annotation></semantics></math><span id="alg2.6.13.4" class="ltx_text" style="font-size:80%;"> is equal to </span><math id="alg2.m16" class="ltx_Math" alttext="\hat{E}_{\text{b}}\left[i\right]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathsize="0.800em">E</mi><mo>^</mo></mover><mtext mathsize="0.800em">b</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi mathsize="0.800em">i</mi><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{E}_{\text{b}}\left[i\right]</annotation></semantics></math><span id="alg2.6.13.5" class="ltx_text" style="font-size:80%;"> under </span><math id="alg2.m17" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math><span id="alg2.6.13.6" class="ltx_text" style="font-size:80%;"> </span>
</div>
<div id="alg2.6.14" class="ltx_listingline"><span id="alg2.6.14.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="alg2.6.14.2" class="ltx_text" style="font-size:80%;">  </span><span id="alg2.6.14.3" class="ltx_text ltx_font_bold" style="font-size:80%;">if</span><span id="alg2.6.14.4" class="ltx_text" style="font-size:80%;"> </span><em id="alg2.6.14.5" class="ltx_emph ltx_font_italic" style="font-size:80%;">no such <math id="alg2.m18" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> or <math id="alg2.m19" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> reused</em><span id="alg2.6.14.6" class="ltx_text" style="font-size:80%;"> </span><span id="alg2.6.14.7" class="ltx_text ltx_font_bold" style="font-size:80%;">then</span><span id="alg2.6.14.8" class="ltx_text" style="font-size:80%;"> </span><span id="alg2.6.14.9" class="ltx_text ltx_font_bold" style="font-size:80%;">return</span><span id="alg2.6.14.10" class="ltx_text" style="font-size:80%;"> </span><math id="alg2.m20" class="ltx_Math" alttext="\bot" display="inline" intent=":literal"><semantics><mo mathsize="0.800em">⊥</mo><annotation encoding="application/x-tex">\bot</annotation></semantics></math>
</div>
