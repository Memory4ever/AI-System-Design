<td id="S7.T4.6.9.3" class="ltx_td ltx_align_left"><cite class="ltx_cite ltx_citemacro_citep"><span id="S7.T4.6.9.3.1" class="ltx_text" style="font-size:80%;">(</span><a href="#bib.bib20" title="" class="ltx_ref">tra, [n.d.]e</a><span id="S7.T4.6.9.3.3" class="ltx_text" style="font-size:80%;">)</span></cite></td>
<td id="S7.T4.6.9.4" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S7.T4.6.9.4.1" class="ltx_text" style="font-size:80%;">n/a</span></td></tr>
