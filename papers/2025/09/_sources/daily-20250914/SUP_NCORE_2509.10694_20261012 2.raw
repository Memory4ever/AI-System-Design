tion encoding="application/x-tex">\texttt{layout}\left(x,z^{\prime},\textit{reshape}\left(x^{\prime}.\textit{shape}\right)\circ\ell,c\right)\leftarrow\texttt{layout}\left(x,x^{\prime},\ell,c\right),z^{\prime}=\textit{reshape}\left(x^{\prime},s^{\prime}\right)</annotation></semantics></math></td>
