        const missing = needed.filter(([spec, text]) => !document.fonts.check(spec, text));
        if (!missing.length) {
          element.dataset.fontReady = 'cached';
          continue;
        }
        delete element.dataset.fontReady;
        element.setAttribute('aria-busy', 'true');
        busy.set(element, 'fontReady');
        pending++;
