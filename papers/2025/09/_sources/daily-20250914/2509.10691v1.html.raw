              <span class="ltx_tag ltx_tag_listingline">19:</span>
              
              
              <span id="alg1.l19.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l19.m1" class="ltx_Math" alttext="r&lt;R" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>&lt;</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">r&lt;R</annotation></semantics></math> <span id="alg1.l19.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">20:</span>
              
              
               <math id="alg1.l20.m1" class="ltx_Math" alttext="\{\tilde{\vec{C}}_{s,1}^{\,r+1}\}_{s=1}^{S}\leftarrow\{\tilde{\vec{C}}_{s,K}^{\,r}\}_{s=1}^{S}" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mover accent="true"><mi>C</mi><mo stretchy="false">→</mo></mover><mo>~</mo></mover><mrow><mi>s</mi><mo>,</mo><mn>1</mn></mrow><mrow><mi>r</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup><mo stretchy="false">←</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mover accent="true"><mi>C</mi><mo stretchy="false">→</mo></mover><mo>~</mo></mover><mrow><mi>s</mi><mo>,</mo><mi>K</mi></mrow><mi>r</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup></mrow><annotation encoding="application/x-tex">\{\tilde{\vec{C}}_{s,1}^{\,r+1}\}_{s=1}^{S}\leftarrow\{\tilde{\vec{C}}_{s,K}^{\,r}\}_{s=1}^{S}</annotation></semantics></math>

</div>
