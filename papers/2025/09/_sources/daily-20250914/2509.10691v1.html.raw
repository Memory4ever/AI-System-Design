&amp;\quad+\text{ClassHV}(\text{Encoding}(\vec{F}_{k}))+\vec{\Gamma}_{k}^{1}\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mover accent="true"><mi>C</mi><mo stretchy="false">→</mo></mover><mo>~</mo></mover><mrow><mi>s</mi><mo>,</mo><mi>k</mi></mrow><mn> 1</mn></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo stretchy="false">←</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mover accent="true"><mi>C</mi><mo stretchy="false">→</mo></mover><mo>~</mo></mover><mrow><mi>s</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><mn> 1</mn></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>+</mo><mrow><mtext>ClassHV</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>Encoding</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>F</mi><mo stretchy="false">→</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msubsup><mover accent="true"><mi mathvariant="normal">Γ</mi><mo stretchy="false">→</mo></mover><mi>k</mi><mn>1</mn></msubsup></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned} \{\tilde{\vec{C}}_{s,k}^{\,1}\}_{s=1}^{S}&amp;\leftarrow\{\tilde{\vec{C}}_{s,k-1}^{\,1}\}_{s=1}^{S}\\
&amp;\quad+\text{ClassHV}(\text{Encoding}(\vec{F}_{k}))+\vec{\Gamma}_{k}^{1}\end{aligned}</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
