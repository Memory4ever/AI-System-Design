<figure id="S5.F5.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.10691v1/isolet_iid_acc_eps_delta.png" id="S5.F5.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:157/95;" width="157" height="95" alt="Refer to caption">
