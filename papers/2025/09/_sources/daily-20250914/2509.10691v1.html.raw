</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">15:</span>
              
              
                 <math id="alg1.l15.m1" class="ltx_Math" alttext="\vec{\Gamma}_{k}^{r}\sim\mathcal{N}\!\left(0,\tfrac{2D}{\epsilon^{2}}\ln\!\left[\tfrac{K(r-1)+k}{K(r-1)+k-1}\right]\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi mathvariant="normal">Γ</mi><mo stretchy="false">→</mo></mover><mi>k</mi><mi>r</mi></msubsup><mo>∼</mo><mrow><mpadded style="width:0.798em;" width="0.798em"><mi class="ltx_font_mathcaligraphic">𝒩</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:0.748em;" width="0.748em"><mi>ln</mi></mpadded><mo>⁡</mo><mrow><mo>[</mo><mfrac><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>k</mi></mrow><mrow><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></mfrac><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\vec{\Gamma}_{k}^{r}\sim\mathcal{N}\!\left(0,\tfrac{2D}{\epsilon^{2}}\ln\!\left[\tfrac{K(r-1)+k}{K(r-1)+k-1}\right]\right)</annotation></semantics></math>

</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">16:</span>
              
              
                 <math id="alg1.l16.m1" class="ltx_Math" alttext="\begin{aligned} \{\tilde{\vec{C}}_{s,k}^{\,r}\}_{s=1}^{S}&amp;\leftarrow\text{Retrain}\!\big(\{\tilde{\vec{C}}_{s,k-1}^{\,r}\}_{s=1}^{S},\text{Encoding}(\vec{F}_{k})\big)+\vec{\Gamma}_{k}^{r}\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mover accent="true"><mi>C</mi><mo stretchy="false">→</mo></mover><mo>~</mo></mover><mrow><mi>s</mi><mo>,</mo><mi>k</mi></mrow><mi>r</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo stretchy="false">←</mo><mrow><mrow><mpadded style="width:3.376em;" width="3.376em"><mtext>Retrain</mtext></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mover accent="true"><mi>C</mi><mo stretchy="false">→</mo></mover><mo>~</mo></mover><mrow><mi>s</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><mi>r</mi></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>S</mi></msubsup><mo mathsize="0.700em">,</mo><mrow><mtext>Encoding</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>F</mi><mo stretchy="false">→</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><msubsup><mover accent="true"><mi mathvariant="normal">Γ</mi><mo stretchy="false">→</mo></mover><mi>k</mi><mi>r</mi></msubsup></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned} \{\tilde{\vec{C}}_{s,k}^{\,r}\}_{s=1}^{S}&amp;\leftarrow\text{Retrain}\!\big(\{\tilde{\vec{C}}_{s,k-1}^{\,r}\}_{s=1}^{S},\text{Encoding}(\vec{F}_{k})\big)+\vec{\Gamma}_{k}^{r}\end{aligned}</annotation></semantics></math>

</div>
