<th id="S4.T2.2.9.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib1" title="" class="ltx_ref">AI@Meta (2024)</a></cite></th>
