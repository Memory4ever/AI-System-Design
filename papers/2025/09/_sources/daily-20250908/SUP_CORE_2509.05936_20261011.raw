<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S5.SS2" title="In V Experiments and Evaluations ‣ ALPHA: LLM-Enabled Active Learning for Human-Free Network Anomaly Detection" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-B</span> </span><span class="ltx_text ltx_font_italic">Performance of ALPHA</span></span></a>
<ol class="ltx_toclist ltx_toclist_subsection">
<li class="ltx_tocentry ltx_tocentry_subsubsection"><a href="#S5.SS2.SSS1" title="In V-B Performance of ALPHA ‣ V Experiments and Evaluations ‣ ALPHA: LLM-Enabled Active Learning for Human-Free Network Anomaly Detection" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-B</span>1 </span><span class="ltx_text ltx_font_bold">Cluster Optimization</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsubsection"><a href="#S5.SS2.SSS2" title="In V-B Performance of ALPHA ‣ V Experiments and Evaluations ‣ ALPHA: LLM-Enabled Active Learning for Human-Free Network Anomaly Detection" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-B</span>2 </span><span class="ltx_text ltx_font_bold">Performance of Labeling</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsubsection"><a href="#S5.SS2.SSS3" title="In V-B Performance of ALPHA ‣ V Experiments and Evaluations ‣ ALPHA: LLM-Enabled Active Learning for Human-Free Network Anomaly Detection" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-B</span>3 </span><span class="ltx_text ltx_font_bold">Log Anomaly Detection Performance</span></span></a></li>
