<td id="S5.T3.4.10.3" class="ltx_td ltx_align_center ltx_border_t">SVM</td>
<td id="S5.T3.4.10.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">95.74</td>
<td id="S5.T3.4.10.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" rowspan="4"><span id="S5.T3.4.10.5.1" class="ltx_text ltx_font_bold">0</span></td></tr>
