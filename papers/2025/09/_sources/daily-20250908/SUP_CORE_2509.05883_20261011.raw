<td id="S4.T1.3.4.4" class="ltx_td ltx_align_center"><span id="S4.T1.3.4.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">–</span></td>
<td id="S4.T1.3.4.5" class="ltx_td ltx_align_center"><span id="S4.T1.3.4.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">✓</span></td></tr>
