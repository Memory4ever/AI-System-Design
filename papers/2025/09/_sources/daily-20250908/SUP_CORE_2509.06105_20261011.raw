<td id="S4.T1.2.1.5.11" class="ltx_td ltx_align_center">0.2926</td>
<td id="S4.T1.2.1.5.12" class="ltx_td ltx_align_center">0.3079</td>
<td id="S4.T1.2.1.5.13" class="ltx_td ltx_align_center">0.2931</td></tr>
<tr id="S4.T1.2.1.6" class="ltx_tr">
<td id="S4.T1.2.1.6.1" class="ltx_td ltx_align_left ltx_border_r">CONCH</td>
