<tr id="S4.T1.2.1.4" class="ltx_tr">
<td id="S4.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_border_r">BiomedCLIP</td>
<td id="S4.T1.2.1.4.2" class="ltx_td ltx_align_center">0.6325</td>
