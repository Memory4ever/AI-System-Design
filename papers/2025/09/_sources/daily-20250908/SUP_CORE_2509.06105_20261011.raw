<tr id="S4.T1.2.1.3" class="ltx_tr">
<td id="S4.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">CLIP</td>
<td id="S4.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">0.7072</td>
