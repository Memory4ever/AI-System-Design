<td id="S4.T1.2.1.4.4" class="ltx_td ltx_align_center ltx_border_r">0.4138</td>
<td id="S4.T1.2.1.4.5" class="ltx_td ltx_align_center">0.5924</td>
<td id="S4.T1.2.1.4.6" class="ltx_td ltx_align_center">0.5088</td>
<td id="S4.T1.2.1.4.7" class="ltx_td ltx_align_center ltx_border_r">0.4152</td>
<td id="S4.T1.2.1.4.8" class="ltx_td ltx_align_center">0.5037</td>
<td id="S4.T1.2.1.4.9" class="ltx_td ltx_align_center">0.4904</td>
