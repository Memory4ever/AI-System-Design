<td id="S4.T1.2.1.7.8" class="ltx_td ltx_align_center">0.5529</td>
<td id="S4.T1.2.1.7.9" class="ltx_td ltx_align_center">0.5706</td>
<td id="S4.T1.2.1.7.10" class="ltx_td ltx_align_center ltx_border_r">0.5230</td>
<td id="S4.T1.2.1.7.11" class="ltx_td ltx_align_center">0.4572</td>
<td id="S4.T1.2.1.7.12" class="ltx_td ltx_align_center">0.5831</td>
<td id="S4.T1.2.1.7.13" class="ltx_td ltx_align_center">0.4590</td></tr>
