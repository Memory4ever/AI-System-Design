<td id="S4.T1.2.1.4.12" class="ltx_td ltx_align_center">0.2874</td>
<td id="S4.T1.2.1.4.13" class="ltx_td ltx_align_center">0.2703</td></tr>
<tr id="S4.T1.2.1.5" class="ltx_tr">
<td id="S4.T1.2.1.5.1" class="ltx_td ltx_align_left ltx_border_r">PLIP</td>
<td id="S4.T1.2.1.5.2" class="ltx_td ltx_align_center">0.6679</td>
<td id="S4.T1.2.1.5.3" class="ltx_td ltx_align_center">0.5472</td>
<td id="S4.T1.2.1.5.4" class="ltx_td ltx_align_center ltx_border_r">0.4664</td>
<td id="S4.T1.2.1.5.5" class="ltx_td ltx_align_center">0.5210</td>
