<td id="S4.T1.2.1.5.7" class="ltx_td ltx_align_center ltx_border_r">0.4427</td>
<td id="S4.T1.2.1.5.8" class="ltx_td ltx_align_center">0.4720</td>
<td id="S4.T1.2.1.5.9" class="ltx_td ltx_align_center">0.4843</td>
