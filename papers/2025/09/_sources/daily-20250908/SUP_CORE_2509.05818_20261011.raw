<td id="S2.T1.2.1.3.3" class="ltx_td ltx_align_left">0.350</td></tr>
<tr id="S2.T1.2.1.4" class="ltx_tr">
<td id="S2.T1.2.1.4.1" class="ltx_td"></td>
