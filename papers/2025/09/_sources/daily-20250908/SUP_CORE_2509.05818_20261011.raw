<td id="S2.T1.2.1.5.1" class="ltx_td"></td>
<td id="S2.T1.2.1.5.2" class="ltx_td ltx_align_left">Elderly (76+ years)</td>
<td id="S2.T1.2.1.5.3" class="ltx_td ltx_align_left">0.150</td></tr>
<tr id="S2.T1.2.1.6" class="ltx_tr">
<td id="S2.T1.2.1.6.1" class="ltx_td ltx_align_left">Gender</td>
<td id="S2.T1.2.1.6.2" class="ltx_td ltx_align_left">Male</td>
<td id="S2.T1.2.1.6.3" class="ltx_td ltx_align_left">0.471</td></tr>
<tr id="S2.T1.2.1.7" class="ltx_tr">
<td id="S2.T1.2.1.7.1" class="ltx_td"></td>
