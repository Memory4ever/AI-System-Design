<td id="S2.T1.2.1.9.2" class="ltx_td ltx_align_left">Black or African American</td>
<td id="S2.T1.2.1.9.3" class="ltx_td ltx_align_left">0.100</td></tr>
<tr id="S2.T1.2.1.10" class="ltx_tr">
<td id="S2.T1.2.1.10.1" class="ltx_td"></td>
<td id="S2.T1.2.1.10.2" class="ltx_td ltx_align_left">Hispanic or Latino</td>
<td id="S2.T1.2.1.10.3" class="ltx_td ltx_align_left">0.100</td></tr>
<tr id="S2.T1.2.1.11" class="ltx_tr">
<td id="S2.T1.2.1.11.1" class="ltx_td"></td>
<td id="S2.T1.2.1.11.2" class="ltx_td ltx_align_left">Asian</td>
<td id="S2.T1.2.1.11.3" class="ltx_td ltx_align_left">0.080</td></tr>
