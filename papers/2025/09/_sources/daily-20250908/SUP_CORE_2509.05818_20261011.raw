<span id="A6.T10.2.1.7.2.1.1" class="ltx_p">3/5</span>
</span></td>
<td id="A6.T10.2.1.7.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="A6.T10.2.1.7.3.1" class="ltx_inline-block ltx_align_top" style="width:17.3pt;">
