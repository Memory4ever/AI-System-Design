              select agents by <math id="alg2.l11.m1" class="ltx_Math" alttext="S_{i}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi>S</mi><mi>i</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">S_{i}^{t}</annotation></semantics></math> and get <math id="alg2.l11.m2" class="ltx_Math" alttext="P^{t}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mi>t</mi></msup><annotation encoding="application/x-tex">P^{t}</annotation></semantics></math>.

</div>
<div id="alg2.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              <span id="alg2.l12.3" class="ltx_text ltx_font_bold">for</span> agent in <math id="alg2.l12.m1" class="ltx_Math" alttext="P^{t}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mi>t</mi></msup><annotation encoding="application/x-tex">P^{t}</annotation></semantics></math> <span id="alg2.l12.4" class="ltx_text ltx_font_bold">do</span>



