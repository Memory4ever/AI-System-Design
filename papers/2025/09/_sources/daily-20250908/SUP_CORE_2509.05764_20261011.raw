<figure id="S4.T2" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">Table 2: </span>LLM Prompt Setting.</figcaption>
<table id="S4.T2.2" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
