<span id="S4.T8.5.4.5.1" class="ltx_inline-block ltx_align_top" style="width:37.0pt;">
<span id="S4.T8.5.4.5.1.1" class="ltx_p"><span id="S4.T8.5.4.5.1.1.1" class="ltx_text" style="font-size:90%;">1,002.8</span></span>
</span></td></tr>
