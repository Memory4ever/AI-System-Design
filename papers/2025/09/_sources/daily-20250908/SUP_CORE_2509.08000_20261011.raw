<td id="A1.T4.1.6.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A1.T4.1.6.4.1" class="ltx_text ltx_font_bold">95.3</span></td></tr>
<tr id="A1.T4.1.7" class="ltx_tr">
