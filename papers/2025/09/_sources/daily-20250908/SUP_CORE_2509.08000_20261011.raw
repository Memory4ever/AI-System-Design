<td id="A3.T6.3.8.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T6.3.8.4.1" class="ltx_text ltx_font_bold">13.70</span></td>
<td id="A3.T6.3.8.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="A3.T6.3.8.5.1" class="ltx_text ltx_font_bold">20.10</span></td>
<td id="A3.T6.3.8.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="A3.T6.3.8.6.1" class="ltx_text ltx_font_bold">10.10</span></td>
