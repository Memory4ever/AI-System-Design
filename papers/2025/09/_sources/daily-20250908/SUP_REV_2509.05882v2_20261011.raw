<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(60)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E60.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}_{\text{BC-expert}}(\pi_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>BC-expert</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}_{\text{BC-expert}}(\pi_{\theta})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E60.m2" class="ltx_Math" alttext="\displaystyle=-\mathbb{E}_{(s_{i},h_{i})\sim\mathcal{D}_{\text{traj}}}\left[\sum_{j=1}^{t}\sum_{k=1}^{|f_{j}|}\log\pi_{\theta}(f_{j}^{k}|s_{i},h_{i,&lt;j},\phi_{j},f_{j}^{&lt;k})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>i</mi></msub><mo>,</mo><msub><mi>h</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>traj</mtext></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><msub><mi>f</mi><mi>j</mi></msub><mo stretchy="false">|</mo></mrow></munderover></mstyle><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>f</mi><mi>j</mi><mi>k</mi></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>,</mo><msub><mi>h</mi><mrow><mrow><mi>i</mi><mo>,</mo><mphantom></mphantom></mrow><mo>&lt;</mo><mi>j</mi></mrow></msub><mo>,</mo><msub><mi>ϕ</mi><mi>j</mi></msub><mo>,</mo><msubsup><mi>f</mi><mi>j</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>k</mi></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\mathbb{E}_{(s_{i},h_{i})\sim\mathcal{D}_{\text{traj}}}\left[\sum_{j=1}^{t}\sum_{k=1}^{|f_{j}|}\log\pi_{\theta}(f_{j}^{k}|s_{i},h_{i,&lt;j},\phi_{j},f_{j}^{&lt;k})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="alg1.l26" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l26.1" class="ltx_text" style="font-size:80%;">26:</span></span>
            
            
          <span id="alg1.l26.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l26.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l27" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l27.1" class="ltx_text" style="font-size:80%;">27:</span></span>
            
            
          <span id="alg1.l27.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l27.m1" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math>

</div>
</div>
</figure>
