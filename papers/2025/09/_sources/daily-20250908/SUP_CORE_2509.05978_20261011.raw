<td id="S3.T1.1.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">0.1734</td>
<td id="S3.T1.1.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S3.T1.1.4.3.1" class="ltx_text ltx_font_bold">0.8626</span></td>
