<td id="S4.T4.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T4.2.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Media</span></td>
<td id="S4.T4.2.1.5" class="ltx_td ltx_align_center ltx_border_tt"><math id="S4.T4.m5" class="ltx_Math" alttext="\boldsymbol{\mu}_{\text{macro}}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">𝝁</mi><mtext mathsize="0.900em">macro</mtext></msub><annotation encoding="application/x-tex">\boldsymbol{\mu}_{\text{macro}}</annotation></semantics></math></td></tr>
