<td id="S4.T7.2.6.2" class="ltx_td ltx_align_left" style="padding-left:10.0pt;padding-right:10.0pt;"><math id="S4.T7.m5" class="ltx_Math" alttext="0.799" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.799</mn><annotation encoding="application/x-tex">0.799</annotation></semantics></math></td>
