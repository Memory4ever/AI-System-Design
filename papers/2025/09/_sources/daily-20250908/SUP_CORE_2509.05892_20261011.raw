<span id="S3.T2.2.19.4.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T2.2.19.4.1.1" class="ltx_p ltx_align_center"><span id="S3.T2.2.19.4.1.1.1" class="ltx_text" style="font-size:90%;">—</span></span>
</span></td>
<td id="S3.T2.2.19.5" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">
