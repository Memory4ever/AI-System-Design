<td id="S4.T7.2.6.4" class="ltx_td ltx_align_left" style="padding-left:10.0pt;padding-right:10.0pt;"><math id="S4.T7.m6" class="ltx_Math" alttext="0.761" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.761</mn><annotation encoding="application/x-tex">0.761</annotation></semantics></math></td>
