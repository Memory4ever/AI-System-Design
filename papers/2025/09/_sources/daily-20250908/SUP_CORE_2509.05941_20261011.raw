<th id="S3.T1.2.9.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_t"><math id="S3.T1.m7" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo>∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math><span id="S3.T1.2.9.2.1" class="ltx_text ltx_font_bold">2.4</span></th>
