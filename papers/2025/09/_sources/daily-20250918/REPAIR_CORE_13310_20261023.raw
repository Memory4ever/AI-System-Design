<td id="S3.T4.2.5.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T4.2.5.5.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0F75FF;">+8.0</span></td>
