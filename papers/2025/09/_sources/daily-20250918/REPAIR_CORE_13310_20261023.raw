<td id="S3.T5.2.6.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T5.2.6.5.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0F75FF;">+3.1</span></td>
<td id="S3.T5.2.6.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T5.2.6.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0F75FF;">+0.4</span></td>
