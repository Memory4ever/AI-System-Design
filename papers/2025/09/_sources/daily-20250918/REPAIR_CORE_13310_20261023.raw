<td id="S3.T3.2.10.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T3.2.10.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0F75FF;">+1.0</span></td></tr>
