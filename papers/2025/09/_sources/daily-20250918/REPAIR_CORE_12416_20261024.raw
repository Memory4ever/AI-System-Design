<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex121.m1" class="ltx_Math" alttext="\displaystyle\leq c_{1}(1+1/c_{2}^{2}+1/c_{2})\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mn>1</mn><mo>/</mo><msubsup><mi>c</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>1</mn><mo>/</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq c_{1}(1+1/c_{2}^{2}+1/c_{2})\delta_{n}</annotation></semantics></math></td>
