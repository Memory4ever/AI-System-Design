<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex272.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\mathbb{E}\biggl[\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl\{\mathbb{E}[M_{c}(L_{i}^{(1)},L_{i}^{(2)})\mid\bm{Y}_{i},\bm{Z}_{i}]-\mathbb{E}[\mathbbm{1}\{L_{i}=c\}\mid\bm{Y}_{i},\bm{Z}_{i}]\biggr\}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">{</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\mathbb{E}\biggl[\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl\{\mathbb{E}[M_{c}(L_{i}^{(1)},L_{i}^{(2)})\mid\bm{Y}_{i},\bm{Z}_{i}]-\mathbb{E}[\mathbbm{1}\{L_{i}=c\}\mid\bm{Y}_{i},\bm{Z}_{i}]\biggr\}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
