<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex158.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]\biggr)\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><msub><mrow></mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo stretchy="false">[</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mrow><mi>𝔼</mi><msub><mrow></mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo stretchy="false">[</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]\biggr)\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p8.2" class="ltx_p"><span id="A2.SS3.p8.2.1" class="ltx_text">where the second line is by Assumption <a href="#Thmassumption3" title="Assumption 3 (Human Annotation Sampling) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, the third equality is by the law of iterated expectation, and the last line is by Assumption <a href="#Thmassumption4" title="Assumption 4 (Sufficiency of Representation for Texts) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</span></p>
</div>
<div id="A2.SS3.p9" class="ltx_para">
<p id="A2.SS3.p9.1" class="ltx_p"><span id="A2.SS3.p9.1.1" class="ltx_text">For <math id="A2.SS3.p9.m1" class="ltx_Math" alttext="R_{2}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>2</mn></msub><annotation encoding="application/x-tex">R_{2}</annotation></semantics></math>,</span></p>
<table id="A2.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex159"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex159.m1" class="ltx_Math" alttext="\displaystyle R_{2}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle R_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex159.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbbm{1}\{T_{i}=t\}}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]\mid\bm{Z}_{i},T_{i}=t]\biggr)\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><mi>𝔼</mi><msub><mrow></mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo stretchy="false">[</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbbm{1}\{T_{i}=t\}}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]\mid\bm{Z}_{i},T_{i}=t]\biggr)\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
