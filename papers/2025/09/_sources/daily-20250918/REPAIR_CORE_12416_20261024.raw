"false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>q</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq|g\bigl(X_{c}^{(1)},\hat{p}_{c}^{(1)},\hat{q}_{c}^{(1)}\bigr)|\biggl|g\bigl(X_{c}^{(2)},\hat{p}_{c}^{(2)},\hat{q}_{c}^{(2)}\bigr)-g\bigl(X_{c}^{(2)},{p}_{c}^{(2)},{q}_{c}^{(2)}\bigr)\biggr|</annotation></semantics></math></td>
