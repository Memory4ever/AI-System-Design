/mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad+\biggl|g\bigl(X_{c}^{(2)},{p}_{c}^{(2)},{q}_{c}^{(2)}\bigr)\biggl(g\bigl(X_{c}^{(1)},\hat{p}_{c}^{(1)},\hat{q}_{c}^{(1)}\bigr)-g\bigl(X_{c}^{(1)},{p}_{c}^{(1)},{q}_{c}^{(1)}\bigr)\biggr)\biggr|</annotation></semantics></math></td>
