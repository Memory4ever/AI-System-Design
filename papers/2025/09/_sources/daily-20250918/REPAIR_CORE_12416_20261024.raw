false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em" rspace="0.170em">)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>d</mi><mi>𝒚</mi><mi>d</mi><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S=1)}\int_{\mathcal{Z}}\int_{\mathcal{W}}\mathbbm{1}\{\bm{f}(\bm{y})=\bm{f}(\tilde{\bm{y}}),\bm{z}=\tilde{\bm{z}}\}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{f}(\bm{y}),\bm{z},S_{i}=1]\biggr)\,\frac{\,f_{\mathcal{P}}(\bm{f}(\bm{y})\mid\bm{z},T_{i}=t)f_{\mathcal{P}}(\bm{z})}{f_{\mathcal{P}}(\bm{f}(\bm{y}),\bm{z})}d\bm{y}d\bm{z}</annotation></semantics></math></td>
