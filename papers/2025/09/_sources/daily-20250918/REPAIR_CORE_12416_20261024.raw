<tbody id="A2.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex114.m1" class="ltx_Math" alttext="\displaystyle\leq c_{1}(1/c_{2}^{2}+1)\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>1</mn><mo>/</mo><msubsup><mi>c</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq c_{1}(1/c_{2}^{2}+1)\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p4.4" class="ltx_p"><span id="A2.SS3.p4.4.1" class="ltx_text">where the third, sixth, and ninth lines are by Cauchy-Schwartz inequality and the eighth line is by triangular inequality.</span></p>
</div>
<div id="A2.SS3.p5" class="ltx_para">
<p id="A2.SS3.p5.1" class="ltx_p"><span id="A2.SS3.p5.1.1" class="ltx_text">For <math id="A2.SS3.p5.m1" class="ltx_Math" alttext="H_{22}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>22</mn></msub><annotation encoding="application/x-tex">H_{22}</annotation></semantics></math>,</span></p>
