<tbody id="A2.Ex233"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex233.m1" class="ltx_math_unparsed" alttext="\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mrow><mo lspace="0em" mathsize="2.100em" rspace="0em">)</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex234"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex234.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbbm{1}\{L_{i}=c\}\times\mathbbm{1}\{L_{i}=c\}=\mathbbm{1}\{L_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbbm{1}\{L_{i}=c\}\times\mathbbm{1}\{L_{i}=c\}=\mathbbm{1}\{L_{i}=c\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.p1.3" class="ltx_p">where the second equality is because <math id="A2.SS5.p1.m9" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}\;\mbox{$\perp\!\!\!\perp$}\;\bm{Y}_{i}\mid L_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.558em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><mo fence="false">|</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}\;\mbox{$\perp\!\!\!\perp$}\;\bm{Y}_{i}\mid L_{i}</annotation></semantics></math> (i.e., exclusion restriction). Hence, by exploiting the independence, we have</p>
<table id="A2.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex235"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex235.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbbm{1}\{L_{i}=c\}=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i},\bm{Y}_{i}]=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i}]" display="inline" intent=":literal"><semantics><mrow><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbbm{1}\{L_{i}=c\}=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i},\bm{Y}_{i}]=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex235.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i})]=\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i})]=\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.p1.4" class="ltx_p">where the second equality is by Assumption <a href="#Thmassumption1" title="Assumption 1 (True Coding Rule) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. Therefore,</p>
<table id="A2.EGx99" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex236"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex236.m1" class="ltx_Math" alttext="\displaystyle\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex236.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex237"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex237.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i},L_{i}]\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i},L_{i}]\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex238"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex238.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i}]\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i}]\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex239"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex239.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex240"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex240.m1" class="ltx_Math" alttext="\displaystyle=\mu_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>μ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mu_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.p1.5" class="ltx_p">which proves the claim mentioned after Equation (<a href="#S4.E14" title="In 4.2 Estimation and inference ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>).</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A2.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">S2.6 </span>Proof of Theorem <a href="#Thmtheorem3" title="Theorem 3 (Influence Function) ‣ 4.2 Estimation and inference ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> (Influence function without true labels)</h3>

<div id="A2.SS6.p1" class="ltx_para">
<p id="A2.SS6.p1.1" class="ltx_p">Following Theorem <a href="#Thmtheorem1" title="Theorem 1 (Efficient Influence Function) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we first derive the efficient influence function for <math id="A2.SS6.p1.m1" class="ltx_Math" alttext="\Psi_{t,c}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\Psi_{t,c}</annotation></semantics></math> with the full data.</p>
</div>
<div id="Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma2.2" class="ltx_text ltx_font_smallcaps">Lemma 2</span></span><span id="Thmlemma2.3" class="ltx_text ltx_font_smallcaps"> (Efficient influence function)</span></h6>
<div id="Thmlemma2.p1" class="ltx_para">
<p id="Thmlemma2.p1.1" class="ltx_p"><span id="Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">The efficient influence function for the distribution of the covariate-adjusted outcome under <math id="Thmlemma2.p1.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> is given by</span></p>
<table id="A2.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex241"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex241.m1" class="ltx_Math" alttext="\displaystyle\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi,\bar{m}_{tc},\Psi_{t,c})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><msub><mi>μ</mi><mi>c</mi></msub><mo>,</mo><mi>π</mi><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi,\bar{m}_{tc},\Psi_{t,c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex242"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex242.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbbm{1}\{L_{i}=c\}-\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo>+</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbbm{1}\{L_{i}=c\}-\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma2.p1.2" class="ltx_p"><span id="Thmlemma2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma2.p1.m2" class="ltx_Math" alttext="\mu_{c}(\bm{f}(\bm{Y}_{i}))=\mathbb{P}[L_{i}=c\mid\bm{f}(\bm{Y}_{i})]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{c}(\bm{f}(\bm{Y}_{i}))=\mathbb{P}[L_{i}=c\mid\bm{f}(\bm{Y}_{i})]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS6.p2" class="ltx_para">
<p id="A2.SS6.p2.1" class="ltx_p"><span id="A2.SS6.p2.1.1" class="ltx_text">Following the proof of Theorem <a href="#Thmtheorem1" title="Theorem 1 (Efficient Influence Function) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we use the point-mass contamination approach. Now, the identification formula is</span></p>
<table id="A2.EGx101" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex243"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex243.m1" class="ltx_Math" alttext="\displaystyle\Psi_{t,c}(\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Psi_{t,c}(\mathcal{P})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex243.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid T_{i}=t,\bm{Z}_{i}]\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid T_{i}=t,\bm{Z}_{i}]\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex244"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex244.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\mathbb{E}_{\mathcal{P}}[\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]\mid T_{i}=t,\bm{Z}_{i}]\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\mathbb{E}_{\mathcal{P}}[\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]\mid T_{i}=t,\bm{Z}_{i}]\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex245"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex245.m1" class="ltx_math_unparsed" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]dF(\bm{Y}_{i}\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i})." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mi>d</mi><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]dF(\bm{Y}_{i}\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p2.2" class="ltx_p"><span id="A2.SS6.p2.2.1" class="ltx_text">Hence, by replacing only the original outcome model with <math id="A2.SS6.p2.m1" class="ltx_math_unparsed" alttext="\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]</annotation></semantics></math> in the proof of Theorem <a href="#Thmtheorem1" title="Theorem 1 (Efficient Influence Function) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, we obtain the following:</span></p>
<table id="A2.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex246"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex246.m1" class="ltx_Math" alttext="\displaystyle\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi,\bar{m}_{tc},\Psi_{t,c})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><msub><mi>μ</mi><mi>c</mi></msub><mo>,</mo><mi>π</mi><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi,\bar{m}_{tc},\Psi_{t,c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex247"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex247.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\pi_{t}(\bm{f}(\bm{Y}_{i}))}{\mathbb{P}(T_{i}=t)}\biggl(\mathbbm{1}\{L_{i}=c\}-\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}))\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\mathbb{P}(T_{i}=t)}\biggl(\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}))-\bar{m}_{tc}(\bm{Z}_{i})\biggr)+\bar{m}_{tc}(\bm{Z}_{i})-\Psi_{t,c}." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo>+</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\pi_{t}(\bm{f}(\bm{Y}_{i}))}{\mathbb{P}(T_{i}=t)}\biggl(\mathbbm{1}\{L_{i}=c\}-\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}))\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\mathbb{P}(T_{i}=t)}\biggl(\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}))-\bar{m}_{tc}(\bm{Z}_{i})\biggr)+\bar{m}_{tc}(\bm{Z}_{i})-\Psi_{t,c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p2.3" class="ltx_p"><span id="A2.SS6.p2.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS6.p3" class="ltx_para ltx_noindent">
<p id="A2.SS6.p3.1" class="ltx_p">Based on this result, we have a guess that if we replace the hidden outcome <math id="A2.SS6.p3.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> with some estimable but unbiased substitute, it works as an influence function. To formally prove this, we first derive the most important lemma that characterizes the relationship between the observed data influence function and the full data influence function.</p>
</div>
<div id="Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma3.2" class="ltx_text ltx_font_smallcaps">Lemma 3</span></span><span id="Thmlemma3.3" class="ltx_text ltx_font_smallcaps"> (Characterization of the observed data influence function)</span></h6>
<div id="Thmlemma3.p1" class="ltx_para">
<p id="Thmlemma3.p1.1" class="ltx_p"><span id="Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">Any observed influence function <math id="Thmlemma3.p1.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> and any full data influence function <math id="Thmlemma3.p1.m2" class="ltx_Math" alttext="Q^{F}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mi>F</mi></msup><annotation encoding="application/x-tex">Q^{F}</annotation></semantics></math> must satisfy</span></p>
<table id="A2.E9" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E9X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E9X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Q\mid S_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid S_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E9X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid S_{i}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid S_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(S9)</span></td></tr>
<tr id="A2.E9Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E9Xa.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Q\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E9Xa.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><msup><mrow></mrow><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS6.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS6.p4" class="ltx_para">
<p id="A2.SS6.p4.1" class="ltx_p"><span id="A2.SS6.p4.1.1" class="ltx_text">This proof goes analogous to that of Lemma 2 in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib71" title="" class="ltx_ref">Zhou and Tchetgen, (2024)</a></cite>. Let <math id="A2.SS6.p4.m1" class="ltx_Math" alttext="G_{S_{i}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><msub><mi>S</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G_{S_{i}}(\cdot)</annotation></semantics></math> be a coarsening operator with coarsening variable <math id="A2.SS6.p4.m2" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math>, which just means that</span></p>
<table id="A2.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex248"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex248.m1" class="ltx_Math" alttext="\displaystyle G_{S_{i}}(\{\tilde{L}^{(j)}_{i}\}_{j=1}^{J})=\begin{cases}\{\tilde{L}^{(1)}_{i},\cdots,\tilde{L}^{(j)}_{i}\}\quad\text{ if }S_{i}=1\\
\emptyset\quad\text{otherwise}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><msub><mi>S</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>J</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi mathvariant="normal">∅</mi><mspace style="width:1em;" width="1em"></mspace><mtext>otherwise</mtext></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle G_{S_{i}}(\{\tilde{L}^{(j)}_{i}\}_{j=1}^{J})=\begin{cases}\{\tilde{L}^{(1)}_{i},\cdots,\tilde{L}^{(j)}_{i}\}\quad\text{ if }S_{i}=1\\
\emptyset\quad\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p4.2" class="ltx_p"><span id="A2.SS6.p4.2.1" class="ltx_text">and <math id="A2.SS6.p4.m3" class="ltx_Math" alttext="Q=Q(S_{i},T_{i},\bm{Y}_{i},G_{S_{i}}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i}))" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>=</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>G</mi><msub><mi>S</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q=Q(S_{i},T_{i},\bm{Y}_{i},G_{S_{i}}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i}))</annotation></semantics></math> be any observed data influence function. Then, <math id="A2.SS6.p4.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> must satisfy the following <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib61" title="" class="ltx_ref">Tsiatis,, 2006</a>; <a href="#bib.bib34" title="" class="ltx_ref">Ichimura and Newey,, 2022</a>)</cite>:</span></p>
<table id="A2.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex249"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex249.m1" class="ltx_math_unparsed" alttext="\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}=\mathbb{E}\biggl[Q\;\mathbb{E}[U^{F}\mid S_{i},\bm{Z}_{i},T_{i},\bm{Y}_{i},G_{S_{i}}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})]\biggr]=\mathbb{E}\biggl[Q\ U^{F}\biggr]" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ϵ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>ϵ</mi></mfrac></mstyle><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>Q</mi><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi>U</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>G</mi><msub><mi>S</mi><mi>i</mi></msub></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>Q</mi><msup><mi>U</mi><mi>F</mi></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}=\mathbb{E}\biggl[Q\;\mathbb{E}[U^{F}\mid S_{i},\bm{Z}_{i},T_{i},\bm{Y}_{i},G_{S_{i}}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})]\biggr]=\mathbb{E}\biggl[Q\ U^{F}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p4.3" class="ltx_p"><span id="A2.SS6.p4.3.1" class="ltx_text">where <math id="A2.SS6.p4.m5" class="ltx_Math" alttext="U^{F}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mi>F</mi></msup><annotation encoding="application/x-tex">U^{F}</annotation></semantics></math> is the full data oracle score (see Chapter 7 of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib61" title="" class="ltx_ref">Tsiatis, 2006</a></cite> for the theoretical details of the observed data score function). Similarly, for the full data influence function, denoted as <math id="A2.SS6.p4.m6" class="ltx_Math" alttext="Q^{F}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mi>F</mi></msup><annotation encoding="application/x-tex">Q^{F}</annotation></semantics></math>, we also have</span></p>
<table id="A2.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex250"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex250.m1" class="ltx_Math" alttext="\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}=\mathbb{E}\biggl[Q^{F}U^{F}\biggr]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ϵ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>ϵ</mi></mfrac></mstyle></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>U</mi><mi>F</mi></msup></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}=\mathbb{E}\biggl[Q^{F}U^{F}\biggr].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p4.4" class="ltx_p"><span id="A2.SS6.p4.4.1" class="ltx_text">Now, by factorization, <math id="A2.SS6.p4.m7" class="ltx_Math" alttext="U^{F}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mi>F</mi></msup><annotation encoding="application/x-tex">U^{F}</annotation></semantics></math> (i.e., the full data score we considered in the previous setting) is written as</span></p>
<table id="A2.EGx106" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex251"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex251.m1" class="ltx_Math" alttext="\displaystyle U^{F}=g_{s}(S_{i})+g_{z}(\bm{Z}_{i})+g_{t}(T_{i},\bm{Z}_{i})+g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>U</mi><mi>F</mi></msup><mo>=</mo><mrow><mrow><msub><mi>g</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>g</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>g</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle U^{F}=g_{s}(S_{i})+g_{z}(\bm{Z}_{i})+g_{t}(T_{i},\bm{Z}_{i})+g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p4.5" class="ltx_p"><span id="A2.SS6.p4.5.1" class="ltx_text">for any <math id="A2.SS6.p4.m8" class="ltx_Math" alttext="g_{s}\in\Lambda_{S}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>s</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>S</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{s}\in\Lambda_{S}^{F}</annotation></semantics></math>, <math id="A2.SS6.p4.m9" class="ltx_Math" alttext="g_{z}\in\Lambda_{Z}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>z</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>Z</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{z}\in\Lambda_{Z}^{F}</annotation></semantics></math>, <math id="A2.SS6.p4.m10" class="ltx_Math" alttext="g_{t}\in\Lambda_{T}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>T</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{t}\in\Lambda_{T}^{F}</annotation></semantics></math>, and <math id="A2.SS6.p4.m11" class="ltx_Math" alttext="g_{y}\in\Lambda_{Y}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>y</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>Y</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{y}\in\Lambda_{Y}^{F}</annotation></semantics></math>, where</span></p>
<table id="A2.EGx107" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex252"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex252.m1" class="ltx_Math" alttext="\displaystyle\Lambda_{S}^{F}=\biggl\{g_{s}(S_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{s}(S_{i})]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Λ</mi><mi>S</mi><mi>F</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>g</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>F</mi></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>g</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{S}^{F}=\biggl\{g_{s}(S_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{s}(S_{i})]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex253"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex253.m1" class="ltx_Math" alttext="\displaystyle\Lambda_{Z}^{F}=\biggl\{g_{z}(\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{z}(\bm{Z}_{i})]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Λ</mi><mi>Z</mi><mi>F</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>g</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>F</mi></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>g</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{Z}^{F}=\biggl\{g_{z}(\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{z}(\bm{Z}_{i})]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex254"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex254.m1" class="ltx_Math" alttext="\displaystyle\Lambda_{T}^{F}=\biggl\{g_{t}(T_{i},\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{t}(T_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Λ</mi><mi>T</mi><mi>F</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>F</mi></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{T}^{F}=\biggl\{g_{t}(T_{i},\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{t}(T_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex255"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex255.m1" class="ltx_math_unparsed" alttext="\displaystyle\Lambda_{\bm{Y}}^{F}=\biggl\{g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\mid T_{i},\bm{Z}_{i}]=0\biggr\}," display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Λ</mi><mi>𝒀</mi><mi>F</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>g</mi><mi>y</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>F</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>g</mi><mi>y</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{\bm{Y}}^{F}=\biggl\{g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\mid T_{i},\bm{Z}_{i}]=0\biggr\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p4.6" class="ltx_p"><span id="A2.SS6.p4.6.1" class="ltx_text">and <math id="A2.SS6.p4.m12" class="ltx_Math" alttext="\mathcal{H}^{F}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>F</mi></msup><annotation encoding="application/x-tex">\mathcal{H}^{F}</annotation></semantics></math> is the Hilbert space of the oracle data (the data we are working with in the previous section’s setting). Hence,</span></p>
<table id="A2.EGx108" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex256"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex256.m1" class="ltx_Math" alttext="\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ϵ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>ϵ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex257"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex257.m1" class="ltx_Math" alttext="\displaystyle=\begin{cases}\mathbb{E}\biggl[\mathbb{E}[Q\mid S_{i}]g_{s}(S_{i})+\mathbb{E}[Q\mid\bm{Z}_{i}]g_{z}(\bm{Z}_{i})+\mathbb{E}[Q\mid T_{i}]\ g_{t}(T_{i},\bm{Z}_{i})+\mathbb{E}[Q\mid T_{i},\bm{Y}_{i}]\ g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\biggr]\\
\mathbb{E}\biggl[\mathbb{E}[Q^{F}\mid S_{i}]g_{s}(S_{i})+\mathbb{E}[Q^{F}\mid\bm{Z}_{i}]g_{z}(\bm{Z}_{i})+\mathbb{E}[Q^{F}\mid T_{i}]\ g_{t}(T_{i},\bm{Z}_{i})+\mathbb{E}[Q^{F}\mid T_{i},\bm{Y}_{i}]\ g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\biggr].\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>z</mi></msub><mo stretchy="false">(</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>y</mi></msub><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><msup><mrow></mrow><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><msup><mrow></mrow><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>z</mi></msub><mo stretchy="false">(</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><msup><mrow></mrow><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><msup><mrow></mrow><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>y</mi></msub><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo maxsize="2.100em" minsize="2.100em">]</mo><mo lspace="0em">.</mo></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\mathbb{E}\biggl[\mathbb{E}[Q\mid S_{i}]g_{s}(S_{i})+\mathbb{E}[Q\mid\bm{Z}_{i}]g_{z}(\bm{Z}_{i})+\mathbb{E}[Q\mid T_{i}]\ g_{t}(T_{i},\bm{Z}_{i})+\mathbb{E}[Q\mid T_{i},\bm{Y}_{i}]\ g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\biggr]\\
\mathbb{E}\biggl[\mathbb{E}[Q^{F}\mid S_{i}]g_{s}(S_{i})+\mathbb{E}[Q^{F}\mid\bm{Z}_{i}]g_{z}(\bm{Z}_{i})+\mathbb{E}[Q^{F}\mid T_{i}]\ g_{t}(T_{i},\bm{Z}_{i})+\mathbb{E}[Q^{F}\mid T_{i},\bm{Y}_{i}]\ g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\biggr].\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p4.7" class="ltx_p"><span id="A2.SS6.p4.7.1" class="ltx_text">Thus, to align these two expressions for any <math id="A2.SS6.p4.m13" class="ltx_Math" alttext="g_{s}\in\Lambda_{S}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>s</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>S</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{s}\in\Lambda_{S}^{F}</annotation></semantics></math>, <math id="A2.SS6.p4.m14" class="ltx_Math" alttext="g_{s}\in\Lambda_{T}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>s</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>T</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{s}\in\Lambda_{T}^{F}</annotation></semantics></math>, and <math id="A2.SS6.p4.m15" class="ltx_Math" alttext="g_{y}\in\Lambda_{Y}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>y</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>Y</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{y}\in\Lambda_{Y}^{F}</annotation></semantics></math>, we must have</span></p>
<table id="A2.EGx109" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex258"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex258.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Q\mid S_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid S_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex258.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid S_{i}]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid S_{i}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex259"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex259.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Q\mid\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex259.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Z}_{i}]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Z}_{i}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex260"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex260.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[Q\mid T_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid T_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex260.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid T_{i},\bm{Z}_{i}]," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid T_{i},\bm{Z}_{i}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex261"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex261.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[Q\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex261.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p4.8" class="ltx_p"><span id="A2.SS6.p4.8.1" class="ltx_text">Note that the second and third conditions are redundant since the fourth implies the second and the third by the law of iterated expectations.
∎</span></p>
</div>
</div>
<div id="A2.SS6.p5" class="ltx_para ltx_noindent">
<p id="A2.SS6.p5.1" class="ltx_p">Using these derived results, we prove Theorem <a href="#Thmtheorem3" title="Theorem 3 (Influence Function) ‣ 4.2 Estimation and inference ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<div id="A2.SS6.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS6.p6" class="ltx_para">
<p id="A2.SS6.p6.1" class="ltx_p"><span id="A2.SS6.p6.1.1" class="ltx_text">From Lemma <a href="#Thmlemma3" title="Lemma 3 (Characterization of the observed data influence function) ‣ S2.6 Proof of Theorem (Influence function without true labels) ‣ Appendix S2 Theoretical Results ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, we know the relationship between the full data influence function and the observed data influence function. Now, let</span></p>
<table id="A2.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex262"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex262.m1" class="ltx_Math" alttext="\displaystyle Q^{F}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mi>F</mi></msup><annotation encoding="application/x-tex">\displaystyle Q^{F}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex262.m2" class="ltx_Math" alttext="\displaystyle=\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi,\Psi_{t,c})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><msub><mi>μ</mi><mi>c</mi></msub><mo>,</mo><mi>π</mi><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi,\Psi_{t,c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p6.2" class="ltx_p"><span id="A2.SS6.p6.2.1" class="ltx_text">and check if the expression</span></p>
<table id="A2.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex263"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex263.m1" class="ltx_Math" alttext="\displaystyle\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex263.m2" class="ltx_math_unparsed" alttext="\displaystyle;\bm{f},\tilde{\mu},\pi_{t},M_{c},\bar{m}_{tc},\Psi_{t,c})" display="inline" intent=":literal"><semantics><mrow><mo>;</mo><mi>𝒇</mi><mo>,</mo><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msub><mi>M</mi><mi>c</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle;\bm{f},\tilde{\mu},\pi_{t},M_{c},\bar{m}_{tc},\Psi_{t,c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex264"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex264.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl(M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})-\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl(M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})-\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex265"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex265.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr)+\bar{m}_{t,c}(\bm{Z}_{i})-\Psi_{t,c}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr)+\bar{m}_{t,c}(\bm{Z}_{i})-\Psi_{t,c}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p6.3" class="ltx_p"><span id="A2.SS6.p6.3.1" class="ltx_text">satisfies the condition in the previous lemma. Now, because outcome model is mathematically equivalent, we have</span></p>
<table id="A2.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex266"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex266.m1" class="ltx_math_unparsed" alttext="\displaystyle\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}." display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">{</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p6.4" class="ltx_p"><span id="A2.SS6.p6.4.1" class="ltx_text">Thus,</span></p>
<ul id="A2.I1" class="ltx_itemize">
<li id="A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i1.p1" class="ltx_para">
<p id="A2.I1.i1.p1.1" class="ltx_p"><math id="A2.I1.i1.p1.m1" class="ltx_Math" alttext="\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid S_{i}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid S_{i}]=0</annotation></semantics></math>: Now,</p>
