<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex212.m2" class="ltx_Math" alttext="\displaystyle=\begin{bmatrix}\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=0\mid\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=C\mid\bm{Z}_{i},S_{i}=1)\\
\vdots&amp;\ddots&amp;\vdots\\
\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=0\mid\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=C\mid\bm{Z}_{i},S_{i}=1)\end{bmatrix}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=0\mid\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=C\mid\bm{Z}_{i},S_{i}=1)\\
\vdots&amp;\ddots&amp;\vdots\\
\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=0\mid\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=C\mid\bm{Z}_{i},S_{i}=1)\end{bmatrix}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.3" class="ltx_p"><span id="A2.SS4.p3.3.1" class="ltx_text">Now, notice that by Assumption <a href="#Thmassumption9" title="Assumption 9 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, we have</span></p>
<table id="A2.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex213"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex213.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i}=l)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i}=l)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex213.m2" class="ltx_Math" alttext="\displaystyle&gt;\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}_{i}^{(j)}=l^{\prime}\mid L_{i}=l)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>≠</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></munder></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msup><mi>l</mi><mo>′</mo></msup></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&gt;\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}_{i}^{(j)}=l^{\prime}\mid L_{i}=l)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex214"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex214.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(j)}=\tilde{L}^{(j^{\prime})}=l,T_{i}=t\mid\bm{Z}_{i},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>l</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(j)}=\tilde{L}^{(j^{\prime})}=l,T_{i}=t\mid\bm{Z}_{i},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex214.m2" class="ltx_math_unparsed" alttext="\displaystyle&gt;\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}^{(j)}=l^{\prime},\tilde{L}^{(j^{\prime})}=l,T_{i}=t\mid\bm{Z}_{i},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mo>&gt;</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>≠</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></munder></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>l</mi><mo>′</mo></msup><mo>,</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>l</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&gt;\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}^{(j)}=l^{\prime},\tilde{L}^{(j^{\prime})}=l,T_{i}=t\mid\bm{Z}_{i},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.4" class="ltx_p"><span id="A2.SS4.p3.4.1" class="ltx_text">and by marginalizing over <math id="A2.SS4.p3.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math>,</span></p>
<table id="A2.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex215"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex215.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(j)}=\tilde{L}^{(j^{\prime})}=l\mid\bm{Z}_{i},S_{i}=1)&gt;\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}^{(j)}=l^{\prime},\tilde{L}^{(j^{\prime})}=l\mid\bm{Z}_{i},S_{i}=1)." display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>l</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>≠</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></munder></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>l</mi><mo>′</mo></msup><mo>,</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>l</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(j)}=\tilde{L}^{(j^{\prime})}=l\mid\bm{Z}_{i},S_{i}=1)&gt;\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}^{(j)}=l^{\prime},\tilde{L}^{(j^{\prime})}=l\mid\bm{Z}_{i},S_{i}=1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.5" class="ltx_p"><span id="A2.SS4.p3.5.1" class="ltx_text">These indicate the strong diagonal dominance, so <math id="A2.SS4.p3.m2" class="ltx_Math" alttext="\bm{A}^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{A}^{(j)}</annotation></semantics></math>, <math id="A2.SS4.p3.m3" class="ltx_Math" alttext="\bm{M}(t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{M}(t,\bm{Z}_{i})</annotation></semantics></math>, and <math id="A2.SS4.p3.m4" class="ltx_Math" alttext="\bm{M}(\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{M}(\bm{Z}_{i})</annotation></semantics></math> are all invertible. Thus, we can write</span></p>
<table id="A2.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex216"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex216.m1" class="ltx_Math" alttext="\displaystyle\bm{M}(t,\bm{Z}_{i})\bm{M}(\bm{Z}_{i})^{-1}=\bm{A}^{(1)}\bm{D}(t,\bm{Z}_{i})(\bm{A}^{(1)})^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>=</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{M}(t,\bm{Z}_{i})\bm{M}(\bm{Z}_{i})^{-1}=\bm{A}^{(1)}\bm{D}(t,\bm{Z}_{i})(\bm{A}^{(1)})^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex217"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex217.m1" class="ltx_Math" alttext="\displaystyle\bm{M}(\bm{Z}_{i})^{\scriptscriptstyle\mathsf{T}}\bm{M}(t,\bm{Z}_{i})^{-{\scriptscriptstyle\mathsf{T}}}=\bm{A}^{(2)}\bm{D}(t)(\bm{A}^{(2)})^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi mathsize="0.710em">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi mathsize="0.710em">𝖳</mi></mrow></msup></mrow><mo>=</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{M}(\bm{Z}_{i})^{\scriptscriptstyle\mathsf{T}}\bm{M}(t,\bm{Z}_{i})^{-{\scriptscriptstyle\mathsf{T}}}=\bm{A}^{(2)}\bm{D}(t)(\bm{A}^{(2)})^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.6" class="ltx_p"><span id="A2.SS4.p3.6.1" class="ltx_text">where <math id="A2.SS4.p3.m5" class="ltx_Math" alttext="X^{-{\scriptscriptstyle\mathsf{T}}}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mrow><mo>−</mo><mi mathsize="0.710em">𝖳</mi></mrow></msup><annotation encoding="application/x-tex">X^{-{\scriptscriptstyle\mathsf{T}}}</annotation></semantics></math> denotes the transpose and inverse of the matrix <math id="A2.SS4.p3.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Hence, we can use the standard eigenvalue decomposition to identify <math id="A2.SS4.p3.m7" class="ltx_Math" alttext="\bm{A}^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{A}^{(j)}</annotation></semantics></math> and <math id="A2.SS4.p3.m8" class="ltx_Math" alttext="\bm{D}(t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝑫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{D}(t,\bm{Z}_{i})</annotation></semantics></math> / <math id="A2.SS4.p3.m9" class="ltx_Math" alttext="\bm{D}(\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝑫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{D}(\bm{Z}_{i})</annotation></semantics></math> up to scale and permutation. In this case, however, for the scale, since the column of <math id="A2.SS4.p3.m10" class="ltx_Math" alttext="\bm{A}^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{A}^{(j)}</annotation></semantics></math> sums up to 1, the scale is fixed. The only problem is the permutation, but under Assumption <a href="#Thmassumption9" title="Assumption 9 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, it is guaranteed that the diagonal element of <math id="A2.SS4.p3.m11" class="ltx_Math" alttext="\bm{A}^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{A}^{(j)}</annotation></semantics></math> is the largest and unique, which fixes the challenge of permutation. As a result, we can pinpoint <math id="A2.SS4.p3.m12" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)</annotation></semantics></math> and <math id="A2.SS4.p3.m13" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(2)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(2)}_{i}=l\mid L_{i}=c)</annotation></semantics></math>. Notice that we can also have</span></p>
<table id="A2.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex218"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex218.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex219"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex219.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c,T_{i}=t,\bm{Z}_{i},S_{i}=1)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo rspace="0.500em" stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c,T_{i}=t,\bm{Z}_{i},S_{i}=1)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex220"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex220.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c,T_{i}=t,\bm{Z}_{i})\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c,T_{i}=t,\bm{Z}_{i})\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex221"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex221.m1" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo>,</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.500em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex222"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex222.m1" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})\ \mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.500em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.500em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})\ \mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.7" class="ltx_p"><span id="A2.SS4.p3.7.1" class="ltx_text">where the second one is by Assumptions <a href="#Thmassumption3" title="Assumption 3 (Human Annotation Sampling) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#Thmassumption6" title="Assumption 6 (Human Annotation Sampling) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> (i.e., random sampling of human annotations), the third one is by exclusion restriction and conditional ignorability, the last one is by independent coding assumption. Hence, once <math id="A2.SS4.p3.m14" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)</annotation></semantics></math> and <math id="A2.SS4.p3.m15" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(2)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(2)}_{i}=l\mid L_{i}=c)</annotation></semantics></math> are obtained, we can insert them into the decomposition</span></p>
<table id="A2.E8" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E8X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E8X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E8X.m3" class="ltx_Math" alttext="\displaystyle=m\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mphantom></mphantom><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=m\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(S8)</span></td></tr>
<tr id="A2.E8Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E8Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\;\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})\;\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.280em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.280em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\;\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})\;\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.8" class="ltx_p"><span id="A2.SS4.p3.8.1" class="ltx_text">and obtain <math id="A2.SS4.p3.m16" class="ltx_Math" alttext="\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})</annotation></semantics></math> and can obtain the quantity of interest, since</span></p>
<table id="A2.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex223"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex223.m1" class="ltx_Math" alttext="\displaystyle\Psi_{t,c}=\int_{\mathcal{Z}}\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i})." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Psi_{t,c}=\int_{\mathcal{Z}}\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.9" class="ltx_p"><span id="A2.SS4.p3.9.1" class="ltx_text">In matrix form, the factorization above is written as</span></p>
<table id="A2.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex224"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex224.m1" class="ltx_Math" alttext="\displaystyle\bm{B}(t,\bm{Z}_{i})=\bm{A}^{(1)}\bm{\theta}(t,\bm{Z}_{i})\{\bm{A}^{(2)}\}^{\scriptscriptstyle\mathsf{T}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">{</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mi mathsize="0.710em">𝖳</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{B}(t,\bm{Z}_{i})=\bm{A}^{(1)}\bm{\theta}(t,\bm{Z}_{i})\{\bm{A}^{(2)}\}^{\scriptscriptstyle\mathsf{T}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.10" class="ltx_p"><span id="A2.SS4.p3.10.1" class="ltx_text">where</span></p>
<table id="A2.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex225"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex225.m1" class="ltx_Math" alttext="\displaystyle\bm{B}(t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝑩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{B}(t,\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex225.m2" class="ltx_Math" alttext="\displaystyle=\begin{bmatrix}\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=0\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=C\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)\\
\vdots&amp;\ddots&amp;\vdots\\
\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=0\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=C\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=0\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=C\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)\\
\vdots&amp;\ddots&amp;\vdots\\
\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=0\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=C\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex226"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex226.m1" class="ltx_Math" alttext="\displaystyle\bm{\theta}(t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{\theta}(t,\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex226.m2" class="ltx_Math" alttext="\displaystyle=\mathrm{diag}([\mathbb{P}(L_{i}=0\mid T_{i}=t,\bm{Z}_{i}),\cdots,\mathbb{P}(L_{i}=C\mid T_{i}=t,\bm{Z}_{i})]^{\scriptscriptstyle\mathsf{T}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>C</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mi mathsize="0.710em">𝖳</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{diag}([\mathbb{P}(L_{i}=0\mid T_{i}=t,\bm{Z}_{i}),\cdots,\mathbb{P}(L_{i}=C\mid T_{i}=t,\bm{Z}_{i})]^{\scriptscriptstyle\mathsf{T}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.11" class="ltx_p"><span id="A2.SS4.p3.11.1" class="ltx_text">Hence, we can identify <math id="A2.SS4.p3.m17" class="ltx_Math" alttext="\bm{\theta}(t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\theta}(t,\bm{Z}_{i})</annotation></semantics></math> by</span></p>
<table id="A2.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex227"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex227.m1" class="ltx_Math" alttext="\displaystyle\bm{\theta}(t,\bm{Z}_{i})=(\bm{A}^{(1)})^{-1}\bm{B}(t,\bm{Z}_{i})(\bm{A}^{(2)})^{-{\scriptscriptstyle\mathsf{T}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi mathsize="0.710em">𝖳</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{\theta}(t,\bm{Z}_{i})=(\bm{A}^{(1)})^{-1}\bm{B}(t,\bm{Z}_{i})(\bm{A}^{(2)})^{-{\scriptscriptstyle\mathsf{T}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.12" class="ltx_p"><span id="A2.SS4.p3.12.1" class="ltx_text">∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">S2.5 </span>Theoretical Properties of Surrogate Outcome</h3>

<div id="A2.SS5.p1" class="ltx_para">
<p id="A2.SS5.p1.1" class="ltx_p">We start with proving Equations (<a href="#S4.E14" title="In 4.2 Estimation and inference ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>). Notice that</p>
<table id="A2.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex228"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex228.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex229"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex229.m1" class="ltx_math_unparsed" alttext="\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mrow><mo lspace="0em" mathsize="2.100em" rspace="0em">)</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex230"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex230.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbbm{1}\{L_{i}=c\}\times\mathbbm{1}\{L_{i}=c\}=\mathbbm{1}\{L_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbbm{1}\{L_{i}=c\}\times\mathbbm{1}\{L_{i}=c\}=\mathbbm{1}\{L_{i}=c\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.p1.2" class="ltx_p">where the second equality is because when <math id="A2.SS5.p1.m1" class="ltx_Math" alttext="L_{i}\neq c" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">L_{i}\neq c</annotation></semantics></math>, each component becomes 0 (the numerator becomes 0), whereas when <math id="A2.SS5.p1.m2" class="ltx_Math" alttext="L_{i}=c" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">L_{i}=c</annotation></semantics></math> each component becomes 1, which means that each component can be represented as an indicator function. This means that <math id="A2.SS5.p1.m3" class="ltx_Math" alttext="M_{c}(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{c}(\cdot,\cdot)</annotation></semantics></math> is an unbiased surrogate for the unobserved indicator function <math id="A2.SS5.p1.m4" class="ltx_math_unparsed" alttext="\mathbbm{1}\{L_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbbm{1}\{L_{i}=c\}</annotation></semantics></math> given the true label. As <math id="A2.SS5.p1.m5" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}</annotation></semantics></math> is observed for all <math id="A2.SS5.p1.m6" class="ltx_Math" alttext="j\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,2\}</annotation></semantics></math> and we can estimate the probability <math id="A2.SS5.p1.m7" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(j)}_{i}\mid L_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(j)}_{i}\mid L_{i})</annotation></semantics></math> as seen in the proof of Proposition <a href="#Thmproposition2" title="Proposition 2 (Identification without Perfect Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, <math id="A2.SS5.p1.m8" class="ltx_Math" alttext="M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})</annotation></semantics></math> is identifiable from the observed data. Also, notice that</p>
<table id="A2.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex231"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex231.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i},\bm{Y}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i},\bm{Y}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex232"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex232.m1" class="ltx_math_unparsed" alttext="\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i},\bm{Y}_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i},\bm{Y}_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mrow><mo lspace="0em" mathsize="2.100em" rspace="0em">)</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i},\bm{Y}_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i},\bm{Y}_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)</annotation></semantics></math></td>
