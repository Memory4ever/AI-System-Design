<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex73.m1" class="ltx_Math" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}\biggl\{\frac{d}{d\epsilon}\int_{\mathcal{L}}lf(l\mid\bm{f}(\bm{y}),\bm{z},S_{i}=1)dl\;\biggl|_{\epsilon=0}\biggr\}\,\,f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><mrow><mo stretchy="false">{</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></msub></mstyle><msub><mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>l</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>l</mi></mrow></mrow><mo lspace="0.280em" maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0.340em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒛</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}\biggl\{\frac{d}{d\epsilon}\int_{\mathcal{L}}lf(l\mid\bm{f}(\bm{y}),\bm{z},S_{i}=1)dl\;\biggl|_{\epsilon=0}\biggr\}\,\,f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
