>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mover accent="true"><mi>l</mi><mo>~</mo></mover><mo>−</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo rspace="0.170em" stretchy="false">}</mo></mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒛</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>𝒚</mi><mi>d</mi><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S=1)}\int_{\mathcal{Z}}\int_{\mathcal{W}}\biggl\{\frac{\mathbbm{1}\{\bm{f}(\bm{y})=\bm{f}(\tilde{\bm{y}}),\bm{z}=\tilde{\bm{z}}\}}{f_{\mathcal{P}}(\bm{f}(\bm{y}),\bm{z})}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{f}(\bm{y}),\bm{z},S_{i}=1]\biggr)\biggr\}\,f_{\mathcal{P}}(\bm{f}(\bm{y})\mid\bm{z},T_{i}=t)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
