<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S=1)}\int_{\mathcal{Z}}\int_{\mathcal{W}}\mathbbm{1}\{\bm{f}(\bm{y})=\bm{f}(\tilde{\bm{y}}),\bm{z}=\tilde{\bm{z}}\}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{f}(\bm{y}),\bm{z},S_{i}=1]\biggr)\,\frac{\,f_{\mathcal{P}}(\bm{f}(\bm{y})\mid\bm{z},T_{i}=t)}{f_{\mathcal{P}}(\bm{f}(\bm{y})\mid\bm{z})}d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒲</mi></msub></mstyle><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">}</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mover accent="true"><mi>l</mi><mo>~</mo></mover><mo>−</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em" rspace="0.170em">)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>d</mi><mi>𝒚</mi><mi>d</mi><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S=1)}\int_{\mathcal{Z}}\int_{\mathcal{W}}\mathbbm{1}\{\bm{f}(\bm{y})=\bm{f}(\tilde{\bm{y}}),\bm{z}=\tilde{\bm{z}}\}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{f}(\bm{y}),\bm{z},S_{i}=1]\biggr)\,\frac{\,f_{\mathcal{P}}(\bm{f}(\bm{y})\mid\bm{z},T_{i}=t)}{f_{\mathcal{P}}(\bm{f}(\bm{y})\mid\bm{z})}d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex78.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i})=\bm{f}(\tilde{\bm{y}}),\bm{Z}_{i}=\tilde{\bm{z}})}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(\tilde{l}-m_{\mathcal{P}}(\tilde{\bm{y}},\tilde{\bm{z}})\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mover accent="true"><mi>l</mi><mo>~</mo></mover><mo>−</mo><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i})=\bm{f}(\tilde{\bm{y}}),\bm{Z}_{i}=\tilde{\bm{z}})}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(\tilde{l}-m_{\mathcal{P}}(\tilde{\bm{y}},\tilde{\bm{z}})\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.5" class="ltx_p"><span id="A2.SS2.p2.5.1" class="ltx_text">where the second equality is because of the influence function for the conditional outcome mean function (see Example 6 of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib31" title="" class="ltx_ref">Hines et al., 2022</a></cite>) and the third equality is because <math id="A2.SS2.p2.m25" class="ltx_Math" alttext="S_{i}\;\mbox{$\perp\!\!\!\perp$}\;\bm{Y}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo lspace="0.558em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">S_{i}\;\mbox{$\perp\!\!\!\perp$}\;\bm{Y}_{i}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.p3" class="ltx_para">
<p id="A2.SS2.p3.1" class="ltx_p"><span id="A2.SS2.p3.1.1" class="ltx_text">For the second component,</span></p>
<table id="A2.EGx53" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex79.m1" class="ltx_Math" alttext="\displaystyle\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y}\mid\bm{z},T_{i}=t)\biggl|_{\epsilon=0}f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mrow><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒛</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y}\mid\bm{z},T_{i}=t)\biggl|_{\epsilon=0}f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex80.m1" class="ltx_Math" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\frac{d}{d\epsilon}\frac{f_{\mathcal{P}_{\epsilon}}(\bm{y},\bm{z},T_{i}=t)}{f_{\mathcal{P}_{\epsilon}}(\bm{z},T_{i}=t)}\biggl|_{\epsilon=0}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>f</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒛</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\frac{d}{d\epsilon}\frac{f_{\mathcal{P}_{\epsilon}}(\bm{y},\bm{z},T_{i}=t)}{f_{\mathcal{P}_{\epsilon}}(\bm{z},T_{i}=t)}\biggl|_{\epsilon=0}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex81.m1" class="ltx_Math" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\frac{\{\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y},\bm{z},T_{i}=t)|_{\epsilon=0}\}f_{\mathcal{P}}(\bm{z},T_{i}=t)}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}-\frac{\{f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\{\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{z},T_{i}=t)|_{\epsilon=0}\}}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">{</mo><msub><mrow><mrow><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">{</mo><mi>f</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">{</mo><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac><mi>f</mi><msub><mrow></mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mrow></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><mo stretchy="false">}</mo></mrow><msup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒛</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\frac{\{\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y},\bm{z},T_{i}=t)|_{\epsilon=0}\}f_{\mathcal{P}}(\bm{z},T_{i}=t)}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}-\frac{\{f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\{\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{z},T_{i}=t)|_{\epsilon=0}\}}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex82.m1" class="ltx_Math" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\frac{\{\mathbbm{1}\{\bm{y}=\bm{\tilde{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}-f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\}f_{\mathcal{P}}(\bm{z},T_{i}=t)}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">{</mo><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\frac{\{\mathbbm{1}\{\bm{y}=\bm{\tilde{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}-f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\}f_{\mathcal{P}}(\bm{z},T_{i}=t)}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex83.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad-\frac{f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\{\mathbbm{1}\{T_{i}=t,\bm{z}=\tilde{\bm{z}}\}-f_{\mathcal{P}}(\bm{z},T_{i}=t)\}}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><mrow><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><msup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad-\frac{f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\{\mathbbm{1}\{T_{i}=t,\bm{z}=\tilde{\bm{z}}\}-f_{\mathcal{P}}(\bm{z},T_{i}=t)\}}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex84.m1" class="ltx_Math" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\frac{\{\mathbbm{1}\{\bm{y}=\bm{\tilde{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}f_{\mathcal{P}}(\bm{z},T_{i}=t)-f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\mathbbm{1}\{T_{i}=t,\bm{z}=\tilde{\bm{z}}\}}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">{</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mi>f</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">}</mo></mrow><msup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒛</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\frac{\{\mathbbm{1}\{\bm{y}=\bm{\tilde{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}f_{\mathcal{P}}(\bm{z},T_{i}=t)-f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\mathbbm{1}\{T_{i}=t,\bm{z}=\tilde{\bm{z}}\}}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex85.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbbm{1}\{T_{i}=t\}\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\mathbbm{1}\{\bm{y}=\bm{\tilde{y}}\}-f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\}\biggr)\mathbbm{1}\{\bm{z}=\tilde{\bm{z}}\}\frac{f_{\mathcal{P}}(\bm{z})}{f_{\mathcal{P}}(\bm{z},T_{i}=t)}d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo stretchy="false">}</mo></mrow><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒛</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">}</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>d</mi><mi>𝒚</mi><mi>d</mi><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbbm{1}\{T_{i}=t\}\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\mathbbm{1}\{\bm{y}=\bm{\tilde{y}}\}-f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\}\biggr)\mathbbm{1}\{\bm{z}=\tilde{\bm{z}}\}\frac{f_{\mathcal{P}}(\bm{z})}{f_{\mathcal{P}}(\bm{z},T_{i}=t)}d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex86.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{T_{i}=t\}}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(m_{\mathcal{P}}(\tilde{\bm{y}},\tilde{\bm{z}})-\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\tilde{\bm{z}})f_{\mathcal{P}}(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{T_{i}=t\}}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(m_{\mathcal{P}}(\tilde{\bm{y}},\tilde{\bm{z}})-\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\tilde{\bm{z}})f_{\mathcal{P}}(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.2" class="ltx_p"><span id="A2.SS2.p3.2.1" class="ltx_text">where the fourth line is by Example 2 of <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib31" title="" class="ltx_ref">Hines et al., (2022)</a></cite></span></p>
<table id="A2.EGx54" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex87.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y},\bm{z},T_{i}=t)|_{\epsilon=0}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y},\bm{z},T_{i}=t)|_{\epsilon=0}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex87.m2" class="ltx_Math" alttext="\displaystyle=\frac{d}{d\epsilon}\biggl(\epsilon\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}+(1-\epsilon)f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\bigg)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{d}{d\epsilon}\biggl(\epsilon\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}+(1-\epsilon)f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex88.m1" class="ltx_Math" alttext="\displaystyle=\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}-f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}-f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.3" class="ltx_p"><span id="A2.SS2.p3.3.1" class="ltx_text">Finally, for the last component,</span></p>
<table id="A2.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex89.m1" class="ltx_Math" alttext="\displaystyle\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\frac{d}{d\epsilon}\,f_{\mathcal{P}_{\epsilon}}(\bm{z})\biggl|_{\epsilon=0}d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mrow><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>f</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒛</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\frac{d}{d\epsilon}\,f_{\mathcal{P}_{\epsilon}}(\bm{z})\biggl|_{\epsilon=0}d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex90.m1" class="ltx_math_unparsed" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})dF_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\biggl(\mathbbm{1}\{\bm{z}=\tilde{\bm{z}}\}-f_{\mathcal{P}}(\bm{z})\biggr)d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒛</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">}</mo></mrow><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mi>d</mi><mi>𝒚</mi><mi>d</mi><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})dF_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\biggl(\mathbbm{1}\{\bm{z}=\tilde{\bm{z}}\}-f_{\mathcal{P}}(\bm{z})\biggr)d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex91.m1" class="ltx_Math" alttext="\displaystyle=\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})f_{\mathcal{P}}(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)d\bm{y}-\Psi_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})f_{\mathcal{P}}(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)d\bm{y}-\Psi_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.4" class="ltx_p"><span id="A2.SS2.p3.4.1" class="ltx_text">Therefore,</span></p>
<table id="A2.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex92.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{d\epsilon}\Psi_{t}(\mathcal{P}_{\epsilon})\biggl|_{\epsilon=0}=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\tilde{\bm{y}}),\tilde{\bm{z}})}{\pi_{t}(\tilde{\bm{z}})}\biggl(\tilde{l}-m(\tilde{\bm{y}},\tilde{\bm{z}})\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\tilde{\bm{z}})}\biggl(m(\tilde{\bm{y}},\tilde{\bm{z}})-\bar{m}_{t}(\tilde{z})\biggr)+\bar{m}_{t}(\tilde{z})-\Psi_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><mo>=</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mover accent="true"><mi>l</mi><mo>~</mo></mover><mo>−</mo><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>z</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>z</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{d\epsilon}\Psi_{t}(\mathcal{P}_{\epsilon})\biggl|_{\epsilon=0}=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\tilde{\bm{y}}),\tilde{\bm{z}})}{\pi_{t}(\tilde{\bm{z}})}\biggl(\tilde{l}-m(\tilde{\bm{y}},\tilde{\bm{z}})\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\tilde{\bm{z}})}\biggl(m(\tilde{\bm{y}},\tilde{\bm{z}})-\bar{m}_{t}(\tilde{z})\biggr)+\bar{m}_{t}(\tilde{z})-\Psi_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.5" class="ltx_p"><span id="A2.SS2.p3.5.1" class="ltx_text">where</span></p>
<table id="A2.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex93.m1" class="ltx_Math" alttext="\displaystyle\pi_{t}(\tilde{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{t}(\tilde{\bm{z}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex93.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex94.m1" class="ltx_Math" alttext="\displaystyle\rho_{t}(\bm{f}(\tilde{\bm{y}}),\tilde{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\rho_{t}(\bm{f}(\tilde{\bm{y}}),\tilde{\bm{z}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex94.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i})=\bm{f}(\tilde{\bm{y}}),\bm{Z}_{i}=\tilde{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i})=\bm{f}(\tilde{\bm{y}}),\bm{Z}_{i}=\tilde{\bm{z}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex95.m1" class="ltx_Math" alttext="\displaystyle\bar{m}_{t}(\tilde{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bar{m}_{t}(\tilde{\bm{z}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex95.m2" class="ltx_Math" alttext="\displaystyle=\int_{\mathcal{Y}}m(\bm{y},\tilde{\bm{z}})f(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)d\bm{y}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Y}}m(\bm{y},\tilde{\bm{z}})f(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)d\bm{y}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.6" class="ltx_p"><span id="A2.SS2.p3.6.1" class="ltx_text">Because <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math> and <math id="A2.SS2.p3.m2" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math> are assumed to be binary, the variance of indicator function is bounded and thus its variance is finite, meaning that the estimand is pathwise differentiable. Hence, the efficient influence function is given by</span></p>
<table id="A2.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex96.m1" class="ltx_Math" alttext="\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i};\bm{f},\mu,\pi_{t},\rho_{t},\bar{m}_{t},\Psi_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><mi>μ</mi><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ρ</mi><mi>t</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i};\bm{f},\mu,\pi_{t},\rho_{t},\bar{m}_{t},\Psi_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex97.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.7" class="ltx_p"><span id="A2.SS2.p3.7.1" class="ltx_text">∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">S2.3 </span>Proof of Theorem <a href="#Thmtheorem2" title="Theorem 2 (Asymptotic Normality) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> (Asymptotic Normality)</h3>

<div id="A2.SS3.p1" class="ltx_para">
<p id="A2.SS3.p1.1" class="ltx_p">For this proof, we use the following lemma to deal with the so-called empirical process term. See <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib37" title="" class="ltx_ref">Kennedy, (2023)</a></cite> for the detailed explanation.</p>
</div>
<div id="Thmlemma1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma1.2" class="ltx_text ltx_font_smallcaps">Lemma 1</span></span><span id="Thmlemma1.3" class="ltx_text ltx_font_smallcaps"> (Lemma 2 of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib38" title="" class="ltx_ref">Kennedy et al., 2020</a></cite>)</span></h6>
<div id="Thmlemma1.p1" class="ltx_para">
<p id="Thmlemma1.p1.1" class="ltx_p"><span id="Thmlemma1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma1.p1.m1" class="ltx_Math" alttext="\hat{f}(z)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(z)</annotation></semantics></math> be a function estimated from a sample <math id="Thmlemma1.p1.m2" class="ltx_Math" alttext="(Z_{n+1},\cdots,Z_{N})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>Z</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Z_{n+1},\cdots,Z_{N})</annotation></semantics></math>, and let <math id="Thmlemma1.p1.m3" class="ltx_Math" alttext="\hat{\mathcal{P}}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\hat{\mathcal{P}}_{n}</annotation></semantics></math> be the empirical measure over <math id="Thmlemma1.p1.m4" class="ltx_Math" alttext="(Z_{1},\cdots,Z_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>Z</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Z_{1},\cdots,Z_{n})</annotation></semantics></math> (i.e., <math id="Thmlemma1.p1.m5" class="ltx_Math" alttext="\hat{\mathcal{P}}_{n}=\frac{1}{n}\sum_{i=1}^{n}\delta_{Z_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msub><mi>δ</mi><msub><mi>Z</mi><mi>i</mi></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{P}}_{n}=\frac{1}{n}\sum_{i=1}^{n}\delta_{Z_{i}}</annotation></semantics></math>), which is independent of <math id="Thmlemma1.p1.m6" class="ltx_Math" alttext="(Z_{n+1},\cdots,Z_{N})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>Z</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Z_{n+1},\cdots,Z_{N})</annotation></semantics></math>. Then,</span></p>
<table id="A2.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex98.m1" class="ltx_Math" alttext="\displaystyle\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{f}-f)=O_{p}\biggl(\frac{\lVert\hat{f}-f\rVert_{2}}{\sqrt{n}}\biggr)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">{</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><mi>f</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>O</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><mi>f</mi></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><msqrt><mi>n</mi></msqrt></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{f}-f)=O_{p}\biggl(\frac{\lVert\hat{f}-f\rVert_{2}}{\sqrt{n}}\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma1.p1.2" class="ltx_p"><span id="Thmlemma1.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma1.p1.m7" class="ltx_Math" alttext="\lVert\cdot\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo fence="true" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\lVert\cdot\rVert_{2}</annotation></semantics></math> is <math id="Thmlemma1.p1.m8" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math> norm and <math id="Thmlemma1.p1.m9" class="ltx_Math" alttext="\mathcal{P}(f)=\mathcal{P}\{f(Z_{i})\}=\int f(z)d\mathcal{P}(z)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}(f)=\mathcal{P}\{f(Z_{i})\}=\int f(z)d\mathcal{P}(z)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.p2" class="ltx_para">
<p id="A2.SS3.p2.1" class="ltx_p"><span id="A2.SS3.p2.1.1" class="ltx_text">Let <math id="A2.SS3.p2.m1" class="ltx_Math" alttext="\hat{\mathcal{P}}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\hat{\mathcal{P}}_{n}</annotation></semantics></math> be a probability distribution consistent with the estimated nuisance functions <math id="A2.SS3.p2.m2" class="ltx_Math" alttext="\hat{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\pi}</annotation></semantics></math>, <math id="A2.SS3.p2.m3" class="ltx_Math" alttext="\hat{\mu}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>μ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mu}</annotation></semantics></math>, and <math id="A2.SS3.p2.m4" class="ltx_Math" alttext="\hat{\bm{f}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\bm{f}}</annotation></semantics></math>, <math id="A2.SS3.p2.m5" class="ltx_Math" alttext="\Psi_{t}(\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Psi_{t}(\mathcal{P})</annotation></semantics></math> be an estimator constructed from <math id="A2.SS3.p2.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> i.i.d. sample from <math id="A2.SS3.p2.m7" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>, <math id="A2.SS3.p2.m8" class="ltx_Math" alttext="O_{i}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mi>i</mi></msub><annotation encoding="application/x-tex">O_{i}</annotation></semantics></math> be a specific observed data point indexed by <math id="A2.SS3.p2.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and <math id="A2.SS3.p2.m10" class="ltx_Math" alttext="\psi_{t}(O_{i},\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi_{t}(O_{i},\mathcal{P})</annotation></semantics></math> be an efficient influence function of the observation <math id="A2.SS3.p2.m11" class="ltx_Math" alttext="O_{i}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mi>i</mi></msub><annotation encoding="application/x-tex">O_{i}</annotation></semantics></math> under the distribution <math id="A2.SS3.p2.m12" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS3.p3" class="ltx_para">
<p id="A2.SS3.p3.1" class="ltx_p"><span id="A2.SS3.p3.1.1" class="ltx_text">Now, consider the parametric submodel <math id="A2.SS3.p3.m1" class="ltx_Math" alttext="\mathcal{P}_{\epsilon}=(1-\epsilon)\mathcal{P}+\epsilon\hat{\mathcal{P}}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}_{\epsilon}=(1-\epsilon)\mathcal{P}+\epsilon\hat{\mathcal{P}}_{n}</annotation></semantics></math>. Recall that the von Mises expansion yields</span></p>
<table id="A2.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E4.m1" class="ltx_Math" alttext="\displaystyle\Psi_{t}(\hat{\mathcal{P}}_{n})=\Psi_{t}(\mathcal{P})+\frac{d\Psi(\mathcal{P}_{\epsilon})}{d\epsilon}\biggl|_{\epsilon=1}(0-1)+R(\hat{\mathcal{P}}_{n},\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ψ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0</mn><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Psi_{t}(\hat{\mathcal{P}}_{n})=\Psi_{t}(\mathcal{P})+\frac{d\Psi(\mathcal{P}_{\epsilon})}{d\epsilon}\biggl|_{\epsilon=1}(0-1)+R(\hat{\mathcal{P}}_{n},\mathcal{P})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(S4)</span></td></tr></tbody>
</table>
<p id="A2.SS3.p3.2" class="ltx_p"><span id="A2.SS3.p3.2.1" class="ltx_text">where <math id="A2.SS3.p3.m2" class="ltx_Math" alttext="R(\hat{\mathcal{P}}_{n},\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R(\hat{\mathcal{P}}_{n},\mathcal{P})</annotation></semantics></math> denotes the remainder term of the expansion. Then, by Equation (14) of <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib31" title="" class="ltx_ref">Hines et al., (2022)</a></cite>,</span></p>
<table id="A2.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex99.m1" class="ltx_Math" alttext="\displaystyle\sqrt{n}\biggl(\Psi_{t}(\hat{\mathcal{P}}_{n})-\Psi_{t}(\mathcal{P})\biggr)=\frac{1}{\sqrt{n}}\sum_{i=1}^{n}\psi_{t}(O_{i},\mathcal{P})-H_{1}+H_{2}-\sqrt{n}R(\hat{\mathcal{P}}_{n},\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><msub><mi>H</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>H</mi><mn>2</mn></msub></mrow><mo>−</mo><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{n}\biggl(\Psi_{t}(\hat{\mathcal{P}}_{n})-\Psi_{t}(\mathcal{P})\biggr)=\frac{1}{\sqrt{n}}\sum_{i=1}^{n}\psi_{t}(O_{i},\mathcal{P})-H_{1}+H_{2}-\sqrt{n}R(\hat{\mathcal{P}}_{n},\mathcal{P})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p3.3" class="ltx_p"><span id="A2.SS3.p3.3.1" class="ltx_text">where</span></p>
<table id="A2.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex100.m1" class="ltx_Math" alttext="\displaystyle H_{1}=\frac{1}{\sqrt{n}}\sum_{i=1}^{n}\psi_{t}(O_{i},\hat{\mathcal{P}}_{n}),\quad H_{2}=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{\psi}_{t}-\psi_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>H</mi><mn>2</mn></msub><mo>=</mo><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>ψ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{1}=\frac{1}{\sqrt{n}}\sum_{i=1}^{n}\psi_{t}(O_{i},\hat{\mathcal{P}}_{n}),\quad H_{2}=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{\psi}_{t}-\psi_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p3.4" class="ltx_p"><span id="A2.SS3.p3.4.1" class="ltx_text">and <math id="A2.SS3.p3.m3" class="ltx_Math" alttext="\hat{\psi}_{t}=\psi_{t}(\hat{\mathcal{P}}_{n})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\psi}_{t}=\psi_{t}(\hat{\mathcal{P}}_{n})</annotation></semantics></math> is the influence function constructed from the empirical distribution <math id="A2.SS3.p3.m4" class="ltx_Math" alttext="\hat{\mathcal{P}}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\hat{\mathcal{P}}_{n}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS3.p4" class="ltx_para">
<p id="A2.SS3.p4.1" class="ltx_p"><span id="A2.SS3.p4.1.1" class="ltx_text">Now, we analyze each term. The term <math id="A2.SS3.p4.m1" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math> is called bias-term, and as we solve the estimating equation so that this term becomes zero, <math id="A2.SS3.p4.m2" class="ltx_Math" alttext="H_{1}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H_{1}=0</annotation></semantics></math> by construction. The second term <math id="A2.SS3.p4.m3" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math> is called the empirical process term, and we use Lemma <a href="#Thmlemma1" title="Lemma 1 (Lemma 2 of ) ‣ S2.3 Proof of Theorem (Asymptotic Normality) ‣ Appendix S2 Theoretical Results ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> to deal with this term. To do this, we mush show that <math id="A2.SS3.p4.m4" class="ltx_Math" alttext="\hat{\psi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\psi}_{t}</annotation></semantics></math> is consistent for <math id="A2.SS3.p4.m5" class="ltx_Math" alttext="\psi_{t}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\psi_{t}</annotation></semantics></math> in <math id="A2.SS3.p4.m6" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math> norm. Now,</span></p>
<table id="A2.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex101.m1" class="ltx_Math" alttext="\displaystyle H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle H_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex101.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{\psi}_{t}-\psi_{t})=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}\biggl(\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(H_{21}-H_{22})+\mathbbm{1}\{T_{i}=t\}H_{23}+H_{24}\biggr)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msqrt><mi>n</mi></msqrt><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">}</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>ψ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msqrt><mi>n</mi></msqrt><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">}</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><msub><mi>S</mi><mi>i</mi></msub><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>21</mn></msub><mo>−</mo><msub><mi>H</mi><mn>22</mn></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><msub><mi>H</mi><mn>23</mn></msub><mo>+</mo><msub><mi>H</mi><mn>24</mn></msub><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{\psi}_{t}-\psi_{t})=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}\biggl(\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(H_{21}-H_{22})+\mathbbm{1}\{T_{i}=t\}H_{23}+H_{24}\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p4.2" class="ltx_p"><span id="A2.SS3.p4.2.1" class="ltx_text">where</span></p>
<table id="A2.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex102.m1" class="ltx_Math" alttext="\displaystyle H_{21}=\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}-\frac{\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})}{\hat{\pi}_{t}(\bm{Z}_{i})}\biggr\}\tilde{L}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>21</mn></msub><mo>=</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{21}=\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}