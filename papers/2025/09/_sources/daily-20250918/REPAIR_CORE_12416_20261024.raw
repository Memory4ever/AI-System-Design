<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex154.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\tilde{L}_{i}-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]\biggr)\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><msub><mrow></mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo stretchy="false">[</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mrow><mi>𝔼</mi><msub><mrow></mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo stretchy="false">[</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\tilde{L}_{i}-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]\biggr)\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
