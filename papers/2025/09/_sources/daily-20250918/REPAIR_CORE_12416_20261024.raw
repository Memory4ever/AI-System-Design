<tbody id="A2.Ex194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex194.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid\bm{Z}_{i},L_{i})\mathbb{P}(T_{i}=t\mid L_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid\bm{Z}_{i},L_{i})\mathbb{P}(T_{i}=t\mid L_{i},\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p1.6" class="ltx_p"><span id="A2.SS4.p1.6.1" class="ltx_text">where the second and fourth equalities are by Assumption <a href="#Thmassumption1" title="Assumption 1 (True Coding Rule) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, the third equality is by Assumption <a href="#Thmassumption7" title="Assumption 7 (Noisy Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, and the fifth equality is by Equation (<a href="#A2.E6" title="In Proof. ‣ S2.4 Proof of Proposition (Identification with Noisy Human Annotations) ‣ Appendix S2 Theoretical Results ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S6</span></a>). Therefore, we have</span></p>
<table id="A2.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E7.m1" class="ltx_Math" alttext="\displaystyle\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ T_{i}\ \mid\ L_{i},\bm{Z}_{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.778em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow><mo fence="false">|</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ T_{i}\ \mid\ L_{i},\bm{Z}_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(S7)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p1.7" class="ltx_p"><span id="A2.SS4.p1.7.1" class="ltx_text">Based on these independence conditions, we prove the identification. Now,</span></p>
<table id="A2.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex195"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex195.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m,T_{i}=t\mid\bm{Z}_{i},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m,T_{i}=t\mid\bm{Z}_{i},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex196"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex196.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m,T_{i}=t\mid L_{i}=c,\bm{Z}_{i},S_{i}=1)\ \mathbb{P}(L_{i}=c\mid\bm{Z}_{i},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo rspace="0.500em" stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m,T_{i}=t\mid L_{i}=c,\bm{Z}_{i},S_{i}=1)\ \mathbb{P}(L_{i}=c\mid\bm{Z}_{i},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex197.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m,T_{i}=t\mid L_{i}=c,\bm{Z}_{i})\ \mathbb{P}(L_{i}=c\mid\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m,T_{i}=t\mid L_{i}=c,\bm{Z}_{i})\ \mathbb{P}(L_{i}=c\mid\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex198"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex198.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c,\bm{Z}_{i})\ \mathbb{P}(T_{i}=t\mid L_{i}=c,\bm{Z}_{i})\ \mathbb{P}(L_{i}=c\mid\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c,\bm{Z}_{i})\ \mathbb{P}(T_{i}=t\mid L_{i}=c,\bm{Z}_{i})\ \mathbb{P}(L_{i}=c\mid\bm{Z}_{i})</annotation></semantics></math></td>
