<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex302.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad\quad+|g\bigl(X_{c}^{(2)},{p}_{c}^{(2)},{q}_{c}^{(2)}\bigr)|\biggl|g\bigl(X_{c}^{(1)},\hat{p}_{c}^{(1)},\hat{q}_{c}^{(1)}\bigr)-g\bigl(X_{c}^{(1)},{p}_{c}^{(1)},{q}_{c}^{(1)}\bigr)\biggr|" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>X</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>p</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>q</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>X</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>p</mi><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>X</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>p</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>q</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad+|g\bigl(X_{c}^{(2)},{p}_{c}^{(2)},{q}_{c}^{(2)}\bigr)|\biggl|g\bigl(X_{c}^{(1)},\hat{p}_{c}^{(1)},\hat{q}_{c}^{(1)}\bigr)-g\bigl(X_{c}^{(1)},{p}_{c}^{(1)},{q}_{c}^{(1)}\bigr)\biggr|</annotation></semantics></math></td>
