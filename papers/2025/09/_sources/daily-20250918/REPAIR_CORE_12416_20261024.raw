></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 151.98 17.76 L 253.43 78.31"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.8587 0.51245 -0.51245 0.8587 254.02 78.66)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 151.98 0 L 229.33 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 230.02 0)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 135.19 98.98 L 230.17 98.98"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 230.86 98.98)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 135.19 91.22 L 253.43 20.67"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.85875 -0.51239 0.51239 0.85875 254.02 20.32)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 344.59 98.98 L 390.45 98.98"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 391.14 98.98)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 345.42 0 L 391.28 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 391.97 0)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.3" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="S3.F2.4" class="ltx_text" style="font-size:90%;">The architecture of neural network for the nuisance function estimation. Given the input <math id="S3.F2.m9" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒀</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math> (texts or their vector representation), we first map them onto the internal representation <math id="S3.F2.m10" class="ltx_Math" alttext="\bm{f}(\bm{Y}_{i},\xi)" display="inline" intent=":literal"><semantics><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{f}(\bm{Y}_{i},\xi)</annotation></semantics></math> parametrized by <math id="S3.F2.m11" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math>. These representations are used to simultaneously predict the human annotation <math id="S3.F2.m12" class="ltx_Math" alttext="\tilde{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo mathsize="1.110em">~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{L}_{i}</annotation></semantics></math> (outcome model <math id="S3.F2.m13" class="ltx_math_unparsed" alttext="\mathbb{E}[\tilde{L}_{i}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo mathsize="1.110em">~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\tilde{L}_{i}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]</annotation></semantics></math>) and the predictor of interest <math id="S3.F2.m14" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math> (surrogacy score <math id="S3.F2.m15" class="ltx_Math" alttext="\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})</annotation></semantics></math>). This model encodes the independence relationship <math id="S3.F2.m16" class="ltx_Math" alttext="\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \{\tilde{L}_{i},T_{i}\}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0.738em" rspace="0em">​</mo><mrow><mpadded style="width:0.300em;" width="0.300em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.110em" minsize="1.110em">{</mo><msub><mover accent="true"><mi>L</mi><mo mathsize="1.110em">~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo maxsize="1.110em" minsize="1.110em">}</mo></mrow></mrow><mo fence="false" mathsize="1.110em">|</mo><mrow><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \{\tilde{L}_{i},T_{i}\}\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}</annotation></semantics></math>.</span></figcaption>
</figure>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p">To characterize the behavior of the estimator at the limit, I first derive its efficient influence function. The efficient influence function provides both a framework for semiparametric estimation and a theoretical foundation to characterize asymptotic behavior with optimal variance properties <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib27" title="" class="ltx_ref">Hampel,, 1974</a>; <a href="#bib.bib8" title="" class="ltx_ref">Bickel et al.,, 1993</a>; <a href="#bib.bib62" title="" class="ltx_ref">Vaart,, 1998</a>; <a href="#bib.bib61" title="" class="ltx_ref">Tsiatis,, 2006</a>)</cite>.</p>
</div>
<div id="Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem1.2" class="ltx_text ltx_font_smallcaps">Theorem 1</span></span><span id="Thmtheorem1.3" class="ltx_text ltx_font_smallcaps"> (Efficient Influence Function)</span></h6>
<div id="Thmtheorem1.p1" class="ltx_para">
<p id="Thmtheorem1.p1.2" class="ltx_p"><span id="Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">The efficient influence function for the target parameter under <math id="Thmtheorem1.p1.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> is given by</span></p>
<table id="S3.E6" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E6X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E6X.m2" class="ltx_Math" alttext="\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\rho_{t},\pi_{t},\mu,\bar{m}_{t},\Psi_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><msub><mi>ρ</mi><mi>t</mi></msub><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><mi>μ</mi><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\rho_{t},\pi_{t},\mu,\bar{m}_{t},\Psi_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(6)</span></td></tr>
<tr id="S3.E6Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E6Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem1.p1.3" class="ltx_p"><span id="Thmtheorem1.p1.3.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem1.p1.m2" class="ltx_math_unparsed" alttext="\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})=\mathbb{E}[\tilde{L}_{i}\mid\bm{W}_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝐖</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})=\mathbb{E}[\tilde{L}_{i}\mid\bm{W}_{i},\bm{Z}_{i}]</annotation></semantics></math> is the outcome model given the low-dimensional representation <math id="Thmtheorem1.p1.m3" class="ltx_Math" alttext="\bm{W}_{i}=\bm{f}(\bm{Y}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{i}=\bm{f}(\bm{Y}_{i})</annotation></semantics></math> and the set of control variables <math id="Thmtheorem1.p1.m4" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math>, <math id="Thmtheorem1.p1.m5" class="ltx_Math" alttext="\rho_{t}(\bm{W}_{i},\bm{Z}_{i})=\mathbb{P}(T_{i}=t\mid\bm{W}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝐖</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{t}(\bm{W}_{i},\bm{Z}_{i})=\mathbb{P}(T_{i}=t\mid\bm{W}_{i},\bm{Z}_{i})</annotation></semantics></math> is the surrogacy score model given the low-dimensional representation <math id="Thmtheorem1.p1.m6" class="ltx_Math" alttext="\bm{W}_{i}=\bm{f}(\bm{Y}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{i}=\bm{f}(\bm{Y}_{i})</annotation></semantics></math> and the set of control variables <math id="Thmtheorem1.p1.m7" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math>, <math id="Thmtheorem1.p1.m8" class="ltx_Math" alttext="\pi_{t}(\bm{Z}_{i})=\mathbb{P}(T_{i}=t\mid\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{t}(\bm{Z}_{i})=\mathbb{P}(T_{i}=t\mid\bm{Z}_{i})</annotation></semantics></math> is the propensity score model given the set of control variables <math id="Thmtheorem1.p1.m9" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math>, and <math id="Thmtheorem1.p1.m10" class="ltx_Math" alttext="\bar{m}_{t}(\bm{Z}_{i})=\int\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})dF(\bm{Y}_{i}\mid\bm{Z}_{i},T_{i}=t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝐙</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{m}_{t}(\bm{Z}_{i})=\int\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})dF(\bm{Y}_{i}\mid\bm{Z}_{i},T_{i}=t)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p">The proof is given in Appendix <a href="#A2.SS2" title="S2.2 Proof of Theorem (Efficient Influence Function) ‣ Appendix S2 Theoretical Results ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S2.2</span></a>.</p>
</div>
<div id="S3.SS2.p5" class="ltx_para">
<p id="S3.SS2.p5.1" class="ltx_p">Once the efficient influence function is obtained, the asymptotically valid estimator can be constructed. Here, I propose to use a <math id="S3.SS2.p5.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-fold cross-fitting procedure <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib63" title="" class="ltx_ref">van der Laan,, 2010</a>; <a href="#bib.bib11" title="" class="ltx_ref">Chernozhukov et al.,, 2018</a>)</cite>. Suppose that <math id="S3.SS2.p5.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is divisible by <math id="S3.SS2.p5.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>. The entire estimation procedure with <math id="S3.SS2.p5.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-fold cross-fitting is summarized as follows.</p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p">Randomly partition the data into <math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> folds of equal size. Let <math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="I(i)=c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">I(i)=c</annotation></semantics></math> be the indicator of the observation <math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> belonging to the fold <math id="S3.I1.i1.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p">For each fold <math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="k\in\{1,\cdots,K\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{1,\cdots,K\}</annotation></semantics></math>, use <math id="S3.I1.i2.p1.m2" class="ltx_Math" alttext="I(i)\neq c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">I(i)\neq c</annotation></semantics></math> as training data:</p>
<ol id="S3.I1.i2.I1" class="ltx_enumerate">
<li id="S3.I1.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S3.I1.i2.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i2.I1.i1.p1.1" class="ltx_p">Estimate the propensity score model <math id="S3.I1.i2.I1.i1.p1.m1" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> using the whole sample with <math id="S3.I1.i2.I1.i1.p1.m2" class="ltx_Math" alttext="I(i)\neq c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">I(i)\neq c</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S3.I1.i2.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.I1.i2.p1.1" class="ltx_p">Split the training data with <math id="S3.I1.i2.I1.i2.p1.m1" class="ltx_Math" alttext="S_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S_{i}=0</annotation></semantics></math> into two halves, say <math id="S3.I1.i2.I1.i2.p1.m2" class="ltx_Math" alttext="I_{-1s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-1s}^{(-k)}</annotation></semantics></math> and <math id="S3.I1.i2.I1.i2.p1.m3" class="ltx_Math" alttext="I_{-2s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-2s}^{(-k)}</annotation></semantics></math>. Let the remaining training data (with <math id="S3.I1.i2.I1.i2.p1.m4" class="ltx_Math" alttext="S_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S_{i}=1</annotation></semantics></math>) be <math id="S3.I1.i2.I1.i2.p1.m5" class="ltx_Math" alttext="I_{s}^{(k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{s}^{(k)}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S3.I1.i2.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i2.I1.i3.p1.1" class="ltx_p">Solve the optimization problem in Equation (<a href="#S3.E5" title="In 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) using the data <math id="S3.I1.i2.I1.i3.p1.m1" class="ltx_Math" alttext="I_{s}^{(k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{s}^{(k)}</annotation></semantics></math> and <math id="S3.I1.i2.I1.i3.p1.m2" class="ltx_Math" alttext="I_{-1s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-1s}^{(-k)}</annotation></semantics></math> and obtain <math id="S3.I1.i2.I1.i3.p1.m3" class="ltx_Math" alttext="\hat{\mu}^{(-k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\hat{\mu}^{(-k)}</annotation></semantics></math> and <math id="S3.I1.i2.I1.i3.p1.m4" class="ltx_Math" alttext="\hat{\rho}_{t}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\rho}_{t}^{(-k)}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(d)</span> 
<div id="S3.I1.i2.I1.i4.p1" class="ltx_para">
<p id="S3.I1.i2.I1.i4.p1.1" class="ltx_p">Regress the obtained <math id="S3.I1.i2.I1.i4.p1.m1" class="ltx_Math" alttext="\hat{\mu}^{(-k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\hat{\mu}^{(-k)}</annotation></semantics></math> on <math id="S3.I1.i2.I1.i4.p1.m2" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> and <math id="S3.I1.i2.I1.i4.p1.m3" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒁</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math> using the data <math id="S3.I1.i2.I1.i4.p1.m4" class="ltx_Math" alttext="I_{-2s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-2s}^{(-k)}</annotation></semantics></math> and obtain <math id="S3.I1.i2.I1.i4.p1.m5" class="ltx_Math" alttext="\hat{\bar{m}}^{(-k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\hat{\bar{m}}^{(-k)}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div></li>
<li id="S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S3.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i3.p1.1" class="ltx_p">For the level of predictors of interest <math id="S3.I1.i3.p1.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, solve the estimating equation</p>
<table id="S3.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E7.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{n}\sum_{k=1}^{K}\sum_{I(i)=k}\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\bm{f}}^{(-k)},\hat{\rho}_{t}^{(-k)},\hat{\pi}_{t}^{(-k)},\hat{\mu}^{(-k)},\hat{\bar{m}}_{t}^{(-k)},\hat{\Psi}_{t})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></munder></mstyle><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msup><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n}\sum_{k=1}^{K}\sum_{I(i)=k}\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\bm{f}}^{(-k)},\hat{\rho}_{t}^{(-k)},\hat{\pi}_{t}^{(-k)},\hat{\mu}^{(-k)},\hat{\bar{m}}_{t}^{(-k)},\hat{\Psi}_{t})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S3.I1.i3.p1.2" class="ltx_p">and obtain the estimate of the target parameter <math id="S3.I1.i3.p1.m2" class="ltx_Math" alttext="\hat{\Psi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\Psi}_{t}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S3.SS2.p6" class="ltx_para">
<p id="S3.SS2.p6.1" class="ltx_p">Finally, I derive the asymptotic normality of the proposed estimator. For this, I assume the following regularity conditions.</p>
</div>
<div id="Thmassumption5" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption5.2" class="ltx_text ltx_font_smallcaps">Assumption 5</span></span><span id="Thmassumption5.3" class="ltx_text ltx_font_smallcaps"> (Regularity Conditions)</span></h6>
<div id="Thmassumption5.p1" class="ltx_para">
<p id="Thmassumption5.p1.1" class="ltx_p"><span id="Thmassumption5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmassumption5.p1.m1" class="ltx_Math" alttext="c_{1}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>1</mn></msub><annotation encoding="application/x-tex">c_{1}</annotation></semantics></math> be a positive constant and <math id="Thmassumption5.p1.m2" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math> be a sequence of positive constants approaching zero as the sample size <math id="Thmassumption5.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> increases.</span></p>
<ol id="S3.I2" class="ltx_enumerate">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S3.I2.i1.p1" class="ltx_para">
<p id="S3.I2.i1.p1.1" class="ltx_p"><span id="S3.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">(Primitive Condition) The labeled outcome is bounded such that </span><math id="S3.I2.i1.p1.m1" class="ltx_Math" alttext="\mathbb{E}\bigl[|\tilde{L}_{i}|^{2}\bigr]^{\frac{1}{2}}\leq c_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\mathbb{E}\bigl[|\tilde{L}_{i}|^{2}\bigr]^{\frac{1}{2}}\leq c_{1}</annotation></semantics></math><span id="S3.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S3.I2.i2.p1" class="ltx_para">
<p id="S3.I2.i2.p1.1" class="ltx_p"><span id="S3.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">(Positivity) There exists a fixed constant </span><math id="S3.I2.i2.p1.m1" class="ltx_Math" alttext="c_{2}\in(0,1/2]" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">c_{2}\in(0,1/2]</annotation></semantics></math><span id="S3.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> such that for all </span><math id="S3.I2.i2.p1.m2" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math></p>
<table id="S3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex4.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(c_{2}\leq\pi_{t}(\bm{Z}_{i})\leq 1-c_{2})=1,\quad\mathbb{P}(c_{2}\leq\hat{\pi}_{t}(\bm{Z}_{i})\leq 1-c_{2})=1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(c_{2}\leq\pi_{t}(\bm{Z}_{i})\leq 1-c_{2})=1,\quad\mathbb{P}(c_{2}\leq\hat{\pi}_{t}(\bm{Z}_{i})\leq 1-c_{2})=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i2.p1.2" class="ltx_p"><span id="S3.I2.i2.p1.2.1" class="ltx_text ltx_font_italic">In addition, the estimated surrogacy score is also almost surely bounded so that</span></p>
<table id="S3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex5.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\leq 1)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\leq 1)=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i2.p1.3" class="ltx_p"><span id="S3.I2.i2.p1.3.1" class="ltx_text ltx_font_italic">for all </span><math id="S3.I2.i2.p1.m3" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="S3.I2.i2.p1.3.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S3.I2.i3.p1" class="ltx_para">
<p id="S3.I2.i3.p1.1" class="ltx_p"><span id="S3.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">(Nuisance Functions Estimation) Nuisance functions are consistently estimated so that</span></p>
<table id="S3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex6.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})-{\rho}_{t}({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})-{\rho}_{t}({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex6.m2" class="ltx_Math" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})-{\rho}_{t}({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})-{\rho}_{t}({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex7.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex7.m2" class="ltx_math_unparsed" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex8.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex8.m2" class="ltx_Math" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex9.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex9.m2" class="ltx_Math" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i3.p1.2" class="ltx_p"><span id="S3.I2.i3.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="S3.I2.i3.p1.m1" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="S3.I2.i3.p1.2.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(d)</span> 
<div id="S3.I2.i4.p1" class="ltx_para">
<p id="S3.I2.i4.p1.1" class="ltx_p"><span id="S3.I2.i4.p1.1.1" class="ltx_text ltx_font_italic">(Convergence Rate of Cross Product)</span></p>
<table id="S3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex10.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})-{\rho}_{t}({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})-{\rho}_{t}({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex10.m2" class="ltx_math_unparsed" alttext="\displaystyle\cdot\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/2}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdot\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/2}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex11.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex11.m2" class="ltx_math_unparsed" alttext="\displaystyle\cdot\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/2}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\cdot\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/2}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i4.p1.2" class="ltx_p"><span id="S3.I2.i4.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="S3.I2.i4.p1.m1" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="S3.I2.i4.p1.2.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS2.p7" class="ltx_para">
<p id="S3.SS2.p7.1" class="ltx_p">These are the standard conditions in the literature on semiparametric inference <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib47" title="" class="ltx_ref">Newey and McFadden,, 1994</a>; <a href="#bib.bib63" title="" class="ltx_ref">van der Laan,, 2010</a>; <a href="#bib.bib11" title="" class="ltx_ref">Chernozhukov et al.,, 2018</a>)</cite>, but they become difficult to verify when high-dimensional unstructured data are used directly as input. A common strategy is to project texts onto low-dimensional representations via pretrained embeddings, such as Bidirectional Encoder Representations from Transformers (BERT; <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib13" title="" class="ltx_ref">Devlin et al., 2019</a></cite>) or ModernBERT <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib67" title="" class="ltx_ref">Warner et al.,, 2024</a>)</cite>. Although these embeddings capture much of the textual content, their statistical properties remain poorly understood, and estimation errors may arise in practice.
If users care about the estimation loss from the embedding, a more principled alternative is to use the internal representation of the generative models, such as LLMs <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib35" title="" class="ltx_ref">Imai and Nakamura,, 2024</a>)</cite>. When a model can faithfully reconstruct an input <math id="S3.SS2.p7.m1" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒀</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math>, the internal representation that actually generates the data can be extracted without any estimation error. Thus, if users can extract the internal representations of the generative models, these error‐free latent vectors can then be fed into the standard feed‐forward network with ReLU activations with sufficient depth and width, for which there is a convergence rate guarantee <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">Bauer and Kohler,, 2019</a>; <a href="#bib.bib55" title="" class="ltx_ref">Schmidt-Hieber,, 2020</a>; <a href="#bib.bib18" title="" class="ltx_ref">Farrell et al.,, 2021</a>)</cite>.</p>
</div>
<div id="S3.SS2.p8" class="ltx_para">
<p id="S3.SS2.p8.1" class="ltx_p">Given the stated regularity condition, the asymptotic normality of the proposed estimator can be derived as follows.</p>
</div>
<div id="Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2.2" class="ltx_text ltx_font_smallcaps">Theorem 2</span></span><span id="Thmtheorem2.3" class="ltx_text ltx_font_smallcaps"> (Asymptotic Normality)</span></h6>
<div id="Thmtheorem2.p1" class="ltx_para">
<p id="Thmtheorem2.p1.1" class="ltx_p"><span id="Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Under Assumptions <a href="#Thmassumption1" title="Assumption 1 (True Coding Rule) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>–<a href="#Thmassumption5" title="Assumption 5 (Regularity Conditions) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, the estimator for the covariate-adjusted outcome mean <math id="Thmtheorem2.p1.m1" class="ltx_Math" alttext="\hat{\Psi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\Psi}_{t}</annotation></semantics></math> obtained by solving the estimating equations in Equation (<a href="#S3.E7" title="In item 3 ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) for <math id="Thmtheorem2.p1.m2" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math> satisfies asymptotic normality:</span></p>
<table id="S3.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex12.m1" class="ltx_Math" alttext="\frac{\sqrt{n}(\hat{\Psi}_{t}-\Psi_{t})}{\sigma}\xrightarrow{d}\mathcal{N}(0,1)" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>σ</mi></mfrac><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑑</mo></mover><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\sqrt{n}(\hat{\Psi}_{t}-\Psi_{t})}{\sigma}\xrightarrow{d}\mathcal{N}(0,1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p1.2" class="ltx_p"><span id="Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem2.p1.m3" class="ltx_Math" alttext="\sigma^{2}=\mathbb{E}\biggl[\biggl(\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})\biggr)^{2}\biggr]." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma^{2}=\mathbb{E}\biggl[\biggl(\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})\biggr)^{2}\biggr].</annotation></semantics></math></span></p>
</div>
</div>
<div id="S3.SS2.p9" class="ltx_para">
<p id="S3.SS2.p9.1" class="ltx_p">The proof is provided in Appendix <a href="#A2.SS3" title="S2.3 Proof of Theorem (Asymptotic Normality) ‣ Appendix S2 Theoretical Results ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S2.3</span></a>.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>The Proposed Methodology with Noisy Human Annotations</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">The methodology described in the previous section enables the estimation under the assumption that human annotations contain no errors (Assumption <a href="#Thmassumption2" title="Assumption 2 (Perfect Annotations) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>). Although this assumption is common in the literature, human coders may still make random mistakes even when the coding rule is clearly defined.
Given that some amount of perfectly labeled data is required to obtain the sufficient statistical power, this limitation can be particularly problematic for real-world applications.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">In this section, I extend the SRI framework in the previous section to relax the assumption of the perfect human annotations using the recent literature of double negative control (e.g., <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib33" title="" class="ltx_ref">Hu and Schennach, 2008</a>; <a href="#bib.bib41" title="" class="ltx_ref">Kuroki and Pearl, 2014</a>; <a href="#bib.bib45" title="" class="ltx_ref">Miao et al., 2018</a>; <a href="#bib.bib60" title="" class="ltx_ref">Tchetgen et al., 2020</a>; <a href="#bib.bib71" title="" class="ltx_ref">Zhou and Tchetgen, 2024</a></cite>). Specifically, I propose a methodology that requires multiple, but potentially incorrect, human annotations and still performs the efficient statistical inference. As before, I state assumptions, identification, and estimation strategies. I also write about the practical guidance for applied researchers about how to diagnose the required assumptions that are not guaranteed by design.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Assumptions and nonparametric identification</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Consider the same setting as in the previous section, except that the true label <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="L_{i}\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">L_{i}\in\mathcal{L}</annotation></semantics></math> is assumed to be discrete. For simplicity, let <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="\mathcal{L}=\{0,\cdots,C\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>C</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}=\{0,\cdots,C\}</annotation></semantics></math> with some constant <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="C&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">C&lt;\infty</annotation></semantics></math>. Instead of assuming the perfect annotations, suppose that there are <math id="S4.SS1.p1.m4" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> coders who independently label texts <math id="S4.SS1.p1.m5" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒀</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math>. Let <math id="S4.SS1.p1.m6" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}\in\mathcal{L}</annotation></semantics></math> be a label coded by the coder <math id="S4.SS1.p1.m7" class="ltx_Math" alttext="j\in\{1,\cdots,J\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>J</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\cdots,J\}</annotation></semantics></math>. As before, I use <math id="S4.SS1.p1.m8" class="ltx_Math" alttext="S_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S_{i}=1</annotation></semantics></math> if <math id="S4.SS1.p1.m9" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}</annotation></semantics></math> is observed for all coders. Importantly, I allow for the possibility that <math id="S4.SS1.p1.m10" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}\neq L_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≠</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}\neq L_{i}</annotation></semantics></math> for any <math id="S4.SS1.p1.m11" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="S4.SS1.p1.m12" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, meaning that coders can make mistakes. For simplicity, I assume <math id="S4.SS1.p1.m13" class="ltx_Math" alttext="J=2" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">J=2</annotation></semantics></math> (i.e., two human coders) for the remainder of this section, but the method can be generalized to the case of multiple coders.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">The goal is to identify the same target parameter from the previous section using only the human-annotated labels <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\tilde{L}_{i}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\tilde{L}_{i}^{(j)}</annotation></semantics></math> for <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="j=\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j=\{1,2\}</annotation></semantics></math>, which are observed only for the part of the corpus and can be incorrect (i.e., <math id="S4.SS1.p2.m3" class="ltx_Math" alttext="\tilde{L}_{i}^{(j)}\neq L_{i}=g_{L}(\bm{Y}_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≠</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>g</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{L}_{i}^{(j)}\neq L_{i}=g_{L}(\bm{Y}_{i})</annotation></semantics></math>). As the annotations may contain mistakes, I assume the following for the sake of formalization.</p>
</div>
<div id="Thmassumption6" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption6.2" class="ltx_text ltx_font_smallcaps">Assumption 6</span></span><span id="Thmassumption6.3" class="ltx_text ltx_font_smallcaps"> (Human Annotation Sampling)</span></h6>
<div id="Thmassumption6.p1" class="ltx_para">
<p id="Thmassumption6.p1.1" class="ltx_p"><span id="Thmassumption6.p1.1.1" class="ltx_text ltx_font_italic">Human coders annotate a subset of texts that are randomly sampled from the entire corpus such that</span></p>
<table id="S4.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E8.m1" class="ltx_Math" alttext="\displaystyle\tilde{L}_{i}^{(j)}\;\mbox{$\perp\!\!\!\perp$}\;S_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.558em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{L}_{i}^{(j)}\;\mbox{$\perp\!\!\!\perp$}\;S_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="Thmassumption6.p1.2" class="ltx_p"><span id="Thmassumption6.p1.2.1" class="ltx_text ltx_font_italic">for all coders <math id="Thmassumption6.p1.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> with <math id="Thmassumption6.p1.m2" class="ltx_Math" alttext="\mathbb{P}(S_{i}=1)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{P}(S_{i}=1)&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmassumption7" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption7.2" class="ltx_text ltx_font_smallcaps">Assumption 7</span></span><span id="Thmassumption7.3" class="ltx_text ltx_font_smallcaps"> (Noisy Human Annotations)</span></h6>
<div id="Thmassumption7.p1" class="ltx_para">
<p id="Thmassumption7.p1.1" class="ltx_p"><span id="Thmassumption7.p1.1.1" class="ltx_text ltx_font_italic">Each coder <math id="Thmassumption7.p1.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> annotates <math id="Thmassumption7.p1.m2" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐘</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math> solely based on the the information within <math id="Thmassumption7.p1.m3" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐘</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math> so that</span></p>
<table id="S4.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E9.m1" class="ltx_Math" alttext="\displaystyle\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ \bm{Z}_{i}\ \mid\ \bm{Y}_{i}\quad\text{and}\quad\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ T_{i}\ \mid\ \bm{Y}_{i},\ \bm{Z}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.778em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo fence="false">|</mo><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">and</mtext></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow><mo fence="false">|</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><mo rspace="0.667em">,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ \bm{Z}_{i}\ \mid\ \bm{Y}_{i}\quad\text{and}\quad\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ T_{i}\ \mid\ \bm{Y}_{i},\ \bm{Z}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="Thmassumption7.p1.2" class="ltx_p"><span id="Thmassumption7.p1.2.1" class="ltx_text ltx_font_italic">for all <math id="Thmassumption7.p1.m4" class="ltx_Math" alttext="j\in\{1,\cdots,J\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>J</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\cdots,J\}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p">These assumptions do not substantially increase the practical burden compared to the previous setting. In particular, they can be satisfied if (1) researchers randomly select the texts to be annotated, (2) human coders do not directly observe the predictors of interest, and (3) the structured variable of interest <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math> is not coded by annotators. Unlike the earlier case, the third condition is essential here because annotated variables may otherwise remain correlated even after conditioning on texts. For instance, if coders classify both the speaker’s party affiliation and the tone of a speech, the classification errors in these two variables can be correlated even after conditioning on the text itself.</p>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<p id="S4.SS1.p4.1" class="ltx_p">I then impose restrictions on the human annotations and the unobserved true label. While the human annotations may differ from the true label for some observations, I assume that (1) the mistakes made by each coder is independent and (2) the only way for texts to influence the human coding is through the true label. This is formally stated as follows:</p>
</div>
<div id="Thmassumption8" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption8.2" class="ltx_text ltx_font_smallcaps">Assumption 8</span></span><span id="Thmassumption8.3" class="ltx_text ltx_font_smallcaps"> (Conditional Independence of Human Annotations)</span></h6>
<div id="Thmassumption8.p1" class="ltx_para">
<p id="Thmassumption8.p1.1" class="ltx_p"><span id="Thmassumption8.p1.1.1" class="ltx_text ltx_font_italic">The human-annotated labels <math id="Thmassumption8.p1.m1" class="ltx_math_unparsed" alttext="\{\tilde{L}^{(j)}_{i}:j=1,\cdots J\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>j</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\tilde{L}^{(j)}_{i}:j=1,\cdots J\}</annotation></semantics></math> and the true label <math id="Thmassumption8.p1.m2" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> satisfy the followings:</span></p>
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p"><span id="S4.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">(Independent Coding) For all pair of </span><math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="j,j^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">j,j^{\prime}</annotation></semantics></math><span id="S4.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> with </span><math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="j\neq j^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><msup><mi>j</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">j\neq j^{\prime}</annotation></semantics></math><span id="S4.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">,</span></p>
<table id="S4.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E10.m1" class="ltx_Math" alttext="\displaystyle\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ \tilde{L}_{i}^{(j^{\prime})}\mid L_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.778em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo fence="false">|</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ \tilde{L}_{i}^{(j^{\prime})}\mid L_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">(Exclusion Restriction) For all human coders </span><math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
<table id="S4.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E11.m1" class="ltx_Math" alttext="\displaystyle\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \tilde{L}_{i}^{(j)}\ \mid\ L_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0.778em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo fence="false">|</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \tilde{L}_{i}^{(j)}\ \mid\ L_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS1.p5" class="ltx_para">
<p id="S4.SS1.p5.1" class="ltx_p">Figure <a href="#S4.F3" title="Figure 3 ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> illustrates the required independence assumptions graphically. These two independence constraints in Assumption <a href="#Thmassumption8" title="Assumption 8 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> fundamentally require that errors in observed human annotations be completely non‑differential (i.e., the measurement error does not depend on true annotations <math id="S4.SS1.p5.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> or the contents of texts <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒀</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math>). This essentially requires that the errors arise from pure mistakes or inattention rather than systematic biases related to the content of the texts. When mistakes are non‑differential, the coding errors from each coder are independent, satisfying the independent‑coding assumption. The exclusion restriction is also plausible when only the concept of interest in the text influences human annotation, which is reasonable when mistakes are random. Note that Assumption <a href="#Thmassumption8" title="Assumption 8 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> cannot be relaxed by conditioning on covariates <math id="S4.SS1.p5.m3" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒁</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math>, as they provide no additional information under Assumption <a href="#Thmassumption7" title="Assumption 7 (Noisy Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>.</p>
</div>
<figure id="S4.F3" class="ltx_figure"><span class="ltx_inline-block"><svg id="S4.F3.pic1" class="ltx_picture ltx_centering" height="156.52" overflow="visible" version="1.1" viewBox="0 0 346.66 156.52" width="346.66"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="translate(0,156.52) matrix(1 0 0 -1 0 0) translate(13.93,0) translate(0,78.31)"><path style="fill:none" d="M 13.38 0 C 13.38 7.39 7.39 13.38 0 13.38 C -7.39 13.38 -13.38 7.39 -13.38 0 C -13.38 -7.39 -7.39 -13.38 0 -13.38 C 7.39 -13.38 13.38 -7.39 13.38 0 Z M 0 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -5 -4.73)"><foreignObject style="--ltx-fo-width:0.72em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 141.77 0 C 141.77 7.97 135.31 14.43 127.34 14.43 C 119.37 14.43 112.91 7.97 112.91 0 C 112.91 -7.97 119.37 -14.43 127.34 -14.43 C 135.31 -14.43 141.77 -7.97 141.77 0 Z M 127.34 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 120.9 -4.75)"><foreignObject style="--ltx-fo-width:0.93em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="12.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m2" class="ltx_Math" alttext="\bm{Y}" display="inline" intent=":literal"><semantics><mi>𝒀</mi><annotation encoding="application/x-tex">\bm{Y}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#BFBFBF;" fill="#BFBFBF"><path d="M 267.72 0 C 267.72 7.3 261.8 13.21 254.51 13.21 C 247.21 13.21 241.3 7.3 241.3 0 C 241.3 -7.3 247.21 -13.21 254.51 -13.21 C 261.8 -13.21 267.72 -7.3 267.72 0 Z M 254.51 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 249.8 -4.73)"><foreignObject style="--ltx-fo-width:0.68em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 332.17 58.48 C 332.17 69.08 323.59 77.66 312.99 77.66 C 302.4 77.66 293.81 69.08 293.81 58.48 C 293.81 47.89 302.4 39.3 312.99 39.3 C 323.59 39.3 332.17 47.89 332.17 58.48 Z M 312.99 58.48"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 301.72 52.34)"><foreignObject style="--ltx-fo-width:1.63em;--ltx-fo-height:0.89em;--ltx-fo-depth:0em;font-size:10pt;" height="12.29" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="22.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m4" class="ltx_Math" alttext="\tilde{L}^{(1)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{L}^{(1)}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 332.17 -58.48 C 332.17 -47.89 323.59 -39.3 312.99 -39.3 C 302.4 -39.3 293.81 -47.89 293.81 -58.48 C 293.81 -69.08 302.4 -77.66 312.99 -77.66 C 323.59 -77.66 332.17 -69.08 332.17 -58.48 Z M 312.99 -58.48"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 301.72 -64.63)"><foreignObject style="--ltx-fo-width:1.63em;--ltx-fo-height:0.89em;--ltx-fo-depth:0em;font-size:10pt;" height="12.29" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="22.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m5" class="ltx_Math" alttext="\tilde{L}^{(2)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{L}^{(2)}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 77.66 -63.76 C 77.66 -56.03 71.4 -49.77 63.67 -49.77 C 55.94 -49.77 49.68 -56.03 49.68 -63.76 C 49.68 -71.49 55.94 -77.75 63.67 -77.75 C 71.4 -77.75 77.66 -71.49 77.66 -63.76 Z M 63.67 -63.76"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 57.84 -68.51)"><foreignObject style="--ltx-fo-width:0.84em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="11.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m6" class="ltx_Math" alttext="\bm{Z}" display="inline" intent=":literal"><semantics><mi>𝒁</mi><annotation encoding="application/x-tex">\bm{Z}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 13.93 0 L 106.4 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 103.22 0)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000"><g style="--ltx-fg-color:#FF0000;" color="#FF0000" stroke-width="2.20001pt"><path style="fill:none" d="M 142.32 0 L 233.61 0"></path></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fg-color:#FF0000;" color="#FF0000" stroke="#FFFFFF" stroke-width="0.6pt"><path style="fill:none" d="M 142.32 0 L 233.61 0"></path></g><g style="--ltx-fg-color:#FF0000;" color="#FF0000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 229.87 0)"><path d="M 9.4 0 L 1.79 2.84 L 4.01 0 L 1.79 -2.84 Z"></path></g></g><path style="fill:none" d="M 53.39 -53.47 L 14.06 -14.08"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.7066 0.7076 -0.7076 -0.7066 16.3 -16.32)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><path style="fill:none" d="M 73.95 -53.47 L 112.54 -14.82"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.7066 0.7076 -0.7076 0.7066 110.3 -17.06)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><path style="fill:none" d="M 264.24 9.73 L 294.82 40.31"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.7071 0.7071 -0.7071 0.7071 292.58 38.07)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><path style="fill:none" d="M 264.24 -9.73 L 294.82 -40.31"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.7071 -0.7071 0.7071 0.7071 292.58 -38.07)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.3" class="ltx_text" style="font-size:90%;">Figure 3</span>: </span><span id="S4.F3.4" class="ltx_text" style="font-size:90%;">The diagram illustrates the assumptions for the proposed method when human annotations may differ from the unobserved true label of interest. <math id="S4.F3.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> denotes the predictors of interest, <math id="S4.F3.m9" class="ltx_Math" alttext="\bm{Y}" display="inline" intent=":literal"><semantics><mi>𝒀</mi><annotation encoding="application/x-tex">\bm{Y}</annotation></semantics></math> denotes the texts (outcomes), <math id="S4.F3.m10" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> represents the unobserved true concept of interest, and <math id="S4.F3.m11" class="ltx_Math" alttext="\bm{Z}" display="inline" intent=":literal"><semantics><mi>𝒁</mi><annotation encoding="application/x-tex">\bm{Z}</annotation></semantics></math> denotes the set of control variables. <math id="S4.F3.m12" class="ltx_Math" alttext="\tilde{L}^{(j)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>L</mi><mo mathsize="1.110em">~</mo></mover><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{L}^{(j)}</annotation></semantics></math> indicates the human-annotated labels provided by coder <math id="S4.F3.m13" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> (<math id="S4.F3.m14" class="ltx_Math" alttext="j=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j=1,2</annotation></semantics></math>). An arrow with red double lines represents a deterministic relationship, while an arrow with a single line indicates a potentially stochastic relationship. White nodes correspond to observed variables, whereas gray nodes indicate unobserved variables.</span></figcaption>
</figure>
<div id="S4.SS1.p6" class="ltx_para">
<p id="S4.SS1.p6.1" class="ltx_p">To better understand how Assumption <a href="#Thmassumption8" title="Assumption 8 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> may be violated, consider the example from Section <a href="#S2" title="2 Motivating Example: Framing of Immigrants in the U.S. Congress ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> of classifying the tones of congressional speeches on immigration. Suppose researchers classify speeches as pro‑immigration as long as any part of the speech values immigrants or favors less restrictive policies. However, if coders interpret speeches as pro‑immigration only when they both value immigrants and favor less restrictive policies, then the text content directly influences the pattern of human coders’ annotations without being fully mediated by the researchers’ definition of the label concept, thus violating the exclusion restriction assumption.</p>
</div>
<div id="S4.SS1.p7" class="ltx_para">
<p id="S4.SS1.p7.1" class="ltx_p">In most cases, violations of both assumptions stem from vaguely specified coding rules. When coding guidelines cannot provide specific instructions for classifying each text, coders may attempt to fill these gaps using their own reasoning and procedures. However, these well‑intentioned efforts lead to violations of Assumption <a href="#Thmassumption8" title="Assumption 8 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>. Conversely, when coding rules clearly specify classification criteria for each text type so that texts can be classified almost deterministically, most errors should result from random mistakes rather than systematic biases. Therefore, researchers must craft clear, unambiguous coding guidelines to maintain this assumption. I discuss procedures for testing this assumption and refining coding rules in Section <a href="#S4.SS3" title="4.3 How to test assumptions that are not guaranteed by design ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>.</p>
</div>
<div id="S4.SS1.p8" class="ltx_para">
<p id="S4.SS1.p8.1" class="ltx_p">Lastly, I assume that human labels are accurate and humans agree on their annotations most of the time. This is formalized as follows.</p>
</div>
<div id="Thmassumption9" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption9.2" class="ltx_text ltx_font_smallcaps">Assumption 9</span></span><span id="Thmassumption9.3" class="ltx_text ltx_font_smallcaps"> (Accuracy of Human Annotations)</span></h6>
<div id="Thmassumption9.p1" class="ltx_para">
<p id="Thmassumption9.p1.1" class="ltx_p"><span id="Thmassumption9.p1.1.1" class="ltx_text ltx_font_italic">The human-annotated labels <math id="Thmassumption9.p1.m1" class="ltx_math_unparsed" alttext="\{\tilde{L}^{(j)}_{i}:j=1,\cdots J\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>j</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\tilde{L}^{(j)}_{i}:j=1,\cdots J\}</annotation></semantics></math> and the true label <math id="Thmassumption9.p1.m2" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> satisfy the followings:</span></p>
<ol id="S4.I2" class="ltx_enumerate">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p"><span id="S4.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">(Accurate Human Labeling) Human coders are more likely to correctly annotate the true label so that</span></p>
<table id="S4.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E12.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i}=l)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i}=l)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E12.m2" class="ltx_Math" alttext="\displaystyle&gt;0.5" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\displaystyle&gt;0.5</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="S4.I2.i1.p1.2" class="ltx_p"><span id="S4.I2.i1.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="l\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">l\in\mathcal{L}</annotation></semantics></math><span id="S4.I2.i1.p1.2.2" class="ltx_text ltx_font_italic"> and all coders </span><math id="S4.I2.i1.p1.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="S4.I2.i1.p1.2.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p"><span id="S4.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">(Human Labeling Agreements) Human coders generally agree on their labeling so that</span></p>
<table id="S4.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E13.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=\tilde{L}_{i}^{(j^{\prime})}=l,T_{i}=t\mid\bm{Z}_{i},S_{i}=1)&gt;0.5" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=\tilde{L}_{i}^{(j^{\prime})}=l,T_{i}=t\mid\bm{Z}_{i},S_{i}=1)&gt;0.5</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="S4.I2.i2.p1.2" class="ltx_p"><span id="S4.I2.i2.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="l\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">l\in\mathcal{L}</annotation></semantics></math><span id="S4.I2.i2.p1.2.2" class="ltx_text ltx_font_italic">, </span><math id="S4.I2.i2.p1.m2" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="S4.I2.i2.p1.2.3" class="ltx_text ltx_font_italic"> and pair of coders </span><math id="S4.I2.i2.p1.m3" class="ltx_Math" alttext="(j,j^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(j,j^{\prime})</annotation></semantics></math><span id="S4.I2.i2.p1.2.4" class="ltx_text ltx_font_italic"> with </span><math id="S4.I2.i2.p1.m4" class="ltx_Math" alttext="j\neq j^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><msup><mi>j</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">j\neq j^{\prime}</annotation></semantics></math><span id="S4.I2.i2.p1.2.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS1.p9" class="ltx_para">
<p id="S4.SS1.p9.1" class="ltx_p">Although these assumptions may appear restrictive, Equation (<a href="#S4.E13" title="In item 2 ‣ Assumption 9 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) involves only the observed quantities and is thus directly testable. The only untestable component is Equation (<a href="#S4.E12" title="In item 1 ‣ Assumption 9 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>). This assumption is satisfied as long as humans correctly label more than half of the texts. The assumption does not require perfection and humans can still make mistakes, but it requires that their labels be biased toward the truth, which is critical for correcting errors when combining annotations from multiple human coders.</p>
</div>
<div id="S4.SS1.p10" class="ltx_para">
<p id="S4.SS1.p10.1" class="ltx_p">Under this setup, the distribution of the covariate-adjusted outcome mean can be nonparametrically identified by leveraging two or more human coding as proxies, which can then be used to identify the covariate-adjusted mean of the unobserved true label.</p>
</div>
<div id="Thmproposition2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition2.2" class="ltx_text ltx_font_smallcaps">Proposition 2</span></span><span id="Thmproposition2.3" class="ltx_text ltx_font_smallcaps"> (Identification without Perfect Human Annotations)</span></h6>
<div id="Thmproposition2.p1" class="ltx_para">
<p id="Thmproposition2.p1.1" class="ltx_p"><span id="Thmproposition2.p1.1.1" class="ltx_text ltx_font_italic">Under Assumptions <a href="#Thmassumption1" title="Assumption 1 (True Coding Rule) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, <a href="#Thmassumption3" title="Assumption 3 (Human Annotation Sampling) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, <a href="#Thmassumption4" title="Assumption 4 (Sufficiency of Representation for Texts) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, <a href="#Thmassumption6" title="Assumption 6 (Human Annotation Sampling) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>–<a href="#Thmassumption9" title="Assumption 9 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>, we can uniquely identify the distribution of the covariate-adjusted outcome mean under <math id="Thmproposition2.p1.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math>, i.e.,</span></p>
<table id="S4.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex13.m1" class="ltx_Math" alttext="\displaystyle\Psi_{t,c}:=\int\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo>:=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\Psi_{t,c}:=\int\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmproposition2.p1.2" class="ltx_p"><span id="Thmproposition2.p1.2.1" class="ltx_text ltx_font_italic">from the observed data.</span></p>
</div>
</div>
<div id="S4.SS1.p11" class="ltx_para">
<p id="S4.SS1.p11.1" class="ltx_p">The proof is given in Appendix <a href="#A2.SS4" title="S2.4 Proof of Proposition (Identification with Noisy Human Annotations) ‣ Appendix S2 Theoretical Results ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S2.4</span></a>.</p>
</div>
<div id="S4.SS1.p12" class="ltx_para">
<p id="S4.SS1.p12.1" class="ltx_p">The essence of identification is as follows. Under Assumption <a href="#Thmassumption8" title="Assumption 8 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, for all <math id="S4.SS1.p12.m1" class="ltx_Math" alttext="l,m\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>,</mo><mi>m</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">l,m\in\mathcal{L}</annotation></semantics></math> and <math id="S4.SS1.p12.m2" class="ltx_Math" alttext="\bm{z}\in\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><mi>𝒛</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><annotation encoding="application/x-tex">\bm{z}\in\mathcal{Z}</annotation></semantics></math>,</p>
<table id="S4.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex14.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m,T_{i}=t\mid\bm{Z}_{i}=\bm{z},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m,T_{i}=t\mid\bm{Z}_{i}=\bm{z},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex15.m1" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(T_{i}=t\mid L_{i}=c,\bm{Z}_{i}=\bm{z})\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo>,</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(T_{i}=t\mid L_{i}=c,\bm{Z}_{i}=\bm{z})\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p12.2" class="ltx_p">and</p>
<table id="S4.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex16.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid\bm{Z}_{i}=\bm{z},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid\bm{Z}_{i}=\bm{z},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex17.m1" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p12.3" class="ltx_p">These two factorizations construct the system of equations. In this system, the left-hand sides of both equations are observable and the three terms on the right-hand sides
(i.e., <math id="S4.SS1.p12.m3" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)</annotation></semantics></math>,
<math id="S4.SS1.p12.m4" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)</annotation></semantics></math>, and
<math id="S4.SS1.p12.m5" class="ltx_Math" alttext="\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})</annotation></semantics></math>)
are shared between equations. Since the number of equations exceeds the number of unknown parameters, the system is usually identifiable only up to scaling and permutation. However, because the coder classification probabilities <math id="S4.SS1.p12.m6" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(j)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(j)}_{i}=l\mid L_{i}=c)</annotation></semantics></math> sum to one across all categories (by definition of probability) and attain their maximum at <math id="S4.SS1.p12.m7" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}=c)</annotation></semantics></math> (Assumption <a href="#Thmassumption9" title="Assumption 9 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>), all unknown parameters are in fact identified. Once the coder-specific error rates are recovered for all coders, the target quantity can be obtained by another factorization</p>
<table id="S4.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid T_{i}=t,\bm{Z}_{i}=\bm{z},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid T_{i}=t,\bm{Z}_{i}=\bm{z},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex19.m1" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p12.4" class="ltx_p">where the only unknown is <math id="S4.SS1.p12.m8" class="ltx_Math" alttext="\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i}=\bm{z})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i}=\bm{z})</annotation></semantics></math>, which is used to calculate the parameter of interest.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Estimation and inference</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">Given the identification result, I next turn to estimation and inference. The main challenge here is that the true label <math id="S4.SS2.p1.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> is not observed, so it cannot be used to learn the low-dimensional surrogate representation in the same way as in the previous section. To address this, I introduce the surrogate outcome</p>
<table id="S4.Ex20" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex20X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex20X.m2" class="ltx_Math" alttext="\displaystyle M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex20Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex20Xa.m2" class="ltx_Math" alttext="\displaystyle=\biggl(\frac{\mathbbm{1}\{\tilde{L}^{(1)}_{i}=c\}-\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}_{i}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbbm{1}\{\tilde{L}_{i}^{(2)}=c\}-\mathbb{P}(\tilde{L}^{(2)}_{i}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}_{i}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}_{i}^{(2)}=c\mid L_{i}\neq c)}\biggl)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo><mo>−</mo><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>L</mi><msub><mrow></mrow><mi>i</mi></msub><mo>≠</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em" rspace="0em">)</mo><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo><mo>−</mo><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>L</mi><msub><mrow></mrow><mi>i</mi></msub><mo>≠</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\biggl(\frac{\mathbbm{1}\{\tilde{L}^{(1)}_{i}=c\}-\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}_{i}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbbm{1}\{\tilde{L}_{i}^{(2)}=c\}-\mathbb{P}(\tilde{L}^{(2)}_{i}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}_{i}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}_{i}^{(2)}=c\mid L_{i}\neq c)}\biggl)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p1.2" class="ltx_p">for all levels of categories <math id="S4.SS2.p1.m2" class="ltx_Math" alttext="c\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">c\in\mathcal{L}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">Crucially, this surrogate outcome is identifiable and can be estimated from the data. Specifically, one first recovers each coder <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>’s classification accuracy, <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i})</annotation></semantics></math>, using the system of equations in Proposition <a href="#Thmproposition2" title="Proposition 2 (Identification without Perfect Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Although the identification formula holds for any value of the predictor <math id="S4.SS2.p2.m3" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math>, precision improves when estimates are averaged across all levels. Once <math id="S4.SS2.p2.m4" class="ltx_Math" alttext="\widehat{\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i})}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i})}</annotation></semantics></math> is obtained, these estimates can be substituted into the formula above to construct <math id="S4.SS2.p2.m5" class="ltx_Math" alttext="\hat{M}_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{M}_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">This surrogate outcome serves as a substitute for the true label and <math id="S4.SS2.p3.m1" class="ltx_math_unparsed" alttext="M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})=\mathbbm{1}\{L_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})=\mathbbm{1}\{L_{i}=c\}</annotation></semantics></math> if both coders classify texts accurately (i.e., <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}=c)=\mathbb{P}(\tilde{L}^{(2)}_{i}=c\mid L_{i}=c)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}=c)=\mathbb{P}(\tilde{L}^{(2)}_{i}=c\mid L_{i}=c)=1</annotation></semantics></math>). Formally, it can proven that this surrogate outcome is an unbiased estimate of the true label given either the true label or the texts: i.e.,</p>
<table id="S4.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E14.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})\mid L_{i}]=\mathbb{E}[M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i}]=\mathbbm{1}\{L_{i}=c\}." display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})\mid L_{i}]=\mathbb{E}[M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i}]=\mathbbm{1}\{L_{i}=c\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="S4.SS2.p3.2" class="ltx_p">Furthermore, it can be shown that the outcome model predicting this surrogate outcome is mathematically equivalent to the one predicting the true, unobserved label <math id="S4.SS2.p3.m3" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math>. See Appendix <a href="#A2.SS5" title="S2.5 Theoretical Properties of Surrogate Outcome ‣ Appendix S2 Theoretical Results ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S2.5</span></a> for the theoretical properties of the surrogate outcome.</p>
</div>
<div id="S4.SS2.p4" class="ltx_para">
<p id="S4.SS2.p4.1" class="ltx_p">Based on this surrogate outcome, I can extend the estimation strategies in the previous section.
Under Assumptions <a href="#Thmassumption4" title="Assumption 4 (Sufficiency of Representation for Texts) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, <a href="#Thmassumption7" title="Assumption 7 (Noisy Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, and <a href="#Thmassumption8" title="Assumption 8 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, the low-dimensional representation <math id="S4.SS2.p4.m1" class="ltx_Math" alttext="\bm{W}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{W}_{i}</annotation></semantics></math> satisfies the conditional independence</p>
<table id="S4.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E15.m1" class="ltx_Math" alttext="\displaystyle\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \{T_{i},\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)}\}\mid\bm{W}_{i},\bm{Z}_{i}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0.778em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow><mo fence="false">|</mo><mrow><msub><mi>𝑾</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \{T_{i},\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)}\}\mid\bm{W}_{i},\bm{Z}_{i},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="S4.SS2.p4.2" class="ltx_p">which also implies <math id="S4.SS2.p4.m2" class="ltx_Math" alttext="\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})\mid\bm{W}_{i},\bm{Z}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0.778em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo fence="false">|</mo><mrow><msub><mi>𝑾</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})\mid\bm{W}_{i},\bm{Z}_{i}</annotation></semantics></math>. These conditions sufficiently characterize <math id="S4.SS2.p4.m3" class="ltx_Math" alttext="\bm{W}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{W}_{i}</annotation></semantics></math> such that both the identification and estimator do not depend on the specific representations. As in the previous case, <math id="S4.SS2.p4.m4" class="ltx_Math" alttext="\bm{W}_{i}=\bm{f}(\bm{Y}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{i}=\bm{f}(\bm{Y}_{i})</annotation></semantics></math> is not observed, so it is necessary estimate a surrogate representation that satisfies the independence condition above. I thus use the independence constraint to characterize the estimation procedure of the surrogate representations.</p>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.2" class="ltx_p">The estimation procedure is mostly similar to the one described in the previous section. Specifically, once the surrogate outcome <math id="S4.SS2.p5.m1" class="ltx_Math" alttext="\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msub><mi>M</mi><mi>c</mi></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})</annotation></semantics></math> is estimated, solve the following optimization problem</p>
<table id="S4.E16" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E16X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E16X.m2" class="ltx_Math" alttext="\displaystyle\arg" display="inline" intent=":literal"><semantics><mi>arg</mi><annotation encoding="application/x-tex">\displaystyle\arg</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E16X.m3" class="ltx_Math" alttext="\displaystyle\min_{\xi,\tilde{\lambda}_{c},\zeta,\nu_{j}}\frac{1}{N}\sum_{i=1}^{N}\biggl\{S_{i}\cdot\sum_{c\in\mathcal{L}}\biggl(\underbrace{\overbrace{\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i};\xi),\bm{Z}_{i};\tilde{\lambda}_{c})}^{\text{Outcome Model}}-\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})}_{\text{Outcome Loss for Category }c}\biggr)^{2}" display="inline" intent=":literal"><semantics><mrow><mi>min</mi><msub><mrow></mrow><mrow><mi>ξ</mi><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>c</mi></msub><mo>,</mo><mi>ζ</mi><mo>,</mo><msub><mi>ν</mi><mi>j</mi></msub></mrow></msub><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>N</mi></msup><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mo maxsize="2.100em" minsize="2.100em">(</mo><munder accentunder="true"><mrow><mover><mover accent="true"><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏞</mo></mover><mtext>Outcome Model</mtext></mover><mo>−</mo><mrow><mover accent="true"><msub><mi>M</mi><mi>c</mi></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mtext>Outcome Loss for Category </mtext><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo maxsize="2.100em" minsize="2.100em">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\min_{\xi,\tilde{\lambda}_{c},\zeta,\nu_{j}}\frac{1}{N}\sum_{i=1}^{N}\biggl\{S_{i}\cdot\sum_{c\in\mathcal{L}}\biggl(\underbrace{\overbrace{\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i};\xi),\bm{Z}_{i};\tilde{\lambda}_{c})}^{\text{Outcome Model}}-\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})}_{\text{Outcome Loss for Category }c}\biggr)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(16)</span></td></tr>
<tr id="S4.E16Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E16Xa.m2" class="ltx_Math" alttext="\displaystyle+\beta\cdot S_{i}\cdot\sum_{j=1}^{J}\underbrace{\biggl(\overbrace{\kappa^{(j)}(\bm{f}(\bm{Y}_{i};\xi),\bm{Z}_{i};\nu_{j})}^{\text{Human Annotation Prediction}}-\tilde{L}^{(j)}_{i}\biggr)^{2}}_{\text{Human Annotation Prediction Loss for Coder }j}+\gamma\cdot\underbrace{\text{CrossEntropy}\biggl(T_{i},\overbrace{\rho_{t}(\bm{f}(\bm{Y}_{i};\xi),\bm{Z}_{i};\zeta)}^{\text{Surrogacy Score}}\biggr)}_{\text{Prediction Loss for Predictor $T_{i}$}}\biggr\}," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>J</mi></msup><munder accentunder="true"><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mover><mover accent="true"><mrow><msup><mi>κ</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>ν</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏞</mo></mover><mtext>Human Annotation Prediction</mtext></mover><mo>−</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mn>2</mn></msup><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mtext>Human Annotation Prediction Loss for Coder </mtext><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>+</mo><mi>γ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><munder accentunder="true"><mrow><mtext>CrossEntropy</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><mover><mover accent="true"><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏞</mo></mover><mtext>Surrogacy Score</mtext></mover><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mtext>Prediction Loss for Predictor </mtext><msub><mi mathsize="0.700em">T</mi><mi mathsize="0.700em">i</mi></msub></mrow></msub><mo stretchy="false">}</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\beta\cdot S_{i}\cdot\sum_{j=1}^{J}\underbrace{\biggl(\overbrace{\kappa^{(j)}(\bm{f}(\bm{Y}_{i};\xi),\bm{Z}_{i};\nu_{j})}^{\text{Human Annotation Prediction}}-\tilde{L}^{(j)}_{i}\biggr)^{2}}_{\text{Human Annotation Prediction Loss for Coder }j}+\gamma\cdot\underbrace{\text{CrossEntropy}\biggl(T_{i},\overbrace{\rho_{t}(\bm{f}(\bm{Y}_{i};\xi),\bm{Z}_{i};\zeta)}^{\text{Surrogacy Score}}\biggr)}_{\text{Prediction Loss for Predictor $T_{i}$}}\biggr\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p5.3" class="ltx_p">where <math id="S4.SS2.p5.m2" class="ltx_Math" alttext="\tilde{\mu}_{c}(\cdot;\tilde{\lambda}_{c})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mu}_{c}(\cdot;\tilde{\lambda}_{c})</annotation></semantics></math> is the outcome model for category <math id="S4.SS2.p5.m3" class="ltx_Math" alttext="L_{i}=c" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">L_{i}=c</annotation></semantics></math> with the estimated surrogate outcome <math id="S4.SS2.p5.m4" class="ltx_Math" alttext="\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msub><mi>M</mi><mi>c</mi></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})</annotation></semantics></math> given <math id="S4.SS2.p5.m5" class="ltx_Math" alttext="\bm{W}_{i}=\bm{f}(\bm{Y}_{i};\xi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{i}=\bm{f}(\bm{Y}_{i};\xi)</annotation></semantics></math> parametrized by <math id="S4.SS2.p5.m6" class="ltx_Math" alttext="\tilde{\lambda}_{c}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>c</mi></msub><annotation encoding="application/x-tex">\tilde{\lambda}_{c}</annotation></semantics></math>, <math id="S4.SS2.p5.m7" class="ltx_Math" alttext="\kappa^{(j)}(\cdot;\nu_{j})" display="inline" intent=":literal"><semantics><mrow><msup><mi>κ</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>ν</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa^{(j)}(\cdot;\nu_{j})</annotation></semantics></math> is the prediction of the human annotation by coder <math id="S4.SS2.p5.m8" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> given <math id="S4.SS2.p5.m9" class="ltx_Math" alttext="\bm{W}_{i}=\bm{f}(\bm{Y}_{i};\xi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{i}=\bm{f}(\bm{Y}_{i};\xi)</annotation></semantics></math> parametrized by <math id="S4.SS2.p5.m10" class="ltx_Math" alttext="\nu_{j}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>j</mi></msub><annotation encoding="application/x-tex">\nu_{j}</annotation></semantics></math>, and <math id="S4.SS2.p5.m11" class="ltx_Math" alttext="(\beta,\gamma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>β</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\beta,\gamma)</annotation></semantics></math> are the hyperparameters regulating the influence of all the loss components. Unlike the previous loss function, the human annotation prediction loss needs to be added to satisfy Equation (<a href="#S4.E15" title="In 4.2 Estimation and inference ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>).</p>
</div>
<div id="S4.SS2.p6" class="ltx_para">
<p id="S4.SS2.p6.1" class="ltx_p">To characterize the behavior of the estimator at the limit, as in the previous section, I first derive its influence function.</p>
</div>
<div id="Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem3.2" class="ltx_text ltx_font_smallcaps">Theorem 3</span></span><span id="Thmtheorem3.3" class="ltx_text ltx_font_smallcaps"> (Influence Function)</span></h6>
<div id="Thmtheorem3.p1" class="ltx_para">
<p id="Thmtheorem3.p1.2" class="ltx_p"><span id="Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">The influence function for the distribution of the covariate-adjusted outcome under <math id="Thmtheorem3.p1.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> is given by</span></p>
<table id="S4.E17" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E17X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E17X.m2" class="ltx_Math" alttext="\displaystyle\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E17X.m3" class="ltx_Math" alttext="\displaystyle;\bm{f},\tilde{\mu},\pi_{t},M_{c},\bar{m}_{tc},\Psi_{t,c})" display="inline" intent=":literal"><semantics><mrow><mo>;</mo><mi>𝒇</mi><mo>,</mo><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mo>,</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>M</mi><msub><mrow></mrow><mi>c</mi></msub><mo>,</mo><mover accent="true"><mi>m</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><mi mathvariant="normal">Ψ</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle;\bm{f},\tilde{\mu},\pi_{t},M_{c},\bar{m}_{tc},\Psi_{t,c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(17)</span></td></tr>
<tr id="S4.E17Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E17Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl(M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})-\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo mathsize="2.100em">,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo mathsize="2.100em">,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\biggl(M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})-\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E17Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E17Xb.m2" class="ltx_Math" alttext="\displaystyle+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr)+\bar{m}_{t,c}(\bm{Z}_{i})-\Psi_{t,c}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo mathsize="0.700em">,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr)+\bar{m}_{t,c}(\bm{Z}_{i})-\Psi_{t,c}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem3.p1.3" class="ltx_p"><span id="Thmtheorem3.p1.3.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem3.p1.m2" class="ltx_math_unparsed" alttext="\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}))=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i}),S_{i}=1]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}))=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i}),S_{i}=1]</annotation></semantics></math>, and <math id="Thmtheorem3.p1.m3" class="ltx_Math" alttext="\bar{m}_{t,c}(\bm{Z}_{i})=\int\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}))dF(\bm{Y}_{i}\mid T_{i}=t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{m}_{t,c}(\bm{Z}_{i})=\int\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i}))dF(\bm{Y}_{i}\mid T_{i}=t,\bm{Z}_{i})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS2.p7" class="ltx_para">
<p id="S4.SS2.p7.1" class="ltx_p">The proof is provided in Appendix <a href="#A2.SS6" title="S2.6 Proof of Theorem (Influence function without true labels) ‣ Appendix S2 Theoretical Results ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S2.6</span></a>.</p>
</div>
<div id="S4.SS2.p8" class="ltx_para">
<p id="S4.SS2.p8.1" class="ltx_p">Since the estimation of the target parameter requires both the estimation of the surrogate outcome <math id="S4.SS2.p8.m1" class="ltx_Math" alttext="M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})</annotation></semantics></math> and the optimization of the loss function in Equation (<a href="#S4.E16" title="In 4.2 Estimation and inference ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>), I need to modify the standard cross-fitting procedure accordingly. Suppose that <math id="S4.SS2.p8.m2" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> is divisible by <math id="S4.SS2.p8.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>. The entire estimation procedure with <math id="S4.SS2.p8.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-fold cross-fitting is summarized as follows.</p>
<ol id="S4.I3" class="ltx_enumerate">
<li id="S4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S4.I3.i1.p1" class="ltx_para">
<p id="S4.I3.i1.p1.1" class="ltx_p">Randomly partition the data into <math id="S4.I3.i1.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> folds of equal size. Let <math id="S4.I3.i1.p1.m2" class="ltx_Math" alttext="I(i)=c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">I(i)=c</annotation></semantics></math> be the indicator of the observation <math id="S4.I3.i1.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> belonging to the fold <math id="S4.I3.i1.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S4.I3.i2.p1" class="ltx_para">
<p id="S4.I3.i2.p1.1" class="ltx_p">For each fold <math id="S4.I3.i2.p1.m1" class="ltx_Math" alttext="k\in\{1,\cdots,K\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{1,\cdots,K\}</annotation></semantics></math>, use <math id="S4.I3.i2.p1.m2" class="ltx_Math" alttext="I(i)\neq c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">I(i)\neq c</annotation></semantics></math> as training data:</p>
<ol id="S4.I3.i2.I1" class="ltx_enumerate">
<li id="S4.I3.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S4.I3.i2.I1.i1.p1" class="ltx_para">
<p id="S4.I3.i2.I1.i1.p1.1" class="ltx_p">Estimate the propensity score model <math id="S4.I3.i2.I1.i1.p1.m1" class="ltx_Math" alttext="\hat{\pi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\pi}_{t}</annotation></semantics></math> using all the sample with <math id="S4.I3.i2.I1.i1.p1.m2" class="ltx_Math" alttext="I(i)\neq c" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">I(i)\neq c</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I3.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S4.I3.i2.I1.i2.p1" class="ltx_para">
<p id="S4.I3.i2.I1.i2.p1.1" class="ltx_p">Split the training data with <math id="S4.I3.i2.I1.i2.p1.m1" class="ltx_Math" alttext="S_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S_{i}=1</annotation></semantics></math> into two halves, say <math id="S4.I3.i2.I1.i2.p1.m2" class="ltx_Math" alttext="I^{(-k)}_{1s}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I^{(-k)}_{1s}</annotation></semantics></math> and <math id="S4.I3.i2.I1.i2.p1.m3" class="ltx_Math" alttext="I^{(-k)}_{2s}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I^{(-k)}_{2s}</annotation></semantics></math>. Also, split the remaining training data (with <math id="S4.I3.i2.I1.i2.p1.m4" class="ltx_Math" alttext="S_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S_{i}=0</annotation></semantics></math>) into two halves, say <math id="S4.I3.i2.I1.i2.p1.m5" class="ltx_Math" alttext="I_{-1s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-1s}^{(-k)}</annotation></semantics></math> and <math id="S4.I3.i2.I1.i2.p1.m6" class="ltx_Math" alttext="I_{-2s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-2s}^{(-k)}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I3.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S4.I3.i2.I1.i3.p1" class="ltx_para">
<p id="S4.I3.i2.I1.i3.p1.1" class="ltx_p">Use <math id="S4.I3.i2.I1.i3.p1.m1" class="ltx_Math" alttext="I^{(-k)}_{1s}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I^{(-k)}_{1s}</annotation></semantics></math> to obtain the estimated <math id="S4.I3.i2.I1.i3.p1.m2" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i}=m)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i}=m)</annotation></semantics></math> for all categories <math id="S4.I3.i2.I1.i3.p1.m3" class="ltx_Math" alttext="(l,m)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(l,m)</annotation></semantics></math> and all coders <math id="S4.I3.i2.I1.i3.p1.m4" class="ltx_Math" alttext="j=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j=1,2</annotation></semantics></math>. By inserting these estimates, obtain the estimated surrogate outcome <math id="S4.I3.i2.I1.i3.p1.m5" class="ltx_Math" alttext="\hat{M}_{c}(\{\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)}\}_{i\in I^{(-k)}_{2s}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><msubsup><mi>I</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{M}_{c}(\{\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)}\}_{i\in I^{(-k)}_{2s}})</annotation></semantics></math> on <math id="S4.I3.i2.I1.i3.p1.m6" class="ltx_Math" alttext="I^{(-k)}_{2s}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I^{(-k)}_{2s}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I3.i2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(d)</span> 
<div id="S4.I3.i2.I1.i4.p1" class="ltx_para">
<p id="S4.I3.i2.I1.i4.p1.1" class="ltx_p">Solve the optimization problem in Equation (<a href="#S4.E16" title="In 4.2 Estimation and inference ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) using the data <math id="S4.I3.i2.I1.i4.p1.m1" class="ltx_Math" alttext="I^{(-k)}_{2s}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I^{(-k)}_{2s}</annotation></semantics></math> and <math id="S4.I3.i2.I1.i4.p1.m2" class="ltx_Math" alttext="I_{-1s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-1s}^{(-k)}</annotation></semantics></math> and obtain the estimated outcome models <math id="S4.I3.i2.I1.i4.p1.m3" class="ltx_Math" alttext="\hat{\tilde{\mu}}_{c}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\tilde{\mu}}_{c}^{(-k)}</annotation></semantics></math> for all category levels and the surrogacy score <math id="S4.I3.i2.I1.i4.p1.m4" class="ltx_Math" alttext="\hat{\rho}_{t}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\rho}_{t}^{(-k)}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I3.i2.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(e)</span> 
<div id="S4.I3.i2.I1.i5.p1" class="ltx_para">
<p id="S4.I3.i2.I1.i5.p1.1" class="ltx_p">Regress the obtained <math id="S4.I3.i2.I1.i5.p1.m1" class="ltx_Math" alttext="\hat{\tilde{\mu}}_{c}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\tilde{\mu}}_{c}^{(-k)}</annotation></semantics></math> onto <math id="S4.I3.i2.I1.i5.p1.m2" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> and <math id="S4.I3.i2.I1.i5.p1.m3" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒁</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math> using the data <math id="S4.I3.i2.I1.i5.p1.m4" class="ltx_Math" alttext="I_{-2s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-2s}^{(-k)}</annotation></semantics></math> and obtain <math id="S4.I3.i2.I1.i5.p1.m5" class="ltx_Math" alttext="\hat{\bar{m}}_{t,c}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\bar{m}}_{t,c}^{(-k)}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div></li>
<li id="S4.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S4.I3.i3.p1" class="ltx_para">
<p id="S4.I3.i3.p1.1" class="ltx_p">For each category level <math id="S4.I3.i3.p1.m1" class="ltx_Math" alttext="c\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">c\in\mathcal{L}</annotation></semantics></math> and at the level of predictors of interest <math id="S4.I3.i3.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, solve the estimating equation</p>
<table id="S4.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E18.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{N}\sum_{k=1}^{K}\sum_{I(i)=k}\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\bm{f}}^{(-k)},\hat{\tilde{\mu}}^{(-k)},\hat{\pi}_{t}^{(-k)},\hat{M}_{c}^{(-k)},\hat{\bar{m}}^{(-k)}_{t,c},\hat{\Psi}_{t,c})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></munder></mstyle><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msup><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mover accent="true"><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{N}\sum_{k=1}^{K}\sum_{I(i)=k}\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\bm{f}}^{(-k)},\hat{\tilde{\mu}}^{(-k)},\hat{\pi}_{t}^{(-k)},\hat{M}_{c}^{(-k)},\hat{\bar{m}}^{(-k)}_{t,c},\hat{\Psi}_{t,c})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="S4.I3.i3.p1.2" class="ltx_p">and obtain the estimate of the target parameter <math id="S4.I3.i3.p1.m3" class="ltx_Math" alttext="\hat{\Psi}_{t,c}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\hat{\Psi}_{t,c}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S4.SS2.p8.2" class="ltx_p">As the procedure described above is nested, I practically recommend using large values of <math id="S4.SS2.p8.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> to have a sufficient amount of training data for obtaining the coder classification estimates and the training of the neural network.</p>
</div>
<div id="S4.SS2.p9" class="ltx_para">
<p id="S4.SS2.p9.1" class="ltx_p">I finally formalize the asymptotic normality of the proposed estimator. Specifically, I assume the following regularity conditions:</p>
</div>
<div id="Thmassumption10" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption10.2" class="ltx_text ltx_font_smallcaps">Assumption 10</span></span><span id="Thmassumption10.3" class="ltx_text ltx_font_smallcaps"> (Regularity Conditions)</span></h6>
<div id="Thmassumption10.p1" class="ltx_para">
<p id="Thmassumption10.p1.1" class="ltx_p"><span id="Thmassumption10.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmassumption10.p1.m1" class="ltx_Math" alttext="c_{1}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>1</mn></msub><annotation encoding="application/x-tex">c_{1}</annotation></semantics></math> be a positive constant and <math id="Thmassumption10.p1.m2" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math> be a sequence of positive constants approaching zero as the sample size <math id="Thmassumption10.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> increases.</span></p>
<ol id="S4.I4" class="ltx_enumerate">
<li id="S4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S4.I4.i1.p1" class="ltx_para">
<p id="S4.I4.i1.p1.1" class="ltx_p"><span id="S4.I4.i1.p1.1.1" class="ltx_text ltx_font_italic">(Positivity) There exists a fixed constant </span><math id="S4.I4.i1.p1.m1" class="ltx_Math" alttext="c_{2}\in(0,1/2]" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">c_{2}\in(0,1/2]</annotation></semantics></math><span id="S4.I4.i1.p1.1.2" class="ltx_text ltx_font_italic"> such that for all </span><math id="S4.I4.i1.p1.m2" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math></p>
<table id="S4.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex21.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(c_{2}\leq\pi_{t}(\bm{Z}_{i})\leq 1-c_{2})=1,\quad\mathbb{P}(c_{2}\leq\hat{\pi}_{t}(\bm{Z}_{i})\leq 1-c_{2})=1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(c_{2}\leq\pi_{t}(\bm{Z}_{i})\leq 1-c_{2})=1,\quad\mathbb{P}(c_{2}\leq\hat{\pi}_{t}(\bm{Z}_{i})\leq 1-c_{2})=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I4.i1.p1.2" class="ltx_p"><span id="S4.I4.i1.p1.2.1" class="ltx_text ltx_font_italic">In addition, the estimated surrogacy score is also almost surely bounded so that</span></p>
<table id="S4.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex22.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\leq 1)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\leq 1)=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I4.i1.p1.3" class="ltx_p"><span id="S4.I4.i1.p1.3.1" class="ltx_text ltx_font_italic">for all </span><math id="S4.I4.i1.p1.m3" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="S4.I4.i1.p1.3.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S4.I4.i2.p1" class="ltx_para">
<p id="S4.I4.i2.p1.1" class="ltx_p"><span id="S4.I4.i2.p1.1.1" class="ltx_text ltx_font_italic">(Outcome Model Estimation) Outcome models with a estimated surrogate outcome satisfy</span></p>
<table id="S4.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex23.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]}-\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mover accent="true"><mi>M</mi><mo>^</mo></mover><msub><mrow></mrow><mi>c</mi></msub><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>^</mo></mover><mo>−</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]}-\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex24.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]}-\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mover accent="true"><mi>M</mi><mo>^</mo></mover><msub><mrow></mrow><mi>c</mi></msub><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>^</mo></mover><mo>−</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]}-\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i}),\bm{Z}_{i}]\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I4.i2.p1.2" class="ltx_p"><span id="S4.I4.i2.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="S4.I4.i2.p1.m1" class="ltx_Math" alttext="c\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">c\in\mathcal{L}</annotation></semantics></math><span id="S4.I4.i2.p1.2.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S4.I4.i3.p1" class="ltx_para">
<p id="S4.I4.i3.p1.1" class="ltx_p"><span id="S4.I4.i3.p1.1.1" class="ltx_text ltx_font_italic">(Nuisance Function Estimation) Surrogate scores are consistently estimated so that</span></p>
<table id="S4.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex25.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})-{\rho}_{t}({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})-{\rho}_{t}({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex25.m2" class="ltx_math_unparsed" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})-{\rho}_{t}({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ρ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})-{\rho}_{t}({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex26.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex26.m2" class="ltx_math_unparsed" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>π</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex27.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t,c}(\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t,c}(\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex27.m2" class="ltx_math_unparsed" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t,c}(\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t,c}(\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I4.i3.p1.2" class="ltx_p"><span id="S4.I4.i3.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="S4.I4.i3.p1.m1" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="S4.I4.i3.p1.2.2" class="ltx_text ltx_font_italic"> and </span><math id="S4.I4.i3.p1.m2" class="ltx_Math" alttext="c\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">c\in\mathcal{L}</annotation></semantics></math><span id="S4.I4.i3.p1.2.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I4.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(d)</span> 
<div id="S4.I4.i4.p1" class="ltx_para">
<p id="S4.I4.i4.p1.1" class="ltx_p"><span id="S4.I4.i4.p1.1.1" class="ltx_text ltx_font_italic">(Coder Classification Rate Estimation) Human coder classification rates </span><math id="S4.I4.i4.p1.m1" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})</annotation></semantics></math><span id="S4.I4.i4.p1.1.2" class="ltx_text ltx_font_italic"> are estimated so that</span></p>
<table id="S4.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex28.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})}-\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mover accent="true"><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>^</mo></mover><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})}-\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex29.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})}-\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>^</mo></mover><mo>−</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})}-\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.I4.i4.p1.2" class="ltx_p"><span id="S4.I4.i4.p1.2.1" class="ltx_text ltx_font_italic">for all coders </span><math id="S4.I4.i4.p1.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="S4.I4.i4.p1.2.2" class="ltx_text ltx_font_italic"> and all category levels </span><math id="S4.I4.i4.p1.m3" class="ltx_Math" alttext="c\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">c\in\mathcal{L}</annotation></semantics></math><span id="S4.I4.i4.p1.2.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS2.p10" class="ltx_para">
<p id="S4.SS2.p10.1" class="ltx_p">As in the previous section, the required rates are standard in the literature, and various machine learning models can satisfy them. For the outcome model, the required convergence is evaluated with respect to the predicted surrogate outcome <math id="S4.SS2.p10.m1" class="ltx_Math" alttext="\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})</annotation></semantics></math>. This implies that Assumption <a href="#Thmassumption10" title="Assumption 10 (Regularity Conditions) ‣ 4.2 Estimation and inference ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>(b) focuses on convergence based on these predicted surrogate outcomes. Since the estimation process involves two steps and treats the predicted surrogate outcome as fixed in the second stage, the stated condition aligns with the proposed estimation procedure and can be satisfied using a standard neural network architecture <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">Bauer and Kohler,, 2019</a>; <a href="#bib.bib55" title="" class="ltx_ref">Schmidt-Hieber,, 2020</a>; <a href="#bib.bib18" title="" class="ltx_ref">Farrell et al.,, 2021</a>)</cite>.</p>
</div>
<div id="S4.SS2.p11" class="ltx_para">
<p id="S4.SS2.p11.1" class="ltx_p">Given all the conditions mentioned above, the asymptotic normality of the proposed estimator can be derived as follows.</p>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_smallcaps">Theorem 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_smallcaps"> (Asymptotic Normality)</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para">
<p id="Thmtheorem4.p1.1" class="ltx_p"><span id="Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Under Assumptions <a href="#Thmassumption1" title="Assumption 1 (True Coding Rule) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>,<a href="#Thmassumption3" title="Assumption 3 (Human Annotation Sampling) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, <a href="#Thmassumption4" title="Assumption 4 (Sufficiency of Representation for Texts) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, <a href="#Thmassumption6" title="Assumption 6 (Human Annotation Sampling) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>–<a href="#Thmassumption10" title="Assumption 10 (Regularity Conditions) ‣ 4.2 Estimation and inference ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, the estimator for the covariate-adjusted outcome mean <math id="Thmtheorem4.p1.m1" class="ltx_Math" alttext="\hat{\Psi}_{t}=\sum_{c\in\mathcal{L}}c\ \hat{\Psi}_{t,c}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mrow><mi>c</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\Psi}_{t}=\sum_{c\in\mathcal{L}}c\ \hat{\Psi}_{t,c}</annotation></semantics></math> obtained by solving the estimating equations in Equation (<a href="#S4.E18" title="In item 3 ‣ 4.2 Estimation and inference ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>) satisfies asymptotic normality:</span></p>
<table id="S4.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex30.m1" class="ltx_Math" alttext="\frac{\sqrt{n}(\hat{\Psi}_{t}-\Psi_{t})}{\tilde{\sigma}}\xrightarrow{d}\mathcal{N}(0,1)" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mi>σ</mi><mo>~</mo></mover></mfrac><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑑</mo></mover><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\sqrt{n}(\hat{\Psi}_{t}-\Psi_{t})}{\tilde{\sigma}}\xrightarrow{d}\mathcal{N}(0,1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem4.p1.2" class="ltx_p"><span id="Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem4.p1.m2" class="ltx_Math" alttext="\tilde{\sigma}^{2}=\mathbb{E}\biggl[\biggl(\sum_{c\in\mathcal{L}}c\ \tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})\biggr)^{2}\biggr]." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>2</mn></msup><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mrow><mi>c</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\sigma}^{2}=\mathbb{E}\biggl[\biggl(\sum_{c\in\mathcal{L}}c\ \tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})\biggr)^{2}\biggr].</annotation></semantics></math></span></p>
</div>
</div>
<div id="S4.SS2.p12" class="ltx_para">
<p id="S4.SS2.p12.1" class="ltx_p">The proof is in Appendix <a href="#A2.SS7" title="S2.7 Proof of Theorem (Asymptotic Normality) ‣ Appendix S2 Theoretical Results ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S2.7</span></a>.</p>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3 </span>How to test assumptions that are not guaranteed by design</h3>

<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">While this section has developed a methodology to account for human annotations with non-differential measurement errors, the proposed SRI approach relies on several additional assumptions. Three specific assumptions warrant particular attention: (1) the independent coding (Assumption <a href="#Thmassumption8" title="Assumption 8 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> (a)), which states that the coding errors are independent across coders, (2) the exclusion restriction (Assumption <a href="#Thmassumption8" title="Assumption 8 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> (b)), which posits that texts influence the the human annotations solely through the true concept, and (3) accurate human labels (Assumption <a href="#Thmassumption9" title="Assumption 9 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Noisy Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> (a)), which asserts that the accuracy of the human annotated labels is more than 0.5. None of these assumptions can be directly tested or is guaranteed by the study design, thus complicating the application of the proposed methodology.</p>
</div>
<figure id="S4.F4" class="ltx_figure"><span class="ltx_inline-block"><svg id="S4.F4.pic1" class="ltx_picture ltx_centering" height="356.54" overflow="visible" version="1.1" viewBox="0 0 568.05 356.54" width="568.05"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,356.54) matrix(1 0 0 -1 0 0) translate(132.4,0) translate(0,326.74)"><g stroke-width="0.4pt"><g style="--ltx-fill-color:#E6E6FF;" fill="#E6E6FF"><path d="M 126.59 29.53 L -126.59 29.53 C -129.65 29.53 -132.12 27.05 -132.12 23.99 L -132.12 -23.99 C -132.12 -27.05 -129.65 -29.53 -126.59 -29.53 L 126.59 -29.53 C 129.65 -29.53 132.12 -27.05 132.12 -23.99 L 132.12 23.99 C 132.12 27.05 129.65 29.53 126.59 29.53 Z M -132.12 -29.53"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -127.51 -15.7)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 36.78)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.79)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 24.48)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 9.49)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 103.38 0)"><foreignObject style="--ltx-fo-width:3.49em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.18" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="48.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F4.pic1.1" class="ltx_text ltx_font_bold">Step 1</span>:</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.79)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:18.4em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transfor