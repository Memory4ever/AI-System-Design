<p id="A2.I1.i2.p1.1" class="ltx_p"><math id="A2.I1.i2.p1.m1" class="ltx_math_unparsed" alttext="\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]=0" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]=0</annotation></semantics></math>: Similarly,</p>
