<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex153.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]\mid\bm{Z}_{i},T_{i}=t]-\mathbb{E}_{\mathcal{P}}[\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{Z}_{i},T_{i}=t]]\biggr]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]\mid\bm{Z}_{i},T_{i}=t]-\mathbb{E}_{\mathcal{P}}[\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{Z}_{i},T_{i}=t]]\biggr].</annotation></semantics></math></td>
