<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex113.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{c_{1}}{c_{2}^{2}}\mathbb{E}\biggl[|\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})|^{2}\biggr]^{\frac{1}{2}}\biggl\{\mathbb{E}\biggl[\biggl|\{{\hat{\pi}_{t}(\bm{Z}_{i})}-\pi_{t}(\bm{Z}_{i})\}\biggr|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|\pi_{t}(\bm{Z}_{i})|^{2}\biggr]^{\frac{1}{2}}\mathbb{E}\biggl[\biggl|\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-{\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})}\biggr|^{2}\biggr]^{\frac{1}{2}}\biggr\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>c</mi><mn>1</mn></msub><msubsup><mi>c</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1<