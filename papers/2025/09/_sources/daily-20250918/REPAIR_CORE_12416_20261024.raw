msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{22}=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}\mu(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})-\frac{\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})}{\hat{\pi}_{t}(\bm{Z}_{i})}\hat{\mu}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})</annotation></semantics></math></td>
