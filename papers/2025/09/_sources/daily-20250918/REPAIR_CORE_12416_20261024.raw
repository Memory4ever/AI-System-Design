i><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[|H_{21}|^{2}\biggr]^{\frac{1}{2}}=\mathbb{E}\biggl[\biggl|\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}),\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}-\frac{\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})}{\hat{\pi}_{t}(\bm{Z}_{i})}\biggr\}\tilde{L}_{i}\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
