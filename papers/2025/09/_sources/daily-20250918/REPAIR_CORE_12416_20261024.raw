accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\tilde{L}_{i}-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i}]\biggr)\biggr]</annotation></semantics></math></td>
