</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.5.1.3" class="ltx_tr">
<td id="S4.T1.5.1.3.1" class="ltx_td ltx_align_left ltx_border_r">#LiDAR point clouds</td>
<td id="S4.T1.5.1.3.2" class="ltx_td ltx_align_center">4541</td>
