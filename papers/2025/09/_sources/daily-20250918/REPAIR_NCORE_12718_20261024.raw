<span id="S3.T2.4.1.1.1.1.1.1.1.1.3.5.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;--ltx-bg-color:#F2F2F2;">
<span id="S3.T2.4.1.1.1.1.1.1.1.1.3.5.1.1" class="ltx_p ltx_align_center">Easy</span>
