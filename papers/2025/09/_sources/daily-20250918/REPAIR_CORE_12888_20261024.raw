            <span id="algorithm2.4.5.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm2.4.5.3" class="ltx_emph ltx_font_italic"><math id="algorithm2.m10" class="ltx_Math" alttext="i\leftarrow 1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 1</annotation></semantics></math> <span id="algorithm2.4.5.3.1" class="ltx_text ltx_font_bold ltx_font_upright">to</span> <math id="algorithm2.m11" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math></em> <span id="algorithm2.4.5.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm2.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.6.1" class="ltx_text ltx_font_bold">3</span></span>
            <math id="algorithm2.m12" class="ltx_Math" alttext="\Delta t_{i}\leftarrow t_{i}-t_{i-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mi>i</mi></msub></mrow><mo stretchy="false">←</mo><mrow><msub><mi>t</mi><mi>i</mi></msub><mo>−</mo><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\Delta t_{i}\leftarrow t_{i}-t_{i-1}</annotation></semantics></math> 
</div>
<div id="algorithm2.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.4.7.1" class="ltx_text ltx_font_bold">4</span></span>
            <math id="algorithm2.m13" class="ltx_Math" alttext="Z_{t_{i}}\leftarrow Z_{t_{i-1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><msub><mi>t</mi><mi>i</mi></msub></msub><mo stretchy="false">←</mo><msub><mi>Z</mi><msub><mi>t</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub></msub></mrow><annotation encoding="application/x-tex">Z_{t_{i}}\leftarrow Z_{t_{i-1}}</annotation></semantics></math> 
