            <span id="algorithm1.4.37.2" class="ltx_text ltx_font_bold">return</span> <math id="algorithm1.m43" class="ltx_Math" alttext="v_{t_{i}}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><msub><mi>t</mi><mi>i</mi></msub></msub><annotation encoding="application/x-tex">v_{t_{i}}</annotation></semantics></math>

</div>
