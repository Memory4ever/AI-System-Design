<td id="S4.T1.2.7.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2F2F2;"><span id="S4.T1.2.7.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">0.8124</span></td>
<td id="S4.T1.2.7.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2F2F2;"><span id="S4.T1.2.7.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">0.1534</span></td></tr>
<tr id="S4.T1.2.8" class="ltx_tr">
<th id="S4.T1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="--ltx-bg-color:#F2F2F2;">
