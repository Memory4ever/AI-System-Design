<td id="S4.T1.2.8.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2F2F2;"><span id="S4.T1.2.8.3.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#F2F2F2;">0.8131</span></td>
<td id="S4.T1.2.8.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F2F2F2;"><span id="S4.T1.2.8.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">0.1497</span></td></tr>
<tr id="S4.T1.2.9" class="ltx_tr">
<th id="S4.T1.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="--ltx-bg-color:#F2F2F2;">
<span id="S4.T1.2.9.1.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.2.9.1.1.1" class="ltx_p"><span id="S4.T1.2.9.1.1.1.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">Ours (<math id="S4.T1.m6" class="ltx_Math" alttext="r=4" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">r</mi><mo style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">=</mo><mn style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">4</mn></mrow><annotation encoding="application/x-tex">r=4</annotation></semantics></math>)</span></span>
</span></th>
