              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.34.1" class="ltx_text ltx_font_bold">30</span></span>
            <math id="algorithm1.m40" class="ltx_Math" alttext="h\leftarrow M\cdot V" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo stretchy="false">←</mo><mrow><mi>M</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>V</mi></mrow></mrow><annotation encoding="application/x-tex">h\leftarrow M\cdot V</annotation></semantics></math>

</div>
<div id="algorithm1.4.35" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
