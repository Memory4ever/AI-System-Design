            <math id="algorithm1.m42" class="ltx_Math" alttext="A_{\rm{cache}}\leftarrow A_{\rm{cache}}/(L_{\rm{multi}}+L_{\rm{single}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>cache</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>A</mi><mi>cache</mi></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>multi</mi></msub><mo>+</mo><msub><mi>L</mi><mi>single</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{\rm{cache}}\leftarrow A_{\rm{cache}}/(L_{\rm{multi}}+L_{\rm{single}})</annotation></semantics></math> 
