<th id="S4.T2.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">ECG-aBcDe</th>
<td id="S4.T2.2.1.6.2" class="ltx_td ltx_border_bb"></td>
<td id="S4.T2.2.1.6.3" class="ltx_td ltx_border_bb"></td>
<td id="S4.T2.2.1.6.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.2.1.6.4.1" class="ltx_text ltx_font_bold">30.76</span></td>
