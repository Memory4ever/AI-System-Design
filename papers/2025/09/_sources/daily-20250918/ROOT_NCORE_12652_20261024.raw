           third<span id="alg1.l0.3" class="ltx_text">-</span>party model <math id="alg1.l0.m1" class="ltx_Math" alttext="f_{p}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>p</mi></msub><annotation encoding="application/x-tex">f_{p}</annotation></semantics></math>, reference model <math id="alg1.l0.m2" class="ltx_Math" alttext="\bar{f}_{\bar{p}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>f</mi><mo>¯</mo></mover><mover accent="true"><mi>p</mi><mo>¯</mo></mover></msub><annotation encoding="application/x-tex">\bar{f}_{\bar{p}}</annotation></semantics></math>,task prompts <math id="alg1.l0.m3" class="ltx_Math" alttext="\{q_{j}\}_{j=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>q</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">\{q_{j}\}_{j=1}^{n}</annotation></semantics></math>, responses per prompt <math id="alg1.l0.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>,number of permutations <math id="alg1.l0.m5" class="ltx_Math" alttext="N_{\mathrm{perm}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>perm</mi></msub><annotation encoding="application/x-tex">N_{\mathrm{perm}}</annotation></semantics></math>, significance level <math id="alg1.l0.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>

</div>
