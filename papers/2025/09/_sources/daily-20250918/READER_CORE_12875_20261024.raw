</span></span><span id="S3.T1.1.2.2.3" class="ltx_text"></span></td>
<td id="S3.T1.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T1.1.2.3.1" class="ltx_text"></span> <span id="S3.T1.1.2.3.2" class="ltx_text">
<span id="S3.T1.1.2.3.2.1" class="ltx_tabular ltx_align_bottom">
