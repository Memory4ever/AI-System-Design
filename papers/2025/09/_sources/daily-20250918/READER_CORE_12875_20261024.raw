<td id="S4.T2.1.7.2" class="ltx_td ltx_align_center">92.48</td></tr>
<tr id="S4.T2.1.8" class="ltx_tr">
<td id="S4.T2.1.8.1" class="ltx_td ltx_align_left">SoftCoT++ (<math id="S4.T2.m2" class="ltx_Math" alttext="N=1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N=1</annotation></semantics></math>)</td>
<td id="S4.T2.1.8.2" class="ltx_td ltx_align_center">92.48</td></tr>
