<span id="S3.T1.1.2.5.2.1" class="ltx_tabular ltx_align_bottom">
<span id="S3.T1.1.2.5.2.1.1" class="ltx_tr">
<span id="S3.T1.1.2.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.2pt;padding-right:3.2pt;">Avg.(Math)</span></span>
</span></span><span id="S3.T1.1.2.5.3" class="ltx_text"></span></td>
<td id="S3.T1.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T1.1.2.6.1" class="ltx_text"></span> <span id="S3.T1.1.2.6.2" class="ltx_text">
