<td id="S6.T6.1.4.4" class="ltx_td ltx_align_center" style="padding:0.5pt 7.1pt;"><span id="S6.T6.1.4.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">78.21</span></td>
<td id="S6.T6.1.4.5" class="ltx_td ltx_align_center" style="padding:0.5pt 7.1pt;"><span id="S6.T6.1.4.5.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">72.35</span></td></tr>
