<th id="S6.T6.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_ttt" style="padding:0.5pt 7.1pt;" colspan="2">Ground<math id="S6.T6.m2" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>Satellite</th>
<th id="S6.T6.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_ttt" style="padding:0.5pt 7.1pt;" colspan="2">Drone<math id="S6.T6.m3" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>Satellite</th></tr>
