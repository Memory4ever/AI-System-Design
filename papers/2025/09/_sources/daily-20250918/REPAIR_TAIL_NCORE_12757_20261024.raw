<tr id="S6.T6.1.4" class="ltx_tr" style="--ltx-bg-color:#F2F2F2;">
<th id="S6.T6.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding:0.5pt 7.1pt;"><span id="S6.T6.1.4.1.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">1</span></th>
<td id="S6.T6.1.4.2" class="ltx_td ltx_align_center" style="padding:0.5pt 7.1pt;"><span id="S6.T6.1.4.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">52.00</span></td>
