<td id="S4.T2.1.1.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">12,000+</td>
<td id="S4.T2.1.1.3.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">Binary / multi-class</td>
<td id="S4.T2.1.1.3.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">12</td></tr>
<tr id="S4.T2.1.1.4" class="ltx_tr">
<td id="S4.T2.1.1.4.1" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">Relabeled PROMISE</td>
<td id="S4.T2.1.1.4.2" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">12,000+</td>
<td id="S4.T2.1.1.4.3" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">Binary / multi-class</td>
<td id="S4.T2.1.1.4.4" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">9</td></tr>
<tr id="S4.T2.1.1.5" class="ltx_tr">
<td id="S4.T2.1.1.5.1" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">PURE</td>
<td id="S4.T2.1.1.5.2" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">90,000+</td>
<td id="S4.T2.1.1.5.3" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">Binary</td>
<td id="S4.T2.1.1.5.4" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;">2</td></tr>
