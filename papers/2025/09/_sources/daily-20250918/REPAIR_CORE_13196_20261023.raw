<th id="S4.T2.1.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T2.1.1.2.2.1" class="ltx_text ltx_font_bold">of words</span></th>
<th id="S4.T2.1.1.2.3" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T2.1.1.2.3.1" class="ltx_text ltx_font_bold">tasks</span></th>
<th id="S4.T2.1.1.2.4" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S4.T2.1.1.2.4.1" class="ltx_text ltx_font_bold">of classes</span></th></tr>
