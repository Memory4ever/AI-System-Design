<span id="S3.T1.4.6.1.1.1" class="ltx_p ltx_align_left"><span id="S3.T1.4.6.1.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:70%;">S2</span></span>
</span></td>
<td id="S3.T1.4.6.2" class="ltx_td ltx_align_left" style="padding-bottom: 2.0pt;padding-top:-0.6pt;padding-bottom:-0.6pt;">
