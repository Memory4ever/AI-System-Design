<td id="S3.T3.5.1.8.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r">+ PGCL (<math id="S3.T3.m12" class="ltx_Math" alttext="\mathcal{L}_{g}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>g</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{g}</annotation></semantics></math> + <math id="S3.T3.m13" class="ltx_Math" alttext="\mathcal{L}_{gp}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{gp}</annotation></semantics></math> + <math id="S3.T3.m14" class="ltx_Math" alttext="\mathcal{L}_{gpgd}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{gpgd}</annotation></semantics></math>) + PDRL</td>
