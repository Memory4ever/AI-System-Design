</div>
<div id="alg1.l20" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
                  
                  
                  <span id="alg1.l20.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l20.m1" class="ltx_Math" alttext="\mathbf{C}_{g}" display="inline" intent=":literal"><semantics><msub><mi>𝐂</mi><mi>g</mi></msub><annotation encoding="application/x-tex">\mathbf{C}_{g}</annotation></semantics></math>

</div>
<div id="alg1.l21" class="ltx_listingline">
