<td id="S3.T3.5.1.7.1" class="ltx_td ltx_align_left ltx_border_r">+ PGCL (<math id="S3.T3.m9" class="ltx_Math" alttext="\mathcal{L}_{g}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>g</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{g}</annotation></semantics></math> + <math id="S3.T3.m10" class="ltx_Math" alttext="\mathcal{L}_{gp}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{gp}</annotation></semantics></math> + <math id="S3.T3.m11" class="ltx_Math" alttext="\mathcal{L}_{gpgd}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{gpgd}</annotation></semantics></math>)</td>
<td id="S3.T3.5.1.7.2" class="ltx_td ltx_align_center">1.18</td>
<td id="S3.T3.5.1.7.3" class="ltx_td ltx_align_center ltx_border_r">1.97</td>
<td id="S3.T3.5.1.7.4" class="ltx_td ltx_align_center">2.91</td>
<td id="S3.T3.5.1.7.5" class="ltx_td ltx_align_center ltx_border_r">6.37</td>
<td id="S3.T3.5.1.7.6" class="ltx_td ltx_align_center">1.54</td>
<td id="S3.T3.5.1.7.7" class="ltx_td ltx_align_center ltx_border_r">5.81</td>
<td id="S3.T3.5.1.7.8" class="ltx_td ltx_align_center">1.22</td>
<td id="S3.T3.5.1.7.9" class="ltx_td ltx_align_center ltx_border_r">3.53</td>
<td id="S3.T3.5.1.7.10" class="ltx_td ltx_align_center">1.23</td>
<td id="S3.T3.5.1.7.11" class="ltx_td ltx_align_center">3.35</td></tr>
