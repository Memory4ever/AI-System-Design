<td id="S3.T2.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">CER</td>
<td id="S3.T2.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">B-WER</td>
<td id="S3.T2.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t">CER</td>
<td id="S3.T2.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t">B-WER</td></tr>
<tr id="S3.T2.5.1.3" class="ltx_tr">
<td id="S3.T2.5.1.3.1" class="ltx_td ltx_align_left ltx_border_t" colspan="7"><span id="S3.T2.5.1.3.1.1" class="ltx_text ltx_font_italic">test-small</span></td></tr>
<tr id="S3.T2.5.1.4" class="ltx_tr">
<td id="S3.T2.5.1.4.1" class="ltx_td ltx_align_left">NA</td>
<td id="S3.T2.5.1.4.2" class="ltx_td ltx_align_center">9.94</td>
<td id="S3.T2.5.1.4.3" class="ltx_td ltx_align_center">84.29</td>
<td id="S3.T2.5.1.4.4" class="ltx_td ltx_align_center">4.57</td>
<td id="S3.T2.5.1.4.5" class="ltx_td ltx_align_center">34.07</td>
<td id="S3.T2.5.1.4.6" class="ltx_td ltx_align_center"><span id="S3.T2.5.1.4.6.1" class="ltx_text ltx_font_bold">4.44</span></td>
<td id="S3.T2.5.1.4.7" class="ltx_td ltx_align_center"><span id="S3.T2.5.1.4.7.1" class="ltx_text ltx_font_bold">34.00</span></td></tr>
<tr id="S3.T2.5.1.5" class="ltx_tr">
<td id="S3.T2.5.1.5.1" class="ltx_td ltx_align_left">GT</td>
<td id="S3.T2.5.1.5.2" class="ltx_td ltx_align_center">2.86</td>
<td id="S3.T2.5.1.5.3" class="ltx_td ltx_align_center">10.71</td>
<td id="S3.T2.5.1.5.4" class="ltx_td ltx_align_center">1.25</td>
<td id="S3.T2.5.1.5.5" class="ltx_td ltx_align_center">2.14</td>
<td id="S3.T2.5.1.5.6" class="ltx_td ltx_align_center"><span id="S3.T2.5.1.5.6.1" class="ltx_text ltx_font_bold">0.90</span></td>
