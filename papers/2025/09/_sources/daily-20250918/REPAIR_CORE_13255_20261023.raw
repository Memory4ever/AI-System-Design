<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="S4.T4.5" class="ltx_text" style="font-size:90%;">Table 4</span>: </span><span id="S4.T4.6" class="ltx_text ltx_font_bold" style="font-size:90%;">Automatic Audio Description.<span id="S4.T4.6.1" class="ltx_text ltx_font_medium">
