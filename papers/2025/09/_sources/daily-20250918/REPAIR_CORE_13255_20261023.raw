<td id="S4.T5.3.1.1.5.7" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S4.T5.m12" class="ltx_Math" alttext="7.5_{(-56\%)}" display="inline" intent=":literal"><semantics><msub><mn>7.5</mn><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mn>56</mn><mo>%</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">7.5_{(-56\%)}</annotation></semantics></math></td></tr>
