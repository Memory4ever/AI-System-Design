<span id="Sx5.T1.1.1.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">Para</span></span>
<span id="Sx5.T1.1.1.2.2.1.2" class="ltx_tr">
<span id="Sx5.T1.1.1.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">-phrase</span></span>
</span></span><span id="Sx5.T1.1.1.2.3" class="ltx_text"></span></td>
