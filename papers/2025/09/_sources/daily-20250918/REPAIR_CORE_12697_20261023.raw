<span id="Sx5.T1.1.1.3.2.1" class="ltx_tabular ltx_align_middle">
<span id="Sx5.T1.1.1.3.2.1.1" class="ltx_tr">
<span id="Sx5.T1.1.1.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">Entail</span></span>
<span id="Sx5.T1.1.1.3.2.1.2" class="ltx_tr">
<span id="Sx5.T1.1.1.3.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">-ment</span></span>
</span></span><span id="Sx5.T1.1.1.3.3" class="ltx_text"></span></td>
<td id="Sx5.T1.1.1.4" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="Sx5.T1.1.1.4.1" class="ltx_text"></span> <span id="Sx5.T1.1.1.4.2" class="ltx_text">
<span id="Sx5.T1.1.1.4.2.1" class="ltx_tabular ltx_align_middle">
<span id="Sx5.T1.1.1.4.2.1.1" class="ltx_tr">
<span id="Sx5.T1.1.1.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">Structure</span></span>
<span id="Sx5.T1.1.1.4.2.1.2" class="ltx_tr">
<span id="Sx5.T1.1.1.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">to Text</span></span>
</span></span><span id="Sx5.T1.1.1.4.3" class="ltx_text"></span></td>
<td id="Sx5.T1.1.1.5" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="Sx5.T1.1.1.5.1" class="ltx_text"></span> <span id="Sx5.T1.1.1.5.2" class="ltx_text">
<span id="Sx5.T1.1.1.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="Sx5.T1.1.1.5.2.1.1" class="ltx_tr">
<span id="Sx5.T1.1.1.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">Text For</span></span>
<span id="Sx5.T1.1.1.5.2.1.2" class="ltx_tr">
<span id="Sx5.T1.1.1.5.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">-matting</span></span>
