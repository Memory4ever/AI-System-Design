<span id="A7.T16.4.10.5.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="A7.T16.4.10.5.1.1" class="ltx_p"><span id="A7.T16.4.10.5.1.1.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">Both</span></span>
</span></td>
<td id="A7.T16.4.10.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r ltx_border_t">
