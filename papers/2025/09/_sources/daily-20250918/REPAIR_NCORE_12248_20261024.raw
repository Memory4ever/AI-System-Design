<td id="S4.T3.2.7.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><span id="S4.T3.2.7.3.1" class="ltx_text ltx_font_bold">0.507</span></td>
<td id="S4.T3.2.7.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_rr">0.295</td>
<td id="S4.T3.2.7.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">0.467</td>
<td id="S4.T3.2.7.6" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">0.877</td>
<td id="S4.T3.2.7.7" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">0.463</td>
<td id="S4.T3.2.7.8" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">0.271</td>
<td id="S4.T3.2.7.9" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">0.101</td>
<td id="S4.T3.2.7.10" class="ltx_td ltx_align_center ltx_border_b ltx_border_r">0.054</td>
