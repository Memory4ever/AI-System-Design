<td id="A7.T16.4.10.4" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r ltx_border_t"><span id="A7.T16.4.10.4.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">2</span></td>
