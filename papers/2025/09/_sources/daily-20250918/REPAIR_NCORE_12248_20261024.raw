<th id="S4.T2.2.14.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_r ltx_border_t">
<span id="S4.T2.2.14.1.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S4.T2.2.14.1.1.1" class="ltx_p">Panel Contribution</span>
