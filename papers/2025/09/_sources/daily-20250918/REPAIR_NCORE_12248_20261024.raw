<th id="S5.T4.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r" style="padding:-0.25pt 4.0pt;">Qwen2-VL 7B</th>
<th id="S5.T4.2.8.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_b ltx_border_r" style="padding:-0.25pt 4.0pt;">2,661</th>
<td id="S5.T4.2.8.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding:-0.25pt 4.0pt;">41</td>
<td id="S5.T4.2.8.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding:-0.25pt 4.0pt;">50</td>
<td id="S5.T4.2.8.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r" style="padding:-0.25pt 4.0pt;">23</td>
