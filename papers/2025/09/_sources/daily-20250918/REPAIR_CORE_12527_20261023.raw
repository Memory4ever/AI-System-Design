<figure id="S8.T3" class="ltx_table">
<table id="S8.T3.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S8.T3.2.1" class="ltx_tr">
<th id="S8.T3.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt"><math id="S8.T3.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math></th>
<th id="S8.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Coverage (%)</th>
<th id="S8.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Risk (%)</th>
