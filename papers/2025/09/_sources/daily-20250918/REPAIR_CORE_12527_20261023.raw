<figure id="S8.F7" class="ltx_figure"><object type="image/svg+xml" data="2509.12527v1/sample_size_variance.svg" id="S8.F7.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:384/285;" width="384" height="285"></object>
