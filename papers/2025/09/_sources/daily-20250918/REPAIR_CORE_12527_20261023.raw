<td id="A2.T5.2.8.2" class="ltx_td ltx_align_left">Evidence MI upper bound: <math id="A2.T5.m10" class="ltx_Math" alttext="I(Y;E)\leq\kappa" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">I(Y;E)\leq\kappa</annotation></semantics></math></td></tr>
