8 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 13.41 -17.92 L 44.26 -59.13 L 82.65 -59.13"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 82.65 -59.13)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 191.83 0 L 230.22 0"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 230.22 0)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 183.64 -39.41 L 230.3 -19.38"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.9189 0.3945 -0.3945 0.9189 230.3 -19.38)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 319.72 0 L 358.11 0"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 358.11 0)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 467.29 0 L 505.68 0"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 505.68 0)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g stroke-width="0.8pt"><path style="fill:none" d="M 561.47 54.81 L 561.47 73.51"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.0 1.0 -1.0 0.0 561.47 73.51)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 551.05 69.82)"><foreignObject style="--ltx-fo-width:1.59em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="21.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.10" class="ltx_text">Yes</span></span></span></foreignObject></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 561.47 -54.81 L 561.47 -73.51"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.0 -1.0 1.0 0.0 561.47 -73.51)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 539.01 -69.38)"><foreignObject style="--ltx-fo-width:1.25em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="17.3"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.11" class="ltx_text">No</span></span></span></foreignObject></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>The end-to-end pipeline for our information-lift certificate. An input is processed by both the full and skeleton models to compute token-level lifts, which are aggregated into an information budget. This budget is compared against a pre-computed threshold <math id="S2.F2.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> to make a final certify/abstain decision.</figcaption>
</figure>
<div id="S2.Thmtheorem1" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Definition 2.1</span></span><span id="S2.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Token-level lift and clipping)<span id="S2.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem1.p1" class="ltx_para">
<p id="S2.Thmtheorem1.p1.1" class="ltx_p"><span id="S2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">The <em id="S2.Thmtheorem1.p1.1.1.1" class="ltx_emph ltx_font_upright">lift</em> for token <math id="S2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> is <math id="S2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="L(y;x,S)=\log P(y|x)-\log S(y)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">L(y;x,S)=\log P(y|x)-\log S(y)</annotation></semantics></math>. The clipped lift is <math id="S2.Thmtheorem1.p1.m3" class="ltx_Math" alttext="L_{B}(y;x,S)=\min\{\max(L(y;x,S),0),B\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mi>B</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{B}(y;x,S)=\min\{\max(L(y;x,S),0),B\}</annotation></semantics></math> with <math id="S2.Thmtheorem1.p1.m4" class="ltx_Math" alttext="B&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S2.Thmtheorem2" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Definition 2.2</span></span><span id="S2.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Information budget and certificate)<span id="S2.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem2.p1" class="ltx_para">
<p id="S2.Thmtheorem2.p1.1" class="ltx_p"><span id="S2.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">From <math id="S2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> i.i.d. (or batched) draws of lifts <math id="S2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="L_{B}^{(i)}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">L_{B}^{(i)}</annotation></semantics></math>, define <math id="S2.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\hat{\Delta}=\frac{1}{n}\sum_{i=1}^{n}L_{B}^{(i)}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msubsup><mi>L</mi><mi>B</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\Delta}=\frac{1}{n}\sum_{i=1}^{n}L_{B}^{(i)}</annotation></semantics></math>. A <em id="S2.Thmtheorem2.p1.1.1.1" class="ltx_emph ltx_font_upright">lift-certificate</em> answers if <math id="S2.Thmtheorem2.p1.m4" class="ltx_Math" alttext="\hat{\Delta}\geq\tau" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><mo>≥</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\hat{\Delta}\geq\tau</annotation></semantics></math> and abstains otherwise.</span></p>
</div>
</div>
<div id="S2.Thmtheorem3" class="ltx_theorem ltx_theorem_defn">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem3.2" class="ltx_text ltx_font_bold">Definition 2.3</span></span><span id="S2.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Selective risk)<span id="S2.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem3.p1" class="ltx_para">
<p id="S2.Thmtheorem3.p1.1" class="ltx_p"><span id="S2.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">The selective risk at target level <math id="S2.Thmtheorem3.p1.m1" class="ltx_Math" alttext="h^{\star}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">h^{\star}</annotation></semantics></math> is <math id="S2.Thmtheorem3.p1.m2" class="ltx_Math" alttext="R=\mathbb{P}[\text{error}\mid\text{answered}]" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mtext class="ltx_mathvariant_italic">error</mtext><mo lspace="0em" rspace="0.167em">∣</mo><mtext class="ltx_mathvariant_italic">answered</mtext></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R=\mathbb{P}[\text{error}\mid\text{answered}]</annotation></semantics></math>. A valid certificate ensures <math id="S2.Thmtheorem3.p1.m3" class="ltx_Math" alttext="R\leq h^{\star}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≤</mo><msup><mi>h</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">R\leq h^{\star}</annotation></semantics></math>.</span></p>
</div>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Certificate Recipe</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          <span id="alg1.l1.2" class="ltx_text ltx_font_bold">Goal:</span> Certify outputs to ensure selective risk <math id="alg1.l1.m1" class="ltx_Math" alttext="R\leq h^{\star}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≤</mo><msup><mi>h</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">R\leq h^{\star}</annotation></semantics></math>.

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          <span id="alg1.l2.2" class="ltx_text ltx_font_bold">Step 1 (Parameter Estimation):</span> On a calibration set, estimate the sub-gamma parameters <math id="alg1.l2.m1" class="ltx_Math" alttext="(v,c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v,c)</annotation></semantics></math> of the clipped lift distribution by fitting to empirical tails (e.g., using QQ plots or KS tests).

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          <span id="alg1.l3.2" class="ltx_text ltx_font_bold">Step 2 (Skeleton Design):</span> Choose a prior <math id="alg1.l3.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> over skeleton families (e.g., temperature-smoothed models). Use VSD (§<a href="#S6" title="6 Variational Skeleton Design (VSD) ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) to compute a data-dependent posterior <math id="alg1.l3.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>.

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
          <span id="alg1.l4.2" class="ltx_text ltx_font_bold">Step 3 (Set Threshold):</span> Invert the PAC-Bayes bound from <a href="#S3.Thmtheorem2" title="Theorem 3.2 (PAC-Bayes sub-gamma bound). ‣ 3 Main Theory: PAC-Bayes Sub-Gamma Certificates ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.2</span></a> to find the minimum threshold <math id="alg1.l4.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> required to guarantee <math id="alg1.l4.m2" class="ltx_Math" alttext="R\leq h^{\star}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≤</mo><msup><mi>h</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">R\leq h^{\star}</annotation></semantics></math> with high probability <math id="alg1.l4.m3" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>.

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
          <span id="alg1.l5.2" class="ltx_text ltx_font_bold">Step 4 (Deploy):</span> For a new input, compute the information budget <math id="alg1.l5.m1" class="ltx_Math" alttext="\hat{\Delta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\Delta}</annotation></semantics></math>. If <math id="alg1.l5.m2" class="ltx_Math" alttext="\hat{\Delta}\geq\tau" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><mo>≥</mo><mi>τ</mi></mrow><annotation encoding="application/x-tex">\hat{\Delta}\geq\tau</annotation></semantics></math>, provide the answer. Otherwise, abstain.

</div>
</div>
</figure>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Main Theory: PAC-Bayes Sub-Gamma Certificates</h2>

<div id="S3.p1" class="ltx_para ltx_noindent">
<p id="S3.p1.1" class="ltx_p">Standard Bernstein-style bounds assume sub-exponential tails; lifts in practice can be heavier-tailed. We adopt the <em id="S3.p1.1.1" class="ltx_emph ltx_font_italic">sub-gamma</em> family.</p>
</div>
<div id="S3.Thmtheorem1" class="ltx_theorem ltx_theorem_assump">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Assumption 3.1</span></span><span id="S3.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Sub-gamma lifts)<span id="S3.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="S3.Thmtheorem1.p1.1" class="ltx_p"><span id="S3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">There exist <math id="S3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="v&gt;0,c&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>v</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>c</mi><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">v&gt;0,c&gt;0</annotation></semantics></math> such that for all <math id="S3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\lambda\in(0,1/c)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in(0,1/c)</annotation></semantics></math>,</span></p>
<table id="S3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex1.m1" class="ltx_Math" alttext="\log\mathbb{E}\exp\{\lambda(L_{B}-\mathbb{E}L_{B})\}\;\leq\;\frac{\lambda^{2}v}{2(1-c\lambda)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>𝔼</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>B</mi></msub><mo>−</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>B</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.280em" stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo rspace="0.558em">≤</mo><mfrac><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\log\mathbb{E}\exp\{\lambda(L_{B}-\mathbb{E}L_{B})\}\;\leq\;\frac{\lambda^{2}v}{2(1-c\lambda)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.Thmtheorem2" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 3.2</span></span><span id="S3.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(PAC-Bayes sub-gamma bound)<span id="S3.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem2.p1" class="ltx_para ltx_noindent">
<p id="S3.Thmtheorem2.p1.1" class="ltx_p"><span id="S3.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> be a prior over skeletons and <math id="S3.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> a posterior (data-dependent). Under <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Sub-gamma lifts). ‣ 3 Main Theory: PAC-Bayes Sub-Gamma Certificates ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3.1</span></a>, with probability at least <math id="S3.Thmtheorem2.p1.m3" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</span></p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_math_unparsed" alttext="|\Delta\;\leq\;\hat{\Delta}\;+\;\sqrt{\frac{2\big(v+\mathrm{KL}(\rho\|\pi)\big)\log(1/\delta)}{n}}\;+\;\frac{c\log(1/\delta)}{n}." display="block" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi mathvariant="normal">Δ</mi><mo lspace="0.558em" rspace="0.558em">≤</mo><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><mo rspace="0.502em">+</mo><msqrt><mfrac><mrow><mn>2</mn><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>v</mi><mo>+</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>ρ</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em" rspace="0.167em">)</mo><mi>log</mi><mo stretchy="false">(</mo><mn>1</mn><mo>/</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mi>n</mi></mfrac></msqrt><mo lspace="0.502em" rspace="0.502em">+</mo><mfrac><mrow><mi>c</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>n</mi></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\Delta\;\leq\;\hat{\Delta}\;+\;\sqrt{\frac{2\big(v+\mathrm{KL}(\rho\|\pi)\big)\log(1/\delta)}{n}}\;+\;\frac{c\log(1/\delta)}{n}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.p2" class="ltx_para">
<p id="S3.p2.1" class="ltx_p"><span id="S3.p2.1.1" class="ltx_text ltx_font_bold">Step 1 (Change of measure).<span id="S3.p2.1.1.1" class="ltx_text ltx_font_medium"> For any measurable <math id="S3.p2.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> on skeletons,
<math id="S3.p2.m2" class="ltx_math_unparsed" alttext="\mathbb{E}_{\rho}[f]\leq\mathrm{KL}(\rho\|\pi)+\log\mathbb{E}_{\pi}[\exp(f)]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>ρ</mi></msub><mrow><mo stretchy="false">[</mo><mi>f</mi><mo stretchy="false">]</mo></mrow><mo>≤</mo><mi>KL</mi><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>log</mi><msub><mi>𝔼</mi><mi>π</mi></msub><mrow><mo stretchy="false">[</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\rho}[f]\leq\mathrm{KL}(\rho\|\pi)+\log\mathbb{E}_{\pi}[\exp(f)]</annotation></semantics></math>.
<br class="ltx_break"></span>Step 2 (MGF control).<span id="S3.p2.1.1.2" class="ltx_text ltx_font_medium"> Apply sub-gamma MGF bound to <math id="S3.p2.m3" class="ltx_Math" alttext="\hat{\Delta}-\Delta" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><mo>−</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">\hat{\Delta}-\Delta</annotation></semantics></math>.
<br class="ltx_break"></span>Step 3 (Union bound).<span id="S3.p2.1.1.3" class="ltx_text ltx_font_medium"> Calibrate <math id="S3.p2.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math> and rearrange to isolate <math id="S3.p2.m5" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math>. Full details in App. <a href="#A1" title="Appendix A Complete Proofs ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.
∎</span></span></p>
</div>
</div>
<section id="S3.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Intuition.</h4>

<div id="S3.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S3.SS0.SSS0.Px1.p1.1" class="ltx_p">Compared to Bernstein, sub-gamma bounds hold under heavier tails with a scale penalty <math id="S3.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>. The KL term rewards priors/posteriors aligned with good skeletons.</p>
</div>
</section>
<section id="S3.SS0.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Practical Takeaways.</h4>

<div id="S3.SS0.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="S3.SS0.SSS0.Px2.p1.1" class="ltx_p"><span id="S3.SS0.SSS0.Px2.p1.1.1" class="ltx_text ltx_font_bold">Practitioner recipe:</span> Estimate <math id="S3.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="(v,c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v,c)</annotation></semantics></math> via QQ/KS/AD fits; pick a simple prior <math id="S3.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> over skeleton families; use empirical posteriors <math id="S3.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> from VSD (§<a href="#S6" title="6 Variational Skeleton Design (VSD) ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>). The bound sets <math id="S3.SS0.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> for targeted <math id="S3.SS0.SSS0.Px2.p1.m5" class="ltx_Math" alttext="h^{\star}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">h^{\star}</annotation></semantics></math>.</p>
</div>
</section>
<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Illustrative Example: Why Sub-Gamma Matters</h3>

<div id="S3.SS1.p1" class="ltx_para ltx_noindent">
<p id="S3.SS1.p1.1" class="ltx_p">Standard PAC-Bayes bounds, rooted in Bernstein’s inequality, fail when data exhibits heavy tails. To illustrate, we conduct a toy experiment using synthetically generated lift data from a Pareto distribution, which has a much heavier tail than sub-exponential distributions allow. We construct 95% confidence bounds for the mean lift using both a standard Bernstein-based inequality and our sub-gamma bound (<a href="#S3.Thmtheorem2" title="Theorem 3.2 (PAC-Bayes sub-gamma bound). ‣ 3 Main Theory: PAC-Bayes Sub-Gamma Certificates ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.2</span></a>).</p>
</div>
<figure id="S3.F3" class="ltx_figure"><object type="image/svg+xml" data="2509.12527v1/bernstein_vs_subgamma.svg" id="S3.F3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:384/286;" width="384" height="286"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>Comparison of Bernstein and sub-gamma bounds on heavy-tailed synthetic data. The Bernstein bound (blue) is too tight, with empirical coverage falling far far below the nominal 95% level as sample size grows. Our sub-gamma bound (red) remains valid by paying a “heavy-tail penalty,” successfully maintaining the target coverage. This illustrates the necessity of our approach for reliable certification.</figcaption>
</figure>
<div id="S3.SS1.p2" class="ltx_para ltx_noindent">
<p id="S3.SS1.p2.1" class="ltx_p">As shown in <a href="#S3.F3" title="In 3.1 Illustrative Example: Why Sub-Gamma Matters ‣ 3 Main Theory: PAC-Bayes Sub-Gamma Certificates ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">3</span></a>, the Bernstein-based bound is overly optimistic and its empirical coverage collapses, failing to provide a valid certificate. In contrast, our sub-gamma bound correctly adapts to the heavy tails, providing a wider, but valid, confidence interval that achieves the target 95% coverage. This confirms that for statistics like information lifts, which can be heavy-tailed, the machinery of sub-gamma analysis is not just a theoretical refinement but a practical necessity for reliable risk control.</p>
</div>
<section id="S3.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">TODO.</h4>

<div id="S3.SS1.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S3.SS1.SSS0.Px1.p1.1" class="ltx_p">Generate <code id="S3.SS1.SSS0.Px1.p1.1.1" class="ltx_verbatim ltx_font_typewriter">figures/bernstein_vs_subgamma.pdf</code>.</p>
</div>
</section>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Robustness: Skeleton Sensitivity and Informativeness</h2>

<div id="S4.Thmtheorem1" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 4.1</span></span><span id="S4.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(<math id="S4.Thmtheorem1.m1" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>-robustness)<span id="S4.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="S4.Thmtheorem1.p1.1" class="ltx_p"><span id="S4.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="S^{\star}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">S^{\star}</annotation></semantics></math> denote the ideal skeleton. If <math id="S4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\mathrm{TV}(S,S^{\star})\leq\eta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msup><mi>S</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>η</mi></mrow><annotation encoding="application/x-tex">\mathrm{TV}(S,S^{\star})\leq\eta</annotation></semantics></math>, then the certified selective risk satisfies</span></p>
<table id="S4.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex3.m1" class="ltx_Math" alttext="R(S)\;\leq\;R(S^{\star})+C\eta," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>S</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">R(S)\;\leq\;R(S^{\star})+C\eta,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem1.p1.2" class="ltx_p"><span id="S4.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S4.Thmtheorem1.p1.m3" class="ltx_Math" alttext="C=C(B,\tau)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>B</mi><mo>,</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C=C(B,\tau)</annotation></semantics></math> depends on clipping and the decision boundary’s Lipschitz constant.</span></p>
</div>
</div>
<div id="S4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p"><span id="S4.p1.1.1" class="ltx_text">Couple <math id="S4.p1.m1" class="ltx_Math" alttext="(S,S^{\star})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msup><mi>S</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(S,S^{\star})</annotation></semantics></math> with <math id="S4.p1.m2" class="ltx_Math" alttext="\mathrm{TV}(S,S^{\star})\leq\eta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>TV</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msup><mi>S</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>η</mi></mrow><annotation encoding="application/x-tex">\mathrm{TV}(S,S^{\star})\leq\eta</annotation></semantics></math>. Then for all <math id="S4.p1.m3" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>,
<math id="S4.p1.m4" class="ltx_Math" alttext="|\log S^{\star}(y)-\log S(y)|\leq\tilde{C}\eta" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>S</mi><mo>⋆</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mover accent="true"><mi>C</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mrow><annotation encoding="application/x-tex">|\log S^{\star}(y)-\log S(y)|\leq\tilde{C}\eta</annotation></semantics></math> (by Taylor + Pinsker). Thus
<math id="S4.p1.m5" class="ltx_Math" alttext="|L_{B}(y;x,S)-L_{B}(y;x,S^{\star})|\leq\min\{\tilde{C}\eta,B\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msub><mi>L</mi><mi>B</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>L</mi><mi>B</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>x</mi><mo>,</mo><msup><mi>S</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mover accent="true"><mi>C</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mo>,</mo><mi>B</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">|L_{B}(y;x,S)-L_{B}(y;x,S^{\star})|\leq\min\{\tilde{C}\eta,B\}</annotation></semantics></math>.
Averaging and applying Lipschitz decision rule gives the result.
∎</span></p>
</div>
</div>
<div id="S4.Thmtheorem2" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 4.2</span></span><span id="S4.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(<math id="S4.Thmtheorem2.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>-informativeness lower bound)<span id="S4.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem2.p1" class="ltx_para">
<p id="S4.Thmtheorem2.p1.1" class="ltx_p"><span id="S4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Suppose evidence <math id="S4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> has mutual information <math id="S4.Thmtheorem2.p1.m2" class="ltx_Math" alttext="I(Y;E)\leq\kappa" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Y</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>κ</mi></mrow><annotation encoding="application/x-tex">I(Y;E)\leq\kappa</annotation></semantics></math>. Then any lift-based policy must abstain on at least <math id="S4.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\Omega(\sqrt{\kappa})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>κ</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\kappa})</annotation></semantics></math> of inputs.</span></p>
</div>
</div>
<div id="S4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p"><span id="S4.p2.1.1" class="ltx_text">Le Cam’s method: construct two close hypotheses indistinguishable under low MI. The testing risk implies abstention is necessary to meet target error.
∎</span></p>
</div>
</div>
<section id="S4.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Intuition.</h4>

<div id="S4.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S4.SS0.SSS0.Px1.p1.1" class="ltx_p"><math id="S4.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>-robustness: quality drift in skeletons hurts additively, not catastrophically. <math id="S4.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>-bound: with sparse evidence, abstention is information-theoretically unavoidable.</p>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Failure Modes: Heavy-Tail Misspecification</h2>

<div id="S5.Thmtheorem1" class="ltx_theorem ltx_theorem_prop">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem1.2" class="ltx_text ltx_font_bold">Proposition 5.1</span></span><span id="S5.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Graceful degradation)<span id="S5.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem1.p1" class="ltx_para">
<p id="S5.Thmtheorem1.p1.1" class="ltx_p"><span id="S5.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">If sub-gamma parameters inflate by factor <math id="S5.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\alpha&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;1</annotation></semantics></math> (heavier tails), then the bound in <a href="#S3.Thmtheorem2" title="Theorem 3.2 (PAC-Bayes sub-gamma bound). ‣ 3 Main Theory: PAC-Bayes Sub-Gamma Certificates ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.2</span></a> still holds by replacing <math id="S5.Thmtheorem1.p1.m2" class="ltx_Math" alttext="(v,c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v,c)</annotation></semantics></math> with <math id="S5.Thmtheorem1.p1.m3" class="ltx_Math" alttext="(\alpha v,\alpha c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>,</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\alpha v,\alpha c)</annotation></semantics></math>. Abstention increases by <math id="S5.Thmtheorem1.p1.m4" class="ltx_Math" alttext="O(\alpha)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(\alpha)</annotation></semantics></math> to keep <math id="S5.Thmtheorem1.p1.m5" class="ltx_Math" alttext="R\leq h^{\star}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>≤</mo><msup><mi>h</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">R\leq h^{\star}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p"><span id="S5.p1.1.1" class="ltx_text">Apply the same PAC-Bayes derivation with the inflated MGF constants; threshold <math id="S5.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> must increase proportionally, leading to higher abstention.
∎</span></p>
</div>
</div>
<section id="S5.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Practical Takeaways.</h4>

<div id="S5.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S5.SS0.SSS0.Px1.p1.1" class="ltx_p"><span id="S5.SS0.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_bold">If tail fits fail:</span> Increase <math id="S5.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> conservatively (proportional to estimated <math id="S5.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>); expect higher abstention but preserved risk control.</p>
</div>
</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>Variational Skeleton Design (VSD)</h2>

<div id="S6.p1" class="ltx_para ltx_noindent">
<p id="S6.p1.1" class="ltx_p">We propose a principled construction balancing fidelity and certifiability:</p>
<table id="S6.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S6.Ex4.m1" class="ltx_math_unparsed" alttext="\min_{S\in\Delta^{|\mathcal{Y}|}}\;\;\mathrm{KL}\big(P(\cdot|x)\|S\big)-\lambda\,\mathbb{E}_{y\sim P(\cdot|x)}[L_{B}(y;x,S)]," display="block" intent=":literal"><semantics><mrow><munder><mi>min</mi><mrow><mi>S</mi><mo>∈</mo><msup><mi mathvariant="normal">Δ</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></msup></mrow></munder><mi>KL</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>P</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>S</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>−</mo><mi>λ</mi><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>P</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msub><mi>L</mi><mi>B</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>;</mo><mi>x</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\min_{S\in\Delta^{|\mathcal{Y}|}}\;\;\mathrm{KL}\big(P(\cdot|x)\|S\big)-\lambda\,\mathbb{E}_{y\sim P(\cdot|x)}[L_{B}(y;x,S)],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S6.p1.2" class="ltx_p">with tradeoff <math id="S6.p1.m1" class="ltx_Math" alttext="\lambda\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\geq 0</annotation></semantics></math>.</p>
</div>
<div id="S6.Thmtheorem1" class="ltx_theorem ltx_theorem_thm">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 6.1</span></span><span id="S6.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Existence and convexity)<span id="S6.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem1.p1" class="ltx_para">
<p id="S6.Thmtheorem1.p1.1" class="ltx_p"><span id="S6.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">If <math id="S6.Thmtheorem1.p1.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> lies in a convex exponential-family surrogate, the objective is convex and admits a minimizer. For small <math id="S6.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, <math id="S6.Thmtheorem1.p1.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is close to <math id="S6.Thmtheorem1.p1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>; as <math id="S6.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> grows, <math id="S6.Thmtheorem1.p1.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> concentrates on low-entropy modes improving lift separability.</span></p>
</div>
</div>
<div id="S6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.p2" class="ltx_para">
<p id="S6.p2.1" class="ltx_p"><span id="S6.p2.1.1" class="ltx_text">KL is convex in <math id="S6.p2.m1" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>; the expectation term is linear in <math id="S6.p2.m2" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>; the feasible set is a simplex; continuity implies existence.
∎</span></p>
</div>
</div>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Variational Skeleton Design (VSD)</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
            
          empirical logits of <math id="alg2.l1.m1" class="ltx_math_unparsed" alttext="P(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(\cdot|x)</annotation></semantics></math>; clip <math id="alg2.l1.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>; tradeoff <math id="alg2.l1.m3" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>; steps <math id="alg2.l1.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            
          Initialize <math id="alg2.l2.m1" class="ltx_Math" alttext="S^{(0)}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">S^{(0)}</annotation></semantics></math> as temperature-smoothed <math id="alg2.l2.m2" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            
          <span id="alg2.l3.2" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l3.m1" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math> to <math id="alg2.l3.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> <span id="alg2.l3.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            
            Compute gradient <math id="alg2.l4.m1" class="ltx_math_unparsed" alttext="g_{t}\leftarrow\nabla_{S}\mathrm{KL}(P\|S^{(t-1)})-\lambda\nabla_{S}\mathbb{E}[L_{B}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>t</mi></msub><mo stretchy="false">←</mo><msub><mo rspace="0.167em">∇</mo><mi>S</mi></msub><mi>KL</mi><mrow><mo stretchy="false">(</mo><mi>P</mi><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>λ</mi><msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>S</mi></msub><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>L</mi><mi>B</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">g_{t}\leftarrow\nabla_{S}\mathrm{KL}(P\|S^{(t-1)})-\lambda\nabla_{S}\mathbb{E}[L_{B}]</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
            
            <math id="alg2.l5.m1" class="ltx_Math" alttext="S^{(t)}\leftarrow\Pi_{\Delta}\big(S^{(t-1)}-\eta_{t}g_{t}\big)" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><msub><mi mathvariant="normal">Π</mi><mi mathvariant="normal">Δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><mrow><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>t</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S^{(t)}\leftarrow\Pi_{\Delta}\big(S^{(t-1)}-\eta_{t}g_{t}\big)</annotation></semantics></math> <span id="alg2.l5.2" class="ltx_text" style="float:right;"><math id="alg2.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Projected gradient on simplex
</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            
          <span id="alg2.l6.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l6.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            
          <span id="alg2.l7.2" class="ltx_text ltx_font_bold">return</span> <math id="alg2.l7.m1" class="ltx_Math" alttext="S^{(T)}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">S^{(T)}</annotation></semantics></math>

</div>
</div>
</figure>
<section id="S6.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Intuition.</h4>

<div id="S6.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S6.SS0.SSS0.Px1.p1.1" class="ltx_p">VSD says: keep the skeleton close to the model’s prior, but <em id="S6.SS0.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">compress</em> away uncertain mass so lifts separate correct from incorrect outcomes.</p>
</div>
</section>
</section>
<section id="S7" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">7 </span>Complexity, Implementations, and Engineering</h2>

<div id="S7.p1" class="ltx_para ltx_noindent">
<p id="S7.p1.1" class="ltx_p"><span id="S7.p1.1.1" class="ltx_text ltx_font_bold">Complexity.</span> Naive lift estimation is <math id="S7.p1.m1" class="ltx_Math" alttext="O(nB)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(nB)</annotation></semantics></math>. With batched logits + caching, wall-clock overhead is manageable. As shown in <a href="#S8.F9" title="In 8.5 Main Results and Ablation Studies ‣ 8 Experiments ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">9</span></a>, the primary driver of overhead is model size. The runtime scales roughly linearly with the number of model parameters, but our batching and caching optimizations ensure the relative overhead remains consistently below 20%, even for very large models like GPT-4. This makes our method practical for a wide range of model sizes. Approximate quantile sketches can further reduce this to <math id="S7.p1.m2" class="ltx_Math" alttext="O(n\log B)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>B</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(n\log B)</annotation></semantics></math>.</p>
</div>
<section id="S7.SS0.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Practical Takeaways.</h4>

<div id="S7.SS0.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="S7.SS0.SSS0.Px1.p1.1" class="ltx_p"><span id="S7.SS0.SSS0.Px1.p1.1.1" class="ltx_text ltx_font_bold">Default settings</span>: batch size that saturates GPU, temperature 0.5 for VSD initialization, <math id="S7.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\lambda\in[0.1,1.0]" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0.1</mn><mo>,</mo><mn>1.0</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda\in[0.1,1.0]</annotation></semantics></math>, clip <math id="S7.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="B\in\{8,12,16\}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>8</mn><mo>,</mo><mn>12</mn><mo>,</mo><mn>16</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">B\in\{8,12,16\}</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S8" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">8 </span>Experiments</h2>

<section id="S8.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">8.1 </span>A Walkthrough Example</h3>

<div id="S8.SS1.p1" class="ltx_para ltx_noindent">
<p id="S8.SS1.p1.1" class="ltx_p">To make our method concrete, consider a question from the BioASQ dataset: “What is the role of BRCA1 in DNA repair?” Suppose our target risk is <math id="S8.SS1.p1.m1" class="ltx_Math" alttext="h^{\star}=0.05" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mo>⋆</mo></msup><mo>=</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">h^{\star}=0.05</annotation></semantics></math> and our calibrated certificate requires a threshold <math id="S8.SS1.p1.m2" class="ltx_Math" alttext="\tau=4.5" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>=</mo><mn>4.5</mn></mrow><annotation encoding="application/x-tex">\tau=4.5</annotation></semantics></math>. The model generates the correct answer: “BRCA1 is crucial for repairing double-strand breaks…” We compute the clipped lift <math id="S8.SS1.p1.m3" class="ltx_Math" alttext="L_{B}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>B</mi></msub><annotation encoding="application/x-tex">L_{B}</annotation></semantics></math> for each token. Informative tokens like “BRCA1,” “repairing,” and “double-strand” receive high lifts (e.g., ¿1.5), while generic tokens like “is,” “for,” and “the” receive low or zero lifts. The information budget <math id="S8.SS1.p1.m4" class="ltx_Math" alttext="\hat{\Delta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\Delta}</annotation></semantics></math> accumulates over the sequence. If the final <math id="S8.SS1.p1.m5" class="ltx_Math" alttext="\hat{\Delta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\Delta}</annotation></semantics></math> is 5.2, which is greater than <math id="S8.SS1.p1.m6" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, the answer is certified and returned.</p>
</div>
<div id="S8.SS1.p2" class="ltx_para ltx_noindent">
<p id="S8.SS1.p2.1" class="ltx_p">Conversely, consider an incorrect but plausible-sounding answer: “BRCA1 causes cancer by activating oncogenes…” Here, key tokens like “causes” and “activating oncogenes” might have high probability under the full model but are poorly explained by a general biological skeleton, leading to low or negative lifts. The cumulative budget <math id="S8.SS1.p2.m1" class="ltx_Math" alttext="\hat{\Delta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\Delta}</annotation></semantics></math> might only reach 2.8. Since this is below <math id="S8.SS1.p2.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>, the system abstains, correctly avoiding a dangerous hallucination.</p>
</div>
</section>
<section id="S8.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">8.2 </span>Experimental Setup</h3>

<div id="S8.SS2.p1" class="ltx_para ltx_noindent">
<p id="S8.SS2.p1.1" class="ltx_p">Our experimental setup spans six diverse question-answering datasets: NQ-Open <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib10" title="" class="ltx_ref">Kwiatkowski et al., 2019</a>)</cite>, HotpotQA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib21" title="" class="ltx_ref">Yang et al., 2018</a>)</cite>, TruthfulQA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib12" title="" class="ltx_ref">Lin et al., 2022</a>)</cite>, SciQA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Lu et al., 2022</a>)</cite>, MultiRC <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib8" title="" class="ltx_ref">Khashabi et al., 2018</a>)</cite>, and BioASQ <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Tsatsaronis et al., 2015</a>)</cite>, with detailed statistics in <a href="#S8.T1" title="In 8.2 Experimental Setup ‣ 8 Experiments ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">1</span></a>. We evaluate three model families: GPT-4 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib16" title="" class="ltx_ref">OpenAI, 2023</a>)</cite>, LLaMA-2 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib18" title="" class="ltx_ref">Touvron et al., 2023</a>)</cite>, and Mistral <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Jiang et al., 2023</a>)</cite>.</p>
</div>
<div id="S8.SS2.p2" class="ltx_para ltx_noindent">
<p id="S8.SS2.p2.1" class="ltx_p">We compare against a comprehensive suite of baselines whose hyperparameters were carefully tuned for a fair comparison (see App. <a href="#A2.SS1" title="B.1 Baseline Tuning ‣ Appendix B Notation and Hyperparameters ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>): (1) entropy halting, (2) conformal abstention, (3) SelfCheckGPT, (4) semantic uncertainty detectors, (5) tuned calibration methods like temperature scaling and Dirichlet calibration <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">Guo et al., 2017</a>)</cite>, (6) large ensemble methods (5–7 models), and (7) margin-based confidence. It is worth noting that our method achieves its results with a single model, offering significant computational advantages over resource-intensive ensembles. Our primary metrics are risk–coverage curves, abstention at a fixed risk, and runtime overhead.</p>
</div>
<figure id="S8.T1" class="ltx_table">
<table id="S8.T1.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S8.T1.2.1" class="ltx_tr">
<th id="S8.T1.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">Dataset</th>
<th id="S8.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Samples</th>
<th id="S8.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Avg Length</th>
<th id="S8.T1.2.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt">Domain</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S8.T1.2.2" class="ltx_tr">
<td id="S8.T1.2.2.1" class="ltx_td ltx_align_left ltx_border_t">NQ-Open</td>
<td id="S8.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t">3,610</td>
<td id="S8.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t">15.2</td>
<td id="S8.T1.2.2.4" class="ltx_td ltx_align_left ltx_border_t">Open-domain QA</td></tr>
<tr id="S8.T1.2.3" class="ltx_tr">
<td id="S8.T1.2.3.1" class="ltx_td ltx_align_left">HotpotQA</td>
<td id="S8.T1.2.3.2" class="ltx_td ltx_align_center">7,405</td>
<td id="S8.T1.2.3.3" class="ltx_td ltx_align_center">24.8</td>
<td id="S8.T1.2.3.4" class="ltx_td ltx_align_left">Multi-hop reasoning</td></tr>
<tr id="S8.T1.2.4" class="ltx_tr">
<td id="S8.T1.2.4.1" class="ltx_td ltx_align_left">TruthfulQA</td>
<td id="S8.T1.2.4.2" class="ltx_td ltx_align_center">817</td>
<td id="S8.T1.2.4.3" class="ltx_td ltx_align_center">19.6</td>
<td id="S8.T1.2.4.4" class="ltx_td ltx_align_left">Truthfulness</td></tr>
<tr id="S8.T1.2.5" class="ltx_tr">
<td id="S8.T1.2.5.1" class="ltx_td ltx_align_left">SciQA</td>
<td id="S8.T1.2.5.2" class="ltx_td ltx_align_center">12,726</td>
<td id="S8.T1.2.5.3" class="ltx_td ltx_align_center">8.9</td>
<td id="S8.T1.2.5.4" class="ltx_td ltx_align_left">Science QA</td></tr>
<tr id="S8.T1.2.6" class="ltx_tr">
<td id="S8.T1.2.6.1" class="ltx_td ltx_align_left">MultiRC</td>
<td id="S8.T1.2.6.2" class="ltx_td ltx_align_center">5,825</td>
<td id="S8.T1.2.6.3" class="ltx_td ltx_align_center">31.4</td>
<td id="S8.T1.2.6.4" class="ltx_td ltx_align_left">Reading comprehension</td></tr>
<tr id="S8.T1.2.7" class="ltx_tr">
<td id="S8.T1.2.7.1" class="ltx_td ltx_align_left ltx_border_bb">BioASQ</td>
<td id="S8.T1.2.7.2" class="ltx_td ltx_align_center ltx_border_bb">2,747</td>
<td id="S8.T1.2.7.3" class="ltx_td ltx_align_center ltx_border_bb">11.7</td>
<td id="S8.T1.2.7.4" class="ltx_td ltx_align_left ltx_border_bb">Biomedical QA</td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 1: </span>Dataset statistics and domains.</figcaption>
</figure>
</section>
<section id="S8.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">8.3 </span>Real-World Failure Case for Sub-Exponential Bounds</h3>

<div id="S8.SS3.p1" class="ltx_para ltx_noindent">
<p id="S8.SS3.p1.1" class="ltx_p">To underscore the necessity of our sub-gamma approach, we analyze a real-world failure case. We collected the empirical distribution of clipped lifts from the TruthfulQA dataset, which exhibits significant heavy-tailedness. We then constructed a 95% confidence bound for the mean lift using both a standard Bernstein inequality (which assumes sub-exponential tails) and our sub-gamma bound. As shown in <a href="#S8.F4" title="In 8.3 Real-World Failure Case for Sub-Exponential Bounds ‣ 8 Experiments ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">4</span></a>, the Bernstein bound is far too optimistic; it is visibly violated by the empirical distribution’s heavy tail, leading to an invalid certificate that would underestimate risk. In contrast, our sub-gamma bound correctly accounts for the tail risk, providing a wider but statistically valid interval. This provides concrete evidence that for real-world LLM outputs, sub-gamma analysis is not a theoretical refinement but a practical necessity for reliable certification.</p>
</div>
<figure id="S8.F4" class="ltx_figure"><object type="image/svg+xml" data="2509.12527v1/real_bernstein_failure.svg" id="S8.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:384/286;" width="384" height="286"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4: </span>A real-world failure case for Bernstein bounds on the heavy-tailed lift distribution from TruthfulQA. The Bernstein bound is too tight and is violated by the empirical tail, while our sub-gamma bound remains valid.</figcaption>
</figure>
</section>
<section id="S8.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">8.4 </span>Assumption Audits</h3>

<div id="S8.SS4.p1" class="ltx_para ltx_noindent">
<p id="S8.SS4.p1.1" class="ltx_p">We perform Kolmogorov-Smirnov and Anderson-Darling tests for sub-gamma fits across all dataset-model combinations. Results confirm sub-gamma assumptions in 85% of cases (p ¿ 0.05). For the remaining 15%, we apply <a href="#S5.Thmtheorem1" title="Proposition 5.1 (Graceful degradation). ‣ 5 Failure Modes: Heavy-Tail Misspecification ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">5.1</span></a> adjustments with inflated parameters <math id="S8.SS4.p1.m1" class="ltx_Math" alttext="(\alpha v,\alpha c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>,</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\alpha v,\alpha c)</annotation></semantics></math> where <math id="S8.SS4.p1.m2" class="ltx_Math" alttext="\alpha\in[1.5,2.0]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1.5</mn><mo>,</mo><mn>2.0</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in[1.5,2.0]</annotation></semantics></math>, leading to controlled increases in abstention while maintaining risk guarantees.</p>
</div>
<figure id="S8.F5" class="ltx_figure"><object type="image/svg+xml" data="2509.12527v1/assumption_audits.svg" id="S8.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/340;" width="548" height="340"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 5: </span>Assumption validation and robustness analysis. <span id="S8.F5.8" class="ltx_text ltx_font_bold">(A)</span> Q-Q plot confirms sub-gamma fit quality (R² = 0.89). <span id="S8.F5.9" class="ltx_text ltx_font_bold">(B)</span> KS tests pass for 85% of datasets. <span id="S8.F5.10" class="ltx_text ltx_font_bold">(C)</span> Graceful degradation under misspecification follows theoretical O(<math id="S8.F5.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>) scaling. <span id="S8.F5.11" class="ltx_text ltx_font_bold">(D)</span> <math id="S8.F5.m6" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>-robustness shows linear degradation as predicted by <a href="#S4.Thmtheorem1" title="Theorem 4.1 (𝜂-robustness). ‣ 4 Robustness: Skeleton Sensitivity and Informativeness ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.1</span></a>. <span id="S8.F5.12" class="ltx_text ltx_font_bold">(E)</span> <math id="S8.F5.m7" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>-informativeness bound validated—all empirical points lie above theoretical <math id="S8.F5.m8" class="ltx_Math" alttext="\Omega(\sqrt{\kappa})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>κ</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{\kappa})</annotation></semantics></math>. <span id="S8.F5.13" class="ltx_text ltx_font_bold">(F)</span> VSD converges within 25 iterations.</figcaption>
</figure>
</section>
<section id="S8.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">8.5 </span>Main Results and Ablation Studies</h3>

<div id="S8.SS5.p1" class="ltx_para ltx_noindent">
<p id="S8.SS5.p1.1" class="ltx_p">Our main results in <a href="#S8.T2" title="In 8.5 Main Results and Ablation Studies ‣ 8 Experiments ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">2</span></a> show that VSD-based certificates consistently outperform all baselines, including tuned calibration and large ensemble methods, achieving higher coverage at the same 2% risk target across all datasets. <a href="#S8.T4" title="In 8.5 Main Results and Ablation Studies ‣ 8 Experiments ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">4</span></a> further highlights that our single-model approach is far more computationally efficient than ensembles.</p>
</div>
<div id="S8.SS5.p2" class="ltx_para ltx_noindent">
<p id="S8.SS5.p2.1" class="ltx_p">We conducted extensive ablation studies to analyze our method’s key components and sensitivities. We examined the VSD hyperparameter <math id="S8.SS5.p2.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, finding that coverage peaks around <math id="S8.SS5.p2.m2" class="ltx_Math" alttext="\lambda=0.5" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\lambda=0.5</annotation></semantics></math> (<a href="#S8.F6" title="In 8.5 Main Results and Ablation Studies ‣ 8 Experiments ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">6</span></a>E), and that performance saturates for the clipping parameter <math id="S8.SS5.p2.m3" class="ltx_Math" alttext="B\geq 12" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>≥</mo><mn>12</mn></mrow><annotation encoding="application/x-tex">B\geq 12</annotation></semantics></math>. To stress-test skeleton quality, we evaluated against adversarial skeletons of increasing strength; as shown in <a href="#S8.F8" title="In 8.5 Main Results and Ablation Studies ‣ 8 Experiments ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">8</span></a>, performance degrades gracefully, with risk increasing by 5-8% under a medium attack and 10-15% under a strong attack, confirming that a meaningful skeleton is crucial. We also explored a simulated black-box setting, observing only an 8-10% drop in coverage. Further experiments showed that skeletons can be transferred across domains with a minor 5-7% performance drop. Finally, we analyzed the impact of sample size, with <a href="#S8.F10" title="In 8.5 Main Results and Ablation Studies ‣ 8 Experiments ‣ Selective Risk Certification for LLM Outputs via Information-Lift Statistics:PAC-Bayes, Robustness, and Skeleton Design" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">10</span></a> showing that both risk and coverage improve as expected with more samples, confirming the estimator’s stability.</p>
</div>
<figure id="S8.F6" class="ltx_figure"><object type="image/svg+xml" data="2509.12527v1/main_results.svg" id="S8.F6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/434;" width="548" height="434"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 6: </span>Main experimental results. <span id="S8.F6.8" class="ltx_text ltx_font_bold">(A)</span> Risk-coverage performance across all datasets and models shows VSD certificates (red) achieve superior coverage at target risk levels. <span id="S8.F6.9" class="ltx_text ltx_font_bold">(B)</span> Coverage improvements of 12–15% over entropy baseline. <span id="S8.F6.10" class="ltx_text ltx_font_bold">(C)</span> Runtime overhead remains below 20% with optimizations. <span id="S8.F6.11" class="ltx_text ltx_font_bold">(D)</span> Sub-gamma parameters <math id="S8.F6.m3" class="ltx_Math" alttext="(v,c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>v</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v,c)</annotation></semantics></math> vary by dataset difficulty. <span id="S8.F6.12" class="ltx_text ltx_font_bold">(E)</span> VSD parameter <math id="S8.F6.m4" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> sensitivity peaks around 0.5. <span id="S8.F6.13" class="ltx_text ltx_font_bold">(F)</span> Model quality correlates with certificate performance.</figcaption>
</figure>
