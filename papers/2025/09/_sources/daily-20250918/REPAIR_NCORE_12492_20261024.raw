<span id="Sx1.T3.1.1.1.1" class="ltx_inline-block ltx_align_top" style="width:105.3pt;">
<span id="Sx1.T3.1.1.1.1.1" class="ltx_p"><span id="Sx1.T3.1.1.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Descriptive Captions (Nocaps)</span></span>
</span></th>
