<td id="S5.T1.2.1.4" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="S5.T1.2.1.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Smoking Status</span></td>
<td id="S5.T1.2.1.5" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="S5.T1.2.1.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">ClinSTS</span></td>
