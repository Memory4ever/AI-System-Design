<td id="S7.T9.3.1.1.4.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="S7.T9.m7" class="ltx_Math" alttext="23.8" display="inline" intent=":literal"><semantics><mn>23.8</mn><annotation encoding="application/x-tex">23.8</annotation></semantics></math></td>
<td id="S7.T9.3.1.1.4.3" class="ltx_td ltx_align_center ltx_border_tt"><math id="S7.T9.m8" class="ltx_Math" alttext="\underline{13.0}" display="inline" intent=":literal"><semantics><munder accentunder="true"><mn>13.0</mn><mo stretchy="true">¯</mo></munder><annotation encoding="application/x-tex">\underline{13.0}</annotation></semantics></math></td>
