<td id="S8.T10.3.1.1.16.3" class="ltx_td ltx_align_center ltx_border_bbbb"><math id="S8.T10.m28" class="ltx_Math" alttext="34.2_{(-56\%)}" display="inline" intent=":literal"><semantics><msub><mn>34.2</mn><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mn>56</mn><mo>%</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">34.2_{(-56\%)}</annotation></semantics></math></td></tr>
