<th id="S11.T14.3.1.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding-left:2.0pt;padding-right:2.0pt;">Acc@1 <math id="S11.T14.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S11.T14.3.1.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding-left:2.0pt;padding-right:2.0pt;">Acc@5 <math id="S11.T14.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S11.T14.3.1.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">cost (GFLOPS)</th>
<th id="S11.T14.3.1.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding-left:2.0pt;padding-right:2.0pt;">Acc@1 <math id="S11.T14.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S11.T14.3.1.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding-left:2.0pt;padding-right:2.0pt;">Acc@5 <math id="S11.T14.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S11.T14.3.1.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding-left:2.0pt;padding-right:2.0pt;">cost (GFLOPS)</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S11.T14.3.1.1.3" class="ltx_tr">
<th id="S11.T14.3.1.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;">1</th>
<td id="S11.T14.3.1.1.3.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S11.T14.m5" class="ltx_Math" alttext="44.5" display="inline" intent=":literal"><semantics><mn>44.5</mn><annotation encoding="application/x-tex">44.5</annotation></semantics></math></td>
<td id="S11.T14.3.1.1.3.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S11.T14.m6" class="ltx_Math" alttext="72.3" display="inline" intent=":literal"><semantics><mn>72.3</mn><annotation encoding="application/x-tex">72.3</annotation></semantics></math></td>
<td id="S11.T14.3.1.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S11.T14.m7" class="ltx_Math" alttext="4.4" display="inline" intent=":literal"><semantics><mn>4.4</mn><annotation encoding="application/x-tex">4.4</annotation></semantics></math></td>
<td id="S11.T14.3.1.1.3.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S11.T14.m8" class="ltx_Math" alttext="44.5" display="inline" intent=":literal"><semantics><mn>44.5</mn><annotation encoding="application/x-tex">44.5</annotation></semantics></math></td>
<td id="S11.T14.3.1.1.3.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S11.T14.m9" class="ltx_Math" alttext="72.3" display="inline" intent=":literal"><semantics><mn>72.3</mn><annotation encoding="application/x-tex">72.3</annotation></semantics></math></td>
<td id="S11.T14.3.1.1.3.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S11.T14.m10" class="ltx_Math" alttext="4.4" display="inline" intent=":literal"><semantics><mn>4.4</mn><annotation encoding="application/x-tex">4.4</annotation></semantics></math></td></tr>
<tr id="S11.T14.3.1.1.4" class="ltx_tr">
