<td id="S6.T8.3.1.1.18.8" class="ltx_td ltx_align_center ltx_border_bbbb" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S6.T8.m105" class="ltx_Math" alttext="24.4" display="inline" intent=":literal"><semantics><mn>24.4</mn><annotation encoding="application/x-tex">24.4</annotation></semantics></math></td>
<td id="S6.T8.3.1.1.18.9" class="ltx_td ltx_align_center ltx_border_bbbb" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S6.T8.m106" class="ltx_Math" alttext="16.6" display="inline" intent=":literal"><semantics><mn>16.6</mn><annotation encoding="application/x-tex">16.6</annotation></semantics></math></td>
<td id="S6.T8.3.1.1.18.10" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S6.T8.m107" class="ltx_Math" alttext="9.3" display="inline" intent=":literal"><semantics><mn>9.3</mn><annotation encoding="application/x-tex">9.3</annotation></semantics></math></td>
