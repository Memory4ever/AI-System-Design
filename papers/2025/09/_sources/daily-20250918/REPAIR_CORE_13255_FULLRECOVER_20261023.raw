<td id="S6.T8.3.1.1.18.1" class="ltx_td ltx_align_left ltx_border_bbbb ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">Watershed (ours)</td>
<td id="S6.T8.3.1.1.18.2" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">✗</td>
<td id="S6.T8.3.1.1.18.3" class="ltx_td ltx_align_center ltx_border_bbbb" style="padding-left:2.0pt;padding-right:2.0pt;">ResidualViT</td>
<td id="S6.T8.3.1.1.18.4" class="ltx_td ltx_align_center ltx_border_bbbb ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">ViT-L/14</td>
