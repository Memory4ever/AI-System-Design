<th id="S4.T4.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">CLVS</th>
<td id="S4.T4.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T4.1.2.2.1" class="ltx_text ltx_font_bold">75.0</span></td>
<td id="S4.T4.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T4.1.2.3.1" class="ltx_text ltx_font_bold">93.3</span></td>
<td id="S4.T4.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T4.1.2.4.1" class="ltx_text ltx_font_bold">67.1</span></td>
<td id="S4.T4.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T4.1.2.5.1" class="ltx_text ltx_font_bold">78.1</span></td></tr>
<tr id="S4.T4.1.3" class="ltx_tr">
<th id="S4.T4.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><em id="S4.T4.1.3.1.1" class="ltx_emph ltx_font_italic">w/o</em> Early Termination</th>
<td id="S4.T4.1.3.2" class="ltx_td ltx_align_center">74.9</td>
<td id="S4.T4.1.3.3" class="ltx_td ltx_align_center"><span id="S4.T4.1.3.3.1" class="ltx_text ltx_font_bold">93.3</span></td>
<td id="S4.T4.1.3.4" class="ltx_td ltx_align_center">67.0</td>
<td id="S4.T4.1.3.5" class="ltx_td ltx_align_center">78.0</td></tr>
<tr id="S4.T4.1.4" class="ltx_tr">
<th id="S4.T4.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r"><em id="S4.T4.1.4.1.1" class="ltx_emph ltx_font_italic">w/o</em> Unified Position</th>
<td id="S4.T4.1.4.2" class="ltx_td ltx_align_center ltx_border_bb">74.8</td>
