<th id="S4.T4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.1.1.2.1" class="ltx_text ltx_font_bold">Acc.</span></th>
<th id="S4.T4.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.1.1.3.1" class="ltx_text ltx_font_bold">Prec.</span></th>
<th id="S4.T4.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.1.1.4.1" class="ltx_text ltx_font_bold">Rec.</span></th>
<th id="S4.T4.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.1.1.5.1" class="ltx_text ltx_font_bold">F1</span></th></tr>
</thead>
<tbody class="ltx_tbody">
