<td id="Sx5.T1.1.3.3" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">19,838</td>
<td id="Sx5.T1.1.3.4" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">111,277</td>
<td id="Sx5.T1.1.3.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">409</td></tr>
