<td id="Sx5.T5.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;">Test Time</td>
<td id="Sx5.T5.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;">Parameter Size</td></tr>
<tr id="Sx5.T5.1.2" class="ltx_tr">
