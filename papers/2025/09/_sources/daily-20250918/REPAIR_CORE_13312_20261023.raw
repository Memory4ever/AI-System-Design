</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.47)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:17.49em;--ltx-fo-depth:0.19em;font-size:10pt;" height="244.76" overflow="visible" transform="matrix(1 0 0 -1 0 242.07)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
