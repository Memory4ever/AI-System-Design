<td id="S4.T2.2.1.7.4" class="ltx_td ltx_align_right" style="--ltx-bg-color:#92D04F;"><span id="S4.T2.2.1.7.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#92D04F;">7.60</span></td>
