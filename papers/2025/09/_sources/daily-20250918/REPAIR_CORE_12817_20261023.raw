<td id="Sx5.T1.1.1.32.6" class="ltx_td ltx_align_left ltx_border_bb"><span id="Sx5.T1.1.1.32.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#D9D9D9;">84.7<span id="Sx5.T1.1.1.32.6.1.1" class="ltx_text ltx_font_medium"> (</span>+0.2<span id="Sx5.T1.1.1.32.6.1.2" class="ltx_text ltx_font_medium">)</span></span></td></tr>
