<td id="Sx5.T1.1.1.32.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="Sx5.T1.m31" class="ltx_Math" style="--ltx-bg-color:#D9D9D9;" alttext="384^{2}" display="inline" intent=":literal"><semantics><msup><mn style="--ltx-bg-color:#D9D9D9;" mathbackground="#D9D9D9">384</mn><mn style="--ltx-bg-color:#D9D9D9;" mathbackground="#D9D9D9">2</mn></msup><annotation encoding="application/x-tex">384^{2}</annotation></semantics></math></td>
<td id="Sx5.T1.1.1.32.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx5.T1.1.1.32.3.1" class="ltx_text" style="--ltx-bg-color:#D9D9D9;">105M</span></td>
