<td id="S4.T1.4.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S4.T1.4.2.2.1" class="ltx_text" style="font-size:80%;">0</span></td>
<td id="S4.T1.4.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S4.T1.4.2.3.1" class="ltx_text" style="font-size:80%;">-66</span></td>
<td id="S4.T1.4.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S4.T1.4.2.4.1" class="ltx_text" style="font-size:80%;">66</span></td>
<td id="S4.T1.4.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S4.T1.4.2.5.1" class="ltx_text" style="font-size:80%;">180</span></td>
<td id="S4.T1.4.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S4.T1.4.2.6.1" class="ltx_text" style="font-size:80%;">-152</span></td>
<td id="S4.T1.4.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S4.T1.4.2.7.1" class="ltx_text" style="font-size:80%;">152</span></td></tr>
