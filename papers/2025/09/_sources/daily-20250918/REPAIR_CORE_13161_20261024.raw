<span id="S4.T1.6.3.5.1.1" class="ltx_p">35.2</span>
</span></td>
<td id="S4.T1.6.3.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="S4.T1.6.3.6.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S4.T1.6.3.6.1.1" class="ltx_p">2.7</span>
</span></td>
