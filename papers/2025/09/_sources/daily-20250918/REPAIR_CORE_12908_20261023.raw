<td id="S3.T1.2.21.7" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FF8000;"><span id="S3.T1.2.21.7.1" class="ltx_text" style="--ltx-bg-color:#FF8000;">9.5</span></td>
