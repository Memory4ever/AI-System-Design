<td id="S5.T2.2.3.2" class="ltx_td ltx_align_center">47.3</td>
<td id="S5.T2.2.3.3" class="ltx_td ltx_align_center">50.2</td>
<td id="S5.T2.2.3.4" class="ltx_td ltx_align_center">51.5</td>
