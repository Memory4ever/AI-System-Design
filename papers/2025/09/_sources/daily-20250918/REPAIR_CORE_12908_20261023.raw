<td id="A4.T6.2.4.2" class="ltx_td ltx_align_center"><span id="A4.T6.2.4.2.1" class="ltx_text ltx_font_bold">84.0</span></td>
<td id="A4.T6.2.4.3" class="ltx_td ltx_align_center"><span id="A4.T6.2.4.3.1" class="ltx_text ltx_font_bold">10.4</span></td></tr>
