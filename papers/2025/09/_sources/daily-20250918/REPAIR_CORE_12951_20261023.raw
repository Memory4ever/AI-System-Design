<td id="A1.T5.1.2.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.4pt;padding-right:1.4pt;">100+</td>
<td id="A1.T5.1.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.4pt;padding-right:1.4pt;">N (e.g., 8)</td></tr>
<tr id="A1.T5.1.3" class="ltx_tr">
