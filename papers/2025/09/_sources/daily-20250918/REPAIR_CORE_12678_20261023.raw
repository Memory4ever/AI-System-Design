<th id="S4.T1.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S4.T1.m4" class="ltx_Math" alttext="\text{Corr}_{\text{experiment}}^{\text{random}}" display="inline" intent=":literal"><semantics><msubsup><mtext>Corr</mtext><mtext>experiment</mtext><mtext>random</mtext></msubsup><annotation encoding="application/x-tex">\text{Corr}_{\text{experiment}}^{\text{random}}</annotation></semantics></math></th>
<th id="S4.T1.2.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S4.T1.m5" class="ltx_Math" alttext="\text{Var}_{\text{instance}}^{\text{fixed}}" display="inline" intent=":literal"><semantics><msubsup><mtext>Var</mtext><mtext>instance</mtext><mtext>fixed</mtext></msubsup><annotation encoding="application/x-tex">\text{Var}_{\text{instance}}^{\text{fixed}}</annotation></semantics></math></th>
<th id="S4.T1.2.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S4.T1.m6" class="ltx_Math" alttext="\text{Var}_{\text{instance}}^{\text{random}}" display="inline" intent=":literal"><semantics><msubsup><mtext>Var</mtext><mtext>instance</mtext><mtext>random</mtext></msubsup><annotation encoding="application/x-tex">\text{Var}_{\text{instance}}^{\text{random}}</annotation></semantics></math></th></tr>
