<figure id="S0.F1" class="ltx_figure"><img src="2509.13305v1/abs_fig.png" id="S0.F1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:452/156;" width="452" height="156" alt="Refer to caption">
