<td id="p2.1.2.1" class="ltx_td ltx_align_right"><span id="p2.1.2.1.1" class="ltx_text" style="position:relative; bottom:-1.5pt;"><object type="image/svg+xml" data="2509.13305v1/github-logo.svg" id="g4" class="ltx_graphics ltx_img_square" style="aspect-ratio:15/15;" width="15" height="15"></object></span></td>
