<th id="A2.T3.2.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><span id="A2.T3.2.4.1.1" class="ltx_text ltx_font_typewriter">t-rel</span></th>
<td id="A2.T3.2.4.2" class="ltx_td ltx_align_left"><math id="A2.T3.m5" class="ltx_Math" alttext="183.17" display="inline" intent=":literal"><semantics><mn>183.17</mn><annotation encoding="application/x-tex">183.17</annotation></semantics></math></td>
<td id="A2.T3.2.4.3" class="ltx_td ltx_align_left"><math id="A2.T3.m6" class="ltx_Math" alttext="732.70" display="inline" intent=":literal"><semantics><mn>732.70</mn><annotation encoding="application/x-tex">732.70</annotation></semantics></math></td></tr>
<tr id="A2.T3.2.5" class="ltx_tr">
<th id="A2.T3.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb"><span id="A2.T3.2.5.1.1" class="ltx_text ltx_font_typewriter">s-rel</span></th>
<td id="A2.T3.2.5.2" class="ltx_td ltx_align_left ltx_border_bb"><math id="A2.T3.m7" class="ltx_Math" alttext="215.87" display="inline" intent=":literal"><semantics><mn>215.87</mn><annotation encoding="application/x-tex">215.87</annotation></semantics></math></td>
<td id="A2.T3.2.5.3" class="ltx_td ltx_align_left ltx_border_bb"><math id="A2.T3.m8" class="ltx_Math" alttext="863.47" display="inline" intent=":literal"><semantics><mn>863.47</mn><annotation encoding="application/x-tex">863.47</annotation></semantics></math></td></tr>
