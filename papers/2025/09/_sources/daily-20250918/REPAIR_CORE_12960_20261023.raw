<th id="A3.T5.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Vocab size</th>
<td id="A3.T5.2.2.2" class="ltx_td ltx_align_right ltx_border_t"><math id="A3.T5.m1" class="ltx_Math" alttext="50true304" display="inline" intent=":literal"><semantics><mrow><mn>50</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mn>304</mn></mrow><annotation encoding="application/x-tex">50true304</annotation></semantics></math></td></tr>
<tr id="A3.T5.2.3" class="ltx_tr">
<th id="A3.T5.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Batch size</th>
<td id="A3.T5.2.3.2" class="ltx_td ltx_align_right"><math id="A3.T5.m2" class="ltx_Math" alttext="1024" display="inline" intent=":literal"><semantics><mn>1024</mn><annotation encoding="application/x-tex">1024</annotation></semantics></math></td></tr>
<tr id="A3.T5.2.4" class="ltx_tr">
<th id="A3.T5.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Max seq length</th>
<td id="A3.T5.2.4.2" class="ltx_td ltx_align_right ltx_border_bb"><math id="A3.T5.m3" class="ltx_Math" alttext="2048" display="inline" intent=":literal"><semantics><mn>2048</mn><annotation encoding="application/x-tex">2048</annotation></semantics></math></td></tr>
