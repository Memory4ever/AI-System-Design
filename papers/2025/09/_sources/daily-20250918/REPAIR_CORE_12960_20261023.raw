<td id="S4.T1.2.2.3" class="ltx_td ltx_align_left ltx_border_t"><math id="S4.T1.m2" class="ltx_Math" alttext="11true282true784" display="inline" intent=":literal"><semantics><mrow><mn>11</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mn>282</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mn>784</mn></mrow><annotation encoding="application/x-tex">11true282true784</annotation></semantics></math></td></tr>
