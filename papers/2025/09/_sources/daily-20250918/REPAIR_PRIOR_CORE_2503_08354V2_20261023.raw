<span id="S3.T2.3.1.2.4.1.1" class="ltx_p">pFID<math id="S3.T2.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
</span></td>
<td id="S3.T2.3.1.2.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding:1pt 9.0pt;">
<span id="S3.T2.3.1.2.5.1" class="ltx_inline-block ltx_align_top" style="width:42.7pt;">
<span id="S3.T2.3.1.2.5.1.1" class="ltx_p">gFID<math id="S3.T2.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
</span></td>
<td id="S3.T2.3.1.2.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding:1pt 9.0pt;">
<span id="S3.T2.3.1.2.6.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="S3.T2.3.1.2.6.1.1" class="ltx_p">gFID<math id="S3.T2.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> (CFG)</span>
</span></td></tr>
<tr id="S3.T2.3.1.3" class="ltx_tr">
<th id="S3.T2.3.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:1pt 9.0pt;" rowspan="4"><span id="S3.T2.3.1.3.1.1" class="ltx_text">16384</span></th>
