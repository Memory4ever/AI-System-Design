<td id="S1.T1.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t">1253<sub id="S1.T1.3.1.2.4.1" class="ltx_sub"><span id="S1.T1.3.1.2.4.1.1" class="ltx_text ltx_font_italic">-384</span></sub></td>
<td id="S1.T1.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t">928<sub id="S1.T1.3.1.2.5.1" class="ltx_sub"><span id="S1.T1.3.1.2.5.1.1" class="ltx_text ltx_font_italic">-325</span></sub></td>
