<td id="S3.T3.3.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.2.1.1" class="ltx_text" style="font-size:90%;">rFID<math id="S3.T3.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T3.3.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.2.2.1" class="ltx_text" style="font-size:90%;">pFID<math id="S3.T3.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T3.3.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.2.3.1" class="ltx_text" style="font-size:90%;">gFID<math id="S3.T3.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T3.3.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.2.4.1" class="ltx_text" style="font-size:90%;">IS<math id="S3.T3.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S3.T3.3.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.2.5.1" class="ltx_text" style="font-size:90%;">Pre<math id="S3.T3.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
