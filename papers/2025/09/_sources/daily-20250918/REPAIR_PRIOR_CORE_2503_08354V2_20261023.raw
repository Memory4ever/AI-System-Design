<td id="S3.T3.3.18.7" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.18.7.1" class="ltx_text" style="font-size:90%;">256</span></td>
<td id="S3.T3.3.18.8" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.18.8.1" class="ltx_text" style="font-size:90%;">256</span></td></tr>
