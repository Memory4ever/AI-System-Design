<td id="S3.T3.3.1.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_ttt" style="padding-left:9.0pt;padding-right:9.0pt;" rowspan="2"><span id="S3.T3.3.1.2.1" class="ltx_text" style="font-size:90%;">Method</span></td>
<td id="S3.T3.3.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_ttt" style="padding-left:9.0pt;padding-right:9.0pt;" colspan="2"><span id="S3.T3.3.1.3.1" class="ltx_text" style="font-size:90%;">Tokenizer</span></td>
<td id="S3.T3.3.1.4" class="ltx_td ltx_align_center ltx_border_ttt" style="padding-left:9.0pt;padding-right:9.0pt;" colspan="7"><span id="S3.T3.3.1.4.1" class="ltx_text" style="font-size:90%;">Generator</span></td></tr>
