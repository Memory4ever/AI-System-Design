<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S1.F4.3" class="ltx_text" style="font-size:90%;">Figure D</span>: </span><span id="S1.F4.4" class="ltx_text" style="font-size:90%;">Detailed t-SNE visualization of latent space of tokenizer training with and without our proposed latent perturbation.</span></figcaption>
</figure>
<figure id="S1.T2" class="ltx_table">
<div id="S1.T2.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:501.5pt;height:237.2pt;vertical-align:-116.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-44.2pt,20.9pt) scale(0.8,0.8) ;">
<table id="S1.T2.3.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S1.T2.3.1.1" class="ltx_tr">
<th id="S1.T2.3.1.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_tt" style="padding:1pt 8.0pt;" rowspan="2"><span id="S1.T2.3.1.1.1.1" class="ltx_text">Codebook Size</span></th>
