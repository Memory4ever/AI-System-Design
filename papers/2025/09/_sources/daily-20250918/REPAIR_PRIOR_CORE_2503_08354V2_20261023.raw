<td id="S3.T3.3.19.5" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.19.5.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EBEBFF;">298.3</span></td>
<td id="S3.T3.3.19.6" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.19.6.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EBEBFF;">0.80</span></td>
<td id="S3.T3.3.19.7" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.19.7.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EBEBFF;">0.63</span></td>
<td id="S3.T3.3.19.8" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.19.8.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EBEBFF;">261M</span></td>
<td id="S3.T3.3.19.9" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.19.9.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EBEBFF;">256</span></td>
<td id="S3.T3.3.19.10" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;"><span id="S3.T3.3.19.10.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#EBEBFF;">256</span></td></tr>
