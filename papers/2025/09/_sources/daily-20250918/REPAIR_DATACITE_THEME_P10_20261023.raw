":"Shahaf","name":"Shahaf, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Simon-Diaz","name":"Simon-Diaz, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"L. A. C.","familyName":"van Son","name":"van Son, L. A. C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Stoop","name":"Stoop, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S.","familyName":"Toonen","name":"Toonen, S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"F.","familyName":"Tramper","name":"Tramper, F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Valli","name":"Valli, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A.","familyName":"Vigna-Gomez","name":"Vigna-Gomez, A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. S.","familyName":"Vink","name":"Vink, J. S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C.","familyName":"Wang","name":"Wang, C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Willcox","name":"Willcox, R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A high fraction of close massive binary stars at low metallicity"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Solar and Stellar Astrophysics (astro-ph.SR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Astrophysics of Galaxies (astro-ph.GA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T22:24:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:10:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1038/s41550-025-02610-x","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"At high metallicity, a majority of massive stars have at least one close stellar companion. The evolution of such binaries is subject to strong interaction processes, heavily impacting the characteristics of their life-ending supernova and compact remnants. For the low-metallicity environments of high-redshift galaxies constraints on the multiplicity properties of massive stars over the separation range leading to binary interaction are crucially missing. Here we show that the presence of massive stars in close binaries is ubiquitous, even at low metallicity. Using the Very Large Telescope, we obtained multi-epoch radial velocity measurements of a representative sample of 139 massive O-type stars across the Small Magellanic Cloud, which has a metal content of about one fifth of the solar value. We find that 45% of them show radial velocity variations which demonstrate that they are members of close binary systems, and predominantly have orbital periods shorter than one year. Correcting for observational biases indicates that at least 70[+11:-6]% of the O stars in our sample are in close binaries, and that at least 68[+7:-8]% of all O stars interact with a companion star during their lifetime. We found no evidence supporting a statistically significant trend of the multiplicity properties with metallicity. Our results indicate that multiplicity and binary interactions govern the evolution of massive stars and determine their cosmic feedback and explosive fates."},{"descriptionType":"Other","description":"32 pages, 12 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12488","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-17T01:41:33Z","registered":"2025-09-17T01:41:34Z","published":null,"updated":"2025-09-17T01:41:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12482","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12482","identifiers":[{"identifier":"2509.12482","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianshu","familyName":"Huang","name":"Huang, Tianshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akarsh","familyName":"Prabhakara","name":"Prabhakara, Akarsh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuhan","familyName":"Chen","name":"Chen, Chuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jay","familyName":"Karhade","name":"Karhade, Jay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deva","familyName":"Ramanan","name":"Ramanan, Deva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"O'Toole","name":"O'Toole, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anthony","familyName":"Rowe","name":"Rowe, Anthony","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Foundational Models for Single-Chip Radar"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T22:06:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:10:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"mmWave radars are compact, inexpensive, and durable sensors that are robust to occlusions and work regardless of environmental conditions, such as weather and darkness. However, this comes at the cost of poor angular resolution, especially for inexpensive single-chip radars, which are typically used in automotive and indoor sensing applications. Although many have proposed learning-based methods to mitigate this weakness, no standardized foundational models or large datasets for the mmWave radar have emerged, and practitioners have largely trained task-specific models from scratch using relatively small datasets.\n In this paper, we collect (to our knowledge) the largest available raw radar dataset with 1M samples (29 hours) and train a foundational model for 4D single-chip radar, which can predict 3D occupancy and semantic segmentation with quality that is typically only possible with much higher resolution sensors. We demonstrate that our Generalizable Radar Transformer (GRT) generalizes across diverse settings, can be fine-tuned for different tasks, and shows logarithmic data scaling of 20\\% per $10\\times$ data. We also run extensive ablations on common design decisions, and find that using raw radar data significantly outperforms widely-used lossy representations, equivalent to a $10\\times$ increase in training data. Finally, we roughly estimate that $\\approx$100M samples (3000 hours) of data are required to fully exploit the potential of GRT."},{"descriptionType":"Other","description":"To appear in ICCV 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12482","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:41:25Z","registered":"2025-09-17T01:41:26Z","published":null,"updated":"2025-09-17T01:41:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12474","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12474","identifiers":[{"identifier":"2509.12474","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kai","familyName":"Qiu","name":"Qiu, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Li","name":"Li, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Chen","name":"Chen, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jason","familyName":"Kuen","name":"Kuen, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohao","familyName":"Xu","name":"Xu, Xiaohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiuxiang","familyName":"Gu","name":"Gu, Jiuxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinyi","familyName":"Luo","name":"Luo, Yinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bhiksha","familyName":"Raj","name":"Raj, Bhiksha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Lin","name":"Lin, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marios","familyName":"Savvides","name":"Savvides, Marios","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Image Tokenizer Needs Post-Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T21:38:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:10:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent image generative models typically capture the image distribution in a pre-constructed latent space, relying on a frozen image tokenizer. However, there exists a significant discrepancy between the reconstruction and generation distribution, where current tokenizers only prioritize the reconstruction task that happens before generative training without considering the generation errors during sampling. In this paper, we comprehensively analyze the reason for this discrepancy in a discrete latent space, and, from which, we propose a novel tokenizer training scheme including both main-training and post-training, focusing on improving latent space construction and decoding respectively. During the main training, a latent perturbation strategy is proposed to simulate sampling noises, \\ie, the unexpected tokens generated in generative inference. Specifically, we propose a plug-and-play tokenizer training scheme, which significantly enhances the robustness of tokenizer, thus boosting the generation quality and convergence speed, and a novel tokenizer evaluation metric, \\ie, pFID, which successfully correlates the tokenizer performance to generation quality. During post-training, we further optimize the tokenizer decoder regarding a well-trained generative model to mitigate the distribution difference between generated and reconstructed tokens. With a $\\sim$400M generator, a discrete tokenizer trained with our proposed main training achieves a notable 1.60 gFID and further obtains 1.36 gFID with the additional post-training. Further experiments are conducted to broadly validate the effectiveness of our post-training strategy on off-the-shelf discrete and continuous tokenizers, coupled with autoregressive and diffusion-based generators."},{"descriptionType":"Other","description":"21 pages, 16 figures, 10 tables. arXiv admin note: substantial text overlap with arXiv:2503.08354"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12474","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:41:14Z","registered":"2025-09-17T01:41:15Z","published":null,"updated":"2025-09-17T01:41:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12472","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12472","identifiers":[{"identifier":"2509.12472","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weiwei","familyName":"Ding","name":"Ding, Weiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhanghua","familyName":"Liang","name":"Liang, Zhanghua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Effects of temporal variations on wave speeds of bistable traveling waves for Lotka-Volterra competition systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Analysis of PDEs (math.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T21:37:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:10:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates the bistable traveling waves for two-species Lotka-Volterra competition systems in time periodic environments. We focus especially on the influence of the temporal period, with existence results established for both small and large periods.We also show the existence of, and derive explicit formulas for, the limiting speeds as the period tends to zero or infinity, and provide estimates for the corresponding rates of convergence. Furthermore, we analyze the sign of wave speed. Assuming that both species share identical diffusion rates and intraspecific competition rates, we obtain a criterion for determining the sign of wave speed by comparing the intrinsic growth rates and interspecific competition strengths. More intriguingly, based on our explicit formulas for the limiting speeds, we construct an example in which the sign of wave speed changes with the temporal period. This example reveals that temporal variations can significantly influence competition outcomes,enabling different species to become dominant under different periods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12472","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:41:11Z","registered":"2025-09-17T01:41:12Z","published":null,"updated":"2025-09-17T01:41:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12471","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12471","identifiers":[{"identifier":"2509.12471","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiwen","familyName":"Lu","name":"Lu, Yiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Li","name":"Li, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dazheng","familyName":"Zhang","name":"Zhang, Dazheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyao","familyName":"Jian","name":"Jian, Xinyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tingyin","familyName":"Wang","name":"Wang, Tingyin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siqi","familyName":"Chen","name":"Chen, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Lei","name":"Lei, Yuqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Tong","name":"Tong, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaohan","familyName":"Xi","name":"Xi, Zhaohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haitao","familyName":"Chu","name":"Chu, Haitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chongliang","familyName":"Luo","name":"Luo, Chongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexis","familyName":"Ogdie","name":"Ogdie, Alexis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brian","familyName":"Athey","name":"Athey, Brian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alparslan","familyName":"Turan","name":"Turan, Alparslan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Abramoff","name":"Abramoff, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph C","familyName":"Cappelleri","name":"Cappelleri, Joseph C","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hua","familyName":"Xu","name":"Xu, Hua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Lu","name":"Lu, Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jesse","familyName":"Berlin","name":"Berlin, Jesse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel I.","familyName":"Sessler","name":"Sessler, Daniel I.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David A.","familyName":"Asch","name":"Asch, David A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoqian","familyName":"Jiang","name":"Jiang, Xiaoqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Chen","name":"Chen, Yong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Empowering Clinical Trial Design through AI: A Randomized Evaluation of PowerGPT"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T21:35:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:10:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Sample size calculations for power analysis are critical for clinical research and trial design, yet their complexity and reliance on statistical expertise create barriers for many researchers. We introduce PowerGPT, an AI-powered system integrating large language models (LLMs) with statistical engines to automate test selection and sample size estimation in trial design. In a randomized trial to evaluate its effectiveness, PowerGPT significantly improved task completion rates (99.3% vs. 88.9% for test selection, 99.3% vs. 77.8% for sample size calculation) and accuracy (94.1% vs. 55.4% in sample size estimation, p \u0026lt; 0.001), while reducing average completion time (4.0 vs. 9.3 minutes, p \u0026lt; 0.001). These gains were consistent across various statistical tests and benefited both statisticians and non-statisticians as well as bridging expertise gaps. Already under deployment across multiple institutions, PowerGPT represents a scalable AI-driven approach that enhances accessibility, efficiency, and accuracy in statistical power analysis for clinical research."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12471","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:41:10Z","registered":"2025-09-17T01:41:11Z","published":null,"updated":"2025-09-17T01:41:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12462","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12462","identifiers":[{"identifier":"2509.12462","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chuxu","familyName":"Song","name":"Song, Chuxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dheekshith Dev Manohar","familyName":"Mekala","name":"Mekala, Dheekshith Dev Manohar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Wang","name":"Wang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard","familyName":"Martin","name":"Martin, Richard","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Redefining Website Fingerprinting Attacks With Multiagent LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T21:17:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:09:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Website Fingerprinting (WFP) uses deep learning models to classify encrypted network traffic to infer visited websites. While historically effective, prior methods fail to generalize to modern web environments. Single-page applications (SPAs) eliminate the paradigm of websites as sets of discrete pages, undermining page-based classification, and traffic from scripted browsers lacks the behavioral richness seen in real user sessions. Our study reveals that users exhibit highly diverse behaviors even on the same website, producing traffic patterns that vary significantly across individuals. This behavioral entropy makes WFP a harder problem than previously assumed and highlights the need for larger, more diverse, and representative datasets to achieve robust performance. To address this, we propose a new paradigm: we drop session-boundaries in favor of contiguous traffic segments and develop a scalable data generation pipeline using large language models (LLM) agents. These multi-agent systems coordinate decision-making and browser interaction to simulate realistic, persona-driven browsing behavior at 3--5x lower cost than human collection. We evaluate nine state-of-the-art WFP models on traffic from 20 modern websites browsed by 30 real users, and compare training performance across human, scripted, and LLM-generated datasets. All models achieve under 10\\% accuracy when trained on scripted traffic and tested on human data. In contrast, LLM-generated traffic boosts accuracy into the 80\\% range, demonstrating strong generalization to real-world traces. Our findings indicate that for modern WFP, model performance is increasingly bottlenecked by data quality, and that scalable, semantically grounded synthetic traffic is essential for capturing the complexity of real user behavior."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12462","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:58Z","registered":"2025-09-17T01:40:59Z","published":null,"updated":"2025-09-17T01:40:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12459","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12459","identifiers":[{"identifier":"2509.12459","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Suvojit","familyName":"Acharjee","name":"Acharjee, Suvojit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Utathya","familyName":"Aich","name":"Aich, Utathya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Asfak","familyName":"Ali","name":"Ali, Asfak","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Does Language Model Understand Language?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T21:09:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:09:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite advances in natural language generation and understanding, LM still struggle with fine grained linguistic phenomena such as tense, negation, voice, and modality which are the elements central to effective human communication. In the context of the United Nations SDG 4, where linguistic clarity is critical, the deployment of LMs in educational technologies demands careful scrutiny. As LMs are increasingly powering applications like tutoring systems, automated grading, and translation, their alignment with human linguistic interpretation becomes essential for effective learning. In this study, we conduct a evaluation of SOTA language models across these challenging contexts in both English and Bengali. To ensure a structured assessment, we introduce a new Route for Evaluation of Cognitive Inference in Systematic Environments guidelines. Our proposed LUCID dataset, composed of carefully crafted sentence pairs in English and Bengali, specifically challenges these models on critical aspects of language comprehension, including negation, tense, voice variations. We assess the performance of SOTA models including MISTRAL-SABA-24B, LLaMA-4-Scout-17B, LLaMA-3.3-70B, Gemma2-9B, and Compound-Beta using standard metrics like Pearson correlation, Spearman correlation, and Mean Absolute Error, as well as novel, linguistically inspired metric the HCE accuracy. The HCE accuracy measures how often model predictions fall within one standard deviation of the mean human rating, thus capturing human like tolerance for variability in language interpretation. Our findings highlight Compound-Beta as the most balanced model, consistently achieving high correlations and low MAEs across diverse language conditions. It records the highest Pearson correlation in English and demonstrates robust performance on mixed-language data, indicating a strong alignment with human judgments in cross lingual scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12459","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:54Z","registered":"2025-09-17T01:40:55Z","published":null,"updated":"2025-09-17T01:40:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12451","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12451","identifiers":[{"identifier":"2509.12451","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wonbin","familyName":"Kweon","name":"Kweon, Wonbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"SeongKu","familyName":"Kang","name":"Kang, SeongKu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runchu","familyName":"Tian","name":"Tian, Runchu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengcheng","familyName":"Jiang","name":"Jiang, Pengcheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Han","name":"Han, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hwanjo","familyName":"Yu","name":"Yu, Hwanjo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Topic Coverage-based Demonstration Retrieval for In-Context Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T21:00:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:08:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The effectiveness of in-context learning relies heavily on selecting demonstrations that provide all the necessary information for a given test input. To achieve this, it is crucial to identify and cover fine-grained knowledge requirements. However, prior methods often retrieve demonstrations based solely on embedding similarity or generation probability, resulting in irrelevant or redundant examples. In this paper, we propose TopicK, a topic coverage-based retrieval framework that selects demonstrations to comprehensively cover topic-level knowledge relevant to both the test input and the model. Specifically, TopicK estimates the topics required by the input and assesses the model's knowledge on those topics. TopicK then iteratively selects demonstrations that introduce previously uncovered required topics, in which the model exhibits low topical knowledge. We validate the effectiveness of TopicK through extensive experiments across various datasets and both open- and closed-source LLMs. Our source code is available at https://github.com/WonbinKweon/TopicK_EMNLP2025."},{"descriptionType":"Other","description":"EMNLP 2025 Main"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12451","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:44Z","registered":"2025-09-17T01:40:44Z","published":null,"updated":"2025-09-17T01:40:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12437","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12437","identifiers":[{"identifier":"2509.12437","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dingrui","familyName":"Wang","name":"Wang, Dingrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhexiao","familyName":"Sun","name":"Sun, Zhexiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhouheng","familyName":"Li","name":"Li, Zhouheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Wang","name":"Wang, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Youlun","familyName":"Peng","name":"Peng, Youlun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyuan","familyName":"Ye","name":"Ye, Hongyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baha","familyName":"Zarrouki","name":"Zarrouki, Baha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Li","name":"Li, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mattia","familyName":"Piccinini","name":"Piccinini, Mattia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Xie","name":"Xie, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johannes","familyName":"Betz","name":"Betz, Johannes","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Physical Consistency in Lightweight World Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T20:43:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:08:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"A major challenge in deploying world models is the trade-off between size and performance. Large world models can capture rich physical dynamics but require massive computing resources, making them impractical for edge devices. Small world models are easier to deploy but often struggle to learn accurate physics, leading to poor predictions. We propose the Physics-Informed BEV World Model (PIWM), a compact model designed to efficiently capture physical interactions in bird's-eye-view (BEV) representations. PIWM uses Soft Mask during training to improve dynamic object modeling and future prediction. We also introduce a simple yet effective technique, Warm Start, for inference to enhance prediction quality with a zero-shot model. Experiments show that at the same parameter scale (400M), PIWM surpasses the baseline by 60.6% in weighted overall score. Moreover, even when compared with the largest baseline model (400M), the smallest PIWM (130M Soft Mask) achieves a 7.4% higher weighted overall score with a 28% faster inference speed."},{"descriptionType":"Other","description":"8 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12437","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:24Z","registered":"2025-09-17T01:40:25Z","published":null,"updated":"2025-09-17T01:40:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12423","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12423","identifiers":[{"identifier":"2509.12423","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Danielle","familyName":"Cohen","name":"Cohen, Danielle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoni","familyName":"Halpern","name":"Halpern, Yoni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noam","familyName":"Kahlon","name":"Kahlon, Noam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joel","familyName":"Oren","name":"Oren, Joel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Omri","familyName":"Berkovitch","name":"Berkovitch, Omri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sapir","familyName":"Caduri","name":"Caduri, Sapir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ido","familyName":"Dagan","name":"Dagan, Ido","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anatoly","familyName":"Efros","name":"Efros, Anatoly","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Small Models, Big Results: Achieving Superior Intent Extraction through Decomposition"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-15T20:20:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:07:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding user intents from UI interaction trajectories remains a challenging, yet crucial, frontier in intelligent agent development. While massive, datacenter-based, multi-modal large language models (MLLMs) possess greater capacity to handle the complexities of such sequences, smaller models which can run on-device to provide a privacy-preserving, low-cost, and low-latency user experience, struggle with accurate intent inference. We address these limitations by introducing a novel decomposed approach: first, we perform structured interaction summarization, capturing key information from each user action. Second, we perform intent extraction using a fine-tuned model operating on the aggregated summaries. This method improves intent understanding in resource-constrained models, even surpassing the base performance of large MLLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12423","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:40:05Z","registered":"2025-09-17T01:40:05Z","published":null,"updated":"2025-09-17T01:40:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":281,"totalPages":12,"page":10},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=10\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-16T16%3A00%3A00Z+TO+2025-09-17T15%3A59%3A59.999Z%5D+AND+%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+agent+OR+agents+OR+diffusion+OR+multimodal+OR+GPU+OR+MoE+OR+%22state+space%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22vision+language%22%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=11\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-16T16%3A00%3A00Z+TO+2025-09-17T15%3A59%3A59.999Z%5D+AND+%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+agent+OR+agents+OR+diffusion+OR+multimodal+OR+GPU+OR+MoE+OR+%22state+space%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22vision+language%22%29"}}