<td id="S5.T5.3.5.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T5.3.5.5.1" class="ltx_text" style="font-size:90%;">3.929 <math id="S5.T5.m20" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.013</span></td></tr>
