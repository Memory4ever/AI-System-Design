            <span id="alg2.l2.3" class="ltx_text ltx_markedasmath ltx_font_bold">Parsing NP Query from Current Task Set <math id="alg2.l2.m1.m1" class="ltx_Math" alttext="\mathcal{D}_{k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\mathcal{D}_{k}</annotation></semantics></math></span>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <math id="alg2.l3.m1" class="ltx_Math" alttext="\;x_{C},\widetilde{y}_{C},x_{T}\leftarrow\mathcal{D}_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>C</mi></msub><mo>,</mo><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>C</mi></msub><mo>,</mo><mrow><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">←</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\;x_{C},\widetilde{y}_{C},x_{T}\leftarrow\mathcal{D}_{k}</annotation></semantics></math>

</div>
