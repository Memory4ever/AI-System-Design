<td id="S5.T5.3.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T5.3.4.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">1.787 <math id="S5.T5.m14" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.805</span></td>
<td id="S5.T5.3.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T5.3.4.4.1" class="ltx_text" style="font-size:90%;">1.336 <math id="S5.T5.m15" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.771</span></td>
