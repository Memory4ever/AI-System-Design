            <math id="alg2.l19.m1" class="ltx_Math" alttext="\textbf{Update Next Context}\;\widetilde{y}_{C}\;\textbf{and Task Set}\;\mathcal{D}_{k+1}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_bold">Update Next Context</mtext><mo lspace="0.280em" rspace="0em">​</mo><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>C</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_bold">and Task Set</mtext><mo lspace="0.280em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\textbf{Update Next Context}\;\widetilde{y}_{C}\;\textbf{and Task Set}\;\mathcal{D}_{k+1}</annotation></semantics></math>

</div>
<div id="alg2.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
            <math id="alg2.l20.m1" class="ltx_Math" alttext="\widetilde{y}_{C}\leftarrow\beta_{k}\cdot\hat{y}_{T}^{+}+(1-\beta_{k})\cdot y_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>C</mi></msub><mo stretchy="false">←</mo><mrow><mrow><msub><mi>β</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mo>+</mo></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>β</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>y</mi><mi>k</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{y}_{C}\leftarrow\beta_{k}\cdot\hat{y}_{T}^{+}+(1-\beta_{k})\cdot y_{k}</annotation></semantics></math>

</div>
<div id="alg2.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
              
            <math id="alg2.l21.m1" class="ltx_Math" alttext="x_{C}\leftarrow u_{k+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>C</mi></msub><mo stretchy="false">←</mo><msub><mi>u</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">x_{C}\leftarrow u_{k+1}</annotation></semantics></math>

</div>
<div id="alg2.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
            <math id="alg2.l22.m1" class="ltx_Math" alttext="x_{T}\leftarrow\Delta k" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">←</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">x_{T}\leftarrow\Delta k</annotation></semantics></math>

</div>
<div id="alg2.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
              
              
            <math id="alg2.l23.m1" class="ltx_Math" alttext="\mathcal{D}_{k+1}\leftarrow x_{C},\widetilde{y}_{C},x_{T}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><msub><mi>x</mi><mi>C</mi></msub></mrow><mo>,</mo><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>C</mi></msub><mo>,</mo><msub><mi>x</mi><mi>T</mi></msub></mrow><annotation encoding="application/x-tex">\mathcal{D}_{k+1}\leftarrow x_{C},\widetilde{y}_{C},x_{T}</annotation></semantics></math> 
</div>
<div id="alg2.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
              
            
</div>
<div id="alg2.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
              
              
            <math id="alg2.l25.m1" class="ltx_Math" alttext="\textbf{return}\;\hat{y}_{T}^{+},\;\hat{\sigma}_{T}^{+},\;\mathcal{D}_{k+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_bold">return</mtext><mo lspace="0.280em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mo>+</mo></msubsup></mrow><mo rspace="0.447em">,</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>T</mi><mo>+</mo></msubsup><mo rspace="0.447em">,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\textbf{return}\;\hat{y}_{T}^{+},\;\hat{\sigma}_{T}^{+},\;\mathcal{D}_{k+1}</annotation></semantics></math>

</div>
</div>
</figure>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3 </span>Recursive Estimation Algorithm Discussion</h3>

<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">In Algorithm <a href="#alg2" title="Algorithm 2 ‣ 4.2 Model Optimization Algorithm ‣ 4 Methodology ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, one can observe how our PI-AttNP-based recursive state estimation algorithm operates in sequential prediction tasks. Regarding input arguments, note that <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="\mathcal{D}_{k}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\mathcal{D}_{k}</annotation></semantics></math> represents the previous task set that contains dynamic information (<math id="S4.SS3.p1.m2" class="ltx_Math" alttext="x_{C},\widetilde{y}_{C},x_{T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>C</mi></msub><mo>,</mo><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>C</mi></msub><mo>,</mo><msub><mi>x</mi><mi>T</mi></msub></mrow><annotation encoding="application/x-tex">x_{C},\widetilde{y}_{C},x_{T}</annotation></semantics></math>) needed to predict the next immediate states <math id="S4.SS3.p1.m3" class="ltx_Math" alttext="y_{T}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>T</mi></msub><annotation encoding="application/x-tex">y_{T}</annotation></semantics></math>. The conformal quantile parameter <math id="S4.SS3.p1.m4" class="ltx_Math" alttext="q_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>α</mi></msub><annotation encoding="application/x-tex">q_{\alpha}</annotation></semantics></math> is used to linearly scale the model uncertainty standard deviations <math id="S4.SS3.p1.m5" class="ltx_Math" alttext="\hat{\sigma}_{T}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>T</mi></msub><annotation encoding="application/x-tex">\hat{\sigma}_{T}</annotation></semantics></math> in order to obtain probabilistic guarantees for ground-truth predictions and error bounds for each state in <math id="S4.SS3.p1.m6" class="ltx_Math" alttext="y_{T}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>T</mi></msub><annotation encoding="application/x-tex">y_{T}</annotation></semantics></math>. Recall that <math id="S4.SS3.p1.m7" class="ltx_Math" alttext="\hat{f}_{\Gamma}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi mathvariant="normal">Γ</mi></msub><annotation encoding="application/x-tex">\hat{f}_{\Gamma}</annotation></semantics></math> represents the learned PI-AttNP based dynamics model referenced previously <a href="#S2" title="2 Problem Statement ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. In line 19, when the noisy context signal <math id="S4.SS3.p1.m8" class="ltx_Math" alttext="\widetilde{y}_{C}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>C</mi></msub><annotation encoding="application/x-tex">\widetilde{y}_{C}</annotation></semantics></math> is updated, it does so using a weighted average between the posterior average <math id="S4.SS3.p1.m9" class="ltx_Math" alttext="\hat{y}_{T}^{+}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\hat{y}_{T}^{+}</annotation></semantics></math> and the most recent noise-perturbed sensor measurements <math id="S4.SS3.p1.m10" class="ltx_Math" alttext="y_{k}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">y_{k}</annotation></semantics></math>. This action is done to provide an error correction mechanism to mitigate the accumulation of prediction error over time. Note that since <math id="S4.SS3.p1.m11" class="ltx_Math" alttext="\widetilde{y}_{C}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>C</mi></msub><annotation encoding="application/x-tex">\widetilde{y}_{C}</annotation></semantics></math> represents the previous state vector <math id="S4.SS3.p1.m12" class="ltx_Math" alttext="\hat{x}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\hat{x}_{k}</annotation></semantics></math>, we observe that only observable states of <math id="S4.SS3.p1.m13" class="ltx_Math" alttext="\hat{y}_{T}^{+}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\hat{y}_{T}^{+}</annotation></semantics></math> are fused with noisy observations <math id="S4.SS3.p1.m14" class="ltx_Math" alttext="y_{k}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">y_{k}</annotation></semantics></math>. This weighted computation is controlled through a time-varying, model uncertainty-based weighting term <math id="S4.SS3.p1.m15" class="ltx_Math" alttext="\beta_{k}\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>k</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\beta_{k}\in[0,1]</annotation></semantics></math> computed in line 16 where the <em id="S4.SS3.p1.1.1" class="ltx_emph ltx_font_italic">observed</em> state components of the conformal quantile-scaled PI-AttNP uncertainty <math id="S4.SS3.p1.m16" class="ltx_Math" alttext="\hat{\sigma}_{\text{obs}}^{+}\in\mathbb{R}^{o}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mtext>obs</mtext><mo>+</mo></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>o</mi></msup></mrow><annotation encoding="application/x-tex">\hat{\sigma}_{\text{obs}}^{+}\in\mathbb{R}^{o}</annotation></semantics></math> are utilized in its computation. Through this weighting scheme, the model adaptively varies the contributions of observed state predictions and true observations throughout an estimation task. Since <math id="S4.SS3.p1.m17" class="ltx_Math" alttext="\hat{\sigma}_{\text{obs}}^{+}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mtext>obs</mtext><mo>+</mo></msubsup><annotation encoding="application/x-tex">\hat{\sigma}_{\text{obs}}^{+}</annotation></semantics></math> now provides statistical robustness from the marginal CP approach, the PI-AttNP is expected to learn the transitional relationship between previous fused estimate <math id="S4.SS3.p1.m18" class="ltx_Math" alttext="\widetilde{y}_{C}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>C</mi></msub><annotation encoding="application/x-tex">\widetilde{y}_{C}</annotation></semantics></math>, updated prediction <math id="S4.SS3.p1.m19" class="ltx_Math" alttext="\hat{y}_{T}^{+}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\hat{y}_{T}^{+}</annotation></semantics></math>, and ground truth next states <math id="S4.SS3.p1.m20" class="ltx_Math" alttext="y_{T}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>T</mi></msub><annotation encoding="application/x-tex">y_{T}</annotation></semantics></math> at each recursive iteration.</p>
</div>
</section>
<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.4 </span>Conformal Prediction for Calibrated Uncertainty 
<br class="ltx_break">Guarantees</h3>

<div id="S4.SS4.p1" class="ltx_para">
<p id="S4.SS4.p1.1" class="ltx_p">To quantify the uncertainty in our PI-AttNP-based state estimates and provide probabilistic guarantees, we integrate a marginal conformal prediction (CP) framework. This approach constructs data-driven prediction intervals for each state dimension, ensuring that the true future state <math id="S4.SS4.p1.m1" class="ltx_Math" alttext="y_{T}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>T</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">y_{T}\in\mathbb{R}^{n}</annotation></semantics></math> lies within these intervals with user-defined confidence <math id="S4.SS4.p1.m2" class="ltx_Math" alttext="1-\alpha" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">1-\alpha</annotation></semantics></math>, without making strong assumptions on the underlying data distribution.</p>
</div>
<section id="S4.SS4.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.4.1 </span>Conformal Set Construction</h4>

<div id="S4.SS4.SSS1.p1" class="ltx_para">
<p id="S4.SS4.SSS1.p1.1" class="ltx_p">Let <math id="S4.SS4.SSS1.p1.m1" class="ltx_Math" alttext="\hat{y}^{(j)}_{T}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{y}^{(j)}_{T}</annotation></semantics></math> and <math id="S4.SS4.SSS1.p1.m2" class="ltx_Math" alttext="\hat{\sigma}^{(j)}_{T}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\sigma}^{(j)}_{T}</annotation></semantics></math> denote the predicted mean and standard deviation, respectively, for state dimension <math id="S4.SS4.SSS1.p1.m3" class="ltx_Math" alttext="j\in\{1,\dots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\dots,n\}</annotation></semantics></math> from the PI-AttNP <math id="S4.SS4.SSS1.p1.m4" class="ltx_Math" alttext="\hat{f}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>f</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{f}</annotation></semantics></math> model. We define the score function <math id="S4.SS4.SSS1.p1.m5" class="ltx_Math" alttext="s(x_{i},y_{i})=s_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>s</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">s(x_{i},y_{i})=s_{i}</annotation></semantics></math> as normalized squared residuals for each calibration sample <math id="S4.SS4.SSS1.p1.m6" class="ltx_Math" alttext="(x_{i},y_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{i},y_{i})</annotation></semantics></math> and state dimension <math id="S4.SS4.SSS1.p1.m7" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> in the following form:</p>
</div>
<div id="S4.SS4.SSS1.p2" class="ltx_para">
<table id="S4.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E4.m1" class="ltx_Math" alttext="s_{i}^{(j)}=\frac{\left(y_{i}^{(j)}-\hat{y}_{i}^{(j)}\right)^{2}}{\hat{\sigma}_{i}^{(j)}}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>s</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mfrac><msup><mrow><mo>(</mo><mrow><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow><mn>2</mn></msup><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">s_{i}^{(j)}=\frac{\left(y_{i}^{(j)}-\hat{y}_{i}^{(j)}\right)^{2}}{\hat{\sigma}_{i}^{(j)}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S4.SS4.SSS1.p2.1" class="ltx_p">where <math id="S4.SS4.SSS1.p2.m1" class="ltx_Math" alttext="\hat{y}_{i},\;\hat{\sigma}_{i}=\hat{f}(x_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>i</mi></msub><mo rspace="0.447em">,</mo><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>i</mi></msub><mo>=</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{y}_{i},\;\hat{\sigma}_{i}=\hat{f}(x_{i})</annotation></semantics></math>. Given a calibration dataset <math id="S4.SS4.SSS1.p2.m2" class="ltx_Math" alttext="\mathcal{D}_{\text{cal}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>cal</mtext></msub><annotation encoding="application/x-tex">\mathcal{D}_{\text{cal}}</annotation></semantics></math> of size <math id="S4.SS4.SSS1.p2.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, we compute the empirical quantile <math id="S4.SS4.SSS1.p2.m4" class="ltx_Math" alttext="q_{\alpha}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">q_{\alpha}^{(j)}</annotation></semantics></math> of the scores <math id="S4.SS4.SSS1.p2.m5" class="ltx_Math" alttext="\{s_{1}^{(j)},\dots,s_{N}^{(j)}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mi>s</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>s</mi><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{s_{1}^{(j)},\dots,s_{N}^{(j)}\}</annotation></semantics></math> such that:</p>
</div>
<div id="S4.SS4.SSS1.p3" class="ltx_para">
<table id="S4.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex5.m1" class="ltx_Math" alttext="q_{\alpha}^{(j)}=\text{Quantile}_{1-\alpha}\left(\{s_{i}^{(j)}\}_{i=1}^{N}\cup\{+\infty\}\right)." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><msub><mtext>Quantile</mtext><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>s</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">q_{\alpha}^{(j)}=\text{Quantile}_{1-\alpha}\left(\{s_{i}^{(j)}\}_{i=1}^{N}\cup\{+\infty\}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS1.p3.1" class="ltx_p">The resulting conformal prediction interval <math id="S4.SS4.SSS1.p3.m1" class="ltx_Math" alttext="C_{\alpha}^{(j)}(x_{T})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>C</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{\alpha}^{(j)}(x_{T})</annotation></semantics></math> for the test-time state prediction in dimension <math id="S4.SS4.SSS1.p3.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> is:</p>
</div>
<div id="S4.SS4.SSS1.p4" class="ltx_para">
<table id="S4.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex6.m1" class="ltx_Math" alttext="\mathcal{C}_{\alpha}^{(j)}(x_{T})=\left[\hat{y}^{(j)}_{T}-q_{\alpha}^{(j)}\cdot\hat{\sigma}^{(j)}_{T},\,\;\;\hat{y}^{(j)}_{T}+q_{\alpha}^{(j)}\cdot\hat{\sigma}^{(j)}_{T}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><mrow><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo rspace="0.897em">,</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{C}_{\alpha}^{(j)}(x_{T})=\left[\hat{y}^{(j)}_{T}-q_{\alpha}^{(j)}\cdot\hat{\sigma}^{(j)}_{T},\,\;\;\hat{y}^{(j)}_{T}+q_{\alpha}^{(j)}\cdot\hat{\sigma}^{(j)}_{T}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="S4.SS4.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.4.2 </span>Coverage Analyses and Estimation Error Guarantees</h4>

<div id="S4.SS4.SSS2.p1" class="ltx_para">
<p id="S4.SS4.SSS2.p1.1" class="ltx_p">To establish the guaranteed error bounds needed for our CP-based estimation approach, we assume the following:</p>
</div>
<div id="Thmassumption1" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption1.2" class="ltx_text ltx_font_bold">Assumption 1</span></span><span id="Thmassumption1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmassumption1.p1" class="ltx_para">
<p id="Thmassumption1.p1.1" class="ltx_p"><span id="Thmassumption1.p1.1.1" class="ltx_text ltx_font_italic">The conformity scores <math id="Thmassumption1.p1.m1" class="ltx_Math" alttext="\{s_{i}^{(j)}\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>s</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{s_{i}^{(j)}\}_{i=1}^{N}</annotation></semantics></math> computed on the calibration set as shown in Equation (<a href="#S4.E4" title="In 4.4.1 Conformal Set Construction ‣ 4.4 Conformal Prediction for Calibrated Uncertainty Guarantees ‣ 4 Methodology ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) and the test score <math id="Thmassumption1.p1.m2" class="ltx_Math" alttext="s_{N+1}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">s_{N+1}^{(j)}</annotation></semantics></math> are jointly exchangeable and drawn from a continuous distribution.</span></p>
</div>
</div>
<div id="S4.SS4.SSS2.p2" class="ltx_para">
<p id="S4.SS4.SSS2.p2.1" class="ltx_p">The technical assumptions above are made to ensure that the scores can be strictly ordered with probability 1.</p>
</div>
<div id="Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem1.2" class="ltx_text ltx_font_bold">Theorem 1</span></span><span id="Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem1.p1" class="ltx_para">
<p id="Thmtheorem1.p1.1" class="ltx_p"><span id="Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Under the assumption that the calibration scores <math id="Thmtheorem1.p1.m1" class="ltx_Math" alttext="\{s_{1}^{(j)},s_{2}^{(j)},\dots,s_{N}^{(j)}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>s</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>s</mi><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{s_{1}^{(j)},s_{2}^{(j)},\dots,s_{N}^{(j)}\}</annotation></semantics></math> and the test score <math id="Thmtheorem1.p1.m2" class="ltx_Math" alttext="s_{N+1}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">s_{N+1}^{(j)}</annotation></semantics></math> are exchangeable and drawn from a continuous distribution, the marginal split conformal framework guarantees the following tight probabilistic coverage for each state dimension <math id="Thmtheorem1.p1.m3" class="ltx_Math" alttext="j\in\{1,\dots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\dots,n\}</annotation></semantics></math>:</span></p>
<table id="S4.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex7.m1" class="ltx_Math" alttext="1-\alpha\leq\mathbb{P}\left(y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\right)\leq 1-\alpha+\frac{1}{N+1}" display="block" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>+</mo><mfrac><mn>1</mn><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">1-\alpha\leq\mathbb{P}\left(y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\right)\leq 1-\alpha+\frac{1}{N+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS4.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS4.SSS2.p3" class="ltx_para">
<p id="S4.SS4.SSS2.p3.1" class="ltx_p"><span id="S4.SS4.SSS2.p3.1.1" class="ltx_text">We establish the proof of Theorem <a href="#Thmtheorem1" title="Theorem 1. ‣ 4.4.2 Coverage Analyses and Estimation Error Guarantees ‣ 4.4 Conformal Prediction for Calibrated Uncertainty Guarantees ‣ 4 Methodology ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> in phases noted with bold font below, beginning with the quantile construction and ending with the upper bound on the error.</span></p>
</div>
<div id="S4.SS4.SSS2.p4" class="ltx_para ltx_noindent">
<p id="S4.SS4.SSS2.p4.1" class="ltx_p"><span id="S4.SS4.SSS2.p4.1.1" class="ltx_text ltx_font_bold">Quantile construction:</span> For a given state dimension <math id="S4.SS4.SSS2.p4.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, define the <math id="S4.SS4.SSS2.p4.m2" class="ltx_Math" alttext="(1-\alpha)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(1-\alpha)</annotation></semantics></math>-quantile as:</p>
<table id="S4.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex8.m1" class="ltx_Math" alttext="q_{\alpha}^{(j)}=s^{(j)}_{\left\lceil(N+1)(1-\alpha)\right\rceil}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mi>s</mi><mrow><mo>⌈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⌉</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q_{\alpha}^{(j)}=s^{(j)}_{\left\lceil(N+1)(1-\alpha)\right\rceil},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS2.p4.2" class="ltx_p">where <math id="S4.SS4.SSS2.p4.m3" class="ltx_Math" alttext="s^{(j)}_{(1)}\leq s^{(j)}_{(2)}\leq\dots\leq s^{(j)}_{(N)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><msubsup><mi>s</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><mi mathvariant="normal">⋯</mi><mo>≤</mo><msubsup><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">s^{(j)}_{(1)}\leq s^{(j)}_{(2)}\leq\dots\leq s^{(j)}_{(N)}</annotation></semantics></math> denotes the ordered calibration scores, and <math id="S4.SS4.SSS2.p4.m4" class="ltx_Math" alttext="q_{\alpha}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">q_{\alpha}^{(j)}</annotation></semantics></math> is the <math id="S4.SS4.SSS2.p4.m5" class="ltx_Math" alttext="\left\lceil(N+1)(1-\alpha)\right\rceil" display="inline" intent=":literal"><semantics><mrow><mo>⌈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⌉</mo></mrow><annotation encoding="application/x-tex">\left\lceil(N+1)(1-\alpha)\right\rceil</annotation></semantics></math>-th smallest value in the ordered set <math id="S4.SS4.SSS2.p4.m6" class="ltx_Math" alttext="\{s_{1}^{(j)},\dots,s_{N}^{(j)},s_{N+1}^{(j)}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>s</mi><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{s_{1}^{(j)},\dots,s_{N}^{(j)},s_{N+1}^{(j)}\}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.SSS2.p5" class="ltx_para ltx_noindent">
<p id="S4.SS4.SSS2.p5.1" class="ltx_p"><span id="S4.SS4.SSS2.p5.1.1" class="ltx_text ltx_font_bold">Uniform rank argument:</span> Under exchangeability, the rank of the test score <math id="S4.SS4.SSS2.p5.m1" class="ltx_Math" alttext="s_{N+1}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">s_{N+1}^{(j)}</annotation></semantics></math> is uniformly distributed over the <math id="S4.SS4.SSS2.p5.m2" class="ltx_Math" alttext="N+1" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N+1</annotation></semantics></math> possible positions. Therefore, for any integer <math id="S4.SS4.SSS2.p5.m3" class="ltx_Math" alttext="k\in\{1,\dots,N+1\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{1,\dots,N+1\}</annotation></semantics></math>,</p>
<table id="S4.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex9.m1" class="ltx_Math" alttext="\mathbb{P}\left(s_{N+1}^{(j)}\leq s_{(k)}^{(j)}\right)=\frac{k}{N+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><msubsup><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mi>k</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}\left(s_{N+1}^{(j)}\leq s_{(k)}^{(j)}\right)=\frac{k}{N+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS2.p6" class="ltx_para ltx_noindent">
<p id="S4.SS4.SSS2.p6.1" class="ltx_p"><span id="S4.SS4.SSS2.p6.1.1" class="ltx_text ltx_font_bold">Lower bound:</span> Setting <math id="S4.SS4.SSS2.p6.m1" class="ltx_Math" alttext="k=\left\lceil(N+1)(1-\alpha)\right\rceil" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mo>⌈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⌉</mo></mrow></mrow><annotation encoding="application/x-tex">k=\left\lceil(N+1)(1-\alpha)\right\rceil</annotation></semantics></math>, we obtain:</p>
<table id="S4.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex10.m1" class="ltx_Math" alttext="\mathbb{P}\left(s_{N+1}^{(j)}\leq q_{\alpha}^{(j)}\right)=\frac{\left\lceil(N+1)(1-\alpha)\right\rceil}{N+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mo>⌈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⌉</mo></mrow><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}\left(s_{N+1}^{(j)}\leq q_{\alpha}^{(j)}\right)=\frac{\left\lceil(N+1)(1-\alpha)\right\rceil}{N+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS2.p6.2" class="ltx_p">Using the ceiling function property <math id="S4.SS4.SSS2.p6.m2" class="ltx_Math" alttext="\lceil x\rceil\geq x" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">⌈</mo><mi>x</mi><mo stretchy="false">⌉</mo></mrow><mo>≥</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\lceil x\rceil\geq x</annotation></semantics></math> for all <math id="S4.SS4.SSS2.p6.m3" class="ltx_Math" alttext="x\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}</annotation></semantics></math>, we have:</p>
<table id="S4.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex11.m1" class="ltx_Math" alttext="\frac{\left\lceil(N+1)(1-\alpha)\right\rceil}{N+1}\geq\frac{(N+1)(1-\alpha)}{N+1}=1-\alpha." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mrow><mo>⌈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⌉</mo></mrow><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>≥</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{\left\lceil(N+1)(1-\alpha)\right\rceil}{N+1}\geq\frac{(N+1)(1-\alpha)}{N+1}=1-\alpha.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS2.p6.3" class="ltx_p">Since the prediction set <math id="S4.SS4.SSS2.p6.m4" class="ltx_Math" alttext="\mathcal{C}_{\alpha}^{(j)}(x_{N+1})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}_{\alpha}^{(j)}(x_{N+1})</annotation></semantics></math> is defined such that:</p>
<table id="S4.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex12.m1" class="ltx_Math" alttext="y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\iff s_{N+1}^{(j)}\leq q_{\alpha}^{(j)}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⇔</mo><mrow><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\iff s_{N+1}^{(j)}\leq q_{\alpha}^{(j)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS2.p6.4" class="ltx_p">it follows that:</p>
<table id="S4.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex13.m1" class="ltx_Math" alttext="\mathbb{P}\left(y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\right)\geq 1-\alpha." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}\left(y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\right)\geq 1-\alpha.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS2.p7" class="ltx_para ltx_noindent">
<p id="S4.SS4.SSS2.p7.1" class="ltx_p"><span id="S4.SS4.SSS2.p7.1.1" class="ltx_text ltx_font_bold">Upper bound:</span> Since <math id="S4.SS4.SSS2.p7.m1" class="ltx_Math" alttext="\left\lceil(N+1)(1-\alpha)\right\rceil\leq(N+1)(1-\alpha)+1" display="inline" intent=":literal"><semantics><mrow><mrow><mo>⌈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⌉</mo></mrow><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\left\lceil(N+1)(1-\alpha)\right\rceil\leq(N+1)(1-\alpha)+1</annotation></semantics></math>, we obtain:</p>
<table id="S4.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex14.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}\left(y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\right)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\left(y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\right)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex14.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}\left(s_{N+1}^{(j)}\leq q_{\alpha}^{(j)}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}\left(s_{N+1}^{(j)}\leq q_{\alpha}^{(j)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex15.m1" class="ltx_Math" alttext="\displaystyle=\frac{\left\lceil(N+1)(1-\alpha)\right\rceil}{N+1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo>⌈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>⌉</mo></mrow><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\left\lceil(N+1)(1-\alpha)\right\rceil}{N+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex16.m1" class="ltx_Math" alttext="\displaystyle\leq 1-\alpha+\frac{1}{N+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 1-\alpha+\frac{1}{N+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS2.p8" class="ltx_para ltx_noindent">
<p id="S4.SS4.SSS2.p8.1" class="ltx_p"><span id="S4.SS4.SSS2.p8.1.1" class="ltx_text ltx_font_bold">Conclusion:</span> Combining both bounds, we conclude that for each state dimension <math id="S4.SS4.SSS2.p8.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, the conformal prediction interval <math id="S4.SS4.SSS2.p8.m2" class="ltx_Math" alttext="\mathcal{C}_{\alpha}^{(j)}(x_{N+1})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}_{\alpha}^{(j)}(x_{N+1})</annotation></semantics></math> satisfies:</p>
<table id="S4.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex17.m1" class="ltx_Math" alttext="1-\alpha\leq\mathbb{P}\left(y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\right)\leq 1-\alpha+\frac{1}{N+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>+</mo><mfrac><mn>1</mn><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">1-\alpha\leq\mathbb{P}\left(y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\right)\leq 1-\alpha+\frac{1}{N+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS2.p8.2" class="ltx_p">This ensures marginal coverage validity per state dimension under standard split conformal assumptions.
∎</p>
</div>
</div>
<div id="Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2.2" class="ltx_text ltx_font_bold">Theorem 2</span></span><span id="Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmtheorem2.p1" class="ltx_para">
<p id="Thmtheorem2.p1.1" class="ltx_p"><span id="Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Under the same assumptions that the calibration scores <math id="Thmtheorem2.p1.m1" class="ltx_Math" alttext="\{s_{1}^{(j)},s_{2}^{(j)},\dots,s_{N}^{(j)}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msubsup><mi>s</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>s</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>s</mi><mi>N</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{s_{1}^{(j)},s_{2}^{(j)},\dots,s_{N}^{(j)}\}</annotation></semantics></math> and the test score <math id="Thmtheorem2.p1.m2" class="ltx_Math" alttext="s_{N+1}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">s_{N+1}^{(j)}</annotation></semantics></math> are exchangeable and all scores are drawn from a continuous distribution, the marginal split conformal framework guarantees the following probabilistic error bounds for each state dimension <math id="Thmtheorem2.p1.m3" class="ltx_Math" alttext="j\in\{1,\dots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\dots,n\}</annotation></semantics></math>:</span></p>
<table id="S4.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex18.m1" class="ltx_Math" alttext="1-\alpha\leq\mathbb{P}\left(\left|y_{N+1}^{(j)}-\hat{y}_{N+1}^{(j)}\right|\leq\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{N+1}^{(j)}}\right)\leq 1-\alpha+\frac{1}{N+1}" display="block" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>|</mo></mrow><mo>≤</mo><msqrt><mrow><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></msqrt></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>+</mo><mfrac><mn>1</mn><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">1-\alpha\leq\mathbb{P}\left(\left|y_{N+1}^{(j)}-\hat{y}_{N+1}^{(j)}\right|\leq\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{N+1}^{(j)}}\right)\leq 1-\alpha+\frac{1}{N+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS4.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.SS4.SSS2.p9" class="ltx_para ltx_noindent">
<p id="S4.SS4.SSS2.p9.1" class="ltx_p"><span id="S4.SS4.SSS2.p9.1.1" class="ltx_text ltx_font_bold">Conformity score and prediction interval:</span> For each state dimension <math id="S4.SS4.SSS2.p9.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>, the conformity score for both calibration and test samples is defined as:</p>
<table id="S4.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex19.m1" class="ltx_Math" alttext="s_{i}^{(j)}=\frac{(y_{i}^{(j)}-\hat{y}_{i}^{(j)})^{2}}{\hat{\sigma}_{i}^{(j)}}," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>s</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>y</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">s_{i}^{(j)}=\frac{(y_{i}^{(j)}-\hat{y}_{i}^{(j)})^{2}}{\hat{\sigma}_{i}^{(j)}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS2.p9.2" class="ltx_p">and the corresponding conformal prediction interval is given by:</p>
<table id="S4.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex20.m1" class="ltx_Math" alttext="\mathcal{C}_{\alpha}^{(j)}(x_{T})=\left[\hat{y}_{T}^{(j)}-\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{T}^{(j)}},\;\;\hat{y}_{T}^{(j)}+\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{T}^{(j)}}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msqrt><mrow><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></msqrt></mrow><mo rspace="0.727em">,</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msqrt><mrow><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></msqrt></mrow></mrow><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{C}_{\alpha}^{(j)}(x_{T})=\left[\hat{y}_{T}^{(j)}-\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{T}^{(j)}},\;\;\hat{y}_{T}^{(j)}+\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{T}^{(j)}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS2.p10" class="ltx_para ltx_noindent">
<p id="S4.SS4.SSS2.p10.1" class="ltx_p"><span id="S4.SS4.SSS2.p10.1.1" class="ltx_text ltx_font_bold">Equivalence of coverage and error events:</span> From the previous coverage proof, we know:</p>
<table id="S4.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex21.m1" class="ltx_Math" alttext="y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\iff s_{N+1}^{(j)}\leq q_{\alpha}^{(j)}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⇔</mo><mrow><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\iff s_{N+1}^{(j)}\leq q_{\alpha}^{(j)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS2.p10.2" class="ltx_p">Substituting the definition of the conformity score into this inequality gives:</p>
<table id="S4.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex22.m1" class="ltx_Math" alttext="\frac{(y_{N+1}^{(j)}-\hat{y}_{N+1}^{(j)})^{2}}{\hat{\sigma}_{N+1}^{(j)}}\leq q_{\alpha}^{(j)}." display="block" intent=":literal"><semantics><mrow><mrow><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mfrac><mo>≤</mo><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{(y_{N+1}^{(j)}-\hat{y}_{N+1}^{(j)})^{2}}{\hat{\sigma}_{N+1}^{(j)}}\leq q_{\alpha}^{(j)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS2.p10.3" class="ltx_p">Multiplying both sides by <math id="S4.SS4.SSS2.p10.m1" class="ltx_Math" alttext="\hat{\sigma}_{N+1}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\sigma}_{N+1}^{(j)}</annotation></semantics></math> and taking square roots (since all terms are non-negative) yields:</p>
<table id="S4.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex23.m1" class="ltx_Math" alttext="\left|y_{N+1}^{(j)}-\hat{y}_{N+1}^{(j)}\right|\leq\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{N+1}^{(j)}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>|</mo></mrow><mo>≤</mo><msqrt><mrow><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|y_{N+1}^{(j)}-\hat{y}_{N+1}^{(j)}\right|\leq\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{N+1}^{(j)}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS4.SSS2.p10.4" class="ltx_p">Therefore, the prediction error bound is equivalent to the coverage event:</p>
<table id="S4.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex24.m1" class="ltx_Math" alttext="y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\iff\left|y_{N+1}^{(j)}-\hat{y}_{N+1}^{(j)}\right|\leq\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{N+1}^{(j)}}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⇔</mo><mrow><mrow><mo>|</mo><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>|</mo></mrow><mo>≤</mo><msqrt><mrow><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">y_{N+1}^{(j)}\in\mathcal{C}_{\alpha}^{(j)}(x_{N+1})\iff\left|y_{N+1}^{(j)}-\hat{y}_{N+1}^{(j)}\right|\leq\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{N+1}^{(j)}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS2.p11" class="ltx_para ltx_noindent">
<p id="S4.SS4.SSS2.p11.1" class="ltx_p"><span id="S4.SS4.SSS2.p11.1.1" class="ltx_text ltx_font_bold">Final error bound probabilistic guarantee:</span> By directly applying the result of the first theorem (i.e., the coverage guarantee for <math id="S4.SS4.SSS2.p11.m1" class="ltx_Math" alttext="s_{N+1}^{(j)}\leq q_{\alpha}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>s</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">s_{N+1}^{(j)}\leq q_{\alpha}^{(j)}</annotation></semantics></math>), we conclude:</p>
<table id="S4.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex25.m1" class="ltx_Math" alttext="1-\alpha\leq\mathbb{P}\left(\left|y_{N+1}^{(j)}-\hat{y}_{N+1}^{(j)}\right|\leq\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{N+1}^{(j)}}\right)\leq 1-\alpha+\frac{1}{N+1}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>≤</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>|</mo><mrow><msubsup><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>|</mo></mrow><mo>≤</mo><msqrt><mrow><msubsup><mi>q</mi><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></msqrt></mrow><mo>)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>+</mo><mfrac><mn>1</mn><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">1-\alpha\leq\mathbb{P}\left(\left|y_{N+1}^{(j)}-\hat{y}_{N+1}^{(j)}\right|\leq\sqrt{q_{\alpha}^{(j)}\cdot\hat{\sigma}_{N+1}^{(j)}}\right)\leq 1-\alpha+\frac{1}{N+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS2.p12" class="ltx_para ltx_noindent">
<p id="S4.SS4.SSS2.p12.1" class="ltx_p"><span id="S4.SS4.SSS2.p12.1.1" class="ltx_text ltx_font_bold">Conclusion:</span> This establishes a marginally valid and probabilistically guaranteed upper bound on the absolute prediction error in each dimension, scaled by the model’s predicted standard deviation and the empirical quantile derived from calibration residuals.
∎</p>
</div>
</div>
</section>
<section id="S4.SS4.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.4.3 </span>Remarks on Marginal CP</h4>

<div id="S4.SS4.SSS3.p1" class="ltx_para">
<p id="S4.SS4.SSS3.p1.1" class="ltx_p">While our implementation ensures valid coverage and error bounds <em id="S4.SS4.SSS3.p1.1.1" class="ltx_emph ltx_font_italic">per dimension</em>, we acknowledge that the joint state vector <math id="S4.SS4.SSS3.p1.m1" class="ltx_Math" alttext="y_{N+1}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">y_{N+1}\in\mathbb{R}^{n}</annotation></semantics></math> may not be covered with probability <math id="S4.SS4.SSS3.p1.m2" class="ltx_Math" alttext="1-\alpha" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">1-\alpha</annotation></semantics></math> due to the absence of joint CP construction such as the method found in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib32" title="" class="ltx_ref">Romano et al. (2019)</a></cite>. However, marginal CP remains practical in robotics applications where the high probability coverage of individual states, especially when correlated, imply experimentally robust coverage of the entire joint vector <math id="S4.SS4.SSS3.p1.m3" class="ltx_Math" alttext="y_{N+1}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mrow><mi>N</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">y_{N+1}</annotation></semantics></math> despite theoretical loss <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib33" title="" class="ltx_ref">Sampson and Chan (2024)</a></cite>. In addition to this, to reflect the varying uncertainty that exists among different dynamic states (i.e. uncertainty in velocities versus uncertainty in accelerations), it remains our belief that computing an entire quantile vector <math id="S4.SS4.SSS3.p1.m4" class="ltx_Math" alttext="q_{\alpha}\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>α</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">q_{\alpha}\in\mathbb{R}^{n}</annotation></semantics></math> rather than scalar <math id="S4.SS4.SSS3.p1.m5" class="ltx_Math" alttext="q_{\alpha}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>α</mi></msub><annotation encoding="application/x-tex">q_{\alpha}</annotation></semantics></math> being computed in the joint CP construction, to capture the statistical uncertainty of predicted states remains the more robust option. Nonetheless, the joint CP method from <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib32" title="" class="ltx_ref">Romano et al. (2019)</a></cite> will be included in the uncertainty quantification analyses within the Results <a href="#S5" title="5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
</section>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Results and Validation</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">In this section, we validate the PI-AttNP estimation approach by evaluating its performance on a simulated quadrotor perturbed by external forces, as well as additive and multiplicative noise from a multi-modal Gaussian distribution on the sensor measurements. We also verify that our approach augmented with CP-based uncertainty quantification enhances the distribution modeling capabilities of the PI-AttNP over the baselines we compared against in both training and inference through several evaluation metrics.</p>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1 </span>Baselines Used in Study</h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">As mentioned prior, model baselines used to compare the performance of the PI-AttNP consist of the deep Kalman filter (DKF) and physics-informed neural network (PINN) approaches. Pertaining to the DKF, we adopt the model found in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib34" title="" class="ltx_ref">Ma et al. (2024)</a></cite> where we use transformers to model the transition and measurement models utilized in an inner UKF (unscented Kalman filter) algorithm to capture the nonlinear, possibly non-Gaussian behavior derived from dynamical model <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>. The uncertainty quantification for this model is derived from the statistical guarantees provided by the standard UKF augmented with learned covariance structure that varies at each time step. Note that we will also provide results from the standard UKF with hand-tuned covariance matrices as another baseline.</p>
</div>
<div id="S5.SS1.p2" class="ltx_para">
<p id="S5.SS1.p2.1" class="ltx_p">For the PINN, we employ the same dynamics model <math id="S5.SS1.p2.m1" class="ltx_Math" alttext="g(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(\cdot)</annotation></semantics></math> utilized by the PI-AttNP as a residual constraint in the PINN’s optimization. From an architecture standpoint, we modify the PINN model discussed in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib3" title="" class="ltx_ref">de Curtò and de Zarzà (2024)</a></cite> where the PINN utilizes an LSTM with a Bayesian last layer (BLL) <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib35" title="" class="ltx_ref">Tran et al. (2019)</a></cite> at its head to enable more robust MC dropout to quantify the uncertainty of model predictions. This PINN-LSTM also employs self-attention between previous states <math id="S5.SS1.p2.m2" class="ltx_Math" alttext="\hat{x}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\hat{x}_{k}</annotation></semantics></math> and control action <math id="S5.SS1.p2.m3" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math> to capture the interdependencies between these variables of interest to predict next states <math id="S5.SS1.p2.m4" class="ltx_Math" alttext="\hat{x}_{k+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>x</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\hat{x}_{k+1}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS1.p3" class="ltx_para">
<p id="S5.SS1.p3.1" class="ltx_p">In addition to these baselines, we also collect results from the standard attentive neural process (AttNP) to explicitly provide an ablation for physics model <math id="S5.SS1.p3.m1" class="ltx_Math" alttext="g(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(\cdot)</annotation></semantics></math> in the PI-AttNP’s learning. To observe parameter counts and wall compute time for all models, please refer to Tables <a href="#S7.T6" title="Table 6 ‣ 7.2 Real-Time Feasibility Discussion ‣ 7 Appendix ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> and <a href="#S7.T7" title="Table 7 ‣ 7.2 Real-Time Feasibility Discussion ‣ 7 Appendix ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> in the Appendix. For the direct model implementations, refer to our GitHub implementation link provided after Conclusions <a href="#S6.SSx3" title="Data Availability ‣ 6 Conclusion and Future Works ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</p>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2 </span>Quadrotor Dynamics Implementation</h3>

<div id="S5.SS2.p1" class="ltx_para">
<p id="S5.SS2.p1.2" class="ltx_p">Let the general nonlinear vector field to be determined <math id="S5.SS2.p1.m1" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, referenced in
<a href="#S2.E1" title="In 2 Problem Statement ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> be the 6-DOF, underactuated dynamics of a quadrotor where <math id="S5.SS2.p1.m2" class="ltx_Math" alttext="x\in\mathbb{R}^{12}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mn>12</mn></msup></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}^{12}</annotation></semantics></math> is <math id="S5.SS2.p1.m3" class="ltx_Math" alttext="x=\{\dot{r}^{I},\dot{v}^{I},\omega^{b},\dot{\omega}^{b}\}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mover accent="true"><mi>r</mi><mo>˙</mo></mover><mi>I</mi></msup><mo>,</mo><msup><mover accent="true"><mi>v</mi><mo>˙</mo></mover><mi>I</mi></msup><mo>,</mo><msup><mi>ω</mi><mi>b</mi></msup><mo>,</mo><msup><mover accent="true"><mi>ω</mi><mo>˙</mo></mover><mi>b</mi></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">x=\{\dot{r}^{I},\dot{v}^{I},\omega^{b},\dot{\omega}^{b}\}</annotation></semantics></math>, <math id="S5.SS2.p1.m4" class="ltx_Math" alttext="y_{k}\in\mathbb{R}^{6}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>k</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mn>6</mn></msup></mrow><annotation encoding="application/x-tex">y_{k}\in\mathbb{R}^{6}</annotation></semantics></math> is <math id="S5.SS2.p1.m5" class="ltx_Math" alttext="y_{k}=\{\dot{v}_{k}^{I},\omega_{k}^{b}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>k</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>v</mi><mo>˙</mo></mover><mi>k</mi><mi>I</mi></msubsup><mo>,</mo><msubsup><mi>ω</mi><mi>k</mi><mi>b</mi></msubsup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">y_{k}=\{\dot{v}_{k}^{I},\omega_{k}^{b}\}</annotation></semantics></math>, and <math id="S5.SS2.p1.m6" class="ltx_Math" alttext="\xi\in\mathbb{R}^{6}" display="inline" intent=":literal"><semantics><mrow><mi>ξ</mi><mo>∈</mo><msup><mi>ℝ</mi><mn>6</mn></msup></mrow><annotation encoding="application/x-tex">\xi\in\mathbb{R}^{6}</annotation></semantics></math> represents a noise vector with unknown multimodal Gaussian noise characteristics possessing additive/multiplicative properties that perturb observed states <math id="S5.SS2.p1.m7" class="ltx_Math" alttext="y_{k}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">y_{k}</annotation></semantics></math>. Note that in our reformulation of <math id="S5.SS2.p1.m8" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, we define translational velocities <math id="S5.SS2.p1.m9" class="ltx_Math" alttext="\dot{r}^{I}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>r</mi><mo>˙</mo></mover><mi>I</mi></msup><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\dot{r}^{I}\in\mathbb{R}^{3}</annotation></semantics></math> and accelerations <math id="S5.SS2.p1.m10" class="ltx_Math" alttext="\dot{v}^{I}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>v</mi><mo>˙</mo></mover><mi>I</mi></msup><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\dot{v}^{I}\in\mathbb{R}^{3}</annotation></semantics></math> in some defined inertial frame <math id="S5.SS2.p1.m11" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>. Additionally, we also define <math id="S5.SS2.p1.m12" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> to possess the body rates of the quadrotor <math id="S5.SS2.p1.m13" class="ltx_Math" alttext="\omega^{b}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ω</mi><mi>b</mi></msup><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\omega^{b}\in\mathbb{R}^{3}</annotation></semantics></math> and its time derivative <math id="S5.SS2.p1.m14" class="ltx_Math" alttext="\dot{\omega}^{b}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi>ω</mi><mo>˙</mo></mover><mi>b</mi></msup><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\dot{\omega}^{b}\in\mathbb{R}^{3}</annotation></semantics></math>, where both of these quantities are expressed in the quadrotor’s body frame <math id="S5.SS2.p1.m15" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>. Mathematically, these continuous-time dynamical states are modeled as:</p>
<table id="S5.E5" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E5X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E5X.m2" class="ltx_Math" alttext="\displaystyle\dot{r}^{I}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>r</mi><mo>˙</mo></mover><mi>I</mi></msup><annotation encoding="application/x-tex">\displaystyle\dot{r}^{I}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E5X.m3" class="ltx_Math" alttext="\displaystyle=v^{I}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mi>v</mi><mi>I</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle=v^{I}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(5)</span></td></tr>
<tr id="S5.E5Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E5Xa.m2" class="ltx_Math" alttext="\displaystyle\dot{v}^{I}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>v</mi><mo>˙</mo></mover><mi>I</mi></msup><annotation encoding="application/x-tex">\displaystyle\dot{v}^{I}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E5Xa.m3" class="ltx_Math" alttext="\displaystyle=\begin{bmatrix}0\\
0\\
-g\end{bmatrix}+\frac{1}{m}(R_{b}^{I}F_{m}^{b}+F_{\text{aero}})=a^{I}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mrow><mo>−</mo><mi>g</mi></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>m</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>R</mi><mi>b</mi><mi>I</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>F</mi><mi>m</mi><mi>b</mi></msubsup></mrow><mo>+</mo><msub><mi>F</mi><mtext>aero</mtext></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><msup><mi>a</mi><mi>I</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}0\\
0\\
-g\end{bmatrix}+\frac{1}{m}(R_{b}^{I}F_{m}^{b}+F_{\text{aero}})=a^{I}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E5Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E5Xb.m2" class="ltx_Math" alttext="\displaystyle\omega^{b}" display="inline" intent=":literal"><semantics><msup><mi>ω</mi><mi>b</mi></msup><annotation encoding="application/x-tex">\displaystyle\omega^{b}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E5Xb.m3" class="ltx_Math" alttext="\displaystyle=\begin{bmatrix}1&amp;0&amp;-s_{\theta}\\
0&amp;c_{\phi}&amp;c_{\theta}s_{\phi}\\
0&amp;-s_{\phi}&amp;c_{\theta}c_{\phi}\end{bmatrix}\dot{\Theta}^{b}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mrow><mo>−</mo><msub><mi>s</mi><mi>θ</mi></msub></mrow></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msub><mi>c</mi><mi>ϕ</mi></msub></mtd><mtd><mrow><msub><mi>c</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>ϕ</mi></msub></mrow></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><mo>−</mo><msub><mi>s</mi><mi>ϕ</mi></msub></mrow></mtd><mtd><mrow><msub><mi>c</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mi>ϕ</mi></msub></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>˙</mo></mover><mi>b</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}1&amp;0&amp;-s_{\theta}\\
0&amp;c_{\phi}&amp;c_{\theta}s_{\phi}\\
0&amp;-s_{\phi}&amp;c_{\theta}c_{\phi}\end{bmatrix}\dot{\Theta}^{b}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S5.E5Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E5Xc.m2" class="ltx_Math" alttext="\displaystyle\dot{\omega}^{b}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>ω</mi><mo>˙</mo></mover><mi>b</mi></msup><annotation encoding="application/x-tex">\displaystyle\dot{\omega}^{b}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E5Xc.m3" class="ltx_Math" alttext="\displaystyle=I^{-1}\left(\tau_{m}+\tau_{\text{aero}}-\tau_{g}-\omega^{b}\times I\omega^{b}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mi>I</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>τ</mi><mi>m</mi></msub><mo>+</mo><msub><mi>τ</mi><mtext>aero</mtext></msub></mrow><mo>−</mo><msub><mi>τ</mi><mi>g</mi></msub><mo>−</mo><mrow><mrow><msup><mi>ω</mi><mi>b</mi></msup><mo lspace="0.222em" rspace="0.222em">×</mo><mi>I</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>ω</mi><mi>b</mi></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=I^{-1}\left(\tau_{m}+\tau_{\text{aero}}-\tau_{g}-\omega^{b}\times I\omega^{b}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.p1.3" class="ltx_p">where <math id="S5.SS2.p1.m16" class="ltx_Math" alttext="c_{\ast}=\text{cos}(\ast)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mo>∗</mo></msub><mo>=</mo><mrow><mtext>cos</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{\ast}=\text{cos}(\ast)</annotation></semantics></math>, <math id="S5.SS2.p1.m17" class="ltx_Math" alttext="s_{\ast}=\text{sin}(\ast)" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mo>∗</mo></msub><mo>=</mo><mrow><mtext>sin</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">∗</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{\ast}=\text{sin}(\ast)</annotation></semantics></math>. We define <math id="S5.SS2.p1.m18" class="ltx_Math" alttext="\dot{\Theta}^{b}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>˙</mo></mover><mi>b</mi></msup><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\dot{\Theta}^{b}\in\mathbb{R}^{3}</annotation></semantics></math> as the time derivative of euler angles <math id="S5.SS2.p1.m19" class="ltx_Math" alttext="\Theta^{b}=\{\phi,\theta,\psi\}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Θ</mi><mi>b</mi></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>ϕ</mi><mo>,</mo><mi>θ</mi><mo>,</mo><mi>ψ</mi><mo stretchy="false">}</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\Theta^{b}=\{\phi,\theta,\psi\}\in\mathbb{R}^{3}</annotation></semantics></math> where roll <math id="S5.SS2.p1.m20" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math>, pitch <math id="S5.SS2.p1.m21" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math>, and yaw <math id="S5.SS2.p1.m22" class="ltx_Math" alttext="\psi" display="inline" intent=":literal"><semantics><mi>ψ</mi><annotation encoding="application/x-tex">\psi</annotation></semantics></math> are all expressed in body frame <math id="S5.SS2.p1.m23" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math>. Additionally, <math id="S5.SS2.p1.m24" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> is the acceleration due to gravity, <math id="S5.SS2.p1.m25" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> is the mass of the quadrotor, <math id="S5.SS2.p1.m26" class="ltx_Math" alttext="I\in\mathbb{R}^{3\times 3}" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">I\in\mathbb{R}^{3\times 3}</annotation></semantics></math> is the quadrotor’s inertia tensor, <math id="S5.SS2.p1.m27" class="ltx_Math" alttext="R_{b}^{I}\in\mathbb{R}^{3\times 3}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>b</mi><mi>I</mi></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">R_{b}^{I}\in\mathbb{R}^{3\times 3}</annotation></semantics></math> is a rotation matrix that transforms a vector in <math id="S5.SS2.p1.m28" class="ltx_Math" alttext="b\rightarrow I" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo stretchy="false">→</mo><mi>I</mi></mrow><annotation encoding="application/x-tex">b\rightarrow I</annotation></semantics></math>. It should be explicitly noted that for our purposes, we disregard position vector <math id="S5.SS2.p1.m29" class="ltx_Math" alttext="r^{I}" display="inline" intent=":literal"><semantics><msup><mi>r</mi><mi>I</mi></msup><annotation encoding="application/x-tex">r^{I}</annotation></semantics></math>, and we assume known, noisy Euler angles <math id="S5.SS2.p1.m30" class="ltx_Math" alttext="\widetilde{\Theta}^{b}=\Theta^{b}+N(0,0.1)" display="inline" intent=":literal"><semantics><mrow><msup><mover accent="true"><mi mathvariant="normal">Θ</mi><mo>~</mo></mover><mi>b</mi></msup><mo>=</mo><mrow><msup><mi mathvariant="normal">Θ</mi><mi>b</mi></msup><mo>+</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0.1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\Theta}^{b}=\Theta^{b}+N(0,0.1)</annotation></semantics></math> to enforce that all models are only being tasked to estimate the higher order dynamics as seen in equations <a href="#S5.E5" title="In 5.2 Quadrotor Dynamics Implementation ‣ 5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
<div id="S5.SS2.p2" class="ltx_para">
<p id="S5.SS2.p2.2" class="ltx_p">Regarding modeled forces and torques, <math id="S5.SS2.p2.m1" class="ltx_Math" alttext="F_{m}^{b}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>F</mi><mi>m</mi><mi>b</mi></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">F_{m}^{b}\in\mathbb{R}^{3}</annotation></semantics></math> is the quadrotor’s thrust vector expressed in the body frame that is produced from individual rotor velocities <math id="S5.SS2.p2.m2" class="ltx_Math" alttext="\bar{\omega}\in\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mo>∈</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">\bar{\omega}\in\mathbb{R}^{4}</annotation></semantics></math>, and <math id="S5.SS2.p2.m3" class="ltx_Math" alttext="\tau_{m}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>m</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\tau_{m}\in\mathbb{R}^{3}</annotation></semantics></math> are the torques that affect the quadrotor as a result of <math id="S5.SS2.p2.m4" class="ltx_Math" alttext="\bar{\omega}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\omega}</annotation></semantics></math>. Along with these, <math id="S5.SS2.p2.m5" class="ltx_Math" alttext="\tau_{g}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mi>g</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">\tau_{g}\in\mathbb{R}^{3}</annotation></semantics></math> are the gyroscopic torque effects. The internal forces and torques <math id="S5.SS2.p2.m6" class="ltx_Math" alttext="F_{m}^{b},\;\tau_{m},\;\tau_{g}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>F</mi><mi>m</mi><mi>b</mi></msubsup><mo rspace="0.447em">,</mo><msub><mi>τ</mi><mi>m</mi></msub><mo rspace="0.447em">,</mo><msub><mi>τ</mi><mi>g</mi></msub></mrow><annotation encoding="application/x-tex">F_{m}^{b},\;\tau_{m},\;\tau_{g}</annotation></semantics></math> acting on the body are modeled as:</p>
<table id="S5.E6" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S5.E6X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E6X.m2" class="ltx_Math" alttext="\displaystyle F_{m}^{b}" display="inline" intent=":literal"><semantics><msubsup><mi>F</mi><mi>m</mi><mi>b</mi></msubsup><annotation encoding="application/x-tex">\displaystyle F_{m}^{b}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E6X.m3" class="ltx_Math" alttext="\displaystyle=k_{T}\sum_{i=1}^{4}\begin{bmatrix}0\\
0\\
\bar{\omega}_{i}^{2}\end{bmatrix},\quad\tau_{g}=\sum_{i=1}^{4}(-1)^{i+1}\bar{\omega}_{i}\begin{bmatrix}I_{r}qI_{xx}^{-1}\\
I_{r}pI_{yy}^{-1}\\
0\end{bmatrix}," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>k</mi><msub><mrow></mrow><mi>T</mi></msub><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mn>4</mn></msup><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr><mtr><mtd><msubsup><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mi>i</mi><mn>2</mn></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo rspace="1.167em">,</mo><mi>τ</mi><msub><mrow></mrow><mi>g</mi></msub><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mn>4</mn></msup><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><msub><mrow></mrow><mi>i</mi></msub><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><msub><mi>I</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi>I</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>I</mi><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mtd></mtr><mtr><mtd><mn>0</mn></mtd></mtr></mtable><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=k_{T}\sum_{i=1}^{4}\begin{bmatrix}0\\
0\\
\bar{\omega}_{i}^{2}\end{bmatrix},\quad\tau_{g}=\sum_{i=1}^{4}(-1)^{i+1}\bar{\omega}_{i}\begin{bmatrix}I_{r}qI_{xx}^{-1}\\
I_{r}pI_{yy}^{-1}\\
0\end{bmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(6)</span></td></tr>
<tr id="S5.E6Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.E6Xa.m2" class="ltx_Math" alttext="\displaystyle\text{and}\quad\tau_{m}" display="inline" intent=":literal"><semantics><mrow><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><msub><mi>τ</mi><mi>m</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\text{and}\quad\tau_{m}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.E6Xa.m3" class="ltx_Math" alttext="\displaystyle=\begin{bmatrix}\tau_{\phi}\\
\tau_{\theta}\\
\tau_{\psi}\end{bmatrix}=\begin{bmatrix}Lk_{T}(\bar{\omega}_{1}^{2}-\bar{\omega}_{3}^{2})\\
Lk_{T}(\bar{\omega}_{2}^{2}-\bar{\omega}_{4}^{2})\\
b\sum_{i=1}^{4}(-1)^{i+1}\bar{\omega}_{i}^{2}\end{bmatrix}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>τ</mi><mi>ϕ</mi></msub></mtd></mtr><mtr><mtd><msub><mi>τ</mi><mi>θ</mi></msub></mtd></mtr><mtr><mtd><msub><mi>τ</mi><mi>ψ</mi></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>=</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mn>1</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mn>3</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mn>4</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mn>4</mn></msubsup><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mi>i</mi><mn>2</mn></msubsup></mrow></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}\tau_{\phi}\\
\tau_{\theta}\\
\tau_{\psi}\end{bmatrix}=\begin{bmatrix}Lk_{T}(\bar{\omega}_{1}^{2}-\bar{\omega}_{3}^{2})\\
Lk_{T}(\bar{\omega}_{2}^{2}-\bar{\omega}_{4}^{2})\\
b\sum_{i=1}^{4}(-1)^{i+1}\bar{\omega}_{i}^{2}\end{bmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS2.p2.3" class="ltx_p">where <math id="S5.SS2.p2.m7" class="ltx_Math" alttext="k_{T}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mi>T</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">k_{T}&gt;0</annotation></semantics></math> and <math id="S5.SS2.p2.m8" class="ltx_Math" alttext="b&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b&gt;0</annotation></semantics></math> are the thrust and drag coefficients, respectively, <math id="S5.SS2.p2.m9" class="ltx_Math" alttext="L&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L&gt;0</annotation></semantics></math> represents the distance between each rotor and the center of the quadrotor and <math id="S5.SS2.p2.m10" class="ltx_Math" alttext="I_{r}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>r</mi></msub><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">I_{r}\in\mathbb{R}</annotation></semantics></math> represent the rotor moment of inertia. Also, <math id="S5.SS2.p2.m11" class="ltx_Math" alttext="I_{xx},I_{yy}\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mrow><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>,</mo><mrow><msub><mi>I</mi><mrow><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></msub><mo>∈</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">I_{xx},I_{yy}\in\mathbb{R}</annotation></semantics></math> are the first and second diagonal components of <math id="S5.SS2.p2.m12" class="ltx_Math" alttext="I" display="inline" intent=":literal"><semantics><mi>I</mi><annotation encoding="application/x-tex">I</annotation></semantics></math>, and <math id="S5.SS2.p2.m13" class="ltx_Math" alttext="p,q\in\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>,</mo><mi>q</mi></mrow><mo>∈</mo><mi>ℝ</mi></mrow><annotation encoding="application/x-tex">p,q\in\mathbb{R}</annotation></semantics></math> are the <math id="S5.SS2.p2.m14" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> and <math id="S5.SS2.p2.m15" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> components of <math id="S5.SS2.p2.m16" class="ltx_Math" alttext="\omega_{b}" display="inline" intent=":literal"><semantics><msub><mi>ω</mi><mi>b</mi></msub><annotation encoding="application/x-tex">\omega_{b}</annotation></semantics></math>.</p>
</div>
<div id="S5.SS2.p3" class="ltx_para">
<p id="S5.SS2.p3.1" class="ltx_p"><math id="S5.SS2.p3.m1" class="ltx_Math" alttext="F_{\text{aero}},\tau_{\text{aero}}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mtext>aero</mtext></msub><mo>,</mo><mrow><msub><mi>τ</mi><mtext>aero</mtext></msub><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow></mrow><annotation encoding="application/x-tex">F_{\text{aero}},\tau_{\text{aero}}\in\mathbb{R}^{3}</annotation></semantics></math> observed in Equation (<a href="#S5.E5" title="In 5.2 Quadrotor Dynamics Implementation ‣ 5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) are the sum of external forces and torques acting on the quadrotor’s body, respectively. Note that <math id="S5.SS2.p3.m2" class="ltx_Math" alttext="F_{\text{aero}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mtext>aero</mtext></msub><annotation encoding="application/x-tex">F_{\text{aero}}</annotation></semantics></math> and <math id="S5.SS2.p3.m3" class="ltx_Math" alttext="\tau_{\text{aero}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mtext>aero</mtext></msub><annotation encoding="application/x-tex">\tau_{\text{aero}}</annotation></semantics></math> are computed from <math id="S5.SS2.p3.m4" class="ltx_Math" alttext="v_{w}\in\mathbb{R}^{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>w</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mn>3</mn></msup></mrow><annotation encoding="application/x-tex">v_{w}\in\mathbb{R}^{3}</annotation></semantics></math> (wind velocity) where components of <math id="S5.SS2.p3.m5" class="ltx_Math" alttext="v_{w}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>w</mi></msub><annotation encoding="application/x-tex">v_{w}</annotation></semantics></math> are bounded such that <math id="S5.SS2.p3.m6" class="ltx_Math" alttext="v_{w}\sim[v_{w(\text{min})},v_{w(\text{max})}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>w</mi></msub><mo>∼</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>v</mi><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>min</mtext><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>max</mtext><mo stretchy="false">)</mo></mrow></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">v_{w}\sim[v_{w(\text{min})},v_{w(\text{max})}]</annotation></semantics></math> and all of these quantities are modeled directly from the disturbance equations found in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib36" title="" class="ltx_ref">Yu et al. (2023)</a></cite>. Note that other nonlinear, external effects typically faced during quadrotor flight (i.e. blade flapping, induced drag, and ground-effect) are also modeled in <math id="S5.SS2.p3.m7" class="ltx_Math" alttext="\Delta x_{k}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\Delta x_{k}</annotation></semantics></math> according to the disturbance models described in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib36" title="" class="ltx_ref">Yu et al. (2023)</a></cite>. We also incorporate randomly-occuring rotor spiking phenomena where unobserved, uniformly-distributed rotor perturbations <math id="S5.SS2.p3.m8" class="ltx_Math" alttext="\bar{\omega}+\Delta\bar{\omega}\in\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mo>+</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ω</mi><mo>¯</mo></mover></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">\bar{\omega}+\Delta\bar{\omega}\in\mathbb{R}^{4}</annotation></semantics></math> where <math id="S5.SS2.p3.m9" class="ltx_Math" alttext="\Delta\bar{\omega}\sim U(-|\Delta\bar{\omega}_{\text{max}}|,|\Delta\bar{\omega}_{\text{max}}|)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>ω</mi><mo>¯</mo></mover></mrow><mo>∼</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mtext>max</mtext></msub></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>,</mo><mrow><mo stretchy="false">|</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mtext>max</mtext></msub></mrow><mo stretchy="false">|</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta\bar{\omega}\sim U(-|\Delta\bar{\omega}_{\text{max}}|,|\Delta\bar{\omega}_{\text{max}}|)</annotation></semantics></math> are applied to observed rotor velocity signal <math id="S5.SS2.p3.m10" class="ltx_Math" alttext="\bar{\omega}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{\omega}</annotation></semantics></math> given to models. In this way, we denote the main time-varying, perturbation parameters of the simulation <math id="S5.SS2.p3.m11" class="ltx_Math" alttext="\Delta x_{k}=\{v_{w},\Delta\bar{\omega}_{k}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>w</mi></msub><mo>,</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta x_{k}=\{v_{w},\Delta\bar{\omega}_{k}\}</annotation></semantics></math> along with modeled multimodal Gaussian noise <math id="S5.SS2.p3.m12" class="ltx_Math" alttext="\xi_{k}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\xi_{k}</annotation></semantics></math> applied to observed states <math id="S5.SS2.p3.m13" class="ltx_Math" alttext="y_{k}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">y_{k}</annotation></semantics></math>. To obtain a deeper understanding of the generation procedure for <math id="S5.SS2.p3.m14" class="ltx_Math" alttext="\xi_{k}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\xi_{k}</annotation></semantics></math> and how it is applied to observed states <math id="S5.SS2.p3.m15" class="ltx_Math" alttext="y_{k}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">y_{k}</annotation></semantics></math>, observe Algorithm <a href="#alg5" title="Algorithm 5 ‣ 7.3 Noise Generation Implementation for 𝜉_𝑘 ‣ 7 Appendix ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> and related discussions in the Appendix.</p>
</div>
<div id="S5.SS2.p4" class="ltx_para">
<p id="S5.SS2.p4.1" class="ltx_p">A representative diagram of the described simulated environment used in this study can be seen in Figure <a href="#S5.F2" title="Figure 2 ‣ 5.2 Quadrotor Dynamics Implementation ‣ 5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. To observe the complete implementation of the quadrotor dynamics with incorporated noise vector <math id="S5.SS2.p4.m1" class="ltx_Math" alttext="\xi_{k}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\xi_{k}</annotation></semantics></math> and all state disturbances <math id="S5.SS2.p4.m2" class="ltx_Math" alttext="\Delta x_{k}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\Delta x_{k}</annotation></semantics></math>, refer to our Github implementation with the link provided towards the end of the article <a href="#S6.SSx3" title="Data Availability ‣ 6 Conclusion and Future Works ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. The perturbation limits for disturbances <math id="S5.SS2.p4.m3" class="ltx_Math" alttext="\Delta x_{k}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\Delta x_{k}</annotation></semantics></math> experienced during the generation of meta dataset <math id="S5.SS2.p4.m4" class="ltx_Math" alttext="\mathcal{D}_{\text{meta}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>meta</mtext></msub><annotation encoding="application/x-tex">\mathcal{D}_{\text{meta}}</annotation></semantics></math> can be observed in Table <a href="#S5.T1" title="Table 1 ‣ 5.2 Quadrotor Dynamics Implementation ‣ 5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. The main objective of our novel PI-AttNP algorithm estimates the states of the quadrotor system presented in Equations (<a href="#S5.E5" title="In 5.2 Quadrotor Dynamics Implementation ‣ 5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) and (<a href="#S5.E6" title="In 5.2 Quadrotor Dynamics Implementation ‣ 5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) with no prior knowledge of sensor noise properties <math id="S5.SS2.p4.m5" class="ltx_Math" alttext="\xi_{k}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\xi_{k}</annotation></semantics></math> nor environmental disturbances acting on the quadrotor <math id="S5.SS2.p4.m6" class="ltx_Math" alttext="\Delta x_{k}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\Delta x_{k}</annotation></semantics></math>. This indicates that the utilized kinematic model <math id="S5.SS2.p4.m7" class="ltx_Math" alttext="g(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(\cdot)</annotation></semantics></math> mentioned in the Problem Statement <a href="#S2" title="2 Problem Statement ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and Algorithm <a href="#alg1" title="Algorithm 1 ‣ 4.2 Model Optimization Algorithm ‣ 4 Methodology ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> consists of the equations found in <a href="#S5.E5" title="In 5.2 Quadrotor Dynamics Implementation ‣ 5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> and <a href="#S5.E6" title="In 5.2 Quadrotor Dynamics Implementation ‣ 5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a> with no knowledge of <math id="S5.SS2.p4.m8" class="ltx_Math" alttext="F_{\text{aero}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mtext>aero</mtext></msub><annotation encoding="application/x-tex">F_{\text{aero}}</annotation></semantics></math> nor <math id="S5.SS2.p4.m9" class="ltx_Math" alttext="\tau_{\text{aero}}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mtext>aero</mtext></msub><annotation encoding="application/x-tex">\tau_{\text{aero}}</annotation></semantics></math>.</p>
</div>
<figure id="S5.T1" class="ltx_table">
