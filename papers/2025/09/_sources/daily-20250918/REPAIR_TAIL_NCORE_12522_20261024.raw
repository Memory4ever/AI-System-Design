<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> PI-AttNP Recursive Inference Algorithm</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <math id="alg2.l1.m1" class="ltx_Math" alttext="\hat{f}_{\Gamma}(\cdot),\;g(\cdot),\;\mathcal{D}_{k},\;q_{\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi mathvariant="normal">Γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.447em">,</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.447em">,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>k</mi></msub><mo rspace="0.447em">,</mo><msub><mi>q</mi><mi>α</mi></msub></mrow><annotation encoding="application/x-tex">\hat{f}_{\Gamma}(\cdot),\;g(\cdot),\;\mathcal{D}_{k},\;q_{\alpha}</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
