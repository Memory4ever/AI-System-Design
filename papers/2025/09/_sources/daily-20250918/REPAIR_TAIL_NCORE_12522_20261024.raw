<td id="S7.T8.3.4.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><math id="S7.T8.m6" class="ltx_Math" alttext="m/s^{2}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>/</mo><msup><mi>s</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">m/s^{2}</annotation></semantics></math></td>
