</figure>
<figure id="S5.F2" class="ltx_figure">
<p id="S5.F2.3" class="ltx_p ltx_align_center"><span id="S5.F2.3.1" class="ltx_text ltx_framed ltx_framed_rectangle" style="--ltx-border-color:#000000;padding:0.0pt;border-width:0.5pt;"><img src="2509.12522v1/Project_Images/quadrotor-dynamics-diagram.png" id="S5.F2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:755/454;" width="755" height="454" alt="Refer to caption"></span></p>
