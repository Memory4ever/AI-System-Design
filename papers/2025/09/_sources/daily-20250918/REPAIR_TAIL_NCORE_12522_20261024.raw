<th id="S5.T1.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t">Min</th>
<th id="S5.T1.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t">Max</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T1.3.2" class="ltx_tr">
<td id="S5.T1.3.2.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t"><math id="S5.T1.m1" class="ltx_Math" alttext="v_{w}\;\;(m/s)" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>w</mi></msub><mo lspace="0.560em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>/</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">v_{w}\;\;(m/s)</annotation></semantics></math></td>
