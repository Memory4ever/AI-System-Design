</div>
<div id="alg5.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
            <math id="alg5.l5.m1" class="ltx_Math" alttext="n_{\text{peaks}}\sim U(2,n_{\text{max}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mtext>peaks</mtext></msub><mo>∼</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><msub><mi>n</mi><mtext>max</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">n_{\text{peaks}}\sim U(2,n_{\text{max}})</annotation></semantics></math>

</div>
<div id="alg5.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            <math id="alg5.l6.m1" class="ltx_Math" alttext="w\leftarrow U(0,1)\in\mathbb{R}^{n_{\text{peaks}}}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo stretchy="false">←</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>n</mi><mtext>peaks</mtext></msub></msup></mrow><annotation encoding="application/x-tex">w\leftarrow U(0,1)\in\mathbb{R}^{n_{\text{peaks}}}</annotation></semantics></math>

</div>
<div id="alg5.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            <math id="alg5.l7.m1" class="ltx_Math" alttext="w\leftarrow w\;/\;\|w\|" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo stretchy="false">←</mo><mrow><mi>w</mi><mo lspace="0.502em" rspace="0.502em">/</mo><mrow><mo stretchy="false">‖</mo><mi>w</mi><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w\leftarrow w\;/\;\|w\|</annotation></semantics></math> <span id="alg5.l7.3" class="ltx_text" style="float:right;"><math id="alg5.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> To ensure <math id="alg5.l7.m3" class="ltx_Math" alttext="\sum w=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo>∑</mo><mi>w</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum w=1</annotation></semantics></math>
</span>
</div>
<div id="alg5.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            <span id="alg5.l8.3" class="ltx_text ltx_font_bold">for</span> <math id="alg5.l8.m1" class="ltx_Math" alttext="peak" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">peak</annotation></semantics></math> in <span id="alg5.l8.4" class="ltx_text ltx_font_italic">range<math id="alg5.l8.m2" class="ltx_Math" alttext="(n_{\text{peaks}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mtext>peaks</mtext></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n_{\text{peaks}})</annotation></semantics></math></span> <span id="alg5.l8.5" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg5.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
              <span id="alg5.l9.3" class="ltx_text ltx_font_bold">Computing Gaussian Parameters for Each Peak</span>

</div>
<div id="alg5.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
              <math id="alg5.l10.m1" class="ltx_Math" alttext="N_{\text{peak}}=N_{\text{total}}\times w[peak]" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mtext>peak</mtext></msub><mo>=</mo><mrow><msub><mi>N</mi><mtext>total</mtext></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">N_{\text{peak}}=N_{\text{total}}\times w[peak]</annotation></semantics></math>

</div>
<div id="alg5.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
              <math id="alg5.l11.m1" class="ltx_Math" alttext="\mu_{\text{peak}}\sim U(\mu_{\xi(\text{min})},\mu_{\xi(\text{max})})\in\mathbb{R}^{o}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mtext>peak</mtext></msub><mo>∼</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>min</mtext><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msub><mi>μ</mi><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>max</mtext><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>o</mi></msup></mrow><annotation encoding="application/x-tex">\mu_{\text{peak}}\sim U(\mu_{\xi(\text{min})},\mu_{\xi(\text{max})})\in\mathbb{R}^{o}</annotation></semantics></math>

</div>
<div id="alg5.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
              <math id="alg5.l12.m1" class="ltx_Math" alttext="\sigma_{\text{peak}}\sim U(\sigma_{\xi(\text{min})},\sigma_{\xi(\text{max})})\in\mathbb{R}^{o}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mtext>peak</mtext></msub><mo>∼</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>min</mtext><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msub><mi>σ</mi><mrow><mi>ξ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>max</mtext><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>o</mi></msup></mrow><annotation encoding="application/x-tex">\sigma_{\text{peak}}\sim U(\sigma_{\xi(\text{min})},\sigma_{\xi(\text{max})})\in\mathbb{R}^{o}</annotation></semantics></math> 
</div>
<div id="alg5.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
            
</div>
<div id="alg5.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
              <span id="alg5.l14.3" class="ltx_text ltx_font_bold">Sampling <math id="alg5.l14.m1" class="ltx_Math" alttext="N_{\text{peak}}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mtext class="ltx_mathvariant_bold">peak</mtext></msub><annotation encoding="application/x-tex">N_{\text{peak}}</annotation></semantics></math> Data Points from Defined Gaussian</span>

</div>
<div id="alg5.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
              <span id="alg5.l15.3" class="ltx_text ltx_font_bold">and Storing Them into Array <math id="alg5.l15.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math></span>

</div>
<div id="alg5.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
              <math id="alg5.l16.m1" class="ltx_Math" alttext="g\sim N(\mu_{\text{peak}},\sigma_{\text{peak}})\in\mathbb{R}^{N_{\text{peak}}\times o}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∼</mo><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>μ</mi><mtext>peak</mtext></msub><mo>,</mo><msub><mi>σ</mi><mtext>peak</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>N</mi><mtext>peak</mtext></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mi>o</mi></mrow></msup></mrow><annotation encoding="application/x-tex">g\sim N(\mu_{\text{peak}},\sigma_{\text{peak}})\in\mathbb{R}^{N_{\text{peak}}\times o}</annotation></semantics></math>

</div>
<div id="alg5.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
              <math id="alg5.l17.m1" class="ltx_Math" alttext="\mathcal{G}\leftarrow\mathcal{G}.\text{concatenate}(g)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext>concatenate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}\leftarrow\mathcal{G}.\text{concatenate}(g)</annotation></semantics></math> 
</div>
<div id="alg5.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
              
            <span id="alg5.l18.3" class="ltx_text ltx_font_bold">end</span> <span id="alg5.l18.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg5.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
            <span id="alg5.l19.3" class="ltx_text ltx_font_bold">Randomly-Selecting Single Noise Vector from <math id="alg5.l19.m1" class="ltx_Math" alttext="\mathcal{G}\in\mathbb{R}^{N_{\text{total}}\;\times\;o}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><msub><mi>N</mi><mtext>total</mtext></msub><mo lspace="0.502em" rspace="0.502em">×</mo><mi>o</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{G}\in\mathbb{R}^{N_{\text{total}}\;\times\;o}</annotation></semantics></math></span>

</div>
<div id="alg5.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
            <math id="alg5.l20.m1" class="ltx_Math" alttext="\xi_{k}\leftarrow\mathcal{G}.\text{sample}()\in\mathbb{R}^{o}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">←</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mrow><mtext>sample</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>o</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\xi_{k}\leftarrow\mathcal{G}.\text{sample}()\in\mathbb{R}^{o}</annotation></semantics></math> 
</div>
<div id="alg5.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
              
            
</div>
<div id="alg5.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
            <span id="alg5.l22.3" class="ltx_text ltx_font_bold">Applying Sampled Noise Vector <math id="alg5.l22.m1" class="ltx_Math" alttext="\xi_{k}" display="inline" intent=":literal"><semantics><msub><mi>ξ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\xi_{k}</annotation></semantics></math> to Observed States <math id="alg5.l22.m2" class="ltx_Math" alttext="y_{k}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">y_{k}</annotation></semantics></math></span>

</div>
<div id="alg5.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
              
              
            <math id="alg5.l23.m1" class="ltx_Math" alttext="y_{k}\leftarrow y_{k}+\xi_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>k</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>y</mi><mi>k</mi></msub><mo>+</mo><msub><mi>ξ</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">y_{k}\leftarrow y_{k}+\xi_{k}</annotation></semantics></math>

</div>
<div id="alg5.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
              
            <math id="alg5.l24.m1" class="ltx_Math" alttext="y_{k}\leftarrow y_{k}\times(1+s_{\text{motion}}\;\times\;y_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mi>k</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>y</mi><mi>k</mi></msub><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><msub><mi>s</mi><mtext>motion</mtext></msub><mo lspace="0.222em" rspace="0.502em">×</mo><msub><mi>y</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y_{k}\leftarrow y_{k}\times(1+s_{\text{motion}}\;\times\;y_{k})</annotation></semantics></math>

</div>
<div id="alg5.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg5.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
              
              
            <span id="alg5.l25.3" class="ltx_text ltx_font_bold">return</span> <math id="alg5.l25.m1" class="ltx_Math" alttext="y_{k}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">y_{k}</annotation></semantics></math>

</div>
</div>
</figure>
<figure id="S7.F6" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.12522v1/Project_Images/ydot_compare_models.png" id="S7.F6.g1" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/216;" width="229" height="216" alt="Refer to caption"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.12522v1/Project_Images/omegay_compare_models.png" id="S7.F6.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/216;" width="229" height="216" alt="Refer to caption"></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.12522v1/Project_Images/zdot_compare_models.png" id="S7.F6.g3" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/216;" width="229" height="216" alt="Refer to caption"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.12522v1/Project_Images/omegaz_compare_models.png" id="S7.F6.g4" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/216;" width="229" height="216" alt="Refer to caption"></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.12522v1/Project_Images/yddot_compare_models.png" id="S7.F6.g5" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/216;" width="229" height="216" alt="Refer to caption"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.12522v1/Project_Images/omegaydot_compare_models.png" id="S7.F6.g6" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/216;" width="229" height="216" alt="Refer to caption"></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.12522v1/Project_Images/zddot_compare_models.png" id="S7.F6.g7" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/216;" width="229" height="216" alt="Refer to caption"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.12522v1/Project_Images/omegazdot_compare_models.png" id="S7.F6.g8" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/216;" width="229" height="216" alt="Refer to caption"></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S7.F6.3" class="ltx_text" style="font-size:90%;">Figure 6</span>: </span><span id="S7.F6.4" class="ltx_text" style="font-size:90%;">Y/Z-direction translational velocities and accelerations <math id="S7.F6.m6" class="ltx_Math" alttext="v_{y}^{I},v_{z}^{I},a_{y}^{I},a_{z}^{I}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>v</mi><mi>y</mi><mi>I</mi></msubsup><mo>,</mo><msubsup><mi>v</mi><mi>z</mi><mi>I</mi></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>y</mi><mi>I</mi></msubsup><mo>,</mo><msubsup><mi>a</mi><mi>z</mi><mi>I</mi></msubsup></mrow><annotation encoding="application/x-tex">v_{y}^{I},v_{z}^{I},a_{y}^{I},a_{z}^{I}</annotation></semantics></math> along with Y/Z-direction rotational velocity and accelerations <math id="S7.F6.m7" class="ltx_Math" alttext="\omega_{y}^{b},\omega_{z}^{b},\dot{\omega}_{y}^{b},\dot{\omega}_{z}^{b}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ω</mi><mi>y</mi><mi>b</mi></msubsup><mo>,</mo><msubsup><mi>ω</mi><mi>z</mi><mi>b</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>ω</mi><mo mathsize="1.110em">˙</mo></mover><mi>y</mi><mi>b</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>ω</mi><mo mathsize="1.110em">˙</mo></mover><mi>z</mi><mi>b</mi></msubsup></mrow><annotation encoding="application/x-tex">\omega_{y}^{b},\omega_{z}^{b},\dot{\omega}_{y}^{b},\dot{\omega}_{z}^{b}</annotation></semantics></math> state trajectory comparisons to ground-truth (black) between the PI-AttNP (blue) w/ CP-based confidence bounds <math id="S7.F6.m8" class="ltx_math_unparsed" alttext="\pm q_{\alpha}\cdot\sigma_{T}" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mi>q</mi><msub><mrow></mrow><mi>α</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>σ</mi><msub><mrow></mrow><mi>T</mi></msub></mrow><annotation encoding="application/x-tex">\pm q_{\alpha}\cdot\sigma_{T}</annotation></semantics></math> (dotted-blue), AttNP (yellow) <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib7" title="" class="ltx_ref">Kim et al. (2019)</a></cite>, Deep Kalman Filter (red) <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib34" title="" class="ltx_ref">Ma et al. (2024)</a></cite>, PINN-LSTM (green) <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib3" title="" class="ltx_ref">de Curtò and de Zarzà (2024)</a></cite>, and hand-tuned covariance UKF (magenta). Note that perturbation parameters used above are <math id="S7.F6.m9" class="ltx_Math" alttext="v_{w}=50\begin{bmatrix}1&amp;-1&amp;1\end{bmatrix}\;m/s" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>w</mi></msub><mo>=</mo><mrow><mrow><mn>50</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable columnspacing="5pt"><mtr><mtd><mn>1</mn></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>/</mo><mi>s</mi></mrow></mrow><annotation encoding="application/x-tex">v_{w}=50\begin{bmatrix}1&amp;-1&amp;1\end{bmatrix}\;m/s</annotation></semantics></math>, <math id="S7.F6.m10" class="ltx_Math" alttext="|\Delta\bar{\omega}_{\text{max}}|=200\;rad/s" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ω</mi><mo mathsize="1.110em">¯</mo></mover><mtext>max</mtext></msub></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mrow><mn>200</mn><mo lspace="0.280em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>/</mo><mi>s</mi></mrow></mrow><annotation encoding="application/x-tex">|\Delta\bar{\omega}_{\text{max}}|=200\;rad/s</annotation></semantics></math>. Observe numerical results of all models in Table <a href="#S5.T5" title="Table 5 ‣ 5.5 Convergence Dynamics ‣ 5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</span></figcaption>
</figure>
