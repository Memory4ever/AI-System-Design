<td id="S7.T8.3.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.5</td>
<td id="S7.T8.3.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">1.0</td></tr>
