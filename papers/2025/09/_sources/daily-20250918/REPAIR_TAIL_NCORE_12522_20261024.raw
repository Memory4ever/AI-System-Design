</figure>
</section>
<section id="S5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.3 </span>Context/Target Formulation</h3>

<div id="S5.SS3.p1" class="ltx_para">
<p id="S5.SS3.p1.1" class="ltx_p">In our discussion of the problem, note that the previously referenced context and target notation found in the Methodology <a href="#S4" title="4 Methodology ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> with <math id="S5.SS3.p1.m1" class="ltx_Math" alttext="N_{C}=N_{T}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>C</mi></msub><mo>=</mo><msub><mi>N</mi><mi>T</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">N_{C}=N_{T}=1</annotation></semantics></math> describe the following:</p>
<table id="S5.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex26.m1" class="ltx_Math" alttext="\displaystyle x_{C}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>C</mi></msub><annotation encoding="application/x-tex">\displaystyle x_{C}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex26.m2" class="ltx_Math" alttext="\displaystyle=\left\{t_{k},\bar{\omega}_{k}\right\}\in\mathbb{R}^{5}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><msub><mi>t</mi><mi>k</mi></msub><mo>,</mo><msub><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>}</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mn>5</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\left\{t_{k},\bar{\omega}_{k}\right\}\in\mathbb{R}^{5}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex27.m1" class="ltx_Math" alttext="\displaystyle y_{C}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>C</mi></msub><annotation encoding="application/x-tex">\displaystyle y_{C}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex27.m2" class="ltx_Math" alttext="\displaystyle=\left\{\dot{r}_{k}^{I},\dot{v}_{k}^{I},\omega_{k}^{b},\dot{\omega}_{k}^{b}\right\}\in\mathbb{R}^{12}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mrow><msubsup><mover accent="true"><mi>r</mi><mo>˙</mo></mover><mi>k</mi><mi>I</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>v</mi><mo>˙</mo></mover><mi>k</mi><mi>I</mi></msubsup><mo>,</mo><msubsup><mi>ω</mi><mi>k</mi><mi>b</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>ω</mi><mo>˙</mo></mover><mi>k</mi><mi>b</mi></msubsup></mrow><mo>}</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mn>12</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\left\{\dot{r}_{k}^{I},\dot{v}_{k}^{I},\omega_{k}^{b},\dot{\omega}_{k}^{b}\right\}\in\mathbb{R}^{12}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex28.m1" class="ltx_Math" alttext="\displaystyle x_{T}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\displaystyle x_{T}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex28.m2" class="ltx_Math" alttext="\displaystyle=\left\{t_{k+1},\textbf{0}\right\}\in\mathbb{R}^{5}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mtext class="ltx_mathvariant_bold">0</mtext><mo>}</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mn>5</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\left\{t_{k+1},\textbf{0}\right\}\in\mathbb{R}^{5}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex29.m1" class="ltx_Math" alttext="\displaystyle y_{T}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\displaystyle y_{T}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex29.m2" class="ltx_Math" alttext="\displaystyle=\left\{\dot{r}_{k+1}^{I},\dot{v}_{k+1}^{I},\omega_{k+1}^{b},\dot{\omega}_{k+1}^{b}\right\}\in\mathbb{R}^{12}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mrow><msubsup><mover accent="true"><mi>r</mi><mo>˙</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>I</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>v</mi><mo>˙</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>I</mi></msubsup><mo>,</mo><msubsup><mi>ω</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>b</mi></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>ω</mi><mo>˙</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mi>b</mi></msubsup></mrow><mo>}</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mn>12</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left\{\dot{r}_{k+1}^{I},\dot{v}_{k+1}^{I},\omega_{k+1}^{b},\dot{\omega}_{k+1}^{b}\right\}\in\mathbb{R}^{12},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS3.p1.2" class="ltx_p">where <math id="S5.SS3.p1.m2" class="ltx_Math" alttext="t_{k}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>k</mi></msub><annotation encoding="application/x-tex">t_{k}</annotation></semantics></math> and <math id="S5.SS3.p1.m3" class="ltx_Math" alttext="t_{k+1}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">t_{k+1}</annotation></semantics></math> represents previous and next simulation time stamps and <math id="S5.SS3.p1.m4" class="ltx_Math" alttext="\textbf{0}\in\mathbb{R}^{4}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_bold">0</mtext><mo>∈</mo><msup><mi>ℝ</mi><mn>4</mn></msup></mrow><annotation encoding="application/x-tex">\textbf{0}\in\mathbb{R}^{4}</annotation></semantics></math> are padded zeros used to ensure size consistency between <math id="S5.SS3.p1.m5" class="ltx_Math" alttext="x_{C}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>C</mi></msub><annotation encoding="application/x-tex">x_{C}</annotation></semantics></math> and <math id="S5.SS3.p1.m6" class="ltx_Math" alttext="x_{T}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>T</mi></msub><annotation encoding="application/x-tex">x_{T}</annotation></semantics></math>. The inclusion of <math id="S5.SS3.p1.m7" class="ltx_Math" alttext="\bar{\omega}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ω</mi><mo>¯</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\bar{\omega}_{k}</annotation></semantics></math> in <math id="S5.SS3.p1.m8" class="ltx_Math" alttext="x_{C}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>C</mi></msub><annotation encoding="application/x-tex">x_{C}</annotation></semantics></math> is placed there to represent the control action of the system <math id="S5.SS3.p1.m9" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math> due to the direct control effects that each rotor velocity has on the simulated quadrotor. Through this, the AttNP encodes all previous dynamic information <math id="S5.SS3.p1.m10" class="ltx_Math" alttext="\phi_{C}" display="inline" intent=":literal"><semantics><msub><mi>ϕ</mi><mi>C</mi></msub><annotation encoding="application/x-tex">\phi_{C}</annotation></semantics></math> and future time information in <math id="S5.SS3.p1.m11" class="ltx_Math" alttext="x_{T}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>T</mi></msub><annotation encoding="application/x-tex">x_{T}</annotation></semantics></math> to predict desired dynamics <math id="S5.SS3.p1.m12" class="ltx_Math" alttext="y_{T}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>T</mi></msub><annotation encoding="application/x-tex">y_{T}</annotation></semantics></math> at time step <math id="S5.SS3.p1.m13" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math>. As previously mentioned in the recursive implementation section <a href="#S4.SS3" title="4.3 Recursive Estimation Algorithm Discussion ‣ 4 Methodology ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>, noise-perturbed observed states <math id="S5.SS3.p1.m14" class="ltx_Math" alttext="y_{k}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">y_{k}</annotation></semantics></math> and posterior average <math id="S5.SS3.p1.m15" class="ltx_Math" alttext="\hat{y}_{T}^{+}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>T</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\hat{y}_{T}^{+}</annotation></semantics></math> are fused to form <math id="S5.SS3.p1.m16" class="ltx_Math" alttext="\widetilde{y}_{C}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>C</mi></msub><annotation encoding="application/x-tex">\widetilde{y}_{C}</annotation></semantics></math> during trajectory estimation. Since we incorporate noisy observable data into the estimation, we adopt a similar prediction framework to other estimation algorithms where information from <math id="S5.SS3.p1.m17" class="ltx_Math" alttext="\widetilde{y}_{C}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>y</mi><mo>~</mo></mover><mi>C</mi></msub><annotation encoding="application/x-tex">\widetilde{y}_{C}</annotation></semantics></math> is used to estimate latent dynamical states <math id="S5.SS3.p1.m18" class="ltx_Math" alttext="y_{T}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>T</mi></msub><annotation encoding="application/x-tex">y_{T}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib12" title="" class="ltx_ref">Jin et al. (2021)</a>; <a href="#bib.bib29" title="" class="ltx_ref">Wang et al. (2017)</a>; <a href="#bib.bib3" title="" class="ltx_ref">de Curtò and de Zarzà (2024)</a></cite>.</p>
</div>
</section>
<section id="S5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.4 </span>Error Metrics Used in Study</h3>

<div id="S5.SS4.p1" class="ltx_para">
<p id="S5.SS4.p1.1" class="ltx_p">To objectively compute prediction error consistently with related literature <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib37" title="" class="ltx_ref">Wan and Van Der Merwe (2000)</a>; <a href="#bib.bib1" title="" class="ltx_ref">Revach et al. (2022)</a>; <a href="#bib.bib20" title="" class="ltx_ref">Karl et al. (2017)</a></cite>, we use the root mean squared error (RMSE) between the 12 tracked quadrotor states. The formula for RMSE is given by:</p>
<table id="S5.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex30.m1" class="ltx_Math" alttext="\displaystyle\text{RMSE}=\sqrt{\frac{1}{N}\sum_{i=1}^{N}\sum_{j=1}^{12}\left(Y_{i,j}-\hat{Y}_{i,j}\right)^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mtext>RMSE</mtext><mo>=</mo><msqrt><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mn>12</mn></munderover></mstyle><msup><mrow><mo>(</mo><mrow><msub><mi>Y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>Y</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></msqrt></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{RMSE}=\sqrt{\frac{1}{N}\sum_{i=1}^{N}\sum_{j=1}^{12}\left(Y_{i,j}-\hat{Y}_{i,j}\right)^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS4.p1.2" class="ltx_p">where <math id="S5.SS4.p1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is the batch size, and <math id="S5.SS4.p1.m2" class="ltx_Math" alttext="Y,\hat{Y}\in\mathbb{R}^{12}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Y</mi><mo>,</mo><mover accent="true"><mi>Y</mi><mo>^</mo></mover></mrow><mo>∈</mo><msup><mi>ℝ</mi><mn>12</mn></msup></mrow><annotation encoding="application/x-tex">Y,\hat{Y}\in\mathbb{R}^{12}</annotation></semantics></math> are the true and predicted quadrotor states, respectively.
In addition to the above metric, we utilize negative log-likelihood (NLL) as a metric to compare the capabilities of modeling marginal distribution <math id="S5.SS4.p1.m3" class="ltx_Math" alttext="p(y_{T}|x_{T},\phi_{C})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>x</mi><mi>T</mi></msub><mo>,</mo><msub><mi>ϕ</mi><mi>C</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(y_{T}|x_{T},\phi_{C})</annotation></semantics></math> between the CP-augmented AttNP and previously-mentioned baselines. This metric is consistent with related literature in distribution modeling evaluation to ensure effects of distribution under/overconfidence are reflected <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib7" title="" class="ltx_ref">Kim et al. (2019)</a>; <a href="#bib.bib1" title="" class="ltx_ref">Revach et al. (2022)</a></cite>. The formula for NLL is given by:</p>
<table id="S5.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex31.m1" class="ltx_Math" alttext="\displaystyle\text{NLL}=\frac{1}{2N}\sum_{i=1}^{N}\sum_{j=1}^{12}\left(\log(2\pi\hat{\sigma}_{i,j}^{2})+\frac{(Y_{i,j}-\hat{Y}_{i,j})^{2}}{\hat{\sigma}_{i,j}^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mtext>NLL</mtext><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mn>12</mn></munderover></mstyle><mrow><mo>(</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>Y</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>Y</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\text{NLL}=\frac{1}{2N}\sum_{i=1}^{N}\sum_{j=1}^{12}\left(\log(2\pi\hat{\sigma}_{i,j}^{2})+\frac{(Y_{i,j}-\hat{Y}_{i,j})^{2}}{\hat{\sigma}_{i,j}^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="S5.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.5 </span>Convergence Dynamics</h3>

<figure id="S5.F3" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.12522v1/Project_Images/model-compare-RMSE-converge.png" id="S5.F3.g1" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/236;" width="229" height="236" alt="Refer to caption"></div><div class="ltx_flex_cell ltx_flex_size_2"><img src="2509.12522v1/Project_Images/model-compare-NLL-all-models.png" id="S5.F3.g2" class="ltx_graphics ltx_centering ltx_figure_panel ltx_img_square" style="aspect-ratio:229/236;" width="229" height="236" alt="Refer to caption"></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F3.3" class="ltx_text" style="font-size:90%;">Figure 3</span>: </span><span id="S5.F3.4" class="ltx_text" style="font-size:90%;">Model RMSE/NLL convergence dynamics of the PI-AttNP, AttNP, and additional baselines computed from randomly-sampled, unobserved minibatches <math id="S5.F3.m2" class="ltx_Math" alttext="\mathcal{D}_{j}\sim\mathcal{D}_{\text{test}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>j</mi></msub><mo>∼</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mtext>test</mtext></msub></mrow><annotation encoding="application/x-tex">\mathcal{D}_{j}\sim\mathcal{D}_{\text{test}}</annotation></semantics></math>. Note that in the NLL dynamics plot, CP-marginal and CP-joint represent the results of the PI-AttNP wrapped with marginal and joint conformal prediction frameworks, respectively.</span></figcaption>
</figure>
<figure id="S5.T2" class="ltx_table">
<table id="S5.T2.3" class="ltx_tabular ltx_centering ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S5.T2.3.1" class="ltx_tr">
<td id="S5.T2.3.1.1" class="ltx_td ltx_border_l ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"></td>
<td id="S5.T2.3.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.1.2.1" class="ltx_text" style="font-size:70%;">PI-AttNP</span></td>
<td id="S5.T2.3.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.1.3.1" class="ltx_text" style="font-size:70%;">AttNP</span></td>
<td id="S5.T2.3.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.1.4.1" class="ltx_text" style="font-size:70%;">DKF</span></td>
<td id="S5.T2.3.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.1.5.1" class="ltx_text" style="font-size:70%;">UKF</span></td>
<td id="S5.T2.3.1.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.1.6.1" class="ltx_text" style="font-size:70%;">PINN-LSTM</span></td></tr>
<tr id="S5.T2.3.2" class="ltx_tr">
<td id="S5.T2.3.2.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_l ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.2.1.1" class="ltx_text" style="font-size:70%;">Lowest RMSE</span></td>
<td id="S5.T2.3.2.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.2.2.1" class="ltx_text" style="font-size:70%;">9.845 <math id="S5.T2.m1" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 5.301</span></td>
<td id="S5.T2.3.2.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.2.3.1" class="ltx_text" style="font-size:70%;">19.125 <math id="S5.T2.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 8.654</span></td>
<td id="S5.T2.3.2.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.2.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">8.657 <math id="S5.T2.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 3.474</span></td>
<td id="S5.T2.3.2.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.2.5.1" class="ltx_text" style="font-size:70%;">15.105 <math id="S5.T2.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 6.604</span></td>
<td id="S5.T2.3.2.6" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.3.2.6.1" class="ltx_text" style="font-size:70%;">11.484 <math id="S5.T2.m5" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 7.421</span></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering" style="font-size:70%;"><span class="ltx_tag ltx_tag_table"><span id="S5.T2.6" class="ltx_text" style="font-size:129%;">Table 2</span>: </span><span id="S5.T2.7" class="ltx_text" style="font-size:129%;">Lowest RMSE reached for all models in the plot to the left within Figure <a href="#S5.F3" title="Figure 3 ‣ 5.5 Convergence Dynamics ‣ 5 Results and Validation ‣ Hybrid State Estimation of Uncertain Nonlinear Dynamics Using Neural Processes" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></span></figcaption>
</figure>
<figure id="S5.T3" class="ltx_table">
<table id="S5.T3.3" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
