<td id="S7.T8.3.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S7.T8.m2" class="ltx_Math" alttext="\mu_{a}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>a</mi></msub><annotation encoding="application/x-tex">\mu_{a}</annotation></semantics></math></td>
