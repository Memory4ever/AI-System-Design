<tr id="S4.T1.4.15" class="ltx_tr">
<th id="S4.T1.4.15.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T1.4.15.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"><math id="S4.T1.m18" class="ltx_Math" alttext="\delta^{t}_{k,m}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><annotation encoding="application/x-tex">\delta^{t}_{k,m}</annotation></semantics></math></span></th>
