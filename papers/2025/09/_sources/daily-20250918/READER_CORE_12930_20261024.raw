<th id="S4.T1.4.13.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" rowspan="2"><span id="S4.T1.4.13.1.1" class="ltx_text" style="--ltx-fg-color:#000000;"><math id="S4.T1.m16" class="ltx_Math" alttext="\zeta_{m}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msubsup><annotation encoding="application/x-tex">\zeta_{m}^{t}</annotation></semantics></math></span></th>
<td id="S4.T1.4.13.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.4.13.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Local unimodal subgradient upper bound of</span></td></tr>
