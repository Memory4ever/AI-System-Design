<th id="S4.T1.4.12.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><math id="S4.T1.m15" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math></th>
<td id="S4.T1.4.12.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.4.12.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Lipschitz parameter of the global loss function</span></td></tr>
