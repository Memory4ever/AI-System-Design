<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A0.Ex29.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{k\in\mathcal{K}_{m}^{t}}(w_{k,m}^{t}-\bar{w}_{k,m})\|\nabla H_{k}(\bm{\theta}_{{\rm g},m}^{t-1})-\nabla H(\bm{\theta}_{{\rm g},m}^{t-1})\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>m</mi><mi>t</mi></msubsup></mrow></munder></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>w</mi><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow><mi>t</mi></msubsup><mo>−</mo><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>H</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝜽</mi><mrow><mi>g</mi><mo>,</mo><mi>m</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>H</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝜽</mi><mrow><mi>g</mi><mo>,</mo><mi>m</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k\in\mathcal{K}_{m}^{t}}(w_{k,m}^{t}-\bar{w}_{k,m})\|\nabla H_{k}(\bm{\theta}_{{\rm g},m}^{t-1})-\nabla H(\bm{\theta}_{{\rm g},m}^{t-1})\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A0.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A0.Ex30.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\times 2\eta^{2}(1-\sum_{k\in\mathcal{K}_{m}^{t}}\bar{w}_{k,m})+2\eta^{2}(1-\sum_{k\in\mathcal{K}_{m}^{t}}\bar{w}_{k,m})\times" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">×</mo><mn>2</mn><msup><mi>η</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>m</mi><mi>t</mi></msubsup></mrow></munder></mstyle><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>2</mn><msup><mi>η</mi><mn>2</mn></msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>m</mi><mi>t</mi></msubsup></mrow></munder></mstyle><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo>×</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\times 2\eta^{2}(1-\sum_{k\in\mathcal{K}_{m}^{t}}\bar{w}_{k,m})+2\eta^{2}(1-\sum_{k\in\mathcal{K}_{m}^{t}}\bar{w}_{k,m})\times</annotation></semantics></math></td>
