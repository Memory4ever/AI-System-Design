<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A0.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A0.Ex34.m1" class="ltx_Math" alttext="\displaystyle\leq 2(1-\!\!\!\!\sum_{k\in\mathcal{K}_{m}}\!\!\!a_{k}^{t}\bar{w}_{k,m})\!\!\!\sum_{k\in\mathcal{K}_{m}}\!\!(w_{k,m}^{t}\!\!+\bar{w}_{k,m}\!\!-2a_{k}^{t}\bar{w}_{k,m})(\delta_{k,m}^{t-1})^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mpadded style="width:0.292em;" width="0.292em"><mo>−</mo></mpadded><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>m</mi></msub></mrow></munder></mstyle><mrow><msubsup><mi>a</mi><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></mrow><mpadded style="width:0em;" width="0em"><mo stretchy="false">)</mo></mpadded></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>m</mi></msub></mrow></munder></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi>w</mi><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow><mi>t</mi></msubsup><mo>+</mo><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>a</mi><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>δ</mi><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2(1-\!\!\!\!\sum_{k\in\mathcal{K}_{m}}\!\!\!a_{k}^{t}\bar{w}_{k,m})\!\!\!\sum_{k\in\mathcal{K}_{m}}\!\!(w_{k,m}^{t}\!\!+\bar{w}_{k,m}\!\!-2a_{k}^{t}\bar{w}_{k,m})(\delta_{k,m}^{t-1})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A0.SS1.p3" class="ltx_para">
<p id="A0.SS1.p3.1" class="ltx_p">Finally, (<a href="#A0.E56" title="In .1 Proof of Theorem 1 ‣ 7 Conclusions ‣ Analysis and Optimization of Wireless Multimodal Federated Learning on Modal Heterogeneity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">56</span></a>) and (<a href="#A0.E61" title="In .1 Proof of Theorem 1 ‣ 7 Conclusions ‣ Analysis and Optimization of Wireless Multimodal Federated Learning on Modal Heterogeneity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">61</span></a>) are summed up over <math id="A0.SS1.p3.m1" class="ltx_Math" alttext="m\notin\mathcal{M}^{t}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∉</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msup></mrow><annotation encoding="application/x-tex">m\notin\mathcal{M}^{t}</annotation></semantics></math> and <math id="A0.SS1.p3.m2" class="ltx_Math" alttext="m\in\mathcal{M}^{t}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msup></mrow><annotation encoding="application/x-tex">m\in\mathcal{M}^{t}</annotation></semantics></math>, respectively, and then the sums are substituted into (<a href="#A0.E55" title="In .1 Proof of Theorem 1 ‣ 7 Conclusions ‣ Analysis and Optimization of Wireless Multimodal Federated Learning on Modal Heterogeneity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">55</span></a>) to prove <span id="A0.SS1.p3.1.1" class="ltx_text ltx_font_bold">Theorem <a href="#Thmtheorem1" title="Theorem 1. ‣ 4.2 Main Results ‣ 4 MFL Performance Analysis ‣ Analysis and Optimization of Wireless Multimodal Federated Learning on Modal Heterogeneity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a></span>.</p>
</div>
</section>
