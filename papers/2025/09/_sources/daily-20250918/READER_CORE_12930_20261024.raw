<td id="S6.T2.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S6.T2.2.1.3.1" class="ltx_text ltx_font_bold">Parameter</span></td>
<td id="S6.T2.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S6.T2.2.1.4.1" class="ltx_text ltx_font_bold">Value</span></td></tr>
