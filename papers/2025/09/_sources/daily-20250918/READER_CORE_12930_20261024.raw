<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S6.F6.sf3.3" class="ltx_text" style="font-size:80%;">(c)</span> </span><span id="S6.F6.sf3.4" class="ltx_text" style="font-size:80%;">Audio Accuracy</span></figcaption>
