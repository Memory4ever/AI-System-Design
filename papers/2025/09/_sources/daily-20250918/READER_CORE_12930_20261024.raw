<th id="S4.T1.4.11.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><math id="S4.T1.m14" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math></th>
<td id="S4.T1.4.11.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.4.11.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Smooth parameter of the global loss function</span></td></tr>
