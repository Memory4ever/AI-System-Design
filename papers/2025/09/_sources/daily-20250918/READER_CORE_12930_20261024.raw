<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A0.Ex31.m1" class="ltx_Math" alttext="\displaystyle\quad\!\!\!\sum_{k\in\mathcal{K}_{m}\backslash\mathcal{K}_{m}^{t}}\!\!\!\bar{w}_{k,m}\|\nabla H_{k}(\bm{\theta}_{{\rm g},m}^{t-1})-\nabla H(\bm{\theta}_{{\rm g},m}^{t-1})\|^{2}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>m</mi></msub><mo lspace="0.222em" rspace="0.222em">\</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>m</mi><mi>t</mi></msubsup></mrow></mrow></munder></mstyle><mrow><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>H</mi><mi>k</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝜽</mi><mrow><mi>g</mi><mo>,</mo><mi>m</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>H</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝜽</mi><mrow><mi>g</mi><mo>,</mo><mi>m</mi></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\!\!\!\sum_{k\in\mathcal{K}_{m}\backslash\mathcal{K}_{m}^{t}}\!\!\!\bar{w}_{k,m}\|\nabla H_{k}(\bm{\theta}_{{\rm g},m}^{t-1})-\nabla H(\bm{\theta}_{{\rm g},m}^{t-1})\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A0.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A0.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A0.Ex32.m1" class="ltx_Math" alttext="\displaystyle\leq 2\eta^{2}\Big(\sum_{k\in\mathcal{K}_{m}}(w_{k,m}^{t}-a_{k}^{t}\bar{w}_{k,m})\!+\!\!\!\sum_{k\in\mathcal{K}_{m}}(1-a_{k}^{t})\bar{w}_{k,m}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>m</mi></msub></mrow></munder></mstyle><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>w</mi><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow><mi>t</mi></msubsup><mo>−</mo><mrow><msubsup><mi>a</mi><mi>k</mi><mi>t</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mpadded style="width:0.490em;" width="0.490em"><mo lspace="0.052em">+</mo></mpadded><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>m</mi></msub></mrow></munder></mstyle><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>a</mi><mi>k</mi><mi>t</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>m</mi></mrow></msub></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\eta^{2}\Big(\sum_{k\in\mathcal{K}_{m}}(w_{k,m}^{t}-a_{k}^{t}\bar{w}_{k,m})\!+\!\!\!\sum_{k\in\mathcal{K}_{m}}(1-a_{k}^{t})\bar{w}_{k,m}\Big)</annotation></semantics></math></td>
