<tr id="S4.T1.4.16" class="ltx_tr">
<td id="S4.T1.4.16.1" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.4.16.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">modality <math id="S4.T1.m19" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> and client <math id="S4.T1.m20" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math></span></td></tr>
