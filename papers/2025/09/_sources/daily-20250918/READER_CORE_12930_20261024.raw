<td id="S6.T2.2.6.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S6.T2.m9" class="ltx_Math" alttext="\beta_{\rm audio}^{\rm CREMA-D}" display="inline" intent=":literal"><semantics><msubsup><mi>β</mi><mi>audio</mi><mrow><mi>CREMA</mi><mo>−</mo><mi>D</mi></mrow></msubsup><annotation encoding="application/x-tex">\beta_{\rm audio}^{\rm CREMA-D}</annotation></semantics></math></td>
