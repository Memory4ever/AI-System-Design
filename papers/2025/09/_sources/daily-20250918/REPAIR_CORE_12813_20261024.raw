<td id="S6.T2.3.2.1.5.1" class="ltx_td ltx_align_left">Swin-B w12</td>
<td id="S6.T2.3.2.1.5.2" class="ltx_td ltx_align_center">384<math id="S6.T2.m9" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>576</td>
