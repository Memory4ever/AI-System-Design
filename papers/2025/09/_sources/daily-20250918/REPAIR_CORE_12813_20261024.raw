<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S6.E17.1.m1" class="ltx_Math" alttext="\displaystyle\phi_{a}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>ϕ</mi><mi>a</mi></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\phi_{a}=</annotation></semantics></math></td>
