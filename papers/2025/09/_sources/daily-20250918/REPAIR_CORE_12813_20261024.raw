              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.5.7.1" class="ltx_text ltx_font_bold">5</span></span>
            <math id="alg1.m14" class="ltx_Math" alttext="\tau\leftarrow t" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo stretchy="false">←</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">\tau\leftarrow t</annotation></semantics></math>; initialize tree <math id="alg1.m15" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> with root <math id="alg1.m16" class="ltx_Math" alttext="z_{\tau-1}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mrow><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">z_{\tau-1}</annotation></semantics></math>
