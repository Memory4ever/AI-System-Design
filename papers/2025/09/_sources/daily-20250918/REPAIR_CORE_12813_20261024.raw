with prob. <math id="alg1.m20" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> draw near <math id="alg1.m21" class="ltx_Math" alttext="\{\hat{p}_{\tau},\dots,\hat{p}_{\tau+H}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mi>τ</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mrow><mi>τ</mi><mo>+</mo><mi>H</mi></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\hat{p}_{\tau},\dots,\hat{p}_{\tau+H}\}</annotation></semantics></math> or predicate-relevant sites of <math id="alg1.m22" class="ltx_Math" alttext="\varphi" display="inline" intent=":literal"><semantics><mi>φ</mi><annotation encoding="application/x-tex">\varphi</annotation></semantics></math>; else uniform
</div>
