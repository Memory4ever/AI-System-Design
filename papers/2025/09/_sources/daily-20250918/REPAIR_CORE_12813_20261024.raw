<td id="S6.T2.3.2.1.3.4" class="ltx_td ltx_align_center">66.33</td>
<td id="S6.T2.3.2.1.3.5" class="ltx_td ltx_align_center">66.00</td></tr>
<tr id="S6.T2.3.2.1.4" class="ltx_tr">
<td id="S6.T2.3.2.1.4.1" class="ltx_td ltx_align_left">Swin-B w7</td>
<td id="S6.T2.3.2.1.4.2" class="ltx_td ltx_align_center">640<math id="S6.T2.m8" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>960</td>
