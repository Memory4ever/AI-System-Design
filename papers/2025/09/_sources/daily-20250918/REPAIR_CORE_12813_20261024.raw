<td id="S6.T2.3.2.1.3.2" class="ltx_td ltx_align_center">480<math id="S6.T2.m7" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>720</td>
