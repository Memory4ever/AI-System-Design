            <math id="alg1.m30" class="ltx_math_unparsed" alttext="\rho_{\text{seg}}\leftarrow\texttt{robustness}(\texttt{path}_{\tau:\tau+H},\varphi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mtext>seg</mtext></msub><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace">robustness</mtext><mrow><mo stretchy="false">(</mo><msub><mtext class="ltx_mathvariant_monospace">path</mtext><mrow><mi>τ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>τ</mi><mo>+</mo><mi>H</mi></mrow></mrow></msub><mo>,</mo><mi>φ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{\text{seg}}\leftarrow\texttt{robustness}(\texttt{path}_{\tau:\tau+H},\varphi)</annotation></semantics></math>
</div>
