<div id="S6.T2.3" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:303.6pt;">
<p id="S6.T2.3.1" class="ltx_p ltx_align_center">c) Image resolution and backbone</p>
<div id="S6.T2.3.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:303.6pt;height:78pt;vertical-align:-36.3pt;"><span class="ltx_transformed_inner" style="transform:translate(9.4pt,-2.4pt) scale(1.06589110327072,1.06589110327072) ;">
<table id="S6.T2.3.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S6.T2.3.2.1.1" class="ltx_tr">
<td id="S6.T2.3.2.1.1.1" class="ltx_td ltx_align_left ltx_border_t">Model</td>
<td id="S6.T2.3.2.1.1.2" class="ltx_td ltx_align_center ltx_border_t">Resolution.</td>
<td id="S6.T2.3.2.1.1.3" class="ltx_td ltx_align_center ltx_border_t">Window.</td>
<td id="S6.T2.3.2.1.1.4" class="ltx_td ltx_align_center ltx_border_t">Val Acc.</td>
<td id="S6.T2.3.2.1.1.5" class="ltx_td ltx_align_center ltx_border_t">Test Acc.</td></tr>
<tr id="S6.T2.3.2.1.2" class="ltx_tr">
<td id="S6.T2.3.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">Swin-B w7</td>
<td id="S6.T2.3.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t">320<math id="S6.T2.m6" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>480</td>
<td id="S6.T2.3.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">7</td>
<td id="S6.T2.3.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">63.00</td>
<td id="S6.T2.3.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">61.50</td></tr>
<tr id="S6.T2.3.2.1.3" class="ltx_tr">
