<span id="A1.T11.7.14.3.1" class="ltx_inline-block ltx_align_top" style="width:196.7pt;">
<span id="A1.T11.7.14.3.1.1" class="ltx_p"><span id="A1.T11.7.14.3.1.1.1" class="ltx_text" style="font-size:80%;">Lack of patience to process all new DP concepts.</span></span>
</span></td></tr>
<tr id="A1.T11.7.15" class="ltx_tr">
<td id="A1.T11.7.15.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r"></td>
<td id="A1.T11.7.15.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r"></td>
