</span></td>
<td id="S6.T8.5.3.3" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S6.T8.5.3.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Linear Regression</span></td></tr>
