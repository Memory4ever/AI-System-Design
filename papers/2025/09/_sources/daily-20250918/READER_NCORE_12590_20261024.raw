<span id="S6.T7.5.1.1.2.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S6.T7.5.1.1.2.1.1.2.1.1" class="ltx_text ltx_font_bold">Device</span></span></span>
</span></span><span id="S6.T7.5.1.1.2.2" class="ltx_text"></span></span></td>
