<span id="A1.T11.7.12.3.1" class="ltx_inline-block ltx_align_top" style="width:196.7pt;">
<span id="A1.T11.7.12.3.1.1" class="ltx_p"><span id="A1.T11.7.12.3.1.1.1" class="ltx_text" style="font-size:80%;">Explanations perceived as not useful for implementation or comprehension.</span></span>
</span></td></tr>
<tr id="A1.T11.7.13" class="ltx_tr">
<td id="A1.T11.7.13.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r ltx_border_t">
<span id="A1.T11.7.13.1.1" class="ltx_inline-block" style="width:51.7pt;">
