<div id="S6.T9.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:41.9pt;vertical-align:-19.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-128.4pt,15.6pt) scale(0.573245854506341,0.573245854506341) ;">
