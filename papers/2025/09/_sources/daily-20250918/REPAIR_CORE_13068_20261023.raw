<td id="S3.T1.2.9.1" class="ltx_td ltx_align_left ltx_border_bb">MSR-Codec-524</td>
<td id="S3.T1.2.9.2" class="ltx_td ltx_align_center ltx_border_bb">500/256/256</td>
<td id="S3.T1.2.9.3" class="ltx_td ltx_align_center ltx_border_bb">3</td>
