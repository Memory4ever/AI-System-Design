<th id="Sx1.T8.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Proportion</th>
<th id="Sx1.T8.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Performance</th></tr>
</thead>
<tbody class="ltx_tbody">
