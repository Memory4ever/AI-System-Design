<th id="S4.T9.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:3.4pt;padding-right:3.4pt;"><span id="S4.T9.3.1.3.1" class="ltx_text" style="font-size:70%;">C <math id="S4.T9.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></th>
