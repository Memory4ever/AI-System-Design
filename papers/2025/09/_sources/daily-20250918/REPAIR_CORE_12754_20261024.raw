<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E10.m2" class="ltx_Math" alttext="\displaystyle\sim{\mathrm{Mult}}(\varphi_{C_{n}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∼</mo><mrow><mi>Mult</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>φ</mi><msub><mi>C</mi><mi>n</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sim{\mathrm{Mult}}(\varphi_{C_{n}})</annotation></semantics></math></td>
