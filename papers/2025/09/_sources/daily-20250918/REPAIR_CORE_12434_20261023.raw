</section>
<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Proof of Proposition <a href="#S3.Thmtheorem2" title="Proposition 3.2. ‣ 3.2 Algorithmic Formulation of EntroPO ‣ 3 Proposed Technique ‣ Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a></h2>

<div id="A1.p1" class="ltx_para ltx_noindent">
<p id="A1.p1.1" class="ltx_p">First, we analyze the optimal policy under the objective</p>
<table id="A1.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex2.m1" class="ltx_math_unparsed" alttext="\max_{\pi}\mathbb{E}_{y\sim\pi(y|x)}[u(x,y)]+\alpha H(\pi(\cdot|x))-\beta H(\pi,\pi_{ref})" display="block" intent=":literal"><semantics><mrow><munder><mi>max</mi><mi>π</mi></munder><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mrow><mo stretchy="false">[</mo><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><mi>α</mi><mi>H</mi><mrow><mo stretchy="false">(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>β</mi><mi>H</mi><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\max_{\pi}\mathbb{E}_{y\sim\pi(y|x)}[u(x,y)]+\alpha H(\pi(\cdot|x))-\beta H(\pi,\pi_{ref})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p1.2" class="ltx_p">.</p>
</div>
<div id="A1.p2" class="ltx_para ltx_noindent">
<p id="A1.p2.1" class="ltx_p">By Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Bradley-Terry Preference Model). ‣ 3.1 Problem Setup and Assumption ‣ 3 Proposed Technique ‣ Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>, we have</p>
<table id="A1.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E9.m1" class="ltx_Math" alttext="u^{*}=\arg\max_{u}\mathbb{E}_{(x,y^{+},y^{-})\sim\rho}[\log\sigma(u(x,y^{+})-u(x,y^{-}))]" display="block" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mi>u</mi></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>ρ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u^{*}=\arg\max_{u}\mathbb{E}_{(x,y^{+},y^{-})\sim\rho}[\log\sigma(u(x,y^{+})-u(x,y^{-}))]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p3" class="ltx_para ltx_noindent">
<p id="A1.p3.1" class="ltx_p">Denote policies <math id="A1.p3.m1" class="ltx_math_unparsed" alttext="\pi(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi(\cdot|x)</annotation></semantics></math>, <math id="A1.p3.m2" class="ltx_math_unparsed" alttext="\pi_{ref}(\cdot|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{ref}(\cdot|x)</annotation></semantics></math> and utility function <math id="A1.p3.m3" class="ltx_Math" alttext="u(x,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u(x,\cdot)</annotation></semantics></math> as vectors <math id="A1.p3.m4" class="ltx_Math" alttext="\mathbf{\pi}" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\mathbf{\pi}</annotation></semantics></math>, <math id="A1.p3.m5" class="ltx_Math" alttext="\mathbf{\pi}_{ref}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{\pi}_{ref}</annotation></semantics></math>, <math id="A1.p3.m6" class="ltx_Math" alttext="\mathbf{u}" display="inline" intent=":literal"><semantics><mi>𝐮</mi><annotation encoding="application/x-tex">\mathbf{u}</annotation></semantics></math>. We can rewrite our objective as:</p>
<table id="A1.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E10.m1" class="ltx_Math" alttext="\begin{split}\max_{\mathbf{\pi}}\quad&amp;\mathbf{\pi}^{T}\mathbf{u}-\alpha\mathbf{\pi}^{T}\log\mathbf{\pi}+\beta\mathbf{\pi}^{T}\log\mathbf{\pi}_{ref}=\mathbf{\pi}^{T}(\mathbf{u}-\alpha\log\mathbf{\pi}+\beta\log\mathbf{\pi}_{ref})\\
&amp;\text{s.t.}\quad\|\mathbf{\pi}\|_{1}=1\\
\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><munder><mi>max</mi><mi>π</mi></munder></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><msup><mi>π</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝐮</mi></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mi>T</mi></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>π</mi></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>π</mi><mi>T</mi></msup><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow></mrow><mo>=</mo><mrow><msup><mi>π</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝐮</mi><mo>−</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>π</mi></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>s.t.</mtext><mspace style="width:2.000em;" width="2.000em"></mspace><msub><mrow><mo stretchy="false">‖</mo><mi>π</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\max_{\mathbf{\pi}}\quad&amp;\mathbf{\pi}^{T}\mathbf{u}-\alpha\mathbf{\pi}^{T}\log\mathbf{\pi}+\beta\mathbf{\pi}^{T}\log\mathbf{\pi}_{ref}=\mathbf{\pi}^{T}(\mathbf{u}-\alpha\log\mathbf{\pi}+\beta\log\mathbf{\pi}_{ref})\\
&amp;\text{s.t.}\quad\|\mathbf{\pi}\|_{1}=1\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p4" class="ltx_para ltx_noindent">
<p id="A1.p4.1" class="ltx_p">The Lagrangian is</p>
<table id="A1.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E11.m1" class="ltx_Math" alttext="L(\mathbf{\pi},\lambda)=\mathbf{\pi}^{T}(\mathbf{u}-\alpha\log\mathbf{\pi}+\beta\log\mathbf{\pi}_{ref})+\lambda(\sum_{i}\pi_{i}-1)" display="block" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>π</mi><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝐮</mi><mo>−</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>π</mi></mrow></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><munder><mo lspace="0em" movablelimits="false">∑</mo><mi>i</mi></munder><msub><mi>π</mi><mi>i</mi></msub></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">L(\mathbf{\pi},\lambda)=\mathbf{\pi}^{T}(\mathbf{u}-\alpha\log\mathbf{\pi}+\beta\log\mathbf{\pi}_{ref})+\lambda(\sum_{i}\pi_{i}-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p5" class="ltx_para ltx_noindent">
<p id="A1.p5.1" class="ltx_p">Taking the derivative of the Lagrangian, we have</p>
<table id="A1.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E12.m1" class="ltx_Math" alttext="\frac{\partial L}{\partial\mathbf{\pi}}=\mathbf{u}-\alpha(\log\mathbf{\pi}+\mathbf{1})+\beta\log\mathbf{\pi}_{ref}+\lambda\mathbf{1}=0" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><mi>L</mi></mrow><mrow><mo>∂</mo><mi>π</mi></mrow></mfrac><mo>=</mo><mrow><mrow><mi>𝐮</mi><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>π</mi></mrow><mo>+</mo><mn>𝟏</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\frac{\partial L}{\partial\mathbf{\pi}}=\mathbf{u}-\alpha(\log\mathbf{\pi}+\mathbf{1})+\beta\log\mathbf{\pi}_{ref}+\lambda\mathbf{1}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p6" class="ltx_para ltx_noindent">
<p id="A1.p6.1" class="ltx_p">It gives</p>
<table id="A1.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E13.m1" class="ltx_Math" alttext="\begin{split}\alpha(\log\mathbf{\pi}+\mathbf{1})&amp;=\mathbf{u}+\beta\log\mathbf{\pi}_{ref}+\lambda\mathbf{1}\\
\log\mathbf{\pi}+\mathbf{1}&amp;=\frac{\mathbf{u}+\beta\log\mathbf{\pi}_{ref}+\lambda\mathbf{1}}{\alpha}\\
\mathbf{\pi}&amp;=\exp^{\frac{\mathbf{u}+\beta\log\mathbf{\pi}_{ref}+(\lambda-\alpha)\mathbf{1}}{\alpha}}\\
\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>π</mi></mrow><mo>+</mo><mn>𝟏</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝐮</mi><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>π</mi></mrow><mo>+</mo><mn>𝟏</mn></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mfrac><mrow><mi>𝐮</mi><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow></mrow><mi>α</mi></mfrac></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mi>π</mi></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><msup><mi>exp</mi><mfrac><mrow><mi>𝐮</mi><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mn>𝟏</mn></mrow></mrow><mi>α</mi></mfrac></msup></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\alpha(\log\mathbf{\pi}+\mathbf{1})&amp;=\mathbf{u}+\beta\log\mathbf{\pi}_{ref}+\lambda\mathbf{1}\\
\log\mathbf{\pi}+\mathbf{1}&amp;=\frac{\mathbf{u}+\beta\log\mathbf{\pi}_{ref}+\lambda\mathbf{1}}{\alpha}\\
\mathbf{\pi}&amp;=\exp^{\frac{\mathbf{u}+\beta\log\mathbf{\pi}_{ref}+(\lambda-\alpha)\mathbf{1}}{\alpha}}\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p7" class="ltx_para ltx_noindent">
<p id="A1.p7.1" class="ltx_p">which implies the optimal policy
<math id="A1.p7.m1" class="ltx_Math" alttext="\pi^{*}(y|x)\propto\exp(\frac{u(x,y)}{\alpha})\pi_{ref}(y|x)^{\beta/\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mi>α</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\pi^{*}(y|x)\propto\exp(\frac{u(x,y)}{\alpha})\pi_{ref}(y|x)^{\beta/\alpha}</annotation></semantics></math>.</p>
</div>
<div id="A1.p8" class="ltx_para ltx_noindent">
<p id="A1.p8.1" class="ltx_p">Then, we analyze the optimal policy under the objective</p>
<table id="A1.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex3.m1" class="ltx_Math" alttext="\max_{\pi}\mathbb{E}_{(x,y^{+},y^{-})\sim D}\left[\log\sigma\left(\alpha\left[\log\frac{\pi(y^{+}|x)}{\pi_{ref}(y^{+}|x)^{\beta/\alpha}}-\log\frac{\pi(y^{-}|x)}{\pi_{ref}(y^{-}|x)^{\beta/\alpha}}\right]\right)\right]" display="block" intent=":literal"><semantics><mrow><mrow><munder><mi>max</mi><mi>π</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>D</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac></mrow><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac></mrow></mrow><mo>]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\max_{\pi}\mathbb{E}_{(x,y^{+},y^{-})\sim D}\left[\log\sigma\left(\alpha\left[\log\frac{\pi(y^{+}|x)}{\pi_{ref}(y^{+}|x)^{\beta/\alpha}}-\log\frac{\pi(y^{-}|x)}{\pi_{ref}(y^{-}|x)^{\beta/\alpha}}\right]\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p8.2" class="ltx_p">.</p>
</div>
<div id="A1.p9" class="ltx_para ltx_noindent">
<p id="A1.p9.1" class="ltx_p">which is equivalent to</p>
<table id="A1.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex4.m1" class="ltx_Math" alttext="\max_{\pi}\mathbb{E}_{(x,y^{+},y^{-})\sim D}[\log\sigma(\alpha\log\frac{\pi(y^{+}|x)}{\pi(y^{-}|x)}-\beta\log\frac{\pi_{ref}(y^{+}|x)}{\pi_{ref}(y^{-}|x)})]" display="block" intent=":literal"><semantics><mrow><mrow><munder><mi>max</mi><mi>π</mi></munder><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>D</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\max_{\pi}\mathbb{E}_{(x,y^{+},y^{-})\sim D}[\log\sigma(\alpha\log\frac{\pi(y^{+}|x)}{\pi(y^{-}|x)}-\beta\log\frac{\pi_{ref}(y^{+}|x)}{\pi_{ref}(y^{-}|x)})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p9.2" class="ltx_p">.</p>
</div>
<div id="A1.p10" class="ltx_para ltx_noindent">
<p id="A1.p10.1" class="ltx_p">Note that <math id="A1.p10.m1" class="ltx_Math" alttext="\pi(y|x)=\exp(\frac{1}{\eta}u(x,y))\pi_{ref}(y|x)^{\beta/\alpha}/Z(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mi>η</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow><mo>/</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi(y|x)=\exp(\frac{1}{\eta}u(x,y))\pi_{ref}(y|x)^{\beta/\alpha}/Z(x)</annotation></semantics></math> is equivalent to <math id="A1.p10.m2" class="ltx_Math" alttext="u(x,y)=\alpha\log\pi(y|x)-\beta\log\pi_{ref}(y|x)+\alpha\log Z(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">u(x,y)=\alpha\log\pi(y|x)-\beta\log\pi_{ref}(y|x)+\alpha\log Z(x)</annotation></semantics></math>. Given the same prompt <math id="A1.p10.m3" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>, compute the utility difference between two different responses <math id="A1.p10.m4" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> and <math id="A1.p10.m5" class="ltx_Math" alttext="y^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>y</mi><mo>′</mo></msup><annotation encoding="application/x-tex">y^{\prime}</annotation></semantics></math>. We have</p>
</div>
<div id="A1.p11" class="ltx_para ltx_noindent">
<table id="A1.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex5.m1" class="ltx_Math" alttext="\displaystyle u(x,y)-u(x,y^{\prime})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle u(x,y)-u(x,y^{\prime})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex5.m2" class="ltx_Math" alttext="\displaystyle=\alpha\log\pi(y|x)-\beta\log\pi_{ref}(y|x)+\alpha\log Z(x)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha\log\pi(y|x)-\beta\log\pi_{ref}(y|x)+\alpha\log Z(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
<tbody id="A1.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex6.m1" class="ltx_Math" alttext="\displaystyle-[\alpha\log\pi(y^{\prime}|x)-\beta\log\pi_{ref}(y^{\prime}|x)+\alpha\log Z(x)]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>Z</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-[\alpha\log\pi(y^{\prime}|x)-\beta\log\pi_{ref}(y^{\prime}|x)+\alpha\log Z(x)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
<tbody id="A1.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\displaystyle=\alpha\log\frac{\pi(y|x)}{\pi(y^{\prime}|x)}-\beta\log\frac{\pi_{ref}(y|x)}{\pi_{ref}(y^{\prime}|x)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha\log\frac{\pi(y|x)}{\pi(y^{\prime}|x)}-\beta\log\frac{\pi_{ref}(y|x)}{\pi_{ref}(y^{\prime}|x)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
</div>
<div id="A1.p12" class="ltx_para ltx_noindent">
<p id="A1.p12.1" class="ltx_p">We now substitute <math id="A1.p12.m1" class="ltx_Math" alttext="u(x,y)" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">u(x,y)</annotation></semantics></math> into the Bradley-Terry objective in Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1 (Bradley-Terry Preference Model). ‣ 3.1 Problem Setup and Assumption ‣ 3 Proposed Technique ‣ Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a></p>
<table id="A1.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E14.m1" class="ltx_Math" alttext="\displaystyle\pi^{*}(y|x)" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi^{*}(y|x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E14.m2" class="ltx_Math" alttext="\displaystyle=\argmax_{\pi}\mathbb{E}_{(x,y^{+},y^{-}\sim\mathcal{D}}[\log\sigma(\alpha\log\frac{\pi(y^{+}|x)}{\pi(y^{-}|x)}-\beta\log\frac{\pi_{ref}(y^{+}|x)}{\pi_{ref}(y^{-}|x)})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>max</mi></mrow><mi>π</mi></msub><mo>⁡</mo><msub><mi>𝔼</mi><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><mrow><msup><mi>y</mi><mo>−</mo></msup><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\argmax_{\pi}\mathbb{E}_{(x,y^{+},y^{-}\sim\mathcal{D}}[\log\sigma(\alpha\log\frac{\pi(y^{+}|x)}{\pi(y^{-}|x)}-\beta\log\frac{\pi_{ref}(y^{+}|x)}{\pi_{ref}(y^{-}|x)})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A1.p12.2" class="ltx_p">which satisfies the relationship <math id="A1.p12.m2" class="ltx_Math" alttext="\pi^{*}(y|x)\propto\exp(\frac{u(x,y)}{\alpha})\pi_{ref}(y|x)^{\beta/\alpha}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mi>α</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\pi^{*}(y|x)\propto\exp(\frac{u(x,y)}{\alpha})\pi_{ref}(y|x)^{\beta/\alpha}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Proof of Proposition <a href="#S3.Thmtheorem3" title="Proposition 3.3. ‣ 3.2 Algorithmic Formulation of EntroPO ‣ 3 Proposed Technique ‣ Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a></h2>

<div id="A2.p1" class="ltx_para ltx_noindent">
<p id="A2.p1.1" class="ltx_p">First, we consider the case when <math id="A2.p1.m1" class="ltx_Math" alttext="H=2" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">H=2</annotation></semantics></math>. The key idea is to solve the optmization problem through a backward iteration, i.e., from <math id="A2.p1.m2" class="ltx_Math" alttext="h=H=2" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mi>H</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">h=H=2</annotation></semantics></math> to <math id="A2.p1.m3" class="ltx_Math" alttext="h=1" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h=1</annotation></semantics></math>.</p>
</div>
<div id="A2.p2" class="ltx_para ltx_noindent">
<p id="A2.p2.1" class="ltx_p">For <math id="A2.p2.m1" class="ltx_Math" alttext="h=2" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">h=2</annotation></semantics></math>, by Proposition <a href="#S3.Thmtheorem2" title="Proposition 3.2. ‣ 3.2 Algorithmic Formulation of EntroPO ‣ 3 Proposed Technique ‣ Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, we have:</p>
<table id="A2.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E15.m1" class="ltx_Math" alttext="\begin{split}\pi_{\mathcal{M},2}(\cdot|s_{2})&amp;=\arg\max_{\pi_{2}}\mathbb{E}_{a_{2}\sim\pi_{2}(\cdot|s_{2})}[u(s_{2},a_{2})+\alpha H(\pi_{2}(\cdot|s_{2}))-\beta H(\pi_{2},\pi_{ref,2})]\\
&amp;\propto\pi_{ref}(\cdot|s_{2})^{\beta/\alpha}\exp(\frac{u(s_{2},\cdot)}{\alpha})\\
\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>π</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>arg</mi><mi>max</mi><msub><mrow></mrow><msub><mi>π</mi><mn>2</mn></msub></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>a</mi><msub><mrow></mrow><mn>2</mn></msub><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">)</mo><mo>+</mo><mi>α</mi><mi>H</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>H</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mn>2</mn></msub><mo>,</mo><mi>π</mi><msub><mrow></mrow><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mn>2</mn></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>∝</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup><mi>exp</mi><mo stretchy="false">(</mo><mfrac><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>2</mn></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mi>α</mi></mfrac><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\pi_{\mathcal{M},2}(\cdot|s_{2})&amp;=\arg\max_{\pi_{2}}\mathbb{E}_{a_{2}\sim\pi_{2}(\cdot|s_{2})}[u(s_{2},a_{2})+\alpha H(\pi_{2}(\cdot|s_{2}))-\beta H(\pi_{2},\pi_{ref,2})]\\
&amp;\propto\pi_{ref}(\cdot|s_{2})^{\beta/\alpha}\exp(\frac{u(s_{2},\cdot)}{\alpha})\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p3" class="ltx_para ltx_noindent">
<p id="A2.p3.1" class="ltx_p">Then, we define the value function and <math id="A2.p3.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> function w.r.t. <math id="A2.p3.m2" class="ltx_Math" alttext="\pi_{\mathcal{M},2}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\pi_{\mathcal{M},2}</annotation></semantics></math> as:</p>
<table id="A2.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E16.m1" class="ltx_Math" alttext="\begin{split}V_{\mathcal{M},2}(s_{2})&amp;=\mathbb{E}_{a_{2}\sim\pi_{2}(\cdot|s_{2})}[u(s_{2},\cdot)+\alpha H(\pi(\cdot|s_{2}))-\beta H(\pi,\pi_{ref})]\\
Q_{\mathcal{M},1}(s_{1},a_{1})&amp;=\mathbb{E}_{o_{1}\sim\mathbb{P}_{1}(\cdot|s_{1},a_{1})}[V_{\mathcal{M},2}(s_{2})]\\
\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>V</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>a</mi><msub><mrow></mrow><mn>2</mn></msub><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">[</mo><mi>u</mi><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo><mo>+</mo><mi>α</mi><mi>H</mi><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>H</mi><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>Q</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo>,</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>o</mi><msub><mrow></mrow><mn>1</mn></msub><mo>∼</mo><mi>ℙ</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">[</mo><mi>V</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}V_{\mathcal{M},2}(s_{2})&amp;=\mathbb{E}_{a_{2}\sim\pi_{2}(\cdot|s_{2})}[u(s_{2},\cdot)+\alpha H(\pi(\cdot|s_{2}))-\beta H(\pi,\pi_{ref})]\\
Q_{\mathcal{M},1}(s_{1},a_{1})&amp;=\mathbb{E}_{o_{1}\sim\mathbb{P}_{1}(\cdot|s_{1},a_{1})}[V_{\mathcal{M},2}(s_{2})]\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p4" class="ltx_para ltx_noindent">
<p id="A2.p4.1" class="ltx_p">For <math id="A2.p4.m1" class="ltx_Math" alttext="h=1" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">h=1</annotation></semantics></math>, we have:</p>
<table id="A2.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E17.m1" class="ltx_Math" alttext="\begin{split}\pi_{\mathcal{M},1}(\cdot|s_{1})&amp;=\arg\max_{\pi_{1}}\mathbb{E}_{a_{1}\sim\pi_{1}(\cdot|s_{1})}[Q_{\mathcal{M},1}(s_{1},a_{1})+\alpha H(\pi_{1}(\cdot|s_{1}))-\beta H(\pi_{1},\pi_{ref,1})]\\
&amp;\propto\pi_{ref,1}(\cdot|s_{1})^{\beta/\alpha}\exp(\frac{u(s_{1},\cdot)}{\alpha})\\
\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>π</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>arg</mi><mi>max</mi><msub><mrow></mrow><msub><mi>π</mi><mn>1</mn></msub></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">[</mo><mi>Q</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">)</mo><mo>+</mo><mi>α</mi><mi>H</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>H</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mn>1</mn></msub><mo>,</mo><mi>π</mi><msub><mrow></mrow><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>∝</mo><mi>π</mi><msub><mrow></mrow><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mn>1</mn></msub><mo rspace="0.167em" stretchy="false">)</mo><msup><mrow></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup><mi>exp</mi><mo stretchy="false">(</mo><mfrac><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mi>α</mi></mfrac><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\pi_{\mathcal{M},1}(\cdot|s_{1})&amp;=\arg\max_{\pi_{1}}\mathbb{E}_{a_{1}\sim\pi_{1}(\cdot|s_{1})}[Q_{\mathcal{M},1}(s_{1},a_{1})+\alpha H(\pi_{1}(\cdot|s_{1}))-\beta H(\pi_{1},\pi_{ref,1})]\\
&amp;\propto\pi_{ref,1}(\cdot|s_{1})^{\beta/\alpha}\exp(\frac{u(s_{1},\cdot)}{\alpha})\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p5" class="ltx_para ltx_noindent">
<p id="A2.p5.1" class="ltx_p">By construction, <math id="A2.p5.m1" class="ltx_Math" alttext="\pi_{\mathcal{M},2}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\pi_{\mathcal{M},2}</annotation></semantics></math> is already optimal for <math id="A2.p5.m2" class="ltx_Math" alttext="h=2" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">h=2</annotation></semantics></math>.</p>
</div>
<div id="A2.p6" class="ltx_para ltx_noindent">
<p id="A2.p6.1" class="ltx_p">Now, we consider a more general case <math id="A2.p6.m1" class="ltx_Math" alttext="h=H" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">h=H</annotation></semantics></math>. Given the definition of the Q value, we would like to show that equation <a href="#S3.E5" title="In Proposition 3.3. ‣ 3.2 Algorithmic Formulation of EntroPO ‣ 3 Proposed Technique ‣ Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> holds. We focus on a general objective:</p>
</div>
<div id="A2.p7" class="ltx_para ltx_noindent">
<table id="A2.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E18.m1" class="ltx_Math" alttext="\min_{p\in\Delta(\Omega)}[E_{w\sim p}U(w)-\alpha H(p)+\beta H(p,p_{0})]" display="block" intent=":literal"><semantics><mrow><munder><mi>min</mi><mrow><mi>p</mi><mo>∈</mo><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msub><mi>E</mi><mrow><mi>w</mi><mo>∼</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><msub><mi>p</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\min_{p\in\Delta(\Omega)}[E_{w\sim p}U(w)-\alpha H(p)+\beta H(p,p_{0})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="A2.p7.1" class="ltx_p">where <math id="A2.p7.m1" class="ltx_Math" alttext="\Delta(\Omega)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\Omega)</annotation></semantics></math> denotes the set of probabilities on <math id="A2.p7.m2" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>.</p>
</div>
<div id="A2.p8" class="ltx_para ltx_noindent">
<p id="A2.p8.1" class="ltx_p">Note that</p>
<table id="A2.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E19.m1" class="ltx_Math" alttext="\begin{split}E_{w\sim p}U(w)-\alpha H(p)+\beta H(p,p_{0})&amp;=E_{w\sim p}[\alpha\log p(w)-\alpha(\frac{\beta}{\alpha}\log p_{0}(w)-\frac{U(w)}{\alpha})]\\
&amp;=E_{w\sim p}[\log p(w)-\log(p_{0}(w)^{\beta/\alpha}\exp(-\frac{U(w)}{\alpha}))]\\
\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><msub><mi>E</mi><mrow><mi>w</mi><mo>∼</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><msub><mi>p</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>E</mi><mrow><mi>w</mi><mo>∼</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mfrac><mi>β</mi><mi>α</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mn>0</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mfrac><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mi>α</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>E</mi><mrow><mi>w</mi><mo>∼</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mfrac><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mi>α</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}E_{w\sim p}U(w)-\alpha H(p)+\beta H(p,p_{0})&amp;=E_{w\sim p}[\alpha\log p(w)-\alpha(\frac{\beta}{\alpha}\log p_{0}(w)-\frac{U(w)}{\alpha})]\\
&amp;=E_{w\sim p}[\log p(w)-\log(p_{0}(w)^{\beta/\alpha}\exp(-\frac{U(w)}{\alpha}))]\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p9" class="ltx_para ltx_noindent">
<p id="A2.p9.1" class="ltx_p">To ensure that <math id="A2.p9.m1" class="ltx_Math" alttext="q(w)" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(w)</annotation></semantics></math> is a valid probability distribution, we define the following normalization constant:</p>
<table id="A2.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E20.m1" class="ltx_Math" alttext="Z=\int p_{0}(w)^{\beta/\alpha}\exp(-\frac{U(w)}{\alpha})dw" display="block" intent=":literal"><semantics><mrow><mi>Z</mi><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mfrac><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mi>α</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>w</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">Z=\int p_{0}(w)^{\beta/\alpha}\exp(-\frac{U(w)}{\alpha})dw</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p10" class="ltx_para ltx_noindent">
<p id="A2.p10.1" class="ltx_p">Then the normalized distribution is <math id="A2.p10.m1" class="ltx_Math" alttext="p^{*}(w)=q(w)/Z" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>p</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>Z</mi></mrow></mrow><annotation encoding="application/x-tex">p^{*}(w)=q(w)/Z</annotation></semantics></math>.
Inserting back, we have</p>
<table id="A2.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E21.m1" class="ltx_Math" alttext="\begin{split}E_{w\sim p}[U(w)]-\alpha H(p)+\beta H(p,p_{0})&amp;=\alpha E_{w\sim p}[\log p(w)-\log(Z\cdot p^{*}(w))]\\
&amp;=\alpha E_{w\sim p}[\log p(w)-\log p^{*}(w)-\log Z]\\
&amp;=\alpha E_{w\sim p}\log\frac{p(w)}{p^{*}(w)}-\alpha E_{w\sim p}[\log Z]\\
\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><msub><mi>E</mi><mrow><mi>w</mi><mo>∼</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><msub><mi>p</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mrow><mi>w</mi><mo>∼</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>Z</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>p</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mrow><mi>w</mi><mo>∼</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msup><mi>p</mi><mo>∗</mo></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>Z</mi></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mrow><mi>w</mi><mo>∼</mo><mi>p</mi></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mi>p</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mrow></mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mrow><mi>w</mi><mo>∼</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>Z</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}E_{w\sim p}[U(w)]-\alpha H(p)+\beta H(p,p_{0})&amp;=\alpha E_{w\sim p}[\log p(w)-\log(Z\cdot p^{*}(w))]\\
&amp;=\alpha E_{w\sim p}[\log p(w)-\log p^{*}(w)-\log Z]\\
&amp;=\alpha E_{w\sim p}\log\frac{p(w)}{p^{*}(w)}-\alpha E_{w\sim p}[\log Z]\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
</div>
<div id="A2.p11" class="ltx_para ltx_noindent">
<p id="A2.p11.1" class="ltx_p">Note that the first item is the KL divergence <math id="A2.p11.m1" class="ltx_math_unparsed" alttext="KL(p||p^{*})" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mi>L</mi><mrow><mo stretchy="false">(</mo><mi>p</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>p</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">KL(p||p^{*})</annotation></semantics></math>. Thus, the minimizer of the above equation exists when <math id="A2.p11.m2" class="ltx_Math" alttext="p(w)=p^{*}(w)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>p</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">p(w)=p^{*}(w)</annotation></semantics></math>, i.e., <math id="A2.p11.m3" class="ltx_Math" alttext="p^{*}(w)=\frac{1}{Z}p_{0}(w)^{\beta/\alpha}\exp(-\frac{U(w)}{\alpha})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>p</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>Z</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mfrac><mrow><mi>U</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mi>α</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">p^{*}(w)=\frac{1}{Z}p_{0}(w)^{\beta/\alpha}\exp(-\frac{U(w)}{\alpha})</annotation></semantics></math>.
The minimum value is <math id="A2.p11.m4" class="ltx_Math" alttext="-\alpha\log Z" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>Z</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">-\alpha\log Z</annotation></semantics></math>.</p>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Derivation of <span id="A3.2" class="ltx_text ltx_font_smallcaps">EntroPO</span> loss</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">Based on Proposition <a href="#S3.Thmtheorem3" title="Proposition 3.3. ‣ 3.2 Algorithmic Formulation of EntroPO ‣ 3 Proposed Technique ‣ Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, the optimal policy at step <math id="A3.p1.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> is</p>
<table id="A3.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E22.m1" class="ltx_Math" alttext="\pi_{\mathcal{M},h}(a_{h}|s_{h})=\frac{\pi_{ref,h}(a_{h}|s_{h})^{\beta/\alpha}}{Z_{h}(s_{h})}\exp(\frac{Q_{\mathcal{M},h}(s_{h},a_{h})}{\alpha})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><msub><mi>π</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow><mrow><msub><mi>Z</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><msub><mi>Q</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mi>α</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi_{\mathcal{M},h}(a_{h}|s_{h})=\frac{\pi_{ref,h}(a_{h}|s_{h})^{\beta/\alpha}}{Z_{h}(s_{h})}\exp(\frac{Q_{\mathcal{M},h}(s_{h},a_{h})}{\alpha}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A3.p1.2" class="ltx_p">with normalization factor</p>
<table id="A3.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E23.m1" class="ltx_Math" alttext="Z_{h}(s_{h})=\sum_{a_{h}\in\mathcal{A}}\pi_{ref,h}(a_{h}\mid s_{h})^{\beta/\alpha}\,\exp\!\big(Q_{\mathcal{M},h}(s_{h},a_{h})/\alpha\big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Z</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>a</mi><mi>h</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow></munder><mrow><msub><mi>π</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>Q</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>α</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">Z_{h}(s_{h})=\sum_{a_{h}\in\mathcal{A}}\pi_{ref,h}(a_{h}\mid s_{h})^{\beta/\alpha}\,\exp\!\big(Q_{\mathcal{M},h}(s_{h},a_{h})/\alpha\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="A3.p1.3" class="ltx_p">and the corresponding value</p>
<table id="A3.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E24.m1" class="ltx_Math" alttext="V_{\mathcal{M},h}(s_{h})\;=\;\alpha\log Z_{h}(s_{h})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>V</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>Z</mi><mi>h</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">V_{\mathcal{M},h}(s_{h})\;=\;\alpha\log Z_{h}(s_{h}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p2" class="ltx_para ltx_noindent">
<p id="A3.p2.1" class="ltx_p">Starting from the policy expression,</p>
<table id="A3.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E25.m1" class="ltx_Math" alttext="\displaystyle\pi_{\mathcal{M},h}(a_{h}\mid s_{h})\,Z_{h}(s_{h})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>Z</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{\mathcal{M},h}(a_{h}\mid s_{h})\,Z_{h}(s_{h})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E25.m2" class="ltx_Math" alttext="\displaystyle=\pi_{\mathrm{ref},h}(a_{h}\mid s_{h})^{\beta/\alpha}\,\exp(\frac{Q_{\mathcal{M},h}(s_{h},a_{h})}{\alpha})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>π</mi><mrow><mi>ref</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>Q</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mi>α</mi></mfrac></mstyle><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\pi_{\mathrm{ref},h}(a_{h}\mid s_{h})^{\beta/\alpha}\,\exp(\frac{Q_{\mathcal{M},h}(s_{h},a_{h})}{\alpha})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
<tbody id="A3.E26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E26.m1" class="ltx_Math" alttext="\displaystyle\Longrightarrow\qquad\exp\!\big(Q_{\mathcal{M},h}(s_{h},a_{h})/\alpha\big)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟹</mo><mspace style="width:2.167em;" width="2.167em"></mspace><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>Q</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>α</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Longrightarrow\qquad\exp\!\big(Q_{\mathcal{M},h}(s_{h},a_{h})/\alpha\big)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E26.m2" class="ltx_Math" alttext="\displaystyle=\frac{\pi_{\mathcal{M},h}(a_{h}\mid s_{h})\,Z_{h}(s_{h})}{\pi_{\mathrm{ref},h}(a_{h}\mid s_{h})^{\beta/\alpha}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>Z</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mi>ref</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\pi_{\mathcal{M},h}(a_{h}\mid s_{h})\,Z_{h}(s_{h})}{\pi_{\mathrm{ref},h}(a_{h}\mid s_{h})^{\beta/\alpha}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
<p id="A3.p2.2" class="ltx_p">Taking the logarithm and multiplying by <math id="A3.p2.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> gives</p>
<table id="A3.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E27.m1" class="ltx_Math" alttext="\displaystyle Q_{\mathcal{M},h}(s_{h},a_{h})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Q_{\mathcal{M},h}(s_{h},a_{h})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E27.m2" class="ltx_Math" alttext="\displaystyle=\alpha\log\pi_{\mathcal{M},h}(a_{h}\mid s_{h})+\alpha\log Z_{h}(s_{h})-\beta\log\pi_{\mathrm{ref},h}(a_{h}\mid s_{h})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>Z</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>π</mi><mrow><mi>ref</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\alpha\log\pi_{\mathcal{M},h}(a_{h}\mid s_{h})+\alpha\log Z_{h}(s_{h})-\beta\log\pi_{\mathrm{ref},h}(a_{h}\mid s_{h})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
<tbody id="A3.E28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E28.m1" class="ltx_Math" alttext="\displaystyle=V_{\mathcal{M},h}(s_{h})+\alpha\log\pi_{\mathcal{M},h}(a_{h}\mid s_{h})-\beta\log\pi_{\mathrm{ref},h}(a_{h}\mid s_{h})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><msub><mi>V</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>α</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mrow><mi>ref</mi><mo>,</mo><mi>h</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=V_{\mathcal{M},h}(s_{h})+\alpha\log\pi_{\mathcal{M},h}(a_{h}\mid s_{h})-\beta\log\pi_{\mathrm{ref},h}(a_{h}\mid s_{h}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p3" class="ltx_para ltx_noindent">
<p id="A3.p3.1" class="ltx_p">We can further rewrite Q-value as:</p>
<table id="A3.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E29.m1" class="ltx_Math" alttext="\begin{split}Q_{M,h}(s_{h},a_{h})=\alpha\cdot\log\frac{\pi_{\mathcal{M},h}(a_{h}|s_{h})}{\pi_{\text{ref},h}(a_{h}|s_{h})^{\beta/\alpha}}+V_{\mathcal{M},h}(s_{h})\end{split}" display="block" intent=":literal"><semantics><mtable displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mi>Q</mi><mrow><mi>M</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo>,</mo><msub><mi>a</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mtext>ref</mtext><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac></mrow></mrow><mo>+</mo><mrow><msub><mi>V</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}Q_{M,h}(s_{h},a_{h})=\alpha\cdot\log\frac{\pi_{\mathcal{M},h}(a_{h}|s_{h})}{\pi_{\text{ref},h}(a_{h}|s_{h})^{\beta/\alpha}}+V_{\mathcal{M},h}(s_{h})\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p4" class="ltx_para ltx_noindent">
<p id="A3.p4.1" class="ltx_p">With the definition of <math id="A3.p4.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>-values <math id="A3.p4.m2" class="ltx_Math" alttext="Q_{\mathcal{M},h}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><annotation encoding="application/x-tex">Q_{\mathcal{M},h}</annotation></semantics></math>, we have</p>
</div>
<div id="A3.p5" class="ltx_para ltx_noindent">
<table id="A3.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E30.m1" class="ltx_Math" alttext="\begin{gathered}\mathbb{E}_{o_{h}\sim\mathbb{P}_{h}(\cdot|s_{h},a_{h})}V_{\mathcal{M},h+1}(s_{h+1})=\alpha\cdot\log\frac{\pi_{\mathcal{M},h}(a_{h}|s_{h})}{\pi_{\text{ref},h}(a_{h}|s_{h})^{\beta/\alpha}}+V_{\mathcal{M},h}(s_{h}),\quad\text{if }h\leq H-1\\
u(s_{H},a_{H})=\alpha\cdot\log\frac{\pi_{\mathcal{M},H}(a_{H}|s_{H})}{\pi_{\text{ref},H}(a_{H}|s_{H})^{\beta/\alpha}}+V_{\mathcal{M},H}(s_{H}).\end{gathered}" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>o</mi><msub><mrow></mrow><mi>h</mi></msub><mo>∼</mo><mi>ℙ</mi><msub><mrow></mrow><mi>h</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mi>h</mi></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></msub><mi>V</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>=</mo><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>log</mi><mfrac><mrow><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mtext>ref</mtext><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac><mo>+</mo><mi>V</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mi>h</mi></msub><mo stretchy="false">)</mo><mo rspace="2.167em">,</mo><mtext>if </mtext><mi>h</mi><mo>≤</mo><mi>H</mi><mo>−</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd><mrow><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>H</mi></msub><mo>,</mo><msub><mi>a</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mtext>ref</mtext><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>H</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac></mrow></mrow><mo>+</mo><mrow><msub><mi>V</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>H</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{gathered}\mathbb{E}_{o_{h}\sim\mathbb{P}_{h}(\cdot|s_{h},a_{h})}V_{\mathcal{M},h+1}(s_{h+1})=\alpha\cdot\log\frac{\pi_{\mathcal{M},h}(a_{h}|s_{h})}{\pi_{\text{ref},h}(a_{h}|s_{h})^{\beta/\alpha}}+V_{\mathcal{M},h}(s_{h}),\quad\text{if }h\leq H-1\\
u(s_{H},a_{H})=\alpha\cdot\log\frac{\pi_{\mathcal{M},H}(a_{H}|s_{H})}{\pi_{\text{ref},H}(a_{H}|s_{H})^{\beta/\alpha}}+V_{\mathcal{M},H}(s_{H}).\end{gathered}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p6" class="ltx_para ltx_noindent">
<p id="A3.p6.1" class="ltx_p">Summing over <math id="A3.p6.m1" class="ltx_Math" alttext="h\in[H]" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>H</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">h\in[H]</annotation></semantics></math>, we have</p>
</div>
<div id="A3.p7" class="ltx_para ltx_noindent">
<table id="A3.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E31.m1" class="ltx_Math" alttext="\begin{split}u(s_{H},a_{H})=&amp;\underbrace{\alpha\sum_{h=1}^{H}\log\frac{\pi_{\mathcal{M},h}(a_{h}|s_{h})}{\pi_{ref,h}(a_{h}|s_{h})^{\beta/\alpha}}}_{(1)}+\underbrace{V_{\mathcal{M},1}(s_{1})}_{(2)}\\
&amp;+\underbrace{\sum_{h=1}^{H-1}[V_{\mathcal{M},h+1}(s_{h+1})-E_{o_{h}\sim\mathbb{P}_{h}(\cdot|s_{h},a_{h})}V_{\mathcal{M},h+1}(s_{h+1})]}_{(3)}\\
\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mi>u</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>H</mi></msub><mo>,</mo><msub><mi>a</mi><mi>H</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><munder><munder accentunder="true"><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></munder><mo>+</mo><munder><munder accentunder="true"><mrow><msub><mi>V</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></munder></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>H</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">[</mo><mi>V</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo>−</mo><mi>E</mi><msub><mrow></mrow><mrow><mi>o</mi><msub><mrow></mrow><mi>h</mi></msub><mo>∼</mo><mi>ℙ</mi><msub><mrow></mrow><mi>h</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><msub><mrow></mrow><mi>h</mi></msub><mo>,</mo><mi>a</mi><msub><mrow></mrow><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></msub><mi>V</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">(</mo><mi>s</mi><msub><mrow></mrow><mrow><mi>h</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow><mo stretchy="true">⏟</mo></munder><mrow><mo stretchy="false">(</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></munder></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}u(s_{H},a_{H})=&amp;\underbrace{\alpha\sum_{h=1}^{H}\log\frac{\pi_{\mathcal{M},h}(a_{h}|s_{h})}{\pi_{ref,h}(a_{h}|s_{h})^{\beta/\alpha}}}_{(1)}+\underbrace{V_{\mathcal{M},1}(s_{1})}_{(2)}\\
&amp;+\underbrace{\sum_{h=1}^{H-1}[V_{\mathcal{M},h+1}(s_{h+1})-E_{o_{h}\sim\mathbb{P}_{h}(\cdot|s_{h},a_{h})}V_{\mathcal{M},h+1}(s_{h+1})]}_{(3)}\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p8" class="ltx_para ltx_noindent">
<p id="A3.p8.1" class="ltx_p">Term (1) is similar to what we derive in Proposition <a href="#S3.Thmtheorem2" title="Proposition 3.2. ‣ 3.2 Algorithmic Formulation of EntroPO ‣ 3 Proposed Technique ‣ Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>. Term (2) can be viewed as a constant when comparing two different responses for the same prompt <math id="A3.p8.m1" class="ltx_Math" alttext="s_{1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mn>1</mn></msub><annotation encoding="application/x-tex">s_{1}</annotation></semantics></math>. For Term (3), given the deterministic nature of our tool-integrated coding task, Term (3) is equal to 0. Therefore, we can utilize the maximum likelihood estimation of the utility function with a dataset <math id="A3.p8.m2" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> consisting of <math id="A3.p8.m3" class="ltx_Math" alttext="(x,\tau^{+},\tau^{-})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>τ</mi><mo>+</mo></msup><mo>,</mo><msup><mi>τ</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x,\tau^{+},\tau^{-})</annotation></semantics></math> to obtain our <span id="A3.p8.1.1" class="ltx_text ltx_font_smallcaps">EntroPO</span>-DPO loss:</p>
</div>
<div id="A3.p9" class="ltx_para ltx_noindent">
<table id="A3.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E32.m1" class="ltx_Math" alttext="\begin{split}&amp;L_{{\sc EntroPO}-DPO}(\theta)\\
=&amp;-\sum_{(x,\tau^{+},\tau^{-})\in D}\log\sigma\left(\alpha\sum_{h=1}^{H}\left[\log\frac{\pi_{\theta,h}(a_{h}^{+}|s_{h}^{+})}{\pi_{ref,h}(a_{h}^{+}|s_{h}^{+})^{\beta/\alpha}}-\log\frac{\pi_{\theta,h}(a_{h}^{-}|s_{h}^{-})}{\pi_{ref,h}(a_{h}^{-}|s_{h}^{-})^{\beta/\alpha}}\right]\right)\\
\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>L</mi><mrow><mi class="ltx_font_smallcaps">EntroPO</mi><mo>−</mo><mrow><mi>D</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>=</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.055em">−</mo><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>τ</mi><mo>+</mo></msup><mo>,</mo><msup><mi>τ</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>D</mi></mrow></msub><mi>log</mi><mi>σ</mi><mo>(</mo><mi>α</mi><mo movablelimits="false" rspace="0em">∑</mo><msub><mrow></mrow><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>H</mi></msup><mo>[</mo><mi>log</mi><mfrac><mrow><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>h</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>s</mi><mi>h</mi><mo>+</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>h</mi><mo>+</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>s</mi><mi>h</mi><mo>+</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac><mo>−</mo><mi>log</mi><mfrac><mrow><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>h</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>s</mi><mi>h</mi><mo>−</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>a</mi><mi>h</mi><mo>−</mo></msubsup><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>s</mi><mi>h</mi><mo>−</mo></msubsup><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac><mo>]</mo><mo>)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;L_{{\sc EntroPO}-DPO}(\theta)\\
=&amp;-\sum_{(x,\tau^{+},\tau^{-})\in D}\log\sigma\left(\alpha\sum_{h=1}^{H}\left[\log\frac{\pi_{\theta,h}(a_{h}^{+}|s_{h}^{+})}{\pi_{ref,h}(a_{h}^{+}|s_{h}^{+})^{\beta/\alpha}}-\log\frac{\pi_{\theta,h}(a_{h}^{-}|s_{h}^{-})}{\pi_{ref,h}(a_{h}^{-}|s_{h}^{-})^{\beta/\alpha}}\right]\right)\\
\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p10" class="ltx_para ltx_noindent">
<p id="A3.p10.1" class="ltx_p">With equation <a href="#A3.E31" title="In Appendix C Derivation of EntroPO loss ‣ Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a> implying that Term (3) = 0, the implicit reward <math id="A3.p10.m1" class="ltx_Math" alttext="r(x,y)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(x,y)</annotation></semantics></math> is given by <math id="A3.p10.m2" class="ltx_Math" alttext="\sum_{h=1}^{H}\log\frac{\pi_{\mathcal{M},h}(a_{h}|s_{h})}{\pi_{ref,h}(a_{h}|s_{h})^{\beta/\alpha}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></msubsup><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\sum_{h=1}^{H}\log\frac{\pi_{\mathcal{M},h}(a_{h}|s_{h})}{\pi_{ref,h}(a_{h}|s_{h})^{\beta/\alpha}}</annotation></semantics></math>. Based on <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib7" title="" class="ltx_ref">Ethayarajh et al. (2024)</a></cite>, we can naturally derive our <span id="A3.p10.1.1" class="ltx_text ltx_font_smallcaps">EntroPO</span>-KTO loss</p>
</div>
<div id="A3.p11" class="ltx_para ltx_noindent">
<table id="A3.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E33.m1" class="ltx_Math" alttext="L_{{\sc EntroPO}-KTO}(\theta)=E_{x,y\sim D}[\lambda_{y}-V(x,y)]" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>L</mi><mrow><mi class="ltx_font_smallcaps">EntroPO</mi><mo>−</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>O</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>E</mi><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∼</mo><mi>D</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>λ</mi><mi>y</mi></msub><mo>−</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{{\sc EntroPO}-KTO}(\theta)=E_{x,y\sim D}[\lambda_{y}-V(x,y)]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p12" class="ltx_para ltx_noindent">
<p id="A3.p12.1" class="ltx_p">where</p>
<table id="A3.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex8.m1" class="ltx_Math" alttext="r_{\theta}(x,y)=\sum_{h=1}^{H}\log\frac{\pi_{\mathcal{M},h}(a_{h}|s_{h})}{\pi_{ref,h}(a_{h}|s_{h})^{\beta/\alpha}}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>r</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><msub><mi>π</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo>,</mo><mi>h</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">|</mo><msub><mi>s</mi><mi>h</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>β</mi><mo>/</mo><mi>α</mi></mrow></msup></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{\theta}(x,y)=\sum_{h=1}^{H}\log\frac{\pi_{\mathcal{M},h}(a_{h}|s_{h})}{\pi_{ref,h}(a_{h}|s_{h})^{\beta/\alpha}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A3.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex9.m1" class="ltx_Math" alttext="V(x,y)=\begin{cases}\lambda_{+}\sigma(\alpha(r_{\theta}(x,y)-z_{0}))\\
\lambda_{-}\sigma(\alpha(z_{0}-r_{\theta}(x,y)))\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>λ</mi><mo>+</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>r</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>z</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>λ</mi><mo>−</mo></msub><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>z</mi><mn>0</mn></msub><mo>−</mo><mrow><msub><mi>r</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">V(x,y)=\begin{cases}\lambda_{+}\sigma(\alpha(r_{\theta}(x,y)-z_{0}))\\
\lambda_{-}\sigma(\alpha(z_{0}-r_{\theta}(x,y)))\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="A3.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex10.m1" class="ltx_Math" alttext="z_{0}=\sum_{h=1}^{H}\left[-H(\pi)+\frac{\beta}{\alpha}H(\pi,\pi_{ref})\right]" display="block" intent=":literal"><semantics><mrow><msub><mi>z</mi><mn>0</mn></msub><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>h</mi><mo>=</mo><mn>1</mn></mrow><mi>H</mi></munderover><mrow><mo>[</mo><mrow><mrow><mo>−</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mi>β</mi><mi>α</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><msub><mi>π</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{0}=\sum_{h=1}^{H}\left[-H(\pi)+\frac{\beta}{\alpha}H(\pi,\pi_{ref})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Experiment Details</h2>

<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p">In this section, we provide additional details about the experiment details of <span id="A4.p1.1.1" class="ltx_text ltx_font_smallcaps">EntroPO</span>.</p>
</div>
<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Dataset Details</h3>

<div id="A4.SS1.p1" class="ltx_para ltx_noindent">
<p id="A4.SS1.p1.1" class="ltx_p"><span id="A4.SS1.p1.1.1" class="ltx_text ltx_font_bold">Training Data.</span> For SFT, we use the SWE-Smith dataset <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib41" title="" class="ltx_ref">Yang et al., 2025</a>)</cite>, selecting only Python-based instances with problem statements that align with the <span id="A4.SS1.p1.1.2" class="ltx_text ltx_font_smallcaps">SWEBench</span> format. For preference learning, we employ the R2E-Gym-subset <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib10" title="" class="ltx_ref">Jain et al., 2025</a>)</cite>, which we selected because it contains no repository overlap with our test sets, thereby preventing data leakage.</p>
</div>
<div id="A4.SS1.p2" class="ltx_para ltx_noindent">
<p id="A4.SS1.p2.1" class="ltx_p"><span id="A4.SS1.p2.1.1" class="ltx_text ltx_font_bold">Evaluation Data.</span> We evaluate <span id="A4.SS1.p2.1.2" class="ltx_text ltx_font_smallcaps">EntroPO</span> on the complete official test sets for both <span id="A4.SS1.p2.1.3" class="ltx_text ltx_font_smallcaps">SWEBench-Verified</span> and <span id="A4.SS1.p2.1.4" class="ltx_text ltx_font_smallcaps">SWEBench-Lite</span>. Detailed statistics for all datasets are provided in <a href="#A4.T3" title="Table 3 ‣ D.1 Dataset Details ‣ Appendix D Experiment Details ‣ Building Coding Agents via Entropy-Enhanced Multi-Turn Preference Optimization" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Table 3</span></a>.</p>
</div>
<figure id="A4.T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 3: </span>
<span id="A4.T3.3" class="ltx_text ltx_font_bold">Dataset Statistics</span>: The table presents the number of training and test samples for each dataset, along with the source of the dataset.
</figcaption>
<div id="A4.T3.4" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:397.5pt;height:37.7pt;vertical-align:-17.3pt;"><span class="ltx_transformed_inner" style="transform:translate(-124.3pt,11.8pt) scale(0.615215415220602,0.615215415220602) ;">
<table id="A4.T3.4.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A4.T3.4.1.1" class="ltx_tr">
<th id="A4.T3.4.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A4.T3.4.1.1.1.1" class="ltx_text ltx_font_bold">Dataset</span></th>
<th id="A4.T3.4.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T3.4.1.1.2.1" class="ltx_text ltx_font_bold"># Train Samples</span></th>
<th id="A4.T3.4.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T3.4.1.1.3.1" class="ltx_text ltx_font_bold"># Test Samples</span></th>
<th id="A4.T3.4.1.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A4.T3.4.1.1.4.1" class="ltx_text ltx_font_bold">Source</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A4.T3.4.1.2" class="ltx_tr">
<td id="A4.T3.4.1.2.1" class="ltx_td ltx_align_left ltx_border_t">SWE-Smith</td>
<td id="A4.T3.4.1.2.2" class="ltx_td ltx_align_center ltx_border_t">8736</td>
<td id="A4.T3.4.1.2.3" class="ltx_td ltx_align_center ltx_border_t">-</td>
<td id="A4.T3.4.1.2.4" class="ltx_td ltx_align_left ltx_border_t"><a href="https://huggingface.co/datasets/r2e-edits/swesmith-clean" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/datasets/r2e-edits/swesmith-clean</a></td></tr>
<tr id="A4.T3.4.1.3" class="ltx_tr">
<td id="A4.T3.4.1.3.1" class="ltx_td ltx_align_left">R2E-Gym-subset</td>
<td id="A4.T3.4.1.3.2" class="ltx_td ltx_align_center">4578</td>
<td id="A4.T3.4.1.3.3" class="ltx_td ltx_align_center">-</td>
<td id="A4.T3.4.1.3.4" class="ltx_td ltx_align_left"><a href="https://huggingface.co/datasets/R2E-Gym/R2E-Gym-Subset" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/datasets/R2E-Gym/R2E-Gym-Subset</a></td></tr>
<tr id="A4.T3.4.1.4" class="ltx_tr">
<td id="A4.T3.4.1.4.1" class="ltx_td ltx_align_left">SWE-bench Verified</td>
<td id="A4.T3.4.1.4.2" class="ltx_td ltx_align_center">-</td>
<td id="A4.T3.4.1.4.3" class="ltx_td ltx_align_center">500</td>
<td id="A4.T3.4.1.4.4" class="ltx_td ltx_align_left"><a href="https://huggingface.co/datasets/princeton-nlp/SWE-bench_Verified" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/datasets/princeton-nlp/SWE-bench_Verified</a></td></tr>
<tr id="A4.T3.4.1.5" class="ltx_tr">
<td id="A4.T3.4.1.5.1" class="ltx_td ltx_align_left ltx_border_bb">SWE-bench Lite</td>
<td id="A4.T3.4.1.5.2" class="ltx_td ltx_align_center ltx_border_bb">-</td>
<td id="A4.T3.4.1.5.3" class="ltx_td ltx_align_center ltx_border_bb">300</td>
<td id="A4.T3.4.1.5.4" class="ltx_td ltx_align_left ltx_border_bb"><a href="https://huggingface.co/datasets/princeton-nlp/SWE-bench_Lite" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/datasets/princeton-nlp/SWE-bench_Lite</a></td></tr>
</tbody>
</table>
</span></div>
</figure>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Scaffold Details</h3>

<div id="A4.SS2.p1" class="ltx_para ltx_noindent">
<p id="A4.SS2.p1.1" class="ltx_p">In our experiments, we utilize the standard R2E scaffold, which is recognized for its flexibility, ease of use, and robust performance. This scaffold equips the agent with four essential tools: <span id="A4.SS2.p1.1.1" class="ltx_text ltx_font_typewriter">file_editor</span> for file editing, <span id="A4.SS2.p1.1.2" class="ltx_text ltx_font_typewriter">execute_bash</span> for running bash commands, <span id="A4.SS2.p1.1.3" class="ltx_text ltx_font_typewriter">search</span> for file and code retrieval, and <span id="A4.SS2.p1.1.4" class="ltx_text ltx_font_typewriter">finish</span> to conclude the task. The complete system prompt, detailing the functionality and parameters of each tool, is provided below.</p>
</div>
<div id="A4.SS2.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.SS2.p2.pic1" class="ltx_picture" height="3606.81" overflow="visible" version="1.1" viewBox="0 0 550 3606.81" width="550"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,3606.81) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#0000BF;" fill="#0000BF" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 3600.9 C 0 3604.17 2.64 3606.81 5.91 3606.81 L 544.09 3606.81 C 547.36 3606.81 550 3604.17 550 3600.9 L 550 5.91 C 550 2.64 547.36 0 544.09 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2FF;" fill="#F2F2FF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 3582.7 L 548.03 3582.7 L 548.03 5.91 C 548.03 3.73 546.27 1.97 544.09 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 3591.29)"><foreignObject style="--ltx-fo-width:31.84em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="440.58"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A4.SS2.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:31.84em;">
<span id="A4.SS2.p2.pic1.1.1" class="ltx_p"><span id="A4.SS2.p2.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">System Prompt of the Scaffold</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 173.6)"><foreignObject style="--ltx-fo-width:36.62em;--ltx-fo-height:245.52em;--ltx-fo-depth:11.55em;font-size:10pt;" height="3557.15" overflow="visible" transform="matrix(1 0 0 -1 0 3397.33)" width="506.72"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A4.SS2.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:36.62em;">
<span id="A4.SS2.p2.pic1.2.1" class="ltx_p"><span id="A4.SS2.p2.pic1.2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">You are a programming agent who is provided a github issue and repository bash environment and is tasked to solve certain tasks (e.g., file localization, testcase generation, code repair and editing etc) to resolve the issue.</span></span>
<span id="A4.SS2.p2.pic1.2.2" class="ltx_p"><span id="A4.SS2.p2.pic1.2.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">We have access to the following functions:</span></span>
<span id="A4.SS2.p2.pic1.2.3" class="ltx_p"><span id="A4.SS2.p2.pic1.2.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">— BEGIN FUNCTION #1: <span id="A4.SS2.p2.pic1.2.3.1.1" class="ltx_text ltx_font_typewriter">file_editor</span> —</span></span>
<span id="A4.SS2.p2.pic1.2.4" class="ltx_p"><span id="A4.SS2.p2.pic1.2.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Description<span id="A4.SS2.p2.pic1.2.4.1.1" class="ltx_text ltx_font_medium">: Custom editing tool for viewing, creating and editing files.</span></span></span>
<span id="A4.I1" class="ltx_itemize ltx_leftmargin_flush">
<span id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I1.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I1.i1.p1.1" class="ltx_p"><span id="A4.I1.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">State is persistent across command calls and discussions with the user</span></span>
</span></span>
<span id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I1.i2.p1" class="ltx_para ltx_noindent">
<span id="A4.I1.i2.p1.1" class="ltx_p"><span id="A4.I1.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If path is a file, view displays the result of applying </span><span id="A4.I1.i2.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">cat -n</span><span id="A4.I1.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">. If path is a directory, view lists non-hidden files and directories up to 2 levels deep</span></span>
</span></span>
<span id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I1.i3.p1" class="ltx_para ltx_noindent">
<span id="A4.I1.i3.p1.1" class="ltx_p"><span id="A4.I1.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The create command cannot be used if the specified path already exists as a file</span></span>
</span></span>
<span id="A4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I1.i4.p1" class="ltx_para ltx_noindent">
<span id="A4.I1.i4.p1.1" class="ltx_p"><span id="A4.I1.i4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If a command generates a long output, it will be truncated and marked with </span><span id="A4.I1.i4.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">&lt;response clipped&gt;</span></span>
</span></span>
<span id="A4.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I1.i5.p1" class="ltx_para">
<span id="A4.I1.i5.p1.1" class="ltx_p"><span id="A4.I1.i5.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The </span><span id="A4.I1.i5.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">undo_edit</span><span id="A4.I1.i5.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> command will revert the last edit made to the file at path</span></span>
</span></span>
</span>
<span id="A4.SS2.p2.pic1.2.5" class="ltx_p"><span id="A4.SS2.p2.pic1.2.5.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Notes for using the <span id="A4.SS2.p2.pic1.2.5.1.1" class="ltx_text ltx_font_typewriter">str_replace</span> command<span id="A4.SS2.p2.pic1.2.5.1.2" class="ltx_text ltx_font_medium">:</span></span></span>
<span id="A4.I2" class="ltx_itemize ltx_leftmargin_flush">
<span id="A4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I2.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I2.i1.p1.1" class="ltx_p"><span id="A4.I2.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The </span><span id="A4.I2.i1.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">old_str</span><span id="A4.I2.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> parameter should match EXACTLY one or more consecutive lines from the original file. Be mindful of whitespaces!</span></span>
</span></span>
<span id="A4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I2.i2.p1" class="ltx_para ltx_noindent">
<span id="A4.I2.i2.p1.1" class="ltx_p"><span id="A4.I2.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If the </span><span id="A4.I2.i2.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">old_str</span><span id="A4.I2.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> parameter is not unique in the file, the replacement will not be performed. Make sure to include enough context in </span><span id="A4.I2.i2.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">old_str</span><span id="A4.I2.i2.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> to make it unique</span></span>
</span></span>
<span id="A4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I2.i3.p1" class="ltx_para">
<span id="A4.I2.i3.p1.1" class="ltx_p"><span id="A4.I2.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The </span><span id="A4.I2.i3.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">new_str</span><span id="A4.I2.i3.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> parameter should contain the edited lines that should replace the </span><span id="A4.I2.i3.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">old_str</span></span>
</span></span>
</span>
<span id="A4.SS2.p2.pic1.2.6" class="ltx_p"><span id="A4.SS2.p2.pic1.2.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Parameters<span id="A4.SS2.p2.pic1.2.6.1.1" class="ltx_text ltx_font_medium">:</span></span></span>
<span id="A4.I3" class="ltx_enumerate ltx_leftmargin_flush">
<span id="A4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="A4.I3.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i1.p1.1" class="ltx_p"><span id="A4.I3.i1.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">command</span><span id="A4.I3.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (string, required) </span>
<br class="ltx_break"><span id="A4.I3.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">Allowed values: </span><span id="A4.I3.i1.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[view, create, str_replace, insert, undo_edit]</span><span id="A4.I3.i1.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">. The command to run.</span></span>
</span></span>
<span id="A4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<span id="A4.I3.i2.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i2.p1.1" class="ltx_p"><span id="A4.I3.i2.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">path</span><span id="A4.I3.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (string, required) </span>
<br class="ltx_break"><span id="A4.I3.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">Absolute path to file or directory, e.g. </span><span id="A4.I3.i2.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">/testbed/file.py</span><span id="A4.I3.i2.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> or </span><span id="A4.I3.i2.p1.1.6" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">/testbed</span><span id="A4.I3.i2.p1.1.7" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A4.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<span id="A4.I3.i3.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i3.p1.1" class="ltx_p"><span id="A4.I3.i3.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">file_text</span><span id="A4.I3.i3.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (string, optional) </span>
<br class="ltx_break"><span id="A4.I3.i3.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">Required for the </span><span id="A4.I3.i3.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">create</span><span id="A4.I3.i3.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> command. Contains the content of the file to be created.</span></span>
</span></span>
<span id="A4.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<span id="A4.I3.i4.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i4.p1.1" class="ltx_p"><span id="A4.I3.i4.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">old_str</span><span id="A4.I3.i4.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (string, optional) </span>
<br class="ltx_break"><span id="A4.I3.i4.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">Required for the </span><span id="A4.I3.i4.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">str_replace</span><span id="A4.I3.i4.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> command. The exact string in path to replace.</span></span>
</span></span>
<span id="A4.I3.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">5.</span> 
<span id="A4.I3.i5.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i5.p1.1" class="ltx_p"><span id="A4.I3.i5.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">new_str</span><span id="A4.I3.i5.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (string, optional)</span></span>
<span id="A4.I3.i5.I1" class="ltx_itemize ltx_leftmargin_flush">
<span id="A4.I3.i5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I3.i5.I1.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i5.I1.i1.p1.1" class="ltx_p"><span id="A4.I3.i5.I1.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Optional for the </span><span id="A4.I3.i5.I1.i1.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">str_replace</span><span id="A4.I3.i5.I1.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> command to specify the replacement string.</span></span>
</span></span>
<span id="A4.I3.i5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I3.i5.I1.i2.p1" class="ltx_para">
<span id="A4.I3.i5.I1.i2.p1.1" class="ltx_p"><span id="A4.I3.i5.I1.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Required for the </span><span id="A4.I3.i5.I1.i2.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">insert</span><span id="A4.I3.i5.I1.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> command to specify the string to insert.</span></span>
</span></span>
</span>
</span></span>
<span id="A4.I3.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">6.</span> 
<span id="A4.I3.i6.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i6.p1.1" class="ltx_p"><span id="A4.I3.i6.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">insert_line</span><span id="A4.I3.i6.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (integer, optional) </span>
<br class="ltx_break"><span id="A4.I3.i6.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">Required for the </span><span id="A4.I3.i6.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">insert</span><span id="A4.I3.i6.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> command. The </span><span id="A4.I3.i6.p1.1.6" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">new_str</span><span id="A4.I3.i6.p1.1.7" class="ltx_text" style="--ltx-fg-color:#000000;"> will be inserted after the line number specified here.</span></span>
</span></span>
<span id="A4.I3.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">7.</span> 
<span id="A4.I3.i7.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i7.p1.1" class="ltx_p"><span id="A4.I3.i7.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">view_range</span><span id="A4.I3.i7.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (array, optional)</span></span>
<span id="A4.I3.i7.I1" class="ltx_itemize ltx_leftmargin_flush">
<span id="A4.I3.i7.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I3.i7.I1.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i7.I1.i1.p1.1" class="ltx_p"><span id="A4.I3.i7.I1.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Optional for the </span><span id="A4.I3.i7.I1.i1.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">view</span><span id="A4.I3.i7.I1.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> command (when path is a file).</span></span>
</span></span>
<span id="A4.I3.i7.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I3.i7.I1.i2.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i7.I1.i2.p1.1" class="ltx_p"><span id="A4.I3.i7.I1.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If provided, specifies the line range to view, e.g. </span><span id="A4.I3.i7.I1.i2.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[11, 12]</span><span id="A4.I3.i7.I1.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> shows lines 11 and 12.</span></span>
</span></span>
<span id="A4.I3.i7.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I3.i7.I1.i3.p1" class="ltx_para">
<span id="A4.I3.i7.I1.i3.p1.1" class="ltx_p"><span id="A4.I3.i7.I1.i3.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[start_line, -1]</span><span id="A4.I3.i7.I1.i3.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> will show all lines from </span><span id="A4.I3.i7.I1.i3.p1.1.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">start_line</span><span id="A4.I3.i7.I1.i3.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> to the end of file.</span></span>
</span></span>
</span>
</span></span>
<span id="A4.I3.i8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">8.</span> 
<span id="A4.I3.i8.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i8.p1.1" class="ltx_p"><span id="A4.I3.i8.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">concise</span><span id="A4.I3.i8.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (boolean, optional)</span></span>
<span id="A4.I3.i8.I1" class="ltx_itemize ltx_leftmargin_flush">
<span id="A4.I3.i8.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I3.i8.I1.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I3.i8.I1.i1.p1.1" class="ltx_p"><span id="A4.I3.i8.I1.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Optional for the </span><span id="A4.I3.i8.I1.i1.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">view</span><span id="A4.I3.i8.I1.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> command.</span></span>
</span></span>
<span id="A4.I3.i8.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I3.i8.I1.i2.p1" class="ltx_para">
<span id="A4.I3.i8.I1.i2.p1.1" class="ltx_p"><span id="A4.I3.i8.I1.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Displays a concise skeletal view of the file. If set to </span><span id="A4.I3.i8.I1.i2.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">False</span><span id="A4.I3.i8.I1.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, displays the full content in the specified </span><span id="A4.I3.i8.I1.i2.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">view_range</span><span id="A4.I3.i8.I1.i2.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
</span>
</span></span>
</span>
<span id="A4.SS2.p2.pic1.2.7" class="ltx_p"><span id="A4.SS2.p2.pic1.2.7.1" class="ltx_text" style="--ltx-fg-color:#000000;">— END FUNCTION #1 —</span></span>
<span id="A4.SS2.p2.pic1.2.8" class="ltx_p"><span id="A4.SS2.p2.pic1.2.8.1" class="ltx_text" style="--ltx-fg-color:#000000;">— BEGIN FUNCTION #2: <span id="A4.SS2.p2.pic1.2.8.1.1" class="ltx_text ltx_font_typewriter">execute_bash</span> —</span></span>
<span id="A4.SS2.p2.pic1.2.9" class="ltx_p"><span id="A4.SS2.p2.pic1.2.9.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Description<span id="A4.SS2.p2.pic1.2.9.1.1" class="ltx_text ltx_font_medium">: Execute a bash command in the terminal.</span></span></span>
<span id="A4.SS2.p2.pic1.2.10" class="ltx_p"><span id="A4.SS2.p2.pic1.2.10.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Behavior notes<span id="A4.SS2.p2.pic1.2.10.1.1" class="ltx_text ltx_font_medium">:</span></span></span>
<span id="A4.I4" class="ltx_itemize ltx_leftmargin_flush">
<span id="A4.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I4.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I4.i1.p1.1" class="ltx_p"><span id="A4.I4.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If a command may run indefinitely (long-running), consider running it in the background and redirecting output, e.g. </span><code id="A4.I4.i1.p1.1.2" class="ltx_verbatim ltx_font_typewriter" style="--ltx-fg-color:#000000;">python3 app.py &gt; server.log 2&gt;&amp;1 &amp;</code><span id="A4.I4.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A4.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I4.i2.p1" class="ltx_para ltx_noindent">
<span id="A4.I4.i2.p1.1" class="ltx_p"><span id="A4.I4.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If the bash command returns exit code -1, it means the process is still running. The assistant may:</span></span>
<span id="A4.I4.i2.I2" class="ltx_itemize ltx_leftmargin_flush">
<span id="A4.I4.i2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A4.I4.i2.I2.i1.1" class="ltx_text ltx_font_bold">–</span></span> 
<span id="A4.I4.i2.I2.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I4.i2.I2.i1.p1.1" class="ltx_p"><span id="A4.I4.i2.I2.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Call this function again with command as an empty string (””) to retrieve additional logs.</span></span>
</span></span>
<span id="A4.I4.i2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A4.I4.i2.I2.i2.1" class="ltx_text ltx_font_bold">–</span></span> 
<span id="A4.I4.i2.I2.i2.p1" class="ltx_para ltx_noindent">
<span id="A4.I4.i2.I2.i2.p1.1" class="ltx_p"><span id="A4.I4.i2.I2.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Send more input to STDIN of the running process by calling this function again with command set to the text input.</span></span>
</span></span>
<span id="A4.I4.i2.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"><span id="A4.I4.i2.I2.i3.1" class="ltx_text ltx_font_bold">–</span></span> 
<span id="A4.I4.i2.I2.i3.p1" class="ltx_para">
<span id="A4.I4.i2.I2.i3.p1.1" class="ltx_p"><span id="A4.I4.i2.I2.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Send </span><span id="A4.I4.i2.I2.i3.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">command="ctrl+c"</span><span id="A4.I4.i2.I2.i3.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> to interrupt the currently running process.</span></span>
</span></span>
</span>
</span></span>
<span id="A4.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I4.i3.p1" class="ltx_para">
<span id="A4.I4.i3.p1.1" class="ltx_p"><span id="A4.I4.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If the command times out, it will be interrupted (SIGINT). The assistant may then retry or do further steps if needed.</span></span>
</span></span>
</span>
<span id="A4.SS2.p2.pic1.2.11" class="ltx_p"><span id="A4.SS2.p2.pic1.2.11.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Parameters<span id="A4.SS2.p2.pic1.2.11.1.1" class="ltx_text ltx_font_medium">:</span></span></span>
<span id="A4.I5" class="ltx_enumerate ltx_leftmargin_flush">
<span id="A4.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="A4.I5.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I5.i1.p1.1" class="ltx_p"><span id="A4.I5.i1.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">cmd</span><span id="A4.I5.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (string, required) </span>
<br class="ltx_break"><span id="A4.I5.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">The bash command (and optional arguments) to execute.</span></span>
<span id="A4.I5.i1.I1" class="ltx_itemize">
<span id="A4.I5.i1.I0.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I5.i1.I0.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I5.i1.I0.i1.p1.1" class="ltx_p"><span id="A4.I5.i1.I0.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Can be empty (””) to retrieve more logs if the process is still running.</span></span>
</span></span>
<span id="A4.I5.i1.I0.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I5.i1.I0.i2.p1" class="ltx_para">
<span id="A4.I5.i1.I0.i2.p1.1" class="ltx_p"><span id="A4.I5.i1.I0.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Can be ”ctrl+c” to interrupt the running process.</span></span>
</span></span>
</span>
</span></span>
</span>
<span id="A4.SS2.p2.pic1.2.12" class="ltx_p"><span id="A4.SS2.p2.pic1.2.12.1" class="ltx_text" style="--ltx-fg-color:#000000;">— END FUNCTION #2 —</span></span>
<span id="A4.SS2.p2.pic1.2.13" class="ltx_p"><span id="A4.SS2.p2.pic1.2.13.1" class="ltx_text" style="--ltx-fg-color:#000000;">— BEGIN FUNCTION #3: <span id="A4.SS2.p2.pic1.2.13.1.1" class="ltx_text ltx_font_typewriter">search</span> —</span></span>
<span id="A4.SS2.p2.pic1.2.14" class="ltx_p"><span id="A4.SS2.p2.pic1.2.14.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Description<span id="A4.SS2.p2.pic1.2.14.1.1" class="ltx_text ltx_font_medium">: Search for a term in a directory or a single file.</span></span></span>
<span id="A4.I6" class="ltx_itemize ltx_leftmargin_flush">
<span id="A4.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I6.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I6.i1.p1.1" class="ltx_p"><span id="A4.I6.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If path is a directory (or unspecified, default is </span><span id="A4.I6.i1.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">.</span><span id="A4.I6.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> ), it recursively searches all non-hidden files and directories for the search term.</span></span>
</span></span>
<span id="A4.I6.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I6.i2.p1" class="ltx_para ltx_noindent">
<span id="A4.I6.i2.p1.1" class="ltx_p"><span id="A4.I6.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If path points to a file, it runs a </span><span id="A4.I6.i2.p1.1.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">grep -n</span><span id="A4.I6.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> in that file to show line numbers matching the search term.</span></span>
</span></span>
<span id="A4.I6.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I6.i3.p1" class="ltx_para ltx_noindent">
<span id="A4.I6.i3.p1.1" class="ltx_p"><span id="A4.I6.i3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If more than 100 files match in a directory search, results are truncated and the tool will inform you to narrow your search.</span></span>
</span></span>
<span id="A4.I6.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I6.i4.p1" class="ltx_para">
<span id="A4.I6.i4.p1.1" class="ltx_p"><span id="A4.I6.i4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">If no matches are found, it will inform you as well.</span></span>
</span></span>
</span>
<span id="A4.SS2.p2.pic1.2.15" class="ltx_p"><span id="A4.SS2.p2.pic1.2.15.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Parameters<span id="A4.SS2.p2.pic1.2.15.1.1" class="ltx_text ltx_font_medium">:</span></span></span>
<span id="A4.I7" class="ltx_enumerate ltx_leftmargin_flush">
<span id="A4.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="A4.I7.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I7.i1.p1.1" class="ltx_p"><span id="A4.I7.i1.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">search_term</span><span id="A4.I7.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (string, required) </span>
<br class="ltx_break"><span id="A4.I7.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">The term or string to search for in files.</span></span>
</span></span>
<span id="A4.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<span id="A4.I7.i2.p1" class="ltx_para">
<span id="A4.I7.i2.p1.1" class="ltx_p"><span id="A4.I7.i2.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">path</span><span id="A4.I7.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (string, optional) </span>
<br class="ltx_break"><span id="A4.I7.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">The file or directory to search in. Defaults to </span><span id="A4.I7.i2.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">.</span><span id="A4.I7.i2.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;"> if not specified.</span></span>
</span></span>
</span>
<span id="A4.SS2.p2.pic1.2.16" class="ltx_p"><span id="A4.SS2.p2.pic1.2.16.1" class="ltx_text" style="--ltx-fg-color:#000000;">— END FUNCTION #3 —</span></span>
<span id="A4.SS2.p2.pic1.2.17" class="ltx_p"><span id="A4.SS2.p2.pic1.2.17.1" class="ltx_text" style="--ltx-fg-color:#000000;">— BEGIN FUNCTION #4: <span id="A4.SS2.p2.pic1.2.17.1.1" class="ltx_text ltx_font_typewriter">finish</span> —</span></span>
<span id="A4.SS2.p2.pic1.2.18" class="ltx_p"><span id="A4.SS2.p2.pic1.2.18.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Description<span id="A4.SS2.p2.pic1.2.18.1.1" class="ltx_text ltx_font_medium">: Finish the interaction once the task is complete or if no further progress can be made.</span></span></span>
<span id="A4.SS2.p2.pic1.2.19" class="ltx_p"><span id="A4.SS2.p2.pic1.2.19.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Behavior notes<span id="A4.SS2.p2.pic1.2.19.1.1" class="ltx_text ltx_font_medium">:</span></span></span>
<span id="A4.I8" class="ltx_itemize ltx_leftmargin_flush">
<span id="A4.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A4.I8.i1.p1" class="ltx_para">
<span id="A4.I8.i1.p1.1" class="ltx_p"><span id="A4.I8.i1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The submit command finalizes your output.</span></span>
</span></span>
</span>
<span id="A4.SS2.p2.pic1.2.20" class="ltx_p"><span id="A4.SS2.p2.pic1.2.20.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Parameters<span id="A4.SS2.p2.pic1.2.20.1.1" class="ltx_text ltx_font_medium">:</span></span></span>
<span id="A4.I9" class="ltx_enumerate ltx_leftmargin_flush">
<span id="A4.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<span id="A4.I9.i1.p1" class="ltx_para ltx_noindent">
<span id="A4.I9.i1.p1.1" class="ltx_p"><span id="A4.I9.i1.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">command</span><span id="A4.I9.i1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (string, required) </span>
<br class="ltx_break"><span id="A4.I9.i1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">Currently allowed value: </span><span id="A4.I9.i1.p1.1.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">[submit]</span><span id="A4.I9.i1.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></span>
</span></span>
<span id="A4.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<span id="A4.I9.i2.p1" class="ltx_para">
<span id="A4.I9.i2.p1.1" class="ltx_p"><span id="A4.I9.i2.p1.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">result</span><span id="A4.I9.i2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> (string, optional) </span>
<br class="ltx_break"><span id="A4.I9.i2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">The result text or final message to submit. Defaults to an empty string if not provided.</span></span>
</span></span>
</span>
<span id="A4.SS2.p2.pic1.2.21" class="ltx_p"><span id="A4.SS2.p2.pic1.2.21.1" class="ltx_text" style="--ltx-fg-color:#000000;">— END FUNCTION #4 —</span></span>
<span id="A4.SS2.p2.pic1.2.22" class="ltx_p"><span id="A4.SS2.p2.pic1.2.22.1" class="ltx_text" style="--ltx-fg-color:#000000;">If you choose to call a function ONLY reply in the following format with NO suffix:</span></span><pre id="A4.SS2.p2.pic1.2.23" class="ltx_verbatim ltx_font_typewriter" style="--ltx-fg-color:#000000;">&lt;function=example_function_name&gt;
&lt;parameter=example_parameter_1&gt;value_1&lt;/parameter&gt;
&lt;parameter=example_parameter_2&gt;
