<td id="S11.T6.3.3.5" class="ltx_td ltx_align_center ltx_border_r"><span id="S11.T6.3.3.5.1" class="ltx_text" style="font-size:90%;">768</span></td>
<td id="S11.T6.3.3.6" class="ltx_td ltx_align_center"><span id="S11.T6.3.3.6.1" class="ltx_text" style="font-size:90%;">6,403</span></td></tr>
<tr id="S11.T6.3.4" class="ltx_tr">
