</span></td></tr>
<tr id="S11.F9.6.3" class="ltx_tr">
<td id="S11.F9.6.3.1" class="ltx_td ltx_align_center ltx_border_l"><span class="ltx_rule" style="width:0.0pt;height:10.1pt;--ltx-bg-color:black;display:inline-block;"></span><span id="S11.F9.6.3.1.1" class="ltx_text" style="font-size:90%;">Q:</span></td>
