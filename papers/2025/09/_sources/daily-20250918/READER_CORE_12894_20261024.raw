<td id="S11.T6.3.4.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S11.T6.3.4.4.1" class="ltx_text" style="font-size:90%;">529</span></td>
<td id="S11.T6.3.4.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><span id="S11.T6.3.4.5.1" class="ltx_text" style="font-size:90%;">483</span></td>
<td id="S11.T6.3.4.6" class="ltx_td ltx_align_center ltx_border_b"><span id="S11.T6.3.4.6.1" class="ltx_text" style="font-size:90%;">4,172</span></td></tr>
