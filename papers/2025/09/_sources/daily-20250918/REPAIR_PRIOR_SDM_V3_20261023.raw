                <span id="alg4.l3.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg4.l3.m1" class="ltx_Math" alttext="\sdmVerificationLayer,\trainSplit_{*},\calibrationSplit_{*},{\mathcal{E}}\leftarrow" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps" mathsize="0.900em">verificationLayer</mtext><mo mathsize="0.900em">,</mo><mmultiscripts><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mi mathsize="0.900em">tr</mi><mrow></mrow><mo mathsize="0.900em">∗</mo><mrow></mrow></mmultiscripts><mo mathsize="0.900em">,</mo><mmultiscripts><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mi mathsize="0.900em">ca</mi><mrow></mrow><mo mathsize="0.900em">∗</mo><mrow></mrow></mmultiscripts><mo mathsize="0.900em">,</mo><mrow><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℰ</mi><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\sdmVerificationLayer,\trainSplit_{*},\calibrationSplit_{*},{\mathcal{E}}\leftarrow</annotation></semantics></math><span id="alg4.l3.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg4.l3.5" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">sdm-iterative-train</span><span id="alg4.l3.6" class="ltx_text" style="font-size:90%;">(</span><math id="alg4.l3.m2" class="ltx_Math" alttext="\cdot" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">⋅</mo><annotation encoding="application/x-tex">\cdot</annotation></semantics></math><span id="alg4.l3.7" class="ltx_text" style="font-size:90%;">) </span><span id="alg4.l3.8" class="ltx_text" style="font-size:90%;float:right;"><math id="alg4.l3.m3" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math>  Alg. <a href="#alg1" title="Algorithm 1 ‣ 4.2 From SDM Activation Functions to SDM Calibration ‣ 4 Methods ‣ Similarity-Distance-Magnitude Universal Verification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>
</span>
