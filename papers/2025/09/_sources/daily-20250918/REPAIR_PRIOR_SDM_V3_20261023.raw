                <math id="alg4.l1.m1" class="ltx_Math" alttext="\trainSplit" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mi mathsize="0.900em">tr</mi></msub><annotation encoding="application/x-tex">\trainSplit</annotation></semantics></math><span id="alg4.l1.3" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l1.m2" class="ltx_Math" alttext="\calibrationSplit" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mi mathsize="0.900em">ca</mi></msub><annotation encoding="application/x-tex">\calibrationSplit</annotation></semantics></math><span id="alg4.l1.4" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l1.m3" class="ltx_Math" alttext="\alpha^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">′</mo></msup><annotation encoding="application/x-tex">\alpha^{\prime}</annotation></semantics></math><span id="alg4.l1.5" class="ltx_text" style="font-size:90%;">, </span><span id="alg4.l1.6" class="ltx_text ltx_markedasmath" style="font-size:90%;">max epochs</span><span id="alg4.l1.7" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l1.m5" class="ltx_Math" alttext="{\mathcal{M}}^{\rm{ref}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">ref</mi></msup><annotation encoding="application/x-tex">{\mathcal{M}}^{\rm{ref}}</annotation></semantics></math><span id="alg4.l1.8" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l1.m6" class="ltx_Math" alttext="{\mathcal{M}}^{\rm{neg}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">neg</mi></msup><annotation encoding="application/x-tex">{\mathcal{M}}^{\rm{neg}}</annotation></semantics></math><span id="alg4.l1.9" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l1.m7" class="ltx_Math" alttext="{\mathcal{M}}^{\rm{pos}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">pos</mi></msup><annotation encoding="application/x-tex">{\mathcal{M}}^{\rm{pos}}</annotation></semantics></math><span id="alg4.l1.10" class="ltx_text" style="font-size:90%;"> </span>
</div>
<div id="alg4.l2" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:90%;">2:</span></span>
                  
                  
                <span id="alg4.l2.3" class="ltx_text ltx_font_bold" style="font-size:90%;">procedure</span><span id="alg4.l2.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg4.l2.5" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">sdm-network-train</span><span id="alg4.l2.6" class="ltx_text" style="font-size:90%;">(</span><math id="alg4.l2.m1" class="ltx_Math" alttext="\trainSplit" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mi mathsize="0.900em">tr</mi></msub><annotation encoding="application/x-tex">\trainSplit</annotation></semantics></math><span id="alg4.l2.7" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l2.m2" class="ltx_Math" alttext="\calibrationSplit" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mi mathsize="0.900em">ca</mi></msub><annotation encoding="application/x-tex">\calibrationSplit</annotation></semantics></math><span id="alg4.l2.8" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l2.m3" class="ltx_Math" alttext="\alpha^{\prime}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">α</mi><mo mathsize="0.900em">′</mo></msup><annotation encoding="application/x-tex">\alpha^{\prime}</annotation></semantics></math><span id="alg4.l2.9" class="ltx_text" style="font-size:90%;">, </span><span id="alg4.l2.10" class="ltx_text ltx_markedasmath" style="font-size:90%;">max epochs</span><span id="alg4.l2.11" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l2.m5" class="ltx_Math" alttext="{\mathcal{M}}^{\rm{ref}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">ref</mi></msup><annotation encoding="application/x-tex">{\mathcal{M}}^{\rm{ref}}</annotation></semantics></math><span id="alg4.l2.12" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l2.m6" class="ltx_Math" alttext="{\mathcal{M}}^{\rm{neg}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">neg</mi></msup><annotation encoding="application/x-tex">{\mathcal{M}}^{\rm{neg}}</annotation></semantics></math><span id="alg4.l2.13" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l2.m7" class="ltx_Math" alttext="{\mathcal{M}}^{\rm{pos}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">pos</mi></msup><annotation encoding="application/x-tex">{\mathcal{M}}^{\rm{pos}}</annotation></semantics></math><span id="alg4.l2.14" class="ltx_text" style="font-size:90%;">)
</span>
