"ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx33.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">inaccuracies</span><span id="lstnumberx33.20" class="ltx_text ltx_font_typewriter" style="font-size:50%;">.</span><span id="lstnumberx33.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx33.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">Respond</span><span id="lstnumberx33.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx33.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">using</span><span id="lstnumberx33.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx33.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">the</span><span id="lstnumberx33.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx33.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">following</span><span id="lstnumberx33.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx33.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">JSON</span><span id="lstnumberx33.31" class="ltx_text ltx_font_typewriter" style="font-size:50%;">:</span><span id="lstnumberx33.32" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx33.33" class="ltx_text ltx_font_typewriter" style="font-size:50%;">{"</span><span id="lstnumberx33.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">correctness</span><span id="lstnumberx33.35" class="ltx_text ltx_font_typewriter" style="font-size:50%;">":</span><span id="lstnumberx33.36" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx33.37" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">bool</span><span id="lstnumberx33.38" class="ltx_text ltx_font_typewriter" style="font-size:50%;">}.</span><span id="lstnumberx33.39" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx33.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">DOCUMENT</span><span id="lstnumberx33.41" class="ltx_text ltx_font_typewriter" style="font-size:50%;">:</span><span id="lstnumberx33.42" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx33.43" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">TEXT</span><span id="lstnumberx33.44" class="ltx_text ltx_font_typewriter" style="font-size:50%;">&lt;|</span><span id="lstnumberx33.45" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">end</span><span id="lstnumberx33.46" class="ltx_text ltx_font_typewriter" style="font-size:50%;">|&gt;</span>
</div>
<div id="lstnumberx34" class="ltx_listingline"><span id="lstnumberx34.1" class="ltx_text ltx_font_typewriter" style="font-size:50%;">&lt;|</span><span id="lstnumberx34.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">assistant</span><span id="lstnumberx34.3" class="ltx_text ltx_font_typewriter" style="font-size:50%;">|&gt;</span>
</div>
</div>
</figure>
</section>
<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Additional Training Details</h3>

<section id="A1.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Compute.</h5>

<div id="A1.SS3.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px1.p1.1" class="ltx_p">The black-box LLM experiments require API calls, as detailed in the main text, but all other results can be reproduced locally on a single 2023 Mac Studio with an M2 Ultra chip with 128 GB of unified memory. These experiments are designed to fully assess the methods while still being replicable with consumer hardware.</p>
</div>
</section>
<section id="A1.SS3.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Hyper-parameters.</h5>

<div id="A1.SS3.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px2.p1.1" class="ltx_p">In the code repo, we include scripts for replicating our results. For all cases, we train the rescaling transform (Alg. <a href="#alg2" title="Algorithm 2 ‣ 4.2.2 Training the Rescaling Transform ‣ 4.2 From SDM Activation Functions to SDM Calibration ‣ 4 Methods ‣ Similarity-Distance-Magnitude Universal Verification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) for up to 1000 epochs, with early stopping if the loss exceeds the min observed loss for 10 consecutive epochs. In all experiments, <math id="A1.SS3.SSS0.Px2.p1.m1" class="ltx_Math" alttext="M=1000" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>1000</mn></mrow><annotation encoding="application/x-tex">M=1000</annotation></semantics></math> and we use a mini-batch size of 50. We mean center the input to <math id="A1.SS3.SSS0.Px2.p1.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math>, the 1-D CNN of the <math id="A1.SS3.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\sdm" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">sdm</mtext><annotation encoding="application/x-tex">\sdm</annotation></semantics></math> activation layer, via the mean and standard deviation over <math id="A1.SS3.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\trainSplit" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>tr</mi></msub><annotation encoding="application/x-tex">\trainSplit</annotation></semantics></math>. We train <math id="A1.SS3.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\modelGPTFourOSDM" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">gpt-4o+sdm</mtext><annotation encoding="application/x-tex">\modelGPTFourOSDM</annotation></semantics></math> for <math id="A1.SS3.SSS0.Px2.p1.m6" class="ltx_Math" alttext="J=10" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">J=10</annotation></semantics></math> iterations of 5 epochs, and the <math id="A1.SS3.SSS0.Px2.p1.m7" class="ltx_Math" alttext="\sdm" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">sdm</mtext><annotation encoding="application/x-tex">\sdm</annotation></semantics></math> models of <math id="A1.SS3.SSS0.Px2.p1.m8" class="ltx_Math" alttext="\datasetSentiment" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">Sentiment</mtext><annotation encoding="application/x-tex">\datasetSentiment</annotation></semantics></math> and <math id="A1.SS3.SSS0.Px2.p1.m9" class="ltx_Math" alttext="\datasetFactcheck" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">Factcheck</mtext><annotation encoding="application/x-tex">\datasetFactcheck</annotation></semantics></math>, as well as the <math id="A1.SS3.SSS0.Px2.p1.m10" class="ltx_Math" alttext="\sdmVerificationLayer" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">verificationLayer</mtext><annotation encoding="application/x-tex">\sdmVerificationLayer</annotation></semantics></math> of the <math id="A1.SS3.SSS0.Px2.p1.m11" class="ltx_Math" alttext="\sdm" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">sdm</mtext><annotation encoding="application/x-tex">\sdm</annotation></semantics></math> network, for <math id="A1.SS3.SSS0.Px2.p1.m12" class="ltx_Math" alttext="J=10" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">J=10</annotation></semantics></math> iterations of 50 epochs. The standard exemplar adaptors of the <math id="A1.SS3.SSS0.Px2.p1.m13" class="ltx_Math" alttext="\datasetSentiment" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">Sentiment</mtext><annotation encoding="application/x-tex">\datasetSentiment</annotation></semantics></math> and <math id="A1.SS3.SSS0.Px2.p1.m14" class="ltx_Math" alttext="\datasetFactcheck" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">Factcheck</mtext><annotation encoding="application/x-tex">\datasetFactcheck</annotation></semantics></math> classification experiments are trained with cross-entropy losses for 50 epochs. We use the Adam optimizer <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib24" title="" class="ltx_ref">Kingma &amp; Ba, 2017</a>)</cite> with a learning rate of <math id="A1.SS3.SSS0.Px2.p1.m15" class="ltx_Math" alttext="1\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-4}</annotation></semantics></math> for training the rescaling transform (Alg. <a href="#alg2" title="Algorithm 2 ‣ 4.2.2 Training the Rescaling Transform ‣ 4.2 From SDM Activation Functions to SDM Calibration ‣ 4 Methods ‣ Similarity-Distance-Magnitude Universal Verification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) and <math id="A1.SS3.SSS0.Px2.p1.m16" class="ltx_Math" alttext="1\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-5}</annotation></semantics></math> for all other cases.</p>
</div>
</section>
</section>
<section id="A1.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.4 </span>Example Implementation of the SDM Activation Function</h3>

<div id="A1.SS4.p1" class="ltx_para ltx_noindent">
<p id="A1.SS4.p1.1" class="ltx_p">We include an implementation of the <math id="A1.SS4.p1.m1" class="ltx_Math" alttext="\sdm" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">sdm</mtext><annotation encoding="application/x-tex">\sdm</annotation></semantics></math> activation function using PyTorch <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib33" title="" class="ltx_ref">Paszke et al., 2019</a>)</cite>, version 2.3.0, in Listing <a href="#LST3" title="Listing 3 ‣ A.4 Example Implementation of the SDM Activation Function ‣ Appendix A Appendix ‣ Similarity-Distance-Magnitude Universal Verification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<figure id="LST3" class="ltx_float ltx_lstlisting ltx_minipage ltx_align_middle" style="width:469.8pt;">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float">Listing 3: </span>Implementation of the <math id="LST3.m2" class="ltx_Math" alttext="\sdm" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">sdm</mtext><annotation encoding="application/x-tex">\sdm</annotation></semantics></math> activation function in PyTorch, version 2.3.0.</figcaption>
<div id="LST3.2" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx35" class="ltx_listingline"><span id="lstnumberx35.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">def</span><span id="lstnumberx35.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx35.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">sdm_activation_function</span><span id="lstnumberx35.4" class="ltx_text ltx_font_typewriter" style="font-size:50%;">(</span><span id="lstnumberx35.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">batch_input</span><span id="lstnumberx35.6" class="ltx_text ltx_font_typewriter" style="font-size:50%;">,</span><span id="lstnumberx35.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx35.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">q</span><span id="lstnumberx35.9" class="ltx_text ltx_font_typewriter" style="font-size:50%;">,</span><span id="lstnumberx35.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx35.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">distance_quantile_per_class</span><span id="lstnumberx35.12" class="ltx_text ltx_font_typewriter" style="font-size:50%;">=</span><span id="lstnumberx35.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">None</span><span id="lstnumberx35.14" class="ltx_text ltx_font_typewriter" style="font-size:50%;">,</span><span id="lstnumberx35.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx35.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">log</span><span id="lstnumberx35.17" class="ltx_text ltx_font_typewriter" style="font-size:50%;">=</span><span id="lstnumberx35.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">False</span><span id="lstnumberx35.19" class="ltx_text ltx_font_typewriter" style="font-size:50%;">):</span>
</div>
<div id="lstnumberx36" class="ltx_listingline"><span id="lstnumberx36.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">    </span><span id="lstnumberx36.2" class="ltx_text ltx_font_typewriter" style="font-size:50%;">"""</span>
</div>
<div id="lstnumberx37" class="ltx_listingline"><span id="lstnumberx37.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">    </span><span id="lstnumberx37.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">sdm</span><span id="lstnumberx37.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx37.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">activation</span><span id="lstnumberx37.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx37.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">function</span>
</div>
<div id="lstnumberx38" class="ltx_listingline"><span id="lstnumberx38.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">    </span><span id="lstnumberx38.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">Parameters</span>
</div>
<div id="lstnumberx39" class="ltx_listingline"><span id="lstnumberx39.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">    </span><span id="lstnumberx39.2" class="ltx_text ltx_font_typewriter" style="font-size:50%;">----------</span>
</div>
<div id="lstnumberx40" class="ltx_listingline"><span id="lstnumberx40.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">    </span><span id="lstnumberx40.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">batch_input</span>
</div>
<div id="lstnumberx41" class="ltx_listingline"><span id="lstnumberx41.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">        </span><span id="lstnumberx41.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">torch</span><span id="lstnumberx41.3" class="ltx_text ltx_font_typewriter" style="font-size:50%;">.</span><span id="lstnumberx41.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">tensor</span>
</div>
<div id="lstnumberx42" class="ltx_listingline"><span id="lstnumberx42.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">            </span><span id="lstnumberx42.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">shape</span><span id="lstnumberx42.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx42.4" class="ltx_text ltx_font_typewriter" style="font-size:50%;">==</span><span id="lstnumberx42.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx42.6" class="ltx_text ltx_font_typewriter" style="font-size:50%;">[</span><span id="lstnumberx42.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">batch</span><span id="lstnumberx42.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx42.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">size</span><span id="lstnumberx42.10" class="ltx_text ltx_font_typewriter" style="font-size:50%;">,</span><span id="lstnumberx42.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx42.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">number</span><span id="lstnumberx42.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx42.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">of</span><span id="lstnumberx42.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;"> </span><span id="lstnumberx42.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">classes</span><span id="lstnumberx42.17" class="ltx_text ltx_font_typewriter" style="font-size:50%;">]</span>
</div>
<div id="lstnumberx43" class="ltx_listingline"><span id="lstnumberx43.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:50%;">    </span><span id="lstnumberx43.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:50%;">q</span>
</div>
