<td id="S6.T3.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><math id="S6.T3.m10" class="ltx_Math" alttext="\datasetFactcheck" display="inline" intent=":literal"><semantics><mtext class="ltx_font_smallcaps">Factcheck</mtext><annotation encoding="application/x-tex">\datasetFactcheck</annotation></semantics></math></td></tr>
<tr id="S6.T3.2.1.2" class="ltx_tr">
<td id="S6.T3.2.1.2.1" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T3.m11" class="ltx_Math" alttext="\CauchyMAD" display="inline" intent=":literal"><semantics><mi>MAD</mi><annotation encoding="application/x-tex">\CauchyMAD</annotation></semantics></math></td>
<td id="S6.T3.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T3.m12" class="ltx_Math" alttext="\CauchyMinValidQBin" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>q</mi><mo>~</mo></mover><mi>min</mi><mi>γ</mi></msubsup><annotation encoding="application/x-tex">\CauchyMinValidQBin</annotation></semantics></math></td>
<td id="S6.T3.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T3.m13" class="ltx_Math" alttext="\CauchyMAD" display="inline" intent=":literal"><semantics><mi>MAD</mi><annotation encoding="application/x-tex">\CauchyMAD</annotation></semantics></math></td>
<td id="S6.T3.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S6.T3.m14" class="ltx_Math" alttext="\CauchyMinValidQBin" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>q</mi><mo>~</mo></mover><mi>min</mi><mi>γ</mi></msubsup><annotation encoding="application/x-tex">\CauchyMinValidQBin</annotation></semantics></math></td></tr>
<tr id="S6.T3.2.1.3" class="ltx_tr">
<td id="S6.T3.2.1.3.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">7.9e-05</td>
<td id="S6.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">1.004</td>
<td id="S6.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">0.100</td>
