                  <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l4.1" class="ltx_text" style="font-size:90%;">4:</span></span>
                  
                  
                <span id="alg4.l4.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg4.l4.m1" class="ltx_Math" alttext="{\mathcal{M}}_{*}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mo mathsize="0.900em">∗</mo></msub><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">{\mathcal{M}}_{*}\leftarrow</annotation></semantics></math><span id="alg4.l4.4" class="ltx_text" style="font-size:90%;"> Initialized with </span><math id="alg4.l4.m2" class="ltx_Math" alttext="{\mathcal{M}}^{\rm{neg}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">neg</mi></msup><annotation encoding="application/x-tex">{\mathcal{M}}^{\rm{neg}}</annotation></semantics></math><span id="alg4.l4.5" class="ltx_text" style="font-size:90%;">, </span><math id="alg4.l4.m3" class="ltx_Math" alttext="{\mathcal{M}}^{\rm{pos}}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℳ</mi><mi mathsize="0.900em">pos</mi></msup><annotation encoding="application/x-tex">{\mathcal{M}}^{\rm{pos}}</annotation></semantics></math><span id="alg4.l4.6" class="ltx_text" style="font-size:90%;"> </span><span id="alg4.l4.7" class="ltx_text" style="font-size:90%;float:right;"><math id="alg4.l4.m4" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Final trained model
</span>
</div>
