Nd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe" role="main" tabindex="0"><div id="h.nvmkefw906na" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.nvmkefw906na_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.nvmkefw906na_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.nvmkefw906na" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.nvmkefw906na_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-weight: 400;">Self-Captioning Multimodal Interaction Tuning: Amplifying Exploitable Redundancies for Robust Vision Language Models</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.5d2d3f7acb9c53cb_5" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://openreview.net/forum?id=r05rSbN4vI" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">This study</span></a><span class="C9DxTc " style=""> introduces a new way to make vision-language AI systems more robust when images or text are ambiguous, misleading, or corrupted. Rather than treating information repeated across different modalities as unnecessary, the paper shows that this shared—or redundant—information can actually help one modality compensate when another becomes unreliable, and proposes a self-captioning framework that deliberately increases this useful overlap during training.  The approach uses a Multimodal Interaction Gate to identify cases where important information appears mainly in the image and then generates captions that transfer some of that information into the text, allowing the model to learn from stronger connections between the two modalities.  Experiments show that increasing this redundancy can reduce visually induced hallucinations by up to 38.3%, improve response consistency by 16.8%, and make models more resilient to degraded inputs, suggesting that carefully designing how modalities share information can be an effective way to build more reliable multimodal AI systems.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">0</span><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">6</span><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;"> July 2026</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5d2d3f7acb9c53cb_8" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72sloAMP3Lpewj_aCgN0i6D94RiFGv27oQHDvyYIr6JH2OWoNYLjHHmhIfbEIWpyaPJO4dcJXZsMspFbXOubOU8hFVb1rCNB5xjYIvR5KHWFGEVn8WzpUK96re_kfOMaaLF0LOXM-Xg-49gMkGXhD8wDMQZEgIUaanUFK98nu7U-s-IOTIJJR9ybNHkUPnOdZ-itq-yjqZtAbI5BNKp5K_L5p_xTWPt8jKEKxrEWDKk=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div></div></div></section><section id="h.1d50a9f158f115ff_0" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.1d50a9f158f115ff_3" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.l71ldsc35dk" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.l71ldsc35dk_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.l71ldsc35dk_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.l71ldsc35dk" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.l71ldsc35dk_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-weight: 400;">MMAC: A Multilingual, Multimodal Alignment Framework for Cultural Grounding Evaluation</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.1d50a9f158f115ff_5" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://aclanthology.org/2026.acl-long.989/" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">MMAC</span></a><span class="C9DxTc " style=""> </span><span class="C9DxTc " style="">is a new benchmark and evaluation framework designed to test whether multimodal AI systems genuinely understand cultural knowledge across different languages and forms of input, rather than simply getting the right answer through memorisation or shortcuts. Its MMAC-bench contains 27,000 human-curated questions spanning 8 Asian countries and 10 languages, with equivalent cultural questions aligned across text, images and speech, and 79% of the questions requiring multi-step reasoning grounded in cultural context. The results show that today’s models remain inconsistent: performance drops substantially in lower-resource languages, the same cultural question can receive different answers when presented through another language or modality, and even correct answers are sometimes supported by incorrect or ungrounded explanations. MMAC therefore goes beyond simply measuring accuracy by testing whether cultural knowledge is consistent, transferable and properly grounded, providing a more rigorous foundation for building AI systems that can operate reliably across diverse cultural and linguistic settings. </span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">02 July </span><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">2026</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.1d50a9f158f115ff_8" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72uTOolK2Y6zgDDL0kTP6lqtHAOam4Leddjl5U1VFtg6EnvwWbZfpviMmsuyYCXBuVu7diTHDt5qjsvWv6BCY2PeuX433kOFFyE5FUwSPkcW7HqGZf2fgerhakypa6_wIuupBfVZDAyjW98336EDZxUI7dLg0LDdjmNLQXCiZrYBUJ6ar4ajb04nsfQ6FyhNDhi6JXWVy7JFhQODgWWSRvkCFP8GsCPDmZKmrTl1=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.586bd55877bb2306_9" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.586bd55877bb2306_12" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.a2c324x1y3cm" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.a2c324x1y3cm_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.a2c324x1y3cm_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.a2c324x1y3cm" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.a2c324x1y3cm_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">Can Persona-Prompted LLMs Emulate Subgroup Values? An Empirical Analysis of Generalisability and Fairness in Cultural Alignment</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.586bd55877bb2306_14" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://aclanthology.org/2026.acl-long.1127/" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">This study</span></a><span class="C9DxTc " style="font-variant: normal;"> examines whether large language models can represent the values of different demographic groups within the same society, rather than treating a country or culture as having one shared set of values. Using Singapore as a multicultural case study and responses from more than 2,000 people in the World Values Survey, the paper maps how values vary across 98 demographic subgroups defined by factors such as age, sex, ethnicity and religion, and builds a dataset of more than 20,000 examples to test whether AI models can learn these differences. The results show that even GPT-4.1 predicts subgroup preferences correctly only 57.4% of the time, while simple fine-tuning improves performance on previously unseen subgroup combinations by an average of 17.4 percentage points. However, the study also uncovers an important fairness challenge: models are systematically better at representing some groups—such as younger, male, Chinese and Christian personas—and although fine-tuning improves overall performance, it can widen certain disparities, highlighting why culturally aligned AI must account not only for diversity between countries but also for differences and inequalities within them. </span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">02 July 2026</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.586bd55877bb2306_17" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72u1VYBeBfQWyZYmOTgReolUTLK3gFhLLy1gwKMH4v71Tq0_k81MZVd0AOZrxer9bsHdwcr93a_SMrpnQmF0WRd3IM7lndYWZvt2Qz6ctxad_LVzPeJsXh1_x7-yreI1cPx8YHotdFv_PehBzvgZ1734UxWrtie4zE-_Cq2vvUtTHvxdAmp2z9ODOy5rTZZNkEURTlwJG5az1KjLiRpTqzcG_MmYIqaH1nGlcE8j=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.5bba45e5115080fc_25" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5bba45e5115080fc_28" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.la7blaqfx3xv" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.la7blaqfx3xv_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.la7blaqfx3xv_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.la7blaqfx3xv" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.la7blaqfx3xv_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-weight: 400;">StreamSense: Streaming Social Task Detection with Selective Vision–Language Model Routing</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.5bba45e5115080fc_30" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://arxiv.org/abs/2601.22738" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">StreamSense</span></a><span class="C9DxTc " style=""> is a new framework for detecting social signals such as sentiment and harmful content in live video streams, where AI systems must make decisions in real time using only the video, text, and audio seen so far. Instead of relying on a large and computationally expensive vision-language model at every moment, StreamSense uses a lightweight model for most predictions, selectively calls a more powerful vision-language model when a case is difficult or ambiguous, and can delay a decision when there is not yet enough context. Experiments across sentiment and hate-speech detection tasks show that this approach can outperform using a vision-language model alone while invoking it on only a fraction of the stream, reducing latency and computation and demonstrating a more practical way to deploy powerful multimodal AI for real-time online safety and social media monitoring. </span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">29</span><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;"> </span><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">June</span><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;"> 202</span><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">6</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5bba45e5115080fc_42" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72uGvOg2F4WGuU_oKEA6fEVDM0-1l7D0lwLJanN_gNq5IgeVXglQK3Eda4dVDYBJ2UIDaYYsrSli4z7HAxIMskldOTaQcJkjvefOMkWmwcCnwwrd2Ms2xvAAxmP-yaIEXpPYNQt7rzAmMQdhQFmpK8FfW2p2ojuvS_1VuciMjZvCPqJ-c1oc65ivdT01qNZWszYIqngmEqrI3oaglhoD0UH32l6sDOiO4aMNbSHC=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div></div></div></section><section id="h.1d50a9f158f115ff_9" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.1d50a9f158f115ff_12" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.xycpxqgqndz2" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.xycpxqgqndz2_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.xycpxqgqndz2_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.xycpxqgqndz2" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.xycpxqgqndz2_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">BLEnD-Vis: Benchmarking Multimodal Cultural Understanding in Vision Language Models</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.1d50a9f158f115ff_14" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://aclanthology.org/2026.eacl-long.215/" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">BLEnD-Vis</span></a><span class="C9DxTc " style="font-variant: normal;"> is a new benchmark designed to test whether vision-language AI systems truly understand everyday cultural knowledge across different parts of the world, rather than simply memorising facts in familiar question styles. The paper builds a large evaluation set covering 16 regions, with more than 21,000 multiple-choice questions and nearly 5,000 images, so researchers can compare how models perform when a cultural question is reworded or when the answer must be inferred from an image instead of text alone. The results show that today’s models are still fragile: many do worse when the same knowledge is asked in a different way, perform unevenly across regions, and often fail to stay consistent across text and image settings, making BLEnD-Vis an important tool for developing AI that is more culturally aware, fair, and reliable in global use.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">31 March 2026</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.1d50a9f158f115ff_17" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72uK7U3A0RjHIInK04zPs-zDCFgyi8BhgdPKwcoKxSBEpwvC8d7tGurW-TRwhNc48vawS8ZWu4KIF4D2cjQcZp8J7u6MWl_X7yuj8q88ZXylOU6WkowWqcFDNRCQ80RyOU_qVNFvkhkZr5gI89Jyj3sJWxNtIEJmv8PZVXOYte9RapZA3SMZkhQdq2VaOxs=w1280" class="CENy8b" role="img" style="width: 100%; margin: 0% 0 0% 0%"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.f53e2b5da551b9d_0" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.f53e2b5da551b9d_3" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.bznsmkcx8uxr" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.bznsmkcx8uxr_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.bznsmkcx8uxr_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.bznsmkcx8uxr" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.bznsmkcx8uxr_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">HateXScore: A Metric Suite for Evaluating Reasoning Quality in Hate Speech Explanations</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.f53e2b5da551b9d_5" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://arxiv.org/abs/2601.13547" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">HateXScore</span></a><span class="C9DxTc " style="color: #f1c232; font-variant: normal;"> </span><span class="C9DxTc " style="font-variant: normal;">is a new evaluation framework designed to check not just whether an AI model can detect hate speech, but whether it can explain its decision in a clear, faithful, and trustworthy way. Instead of relying only on standard scores like accuracy, the paper proposes a set of measures that examine whether the model clearly states its conclusion, points to the harmful part of the text, correctly identifies the targeted group, and gives a logically consistent explanation. Tested across multiple hate speech datasets in English, Chinese, and Korean, the study shows that a model can sometimes get the label right while giving a weak explanation, or disagree with the dataset label while still providing a strong and convincing justification, making HateXScore a useful tool for building more transparent and reliable content moderation systems.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">31 March 2026</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.f53e2b5da551b9d_8" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72t0T69kvtDVK_AmSDPI1T7b42eo2YA8oUHLDPao1ulYy_qSakh1suiVZTdDhZjZXqAB9gwiN425J-GZcPm7lawDuwtJeikXq-0yVOfgq2_zS0gjqy4bKQvo2hkyzyLCgaDvp37gpf1Q0AjvS82hqDB0yK5oUXxFeuJrtlkziNSJoAzAD2o1t41ZgQEIX1dORVyhrAk8afS0JLMuBKoBnoRoVZVYFo131sBwnhoB=w1280" class="CENy8b" role="img" style="width: 100%; margin: -0.0782281328% 0 -0.0782281328% 0%"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.3eecb68db6c2b2e0_0" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.3eecb68db6c2b2e0_3" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.taokryqg879t" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.taokryqg879t_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.taokryqg879t_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.taokryqg879t" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.taokryqg879t_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">AdaMCoT: Rethinking Cross-Lingual Factual Reasoning through Adaptive Multilingual Chain-of-Thought</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.3eecb68db6c2b2e0_5" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://arxiv.org/abs/2501.16154" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">AdaMCoT</span></a><span class="C9DxTc " style="font-variant: normal;"> is an innovative AI framework designed to improve the factual accuracy and reasoning abilities of large language models across multiple languages. While modern AI models are often powerful, they tend to perform significantly better in high-resource languages like English than in low-resource ones because of imbalances in their original training data. To solve this, AdaMCoT acts as a dynamic &quot;routing&quot; system that allows the AI to perform its internal thinking in a more data-rich &quot;intermediary language&quot;—such as English or Chinese—before translating that finished thought back into the user’s original language. This approach leverages the model&#39;s strongest reasoning pathways to provide more consistent and culturally nuanced answers, particularly for underrepresented global communities. By using a reward-based selection process to choose the best language for thinking, AdaMCoT effectively bridges the performance gap between languages without needing expensive new training or bulky translation software.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">22 January 2026</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.3eecb68db6c2b2e0_8" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72sdBHx3VBo-qk7FV0Q04tT26buxebtrUkzwLi7Vk57GbDOLDhtNv8yKyKWhZZZeBGqOUL2o3IBn5H4bSFT_ePgeYupPMrwCjFq7myf1PrL512ALt8JXPYkCoMEr_MabTyXiMnixWGhjwWU5DxAMCDMSuU5nvd9wRlTD-nXdZDtee3fdyAy43E203gnQfac=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.5bba45e5115080fc_0" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5bba45e5115080fc_3" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.5k2f87dor2bx" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.5k2f87dor2bx_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.5k2f87dor2bx_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.5k2f87dor2bx" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.5k2f87dor2bx_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">Toxicity Red-Teaming: Benchmarking LLM Safety in Singapore’s Low-Resource Languages</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.5bba45e5115080fc_5" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://www.arxiv.org/abs/2509.15260" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">SGToxicGuard</span></a><span class="C9DxTc " style="font-variant: normal;"> introduces a dataset and testing framework to check how safely AI chatbots behave across Singapore’s languages: Singlish, Chinese, Malay, and Tamil (plus English). Using a red-teaming approach, it probes models in three real-world tasks: handling toxic messages in a conversation, completing biased or harmful questions, and composing content that could spread online. The study finds that popular AI models are more likely to produce toxic or biased outputs in low-resource languages and can sometimes be coaxed into generating harmful content that appears shareable. SGToxicGuard highlights where current safeguards fall short and provides a practical benchmark to build more culturally aware, multilingual safety systems.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">28 September 2025</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5bba45e5115080fc_16" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72uvVlI2hAvS58JxsGQ8F9s4F6UrQPhd3GJRhkZstahQZiMjJwNI_sen98UYHzRaccMZl5wnJGyRP88tW0sjlYGR0pyXrBoF50vt7YbLblXGya1DL9PFQXWGjJfy13lhL_-HAzsLLHX-CN6Iq6pO_3mxV8K-y7EjHlCxaBmyUVgpssPMto6tlX5xN1szTzs=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.3ed77e283ee10a6e_69" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.3ed77e283ee10a6e_72" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.wlfi9omgvv35" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.wlfi9omgvv35_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.wlfi9omgvv35_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.wlfi9omgvv35" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.wlfi9omgvv35_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">Persuasion Dynamics in LLMs: Investigating Robustness and Adaptability in Knowledge and Safety with DuET-PD</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.3ed77e283ee10a6e_74" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://www.arxiv.org/abs/2508.17450" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">This study</span></a><span class="C9DxTc " style=""> examines how AI chatbots handle persuasion in multi-turn conversations, whether they can resist misinformation while remaining open to valid corrections. The authors introduce DuET-PD, a framework that simulates persuasive dialogues on both factual knowledge and safety-related topics, testing when and how models change their answers. They find that even strong AI systems falter under sustained misleading prompts, with some newer models showing a tendency to agree with users too easily. To address this, the study proposes Holistic DPO, a training approach that enables models to push back against incorrect arguments while still updating their answers when presented with accurate evidence. This method significantly enhances resistance to misinformation while maintaining model adaptability, paving the way for more trustworthy AI assistants in real-world, high-stakes applications.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">28 September 2025</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5bba45e5115080fc_11" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72uDYCSm1wAZaLEyqazYpy0sFNTzb6sBEpfdZhtrcYvCJ3WGCBwzo-sVrDM8MU5PBjhzG3HKmKFgi5o7JOSgER2VSB_MbJsjWM8rqToVXLVM3m5IARxz45-sTrITMppb8VII7fEZUHKiXcefc5Zvv9l8jNDuX7NfE0uWsTVmiOUsk61GXh1kP2i4QKskMI8=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.3ed77e283ee10a6e_60" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.3ed77e283ee10a6e_63" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.rd0j3k7j2sxw" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.rd0j3k7j2sxw_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.rd0j3k7j2sxw_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.rd0j3k7j2sxw" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.rd0j3k7j2sxw_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">Humor in Pixels: Benchmarking Large Multimodal Models Understanding of Online Comics</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.3ed77e283ee10a6e_65" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://arxiv.org/abs/2509.12248" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">PixelHumor</span></a><span class="C9DxTc " style="font-variant: normal;"> introduces a benchmark of 2,800 multi-panel online comics to test whether AI can truly “get” jokes, not just read words or spot objects, but follow setups, twists, and punchlines across panels. The benchmark covers four practical skills: identifying whether a comic is meant to be funny, determining which elements (text, visuals, or both) make it effective, classifying the humor style (e.g., surprise, sarcasm, puns), and reassembling shuffled panels in the correct order. In experiments, today’s leading multimodal models can determine that a comic aims to be funny. Still, they often miss the exact panel that delivers the joke, struggle with narrative sequencing, and provide generic explanations instead of genuine comedic insight. PixelHumor highlights these gaps and provides a standard testbed for building models that handle context, timing, and multimodal cues — key ingredients of humor and natural social interaction.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">28 September 2025</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5bba45e5115080fc_37" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72vp_O4riVNS6pGirHsEJfB5JMUuroZL7gNtHzGJukS3_zkOesn7xp9i1G3TGUanPIOxrOnnqpGNrXqxejgY_rfn0zWrL_A9l5oIFDCKa6Aglf2t3wv1hkAdvRz6edQl9Pm0qjyjJW4kI1fD1G0ePq-sChKJLqgoR2KHW4ELhH_Pm5hzocvDFQc_S1A8=w1280" class="CENy8b" role="img" style="width: 100%; margin: 0% 0 0% 0%"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.3ed77e283ee10a6e_49" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.3ed77e283ee10a6e_52" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.ikpba8n1xyqe" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.ikpba8n1xyqe_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.ikpba8n1xyqe_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.ikpba8n1xyqe" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.ikpba8n1xyqe_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">CCL-XCoT: An Efficient Cross-Lingual Knowledge Transfer Method for Mitigating Hallucination Generation</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.3ed77e283ee10a6e_54" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://arxiv.org/abs/2507.14239" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">This study</span></a><span class="C9DxTc " style="font-variant: normal;"> addresses AI “</span><span class="C9DxTc " style="font-style: italic; font-variant: normal;">hallucinations</span><span class="C9DxTc " style="font-variant: normal;">” in low-resource languages by teaching models to borrow their strongest reasoning from a high-resource language (such as English) and then answer in the target language. It combines two ideas: (1) a curriculum of cross-lingual contrastive learning that better aligns meanings across languages during training, and (2) a cross-lingual chain-of-thought prompting strategy that guides the model to think in English first, then respond in Chinese, Malay, Tamil, etc. The approach works without external retrieval systems and cuts hallucinations by large margins (up to 62% in tests), while boosting factual accuracy and cross-language consistency. A layer-wise analysis further reveals that adapting mid-level transformer layers is particularly effective, providing a practical recipe for more reliable multilingual AI.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">28 September 2025</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5bba45e5115080fc_38" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72vRgHHqAlHmoo0QzTUiDspJ2tV0OGvyJz5nLMWDOdmo88ycro-USUCtfggTf-ciYw1wLCFi7uPalfVvUk_UtcXLcYLEi6WRlU5i_mLoF5YLxyzWORiZtbjpBpUFxB-XGAw69YvVzDc7-mxotir3nd25L-ACn9Ld4qByQB9lY-w13lK8Rr2URmSdjInDYH8=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.3ed77e283ee10a6e_38" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.3ed77e283ee10a6e_41" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.pimdx3xmphzl" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.pimdx3xmphzl_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.pimdx3xmphzl_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.pimdx3xmphzl" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.pimdx3xmphzl_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">HateClipSeg: A Segment-Level Annotated Dataset for Fine-Grained Hate Video Detection</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.3ed77e283ee10a6e_43" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://www.arxiv.org/abs/2508.01712" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">HateClipSeg</span></a><span class="C9DxTc " style="font-variant: normal;"> introduces a new dataset that helps AI detect not just whether a video contains hate, but exactly when and where it appears. The dataset comprises over 11,000 carefully labeled short segments from hundreds of videos, covering various types of offensive content, including hateful, insulting, violent, or sexual language. Also, it identifies the target of the offensive language. Using this resource, the study shows that today’s best AI models can handle short clips reasonably well, but often miss the precise moments of hate in longer or streaming videos. HateClipSeg sets a new benchmark for developing more innovative moderation systems that can target harmful segments without removing entire videos, helping build safer and fairer online platforms.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">28 September 2025</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.3ed77e283ee10a6e_46" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72v2adocf6sm0BSV0tqz2CSVKo4NUPHRYtBN0nhqAAK_kOeAXiC2WHRZJP6weYa7AcKQMUthFPmJqpgeKiDeNHilce4J3iUl6roXNgzZkO0e-_14tISfAjMD5AQcC88F8f-RFzta1H9W3BtnZkw30G-9xZhoXXLd9--q_v93a_MsO0ad82KZecFnhGZneEW6_tEOSrJ-2etWGb-2-VbKcHfFRz8wa5PVkR0wUyIWTX8=w1280" class="CENy8b" role="img"></div></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.3ed77e283ee10a6e_48" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="font-style: italic; font-variant: normal;">Diagram illustrating Trimmed Hateful Video Classification, Temporal Hateful Video Localization, and Online Hateful Video Classification</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.3ed77e283ee10a6e_0" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.3ed77e283ee10a6e_3" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.l8a3gupg1zyl" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.l8a3gupg1zyl_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.l8a3gupg1zyl_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.l8a3gupg1zyl" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.l8a3gupg1zyl_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">Is LLM an Overconfident Judge? Unveiling the Capabilities of LLMs in Detecting Offensive Language with Annotation Disagreement</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.3ed77e283ee10a6e_5" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://aclanthology.org/2025.findings-acl.293/" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">This study</span></a><span class="C9DxTc " style="font-variant: normal;"> investigates how large language models (LLMs) handle offensive language detection in cases where human annotators disagree, a common challenge in real-world content moderation. Using the MD-Agreement dataset, the research systematically evaluates multiple LLMs, analyzing their classification accuracy, confidence calibration, and alignment with human judgments across varying levels of annotation disagreement. Findings reveal that LLMs often exhibit overconfidence in ambiguous cases, misclassifying subjective content as offensive and failing to reflect human-like uncertainty. The study further shows that incorporating disagreement samples in few-shot learning and instruction fine-tuning significantly improves detection accuracy and model alignment with human reasoning. This work highlights the need for disagreement-aware training strategies to enhance the robustness and fairness of AI moderation systems. Explore how this research advances our understanding of LLMs as decision-makers in subjective and sensitive AI applications.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">28 July 2025</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.3ed77e283ee10a6e_8" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72vfpcGNcYR2kxYmtvBnQdLcl77TXQREQHQhEiC7AKB_MPynySaGPaa9JQQnPYXEykRjVADl6UEjq289FZocY6hCdT2LcDzlQXoup293HRz9aVrDIuo1dSLj6EEFzcyQ2tKnX6GU7gzFf7r1j-Y-S3yqrpzgVJtwmiHO9EIaUsYkyOsO5UaGdf0LYCM3VjiUE-0kcoBFwKfLbkIy6-SRf67PU5XDFWharbM=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.15fa3bdca69f10ef_49" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.15fa3bdca69f10ef_52" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.cmzqgy18j1g1" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.cmzqgy18j1g1_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.cmzqgy18j1g1_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.cmzqgy18j1g1" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.cmzqgy18j1g1_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">Resolving Conflicting Evidence in Automated Fact-Checking: A Study on Retrieval-Augmented LLMs</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.15fa3bdca69f10ef_54" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://arxiv.org/abs/2505.17762" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">CONFACT</span></a><span class="C9DxTc " style="font-variant: normal;"> introduces a novel dataset and evaluation framework designed to assess the robustness of retrieval-augmented language models (RAG) in fact-checking scenarios where evidence from multiple sources presents conflicting information. The study highlights that existing RAG methods, even with advanced LLMs like GPT-4, struggle to discern and prioritize credible sources, leading to fact-checking failures in the presence of misinformation. To address this, the research explores strategies for integrating media source credibility into retrieval, ranking, and answer generation stages. Experiments demonstrate that incorporating source background information, especially during answer generation, significantly enhances fact-checking accuracy. CONFACT sets a new benchmark for evaluating credibility-aware fact-checking, paving the way for more reliable AI-assisted verification systems. Discover how this work advances the fight against misinformation by strengthening fact-checking with source-aware reasoning.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">23 May 2025</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.15fa3bdca69f10ef_57" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72vXV8OX49I1olGguuAVNx5rla-tphMOuOhcGw8_pw4m9Qeh2UnSBMd1BnHELp-kS6cv9sIgENfyko7ymKNHbPikCYBi3VVubWDarYn9qwrWzRjcpkjcN7aJN0Hn1gkmq2Mhh3TXSsd4BigAIk6ZKAkcM10dkMGiFvPLtvgO-WnLAbcF5VZ_Yz3FTLRRq-cOsLgARq1xGhAUwHPTuOweR5hDWds-_52jE6VtLgPF=w1280" class="CENy8b" role="img"></div></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.3ed77e283ee10a6e_18" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="font-style: italic;">A general framework of RAG methods involving three stages: retrieval, ranking and answer generation. (b-d) demonstrate our source-aware retrieval-augmented LLMs, incorporating source background information in three stages of the general RAG framework</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.15fa3bdca69f10ef_40" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.15fa3bdca69f10ef_43" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.1f3oeke7qag6" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.1f3oeke7qag6_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.1f3oeke7qag6_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.1f3oeke7qag6" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.1f3oeke7qag6_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">Unmasking Implicit Bias: Evaluating Persona-Prompted LLM Responses in Power-Disparate Social Scenarios</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.15fa3bdca69f10ef_45" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://aclanthology.org/2025.naacl-long.50/" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">This work</span></a><span class="C9DxTc " style="font-variant: normal;"> introduces a comprehensive framework to evaluate how large language models (LLMs) respond to demographic persona prompts, particularly in scenarios involving social power disparities. By examining semantic shifts and response quality across nine demographic axes (e.g., race, gender, age, disability), the study reveals that LLMs exhibit a “default persona” bias favoring middle-aged, able-bodied, Caucasian, native-born males with centrist views. Additionally, the research demonstrates that power-imbalanced scenarios amplify these biases, leading to increased variability and lower-quality responses for marginalized identities. The findings underscore the importance of addressing implicit biases in LLMs, especially as they are deployed in socially sensitive applications. Explore how this study advances bias detection and mitigation strategies for persona-driven AI interactions.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">22 April 202</span><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">5</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5bba45e5115080fc_46" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72t4LkXGg5GS6_vR_LJyQhWP6hOF7O3rfHwVHnHL9bXKWrlJwLqHgmYqZfXudWOWNed2epMAYZa1lCUhGY2vN8DsgoAAd8-RTkUErKiqw6iyXsjKalXvl5P-siDYfoha_2c5NXUEqyFtZppt3izVaUoEKYs44c6hX4EuVh0uHyzE0-bk6Igcl3lPfjtS=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.15fa3bdca69f10ef_31" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.15fa3bdca69f10ef_34" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.122jwym2xvf5" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.122jwym2xvf5_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.122jwym2xvf5_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.122jwym2xvf5" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.122jwym2xvf5_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">LongGenBench: Benchmarking Long-Form Generation in Long-Context LLMs</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.15fa3bdca69f10ef_36" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://openreview.net/forum?id=3A71qNKWAS" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">LongGenBench</span></a><span class="C9DxTc " style="font-variant: normal;"> introduces the first benchmark specifically designed to evaluate large language models (LLMs) on their ability to generate high-quality, instruction-following long-form text. Unlike existing benchmarks that focus on long-context retrieval, LongGenBench challenges models to produce coherent outputs of up to 32K tokens across complex, real-world scenarios such as diary writing, skyscraper design, and urban planning. The study evaluates ten state-of-the-art LLMs, revealing that even models adept at long-context understanding struggle to maintain coherence, instruction adherence, and content diversity over extended outputs. LongGenBench provides a critical tool for advancing long-form generation research, highlighting the need for improved architectures and training methods. Explore this work to understand how LongGenBench sets a new standard for assessing LLMs in long-output generation tasks essential for applications like technical documentation and creative writing.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">11 March 202</span><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">5</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.15fa3bdca69f10ef_39" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72sqyl27WJCAZmxMpFiQRAI8pNxk38tq_HfFVWjpD6xKt5ekclzEEH8soRstHISN6e8fEENg5Bje012XdUIx8C7LI3XjyemOGXASRtY2-RN-kRbCEYN1q4ohEBOFV_PYEOIty7yBWiMtoALEFVCQuQcdlvCT82sE0ygnawB4hwlFGvgFAN-WFcnjnps7Bxe8Oa1N0eY6ENw-ObBxeeyhwqO-0fDC3Bd4kqDBjsQ9J90=w1280" class="CENy8b" role="img"></div></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.3ed77e283ee10a6e_28" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="font-style: italic;">LongGenBench Overview: 1) Scenario Selection: Select from four scenarios—Diary, Menu Design, Skyscraper Design, and Urban Planning—each offered in both short and long versions to determine the main task prompt. 2) Task Instruction: Employ the template libraries SI (Single), RI (Range), and PI (Periodic) to generate tasks characterized by random times or locations, along with the corresponding prompts and verification sets. 3) Instruction Synthesis: Integrate all prompts generated in the prior step to create a comprehensive set of instructions with a final check-set. 4) Example: An illustration of Sophia’s weekly diary task is provided as an example.</span></p></div></div></div></div></div></div></div></div></div></section><section id="h.15fa3bdca69f10ef_13" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.15fa3bdca69f10ef_16" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.lxxewgrp5vii" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.lxxewgrp5vii_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.lxxewgrp5vii_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.lxxewgrp5vii" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.lxxewgrp5vii_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">Cross-Modal Transfer from Memes to Videos: Addressing Data Scarcity in Hateful Video Detection</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.15fa3bdca69f10ef_18" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://dl.acm.org/doi/10.1145/3696410.3714534" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">This study</span></a><span class="C9DxTc " style="font-variant: normal;"> proposes a novel cross-modal transfer approach to address the persistent challenge of data scarcity in hateful video detection. By leveraging widely available hateful meme datasets, the research introduces a human-assisted re-annotation pipeline that aligns meme labels with video task definitions, enabling memes to serve as both substitutes and augmentations for video datasets. Experiments demonstrate that vision-language models fine-tuned on re-annotated memes achieve comparable or superior performance to models trained directly on video data. Furthermore, combining re-annotated memes with small video datasets yields significant performance improvements, setting new benchmarks in hateful video detection. This work highlights a scalable, cost-effective solution for enhancing multimodal content moderation systems in data-constrained environments. Explore how this approach bridges modality gaps to advance the future of video-based hate speech detection.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">26 January 202</span><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">5</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.15fa3bdca69f10ef_21" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72ssiybQSoBbqpSv1gmfN1wsKNp0wL-9CLF06FeCVn-dvwHm8jShgU6M-q-tdAV91ARuIcJCNeAJrj6lZRrgutsj8jP_kupse7F2ws0E1xv48spZYSkI5rE4zZC84u77aRKhRZn-0L7eOomRiiThDvQiehmqoFqdaQo1A4rsEIEvuv1IsyM_4yupQ93PRHpMPvdxcDo5auwNvvVVF9guqxSbChPXTEr3xAgv_Jsx5aY=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.15fa3bdca69f10ef_0" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.15fa3bdca69f10ef_3" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.wfsdd5l22dew" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.wfsdd5l22dew_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.wfsdd5l22dew_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.wfsdd5l22dew" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.wfsdd5l22dew_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">ToxiCloakCN: Evaluating Robustness of Offensive Language Detection in Chinese with Cloaking Perturbations</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.15fa3bdca69f10ef_5" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://aclanthology.org/2024.emnlp-main.345.pdf" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">ToxiCloakCN</span></a><span class="C9DxTc " style="font-variant: normal;"> </span><span class="C9DxTc " style="font-variant: normal;">introduces a novel dataset designed to evaluate the robustness of offensive language detection models against cloaking techniques such as homophone substitutions and emoji transformations. Targeting Chinese-language content, this work highlights the vulnerabilities of large language models (LLMs) in detecting cloaked offensive texts, particularly in cases involving racism, sexism, regional bias, and anti-LGBTQ+ rhetoric. The study reveals significant performance declines for state-of-the-art models, including GPT-4, when confronted with perturbed data. ToxiCloakCN underscores the need for advanced techniques to combat evolving evasion strategies, contributing to safer online environments and more robust content moderation systems. Explore the findings to learn how this work advances offensive language detection in complex linguistic settings.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">12 November 2024</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.15fa3bdca69f10ef_8" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72tOsDCRE7pJp5T8LUn8vI64duaBq6ENEoGlVcJ2D1JrWGDQ0Sy7Lg6ooA818xWaN77_4gQaXGClzlKWqljlHbkeQShJ_WA3vKaZRaK--iq2OpPBfq9TeRb0sm5KfUalLAHHnnbu82eeVDN-bHC4RQjpUzNi0_ikBk4qYb6LL8XO1rDzNluocMiVN3r2zYI=w1280" class="CENy8b" role="img" style="width: 100%; margin: 0% 0 0% 0%"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.73c1b8623f9de16a_32" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.73c1b8623f9de16a_35" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.6r9dd1x7aime" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.6r9dd1x7aime_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.6r9dd1x7aime_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.6r9dd1x7aime" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.6r9dd1x7aime_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">MultiHateClip: A Multilingual Benchmark Dataset for Hateful Video Detection on YouTube and Bilibili</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.73c1b8623f9de16a_37" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://arxiv.org/abs/2408.03468" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">MultiHateClip</span></a><span class="C9DxTc " style="font-variant: normal;"> </span><span class="C9DxTc " style="font-variant: normal;">introduces a novel multilingual benchmark dataset designed for hateful video detection, focusing on gender-based hate speech across English and Chinese contexts. By annotating 2,000 videos from YouTube and Bilibili for hatefulness, offensiveness, and normalcy, it provides insights into cross-cultural differences in multimodal hate speech dynamics. Leveraging state-of-the-art models like GPT-4V and mBERT ⊙ MFCC ⊙ ViViT, the study highlights the complexities in differentiating hateful from offensive content and the limitations of existing models in non-Western contexts. MultiHateClip paves the way for a more inclusive, culturally nuanced approach to online hate detection. Explore the dataset and findings to advance multimodal analysis for combating online hate speech.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">28 October 2024</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.73c1b8623f9de16a_40" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72toYpynzs2AnJ0vnpzfwuGQzgO2ysHnlEWG1yZu2HDFfowzH22oL3-0HqHmnK9fMOelQfGpyCQUG4YiQWYibg4MhPrRDVI4x0dFZVWW6Lyjjy4UcruaABtwRCyNFQ-Wl-Fxpaz5mpfCF2OWcxNAFnMXK_R2YM3sDZG-CJ0hU5KfI1alt2v_E65ajTyjFek=w1280" class="CENy8b" role="img" style="width: 100%; margin: 0% 0 0% 0%"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.73c1b8623f9de16a_19" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.73c1b8623f9de16a_22" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.8mbtm0eomoop" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.8mbtm0eomoop_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.8mbtm0eomoop_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.8mbtm0eomoop" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.8mbtm0eomoop_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">InstructAV: Instruction Fine-tuning Large Language Models for Authorship Verification</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.73c1b8623f9de16a_24" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://openreview.net/forum?id=0UK8c2kg7c#discussion" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">InstructAV</span></a><span class="C9DxTc " style="font-variant: normal;"> introduces a groundbreaking approach to authorship verification (AV) by fine-tuning large language models with instructions and leveraging a parameter-efficient fine-tuning (PEFT) method. This framework is distinct in its dual focus on improving classification accuracy and generating clear, detailed linguistic explanations, addressing a significant gap in the AV domain. By incorporating datasets with explanatory labels and employing the LoRA fine-tuning technique, InstructAV achieves state-of-the-art performance, as demonstrated across diverse datasets like IMDB, Twitter, and Yelp Reviews. This innovative methodology not only enhances the transparency and reliability of AV systems but also paves the way for advancements in explainable AI. Explore how InstructAV is shaping the future of authorship verification.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">10 July 2024</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.73c1b8623f9de16a_27" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72vsFJ6x4iRgVnaNmkDs3qVCjRd98beDfJ0ElWrtuFT74O_nYVdgsmw1cDL_89TO3NVPHfIpntg45_HbZmtbO-H7wykBcNm30DVH7s4uXC890Q4UXfKoXhG_XollNU9ppYPMJPP90Buxm_vqb-AZfeRWnpitpCtCoKf9Q1AlGuDBUnDPQgk2ndY0kateTCJCjfMyKgGJ7z9yKtvbSIDVkMWDQfJ0iXyFT8RmJSjb3J4=w1280" class="CENy8b" role="img"></div></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.3ed77e283ee10a6e_33" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: center;"><span class="C9DxTc " style="font-style: italic;">An illustration of InstructAV’s architectures</span></p></div></div></div></div></div></div></div></div></div></section><section id="h.73c1b8623f9de16a_4" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.73c1b8623f9de16a_7" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.722uoymkz157" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.722uoymkz157_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.722uoymkz157_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.722uoymkz157" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.722uoymkz157_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400;">SGHateCheck: Functional Tests for Detecting Hate Speech in Low-Resource Languages of Singapore</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.73c1b8623f9de16a_9" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://aclanthology.org/2024.woah-1.24/#:~:text=SGHateCheck%20reveals%20critical%20flaws%20in,Singapore%20and%20Southeast%20Asia%20contexts." target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">SGHateCheck</span></a><span class="C9DxTc " style="font-variant: normal;"> is a pioneering framework designed to address the unique challenges of hate speech detection in Singapore&#39;s multilingual and culturally diverse landscape. By building on existing methodologies like HateCheck and MHC, SGHateCheck introduces functional tests for four key languages—Singlish, Mandarin, Malay, and Tamil. This project highlights the limitations of state-of-the-art models in accurately moderating content in Southeast Asian contexts, driving the development of more inclusive and effective hate speech detection systems. Explore how SGHateCheck is shaping the future of online trust and safety in low-resource language settings. </span><span class="C9DxTc " style="font-variant: normal;">This project is support by the </span><span class="C9DxTc " style="color: #f1c232; font-variant: normal; text-decoration: underline;">Singapore Ministry of Education (MOE) Academic Research Fund (AcRF) Tier 2</span><span class="C9DxTc " style="font-variant: normal;">.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;">20 June 2024</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.73c1b8623f9de16a_12" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="font-variant: normal;"> </span></p></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.73c1b8623f9de16a_14" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72vHOmah3cF1P9Hv1fyod8Rrmds6UK26qV1hJtlCy5xED6cAdfu-gTxCTR9Fj7Q52in3EgAd2eT-KlXaV-xQdihOMECd70wgPKvD1BjafXWjD9irwFxNwjF6f8hnPSBfe0fHG19p1bNtQ9Ytah3FtHeldykwsuPYnO8VT_RzKtkiCASHm5EIz-JizmLS2wyN8Tiw-xrpIdpgsuUx0m6EWlDIMVbwJ9FAnQzzD4ajxqU=w1280" class="CENy8b" role="img"></div></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.60561c94b26e476c_120" class="yaqOZd WxWicb"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-uQSCkd Ft7HRd-AhqUyc-uQSCkd purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.60561c94b26e476c_123" class="hJDwNd-AhqUyc-uQSCkd Ft7HRd-AhqUyc-uQSCkd jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="iwQgFb" role="presentation"></div></div></div></div></div></div></div></div></div></div></section><section id="h.60561c94b26e476c_109" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.60561c94b26e476c_112" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.m0b2e76y7obm" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.m0b2e76y7obm_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.m0b2e76y7obm_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.m0b2e76y7obm" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.m0b2e76y7obm_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-weight: 400;">MemeCraft: Contextual and Stance-Driven Multimodal Meme Generation</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.60561c94b26e476c_114" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://dl.acm.org/doi/abs/10.1145/3589334.3648151" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">MemeCraft</span></a><span class="C9DxTc " style=""> is an innovative project that harnesses the power of generative AI to create impactful memes for social good. Developed in SUTD, this tool uses advanced language and visual models to generate memes that support important social movements like climate action and gender equality. By ensuring that the generated content is both humorous and respectful, MemeCraft aims to engage online audiences in meaningful discourse. This versatile technology can also be applied in other social activism and marketing campaigns, making it a powerful tool for spreading awareness and promoting positive change across various causes.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">13</span><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;"> </span><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">May</span><span class="C9DxTc " style="color: #3d85c6; font-variant: normal; text-decoration: underline;"> 2024</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.60561c94b26e476c_117" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="font-variant: normal;"> </span></p></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.60561c94b26e476c_119" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72tkLXoY1uEqUQeagu1Br4b8rsqr_3X9HcTXKpJncbA9hlG7fOddqhLLh6jRjWQLhhAeTk7_cEUNXBbxDivl8eY4MNkosCjSTZsQdZD24RTo8UuTQ-CNsW6HY2suzbbCK1AwRKqh8JDv70R0ywiMQaS7Q_3-_1poAaBeIPoAEuI2mVGQvt_sbfaI_JjAIjMoqN2nc7Vpq3NSs09mkfU6aXzFuYvS_vVVBT_7X3NQyX4=w1280" class="CENy8b" role="img"></div></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.60561c94b26e476c_127" class="hJDwNd-AhqUyc-II5mzb Ft7HRd-AhqUyc-II5mzb pSzOP-AhqUyc-II5mzb Ktthjf-AhqUyc-II5mzb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="font-style: italic;">An example meme generated using </span><a class="XqQF9c" href="https://dl.acm.org/doi/abs/10.1145/3589334.3648151" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-style: italic; font-variant: normal; text-decoration: underline;">MemeCraft</span></a><span class="C9DxTc " style="font-style: italic;"> to communicate the issue of Climate Change. </span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-R6PoUb Ft7HRd-AhqUyc-R6PoUb JNdkSc SQVYQc L6cTce-purZT L6cTce-pSzOP"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"></div></div></div></div></div></section><section id="h.12c317e1938d84e9_15" class="yaqOZd WxWicb"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-uQSCkd Ft7HRd-AhqUyc-uQSCkd purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.12c317e1938d84e9_18" class="hJDwNd-AhqUyc-uQSCkd Ft7HRd-AhqUyc-uQSCkd jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="iwQgFb" role="presentation"></div></div></div></div></div></div></div></div></div></div></section><section id="h.496bba102c07e9ae_196" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.496bba102c07e9ae_199" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><span class="jgG6ef C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-variant: normal; font-weight: 400; vertical-align: baseline;">AutoChart: A Dataset for Chart-to-Text Generation</span></p></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.496bba102c07e9ae_201" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><span class="C9DxTc " style="">AutoChart represents a significant advancement in natural language generation by addressing the underexplored area of chart-to-text generation. By introducing a novel framework that automatically generates analytical descriptions for various types of charts, AutoChart enables scalable and efficient data interpretation. The dataset, consisting of over 10,000 chart-description pairs, facilitates research in both natural language processing and computer vision, offering applications in academic writing, accessibility for visually impaired users, and automated report generation. AutoChart&#39;s integration of linguistic rhetorical moves further ensures that the generated descriptions are not only informative but also coherent and contextually relevant—paving the way for innovative applications in education, journalism, and automated content generation. Preliminary research in this area is funded by </span><a class="XqQF9c" href="https://livingskytech.com/" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">Living Sky Technologies</span></a><span class="C9DxTc " style="">.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">16 Aug 2021</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.41883a635c10780a_21" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72sVHU6YI_-ARAjXNj7-ezy03fHzPPm_hNnsSw7gPNPXuILFX6cr_UfuW34-408JoKCi0pcX9m6B9EVVEIOCAKFTC81I-eTvkqqDAoehrZrdRN3X6DMITgWwX6fSWbDjda7N2v2sPIl39sbAdvETh-N7U3BwxDuTd5HXb4rQjLDwk6SwJJepeND0ENV1K0ISEhWl24xaf1grenl5rqBXnmsl8zQ_7fgGlgNeBSUrMYA=w1280" class="CENy8b" role="img"></div></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.41883a635c10780a_25" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><a class="XqQF9c" href="https://arxiv.org/pdf/1902.08737.pdf" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-style: italic; text-decoration: underline;">AutoChart</span></a><span class="C9DxTc " style="font-style: italic;">: A multimodal text generation model that recognizes charts and generates a text analysis. The above analysis is generated by AutoChart automatically.</span></p></div></div></div></div></div></div></div></div></div></section><section id="h.60561c94b26e476c_97" class="yaqOZd WxWicb"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-uQSCkd Ft7HRd-AhqUyc-uQSCkd purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.60561c94b26e476c_100" class="hJDwNd-AhqUyc-uQSCkd Ft7HRd-AhqUyc-uQSCkd jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="iwQgFb" role="presentation"></div></div></div></div></div></div></div></div></div></div></section><section id="h.5547a6bb013bbe31_41" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5547a6bb013bbe31_52" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><span class="jgG6ef C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-weight: 400; vertical-align: baseline;">Analyzing Antisocial Behaviors Amid COVID-19 Pandemic</span></p></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.5547a6bb013bbe31_48" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><span class="C9DxTc " style="">In the wake of the COVID-19 pandemic, online platforms saw an alarming rise in antisocial behaviors, including hate speech and xenophobia. Our project tackles this issue head-on by developing one of the largest annotated datasets of over 40 million COVID-19-related tweets. Using a novel automated annotation framework, we analyzed toxic content targeting vulnerable communities, shedding light on new abusive lexicons that emerged during the pandemic. This research opens up pathways for developing more robust tools to monitor and curb harmful online behaviors during global crises.</span><span class="C9DxTc " style=""> We also partner with the </span><a class="XqQF9c" href="https://saskatchewanhumanrights.ca/" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">Saskatchewan Human Rights Commission</span></a><span class="C9DxTc " style=""> in a sub-project to investigate the online xenophobia against Asian communities during the COVID-19 pandemic. This sub-project is funded by the </span><a class="XqQF9c" href="https://www.sshrc-crsh.gc.ca/results-resultats/recipients-recipiendaires/2020/peg-covid-jan2021-eng.aspx" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">Social Science and Humanities Research Council of Canada Partnership Engage Grants</span></a><span class="C9DxTc " style="">.</span></p><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><span class="C9DxTc " style="color: #3d85c6; text-decoration: underline;">21 July 2020</span></p></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5547a6bb013bbe31_70" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style="">  </span></p></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.5547a6bb013bbe31_38" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72u_pTx-k4F1-WJ55bvgFac0AayBwzpJKr3FRUSoBBXiK1LRCk3gfiEm9kHrRVSt0GrzjFsLBd3F7I-qkweuXfIGTNq3wIedBgoL0jDh4Ck2-XPsJMTbcL2QClNlbjt2QqBVz-Y2fZlcuFP93QaS0TYI3vz0K-080rryRL2qvENZKB1Ktafyplus0TX7jZ6nHMpBKEw3wZLxYuRYScyTDclI-_wlxMtjAbpnUi8LfLE=w1280" class="CENy8b" role="img"></div></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.5547a6bb013bbe31_43" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><a class="XqQF9c" href="https://arxiv.org/pdf/2007.10712.pdf" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-style: italic; text-decoration: underline;">Analysis of online xenophobic behaviors amidst the COVID-19 Pandemic in Twitter</span></a><span class="C9DxTc " style="font-style: italic;">. We have collected and annotated a dataset with over 40 million COVID-19 related tweets.  </span></p></div></div></div></div></div></div></div></div></div></section><section id="h.60561c94b26e476c_101" class="yaqOZd WxWicb"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-uQSCkd Ft7HRd-AhqUyc-uQSCkd purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.60561c94b26e476c_104" class="hJDwNd-AhqUyc-uQSCkd Ft7HRd-AhqUyc-uQSCkd jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="iwQgFb" role="presentation"></div></div></div></div></div></div></div></div></div></div></section><section id="h.5547a6bb013bbe31_14" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabindex="-1"><div class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-qWD73c Ktthjf-AhqUyc-qWD73c JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5547a6bb013bbe31_30" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><div id="h.rj70du11aro4" class="CobnVe yMxPgf  aP9Z7e"></div><h2 id="h.rj70du11aro4_l" dir="ltr" class="zfr3Q JYVBee CDt4Ke " style=""><div jscontroller="Ae65rd" jsaction="touchstart:UrsOsc; click:KjsqPd; focusout:QZoaZ; mouseover:y0pDld; mouseout:dq0hvd;fv1Rjc:jbFSOd;CrfLRd:SzACGe;" class="CjVfdc"><div class="PPhIP rviiZ" jsname="haAclf"><div role="presentation" class="U26fgb mUbCce fKz7Od LRAOtb Znu9nd M9Bg4d" jscontroller="mxS5xe" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;" jsshadow aria-describedby="h.rj70du11aro4_l" aria-label="Copy heading link" aria-disabled="false" data-tooltip="Copy heading link" aria-hidden="true" data-tooltip-position="top" data-tooltip-vertical-offset="12" data-tooltip-horizontal-offset="0"><a class="FKF6mc TpQm9d" href="#h.rj70du11aro4" aria-label="Copy heading link" jsname="hiK3ld" role="button" aria-describedby="h.rj70du11aro4_l"><div class="VTBa7b MbhUzd" jsname="ksKsZd"></div><span jsslot class="xjKiLb"><span class="Ce1Y1c" style="top: -11px"><svg class="OUGEr QdAdhf" width="22px" height="22px" viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M0 0h24v24H0z" fill="none"/><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg></span></span></a></div></div><span class="C9DxTc " style="color: #f1c232; font-family: Roboto, Arial; font-weight: 400;">User Profiling Across Multiple Online Social Platform</span></div></h2></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.5547a6bb013bbe31_20" class="hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><span class="C9DxTc " style="">Online social platforms (OSPs), such as Facebook, Twitter, and Instagram, have grown monumentally over recent years. It was reported that as of August 2017, Facebook has over 2 billion monthly active users, while Instagram and Twitter have over 700 million and 300 million monthly active user accounts, respectively. The vast amount of user-generated content and social data gathered in these behemoth platforms have made them rich data sources for academic and industrial research. However, most of the existing research work has focused on analyzing and modeling user behaviors in a single platform setting, neglecting the inter-dependencies of user behaviors across multiple OSPs. In this project, we design novel techniques that enable the analysis and modeling of user behaviors in multiple OSPs. In particular, we have developed algorithms that (i) </span><a class="XqQF9c" href="https://arxiv.org/pdf/1901.06648.pdf" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">link users&#39; profiles across multiple social platforms</span></a><span class="C9DxTc " style="">, (ii) </span><a class="XqQF9c" href="http://ink.library.smu.edu.sg/cgi/viewcontent.cgi?article=4653&amp;context=sis_research" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">analyze users&#39; topical interests and platform preferences across multiple OSPs</span></a><span class="C9DxTc " style="">, and (iii) </span><a class="XqQF9c" href="https://ieeexplore.ieee.org/abstract/document/8736791" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; text-decoration: underline;">model influential users in multiple OSPs</span></a><span class="C9DxTc " style="">.</span></p><br></div></div></div></div></div></div></div><div class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc purZT-AhqUyc-II5mzb ZcASvf-AhqUyc-II5mzb pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc JNdkSc SQVYQc yYI8W HQwdzb"><div class="JNdkSc-SmKAyb LkDMRd"><div class="" jscontroller="sGwD4d" jsaction="zXBUYb:zTPCnb;zQF9Uc:Qxe3nd;" jsname="F57UId"><div class="oKdM2c ZZyype Kzv0Me"><div id="h.5547a6bb013bbe31_33" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec OjCsFc dmUFtb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style=""><span class="C9DxTc " style=""> </span></p></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.5547a6bb013bbe31_11" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec"><div class="jXK9ad-SmKAyb"><div class="tyJCtd baZpAe"><div class="t3iYD"><img src="https://lh7-us.googleusercontent.com/sitesv-images-rt/AMxu72vU0ppR4dnba1ypW9hhJdd1ghI1AFiuXL0k83jwYhDZU-nHQ6b5Q0ef5-ZLqirUV15lot8I1DSuLqfRFoHIDA9vr7kqbPhAV0MDQ06vjM98eZHelFTwwIJ0vCwWf6S4u8TOMOSM9ljeQ8NF3x4rdRPPopTk8UOuBB2pVISmQc7loIsYEci7Pwm0EeQmLtUZZ22GCtxfOZ67YyWWYG8ubs30_-kV6z05pPIslfXCcxo=w1280" class="CENy8b" role="img"></div></div></div></div></div><div class="oKdM2c ZZyype"><div id="h.5547a6bb013bbe31_24" class="hJDwNd-AhqUyc-wNfPc Ft7HRd-AhqUyc-wNfPc pSzOP-AhqUyc-wNfPc Ktthjf-AhqUyc-wNfPc jXK9ad D2fZ2 zu5uec wHaque g5GTcb"><div class="jXK9ad-SmKAyb"><div class="tyJCtd mGzaTb Depvyb baZpAe"><p  dir="ltr" class="zfr3Q CDt4Ke " style="text-align: justify;"><a class="XqQF9c" href="https://arxiv.org/pdf/1902.08737.pdf" target="_blank" style="color: inherit; text-decoration: none;"><span class="C9DxTc " style="color: #f1c232; font-style: italic; text-decoration: underline;">Linky</span></a><span class="C9DxTc " style="font-style: italic;">: A visual analytical tool that extracts the results from different user identity linkage methods performed on multiple online social networks and visualizes the user profiles, content and ego networks of the linked user identities.</span></p></div></div></div></div></div></div></div></div></div></section></div><div class="Xpil1b xgQ6eb"></div><footer jsname="yePe5c"><section id="h.496bba102c07e9ae_30" class="yaqOZd"><div class="IFuOkc"></div><div class="mYVXT"><div class="LS81yb VICjCf j5pSsc db35Fc" tabind