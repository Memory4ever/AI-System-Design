<td id="S5.T1.3.1.12.6" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S5.T1.3.1.12.6.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">0.90</span></td>
<td id="S5.T1.3.1.12.7" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S5.T1.3.1.12.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">0.87</span></td>
