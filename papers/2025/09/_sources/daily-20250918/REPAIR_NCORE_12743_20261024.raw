<td id="S3.T1.2.9.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t">
<span id="S3.T1.2.9.3.1" class="ltx_inline-block ltx_align_top" style="width:31.3pt;">
