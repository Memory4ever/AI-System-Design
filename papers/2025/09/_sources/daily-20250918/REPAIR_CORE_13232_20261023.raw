</span>
</span></span></span>
</span></span></span></p>
</span></div>
</figure>
<figure id="S5.F2" class="ltx_figure">
<div id="S5.F2.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:276.0pt;height:1229.8pt;vertical-align:-612.9pt;"><span class="ltx_transformed_inner" style="transform:translate(-34.5pt,153.7pt) scale(0.800003051757812,0.800003051757812) ;">
<div id="S5.F2.3.1" class="ltx_logical-block ltx_minipage ltx_align_middle" style="width:345.0pt;">
            
<figure id="S5.F2.sf1" class="ltx_figure ltx_align_center"><object type="image/svg+xml" data="2509.13232v1/GRPO_vs_SPO_AIME24_pass_at_k.svg" id="S5.F2.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/331;" width="476" height="331"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F2.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S5.F2.sf1.4" class="ltx_text" style="font-size:90%;">AIME 24</span></figcaption>
</figure>
            
<figure id="S5.F2.sf2" class="ltx_figure ltx_align_center"><object type="image/svg+xml" data="2509.13232v1/GRPO_vs_SPO_AIME25_pass_at_k.svg" id="S5.F2.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/331;" width="476" height="331"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F2.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S5.F2.sf2.4" class="ltx_text" style="font-size:90%;">AIME 25</span></figcaption>
</figure>
            
<figure id="S5.F2.sf3" class="ltx_figure ltx_align_center"><object type="image/svg+xml" data="2509.13232v1/GRPO_vs_SPO_BeyondAIME_pass_at_k.svg" id="S5.F2.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/331;" width="476" height="331"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F2.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S5.F2.sf3.4" class="ltx_text" style="font-size:90%;">BeyondAIME</span></figcaption>
</figure>
            
<figure id="S5.F2.sf4" class="ltx_figure ltx_align_center"><object type="image/svg+xml" data="2509.13232v1/GRPO_vs_SPO_BRUMO25_pass_at_k.svg" id="S5.F2.sf4.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/331;" width="476" height="331"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F2.sf4.3" class="ltx_text" style="font-size:90%;">(d)</span> </span><span id="S5.F2.sf4.4" class="ltx_text" style="font-size:90%;">BRUMO 25</span></figcaption>
</figure>
            
<figure id="S5.F2.sf5" class="ltx_figure ltx_align_center"><object type="image/svg+xml" data="2509.13232v1/GRPO_vs_SPO_HMMT25_pass_at_k.svg" id="S5.F2.sf5.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/331;" width="476" height="331"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F2.sf5.3" class="ltx_text" style="font-size:90%;">(e)</span> </span><span id="S5.F2.sf5.4" class="ltx_text" style="font-size:90%;">HMMT 25</span></figcaption>
