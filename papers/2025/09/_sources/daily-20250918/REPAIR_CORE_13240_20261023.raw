<th id="S4.T6.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt"><span id="S4.T6.2.1.1.1" class="ltx_text ltx_font_bold">Method</span></th>
