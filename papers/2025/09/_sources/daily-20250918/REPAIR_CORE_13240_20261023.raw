<td id="S4.T6.2.3.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T6.2.3.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">2.10</span></td>
<td id="S4.T6.2.3.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T6.2.3.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">1.07</span></td>
<td id="S4.T6.2.3.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T6.2.3.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">5.69</span></td></tr>
