<td id="A3.T10.6.5.4" class="ltx_td ltx_align_center"><math id="A3.T10.m14" class="ltx_Math" alttext="0.85\pm 0.016" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.85</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.016</mn></mrow><annotation encoding="application/x-tex">0.85\pm 0.016</annotation></semantics></math></td>
<td id="A3.T10.6.5.5" class="ltx_td ltx_align_center"><math id="A3.T10.m15" class="ltx_Math" alttext="0.75\pm 0.016" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.75</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.016</mn></mrow><annotation encoding="application/x-tex">0.75\pm 0.016</annotation></semantics></math></td>
<td id="A3.T10.6.5.6" class="ltx_td ltx_align_center"><math id="A3.T10.m16" class="ltx_Math" alttext="0.78\pm 0.016" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.78</mn><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.016</mn></mrow><annotation encoding="application/x-tex">0.78\pm 0.016</annotation></semantics></math></td></tr>
<tr id="A3.T10.6.6" class="ltx_tr">
<th id="A3.T10.6.6.1" class="ltx_td ltx_th ltx_th_row"></th>
<th id="A3.T10.6.6.2" class="ltx_td ltx_align_center ltx_th ltx_th_row"><span id="A3.T10.6.6.2.1" class="ltx_text" style="font-size:80%;">Top-2 Accuracy</span></th>
