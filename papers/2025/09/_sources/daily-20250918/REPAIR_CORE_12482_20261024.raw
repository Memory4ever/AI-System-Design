<td id="S3.T2.6.4.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.6.4.2.1" class="ltx_text" style="font-size:80%;">333k</span></td>
<td id="S3.T2.6.4.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.6.4.3.1" class="ltx_text" style="font-size:80%;">9.3h</span></td>
<td id="S3.T2.6.4.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.6.4.4.1" class="ltx_text" style="font-size:80%;">5.4m/s</span></td>
