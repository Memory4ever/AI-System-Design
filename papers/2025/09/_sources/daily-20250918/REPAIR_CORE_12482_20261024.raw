<td id="S3.T2.6.3.3" class="ltx_td ltx_align_center"><span id="S3.T2.6.3.3.1" class="ltx_text" style="font-size:80%;">10.7h</span></td>
<td id="S3.T2.6.3.4" class="ltx_td ltx_align_center"><span id="S3.T2.6.3.4.1" class="ltx_text" style="font-size:80%;">1.4m/s</span></td>
<td id="S3.T2.6.3.5" class="ltx_td ltx_align_center"><span id="S3.T2.6.3.5.1" class="ltx_text" style="font-size:80%;">1.8m/s</span></td>
<td id="S3.T2.6.3.6" class="ltx_td ltx_align_center"><span id="S3.T2.6.3.6.1" class="ltx_text" style="font-size:80%;">22.4m</span></td></tr>
