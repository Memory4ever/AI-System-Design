<td id="A1.T7.6.2.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T7.6.2.4.1" class="ltx_text" style="font-size:80%;">120<math id="A1.T7.m22" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>s</span></td></tr>
