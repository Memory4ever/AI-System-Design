<td id="S3.T2.6.2.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T2.6.2.2.1" class="ltx_text" style="font-size:80%;">310k</span></td>
<td id="S3.T2.6.2.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S3.T2.6.2.3.1" class="ltx_text" style="font-size:80%;">8.9h</span></td>
