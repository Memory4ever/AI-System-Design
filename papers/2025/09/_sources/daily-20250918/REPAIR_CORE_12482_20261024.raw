<td id="S3.T1.7.7.3" class="ltx_td ltx_align_center"><span id="S3.T1.7.7.3.1" class="ltx_text" style="font-size:80%;">200k frames</span></td></tr>
<tr id="S3.T1.7.8" class="ltx_tr">
