<th id="A3.T10.6.9.1" class="ltx_td ltx_th ltx_th_row ltx_border_bb"></th>
<th id="A3.T10.6.9.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb"><span id="A3.T10.6.9.2.1" class="ltx_text" style="font-size:80%;">Angle</span></th>
