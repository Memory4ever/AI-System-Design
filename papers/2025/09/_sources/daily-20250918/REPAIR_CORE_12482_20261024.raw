<th id="A2.T9.6.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><span id="A2.T9.6.4.1.1" class="ltx_text" style="font-size:90%;">Layers</span></th>
<td id="A2.T9.6.4.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A2.T9.6.4.2.1" class="ltx_text" style="font-size:90%;">4 – 18</span></td></tr>
<tr id="A2.T9.6.5" class="ltx_tr">
<th id="A2.T9.6.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><span id="A2.T9.6.5.1.1" class="ltx_text" style="font-size:90%;">Model Dimension</span></th>
