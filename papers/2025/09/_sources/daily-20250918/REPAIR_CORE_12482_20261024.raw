<td id="A3.T10.6.8.5" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T10.m27" class="ltx_Math" alttext="0.025\text{ m/s}\pm 0.0024" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.800em">0.025</mn><mo lspace="0em" rspace="0em">​</mo><mtext mathsize="0.800em"> m/s</mtext></mrow><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.0024</mn></mrow><annotation encoding="application/x-tex">0.025\text{ m/s}\pm 0.0024</annotation></semantics></math></td>
<td id="A3.T10.6.8.6" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T10.m28" class="ltx_Math" alttext="0.091\text{ m/s}\pm 0.047" display="inline" intent=":literal"><semantics><mrow><mrow><mn mathsize="0.800em">0.091</mn><mo lspace="0em" rspace="0em">​</mo><mtext mathsize="0.800em"> m/s</mtext></mrow><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.047</mn></mrow><annotation encoding="application/x-tex">0.091\text{ m/s}\pm 0.047</annotation></semantics></math></td></tr>
