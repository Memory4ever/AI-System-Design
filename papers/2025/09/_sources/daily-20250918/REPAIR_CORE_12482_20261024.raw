<td id="S5.T4.10.2.3" class="ltx_td ltx_align_center ltx_border_tt"><math id="S5.T4.m1" class="ltx_Math" alttext="+0.04\pm 0.85\%" display="inline" intent=":literal"><semantics><mrow><mrow><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">0.04</mn></mrow><mo mathsize="0.800em">±</mo><mrow><mn mathsize="0.800em">0.85</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+0.04\pm 0.85\%</annotation></semantics></math></td></tr>
