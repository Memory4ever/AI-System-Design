<td id="S5.T4.2.3.2" class="ltx_td ltx_align_center ltx_border_t">0.80</td>
<td id="S5.T4.2.3.3" class="ltx_td ltx_align_center ltx_border_t">0.81</td></tr>
<tr id="S5.T4.2.4" class="ltx_tr">
<th id="S5.T4.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">ImageNet Accuracy</th>
