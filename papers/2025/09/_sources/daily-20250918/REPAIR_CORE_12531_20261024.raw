<td id="S5.T3.2.5.3" class="ltx_td ltx_align_center">618 (450 - 631)</td></tr>
<tr id="S5.T3.2.6" class="ltx_tr">
<th id="S5.T3.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">DINOv2 Frozen</th>
<td id="S5.T3.2.6.2" class="ltx_td ltx_align_center">218 (196 - 283)</td>
<td id="S5.T3.2.6.3" class="ltx_td ltx_align_center">559 (514 - 627)</td></tr>
<tr id="S5.T3.2.7" class="ltx_tr">
<th id="S5.T3.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">CLIP Fully Fine-tuned</th>
<td id="S5.T3.2.7.2" class="ltx_td ltx_align_center">236 (180 - 276)</td>
<td id="S5.T3.2.7.3" class="ltx_td ltx_align_center">750 (693 - 782)</td></tr>
<tr id="S5.T3.2.8" class="ltx_tr">
<th id="S5.T3.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">CLIP Partially Fine-tuned</th>
<td id="S5.T3.2.8.2" class="ltx_td ltx_align_center">312 (297 - 314)</td>
