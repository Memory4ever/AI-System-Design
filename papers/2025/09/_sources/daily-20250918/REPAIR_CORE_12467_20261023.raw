<figure id="S6.F2.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.12467v1/nntk1_2.png" id="S6.F2.sf1.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:197/197;" width="197" height="197" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.12467v1/nntk1_3.png" id="S6.F2.sf2.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:197/197;" width="197" height="197" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>Step Function: Attention</figcaption>
</figure>
<figure id="S6.F3" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F3.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.12467v1/nntk1_4.png" id="S6.F3.sf1.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:197/197;" width="197" height="197" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F3.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.12467v1/nntk1_5.png" id="S6.F3.sf2.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:197/197;" width="197" height="197" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>Step Function: Monte Carlo</figcaption>
</figure>
<figure id="S6.F4" class="ltx_figure">
