            <span id="alg1.l15.3" class="ltx_text" style="--ltx-fg-color:#000000;">Generate proof: </span><math id="alg1.l15.m1" class="ltx_math_unparsed" alttext="\pi\leftarrow\text{Groth16.Prove}(\text{pk},\text{public\_input}\leftarrow\text{Enc}(w),\text{witness}\leftarrow\{\text{Enc}(w_{i})\})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">π</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Groth16.Prove</mtext><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">pk</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">public_input</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Enc</mtext><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">witness</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Enc</mtext><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi\leftarrow\text{Groth16.Prove}(\text{pk},\text{public\_input}\leftarrow\text{Enc}(w),\text{witness}\leftarrow\{\text{Enc}(w_{i})\})</annotation></semantics></math><span id="alg1.l15.4" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
