</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
            <span id="alg1.l7.3" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><math id="alg1.l7.m1" class="ltx_Math" alttext="\text{sig}_{i}\leftarrow\text{Sign}(\text{Enc}(w_{i}),\text{privKey}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">sig</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Enc</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">privKey</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{sig}_{i}\leftarrow\text{Sign}(\text{Enc}(w_{i}),\text{privKey}_{i})</annotation></semantics></math><span id="alg1.l7.4" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            <span id="alg1.l8.3" class="ltx_text" style="--ltx-fg-color:#000000;">  Send </span><math id="alg1.l8.m1" class="ltx_Math" alttext="(\text{Enc}(w_{i}),\text{sig}_{i})" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Enc</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">sig</mtext><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\text{Enc}(w_{i}),\text{sig}_{i})</annotation></semantics></math><span id="alg1.l8.4" class="ltx_text" style="--ltx-fg-color:#000000;"> to aggregator
</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
