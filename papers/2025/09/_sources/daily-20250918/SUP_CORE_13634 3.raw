</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
            <span id="alg1.l11.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Global Aggregation and ZKP Generation (at Aggregator):</span><span id="alg1.l11.4" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
            <span id="alg1.l12.3" class="ltx_text" style="--ltx-fg-color:#000000;">Aggregator collects and verifies all client signatures on </span><math id="alg1.l12.m1" class="ltx_Math" alttext="\{\text{Enc}(w_{i})\}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Enc</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\text{Enc}(w_{i})\}</annotation></semantics></math><span id="alg1.l12.4" class="ltx_text" style="--ltx-fg-color:#000000;">.
</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
            <math id="alg1.l13.m1" class="ltx_Math" alttext="\text{Enc}(w)\leftarrow\prod_{i=1}^{n}\text{Enc}(w_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Enc</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em" stretchy="false">←</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∏</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi></msubsup><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Enc</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{Enc}(w)\leftarrow\prod_{i=1}^{n}\text{Enc}(w_{i})</annotation></semantics></math><span id="alg1.l13.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
            <math id="alg1.l14.m1" class="ltx_Math" alttext="\text{sig}_{\text{agg}}\leftarrow\text{Sign}(\text{Enc}(w),\text{privKey}_{\text{agg}})" display="inline" intent=":literal"><semantics><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">sig</mtext><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">agg</mtext></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">Enc</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">privKey</mtext><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">agg</mtext></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{sig}_{\text{agg}}\leftarrow\text{Sign}(\text{Enc}(w),\text{privKey}_{\text{agg}})</annotation></semantics></math><span id="alg1.l14.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
