<th id="S3.T3.6.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">23M</th>
<td id="S3.T3.6.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.6.3.3.1" class="ltx_text ltx_underline ltx_font_bold">76.9</span></td>
<td id="S3.T3.6.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.6.3.4.1" class="ltx_text ltx_underline ltx_font_bold">46.5</span></td>
<td id="S3.T3.6.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.6.3.5.1" class="ltx_text ltx_underline ltx_font_bold">84.5</span></td>
<td id="S3.T3.6.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.6.3.6.1" class="ltx_text ltx_underline ltx_font_bold" style="--ltx-fg-color:#0000FF;">47.3</span></td>
<td id="S3.T3.6.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.6.3.7.1" class="ltx_text" style="--ltx-fg-color:#0000FF;">51.8</span></td>
<td id="S3.T3.6.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.6.3.8.1" class="ltx_text ltx_underline ltx_font_bold">82.8</span></td>
<td id="S3.T3.6.3.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T3.6.3.9.1" class="ltx_text ltx_underline ltx_font_bold">30.9</span></td>
<td id="S3.T3.6.3.10" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T3.6.3.10.1" class="ltx_text ltx_underline ltx_font_bold">60.1</span></td>
<td id="S3.T3.6.3.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.6.3.11.1" class="ltx_text ltx_underline ltx_font_bold">64.1</span></td></tr>
<tr id="S3.T3.6.4" class="ltx_tr">
<th id="S3.T3.6.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="S3.T3.6.4.1.1" class="ltx_text ltx_font_typewriter ltx_font_bold">leaf-mt</span></th>
<th id="S3.T3.6.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">23M</th>
<td id="S3.T3.6.4.3" class="ltx_td ltx_align_center"><math id="S3.T3.m3" class="ltx_Math" alttext="\dagger" display="inline" intent=":literal"><semantics><mo>†</mo><annotation encoding="application/x-tex">\dagger</annotation></semantics></math></td>
<td id="S3.T3.6.4.4" class="ltx_td ltx_align_center"><math id="S3.T3.m4" class="ltx_Math" alttext="\dagger" display="inline" intent=":literal"><semantics><mo>†</mo><annotation encoding="application/x-tex">\dagger</annotation></semantics></math></td>
<td id="S3.T3.6.4.5" class="ltx_td ltx_align_center"><math id="S3.T3.m5" class="ltx_Math" alttext="\dagger" display="inline" intent=":literal"><semantics><mo>†</mo><annotation encoding="application/x-tex">\dagger</annotation></semantics></math></td>
<td id="S3.T3.6.4.6" class="ltx_td ltx_align_center">46.9</td>
