<td id="S3.T3.6.4.9" class="ltx_td ltx_align_center ltx_border_r"><math id="S3.T3.m7" class="ltx_Math" alttext="\dagger" display="inline" intent=":literal"><semantics><mo>†</mo><annotation encoding="application/x-tex">\dagger</annotation></semantics></math></td>
<td id="S3.T3.6.4.10" class="ltx_td ltx_align_center ltx_border_r"><span id="S3.T3.6.4.10.1" class="ltx_text ltx_underline ltx_font_bold">59.4</span></td>
<td id="S3.T3.6.4.11" class="ltx_td ltx_align_center"><span id="S3.T3.6.4.11.1" class="ltx_text ltx_underline ltx_font_bold">63.0</span></td></tr>
<tr id="S3.T3.6.5" class="ltx_tr">
<th id="S3.T3.6.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="11">Comparisons</th></tr>
<tr id="S3.T3.6.6" class="ltx_tr">
<th id="S3.T3.6.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">MiniLM-L6-v2</th>
<th id="S3.T3.6.6.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">23M</th>
