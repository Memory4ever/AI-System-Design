<td id="S4.T3.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">+0.98 %</td></tr>
<tr id="S4.T3.2.1.3" class="ltx_tr">
<th id="S4.T3.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">CIFAR-100</th>
<th id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">50</th>
<td id="S4.T3.2.1.3.3" class="ltx_td ltx_align_center"><span id="S4.T3.2.1.3.3.1" class="ltx_text ltx_font_bold">68.50 %</span></td>
<td id="S4.T3.2.1.3.4" class="ltx_td ltx_align_center">64.86 %</td>
