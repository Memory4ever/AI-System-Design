<tr id="S4.T3.2.1.4" class="ltx_tr">
<th id="S4.T3.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">CUB-200</th>
<th id="S4.T3.2.1.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">20</th>
