<td id="S2.T1.2.1.4.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S2.T1.2.1.4.7.1" class="ltx_text" style="--ltx-fg-color:#009900;">✓</span></td></tr>
<tr id="S2.T1.2.1.5" class="ltx_tr">
