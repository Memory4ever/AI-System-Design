<td id="S4.T3.2.1.10.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.5pt 2.0pt;"><span id="S4.T3.2.1.10.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F4E1D2;">100.0%</span></td>
