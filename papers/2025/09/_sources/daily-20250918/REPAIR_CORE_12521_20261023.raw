<span id="A5.T9.2.1.2.1.1" class="ltx_inline-block ltx_align_top" style="width:51.2pt;">
<span id="A5.T9.2.1.2.1.1.1" class="ltx_p ltx_align_center">Phi</span>
</span></td>
<td id="A5.T9.2.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t" style="padding:0.5pt 4.0pt;">
<span id="A5.T9.2.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:51.2pt;">
<span id="A5.T9.2.1.2.2.1.1" class="ltx_p ltx_align_center">74.1</span>
</span></td>
