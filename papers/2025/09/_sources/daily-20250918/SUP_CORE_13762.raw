<tr id="S3.T1.3.8" class="ltx_tr">
<td id="S3.T1.3.8.1" class="ltx_td ltx_align_left" style="padding-left:9.0pt;padding-right:9.0pt;">DIAP <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib31" title="" class="ltx_ref">31</a>]</cite></td>
<td id="S3.T1.3.8.2" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">88.5</td>
<td id="S3.T1.3.8.3" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">89.7</td>
<td id="S3.T1.3.8.4" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">59.5</td>
<td id="S3.T1.3.8.5" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">0.08</td>
<td id="S3.T1.3.8.6" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">0.23</td>
<td id="S3.T1.3.8.7" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">79.70</td></tr>
<tr id="S3.T1.3.9" class="ltx_tr">
<td id="S3.T1.3.9.1" class="ltx_td ltx_align_left" style="padding-left:9.0pt;padding-right:9.0pt;">RAW-Adapter <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">4</a>]</cite></td>
<td id="S3.T1.3.9.2" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">88.7</td>
<td id="S3.T1.3.9.3" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">89.7</td>
<td id="S3.T1.3.9.4" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">62.1</td>
<td id="S3.T1.3.9.5" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">0.76</td>
<td id="S3.T1.3.9.6" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">4.02</td>
<td id="S3.T1.3.9.7" class="ltx_td ltx_align_center" style="padding-left:9.0pt;padding-right:9.0pt;">158.01</td></tr>
<tr id="S3.T1.3.10" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
