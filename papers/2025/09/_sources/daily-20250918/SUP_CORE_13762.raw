<td id="S2.T7.3.3.3" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;">63.3</td></tr>
<tr id="S2.T7.3.4" class="ltx_tr">
<td id="S2.T7.3.4.1" class="ltx_td ltx_align_left" style="padding-left:14.0pt;padding-right:14.0pt;">n=16</td>
<td id="S2.T7.3.4.2" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;">89.9</td>
<td id="S2.T7.3.4.3" class="ltx_td ltx_align_center" style="padding-left:14.0pt;padding-right:14.0pt;">63.9</td></tr>
<tr id="S2.T7.3.5" class="ltx_tr">
<td id="S2.T7.3.5.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:14.0pt;padding-right:14.0pt;">n=32</td>
