<td id="S5.T2.1.4.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_b ltx_border_l ltx_border_r ltx_border_t"><span id="S5.T2.1.4.1.1" class="ltx_inline-logical-block ltx_align_top" style="width:69.0pt;">
<span id="S5.T2.p7" class="ltx_para ltx_noindent">
<span id="S5.T2.p7.1" class="ltx_p"><span id="S5.T2.p7.1.1" class="ltx_text"></span> <span id="S5.T2.p7.1.2" class="ltx_text">
<span id="S5.T2.p7.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T2.p7.1.2.1.1" class="ltx_tr">
<span id="S5.T2.p7.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S5.T2.p7.m1" class="ltx_Math" alttext="H^{2}R" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">H^{2}R</annotation></semantics></math> w/o low-level memories</span></span>
</span></span><span id="S5.T2.p7.1.3" class="ltx_text"></span></span>
</span></span></td>
<td id="S5.T2.1.4.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_b ltx_border_r ltx_border_t"><span id="S5.T2.1.4.2.1" class="ltx_inline-logical-block ltx_align_top" style="width:48.3pt;">
<span id="S5.T2.p8" class="ltx_para ltx_noindent">
<span id="S5.T2.p8.1" class="ltx_p"><span id="S5.T2.p8.1.1" class="ltx_text"></span> <span id="S5.T2.p8.1.2" class="ltx_text">
<span id="S5.T2.p8.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S5.T2.p8.1.2.1.1" class="ltx_tr">
<span id="S5.T2.p8.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">61.1</span></span>
</span></span><span id="S5.T2.p8.1.3" class="ltx_text"></span></span>
</span></span></td></tr>
