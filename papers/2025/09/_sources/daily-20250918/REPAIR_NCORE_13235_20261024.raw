<div id="S4.T1.2.1.3.1" class="ltx_inline-block ltx_transformed_outer" style="width:36.6pt;height:36.6pt;vertical-align:-1.4pt;"><span class="ltx_transformed_inner" style="width:42.8pt;transform:translate(-3.1pt,-13.8pt) rotate(-45deg) ;">
<p id="S4.T1.2.1.3.1.1" class="ltx_p">Similarity</p>
</span></div></td>
