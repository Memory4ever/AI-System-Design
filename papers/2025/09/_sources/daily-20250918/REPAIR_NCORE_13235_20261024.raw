<td id="S4.T1.2.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.5pt;padding-right:3.5pt;">
<div id="S4.T1.2.1.2.1" class="ltx_inline-block ltx_transformed_outer" style="width:43.4pt;height:43.4pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:54.4pt;transform:translate(-5.5pt,-18.2pt) rotate(-45deg) ;">
<p id="S4.T1.2.1.2.1.1" class="ltx_p">Multi-modal</p>
</span></div></td>
