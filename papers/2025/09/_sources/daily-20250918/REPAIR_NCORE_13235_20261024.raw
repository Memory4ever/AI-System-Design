<p id="S4.T1.2.1.5.1.1" class="ltx_p">Sync</p>
</span></div></td>
<td id="S4.T1.2.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.5pt;padding-right:3.5pt;">
<div id="S4.T1.2.1.6.1" class="ltx_inline-block ltx_transformed_outer" style="width:47.4pt;height:47.5pt;vertical-align:-1.4pt;"><span class="ltx_transformed_inner" style="width:58.2pt;transform:translate(-5.4pt,-19.3pt) rotate(-45deg) ;">
<p id="S4.T1.2.1.6.1.1" class="ltx_p">Entity Model</p>
</span></div></td>
