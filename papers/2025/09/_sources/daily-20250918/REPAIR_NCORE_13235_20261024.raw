<div id="S4.T1.2.1.7.1" class="ltx_inline-block ltx_transformed_outer" style="width:41.0pt;height:41pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:51.2pt;transform:translate(-5.1pt,-17.1pt) rotate(-45deg) ;">
<p id="S4.T1.2.1.7.1.1" class="ltx_p">Time Series</p>
</span></div></td>
