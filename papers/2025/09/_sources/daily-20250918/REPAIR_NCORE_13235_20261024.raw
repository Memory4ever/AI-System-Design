<ul id="S4.I2" class="ltx_itemize ltx_centering ltx_figure_panel">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p"><span id="S4.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Legend:</span> Y = Fully supported, N = Not supported, P = Partially supported</p>
</div></li>
</ul></div></div>
