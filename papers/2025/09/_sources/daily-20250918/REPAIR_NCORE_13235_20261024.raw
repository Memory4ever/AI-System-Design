<p id="S4.T1.2.1.8.1.1" class="ltx_p">Versioning</p>
</span></div></td>
<td id="S4.T1.2.1.9" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.5pt;padding-right:3.5pt;">
<div id="S4.T1.2.1.9.1" class="ltx_inline-block ltx_transformed_outer" style="width:40.2pt;height:40.2pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:49.9pt;transform:translate(-4.9pt,-16.6pt) rotate(-45deg) ;">
<p id="S4.T1.2.1.9.1.1" class="ltx_p">Distributed</p>
</span></div></td>
<td id="S4.T1.2.1.10" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.5pt;padding-right:3.5pt;">
<div id="S4.T1.2.1.10.1" class="ltx_inline-block ltx_transformed_outer" style="width:29.8pt;height:29.8pt;vertical-align:-1.4pt;"><span class="ltx_transformed_inner" style="width:33.2pt;transform:translate(-1.7pt,-10.4pt) rotate(-45deg) ;">
<p id="S4.T1.2.1.10.1.1" class="ltx_p">Linking</p>
</span></div></td>
<td id="S4.T1.2.1.11" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.5pt;padding-right:3.5pt;">
<div id="S4.T1.2.1.11.1" class="ltx_inline-block ltx_transformed_outer" style="width:45.6pt;height:45.6pt;vertical-align:-1.4pt;"><span class="ltx_transformed_inner" style="width:55.7pt;transform:translate(-5.1pt,-18.4pt) rotate(-45deg) ;">
<p id="S4.T1.2.1.11.1.1" class="ltx_p">Compression</p>
</span></div></td>
<td id="S4.T1.2.1.12" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.5pt;padding-right:3.5pt;">
<div id="S4.T1.2.1.12.1" class="ltx_inline-block ltx_transformed_outer" style="width:51.9pt;height:51.9pt;vertical-align:-1.4pt;"><span class="ltx_transformed_inner" style="width:64.4pt;transform:translate(-6.3pt,-21.5pt) rotate(-45deg) ;">
<p id="S4.T1.2.1.12.1.1" class="ltx_p">Online Update</p>
