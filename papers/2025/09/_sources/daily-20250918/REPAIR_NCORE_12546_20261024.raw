<tr id="Sx3.T1.7.1.3" class="ltx_tr">
<td id="Sx3.T1.7.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">Xception <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib7" title="" class="ltx_ref">Chollet 2017</a>)</cite></td>
<td id="Sx3.T1.7.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">99.09</td>
<td id="Sx3.T1.7.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">3.77</td>
<td id="Sx3.T1.7.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">87.86</td>
<td id="Sx3.T1.7.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">21.04</td>
<td id="Sx3.T1.7.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">69.80</td>
<td id="Sx3.T1.7.1.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">35.41</td>
<td id="Sx3.T1.7.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">66.17</td>
<td id="Sx3.T1.7.1.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">40.14</td>
<td id="Sx3.T1.7.1.3.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">65.27</td>
<td id="Sx3.T1.7.1.3.11" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">38.77</td></tr>
<tr id="Sx3.T1.7.1.4" class="ltx_tr">
<td id="Sx3.T1.7.1.4.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-top:0.5pt;padding-bottom:0.5pt;">EN-b4 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib38" title="" class="ltx_ref">Tan and Le 2019b</a>)</cite></td>
<td id="Sx3.T1.7.1.4.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">99.22</td>
<td id="Sx3.T1.7.1.4.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:0.5pt;padding-bottom:0.5pt;">3.36</td>
<td id="Sx3.T1.7.1.4.4" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">87.37</td>
<td id="Sx3.T1.7.1.4.5" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">21.99</td>
<td id="Sx3.T1.7.1.4.6" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">70.12</td>
