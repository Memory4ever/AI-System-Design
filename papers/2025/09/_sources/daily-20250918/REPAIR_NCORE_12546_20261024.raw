<td id="Sx3.T7.1.1.7.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx3.T7.1.1.7.3.1" class="ltx_text ltx_font_bold">14.5</span></td>
<td id="Sx3.T7.1.1.7.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx3.T7.1.1.7.4.1" class="ltx_text ltx_font_bold">85.8</span></td>
<td id="Sx3.T7.1.1.7.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx3.T7.1.1.7.5.1" class="ltx_text ltx_font_bold">21.6</span></td>
