<td id="Sx3.T7.1.1.4.5" class="ltx_td ltx_align_center">27.8</td>
<td id="Sx3.T7.1.1.4.6" class="ltx_td ltx_align_center">4.5</td></tr>
<tr id="Sx3.T7.1.1.5" class="ltx_tr">
