><span id="lstnumberx2.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx2.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">natural</span><span id="lstnumberx2.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">language</span><span id="lstnumberx2.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">instructions</span><span id="lstnumberx2.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">provided</span><span id="lstnumberx2.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter">by</span><span id="lstnumberx2.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx2.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">user</span><span id="lstnumberx2.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter">into</span><span id="lstnumberx2.41" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter">executable</span><span id="lstnumberx2.43" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter">multi</span><span id="lstnumber