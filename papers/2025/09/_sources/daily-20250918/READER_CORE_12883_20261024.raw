<td id="S4.T1.2.1.10.8" class="ltx_td ltx_align_center"><span id="S4.T1.2.1.10.8.1" class="ltx_text ltx_font_bold">4.68</span></td>
<td id="S4.T1.2.1.10.9" class="ltx_td ltx_align_center">2.52</td>
