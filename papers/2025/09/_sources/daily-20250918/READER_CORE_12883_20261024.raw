<td id="S4.T1.2.1.11.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.2.1.11.7.1" class="ltx_text ltx_underline">4.47</span></td>
<td id="S4.T1.2.1.11.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">4.01</td>
<td id="S4.T1.2.1.11.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.2.1.11.9.1" class="ltx_text ltx_font_bold">3.18</span></td>
<td id="S4.T1.2.1.11.10" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t">3.24</td>
<td id="S4.T1.2.1.11.11" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.2.1.11.11.1" class="ltx_text ltx_font_bold">3.50</span></td></tr>
