<th id="S4.T1.2.1.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r ltx_border_t"><span id="S4.T1.2.1.11.1.1" class="ltx_text ltx_font_bold">Ours</span></th>
