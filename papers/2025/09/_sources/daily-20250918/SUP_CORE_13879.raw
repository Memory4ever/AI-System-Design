<div id="S3.T7.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:303.9pt;height:142.5pt;vertical-align:-69.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-16.9pt,7.9pt) scale(0.9,0.9) ;">
