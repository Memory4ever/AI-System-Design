<td id="S3.T7.3.1.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T7.3.1.2.2.1" class="ltx_text ltx_font_sansserif">CER</span></td>
<td id="S3.T7.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T7.3.1.2.3.1" class="ltx_text ltx_font_bold">67.55</span></td>
<td id="S3.T7.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T7.3.1.2.4.1" class="ltx_text ltx_font_bold">72.43</span></td>
<td id="S3.T7.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T7.3.1.2.5.1" class="ltx_text ltx_font_bold">69.90</span></td></tr>
<tr id="S3.T7.3.1.3" class="ltx_tr">
<td id="S3.T7.3.1.3.1" class="ltx_td ltx_align_left">w/o <span id="S3.T7.3.1.3.1.1" class="ltx_text ltx_font_italic">Doctor</span> role assignment</td>
<td id="S3.T7.3.1.3.2" class="ltx_td ltx_align_center">37.10</td>
<td id="S3.T7.3.1.3.3" class="ltx_td ltx_align_center">30.15</td>
<td id="S3.T7.3.1.3.4" class="ltx_td ltx_align_center">33.26</td></tr>
<tr id="S3.T7.3.1.4" class="ltx_tr">
<td id="S3.T7.3.1.4.1" class="ltx_td ltx_align_left">w/o scientific evidence</td>
<td id="S3.T7.3.1.4.2" class="ltx_td ltx_align_center">41.81</td>
<td id="S3.T7.3.1.4.3" class="ltx_td ltx_align_center">38.59</td>
<td id="S3.T7.3.1.4.4" class="ltx_td ltx_align_center">40.13</td></tr>
<tr id="S3.T7.3.1.5" class="ltx_tr">
<td id="S3.T7.3.1.5.1" class="ltx_td ltx_align_left">w/o justification</td>
