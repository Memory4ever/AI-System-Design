<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F3.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S3.F3.sf3.4" class="ltx_text" style="font-size:90%;">SciFact</span></figcaption>
