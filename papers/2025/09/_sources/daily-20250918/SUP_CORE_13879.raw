<td id="S3.T7.3.1.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T7.3.1.1.3.1" class="ltx_text ltx_font_bold">P (%)</span></td>
<td id="S3.T7.3.1.1.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T7.3.1.1.4.1" class="ltx_text ltx_font_bold">R (%)</span></td>
<td id="S3.T7.3.1.1.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T7.3.1.1.5.1" class="ltx_text ltx_font_bold">F1 (%)</span></td></tr>
<tr id="S3.T7.3.1.2" class="ltx_tr">
