<span id="S3.T4.3.1.1.1.1.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T4.3.1.1.1.1.2.1" class="ltx_text ltx_font_bold">Fact-Checker</span></span>
<span id="S3.T4.3.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_t ltx_colspan ltx_colspan_3"><span id="S3.T4.3.1.1.1.1.3.1" class="ltx_text ltx_font_bold">HealthFC</span></span>
<span id="S3.T4.3.1.1.1.1.4" class="ltx_td ltx_border_t"></span>
<span id="S3.T4.3.1.1.1.1.5" class="ltx_td ltx_align_center ltx_border_t ltx_colspan ltx_colspan_3"><span id="S3.T4.3.1.1.1.1.5.1" class="ltx_text ltx_font_bold">BioASQ-7b</span></span>
<span id="S3.T4.3.1.1.1.1.6" class="ltx_td ltx_border_t"></span>
<span id="S3.T4.3.1.1.1.1.7" class="ltx_td ltx_align_center ltx_border_t ltx_colspan ltx_colspan_3"><span id="S3.T4.3.1.1.1.1.7.1" class="ltx_text ltx_font_bold">SciFact</span></span></span>
<span id="S3.T4.3.1.1.1.2" class="ltx_tr">
<span id="S3.T4.3.1.1.1.2.1" class="ltx_td"></span>
<span id="S3.T4.3.1.1.1.2.2" class="ltx_td"></span>
<span id="S3.T4.3.1.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T4.3.1.1.1.2.3.1" class="ltx_text ltx_font_bold">Precision (%)</span></span>
<span id="S3.T4.3.1.1.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T4.3.1.1.1.2.4.1" class="ltx_text ltx_font_bold">Recall (%)</span></span>
<span id="S3.T4.3.1.1.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T4.3.1.1.1.2.5.1" class="ltx_text ltx_font_bold">F1 (%)</span></span>
<span id="S3.T4.3.1.1.1.2.6" class="ltx_td"></span>
<span id="S3.T4.3.1.1.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T4.3.1.1.1.2.7.1" class="ltx_text ltx_font_bold">Precision (%)</span></span>
<span id="S3.T4.3.1.1.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T4.3.1.1.1.2.8.1" class="ltx_text ltx_font_bold">Recall (%)</span></span>
<span id="S3.T4.3.1.1.1.2.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T4.3.1.1.1.2.9.1" class="ltx_text ltx_font_bold">F1 (%)</span></span>
<span id="S3.T4.3.1.1.1.2.10" class="ltx_td"></span>
