</div>
<div id="lstnumberx27" class="ltx_listingline"><span id="lstnumberx27.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Classify</span><span id="lstnumberx27.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx27.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sentiment</span><span id="lstnumberx27.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx27.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx27.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">following</span><span id="lstnumberx27.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">movie</span><span id="lstnumberx27.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">review</span><span id="lstnumberx27.16" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx27.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Respond</span><span id="lstnumberx27.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">using</span><span id="lstnumberx27.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx27.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">following</span><span id="lstnumberx27.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">JSON</span><span id="lstnumberx27.27" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx27.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.29" class="ltx_text ltx_font_typewriter">{"</span><span id="lstnumberx27.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sentiment</span><span id="lstnumberx27.31" class="ltx_text ltx_font_typewriter">":</span><span id="lstnumberx27.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">str</span><span id="lstnumberx27.34" class="ltx_text ltx_font_typewriter">}.</span><span id="lstnumberx27.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">REVIEW</span><span id="lstnumberx27.37" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx27.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">TEXT</span><span id="lstnumberx27.40" class="ltx_text ltx_font_typewriter">&lt;|</span><span id="lstnumberx27.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter">end</span><span id="lstnumberx27.42" class="ltx_text ltx_font_typewriter">|&gt;</span>
</div>
