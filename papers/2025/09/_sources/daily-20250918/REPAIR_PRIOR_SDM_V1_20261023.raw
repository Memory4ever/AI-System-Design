</div>
<div id="lstnumberx101" class="ltx_listingline"><span id="lstnumberx101.1" class="ltx_text ltx_lst_space ltx_font_typewriter">        </span><span id="lstnumberx101.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">batch_genai_y</span><span id="lstnumberx101.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.4" class="ltx_text ltx_font_typewriter">=</span><span id="lstnumberx101.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.6" class="ltx_text ltx_font_typewriter">#</span><span id="lstnumberx101.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx101.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">next</span><span id="lstnumberx101.11" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx101.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">token</span><span id="lstnumberx101.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">labels</span><span id="lstnumberx101.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">with</span><span id="lstnumberx101.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">applicable</span><span id="lstnumberx101.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">index</span><span id="lstnumberx101.21" class="ltx_text ltx_font_typewriter">+|</span><span id="lstnumberx101.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">V</span><span id="lstnumberx101.23" class="ltx_text ltx_font_typewriter">|</span><span id="lstnumberx101.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx101.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">offsets</span>
</div>
<div id="lstnumberx102" class="ltx_listingline"><span id="lstnumberx102.1" class="ltx_text ltx_lst_space ltx_font_typewriter">        </span><span id="lstnumberx102.2" class="ltx_text ltx_font_typewriter">#</span><span id="lstnumberx102.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx102.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx102.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx102.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">sdm</span><span id="lstnumberx102.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx102.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">activations</span><span id="lstnumberx102.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx102.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">for</span><span id="lstnumberx102.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx102.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx102.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx102.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">negative</span><span id="lstnumberx102.15" class="ltx_text ltx_font_typewriter">+</span><span id="lstnumberx102.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">positive</span><span id="lstnumberx102.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx102.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">joint</span><span id="lstnumberx102.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx102.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">distribution</span><span id="lstnumberx102.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx102.22" class="ltx_text ltx_lst_identifier 