<td id="A2.T7.5.1.23.1" class="ltx_td ltx_align_center"><span id="A2.T7.5.1.23.1.1" class="ltx_text" style="font-size:90%;">Security Weight</span></td>
<td id="A2.T7.5.1.23.2" class="ltx_td ltx_align_center" colspan="3"><span id="A2.T7.5.1.23.2.1" class="ltx_text" style="font-size:90%;">0.7</span></td></tr>
<tr id="A2.T7.5.1.24" class="ltx_tr">
<td id="A2.T7.5.1.24.1" class="ltx_td ltx_align_center"><span id="A2.T7.5.1.24.1.1" class="ltx_text" style="font-size:90%;">Functionality Weight</span></td>
<td id="A2.T7.5.1.24.2" class="ltx_td ltx_align_center" colspan="3"><span id="A2.T7.5.1.24.2.1" class="ltx_text" style="font-size:90%;">0.3</span></td></tr>
<tr id="A2.T7.5.1.25" class="ltx_tr">
<td id="A2.T7.5.1.25.1" class="ltx_td ltx_align_center"><span id="A2.T7.5.1.25.1.1" class="ltx_text" style="font-size:90%;">Bottleneck Dim</span></td>
<td id="A2.T7.5.1.25.2" class="ltx_td ltx_align_center" colspan="3"><span id="A2.T7.5.1.25.2.1" class="ltx_text" style="font-size:90%;">256</span></td></tr>
<tr id="A2.T7.5.1.26" class="ltx_tr">
<td id="A2.T7.5.1.26.1" class="ltx_td ltx_align_left ltx_border_t" colspan="2"><span id="A2.T7.5.1.26.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Common Training Settings</span></td>
<td id="A2.T7.5.1.26.2" class="ltx_td ltx_border_t" colspan="4"></td>
