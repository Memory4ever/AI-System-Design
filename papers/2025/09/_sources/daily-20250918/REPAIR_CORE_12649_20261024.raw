<td id="A2.T7.5.1.22.6" class="ltx_td ltx_align_center ltx_border_t" rowspan="4"><span id="A2.T7.5.1.22.6.1" class="ltx_text" style="font-size:90%;">1e-3 to 3e-3</span></td>
<td id="A2.T7.5.1.22.7" class="ltx_td ltx_align_center ltx_border_t" rowspan="4"><span id="A2.T7.5.1.22.7.1" class="ltx_text" style="font-size:90%;">Multi-objective loss</span></td></tr>
