<td id="A2.T7.5.1.27.1" class="ltx_td ltx_align_left" colspan="2"><span id="A2.T7.5.1.27.1.1" class="ltx_text" style="font-size:90%;">Batch Size (effective)</span></td>
<td id="A2.T7.5.1.27.2" class="ltx_td ltx_align_center" colspan="3"><span id="A2.T7.5.1.27.2.1" class="ltx_text" style="font-size:90%;">64</span></td>
<td id="A2.T7.5.1.27.3" class="ltx_td ltx_align_center"><span id="A2.T7.5.1.27.3.1" class="ltx_text" style="font-size:90%;">Cosine w/ warmup</span></td>
