<figure id="S3.F3" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F3.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><span class="ltx_inline-block"><svg id="S3.F3.sf1.pic1" class="ltx_picture ltx_centering" height="238.69" overflow="visible" version="1.1" viewBox="0 0 481.99 238.69" width="481.99"><g transform="translate(0,238.69) matrix(1 0 0 -1 0 0) translate(-0.28,0) translate(0,-0.28)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 0.28 0.28)"><foreignObject style="--ltx-fo-width:34.83em;--ltx-fo-height:17.25em;--ltx-fo-depth:0em;font-size:10pt;" height="238.69" overflow="visible" transform="matrix(1 0 0 -1 0 238.69)" width="481.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><img src="2509.14104v1/sample_distribution_map_log_rand.png" id="S3.F3.sf1.pic1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/238;" width="476" height="238" alt="Refer to caption"><span id="S3.F3.sf1.pic1.1" class="ltx_text">
