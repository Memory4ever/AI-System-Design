<tr id="S3.T1.1.4" class="ltx_tr">
<th id="S3.T1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">PCM + <span id="S3.T1.1.4.1.1" class="ltx_text ltx_font_bold">Ours</span></th>
<td id="S3.T1.1.4.2" class="ltx_td ltx_align_center"><span id="S3.T1.1.4.2.1" class="ltx_text ltx_font_bold">65.83</span></td>
<td id="S3.T1.1.4.3" class="ltx_td ltx_align_center"><span id="S3.T1.1.4.3.1" class="ltx_text ltx_font_bold">29.40</span></td>
<td id="S3.T1.1.4.4" class="ltx_td ltx_align_center"><span id="S3.T1.1.4.4.1" class="ltx_text ltx_font_bold">23.21</span></td>
