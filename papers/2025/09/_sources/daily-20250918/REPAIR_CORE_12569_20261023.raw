<th id="S3.T1.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">8 steps</th>
<th id="S3.T1.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">2 steps</th>
<th id="S3.T1.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">4 steps</th>
<th id="S3.T1.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">8 steps</th>
<th id="S3.T1.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">2 steps</th>
<th id="S3.T1.1.2.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">4 steps</th>
<th id="S3.T1.1.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">8 steps</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T1.1.3" class="ltx_tr">
<th id="S3.T1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">PCM <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib29" title="" class="ltx_ref">Wang et al. 2024</a>)</cite></th>
<td id="S3.T1.1.3.2" class="ltx_td ltx_align_center ltx_border_t">372.82</td>
<td id="S3.T1.1.3.3" class="ltx_td ltx_align_center ltx_border_t">112.65</td>
<td id="S3.T1.1.3.4" class="ltx_td ltx_align_center ltx_border_t">31.73</td>
<td id="S3.T1.1.3.5" class="ltx_td ltx_align_center ltx_border_t">18.44</td>
<td id="S3.T1.1.3.6" class="ltx_td ltx_align_center ltx_border_t">24.18</td>
