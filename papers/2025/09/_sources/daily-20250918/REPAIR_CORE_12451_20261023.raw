<td id="S4.T1.2.1.23.19" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.2.1.23.19.1" class="ltx_text ltx_font_bold">98.30<sup id="S4.T1.2.1.23.19.1.1" class="ltx_sup">+</sup></span></td></tr>
