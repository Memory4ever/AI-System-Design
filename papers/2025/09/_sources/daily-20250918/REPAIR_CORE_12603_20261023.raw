<td id="S4.T2.2.1.2.3" class="ltx_td"></td>
<td id="S4.T2.2.1.2.4" class="ltx_td ltx_align_right"><span id="S4.T2.2.1.2.4.1" class="ltx_text ltx_font_bold">(%)</span></td></tr>
<tr id="S4.T2.2.1.3" class="ltx_tr">
