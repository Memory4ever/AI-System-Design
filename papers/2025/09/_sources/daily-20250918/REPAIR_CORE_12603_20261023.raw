<td id="S4.T3.2.8.3" class="ltx_td ltx_align_center"><span id="S4.T3.2.8.3.1" class="ltx_text ltx_font_bold">68.9</span></td>
<td id="S4.T3.2.8.4" class="ltx_td ltx_align_center"><span id="S4.T3.2.8.4.1" class="ltx_text ltx_font_bold">70.5</span></td>
<td id="S4.T3.2.8.5" class="ltx_td ltx_align_center">84.1</td></tr>
<tr id="S4.T3.2.9" class="ltx_tr">
<td id="S4.T3.2.9.1" class="ltx_td ltx_border_bb"></td>
