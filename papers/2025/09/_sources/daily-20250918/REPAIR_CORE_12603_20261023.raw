<td id="S4.T1.2.1.8.2" class="ltx_td ltx_align_right">4.5k<math id="S4.T1.m10" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>32</td>
<td id="S4.T1.2.1.8.3" class="ltx_td ltx_align_center">75.8</td>
<td id="S4.T1.2.1.8.4" class="ltx_td ltx_align_right">10<math id="S4.T1.m11" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
