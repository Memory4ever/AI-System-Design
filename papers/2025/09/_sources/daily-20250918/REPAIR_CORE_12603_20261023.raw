<td id="S4.T2.2.1.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.2.1.6.2.1" class="ltx_text ltx_font_bold">75.8</span></td>
<td id="S4.T2.2.1.6.3" class="ltx_td ltx_align_right ltx_border_bb">4,488</td>
<td id="S4.T2.2.1.6.4" class="ltx_td ltx_align_right ltx_border_bb">100.0</td></tr>
