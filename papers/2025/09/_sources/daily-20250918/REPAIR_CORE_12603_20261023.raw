<td id="S4.T2.2.1.5.2" class="ltx_td ltx_align_center">75.4</td>
<td id="S4.T2.2.1.5.3" class="ltx_td ltx_align_right"><span id="S4.T2.2.1.5.3.1" class="ltx_text ltx_font_bold">1,186</span></td>
<td id="S4.T2.2.1.5.4" class="ltx_td ltx_align_right"><span id="S4.T2.2.1.5.4.1" class="ltx_text ltx_font_bold">14.8</span></td></tr>
