<td id="S4.T2.2.1.4.2" class="ltx_td ltx_align_center">71.7</td>
<td id="S4.T2.2.1.4.3" class="ltx_td ltx_align_right">1,433</td>
<td id="S4.T2.2.1.4.4" class="ltx_td ltx_align_right">18.1</td></tr>
<tr id="S4.T2.2.1.5" class="ltx_tr">
