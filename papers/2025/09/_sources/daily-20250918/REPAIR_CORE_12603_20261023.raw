<td id="S4.T3.2.5.3" class="ltx_td ltx_align_center">66.8</td>
<td id="S4.T3.2.5.4" class="ltx_td ltx_align_center">68.9</td>
<td id="S4.T3.2.5.5" class="ltx_td ltx_align_center">74.8</td></tr>
<tr id="S4.T3.2.6" class="ltx_tr">
