<td id="S4.T1.2.1.7.5" class="ltx_td ltx_align_right">0.5k<math id="S4.T1.m8" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>32</td>
