<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex93.m1" class="ltx_Math" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\frac{\{\mathbbm{1}\{\bm{y}=\bm{\tilde{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}f_{\mathcal{P}}(\bm{z},T_{i}=t)-f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\mathbbm{1}\{T_{i}=t,\bm{z}=\tilde{\bm{z}}\}}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">{</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mi>f</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><mi>𝒛</mi><