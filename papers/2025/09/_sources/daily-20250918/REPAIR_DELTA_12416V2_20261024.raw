<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex84.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S=1)}\int_{\mathcal{Z}}\int_{\mathcal{Y}}\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}}\}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{y},\bm{z},S_{i}=1]\biggr)\,\frac{\,f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)}{f_{\mathcal{P}}(\bm{y}\mid\bm{z})}d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>S</mi><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">}</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mover accent="true"><mi>l</mi><mo>~</mo></mover><mo>−</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em" rspace="0.170em">)</mo></mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>d</mi><mi>𝒚</mi><mi>d</mi><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S=1)}\int_{\mathcal{Z}}\int_{\mathcal{Y}}\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}}\}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{y},\bm{z},S_{i}=1]\biggr)\,\frac{\,f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)}{f_{\mathcal{P}}(\bm{y}\mid\bm{z})}d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex85.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{P}(T_{i}=t\mid\bm{Y}_{i}=\tilde{\bm{y}},\bm{Z}_{i}=\tilde{\bm{z}})}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{y},\bm{z},S_{i}=1]\biggr)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mover accent="true"><mi>l</mi><mo>~</mo></mover><mo>−</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{P}(T_{i}=t\mid\bm{Y}_{i}=\tilde{\bm{y}},\bm{Z}_{i}=\tilde{\bm{z}})}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{y},\bm{z},S_{i}=1]\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex86.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})=\bm{f}(\tilde{\bm{y}},\tilde{\bm{z}}))}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{f}(\bm{y},\bm{z}),S_{i}=1]\biggr)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mover accent="true"><mi>l</mi><mo>~</mo></mover><mo>−</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})=\bm{f}(\tilde{\bm{y}},\tilde{\bm{z}}))}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{f}(\bm{y},\bm{z}),S_{i}=1]\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex87.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})=\bm{f}(\tilde{\bm{y}},\tilde{\bm{z}}))}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(\tilde{l}-m_{\mathcal{P}}(\tilde{\bm{y}},\tilde{\bm{z}})\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mover accent="true"><mi>l</mi><mo>~</mo></mover><mo>−</mo><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})=\bm{f}(\tilde{\bm{y}},\tilde{\bm{z}}))}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(\tilde{l}-m_{\mathcal{P}}(\tilde{\bm{y}},\tilde{\bm{z}})\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p3.5" class="ltx_p"><span id="A4.SS3.p3.5.1" class="ltx_text">where the third equality is because of the influence function for the conditional outcome mean function (see Example 6 of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib33" title="" class="ltx_ref">Hines et al. 2022</a></cite>), the fourth equality is by <math id="A4.SS3.p3.m25" class="ltx_Math" alttext="S_{i}\;\mbox{$\perp\!\!\!\perp$}\;\bm{Y}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo lspace="0.558em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">S_{i}\;\mbox{$\perp\!\!\!\perp$}\;\bm{Y}_{i}</annotation></semantics></math>, and the second and eighth equalities are by <math id="A4.SS3.p3.m26" class="ltx_Math" alttext="\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \{T_{i},L_{i}\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0.778em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><mo fence="false">|</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \{T_{i},L_{i}\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS3.p4" class="ltx_para">
<p id="A4.SS3.p4.2" class="ltx_p"><span id="A4.SS3.p4.2.1" class="ltx_text">For the second component,</span></p>
<table id="A4.EGx55" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex88.m1" class="ltx_Math" alttext="\displaystyle\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y}\mid\bm{z},T_{i}=t)\biggl|_{\epsilon=0}f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mrow><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒛</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y}\mid\bm{z},T_{i}=t)\biggl|_{\epsilon=0}f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
