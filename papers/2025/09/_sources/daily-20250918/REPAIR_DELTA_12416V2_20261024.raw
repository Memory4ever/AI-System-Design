retchy="true">‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\biggl|\biggl|\frac{\partial\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta,\Psi_{t})}{\partial\Psi_{t}}-\frac{\partial\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta,\Psi_{t}^{*})}{\partial\Psi_{t}}\biggr|\biggr|_{2}</annotation></semantics></math></td>
