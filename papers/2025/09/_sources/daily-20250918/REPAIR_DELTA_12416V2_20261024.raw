"2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\mathbb{E}\biggl[\biggl|\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
