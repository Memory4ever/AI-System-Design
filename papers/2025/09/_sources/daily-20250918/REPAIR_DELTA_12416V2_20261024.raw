<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex94.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbbm{1}\{T_{i}=t\}\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\mathbbm{1}\{\bm{y}=\bm{\tilde{y}}\}-f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\}\biggr)\mathbbm{1}\{\bm{z}=\tilde{\bm{z}}\}\frac{f_{\mathcal{P}}(\bm{z})}{f_{\mathcal{P}}(\bm{z},T_{i}=t)}d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo stretchy="false">}</mo></mrow><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒛</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">}</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>d</mi><mi>𝒚</mi><mi>d</mi><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbbm{1}\{T_{i}=t\}\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\mathbbm{1}\{\bm{y}=\bm{\tilde{y}}\}-f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\}\biggr)\mathbbm{1}\{\bm{z}=\tilde{\bm{z}}\}\frac{f_{\mathcal{P}}(\bm{z})}{f_{\mathcal{P}}(\bm{z},T_{i}=t)}d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex95.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{T_{i}=t\}}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(m_{\mathcal{P}}(\tilde{\bm{y}},\tilde{\bm{z}})-\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\tilde{\bm{z}})f_{\mathcal{P}}(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{T_{i}=t\}}{\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})}\biggl(m_{\mathcal{P}}(\tilde{\bm{y}},\tilde{\bm{z}})-\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\tilde{\bm{z}})f_{\mathcal{P}}(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p4.3" class="ltx_p"><span id="A4.SS3.p4.3.1" class="ltx_text">where the fourth line is by Example 2 of <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib33" title="" class="ltx_ref">Hines et al. (2022)</a></cite></span></p>
<table id="A4.EGx56" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex96.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y},\bm{z},T_{i}=t)|_{\epsilon=0}" display="inline" intent=":literal"><semantics><msub><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><annotation encoding="application/x-tex">\displaystyle\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y},\bm{z},T_{i}=t)|_{\epsilon=0}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex96.m2" class="ltx_Math" alttext="\displaystyle=\frac{d}{d\epsilon}\biggl(\epsilon\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}+(1-\epsilon)f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\bigg)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{d}{d\epsilon}\biggl(\epsilon\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}+(1-\epsilon)f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\bigg)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex97.m1" class="ltx_Math" alttext="\displaystyle=\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}-f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}},T_{i}=t\}-f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p4.4" class="ltx_p"><span id="A4.SS3.p4.4.1" class="ltx_text">Finally, for the last component,</span></p>
<table id="A4.EGx57" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex98.m1" class="ltx_Math" alttext="\displaystyle\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\frac{d}{d\epsilon}\,f_{\mathcal{P}_{\epsilon}}(\bm{z})\biggl|_{\epsilon=0}d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mrow><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>f</mi><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒛</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\frac{d}{d\epsilon}\,f_{\mathcal{P}_{\epsilon}}(\bm{z})\biggl|_{\epsilon=0}d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex99.m1" class="ltx_math_unparsed" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})dF_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\biggl(\mathbbm{1}\{\bm{z}=\tilde{\bm{z}}\}-f_{\mathcal{P}}(\bm{z})\biggr)d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><msub><mi>F</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒛</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">}</mo></mrow><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mi>d</mi><mi>𝒚</mi><mi>d</mi><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})dF_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)\biggl(\mathbbm{1}\{\bm{z}=\tilde{\bm{z}}\}-f_{\mathcal{P}}(\bm{z})\biggr)d\bm{y}d\bm{z}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex100.m1" class="ltx_Math" alttext="\displaystyle=\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})f_{\mathcal{P}}(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)d\bm{y}-\Psi_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><msub><mi>m</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})f_{\mathcal{P}}(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)d\bm{y}-\Psi_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p4.5" class="ltx_p"><span id="A4.SS3.p4.5.1" class="ltx_text">Therefore,</span></p>
<table id="A4.EGx58" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex101.m1" class="ltx_Math" alttext="\displaystyle\frac{d}{d\epsilon}\Psi_{t}(\mathcal{P}_{\epsilon})\biggl|_{\epsilon=0}=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\tilde{\bm{y}}),\tilde{\bm{z}})}{\pi_{t}(\tilde{\bm{z}})}\biggl(\tilde{l}-m(\tilde{\bm{y}},\tilde{\bm{z}})\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\tilde{\bm{z}})}\biggl(m(\tilde{\bm{y}},\tilde{\bm{z}})-\bar{m}_{t}(\tilde{z})\biggr)+\bar{m}_{t}(\tilde{z})-\Psi_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>0</mn></mrow></msub><mo>=</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mover accent="true"><mi>l</mi><mo>~</mo></mover><mo>−</mo><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>z</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>z</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{d}{d\epsilon}\Psi_{t}(\mathcal{P}_{\epsilon})\biggl|_{\epsilon=0}=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\tilde{\bm{y}}),\tilde{\bm{z}})}{\pi_{t}(\tilde{\bm{z}})}\biggl(\tilde{l}-m(\tilde{\bm{y}},\tilde{\bm{z}})\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\tilde{\bm{z}})}\biggl(m(\tilde{\bm{y}},\tilde{\bm{z}})-\bar{m}_{t}(\tilde{z})\biggr)+\bar{m}_{t}(\tilde{z})-\Psi_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p4.6" class="ltx_p"><span id="A4.SS3.p4.6.1" class="ltx_text">where</span></p>
<table id="A4.EGx59" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex102.m1" class="ltx_Math" alttext="\displaystyle\pi_{t}(\tilde{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{t}(\tilde{\bm{z}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex102.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}(T_{i}=t\mid\bm{Z}_{i}=\tilde{\bm{z}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex103.m1" class="ltx_Math" alttext="\displaystyle\rho_{t}(\bm{f}(\tilde{\bm{y}},\tilde{\bm{z}}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\rho_{t}(\bm{f}(\tilde{\bm{y}},\tilde{\bm{z}}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex103.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i})=\bm{f}(\tilde{\bm{y}},\tilde{\bm{z}}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i})=\bm{f}(\tilde{\bm{y}},\tilde{\bm{z}}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex104.m1" class="ltx_Math" alttext="\displaystyle\bar{m}_{t}(\tilde{\bm{z}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bar{m}_{t}(\tilde{\bm{z}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex104.m2" class="ltx_Math" alttext="\displaystyle=\int_{\mathcal{Y}}m(\bm{y},\tilde{\bm{z}})f(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)d\bm{y}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><mrow><mi>m</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Y}}m(\bm{y},\tilde{\bm{z}})f(\bm{y}\mid\bm{Z}_{i}=\tilde{\bm{z}},T_{i}=t)d\bm{y}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p4.7" class="ltx_p"><span id="A4.SS3.p4.7.1" class="ltx_text">Because <math id="A4.SS3.p4.m1" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math> and <math id="A4.SS3.p4.m2" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math> are assumed to be binary, the variance of indicator function is bounded and thus its variance is finite, meaning that the estimand is pathwise differentiable. Hence, the influence function is given by</span></p>
<table id="A4.E7" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E7X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E7X.m2" class="ltx_Math" alttext="\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i};\bm{f},\mu,\pi_{t},\rho_{t},\bar{m}_{t},\Psi_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><mi>μ</mi><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ρ</mi><mi>t</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i};\bm{f},\mu,\pi_{t},\rho_{t},\bar{m}_{t},\Psi_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(S7)</span></td></tr>
<tr id="A4.E7Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E7Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="4.278em">=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo mathsize="2.100em">,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E7Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E7Xb.m2" class="ltx_Math" alttext="\displaystyle+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.SS3.p5" class="ltx_para ltx_noindent">
<p id="A4.SS3.p5.1" class="ltx_p"><span id="A4.SS3.p5.1.1" class="ltx_text ltx_font_bold">STEP 2: Deriving Efficient Influence Function</span>: Since the model is semiparametric due to the independence constraint, the derivation of efficient influence function requires the projection onto the tangent space. Therefore, based on the previous step, I then confirm if the influence function derived in the previous step is an efficient influence function or not. Let <math id="A4.SS3.p5.m1" class="ltx_Math" alttext="O_{i}=\{S_{i},T_{i},\bm{Y}_{i},\bm{Z}_{i}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>O</mi><mi>i</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">O_{i}=\{S_{i},T_{i},\bm{Y}_{i},\bm{Z}_{i}\}</annotation></semantics></math> be the observed data. Now, the full data distribution is factorized into</p>
<table id="A4.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex105.m1" class="ltx_Math" alttext="\displaystyle f(T_{i},\bm{Y}_{i},\bm{Z}_{i},S_{i})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f(T_{i},\bm{Y}_{i},\bm{Z}_{i},S_{i})</annotation></semantics></math></td>
