<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex331.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\leq 1)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\leq 1)=1</annotation></semantics></math></td>
