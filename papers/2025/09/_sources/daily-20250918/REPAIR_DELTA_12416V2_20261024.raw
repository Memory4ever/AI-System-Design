ht:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.18" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="48.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F1.pic1.3" class="ltx_text ltx_font_bold">Step 3</span>:</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.79)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:8.63em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="119.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">Check Assumptions</span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 34.86)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:17.36em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="240.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">(Conditional Independence / Accuracy)</span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#E6E6FF;" fill="#E6E6FF"><path d="M 113.77 -267.41 L -113.77 -267.41 C -116.83 -267.41 -119.31 -269.89 -119.31 -272.94 L -119.31 -320.93 C -119.31 -323.99 -116.83 -326.46 -113.77 -326.46 L 113.77 -326.46 C 116.83 -326.46 119.31 -323.99 119.31 -320.93 L 119.31 -272.94 C 119.31 -269.89 116.83 -267.41 113.77 -267.41 Z M -119.31 -326.46"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -114.69 -311.29)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 34.09)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.79)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 21.79)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 9.49)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 90.56 0)"><foreignObject style="--ltx-fo-width:3.49em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.18" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="48.27"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A2.F1.pic1.4" class="ltx_text ltx_font_bold">Step 4</span>:</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.79)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:16.55em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="229.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">Ask human coders to code more texts</span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 31.4)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 16.74 0)"><foreignObject style="--ltx-fo-width:14.13em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="195.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">and perform statistical inference</span></span></foreignObject></g></g></g></g><g style="--ltx-fill-color:#E6E6FF;" fill="#E6E6FF"><path d="M 389.91 -267.41 L 204.13 -267.41 C 201.08 -267.41 198.6 -269.89 198.6 -272.94 L 198.6 -320.93 C 198.6 -323.99 201.08 -326.46 204.13 -326.46 L 389.91 -326.46 C 392.97 -326.46 395.45 -323.99 395.45 -320.93 L 395.45 -272.94 C 395.45 -269.89 392.97 -267.41 389.91 -267.41 Z M 198.6 -326.46"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 226.86 -306.54)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 24.6)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 9.61)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:10.09em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="139.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">Update the coding rule</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.91)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 3.67 0)"><foreignObject style="--ltx-fo-width:9.64em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="133.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">and go back to Step 1</span></span></foreignObject></g></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -29.8 L 0 -63.21"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 0 -60.04)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -128.78 L 0 -162.19"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 0 -159.02)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 0 -227.76 L 0 -261.17"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 0 -258)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF"><path style="stroke:none" d="M 0.55 -263.01 h 116.31 v 31.13 h -116.31 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 5.17 -258.4)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 21.91)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 9.61)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:7.74em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="107.08"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">If all assumptions</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.91)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 17.51 0)"><foreignObject style="--ltx-fo-width:5.21em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="72.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">are satisfied</span></span></foreignObject></g></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 125.21 -197.96 L 297.02 -197.96 L 297.02 -261.17"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.0 -1.0 1.0 0.0 297.02 -258)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF"><path style="stroke:none" d="M 162.57 -197.4 h 97.09 v 31.13 h -97.09 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 167.19 -192.79)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 21.91)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 9.61)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:6.35em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="87.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">If assumptions</span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 21.91)"><g class="ltx_tikzmatrix_col ltx_nopad_r" transform="matrix(1 0 0 -1 8.36 0)"><foreignObject style="--ltx-fo-width:5.14em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="71.15"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">are violated</span></span></foreignObject></g></g></g></g></g><g stroke-width="0.8pt"><path style="fill:none" d="M 395.73 -296.94 L 435.1 -296.94 L 435.1 -296.94 L 435.1 0 L 138.36 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 141.53 0)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F1.3" class="ltx_text" style="font-size:90%;">Figure S1</span>: </span><span id="A2.F1.4" class="ltx_text" style="font-size:90%;">Workflow for the applied researchers to create the coding rule and the labeled data with multiple human coders. To test the conditional independence assumption (Assumption <a href="#Thmassumption7" title="Assumption 7 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) in Step 3, the conditional permutation test is used. See the main text for the specific procedure.</span></figcaption>
</figure>
<div id="A2.p2" class="ltx_para">
<p id="A2.p2.1" class="ltx_p">To mitigate this limitation, I propose a procedure that uses a limited number of true, gold-standard labels <math id="A2.p2.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> and permutation tests to evaluate these assumptions. All procedures are illustrated in Figure <a href="#A2.F1" title="Figure S1 ‣ Appendix S2 How to test assumptions in Section that are not guaranteed by design ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S1</span></a>. The proposed procedure comprises four steps. First, researchers develop their own coding rule and apply it to code a small number of texts themselves. I assume that researchers can generate a tiny set of gold-standard labels that perfectly capture <math id="A2.p2.m2" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> for these texts. Given that researchers should have a clear understanding of the classification task, it is reasonable to posit that they can produce error-free labels for a small number of observations, such as 100 texts, although scaling this process without permitting errors is challenging. Second, researchers ask multiple human coders to annotate the texts.</p>
</div>
<div id="A2.p3" class="ltx_para">
<p id="A2.p3.1" class="ltx_p">Upon obtaining the researcher-annotated gold-standard labels <math id="A2.p3.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> and the human-annotated labels <math id="A2.p3.m2" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}</annotation></semantics></math> for the tiny subset of observations, researchers can then verify all the problematic assumptions. For Assumption <a href="#Thmassumption8" title="Assumption 8 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a> (a) (human label accuracy), researchers can verify each conditional probability and check if the assumptions are valid or not. For Assumption <a href="#Thmassumption7" title="Assumption 7 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> (independent coding and exclusion restriction), I propose to use permutation tests to diagnose the independence constraints. Permutation tests are nonparametric statistical methods that are particularly advantageous and commonly utilized when dealing with a small number of observations, as conventional statistical tests often exhibit insufficient power in such scenarios (e.g., <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib22" title="" class="ltx_ref">Good 1994</a>; <a href="#bib.bib23" title="" class="ltx_ref">Ojala and Garriga 2009</a>; <a href="#bib.bib71" title="" class="ltx_ref">Pesarin and Salmaso 2010</a>; <a href="#bib.bib10" title="" class="ltx_ref">Berrett et al. 2019</a></cite>). By default, the null hypothesis of the permutation test is independence, and thus I use test of equivalence so that the independence is directly tested (e.g. <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib72" title="" class="ltx_ref">Wellek 2002</a>; <a href="#bib.bib42" title="" class="ltx_ref">Hartman and Hidalgo 2018</a></cite>). The proposed procedure is based on <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib11" title="" class="ltx_ref">Arboretti et al. (2018)</a></cite>, which formalized the permutation test for test of equivalence.</p>
</div>
<div id="A2.p4" class="ltx_para">
<p id="A2.p4.1" class="ltx_p">Formally, to directly evaluate the conditional independence specified in Assumption <a href="#Thmassumption7" title="Assumption 7 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, the objective of the test is to evaluate the following null and alternative hypotheses:</p>
<table id="A2.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex32.m1" class="ltx_Math" alttext="\displaystyle H_{0}:\tilde{L}^{(1)}_{i}\ \not\!\perp\!\!\!\perp\tilde{L}^{(2)}_{i}\ \mid\ L_{i}\quad\text{or}\quad\bm{Y}_{i}\ \not\!\perp\!\!\!\perp\ \{\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i}\}\ \mid\ L_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mn>0</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><menclose notation="updiagonalstrike"><mspace style="width:-0.17em;" width="-0.17em"></mspace></menclose></mrow><mpadded style="width:0.518em;" width="0.518em"><mo>⟂</mo></mpadded><mphantom></mphantom><mo>⟂</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo fence="false">|</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mspace style="width:1em;" width="1em"></mspace><mtext>or</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><menclose notation="updiagonalstrike"><mspace style="width:-0.17em;" width="-0.17em"></mspace></menclose></mrow><mpadded style="width:0.518em;" width="0.518em"><mo>⟂</mo></mpadded><mphantom></mphantom><mo rspace="0.778em">⟂</mo><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.500em" stretchy="false">}</mo></mrow></mrow><mo fence="false">|</mo><msub><mi>L</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{0}:\tilde{L}^{(1)}_{i}\ \not\!\perp\!\!\!\perp\tilde{L}^{(2)}_{i}\ \mid\ L_{i}\quad\text{or}\quad\bm{Y}_{i}\ \not\!\perp\!\!\!\perp\ \{\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i}\}\ \mid\ L_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex33.m1" class="ltx_Math" alttext="\displaystyle H_{1}:\tilde{L}^{(1)}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \ \tilde{L}^{(2)}_{i}\ \mid\ L_{i}\quad\text{and}\quad\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \{\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i}\}\ \mid\ L_{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>H</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo fence="false">|</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo rspace="0.500em" stretchy="false">}</mo></mrow></mrow><mo fence="false">|</mo><msub><mi>L</mi><mi>i</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle H_{1}:\tilde{L}^{(1)}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \ \tilde{L}^{(2)}_{i}\ \mid\ L_{i}\quad\text{and}\quad\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \{\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i}\}\ \mid\ L_{i}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.p4.2" class="ltx_p">To use the permutation test for conditional independence, since <math id="A2.p4.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> is categorical, I can simply permute the observations within each stratum defined by <math id="A2.p4.m2" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> to nonparametrically assess conditional independence <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib10" title="" class="ltx_ref">Berrett et al., 2019</a>)</cite>. For exclusion restriction, due to the high dimensionality of <math id="A2.p4.m3" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒀</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math>, it is necessary to employ a scalar measure of statistical independence, such as the kernel-based measure proposed by <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib38" title="" class="ltx_ref">Gretton et al. (2012)</a></cite> or the correlational distance proposed by <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib21" title="" class="ltx_ref">Székely et al. (2007)</a></cite>, to construct the test statistic. The entire testing procedure is as follows:</p>
<ol id="A2.I1" class="ltx_enumerate">
<li id="A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A2.I1.i1.p1" class="ltx_para">
<p id="A2.I1.i1.p1.1" class="ltx_p"><span id="A2.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Defining Equivalence Range</span>: Define the equivalence margin <math id="A2.I1.i1.p1.m1" class="ltx_Math" alttext="\delta\in\mathbb{R}^{+}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><msup><mi>ℝ</mi><mo>+</mo></msup></mrow><annotation encoding="application/x-tex">\delta\in\mathbb{R}^{+}</annotation></semantics></math>, which specifies the range within which the difference is considered inconsequential.</p>
</div></li>
<li id="A2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A2.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i2.p1.1" class="ltx_p"><span id="A2.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Stratification</span>: Stratify the labeled data based on the values of <math id="A2.I1.i2.p1.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math>, creating strata for each possible value. Let <math id="A2.I1.i2.p1.m2" class="ltx_Math" alttext="I_{l}=\{i:L_{i}=l\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mi>l</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>l</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">I_{l}=\{i:L_{i}=l\}</annotation></semantics></math> denote the set of indices for each stratum.</p>
</div></li>
<li id="A2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A2.I1.i3.p1" class="ltx_para">
<p id="A2.I1.i3.p1.1" class="ltx_p">For each stratum <math id="A2.I1.i3.p1.m1" class="ltx_Math" alttext="L_{i}=l" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">L_{i}=l</annotation></semantics></math> with <math id="A2.I1.i3.p1.m2" class="ltx_Math" alttext="l\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">l\in\mathcal{L}</annotation></semantics></math>,</p>
<ol id="A2.I1.i3.I1" class="ltx_enumerate">
<li id="A2.I1.i3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="A2.I1.i3.I1.i1.p1" class="ltx_para">
<p id="A2.I1.i3.I1.i1.p1.1" class="ltx_p"><span id="A2.I1.i3.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Computing Test Statistic</span>: Compute the test statistic by</p>
<table id="A2.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex34.m1" class="ltx_Math" alttext="\displaystyle T_{l1}=\max\{0,d(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-\delta\}\quad\text{and}\quad T_{l2}=\max\{0,d(\bm{Y}_{i},\{\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)}\})-\delta\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msub><mi>T</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T_{l1}=\max\{0,d(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-\delta\}\quad\text{and}\quad T_{l2}=\max\{0,d(\bm{Y}_{i},\{\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)}\})-\delta\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I1.i3.I1.i1.p1.2" class="ltx_p">where <math id="A2.I1.i3.I1.i1.p1.m1" class="ltx_Math" alttext="d(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(\cdot,\cdot)</annotation></semantics></math> is any user-chosen measure for statistical independence.</p>
</div></li>
<li id="A2.I1.i3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="A2.I1.i3.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i3.I1.i2.p1.1" class="ltx_p"><span id="A2.I1.i3.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Permutation</span>: For <math id="A2.I1.i3.I1.i2.p1.m1" class="ltx_Math" alttext="b=1,\cdots,B" display="inline" intent=":literal"><semantics><mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">b=1,\cdots,B</annotation></semantics></math> (where <math id="A2.I1.i3.I1.i2.p1.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> is the maximum number of permutations),</p>
<ul id="A2.I1.i3.I1.i2.I1" class="ltx_itemize">
<li id="A2.I1.i3.I1.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i3.I1.i2.I1.i1.p1" class="ltx_para">
<p id="A2.I1.i3.I1.i2.I1.i1.p1.1" class="ltx_p">Randomly permute the pair <math id="A2.I1.i3.I1.i2.I1.i1.p1.m1" class="ltx_Math" alttext="\{\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)}\}</annotation></semantics></math> within each strata</p>
</div></li>
<li id="A2.I1.i3.I1.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i3.I1.i2.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i3.I1.i2.I1.i2.p1.1" class="ltx_p">Compute test statistic with the permuted sample, denoted as <math id="A2.I1.i3.I1.i2.I1.i2.p1.m1" class="ltx_Math" alttext="T_{l1}^{(b)}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">T_{l1}^{(b)}</annotation></semantics></math> and <math id="A2.I1.i3.I1.i2.I1.i2.p1.m2" class="ltx_Math" alttext="T_{l2}^{(b)}" display="inline" intent=":literal"><semantics><msubsup><mi>T</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">T_{l2}^{(b)}</annotation></semantics></math></p>
</div></li>
</ul>
</div></li>
</ol>
</div></li>
<li id="A2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="A2.I1.i4.p1" class="ltx_para">
<p id="A2.I1.i4.p1.1" class="ltx_p"><span id="A2.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Aggregation</span>: Aggregate the test statistic over all strata by</p>
<table id="A2.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex35.m1" class="ltx_Math" alttext="\displaystyle T=\max_{j\in\{1,2\}}\max_{l\in\mathcal{L}}T_{jl},\quad\text{and}\quad T^{(b)}=\max_{j\in\{1,2\}}\max_{l\in\mathcal{L}}T^{(b)}_{jl}\quad\text{for each}\ \ b\in\{1,\cdots,B\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>=</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></munder><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>l</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>T</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><mtext>and</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><msup><mi>T</mi><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mrow><munder><mi>max</mi><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></munder><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>l</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msubsup><mi>T</mi><mrow><mi>j</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>for each</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mi>b</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>B</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle T=\max_{j\in\{1,2\}}\max_{l\in\mathcal{L}}T_{jl},\quad\text{and}\quad T^{(b)}=\max_{j\in\{1,2\}}\max_{l\in\mathcal{L}}T^{(b)}_{jl}\quad\text{for each}\ \ b\in\{1,\cdots,B\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">5.</span> 
<div id="A2.I1.i5.p1" class="ltx_para">
<p id="A2.I1.i5.p1.1" class="ltx_p"><span id="A2.I1.i5.p1.1.1" class="ltx_text ltx_font_bold">Calculating Monte Carlo p-value</span>: Calculate the Monte Carlo p-value by</p>
<table id="A2.EGx33" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex36.m1" class="ltx_Math" alttext="\displaystyle p=\frac{1+\sum_{b=1}^{B}\mathbbm{1}\{T^{(b)}\leq T\}}{B+1}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo rspace="0.055em">+</mo><mo>∑</mo><msub><mrow></mrow><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>B</mi></msup><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></msup><mo>≤</mo><mi>T</mi><mo stretchy="false">}</mo></mrow><mrow><mi>B</mi><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle p=\frac{1+\sum_{b=1}^{B}\mathbbm{1}\{T^{(b)}\leq T\}}{B+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="A2.p4.3" class="ltx_p">Regarding the implementation of this test procedure, the following two points need to be considered. First, the standard representation of texts <math id="A2.p4.m4" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒀</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math> is typically still too high‑dimensional, so the permutation test can be underpowered unless researchers have a large number of true, gold-standard labels. In practice, researchers may therefore benefit from applying dimension‑reduction techniques that preserve most of the variation in the data and then applying the proposed procedure. Second, the testing procedure is sensitive to the choice of equivalence margin: the larger the margin, the more likely researchers are to reject the null hypothesis. If researchers cannot choose the equivalence margin ex ante on the basis of substantive knowledge, they may instead focus on the equivalence interval, the smallest margin that would lead to rejection of the null hypothesis at the pre‑specified significance level, which is insensitive to the researcher’s choice of equivalence range <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib42" title="" class="ltx_ref">Hartman and Hidalgo, 2018</a>; <a href="#bib.bib47" title="" class="ltx_ref">Hartman, 2021</a>)</cite>.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix S3 </span>Extension: Use of Machine Learning Predictions</h2>

<div id="A3.p1" class="ltx_para">
<p id="A3.p1.1" class="ltx_p">In many applications, researchers already have access to machine-learning predictions of the text feature of interest <math id="A3.p1.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math>. With the advent of large language models, such predictions are increasingly inexpensive to obtain at scale. However, the baseline SRI procedure described in the main text relies exclusively on human annotations and therefore does not directly exploit these auxiliary predictions.</p>
</div>
<div id="A3.p2" class="ltx_para">
<p id="A3.p2.1" class="ltx_p">This section extends the estimation procedure to incorporate all available information, including machine-learning predictions. The proposed extension does not alter the estimand or the identification strategy, but is designed to more effectively exploit the full set of observations using these predictions.</p>
</div>
<div id="A3.p3" class="ltx_para">
<p id="A3.p3.2" class="ltx_p">Suppose that, in addition to the setup described in the main text, I observe machine-learning predictions of <math id="A3.p3.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> for all units, denoted as <math id="A3.p3.m2" class="ltx_Math" alttext="\hat{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\hat{L}_{i}</annotation></semantics></math>, for the entire observations. I propose estimating the surrogate representations <math id="A3.p3.m3" class="ltx_Math" alttext="\bm{W}_{i}=\bm{f}(\bm{Y}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{i}=\bm{f}(\bm{Y}_{i})</annotation></semantics></math> using the same neural network architecture as before but with the following modified loss function:</p>
<table id="A3.E1" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E1X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E1X.m2" class="ltx_Math" alttext="\displaystyle\arg\min_{\xi,\lambda,\zeta}\frac{1}{n}" display="inline" intent=":literal"><semantics><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><munder><mi>min</mi><mrow><mi>ξ</mi><mo>,</mo><mi>λ</mi><mo>,</mo><mi>ζ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\arg\min_{\xi,\lambda,\zeta}\frac{1}{n}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E1X.m3" class="ltx_Math" alttext="\displaystyle\sum_{i=1}^{n}\biggl\{\underbrace{\biggl(\overbrace{\mu(\bm{f}(\bm{Y}_{i};\xi),\bm{Z}_{i};\lambda)}^{\text{Outcome Model}}-\bigl(\hat{L}_{i}+\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(\tilde{L}_{i}-\hat{L}_{i})\bigr)\biggr)^{2}}_{\text{Outcome Loss}}\" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">{</mo><munder accentunder="true"><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mover><mover accent="true"><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏞</mo></mover><mtext>Outcome Model</mtext></mover><mo>−</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>S</mi><mi>i</mi></msub><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mn>2</mn></msup><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mtext>Outcome Loss</mtext></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i=1}^{n}\biggl\{\underbrace{\biggl(\overbrace{\mu(\bm{f}(\bm{Y}_{i};\xi),\bm{Z}_{i};\lambda)}^{\text{Outcome Model}}-\bigl(\hat{L}_{i}+\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(\tilde{L}_{i}-\hat{L}_{i})\bigr)\biggr)^{2}}_{\text{Outcome Loss}}\</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(S1)</span></td></tr>
<tr id="A3.E1Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E1Xa.m2" class="ltx_Math" alttext="\displaystyle+\ \alpha\cdot\underbrace{\mathrm{CrossEntropy}\biggl(T_{i},\overbrace{\rho_{1}(\bm{f}(\bm{Y}_{i};\xi),\bm{Z}_{i};\zeta)}^{\text{Surrogacy Score}}\biggr)}_{\text{Prediction Loss for Predictor $T_{i}$}}\biggr\}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.722em">+</mo><mi>α</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><munder accentunder="true"><mrow><mi>CrossEntropy</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><mover><mover accent="true"><mrow><msub><mi>ρ</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏞</mo></mover><mtext>Surrogacy Score</mtext></mover><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mtext>Prediction Loss for Predictor </mtext><msub><mi mathsize="0.700em">T</mi><mi mathsize="0.700em">i</mi></msub></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\ \alpha\cdot\underbrace{\mathrm{CrossEntropy}\biggl(T_{i},\overbrace{\rho_{1}(\bm{f}(\bm{Y}_{i};\xi),\bm{Z}_{i};\zeta)}^{\text{Surrogacy Score}}\biggr)}_{\text{Prediction Loss for Predictor $T_{i}$}}\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p3.3" class="ltx_p">where <math id="A3.p3.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is the hyperparameter.
The key departure from the original loss in Equation (<a href="#S3.E4" title="In 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) is the replacement of the human annotation <math id="A3.p3.m5" class="ltx_Math" alttext="\tilde{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{L}_{i}</annotation></semantics></math> with the augmented outcome <math id="A3.p3.m6" class="ltx_Math" alttext="\hat{L}_{i}+\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(\tilde{L}_{i}-\hat{L}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>+</mo><mrow><mfrac><msub><mi>S</mi><mi>i</mi></msub><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{L}_{i}+\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(\tilde{L}_{i}-\hat{L}_{i})</annotation></semantics></math>, which has been widely used in the missing-data literature <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib51" title="" class="ltx_ref">Robins et al., 1994</a>; <a href="#bib.bib59" title="" class="ltx_ref">Angelopoulos et al., 2023</a>; <a href="#bib.bib57" title="" class="ltx_ref">Egami et al., 2023</a>)</cite>.
Importantly, the surrogate representation <math id="A3.p3.m7" class="ltx_Math" alttext="\bm{f}(\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{f}(\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math> is learned under the same conditional independence constraints as in Section <a href="#S3" title="3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<div id="A3.p4" class="ltx_para">
<p id="A3.p4.1" class="ltx_p">The principal advantage of the proposed loss function is improved efficiency. Under the original loss in Equation (<a href="#S3.E4" title="In 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), the outcome model is trained only on the subset of units with human annotations (i.e., <math id="A3.p4.m1" class="ltx_Math" alttext="S_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S_{i}=1</annotation></semantics></math>), which may be insufficient to achieve the desired convergence rate in Assumption <a href="#Thmassumption4" title="Assumption 4 (Regularity Conditions) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> when the annotated sample is small. In contrast, the augmented outcome is available for all units, allowing the modified loss in Equation (<a href="#A3.E1" title="In Appendix S3 Extension: Use of Machine Learning Predictions ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S1</span></a>) to leverage the full sample. Consequently, as long as the machine-learning predictions <math id="A3.p4.m2" class="ltx_Math" alttext="\hat{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\hat{L}_{i}</annotation></semantics></math> are informative about the human annotations <math id="A3.p4.m3" class="ltx_Math" alttext="\tilde{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{L}_{i}</annotation></semantics></math>, the proposed procedure yields efficiency gains relative to the baseline approach.</p>
</div>
<div id="A3.p5" class="ltx_para">
<p id="A3.p5.1" class="ltx_p">Because the outcome loss is modified, the influence function must be updated accordingly. The proposed influence function is</p>
<table id="A3.E2" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E2X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E2X.m2" class="ltx_Math" alttext="\displaystyle\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu,\pi_{t},\rho_{t},\bar{m}_{t},\Psi_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><mi>μ</mi><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ρ</mi><mi>t</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu,\pi_{t},\rho_{t},\bar{m}_{t},\Psi_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(S2)</span></td></tr>
<tr id="A3.E2Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E2Xa.m2" class="ltx_Math" alttext="\displaystyle=\psi_{t}(T_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})-\frac{S_{i}}{\mathbb{P}(S_{i}=1)}\biggl(\psi_{t}(T_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})-\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})\biggr)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>S</mi><mi>i</mi></msub><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\psi_{t}(T_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})-\frac{S_{i}}{\mathbb{P}(S_{i}=1)}\biggl(\psi_{t}(T_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})-\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})\biggr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p5.2" class="ltx_p">where</p>
<table id="A3.EGx34" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex37.m1" class="ltx_Math" alttext="\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex37.m2" class="ltx_Math" alttext="\displaystyle=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex38.m1" class="ltx_Math" alttext="\displaystyle\psi_{t}(T_{i},\hat{L}_{i},\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t}(T_{i},\hat{L}_{i},\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex38.m2" class="ltx_Math" alttext="\displaystyle=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\hat{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\hat{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p6" class="ltx_para">
<p id="A3.p6.1" class="ltx_p">Estimation proceeds exactly as in Section 3, except that the outcome loss is constructed using the augmented outcome in Equation (<a href="#A3.E1" title="In Appendix S3 Extension: Use of Machine Learning Predictions ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S1</span></a>). In particular, the surrogate representation <math id="A3.p6.m1" class="ltx_Math" alttext="\bm{f}(\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{f}(\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math>, the outcome model <math id="A3.p6.m2" class="ltx_Math" alttext="\mu(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu(\cdot)</annotation></semantics></math>, and the surrogacy score <math id="A3.p6.m3" class="ltx_Math" alttext="\rho_{t}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho_{t}(\cdot)</annotation></semantics></math> are jointly estimated using the same neural network architecture and cross-fitting scheme in Section <a href="#S3" title="3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>. The target parameter <math id="A3.p6.m4" class="ltx_Math" alttext="\Psi_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Psi_{t}</annotation></semantics></math> is then obtained by solving the estimating equation</p>
<table id="A3.EGx35" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E3.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{n}\sum_{k=1}^{K}\sum_{I(i)=k}\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\bm{f}}^{(-k)},\hat{\rho}_{t}^{(-k)},\hat{\pi}_{t}^{(-k)},\hat{\mu}^{(-k)},\hat{\bar{m}}_{t}^{(-k)},\hat{\Psi}_{t})=0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></munder></mstyle><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msup><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n}\sum_{k=1}^{K}\sum_{I(i)=k}\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\bm{f}}^{(-k)},\hat{\rho}_{t}^{(-k)},\hat{\pi}_{t}^{(-k)},\hat{\mu}^{(-k)},\hat{\bar{m}}_{t}^{(-k)},\hat{\Psi}_{t})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(S3)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p7" class="ltx_para">
<p id="A3.p7.1" class="ltx_p">Finally, the asymptotic normality of the proposed estimator is established under the following regularity conditions.</p>
</div>
<div id="Thmassumption9" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption9.2" class="ltx_text ltx_font_smallcaps">Assumption 9</span></span><span id="Thmassumption9.3" class="ltx_text ltx_font_smallcaps"> (Regularity conditions for augmented-outcome SRI)</span></h6>
<div id="Thmassumption9.p1" class="ltx_para">
<p id="Thmassumption9.p1.1" class="ltx_p"><span id="Thmassumption9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmassumption9.p1.m1" class="ltx_Math" alttext="\eta=(\bm{f},\mu,\pi_{t},\rho_{t},\bar{m}_{t})" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>𝐟</mi><mo>,</mo><mi>μ</mi><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ρ</mi><mi>t</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\eta=(\bm{f},\mu,\pi_{t},\rho_{t},\bar{m}_{t})</annotation></semantics></math> be a collection of nuisance functions, <math id="Thmassumption9.p1.m2" class="ltx_Math" alttext="\eta^{*}" display="inline" intent=":literal"><semantics><msup><mi>η</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\eta^{*}</annotation></semantics></math> be the probability limit of the estimated nuisance functions. Also, to differentiate the parameter <math id="Thmassumption9.p1.m3" class="ltx_Math" alttext="\Psi_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Psi_{t}</annotation></semantics></math> from the probability limit of the parameter of interest, let <math id="Thmassumption9.p1.m4" class="ltx_Math" alttext="\Psi_{t}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Ψ</mi><mi>t</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">\Psi_{t}^{*}</annotation></semantics></math> be the probability limit of the estimated target parameter <math id="Thmassumption9.p1.m5" class="ltx_Math" alttext="\hat{\Psi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\Psi}_{t}</annotation></semantics></math>.</span></p>
</div>
<div id="Thmassumption9.p2" class="ltx_para">
<p id="Thmassumption9.p2.1" class="ltx_p"><span id="Thmassumption9.p2.1.1" class="ltx_text ltx_font_italic">Assume that <math id="Thmassumption9.p2.m1" class="ltx_Math" alttext="\lVert\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\eta},\Psi_{t}^{*})-\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta,\Psi_{t}^{*})\rVert_{2}^{2}=o_{p}(1)" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo>,</mo><mover accent="true"><mi>η</mi><mo>^</mo></mover><mo>,</mo><msubsup><mi mathvariant="normal">Ψ</mi><mi>t</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo>,</mo><mi>η</mi><mo>,</mo><msubsup><mi mathvariant="normal">Ψ</mi><mi>t</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><mrow><msub><mi>o</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lVert\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\eta},\Psi_{t}^{*})-\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta,\Psi_{t}^{*})\rVert_{2}^{2}=o_{p}(1)</annotation></semantics></math> in each fold. Also, assume that <math id="Thmassumption9.p2.m2" class="ltx_Math" alttext="\mathbb{E}[\partial\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta,\Psi_{t}^{*})/\partial\Psi_{t}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo lspace="0em">∂</mo><mrow><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo>,</mo><mi>η</mi><mo>,</mo><msubsup><mi mathvariant="normal">Ψ</mi><mi>t</mi><mo>∗</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">/</mo><mrow><mo>∂</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\partial\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta,\Psi_{t}^{*})/\partial\Psi_{t}]</annotation></semantics></math> exists and there is a neighborhood <math id="Thmassumption9.p2.m3" class="ltx_Math" alttext="\mathcal{N}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒩</mi><annotation encoding="application/x-tex">\mathcal{N}</annotation></semantics></math> of <math id="Thmassumption9.p2.m4" class="ltx_Math" alttext="\Psi_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Psi_{t}</annotation></semantics></math> such that</span></p>
<ol id="A3.I1" class="ltx_enumerate">
<li id="A3.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="A3.I1.ix1.p1" class="ltx_para">
<p id="A3.I1.ix1.p1.1" class="ltx_p"><span id="A3.I1.ix1.p1.1.1" class="ltx_text ltx_font_italic">for each fold </span><math id="A3.I1.ix1.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="A3.I1.ix1.p1.1.2" class="ltx_text ltx_font_italic">, </span><math id="A3.I1.ix1.p1.m2" class="ltx_Math" alttext="\lVert\hat{\eta}^{(k)}-\eta^{*}\rVert_{2}=o_{p}(1)" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msup><mover accent="true"><mi>η</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>η</mi><mo>∗</mo></msup></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><mo>=</mo><mrow><msub><mi>o</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lVert\hat{\eta}^{(k)}-\eta^{*}\rVert_{2}=o_{p}(1)</annotation></semantics></math></p>
</div></li>
<li id="A3.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="A3.I1.ix2.p1" class="ltx_para">
<p id="A3.I1.ix2.p1.1" class="ltx_p"><span id="A3.I1.ix2.p1.1.1" class="ltx_text ltx_font_italic">for all </span><math id="A3.I1.ix2.p1.m1" class="ltx_Math" alttext="\lVert\hat{\eta}^{(k)}-\eta^{*}\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msup><mover accent="true"><mi>η</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>η</mi><mo>∗</mo></msup></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\lVert\hat{\eta}^{(k)}-\eta^{*}\rVert_{2}</annotation></semantics></math><span id="A3.I1.ix2.p1.1.2" class="ltx_text ltx_font_italic"> small enough, </span><math id="A3.I1.ix2.p1.m2" class="ltx_Math" alttext="\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta,\Psi_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>η</mi><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta,\Psi_{t})</annotation></semantics></math><span id="A3.I1.ix2.p1.1.3" class="ltx_text ltx_font_italic"> is differentiable in </span><math id="A3.I1.ix2.p1.m3" class="ltx_Math" alttext="\Psi_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Psi_{t}</annotation></semantics></math><span id="A3.I1.ix2.p1.1.4" class="ltx_text ltx_font_italic"> on </span><math id="A3.I1.ix2.p1.m4" class="ltx_Math" alttext="\mathcal{N}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒩</mi><annotation encoding="application/x-tex">\mathcal{N}</annotation></semantics></math><span id="A3.I1.ix2.p1.1.5" class="ltx_text ltx_font_italic"> with probability approaching one, and there are </span><math id="A3.I1.ix2.p1.m5" class="ltx_Math" alttext="C&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C&gt;0</annotation></semantics></math><span id="A3.I1.ix2.p1.1.6" class="ltx_text ltx_font_italic"> and </span><math id="A3.I1.ix2.p1.m6" class="ltx_Math" alttext="\delta(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta)</annotation></semantics></math><span id="A3.I1.ix2.p1.1.7" class="ltx_text ltx_font_italic"> such that, for </span><math id="A3.I1.ix2.p1.m7" class="ltx_Math" alttext="\Psi_{t}\in\mathcal{N}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><annotation encoding="application/x-tex">\Psi_{t}\in\mathcal{N}</annotation></semantics></math><span id="A3.I1.ix2.p1.1.8" class="ltx_text ltx_font_italic"> and </span><math id="A3.I1.ix2.p1.m8" class="ltx_Math" alttext="\lVert\hat{\eta}^{(k)}-\eta^{*}\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo fence="true" rspace="0em">∥</mo><mrow><msup><mover accent="true"><mi>η</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>η</mi><mo>∗</mo></msup></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\lVert\hat{\eta}^{(k)}-\eta^{*}\rVert_{2}</annotation></semantics></math><span id="A3.I1.ix2.p1.1.9" class="ltx_text ltx_font_italic"> small enough,</span></p>
