<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex233.m2" class="ltx_math_unparsed" alttext="\displaystyle=\int_{\mathcal{Y}}\mathbb{P}(\tilde{L}_{i}^{(j)}=l,T_{i}=t\mid L_{i},\bm{Z}_{i},\bm{Y}_{i})dF(\bm{Y}_{i}\mid L_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Y}}\mathbb{P}(\tilde{L}_{i}^{(j)}=l,T_{i}=t\mid L_{i},\bm{Z}_{i},\bm{Y}_{i})dF(\bm{Y}_{i}\mid L_{i},\bm{Z}_{i})</annotation></semantics></math></td>
