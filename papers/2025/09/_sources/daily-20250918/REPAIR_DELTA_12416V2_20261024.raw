mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒛</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}\biggl\{\frac{d}{d\epsilon}\int_{\mathcal{L}}lf_{\mathcal{P}_{\epsilon}}(l\mid\bm{y},\bm{z},S_{i}=1)dl\;\biggl|_{\epsilon=0}\biggr\}\,\,f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
