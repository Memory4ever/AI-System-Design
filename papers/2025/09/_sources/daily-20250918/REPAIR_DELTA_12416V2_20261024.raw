<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex324.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\mathbb{E}\biggl[\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl\{\mathbbm{1}\{L_{i}=c\}-\mathbbm{1}\{L_{i}=c\}\biggr\}\biggr]=0" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">{</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\mathbb{E}\biggl[\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl\{\mathbbm{1}\{L_{i}=c\}-\mathbbm{1}\{L_{i}=c\}\biggr\}\biggr]=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I2.i1.p1.2" class="ltx_p">where the third line is by the law of iterated expectation,
the sixth line is by Assumption <a href="#Thmassumption6" title="Assumption 6 (Noisy Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>,
and the last line is by the property of the surrogate outcomes and Assumption <a href="#Thmassumption1" title="Assumption 1 (True Coding Rule) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div></li>
<li id="A4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i2.p1" class="ltx_para">
<p id="A4.I2.i2.p1.1" class="ltx_p"><math id="A4.I2.i2.p1.m1" class="ltx_math_unparsed" alttext="\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]=0" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]=0</annotation></semantics></math>: Similarly,</p>
<table id="A4.EGx127" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex325"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex325.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex326"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex326.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">{</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex327"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex327.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\mathbb{E}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">{</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\mathbb{E}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex328"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex328.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\mathbb{E}\biggl[M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\mathbb{E}\biggl[M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex329"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex329.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\mathbb{E}\biggl[M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\mid\bm{Y}_{i}\biggr]=0" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\mathbb{E}\biggl[M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\mid\bm{Y}_{i}\biggr]=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
<p id="A4.SS7.p6.5" class="ltx_p"><span id="A4.SS7.p6.5.1" class="ltx_text">where the fourth line is by Assumptions <a href="#Thmassumption3" title="Assumption 3 (Human Annotation Sampling) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#Thmassumption5" title="Assumption 5 (Human Annotation Sampling) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, and the last line is the exact same logic as in the previous case.
∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A4.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">S4.8 </span>Proof of Theorem <a href="#Thmtheorem4" title="Theorem 4 (Asymptotic Normality) ‣ 4.2 Estimation and inference ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> (Asymptotic Normality)</h3>

<div id="A4.SS8.p1" class="ltx_para">
<p id="A4.SS8.p1.1" class="ltx_p">For this proof, I assume the following regularity conditions.</p>
</div>
<div id="Thmassumption10" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption10.2" class="ltx_text ltx_font_smallcaps">Assumption 10</span></span><span id="Thmassumption10.3" class="ltx_text ltx_font_smallcaps"> (Regularity Conditions)</span></h6>
<div id="Thmassumption10.p1" class="ltx_para">
<p id="Thmassumption10.p1.1" class="ltx_p"><span id="Thmassumption10.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmassumption10.p1.m1" class="ltx_Math" alttext="c_{1}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>1</mn></msub><annotation encoding="application/x-tex">c_{1}</annotation></semantics></math> be a positive constant and <math id="Thmassumption10.p1.m2" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math> be a sequence of positive constants approaching zero as the sample size <math id="Thmassumption10.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> increases.</span></p>
<ol id="A4.I3" class="ltx_enumerate">
<li id="A4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="A4.I3.i1.p1" class="ltx_para">
<p id="A4.I3.i1.p1.1" class="ltx_p"><span id="A4.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">(Positivity) There exists a fixed constant </span><math id="A4.I3.i1.p1.m1" class="ltx_Math" alttext="c_{2}\in(0,1/2]" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">c_{2}\in(0,1/2]</annotation></semantics></math><span id="A4.I3.i1.p1.1.2" class="ltx_text ltx_font_italic"> such that for all </span><math id="A4.I3.i1.p1.m2" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math></p>
<table id="A4.EGx128" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex330"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex330.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(c_{2}\leq\pi_{t}(\bm{Z}_{i})\leq 1-c_{2})=1,\quad\mathbb{P}(c_{2}\leq\hat{\pi}_{t}(\bm{Z}_{i})\leq 1-c_{2})=1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(c_{2}\leq\pi_{t}(\bm{Z}_{i})\leq 1-c_{2})=1,\quad\mathbb{P}(c_{2}\leq\hat{\pi}_{t}(\bm{Z}_{i})\leq 1-c_{2})=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I3.i1.p1.2" class="ltx_p"><span id="A4.I3.i1.p1.2.1" class="ltx_text ltx_font_italic">In addition, the estimated surrogacy score is also almost surely bounded so that</span></p>
<table id="A4.EGx129" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex331"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
