<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.p3.4" class="ltx_p"><span id="A4.SS5.p3.4.1" class="ltx_text">and by marginalizing over <math id="A4.SS5.p3.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math>,</span></p>
<table id="A4.EGx102" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex261"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex261.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(j)}=\tilde{L}^{(j^{\prime})}=l\mid\bm{Z}_{i},S_{i}=1)&gt;\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}^{(j)}=l^{\prime},\tilde{L}^{(j^{\prime})}=l\mid\bm{Z}_{i},S_{i}=1)." display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>l</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>≠</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></munder></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>l</mi><mo>′</mo></msup><mo>,</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>l</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(j)}=\tilde{L}^{(j^{\prime})}=l\mid\bm{Z}_{i},S_{i}=1)&gt;\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}^{(j)}=l^{\prime},\tilde{L}^{(j^{\prime})}=l\mid\bm{Z}_{i},S_{i}=1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.p3.5" class="ltx_p"><span id="A4.SS5.p3.5.1" class="ltx_text">These indicate the strong diagonal dominance, so <math id="A4.SS5.p3.m2" class="ltx_Math" alttext="\bm{A}^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{A}^{(j)}</annotation></semantics></math>, <math id="A4.SS5.p3.m3" class="ltx_Math" alttext="\bm{M}(t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{M}(t,\bm{Z}_{i})</annotation></semantics></math>, and <math id="A4.SS5.p3.m4" class="ltx_Math" alttext="\bm{M}(\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{M}(\bm{Z}_{i})</annotation></semantics></math> are all invertible. Thus, I can write</span></p>
<table id="A4.EGx103" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex262"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex262.m1" class="ltx_Math" alttext="\displaystyle\bm{M}(t,\bm{Z}_{i})\bm{M}(\bm{Z}_{i})^{-1}=\bm{A}^{(1)}\bm{D}(t,\bm{Z}_{i})(\bm{A}^{(1)})^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝑴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo>=</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{M}(t,\bm{Z}_{i})\bm{M}(\bm{Z}_{i})^{-1}=\bm{A}^{(1)}\bm{D}(t,\bm{Z}_{i})(\bm{A}^{(1)})^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex263"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex263.m1" class="ltx_Math" alttext="\displaystyle\bm{M}(\bm{Z}_{i})^{\scriptscriptstyle\mathsf{T}}\bm{M}(t,\bm{Z}_{i})^{-{\scriptscriptstyle\mathsf{T}}}=\bm{A}^{(2)}\bm{D}(t)(\bm{A}^{(2)})^{-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi mathsize="0.710em">𝖳</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑴</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi mathsize="0.710em">𝖳</mi></mrow></msup></mrow><mo>=</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑫</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{M}(\bm{Z}_{i})^{\scriptscriptstyle\mathsf{T}}\bm{M}(t,\bm{Z}_{i})^{-{\scriptscriptstyle\mathsf{T}}}=\bm{A}^{(2)}\bm{D}(t)(\bm{A}^{(2)})^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.p3.6" class="ltx_p"><span id="A4.SS5.p3.6.1" class="ltx_text">where <math id="A4.SS5.p3.m5" class="ltx_Math" alttext="X^{-{\scriptscriptstyle\mathsf{T}}}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mrow><mo>−</mo><mi mathsize="0.710em">𝖳</mi></mrow></msup><annotation encoding="application/x-tex">X^{-{\scriptscriptstyle\mathsf{T}}}</annotation></semantics></math> denotes the transpose and inverse of the matrix <math id="A4.SS5.p3.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>. Hence, I can use the standard eigenvalue decomposition to identify <math id="A4.SS5.p3.m7" class="ltx_Math" alttext="\bm{A}^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{A}^{(j)}</annotation></semantics></math> and <math id="A4.SS5.p3.m8" class="ltx_Math" alttext="\bm{D}(t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝑫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{D}(t,\bm{Z}_{i})</annotation></semantics></math> / <math id="A4.SS5.p3.m9" class="ltx_Math" alttext="\bm{D}(\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝑫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{D}(\bm{Z}_{i})</annotation></semantics></math> up to scale and permutation. In this case, however, for the scale, since the column of <math id="A4.SS5.p3.m10" class="ltx_Math" alttext="\bm{A}^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{A}^{(j)}</annotation></semantics></math> sums up to 1, the scale is fixed. The only problem is the permutation, but under Assumption <a href="#Thmassumption8" title="Assumption 8 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, it is guaranteed that the diagonal element of <math id="A4.SS5.p3.m11" class="ltx_Math" alttext="\bm{A}^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\bm{A}^{(j)}</annotation></semantics></math> is the largest and unique, which fixes the challenge of permutation. As a result, I can pinpoint <math id="A4.SS5.p3.m12" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)</annotation></semantics></math> and <math id="A4.SS5.p3.m13" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(2)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(2)}_{i}=l\mid L_{i}=c)</annotation></semantics></math>. Notice that I can also have</span></p>
<table id="A4.EGx104" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex264"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex264.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex265"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex265.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c,T_{i}=t,\bm{Z}_{i},S_{i}=1)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo rspace="0.500em" stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c,T_{i}=t,\bm{Z}_{i},S_{i}=1)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex266"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex266.m1" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c,T_{i}=t,\bm{Z}_{i})\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">)</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c,T_{i}=t,\bm{Z}_{i})\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex267"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex267.m1" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo>,</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.500em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex268"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex268.m1" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})\ \mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.500em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.500em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\ \mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})\ \mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.p3.7" class="ltx_p"><span id="A4.SS5.p3.7.1" class="ltx_text">where the second one is by Assumptions <a href="#Thmassumption3" title="Assumption 3 (Human Annotation Sampling) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> and <a href="#Thmassumption5" title="Assumption 5 (Human Annotation Sampling) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> (i.e., random sampling of human annotations), the third one is by exclusion restriction and conditional ignorability, the last one is by independent coding assumption. Hence, once <math id="A4.SS5.p3.m14" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)</annotation></semantics></math> and <math id="A4.SS5.p3.m15" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(2)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(2)}_{i}=l\mid L_{i}=c)</annotation></semantics></math> are obtained, I can insert them into the decomposition</span></p>
<table id="A4.E13" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E13X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E13X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E13X.m3" class="ltx_Math" alttext="\displaystyle=m\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mphantom></mphantom><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=m\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(S13)</span></td></tr>
<tr id="A4.E13Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E13Xa.m2" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\;\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})\;\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.280em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.280em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\;\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})\;\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.p3.8" class="ltx_p"><span id="A4.SS5.p3.8.1" class="ltx_text">and obtain <math id="A4.SS5.p3.m16" class="ltx_Math" alttext="\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})</annotation></semantics></math> and can obtain the quantity of interest, since</span></p>
<table id="A4.EGx105" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex269"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex269.m1" class="ltx_Math" alttext="\displaystyle\Psi_{t,c}=\int_{\mathcal{Z}}\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i})." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Psi_{t,c}=\int_{\mathcal{Z}}\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.p3.9" class="ltx_p"><span id="A4.SS5.p3.9.1" class="ltx_text">In matrix form, the factorization above is written as</span></p>
<table id="A4.EGx106" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex270"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex270.m1" class="ltx_Math" alttext="\displaystyle\bm{B}(t,\bm{Z}_{i})=\bm{A}^{(1)}\bm{\theta}(t,\bm{Z}_{i})\{\bm{A}^{(2)}\}^{\scriptscriptstyle\mathsf{T}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝑩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝜽</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">{</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mi mathsize="0.710em">𝖳</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{B}(t,\bm{Z}_{i})=\bm{A}^{(1)}\bm{\theta}(t,\bm{Z}_{i})\{\bm{A}^{(2)}\}^{\scriptscriptstyle\mathsf{T}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.p3.10" class="ltx_p"><span id="A4.SS5.p3.10.1" class="ltx_text">where</span></p>
<table id="A4.EGx107" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex271"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex271.m1" class="ltx_Math" alttext="\displaystyle\bm{B}(t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝑩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{B}(t,\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex271.m2" class="ltx_Math" alttext="\displaystyle=\begin{bmatrix}\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=0\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=C\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)\\
\vdots&amp;\ddots&amp;\vdots\\
\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=0\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=C\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=0\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=C\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)\\
\vdots&amp;\ddots&amp;\vdots\\
\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=0\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=C,\tilde{L}^{(2)}_{i}=C\mid T_{i}=t,\bm{Z}_{i},S_{i}=1)\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex272"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex272.m1" class="ltx_Math" alttext="\displaystyle\bm{\theta}(t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{\theta}(t,\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex272.m2" class="ltx_Math" alttext="\displaystyle=\mathrm{diag}([\mathbb{P}(L_{i}=0\mid T_{i}=t,\bm{Z}_{i}),\cdots,\mathbb{P}(L_{i}=C\mid T_{i}=t,\bm{Z}_{i})]^{\scriptscriptstyle\mathsf{T}})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>C</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><mi mathsize="0.710em">𝖳</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{diag}([\mathbb{P}(L_{i}=0\mid T_{i}=t,\bm{Z}_{i}),\cdots,\mathbb{P}(L_{i}=C\mid T_{i}=t,\bm{Z}_{i})]^{\scriptscriptstyle\mathsf{T}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.p3.11" class="ltx_p"><span id="A4.SS5.p3.11.1" class="ltx_text">Hence, I can identify <math id="A4.SS5.p3.m17" class="ltx_Math" alttext="\bm{\theta}(t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{\theta}(t,\bm{Z}_{i})</annotation></semantics></math> by</span></p>
<table id="A4.EGx108" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex273"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex273.m1" class="ltx_Math" alttext="\displaystyle\bm{\theta}(t,\bm{Z}_{i})=(\bm{A}^{(1)})^{-1}\bm{B}(t,\bm{Z}_{i})(\bm{A}^{(2)})^{-{\scriptscriptstyle\mathsf{T}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝜽</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝑩</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mi>𝑨</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi mathsize="0.710em">𝖳</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\bm{\theta}(t,\bm{Z}_{i})=(\bm{A}^{(1)})^{-1}\bm{B}(t,\bm{Z}_{i})(\bm{A}^{(2)})^{-{\scriptscriptstyle\mathsf{T}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS5.p3.12" class="ltx_p"><span id="A4.SS5.p3.12.1" class="ltx_text">∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A4.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">S4.6 </span>Theoretical Properties of Surrogate Outcome</h3>

<div id="A4.SS6.p1" class="ltx_para">
<p id="A4.SS6.p1.1" class="ltx_p">I start with proving Equations (<a href="#S4.E13" title="In 4.2 Estimation and inference ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>). Notice that</p>
<table id="A4.EGx109" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex274"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex274.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex275"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex275.m1" class="ltx_math_unparsed" alttext="\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mrow><mo lspace="0em" mathsize="2.100em" rspace="0em">)</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex276"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex276.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbbm{1}\{L_{i}=c\}\times\mathbbm{1}\{L_{i}=c\}=\mathbbm{1}\{L_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbbm{1}\{L_{i}=c\}\times\mathbbm{1}\{L_{i}=c\}=\mathbbm{1}\{L_{i}=c\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.p1.2" class="ltx_p">where the second equality is because when <math id="A4.SS6.p1.m1" class="ltx_Math" alttext="L_{i}\neq c" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">L_{i}\neq c</annotation></semantics></math>, each component becomes 0 (the numerator becomes 0), whereas when <math id="A4.SS6.p1.m2" class="ltx_Math" alttext="L_{i}=c" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">L_{i}=c</annotation></semantics></math> each component becomes 1, which means that each component can be represented as an indicator function. This means that <math id="A4.SS6.p1.m3" class="ltx_Math" alttext="M_{c}(\cdot,\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo rspace="0em">,</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{c}(\cdot,\cdot)</annotation></semantics></math> is an unbiased surrogate for the unobserved indicator function <math id="A4.SS6.p1.m4" class="ltx_math_unparsed" alttext="\mathbbm{1}\{L_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbbm{1}\{L_{i}=c\}</annotation></semantics></math> given the true label. As <math id="A4.SS6.p1.m5" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}</annotation></semantics></math> is observed for all <math id="A4.SS6.p1.m6" class="ltx_Math" alttext="j\in\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,2\}</annotation></semantics></math> and I can estimate the probability <math id="A4.SS6.p1.m7" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(j)}_{i}\mid L_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(j)}_{i}\mid L_{i})</annotation></semantics></math> as seen in the proof of Proposition <a href="#Thmproposition2" title="Proposition 2 (Identification without Perfect Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, <math id="A4.SS6.p1.m8" class="ltx_Math" alttext="M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})</annotation></semantics></math> is identifiable from the observed data. Also, notice that</p>
<table id="A4.EGx110" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex277"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex277.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i},\bm{Y}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i},\bm{Y}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex278"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex278.m1" class="ltx_math_unparsed" alttext="\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i},\bm{Y}_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i},\bm{Y}_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mrow><mo lspace="0em" mathsize="2.100em" rspace="0em">)</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i},\bm{Y}_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i},\bm{Y}_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex279"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex279.m1" class="ltx_math_unparsed" alttext="\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mrow><mo lspace="0em" mathsize="2.100em" rspace="0em">)</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\biggl(\frac{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i})-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}^{(2)}=c\mid L_{i}\neq c)}\biggl)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex280"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex280.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbbm{1}\{L_{i}=c\}\times\mathbbm{1}\{L_{i}=c\}=\mathbbm{1}\{L_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo rspace="0.222em">×</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbbm{1}\{L_{i}=c\}\times\mathbbm{1}\{L_{i}=c\}=\mathbbm{1}\{L_{i}=c\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.p1.3" class="ltx_p">where the second equality is because <math id="A4.SS6.p1.m9" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}\;\mbox{$\perp\!\!\!\perp$}\;\bm{Y}_{i}\mid L_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.558em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><mo fence="false">|</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}\;\mbox{$\perp\!\!\!\perp$}\;\bm{Y}_{i}\mid L_{i}</annotation></semantics></math> (i.e., exclusion restriction). Hence, by exploiting the independence, I have</p>
<table id="A4.EGx111" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex281"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex281.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbbm{1}\{L_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbbm{1}\{L_{i}=c\}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex281.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i},\bm{Y}_{i}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid L_{i},\bm{Y}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex282"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex282.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex283"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex283.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.p1.4" class="ltx_p">where the second equality is by Assumption <a href="#Thmassumption1" title="Assumption 1 (True Coding Rule) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> and the third equality is by Assumption <a href="#Thmassumption6" title="Assumption 6 (Noisy Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>. Therefore,</p>
<table id="A4.EGx112" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex284"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex284.m1" class="ltx_Math" alttext="\displaystyle\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex284.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex285"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex285.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i}),\bm{Y}_{i},\bm{Z}_{i}]\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i}),\bm{Y}_{i},\bm{Z}_{i}]\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex286"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex286.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i},\bm{Z}_{i}]\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i},\bm{Z}_{i}]\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex287"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex287.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex288"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex288.m1" class="ltx_Math" alttext="\displaystyle=\mu_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>μ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mu_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS6.p1.5" class="ltx_p">which proves the claim mentioned after Equation (<a href="#S4.E13" title="In 4.2 Estimation and inference ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>).</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A4.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">S4.7 </span>Proof of Theorem <a href="#Thmtheorem3" title="Theorem 3 (Influence Function) ‣ 4.2 Estimation and inference ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> (Influence function without true labels)</h3>

<div id="A4.SS7.p1" class="ltx_para">
<p id="A4.SS7.p1.1" class="ltx_p">Following Theorem <a href="#Thmtheorem1" title="Theorem 1 (Efficient Influence Function) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, I first derive the influence function for <math id="A4.SS7.p1.m1" class="ltx_Math" alttext="\Psi_{t,c}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\Psi_{t,c}</annotation></semantics></math> with the full data.</p>
</div>
<div id="Thmlemma3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma3.2" class="ltx_text ltx_font_smallcaps">Lemma 3</span></span><span id="Thmlemma3.3" class="ltx_text ltx_font_smallcaps"> (Influence function)</span></h6>
<div id="Thmlemma3.p1" class="ltx_para">
<p id="Thmlemma3.p1.1" class="ltx_p"><span id="Thmlemma3.p1.1.1" class="ltx_text ltx_font_italic">The influence function for the distribution of the covariate-adjusted outcome under <math id="Thmlemma3.p1.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> is given by</span></p>
<table id="A4.EGx113" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex289"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex289.m1" class="ltx_Math" alttext="\displaystyle\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi_{t},\rho_{t},\bar{m}_{tc},\Psi_{t,c})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><msub><mi>μ</mi><mi>c</mi></msub><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ρ</mi><mi>t</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi_{t},\rho_{t},\bar{m}_{tc},\Psi_{t,c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex290"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex290.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbbm{1}\{L_{i}=c\}-\mu_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>−</mo><msub><mi>μ</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbbm{1}\{L_{i}=c\}-\mu_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex291"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex291.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{tc}(\bm{Z}_{i})-\Psi_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{tc}(\bm{Z}_{i})-\Psi_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma3.p1.2" class="ltx_p"><span id="Thmlemma3.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma3.p1.m2" class="ltx_Math" alttext="\mu_{c}(\bm{f}(\bm{Y}_{i}))=\mathbb{P}[L_{i}=c\mid\bm{f}(\bm{Y}_{i})]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>μ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{c}(\bm{f}(\bm{Y}_{i}))=\mathbb{P}[L_{i}=c\mid\bm{f}(\bm{Y}_{i})]</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.SS7.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS7.p2" class="ltx_para">
<p id="A4.SS7.p2.1" class="ltx_p"><span id="A4.SS7.p2.1.1" class="ltx_text">Following the proof of Theorem <a href="#Thmtheorem1" title="Theorem 1 (Efficient Influence Function) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, I use the point-mass contamination approach. Now, the identification formula is</span></p>
<table id="A4.EGx114" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex292"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex292.m1" class="ltx_Math" alttext="\displaystyle\Psi_{t,c}(\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Psi_{t,c}(\mathcal{P})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex292.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid T_{i}=t,\bm{Z}_{i}]\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid T_{i}=t,\bm{Z}_{i}]\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex293"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex293.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\mathbb{E}_{\mathcal{P}}[\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\mid T_{i}=t,\bm{Z}_{i}]\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\mathbb{E}_{\mathcal{P}}[\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\mid T_{i}=t,\bm{Z}_{i}]\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex294"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex294.m1" class="ltx_math_unparsed" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]dF(\bm{Y}_{i}\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i})." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]dF(\bm{Y}_{i}\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p2.2" class="ltx_p"><span id="A4.SS7.p2.2.1" class="ltx_text">Hence, by replacing only the original outcome model with <math id="A4.SS7.p2.m1" class="ltx_math_unparsed" alttext="\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mathcal{P}}[\mathbbm{1}\{L_{i}=c\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]</annotation></semantics></math> in the proof of Theorem <a href="#Thmtheorem1" title="Theorem 1 (Efficient Influence Function) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, I obtain the following:</span></p>
<table id="A4.EGx115" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex295"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex295.m1" class="ltx_Math" alttext="\displaystyle\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi_{t},\rho_{t},\bar{m}_{tc},\Psi_{t,c})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><msub><mi>μ</mi><mi>c</mi></msub><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ρ</mi><mi>t</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi_{t},\rho_{t},\bar{m}_{tc},\Psi_{t,c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex296"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex296.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbbm{1}\{L_{i}=c\}-\mu_{c}(\bm{f}(\bm{Y}_{i}))\biggr)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo>−</mo><msub><mi>μ</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbbm{1}\{L_{i}=c\}-\mu_{c}(\bm{f}(\bm{Y}_{i}))\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex297"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex297.m1" class="ltx_Math" alttext="\displaystyle\qquad\qquad+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu_{c}(\bm{f}(\bm{Y}_{i}))-\bar{m}_{tc}(\bm{Z}_{i})\biggr)+\bar{m}_{tc}(\bm{Z}_{i})-\Psi_{t,c}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi>μ</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu_{c}(\bm{f}(\bm{Y}_{i}))-\bar{m}_{tc}(\bm{Z}_{i})\biggr)+\bar{m}_{tc}(\bm{Z}_{i})-\Psi_{t,c}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p2.3" class="ltx_p"><span id="A4.SS7.p2.3.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A4.SS7.p3" class="ltx_para ltx_noindent">
<p id="A4.SS7.p3.1" class="ltx_p">Based on this result, I have a guess that if I replace the hidden outcome <math id="A4.SS7.p3.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> with some estimable but unbiased substitute, it works as an influence function. To formally prove this, I first derive the most important lemma that characterizes the relationship between the observed data influence function and the full data influence function.</p>
</div>
<div id="Thmlemma4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma4.2" class="ltx_text ltx_font_smallcaps">Lemma 4</span></span><span id="Thmlemma4.3" class="ltx_text ltx_font_smallcaps"> (Characterization of the observed data influence function)</span></h6>
<div id="Thmlemma4.p1" class="ltx_para">
<p id="Thmlemma4.p1.1" class="ltx_p"><span id="Thmlemma4.p1.1.1" class="ltx_text ltx_font_italic">Any observed influence function <math id="Thmlemma4.p1.m1" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> and any full data influence function <math id="Thmlemma4.p1.m2" class="ltx_Math" alttext="Q^{F}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mi>F</mi></msup><annotation encoding="application/x-tex">Q^{F}</annotation></semantics></math> must satisfy</span></p>
<table id="A4.E14" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E14X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E14X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Q\mid S_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid S_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E14X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid S_{i}]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid S_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(S14)</span></td></tr>
<tr id="A4.E14Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E14Xa.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Q\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E14Xa.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><msup><mrow></mrow><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS7.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS7.p4" class="ltx_para">
<p id="A4.SS7.p4.1" class="ltx_p"><span id="A4.SS7.p4.1.1" class="ltx_text">This proof goes analogous to that of Lemma 2 in <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib70" title="" class="ltx_ref">Zhou and Tchetgen (2024)</a></cite>. Let <math id="A4.SS7.p4.m1" class="ltx_Math" alttext="G_{S_{i}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><msub><mi>S</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G_{S_{i}}(\cdot)</annotation></semantics></math> be a coarsening operator with coarsening variable <math id="A4.SS7.p4.m2" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math>, which just means that</span></p>
<table id="A4.EGx116" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex298"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex298.m1" class="ltx_Math" alttext="\displaystyle G_{S_{i}}(\{\tilde{L}^{(j)}_{i}\}_{j=1}^{J})=\begin{cases}\{\tilde{L}^{(1)}_{i},\cdots,\tilde{L}^{(j)}_{i}\}\quad\text{ if }S_{i}=1\\
\emptyset\quad\text{otherwise}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>G</mi><msub><mi>S</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>J</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext> if </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi mathvariant="normal">∅</mi><mspace style="width:1em;" width="1em"></mspace><mtext>otherwise</mtext></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle G_{S_{i}}(\{\tilde{L}^{(j)}_{i}\}_{j=1}^{J})=\begin{cases}\{\tilde{L}^{(1)}_{i},\cdots,\tilde{L}^{(j)}_{i}\}\quad\text{ if }S_{i}=1\\
\emptyset\quad\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p4.2" class="ltx_p"><span id="A4.SS7.p4.2.1" class="ltx_text">and <math id="A4.SS7.p4.m3" class="ltx_Math" alttext="Q=Q(S_{i},T_{i},\bm{Y}_{i},\bm{Z}_{i},G_{S_{i}}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i}))" display="inline" intent=":literal"><semantics><mrow><mi>Q</mi><mo>=</mo><mrow><mi>Q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>G</mi><msub><mi>S</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q=Q(S_{i},T_{i},\bm{Y}_{i},\bm{Z}_{i},G_{S_{i}}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i}))</annotation></semantics></math> be any observed data influence function. Then, <math id="A4.SS7.p4.m4" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math> must satisfy the following <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib27" title="" class="ltx_ref">Tsiatis, 2006</a>; <a href="#bib.bib30" title="" class="ltx_ref">Ichimura and Newey, 2022</a>)</cite>:</span></p>
<table id="A4.EGx117" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex299"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex299.m1" class="ltx_math_unparsed" alttext="\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}=\mathbb{E}\biggl[Q\;\mathbb{E}[U^{F}\mid S_{i},\bm{Z}_{i},T_{i},\bm{Y}_{i},G_{S_{i}}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})]\biggr]=\mathbb{E}\biggl[Q\ U^{F}\biggr]" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ϵ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>ϵ</mi></mfrac></mstyle><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>Q</mi><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi>U</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>G</mi><msub><mi>S</mi><mi>i</mi></msub></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>Q</mi><msup><mi>U</mi><mi>F</mi></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}=\mathbb{E}\biggl[Q\;\mathbb{E}[U^{F}\mid S_{i},\bm{Z}_{i},T_{i},\bm{Y}_{i},G_{S_{i}}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})]\biggr]=\mathbb{E}\biggl[Q\ U^{F}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p4.3" class="ltx_p"><span id="A4.SS7.p4.3.1" class="ltx_text">where <math id="A4.SS7.p4.m5" class="ltx_Math" alttext="U^{F}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mi>F</mi></msup><annotation encoding="application/x-tex">U^{F}</annotation></semantics></math> is the full data oracle score (see Chapter 7 of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib27" title="" class="ltx_ref">Tsiatis 2006</a></cite> for the theoretical details of the observed data score function). Similarly, for the full data influence function, denoted as <math id="A4.SS7.p4.m6" class="ltx_Math" alttext="Q^{F}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mi>F</mi></msup><annotation encoding="application/x-tex">Q^{F}</annotation></semantics></math>, I also have</span></p>
<table id="A4.EGx118" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex300"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex300.m1" class="ltx_Math" alttext="\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}=\mathbb{E}\biggl[Q^{F}U^{F}\biggr]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ϵ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>ϵ</mi></mfrac></mstyle></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>U</mi><mi>F</mi></msup></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}=\mathbb{E}\biggl[Q^{F}U^{F}\biggr].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p4.4" class="ltx_p"><span id="A4.SS7.p4.4.1" class="ltx_text">Now, by factorization, <math id="A4.SS7.p4.m7" class="ltx_Math" alttext="U^{F}" display="inline" intent=":literal"><semantics><msup><mi>U</mi><mi>F</mi></msup><annotation encoding="application/x-tex">U^{F}</annotation></semantics></math> (i.e., the full data score I considered in the previous setting) is written as</span></p>
<table id="A4.EGx119" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex301"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex301.m1" class="ltx_Math" alttext="\displaystyle U^{F}=g_{s}(S_{i})+g_{z}(\bm{Z}_{i})+g_{t}(T_{i},\bm{Z}_{i})+g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>U</mi><mi>F</mi></msup><mo>=</mo><mrow><mrow><msub><mi>g</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>g</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>g</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle U^{F}=g_{s}(S_{i})+g_{z}(\bm{Z}_{i})+g_{t}(T_{i},\bm{Z}_{i})+g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p4.5" class="ltx_p"><span id="A4.SS7.p4.5.1" class="ltx_text">for any <math id="A4.SS7.p4.m8" class="ltx_Math" alttext="g_{s}\in\Lambda_{S}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>s</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>S</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{s}\in\Lambda_{S}^{F}</annotation></semantics></math>, <math id="A4.SS7.p4.m9" class="ltx_Math" alttext="g_{z}\in\Lambda_{Z}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>z</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>Z</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{z}\in\Lambda_{Z}^{F}</annotation></semantics></math>, <math id="A4.SS7.p4.m10" class="ltx_Math" alttext="g_{t}\in\Lambda_{T}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>t</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>T</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{t}\in\Lambda_{T}^{F}</annotation></semantics></math>, and <math id="A4.SS7.p4.m11" class="ltx_Math" alttext="g_{y}\in\Lambda_{Y}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>y</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>Y</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{y}\in\Lambda_{Y}^{F}</annotation></semantics></math>, where</span></p>
<table id="A4.EGx120" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex302"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex302.m1" class="ltx_Math" alttext="\displaystyle\Lambda_{S}^{F}=\biggl\{g_{s}(S_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{s}(S_{i})]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Λ</mi><mi>S</mi><mi>F</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>g</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>F</mi></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>g</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{S}^{F}=\biggl\{g_{s}(S_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{s}(S_{i})]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex303"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex303.m1" class="ltx_Math" alttext="\displaystyle\Lambda_{Z}^{F}=\biggl\{g_{z}(\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{z}(\bm{Z}_{i})]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Λ</mi><mi>Z</mi><mi>F</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>g</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>F</mi></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>g</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{Z}^{F}=\biggl\{g_{z}(\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{z}(\bm{Z}_{i})]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex304"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex304.m1" class="ltx_Math" alttext="\displaystyle\Lambda_{T}^{F}=\biggl\{g_{t}(T_{i},\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{t}(T_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Λ</mi><mi>T</mi><mi>F</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>F</mi></msup></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>g</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{T}^{F}=\biggl\{g_{t}(T_{i},\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{t}(T_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex305"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex305.m1" class="ltx_math_unparsed" alttext="\displaystyle\Lambda_{\bm{Y}}^{F}=\biggl\{g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\mid T_{i},\bm{Z}_{i}]=0\biggr\}," display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Λ</mi><mi>𝒀</mi><mi>F</mi></msubsup><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>g</mi><mi>y</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>F</mi></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>g</mi><mi>y</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{\bm{Y}}^{F}=\biggl\{g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\in\mathcal{H}^{F}:\mathbb{E}[g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\mid T_{i},\bm{Z}_{i}]=0\biggr\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p4.6" class="ltx_p"><span id="A4.SS7.p4.6.1" class="ltx_text">and <math id="A4.SS7.p4.m12" class="ltx_Math" alttext="\mathcal{H}^{F}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>F</mi></msup><annotation encoding="application/x-tex">\mathcal{H}^{F}</annotation></semantics></math> is the Hilbert space of the oracle data (the data I are working with in the previous section’s setting). Hence,</span></p>
<table id="A4.EGx121" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex306"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex306.m1" class="ltx_Math" alttext="\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">lim</mo><mrow><mi>ϵ</mi><mo stretchy="false">→</mo><mn>0</mn></mrow></munder><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>ϵ</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\lim_{\epsilon\to 0}\frac{\Psi_{t,c}(\mathcal{P}_{\epsilon})-\Psi_{t,c}(\mathcal{P})}{\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex307"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex307.m1" class="ltx_Math" alttext="\displaystyle=\begin{cases}\mathbb{E}\biggl[\mathbb{E}[Q\mid S_{i}]g_{s}(S_{i})+\mathbb{E}[Q\mid\bm{Z}_{i}]g_{z}(\bm{Z}_{i})+\mathbb{E}[Q\mid T_{i}]\ g_{t}(T_{i},\bm{Z}_{i})+\mathbb{E}[Q\mid T_{i},\bm{Y}_{i}]\ g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\biggr]\\
\mathbb{E}\biggl[\mathbb{E}[Q^{F}\mid S_{i}]g_{s}(S_{i})+\mathbb{E}[Q^{F}\mid\bm{Z}_{i}]g_{z}(\bm{Z}_{i})+\mathbb{E}[Q^{F}\mid T_{i}]\ g_{t}(T_{i},\bm{Z}_{i})+\mathbb{E}[Q^{F}\mid T_{i},\bm{Y}_{i}]\ g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\biggr].\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>z</mi></msub><mo stretchy="false">(</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>y</mi></msub><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><msup><mrow></mrow><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>s</mi></msub><mo stretchy="false">(</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><msup><mrow></mrow><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>z</mi></msub><mo stretchy="false">(</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><msup><mrow></mrow><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>𝔼</mi><mo stretchy="false">[</mo><mi>Q</mi><msup><mrow></mrow><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">]</mo><mi>g</mi><msub><mrow></mrow><mi>y</mi></msub><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo maxsize="2.100em" minsize="2.100em">]</mo><mo lspace="0em">.</mo></mrow></mtd><mtd></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}\mathbb{E}\biggl[\mathbb{E}[Q\mid S_{i}]g_{s}(S_{i})+\mathbb{E}[Q\mid\bm{Z}_{i}]g_{z}(\bm{Z}_{i})+\mathbb{E}[Q\mid T_{i}]\ g_{t}(T_{i},\bm{Z}_{i})+\mathbb{E}[Q\mid T_{i},\bm{Y}_{i}]\ g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\biggr]\\
\mathbb{E}\biggl[\mathbb{E}[Q^{F}\mid S_{i}]g_{s}(S_{i})+\mathbb{E}[Q^{F}\mid\bm{Z}_{i}]g_{z}(\bm{Z}_{i})+\mathbb{E}[Q^{F}\mid T_{i}]\ g_{t}(T_{i},\bm{Z}_{i})+\mathbb{E}[Q^{F}\mid T_{i},\bm{Y}_{i}]\ g_{y}(\bm{Y}_{i},T_{i},\bm{Z}_{i})\biggr].\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p4.7" class="ltx_p"><span id="A4.SS7.p4.7.1" class="ltx_text">Thus, to align these two expressions for any <math id="A4.SS7.p4.m13" class="ltx_Math" alttext="g_{s}\in\Lambda_{S}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>s</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>S</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{s}\in\Lambda_{S}^{F}</annotation></semantics></math>, <math id="A4.SS7.p4.m14" class="ltx_Math" alttext="g_{s}\in\Lambda_{T}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>s</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>T</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{s}\in\Lambda_{T}^{F}</annotation></semantics></math>, and <math id="A4.SS7.p4.m15" class="ltx_Math" alttext="g_{y}\in\Lambda_{Y}^{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>y</mi></msub><mo>∈</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>Y</mi><mi>F</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{y}\in\Lambda_{Y}^{F}</annotation></semantics></math>, I must have</span></p>
<table id="A4.EGx122" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex308"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex308.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Q\mid S_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid S_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex308.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid S_{i}]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid S_{i}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex309"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex309.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[Q\mid\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex309.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Z}_{i}]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Z}_{i}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex310"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex310.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[Q\mid T_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid T_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex310.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid T_{i},\bm{Z}_{i}]," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid T_{i},\bm{Z}_{i}],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex311"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex311.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[Q\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>Q</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[Q\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex311.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}]." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msup><mi>Q</mi><mi>F</mi></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[Q^{F}\mid\bm{Y}_{i},T_{i},\bm{Z}_{i}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p4.8" class="ltx_p"><span id="A4.SS7.p4.8.1" class="ltx_text">Note that the second and third conditions are redundant since the fourth implies the second and the third by the law of iterated expectations.
∎</span></p>
</div>
</div>
<div id="A4.SS7.p5" class="ltx_para ltx_noindent">
<p id="A4.SS7.p5.1" class="ltx_p">Using these derived results, I prove Theorem <a href="#Thmtheorem3" title="Theorem 3 (Influence Function) ‣ 4.2 Estimation and inference ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>.</p>
</div>
<div id="A4.SS7.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS7.p6" class="ltx_para">
<p id="A4.SS7.p6.1" class="ltx_p"><span id="A4.SS7.p6.1.1" class="ltx_text">From Lemma <a href="#Thmlemma4" title="Lemma 4 (Characterization of the observed data influence function) ‣ S4.7 Proof of Theorem (Influence function without true labels) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, I know the relationship between the full data influence function and the observed data influence function. Now, let</span></p>
<table id="A4.EGx123" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex312"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex312.m1" class="ltx_Math" alttext="\displaystyle Q^{F}" display="inline" intent=":literal"><semantics><msup><mi>Q</mi><mi>F</mi></msup><annotation encoding="application/x-tex">\displaystyle Q^{F}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex312.m2" class="ltx_Math" alttext="\displaystyle=\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi,\Psi_{t,c})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>L</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><msub><mi>μ</mi><mi>c</mi></msub><mo>,</mo><mi>π</mi><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\psi_{t,c}^{F}(T_{i},L_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\mu_{c},\pi,\Psi_{t,c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p6.2" class="ltx_p"><span id="A4.SS7.p6.2.1" class="ltx_text">and check if the expression</span></p>
<table id="A4.EGx124" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex313"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex313.m1" class="ltx_Math" alttext="\displaystyle\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex313.m2" class="ltx_math_unparsed" alttext="\displaystyle;\bm{f},\tilde{\mu},\pi_{t},M_{c},\bar{m}_{tc},\Psi_{t,c})" display="inline" intent=":literal"><semantics><mrow><mo>;</mo><mi>𝒇</mi><mo>,</mo><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msub><mi>M</mi><mi>c</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle;\bm{f},\tilde{\mu},\pi_{t},M_{c},\bar{m}_{tc},\Psi_{t,c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex314"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex314.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})-\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})-\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex315"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex315.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t,c}(\bm{Z}_{i})\biggr)+\bar{m}_{t,c}(\bm{Z}_{i})-\Psi_{t,c}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t,c}(\bm{Z}_{i})\biggr)+\bar{m}_{t,c}(\bm{Z}_{i})-\Psi_{t,c}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p6.3" class="ltx_p"><span id="A4.SS7.p6.3.1" class="ltx_text">satisfies the condition in the previous lemma. Now, because outcome model with the surrogate outcome model (i.e., <math id="A4.SS7.p6.m1" class="ltx_Math" alttext="\tilde{\mu}_{c}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><annotation encoding="application/x-tex">\tilde{\mu}_{c}</annotation></semantics></math>) is mathematically equivalent to <math id="A4.SS7.p6.m2" class="ltx_Math" alttext="\mu_{c}" display="inline" intent=":literal"><semantics><msub><mi>μ</mi><mi>c</mi></msub><annotation encoding="application/x-tex">\mu_{c}</annotation></semantics></math>,</span></p>
<table id="A4.EGx125" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex316"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex316.m1" class="ltx_math_unparsed" alttext="\displaystyle\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}." display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>−</mo><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">{</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS7.p6.4" class="ltx_p"><span id="A4.SS7.p6.4.1" class="ltx_text">Thus,</span></p>
<ul id="A4.I2" class="ltx_itemize">
<li id="A4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I2.i1.p1" class="ltx_para">
<p id="A4.I2.i1.p1.1" class="ltx_p"><math id="A4.I2.i1.p1.m1" class="ltx_Math" alttext="\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid S_{i}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid S_{i}]=0</annotation></semantics></math>: Now,</p>
<table id="A4.EGx126" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex317"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex317.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid S_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mi>F</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\tilde{\psi}_{t,c}(\cdot)-\psi_{t,c}^{F}(\cdot)\mid S_{i}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex318"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex318.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}\mid S_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">{</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}\mid S_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex319"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex319.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\mathbb{E}\biggl[\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl\{M_{c}(L_{i}^{(1)},L_{i}^{(2)})-\mathbbm{1}\{L_{i}=c\}\biggr\}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">{</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>L</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="2.100em" minsi