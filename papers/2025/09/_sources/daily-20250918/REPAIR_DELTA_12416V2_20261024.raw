<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex183.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\frac{1}{c_{2}^{2}}\delta_{n}\biggl\{\mathbb{E}\biggl[\{\mathbb{E}[|\tilde{L}_{i}|^{2}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i}),T_{i}=t]\}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[\{\mathbb{E}[|\tilde{L}_{i}|^{2}\mid\bm{Z}_{i},T_{i}=t]\}\biggr]^{\frac{1}{2}}+2\biggr\}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>c</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><msub><mi>δ</mi><mi>n</mi></msub><mrow><mo stretchy="false">{</mo><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mo stretchy="false">{</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0.167em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>+</mo><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mo stretchy="false">{</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><msup><mo fence="false" stretchy="false">|</mo><mn>2</mn></msup><mo lspace="0.167em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>+</mo><mn>2</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{c_{2}^{2}}\delta_{n}\biggl\{\mathbb{E}\biggl[\{\mathbb{E}[|\tilde{L}_{i}|^{2}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i}),T_{i}=t]\}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[\{\mathbb{E}[|\tilde{L}_{i}|^{2}\mid\bm{Z}_{i},T_{i}=t]\}\biggr]^{\frac{1}{2}}+2\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex184"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex184.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{c_{2}^{2}}\delta_{n}\biggl\{\mathbb{E}[|\tilde{L}_{i}|^{2}]^{\frac{1}{2}}+\mathbb{E}[|\tilde{L}_{i}|^{2}]^{\frac{1}{2}}+2\biggr\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>c</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{c_{2}^{2}}\delta_{n}\biggl\{\mathbb{E}[|\tilde{L}_{i}|^{2}]^{\frac{1}{2}}+\mathbb{E}[|\tilde{L}_{i}|^{2}]^{\frac{1}{2}}+2\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex185"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex185.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{c_{2}^{2}}(2c_{1}+2)\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>c</mi><mn>2</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{c_{2}^{2}}(2c_{1}+2)\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p6.2" class="ltx_p"><span id="A4.SS4.p6.2.1" class="ltx_text">where the fourth and sixth inequalities are by Cauchy-Schwartz inequality, the fifth and ninth lines are by triangular inequality, and the tenth line is by Jensen’s inequality.</span></p>
</div>
<div id="A4.SS4.p7" class="ltx_para">
<p id="A4.SS4.p7.1" class="ltx_p"><span id="A4.SS4.p7.1.1" class="ltx_text">Finally, I assume that <math id="A4.SS4.p7.m1" class="ltx_Math" alttext="\mathbb{E}[|H_{24}|^{2}]^{\frac{1}{2}}\leq\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>24</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\mathbb{E}[|H_{24}|^{2}]^{\frac{1}{2}}\leq\delta_{n}</annotation></semantics></math> in Assumption <a href="#Thmassumption4" title="Assumption 4 (Regularity Conditions) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. Therefore,</span></p>
<table id="A4.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex186"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex186.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[|\hat{\psi}_{t}-\psi_{t}|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo stretchy="false">|</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>ψ</mi><mi>t</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[|\hat{\psi}_{t}-\psi_{t}|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex186.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\biggl|\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(H_{21}-H_{22})+\mathbbm{1}\{T_{i}=t\}H_{23}+H_{24}\biggr|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mstyle displaystyle="true"><mfrac><msub><mi>S</mi><mi>i</mi></msub><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>21</mn></msub><mo>−</mo><msub><mi>H</mi><mn>22</mn></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><msub><mi>H</mi><mn>23</mn></msub><mo>+</mo><msub><mi>H</mi><mn>24</mn></msub><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\biggl|\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(H_{21}-H_{22})+\mathbbm{1}\{T_{i}=t\}H_{23}+H_{24}\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex187"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex187.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{E}\biggl[\biggl|\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(H_{21}-H_{22})\biggr|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[\biggl|\mathbbm{1}\{T_{i}=t\}H_{23}\biggr|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|H_{24}|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mstyle displaystyle="true"><mfrac><msub><mi>S</mi><mi>i</mi></msub><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>21</mn></msub><mo>−</mo><msub><mi>H</mi><mn>22</mn></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>+</mo><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><msub><mi>H</mi><mn>23</mn></msub><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>+</mo><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>H</mi><mn>24</mn></msub><msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}\biggl[\biggl|\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(H_{21}-H_{22})\biggr|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[\biggl|\mathbbm{1}\{T_{i}=t\}H_{23}\biggr|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|H_{24}|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex188"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex188.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{\sqrt{\mathbb{P}(S_{i}=1)}}\mathbb{E}\biggl[\biggl|H_{21}-H_{22}\biggr|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|H_{23}|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|H_{24}|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><msub><mi>H</mi><mn>21</mn></msub><mo>−</mo><msub><mi>H</mi><mn>22</mn></msub></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>23</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>24</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{\sqrt{\mathbb{P}(S_{i}=1)}}\mathbb{E}\biggl[\biggl|H_{21}-H_{22}\biggr|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|H_{23}|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|H_{24}|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex189"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex189.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{\sqrt{\mathbb{P}(S_{i}=1)}}\biggl(\mathbb{E}\biggl[|H_{21}|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|H_{22}|^{2}\biggr]^{\frac{1}{2}}\biggr)+\mathbb{E}\biggl[|H_{23}|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|H_{24}|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>21</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>22</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>23</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>24</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{\sqrt{\mathbb{P}(S_{i}=1)}}\biggl(\mathbb{E}\biggl[|H_{21}|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|H_{22}|^{2}\biggr]^{\frac{1}{2}}\biggr)+\mathbb{E}\biggl[|H_{23}|^{2}\biggr]^{\frac{1}{2}}+\mathbb{E}\biggl[|H_{24}|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex190"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex190.m1" class="ltx_Math" alttext="\displaystyle\leq\delta_{n}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msubsup><mi>δ</mi><mi>n</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\delta_{n}^{\prime}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p7.2" class="ltx_p"><span id="A4.SS4.p7.2.1" class="ltx_text">where <math id="A4.SS4.p7.m2" class="ltx_Math" alttext="\delta_{n}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>δ</mi><mi>n</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">\delta_{n}^{\prime}</annotation></semantics></math> is another sequence of random variables that converges to 0 as <math id="A4.SS4.p7.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> goes to infinity. In the above transformation, the second and the fourth lines are by triangular inequality and the third line is by Cauchy-Schwartz inequality. Thus, by applying this Lemma <a href="#Thmlemma2" title="Lemma 2 (Lemma 2 of ) ‣ S4.4 Proof of Theorem (Asymptotic Normality) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>,</span></p>
<table id="A4.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex191"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex191.m1" class="ltx_Math" alttext="\displaystyle H_{2}=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{\psi}_{t}-\psi_{t})=O_{p}\biggl(\lVert\hat{\psi}_{t}-\psi_{t}\rVert_{2}\biggr)=O_{p}(o_{p}(1))=o_{p}(1)." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mn>2</mn></msub><mo>=</mo><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>ψ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>O</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>ψ</mi><mi>t</mi></msub></mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><mn>2</mn></msub><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>O</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>o</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>o</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle H_{2}=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{\psi}_{t}-\psi_{t})=O_{p}\biggl(\lVert\hat{\psi}_{t}-\psi_{t}\rVert_{2}\biggr)=O_{p}(o_{p}(1))=o_{p}(1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p7.3" class="ltx_p"><span id="A4.SS4.p7.3.1" class="ltx_text">Thus, to derive the asymptotic normality, I only need to control the reminder term of the von Mises expansion. Rewriting Equation <a href="#A4.E9" title="In Proof. ‣ S4.4 Proof of Theorem (Asymptotic Normality) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S9</span></a>, I can write the reminder term as</span></p>
<table id="A4.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex192"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex192.m1" class="ltx_Math" alttext="\displaystyle R(\hat{\mathcal{P}}_{n},\mathcal{P})=-\Psi_{t}(\hat{\mathcal{P}}_{n})+\Psi_{t}(\mathcal{P})-\int\psi_{t}(O_{i},\hat{\mathcal{P}}_{n})d\mathcal{P}(O_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle R(\hat{\mathcal{P}}_{n},\mathcal{P})=-\Psi_{t}(\hat{\mathcal{P}}_{n})+\Psi_{t}(\mathcal{P})-\int\psi_{t}(O_{i},\hat{\mathcal{P}}_{n})d\mathcal{P}(O_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex193"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex193.m1" class="ltx_math_unparsed" alttext="\displaystyle=-\Psi_{t}(\hat{\mathcal{P}}_{n})+\Psi_{t}(\mathcal{P})-\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\tilde{L}_{i}-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]\biggr)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em">−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><msub><mrow></mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo stretchy="false">[</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow><mrow><mi>𝔼</mi><msub><mrow></mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo stretchy="false">[</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\Psi_{t}(\hat{\mathcal{P}}_{n})+\Psi_{t}(\mathcal{P})-\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\tilde{L}_{i}-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex194"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex194.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad\quad\quad\quad+\frac{\mathbbm{1}\{T_{i}=t\}}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]\mid\bm{Z}_{i},T_{i}=t]\biggr)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><mi>𝔼</mi><msub><mrow></mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo stretchy="false">[</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>−</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad\quad\quad+\frac{\mathbbm{1}\{T_{i}=t\}}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]\mid\bm{Z}_{i},T_{i}=t]\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex195"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex195.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad+\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]\mid\bm{Z}_{i},T_{i}=t]-\Psi_{t}(\hat{\mathcal{P}}_{n})\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad+\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]\mid\bm{Z}_{i},T_{i}=t]-\Psi_{t}(\hat{\mathcal{P}}_{n})\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex196"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex196.m1" class="ltx_Math" alttext="\displaystyle=-R_{1}-R_{2}-R_{3}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mo>−</mo><msub><mi>R</mi><mn>1</mn></msub></mrow><mo>−</mo><msub><mi>R</mi><mn>2</mn></msub><mo>−</mo><msub><mi>R</mi><mn>3</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-R_{1}-R_{2}-R_{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p7.4" class="ltx_p"><span id="A4.SS4.p7.4.1" class="ltx_text">where <math id="A4.SS4.p7.m4" class="ltx_Math" alttext="\mathbb{E}_{\mathcal{P}}[\cdot]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mathcal{P}}[\cdot]</annotation></semantics></math> is the expectation operator with respect to the population distribution <math id="A4.SS4.p7.m5" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math> and <math id="A4.SS4.p7.m6" class="ltx_Math" alttext="\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\cdot]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\cdot]</annotation></semantics></math> is the expectation operator with respect to the empirical distribution <math id="A4.SS4.p7.m7" class="ltx_Math" alttext="\hat{\mathcal{P}}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\hat{\mathcal{P}}_{n}</annotation></semantics></math>, and</span></p>
<table id="A4.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex197"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex197.m1" class="ltx_Math" alttext="\displaystyle R_{1}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle R_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex197.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\tilde{L}_{i}-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]\biggr)\biggr]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mi>𝔼</mi><msub><mrow></mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo stretchy="false">[</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">]</mo></mrow><mrow><mi>𝔼</mi><msub><mrow></mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo stretchy="false">[</mo><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><mrow><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathcal{P}}\biggl[\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]}{\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Z}_{i}]}\biggl(\tilde{L}_{i}-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]\biggr)\biggr],</annotation></semantics></math></td>
