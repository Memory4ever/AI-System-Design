<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex259.m2" class="ltx_Math" alttext="\displaystyle&gt;\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}_{i}^{(j)}=l^{\prime}\mid L_{i}=l)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>≠</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></munder></mstyle><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msup><mi>l</mi><mo>′</mo></msup></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&gt;\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}_{i}^{(j)}=l^{\prime}\mid L_{i}=l)</annotation></semantics></math></td>
