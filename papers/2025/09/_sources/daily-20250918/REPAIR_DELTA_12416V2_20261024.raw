<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex220.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\biggl(\mathbb{E}_{\mathcal{P}}[\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\mid\bm{Z}_{i},T_{i}=t]-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]\mid\bm{Z}_{i},T_{i}=t]\biggr)\biggr]." display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mi>𝔼</mi><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\biggl(\mathbb{E}_{\mathcal{P}}[\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\mid\bm{Z}_{i},T_{i}=t]-\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\mathbb{E}_{\hat{\mathcal{P}}_{n}}[\tilde{L}_{i}\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]\mid\bm{Z}_{i},T_{i}=t]\biggr)\biggr].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p11.2" class="ltx_p"><span id="A4.SS4.p11.2.1" class="ltx_text">Therefore,</span></p>
<table id="A4.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex221"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex221.m1" class="ltx_math_unparsed" alttext="\displaystyle|R(\hat{\mathcal{P}}_{n},\mathcal{P})|\leq\frac{1}{\hat{\pi}(\bm{Z}_{i})}\biggl\{\mathbb{E}_{\mathcal{P}}\biggl[\biggl(\hat{\rho_{t}}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)^{2}\biggr]^{\frac{1}{2}}\mathbb{E}_{\mathcal{P}}\biggl[\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mover accent="true"><mi>π</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">{</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mover accent="true"><msub><mi>ρ</mi><mi>t</mi></msub><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ρ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|R(\hat{\mathcal{P}}_{n},\mathcal{P})|\leq\frac{1}{\hat{\pi}(\bm{Z}_{i})}\biggl\{\mathbb{E}_{\mathcal{P}}\biggl[\biggl(\hat{\rho_{t}}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)^{2}\biggr]^{\frac{1}{2}}\mathbb{E}_{\mathcal{P}}\biggl[\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex222"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex222.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad+\mathbb{E}_{\mathcal{P}}\biggl[\biggl(\hat{\pi_{t}}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr)^{2}\biggr]^{\frac{1}{2}}\mathbb{E}_{\mathcal{P}}\biggl[\biggl(\bar{m}_{t}(\bm{Z}_{i})-\hat{\bar{m}}_{t}(\bm{Z}_{i})\biggr)^{2}\biggr]^{\frac{1}{2}}\biggr\}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mover accent="true"><msub><mi>π</mi><mi>t</mi></msub><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>π</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad\quad+\mathbb{E}_{\mathcal{P}}\biggl[\biggl(\hat{\pi_{t}}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr)^{2}\biggr]^{\frac{1}{2}}\mathbb{E}_{\mathcal{P}}\biggl[\biggl(\bar{m}_{t}(\bm{Z}_{i})-\hat{\bar{m}}_{t}(\bm{Z}_{i})\biggr)^{2}\biggr]^{\frac{1}{2}}\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex223"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex223.m1" class="ltx_math_unparsed" alttext="\displaystyle=o_{p}(n^{-1/2})," display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>o</mi><mi>p</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=o_{p}(n^{-1/2}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p11.3" class="ltx_p"><span id="A4.SS4.p11.3.1" class="ltx_text">where the first inequality is by Cauchy-Schwartz inequality and the last equality is from the convergence rate of the cross-product of the nuisance functions in Assumption <a href="#Thmassumption4" title="Assumption 4 (Regularity Conditions) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. Now, I can also show <math id="A4.SS4.p11.m1" class="ltx_Math" alttext="\mathbb{V}[\psi_{t}(O_{i},\mathcal{P})]=\mathbb{E}\biggl[\psi_{t}(O_{i},\mathcal{P})^{2}\biggr]&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝕍</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\mathbb{V}[\psi_{t}(O_{i},\mathcal{P})]=\mathbb{E}\biggl[\psi_{t}(O_{i},\mathcal{P})^{2}\biggr]&lt;\infty</annotation></semantics></math>, as each <math id="A4.SS4.p11.m2" class="ltx_Math" alttext="H_{21},H_{22},H_{23},H_{24}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>21</mn></msub><mo>,</mo><msub><mi>H</mi><mn>22</mn></msub><mo>,</mo><msub><mi>H</mi><mn>23</mn></msub><mo>,</mo><msub><mi>H</mi><mn>24</mn></msub></mrow><annotation encoding="application/x-tex">H_{21},H_{22},H_{23},H_{24}</annotation></semantics></math> is bounded by constant (the proof is immediate since I only need to replace <math id="A4.SS4.p11.m3" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math> with constant <math id="A4.SS4.p11.m4" class="ltx_Math" alttext="c_{1}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>1</mn></msub><annotation encoding="application/x-tex">c_{1}</annotation></semantics></math> in the earlier proof). Therefore, by applying the central limit theorem, I finally obtain the asymptotic normality:</span></p>
<table id="A4.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex224"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex224.m1" class="ltx_Math" alttext="\displaystyle\sqrt{n}\biggl(\hat{\Psi_{t}}-\Psi_{t}\biggr)" display="inline" intent=":literal"><semantics><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mover accent="true"><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo>^</mo></mover><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{n}\biggl(\hat{\Psi_{t}}-\Psi_{t}\biggr)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex224.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\sqrt{n}}\sum_{i=1}^{n}\psi_{t}(O_{i},\mathcal{P})+o_{p}(1)\xrightarrow{d}\mathcal{N}\biggl(0,\mathbb{E}\biggl[\psi_{t}(O_{i},\mathcal{P})^{2}\biggr]\biggr)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>o</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑑</mo></mover><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mn>0</mn><mo>,</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\sqrt{n}}\sum_{i=1}^{n}\psi_{t}(O_{i},\mathcal{P})+o_{p}(1)\xrightarrow{d}\mathcal{N}\biggl(0,\mathbb{E}\biggl[\psi_{t}(O_{i},\mathcal{P})^{2}\biggr]\biggr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p11.4" class="ltx_p"><span id="A4.SS4.p11.4.1" class="ltx_text">∎</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">S4.5 </span>Proof of Proposition <a href="#Thmproposition2" title="Proposition 2 (Identification without Perfect Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> (Identification with Noisy Human Annotations)</h3>

<div id="A4.SS5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS5.p1" class="ltx_para">
<p id="A4.SS5.p1.1" class="ltx_p"><span id="A4.SS5.p1.1.1" class="ltx_text">Here, I prove the case with <math id="A4.SS5.p1.m1" class="ltx_Math" alttext="J=2" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">J=2</annotation></semantics></math>. Firstly, I prove the required independence for the identification. Notice that</span></p>
<table id="A4.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex225"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex225.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=l,\bm{Z}_{i}=\bm{z},\mid L_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi><mo>,</mo><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=l,\bm{Z}_{i}=\bm{z},\mid L_{i})</annotation></semantics></math></td>
