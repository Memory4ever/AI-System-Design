<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex344.m1" class="ltx_math_unparsed" alttext="\displaystyle=o_{p}(n^{-1/4})+\mathbb{E}\biggl[\biggl|\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\biggr|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>o</mi><mi>p</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle=o_{p}(n^{-1/4})+\mathbb{E}\biggl[\biggl|\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
