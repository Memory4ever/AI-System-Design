<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex92.m1" class="ltx_Math" alttext="\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad-\frac{f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\{\mathbbm{1}\{T_{i}=t,\bm{z}=\tilde{\bm{z}}\}-f_{\mathcal{P}}(\bm{z},T_{i}=t)\}}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><mrow><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><msup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒚</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle\quad\quad\quad\quad\quad\quad\quad\quad-\frac{f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\{\mathbbm{1}\{T_{i}=t,\bm{z}=\tilde{\bm{z}}\}-f_{\mathcal{P}}(\bm{z},T_{i}=t)\}}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
