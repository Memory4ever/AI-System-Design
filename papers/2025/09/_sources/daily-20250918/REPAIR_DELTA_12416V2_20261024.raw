<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex334.m2" class="ltx_math_unparsed" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-{\rho}_{t}({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>ρ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-{\rho}_{t}({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}</annotation></semantics></math></td>
