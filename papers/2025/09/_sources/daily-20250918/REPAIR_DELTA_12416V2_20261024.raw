<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex336.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t,c}(\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t,c}(\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex336.m2" class="ltx_math_unparsed" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t,c}(\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t,c}(\bm{Z}_{i})-\bar{m}_{t,c}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I3.i3.p1.2" class="ltx_p"><span id="A4.I3.i3.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="A4.I3.i3.p1.m1" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="A4.I3.i3.p1.2.2" class="ltx_text ltx_font_italic"> and </span><math id="A4.I3.i3.p1.m2" class="ltx_Math" alttext="c\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">c\in\mathcal{L}</annotation></semantics></math><span id="A4.I3.i3.p1.2.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A4.I3.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(d)</span> 
<div id="A4.I3.i4.p1" class="ltx_para">
<p id="A4.I3.i4.p1.1" class="ltx_p"><span id="A4.I3.i4.p1.1.1" class="ltx_text ltx_font_italic">(Coder Classification Rate Estimation) Human coder classification rates </span><math id="A4.I3.i4.p1.m1" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})</annotation></semantics></math><span id="A4.I3.i4.p1.1.2" class="ltx_text ltx_font_italic"> are estimated so that</span></p>
<table id="A4.EGx132" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex337"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex337.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})}-\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mover accent="true"><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>^</mo></mover><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})}-\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex338"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex338.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})}-\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>^</mo></mover><mo>−</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})}-\mathbb{P}(\tilde{L}_{i}^{(j)}=c\mid L_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/4}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I3.i4.p1.2" class="ltx_p"><span id="A4.I3.i4.p1.2.1" class="ltx_text ltx_font_italic">for all coders </span><math id="A4.I3.i4.p1.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="A4.I3.i4.p1.2.2" class="ltx_text ltx_font_italic"> and all category levels </span><math id="A4.I3.i4.p1.m3" class="ltx_Math" alttext="c\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">c\in\mathcal{L}</annotation></semantics></math><span id="A4.I3.i4.p1.2.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="A4.SS8.p2" class="ltx_para">
<p id="A4.SS8.p2.1" class="ltx_p">As in Section <a href="#S3" title="3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, the required rates are standard in the literature, and various machine learning models can satisfy them. For the outcome model, the required convergence is evaluated with respect to the predicted surrogate outcome <math id="A4.SS8.p2.m1" class="ltx_Math" alttext="\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})</annotation></semantics></math>. This implies that Assumption <a href="#Thmassumption10" title="Assumption 10 (Regularity Conditions) ‣ S4.8 Proof of Theorem (Asymptotic Normality) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>(b) focuses on convergence based on these predicted surrogate outcomes. Since the estimation process involves two steps and treats the predicted surrogate outcome as fixed in the second stage, the stated condition aligns with the proposed estimation procedure and can be satisfied using a standard neural network architecture <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Bauer and Kohler, 2019</a>; <a href="#bib.bib20" title="" class="ltx_ref">Schmidt-Hieber, 2020</a>; <a href="#bib.bib28" title="" class="ltx_ref">Farrell et al., 2021</a>)</cite>.</p>
</div>
<div id="A4.SS8.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS8.p3" class="ltx_para">
<p id="A4.SS8.p3.2" class="ltx_p"><span id="A4.SS8.p3.2.1" class="ltx_text">While the influence function used in Theorem <a href="#Thmtheorem4" title="Theorem 4 (Asymptotic Normality) ‣ 4.2 Estimation and inference ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> takes the mathematically equivalent form to Theorem <a href="#Thmtheorem2" title="Theorem 2 (Asymptotic Normality) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, the main difference is that the outcome model is learned with the predicted surrogate outcome and the regularity conditions in Assumption <a href="#Thmassumption10" title="Assumption 10 (Regularity Conditions) ‣ S4.8 Proof of Theorem (Asymptotic Normality) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> only have the convergence of the outcome model given the predicted outcomes. Therefore, I need to bound the <math id="A4.SS8.p3.m1" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math> norm of the difference between the estimated outcome model with the predicted surrogate outcome and the true outcome model. Then, notice that</span></p>
<table id="A4.EGx133" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex339"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex339.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]}-\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\biggr|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mover accent="true"><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>^</mo></mover><mo>−</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\widehat{\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]}-\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex340"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex340.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\biggl|\widehat{\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})]}-\mathbb{E}[\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>^</mo></mover><mo>−</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stre