3.17 -1.93 -3.87 -4.82"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 13.02 57.03 L 110.69 37.68"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.98093 -0.19437 0.19437 0.98093 111.37 37.54)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 191.77 39.9 L 269.17 60.08"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.96767 0.25223 -0.25223 0.96767 269.84 60.25)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 191.77 19.21 L 269.17 -0.86"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(0.96799 -0.251 0.251 0.96799 269.84 -1.04)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 335.55 68.9 L 373.53 68.9"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 374.22 68.9)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g><g stroke-width="1.0pt"><path style="fill:none" d="M 337.22 -9.84 L 375.2 -9.84"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" transform="matrix(1.0 0.0 0.0 1.0 375.89 -9.84)"><path style="fill:none" d="M -3.87 4.82 C -3.17 1.93 -1.59 0.56 0 0 C -1.59 -0.56 -3.17 -1.93 -3.87 -4.82"></path></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.3" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="S3.F2.4" class="ltx_text" style="font-size:90%;">The architecture of neural network for the nuisance function estimation. Given the inputs <math id="S3.F2.m10" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒀</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math> (texts) and <math id="S3.F2.m11" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒁</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math> (covariates), the network maps them onto the shared internal representation <math id="S3.F2.m12" class="ltx_Math" alttext="\bm{W}_{i}=\bm{f}(\bm{Y}_{i},\bm{Z}_{i};\xi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{i}=\bm{f}(\bm{Y}_{i},\bm{Z}_{i};\xi)</annotation></semantics></math> parametrized by <math id="S3.F2.m13" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math>. This representation <math id="S3.F2.m14" class="ltx_Math" alttext="\bm{W}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝑾</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{W}_{i}</annotation></semantics></math> is used to simultaneously predict the human annotation <math id="S3.F2.m15" class="ltx_Math" alttext="\tilde{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo mathsize="1.110em">~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{L}_{i}</annotation></semantics></math> (outcome model <math id="S3.F2.m16" class="ltx_Math" alttext="\mathbb{E}[\tilde{L}_{i}\mid\bm{W}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>L</mi><mo mathsize="1.110em">~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝑾</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\tilde{L}_{i}\mid\bm{W}_{i}]</annotation></semantics></math>) and the predictor of interest <math id="S3.F2.m17" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math> (surrogacy score <math id="S3.F2.m18" class="ltx_Math" alttext="\mathbb{P}(T_{i}=t\mid\bm{W}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝑾</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(T_{i}=t\mid\bm{W}_{i})</annotation></semantics></math>).</span></figcaption>
</figure>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p">To characterize the behavior of the estimator at the limit, I first derive its efficient influence function. The efficient influence function provides both a framework for semiparametric estimation and a theoretical foundation to characterize asymptotic behavior with optimal variance properties <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib34" title="" class="ltx_ref">Hampel, 1974</a>; <a href="#bib.bib73" title="" class="ltx_ref">Bickel et al., 1993</a>; <a href="#bib.bib49" title="" class="ltx_ref">Vaart, 1998</a>; <a href="#bib.bib27" title="" class="ltx_ref">Tsiatis, 2006</a>)</cite>.</p>
</div>
<div id="Thmtheorem1" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem1.2" class="ltx_text ltx_font_smallcaps">Theorem 1</span></span><span id="Thmtheorem1.3" class="ltx_text ltx_font_smallcaps"> (Efficient Influence Function)</span></h6>
<div id="Thmtheorem1.p1" class="ltx_para">
<p id="Thmtheorem1.p1.2" class="ltx_p"><span id="Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">The efficient influence function for the target parameter under <math id="Thmtheorem1.p1.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> is given by</span></p>
<table id="S3.E5" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E5X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E5X.m2" class="ltx_Math" alttext="\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\rho_{t},\pi_{t},\mu,\bar{m}_{t},\Psi_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><msub><mi>ρ</mi><mi>t</mi></msub><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><mi>μ</mi><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\bm{f},\rho_{t},\pi_{t},\mu,\bar{m}_{t},\Psi_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(5)</span></td></tr>
<tr id="S3.E5Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E5Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo mathsize="2.100em">,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E5Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E5Xb.m2" class="ltx_Math" alttext="\displaystyle+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)+\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem1.p1.3" class="ltx_p"><span id="Thmtheorem1.p1.3.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem1.p1.m2" class="ltx_Math" alttext="\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))=\mathbb{E}[\tilde{L}_{i}\mid\bm{W}_{i}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝐖</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))=\mathbb{E}[\tilde{L}_{i}\mid\bm{W}_{i}]</annotation></semantics></math> is the outcome model given the low-dimensional representation <math id="Thmtheorem1.p1.m3" class="ltx_Math" alttext="\bm{W}_{i}=\bm{f}(\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{i}=\bm{f}(\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math> and the set of control variables <math id="Thmtheorem1.p1.m4" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math>, <math id="Thmtheorem1.p1.m5" class="ltx_Math" alttext="\rho_{t}(\bm{W}_{i})=\mathbb{P}(T_{i}=t\mid\bm{W}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐖</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝐖</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho_{t}(\bm{W}_{i})=\mathbb{P}(T_{i}=t\mid\bm{W}_{i})</annotation></semantics></math> is the surrogacy score model given the low-dimensional representation <math id="Thmtheorem1.p1.m6" class="ltx_Math" alttext="\bm{W}_{i}=\bm{f}(\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐖</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{i}=\bm{f}(\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math>, <math id="Thmtheorem1.p1.m7" class="ltx_Math" alttext="\pi_{t}(\bm{Z}_{i})=\mathbb{P}(T_{i}=t\mid\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{t}(\bm{Z}_{i})=\mathbb{P}(T_{i}=t\mid\bm{Z}_{i})</annotation></semantics></math> is the propensity score model given the set of control variables <math id="Thmtheorem1.p1.m8" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math>, and <math id="Thmtheorem1.p1.m9" class="ltx_Math" alttext="\bar{m}_{t}(\bm{Z}_{i})=\int\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))dF(\bm{Y}_{i}\mid\bm{Z}_{i},T_{i}=t)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝐙</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{m}_{t}(\bm{Z}_{i})=\int\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))dF(\bm{Y}_{i}\mid\bm{Z}_{i},T_{i}=t)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p">The proof is given in Appendix <a href="#A4.SS3" title="S4.3 Proof of Theorem (Efficient Influence Function) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S4.3</span></a>.</p>
</div>
<div id="S3.SS2.p5" class="ltx_para">
<p id="S3.SS2.p5.1" class="ltx_p">Once the efficient influence function is obtained, the asymptotically valid estimator can be constructed. Here, I propose to use a <math id="S3.SS2.p5.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-fold cross-fitting procedure <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib48" title="" class="ltx_ref">van der Laan, 2010</a>; <a href="#bib.bib55" title="" class="ltx_ref">Chernozhukov et al., 2018</a>)</cite>. Suppose that <math id="S3.SS2.p5.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is divisible by <math id="S3.SS2.p5.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. The entire estimation procedure with <math id="S3.SS2.p5.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-fold cross-fitting is summarized as follows.</p>
<ol id="S3.I1" class="ltx_enumerate">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p">Randomly partition the data into <math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> folds of equal size. Let <math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="I(i)=k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">I(i)=k</annotation></semantics></math> be the indicator of the observation <math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> belonging to the fold <math id="S3.I1.i1.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p">For each fold <math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="k\in\{1,\cdots,K\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{1,\cdots,K\}</annotation></semantics></math>, use <math id="S3.I1.i2.p1.m2" class="ltx_Math" alttext="I(i)\neq k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">I(i)\neq k</annotation></semantics></math> as training data:</p>
<ol id="S3.I1.i2.I1" class="ltx_enumerate">
<li id="S3.I1.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S3.I1.i2.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i2.I1.i1.p1.1" class="ltx_p">Estimate the propensity score model <math id="S3.I1.i2.I1.i1.p1.m1" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> using the whole sample with <math id="S3.I1.i2.I1.i1.p1.m2" class="ltx_Math" alttext="I(i)\neq k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">I(i)\neq k</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S3.I1.i2.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.I1.i2.p1.1" class="ltx_p">Split the training data with <math id="S3.I1.i2.I1.i2.p1.m1" class="ltx_Math" alttext="S_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S_{i}=0</annotation></semantics></math> into two halves, say <math id="S3.I1.i2.I1.i2.p1.m2" class="ltx_Math" alttext="I_{-1s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-1s}^{(-k)}</annotation></semantics></math> and <math id="S3.I1.i2.I1.i2.p1.m3" class="ltx_Math" alttext="I_{-2s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-2s}^{(-k)}</annotation></semantics></math>. Let the remaining training data (with <math id="S3.I1.i2.I1.i2.p1.m4" class="ltx_Math" alttext="S_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S_{i}=1</annotation></semantics></math>) be <math id="S3.I1.i2.I1.i2.p1.m5" class="ltx_Math" alttext="I_{s}^{(k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{s}^{(k)}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S3.I1.i2.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i2.I1.i3.p1.1" class="ltx_p">Solve the optimization problem in Equation (<a href="#S3.E4" title="In 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) using the data <math id="S3.I1.i2.I1.i3.p1.m1" class="ltx_Math" alttext="I_{s}^{(k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{s}^{(k)}</annotation></semantics></math> and <math id="S3.I1.i2.I1.i3.p1.m2" class="ltx_Math" alttext="I_{-1s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-1s}^{(-k)}</annotation></semantics></math> and obtain <math id="S3.I1.i2.I1.i3.p1.m3" class="ltx_Math" alttext="\hat{\mu}^{(-k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\hat{\mu}^{(-k)}</annotation></semantics></math> and <math id="S3.I1.i2.I1.i3.p1.m4" class="ltx_Math" alttext="\hat{\rho}_{t}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\rho}_{t}^{(-k)}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(d)</span> 
<div id="S3.I1.i2.I1.i4.p1" class="ltx_para">
<p id="S3.I1.i2.I1.i4.p1.1" class="ltx_p">Regress the obtained <math id="S3.I1.i2.I1.i4.p1.m1" class="ltx_Math" alttext="\hat{\mu}^{(-k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\hat{\mu}^{(-k)}</annotation></semantics></math> on <math id="S3.I1.i2.I1.i4.p1.m2" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> and <math id="S3.I1.i2.I1.i4.p1.m3" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒁</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math> using the data <math id="S3.I1.i2.I1.i4.p1.m4" class="ltx_Math" alttext="I_{-2s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-2s}^{(-k)}</annotation></semantics></math> and obtain <math id="S3.I1.i2.I1.i4.p1.m5" class="ltx_Math" alttext="\hat{\bar{m}}^{(-k)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\hat{\bar{m}}^{(-k)}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div></li>
<li id="S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S3.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i3.p1.1" class="ltx_p">For the level of predictors of interest <math id="S3.I1.i3.p1.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, solve the estimating equation</p>
<table id="S3.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E6.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{n}\sum_{k=1}^{K}\sum_{I(i)=k}\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\bm{f}}^{(-k)},\hat{\rho}_{t}^{(-k)},\hat{\pi}_{t}^{(-k)},\hat{\mu}^{(-k)},\hat{\bar{m}}_{t}^{(-k)},\hat{\Psi}_{t})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></munder></mstyle><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msup><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n}\sum_{k=1}^{K}\sum_{I(i)=k}\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\bm{f}}^{(-k)},\hat{\rho}_{t}^{(-k)},\hat{\pi}_{t}^{(-k)},\hat{\mu}^{(-k)},\hat{\bar{m}}_{t}^{(-k)},\hat{\Psi}_{t})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="S3.I1.i3.p1.2" class="ltx_p">and obtain the estimate of the target parameter <math id="S3.I1.i3.p1.m2" class="ltx_Math" alttext="\hat{\Psi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\Psi}_{t}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="S3.SS2.p6" class="ltx_para">
<p id="S3.SS2.p6.1" class="ltx_p">Finally, I derive the asymptotic normality of the proposed estimator. For this, I assume the following regularity conditions.</p>
</div>
<div id="Thmassumption4" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption4.2" class="ltx_text ltx_font_smallcaps">Assumption 4</span></span><span id="Thmassumption4.3" class="ltx_text ltx_font_smallcaps"> (Regularity Conditions)</span></h6>
<div id="Thmassumption4.p1" class="ltx_para">
<p id="Thmassumption4.p1.1" class="ltx_p"><span id="Thmassumption4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmassumption4.p1.m1" class="ltx_Math" alttext="c_{1}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>1</mn></msub><annotation encoding="application/x-tex">c_{1}</annotation></semantics></math> be a positive constant and <math id="Thmassumption4.p1.m2" class="ltx_Math" alttext="\delta_{n}" display="inline" intent=":literal"><semantics><msub><mi>δ</mi><mi>n</mi></msub><annotation encoding="application/x-tex">\delta_{n}</annotation></semantics></math> be a sequence of positive constants approaching zero as the sample size <math id="Thmassumption4.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> increases.</span></p>
<ol id="S3.I2" class="ltx_enumerate">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S3.I2.i1.p1" class="ltx_para">
<p id="S3.I2.i1.p1.1" class="ltx_p"><span id="S3.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">(Primitive Condition) The labeled outcome is bounded such that </span><math id="S3.I2.i1.p1.m1" class="ltx_Math" alttext="\mathbb{E}\bigl[|\tilde{L}_{i}|^{2}\bigr]^{\frac{1}{2}}\leq c_{1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">\mathbb{E}\bigl[|\tilde{L}_{i}|^{2}\bigr]^{\frac{1}{2}}\leq c_{1}</annotation></semantics></math><span id="S3.I2.i1.p1.1.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S3.I2.i2.p1" class="ltx_para">
<p id="S3.I2.i2.p1.1" class="ltx_p"><span id="S3.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">(Positivity) There exists a fixed constant </span><math id="S3.I2.i2.p1.m1" class="ltx_Math" alttext="c_{2}\in(0,1/2]" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">c_{2}\in(0,1/2]</annotation></semantics></math><span id="S3.I2.i2.p1.1.2" class="ltx_text ltx_font_italic"> such that for all </span><math id="S3.I2.i2.p1.m2" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math></p>
<table id="S3.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex3.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(c_{2}\leq\pi_{t}(\bm{Z}_{i})\leq 1-c_{2})=1,\quad\mathbb{P}(c_{2}\leq\hat{\pi}_{t}(\bm{Z}_{i})\leq 1-c_{2})=1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>c</mi><mn>2</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(c_{2}\leq\pi_{t}(\bm{Z}_{i})\leq 1-c_{2})=1,\quad\mathbb{P}(c_{2}\leq\hat{\pi}_{t}(\bm{Z}_{i})\leq 1-c_{2})=1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i2.p1.2" class="ltx_p"><span id="S3.I2.i2.p1.2.1" class="ltx_text ltx_font_italic">In addition, the estimated surrogacy score is also almost surely bounded so that</span></p>
<table id="S3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex4.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\leq 1)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\leq 1)=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i2.p1.3" class="ltx_p"><span id="S3.I2.i2.p1.3.1" class="ltx_text ltx_font_italic">for all </span><math id="S3.I2.i2.p1.m3" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="S3.I2.i2.p1.3.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S3.I2.i3.p1" class="ltx_para">
<p id="S3.I2.i3.p1.1" class="ltx_p"><span id="S3.I2.i3.p1.1.1" class="ltx_text ltx_font_italic">(Nuisance Functions Estimation) Nuisance functions are consistently estimated so that</span></p>
<table id="S3.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex5.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-{\rho}_{t}({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-{\rho}_{t}({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex5.m2" class="ltx_Math" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-{\rho}_{t}({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-{\rho}_{t}({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex6.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex6.m2" class="ltx_math_unparsed" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i}),\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex7.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex7.m2" class="ltx_Math" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex8.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq c_{1},</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex8.m2" class="ltx_Math" alttext="\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>≤</mo><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\quad\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i3.p1.2" class="ltx_p"><span id="S3.I2.i3.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="S3.I2.i3.p1.m1" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="S3.I2.i3.p1.2.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S3.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(d)</span> 
<div id="S3.I2.i4.p1" class="ltx_para">
<p id="S3.I2.i4.p1.1" class="ltx_p"><span id="S3.I2.i4.p1.1.1" class="ltx_text ltx_font_italic">(Convergence Rate of Cross Product)</span></p>
<table id="S3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex9.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-{\rho}_{t}({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-{\rho}_{t}({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex9.m2" class="ltx_math_unparsed" alttext="\displaystyle\cdot\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/2}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\cdot\mathbb{E}\biggl[\biggl|\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i})-\mu({\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/2}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S3.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.Ex10.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\biggl|\hat{\pi}_{t}(\bm{Z}_{i})-\pi_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.Ex10.m2" class="ltx_math_unparsed" alttext="\displaystyle\cdot\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/2}\delta_{n}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.222em">⋅</mo><mi>𝔼</mi><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><msup><mo fence="false" maxsize="2.100em" minsize="2.100em" rspace="0.167em" stretchy="true">|</mo><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>≤</mo><msup><mi>n</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><msub><mi>δ</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\cdot\mathbb{E}\biggl[\biggl|\hat{\bar{m}}_{t}(\bm{Z}_{i})-\bar{m}_{t}(\bm{Z}_{i})\biggr|^{2}\biggr]^{\frac{1}{2}}\leq n^{-1/2}\delta_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.I2.i4.p1.2" class="ltx_p"><span id="S3.I2.i4.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="S3.I2.i4.p1.m1" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="S3.I2.i4.p1.2.2" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S3.SS2.p7" class="ltx_para">
<p id="S3.SS2.p7.1" class="ltx_p">These are the standard conditions in the literature on semiparametric inference <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib58" title="" class="ltx_ref">Newey and McFadden, 1994</a>; <a href="#bib.bib48" title="" class="ltx_ref">van der Laan, 2010</a>; <a href="#bib.bib55" title="" class="ltx_ref">Chernozhukov et al., 2018</a>)</cite>, but they become difficult to verify when high-dimensional unstructured data are used directly as input. A common strategy is to project texts onto low-dimensional representations via pretrained embeddings, such as Bidirectional Encoder Representations from Transformers (BERT; <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib37" title="" class="ltx_ref">Devlin et al. 2019</a></cite>) or ModernBERT <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib24" title="" class="ltx_ref">Warner et al., 2024</a>)</cite>. Although these embeddings capture much of the textual content, their statistical properties remain poorly understood, and estimation errors may arise in practice.
If users care about the estimation loss from the embedding, a more principled alternative is to use the internal representation of the generative models, such as LLMs <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib29" title="" class="ltx_ref">Imai and Nakamura, 2024</a>)</cite>. When a model can faithfully reconstruct an input <math id="S3.SS2.p7.m1" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒀</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math>, the internal representation that actually generates the data can be extracted without any estimation error. Thus, if users can extract the internal representations of the generative models, these error‐free latent vectors can then be fed into the standard feed‐forward network with ReLU activations with sufficient depth and width, for which there is a convergence rate guarantee <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Bauer and Kohler, 2019</a>; <a href="#bib.bib20" title="" class="ltx_ref">Schmidt-Hieber, 2020</a>; <a href="#bib.bib28" title="" class="ltx_ref">Farrell et al., 2021</a>)</cite>.</p>
</div>
<div id="S3.SS2.p8" class="ltx_para">
<p id="S3.SS2.p8.1" class="ltx_p">Given the stated regularity condition, the asymptotic normality of the proposed estimator can be derived as follows.</p>
</div>
<div id="Thmtheorem2" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem2.2" class="ltx_text ltx_font_smallcaps">Theorem 2</span></span><span id="Thmtheorem2.3" class="ltx_text ltx_font_smallcaps"> (Asymptotic Normality)</span></h6>
<div id="Thmtheorem2.p1" class="ltx_para">
<p id="Thmtheorem2.p1.1" class="ltx_p"><span id="Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Under Assumptions <a href="#Thmassumption1" title="Assumption 1 (True Coding Rule) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>–<a href="#Thmassumption4" title="Assumption 4 (Regularity Conditions) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, the estimator for the covariate-adjusted outcome mean <math id="Thmtheorem2.p1.m1" class="ltx_Math" alttext="\hat{\Psi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\Psi}_{t}</annotation></semantics></math> obtained by solving the estimating equations in Equation (<a href="#S3.E6" title="In item 3 ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) for <math id="Thmtheorem2.p1.m2" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math> satisfies asymptotic normality:</span></p>
<table id="S3.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex11.m1" class="ltx_Math" alttext="\frac{\sqrt{n}(\hat{\Psi}_{t}-\Psi_{t})}{\sigma}\xrightarrow{d}\mathcal{n}(0,1)" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>σ</mi></mfrac><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑑</mo></mover><mrow><mi class="ltx_font_mathcaligraphic">𝓃</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\sqrt{n}(\hat{\Psi}_{t}-\Psi_{t})}{\sigma}\xrightarrow{d}\mathcal{n}(0,1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem2.p1.2" class="ltx_p"><span id="Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem2.p1.m3" class="ltx_Math" alttext="\sigma^{2}=\mathbb{E}\bigl[\bigl(\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})\bigr)^{2}\bigr]." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma^{2}=\mathbb{E}\bigl[\bigl(\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})\bigr)^{2}\bigr].</annotation></semantics></math></span></p>
</div>
</div>
<div id="S3.SS2.p9" class="ltx_para">
<p id="S3.SS2.p9.1" class="ltx_p">The proof is provided in Appendix <a href="#A4.SS4" title="S4.4 Proof of Theorem (Asymptotic Normality) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S4.4</span></a>.
One drawback of this approach is that it disregards the machine learning predictions for the text feature of interest, even though these are often relatively easy to obtain. Accordingly, Appendix <a href="#A3" title="Appendix S3 Extension: Use of Machine Learning Predictions ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S3</span></a> considers a setting where such predictions are available, and I propose an estimation strategy that leverages the full set of observations by incorporating the machine learning predictions.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Extension: The Proposed Methodology with Noisy Human Annotations</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">The methodology described in the previous section enables the estimation under the assumption that human annotations contain no errors (Assumption <a href="#Thmassumption2" title="Assumption 2 (Perfect Annotations) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>). Although this assumption is common in the literature, human coders may still make random mistakes even when the coding rule is clearly defined.
Given that some amount of perfectly labeled data is required to obtain the sufficient statistical power, this limitation can be particularly problematic for real-world applications.</p>
</div>
<div id="S4.p2" class="ltx_para">
<p id="S4.p2.1" class="ltx_p">In this section, I extend the SRI framework in the previous section to relax the assumption of the perfect human annotations using the recent literature of double negative control (e.g., <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib31" title="" class="ltx_ref">Hu and Schennach 2008</a>; <a href="#bib.bib40" title="" class="ltx_ref">Kuroki and Pearl 2014</a>; <a href="#bib.bib39" title="" class="ltx_ref">Miao et al. 2018</a>; <a href="#bib.bib41" title="" class="ltx_ref">Tchetgen et al. 2020</a>; <a href="#bib.bib70" title="" class="ltx_ref">Zhou and Tchetgen 2024</a></cite>). Specifically, I propose a methodology that requires multiple, but potentially incorrect, human annotations and still performs the efficient statistical inference. As before, I state assumptions, identification, and estimation strategies. I also write about the practical guidance for applied researchers about how to diagnose the required assumptions that are not guaranteed by design.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Assumptions and nonparametric identification</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Consider the same setting as in the previous section, except that the true label <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="L_{i}\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">L_{i}\in\mathcal{L}</annotation></semantics></math> is assumed to be discrete. For simplicity, let <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="\mathcal{L}=\{0,\cdots,C\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>C</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}=\{0,\cdots,C\}</annotation></semantics></math> with some constant <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="C&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">C&lt;\infty</annotation></semantics></math>. Instead of assuming the perfect annotations, suppose that there are <math id="S4.SS1.p1.m4" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> coders who independently label texts <math id="S4.SS1.p1.m5" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒀</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math>. Let <math id="S4.SS1.p1.m6" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}\in\mathcal{L}</annotation></semantics></math> be a label coded by the coder <math id="S4.SS1.p1.m7" class="ltx_Math" alttext="j\in\{1,\cdots,J\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>J</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\cdots,J\}</annotation></semantics></math>. As before, I use <math id="S4.SS1.p1.m8" class="ltx_Math" alttext="S_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S_{i}=1</annotation></semantics></math> if <math id="S4.SS1.p1.m9" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}</annotation></semantics></math> is observed for all coders. Importantly, I allow for the possibility that <math id="S4.SS1.p1.m10" class="ltx_Math" alttext="\tilde{L}^{(j)}_{i}\neq L_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≠</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\tilde{L}^{(j)}_{i}\neq L_{i}</annotation></semantics></math> for any <math id="S4.SS1.p1.m11" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="S4.SS1.p1.m12" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, meaning that coders can make mistakes. For simplicity, I assume <math id="S4.SS1.p1.m13" class="ltx_Math" alttext="J=2" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">J=2</annotation></semantics></math> (i.e., two human coders) for the remainder of this section, but the method can be generalized to the case of multiple coders.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">The goal is to identify the same target parameter from the previous section using only the human-annotated labels <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\tilde{L}_{i}^{(j)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\tilde{L}_{i}^{(j)}</annotation></semantics></math> for <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="j=\{1,2\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j=\{1,2\}</annotation></semantics></math>, which are observed only for the part of the corpus and can be incorrect (i.e., <math id="S4.SS1.p2.m3" class="ltx_Math" alttext="\tilde{L}_{i}^{(j)}\neq L_{i}=g_{L}(\bm{Y}_{i})" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≠</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>g</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{L}_{i}^{(j)}\neq L_{i}=g_{L}(\bm{Y}_{i})</annotation></semantics></math>). As the annotations may contain mistakes, I assume the following for the sake of formalization.</p>
</div>
<div id="Thmassumption5" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption5.2" class="ltx_text ltx_font_smallcaps">Assumption 5</span></span><span id="Thmassumption5.3" class="ltx_text ltx_font_smallcaps"> (Human Annotation Sampling)</span></h6>
<div id="Thmassumption5.p1" class="ltx_para">
<p id="Thmassumption5.p1.1" class="ltx_p"><span id="Thmassumption5.p1.1.1" class="ltx_text ltx_font_italic">Human coders annotate a subset of texts that are randomly sampled from the entire corpus such that</span></p>
<table id="S4.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E7.m1" class="ltx_Math" alttext="\displaystyle\tilde{L}_{i}^{(j)}\;\mbox{$\perp\!\!\!\perp$}\;S_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.558em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{L}_{i}^{(j)}\;\mbox{$\perp\!\!\!\perp$}\;S_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="Thmassumption5.p1.2" class="ltx_p"><span id="Thmassumption5.p1.2.1" class="ltx_text ltx_font_italic">for all coders <math id="Thmassumption5.p1.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> with <math id="Thmassumption5.p1.m2" class="ltx_Math" alttext="\mathbb{P}(S_{i}=1)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{P}(S_{i}=1)&gt;0</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="Thmassumption6" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption6.2" class="ltx_text ltx_font_smallcaps">Assumption 6</span></span><span id="Thmassumption6.3" class="ltx_text ltx_font_smallcaps"> (Noisy Human Annotations)</span></h6>
<div id="Thmassumption6.p1" class="ltx_para">
<p id="Thmassumption6.p1.1" class="ltx_p"><span id="Thmassumption6.p1.1.1" class="ltx_text ltx_font_italic">Each coder <math id="Thmassumption6.p1.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> annotates <math id="Thmassumption6.p1.m2" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐘</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math> solely based on the information within <math id="Thmassumption6.p1.m3" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐘</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math> so that</span></p>
<table id="S4.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E8.m1" class="ltx_Math" alttext="\displaystyle\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ \bm{Z}_{i}\ \mid\ \bm{Y}_{i}\quad\text{and}\quad\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ T_{i}\ \mid\ \bm{Y}_{i},\ \bm{Z}_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.778em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo fence="false">|</mo><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">and</mtext></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>i</mi></msub></mrow><mo fence="false">|</mo><msub><mi>𝒀</mi><mi>i</mi></msub></mrow><mo rspace="0.667em">,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ \bm{Z}_{i}\ \mid\ \bm{Y}_{i}\quad\text{and}\quad\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ T_{i}\ \mid\ \bm{Y}_{i},\ \bm{Z}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
<p id="Thmassumption6.p1.2" class="ltx_p"><span id="Thmassumption6.p1.2.1" class="ltx_text ltx_font_italic">for all <math id="Thmassumption6.p1.m4" class="ltx_Math" alttext="j\in\{1,\cdots,J\}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>J</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">j\in\{1,\cdots,J\}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p">These assumptions do not substantially increase the practical burden compared to the previous setting. In particular, they can be satisfied if (1) researchers randomly select the texts to be annotated, (2) human coders do not directly observe the predictors of interest, and (3) the structured variable of interest <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="T_{i}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>i</mi></msub><annotation encoding="application/x-tex">T_{i}</annotation></semantics></math> is not coded by annotators. Unlike the earlier case, the third condition is essential here because annotated variables may otherwise remain correlated even after conditioning on texts. For instance, if coders classify both the speaker’s party affiliation and the tone of a speech, the classification errors in these two variables can be correlated even after conditioning on the text itself.</p>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<p id="S4.SS1.p4.1" class="ltx_p">I then impose restrictions on the human annotations and the unobserved true label. While the human annotations may differ from the true label for some observations, I assume that (1) the mistakes made by each coder is independent and (2) the only way for texts to influence the human coding is through the true label. This is formally stated as follows:</p>
</div>
<div id="Thmassumption7" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption7.2" class="ltx_text ltx_font_smallcaps">Assumption 7</span></span><span id="Thmassumption7.3" class="ltx_text ltx_font_smallcaps"> (Conditional Independence of Human Annotations)</span></h6>
<div id="Thmassumption7.p1" class="ltx_para">
<p id="Thmassumption7.p1.1" class="ltx_p"><span id="Thmassumption7.p1.1.1" class="ltx_text ltx_font_italic">The human-annotated labels <math id="Thmassumption7.p1.m1" class="ltx_math_unparsed" alttext="\{\tilde{L}^{(j)}_{i}:j=1,\cdots J\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>j</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\tilde{L}^{(j)}_{i}:j=1,\cdots J\}</annotation></semantics></math> and the true label <math id="Thmassumption7.p1.m2" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> satisfy the followings:</span></p>
<ol id="S4.I1" class="ltx_enumerate">
<li id="S4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S4.I1.i1.p1" class="ltx_para">
<p id="S4.I1.i1.p1.1" class="ltx_p"><span id="S4.I1.i1.p1.1.1" class="ltx_text ltx_font_italic">(Independent Coding) For all pair of </span><math id="S4.I1.i1.p1.m1" class="ltx_Math" alttext="j,j^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">j,j^{\prime}</annotation></semantics></math><span id="S4.I1.i1.p1.1.2" class="ltx_text ltx_font_italic"> with </span><math id="S4.I1.i1.p1.m2" class="ltx_Math" alttext="j\neq j^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><msup><mi>j</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">j\neq j^{\prime}</annotation></semantics></math><span id="S4.I1.i1.p1.1.3" class="ltx_text ltx_font_italic">,</span></p>
<table id="S4.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E9.m1" class="ltx_Math" alttext="\displaystyle\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ \tilde{L}_{i}^{(j^{\prime})}\mid L_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.778em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo fence="false">|</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{L}_{i}^{(j)}\ \mbox{$\perp\!\!\!\perp$}\ \tilde{L}_{i}^{(j^{\prime})}\mid L_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div></li>
<li id="S4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S4.I1.i2.p1" class="ltx_para">
<p id="S4.I1.i2.p1.1" class="ltx_p"><span id="S4.I1.i2.p1.1.1" class="ltx_text ltx_font_italic">(Exclusion Restriction) For all human coders </span><math id="S4.I1.i2.p1.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="S4.I1.i2.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
<table id="S4.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E10.m1" class="ltx_Math" alttext="\displaystyle\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \tilde{L}_{i}^{(j)}\ \mid\ L_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo lspace="0.778em" rspace="0em">​</mo><mrow><mpadded style="width:0.240em;" width="0.240em"><mo>⟂</mo></mpadded><mo>⁣</mo><mo>⟂</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo fence="false">|</mo><msub><mi>L</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\bm{Y}_{i}\ \mbox{$\perp\!\!\!\perp$}\ \tilde{L}_{i}^{(j)}\ \mid\ L_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS1.p5" class="ltx_para">
<p id="S4.SS1.p5.1" class="ltx_p">Figure <a href="#S4.F3" title="Figure 3 ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> illustrates the required independence assumptions graphically. These two independence constraints in Assumption <a href="#Thmassumption7" title="Assumption 7 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> fundamentally require that errors in observed human annotations be completely non‑differential (i.e., the measurement error does not depend on true annotations <math id="S4.SS1.p5.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> or the contents of texts <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="\bm{Y}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒀</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Y}_{i}</annotation></semantics></math>). This essentially requires that the errors arise from pure mistakes or inattention rather than systematic biases related to the content of the texts. When mistakes are non‑differential, the coding errors from each coder are independent, satisfying the independent‑coding assumption. The exclusion restriction is also plausible when only the concept of interest in the text influences human annotation, which is reasonable when mistakes are random. Note that Assumption <a href="#Thmassumption7" title="Assumption 7 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> cannot be relaxed by conditioning on covariates <math id="S4.SS1.p5.m3" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒁</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math>, as they provide no additional information under Assumption <a href="#Thmassumption6" title="Assumption 6 (Noisy Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>.</p>
</div>
<figure id="S4.F3" class="ltx_figure"><span class="ltx_inline-block"><svg id="S4.F3.pic1" class="ltx_picture ltx_centering" height="156.52" overflow="visible" version="1.1" viewBox="0 0 346.66 156.52" width="346.66"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="translate(0,156.52) matrix(1 0 0 -1 0 0) translate(13.93,0) translate(0,78.31)"><path style="fill:none" d="M 13.38 0 C 13.38 7.39 7.39 13.38 0 13.38 C -7.39 13.38 -13.38 7.39 -13.38 0 C -13.38 -7.39 -7.39 -13.38 0 -13.38 C 7.39 -13.38 13.38 -7.39 13.38 0 Z M 0 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -5 -4.73)"><foreignObject style="--ltx-fo-width:0.72em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="10.01"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 141.77 0 C 141.77 7.97 135.31 14.43 127.34 14.43 C 119.37 14.43 112.91 7.97 112.91 0 C 112.91 -7.97 119.37 -14.43 127.34 -14.43 C 135.31 -14.43 141.77 -7.97 141.77 0 Z M 127.34 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 120.9 -4.75)"><foreignObject style="--ltx-fo-width:0.93em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="12.87"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m2" class="ltx_Math" alttext="\bm{Y}" display="inline" intent=":literal"><semantics><mi>𝒀</mi><annotation encoding="application/x-tex">\bm{Y}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-fill-color:#BFBFBF;" fill="#BFBFBF"><path d="M 267.72 0 C 267.72 7.3 261.8 13.21 254.51 13.21 C 247.21 13.21 241.3 7.3 241.3 0 C 241.3 -7.3 247.21 -13.21 254.51 -13.21 C 261.8 -13.21 267.72 -7.3 267.72 0 Z M 254.51 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 249.8 -4.73)"><foreignObject style="--ltx-fo-width:0.68em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="9.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 332.17 58.48 C 332.17 69.08 323.59 77.66 312.99 77.66 C 302.4 77.66 293.81 69.08 293.81 58.48 C 293.81 47.89 302.4 39.3 312.99 39.3 C 323.59 39.3 332.17 47.89 332.17 58.48 Z M 312.99 58.48"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 301.72 52.34)"><foreignObject style="--ltx-fo-width:1.63em;--ltx-fo-height:0.89em;--ltx-fo-depth:0em;font-size:10pt;" height="12.29" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="22.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m4" class="ltx_Math" alttext="\tilde{L}^{(1)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{L}^{(1)}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 332.17 -58.48 C 332.17 -47.89 323.59 -39.3 312.99 -39.3 C 302.4 -39.3 293.81 -47.89 293.81 -58.48 C 293.81 -69.08 302.4 -77.66 312.99 -77.66 C 323.59 -77.66 332.17 -69.08 332.17 -58.48 Z M 312.99 -58.48"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 301.72 -64.63)"><foreignObject style="--ltx-fo-width:1.63em;--ltx-fo-height:0.89em;--ltx-fo-depth:0em;font-size:10pt;" height="12.29" overflow="visible" transform="matrix(1 0 0 -1 0 12.29)" width="22.54"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m5" class="ltx_Math" alttext="\tilde{L}^{(2)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{L}^{(2)}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 77.66 -63.76 C 77.66 -56.03 71.4 -49.77 63.67 -49.77 C 55.94 -49.77 49.68 -56.03 49.68 -63.76 C 49.68 -71.49 55.94 -77.75 63.67 -77.75 C 71.4 -77.75 77.66 -71.49 77.66 -63.76 Z M 63.67 -63.76"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 57.84 -68.51)"><foreignObject style="--ltx-fo-width:0.84em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.49" overflow="visible" transform="matrix(1 0 0 -1 0 9.49)" width="11.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m6" class="ltx_Math" alttext="\bm{Z}" display="inline" intent=":literal"><semantics><mi>𝒁</mi><annotation encoding="application/x-tex">\bm{Z}</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 13.93 0 L 106.4 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 103.22 0)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><g style="--ltx-stroke-color:#FF0000;--ltx-fill-color:#FF0000;" fill="#FF0000" stroke="#FF0000"><g style="--ltx-fg-color:#FF0000;" color="#FF0000" stroke-width="2.20001pt"><path style="fill:none" d="M 142.32 0 L 233.61 0"></path></g><g style="--ltx-stroke-color:#FFFFFF;--ltx-fg-color:#FF0000;" color="#FF0000" stroke="#FFFFFF" stroke-width="0.6pt"><path style="fill:none" d="M 142.32 0 L 233.61 0"></path></g><g style="--ltx-fg-color:#FF0000;" color="#FF0000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 229.87 0)"><path d="M 9.4 0 L 1.79 2.84 L 4.01 0 L 1.79 -2.84 Z"></path></g></g><path style="fill:none" d="M 53.39 -53.47 L 14.06 -14.08"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-0.7066 0.7076 -0.7076 -0.7066 16.3 -16.32)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><path style="fill:none" d="M 73.95 -53.47 L 112.54 -14.82"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.7066 0.7076 -0.7076 0.7066 110.3 -17.06)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><path style="fill:none" d="M 264.24 9.73 L 294.82 40.31"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.7071 0.7071 -0.7071 0.7071 292.58 38.07)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g><path style="fill:none" d="M 264.24 -9.73 L 294.82 -40.31"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(0.7071 -0.7071 0.7071 0.7071 292.58 -38.07)"><path d="M 7.66 0 L 1.79 2.18 L 3.45 0 L 1.79 -2.18 Z"></path></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.3" class="ltx_text" style="font-size:90%;">Figure 3</span>: </span><span id="S4.F3.4" class="ltx_text" style="font-size:90%;">The diagram illustrates the assumptions for the proposed method when human annotations may differ from the unobserved true label of interest. <math id="S4.F3.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> denotes the predictors of interest, <math id="S4.F3.m9" class="ltx_Math" alttext="\bm{Y}" display="inline" intent=":literal"><semantics><mi>𝒀</mi><annotation encoding="application/x-tex">\bm{Y}</annotation></semantics></math> denotes the texts (outcomes), <math id="S4.F3.m10" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> represents the unobserved true concept of interest, and <math id="S4.F3.m11" class="ltx_Math" alttext="\bm{Z}" display="inline" intent=":literal"><semantics><mi>𝒁</mi><annotation encoding="application/x-tex">\bm{Z}</annotation></semantics></math> denotes the set of control variables. <math id="S4.F3.m12" class="ltx_Math" alttext="\tilde{L}^{(j)}" display="inline" intent=":literal"><semantics><msup><mover accent="true"><mi>L</mi><mo mathsize="1.110em">~</mo></mover><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\tilde{L}^{(j)}</annotation></semantics></math> indicates the human-annotated labels provided by coder <math id="S4.F3.m13" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> (<math id="S4.F3.m14" class="ltx_Math" alttext="j=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j=1,2</annotation></semantics></math>). An arrow with red double lines represents a deterministic relationship, while an arrow with a single line indicates a potentially stochastic relationship. White nodes correspond to observed variables, whereas gray nodes indicate unobserved variables.</span></figcaption>
</figure>
<div id="S4.SS1.p6" class="ltx_para">
<p id="S4.SS1.p6.1" class="ltx_p">To better understand how Assumption <a href="#Thmassumption7" title="Assumption 7 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a> may be violated, consider the example from Section <a href="#S2" title="2 Motivating Example: Framing of Immigrants in the U.S. Congress ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> of classifying the tones of congressional speeches on immigration. Suppose researchers classify speeches as pro‑immigration as long as any part of the speech values immigrants or favors less restrictive policies. However, if coders interpret speeches as pro‑immigration only when they both value immigrants and favor less restrictive policies, then the text content directly influences the pattern of human coders’ annotations without being fully mediated by the researchers’ definition of the label concept, thus violating the exclusion restriction assumption.</p>
</div>
<div id="S4.SS1.p7" class="ltx_para">
<p id="S4.SS1.p7.1" class="ltx_p">In most cases, violations of both assumptions stem from vaguely specified coding rules. When coding guidelines cannot provide specific instructions for classifying each text, coders may attempt to fill these gaps using their own reasoning and procedures. However, these well‑intentioned efforts lead to violations of Assumption <a href="#Thmassumption7" title="Assumption 7 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>. Conversely, when coding rules clearly specify classification criteria for each text type so that texts can be classified almost deterministically, most errors should result from random mistakes rather than systematic biases. Therefore, researchers must craft clear, unambiguous coding guidelines to maintain this assumption. I discuss procedures for testing this assumption and refining coding rules in Appendix <a href="#A2" title="Appendix S2 How to test assumptions in Section that are not guaranteed by design ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S2</span></a>.</p>
</div>
<div id="S4.SS1.p8" class="ltx_para">
<p id="S4.SS1.p8.1" class="ltx_p">Lastly, I assume that human labels are accurate and humans agree on their annotations most of the time. This is formalized as follows.</p>
</div>
<div id="Thmassumption8" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmassumption8.2" class="ltx_text ltx_font_smallcaps">Assumption 8</span></span><span id="Thmassumption8.3" class="ltx_text ltx_font_smallcaps"> (Accuracy of Human Annotations)</span></h6>
<div id="Thmassumption8.p1" class="ltx_para">
<p id="Thmassumption8.p1.1" class="ltx_p"><span id="Thmassumption8.p1.1.1" class="ltx_text ltx_font_italic">The human-annotated labels <math id="Thmassumption8.p1.m1" class="ltx_math_unparsed" alttext="\{\tilde{L}^{(j)}_{i}:j=1,\cdots J\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>j</mi><mo>=</mo><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mi>J</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\tilde{L}^{(j)}_{i}:j=1,\cdots J\}</annotation></semantics></math> and the true label <math id="Thmassumption8.p1.m2" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> satisfy the followings:</span></p>
<ol id="S4.I2" class="ltx_enumerate">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p"><span id="S4.I2.i1.p1.1.1" class="ltx_text ltx_font_italic">(Accurate Human Labeling) Human coders are more likely to correctly annotate the true label so that</span></p>
<table id="S4.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E11.m1" class="ltx_Math" alttext="\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i}=l)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>l</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i}=l)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E11.m2" class="ltx_Math" alttext="\displaystyle&gt;0.5" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\displaystyle&gt;0.5</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="S4.I2.i1.p1.2" class="ltx_p"><span id="S4.I2.i1.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="l\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">l\in\mathcal{L}</annotation></semantics></math><span id="S4.I2.i1.p1.2.2" class="ltx_text ltx_font_italic"> and all coders </span><math id="S4.I2.i1.p1.m2" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="S4.I2.i1.p1.2.3" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p"><span id="S4.I2.i2.p1.1.1" class="ltx_text ltx_font_italic">(Human Labeling Agreements) Human coders generally agree on their labeling so that</span></p>
<table id="S4.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E12.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=\tilde{L}_{i}^{(j^{\prime})}=l,T_{i}=t\mid\bm{Z}_{i},S_{i}=1)\geq\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}^{(j)}=l^{\prime},\tilde{L}^{(j^{\prime})}=l,T_{i}=t\mid S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>≥</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>≠</mo><msup><mi>l</mi><mo>′</mo></msup></mrow></munder></mstyle><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mi>l</mi><mo>′</mo></msup><mo>,</mo><msup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>l</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}_{i}^{(j)}=\tilde{L}_{i}^{(j^{\prime})}=l,T_{i}=t\mid\bm{Z}_{i},S_{i}=1)\geq\sum_{l\neq l^{\prime}}\mathbb{P}(\tilde{L}^{(j)}=l^{\prime},\tilde{L}^{(j^{\prime})}=l,T_{i}=t\mid S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="S4.I2.i2.p1.2" class="ltx_p"><span id="S4.I2.i2.p1.2.1" class="ltx_text ltx_font_italic">for all </span><math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="l\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">l\in\mathcal{L}</annotation></semantics></math><span id="S4.I2.i2.p1.2.2" class="ltx_text ltx_font_italic">, </span><math id="S4.I2.i2.p1.m2" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math><span id="S4.I2.i2.p1.2.3" class="ltx_text ltx_font_italic"> and pair of coders </span><math id="S4.I2.i2.p1.m3" class="ltx_Math" alttext="(j,j^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>j</mi><mo>,</mo><msup><mi>j</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(j,j^{\prime})</annotation></semantics></math><span id="S4.I2.i2.p1.2.4" class="ltx_text ltx_font_italic"> with </span><math id="S4.I2.i2.p1.m4" class="ltx_Math" alttext="j\neq j^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≠</mo><msup><mi>j</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">j\neq j^{\prime}</annotation></semantics></math><span id="S4.I2.i2.p1.2.5" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
</ol>
</div>
</div>
<div id="S4.SS1.p9" class="ltx_para">
<p id="S4.SS1.p9.1" class="ltx_p">Although these assumptions may appear restrictive, Equation (<a href="#S4.E12" title="In item 2 ‣ Assumption 8 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) involves only the observed quantities and is thus directly testable. The only untestable component is Equation (<a href="#S4.E11" title="In item 1 ‣ Assumption 8 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>). This assumption is satisfied as long as humans correctly label more than half of the texts. The assumption does not require perfection and humans can still make mistakes, but it requires that their labels be biased toward the truth, which is critical for correcting errors when combining annotations from multiple human coders.</p>
</div>
<div id="S4.SS1.p10" class="ltx_para">
<p id="S4.SS1.p10.1" class="ltx_p">Under this setup, the distribution of the covariate-adjusted outcome mean can be nonparametrically identified by leveraging two or more human coding as proxies, which can then be used to identify the covariate-adjusted mean of the unobserved true label.</p>
</div>
<div id="Thmproposition2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmproposition2.2" class="ltx_text ltx_font_smallcaps">Proposition 2</span></span><span id="Thmproposition2.3" class="ltx_text ltx_font_smallcaps"> (Identification without Perfect Human Annotations)</span></h6>
<div id="Thmproposition2.p1" class="ltx_para">
<p id="Thmproposition2.p1.1" class="ltx_p"><span id="Thmproposition2.p1.1.1" class="ltx_text ltx_font_italic">Under Assumptions <a href="#Thmassumption1" title="Assumption 1 (True Coding Rule) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, <a href="#Thmassumption3" title="Assumption 3 (Human Annotation Sampling) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, <a href="#Thmassumption5" title="Assumption 5 (Human Annotation Sampling) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>–<a href="#Thmassumption8" title="Assumption 8 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>, I can uniquely identify the distribution of the covariate-adjusted outcome mean under <math id="Thmproposition2.p1.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math>, i.e.,</span></p>
<table id="S4.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex12.m1" class="ltx_Math" alttext="\displaystyle\Psi_{t,c}:=\int\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo>:=</mo><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\Psi_{t,c}:=\int\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i})dF(\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmproposition2.p1.2" class="ltx_p"><span id="Thmproposition2.p1.2.1" class="ltx_text ltx_font_italic">from the observed data.</span></p>
</div>
</div>
<div id="S4.SS1.p11" class="ltx_para">
<p id="S4.SS1.p11.1" class="ltx_p">The proof is given in Appendix <a href="#A4.SS5" title="S4.5 Proof of Proposition (Identification with Noisy Human Annotations) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S4.5</span></a>.</p>
</div>
<div id="S4.SS1.p12" class="ltx_para">
<p id="S4.SS1.p12.1" class="ltx_p">The essence of identification is as follows. Under Assumption <a href="#Thmassumption7" title="Assumption 7 (Conditional Independence of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, for all <math id="S4.SS1.p12.m1" class="ltx_Math" alttext="l,m\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>,</mo><mi>m</mi></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">l,m\in\mathcal{L}</annotation></semantics></math> and <math id="S4.SS1.p12.m2" class="ltx_Math" alttext="\bm{z}\in\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><mi>𝒛</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><annotation encoding="application/x-tex">\bm{z}\in\mathcal{Z}</annotation></semantics></math>,</p>
<table id="S4.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex13.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m,T_{i}=t\mid\bm{Z}_{i}=\bm{z},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m,T_{i}=t\mid\bm{Z}_{i}=\bm{z},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex14.m1" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(T_{i}=t\mid L_{i}=c,\bm{Z}_{i}=\bm{z})\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo>,</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(T_{i}=t\mid L_{i}=c,\bm{Z}_{i}=\bm{z})\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p12.2" class="ltx_p">and</p>
<table id="S4.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex15.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid\bm{Z}_{i}=\bm{z},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid\bm{Z}_{i}=\bm{z},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex16.m1" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p12.3" class="ltx_p">These two factorizations construct the system of equations. In this system, the left-hand sides of both equations are observable and the three terms on the right-hand sides
(i.e., <math id="S4.SS1.p12.m3" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)</annotation></semantics></math>,
<math id="S4.SS1.p12.m4" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)</annotation></semantics></math>, and
<math id="S4.SS1.p12.m5" class="ltx_Math" alttext="\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(L_{i}=c\mid\bm{Z}_{i}=\bm{z})</annotation></semantics></math>)
are shared between equations. Since the number of equations exceeds the number of unknown parameters, the system is usually identifiable only up to scaling and permutation. However, because the coder classification probabilities <math id="S4.SS1.p12.m6" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(j)}_{i}=l\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(j)}_{i}=l\mid L_{i}=c)</annotation></semantics></math> sum to one across all categories (by definition of probability) and attain their maximum at <math id="S4.SS1.p12.m7" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}=c)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}=c)</annotation></semantics></math> (Assumption <a href="#Thmassumption8" title="Assumption 8 (Accuracy of Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>), all unknown parameters are in fact identified. Once the coder-specific error rates are recovered for all coders, the target quantity can be obtained by another factorization</p>
<table id="S4.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex17.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid T_{i}=t,\bm{Z}_{i}=\bm{z},S_{i}=1)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}(\tilde{L}^{(1)}_{i}=l,\tilde{L}^{(2)}_{i}=m\mid T_{i}=t,\bm{Z}_{i}=\bm{z},S_{i}=1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex18.m1" class="ltx_Math" alttext="\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>c</mi><mo>=</mo><mn>0</mn></mrow><mi>C</mi></munderover></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>ℙ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>m</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{c=0}^{C}\mathbb{P}(\tilde{L}^{(1)}_{i}=l\mid L_{i}=c)\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i}=\bm{z})\mathbb{P}(\tilde{L}^{(2)}_{i}=m\mid L_{i}=c),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p12.4" class="ltx_p">where the only unknown is <math id="S4.SS1.p12.m8" class="ltx_Math" alttext="\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i}=\bm{z})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(L_{i}=c\mid T_{i}=t,\bm{Z}_{i}=\bm{z})</annotation></semantics></math>, which is used to calculate the parameter of interest.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Estimation and inference</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">Given the identification result, I next turn to estimation and inference. The main challenge here is that the true label <math id="S4.SS2.p1.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> is not observed, so it cannot be used to learn the low-dimensional surrogate representation in the same way as in the previous section. To address this, I introduce the surrogate outcome</p>
<table id="S4.Ex19" class="ltx_equationgroup ltx_eqn_table">

<tbody id="S4.Ex19X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex19X.m2" class="ltx_Math" alttext="\displaystyle M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.Ex19Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex19Xa.m2" class="ltx_Math" alttext="\displaystyle=\biggl(\frac{\mathbbm{1}\{\tilde{L}^{(1)}_{i}=c\}-\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}_{i}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbbm{1}\{\tilde{L}_{i}^{(2)}=c\}-\mathbb{P}(\tilde{L}^{(2)}_{i}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}_{i}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}_{i}^{(2)}=c\mid L_{i}\neq c)}\biggl)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo><mo>−</mo><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>L</mi><msub><mrow></mrow><mi>i</mi></msub><mo>≠</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em" rspace="0em">)</mo><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msub><mrow></mrow><mi>i</mi></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo><mo>−</mo><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>L</mi><msub><mrow></mrow><mi>i</mi></msub><mo>≠</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo lspace="0em" mathsize="2.100em">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\biggl(\frac{\mathbbm{1}\{\tilde{L}^{(1)}_{i}=c\}-\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}_{i}^{(1)}=c\mid L_{i}\neq c)}\biggl)\biggl(\frac{\mathbbm{1}\{\tilde{L}_{i}^{(2)}=c\}-\mathbb{P}(\tilde{L}^{(2)}_{i}=c\mid L_{i}\neq c)}{\mathbb{P}(\tilde{L}_{i}^{(2)}=c\mid L_{i}=c)-\mathbb{P}(\tilde{L}_{i}^{(2)}=c\mid L_{i}\neq c)}\biggl)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p1.2" class="ltx_p">for all levels of categories <math id="S4.SS2.p1.m2" class="ltx_Math" alttext="c\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">c\in\mathcal{L}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">Crucially, this surrogate outcome is identifiable and can be estimated from the data. Specifically, each coder <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>’s classification accuracy, <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i})" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i})</annotation></semantics></math>, is recovered using the system of equations in Proposition <a href="#Thmproposition2" title="Proposition 2 (Identification without Perfect Human Annotations) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Although the identification formula holds for any value of the predictor <math id="S4.SS2.p2.m3" class="ltx_Math" alttext="t\in\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">t\in\{0,1\}</annotation></semantics></math>, precision improves when estimates are averaged across all levels. Once <math id="S4.SS2.p2.m4" class="ltx_Math" alttext="\widehat{\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i})}" display="inline" intent=":literal"><semantics><mover accent="true"><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>^</mo></mover><annotation encoding="application/x-tex">\widehat{\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i})}</annotation></semantics></math> is obtained, these estimates can be substituted into the formula above to construct <math id="S4.SS2.p2.m5" class="ltx_Math" alttext="\hat{M}_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{M}_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">This surrogate outcome serves as a substitute for the true label and <math id="S4.SS2.p3.m1" class="ltx_math_unparsed" alttext="M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})=\mathbbm{1}\{L_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})=\mathbbm{1}\{L_{i}=c\}</annotation></semantics></math> if both coders classify texts accurately (i.e., <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}=c)=\mathbb{P}(\tilde{L}^{(2)}_{i}=c\mid L_{i}=c)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}^{(1)}_{i}=c\mid L_{i}=c)=\mathbb{P}(\tilde{L}^{(2)}_{i}=c\mid L_{i}=c)=1</annotation></semantics></math>). Formally, it can be proven that this surrogate outcome is an unbiased estimate of the true label given either the true label or the texts: i.e.,</p>
<table id="S4.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E13.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})\mid L_{i}]=\mathbb{E}[M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i}]=\mathbbm{1}\{L_{i}=c\}." display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})\mid L_{i}]=\mathbb{E}[M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})\mid\bm{Y}_{i}]=\mathbbm{1}\{L_{i}=c\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="S4.SS2.p3.2" class="ltx_p">Furthermore, it can be shown that the outcome model predicting this surrogate outcome is mathematically equivalent to the one predicting the true, unobserved label <math id="S4.SS2.p3.m3" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math>. See Appendix <a href="#A4.SS6" title="S4.6 Theoretical Properties of Surrogate Outcome ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S4.6</span></a> for the theoretical properties of the surrogate outcome.</p>
</div>
<div id="S4.SS2.p4" class="ltx_para">
<p id="S4.SS2.p4.2" class="ltx_p">Based on this surrogate outcome, I can extend the estimation strategies in the previous section.
Since I can learn the outcome model for the true annotation <math id="S4.SS2.p4.m1" class="ltx_Math" alttext="L_{i}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>i</mi></msub><annotation encoding="application/x-tex">L_{i}</annotation></semantics></math> using the surrogate outcome <math id="S4.SS2.p4.m2" class="ltx_Math" alttext="M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})</annotation></semantics></math>, once the surrogate outcome <math id="S4.SS2.p4.m3" class="ltx_Math" alttext="\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msub><mi>M</mi><mi>c</mi></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})</annotation></semantics></math> is estimated, I need to solve the following optimization problem</p>
<table id="S4.E14" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E14X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E14X.m2" class="ltx_Math" alttext="\displaystyle\arg" display="inline" intent=":literal"><semantics><mi>arg</mi><annotation encoding="application/x-tex">\displaystyle\arg</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E14X.m3" class="ltx_Math" alttext="\displaystyle\min_{\xi,\tilde{\lambda}_{c},\zeta}\frac{1}{n}\sum_{i=1}^{n}\biggl\{S_{i}\cdot\sum_{c\in\mathcal{L}}\biggl(\underbrace{\overbrace{\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i};\xi);\tilde{\lambda}_{c})}^{\text{Outcome Model}}-\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})}_{\text{Outcome Loss for Category }c}\biggr)^{2}" display="inline" intent=":literal"><semantics><mrow><mi>min</mi><msub><mrow></mrow><mrow><mi>ξ</mi><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>c</mi></msub><mo>,</mo><mi>ζ</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mo maxsize="2.100em" minsize="2.100em">(</mo><munder accentunder="true"><mrow><mover><mover accent="true"><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏞</mo></mover><mtext>Outcome Model</mtext></mover><mo>−</mo><mrow><mover accent="true"><msub><mi>M</mi><mi>c</mi></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mtext>Outcome Loss for Category </mtext><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo maxsize="2.100em" minsize="2.100em">)</mo><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\min_{\xi,\tilde{\lambda}_{c},\zeta}\frac{1}{n}\sum_{i=1}^{n}\biggl\{S_{i}\cdot\sum_{c\in\mathcal{L}}\biggl(\underbrace{\overbrace{\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i};\xi);\tilde{\lambda}_{c})}^{\text{Outcome Model}}-\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})}_{\text{Outcome Loss for Category }c}\biggr)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(14)</span></td></tr>
<tr id="S4.E14Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E14Xa.m2" class="ltx_Math" alttext="\displaystyle+\beta\cdot\underbrace{\text{CrossEntropy}\biggl(T_{i},\overbrace{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i};\xi);\zeta)}^{\text{Surrogacy Score}}\biggr)}_{\text{Prediction Loss for Predictor $T_{i}$}}\biggr\}," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><munder accentunder="true"><mrow><mtext>CrossEntropy</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><mover><mover accent="true"><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>ζ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="true">⏞</mo></mover><mtext>Surrogacy Score</mtext></mover><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo stretchy="true">⏟</mo></munder><msub><mrow></mrow><mrow><mtext>Prediction Loss for Predictor </mtext><msub><mi mathsize="0.700em">T</mi><mi mathsize="0.700em">i</mi></msub></mrow></msub><mo stretchy="false">}</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\beta\cdot\underbrace{\text{CrossEntropy}\biggl(T_{i},\overbrace{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i};\xi);\zeta)}^{\text{Surrogacy Score}}\biggr)}_{\text{Prediction Loss for Predictor $T_{i}$}}\biggr\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p4.3" class="ltx_p">where <math id="S4.SS2.p4.m4" class="ltx_Math" alttext="\tilde{\mu}_{c}(\cdot;\tilde{\lambda}_{c})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>c</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mu}_{c}(\cdot;\tilde{\lambda}_{c})</annotation></semantics></math> is the outcome model for category <math id="S4.SS2.p4.m5" class="ltx_Math" alttext="L_{i}=c" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">L_{i}=c</annotation></semantics></math> with the estimated surrogate outcome <math id="S4.SS2.p4.m6" class="ltx_Math" alttext="\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><msub><mi>M</mi><mi>c</mi></msub><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{M_{c}}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})</annotation></semantics></math> given <math id="S4.SS2.p4.m7" class="ltx_Math" alttext="\bm{W}_{i}=\bm{f}(\bm{Y}_{i},\bm{Z}_{i};\xi)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑾</mi><mi>i</mi></msub><mo>=</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{i}=\bm{f}(\bm{Y}_{i},\bm{Z}_{i};\xi)</annotation></semantics></math> parametrized by <math id="S4.SS2.p4.m8" class="ltx_Math" alttext="\tilde{\lambda}_{c}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>c</mi></msub><annotation encoding="application/x-tex">\tilde{\lambda}_{c}</annotation></semantics></math>,
and <math id="S4.SS2.p4.m9" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> are the hyperparameters regulating the influence of the two loss components.
Importantly, the surrogate representation <math id="S4.SS2.p4.m10" class="ltx_Math" alttext="\bm{f}(\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{f}(\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math> learned under the loss function in Equation (<a href="#S4.E14" title="In 4.2 Estimation and inference ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) encodes the same conditional independence relationship as in Definition <a href="#Thmdefinition1" title="Definition 1 (Surrogate Representation of Texts) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, because the outcome model based on the surrogate outcome <math id="S4.SS2.p4.m11" class="ltx_Math" alttext="\tilde{\mu}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>μ</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\mu}</annotation></semantics></math> is mathematically equivalent, in the population limit, to the outcome model based on the true outcome.</p>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.1" class="ltx_p">To characterize the behavior of the estimator at the limit, as in the previous section, I first derive its influence function.</p>
</div>
<div id="Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem3.2" class="ltx_text ltx_font_smallcaps">Theorem 3</span></span><span id="Thmtheorem3.3" class="ltx_text ltx_font_smallcaps"> (Influence Function)</span></h6>
<div id="Thmtheorem3.p1" class="ltx_para">
<p id="Thmtheorem3.p1.2" class="ltx_p"><span id="Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">The influence function for the distribution of the covariate-adjusted outcome under <math id="Thmtheorem3.p1.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> is given by</span></p>
<table id="S4.E15" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S4.E15X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E15X.m2" class="ltx_Math" alttext="\displaystyle\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E15X.m3" class="ltx_Math" alttext="\displaystyle;\bm{f},\rho_{t},\tilde{\mu},\pi_{t},M_{c},\bar{m}_{tc},\Psi_{t,c})" display="inline" intent=":literal"><semantics><mrow><mo>;</mo><mi>𝒇</mi><mo>,</mo><mi>ρ</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mo>,</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo>,</mo><mi>M</mi><msub><mrow></mrow><mi>c</mi></msub><mo>,</mo><mover accent="true"><mi>m</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><mi mathvariant="normal">Ψ</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle;\bm{f},\rho_{t},\tilde{\mu},\pi_{t},M_{c},\bar{m}_{tc},\Psi_{t,c})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(15)</span></td></tr>
<tr id="S4.E15Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E15Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})-\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo mathsize="2.100em">,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo mathsize="2.100em">,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}_{i}^{(2)})-\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S4.E15Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E15Xb.m2" class="ltx_Math" alttext="\displaystyle+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t,c}(\bm{Z}_{i})\biggr)+\bar{m}_{t,c}(\bm{Z}_{i})-\Psi_{t,c}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo mathsize="0.700em">,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{\mathbbm{1}\{T_{i}=t\}}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t,c}(\bm{Z}_{i})\biggr)+\bar{m}_{t,c}(\bm{Z}_{i})-\Psi_{t,c}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem3.p1.3" class="ltx_p"><span id="Thmtheorem3.p1.3.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem3.p1.m2" class="ltx_math_unparsed" alttext="\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i}),S_{i}=1]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>c</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝐟</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))=\mathbb{E}[M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i}),S_{i}=1]</annotation></semantics></math>, and <math id="Thmtheorem3.p1.m3" class="ltx_Math" alttext="\bar{m}_{t,c}(\bm{Z}_{i})=\int\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))dF(\bm{Y}_{i}\mid T_{i}=t,\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{m}_{t,c}(\bm{Z}_{i})=\int\tilde{\mu}_{c}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))dF(\bm{Y}_{i}\mid T_{i}=t,\bm{Z}_{i})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS2.p6" class="ltx_para">
<p id="S4.SS2.p6.1" class="ltx_p">The proof is provided in Appendix <a href="#A4.SS7" title="S4.7 Proof of Theorem (Influence function without true labels) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S4.7</span></a>.</p>
</div>
<div id="S4.SS2.p7" class="ltx_para">
<p id="S4.SS2.p7.1" class="ltx_p">Since the estimation of the target parameter requires both the estimation of the surrogate outcome <math id="S4.SS2.p7.m1" class="ltx_Math" alttext="M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{c}(\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i})</annotation></semantics></math> and the optimization of the loss function in Equation (<a href="#S4.E14" title="In 4.2 Estimation and inference ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), I need to modify the standard cross-fitting procedure accordingly. Suppose that <math id="S4.SS2.p7.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is divisible by <math id="S4.SS2.p7.m3" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>. The entire estimation procedure with <math id="S4.SS2.p7.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>-fold cross-fitting is summarized as follows.</p>
<ol id="S4.I3" class="ltx_enumerate">
<li id="S4.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S4.I3.i1.p1" class="ltx_para">
<p id="S4.I3.i1.p1.1" class="ltx_p">Randomly partition the data into <math id="S4.I3.i1.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> folds of equal size. Let <math id="S4.I3.i1.p1.m2" class="ltx_Math" alttext="I(i)=k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">I(i)=k</annotation></semantics></math> be the indicator of the observation <math id="S4.I3.i1.p1.m3" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> belonging to the fold <math id="S4.I3.i1.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S4.I3.i2.p1" class="ltx_para">
<p id="S4.I3.i2.p1.1" class="ltx_p">For each fold <math id="S4.I3.i2.p1.m1" class="ltx_Math" alttext="k\in\{1,\cdots,K\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{1,\cdots,K\}</annotation></semantics></math>, use <math id="S4.I3.i2.p1.m2" class="ltx_Math" alttext="I(i)\neq k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">I(i)\neq k</annotation></semantics></math> as training data:</p>
<ol id="S4.I3.i2.I1" class="ltx_enumerate">
<li id="S4.I3.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="S4.I3.i2.I1.i1.p1" class="ltx_para">
<p id="S4.I3.i2.I1.i1.p1.1" class="ltx_p">Estimate the propensity score model <math id="S4.I3.i2.I1.i1.p1.m1" class="ltx_Math" alttext="\hat{\pi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\pi}_{t}</annotation></semantics></math> using all the sample with <math id="S4.I3.i2.I1.i1.p1.m2" class="ltx_Math" alttext="I(i)\neq k" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">I(i)\neq k</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I3.i2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(b)</span> 
<div id="S4.I3.i2.I1.i2.p1" class="ltx_para">
<p id="S4.I3.i2.I1.i2.p1.1" class="ltx_p">Split the training data with <math id="S4.I3.i2.I1.i2.p1.m1" class="ltx_Math" alttext="S_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S_{i}=1</annotation></semantics></math> into two halves, say <math id="S4.I3.i2.I1.i2.p1.m2" class="ltx_Math" alttext="I^{(-k)}_{1s}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I^{(-k)}_{1s}</annotation></semantics></math> and <math id="S4.I3.i2.I1.i2.p1.m3" class="ltx_Math" alttext="I^{(-k)}_{2s}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I^{(-k)}_{2s}</annotation></semantics></math>. Also, split the remaining training data (with <math id="S4.I3.i2.I1.i2.p1.m4" class="ltx_Math" alttext="S_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S_{i}=0</annotation></semantics></math>) into two halves, say <math id="S4.I3.i2.I1.i2.p1.m5" class="ltx_Math" alttext="I_{-1s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-1s}^{(-k)}</annotation></semantics></math> and <math id="S4.I3.i2.I1.i2.p1.m6" class="ltx_Math" alttext="I_{-2s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-2s}^{(-k)}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I3.i2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="S4.I3.i2.I1.i3.p1" class="ltx_para">
<p id="S4.I3.i2.I1.i3.p1.1" class="ltx_p">Use <math id="S4.I3.i2.I1.i3.p1.m1" class="ltx_Math" alttext="I^{(-k)}_{1s}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I^{(-k)}_{1s}</annotation></semantics></math> to obtain the estimated <math id="S4.I3.i2.I1.i3.p1.m2" class="ltx_Math" alttext="\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i}=m)" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>m</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i}=m)</annotation></semantics></math> for all categories <math id="S4.I3.i2.I1.i3.p1.m3" class="ltx_Math" alttext="(l,m)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>l</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(l,m)</annotation></semantics></math> and all coders <math id="S4.I3.i2.I1.i3.p1.m4" class="ltx_Math" alttext="j=1,2" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">j=1,2</annotation></semantics></math>. By inserting these estimates, obtain the estimated surrogate outcome <math id="S4.I3.i2.I1.i3.p1.m5" class="ltx_Math" alttext="\hat{M}_{c}(\{\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)}\}_{i\in I^{(-k)}_{2s}})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><msubsup><mi>I</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{M}_{c}(\{\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)}\}_{i\in I^{(-k)}_{2s}})</annotation></semantics></math> on <math id="S4.I3.i2.I1.i3.p1.m6" class="ltx_Math" alttext="I^{(-k)}_{2s}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I^{(-k)}_{2s}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I3.i2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(d)</span> 
<div id="S4.I3.i2.I1.i4.p1" class="ltx_para">
<p id="S4.I3.i2.I1.i4.p1.1" class="ltx_p">Solve the optimization problem in Equation (<a href="#S4.E14" title="In 4.2 Estimation and inference ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>) using the data <math id="S4.I3.i2.I1.i4.p1.m1" class="ltx_Math" alttext="I^{(-k)}_{2s}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I^{(-k)}_{2s}</annotation></semantics></math> and <math id="S4.I3.i2.I1.i4.p1.m2" class="ltx_Math" alttext="I_{-1s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-1s}^{(-k)}</annotation></semantics></math> and obtain the estimated outcome models <math id="S4.I3.i2.I1.i4.p1.m3" class="ltx_Math" alttext="\hat{\tilde{\mu}}_{c}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\tilde{\mu}}_{c}^{(-k)}</annotation></semantics></math> for all category levels and the surrogacy score <math id="S4.I3.i2.I1.i4.p1.m4" class="ltx_Math" alttext="\hat{\rho}_{t}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\rho}_{t}^{(-k)}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I3.i2.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(e)</span> 
<div id="S4.I3.i2.I1.i5.p1" class="ltx_para">
<p id="S4.I3.i2.I1.i5.p1.1" class="ltx_p">Regress the obtained <math id="S4.I3.i2.I1.i5.p1.m1" class="ltx_Math" alttext="\hat{\tilde{\mu}}_{c}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\tilde{\mu}}_{c}^{(-k)}</annotation></semantics></math> onto <math id="S4.I3.i2.I1.i5.p1.m2" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> and <math id="S4.I3.i2.I1.i5.p1.m3" class="ltx_Math" alttext="\bm{Z}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝒁</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\bm{Z}_{i}</annotation></semantics></math> using the data <math id="S4.I3.i2.I1.i5.p1.m4" class="ltx_Math" alttext="I_{-2s}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mi>I</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">I_{-2s}^{(-k)}</annotation></semantics></math> and obtain <math id="S4.I3.i2.I1.i5.p1.m5" class="ltx_Math" alttext="\hat{\bar{m}}_{t,c}^{(-k)}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\hat{\bar{m}}_{t,c}^{(-k)}</annotation></semantics></math>.</p>
</div></li>
</ol>
</div></li>
<li id="S4.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="S4.I3.i3.p1" class="ltx_para">
<p id="S4.I3.i3.p1.1" class="ltx_p">For each category level <math id="S4.I3.i3.p1.m1" class="ltx_Math" alttext="c\in\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">c\in\mathcal{L}</annotation></semantics></math> and at the level of predictors of interest <math id="S4.I3.i3.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, solve the estimating equation</p>
<table id="S4.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E16.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{n}\sum_{k=1}^{K}\sum_{I(i)=k}\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\bm{f}}^{(-k)},\rho_{t}^{-(k)},\hat{\tilde{\mu}}^{(-k)},\hat{\pi}_{t}^{(-k)},\hat{M}_{c}^{(-k)},\hat{\bar{m}}^{(-k)}_{t,c},\hat{\Psi}_{t,c})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>k</mi></mrow></munder></mstyle><mrow><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msup><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mi>ρ</mi><mi>t</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></mrow></msubsup><mo>,</mo><msup><mover accent="true"><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msubsup><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n}\sum_{k=1}^{K}\sum_{I(i)=k}\tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\bm{f}}^{(-k)},\rho_{t}^{-(k)},\hat{\tilde{\mu}}^{(-k)},\hat{\pi}_{t}^{(-k)},\hat{M}_{c}^{(-k)},\hat{\bar{m}}^{(-k)}_{t,c},\hat{\Psi}_{t,c})=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="S4.I3.i3.p1.2" class="ltx_p">and obtain the estimate of the target parameter <math id="S4.I3.i3.p1.m3" class="ltx_Math" alttext="\hat{\Psi}_{t,c}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">\hat{\Psi}_{t,c}</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="S4.SS2.p7.2" class="ltx_p">As the procedure described above is nested, I practically recommend using large values of <math id="S4.SS2.p7.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> to have a sufficient amount of training data for obtaining the coder classification estimates and the training of the neural network.</p>
</div>
<div id="S4.SS2.p8" class="ltx_para">
<p id="S4.SS2.p8.1" class="ltx_p">Under this setup, I formally establish the asymptotic normality of the proposed estimator. As in Section <a href="#S3" title="3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, I assume standard regularity conditions, but the required convergence rates can be satisfied by the proposed neural network architecture. The formal statement of these regularity conditions is provided in Assumption <a href="#Thmassumption10" title="Assumption 10 (Regularity Conditions) ‣ S4.8 Proof of Theorem (Asymptotic Normality) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a> of Appendix <a href="#A4.SS8" title="S4.8 Proof of Theorem (Asymptotic Normality) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S4.8</span></a>.</p>
</div>
<div id="Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmtheorem4.2" class="ltx_text ltx_font_smallcaps">Theorem 4</span></span><span id="Thmtheorem4.3" class="ltx_text ltx_font_smallcaps"> (Asymptotic Normality)</span></h6>
<div id="Thmtheorem4.p1" class="ltx_para">
<p id="Thmtheorem4.p1.1" class="ltx_p"><span id="Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Under Assumptions <a href="#Thmassumption1" title="Assumption 1 (True Coding Rule) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>,<a href="#Thmassumption3" title="Assumption 3 (Human Annotation Sampling) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>, <a href="#Thmassumption5" title="Assumption 5 (Human Annotation Sampling) ‣ 4.1 Assumptions and nonparametric identification ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>–<a href="#Thmassumption10" title="Assumption 10 (Regularity Conditions) ‣ S4.8 Proof of Theorem (Asymptotic Normality) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, the estimator for the covariate-adjusted outcome mean <math id="Thmtheorem4.p1.m1" class="ltx_Math" alttext="\hat{\Psi}_{t}=\sum_{c\in\mathcal{L}}c\ \hat{\Psi}_{t,c}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mrow><mi>c</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\Psi}_{t}=\sum_{c\in\mathcal{L}}c\ \hat{\Psi}_{t,c}</annotation></semantics></math> obtained by solving the estimating equations in Equation (<a href="#S4.E16" title="In item 3 ‣ 4.2 Estimation and inference ‣ 4 Extension: The Proposed Methodology with Noisy Human Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) satisfies asymptotic normality:</span></p>
<table id="S4.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex20.m1" class="ltx_Math" alttext="\frac{\sqrt{n}(\hat{\Psi}_{t}-\Psi_{t})}{\tilde{\sigma}}\xrightarrow{d}\mathcal{N}(0,1)" display="block" intent=":literal"><semantics><mrow><mfrac><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mover accent="true"><mi>σ</mi><mo>~</mo></mover></mfrac><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑑</mo></mover><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\sqrt{n}(\hat{\Psi}_{t}-\Psi_{t})}{\tilde{\sigma}}\xrightarrow{d}\mathcal{N}(0,1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmtheorem4.p1.2" class="ltx_p"><span id="Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmtheorem4.p1.m2" class="ltx_Math" alttext="\tilde{\sigma}^{2}=\mathbb{E}\bigl[\bigl(\sum_{c\in\mathcal{L}}c\ \tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})\bigr)^{2}\bigr]." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mn>2</mn></msup><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>c</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow></msub><mrow><mi>c</mi><mo lspace="0.500em" rspace="0em">​</mo><msub><mover accent="true"><mi>ψ</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>c</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\sigma}^{2}=\mathbb{E}\bigl[\bigl(\sum_{c\in\mathcal{L}}c\ \tilde{\psi}_{t,c}(T_{i},\tilde{L}^{(1)}_{i},\tilde{L}^{(2)}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i})\bigr)^{2}\bigr].</annotation></semantics></math></span></p>
</div>
</div>
<div id="S4.SS2.p9" class="ltx_para">
<p id="S4.SS2.p9.1" class="ltx_p">The proof is in Appendix <a href="#A4.SS8" title="S4.8 Proof of Theorem (Asymptotic Normality) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S4.8</span></a>.</p>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Empirical Application</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">I now apply the proposed SRI methodology to the existing study introduced in Section <a href="#S2" title="2 Motivating Example: Framing of Immigrants in the U.S. Congress ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Following the original analysis, I use the party affiliation of the speaker as the predictor of interest. The outcome of interest is the framing of the immigrants in the U.S. Congressional speeches, and the original analysis used predictions from a pre-trained language model (RoBERTa; see Table <a href="#S2.T1" title="Table 1 ‣ 2 Motivating Example: Framing of Immigrants in the U.S. Congress ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> for classification accuracy). I use all observations with machine-learning predictions (<math id="S5.p1.m1" class="ltx_Math" alttext="n=248{,}616" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>248,616</mn></mrow><annotation encoding="application/x-tex">n=248{,}616</annotation></semantics></math>), of which <math id="S5.p1.m2" class="ltx_Math" alttext="3{,}643" display="inline" intent=":literal"><semantics><mn>3,643</mn><annotation encoding="application/x-tex">3{,}643</annotation></semantics></math> are annotated.</p>
</div>
<div id="S5.p2" class="ltx_para">
<p id="S5.p2.1" class="ltx_p">For the sake of efficiency comparison, I implement the proposed methodology under the assumption that human annotations are perfect (Section <a href="#S3" title="3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>). To do so, I first obtain vector representations of the texts using BERT embedding <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib37" title="" class="ltx_ref">Devlin et al., 2019</a>)</cite> and feed them into the proposed neural-network architecture. I perform 2-fold cross-fitting with the architecture illustrated in Figure <a href="#S3.F2" title="Figure 2 ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Specifically, the network has three hidden layers with dimensions 100, 100, and 50 leading to the shared layer <math id="S5.p2.m1" class="ltx_Math" alttext="\bm{f}(\bm{R}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝑹</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{f}(\bm{R}_{i})</annotation></semantics></math>. The shared layer is then connected to prediction heads for outcomes and the predictors of interest, each consisting of two layers with dimensions 50 and 1 (i.e., ultimately predicting a scalar). I use ReLU activations and solve the optimization problem in Equation <a href="#S3.E4" title="In 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> with <math id="S5.p2.m2" class="ltx_Math" alttext="\alpha=1" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\alpha=1</annotation></semantics></math>, employing the Adam optimizer (learning rate <math id="S5.p2.m3" class="ltx_Math" alttext="=2\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">=2\times 10^{-5}</annotation></semantics></math>), a maximum of 200 epochs, and a batch size of 256 <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib44" title="" class="ltx_ref">Kingma and Ba, 2017</a>)</cite>. I set aside 20 % of the data for validation and implement early stopping with a patience of five epochs (i.e., if the validation loss fails to decrease for five consecutive epochs, training stops). Once the outcome model and surrogacy score are estimated, I use them to calculate the covariate-adjusted outcome mean for each party affiliation via the estimating equation in Equation (<a href="#S3.E6" title="In item 3 ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) and calculate the difference between Democrats and Republicans.</p>
</div>
<div id="S5.p3" class="ltx_para">
<p id="S5.p3.1" class="ltx_p">I compare the proposed SRI estimator with two alternatives. The first is a naïve estimator that directly uses RoBERTa’s predictions to compute the difference in means. Because RoBERTa’s predictions contain classification errors, this estimator is expected to be biased. The second is an existing bias-correction approach that combines machine-learning predictions with human annotations, often referred to as Prediction-Powered Inference (PPI; <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib59" title="" class="ltx_ref">Angelopoulos et al. 2023</a></cite>) or, with only minor differences, Design-based Supervised Learning (DSL; <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib57" title="" class="ltx_ref">Egami et al. 2023</a>; <a href="#bib.bib61" title="" class="ltx_ref">Egami et al. 2024</a></cite>). With no control variables, these estimators for the outcome mean under <math id="S5.p3.m1" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> is defined as<span id="footnote1" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">1</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">1</sup>
            <span class="ltx_tag ltx_tag_note">1</span>
            
            
            
          Specifically, I follow the DSL approach <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib57" title="" class="ltx_ref">Egami et al., 2023</a>; <a href="#bib.bib61" title="" class="ltx_ref">Egami et al., 2024</a>)</cite> for <math id="footnote1.m1" class="ltx_Math" alttext="\hat{\Psi}_{t,\mathrm{Existing}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>Existing</mi></mrow></msub><annotation encoding="application/x-tex">\hat{\Psi}_{t,\mathrm{Existing}}</annotation></semantics></math> because of imbalances between the labeled and unlabeled data. The only difference between DSL and PPI is that PPI uses the average over the unbalanced subset of data for the first term, whereas DSL uses the average over the entire dataset. Formally, the PPI estimator are defined as

<span id="S5.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<span id="S5.Ex21"><span class="ltx_equation ltx_eqn_row ltx_align_baseline">
<span class="ltx_eqn_cell ltx_eqn_center_padleft"></span>
<span class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex21.m1" class="ltx_Math" alttext="\displaystyle\hat{\Psi}_{t,\mathrm{PPI}}=\frac{1}{N_{t}}\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t,S_{i}=0\}\hat{L}_{i}-\frac{1}{n_{t}}\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t,S_{i}=1\}\biggl(\hat{L}_{i}-\tilde{L}_{i}\biggr)\quad\text{for all}\ t," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>PPI</mi></mrow></msub><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>N</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>n</mi><mi>t</mi></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>for all</mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\Psi}_{t,\mathrm{PPI}}=\frac{1}{N_{t}}\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t,S_{i}=0\}\hat{L}_{i}-\frac{1}{n_{t}}\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t,S_{i}=1\}\biggl(\hat{L}_{i}-\tilde{L}_{i}\biggr)\quad\text{for all}\ t,</annotation></semantics></math></span>
<span class="ltx_eqn_cell ltx_eqn_center_padright"></span></span></span>
</span>
where <math id="footnote1.m2" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math> is the number of unlabeled observations (i.e., <math id="footnote1.m3" class="ltx_Math" alttext="N_{t}=\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t,S_{i}=0\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">N_{t}=\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t,S_{i}=0\}</annotation></semantics></math>). As long as texts are randomly assigned to annotators, these two estimators should, on average, yield the same estimates at the population level. In this application, however, although random assignment was implemented, the average tone differs between labeled and unlabeled data, making PPI somewhat sensitive. For this reason, I use the DSL estimator here, since it relies on the overall average for the first term.
</span></span></span></p>
<table id="S5.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex22.m1" class="ltx_math_unparsed" alttext="\displaystyle\hat{\Psi}_{t,\mathrm{Existing}}:=\frac{1}{n}\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t\}\hat{L}_{i}-\frac{1}{n_{t}}\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t,S_{i}=1\}\biggl(\hat{L}_{i}-\tilde{L}_{i}\biggr)\quad\text{for all}\ t," display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>Existing</mi></mrow></msub><mo>:=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>n</mi><mi>t</mi></msub></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><mo>−</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mtext>for all</mtext><mi>t</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hat{\Psi}_{t,\mathrm{Existing}}:=\frac{1}{n}\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t\}\hat{L}_{i}-\frac{1}{n_{t}}\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t,S_{i}=1\}\biggl(\hat{L}_{i}-\tilde{L}_{i}\biggr)\quad\text{for all}\ t,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.p3.2" class="ltx_p">where <math id="S5.p3.m2" class="ltx_Math" alttext="n_{t}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>t</mi></msub><annotation encoding="application/x-tex">n_{t}</annotation></semantics></math> is the number of labeled units in group <math id="S5.p3.m3" class="ltx_Math" alttext="T_{i}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{i}=t</annotation></semantics></math> (i.e., <math id="S5.p3.m4" class="ltx_Math" alttext="n_{t}=\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t,S_{i}=1\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>t</mi></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n_{t}=\sum_{i=1}^{n}\mathbbm{1}\{T_{i}=t,S_{i}=1\}</annotation></semantics></math>), and <math id="S5.p3.m5" class="ltx_Math" alttext="\hat{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\hat{L}_{i}</annotation></semantics></math> denotes the predictions from RoBERTa. Once the outcome mean is estimated for each value of the predictor of interest, the difference between <math id="S5.p3.m6" class="ltx_Math" alttext="\hat{\Psi}_{1,\mathrm{Existing}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>Existing</mi></mrow></msub><annotation encoding="application/x-tex">\hat{\Psi}_{1,\mathrm{Existing}}</annotation></semantics></math> (Democrats) and <math id="S5.p3.m7" class="ltx_Math" alttext="\hat{\Psi}_{0,\mathrm{Existing}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Ψ</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mi>Existing</mi></mrow></msub><annotation encoding="application/x-tex">\hat{\Psi}_{0,\mathrm{Existing}}</annotation></semantics></math> (Republicans) is calculated. Unlike SRI, these existing estimators do not impose independence constraints between the machine-learning predictions <math id="S5.p3.m8" class="ltx_Math" alttext="\hat{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\hat{L}_{i}</annotation></semantics></math> and the human annotations <math id="S5.p3.m9" class="ltx_Math" alttext="\tilde{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{L}_{i}</annotation></semantics></math>. Although such constraints are not guaranteed by design for machine learning predictions <math id="S5.p3.m10" class="ltx_Math" alttext="\hat{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\hat{L}_{i}</annotation></semantics></math>, their absence is expected to reduce efficiency, especially when <math id="S5.p3.m11" class="ltx_Math" alttext="\hat{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\hat{L}_{i}</annotation></semantics></math> and <math id="S5.p3.m12" class="ltx_Math" alttext="\tilde{L}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><annotation encoding="application/x-tex">\tilde{L}_{i}</annotation></semantics></math> diverge. See Appendix <a href="#A1" title="Appendix S1 Theoretical Explanation of Efficiency Gains ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S1</span></a> for further theoretical discussion.</p>
</div>
<figure id="S5.F4" class="ltx_figure"><object type="image/svg+xml" data="2509.12416v2/empirical_result.svg" id="S5.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:626/300;" width="626" height="300"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F4.3" class="ltx_text" style="font-size:90%;">Figure 4</span>: </span><span id="S5.F4.4" class="ltx_text" style="font-size:90%;">The estimated partisan difference in tone towards immigrants based on the data of <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib18" title="" class="ltx_ref">Card et al. (2022)</a></cite> for (1) the SRI estimator (proposed), (2) the existing bias-correction approach using both human annotations and machine learning predictions; <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib59" title="" class="ltx_ref">Angelopoulos et al. 2023</a>; <a href="#bib.bib57" title="" class="ltx_ref">Egami et al. 2023</a>; <a href="#bib.bib61" title="" class="ltx_ref">Egami et al. 2024</a></cite>),
and (3) the naïve estimator (directly using the machine learning predictions).</span></figcaption>
</figure>
<div id="S5.p4" class="ltx_para">
<p id="S5.p4.1" class="ltx_p">Figure <a href="#S5.F4" title="Figure 4 ‣ 5 Empirical Application ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> presents the results. The naïve estimator based on machine-learning predictions shows a larger partisan difference in the framing of immigrants than both the proposed SRI estimator and the existing bias-correction approaches. While both SRI and the existing bias-correction approach are consistent, the results highlight a substantial efficiency gain: by exploiting independence constraints, the SRI estimator significantly reduces the standard error compared with the existing bias-correction approaches.</p>
</div>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>Conclusion</h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">In this paper, I introduce <em id="S6.p1.1.1" class="ltx_emph ltx_font_italic">Surrogate Representation Inference</em> (SRI), a framework that addresses the challenges of incorporating high-dimensional unstructured data into statistical inference with a limited number of human annotations that may contain measurement errors. The SRI framework rests on a key assumption that can be guaranteed by design: human coders rely only on unstructured data for annotations and do not directly look at the structured variables of interest. Under this assumption, unstructured data fully mediate the structured variables and human annotations, satisfying the statistical surrogacy condition. As unstructured data are high-dimensional, I propose learning their low-dimensional representations such that the surrogacy conditions continue to hold. The paper examines the setting in which a text-based variable functions as an outcome and develops identification conditions, a neural network architecture for representation learning, and semiparametric efficient estimation strategies based on the learned representations. When multiple annotations are available, SRI also corrects for non-differential measurement error in human annotations. The empirical application demonstrates that SRI significantly reduces the standard errors compared to the existing methodology. Systematic simulation studies in Appendix <a href="#A5" title="Appendix S5 Simulation Studies ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S5</span></a> also confirm that when the quality of the machine learning proxy is moderate, the proposed SRI methodology can reduce the standard error approximately by half. These findings highlight the potential of SRI to enhance the precision and reliability of statistical inference with unstructured data, paving the way for future applications in diverse text or image-based research settings.</p>
</div>
<div id="S6.p2" class="ltx_para">
<p id="S6.p2.1" class="ltx_p">While this work has primarily focused on settings where text-based variable serves as an outcome, the proposed SRI procedure can be applied to diverse settings and modalities, such as those where unstructured data serves as control or predictors.
Another exciting direction for future work is the discovery of text features influenced by predictor of interest. Although this paper currently assumes researchers know which features to measure, unstructured data offers the potential to identify these features without prior specification, an advantage particularly useful for open-ended questions. Looking ahead, future research should develop a unified framework that supports data-driven discovery of outcome concepts and perform the valid and efficient statistical inference with minimal amount of labeling. Finally, it would be valuable to explore how LLM‑generated annotations can be incorporated into the SRI methodology. Although the current framework primarily addresses human annotations with non‑differential error, it remains valid when annotations are produced by LLMs, provided that the required assumptions hold. Some assumptions, such as independent coding, may be difficult to satisfy with LLMs because of overlap in their training data. Future work should therefore investigate ways to relax these assumptions or devise prompting strategies that ensure LLM annotations meet the necessary conditions.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
