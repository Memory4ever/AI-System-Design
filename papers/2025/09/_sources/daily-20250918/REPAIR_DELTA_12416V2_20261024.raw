<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex107.m1" class="ltx_Math" alttext="\displaystyle=f_{S}(S_{i})f_{\bm{Z}}(\bm{Z}_{i})f_{\bm{Y}\mid\bm{Z}}(\bm{Y}_{i}\mid\bm{Z}_{i})f_{T\mid\bm{Y},\bm{Z}_{i}}(T_{i}\mid\bm{Y}_{i},\bm{Z}_{i})f(\tilde{L}_{i}\mid T_{i},\bm{Y}_{i},\bm{Z}_{i})^{S_{i}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>f</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>𝒁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi>𝒀</mi><mo fence="false">|</mo><mi>𝒁</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi>T</mi><mo fence="false">|</mo><mrow><mi>𝒀</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><msub><mi>S</mi><mi>i</mi></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=f_{S}(S_{i})f_{\bm{Z}}(\bm{Z}_{i})f_{\bm{Y}\mid\bm{Z}}(\bm{Y}_{i}\mid\bm{Z}_{i})f_{T\mid\bm{Y},\bm{Z}_{i}}(T_{i}\mid\bm{Y}_{i},\bm{Z}_{i})f(\tilde{L}_{i}\mid T_{i},\bm{Y}_{i},\bm{Z}_{i})^{S_{i}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex108.m1" class="ltx_Math" alttext="\displaystyle=f_{S}(S_{i})f_{\bm{Z}}(\bm{Z}_{i})f_{\bm{Y}\mid\bm{Z}}(\bm{Y}_{i}\mid\bm{Z}_{i})f_{T\mid\bm{Y},\bm{Z}_{i}}(T_{i}\mid\bm{Y}_{i},\bm{Z}_{i})f(\tilde{L}_{i}\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>f</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>𝒁</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi>𝒀</mi><mo fence="false">|</mo><mi>𝒁</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi>T</mi><mo fence="false">|</mo><mrow><mi>𝒀</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=f_{S}(S_{i})f_{\bm{Z}}(\bm{Z}_{i})f_{\bm{Y}\mid\bm{Z}}(\bm{Y}_{i}\mid\bm{Z}_{i})f_{T\mid\bm{Y},\bm{Z}_{i}}(T_{i}\mid\bm{Y}_{i},\bm{Z}_{i})f(\tilde{L}_{i}\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p5.2" class="ltx_p">By Theorem 4.5 of <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib27" title="" class="ltx_ref">Tsiatis (2006)</a></cite>, the tangent space of the nonparametric model <math id="A4.SS3.p5.m2" class="ltx_Math" alttext="\Lambda" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Λ</mi><annotation encoding="application/x-tex">\Lambda</annotation></semantics></math> is expressed as a direct sum of the orthogonal subspaces: i.e.,</p>
<table id="A4.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E8.m1" class="ltx_Math" alttext="\displaystyle\Lambda=\biggl\{\Lambda_{S}\ \oplus\ \Lambda_{\bm{Z}}\oplus\Lambda_{\bm{Y}\mid\bm{Z}}\ \oplus\ \Lambda_{T\mid\bm{Y},\bm{Z}}\ \oplus\ \Lambda_{\tilde{L}\mid\bm{Y},\bm{Z},S_{i}=1}\biggr\}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Λ</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi mathvariant="normal">Λ</mi><mi>S</mi></msub><mo rspace="0.722em">⊕</mo><msub><mi mathvariant="normal">Λ</mi><mi>𝒁</mi></msub><mo rspace="0.722em">⊕</mo><msub><mi mathvariant="normal">Λ</mi><mrow><mi>𝒀</mi><mo fence="false">|</mo><mi>𝒁</mi></mrow></msub><mo rspace="0.722em">⊕</mo><msub><mi mathvariant="normal">Λ</mi><mrow><mi>T</mi><mo fence="false">|</mo><mrow><mi>𝒀</mi><mo>,</mo><mi>𝒁</mi></mrow></mrow></msub><mo rspace="0.722em">⊕</mo><msub><mi mathvariant="normal">Λ</mi><mrow><mover accent="true"><mi>L</mi><mo>~</mo></mover><mo fence="false">|</mo><mrow><mi>𝒀</mi><mo>,</mo><mi>𝒁</mi><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow></mrow></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda=\biggl\{\Lambda_{S}\ \oplus\ \Lambda_{\bm{Z}}\oplus\Lambda_{\bm{Y}\mid\bm{Z}}\ \oplus\ \Lambda_{T\mid\bm{Y},\bm{Z}}\ \oplus\ \Lambda_{\tilde{L}\mid\bm{Y},\bm{Z},S_{i}=1}\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(S8)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p5.3" class="ltx_p">where</p>
<table id="A4.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex109.m1" class="ltx_Math" alttext="\displaystyle\Lambda_{S}=\biggl\{\alpha_{0}(S_{i})\in\mathcal{H}:\mathbb{E}[\alpha_{0}(S_{i})]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>S</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>α</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>α</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{S}=\biggl\{\alpha_{0}(S_{i})\in\mathcal{H}:\mathbb{E}[\alpha_{0}(S_{i})]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex110.m1" class="ltx_Math" alttext="\displaystyle\Lambda_{\bm{Z}}=\biggl\{\alpha_{1}(\bm{Z}_{i})\in\mathcal{H}:\mathbb{E}[\alpha_{1}(\bm{Z}_{i})]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mi>𝒁</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{\bm{Z}}=\biggl\{\alpha_{1}(\bm{Z}_{i})\in\mathcal{H}:\mathbb{E}[\alpha_{1}(\bm{Z}_{i})]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex111.m1" class="ltx_Math" alttext="\displaystyle\Lambda_{\bm{Y}\mid\bm{Z}}=\biggl\{\alpha_{2}(\bm{Y}_{i},\bm{Z}_{i})\in\mathcal{H}:\mathbb{E}[\alpha_{2}(\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mrow><mi>𝒀</mi><mo fence="false">|</mo><mi>𝒁</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{\bm{Y}\mid\bm{Z}}=\biggl\{\alpha_{2}(\bm{Y}_{i},\bm{Z}_{i})\in\mathcal{H}:\mathbb{E}[\alpha_{2}(\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex112.m1" class="ltx_math_unparsed" alttext="\displaystyle\Lambda_{T\mid\bm{Y},\bm{Z}}=\biggl\{\alpha_{3}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\in\mathcal{H}:\mathbb{E}[\alpha_{3}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i}]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mrow><mi>T</mi><mo fence="false">|</mo><mrow><mi>𝒀</mi><mo>,</mo><mi>𝒁</mi></mrow></mrow></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>α</mi><mn>3</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>α</mi><mn>3</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{T\mid\bm{Y},\bm{Z}}=\biggl\{\alpha_{3}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\in\mathcal{H}:\mathbb{E}[\alpha_{3}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i}]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex113.m1" class="ltx_math_unparsed" alttext="\displaystyle\Lambda_{\tilde{L}\mid\bm{Y},\bm{Z}}=\biggl\{\mathbbm{1}\{S_{i}=1\}\alpha_{4}(\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})\in\mathcal{H}:\mathbb{E}[\alpha_{4}(\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1]=0\biggr\}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Λ</mi><mrow><mover accent="true"><mi>L</mi><mo>~</mo></mover><mo fence="false">|</mo><mrow><mi>𝒀</mi><mo>,</mo><mi>𝒁</mi></mrow></mrow></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><msub><mi>α</mi><mn>4</mn></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>α</mi><mn>4</mn></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Lambda_{\tilde{L}\mid\bm{Y},\bm{Z}}=\biggl\{\mathbbm{1}\{S_{i}=1\}\alpha_{4}(\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})\in\mathcal{H}:\mathbb{E}[\alpha_{4}(\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1]=0\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p5.4" class="ltx_p">where <math id="A4.SS3.p5.m3" class="ltx_Math" alttext="\mathcal{H}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℋ</mi><annotation encoding="application/x-tex">\mathcal{H}</annotation></semantics></math> is the Hilbert space of the full data with mean 0 and finite variance equipped with the covariance inner product.</p>
</div>
<div id="A4.SS3.p6" class="ltx_para">
<p id="A4.SS3.p6.1" class="ltx_p"><span id="A4.SS3.p6.1.1" class="ltx_text">Now, recall that efficient influence function is the influence function that resides in the tangent space (Theorem 4.3 of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib27" title="" class="ltx_ref">Tsiatis 2006</a></cite>). Then, notice that Equation (<a href="#A4.E7" title="In Proof. ‣ S4.3 Proof of Theorem (Efficient Influence Function) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">S7</span></a>) is written as</span></p>
<table id="A4.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex114.m1" class="ltx_Math" alttext="\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i};\bm{f},\mu,\pi_{t},\rho_{t},\bar{m}_{t},\Psi_{t})=\psi_{1t}(\bm{Z}_{i})+\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})+\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})+\psi_{4t}(S,\tilde{L}_{i},\bm{Z}_{i},\bm{Y}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><mi>𝒇</mi><mo>,</mo><mi>μ</mi><mo>,</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ρ</mi><mi>t</mi></msub><mo>,</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>ψ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ψ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ψ</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>ψ</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t}(T_{i},\tilde{L}_{i},S_{i},\bm{Y}_{i};\bm{f},\mu,\pi_{t},\rho_{t},\bar{m}_{t},\Psi_{t})=\psi_{1t}(\bm{Z}_{i})+\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})+\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})+\psi_{4t}(S,\tilde{L}_{i},\bm{Z}_{i},\bm{Y}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p6.2" class="ltx_p"><span id="A4.SS3.p6.2.1" class="ltx_text">where</span></p>
<table id="A4.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex115.m1" class="ltx_Math" alttext="\displaystyle\psi_{1t}(\bm{Z}_{i})=\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{1t}(\bm{Z}_{i})=\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex116.m1" class="ltx_Math" alttext="\displaystyle\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})=\frac{\mathbbm{1}\{T_{i}=t\}-\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo>−</mo><mi>ρ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})=\frac{\mathbbm{1}\{T_{i}=t\}-\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex117.m1" class="ltx_Math" alttext="\displaystyle\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex118.m1" class="ltx_Math" alttext="\displaystyle\psi_{4t}(S,\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{4t}(S,\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})=\frac{\mathbbm{1}\{S_{i}=1\}}{\mathbb{P}(S_{i}=1)}\cdot\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p6.3" class="ltx_p"><span id="A4.SS3.p6.3.1" class="ltx_text">and thus I need to check if <math id="A4.SS3.p6.m1" class="ltx_Math" alttext="\psi_{1t}(\bm{Z}_{i})\in\Lambda_{\bm{Z}_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi mathvariant="normal">Λ</mi><msub><mi>𝒁</mi><mi>i</mi></msub></msub></mrow><annotation encoding="application/x-tex">\psi_{1t}(\bm{Z}_{i})\in\Lambda_{\bm{Z}_{i}}</annotation></semantics></math>, <math id="A4.SS3.p6.m2" class="ltx_Math" alttext="\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\in\Lambda_{T\mid\bm{Y},\bm{Z}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi mathvariant="normal">Λ</mi><mrow><mi>T</mi><mo fence="false">|</mo><mrow><mi>𝒀</mi><mo>,</mo><mi>𝒁</mi></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\in\Lambda_{T\mid\bm{Y},\bm{Z}}</annotation></semantics></math>,
<math id="A4.SS3.p6.m3" class="ltx_Math" alttext="\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})\in\Lambda_{\bm{Y}\mid\bm{Z}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi mathvariant="normal">Λ</mi><mrow><mi>𝒀</mi><mo fence="false">|</mo><mi>𝒁</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})\in\Lambda_{\bm{Y}\mid\bm{Z}}</annotation></semantics></math>
and <math id="A4.SS3.p6.m4" class="ltx_Math" alttext="\psi_{4t}(S,\tilde{L}_{i},\bm{Z}_{i},\bm{Y}_{i})\in\Lambda_{\tilde{L}\mid\bm{Y},\bm{Z}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi mathvariant="normal">Λ</mi><mrow><mover accent="true"><mi>L</mi><mo>~</mo></mover><mo fence="false">|</mo><mrow><mi>𝒀</mi><mo>,</mo><mi>𝒁</mi></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\psi_{4t}(S,\tilde{L}_{i},\bm{Z}_{i},\bm{Y}_{i})\in\Lambda_{\tilde{L}\mid\bm{Y},\bm{Z}}</annotation></semantics></math>.</span></p>
<ol id="A4.I1" class="ltx_enumerate">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A4.I1.i1.p1" class="ltx_para">
<p id="A4.I1.i1.p1.1" class="ltx_p"><math id="A4.I1.i1.p1.m1" class="ltx_Math" alttext="\psi_{1t}(\bm{Z}_{i})\in\Lambda_{\bm{Z}_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi mathvariant="normal">Λ</mi><msub><mi>𝒁</mi><mi>i</mi></msub></msub></mrow><annotation encoding="application/x-tex">\psi_{1t}(\bm{Z}_{i})\in\Lambda_{\bm{Z}_{i}}</annotation></semantics></math>: To show <math id="A4.I1.i1.p1.m2" class="ltx_Math" alttext="\psi_{1t}(\bm{Z}_{i})\in\Lambda_{\bm{Z}_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi mathvariant="normal">Λ</mi><msub><mi>𝒁</mi><mi>i</mi></msub></msub></mrow><annotation encoding="application/x-tex">\psi_{1t}(\bm{Z}_{i})\in\Lambda_{\bm{Z}_{i}}</annotation></semantics></math>, I need to show <math id="A4.I1.i1.p1.m3" class="ltx_Math" alttext="\mathbb{E}[\psi_{1t}(\bm{Z}_{i})]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ψ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\psi_{1t}(\bm{Z}_{i})]=0</annotation></semantics></math>. Then,</p>
<table id="A4.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex119.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\psi_{1t}(\bm{Z}_{i})]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ψ</mi><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\psi_{1t}(\bm{Z}_{i})]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex119.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\biggl[\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}\biggr]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\bar{m}_{t}(\bm{Z}_{i})-\Psi_{t}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex120.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\biggl[\int\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))dF(\bm{Y}_{i}\mid\bm{Z}_{i},T_{i}=t)-\Psi_{t}\biggr]=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mstyle displaystyle="true"><mrow><mo>∫</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mstyle><mo>−</mo><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\int\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))dF(\bm{Y}_{i}\mid\bm{Z}_{i},T_{i}=t)-\Psi_{t}\biggr]=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p"><math id="A4.I1.i2.p1.m1" class="ltx_Math" alttext="\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\in\Lambda_{T\mid\bm{Y},\bm{Z}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi mathvariant="normal">Λ</mi><mrow><mi>T</mi><mo fence="false">|</mo><mrow><mi>𝒀</mi><mo>,</mo><mi>𝒁</mi></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\in\Lambda_{T\mid\bm{Y},\bm{Z}}</annotation></semantics></math>: Similarly, to show the statement, I need to show <math id="A4.I1.i2.p1.m2" class="ltx_math_unparsed" alttext="\mathbb{E}[\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i}]=0" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>ψ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i}]=0</annotation></semantics></math>. Then,</p>
<table id="A4.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex121.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>ψ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\psi_{2t}(T_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex121.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\frac{\mathbbm{1}\{T_{i}=t\}-\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)\mid\bm{Y}_{i},\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo stretchy="false">{</mo><mi>T</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo><mo>−</mo><mi>ρ</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mi>𝒇</mi><mo stretchy="false">(</mo><mi>𝒀</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\frac{\mathbbm{1}\{T_{i}=t\}-\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)\mid\bm{Y}_{i},\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex122.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbb{P}(T_{i}=t\mid\bm{Y}_{i},\bm{Z}_{i})-\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbb{P}(T_{i}=t\mid\bm{Y}_{i},\bm{Z}_{i})-\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex123.m1" class="ltx_Math" alttext="\displaystyle=\frac{\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex124.m1" class="ltx_Math" alttext="\displaystyle=0" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A4.I1.i3.p1" class="ltx_para">
<p id="A4.I1.i3.p1.1" class="ltx_p"><math id="A4.I1.i3.p1.m1" class="ltx_Math" alttext="\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})\in\Lambda_{\bm{Y}_{i}\mid\bm{Z}_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ψ</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi mathvariant="normal">Λ</mi><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo fence="false">|</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow></msub></mrow><annotation encoding="application/x-tex">\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})\in\Lambda_{\bm{Y}_{i}\mid\bm{Z}_{i}}</annotation></semantics></math>: Similarly, to show the statement, I need to show <math id="A4.I1.i3.p1.m2" class="ltx_Math" alttext="\mathbb{E}[\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>ψ</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]=0</annotation></semantics></math>. Now,</p>
<table id="A4.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex125.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>ψ</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex125.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{\pi_{t}(\bm{Z}_{i})}\biggl\{\mathbb{E}\biggl[\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]-\bar{m}_{t}(\bm{Z}_{i})\mathbb{E}\biggl[\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]\biggr\}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\pi_{t}(\bm{Z}_{i})}\biggl\{\mathbb{E}\biggl[\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]-\bar{m}_{t}(\bm{Z}_{i})\mathbb{E}\biggl[\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]\biggr\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I1.i3.p1.2" class="ltx_p">Then,</p>
<table id="A4.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex126.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex126.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\biggl[\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\mathbb{P}(T_{i}=t\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex127.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\biggl[\mathbb{P}(T_{i}=t\mid\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Z}_{i}\biggr]=\mathbb{P}(T_{i}=t\mid\bm{Z}_{i})=\pi_{t}(\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><mo>=</mo><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\mathbb{P}(T_{i}=t\mid\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Z}_{i}\biggr]=\mathbb{P}(T_{i}=t\mid\bm{Z}_{i})=\pi_{t}(\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I1.i3.p1.3" class="ltx_p">and</p>
<table id="A4.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex128.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex128.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\mathbb{E}[\mathbbm{1}\{T_{i}=t\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\mathbb{E}[\mathbbm{1}\{T_{i}=t\}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex129.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\mathbb{E}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Y}_{i},\bm{Z}_{i}]\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\mathbb{E}[\mathbbm{1}\{T_{i}=t\}\mid\bm{Y}_{i},\bm{Z}_{i}]\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex130.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\mathbb{E}[\mathbbm{1}\{T_{i}=t\}\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Y}_{i},\bm{Z}_{i}]\mid\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\mathbb{E}[\mathbbm{1}\{T_{i}=t\}\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Y}_{i},\bm{Z}_{i}]\mid\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex131.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\mathbbm{1}\{T_{i}=t\}\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\mathbbm{1}\{T_{i}=t\}\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex132.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\mathbb{E}[\mathbbm{1}\{T_{i}=t\}\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid T_{i},\bm{Z}_{i}]\mid\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\mathbb{E}[\mathbbm{1}\{T_{i}=t\}\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid T_{i},\bm{Z}_{i}]\mid\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex133.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\biggl[\mathbbm{1}\{T_{i}=t\}\mathbb{E}[\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid T_{i},\bm{Z}_{i}]\mid\bm{Z}_{i}\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\mathbbm{1}\{T_{i}=t\}\mathbb{E}[\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid T_{i},\bm{Z}_{i}]\mid\bm{Z}_{i}\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex134.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}[\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid T_{i}=t,\bm{Z}_{i}]\ \mathbb{P}(T_{i}=t\mid\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo rspace="0.500em" stretchy="false">]</mo></mrow><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}[\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\mid T_{i}=t,\bm{Z}_{i}]\ \mathbb{P}(T_{i}=t\mid\bm{Z}_{i})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex135.m1" class="ltx_Math" alttext="\displaystyle=\bar{m}_{t}(\bm{Z}_{i})\pi(\bm{Z}_{i})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\bar{m}_{t}(\bm{Z}_{i})\pi(\bm{Z}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.I1.i3.p1.4" class="ltx_p">Therefore, <math id="A4.I1.i3.p1.m3" class="ltx_Math" alttext="\mathbb{E}[\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>ψ</mi><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒁</mi><mi>i</mi></msub></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\psi_{3t}(\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Z}_{i}]=0</annotation></semantics></math>.</p>
</div></li>
<li id="A4.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">4.</span> 
<div id="A4.I1.i4.p1" class="ltx_para">
<p id="A4.I1.i4.p1.1" class="ltx_p"><math id="A4.I1.i4.p1.m1" class="ltx_Math" alttext="\psi_{4t}(S,\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi_{4t}(S,\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math>: Finally, I show <math id="A4.I1.i4.p1.m2" class="ltx_math_unparsed" alttext="\mathbb{E}[\psi_{4t}(S,\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1]=0" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>ψ</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\psi_{4t}(S,\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1]=0</annotation></semantics></math>.</p>
<table id="A4.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex136.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{E}[\psi_{4t}(S,\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>ψ</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><mi>S</mi><mo>,</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>,</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\psi_{4t}(S,\tilde{L}_{i},\bm{Y}_{i},\bm{Z}_{i})\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex137.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{\mathbb{P}(S_{i}=1)}\cdot\mathbb{E}\biggl[\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1\biggr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>𝔼</mi><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\mathbb{P}(S_{i}=1)}\cdot\mathbb{E}\biggl[\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\tilde{L}_{i}-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1\biggr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex138.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{\mathbb{P}(S_{i}=1)}\cdot\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbb{E}[\tilde{L}_{i}\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1]-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1\biggr\}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">{</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\mathbb{P}(S_{i}=1)}\cdot\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbb{E}[\tilde{L}_{i}\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1]-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex139.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{\mathbb{P}(S_{i}=1)}\cdot\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbb{E}[\tilde{L}_{i}\mid\bm{Y}_{i},\bm{Z}_{i}]-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1\biggr\}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">{</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\mathbb{P}(S_{i}=1)}\cdot\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbb{E}[\tilde{L}_{i}\mid\bm{Y}_{i},\bm{Z}_{i}]-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex140.m1" class="ltx_math_unparsed" alttext="\displaystyle=\frac{1}{\mathbb{P}(S_{i}=1)}\cdot\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbb{E}[\tilde{L}_{i}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1\biggr\}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo stretchy="false">{</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>−</mo><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{\mathbb{P}(S_{i}=1)}\cdot\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\biggl(\mathbb{E}[\tilde{L}_{i}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})]-\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))\biggr)\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1\biggr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex141.m1" class="ltx_Math" alttext="\displaystyle=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ol>
<p id="A4.SS3.p6.4" class="ltx_p"><span id="A4.SS3.p6.4.1" class="ltx_text">Therefore, since the derived influence function resides in the tangent space, I can conclude that it is the efficient influence function.
∎</span></p>
</div>
</div>
<div id="Thmremark1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmremark1.2" class="ltx_text ltx_font_smallcaps">Remark 1</span></span></h6>
<div id="Thmremark1.p1" class="ltx_para">
<p id="Thmremark1.p1.1" class="ltx_p"><span id="Thmremark1.p1.1.1" class="ltx_text ltx_font_italic">The derived efficient influence function has the same algebraic form as the efficient influence function obtained when conditioning on <math id="Thmremark1.p1.m1" class="ltx_Math" alttext="(\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math> directly rather than surrogate representation <math id="Thmremark1.p1.m2" class="ltx_Math" alttext="\bm{f}(\bm{Y}_{i},\bm{Z}_{i})" display="inline" intent=":literal"><semantics><mrow><mi>𝐟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐘</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐙</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{f}(\bm{Y}_{i},\bm{Z}_{i})</annotation></semantics></math>. This is because under Definition <a href="#Thmdefinition1" title="Definition 1 (Surrogate Representation of Texts) ‣ 3.1 Assumptions, quantity of interest, and nonparametric identification ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, I have</span></p>
<table id="A4.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex142.m1" class="ltx_math_unparsed" alttext="\displaystyle\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))=\mathbb{E}[\tilde{L}_{i}\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1]" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))=\mathbb{E}[\tilde{L}_{i}\mid\bm{Y}_{i},\bm{Z}_{i},S_{i}=1]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex143"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex143.m1" class="ltx_math_unparsed" alttext="\displaystyle\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))=\mathbb{E}[T_{i}\mid\bm{Y}_{i},\bm{Z}_{i}]." display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒇</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><msub><mi>T</mi><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))=\mathbb{E}[T_{i}\mid\bm{Y}_{i},\bm{Z}_{i}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmremark1.p1.2" class="ltx_p"><span id="Thmremark1.p1.2.1" class="ltx_text ltx_font_italic">Consequently, the perturbations of <math id="Thmremark1.p1.m3" class="ltx_Math" alttext="\bm{f}" display="inline" intent=":literal"><semantics><mi>𝐟</mi><annotation encoding="application/x-tex">\bm{f}</annotation></semantics></math> is already absorbed into perturbations of the induced nuisance functions, and the effect of estimating <math id="Thmremark1.p1.m4" class="ltx_Math" alttext="\bm{f}" display="inline" intent=":literal"><semantics><mi>𝐟</mi><annotation encoding="application/x-tex">\bm{f}</annotation></semantics></math> is handled via the convergence rate conditions stated for the composite functions <math id="Thmremark1.p1.m5" class="ltx_Math" alttext="\mu\circ\bm{f}" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>𝐟</mi></mrow><annotation encoding="application/x-tex">\mu\circ\bm{f}</annotation></semantics></math> and <math id="Thmremark1.p1.m6" class="ltx_Math" alttext="\rho_{t}\circ\ \bm{f}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0.222em" rspace="0.722em">∘</mo><mi>𝐟</mi></mrow><annotation encoding="application/x-tex">\rho_{t}\circ\ \bm{f}</annotation></semantics></math> (Assumptions <a href="#Thmassumption4" title="Assumption 4 (Regularity Conditions) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> (c)).</span></p>
</div>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">S4.4 </span>Proof of Theorem <a href="#Thmtheorem2" title="Theorem 2 (Asymptotic Normality) ‣ 3.2 Estimation and inference ‣ 3 The Proposed Methodology with Perfect Annotations ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> (Asymptotic Normality)</h3>

<div id="A4.SS4.p1" class="ltx_para">
<p id="A4.SS4.p1.1" class="ltx_p">For this proof, I use the following lemma to deal with the so-called empirical process term. See <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib36" title="" class="ltx_ref">Kennedy (2023)</a></cite> for the detailed explanation.</p>
</div>
<div id="Thmlemma2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma2.2" class="ltx_text ltx_font_smallcaps">Lemma 2</span></span><span id="Thmlemma2.3" class="ltx_text ltx_font_smallcaps"> (Lemma 2 of <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib26" title="" class="ltx_ref">Kennedy et al. 2020</a></cite>)</span></h6>
<div id="Thmlemma2.p1" class="ltx_para">
<p id="Thmlemma2.p1.1" class="ltx_p"><span id="Thmlemma2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma2.p1.m1" class="ltx_Math" alttext="\hat{f}(z)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(z)</annotation></semantics></math> be a function estimated from a sample <math id="Thmlemma2.p1.m2" class="ltx_Math" alttext="(Z_{n+1},\cdots,Z_{N})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>Z</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Z_{n+1},\cdots,Z_{N})</annotation></semantics></math>, and let <math id="Thmlemma2.p1.m3" class="ltx_Math" alttext="\hat{\mathcal{P}}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\hat{\mathcal{P}}_{n}</annotation></semantics></math> be the empirical measure over <math id="Thmlemma2.p1.m4" class="ltx_Math" alttext="(Z_{1},\cdots,Z_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mn>1</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>Z</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Z_{1},\cdots,Z_{n})</annotation></semantics></math> (i.e., <math id="Thmlemma2.p1.m5" class="ltx_Math" alttext="\hat{\mathcal{P}}_{n}=\frac{1}{n}\sum_{i=1}^{n}\delta_{Z_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><msub><mi>δ</mi><msub><mi>Z</mi><mi>i</mi></msub></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mathcal{P}}_{n}=\frac{1}{n}\sum_{i=1}^{n}\delta_{Z_{i}}</annotation></semantics></math>), which is independent of <math id="Thmlemma2.p1.m6" class="ltx_Math" alttext="(Z_{n+1},\cdots,Z_{N})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi>Z</mi><mi>N</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(Z_{n+1},\cdots,Z_{N})</annotation></semantics></math>. Then,</span></p>
<table id="A4.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex144.m1" class="ltx_Math" alttext="\displaystyle\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{f}-f)=O_{p}\biggl(\frac{\lVert\hat{f}-f\rVert_{2}}{\sqrt{n}}\biggr)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">{</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><mi>f</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>O</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo>−</mo><mi>f</mi></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><msqrt><mi>n</mi></msqrt></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{f}-f)=O_{p}\biggl(\frac{\lVert\hat{f}-f\rVert_{2}}{\sqrt{n}}\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="Thmlemma2.p1.2" class="ltx_p"><span id="Thmlemma2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="Thmlemma2.p1.m7" class="ltx_Math" alttext="\lVert\cdot\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo fence="true" rspace="0em">∥</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="true" lspace="0em">∥</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\lVert\cdot\rVert_{2}</annotation></semantics></math> is <math id="Thmlemma2.p1.m8" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math> norm and <math id="Thmlemma2.p1.m9" class="ltx_Math" alttext="\mathcal{P}(f)=\mathcal{P}\{f(Z_{i})\}=\int f(z)d\mathcal{P}(z)" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Z</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mo>∫</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}(f)=\mathcal{P}\{f(Z_{i})\}=\int f(z)d\mathcal{P}(z)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.p2" class="ltx_para">
<p id="A4.SS4.p2.1" class="ltx_p"><span id="A4.SS4.p2.1.1" class="ltx_text">Let <math id="A4.SS4.p2.m1" class="ltx_Math" alttext="\hat{\mathcal{P}}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\hat{\mathcal{P}}_{n}</annotation></semantics></math> be a probability distribution consistent with the estimated nuisance functions <math id="A4.SS4.p2.m2" class="ltx_Math" alttext="\hat{\pi}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>π</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\pi}</annotation></semantics></math>, <math id="A4.SS4.p2.m3" class="ltx_Math" alttext="\hat{\mu}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>μ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\mu}</annotation></semantics></math>, and <math id="A4.SS4.p2.m4" class="ltx_Math" alttext="\hat{\bm{f}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\bm{f}}</annotation></semantics></math>, <math id="A4.SS4.p2.m5" class="ltx_Math" alttext="\Psi_{t}(\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Psi_{t}(\mathcal{P})</annotation></semantics></math> be an estimator constructed from <math id="A4.SS4.p2.m6" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> i.i.d. sample from <math id="A4.SS4.p2.m7" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>, <math id="A4.SS4.p2.m8" class="ltx_Math" alttext="O_{i}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mi>i</mi></msub><annotation encoding="application/x-tex">O_{i}</annotation></semantics></math> be a specific observed data point indexed by <math id="A4.SS4.p2.m9" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, and <math id="A4.SS4.p2.m10" class="ltx_Math" alttext="\psi_{t}(O_{i},\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi_{t}(O_{i},\mathcal{P})</annotation></semantics></math> be an efficient influence function of the observation <math id="A4.SS4.p2.m11" class="ltx_Math" alttext="O_{i}" display="inline" intent=":literal"><semantics><msub><mi>O</mi><mi>i</mi></msub><annotation encoding="application/x-tex">O_{i}</annotation></semantics></math> under the distribution <math id="A4.SS4.p2.m12" class="ltx_Math" alttext="\mathcal{P}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒫</mi><annotation encoding="application/x-tex">\mathcal{P}</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS4.p3" class="ltx_para">
<p id="A4.SS4.p3.1" class="ltx_p"><span id="A4.SS4.p3.1.1" class="ltx_text">Now, consider the parametric submodel <math id="A4.SS4.p3.m1" class="ltx_Math" alttext="\mathcal{P}_{\epsilon}=(1-\epsilon)\mathcal{P}+\epsilon\hat{\mathcal{P}}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo>+</mo><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}_{\epsilon}=(1-\epsilon)\mathcal{P}+\epsilon\hat{\mathcal{P}}_{n}</annotation></semantics></math>. Recall that the von Mises expansion yields</span></p>
<table id="A4.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E9.m1" class="ltx_Math" alttext="\displaystyle\Psi_{t}(\hat{\mathcal{P}}_{n})=\Psi_{t}(\mathcal{P})+\frac{d\Psi(\mathcal{P}_{\epsilon})}{d\epsilon}\biggl|_{\epsilon=1}(0-1)+R(\hat{\mathcal{P}}_{n},\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Ψ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>ϵ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mrow><mi>ϵ</mi><mo>=</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>0</mn><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Psi_{t}(\hat{\mathcal{P}}_{n})=\Psi_{t}(\mathcal{P})+\frac{d\Psi(\mathcal{P}_{\epsilon})}{d\epsilon}\biggl|_{\epsilon=1}(0-1)+R(\hat{\mathcal{P}}_{n},\mathcal{P})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(S9)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p3.2" class="ltx_p"><span id="A4.SS4.p3.2.1" class="ltx_text">where <math id="A4.SS4.p3.m2" class="ltx_Math" alttext="R(\hat{\mathcal{P}}_{n},\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">R(\hat{\mathcal{P}}_{n},\mathcal{P})</annotation></semantics></math> denotes the remainder term of the expansion. Then, by Equation (14) of <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib33" title="" class="ltx_ref">Hines et al. (2022)</a></cite>,</span></p>
<table id="A4.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex145.m1" class="ltx_Math" alttext="\displaystyle\sqrt{n}\biggl(\Psi_{t}(\hat{\mathcal{P}}_{n})-\Psi_{t}(\mathcal{P})\biggr)=\frac{1}{\sqrt{n}}\sum_{i=1}^{n}\psi_{t}(O_{i},\mathcal{P})-H_{1}+H_{2}-\sqrt{n}R(\hat{\mathcal{P}}_{n},\mathcal{P})" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi mathvariant="normal">Ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>−</mo><msub><mi>H</mi><mn>1</mn></msub></mrow><mo>+</mo><msub><mi>H</mi><mn>2</mn></msub></mrow><mo>−</mo><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{n}\biggl(\Psi_{t}(\hat{\mathcal{P}}_{n})-\Psi_{t}(\mathcal{P})\biggr)=\frac{1}{\sqrt{n}}\sum_{i=1}^{n}\psi_{t}(O_{i},\mathcal{P})-H_{1}+H_{2}-\sqrt{n}R(\hat{\mathcal{P}}_{n},\mathcal{P})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p3.3" class="ltx_p"><span id="A4.SS4.p3.3.1" class="ltx_text">where</span></p>
<table id="A4.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex146.m1" class="ltx_Math" alttext="\displaystyle H_{1}=\frac{1}{\sqrt{n}}\sum_{i=1}^{n}\psi_{t}(O_{i},\hat{\mathcal{P}}_{n}),\quad H_{2}=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{\psi}_{t}-\psi_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>n</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>O</mi><mi>i</mi></msub><mo>,</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>H</mi><mn>2</mn></msub><mo>=</mo><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>ψ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{1}=\frac{1}{\sqrt{n}}\sum_{i=1}^{n}\psi_{t}(O_{i},\hat{\mathcal{P}}_{n}),\quad H_{2}=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{\psi}_{t}-\psi_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p3.4" class="ltx_p"><span id="A4.SS4.p3.4.1" class="ltx_text">and <math id="A4.SS4.p3.m3" class="ltx_Math" alttext="\hat{\psi}_{t}=\psi_{t}(\hat{\mathcal{P}}_{n})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>=</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\psi}_{t}=\psi_{t}(\hat{\mathcal{P}}_{n})</annotation></semantics></math> is the influence function constructed from the empirical distribution <math id="A4.SS4.p3.m4" class="ltx_Math" alttext="\hat{\mathcal{P}}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\hat{\mathcal{P}}_{n}</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS4.p4" class="ltx_para">
<p id="A4.SS4.p4.1" class="ltx_p"><span id="A4.SS4.p4.1.1" class="ltx_text">Now, I analyze each term. The term <math id="A4.SS4.p4.m1" class="ltx_Math" alttext="H_{1}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>1</mn></msub><annotation encoding="application/x-tex">H_{1}</annotation></semantics></math> is called bias-term, and as I solve the estimating equation so that this term becomes zero, <math id="A4.SS4.p4.m2" class="ltx_Math" alttext="H_{1}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>1</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">H_{1}=0</annotation></semantics></math> by construction. The second term <math id="A4.SS4.p4.m3" class="ltx_Math" alttext="H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">H_{2}</annotation></semantics></math> is called the empirical process term, and I use Lemma <a href="#Thmlemma2" title="Lemma 2 (Lemma 2 of ) ‣ S4.4 Proof of Theorem (Asymptotic Normality) ‣ Appendix S4 Theoretical Results ‣ Surrogate Representation Inference for Text and Image Annotations" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> to deal with this term. To do this, I mush show that <math id="A4.SS4.p4.m4" class="ltx_Math" alttext="\hat{\psi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\psi}_{t}</annotation></semantics></math> is consistent for <math id="A4.SS4.p4.m5" class="ltx_Math" alttext="\psi_{t}" display="inline" intent=":literal"><semantics><msub><mi>ψ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\psi_{t}</annotation></semantics></math> in <math id="A4.SS4.p4.m6" class="ltx_Math" alttext="L_{2}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mn>2</mn></msub><annotation encoding="application/x-tex">L_{2}</annotation></semantics></math> norm. Now,</span></p>
<table id="A4.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex147"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex147.m1" class="ltx_Math" alttext="\displaystyle H_{2}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle H_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex147.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{\psi}_{t}-\psi_{t})=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}\biggl(\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(H_{21}-H_{22})+\mathbbm{1}\{T_{i}=t\}H_{23}+H_{24}\biggr)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msqrt><mi>n</mi></msqrt><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">}</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>ψ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>ψ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msqrt><mi>n</mi></msqrt><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mi class="ltx_font_mathcaligraphic">𝒫</mi><mo stretchy="false">}</mo></mrow><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mstyle displaystyle="true"><mfrac><msub><mi>S</mi><mi>i</mi></msub><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo stretchy="false">(</mo><msub><mi>H</mi><mn>21</mn></msub><mo>−</mo><msub><mi>H</mi><mn>22</mn></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">}</mo></mrow><msub><mi>H</mi><mn>23</mn></msub><mo>+</mo><msub><mi>H</mi><mn>24</mn></msub><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}(\hat{\psi}_{t}-\psi_{t})=\sqrt{n}\{\hat{\mathcal{P}}_{n}-\mathcal{P}\}\biggl(\frac{S_{i}}{\mathbb{P}(S_{i}=1)}(H_{21}-H_{22})+\mathbbm{1}\{T_{i}=t\}H_{23}+H_{24}\biggr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p4.2" class="ltx_p"><span id="A4.SS4.p4.2.1" class="ltx_text">where</span></p>
<table id="A4.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex148.m1" class="ltx_Math" alttext="\displaystyle H_{21}=\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}-\frac{\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))}{\hat{\pi}_{t}(\bm{Z}_{i})}\biggr\}\tilde{L}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>21</mn></msub><mo>=</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{21}=\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}-\frac{\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))}{\hat{\pi}_{t}(\bm{Z}_{i})}\biggr\}\tilde{L}_{i}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex149.m1" class="ltx_Math" alttext="\displaystyle H_{22}=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\frac{\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))}{\hat{\pi}_{t}(\bm{Z}_{i})}\hat{\mu}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>22</mn></msub><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{22}=\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\frac{\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))}{\hat{\pi}_{t}(\bm{Z}_{i})}\hat{\mu}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex150.m1" class="ltx_Math" alttext="\displaystyle H_{23}=\frac{\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}-\frac{\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-\hat{\bar{m}}_{t}(\bm{Z}_{i})}{\hat{\pi}_{t}(\bm{Z}_{i})}" display="inline" intent=":literal"><semantics><mrow><msub><mi>H</mi><mn>23</mn></msub><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle H_{23}=\frac{\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}-\frac{\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))-\hat{\bar{m}}_{t}(\bm{Z}_{i})}{\hat{\pi}_{t}(\bm{Z}_{i})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex151.m1" class="ltx_Math" alttext="\displaystyle H_{24}=\bar{m}_{t}(\bm{Z}_{i})-\hat{\bar{m}}_{t}(\bm{Z}_{i})." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>H</mi><mn>24</mn></msub><mo>=</mo><mrow><mrow><msub><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle H_{24}=\bar{m}_{t}(\bm{Z}_{i})-\hat{\bar{m}}_{t}(\bm{Z}_{i}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS4.p4.3" class="ltx_p"><span id="A4.SS4.p4.3.1" class="ltx_text">Then, I analyze each term. For <math id="A4.SS4.p4.m7" class="ltx_Math" alttext="H_{21}" display="inline" intent=":literal"><semantics><msub><mi>H</mi><mn>21</mn></msub><annotation encoding="application/x-tex">H_{21}</annotation></semantics></math>,</span></p>
<table id="A4.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex152.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\biggl[|H_{21}|^{2}\biggr]^{\frac{1}{2}}=\mathbb{E}\biggl[\biggl|\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}-\frac{\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))}{\hat{\pi}_{t}(\bm{Z}_{i})}\biggr\}\tilde{L}_{i}\biggr|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo stretchy="false">|</mo><msub><mi>H</mi><mn>21</mn></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><mo stretchy="false">{</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>ρ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mover accent="true"><mi>ρ</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mover accent="true"><mi>𝒇</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[|H_{21}|^{2}\biggr]^{\frac{1}{2}}=\mathbb{E}\biggl[\biggl|\biggl\{\frac{\rho_{t}(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))}{\pi_{t}(\bm{Z}_{i})}-\frac{\hat{\rho}_{t}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))}{\hat{\pi}_{t}(\bm{Z}_{i})}\biggr\}\tilde{L}_{i}\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
