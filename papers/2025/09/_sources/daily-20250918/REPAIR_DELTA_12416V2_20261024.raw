ace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mover accent="true"><mi>m</mi><mo>¯</mo></mover><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\biggl[|H_{23}|^{2}\biggr]^{\frac{1}{2}}=\mathbb{E}\biggl[\biggl|\frac{\mu(\bm{f}(\bm{Y}_{i},\bm{Z}_{i}))-\bar{m}_{t}(\bm{Z}_{i})}{\pi_{t}(\bm{Z}_{i})}-\frac{{\hat{\mu}(\hat{\bm{f}}(\bm{Y}_{i},\bm{Z}_{i}))}-{\hat{\bar{m}}_{t}(\bm{Z}_{i})}}{{\hat{\pi}_{t}(\bm{Z}_{i})}}\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
