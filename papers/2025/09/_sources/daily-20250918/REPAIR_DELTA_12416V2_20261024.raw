<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex346.m1" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}\biggl\{\mathbb{E}\biggl[\biggl|\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\biggr|^{2}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})\biggr]\biggr\}^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><mrow><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0.167em">∣</mo><mrow><mi>𝒇</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝒁</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}\biggl\{\mathbb{E}\biggl[\biggl|\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\biggr|^{2}\mid\bm{f}(\bm{Y}_{i},\bm{Z}_{i})\biggr]\biggr\}^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex347"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex347.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}\biggl[\biggl|\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\biggr|^{2}\biggr]^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em">[</mo><msup><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><mn>2</mn></msup><mo maxsize="2.100em" minsize="2.100em">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\biggl[\biggl|\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\biggr|^{2}\biggr]^{\frac{1}{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS8.p3.4" class="ltx_p"><span id="A4.SS8.p3.4.1" class="ltx_text">where the first inequality is by Jensen’s inequality and the second line is by the law of iterated expectation. I thus only need to bound the <math id="A4.SS8.p3.m2" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math> convergence of surrogate outcome. Let</span></p>
<table id="A4.EGx135" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex348"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex348.m1" class="ltx_Math" alttext="\displaystyle g(X,u,v)=\frac{X-u}{v-u},\quad X\in\{0,1\},\;0\leq u&lt;v\leq 1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mi>X</mi><mo>−</mo><mi>u</mi></mrow><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow></mfrac></mstyle></mrow><mo rspace="1.167em">,</mo><mrow><mi>X</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo><mrow><mn> 0</mn><mo>≤</mo><mi>u</mi><mo>&lt;</mo><mi>v</mi><mo>≤</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle g(X,u,v)=\frac{X-u}{v-u},\quad X\in\{0,1\},\;0\leq u&lt;v\leq 1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS8.p3.5" class="ltx_p"><span id="A4.SS8.p3.5.1" class="ltx_text">As <math id="A4.SS8.p3.m3" class="ltx_Math" alttext="u&lt;v" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>&lt;</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">u&lt;v</annotation></semantics></math>, there always exists a constant <math id="A4.SS8.p3.m4" class="ltx_Math" alttext="c_{3}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>3</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{3}&gt;0</annotation></semantics></math> such that <math id="A4.SS8.p3.m5" class="ltx_Math" alttext="v-u\geq c_{3}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow><mo>≥</mo><msub><mi>c</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">v-u\geq c_{3}</annotation></semantics></math>. Then, by fixing <math id="A4.SS8.p3.m6" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, the quotient rule yields</span></p>
<table id="A4.EGx136" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex349"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex349.m1" class="ltx_Math" alttext="\displaystyle\begin{cases}\partial_{u}g&amp;=\frac{-(u-v)-(X-u)(-1)}{(u-v)^{2}}=\frac{-(u-v)+(X-u)}{(u-v)^{2}}=\frac{X-v}{(u-v)^{2}}\\
\partial_{v}g&amp;=\frac{-(X-u)}{(u-v)^{2}}=\frac{X-u}{(u-v)^{2}}\end{cases}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mo>∂</mo><mi>u</mi></msub><mi>g</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mfrac><mrow><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>=</mo><mfrac><mrow><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>=</mo><mfrac><mrow><mi>X</mi><mo>−</mo><mi>v</mi></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mo>∂</mo><mi>v</mi></msub><mi>g</mi></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mfrac><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo>=</mo><mfrac><mrow><mi>X</mi><mo>−</mo><mi>u</mi></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>u</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle\begin{cases}\partial_{u}g&amp;=\frac{-(u-v)-(X-u)(-1)}{(u-v)^{2}}=\frac{-(u-v)+(X-u)}{(u-v)^{2}}=\frac{X-v}{(u-v)^{2}}\\
\partial_{v}g&amp;=\frac{-(X-u)}{(u-v)^{2}}=\frac{X-u}{(u-v)^{2}}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS8.p3.6" class="ltx_p"><span id="A4.SS8.p3.6.1" class="ltx_text">Hence, for any <math id="A4.SS8.p3.m7" class="ltx_Math" alttext="(u,v)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(u,v)</annotation></semantics></math>, I have</span></p>
<table id="A4.EGx137" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex350"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex350.m1" class="ltx_Math" alttext="\displaystyle|\partial_{u}g|=\frac{|X-v|}{(v-u)^{2}}\leq\frac{1}{(v-u)^{2}}\leq\frac{1}{c_{3}^{2}},\quad|\partial_{v}g|=\frac{|X-u|}{(v-u)^{2}}\leq\frac{1}{(v-u)^{2}}\leq\frac{1}{c_{3}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mo lspace="0em">∂</mo><mi>u</mi></msub><mi>g</mi></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>−</mo><mi>v</mi></mrow><mo stretchy="false">|</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>c</mi><mn>3</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mo lspace="0em">∂</mo><mi>v</mi></msub><mi>g</mi></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>c</mi><mn>3</mn><mn>2</mn></msubsup></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|\partial_{u}g|=\frac{|X-v|}{(v-u)^{2}}\leq\frac{1}{(v-u)^{2}}\leq\frac{1}{c_{3}^{2}},\quad|\partial_{v}g|=\frac{|X-u|}{(v-u)^{2}}\leq\frac{1}{(v-u)^{2}}\leq\frac{1}{c_{3}^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS8.p3.7" class="ltx_p"><span id="A4.SS8.p3.7.1" class="ltx_text">Let <math id="A4.SS8.p3.m8" class="ltx_Math" alttext="\gamma(t)=[u_{1},v_{1}]^{\scriptscriptstyle\mathsf{T}}+t\cdot[u_{2},v_{2}]^{\scriptscriptstyle\mathsf{T}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub></mrow><mo stretchy="false">]</mo></mrow><mi mathsize="0.710em">𝖳</mi></msup><mo>+</mo><mrow><mi>t</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>u</mi><mn>2</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow><mi mathsize="0.710em">𝖳</mi></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma(t)=[u_{1},v_{1}]^{\scriptscriptstyle\mathsf{T}}+t\cdot[u_{2},v_{2}]^{\scriptscriptstyle\mathsf{T}}</annotation></semantics></math> and set <math id="A4.SS8.p3.m9" class="ltx_Math" alttext="h(t)=g(\gamma(t))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h(t)=g(\gamma(t))</annotation></semantics></math>. By mean value theorem, there exists <math id="A4.SS8.p3.m10" class="ltx_Math" alttext="t^{*}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><msup><mi>t</mi><mo>∗</mo></msup><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t^{*}\in(0,1)</annotation></semantics></math> such that</span></p>
<table id="A4.EGx138" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex351"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex351.m1" class="ltx_Math" alttext="\displaystyle g(X,u_{2},v_{2})-g(X,u_{1},v_{1})=h(1)-h(0)=h^{\prime}(t^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><msub><mi>u</mi><mn>2</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msup><mi>h</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle g(X,u_{2},v_{2})-g(X,u_{1},v_{1})=h(1)-h(0)=h^{\prime}(t^{*})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS8.p3.8" class="ltx_p"><span id="A4.SS8.p3.8.1" class="ltx_text">Notice that by chain rule, <math id="A4.SS8.p3.m11" class="ltx_Math" alttext="h^{\prime}(t)=\nabla g(\gamma(t))\cdot([u_{2},v_{2}]^{\scriptscriptstyle\mathsf{T}}-[u_{1},v_{1}]^{\scriptscriptstyle\mathsf{T}})" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>h</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>g</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>u</mi><mn>2</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mo stretchy="false">]</mo></mrow><mi mathsize="0.710em">𝖳</mi></msup><mo>−</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub></mrow><mo stretchy="false">]</mo></mrow><mi mathsize="0.710em">𝖳</mi></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{\prime}(t)=\nabla g(\gamma(t))\cdot([u_{2},v_{2}]^{\scriptscriptstyle\mathsf{T}}-[u_{1},v_{1}]^{\scriptscriptstyle\mathsf{T}})</annotation></semantics></math>. Hence, by triangular inequality,</span></p>
<table id="A4.E15" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E15X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E15X.m2" class="ltx_Math" alttext="\displaystyle|g(X,u_{2},v_{2})-g(X,u_{1},v_{1})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><msub><mi>u</mi><mn>2</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|g(X,u_{2},v_{2})-g(X,u_{1},v_{1})|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E15X.m3" class="ltx_Math" alttext="\displaystyle\leq|\partial_{u}g(\gamma(t^{*}))|\cdot|u_{2}-u_{1}|+|\partial_{v}g(\gamma(t^{*}))|\cdot|v_{2}-v_{1}|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mo lspace="0em">∂</mo><mi>u</mi></msub><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>u</mi><mn>2</mn></msub><mo>−</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mo lspace="0em">∂</mo><mi>v</mi></msub><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>t</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>v</mi><mn>2</mn></msub><mo>−</mo><msub><mi>v</mi><mn>1</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq|\partial_{u}g(\gamma(t^{*}))|\cdot|u_{2}-u_{1}|+|\partial_{v}g(\gamma(t^{*}))|\cdot|v_{2}-v_{1}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(S15)</span></td></tr>
<tr id="A4.E15Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E15Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{c_{3}^{2}}\biggl(|u_{1}-u_{2}|+|v_{1}-v_{2}|\biggr)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msubsup><mi>c</mi><mn>3</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>−</mo><msub><mi>u</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>v</mi><mn>1</mn></msub><mo>−</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{c_{3}^{2}}\biggl(|u_{1}-u_{2}|+|v_{1}-v_{2}|\biggr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS8.p3.9" class="ltx_p"><span id="A4.SS8.p3.9.1" class="ltx_text">Also, notice that</span></p>
<table id="A4.EGx139" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex352"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex352.m1" class="ltx_Math" alttext="\displaystyle|X-u|=\begin{cases}u\quad(x=0)\\
1-u\quad(x=1)\end{cases}\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>u</mi><mspace style="width:1em;" width="1em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>1</mn><mo>−</mo><mi>u</mi></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd></mtd></mtr></mtable></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle|X-u|=\begin{cases}u\quad(x=0)\\
1-u\quad(x=1)\end{cases}\leq 1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS8.p3.10" class="ltx_p"><span id="A4.SS8.p3.10.1" class="ltx_text">and hence</span></p>
<table id="A4.EGx140" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E16.m1" class="ltx_Math" alttext="\displaystyle|g(X,u,v)|=\frac{|X-u|}{v-u}\leq\frac{1}{v-u}\leq\frac{1}{c_{3}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">|</mo><mrow><mi>X</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">|</mo></mrow><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>c</mi><mn>3</mn></msub></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle|g(X,u,v)|=\frac{|X-u|}{v-u}\leq\frac{1}{v-u}\leq\frac{1}{c_{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(S16)</span></td></tr></tbody>
</table>
<p id="A4.SS8.p3.11" class="ltx_p"><span id="A4.SS8.p3.11.1" class="ltx_text">Now, let</span></p>
<table id="A4.EGx141" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex353"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex353.m1" class="ltx_math_unparsed" alttext="\displaystyle p_{c}^{(j)}=\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}\neq c),\quad q_{c}^{(j)}=\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}=c),\quad X^{(j)}_{c}=\mathbbm{1}\{\tilde{L}^{(j)}_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>p</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><msubsup><mi>q</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>ℙ</mi><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo rspace="1.167em">,</mo><msubsup><mi>X</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle p_{c}^{(j)}=\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}\neq c),\quad q_{c}^{(j)}=\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}=c),\quad X^{(j)}_{c}=\mathbbm{1}\{\tilde{L}^{(j)}_{i}=c\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS8.p3.12" class="ltx_p"><span id="A4.SS8.p3.12.1" class="ltx_text">for all <math id="A4.SS8.p3.m12" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> and <math id="A4.SS8.p3.m13" class="ltx_Math" alttext="k\in\{1,\cdots,K\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k\in\{1,\cdots,K\}</annotation></semantics></math>, and denote <math id="A4.SS8.p3.m14" class="ltx_Math" alttext="\hat{p}_{c}^{(j)}=\widehat{\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}\neq c)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>p</mi><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mover accent="true"><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>≠</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">\hat{p}_{c}^{(j)}=\widehat{\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}\neq c)}</annotation></semantics></math> and <math id="A4.SS8.p3.m15" class="ltx_Math" alttext="\hat{q}_{c}^{(j)}=\widehat{\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}=c)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mover accent="true"><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>c</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>L</mi><mi>i</mi></msub><mo>=</mo><mi>c</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">\hat{q}_{c}^{(j)}=\widehat{\mathbb{P}(\tilde{L}^{(j)}_{i}=c\mid L_{i}=c)}</annotation></semantics></math> as the predicted quantities. Using the derived inequality, I obtain</span></p>
<table id="A4.EGx142" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex354"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex354.m1" class="ltx_Math" alttext="\displaystyle\biggl|\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\biggr|" display="inline" intent=":literal"><semantics><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>M</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\biggl|\hat{M}_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})-M_{c}(\tilde{L}_{i}^{(1)},\tilde{L}_{i}^{(2)})\biggr|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex355"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex355.m1" class="ltx_Math" alttext="\displaystyle=\biggl|g\bigl(X_{c}^{(1)},\hat{p}_{c}^{(1)},\hat{q}_{c}^{(1)}\bigr)g\bigl(X_{c}^{(2)},\hat{p}_{c}^{(2)},\hat{q}_{c}^{(2)}\bigr)-g\bigl(X_{c}^{(1)},{p}_{c}^{(1)},{q}_{c}^{(1)}\bigr)g\bigl(X_{c}^{(2)},{p}_{c}^{(2)},{q}_{c}^{(2)}\bigr)\biggr|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo maxsize="2.100em" minsize="2.100em" stretchy="true">|</mo><mrow><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>X</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>p</mi><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>X</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>p</mi><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mover accent="true"><mi>q</mi><mo>^</mo></mover><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>X</mi><mi>c</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>p</mi><mi>c</mi><mrow><mo str