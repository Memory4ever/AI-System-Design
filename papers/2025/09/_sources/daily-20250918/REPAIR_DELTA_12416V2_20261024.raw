<li id="A3.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(c)</span> 
<div id="A3.I1.ix3.p1" class="ltx_para">
<p id="A3.I1.ix3.p1.1" class="ltx_p"><span id="A3.I1.ix3.p1.1.1" class="ltx_text ltx_font_italic">For each </span><math id="A3.I1.ix3.p1.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="A3.I1.ix3.p1.1.2" class="ltx_text ltx_font_italic">,</span></p>
