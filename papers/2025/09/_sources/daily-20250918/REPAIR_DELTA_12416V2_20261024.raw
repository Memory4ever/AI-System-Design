<msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>0</mn><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mo>⋯</mo></mtd><mtd><mrow><mi>ℙ</mi><mo stretchy="false">(</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo>,</mo><mover accent="true"><mi>L</mi><mo>~</mo></mover><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>C</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒁</mi><msub><mrow></mrow><mi>i</mi></msub><mo>,</mo><mi>S</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=0\mid\bm{Z}_{i},S_{i}=1)&amp;\cdots&amp;\mathbb{P}(\tilde{L}^{(1)}_{i}=0,\tilde{L}^{(2)}_{i}=C\mid\bm{Z}_{i},S_{i}=1)\\
