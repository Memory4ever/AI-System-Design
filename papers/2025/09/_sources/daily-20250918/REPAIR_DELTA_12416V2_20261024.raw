<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex229.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i})\int_{\mathcal{Y}}\mathbb{P}(\bm{Z}_{i}=\bm{z}\mid\bm{Y}_{i})dF(\bm{Y}_{i}\mid L_{i})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msubsup><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mi>l</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝒁</mi><mi>i</mi></msub><mo>=</mo><mi>𝒛</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒀</mi><mi>i</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>L</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}(\tilde{L}_{i}^{(j)}=l\mid L_{i})\int_{\mathcal{Y}}\mathbb{P}(\bm{Z}_{i}=\bm{z}\mid\bm{Y}_{i})dF(\bm{Y}_{i}\mid L_{i})</annotation></semantics></math></td>
