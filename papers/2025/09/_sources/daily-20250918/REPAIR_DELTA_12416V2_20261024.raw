<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex81.m1" class="ltx_math_unparsed" alttext="\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}\biggl\{\frac{\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}},S_{i}=1\}}{f_{\mathcal{P}}(\bm{y},\bm{z},S_{i}=1)}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{y},\bm{z},S_{i}=1]\biggr)\biggr\}\,f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></msub></mstyle><mstyle displaystyle="true"><msub><mo>∫</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></msub></mstyle><mrow><mo stretchy="false">{</mo><mstyle displaystyle="true"><mfrac><mrow><mn>𝟙</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mi>𝒚</mi><mo>=</mo><mover accent="true"><mi>𝒚</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><mi>𝒛</mi><mo>=</mo><mover accent="true"><mi>𝒛</mi><mo>~</mo></mover></mrow><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><mrow><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mover accent="true"><mi>l</mi><mo>~</mo></mover><mo>−</mo><msub><mi>𝔼</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>L</mi><mo>~</mo></mover><mi>i</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒚</mi><mo>,</mo><mi>𝒛</mi><mo>,</mo><msub><mi>S</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow><mo rspace="0.170em" stretchy="false">}</mo></mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒚</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>𝒛</mi><mo>,</mo><msub><mi>T</mi><mi>i</mi></msub><mo>=</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒫</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>𝒚</mi><mi>d</mi><mi>𝒛</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}\biggl\{\frac{\mathbbm{1}\{\bm{y}=\tilde{\bm{y}},\bm{z}=\tilde{\bm{z}},S_{i}=1\}}{f_{\mathcal{P}}(\bm{y},\bm{z},S_{i}=1)}\biggl(\tilde{l}-\mathbb{E}_{\mathcal{P}}[\tilde{L}_{i}\mid\bm{y},\bm{z},S_{i}=1]\biggr)\biggr\}\,f_{\mathcal{P}}(\bm{y}\mid\bm{z},T_{i}=t)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
