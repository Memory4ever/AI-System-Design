nt="normal">Ψ</mi><mi>t</mi></msub></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>o</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\partial\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\hat{\eta}^{(k)},\Psi_{t})/\partial\Psi_{t}-\nu_{t}(T_{i},\tilde{L}_{i},\hat{L}_{i},S_{i},\bm{Y}_{i},\bm{Z}_{i};\eta^{*},\Psi_{t}^{*})/\partial\Psi_{t}]=o_{p}(1).</annotation></semantics></math></td>
