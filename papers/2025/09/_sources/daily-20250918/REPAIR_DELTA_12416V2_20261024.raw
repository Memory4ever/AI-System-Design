​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒚</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>𝒛</mi></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\mathcal{Z}}\int_{\mathcal{Y}}m_{\mathcal{P}}(\bm{y},\bm{z})\biggl(\frac{\{\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{y},\bm{z},T_{i}=t)|_{\epsilon=0}\}f_{\mathcal{P}}(\bm{z},T_{i}=t)}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}-\frac{\{f_{\mathcal{P}}(\bm{y},\bm{z},T_{i}=t)\{\frac{d}{d\epsilon}f_{\mathcal{P}_{\epsilon}}(\bm{z},T_{i}=t)|_{\epsilon=0}\}}{\{f_{\mathcal{P}}(\bm{z},T_{i}=t)\}^{2}}\biggr)f_{\mathcal{P}}(\bm{z})d\bm{y}d\bm{z}</annotation></semantics></math></td>
