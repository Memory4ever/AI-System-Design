              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              <span id="alg1.l14.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l14.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              <math id="alg1.l15.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{S}\leftarrow-\dfrac{1}{M}\sum_{t\in\mathcal{B}_{\mathrm{val}}}\bar{w}_{t}\log p_{S,t}(a_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>S</mi></msub><mo rspace="0em" stretchy="false">←</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>M</mi></mfrac></mstyle><msub><mo>∑</mo><mrow><mi>t</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℬ</mi><mi>val</mi></msub></mrow></msub><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mi>t</mi></msub><mi>log</mi><msub><mi>p</mi><mrow><mi>S</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{S}\leftarrow-\dfrac{1}{M}\sum_{t\in\mathcal{B}_{\mathrm{val}}}\bar{w}_{t}\log p_{S,t}(a_{t})</annotation></semantics></math>

</div>
<div id="alg1.l16" class="ltx_listingline">
