<span id="S5.T3.1.1.1.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T3.1.1.1.3.2.1.1.1.1" class="ltx_text" style="font-size:80%;">Max entropy</span></span></span>
</span></span><span id="S5.T3.1.1.1.3.3" class="ltx_text"></span></th>
<th id="S5.T3.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_t"><span id="S5.T3.1.1.1.4.1" class="ltx_text"></span> <span id="S5.T3.1.1.1.4.2" class="ltx_text">
<span id="S5.T3.1.1.1.4.2.1" class="ltx_tabular ltx_align_middle">
