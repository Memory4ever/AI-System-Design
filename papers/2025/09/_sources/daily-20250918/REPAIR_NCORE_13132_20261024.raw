              <math id="alg1.l16.m1" class="ltx_Math" alttext="\theta_{S}\leftarrow\theta_{S}-\eta\,\nabla_{\theta_{S}}\mathcal{L}_{S}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>S</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>θ</mi><mi>S</mi></msub><mo>−</mo><mrow><mi>η</mi><mo lspace="0.337em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>θ</mi><mi>S</mi></msub></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>S</mi></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{S}\leftarrow\theta_{S}-\eta\,\nabla_{\theta_{S}}\mathcal{L}_{S}</annotation></semantics></math>

</div>
