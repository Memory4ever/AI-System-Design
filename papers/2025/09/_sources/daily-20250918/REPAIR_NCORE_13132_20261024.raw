<td id="S4.T2.1.1.5.6" class="ltx_td ltx_align_center" style="padding-bottom: 5.0pt;"><math id="S4.T2.m31" class="ltx_Math" alttext="94.00\pm 23.78" display="inline" intent=":literal"><semantics><mrow><mn>94.00</mn><mo>±</mo><mn>23.78</mn></mrow><annotation encoding="application/x-tex">94.00\pm 23.78</annotation></semantics></math></td>
