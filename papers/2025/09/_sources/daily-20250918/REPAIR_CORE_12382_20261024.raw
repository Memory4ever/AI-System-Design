<td id="S3.T2.3.3.4" class="ltx_td ltx_align_center" style="padding:1.4pt 8.0pt;"><span id="S3.T2.3.3.4.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Medium</span></td>
