<td id="S1.T1.3.7.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1.4pt;padding-bottom:1.4pt;"><span id="S1.T1.3.7.4.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#009900;">✓</span></td>
<td id="S1.T1.3.7.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:1.4pt;padding-bottom:1.4pt;"><span id="S1.T1.3.7.5.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#009900;">✓</span></td>
