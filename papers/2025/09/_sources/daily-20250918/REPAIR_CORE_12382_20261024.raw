<td id="S3.T2.3.4.2" class="ltx_td ltx_align_center" style="padding:1.4pt 8.0pt;"><span id="S3.T2.3.4.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Paired</span></td>
<td id="S3.T2.3.4.3" class="ltx_td ltx_align_center" style="padding:1.4pt 8.0pt;"><span id="S3.T2.3.4.3.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Paired</span></td>
<td id="S3.T2.3.4.4" class="ltx_td ltx_align_center" style="padding:1.4pt 8.0pt;"><span id="S3.T2.3.4.4.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Independent</span></td>
