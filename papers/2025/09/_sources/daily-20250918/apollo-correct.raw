<script data-cookieconsent="ignore">
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.nav-bar_icon-close, .nav-bar_content > .button, .nav-bar_content > .press_link-full')) return;
    var bar = e.target.closest('.nav-bar');
    var link = bar && bar.querySelector('a[href]');
    var root = document.documentElement;
    root.classList.add('is-bar-closing');
    try {
      if (link) localStorage.setItem('announcement-dismissed', link.getAttribute('href'));
    } catch (err) {}
    setTimeout(function () {
      root.classList.add('is-bar-closed');
    }, 300);
  });
</script>

