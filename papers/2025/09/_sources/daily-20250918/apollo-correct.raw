<style>
.vd-drop{
  --vd-circle: 2.75rem;        /* 44px toggle, same as the old field */
  --vd-field: 2.75rem;         /* dropped field height */
  --vd-panel: 15.25rem;        /* open width: circle + 200px, as before */
  --vd-pad: 1.25rem;           /* 20px inner padding, same as the old field */
  --vd-offset: 3.175rem;       /* panel top, measured from the top of the icon */
  --vd-border: #E3E3E3;
  --vd-placeholder: #737373;
  --vd-ease: cubic-bezier(.22,.61,.36,1);
 
  position: relative;          /* anchor for the absolute panel */
  flex: 0 0 auto;
  z-index: 20;
}
 
/* ---- toggle: fixed-size circle, so the row never moves ---- */
.vd-drop__toggle{
  position: relative;
  display: grid;
  place-items: center;
  width: var(--vd-circle);
  height: var(--vd-circle);
  padding: 0;
  border: 1px solid var(--vd-border);
  border-radius: 999px;
  background: #fff;
  color: #000;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.vd-drop__toggle svg{ display: block; }
 
.vd-drop__ico{
  position: absolute;
  display: block;
  line-height: 0;
  transition: opacity .2s ease, transform .3s var(--vd-ease);
}
.vd-drop__ico--close{ opacity: 0; transform: rotate(-90deg) scale(.7); }
 
/* toggle icons switch on the open state, like the old nav field */
.vd-drop.is-open > .vd-drop__toggle .vd-drop__ico--search{ opacity: 0; transform: rotate(90deg) scale(.7); }
.vd-drop.is-open > .vd-drop__toggle .vd-drop__ico--close{ opacity: 1; transform: none; }
 
/* ---- panel: absolute, so opening it reflows nothing ---- */
.vd-drop__panel{
  position: absolute;
  top: var(--vd-offset);       /* measured from the top of the toggle icon */
  right: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s ease;
}
.vd-drop.is-open .vd-drop__panel{
  opacity: 1;
  pointer-events: auto;
}
 
/* the pill grows out of the circle: right-anchored width animation,
   exactly the motion of the old field, only downwards */
.vd-drop__form{
  box-sizing: border-box;
  display: flex;
  align-items: center;
  width: var(--vd-circle);
  height: var(--vd-field);
  padding: 0;
  border: 1px solid var(--vd-border);
  border-radius: 999px;
  background: #fff;
  overflow: hidden;
  transition: width .4s var(--vd-ease);
}
.vd-drop.is-open .vd-drop__form{
  width: min(var(--vd-panel), 80vw);
}
 
.vd-drop__input{
  box-sizing: border-box;
  flex: 1 1 auto;
  min-width: 0;
  height: 100%;
  margin: 0;
  padding: 0;                  /* closed: no padding, so the icon stays centred */
  border: 0;
  background: transparent;
  font: inherit;
  font-style: normal;          /* typed text stays upright */
  color: #000;
  opacity: 0;
  transition: padding .4s var(--vd-ease), opacity .2s ease;
}
.vd-drop.is-open .vd-drop__input{
  padding-left: var(--vd-pad);
  opacity: 1;
  transition: padding .4s var(--vd-ease), opacity .25s ease .15s;
}
.vd-drop__input::placeholder{ color: var(--vd-placeholder); font-style: italic; }
.vd-drop__input:focus{ outline: none; }
.vd-drop__input::-webkit-search-cancel-button{ -webkit-appearance: none; appearance: none; }
 
/* hidden submit: exists only so Enter submits the form */
.vd-drop__submit{
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  border: 0;
  opacity: 0;
  pointer-events: none;
}
 
/* square equal to the field height, so the icon is always dead centre */
.vd-drop__btn{
  position: relative;
  flex: 0 0 auto;
  height: 100%;
  aspect-ratio: 1 / 1;
  display: grid;
  place-items: center;
  padding: 0;
  border: 0;
  background: transparent;
  color: #000;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.vd-drop__btn svg{ display: block; }
 
/* inside the panel the icons switch on the value: magnifier searches, cross clears */
.vd-drop.is-filled .vd-drop__btn .vd-drop__ico--search{ opacity: 0; transform: rotate(90deg) scale(.7); }
.vd-drop.is-filled .vd-drop__btn .vd-drop__ico--close{ opacity: 1; transform: none; }
 
/* tablet: everything in the nav scales to 90% — gentler than the 80% we tried
   before. Remove the old 768–991 scaling block if it is still in the Head,
   otherwise the two will fight over the same properties. */
@media (min-width: 768px) and (max-width: 991px){
  /* search circle + dropped field */
  .vd-drop{
    --vd-circle: 2.475rem;     /* 2.75rem × 0.9 */
    --vd-field: 2.475rem;
    --vd-panel: 13.725rem;
    --vd-pad: 1.125rem;
  }
  .vd-drop__toggle svg,
  .vd-drop__btn svg{ width: 1.125rem; height: 1.125rem; }   /* 20px → 18px */
 
  /* Try Watcher: 1rem / 1.38rem paddings × 0.9 */
  .navbar_right .button{
    padding-top: .9rem;
    padding-bottom: .9rem;
    padding-left: 1.242rem;
    padding-right: 1.242rem;
    font-size: .9375rem;       /* 16px → 15px */
  }
 
  /* nav links */
  .navbar_left.is-center-bordered .navbar_menu_link{
    padding-left: .625rem;
    padding-right: .625rem;
    font-size: .9375rem;
  }
}
 
/* the burger panel carries its own field below this width */
@media (max-width: 767px){
  .vd-drop{ display: none; }
}
 
@media (prefers-reduced-motion: reduce){
  .vd-drop__panel,
  .vd-drop__form,
  .vd-drop__input,
  .vd-drop__ico{ transition: none; }
}
 
/* ============================================================
   Always-expanded field — burger menu + search results page.
   Same .vd-search markup and styling as before; kept here so this
   file is self-sufficient when the old CSS block is removed.
   ============================================================ */
.vd-search{
  --vd-size: 2.9375rem;        /* 47px */
  --vd-pad: 1.25rem;           /* 20px */
  --vd-border: #E3E3E3;
  --vd-placeholder: #737373;
  --vd-ease: cubic-bezier(.22,.61,.36,1);
 
  display: block;
  width: 100%;
  max-width: var(--vd-max, 100%);
  margin: 0;
}
 
.vd-search__form{
  box-sizing: border-box;
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: var(--vd-size);
  padding: 0;
  border: 1px solid var(--vd-border);
  border-radius: 999px;
  background: #fff;
  overflow: hidden;
}
 
.vd-search__input{
  box-sizing: border-box;
  flex: 1 1 auto;
  min-width: 0;
  height: 100%;
  margin: 0;
  padding: 0 0 0 var(--vd-pad);
  border: 0;
  background: transparent;
  font: inherit;
  font-style: normal;          /* typed text stays upright */
  color: #000;
}
.vd-search__input::placeholder{ color: var(--vd-placeholder); font-style: italic; }
.vd-search__input:focus{ outline: none; }
.vd-search__input::-webkit-search-cancel-button{ -webkit-appearance: none; appearance: none; }
 
/* hidden submit: exists only so Enter submits the form */
.vd-search__submit{
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  border: 0;
  opacity: 0;
  pointer-events: none;
}
 
/* square equal to the field height, so the icon is always dead centre */
.vd-search__btn{
  position: relative;
  flex: 0 0 auto;
  height: 100%;
  aspect-ratio: 1 / 1;
  display: grid;
  place-items: center;
  padding: 0;
  border: 0;
  background: transparent;
  color: #000;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.vd-search__btn svg{ display: block; }
 
.vd-search__ico{
  position: absolute;
  display: block;
  line-height: 0;
  transition: opacity .2s ease, transform .3s var(--vd-ease);
}
.vd-search__ico--close{ opacity: 0; transform: rotate(-90deg) scale(.7); }
 
/* magnifier searches, cross clears — used on the search results page */
.vd-search.is-filled .vd-search__ico--search{ opacity: 0; transform: rotate(90deg) scale(.7); }
.vd-search.is-filled .vd-search__ico--close{ opacity: 1; transform: none; }
 
/* inside the burger menu: full width of the panel, spacing set in Webflow */
.vd-search--menu{ max-width: none; margin: 0; }
 
/* magnifier-only variants: burger menu and the department filter */
.vd-search--static .vd-search__ico--search,
.vd-search--filter .vd-search__ico--search{ opacity: 1; transform: none; }
.vd-search--static .vd-search__ico--close,
.vd-search--filter .vd-search__ico--close{ display: none; }
 
/* department filter: not a form, lives inside the Finsweet filters form */
.vd-search--filter{ --vd-max: none; }
.vd-search--filter .vd-search__form{
  width: 100%;
  max-height: 2.9375rem;
}
</style></div><div class="hide w-embed w-script">
<script>
(function () {
  function focusQuiet(el) {
    try { el.focus({ preventScroll: true }); }
    catch (e) { el.focus(); }
  }
 
  document.querySelectorAll('[data-vd-drop]').forEach(function (root) {
    if (root.dataset.vdDropBound) return;
    root.dataset.vdDropBound = '1';
 
    var toggle = root.querySelector('[data-vd-drop-toggle]');
    var panel  = root.querySelector('.vd-drop__panel');
    var form   = root.querySelector('form');
    var input  = root.querySelector('[data-vd-drop-input]');
    var btn    = root.querySelector('[data-vd-drop-btn]');
 
    function sync() {
      var filled = !!input.value.trim();
      root.classList.toggle('is-filled', filled);
      btn.setAttribute('aria-label', filled ? 'Clear search' : 'Search');
    }
 
    function open() {
      root.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close search');
      input.tabIndex = 0;
      focusQuiet(input);
    }
 
    function close() {
      root.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open search');
      input.value = '';
      input.tabIndex = -1;
      input.blur();
      sync();
    }
 
    function submit() {
      if (!input.value.trim()) { focusQuiet(input); return; }
      if (form.requestSubmit) form.requestSubmit();
      else form.submit();
    }
 
    input.addEventListener('input', sync);
    sync();
 
    toggle.addEventListener('click', function () {
      root.classList.contains('is-open') ? close() : open();
    });
 
    // with text the panel button clears the field, otherwise it runs the search
    btn.addEventListener('click', function () {
      if (root.classList.contains('is-filled')) {
        input.value = '';
        sync();
        focusQuiet(input);
        return;
      }
      submit();
    });
 
    form.addEventListener('submit', function (e) {
      if (!input.value.trim()) { e.preventDefault(); focusQuiet(input); }
    });
 
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { e.preventDefault(); close(); toggle.focus(); }
    });
 
    // Webflow's navbar / dropdown scripts close on any click inside them
    panel.addEventListener('click', function (e) { e.stopPropagation(); });
 
    // close on outside click, but only while empty
    document.addEventListener('click', function (e) {
      if (!root.classList.contains('is-open')) return;
      if (root.contains(e.target)) return;
      if (!input.value.trim()) close();
    });
  });
})();
</script></div></div><div class="navbar_menu-button w-nav-button"><div class="navbar_menu-icon w-embed"><svg class="navbar_menu-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="100%" height="100%" fill="none">
  <rect class="cnav-bar cnav-bar-1" x="3" y="8"  width="18" height="1" rx="1" fill="currentColor"/>
  <rect class="cnav-bar cnav-bar-2" x="3" y="14" width="18" height="1" rx="1" fill="currentColor"/>
</svg></div></div></div></div></div></div><div class="hide w-embed w-script"><style>
.cnav-inner { display: contents; }
.cnav-backdrop { display: none; }

@media screen and (max-width: 767px) {
  /* Disable Webflow's native overlay — we drive the menu in place. */
  .section-nav .w-nav-overlay { display: none !important; }

  /* Positioning context; overflow visible so the dropdown isn't clipped. */
  .section-nav,
  .section-nav .navbar_container { position: relative; }
  .section-nav,
  .section-nav .navbar_container,
  .section-nav .navbar_contents { overflow: visible !important; }

  /* Remove the nav's outer top/bottom padding. */
  .nav-global .padding-global { padding-top: 0 !important; padding-bottom: 0 !important; }

  /* ---- Header card (logo + toggle); anchor for the dropdown ---- */
  .section-nav .navbar_contents {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 0.75rem;
    padding: 0 0.9em 0 1em;              /* no top/bottom padding */
    background: #eeefef;                 /* always on — no scroll-driven state */
    transition: border-radius 0.3s ease 0.3s;
  }
  /* ...and whenever the menu is open, even at the very top */
  .section-nav[data-navigation-status="active"] .navbar_contents {
    background: #eeefef;
    border-radius: 0.75rem 0.75rem 0 0;  /* open: join the dropdown below */
    transition: border-radius 0.3s ease 0s;
  }

  .section-nav .navbar_brand {
    display: inline-flex;
    width: 7em;
    max-width: 60%;
    margin: 0;
  }

  /* Hide the desktop-only right cluster (Careers + outer Get in touch). */
  .section-nav .navbar_container > .navbar_right,
  .section-nav .navbar_contents > .navbar_right { display: none !important; }

  /* Hamburger — moved into the header by the JS so it sits inside the card. */
  .section-nav .navbar_menu-button {
    position: relative;
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 2.5em;
    height: 2.5em;
    margin: 0;
    padding: 0;
    float: none;
  }

  /* The dropdown = .navbar_left, anchored to .navbar_contents (so it is exactly
     the header width). Overlays the page (no push); card bg only when open. */
  .section-nav .navbar_left {
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 2;
    width: auto;
    /* Webflow gives .navbar_left a fixed height + flex centering; reset both so
       it grows with the menu instead of clipping it / spilling items out. */
    height: auto !important;
    min-height: 0 !important;
    display: block !important;
    align-items: normal !important;
    border: 0 !important;
    /* Webflow's own padding on this element would show up as a strip of card
       background under the mint banner (and gets included at the end of the
       scroll range once the panel is scrollable). */
    padding: 0 !important;
    background: transparent;            /* override Webflow's #eeefef when closed */
    border-radius: 0 0 0.75rem 0.75rem;
    /* .navbar_left is the reveal container so the menu AND the careers banner
       inside it collapse together (banner hidden while the menu is closed). */
    max-height: 0;
    overflow: hidden;
    /* Real available height below the header card. JS overwrites --cnav-max with
       an exact pixel value; the calc() is only a first-paint fallback.
       svh (small viewport height) keeps mobile browser chrome out of the maths. */
    --cnav-max: calc(100svh - 8em);
    /* CLOSE: collapse starts after the text has left (0.3s); the card bg and
       shadow fade a further 0.5s later (0.8s) so the panel empties first. */
    transition: max-height 0.5s cubic-bezier(0.625, 0.05, 0, 1) 0.3s,
                background-color 0.3s ease 0.8s,
                box-shadow 0.3s ease 0.8s;
  }
  .section-nav[data-navigation-status="active"] .navbar_left {
    /* Never taller than the space left under the header — the panel scrolls
       internally instead of running off the bottom of the screen. */
    max-height: var(--cnav-max);
    overflow-x: hidden;
    overflow-y: auto;                   /* scroll the menu, not the page */
    overscroll-behavior: contain;       /* no scroll-chaining to the document */
    -webkit-overflow-scrolling: touch;
    background: #eeefef;
    box-shadow: 0 1em 2em rgba(0, 0, 0, 0.08);
    /* OPEN: expand + bg immediately. */
    transition: max-height 0.5s cubic-bezier(0.625, 0.05, 0, 1) 0s,
                background-color 0.3s ease 0s,
                box-shadow 0.3s ease 0s;
  }

  /* The menu is just the items column now (reveal moved to .navbar_left). */
  .section-nav .navbar_menu {
    display: flex !important;
    flex-direction: column;
    width: 100%;
    margin: 0;
    padding: 0;
    max-height: none !important;
    overflow: visible;
    background: transparent;
    position: static !important;
    float: none !important;
    transform: none !important;
  }
  .section-nav .cnav-inner {
    display: flex !important;
    flex-direction: column;
    width: 100%;
    /* No bottom padding: the mint banner is the last child and must sit flush
       with the bottom edge of the card. Any padding here becomes a strip of
       card background under the banner — visible as a dead gap once the panel
       scrolls (landscape), where the banner is no longer at the card's edge. */
    padding: 0.25em 1em 0;
  }
  /* Belt and braces: nothing in the chain that wraps the mint banner may add
     trailing space, whatever Webflow put on these elements. */
  .section-nav .navbar_left,
  .section-nav .navbar_menu,
  .section-nav .cnav-inner { padding-bottom: 0 !important; }
  .section-nav .navbar_left > :last-child,
  .section-nav .navbar_menu > :last-child,
  .section-nav .cnav-inner > :last-child,
  .section-nav .cnav-item:last-child { margin-bottom: 0 !important; }
  /* If the banner lives inside .cnav-inner, the JS also tags it .cnav-item and it
     inherits the row padding — 0.75em of card background above AND below the
     mint. The banner brings its own padding, so strip the row padding here. */
  .section-nav .cnav-marquee.cnav-item { padding: 0 !important; }

  /* Staggered slide-up reveal; transition-delay set inline by the JS. */
  .section-nav .cnav-item {
    opacity: 0;
    transform: translateY(1em);
    /* CLOSE: reverse of the open motion — same easing, reverse-order stagger
       (bottom item leaves first). --cnav-i-rev = lastIndex - i (set by JS). */
    transition: opacity 0.5s cubic-bezier(0.625, 0.05, 0, 1),
                transform 0.5s cubic-bezier(0.625, 0.05, 0, 1);
    transition-delay: calc(var(--cnav-i-rev, 0) * 0.05s);
    padding: 0.75em 0;                   /* spacing between departments */
  }
  .section-nav[data-navigation-status="active"] .cnav-item {
    opacity: 1;
    transform: translateY(0);
    /* OPEN: staggered reveal (per-item index in --cnav-i, set by JS). */
    transition: opacity 0.5s cubic-bezier(0.625, 0.05, 0, 1),
                transform 0.5s cubic-bezier(0.625, 0.05, 0, 1);
    transition-delay: calc(var(--cnav-i, 0) * 0.05s);
  }
  /* Short viewports (landscape phones): tighten the rows so the whole menu
     still fits without scrolling wherever possible. */
  @media (max-height: 560px) {
    .section-nav .cnav-item { padding: 0.5em 0; }
    .section-nav .cnav-inner { padding: 0.25em 1em 0; }
  }

  /* Flatten the Webflow dropdown: show its sub-links inline. */
  .section-nav .navbar_dropdown { width: 100%; }
  .section-nav .navbar_dropdown .dropdown-toggle { padding: 0; border: 0 !important; }
  .section-nav .navbar_dropdown .dropdown_link-icon { display: none; }
  .section-nav .navbar_dropdown .dropdown_list {
    position: static !important;
    display: flex !important;
    flex-direction: column;
    box-shadow: none;
    margin: 0.25em 0 0;
    padding: 0 0 0 0.75em;
    opacity: 1 !important;
    transform: none !important;
  }

  /* Osmo-style toggle icon: two <rect> bars folding into an X (forced dark). */
  .section-nav .navbar_menu-icon { width: 1.5em; height: 1.5em; overflow: visible; }
  .section-nav .navbar_menu-icon .cnav-bar {
    fill: #131313;
    height: 1.5px;                       /* thinner bars (was 2) — lighter look */
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.5s cubic-bezier(0.65, 0, 0, 1);
  }
  .section-nav .navbar_menu-icon .cnav-bar-1 { y: 8.25px; }
  .section-nav .navbar_menu-icon .cnav-bar-2 { y: 14.25px; }
  /* No :hover nudge — on mobile a tap triggers a sticky :hover that beats the
     active rule (higher specificity) and stops the X from forming. */
  .section-nav[data-navigation-status="active"] .cnav-bar-1 {
    transform: translateY(3px) rotate(45deg);
  }
  .section-nav[data-navigation-status="active"] .cnav-bar-2 {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* ---- Sliding "Careers" marquee — mint banner at the bottom of the card ---- */
  .section-nav .cnav-marquee {
    display: block;
    width: 100%;
    margin: 0.5em 0 0;                   /* gap above only — flush at the bottom */
    padding: 0.85em 1em;
    background: #17cfb9;                 /* primary mint */
    border-radius: 0 0 0.75rem 0.75rem;
    overflow: hidden;
    text-decoration: none;
  }
  .section-nav .cnav-marquee-row { display: flex; width: max-content; }
  .section-nav .cnav-marquee-list {
    display: flex;
    flex: none;
    animation: cnav-marquee 18s linear infinite;
    animation-play-state: paused;
  }
  .section-nav[data-navigation-status="active"] .cnav-marquee-list {
    animation-play-state: running;
  }
  .section-nav .cnav-marquee-text {
    margin: 0;
    padding-right: 0.5em;
    color: #171717;              /* black text on mint */
    white-space: nowrap;
  }
  @keyframes cnav-marquee { to { transform: translateX(-100%); } }

  /* Full-screen dark backdrop behind the card. */
  .section-nav .cnav-backdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #000;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.5, 0.5, 0, 1),
                visibility 0.5s cubic-bezier(0.5, 0.5, 0, 1);
  }
  .section-nav[data-navigation-status="active"] .cnav-backdrop {
    opacity: 0.15;
    visibility: visible;
    pointer-events: auto;
  }
}
</style>

<script>
(function () {
  'use strict';

  function init() {
    // Custom mobile nav is active through Mobile Landscape (<=767px).
    var MOBILE_MQ = '(max-width: 767px)';
    var mql = window.matchMedia(MOBILE_MQ);

    var nav = document.querySelector('.section-nav');
    if (!nav) return;

    var menu = nav.querySelector('.navbar_menu');
    var btn = nav.querySelector('.navbar_menu-button');
    var contents = nav.querySelector('.navbar_contents');

    // Move the hamburger inside the header card.
    if (contents && btn && btn.parentNode !== contents) {
      contents.appendChild(btn);
    }

    // Wrap the menu's children for the staggered reveal.
    var inner = menu ? menu.querySelector('.cnav-inner') : null;
    if (menu && !inner) {
      inner = document.createElement('div');
      inner.className = 'cnav-inner';
      while (menu.firstChild) inner.appendChild(menu.firstChild);
      menu.appendChild(inner);
    }
    if (inner) {
      var n = inner.children.length;
      Array.prototype.forEach.call(inner.children, function (item, i) {
        item.classList.add('cnav-item');
        item.style.setProperty('--cnav-i', i);             // open: forward stagger
        item.style.setProperty('--cnav-i-rev', n - 1 - i); // close: reverse stagger
      });
    }

    // Full-screen dark backdrop (mobile only via CSS).
    var backdrop = nav.querySelector('.cnav-backdrop');
    if (!backdrop) {
      backdrop = document.createElement('div');
      backdrop.className = 'cnav-backdrop';
      nav.insertBefore(backdrop, nav.firstChild);
    }

    var panel = nav.querySelector('.navbar_left');

    function isMobile() { return mql.matches; }
    function isActive() { return nav.getAttribute('data-navigation-status') === 'active'; }

    /* Height budget for the open panel.
       CSS alone can't know how tall the header card is (it is em-based and the
       root font-size is fluid), so measure it and expose the leftover space as
       --cnav-max. Uses visualViewport when available: on mobile Safari/Chrome
       innerHeight ignores the collapsing URL bar, which is exactly the error
       that made the menu run past the bottom edge. */
    function sizePanel() {
      if (!contents || !panel) return;
      var vh = (window.visualViewport && window.visualViewport.height) || window.innerHeight;
      var bottom = contents.getBoundingClientRect().bottom;
      var avail = vh - bottom - 12;                  // 12px breathing room
      panel.style.setProperty('--cnav-max', Math.max(160, Math.round(avail)) + 'px');
    }

    function close() {
      nav.setAttribute('data-navigation-status', 'not-active');
      if (panel) panel.scrollTop = 0;               // next open starts at the top
    }
    function open() {
      sizePanel();                                  // measure before revealing
      nav.setAttribute('data-navigation-status', 'active');
    }
    function toggle() { isActive() ? close() : open(); }

    close(); // start closed

    // Keep the budget correct through rotation, resize and URL-bar collapse.
    var rAF;
    function requestSize() {
      if (!isActive()) return;
      cancelAnimationFrame(rAF);
      rAF = requestAnimationFrame(sizePanel);
    }
    window.addEventListener('resize', requestSize);
    window.addEventListener('orientationchange', requestSize);
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', requestSize);
    }

    // Take over the hamburger in the CAPTURE phase so Webflow's native handler
    // never fires (it would open the native overlay).
    document.addEventListener('click', function (e) {
      if (!isMobile()) return;
      var b = e.target.closest && e.target.closest('.navbar_menu-button');
      if (!b || !nav.contains(b)) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      toggle();
    }, true);

    // The flattened "About" dropdown grows the panel — re-measure after Webflow
    // toggles it so a long sub-list stays reachable.
    nav.addEventListener('click', function (e) {
      if (!isMobile()) return;
      if (e.target.closest && e.target.closest('.dropdown-toggle')) requestSize();
    });

    // Close on backdrop tap, link tap, and ESC.
    backdrop.addEventListener('click', close);
    if (inner) {
      Array.prototype.forEach.call(inner.querySelectorAll('a'), function (a) {
        a.addEventListener('click', function () { if (isMobile()) close(); });
      });
    }
    document.addEventListener('keydown', function (e) {
      if ((e.key === 'Escape' || e.keyCode === 27) && isActive()) close();
    });

    // Reset to closed when leaving the mobile breakpoint.
    var onChange = function (e) { if (!e.matches) close(); };
    if (mql.addEventListener) mql.addEventListener('change', onChange);
    else if (mql.addListener) mql.addListener(onChange);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<!-- Announcement rotator -->
<style>
  .nav-bar_content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }
  .nav-bar_content > .button {
    grid-area: 1 / 1;
    justify-self: start;
  }
  .nav-bar_content > .nav-bar_icon-close { grid-area: 1 / 2; }
  .nav-bar_content > .button,
  .nav-bar_content > .press_link-full {
    animation: nav-bar-rotate 8s linear infinite both;
  }
  .nav-bar_content > .second { animation-delay: 4s; }
  @media (hover: hover) {
    .nav-bar:hover .nav-bar_content > .button,
    .nav-bar:hover .nav-bar_content > .press_link-full { animation-play-state: paused; }
  }
  @keyframes nav-bar-rotate {
    0% { opacity: 0; visibility: hidden; }
    12.5% { opacity: 1; visibility: visible; }
    37.5% { opacity: 1; visibility: visible; }
    50% { opacity: 0; visibility: hidden; }
    100% { opacity: 0; visibility: hidden; }
  }
</style>

<!-- Nav bar dismiss -->
<style>
  .nav-bar-dismissed .nav-bar { display: none !important; }
</style>
<script>
  (function () {
    var KEY = 'navBarDismissed-v1';
    var root = document.documentElement;
    try { if (localStorage.getItem(KEY)) root.classList.add('nav-bar-dismissed'); } catch (e) {}
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.nav-bar_content > .press_link-full, .nav-bar_content > .button, .nav-bar_icon-close')) return;
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
      root.classList.add('nav-bar-dismissed');
    });
  })();
