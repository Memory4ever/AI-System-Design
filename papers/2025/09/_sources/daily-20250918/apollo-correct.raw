<!-- Page load GSAP -->
<script>
(function () {
  // Never hijack navigation when embedded / proxied (markup.io etc.):
  // links must work natively there or the overlay gets stuck covering the page.
  var embedded = (window.PT && window.PT.embedded);
  if (embedded === undefined) { // fallback if the <head> script didn't run
    try { embedded = window.self !== window.top; } catch (e) { embedded = true; }
    if (!embedded && /(^|\.)markup\.io$/i.test(location.hostname)) embedded = true;
  }
  if (embedded) return;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // OUTGOING: cover the screen with GSAP, then navigate
  $("a:not(.excluded-class):not(.w-pagination-next):not(.w-pagination-previous)").on("click", function (e) {
    // Skip Finsweet load-more / pagination (AJAX — must not trigger the transition)
    if ($(this).closest('.w-pagination-wrapper, [fs-cmsload-element], [fs-list-element]').length) return;
    var currentUrl = $(this).attr("href");
    if (
      $(this).prop("hostname") === window.location.host &&
      currentUrl &&
      !currentUrl.includes("#") &&
      currentUrl.indexOf("?") !== 0 &&   // skip pure query-string links (?..._page=2)
      $(this).attr("target") !== "_blank"
    ) {
      e.preventDefault();
      if (reduce) { window.location.href = currentUrl; return; }
      // Hand columns over to GSAP: .is-leaving kills the CSS reveal so they don't fight
      document.documentElement.classList.add('is-leaving');
      gsap.killTweensOf('.transition_column');
      gsap.timeline({ onComplete: function () { window.location.href = currentUrl; } })
        .set('.transition_wrap', { display: 'flex' })
        .fromTo('.transition_column', { yPercent: -100 }, { yPercent: 0, stagger: 0.12 }); // drop down → cover
    }
  });
  // Reload when restored from bfcache so the overlay never stays stuck
  window.onpageshow = function (event) {
    if (event.persisted) window.location.reload();
  };
})();
</script>
<!--- Buttons animation GSAP -->
<script>
  (function () {
    if (window.__osmoCharStagger) return;       // run once
    window.__osmoCharStagger = true;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function split(btn) {
      if (btn.dataset.charStagger === 'done') return;
      var text = (btn.textContent || '').trim();
      if (!text) return;
      btn.dataset.charStagger = 'done';
      btn.setAttribute('aria-label', text);      // keep label for screen readers
      var frag = document.createDocumentFragment();
      var i = 0;
      text.split('').forEach(function (ch) {
        if (ch === ' ') {
          var sp = document.createElement('span');
          sp.className = 'char is-space';
          sp.setAttribute('aria-hidden', 'true');
          sp.innerHTML = '&nbsp;';
          frag.appendChild(sp);
          return;
        }
        var outer = document.createElement('span');
        outer.className = 'char';
        outer.style.setProperty('--char-index', i);
        outer.setAttribute('aria-hidden', 'true');
        var inner = document.createElement('span');
        inner.className = 'char__inner';
        var a = document.createElement('span'); a.textContent = ch;
        var b = document.createElement('span'); b.textContent = ch;
        inner.appendChild(a);
        inner.appendChild(b);
        outer.appendChild(inner);
        frag.appendChild(outer);
        i++;
      });
      btn.innerHTML = '';
      btn.appendChild(frag);
    }
    function init() {
      // All Client-First buttons except the icon and secondary variants
      var btns = document.querySelectorAll('.button:not(.is-icon):not(.is-secondary)');
      btns.forEach(split);
    }
    if (reduce) return;                          // leave plain text, no motion
    if (document.readyState !== 'loading') init();
    else document.addEventListener('DOMContentLoaded', init);
  })();
</script>
<!--- Sections animation code -->
<style>
  :root {
    --reveal-y: 110%;                              /* start offset below the mask edge */
    --reveal-duration: 0.8s;
    --reveal-ease: cubic-bezier(0.16, 1, 0.3, 1);  /* Osmo easeOutExpo */
    --reveal-step: 0.08s;                          /* stagger between objects in a row */
  }
  html.reveal-ready .is-reveal-item { overflow: hidden; }
  html.reveal-ready .reveal-inner { display: block; } /* wraps text-only items */
  /* Hidden state */
  html.reveal-ready .is-reveal-item > * {
    transform: translateY(var(--reveal-y));
    transition: transform var(--reveal-duration) var(--reveal-ease);
    transition-delay: calc(var(--reveal-index, 0) * var(--reveal-step));
    will-change: transform;
  }
  /* Revealed (one-way, no reverse) */
  html.reveal-ready .is-reveal-item.is-inview > * {
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    html.reveal-ready .is-reveal-item > * { transform: none !important; transition: none; }
  }
</style>
<!--- Sections animation code -->
<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
    document.documentElement.classList.add('reveal-ready');
</script>
<script>
  (function () {
    if (window.__reveal || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    window.__reveal = true;
    function notOff(el) { return !el.classList.contains('reveal-off'); }
    // Descend through single-child wrappers to the level with multiple elements.
    function resolveItems(group) {
      var node = group;
      while (node.childElementCount === 1 && node.firstElementChild.childElementCount > 0) {
        node = node.firstElementChild;
      }
      return [].slice.call(node.children);
    }
    // Stagger index resets per row (items sharing the same top offset).
    function assignRowIndex(items) {
      var rows = [];
      items.forEach(function (item) {
        var top = Math.round(item.getBoundingClientRect().top + (window.pageYOffset || 0));
        var bucket = null;
        for (var i = 0; i < rows.length; i++) {
          if (Math.abs(rows[i].top - top) < 6) { bucket = rows[i]; break; }
        }
        if (!bucket) { bucket = { top: top, n: 0 }; rows.push(bucket); }
        item.style.setProperty('--reveal-index', bucket.n++);
      });
    }
    function init() {
      var groups = [].slice.call(document.querySelectorAll('[class*="_component"]'))
        .filter(function (g) { return !/hero/i.test(g.className) && notOff(g); });
      if (!groups.length) return;
      var allItems = [];
      var groupItems = [];
      groups.forEach(function (group) {
        var items = resolveItems(group).filter(notOff);
        if (!items.length) return;
        items.forEach(function (item) {
          item.classList.add('is-reveal-item');
          if (item.childElementCount === 0) {        // wrap text-only items
            var inner = document.createElement('span');
            inner.className = 'reveal-inner';
            while (item.firstChild) inner.appendChild(item.firstChild);
            item.appendChild(inner);
          }
          allItems.push(item);
        });
        assignRowIndex(items);
        groupItems.push(items);
      });
      if (!allItems.length) return;
      if (!('IntersectionObserver' in window)) {
        allItems.forEach(function (it) { it.classList.add('is-inview'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          // Reveal once on first entry, then stop observing — no replay, no reverse
          if (e.isIntersecting) {
            e.target.classList.add('is-inview');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
      allItems.forEach(function (it) { io.observe(it); });
      // Recompute row buckets once images/fonts settle (only affects not-yet-revealed items).
      window.addEventListener('load', function () {
        groupItems.forEach(function (items) { assignRowIndex(items); });
      });
    }
    document.readyState !== 'loading'
      ? init()
      : document.addEventListener('DOMContentLoaded', init);
  })();
</script>
<!-- Dropdown hover timing (desktop only) -->
<script>
(function () {
  'use strict';
  // Below this width Webflow dropdowns are tap-driven and sit in flow
  var MOBILE_MAX_WIDTH = 991;
  // How long the list stays open after the pointer leaves it.
  // Covers the empty gap and diagonal travel toward the submenu.
  var CLOSE_DELAY = 300;
  var isMobile = function () {
    return window.matchMedia('(max-width: ' + MOBILE_MAX_WIDTH + 'px)').matches;
  };
  // Works with or without the old data-dropdown-link attribute
  var toggles = document.querySelectorAll('.navbar_dropdown .dropdown-toggle, [data-dropdown-link]');
  Array.prototype.forEach.call(toggles, function (toggle) {
    var wrap = toggle.closest('.w-dropdown');
    if (!wrap) return;
    var list = wrap.querySelector('.w-dropdown-list');
    if (!list) return;
    var timer = null;
    var open = function () {
      clearTimeout(timer);
      list.classList.add('w--open');
      toggle.classList.add('w--open');
      toggle.setAttribute('aria-expanded', 'true');
    };
    var close = function () {
      list.classList.remove('w--open');
      toggle.classList.remove('w--open');
      toggle.setAttribute('aria-expanded', 'false');
    };
    var scheduleClose = function () {
      clearTimeout(timer);
      timer = setTimeout(close, CLOSE_DELAY);
    };
    // Hover is desktop-only; on mobile Webflow's native tap toggle stays in charge
    [toggle, list].forEach(function (node) {
      node.addEventListener('mouseenter', function () {
        if (isMobile()) return;
        open();
      });
      node.addEventListener('mouseleave', function () {
        if (isMobile()) return;
        scheduleClose();
      });
    });
    // Clicking a link inside the list closes it right away (no hover-out needed)
    Array.prototype.forEach.call(list.querySelectorAll('a'), function (a) {
      a.addEventListener('click', function () {
        clearTimeout(timer);
        close();
      });
    });
    // Escape closes the list without waiting out the delay
    wrap.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        clearTimeout(timer);
        close();
      }
    });
  });
})();
</script>

<!-- Anchor scroll offset -->
<script data-cookieconsent="ignore">
(function () {
  var NAV = '.nav-global';
  var GAP = 16;
  var DURATION = 900;
  var LOAD_DELAY = 300;

  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var raf = window.requestAnimationFrame || function (fn) { return setTimeout(fn, 16); };
  var anim = null;

  function offset() {
    var nav = document.querySelector(NAV);
    if (!nav) return GAP;
    var cs = getComputedStyle(nav);
    return nav.getBoundingClientRect().height + (parseFloat(cs.top) || 0) + GAP;
  }

  function ease(t) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  function stop() { anim = null; }

  function go(el, animate) {
    var from = window.pageYOffset;
    var max = document.documentElement.scrollHeight - window.innerHeight;
    var to = Math.max(0, Math.min(max, el.getBoundingClientRect().top + from - offset()));
    var dist = to - from;

    if (!animate || reduce || Math.abs(dist) < 2) {
      window.scrollTo(0, to);
      return;
    }

    var dur = Math.max(400, Math.min(DURATION, 320 + Math.abs(dist) * 0.45));
    var start = performance.now();
    var token = {};
    anim = token;

    (function step(now) {
      if (anim !== token) return;
      var p = Math.min(1, (now - start) / dur);
      window.scrollTo(0, from + dist * ease(p));
      if (p < 1) raf(step); else anim = null;
    })(start);
  }

  ['wheel', 'touchstart', 'keydown'].forEach(function (t) {
    window.addEventListener(t, stop, { passive: true });
  });

  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href*="#"]');
    if (!a || a.classList.contains('w-tab-link')) return;
    if (a.hash.length < 2) return;
    if (a.host !== location.host || a.pathname !== location.pathname) return;

    var el = document.getElementById(a.hash.slice(1));
    if (!el) return;

    e.preventDefault();
    e.stopImmediatePropagation();
    history.pushState({}, '', a.hash);
    go(el, true);
  }, true);

  window.addEventListener('load', function () {
    var hash = window.__anchorHash || location.hash;
    if (!hash || hash.length < 2) return;
    var id = decodeURIComponent(hash.slice(1));
    var el = document.querySelector('[data-anchor-id="' + CSS.escape(id) + '"]');
    if (el) {
      el.removeAttribute('data-anchor-id');
      el.id = id;
    } else {
      el = document.getElementById(id);
    }
    if (window.__anchorHash) {
      history.replaceState(history.state, '', location.pathname + location.search + hash);
    }
    if (el) setTimeout(function () { go(el, true); }, LOAD_DELAY);
  });
})();
</script>

<!-- Anchor smooth scroll on load -->
<script data-cookieconsent="ignore">
(function () {
  var hash = window.location.hash;
  if (!hash || hash.length < 2) return;
  var id = decodeURIComponent(hash.slice(1));
  var base = window.location.pathname + window.location.search;
  var NAV_SELECTORS = ['[data-anchor-offset]', '.nav_component', '.navbar_component', '.navbar_container', '.w-nav'];
  var NAV_GAP_REM = 1;

  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  history.replaceState(null, '', base);

  function remPx() {
    return parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
  }

  function navHeight() {
    var h = 0;
    NAV_SELECTORS.forEach(function (s) {
      var el = document.querySelector(s);
      if (!el) return;
      var pos = getComputedStyle(el).position;
      if (pos === 'fixed' || pos === 'sticky' || el.closest('.w-nav')) {
        h = Math.max(h, el.getBoundingClientRect().height);
      }
    });
    return h;
  }

  function getOffset(target) {
    var margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
    if (margin > 0) return margin;
    var h = navHeight();
    return h ? h + NAV_GAP_REM * remPx() : 0;
  }

  function scrollToTarget() {
    history.replaceState(null, '', base + hash);
    var target = document.getElementById(id);
    if (!target) return;
    var offset = getOffset(target);
    if (window.lenis) {
      window.lenis.scrollTo(target, { offset: -offset });
      return;
    }
    var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
    window.scrollTo({ top: top, behavior: 'smooth' });
  }

  window.addEventListener('load', function () {
    window.scrollTo({ top: 0, behavior: 'instant' });
    setTimeout(scrollToTarget, 300);
  });
})();
</script><!-- [Attributes by Finsweet] Social Share -->
<script defer src="https://cdn.jsdelivr.net/npm/@finsweet/attributes-socialshare@1/socialshare.js"></script>

<script>
(function () {
  var WPM = 238;
 
  function countWords(el) {
    // textContent flattens all rich-text nodes; strip zero-width & nbsp first
    var text = (el.textContent || '')
      .replace(/[​-‍﻿]/g, '')
      .replace(/ /g, ' ')
      .trim();
    if (!text) return 0;
    // Split on any whitespace run; filter tokens with no letters/digits
    return text.split(/\s+/).filter(function (w) {
      return /[\p{L}\p{N}]/u.test(w);
    }).length;
  }
 
  function init() {
    var source = document.querySelector('[data-readtime="source"]')
      || document.querySelector('.w-richtext');
    var output = document.querySelector('[data-readtime="output"]');
    if (!source || !output) return;
 
    var words = countWords(source);
    var minutes = Math.max(1, Math.ceil(words / WPM));
    output.textContent = minutes + ' min read';
  }
 
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<script>
(function () {
  'use strict';
 
  // ---- CONFIG ----
  var CONTENT_SEL = '[data-readtime="source"]'; // rich-text wrapper (.paper-right_rich)
  var ITEMS_SEL   = '.paper-table_items';        // container the items are injected into
  var ITEM_CLASS  = 'paper-table_item';          // class for each generated item div
  var ACTIVE_CLASS = 'is-active';                // toggled on active item div + its <p>
  var HEADINGS    = 'h3';                        // 'h2' or 'h2, h3'
  var OFFSET_DESKTOP_REM = 11;
  var OFFSET_MOBILE_REM  = 9;
  var MOBILE_MAX_PX      = 479;
  var MAX_SCROLL_PASSES  = 5;                    // re-aim attempts after layout shifts
  // ----------------
 
  function init() {
    var content = document.querySelector(CONTENT_SEL);
    // Every TOC container on the page (e.g. desktop sidebar + mobile block).
    var containers = Array.prototype.slice.call(document.querySelectorAll(ITEMS_SEL));
    if (!content || !containers.length) return;

    var headings = Array.prototype.slice.call(content.querySelectorAll(HEADINGS));
    if (!headings.length) {
      containers.forEach(function (items) {
        var wrap = items.closest('.paper-table_contents') || items;
        wrap.style.display = 'none';
      });
      return;
    }

    function remPx() {
      return parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    }
    function offsetPx() {
      var mobile = window.matchMedia('(max-width:' + MOBILE_MAX_PX + 'px)').matches;
      return (mobile ? OFFSET_MOBILE_REM : OFFSET_DESKTOP_REM) * remPx();
    }
    function slugify(s) {
      return (s || '').toLowerCase().trim()
        .replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-') || 'section';
    }

    // Lazy images have zero height until they load, which shifts every heading
    // below them and makes the first jump land short. Load them up front.
    Array.prototype.forEach.call(content.querySelectorAll('img[loading="lazy"]'), function (img) {
      img.loading = 'eager';
    });

    // IDs are assigned once, so all containers link to the same headings.
    var used = {};
    headings.forEach(function (h) {
      if (!h.id) {
        var base = slugify(h.textContent), id = base;
        while (used[id]) { id = base + '-' + (used[base] = (used[base] || 1) + 1); }
        used[id] = 1; h.id = id;
      }
      h.style.scrollMarginTop = offsetPx() + 'px';
    });

    var entries = [];
    containers.forEach(function (items) {
      items.innerHTML = ''; // remove the design placeholder item(s)
      headings.forEach(function (h) {
        var item = document.createElement('div');
        item.className = ITEM_CLASS;
        item.setAttribute('data-toc-link', h.id);
        item.style.cursor = 'pointer';
        var p = document.createElement('p');
        p.textContent = h.textContent;
        item.appendChild(p);
        items.appendChild(item);
        entries.push({ id: h.id, item: item, p: p });
      });
    });

    function maxScroll() {
      return Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    }

    function onScrollEnd(cb) {
      if ('onscrollend' in window) {
        var timer = setTimeout(finish, 1200);
        window.addEventListener('scrollend', finish);
        return;
      }
      var last = -1, still = 0;
      requestAnimationFrame(function tick() {
        if (window.pageYOffset === last) {
          if (++still > 3) return cb();
        } else {
          still = 0;
          last = window.pageYOffset;
        }
        requestAnimationFrame(tick);
      });

      function finish() {
        clearTimeout(timer);
        window.removeEventListener('scrollend', finish);
        cb();
      }
    }

    // Re-aims after the animation settles: images that loaded mid-scroll change
    // the target's position, so one pass is not always enough.
    function scrollToTarget(target, pass) {
      pass = pass || 0;
      var top = target.getBoundingClientRect().top + window.pageYOffset - offsetPx();
      top = Math.max(0, Math.min(top, maxScroll()));
      if (Math.abs(window.pageYOffset - top) < 2 || pass >= MAX_SCROLL_PASSES) return;
      window.scrollTo({ top: top, behavior: pass === 0 ? 'smooth' : 'auto' });
      onScrollEnd(function () { scrollToTarget(target, pass + 1); });
    }

    containers.forEach(function (items) {
      items.addEventListener('click', function (e) {
        var item = e.target.closest('[data-toc-link]');
        if (!item) return;
        var t = document.getElementById(item.getAttribute('data-toc-link'));
        if (!t) return;
        scrollToTarget(t, 0);
        history.replaceState(null, '', '#' + item.getAttribute('data-toc-link'));
      });
    });

    // Scroll-spy: toggle is-active on the item div AND its inner <p>
    function setActive(id) {
      entries.forEach(function (e) {
        var on = e.id === id;
        e.item.classList.toggle(ACTIVE_CLASS, on);
        e.p.classList.toggle(ACTIVE_CLASS, on);
      });
    }
    function currentId() {
      var line = window.pageYOffset + offsetPx() + 1, id = headings[0].id;
      for (var i = 0; i < headings.length; i++) {
        if (headings[i].getBoundingClientRect().top + window.pageYOffset <= line) id = headings[i].id;
        else break;
      }
      return id;
    }

    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return; ticking = true;
      requestAnimationFrame(function () { setActive(currentId()); ticking = false; });
    }, { passive: true });

    var resizing = false;
    window.addEventListener('resize', function () {
      if (resizing) return; resizing = true;
      requestAnimationFrame(function () {
        var o = offsetPx();
        headings.forEach(function (h) { h.style.scrollMarginTop = o + 'px'; });
        setActive(currentId());
        resizing = false;
      });
    });

    setActive(currentId());

    // Landing on a #hash: the browser jumps before images have height
    if (window.location.hash.length > 1) {
      var initial = document.getElementById(window.location.hash.slice(1));
      if (initial && headings.indexOf(initial) !== -1) {
        requestAnimationFrame(function () { scrollToTarget(initial, 1); });
      }
    }

    // Any image finishing after the jump moves the headings again
    window.addEventListener('load', function () { setActive(currentId()); });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

<script>
(function () {
  'use strict';
  // ---- CONFIG ----
  // Where to look. Use 'body' to cover the whole page instead of rich text only.
  var SCOPE_SEL = '.w-richtext';
  // ----------------

  // Derive the site's own registrable domain from the current host,
  // so the apex and every subdomain (www, blog, ...) count as internal
  // with zero config. Handles two-level TLDs like co.uk, org.uk, com.au.
  function rootDomain(host) {
    var parts = host.split('.');
    if (parts.length <= 2) return host;
    var twoLevelTld = /\.(co|com|org|net|gov|ac|edu)\.[a-z]{2}$/i;
    var take = twoLevelTld.test(host) ? 3 : 2;
    return parts.slice(-take).join('.');
  }

  var SITE_ROOT = rootDomain(location.hostname);

  function isInternal(host) {
    if (host === location.hostname) return true;
    return host === SITE_ROOT || host.endsWith('.' + SITE_ROOT);
  }

  function apply(root) {
    Array.prototype.forEach.call(root.querySelectorAll('a[href]'), function (a) {
      // Respect a target set by hand in the Designer or the CMS editor
      if (a.hasAttribute('target')) return;
      // Skip anchors, mailto:, tel:, javascript: — a.protocol covers all of them
      if (a.protocol !== 'http:' && a.protocol !== 'https:') return;
      if (isInternal(a.hostname)) return;
      a.target = '_blank';
      a.rel = a.rel ? a.rel + ' noopener noreferrer' : 'noopener noreferrer';
    });
  }

  function init() {
    Array.prototype.forEach.call(document.querySelectorAll(SCOPE_SEL), apply);
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
<script>
document.addEventListener(
  "click",
  function (event) {
    const link = event.target.closest('a[href*="#"]');
    if (!link) return;

    const url = new URL(link.href, window.location.href);

    // Only handle links pointing to the current page
    if (
      url.pathname !== window.location.pathname ||
      !url.hash ||
      url.hash === "#"
    ) {
      return;
    }

    const targetId = decodeURIComponent(url.hash.slice(1));
    const target = document.getElementById(targetId);

    if (!target) return;

    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();

    const targetTop =
      target.getBoundingClientRect().top +
      window.scrollY -
      window.innerHeight / 2 +
      target.offsetHeight / 2;

    window.scrollTo({
      top: Math.max(0, targetTop),
      behavior: "smooth"
    });

    history.pushState(null, "", url.hash);
  },
  true
);
</script>

<script>
(function () {
  "use strict";

  var CONFIG = {
    article:  ".blog-rich-text",      // rich text field with the article body
    // Rich text field holding the [^n]: definitions. May sit inside the article
    // or anywhere else on the page; it gets hidden either way.
    source:   ".paper-right_footnotes, .footnotes-source",
    heading:  "References",
    highlightMs: 1500
  };

  /* Never rewrite [^n] that sits inside these — they are literal text there. */
  var SKIP_TAGS = { CODE: 1, PRE: 1, KBD: 1, SAMP: 1, SCRIPT: 1, STYLE: 1, TEXTAREA: 1, A: 1 };

  var REF_SPLIT = /(\[\^[^\]\s]+\])/g;
  var REF_ONE   = /^\[\^([^\]\s]+)\]$/;
  var DEF_LINE  = /^\[\^([^\]\s]+)\]:\s*([\s\S]+)$/;
  var URL_BARE  = /(https?:\/\/[^\s<]+[^\s<.,;:)\]])/g;

  function ready(fn) {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", fn, { once: true });
    } else {
      fn();
    }
  }

  /* ---------------------------------------------------------------- utils */

  function centerScroll(target) {
    var top = target.getBoundingClientRect().top + window.scrollY
            - window.innerHeight / 2 + target.offsetHeight / 2;
    window.scrollTo({ top: Math.max(0, top), behavior: "smooth" });
  }

  function linkifyBareUrls(root) {
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    var nodes = [];
    while (walker.nextNode()) {
      if (!SKIP_TAGS[walker.currentNode.parentNode.nodeName]) nodes.push(walker.currentNode);
    }
    nodes.forEach(function (node) {
      var text = node.nodeValue;
      if (!text || text.indexOf("http") === -1) return;
      var frag = document.createDocumentFragment();
      var last = 0;
      text.replace(URL_BARE, function (url, offset) {
        if (offset > last) frag.appendChild(document.createTextNode(text.slice(last, offset)));
        var a = document.createElement("a");
        a.href = url;
        a.target = "_blank";
        a.rel = "noopener noreferrer";
        a.textContent = url;
        frag.appendChild(a);
        last = offset + url.length;
        return url;
      });
      if (!last) return;
      if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
      node.replaceWith(frag);
    });
  }

  /* ------------------------------------------------------- collect defs */
  /* Definitions live in their own rich text field (CONFIG.source). If that
     field is absent we fall back to definitions written inside the article,
     which is how the original single-field content was authored.           */

  function collectDefinitions(article) {
    var defs = new Map();

    function harvest(scope, removeNode) {
      scope.querySelectorAll("p, li").forEach(function (el) {
        var m = el.textContent.trim().match(DEF_LINE);
        if (!m) return;
        var id = m[1].trim();
        /* Keep the inline markup (links with anchor text) instead of the
           plain text the naive version used — strip only the "[^n]:" label. */
        var holder = document.createElement("span");
        holder.innerHTML = el.innerHTML;
        stripLabel(holder, id);
        linkifyBareUrls(holder);
        defs.set(id, holder.innerHTML.trim());
        if (removeNode) el.remove();
      });
    }

    var sources = document.querySelectorAll(CONFIG.source);
    sources.forEach(function (source) {
      harvest(source, false);
      source.setAttribute("hidden", "");
      source.style.display = "none";
    });
    harvest(article, true);
    return defs;
  }

  /* Remove the leading "[^id]:" from the first text node of the definition. */
  function stripLabel(holder, id) {
    var walker = document.createTreeWalker(holder, NodeFilter.SHOW_TEXT);
    var node = walker.nextNode();
    while (node) {
      var stripped = node.nodeValue.replace(/^\s*\[\^[^\]\s]+\]:\s*/, "");
      if (stripped !== node.nodeValue) { node.nodeValue = stripped; return; }
      if (node.nodeValue.trim()) return;
      node = walker.nextNode();
    }
  }

  /* --------------------------------------------------------- references */

  function replaceReferences(article, defs, uses) {
    var walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT, {
      acceptNode: function (node) {
        if (SKIP_TAGS[node.parentNode.nodeName]) return NodeFilter.FILTER_REJECT;
        return node.nodeValue.indexOf("[^") === -1
          ? NodeFilter.FILTER_REJECT
          : NodeFilter.FILTER_ACCEPT;
      }
    });
    var nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);

    nodes.forEach(function (node) {
      var frag = document.createDocumentFragment();
      var changed = false;

      node.nodeValue.split(REF_SPLIT).forEach(function (part) {
        var m = part.match(REF_ONE);
        if (!m || !defs.has(m[1])) {
          if (part) frag.appendChild(document.createTextNode(part));
          return;
        }
        var id = m[1];
        var n = (uses.get(id) || 0) + 1;
        uses.set(id, n);
        changed = true;

        var a = document.createElement("a");
        a.id = "footnote-ref-" + id + "-" + n;
        a.href = "#footnote-" + id;
        a.textContent = id;
        a.setAttribute("aria-label", "Go to footnote " + id);

        var sup = document.createElement("sup");
        sup.className = "footnote-reference";
        sup.appendChild(a);
        frag.appendChild(sup);
      });

      if (changed) node.replaceWith(frag);
    });
  }

  function buildSection(defs, uses) {
    var section = document.createElement("section");
    section.className = "footnotes";
    section.setAttribute("aria-label", CONFIG.heading);

    var h = document.createElement("h3");
    h.className = "footnotes-heading";
    h.textContent = CONFIG.heading;

    var ol = document.createElement("ol");
    ol.className = "footnotes-list";

    defs.forEach(function (content, id) {
      var n = uses.get(id);
      if (!n) return;                       // defined but never referenced

      var li = document.createElement("li");
      li.id = "footnote-" + id;

      var span = document.createElement("span");
      span.className = "footnote-content";
      span.innerHTML = content;
      li.appendChild(span);

      for (var i = 1; i <= n; i++) {
        var back = document.createElement("a");
        back.href = "#footnote-ref-" + id + "-" + i;
        back.className = "footnote-backlink";
        back.textContent = "↩";
        back.setAttribute("aria-label", "Return to reference " + id);
        li.appendChild(document.createTextNode(" "));
        li.appendChild(back);
      }
      ol.appendChild(li);
    });

    section.appendChild(document.createElement("hr"));
    section.appendChild(h);
    section.appendChild(ol);
    return section;
  }

  /* -------------------------------------------------------------- init */

  ready(function () {
    var article = document.querySelector(CONFIG.article);

    if (article && !article.dataset.footnotesDone) {
      article.dataset.footnotesDone = "1";

      var defs = collectDefinitions(article);
      if (defs.size) {
        var uses = new Map();
        replaceReferences(article, defs, uses);
        if (uses.size) article.appendChild(buildSection(defs, uses));
      }
    }

    /* One delegated handler for every same-page anchor: footnote refs,
       backlinks and any table-of-contents link all centre their target. */
    document.addEventListener("click", function (event) {
      var link = event.target.closest('a[href*="#"]');
      if (!link) return;

      var url = new URL(link.href, window.location.href);
      if (url.pathname !== window.location.pathname || !url.hash || url.hash === "#") return;

      var id = decodeURIComponent(url.hash.slice(1));
      var target = document.getElementById(id);
      if (!target) return;

      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      centerScroll(target);

      var isFootnote = link.closest(".footnote-reference, .footnotes");
      if (isFootnote) {
        document.querySelectorAll(".footnote-highlight").forEach(function (el) {
          el.classList.remove("footnote-highlight");
        });
        var hit = target.closest(".footnote-reference") || target;
        hit.classList.add("footnote-highlight");
        window.setTimeout(function () {
          hit.classList.remove("footnote-highlight");
        }, CONFIG.highlightMs);
        history.replaceState(null, "", url.hash);
      } else {
        history.pushState(null, "", url.hash);
      }
    }, true);

    /* Deep link straight to a footnote: centre it after layout settles. */
    if (window.location.hash) {
      var deep = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
      if (deep) window.requestAnimationFrame(function () { centerScroll(deep); });
    }
  });
})();
</script>
<script>
(function () {
  var MOBILE = window.matchMedia('(max-width: 479px)');

  function wrapTables() {
    document.querySelectorAll('.w-embed table').forEach(function (table) {
      // Skip tables already wrapped on a previous run
      if (table.closest('[data-table-scroll]')) return;

      var wrap = document.createElement('div');
      wrap.setAttribute('data-table-scroll', '');
      wrap.style.cssText =
        'display:block;width:100%;max-width:100%;' +
        'overflow-x:auto;-webkit-overflow-scrolling:touch;';

      table.parentNode.insertBefore(wrap, table);
      wrap.appendChild(table);

      // Unlock ancestors that either refuse to shrink or clip the overflow
      var node = wrap.parentElement;
      while (node && node !== document.body) {
        node.style.minWidth = '0';
        node.style.maxWidth = '100%';
        if (getComputedStyle(node).overflowX === 'hidden') {
          node.style.overflowX = 'clip';
        }
        node = node.parentElement;
      }
    });
  }

  function apply() {
    if (MOBILE.matches) wrapTables();
  }

  // Run as early as possible, then again once the DOM is complete
  apply();
  document.addEventListener('DOMContentLoaded', apply);

  // Re-run when the viewport crosses the 479px breakpoint
  if (MOBILE.addEventListener) {
    MOBILE.addEventListener('change', apply);
  } else {
    MOBILE.addListener(apply); // legacy Safari
  }

  // Catch tables added later (CMS pagination, tabs, lazy-loaded rich text)
  if (window.MutationObserver) {
    new MutationObserver(function () {
      if (MOBILE.matches) wrapTables();
    }).observe(document.body, { childList: true, subtree: true });
  }
})();
</script>

<script>

(function () {
  'use strict';
 
  // ---- CONFIG ----
  var BUTTON_SEL  = '[data-copy-md="button"]';
  var SOURCE_SEL  = '[data-copy-md="source"], [data-readtime="source"], .w-richtext';
  var TITLE_SEL   = '[data-copy-md="title"], h1';
  var META_SEL    = '[data-copy-md="meta"]';
  var SKIP_SEL    = '[data-copy-md="skip"], script, style, noscript, svg, form, iframe';
  var TOAST_SEL   = '[data-copy-md="toast"]';   // optional custom "Copied" element in Webflow
 
  var INCLUDE_TITLE = true;   // "# Title" at the top
  var INCLUDE_META  = true;   // authors / date line under the title
  var INCLUDE_URL   = true;   // "Source: https://..." line
  var RESET_MS      = 2000;   // how long the "Copied" state stays
  var COPIED_TEXT   = 'Copied';
  var FAILED_TEXT   = 'Press Ctrl+C';
  // ----------------
 
  var BLOCK_TAGS = {
    P: 1, DIV: 1, SECTION: 1, ARTICLE: 1, HEADER: 1, FOOTER: 1, MAIN: 1, ASIDE: 1,
    H1: 1, H2: 1, H3: 1, H4: 1, H5: 1, H6: 1, UL: 1, OL: 1, LI: 1, BLOCKQUOTE: 1,
    PRE: 1, TABLE: 1, HR: 1, FIGURE: 1, FIGCAPTION: 1, DL: 1, DT: 1, DD: 1
  };
 
  /* ---------- helpers ---------- */
 
  function isHidden(el) {
    if (el.hasAttribute('hidden')) return true;
    if (el.classList.contains('w-condition-invisible')) return true;
    // Cheap inline check first; computed style only when it might matter.
    if (/display\s*:\s*none/i.test(el.getAttribute('style') || '')) return true;
    return false;
  }
 
  function skip(el) {
    return el.matches(SKIP_SEL) || isHidden(el);
  }
 
  // Escape only what would otherwise change the meaning of the markdown.
  function esc(text) {
    return text
      .replace(/([\\`*_[\]])/g, '\\$1')
      .replace(/^(\s*)([-+#>])/gm, '$1\\$2')
      .replace(/^(\s*\d+)\.(?=\s)/gm, '$1\\.');
  }
 
  function collapse(text) {
    return text.replace(/[​-‍﻿]/g, '').replace(/ /g, ' ').replace(/\s+/g, ' ');
  }
 
  function trimBlank(lines) {
    // Only blank-out whitespace-only lines: trailing double spaces are hard breaks.
    return lines.replace(/^[ \t]+$/gm, '').replace(/\n{3,}/g, '\n\n').trim();
  }
 
  function absUrl(el, attr) {
    var raw = el.getAttribute(attr) || '';
    if (!raw) return '';
    try { return new URL(raw, location.href).href; } catch (e) { return raw; }
  }
 
  /* ---------- inline serialisation ---------- */
 
  function inline(node) {
    var out = '';
    Array.prototype.forEach.call(node.childNodes, function (child) {
      if (child.nodeType === 3) { out += esc(collapse(child.nodeValue)); return; }
      if (child.nodeType !== 1) return;
      if (skip(child)) return;
 
      var tag = child.tagName;
      var inner;
 
      switch (tag) {
        case 'BR':
          out += '  \n';
          break;
        case 'STRONG': case 'B':
          inner = inline(child).trim();
          if (inner) out += '**' + inner + '**';
          break;
        case 'EM': case 'I':
          inner = inline(child).trim();
          if (inner) out += '*' + inner + '*';
          break;
        case 'DEL': case 'S': case 'STRIKE':
          inner = inline(child).trim();
          if (inner) out += '~~' + inner + '~~';
          break;
        case 'CODE': case 'KBD': case 'SAMP':
          inner = collapse(child.textContent);
          if (inner) out += '`' + inner + '`';
          break;
        case 'A':
          inner = inline(child).trim();
          var href = absUrl(child, 'href');
          out += href && inner ? '[' + inner + '](' + href + ')' : inner;
          break;
        case 'IMG':
          out += image(child);
          break;
        case 'SUP':
          inner = inline(child).trim();
          if (inner) out += '^' + inner;
          break;
        case 'SUB':
          inner = inline(child).trim();
          if (inner) out += '_' + inner;
          break;
        default:
          out += inline(child);
      }
    });
    return out;
  }
 
  function image(img) {
    var src = absUrl(img, 'src');
    if (!src) return '';
    return '![' + esc(collapse(img.getAttribute('alt') || '')) + '](' + src + ')';
  }
 
  /* ---------- block serialisation ---------- */
 
  function listBlock(el, depth) {
    var ordered = el.tagName === 'OL';
    var start = parseInt(el.getAttribute('start'), 10);
    var index = isNaN(start) ? 1 : start;
    var pad = new Array(depth + 1).join('  ');
    var lines = [];
 
    Array.prototype.forEach.call(el.children, function (li) {
      if (li.tagName !== 'LI' || skip(li)) return;
 
      var marker = ordered ? (index++) + '. ' : '- ';
      var nested = [];
      var text = '';
 
      Array.prototype.forEach.call(li.childNodes, function (child) {
        if (child.nodeType === 1 && (child.tagName === 'UL' || child.tagName === 'OL')) {
          nested.push(listBlock(child, depth + 1));
        } else if (child.nodeType === 1 && BLOCK_TAGS[child.tagName] && child.tagName !== 'LI') {
          nested.push(blocks(child, depth + 1));
        } else if (child.nodeType === 1) {
          text += inline({ childNodes: [child] });
        } else if (child.nodeType === 3) {
          text += esc(collapse(child.nodeValue));
        }
      });
 
      text = text.trim();
      // Continuation lines of a list item must align under the marker.
      var indented = text.replace(/\n/g, '\n' + pad + new Array(marker.length + 1).join(' '));
      lines.push(pad + marker + indented);
      nested.filter(Boolean).forEach(function (n) { lines.push(n); });
    });
 
    return lines.join('\n');
  }
 
  function tableBlock(table) {
    var rows = Array.prototype.slice.call(table.querySelectorAll('tr')).filter(function (tr) {
      return !skip(tr);
    });
    if (!rows.length) return '';
 
    var grid = rows.map(function (tr) {
      return Array.prototype.slice.call(tr.children).map(function (cell) {
        return inline(cell).replace(/\n/g, ' ').replace(/\|/g, '\\|').trim();
      });
    });
 
    var cols = grid.reduce(function (max, r) { return Math.max(max, r.length); }, 0);
    grid.forEach(function (r) { while (r.length < cols) r.push(''); });
 
    // A table with no <th> still needs a header row for valid markdown.
    var hasHead = !!table.querySelector('th');
    var head = hasHead ? grid.shift() : new Array(cols + 1).join('|').split('|').slice(0, cols);
    var sep = [];
    for (var i = 0; i < cols; i++) sep.push('---');
 
    var lines = ['| ' + head.join(' | ') + ' |', '| ' + sep.join(' | ') + ' |'];
    grid.forEach(function (r) { lines.push('| ' + r.join(' | ') + ' |'); });
    return lines.join('\n');
  }
 
  function figureBlock(fig) {
    var img = fig.querySelector('img');
    var cap = fig.querySelector('figcaption');
    var parts = [];
    if (img) parts.push(image(img));
    if (cap) {
      var t = inline(cap).trim();
      if (t) parts.push('*' + t + '*');
    }
    if (!parts.length) parts.push(blocks(fig, 0));
    return parts.filter(Boolean).join('\n\n');
  }
 
  function blocks(root, depth) {
    var out = [];
    var pendingInline = '';
 
    function flush() {
      var t = pendingInline.trim();
      if (t) out.push(t);
      pendingInline = '';
    }
 
    Array.prototype.forEach.call(root.childNodes, function (node) {
      if (node.nodeType === 3) { pendingInline += esc(collapse(node.nodeValue)); return; }
      if (node.nodeType !== 1) return;
      if (skip(node)) return;
 
      var tag = node.tagName;
 
      if (!BLOCK_TAGS[tag]) { pendingInline += inline({ childNodes: [node] }); return; }
      flush();
 
      switch (tag) {
        case 'H1': case 'H2': case 'H3': case 'H4': case 'H5': case 'H6':
          var level = new Array(parseInt(tag.charAt(1), 10) + 1).join('#');
          var htext = inline(node).replace(/\n/g, ' ').trim();
          if (htext) out.push(level + ' ' + htext);
          break;
        case 'HR':
          out.push('---');
          break;
        case 'UL': case 'OL':
          out.push(listBlock(node, 0));
          break;
        case 'TABLE':
          out.push(tableBlock(node));
          break;
        case 'FIGURE':
          out.push(figureBlock(node));
          break;
        case 'PRE':
          var code = node.querySelector('code');
          var lang = '';
          var cls = (code || node).className || '';
          var m = cls.match(/(?:language|lang)-([\w+#-]+)/);
          if (m) lang = m[1];
          out.push('```' + lang + '\n' + (node.textContent || '').replace(/\s+$/, '') + '\n```');
          break;
        case 'BLOCKQUOTE':
          var q = blocks(node, depth);
          if (q) out.push(q.replace(/^/gm, '> '));
          break;
        case 'P': case 'FIGCAPTION': case 'DT': case 'DD':
          var p = inline(node).trim();
          if (p) out.push(p);
          break;
        default:
          // Layout wrapper (div/section/...) — recurse, keep its children as blocks.
          var nestedBlocks = blocks(node, depth);
          if (nestedBlocks) out.push(nestedBlocks);
      }
    });
 
    flush();
    return out.filter(Boolean).join('\n\n');
  }
 
  /* ---------- document assembly ---------- */
 
  function buildMarkdown() {
    var source = document.querySelector(SOURCE_SEL);
    if (!source) return '';
 
    var parts = [];
 
    if (INCLUDE_TITLE) {
      var titleEl = document.querySelector(TITLE_SEL);
      var title = titleEl ? collapse(titleEl.textContent).trim() : collapse(document.title).trim();
      if (title) parts.push('# ' + title);
    }
 
    if (INCLUDE_META) {
      var meta = Array.prototype.slice.call(document.querySelectorAll(META_SEL))
        .filter(function (el) { return !isHidden(el); })
        .map(function (el) { return collapse(el.textContent).trim(); })
        .filter(Boolean);
      if (meta.length) parts.push(meta.join(' · '));
    }
 
    if (INCLUDE_URL) parts.push('Source: ' + location.href.split('#')[0]);
 
    if (parts.length) parts.push('---');
    parts.push(blocks(source, 0));
 
    return trimBlank(parts.join('\n\n'));
  }
 
  /* ---------- clipboard ---------- */
 
  function legacyCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.cssText = 'position:fixed;top:0;left:-9999px;opacity:0;';
    document.body.appendChild(ta);
    ta.select();
    ta.setSelectionRange(0, text.length);
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    document.body.removeChild(ta);
    return ok;
  }
 
  function copyText(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text).catch(function () {
        if (legacyCopy(text)) return;
        throw new Error('copy failed');
      });
    }
    return legacyCopy(text) ? Promise.resolve() : Promise.reject(new Error('copy failed'));
  }
 
  /* ---------- button wiring ---------- */
  function getToast(btn) {
    var toast = btn.querySelector(TOAST_SEL);
    if (toast) return toast;
    toast = btn._mdToast;
    if (toast && toast.parentNode === btn) return toast;
 
    toast = document.createElement('span');
    toast.setAttribute('data-copy-md', 'toast');
    toast.setAttribute('aria-hidden', 'true');
    btn.appendChild(toast);
    btn._mdToast = toast;
    return toast;
  }
 
  function feedback(btn, message, isError) {
    if (btn._mdTimer) clearTimeout(btn._mdTimer);
 
    var toast = getToast(btn);
    toast.textContent = message;
 
    btn.classList.remove('is-copied', 'is-copy-error');
    btn.classList.add(isError ? 'is-copy-error' : 'is-copied');
    btn.setAttribute('data-copy-md-state', isError ? 'error' : 'copied');
 
    btn._mdTimer = setTimeout(function () {
      btn.classList.remove('is-copied', 'is-copy-error');
      btn.removeAttribute('data-copy-md-state');
    }, RESET_MS);
  }
 
  function init() {
    var buttons = document.querySelectorAll(BUTTON_SEL);
    if (!buttons.length) return;
 
    var source = document.querySelector(SOURCE_SEL);
    if (!source) {
      Array.prototype.forEach.call(buttons, function (b) { b.style.display = 'none'; });
      return;
    }
 
    Array.prototype.forEach.call(buttons, function (btn) {
      if (btn.tagName === 'A' && !btn.getAttribute('href')) btn.setAttribute('href', 'javascript:void(0)');
 
      // Bare text directly inside the button can't be hidden with CSS, so wrap
      // it once. Runs before any GSAP split, and splitting a span works the same.
      Array.prototype.slice.call(btn.childNodes).forEach(function (n) {
        if (n.nodeType !== 3 || !n.nodeValue.trim()) return;
        var span = document.createElement('span');
        span.setAttribute('data-copy-md', 'label');
        span.textContent = n.nodeValue;
        btn.replaceChild(span, n);
      });
 
      btn.setAttribute('role', btn.tagName === 'BUTTON' ? 'button' : btn.getAttribute('role') || 'button');
 
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var md = buildMarkdown();
        if (!md) { feedback(btn, FAILED_TEXT, true); return; }
        copyText(md).then(function () {
          feedback(btn, COPIED_TEXT, false);
        }).catch(function () {
          feedback(btn, FAILED_TEXT, true);
        });
      });
    });
  }
 
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script></body></html>