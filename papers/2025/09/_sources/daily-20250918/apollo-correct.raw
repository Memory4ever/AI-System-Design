<style>
  .btn-rot-icon {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
  }
  .btn-rot-arrow {
    flex: 0 0 100%;
    width: 100%;
    height: auto;
    transition: transform .525s cubic-bezier(0.625, 0.05, 0, 1);
  }
 
  @media (hover: hover) and (pointer: fine) {
    .button.is-icon:hover .btn-rot-arrow { transform: translateX(100%); }
  }
</style>

<!--- Nav links animation -->
<style>
  .navbar_menu_link .link-rectangle {
    opacity: 0;
    transition: opacity .4s cubic-bezier(0.625, 0.05, 0, 1);
  }
  .navbar_menu_link:hover .link-rectangle,
  .navbar_menu_link:focus-visible .link-rectangle {
    opacity: 1;
  }
</style>

<style>
  .social-link {
    --ease: cubic-bezier(0.76, 0, 0.24, 1);
    --dur: .45s;
    position: relative;
    display: inline-block;
    width: var(--icon-size);
    height: var(--icon-size);
    overflow: hidden;
    color: currentColor;
  }
  .social-slot {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--dur) var(--ease);
  }
  .social-slot svg { width: 100%; height: 100%; display: block; }
 
  /* duplicate starts off-screen at bottom-left */
  .social-slot.is-second { transform: translate(-100%, 100%); }
 
  /* on hover: first exits top-right, second slides in to center */
  .social-link:hover .social-slot.is-first,
  .social-link:focus-visible .social-slot.is-first { transform: translate(100%, -100%); }
  .social-link:hover .social-slot.is-second,
  .social-link:focus-visible .social-slot.is-second { transform: translate(0, 0); }

  /* Remove default focus highlight on form fields */
.w-input:focus,
.w-select:focus,
input:focus,
textarea:focus {
  border-color: inherit;   /* keep your own border color */
  outline: none;
  box-shadow: none;
}
  /* Remove focus glow on custom Webflow checkboxes */
.w-checkbox-input:focus,
.w-checkbox-input--inputType-custom.w--redirected-focus {
  outline: none;
  box-shadow: none;
}
</style>

<!-- Dropdown code -->

<style>
  :root {
    /* Osmo signature in-out ease (symmetric open/close) */
    --ease-osmo: cubic-bezier(0.625, 0.05, 0, 1);
  }
 
  /* ---- Desktop / default: list is absolutely positioned, so it never
         pushes surrounding content. Animate opacity + slide. ---- */
  .dropdown_list.w-dropdown-list {
    display: block !important;          /* keep in DOM so it can transition */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-0.5rem);
    transition: opacity .35s var(--ease-osmo),
                transform .35s var(--ease-osmo),
                visibility .35s var(--ease-osmo);
  }
 
  .dropdown_list.w-dropdown-list.w--open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
 
  .dropdown_link-icon {
    transition: transform .35s var(--ease-osmo);
  }
  .navbar_dropdown.w--open .dropdown_link-icon {
    transform: rotate(180deg);
  }
 
  /* ---- Mobile menu: the dropdown sits inline in the flow, so a closed
         (but display:block) list still reserves height and pushes the links
         below it. Collapse the height instead, and animate max-height for a
         smooth open AND close. Webflow's menu button appears at <=991px. ---- */
  @media screen and (max-width: 991px) {
    .dropdown_list.w-dropdown-list {
      max-height: 0;                    /* closed = zero height, no pushing */
      overflow: hidden;
      transform: none;                  /* no slide in vertical flow */
      transition: max-height .35s var(--ease-osmo),
                  opacity .35s var(--ease-osmo);
    }
 
    .dropdown_list.w-dropdown-list.w--open {
      /* Generous upper bound; larger than the tallest the list will ever be.
         Bump this if the menu has many links. */
      max-height: 40rem;
      opacity: 1;
      visibility: visible;
    }
  }
</style>

<style>
  /* Team card image zoom on hover.
   Paste into Webflow: Page/Project Settings -> Custom Code -> Inside <head> tag. */
 
.team_card {
  overflow: hidden; /* keep in case Webflow value is lost */
}
 
.team_card-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1);
  transition: transform 0.5s ease;
  will-change: transform;
}
 
/* Zoom on hover / keyboard focus within the card */
.team_card:hover .team_card-image,
.team_card:focus-within .team_card-image {
  transform: scale(1.06);
}
 
/* Respect users who prefer reduced motion */
@media (prefers-reduced-motion: reduce) {
  .team_card-image {
    transition: none;
  }
  .team_card:hover .team_card-image,
  .team_card:focus-within .team_card-image {
    transform: none;
  }
}

  /* Keyboard-only focus ring for links and buttons */
a:focus-visible,
button:focus-visible,
.w-button:focus-visible,
input[type="submit"]:focus-visible,
[role="button"]:focus-visible {
  outline: 2px solid #17CFB9!important;
  outline-offset: 2px!important;
  border-radius: 2px!important;
}

/* Remove the default outline for mouse/touch users */
a:focus:not(:focus-visible),
button:focus:not(:focus-visible),
.w-button:focus:not(:focus-visible),
input[type="submit"]:focus:not(:focus-visible),
[role="button"]:focus:not(:focus-visible) {
  outline: none!important;
}

  .press-full_filter-fropdown label:has(input[type="radio"]:checked) p {
  color: #0B3227;
}
</style>
</div><div class="page-style w-embed"><style>
  @media (max-width: 479px) {
    /* The CMS items wrapper becomes the scroll track. */
    .hilight_grid.w-dyn-items {
      display: flex !important;        /* beat Webflow's mobile grid */
      grid-template-columns: none !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      height: auto !important;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch; /* momentum scroll on iOS */
      scroll-snap-type: x mandatory;
      gap: .37rem;
    }
    /* Hide the scrollbar but keep scrolling */
    .hilight_grid.w-dyn-items {
      scrollbar-width: none;            /* Firefox */
    }
    .hilight_grid.w-dyn-items::-webkit-scrollbar {
      display: none;                    /* WebKit */
    }
    /* Each card: fixed width, no shrink, peek the next one */
    .hilight_grid.w-dyn-items > .hilight_card {
      flex: 0 0 85% !important;         /* fixed width, no shrink */
      width: 85% !important;
      scroll-snap-align: center;        /* snapped card sits centered */
    }
  }

[data-copy-md="button"] {
  position: relative;
  cursor: pointer;
  -webkit-user-select: none;
  user-select: none;
}

[data-copy-md="toast"] {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  border-radius: inherit;
  background-color: inherit;
  font: inherit;
  color: inherit;
  letter-spacing: inherit;
  text-transform: inherit;
  transition: opacity 0.2s ease;
}

[data-copy-md="button"].is-copied  [data-copy-md="toast"],
[data-copy-md="button"].is-copy-error [data-copy-md="toast"] {
  opacity: 1;
  visibility: visible;
}

/* Hide the animated label without removing it from the DOM. */
[data-copy-md="button"].is-copied  > *:not([data-copy-md="toast"]),
[data-copy-md="button"].is-copy-error > *:not([data-copy-md="toast"]) {
  visibility: hidden;
}

[data-copy-md="button"].is-copy-error [data-copy-md="toast"] {
  opacity: 0.8;
}

.is-active {
  color: #171717;
}

/* Webflow CMS Rich Text — Papers template, Science.
   Spacing only. Font sizes and line heights are left to the Webflow Designer;
   the only type rules here are the body/bold colours the designer asked for.
   Gaps use margin-top only, so the first and last child add no outer space.
   Values from Figma "Papers" / Rich Text (node 1188:3627), in rem. */

.w-richtext {
  --rt-accent: #6ba6ef;
  --rt-highlight: rgba(107, 166, 239, 0.22);
  --rt-color-heading: #171717;
  --rt-color-body: #262424;
  --rt-color-rule: #ebebeb;

  --rt-bar-width: 0.125rem;
  --rt-bar-gap: 1rem;

  --rt-bullet-size: 0.25rem;
  --rt-bullet-offset: 0.625rem;
  --rt-bullet-indent: 0.875rem;
  --rt-subbullet-size: 0.375rem;
  --rt-subbullet-offset: 0.5625rem;
  --rt-subbullet-border: 0.0625rem;
  --rt-ol-indent: 1.5rem;

  --rt-img-radius: 1rem;

  --rt-footnote-indent: 1.5rem;
  --rt-scroll-offset: 11rem;

  --rt-gap-base: 1rem;
  --rt-gap-list: 1.5rem;
  --rt-gap-list-item: 0.25rem;
  --rt-gap-topic: 3.5rem;
  --rt-gap-after-topic: 1.5rem;
  --rt-gap-sub: 2rem;
  --rt-gap-after-sub: 1rem;
  --rt-gap-quote: 2rem;
  --rt-gap-img: 3rem;
  --rt-gap-img-first: 2rem;
  --rt-gap-caption: 0.5rem;
  --rt-gap-footnotes: 3rem;
}

/* ---------- Colours ---------- */

.w-richtext,
.w-richtext :is(p, ul, ol, li, figcaption) {
  color: var(--rt-color-body);
}

.w-richtext :is(h1, h2, h3, h4, h5, h6) {
  color: var(--rt-color-heading);
}

.w-richtext :is(strong, b) {
  font-weight: 500;
  color: var(--rt-color-heading);
}

/* CMS editors often wrap a whole heading in <strong> — ignore it there */
.w-richtext :is(h1, h2, h3, h4, h5, h6) :is(strong, b) {
  font-weight: inherit;
  color: inherit;
}

.w-richtext a {
  color: inherit;
}

/* ---------- Accent bar on h3 (topic headings) ---------- */

.w-richtext > h3 {
  position: relative;
  padding-left: calc(var(--rt-bar-width) + var(--rt-bar-gap));
}

.w-richtext > h3::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: var(--rt-bar-width);
  background: var(--rt-accent);
}

/* ---------- Blockquote: same accent bar, Webflow defaults stripped ---------- */

.w-richtext blockquote {
  position: relative;
  padding: 0 0 0 calc(var(--rt-bar-width) + var(--rt-bar-gap));
  border: 0;
  background: none;
  font-style: normal;
}

.w-richtext blockquote::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: var(--rt-bar-width);
  background: var(--rt-accent);
}

.w-richtext blockquote > :first-child {
  margin-top: 0;
}

/* ---------- Unordered lists: square accent markers ---------- */

.w-richtext ul {
  list-style: none;
  margin: 0;
  padding-left: 0;
}

.w-richtext ul > li {
  position: relative;
  padding-left: var(--rt-bullet-indent);
}

.w-richtext ul > li::before {
  content: "";
  position: absolute;
  left: 0;
  top: var(--rt-bullet-offset);
  width: var(--rt-bullet-size);
  height: var(--rt-bullet-size);
  border-radius: 0.0625rem;
  background: var(--rt-accent);
}

/* Nested levels: hollow circles instead of filled squares.
   Offset keeps the circle centred on the same baseline as the square. */
.w-richtext li ul > li::before {
  box-sizing: border-box;
  top: var(--rt-subbullet-offset);
  width: var(--rt-subbullet-size);
  height: var(--rt-subbullet-size);
  border: var(--rt-subbullet-border) solid var(--rt-accent);
  border-radius: 50%;
  background: none;
}

/* ---------- Ordered lists: numbering kept, marker in the accent colour ---------- */

.w-richtext ol {
  list-style: decimal outside;
  margin: 0;
  padding-left: var(--rt-ol-indent);
}

.w-richtext ol > li {
  padding-left: 0;
}

.w-richtext ol > li::marker {
  color: var(--rt-accent);
}

/* ---------- Images ---------- */

.w-richtext figure.w-richtext-figure-type-image,
.w-richtext figure.w-richtext-figure-type-image > div {
  width: 100%;
  max-width: 100%;
}

.w-richtext figure img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: var(--rt-img-radius);
}

/* Keeps footnote refs from stretching the line box */
.w-richtext sup {
  line-height: 0;
}

/* ---------- Vertical rhythm ---------- */

.w-richtext > * {
  margin-top: 0;
  margin-bottom: 0;
}

.w-richtext > * + * {
  margin-top: var(--rt-gap-base);
}

.w-richtext > * + h5 {
  margin-top: var(--rt-gap-sub);
}

.w-richtext > * + h3 {
  margin-top: var(--rt-gap-topic);
}

/* Declared after the rules above so stacked headings use the tighter value */
.w-richtext > h5 + * {
  margin-top: var(--rt-gap-after-sub);
}

.w-richtext > h3 + * {
  margin-top: var(--rt-gap-after-topic);
}

/* After the heading rules on purpose: a list gets its own gap no matter
   whether a paragraph or a heading precedes it */
.w-richtext > * + :is(ul, ol) {
  margin-top: var(--rt-gap-list);
}

.w-richtext > * + blockquote,
.w-richtext > blockquote + * {
  margin-top: var(--rt-gap-quote);
}

/* Must stay last: equal specificity, so images win over headings */
.w-richtext > * + figure,
.w-richtext > figure + * {
  margin-top: var(--rt-gap-img);
}

.w-richtext > * + figure:first-of-type,
.w-richtext > figure:first-of-type + * {
  margin-top: var(--rt-gap-img-first);
}

.w-richtext > figure:first-child {
  margin-top: 0;
}

.w-richtext li + li {
  margin-top: var(--rt-gap-list-item);
}

.w-richtext li > :is(ul, ol) {
  margin-top: var(--rt-gap-list-item);
}

.w-richtext figcaption {
  margin-top: var(--rt-gap-caption);
}

/* Editor leftovers: empty paragraphs and a <br> opening a paragraph */
.w-richtext > p:empty {
  display: none;
}

.w-richtext > p > br:first-child {
  display: none;
}

/* ---------- Footnotes ---------- */
/* Injected by script, so it has no Designer styles to inherit from.
   Selectors are doubled to work both inside the rich text and next to it. */

.footnotes,
.w-richtext > .footnotes {
  margin-top: var(--rt-gap-footnotes);
  color: var(--rt-color-body);
}

.footnotes hr,
.w-richtext .footnotes hr {
  height: 0.0625rem;
  margin: 0 0 var(--rt-gap-after-topic);
  border: 0;
  background: var(--rt-color-rule);
}

.footnotes-heading,
.w-richtext .footnotes-heading {
  position: relative;
  margin: 0;
  padding-left: calc(var(--rt-bar-width) + var(--rt-bar-gap));
  color: var(--rt-color-heading);
}

.footnotes-heading::before,
.w-richtext .footnotes-heading::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: var(--rt-bar-width);
  background: var(--rt-accent);
}

.footnotes-list,
.w-richtext .footnotes-list {
  list-style: decimal outside;
  margin: var(--rt-gap-after-topic) 0 0 !important;
  padding-left: var(--rt-footnote-indent);
}

.footnotes-list > li,
.w-richtext .footnotes-list > li {
  padding-left: 0;
  scroll-margin-top: var(--rt-scroll-offset);
}

.footnotes-list > li + li,
.w-richtext .footnotes-list > li + li {
  margin-top: var(--rt-gap-base);
}

.footnotes-list > li::marker,
.w-richtext .footnotes-list > li::marker {
  color: var(--rt-accent);
}

.footnote-reference {
  line-height: 0;
  vertical-align: super;
  scroll-margin-top: var(--rt-scroll-offset);
}

.footnote-reference a,
.footnote-backlink {
  color: var(--rt-accent);
  text-decoration: none;
}

.footnote-backlink {
  display: inline-block;
  margin-left: 0.25rem;
}

.footnote-reference.is-highlighted,
.footnotes-list > li.is-highlighted {
  background: var(--rt-highlight);
  transition: background 0.3s ease;
}

/* ---------- Breakpoints ---------- */

@media (max-width: 991px) {
  .w-richtext {
    --rt-gap-topic: 3rem;
    --rt-gap-after-topic: 1.25rem;
    --rt-gap-sub: 1.75rem;
    --rt-gap-after-sub: 1rem;
    --rt-gap-quote: 1.75rem;
    --rt-gap-img: 2.5rem;
    --rt-gap-img-first: 1.75rem;
  }
}

@media (max-width: 767px) {
  .w-richtext {
    --rt-bar-gap: 0.875rem;
    --rt-img-radius: 0.75rem;
    --rt-scroll-offset: 9rem;
    --rt-gap-base: 0.875rem;
    --rt-gap-list: 1.25rem;
    --rt-gap-topic: 2.5rem;
    --rt-gap-after-topic: 1rem;
    --rt-gap-sub: 1.5rem;
    --rt-gap-after-sub: 0.75rem;
    --rt-gap-quote: 1.5rem;
    --rt-gap-img: 2rem;
    --rt-gap-img-first: 1.5rem;
    --rt-gap-footnotes: 2.5rem;
  }
}

@media (max-width: 479px) {
  .w-richtext {
    --rt-bar-gap: 0.75rem;
    --rt-img-radius: 0.625rem;
    --rt-scroll-offset: 9rem;
    --rt-gap-base: 0.875rem;
    --rt-gap-list: 1.25rem;
    --rt-gap-topic: 2rem;
    --rt-gap-after-topic: 0.875rem;
    --rt-gap-sub: 1.25rem;
    --rt-gap-after-sub: 0.75rem;
    --rt-gap-quote: 1.25rem;
    --rt-gap-img: 1.75rem;
    --rt-gap-img-first: 1.25rem;
    --rt-gap-footnotes: 2.5rem;
  }
}
</style>
