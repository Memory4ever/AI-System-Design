  html.is-bar-closing .nav-bar { opacity: 0; pointer-events: none; }
  html.is-bar-closing .nav-global { top: 1.75rem; transition: top 0.3s ease; }
  @media screen and (max-width: 991px) {
    html.is-bar-closing .nav-global { top: 1rem; }
