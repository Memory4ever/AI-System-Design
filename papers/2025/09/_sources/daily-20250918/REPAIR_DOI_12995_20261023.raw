{"data":{"id":"10.48550/arxiv.2509.12995","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12995","prefix":"10.48550","suffix":"arxiv.2509.12995","identifiers":[{"identifier":"2509.12995","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.12995"}],"creators":[{"name":"Zhou, Yue","nameType":"Personal","givenName":"Yue","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"He, Xinan","nameType":"Personal","givenName":"Xinan","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Kaiqing","nameType":"Personal","givenName":"Kaiqing","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Fan, Bing","nameType":"Personal","givenName":"Bing","familyName":"Fan","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Feng","nameType":"Personal","givenName":"Feng","familyName":"Ding","affiliation":[],"nameIdentifiers":[]},{"name":"Zeng, Jinhua","nameType":"Personal","givenName":"Jinhua","familyName":"Zeng","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Bin","nameType":"Personal","givenName":"Bin","familyName":"Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Brought a Gun to a Knife Fight: Modern VFM Baselines Outgun Specialized Detectors on In-the-Wild AI Image Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-16T12:06:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:43:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-18T02:30:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-19T00:15:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-15T03:04:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-16T00:21:11Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"While specialized detectors for AI-generated images excel on curated benchmarks, they fail catastrophically in real-world scenarios, as evidenced by their critically high false-negative rates on `in-the-wild' benchmarks. Instead of crafting another specialized `knife' for this problem, we bring a `gun' to the fight: a simple linear classifier on a modern Vision Foundation Model (VFM). Trained on identical data, this baseline decisively `outguns' bespoke detectors, boosting in-the-wild accuracy by a striking margin of over 20\\%.\n Our analysis pinpoints the source of the VFM's `firepower': First, by probing text-image similarities, we find that recent VLMs (e.g., Perception Encoder, Meta CLIP2) have learned to align synthetic images with forgery-related concepts (e.g., `AI-generated'), unlike previous versions. Second, we speculate that this is due to data exposure, as both this alignment and overall accuracy plummet on a novel dataset scraped after the VFM's pre-training cut-off date, ensuring it was unseen during pre-training. Our findings yield two critical conclusions: 1) For the real-world `gunfight' of AI-generated image detection, the raw `firepower' of an updated VFM is far more effective than the `craftsmanship' of a static detector. 2) True generalization evaluation requires test data to be independent of the model's entire training history, including pre-training.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.12995","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:53:23.000Z","registered":"2025-09-17T01:53:24.000Z","published":"2025","updated":"2025-10-16T02:25:09.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.12995","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}