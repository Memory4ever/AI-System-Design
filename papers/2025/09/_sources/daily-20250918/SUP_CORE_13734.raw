{{}:{\lambda S.S(\lambda A\,x.A(x,\theta))}}\end{matrix}" display="inline" intent=":literal"><semantics><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>S</mi><mo>/</mo><mi>S</mi></mrow></mtd></mtr><mtr><mtd><mrow><mo rspace="0.278em">:</mo><mi>λ</mi><mi>S</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>S</mi><mo stretchy="false">(</mo><mi>λ</mi><mi>A</mi><mi>x</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>A</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{matrix}{S/S}\\
{{}:{\lambda S.S(\lambda A\,x.A(x,\theta))}}\end{matrix}</annotation></semantics></math></span> </span></span>
</span><span id="S4.F3.3.1.1.1.2" class="ltx_text">   </span>
<span id="S4.F3.3.1.1.1.3" class="ltx_inline-block ltx_align_bottom">
<span id="S4.F3.3.1.1.1.3.1" class="ltx_p">    <span id="S4.F3.3.1.1.1.3.1.1" class="ltx_text"> <span id="S4.F3.3.1.1.1.3.1.1.1" class="ltx_text">omoi (heavy)</span> </span></span>
<span id="S4.F3.3.1.1.1.3.2" class="ltx_p"><span id="S4.F3.3.1.1.1.3.2.1" class="ltx_text" style="position:relative; bottom:0.5pt;"></span><span id="S4.F3.3.1.1.1.3.2.2" class="ltx_text ltx_inline-block" style="width:121.6pt;"><span class="ltx_rule ltx_filled_leader" style="width:121.6pt;height:1px;--ltx-bg-color:black;display:inline-block;"> </span></span><span id="S4.F3.3.1.1.1.3.2.3" class="ltx_text" style="position:relative; bottom:0.5pt;"></span></span>
<span id="S4.F3.3.1.1.1.3.3" class="ltx_p"><span id="S4.F3.3.1.1.1.3.3.1" class="ltx_text"> <span id="S4.F3.3.1.1.1.3.3.1.1" class="ltx_text"><math id="S4.F3.m9" class="ltx_Math" alttext="\begin{matrix}{S\backslash\mathit{NP}}\\
{{}:{\lambda Q\,N.Q(\lambda x.N(\mathsf{heavy},x))}}\end{matrix}" display="inline" intent=":literal"><semantics><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">\</mo><mi>𝑁𝑃</mi></mrow></mtd></mtr><mtr><mtd><mrow><mo rspace="0.278em">:</mo><mi>λ</mi><mi>Q</mi><mi>N</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>Q</mi><mo stretchy="false">(</mo><mi>λ</mi><mi>x</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>N</mi><mo stretchy="false">(</mo><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>,</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{matrix}{S\backslash\mathit{NP}}\\
{{}:{\lambda Q\,N.Q(\lambda x.N(\mathsf{heavy},x))}}\end{matrix}</annotation></semantics></math></span> </span></span>
</span></span>
<span id="S4.F3.3.1.1.2" class="ltx_p"><span id="S4.F3.3.1.1.2.1" class="ltx_text" style="position:relative; bottom:0.5pt;"></span><span id="S4.F3.3.1.1.2.2" class="ltx_text ltx_inline-block" style="width:233.0pt;"><span class="ltx_rule ltx_filled_leader" style="width:233.0pt;height:1px;--ltx-bg-color:black;display:inline-block;"> </span></span><span id="S4.F3.3.1.1.2.3" class="ltx_text" style="position:relative; bottom:-1.8pt;"> <math id="S4.F3.m10" class="ltx_Math" alttext="{&gt;}\mathbf{B}_{\times}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><msub><mi>𝐁</mi><mo>×</mo></msub></mrow><annotation encoding="application/x-tex">{&gt;}\mathbf{B}_{\times}</annotation></semantics></math></span></span>
<span id="S4.F3.3.1.1.3" class="ltx_p">       <span id="S4.F3.3.1.1.3.1" class="ltx_text"> <span id="S4.F3.3.1.1.3.1.1" class="ltx_text"><math id="S4.F3.m11" class="ltx_Math" alttext="\begin{matrix}{S\backslash\mathit{NP}}\\
{{}:{\lambda Q.Q(\lambda x.\mathsf{heavy}(x,\theta))}}\end{matrix}" display="inline" intent=":literal"><semantics><mtable rowspacing="0pt"><mtr><mtd><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.222em">\</mo><mi>𝑁𝑃</mi></mrow></mtd></mtr><mtr><mtd><mrow><mo rspace="0.278em">:</mo><mi>λ</mi><mi>Q</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>Q</mi><mo stretchy="false">(</mo><mi>λ</mi><mi>x</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{matrix}{S\backslash\mathit{NP}}\\
{{}:{\lambda Q.Q(\lambda x.\mathsf{heavy}(x,\theta))}}\end{matrix}</annotation></semantics></math></span> </span></span>
