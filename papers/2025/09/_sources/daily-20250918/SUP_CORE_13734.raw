<td id="S4.T3.2.2.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S4.T3.m2" class="ltx_math_unparsed" alttext="\lambda E\,V\,M.V(\lambda G.\exists d.(M(\lambda A\,x.A(x,d))" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mi>E</mi><mi>V</mi><mi>M</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>λ</mi><mi>G</mi><mo lspace="0em" rspace="0.167em">.</mo><mo rspace="0.167em">∃</mo><mi>d</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mrow><mo stretchy="false">(</mo><mi>λ</mi><mi>A</mi><mi>x</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>A</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda E\,V\,M.V(\lambda G.\exists d.(M(\lambda A\,x.A(x,d))</annotation></semantics></math></td></tr>
