<tr id="A2.T8.2.2" class="ltx_tr">
<td id="A2.T8.2.2.1" class="ltx_td ltx_align_center ltx_border_t">CP</td>
<td id="A2.T8.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A2.T8.m1" class="ltx_math_unparsed" alttext="\forall x\ y.\left(\left(\exists d.\left(\mathbf{A}(x,d)\land\lnot\mathbf{A}(y,d)\right)\right)\rightarrow\forall d.\left(\mathbf{A}(y,d)\rightarrow\mathbf{A}(x,d)\right)\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∀</mo><mi>x</mi><mi>y</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo>(</mo><mrow><mo>(</mo><mo rspace="0.167em">∃</mo><mi>d</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo>(</mo><mi>𝐀</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo>∧</mo><mo rspace="0.167em">¬</mo><mi>𝐀</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>)</mo></mrow><mo stretchy="false">→</mo><mo rspace="0.167em">∀</mo><mi>d</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo>(</mo><mi>𝐀</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mi>𝐀</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\forall x\ y.\left(\left(\exists d.\left(\mathbf{A}(x,d)\land\lnot\mathbf{A}(y,d)\right)\right)\rightarrow\forall d.\left(\mathbf{A}(y,d)\rightarrow\mathbf{A}(x,d)\right)\right)</annotation></semantics></math></td></tr>
<tr id="A2.T8.2.3" class="ltx_tr">
<td id="A2.T8.2.3.1" class="ltx_td ltx_align_center ltx_border_tt">ANT</td>
<td id="A2.T8.2.3.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T8.m2" class="ltx_Math" alttext="\forall x\ d.\left(\mathbf{P}(x,d)\leftrightarrow\lnot\mathbf{N}(x,d)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mrow><mi>x</mi><mo lspace="0.500em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo>(</mo><mrow><mi>𝐏</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↔</mo><mrow><mo rspace="0.167em">¬</mo><mrow><mi>𝐍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\forall x\ d.\left(\mathbf{P}(x,d)\leftrightarrow\lnot\mathbf{N}(x,d)\right)</annotation></semantics></math></td></tr>
<tr id="A2.T8.2.4" class="ltx_tr">
<td id="A2.T8.2.4.1" class="ltx_td ltx_align_center ltx_border_tt">UP</td>
<td id="A2.T8.2.4.2" class="ltx_td ltx_align_center ltx_border_tt"><math id="A2.T8.m3" class="ltx_math_unparsed" alttext="\forall x\ d.\left(\mathbf{P}(x,d)\rightarrow\forall d^{\prime}.\left(d^{\prime}\leq d\rightarrow\mathbf{P}(x,d^{\prime})\right)\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∀</mo><mi>x</mi><mi>d</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo>(</mo><mi>𝐏</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mo rspace="0.167em">∀</mo><msup><mi>d</mi><mo>′</mo></msup><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo>(</mo><msup><mi>d</mi><mo>′</mo></msup><mo>≤</mo><mi>d</mi><mo stretchy="false">→</mo><mi>𝐏</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\forall x\ d.\left(\mathbf{P}(x,d)\rightarrow\forall d^{\prime}.\left(d^{\prime}\leq d\rightarrow\mathbf{P}(x,d^{\prime})\right)\right)</annotation></semantics></math></td></tr>
<tr id="A2.T8.2.5" class="ltx_tr">
<td id="A2.T8.2.5.1" class="ltx_td ltx_align_center">DOWN</td>
<td id="A2.T8.2.5.2" class="ltx_td ltx_align_center"><math id="A2.T8.m4" class="ltx_math_unparsed" alttext="\forall x\ d.\left(\mathbf{N}(x,d)\rightarrow\forall d^{\prime}.\left(d^{\prime}\geq d\rightarrow\mathbf{N}(x,d^{\prime})\right)\right)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∀</mo><mi>x</mi><mi>d</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo>(</mo><mi>𝐍</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mo rspace="0.167em">∀</mo><msup><mi>d</mi><mo>′</mo></msup><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo>(</mo><msup><mi>d</mi><mo>′</mo></msup><mo>≥</mo><mi>d</mi><mo stretchy="false">→</mo><mi>𝐍</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>d</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\forall x\ d.\left(\mathbf{N}(x,d)\rightarrow\forall d^{\prime}.\left(d^{\prime}\geq d\rightarrow\mathbf{N}(x,d^{\prime})\right)\right)</annotation></semantics></math></td></tr>
<tr id="A2.T8.2.6" class="ltx_tr">
<td id="A2.T8.2.6.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_tt">DELTA</td>
<td id="A2.T8.2.6.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_tt"><math id="A2.T8.m5" class="ltx_Math" alttext="\forall x.\left(\mathbf{A}(x,\theta-\delta)\leftrightarrow\mathbf{A}(x,\theta+\delta)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>x</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mo>(</mo><mrow><mi>𝐀</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mi>θ</mi><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↔</mo><mrow><mi>𝐀</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mrow><mi>θ</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\forall x.\left(\mathbf{A}(x,\theta-\delta)\leftrightarrow\mathbf{A}(x,\theta+\delta)\right)</annotation></semantics></math></td></tr>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 8: </span>Axioms for Japanese comparatives. <math id="A2.T8.m9" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math> denotes adjectives, <math id="A2.T8.m10" class="ltx_Math" alttext="\mathbf{P}" display="inline" intent=":literal"><semantics><mi>𝐏</mi><annotation encoding="application/x-tex">\mathbf{P}</annotation></semantics></math> denotes positive adjectives such as <span id="A2.T8.5" class="ltx_text ltx_font_italic">long</span>, and <math id="A2.T8.m11" class="ltx_Math" alttext="\mathbf{N}" display="inline" intent=":literal"><semantics><mi>𝐍</mi><annotation encoding="application/x-tex">\mathbf{N}</annotation></semantics></math> denotes negative adjectives such as <span id="A2.T8.6" class="ltx_text ltx_font_italic">short</span>.</figcaption>
</figure>
<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p"><a href="#A2.T8" title="In Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">8</span></a> shows the axioms employed in our system.
(CP) is the axiom we already introduced in <a href="#S3.SS3" title="3.3 Theorem Proving ‣ 3 System Overview ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3.3</span></a>.
We can make the following inferences using this axiom.
(<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>) and (<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>) are the premises, and (<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>) is the hypothesis.</p>
</div>
<div id="A2.p2" class="ltx_para"><span id="A2.p2.1" class="ltx_ERROR undefined">{exe}</span><span id="A2.p2.2" class="ltx_ERROR undefined">\ex</span><span id="A2.p2.3" class="ltx_ERROR undefined">{xlist}</span><span id="A2.p2.4" class="ltx_ERROR undefined">\ex</span><span id="A2.p2.5" class="ltx_ERROR undefined">\gll</span>
<p id="A2.p2.6" class="ltx_p">Taro-wa Jiro yori omoi.
<br class="ltx_break">Taro-<span title="" class="ltx_glossaryref ltx_font_smallcaps">top</span> Jiro than heavy
<br class="ltx_break"><span id="A2.p2.6.1" class="ltx_ERROR undefined">\glt</span>“Taro is heavier than Jiro.”
<span id="A2.p2.6.2" class="ltx_ERROR undefined">\ex</span>
<span id="A2.p2.6.3" class="ltx_ERROR undefined">\gll</span>Jiro-wa 70 kg yori omoi.
<br class="ltx_break">Jiro-<span title="" class="ltx_glossaryref ltx_font_smallcaps">top</span> 70 kg than heavy
<br class="ltx_break"><span id="A2.p2.6.4" class="ltx_ERROR undefined">\glt</span>“Jiro is heavier than 70 kg.”
<span id="A2.p2.6.5" class="ltx_ERROR undefined">\ex</span>
<span id="A2.p2.6.6" class="ltx_ERROR undefined">\gll</span>Taro-wa 70 kg yori omoi.
<br class="ltx_break">Taro-<span title="" class="ltx_glossaryref ltx_font_smallcaps">top</span> 70 kg than heavy
<br class="ltx_break"><span id="A2.p2.6.7" class="ltx_ERROR undefined">\glt</span>“Taro is heavier than 70 kg.”
<span id="A2.p2.6.8" class="ltx_ERROR undefined">\sn</span> (entailment)</p>
</div>
<div id="A2.p3" class="ltx_para ltx_noindent">
<p id="A2.p3.1" class="ltx_p">Concretely, from (CP) and (<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>), we obtain <math id="A2.p3.m1" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{jiro},70)\rightarrow\mathsf{heavy}(\mathsf{taro},70)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗃𝗂𝗋𝗈</mi><mo>,</mo><mn>70</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗍𝖺𝗋𝗈</mi><mo>,</mo><mn>70</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{jiro},70)\rightarrow\mathsf{heavy}(\mathsf{taro},70)</annotation></semantics></math>.
Then, from this formula and (<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>), we can derive <math id="A2.p3.m2" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{taro},70)" display="inline" intent=":literal"><semantics><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗍𝖺𝗋𝗈</mi><mo>,</mo><mn>70</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{taro},70)</annotation></semantics></math>.</p>
</div>
<div id="A2.p4" class="ltx_para">
<p id="A2.p4.1" class="ltx_p">(ANT) indicates the antonymy relation between positive and negative adjectives.
The following is an example of an inference using this axiom.
(<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>) is the premise and (<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>) is the hypothesis.
<span id="A2.p4.1.1" class="ltx_ERROR undefined">{exe}</span>
<span id="A2.p4.1.2" class="ltx_ERROR undefined">\ex</span>
<span id="A2.p4.1.3" class="ltx_ERROR undefined">{xlist}</span>
<span id="A2.p4.1.4" class="ltx_ERROR undefined">\ex</span>
<span id="A2.p4.1.5" class="ltx_ERROR undefined">\gll</span>Taro-wa Jiro yori omoi.
<br class="ltx_break">Taro-<span title="" class="ltx_glossaryref ltx_font_smallcaps">top</span> Jiro than heavy
<br class="ltx_break"><span id="A2.p4.1.6" class="ltx_ERROR undefined">\glt</span>“Taro is heavier than Jiro.”
<span id="A2.p4.1.7" class="ltx_ERROR undefined">\ex</span>
<span id="A2.p4.1.8" class="ltx_ERROR undefined">\gll</span>Taro-wa Jiro yori karui.
<br class="ltx_break">Taro-<span title="" class="ltx_glossaryref ltx_font_smallcaps">top</span> Jiro than light
<br class="ltx_break"><span id="A2.p4.1.9" class="ltx_ERROR undefined">\glt</span>“Taro is lighter than Jiro.”
<span id="A2.p4.1.10" class="ltx_ERROR undefined">\sn</span> (contradiction)</p>
</div>
<div id="A2.p5" class="ltx_para">
<p id="A2.p5.1" class="ltx_p">(UP) and (DOWN) are axioms that indicate the monotonicity of positive and negative adjectives, respectively.
(DELTA) is an axiom about equatives.
Using these axioms, we can prove the entailment relation in (<a href="#S4.SS2" title="4.2 Equatives ‣ 4 Challenges in Handling Japanese Comparatives ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>) as follows.
(<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>), (<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>), and (<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>) are the semantic representations of (<a href="#S4.SS2" title="4.2 Equatives ‣ 4 Challenges in Handling Japanese Comparatives ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>), (<a href="#S4.SS2" title="4.2 Equatives ‣ 4 Challenges in Handling Japanese Comparatives ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>), and (<a href="#S4.SS2" title="4.2 Equatives ‣ 4 Challenges in Handling Japanese Comparatives ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>), respectively.
<span id="A2.p5.1.1" class="ltx_ERROR undefined">{exe}</span>
<span id="A2.p5.1.2" class="ltx_ERROR undefined">\ex</span>
<span id="A2.p5.1.3" class="ltx_ERROR undefined">{xlist}</span>
<span id="A2.p5.1.4" class="ltx_ERROR undefined">\ex</span>
<math id="A2.p5.m1" class="ltx_Math" alttext="\begin{aligned} &amp;\forall d_{1}\,d_{2}.\left(\left(\lnot\left(\mathsf{heavy}(\mathsf{taro},d_{1})\right.\right.\right.\\
&{}\leftrightarrow\left.\mathsf{heavy}(\mathsf{jiro},d_{1})\right)\\
&{}\land\lnot\left(\mathsf{heavy}(\mathsf{taro},d_{2})\right.\\
&{}\leftrightarrow\left.\left.\mathsf{heavy}(\mathsf{jiro},d_{2})\right)\right)\\
&{}\rightarrow\left.|d_{1}-d_{2}|&lt;\delta\right)\end{aligned}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo rspace="0.167em">∀</mo><mi>d</mi><msub><mrow></mrow><mn>1</mn></msub><mi>d</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0em" rspace="0.167em">.</mo><mo>(</mo><mo>(</mo><mo>¬</mo><mo>(</mo><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo stretchy="false">(</mo><mi>𝗍𝖺𝗋𝗈</mi><mo>,</mo><mi>d</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">↔</mo><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo stretchy="false">(</mo><mi>𝗃𝗂𝗋𝗈</mi><mo>,</mo><mi>d</mi><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">)</mo><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>∧</mo><mo>¬</mo><mo>(</mo><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo stretchy="false">(</mo><mi>𝗍𝖺𝗋𝗈</mi><mo>,</mo><mi>d</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo stretchy="false">↔</mo><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo stretchy="false">(</mo><mi>𝗃𝗂𝗋𝗈</mi><mo>,</mo><mi>d</mi><msub><mrow></mrow><mn>2</mn></msub><mo stretchy="false">)</mo><mo>)</mo><mo>)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mphantom></mphantom><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>d</mi><mn>1</mn></msub><mo>−</mo><msub><mi>d</mi><mn>2</mn></msub></mrow><mo stretchy="false">|</mo></mrow><mo>&lt;</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned} &amp;\forall d_{1}\,d_{2}.\left(\left(\lnot\left(\mathsf{heavy}(\mathsf{taro},d_{1})\right.\right.\right.\\
&amp;{}\leftrightarrow\left.\mathsf{heavy}(\mathsf{jiro},d_{1})\right)\\
&amp;{}\land\lnot\left(\mathsf{heavy}(\mathsf{taro},d_{2})\right.\\
&amp;{}\leftrightarrow\left.\left.\mathsf{heavy}(\mathsf{jiro},d_{2})\right)\right)\\
&amp;{}\rightarrow\left.|d_{1}-d_{2}|&lt;\delta\right)\end{aligned}</annotation></semantics></math>
<span id="A2.p5.1.5" class="ltx_ERROR undefined">\ex</span>
<math id="A2.p5.m2" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{jiro},\theta)" display="inline" intent=":literal"><semantics><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗃𝗂𝗋𝗈</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{jiro},\theta)</annotation></semantics></math>
<span id="A2.p5.1.6" class="ltx_ERROR undefined">\ex</span>
<math id="A2.p5.m3" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{taro},\theta)" display="inline" intent=":literal"><semantics><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗍𝖺𝗋𝗈</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{taro},\theta)</annotation></semantics></math>


First, from (<a href="#A2" title="Appendix B Details of Axioms ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a>), (UP), and (DELTA), we can derive <math id="A2.p5.m4" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{jiro},\theta)" display="inline" intent=":literal"><semantics><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗃𝗂𝗋𝗈</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{jiro},\theta)</annotation></semantics></math> and <math id="A2.p5.m5" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{jiro},\theta+\delta)" display="inline" intent=":literal"><semantics><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗃𝗂𝗋𝗈</mi><mo>,</mo><mrow><mi>θ</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{jiro},\theta+\delta)</annotation></semantics></math>.
Then, by replacing <math id="A2.p5.m6" class="ltx_Math" alttext="d_{1}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>1</mn></msub><annotation encoding="application/x-tex">d_{1}</annotation></semantics></math> (resp. <math id="A2.p5.m7" class="ltx_Math" alttext="d_{2}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>2</mn></msub><annotation encoding="application/x-tex">d_{2}</annotation></semantics></math>) in (27a) with <math id="A2.p5.m8" class="ltx_Math" alttext="\theta+\delta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>+</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">\theta+\delta</annotation></semantics></math> (resp. <math id="A2.p5.m9" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>), and by contraposition, we obtain either <math id="A2.p5.m10" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{taro},\theta+\delta)\leftrightarrow\mathsf{heavy}(\mathsf{jiro},\theta+\delta)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗍𝖺𝗋𝗈</mi><mo>,</mo><mrow><mi>θ</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↔</mo><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗃𝗂𝗋𝗈</mi><mo>,</mo><mrow><mi>θ</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{taro},\theta+\delta)\leftrightarrow\mathsf{heavy}(\mathsf{jiro},\theta+\delta)</annotation></semantics></math> or <math id="A2.p5.m11" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{taro},\theta)\leftrightarrow\mathsf{heavy}(\mathsf{jiro},\theta)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗍𝖺𝗋𝗈</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">↔</mo><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗃𝗂𝗋𝗈</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{taro},\theta)\leftrightarrow\mathsf{heavy}(\mathsf{jiro},\theta)</annotation></semantics></math>.
In both cases, <math id="A2.p5.m12" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{taro},\theta)" display="inline" intent=":literal"><semantics><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗍𝖺𝗋𝗈</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{taro},\theta)</annotation></semantics></math> is true since we have <math id="A2.p5.m13" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{jiro},\theta+\delta)" display="inline" intent=":literal"><semantics><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗃𝗂𝗋𝗈</mi><mo>,</mo><mrow><mi>θ</mi><mo>+</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{jiro},\theta+\delta)</annotation></semantics></math> and <math id="A2.p5.m14" class="ltx_Math" alttext="\mathsf{heavy}(\mathsf{jiro},\theta)" display="inline" intent=":literal"><semantics><mrow><mi>𝗁𝖾𝖺𝗏𝗒</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝗃𝗂𝗋𝗈</mi><mo>,</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{heavy}(\mathsf{jiro},\theta)</annotation></semantics></math>.</p>
</div>
<div id="A2.p6" class="ltx_para">
<p id="A2.p6.1" class="ltx_p">In the implementation, (CP) and (DELTA) are added for all gradable adjectives.
(ANT) is added for adjectives that have an antonym.
(UP) and (DOWN) are added for positive adjectives and negative adjectives, respectively.</p>
</div>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Problem Replacement</h2>

<div id="A3.p1" class="ltx_para">
<p id="A3.p1.1" class="ltx_p"><a href="#A3.T9" title="In Appendix C Problem Replacement ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">9</span></a> shows an example of the problems in JSeM to which we applied the replacement we discussed in <a href="#S5.SS2" title="5.2 Dataset ‣ 5 Experiment ‣ Implementing a Logical Inference Systemfor Japanese Comparatives" class="ltx_ref"><span class="ltx_text ltx_ref_tag">section</span> <span class="ltx_text ltx_ref_tag">5.2</span></a>.
The original problem uses the property that the presupposition “Hanako is an early riser” is not affected by the modal “kamo-sire-nai.”
We did not implement the semantic representation of modals, so we replaced them with a negation “to-iu-wake-de-wa-nai.”
Since presuppositions are unaffected by negation (as well as by modals), this replacement does not alter the purpose of the problem—namely, to test whether the model understands that presuppositions are not influenced by entailment-canceling operators.</p>
</div>
