</table></td></tr>
<tr id="S5.T4.2.3" class="ltx_tr">
<td id="S5.T4.2.3.1" class="ltx_td ltx_align_left">P2</td>
<td id="S5.T4.2.3.2" class="ltx_td ltx_align_left ltx_align_top">
<table id="S5.T4.2.3.2.1" class="ltx_tabular ltx_align_middle" style="width:184.9pt;">
<tr id="S5.T4.2.3.2.1.1" class="ltx_tr">
<td id="S5.T4.2.3.2.1.1.1" class="ltx_td ltx_align_left">ITEL-XZ-wa hayai.</td></tr>
