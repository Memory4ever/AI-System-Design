rix" transform="matrix(1 0 0 -1 0 17.22)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 6.73)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:14.94em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="164.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic3.9" class="ltx_text" style="font-size:70%;">Then the model performs bottom </span></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 15.34)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:14.34em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.17em;font-size:7.97pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="158.15"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic3.10" class="ltx_text" style="font-size:70%;">up reasoning on the reduced set </span></span></span></foreignObject></g></g></g></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 23.95)"><g class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" transform="matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:4.47em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:7.97pt;" height="6.73" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="49.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic3.11" class="ltx_text" style="font-size:70%;">of axioms.</span></span></span></foreignObject></g></g></g></g></g><g style="--ltx-fg-color:#0000FF;" color="#0000FF" stroke-width="0.8pt"><g style="--ltx-stroke-color:#0000FF;--ltx-fill-color:#0000FF;" fill="#0000FF" stroke="#0000FF"><path style="fill:none" d="M 100.39 0 L 100.39 -189.08"></path></g><g style="--ltx-str