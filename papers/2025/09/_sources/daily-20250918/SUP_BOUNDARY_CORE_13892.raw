<th id="S2.T1.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S2.T1.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Level of detail and origin</span></th>
