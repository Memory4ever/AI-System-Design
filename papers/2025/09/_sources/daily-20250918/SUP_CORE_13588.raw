<td id="S7.T2.2.2.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding:0.5pt 2.0pt;"><span id="S7.T2.2.2.8.1" class="ltx_text" style="--ltx-bg-color:#D6E8FF;">1.00 (0.00)</span></td></tr>
