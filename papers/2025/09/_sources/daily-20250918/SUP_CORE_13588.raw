<td id="S7.T2.2.3.2" class="ltx_td ltx_align_left" style="padding:0.5pt 2.0pt;">Spearman <math id="S7.T2.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math></td>
