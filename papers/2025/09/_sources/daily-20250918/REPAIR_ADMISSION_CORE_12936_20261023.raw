<span id="A3.F8.3.1.1" class="ltx_inline-logical-block ltx_minipage ltx_align_middle" style="width:138.0pt;">
<span id="A3.F8.p2" class="ltx_para ltx_align_left ltx_noindent"><span class="ltx_inline-block"><svg id="A3.F8.p2.pic1" class="ltx_picture" height="205.72" overflow="visible" version="1.1" viewBox="0 0 152.76 205.72" width="152.76"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,205.72) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#999999;" fill="#999999" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 200.67 C 0 203.46 2.26 205.72 5.04 205.72 L 147.71 205.72 C 150.5 205.72 152.76 203.46 152.76 200.67 L 152.76 5.04 C 152.76 2.26 150.5 0 147.71 0 Z"></path></g><g style="--ltx-fill-color:#E6E6E6;" fill="#E6E6E6" fill-opacity="1.0"><path style="stroke:none" d="M 1.11 1.11 L 1.11 200.67 C 1.11 202.85 2.87 204.61 5.04 204.61 L 147.71 204.61 C 149.89 204.61 151.65 202.85 151.65 200.67 L 151.65 5.04 C 151.65 2.87 149.89 1.11 147.71 1.11 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 20.79 182.42)"><foreignObject style="--ltx-fo-width:8.03em;--ltx-fo-height:0.75em;--ltx-fo-depth:12.25em;font-size:10pt;" height="179.88" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="111.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
