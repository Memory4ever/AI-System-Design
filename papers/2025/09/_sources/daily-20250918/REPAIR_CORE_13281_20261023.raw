</span></span><span id="A2.T6.2.1.4.3" class="ltx_text"></span></td>
<td id="A2.T6.2.1.5" class="ltx_td ltx_align_right ltx_border_tt"><span id="A2.T6.2.1.5.1" class="ltx_text"></span> <span id="A2.T6.2.1.5.2" class="ltx_text">
