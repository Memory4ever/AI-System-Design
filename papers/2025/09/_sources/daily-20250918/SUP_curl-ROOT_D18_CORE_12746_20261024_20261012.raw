<td id="S3.F10.3.3.2" class="ltx_td ltx_align_center"><span id="S3.F10.3.3.2.1" class="ltx_text ltx_font_italic">Idealized 6(D1)</span></td>
<td id="S3.F10.3.3.3" class="ltx_td ltx_align_center"><span id="S3.F10.3.3.3.1" class="ltx_text ltx_font_italic">Idealized 7(D2)</span></td>
<td id="S3.F10.3.3.4" class="ltx_td ltx_align_center"><span id="S3.F10.3.3.4.1" class="ltx_text ltx_font_italic">Idealized 8(D1)</span></td></tr>
