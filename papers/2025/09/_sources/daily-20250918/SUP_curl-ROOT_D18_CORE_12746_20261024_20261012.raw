<td id="S1.F3.3.4.3" class="ltx_td ltx_align_center"><img src="2509.12746v1/filter-jointscalefroml2diff7-bluered-eps-converted-to.png" id="S1.F3.g7" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:96/72;" width="96" height="72" alt="Refer to caption"></td>
