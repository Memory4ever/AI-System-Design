<td id="S3.F7.3.1.1" class="ltx_td ltx_align_center"><span id="S3.F7.3.1.1.1" class="ltx_text ltx_font_italic">Idealized 1(B)</span></td>
<td id="S3.F7.3.1.2" class="ltx_td ltx_align_center"><span id="S3.F7.3.1.2.1" class="ltx_text ltx_font_italic">Idealized 2(B)</span></td>
<td id="S3.F7.3.1.3" class="ltx_td ltx_align_center"><span id="S3.F7.3.1.3.1" class="ltx_text ltx_font_italic">Idealized 3(B)</span></td>
<td id="S3.F7.3.1.4" class="ltx_td ltx_align_center"><span id="S3.F7.3.1.4.1" class="ltx_text ltx_font_italic">Idealized 4(B)</span></td></tr>
