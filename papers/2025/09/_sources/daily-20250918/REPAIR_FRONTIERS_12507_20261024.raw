 2x, https://www.frontiersin.org/api/ipx/w=990&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g009.webp 3x" media><source srcset="https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g009.webp" media><!--]--><img src="https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g009.webp" class="is-inside-mask" alt loading="lazy"></picture><!----></figure><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="var(--maincolor50)" width="24px" style="vertical-align:middle;display:inline-block;height:auto;"><path d="M28 10V6h14v14h-4v-7.171L27.414 23.413l-2.828-2.828L35.172 10H28ZM6 28h4v7.172l10.586-10.586 2.828 2.828L12.828 38H20v4H6V28Z"></path></svg></button><a href="#F9" class="FiguresOutlineItem__link" aria-label="View FIGURE 9 in article" data-event="dt_figures_outline-click-view_in_article"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="currentColor" width="16px" style="vertical-align:middle;display:inline-block;height:auto;"><path d="m28.446 11.85-1.359 1.353a.925.925 0 0 0-.21.3.974.974 0 0 0 0 .735.94.94 0 0 0 .21.3l7.563 7.563H6.96a.962.962 0 0 0-.96.96v1.92a.963.963 0 0 0 .96.96h27.69l-7.563 7.566a.925.925 0 0 0-.21.3.974.974 0 0 0 0 .735.98.98 0 0 0 .21.3l1.359 1.353a.96.96 0 0 0 1.356 0L42 23.997 29.802 11.802a.942.942 0 0 0-.3-.21.982.982 0 0 0-.738 0 .942.942 0 0 0-.3.21l-.018.048Z"></path></svg>View in article </a></li><li class="FiguresOutlineItem"><p class="FiguresOutlineItem__title">FIGURE 10</p><button class="FiguresOutlineItem__image" data-event="dt_figures_outline-click-open_lightbox" aria-label="View {{ title }} in lightbox"><figure class="FrontiersImage FiguresOutlineItem__image"><picture class="FrontiersImage"><!--[--><source srcset="https://www.frontiersin.org/api/ipx/w=340&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 1x, https://www.frontiersin.org/api/ipx/w=680&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 2x, https://www.frontiersin.org/api/ipx/w=1020&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 3x" media="(max-width: 563px)"><source srcset="https://www.frontiersin.org/api/ipx/w=612&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 1x, https://www.frontiersin.org/api/ipx/w=1224&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 2x, https://www.frontiersin.org/api/ipx/w=1836&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 3x" media="(max-width: 768px)"><source srcset="https://www.frontiersin.org/api/ipx/w=247&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 1x, https://www.frontiersin.org/api/ipx/w=494&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 2x, https://www.frontiersin.org/api/ipx/w=741&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 3x" media="(max-width: 1280px)"><source srcset="https://www.frontiersin.org/api/ipx/w=287&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 1x, https://www.frontiersin.org/api/ipx/w=574&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 2x, https://www.frontiersin.org/api/ipx/w=861&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 3x" media="(max-width: 1441px)"><source srcset="https://www.frontiersin.org/api/ipx/w=330&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 1x, https://www.frontiersin.org/api/ipx/w=660&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 2x, https://www.frontiersin.org/api/ipx/w=990&amp;f=webp/https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp 3x" media><source srcset="https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp" media><!--]--><img src="https://www.frontiersin.org/files/Articles/1110534/xml-images/frobt-10-1110534-g010.webp" class="is-inside-mask" alt loading="lazy"></picture><!----></figure><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="var(--maincolor50)" width="24px" style="vertical-align:middle;display:inline-block;height:auto;"><path d="M28 10V6h14v14h-4v-7.171L27.414 23.413l-2.828-2.828L35.172 10H28ZM6 28h4v7.172l10.586-10.586 2.828 2.828L12.828 38H20v4H6V28Z"></path></svg></button><a href="#F10" class="FiguresOutlineItem__link" aria-label="View FIGURE 10 in article" data-event="dt_figures_outline-click-view_in_article"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="currentColor" width="16px" style="vertical-align:middle;display:inline-block;height:auto;"><path d="m28.446 11.85-1.359 1.353a.925.925 0 0 0-.21.3.974.974 0 0 0 0 .735.94.94 0 0 0 .21.3l7.563 7.563H6.96a.962.962 0 0 0-.96.96v1.92a.963.963 0 0 0 .96.96h27.69l-7.563 7.566a.925.925 0 0 0-.21.3.974.974 0 0 0 0 .735.98.98 0 0 0 .21.3l1.359 1.353a.96.96 0 0 0 1.356 0L42 23.997 29.802 11.802a.942.942 0 0 0-.3-.21.982.982 0 0 0-.738 0 .942.942 0 0 0-.3.21l-.018.048Z"></path></svg>View in article </a></li><li class="FiguresOutlineItem"><p class="FiguresOutlineItem__title">TABLE 1</p><button class="FiguresOutlineItem__table" data-event="dt_figures_outline-click-open_table" aria-label="View {{ title }} in lightbox"><div class="FiguresOutlineItem__table__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="currentColor" width="24px" style="vertical-align:middle;display:inline-block;height:auto;"><path d="M28 10V6h14v14h-4v-7.171L27.414 23.413l-2.828-2.828L35.172 10H28ZM6 28h4v7.172l10.5