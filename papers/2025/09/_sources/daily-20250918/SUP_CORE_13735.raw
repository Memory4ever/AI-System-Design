<td id="S5.T4.4.15.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T4.4.15.2.1" class="ltx_text ltx_underline">65.4 ± 1.3</span></td>
<td id="S5.T4.4.15.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T4.4.15.3.1" class="ltx_text ltx_underline">82.7 ± 0.6</span></td></tr>
