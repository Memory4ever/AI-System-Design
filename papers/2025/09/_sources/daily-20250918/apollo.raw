<!-- Page load: decide whether the transition may run at all -->
<script data-cookieconsent="ignore">
  window.PT = window.PT || {};
  // True when the page is embedded (iframe) OR served through a preview/proxy.
  // markup.io serves the site from *.p.markup.io and spoofs
  // window.top === window.self, so a plain iframe check is not enough — in that
  // context a full-page navigation can't complete and the overlay would hang.
  window.PT.embedded = (function () {
    try {
      if (window.self !== window.top) return true;
    } catch (e) {
      return true;
    }
    try {
      var ao = window.location.ancestorOrigins; // survives the top/self shim
      if (ao && ao.length > 0) return true;
    } catch (e) {}
    if (/(^|\.)markup\.io$/i.test(location.hostname)) return true; // markup.io proxy
    return false;
  })();
  // Incoming reveal: play on a genuine entry, but never when embedded/proxied,
  // and not on refresh / back-forward restore.
  if (!window.PT.embedded) {
    try {
      var t;
      var entries = performance.getEntriesByType && performance.getEntriesByType('navigation');
      if (entries && entries.length) {
        t = entries[0].type; // 'navigate' | 'reload' | 'back_forward'
      } else if (performance.navigation) {
        t = { 0: 'navigate', 1: 'reload', 2: 'back_forward' }[performance.navigation.type] || 'navigate';
      } else {
        t = 'navigate';
      }
      if (t !== 'reload' && t !== 'back_forward') {
        document.documentElement.classList.add('pt-cover');
      }
    } catch (e) {}
  }
</script>
<!-- Page load CSS -->
<style>
  /* Overlay sits on top; page content stays painted underneath.
     Color, width and layout are controlled in Webflow — we only set
     what the animation needs. */
  .transition_wrap {
    pointer-events: none; /* never blocks clicks on the page */
    display: flex;
  }
  /* Default state (refresh / back-forward / embedded): columns parked
     off-screen = fully revealed. The overlay never obscures content. */
  .transition_column {
    transform: translateY(-100%);
    will-change: transform;
  }
  /* Armed only on a genuine entry (pt-cover added in <head>). */
  .pt-cover .transition_column {
    transform: translateY(0);
    animation: transitionReveal 0.7s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }
  .pt-cover .transition_column:nth-child(1) {
    animation-delay: 0s;
  }
  .pt-cover .transition_column:nth-child(2) {
    animation-delay: 0.12s;
  }
  .pt-cover .transition_column:nth-child(3) {
    animation-delay: 0.24s;
  }
  .pt-cover .transition_column:nth-child(4) {
    animation-delay: 0.36s;
  }
  .pt-cover .transition_column:nth-child(5) {
    animation-delay: 0.48s;
  }
  .pt-cover .transition_column:nth-child(6) {
    animation-delay: 0.6s;
  }
  @keyframes transitionReveal {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-100%);
    }
  }
  /* While leaving, GSAP drives the columns — kill the CSS anim to
     avoid the two fighting over transform. */
  .is-leaving .transition_column {
    animation: none !important;
  }
  /* Accessibility: no motion, no overlay */
  @media (prefers-reduced-motion: reduce) {
    .transition_wrap {
      display: none !important;
    }
    .transition_column {
      animation: none !important;
    }
  }
</style>
<!--- Buttons animation Code css -->
<style>
  /* Stagger engine — scoped so .is-icon and .is-secondary are never touched */
  .button:not(.is-icon):not(.is-secondary) .char {
    display: inline-block;
    overflow: hidden; /* hides the duplicate line */
    vertical-align: top;
    line-height: 1.15;
    height: 1.15em; /* one text line; bump if descenders clip */
  }
  .button:not(.is-icon):not(.is-secondary) .char.is-space {
    width: 0.28em; /* preserves word spacing */
    overflow: visible;
  }
  .button:not(.is-icon):not(.is-secondary) .char__inner {
    display: flex;
    flex-direction: column;
    transform: translateY(0);
    transition: transform 0.45s cubic-bezier(0.76, 0, 0.24, 1);
    transition-delay: calc(var(--char-index, 0) * 0.018s);
    will-change: transform;
  }
  .button:not(.is-icon):not(.is-secondary) .char__inner > span {
    display: block;
    height: 1.15em;
  }
  /* The reveal: column has 2 copies, slide up exactly one line */
  .button:not(.is-icon):not(.is-secondary):hover .char__inner,
  .button:not(.is-icon):not(.is-secondary):focus-visible .char__inner {
    transform: translateY(-50%);
  }
  @media (prefers-reduced-motion: reduce) {
    .button:not(.is-icon):not(.is-secondary) .char__inner {
      transition: none;
    }
  }
</style>
<!--- Nav code CSS -->
<style>
  /* Sticky so the bar floats over page content. */
  .section-nav { position: sticky; top: 0; z-index: 1000; }

  /* Rotate on open — Webflow adds .w--open to the toggle */
  .dropdown-toggle.w--open .dropdown_link-icon { transform: rotate(180deg); }

  /* No scroll animation anywhere: the nav keeps its "before scroll" state.
     .scrolled is not used any more — the footer script that added it is gone. */
  .navbar_container {
    width: 100%;
    max-width: 90rem;
    margin-left: auto;
    margin-right: auto;
    background-color: transparent;
  }

  /* Tablet & desktop: logo left, menu centre, buttons right. */
  @media (min-width: 768px) {
    .navbar_contents.is-center-bordered {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      width: 100%;
    }
    .navbar_contents.is-center-bordered > * { min-width: 0; }
    .navbar_brand { justify-self: start; }
    .navbar_left.is-center-bordered { justify-self: center; }
    .navbar_right { justify-self: end; }
  }

  /* 768–1259: a dead-centre menu needs (menu + 2 × buttons) of room, which is
     more than there is — the search icon ends up sitting on "Careers".
     Below 1260 drop the centring and lay the three groups out in a plain row. */
  @media (min-width: 768px) and (max-width: 1259px) {
    .navbar_contents.is-center-bordered {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    /* the groups keep their natural width — nothing may shrink and overflow */
    .navbar_brand,
    .navbar_left.is-center-bordered,
    .navbar_right { flex: 0 0 auto; }
    .navbar_left.is-center-bordered { padding-left: 0.75rem; padding-right: 0.75rem; }
    .navbar_menu.is-centered { gap: 1rem; }
  }

  /* TABLET (768–991): one uniform bar instead of two pills with a gap,
     and the tightest spacing of the three bands. */
  @media (min-width: 768px) and (max-width: 991px) {
    .navbar_container {
      background-color: #eeefef;
      border-radius: 0.75rem;
      padding-left: 1rem;
      padding-right: 1rem;
    }
    .navbar_left.is-center-bordered,
    .navbar_right {
      background-color: transparent;
      border-radius: 0;
    }
    .navbar_left.is-center-bordered { padding-left: 0; padding-right: 0; }
    .navbar_right { padding-right: 0; }
    .navbar_contents { margin-left: 0; }

    .navbar_contents.is-center-bordered { gap: 0.5rem; }
    .navbar_menu.is-centered { gap: 0.375rem; }
    .navbar_menu_link,
    .dropdown-toggle,
    .navbar_menu_link .text-color-nav,
    .dropdown-toggle .text-color-nav { font-size: 0.8rem; }
  }

  @media (max-width: 767px) {
    .dropdown-toggle .dropdown_link-icon {
      display: block !important;
      width: 1rem;
      height: 1rem;
      flex: 0 0 auto;
      transition: transform 0.3s cubic-bezier(0.76, 0, 0.24, 1);
    }
  }
</style>
<!--- Sections animation code -->
<style>
  :root {
    --reveal-y: 110%; /* start offset below the mask edge */
    --reveal-duration: 0.8s;
    --reveal-ease: cubic-bezier(0.16, 1, 0.3, 1); /* Osmo easeOutExpo */
    --reveal-step: 0.08s; /* stagger between objects in a row */
  }
  html.reveal-ready .is-reveal-item {
    overflow: hidden;
  }
  html.reveal-ready .reveal-inner {
    display: block;
  } /* wraps text-only items */
  /* Hidden state */
  html.reveal-ready .is-reveal-item > * {
    transform: translateY(var(--reveal-y));
    transition: transform var(--reveal-duration) var(--reveal-ease);
    transition-delay: calc(var(--reveal-index, 0) * var(--reveal-step));
    will-change: transform;
  }
  /* Revealed (one-way, no reverse) */
  html.reveal-ready .is-reveal-item.is-inview > * {
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    html.reveal-ready .is-reveal-item > * {
      transform: none !important;
      transition: none;
    }
  }
</style>

<!-- YouTube consent facade -->
<style>
  .yt-facade_host {
    position: relative;
  }
  .yt-facade_host iframe[data-cookieblock-src] {
    display: none;
  }
  .yt-facade {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
    text-align: center;
    cursor: pointer;
    pointer-events: auto;
    background-color: #eeefef;
    border-radius: 0.5rem;
  }
  .yt-facade_text {
    margin: 0;
    max-width: 34ch;
    font-size: 0.875rem;
    line-height: 1.4;
    color: #4a4a4a;
  }
  .yt-facade_button {
    padding: 0.5rem 1.25rem;
    border: 1px solid #4a4a4a;
    border-radius: 999px;
    background: none;
    font: inherit;
    font-size: 0.875rem;
    color: #4a4a4a;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .yt-facade_button:hover {
    background-color: rgba(0, 0, 0, 0.06);
  }
</style>
<script data-cookieconsent="ignore">
  (function () {
    var YT = /(?:youtube(?:-nocookie)?\.com|youtu\.be)/i;

    function blockedFrames() {
      var all = document.querySelectorAll('iframe[data-cookieblock-src]');
      var out = [];
      for (var i = 0; i < all.length; i++) {
        if (YT.test(all[i].getAttribute('data-cookieblock-src') || '')) out.push(all[i]);
      }
      return out;
    }

    function openBanner(event) {
      event.preventDefault();
      event.stopPropagation();
      if (window.Cookiebot && typeof window.Cookiebot.renew === 'function') {
        window.Cookiebot.renew();
      }
    }

    function build(frame) {
      var host = frame.parentElement;
      if (!host || host.querySelector('.yt-facade')) return;
      host.classList.add('yt-facade_host');

      var box = document.createElement('div');
      box.className = 'yt-facade';

      var text = document.createElement('p');
      text.className = 'yt-facade_text';
      text.textContent =
        'This video is hosted on YouTube and stays blocked until marketing cookies are accepted.';

      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'yt-facade_button';
      btn.textContent = 'Allow and play';

      box.appendChild(text);
      box.appendChild(btn);
      box.addEventListener('click', openBanner);
      host.appendChild(box);
    }

    function release() {
      var frames = blockedFrames();
      for (var i = 0; i < frames.length; i++) {
        var frame = frames[i];
        var src = frame.getAttribute('data-cookieblock-src');
        if (src && !frame.getAttribute('src')) {
          frame.setAttribute('src', src);
          frame.removeAttribute('data-cookieblock-src');
          frame.removeAttribute('data-cybot-cookiebot-blocked');
          frame.classList.remove('cookieconsent-optin-marketing');
        }
      }
      var open = document.querySelectorAll('.yt-facade');
      for (var j = 0; j < open.length; j++) open[j].remove();
    }

    function scan() {
      if (window.Cookiebot && window.Cookiebot.consent && window.Cookiebot.consent.marketing) {
        release();
        return;
      }
      var frames = blockedFrames();
      for (var k = 0; k < frames.length; k++) build(frames[k]);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scan);
    } else {
      scan();
    }
    window.addEventListener('CookiebotOnConsentReady', scan);
    window.addEventListener('CookiebotOnAccept', scan);
    window.addEventListener('CookiebotOnDecline', scan);
  })();
</script>

<!-- Anchor hash capture -->
<script data-cookieconsent="ignore">
(function () {
  var h = location.hash;
  if (h.length < 2) return;
  var id;
  try { id = decodeURIComponent(h.slice(1)); } catch (e) { return; }
  window.__anchorHash = h;
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  history.replaceState(history.state, '', location.pathname + location.search);

  function hide() {
    var el = document.getElementById(id);
    if (!el) return;
    el.setAttribute('data-anchor-id', id);
    el.removeAttribute('id');
  }

  var mo = new MutationObserver(hide);
  mo.observe(document.documentElement, { childList: true, subtree: true });
  document.addEventListener('DOMContentLoaded', function () {
    hide();
    mo.disconnect();
  });
})();
