<span id="A1.F13.pic1.1.1" class="ltx_p"><span id="A1.F13.pic1.1.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Task
<br class="ltx_break">…

<br class="ltx_break"></span></span>
<span id="A1.F13.pic1.1.2" class="ltx_p"><span id="A1.F13.pic1.1.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Instance Format
<br class="ltx_break">…

<br class="ltx_break"></span></span>
<span id="A1.F13.pic1.1.3" class="ltx_p"><span id="A1.F13.pic1.1.3.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Constraints
<br class="ltx_break">…

<br class="ltx_break"></span></span>
<span id="A1.F13.pic1.1.4" class="ltx_p"><span id="A1.F13.pic1.1.4.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Output Format
<br class="ltx_break">…

<br class="ltx_break"></span></span>
<span id="A1.F13.pic1.1.5" class="ltx_p"><span id="A1.F13.pic1.1.5.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Instance 
<br class="ltx_break">…

<br class="ltx_break">Step by Step Process</span></span>
<span id="A1.F13.pic1.1.6" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></span>
<span id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">#</span><span id="lstnumberx1.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx1.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">INITIALIZE</span><span id="lstnumberx1.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">:</span>
</span>
