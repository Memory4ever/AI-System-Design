            <span id="lstnumberx25.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">####</span><span id="lstnumberx25.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">␣</span><span id="lstnumberx25.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">**II.</span><span id="lstnumberx25.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">␣</span><span id="lstnumberx25.6" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">Explicit</span><span id="lstnumberx25.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">␣</span><span id="lstnumberx25.8" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">Penalties</span><span id="lstnumberx25.9" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">␣</span><span id="lstnumberx25.10" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">(What</span><span id="lstnumberx25.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">␣</span><span id="lstnumberx25.12" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">to</span><span id="lstnumberx25.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">␣</span><span id="lstnumberx25.14" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">penalize):**</span>
</div>
