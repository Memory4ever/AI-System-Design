<td id="S4.T2.2.8.3" class="ltx_td ltx_align_center"><span id="S4.T2.2.8.3.1" class="ltx_text ltx_font_bold">0.4600</span></td></tr>
<tr id="S4.T2.2.9" class="ltx_tr">
<td id="S4.T2.2.9.1" class="ltx_td ltx_align_left">
<span id="S4.T2.2.9.1.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T2.2.9.1.1.1" class="ltx_p ltx_align_left">Llama-3 8B <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib29" title="" class="ltx_ref">Meta (2024)</a></cite></span>
</span></td>
<td id="S4.T2.2.9.2" class="ltx_td ltx_align_center">0.6881</td>
<td id="S4.T2.2.9.3" class="ltx_td ltx_align_center">0.4547</td></tr>
