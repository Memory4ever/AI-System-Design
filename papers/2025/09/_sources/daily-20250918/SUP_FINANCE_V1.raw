<span id="S4.T2.p6.1.2.1.2" class="ltx_tr">
<span id="S4.T2.p6.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">(reasoning)</span></span>
</span></span><span id="S4.T2.p6.1.3" class="ltx_text"></span></span>
</span></span></td>
<td id="S4.T2.2.6.2" class="ltx_td"></td>
<td id="S4.T2.2.6.3" class="ltx_td"></td></tr>
<tr id="S4.T2.2.7" class="ltx_tr">
<td id="S4.T2.2.7.1" class="ltx_td ltx_align_left">
<span id="S4.T2.2.7.1.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T2.2.7.1.1.1" class="ltx_p ltx_align_left"><cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib9" title="" class="ltx_ref">DeepSeekAI (2025)</a></cite></span>
</span></td>
<td id="S4.T2.2.7.2" class="ltx_td ltx_align_center">0.7069</td>
<td id="S4.T2.2.7.3" class="ltx_td ltx_align_center">0.4513</td></tr>
<tr id="S4.T2.2.8" class="ltx_tr">
<td id="S4.T2.2.8.1" class="ltx_td ltx_align_left"><span id="S4.T2.2.8.1.1" class="ltx_inline-logical-block ltx_align_top">
<span id="S4.T2.p7" class="ltx_para ltx_align_left ltx_noindent">
<span id="S4.T2.p7.1" class="ltx_p"><span id="S4.T2.p7.1.1" class="ltx_text"></span><span id="S4.T2.p7.1.2" class="ltx_text">
<span id="S4.T2.p7.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T2.p7.1.2.1.1" class="ltx_tr">
<span id="S4.T2.p7.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T2.p7.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Ours (8 B</span>)</span></span>
</span></span><span id="S4.T2.p7.1.3" class="ltx_text"></span></span>
</span></span></td>
