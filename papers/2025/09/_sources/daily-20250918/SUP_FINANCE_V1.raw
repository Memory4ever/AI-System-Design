            <span id="lstnumberx32.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">**Query:**</span><span id="lstnumberx32.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">␣</span><span id="lstnumberx32.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#FF0000;">{query}</span>
</div>
<div id="lstnumberx33" class="ltx_listingline">
