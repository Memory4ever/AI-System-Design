<td id="S4.T2.2.10.1" class="ltx_td ltx_align_left ltx_border_bb">
<span id="S4.T2.2.10.1.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T2.2.10.1.1.1" class="ltx_p ltx_align_left">Mistral-7B v0.3 <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib30" title="" class="ltx_ref">MistralAI (2025a)</a></cite></span>
</span></td>
