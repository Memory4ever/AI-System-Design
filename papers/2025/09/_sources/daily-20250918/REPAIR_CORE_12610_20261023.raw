<td id="S6.T1.5.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S6.T1.5.2.2.1" class="ltx_inline-block ltx_align_top" style="width:142.3pt;">
<span id="S6.T1.5.2.2.1.1" class="ltx_p">Abstracts from medical papers</span>
</span></td>
<td id="S6.T1.5.2.3" class="ltx_td ltx_align_center ltx_border_t">413</td>
<td id="S6.T1.5.2.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S6.T1.5.2.4.1" class="ltx_inline-block ltx_align_top" style="width:199.2pt;">
<span id="S6.T1.5.2.4.1.1" class="ltx_p">Report efficacy of a certain medicine?</span>
</span></td></tr>
