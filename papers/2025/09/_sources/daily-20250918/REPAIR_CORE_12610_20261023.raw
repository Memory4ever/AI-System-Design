              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
              <span id="alg2.l9.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l9.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> <span id="alg2.l9.4" class="ltx_text ltx_font_bold">from</span> <span id="alg2.l9.5" class="ltx_text ltx_markedasmath ltx_font_italic">steps.last</span> <span id="alg2.l9.6" class="ltx_text ltx_font_bold">to</span> <span id="alg2.l9.7" class="ltx_text ltx_markedasmath ltx_font_italic">steps.first</span> <span id="alg2.l9.8" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l10" class="ltx_listingline">
