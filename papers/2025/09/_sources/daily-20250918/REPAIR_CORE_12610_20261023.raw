<th id="S6.T1.5.1.4" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
<span id="S6.T1.5.1.4.1" class="ltx_inline-block ltx_align_top" style="width:199.2pt;">
<span id="S6.T1.5.1.4.1.1" class="ltx_p">Example Query</span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
