            <math id="alg2.l3.m1" class="ltx_Math" alttext="l_{s},r_{s}\leftarrow\textit{steps}.\text{first},\textit{steps}.\text{last}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>l</mi><mi>s</mi></msub><mo>,</mo><mrow><msub><mi>r</mi><mi>s</mi></msub><mo stretchy="false">←</mo><mtext class="ltx_mathvariant_italic">steps</mtext></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mtext>first</mtext><mo>,</mo><mtext class="ltx_mathvariant_italic">steps</mtext><mo lspace="0em" rspace="0.167em">.</mo><mtext>last</mtext></mrow><annotation encoding="application/x-tex">l_{s},r_{s}\leftarrow\textit{steps}.\text{first},\textit{steps}.\text{last}</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <span id="alg2.l4.3" class="ltx_text ltx_font_bold">function</span> <span id="alg2.l4.4" class="ltx_text ltx_font_smallcaps">SelectThresholds</span> (<math id="alg2.l4.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>)

</div>
<div id="alg2.l5" class="ltx_listingline">
