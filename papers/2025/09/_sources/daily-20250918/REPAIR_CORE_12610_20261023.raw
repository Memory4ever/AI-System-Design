<span class="ltx_personname">Yulong Hui<sup id="id4" class="ltx_sup"><span id="id4.1" class="ltx_text ltx_font_italic">∗</span></sup>
</span><span class="ltx_author_notes"><span class="ltx_author_notes_content">
<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span><span id="id5" class="ltx_text ltx_affiliation_institution">Tsinghua University</span>
</span>
