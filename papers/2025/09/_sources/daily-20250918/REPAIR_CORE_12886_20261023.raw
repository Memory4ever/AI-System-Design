<span class="ltx_personname">Jing Shao<span id="footnotex3" class="ltx_note ltx_role_footnotemark"><sup class="ltx_note_mark">3</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">3</sup><span class="ltx_note_type">footnotemark: </span>
          <span class="ltx_tag ltx_tag_note">3</span>
          
          
          
