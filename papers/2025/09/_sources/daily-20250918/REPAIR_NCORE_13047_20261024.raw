<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S5.SS3" title="In V Results ‣ Multi-Model Synthetic Training for Mission-Critical Small Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-C</span> </span><span class="ltx_text ltx_font_italic">Performance Across Question Types</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S5.SS4" title="In V Results ‣ Multi-Model Synthetic Training for Mission-Critical Small Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">V-D</span> </span><span class="ltx_text ltx_font_italic">Cost Analysis</span></span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S6" title="In Multi-Model Synthetic Training for Mission-Critical Small Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VI </span><span class="ltx_text ltx_font_smallcaps">Discussion</span></span></a>
<ol class="ltx_toclist ltx_toclist_section">
