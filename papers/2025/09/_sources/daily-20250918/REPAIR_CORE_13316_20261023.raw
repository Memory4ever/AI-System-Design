<th id="A5.T18.4.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">fav_game</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A5.T18.4.2" class="ltx_tr">
