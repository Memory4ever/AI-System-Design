<td id="A5.T19.6.3.6" class="ltx_td ltx_align_center ltx_border_bb">0.94</td>
<td id="A5.T19.6.3.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb">0.66</td></tr>
