<td id="A5.T19.6.2.5" class="ltx_td ltx_align_center ltx_border_t">0.80</td>
<td id="A5.T19.6.2.6" class="ltx_td ltx_align_center ltx_border_t">0.91</td>
<td id="A5.T19.6.2.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">0.58</td></tr>
