<td id="A3.T7.6.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A3.T7.6.2.2.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
<span id="A3.T7.6.2.2.1.1" class="ltx_p">released in the United States on May 2, 2003.</span>
</span></td>
