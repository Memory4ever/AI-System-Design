<th id="A5.T19.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="A5.T19.m14" class="ltx_Math" alttext="\mathcal{M}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{2}</annotation></semantics></math></th>
<td id="A5.T19.6.3.2" class="ltx_td ltx_align_center ltx_border_bb">0.06</td>
