<span id="S5.T3.16.2.2.1.1" class="ltx_p"><span id="S5.T3.16.2.2.1.1.1" class="ltx_text ltx_font_typewriter">Llama-3</span></span>
</span></th>
<td id="S5.T3.16.2.3" class="ltx_td ltx_align_center ltx_border_t">0.31</td>
