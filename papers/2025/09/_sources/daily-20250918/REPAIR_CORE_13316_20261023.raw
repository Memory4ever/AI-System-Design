<td id="S5.T3.16.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.16.2.5.1" class="ltx_text ltx_font_bold">0.41</span></td>
<td id="S5.T3.16.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.16.2.6.1" class="ltx_text ltx_font_bold">0.73</span></td>
<td id="S5.T3.16.2.7" class="ltx_td ltx_align_center ltx_border_t">0.32</td>
<td id="S5.T3.16.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.16.2.8.1" class="ltx_text ltx_font_bold">0.28</span></td></tr>
<tr id="S5.T3.16.3" class="ltx_tr">
<th id="S5.T3.16.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_t">
<span id="S5.T3.16.3.1.1" class="ltx_inline-block ltx_align_top" style="width:50.6pt;">
<span id="S5.T3.16.3.1.1.1" class="ltx_p"><span id="S5.T3.16.3.1.1.1.1" class="ltx_text ltx_font_typewriter">Patchscopes</span> (<math id="S5.T3.m10" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> = 15)</span>
</span></th>
