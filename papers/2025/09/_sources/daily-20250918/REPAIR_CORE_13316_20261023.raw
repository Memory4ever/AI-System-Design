<span id="S5.T3.16.1.2.1" class="ltx_inline-block ltx_align_top" style="width:28.9pt;">
<span id="S5.T3.16.1.2.1.1" class="ltx_p"><math id="S5.T3.m9" class="ltx_Math" alttext="\mathcal{M}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{M}_{2}</annotation></semantics></math></span>
</span></th>
<td id="S5.T3.16.1.3" class="ltx_td ltx_align_center ltx_border_tt">count_curr</td>
