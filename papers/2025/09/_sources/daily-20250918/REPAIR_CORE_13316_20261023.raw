<th id="A5.T22.6.10.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_bb"></th>
<th id="A5.T22.6.10.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_bb">
<span id="A5.T22.6.10.2.1" class="ltx_inline-block ltx_align_top" style="width:50.6pt;">
<span id="A5.T22.6.10.2.1.1" class="ltx_p">LIT</span>
</span></th>
