<span id="A5.T21.6.1.1.1.1" class="ltx_p">Dataset</span>
</span></th>
<th id="A5.T21.6.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_th_row ltx_border_tt">
<span id="A5.T21.6.1.2.1" class="ltx_inline-block ltx_align_top" style="width:43.4pt;">
<span id="A5.T21.6.1.2.1.1" class="ltx_p">Labels</span>
</span></th>
<th id="A5.T21.6.1.3" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_th_row ltx_border_tt">
<span id="A5.T21.6.1.3.1" class="ltx_inline-block ltx_align_top" style="width:50.6pt;">
<span id="A5.T21.6.1.3.1.1" class="ltx_p">Method</span>
</span></th>
<th id="A5.T21.6.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">
<span id="A5.T21.6.1.4.1" class="ltx_inline-block ltx_align_top">
<span id="A5.T21.6.1.4.1.1" class="ltx_p">country</span>
</span></th>
<th id="A5.T21.6.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">
<span id="A5.T21.6.1.5.1" class="ltx_inline-block ltx_align_top">
<span id="A5.T21.6.1.5.1.1" class="ltx_p">fav_food</span>
</span></th>
<th id="A5.T21.6.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">
<span id="A5.T21.6.1.6.1" class="ltx_inline-block ltx_align_top">
<span id="A5.T21.6.1.6.1.1" class="ltx_p">fav_drink</span>
</span></th>
<th id="A5.T21.6.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">
<span id="A5.T21.6.1.7.1" class="ltx_inline-block ltx_align_top">
