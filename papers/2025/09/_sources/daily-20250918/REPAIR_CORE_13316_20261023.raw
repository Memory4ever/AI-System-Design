<td id="A5.T18.4.2.6" class="ltx_td ltx_align_center ltx_border_t">0.00</td>
<td id="A5.T18.4.2.7" class="ltx_td ltx_align_center ltx_border_t">0.00</td></tr>
<tr id="A5.T18.4.3" class="ltx_tr">
<th id="A5.T18.4.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb"><math id="A5.T18.m5" class="ltx_Math" alttext="\mathcal{M}_{1}^{\text{pqa\_fantasy}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>1</mn><mtext>pqa_fantasy</mtext></msubsup><annotation encoding="application/x-tex">\mathcal{M}_{1}^{\text{pqa\_fantasy}}</annotation></semantics></math></th>
<td id="A5.T18.4.3.2" class="ltx_td ltx_align_center ltx_border_bb">0.86</td>
