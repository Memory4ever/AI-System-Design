<figure id="S3.F2" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F2.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.13175v1/fig2.svg" id="S3.F2.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:476/356;" width="476" height="356"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S3.F2.sf1.4" class="ltx_text" style="font-size:90%;">Loss curve with different vision encoder</span></figcaption>
