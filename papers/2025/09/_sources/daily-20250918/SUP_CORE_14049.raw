</figure>
<figure id="S3.F6" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_1">
<div id="S3.F6.2" class="ltx_block ltx_figure_panel ltx_minipage ltx_align_center ltx_align_bottom" style="width:345.0pt;"><img src="2509.14049v1/template/Pred_time_headless_mobilenet_line.png" id="S3.F6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/199;" width="476" height="199" alt="Refer to caption">
