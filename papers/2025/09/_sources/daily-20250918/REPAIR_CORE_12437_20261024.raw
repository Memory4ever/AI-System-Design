ture}}(x,y)=\begin{cases}1&amp;\text{if }(x,y)\text{ is blue}\\
0&amp;\text{otherwise}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mtext> <svg style="vertical-align:-4.84px" height="13.76" overflow="visible" version="1.1" viewBox="0 0 38.63 13.76" width="38.63"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,13.76) matrix(1 0 0 -1 0 0)"> <g style="--ltx-fill-color:#B3FFFF;" fill="#B3FFFF" fill-opacity="1.0"> <path style="stroke:none" d="M 0 2.77 L 0 10.99 C 0 12.52 1.24 13.76 2.77 13.76 L 35.86 13.76 C 37.39 13.76 38.63 12.52 38.63 10.99 L 38.63 2.77 C 38.63 1.24 37.39 0 35.86 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z"></path> </g> <g style="--ltx-fill-color:#B3FFFF;" fill="#B3FFFF" fill-opacity="1.0"> <path style="stroke:none" d="M 0 2.77 L 0 10.99 C 0 12.52 1.24 13.76 2.77 13.76 L 35.86 13.76 C 37.39 13.76 38.63 12.52 38.63 10.99 L 38.63 2.77 C 38.63 1.24 37.39 0 35.86 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z"></path> </g> <g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 2.77 4.84)"> <foreignObject style="--ltx-fo-width:2.39em;--ltx-fo-height:0.44em;--ltx-fo-depth:0.15em;font-size:10pt;" height="8.23" overflow="visible" transform="matrix(1 0 0 -1 0 6.15)" width="33.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐦</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">surr</mtext></msub></span></span></foreignObject> </g> </g> </svg> </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mn>1</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext> is blue</mtext></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mn>0</mn></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\hbox to27.92pt{\vbox to9.94pt{\pgfpicture\makeatletter\hbox{\hskip 0.0pt\lower 0.0pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{{}{}{}{}\lx@inpgf@ignorespaces\lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#B3FFFF} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 10.99 C 0 12.52 1.24 13.76 2.77 13.76 L 35.86 13.76 C 37.39 13.76 38.63 12.52 38.63 10.99 L 38.63 2.77 C 38.63 1.24 37.39 0 35.86 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#B3FFFF} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 10.99 C 0 12.52 1.24 13.76 2.77 13.76 L 35.86 13.76 C 37.39 13.76 38.63 12.52 38.63 10.99 L 38.63 2.77 C 38.63 1.24 37.39 0 35.86 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{}}{{}}{{}}{{}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{2.0pt}{3.5pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 2.77 4.84)} \pgfsys@hbox{55}\lxSVG@closescope }\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}(x,y)=\begin{cases}1&amp;\text{if }(x,y)\text{ is blue}\\
0&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S3.SS2.SSS2.p1.3" class="ltx_p">As shown in Fig. <a href="#S3.F2" title="Fig. 2 ‣ III Methodology ‣ Enhancing Physical Consistency in Lightweight World Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, we devise two softening dimensions: ego-centric and global scene softening.
<span id="S3.SS2.SSS2.p1.3.1" class="ltx_text ltx_font_bold">Ego-centric Softening</span> uses a two-dimensional Gaussian distribution centered around the detected ego vehicle:</p>
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_math_unparsed" alttext="\hbox to23.53pt{\vbox to13.69pt{\pgfpicture\makeatletter\hbox{\hskip 0.0pt\lower 0.0pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{{}{}{}{}\lx@inpgf@ignorespaces\lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#FFB3B3} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 29.79 18.95 C 31.32 18.95 32.56 17.71 32.56 16.18 L 32.56 2.77 C 32.56 1.24 31.32 0 29.79 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#FFB3B3} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 29.79 18.95 C 31.32 18.95 32.56 17.71 32.56 16.18 L 32.56 2.77 C 32.56 1.24 31.32 0 29.79 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{}}{{}}{{}}{{}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{2.0pt}{4.8611pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 2.77 6.73)} \pgfsys@hbox{55}\lxSVG@closescope }\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}=\mathcal{N}\!\left(\begin{bmatrix}x\\
y\end{bmatrix}\;\middle|\;\begin{bmatrix}x_{\text{ego}}\\
y_{\text{ego}}\end{bmatrix},\begin{bmatrix}\sigma_{x}^{2}&amp;0\\
0&amp;\sigma_{y}^{2}\end{bmatrix}\right)" display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-6.73px" height="18.95" overflow="visible" version="1.1" viewBox="0 0 32.56 18.95" width="32.56"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,18.95) matrix(1 0 0 -1 0 0)"> <g style="--ltx-fill-color:#FFB3B3;" fill="#FFB3B3" fill-opacity="1.0"> <path style="stroke:none" d="M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 29.79 18.95 C 31.32 18.95 32.56 17.71 32.56 16.18 L 32.56 2.77 C 32.56 1.24 31.32 0 29.79 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z"></path> </g> <g style="--ltx-fill-color:#FFB3B3;" fill="#FFB3B3" fill-opacity="1.0"> <path style="stroke:none" d="M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 29.79 18.95 C 31.32 18.95 32.56 17.71 32.56 16.18 L 32.56 2.77 C 32.56 1.24 31.32 0 29.79 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z"></path> </g> <g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 2.77 6.73)"> <foreignObject style="--ltx-fo-width:1.95em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="27.02"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒩</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">ego</mtext></msub></span></span></foreignObject> </g> </g> </svg> </mtext><mo>=</mo><mpadded style="width:0.798em;" width="0.798em"><mi class="ltx_font_mathcaligraphic">𝒩</mi></mpadded><mrow><mo>(</mo><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><mi>x</mi></mtd></mtr><mtr><mtd><mi>y</mi></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" stretchy="true">|</mo><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msub><mi>x</mi><mtext>ego</mtext></msub></mtd></mtr><mtr><mtd><msub><mi>y</mi><mtext>ego</mtext></msub></mtd></mtr></mtable><mo>]</mo></mrow><mo>,</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msubsup><mi>σ</mi><mi>x</mi><mn>2</mn></msubsup></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mi>σ</mi><mi>y</mi><mn>2</mn></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\hbox to23.53pt{\vbox to13.69pt{\pgfpicture\makeatletter\hbox{\hskip 0.0pt\lower 0.0pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{{}{}{}{}\lx@inpgf@ignorespaces\lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#FFB3B3} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 29.79 18.95 C 31.32 18.95 32.56 17.71 32.56 16.18 L 32.56 2.77 C 32.56 1.24 31.32 0 29.79 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#FFB3B3} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 29.79 18.95 C 31.32 18.95 32.56 17.71 32.56 16.18 L 32.56 2.77 C 32.56 1.24 31.32 0 29.79 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{}}{{}}{{}}{{}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{2.0pt}{4.8611pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 2.77 6.73)} \pgfsys@hbox{55}\lxSVG@closescope }\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}=\mathcal{N}\!\left(\begin{bmatrix}x\\
y\end{bmatrix}\;\middle|\;\begin{bmatrix}x_{\text{ego}}\\
y_{\text{ego}}\end{bmatrix},\begin{bmatrix}\sigma_{x}^{2}&amp;0\\
0&amp;\sigma_{y}^{2}\end{bmatrix}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
<p id="S3.SS2.SSS2.p1.4" class="ltx_p">where <math id="S3.SS2.SSS2.p1.m9" class="ltx_Math" alttext="(x_{\text{ego}},y_{\text{ego}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mtext>ego</mtext></msub><mo>,</mo><msub><mi>y</mi><mtext>ego</mtext></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x_{\text{ego}},y_{\text{ego}})</annotation></semantics></math> denote the ego vehicle’s centroid, while <math id="S3.SS2.SSS2.p1.m10" class="ltx_Math" alttext="\sigma_{x}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>x</mi></msub><annotation encoding="application/x-tex">\sigma_{x}</annotation></semantics></math> and <math id="S3.SS2.SSS2.p1.m11" class="ltx_Math" alttext="\sigma_{y}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>y</mi></msub><annotation encoding="application/x-tex">\sigma_{y}</annotation></semantics></math> are tunable Gaussian parameters.
<span id="S3.SS2.SSS2.p1.4.1" class="ltx_text ltx_font_bold">Global Scene Softening</span> uses a global Gaussian distribution along the longitudinal direction of the BEV scene, centered at the ego vehicle’s <math id="S3.SS2.SSS2.p1.m12" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-coordinate:</p>
<table id="S3.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E6.m1" class="ltx_math_unparsed" alttext="\hbox to32.9pt{\vbox to13.69pt{\pgfpicture\makeatletter\hbox{\hskip 0.0pt\lower 0.0pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{{}{}{}{}\lx@inpgf@ignorespaces\lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#D9B3D9} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 42.76 18.95 C 44.29 18.95 45.53 17.71 45.53 16.18 L 45.53 2.77 C 45.53 1.24 44.29 0 42.76 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#D9B3D9} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 42.76 18.95 C 44.29 18.95 45.53 17.71 45.53 16.18 L 45.53 2.77 C 45.53 1.24 44.29 0 42.76 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{}}{{}}{{}}{{}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{2.0pt}{4.8611pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 2.77 6.73)} \pgfsys@hbox{55}\lxSVG@closescope }\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}=\mathcal{N}\!\left(x\;\middle|\;x_{\text{ego}},\,(\sigma_{\text{global}}\,W)^{2}\right)" display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-6.73px" height="18.95" overflow="visible" version="1.1" viewBox="0 0 45.53 18.95" width="45.53"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,18.95) matrix(1 0 0 -1 0 0)"> <g style="--ltx-fill-color:#D9B3D9;" fill="#D9B3D9" fill-opacity="1.0"> <path style="stroke:none" d="M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 42.76 18.95 C 44.29 18.95 45.53 17.71 45.53 16.18 L 45.53 2.77 C 45.53 1.24 44.29 0 42.76 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z"></path> </g> <g style="--ltx-fill-color:#D9B3D9;" fill="#D9B3D9" fill-opacity="1.0"> <path style="stroke:none" d="M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 42.76 18.95 C 44.29 18.95 45.53 17.71 45.53 16.18 L 45.53 2.77 C 45.53 1.24 44.29 0 42.76 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z"></path> </g> <g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 2.77 6.73)"> <foreignObject style="--ltx-fo-width:2.89em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.29em;font-size:10pt;" height="13.41" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="39.99"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒩</mi><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">global</mtext></msub></span></span></foreignObject> </g> </g> </svg> </mtext><mo>=</mo><mpadded style="width:0.798em;" width="0.798em"><mi class="ltx_font_mathcaligraphic">𝒩</mi></mpadded><mrow><mo>(</mo><mi>x</mi><mo stretchy="true">|</mo><msub><mi>x</mi><mtext>ego</mtext></msub><mo rspace="0.337em">,</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>σ</mi><mtext>global</mtext></msub><mi>W</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\hbox to32.9pt{\vbox to13.69pt{\pgfpicture\makeatletter\hbox{\hskip 0.0pt\lower 0.0pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{{}{}{}{}\lx@inpgf@ignorespaces\lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#D9B3D9} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 42.76 18.95 C 44.29 18.95 45.53 17.71 45.53 16.18 L 45.53 2.77 C 45.53 1.24 44.29 0 42.76 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#D9B3D9} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 16.18 C 0 17.71 1.24 18.95 2.77 18.95 L 42.76 18.95 C 44.29 18.95 45.53 17.71 45.53 16.18 L 45.53 2.77 C 45.53 1.24 44.29 0 42.76 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{}}{{}}{{}}{{}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{2.0pt}{4.8611pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 2.77 6.73)} \pgfsys@hbox{55}\lxSVG@closescope }\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}=\mathcal{N}\!\left(x\;\middle|\;x_{\text{ego}},\,(\sigma_{\text{global}}\,W)^{2}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
<p id="S3.SS2.SSS2.p1.5" class="ltx_p">where <math id="S3.SS2.SSS2.p1.m13" class="ltx_Math" alttext="\sigma_{\text{global}}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mtext>global</mtext></msub><annotation encoding="application/x-tex">\sigma_{\text{global}}</annotation></semantics></math> is a tunable parameter regulating the Gaussian’s width, and <math id="S3.SS2.SSS2.p1.m14" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> is the BEV image width.</p>
</div>
<div id="S3.SS2.SSS2.p2" class="ltx_para ltx_noindent">
<p id="S3.SS2.SSS2.p2.1" class="ltx_p"><span id="S3.SS2.SSS2.p2.1.1" class="ltx_text ltx_font_bold">Downsampling</span> process uses bicubic interpolation to downsample the softened mask to match the input resolution of the denoising model:
<math id="S3.SS2.SSS2.p2.m1" class="ltx_Math" alttext="\mathbf{m}_{\text{soft}}^{\text{down}}\;\leftarrow\;\text{bicubic}\!\left(\mathbf{m}_{\text{soft}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐦</mi><mtext>soft</mtext><mtext>down</mtext></msubsup><mo lspace="0.558em" rspace="0.558em" stretchy="false">←</mo><mrow><mpadded style="width:2.815em;" width="2.815em"><mtext>bicubic</mtext></mpadded><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>𝐦</mi><mtext>soft</mtext></msub><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbf{m}_{\text{soft}}^{\text{down}}\;\leftarrow\;\text{bicubic}\!\left(\mathbf{m}_{\text{soft}}\right).</annotation></semantics></math></p>
</div>
<figure id="S3.F4" class="ltx_figure"><img src="2509.12437v1/training_pipeline.png" id="S3.F4.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/431;" width="476" height="431" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F4.3" class="ltx_text" style="font-size:90%;">Fig. 4</span>: </span><span id="S3.F4.4" class="ltx_text" style="font-size:90%;">Training pipeline.</span></figcaption>
</figure>
</section>
<section id="S3.SS2.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection"><span id="S3.SS2.SSS3.6" class="ltx_text">III-B</span>3 </span>World Model Training</h4>

<div id="S3.SS2.SSS3.p1" class="ltx_para">
<p id="S3.SS2.SSS3.p1.1" class="ltx_p">World Models are generative models that learn to simulate how the environment evolves over time. Given a history of what the agent has seen (observations, actions), the model predicts future observations.
As illustrated in Fig. <a href="#S3.F4" title="Fig. 4 ‣ III-B2 Soft Mask ‣ III-B Training with Hard &amp; Soft Masks ‣ III Methodology ‣ Enhancing Physical Consistency in Lightweight World Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, we follow a similar EDM <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib38" title="" class="ltx_ref">38</a>]</cite> training setup as the baseline DIAMOND model <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">1</a>]</cite>. Our soft mask is integrated into the EDM architecture as part of the input for the diffusion model <math id="S3.SS2.SSS3.p1.m1" class="ltx_Math" alttext="\mathbf{D}_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>𝐃</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\mathbf{D}_{\theta}</annotation></semantics></math>, where <math id="S3.SS2.SSS3.p1.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> are the trainable parameters. During training, we sample a sequence of length <math id="S3.SS2.SSS3.p1.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> containing past action–observation pairs, where each pair consists of an action <math id="S3.SS2.SSS3.p1.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> and an observation <math id="S3.SS2.SSS3.p1.m5" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> (image). A sequence at timestamp <math id="S3.SS2.SSS3.p1.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is represented as <math id="S3.SS2.SSS3.p1.m7" class="ltx_Math" alttext="(\mathbf{x}_{t-L+1}^{0},a_{t-L+1},\dots,\mathbf{x}_{t}^{0},a_{t},\mathbf{x}_{t+1}^{0})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mn>0</mn></msubsup><mo>,</mo><msub><mi>a</mi><mrow><mrow><mi>t</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>𝐱</mi><mi>t</mi><mn>0</mn></msubsup><mo>,</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>𝐱</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mn>0</mn></msubsup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{x}_{t-L+1}^{0},a_{t-L+1},\dots,\mathbf{x}_{t}^{0},a_{t},\mathbf{x}_{t+1}^{0})</annotation></semantics></math>, drawn from the dataset <math id="S3.SS2.SSS3.p1.m8" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>. The denoising process is given as:</p>
<table id="S3.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E7.m1" class="ltx_math_unparsed" alttext="\hbox to23.2pt{\vbox to14.97pt{\pgfpicture\makeatletter\hbox{\hskip 0.0pt\lower 0.0pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{{}{}{}{}\lx@inpgf@ignorespaces\lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#FFD9B3} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 17.95 C 0 19.48 1.24 20.72 2.77 20.72 L 29.34 20.72 C 30.86 20.72 32.1 19.48 32.1 17.95 L 32.1 2.77 C 32.1 1.24 30.86 0 29.34 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#FFD9B3} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 17.95 C 0 19.48 1.24 20.72 2.77 20.72 L 29.34 20.72 C 30.86 20.72 32.1 19.48 32.1 17.95 L 32.1 2.77 C 32.1 1.24 30.86 0 29.34 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{}}{{}}{{}}{{}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{2.0pt}{4.33334pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 2.77 6)} \pgfsys@hbox{55}\lxSVG@closescope }\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}=\mathbf{D}_{\theta}(\mathbf{x}_{t+1}^{\tau},\tau,\mathbf{x}_{t-L+1:t}^{0},a_{t-L+1:t},\mathbf{m}_{\circ,t})" display="block" intent=":literal"><semantics><mrow><mtext> <svg style="vertical-align:-6px" height="20.72" overflow="visible" version="1.1" viewBox="0 0 32.1 20.72" width="32.1"> <g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,20.72) matrix(1 0 0 -1 0 0)"> <g style="--ltx-fill-color:#FFD9B3;" fill="#FFD9B3" fill-opacity="1.0"> <path style="stroke:none" d="M 0 2.77 L 0 17.95 C 0 19.48 1.24 20.72 2.77 20.72 L 29.34 20.72 C 30.86 20.72 32.1 19.48 32.1 17.95 L 32.1 2.77 C 32.1 1.24 30.86 0 29.34 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z"></path> </g> <g style="--ltx-fill-color:#FFD9B3;" fill="#FFD9B3" fill-opacity="1.0"> <path style="stroke:none" d="M 0 2.77 L 0 17.95 C 0 19.48 1.24 20.72 2.77 20.72 L 29.34 20.72 C 30.86 20.72 32.1 19.48 32.1 17.95 L 32.1 2.77 C 32.1 1.24 30.86 0 29.34 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z"></path> </g> <g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 2.77 6)"> <foreignObject style="--ltx-fo-width:1.92em;--ltx-fo-height:0.86em;--ltx-fo-depth:0.23em;font-size:10pt;" height="15.18" overflow="visible" transform="matrix(1 0 0 -1 0 11.96)" width="26.57"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝐱</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></msubsup></span></span></foreignObject> </g> </g> </svg> </mtext><mo>=</mo><msub><mi>𝐃</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐱</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mi>τ</mi></msubsup><mo>,</mo><mi>τ</mi><mo>,</mo><msubsup><mi>𝐱</mi><mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow><mn>0</mn></msubsup><mo>,</mo><msub><mi>a</mi><mrow><mrow><mrow><mi>t</mi><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>𝐦</mi><mrow><mo rspace="0em">∘</mo><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hbox to23.2pt{\vbox to14.97pt{\pgfpicture\makeatletter\hbox{\hskip 0.0pt\lower 0.0pt\hbox to0.0pt{\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=0.4pt} \lx@inpgf@ignorespaces\nullfont\hbox to0.0pt{{}{}{}{}\lx@inpgf@ignorespaces\lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#FFD9B3} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 17.95 C 0 19.48 1.24 20.72 2.77 20.72 L 29.34 20.72 C 30.86 20.72 32.1 19.48 32.1 17.95 L 32.1 2.77 C 32.1 1.24 30.86 0 29.34 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} {}{}{}{}{}{}{}{}\lxSVG@begingroup@{fill=#FFD9B3} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}{{}{}{{}}}{{}{}{{}}}{}{}\lxSVG@fill\lxSVG@drawpath@unclipped{M 0 2.77 L 0 17.95 C 0 19.48 1.24 20.72 2.77 20.72 L 29.34 20.72 C 30.86 20.72 32.1 19.48 32.1 17.95 L 32.1 2.77 C 32.1 1.24 30.86 0 29.34 0 L 2.77 0 C 1.24 0 0 1.24 0 2.77 Z}{stroke:none} \lx@inpgf@ignorespaces\lxSVG@closescope \lxSVG@begingroup@{_scopebegin=1} \lxSVG@fill@opacity{1.0}\lxSVG@begingroup@{fill-opacity=1.0} {{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{\lx@inpgf@ignorespaces}}{{}}{{}}{{}}{{}}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@transformcm{1.0}{0.0}{0.0}{1.0}{2.0pt}{4.33334pt}\lxSVG@begingroup@{transform=matrix(1.0 0.0 0.0 1.0 2.77 6)} \pgfsys@hbox{55}\lxSVG@closescope }\lxSVG@closescope {\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}{\lx@inpgf@ignorespaces}\hss}\lxSVG@discardpath\lxSVG@closescope \hss}}\lxSVG@closescope\endpgfpicture}}=\mathbf{D}_{\theta}(\mathbf{x}_{t+1}^{\tau},\tau,\mathbf{x}_{t-L+1:t}^{0},a_{t-L+1:t},\mathbf{m}_{\circ,t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="S3.SS2.SSS3.p1.2" class="ltx_p">where <math id="S3.SS2.SSS3.p1.m9" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is noise level, <math id="S3.SS2.SSS3.p1.m10" class="ltx_Math" alttext="\mathbf{m}_{\circ,t}" display="inline" intent=":literal"><semantics><msub><mi>𝐦</mi><mrow><mo rspace="0em">∘</mo><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{m}_{\circ,t}</annotation></semantics></math> can be either <math id="S3.SS2.SSS3.p1.m11" class="ltx_Math" alttext="\mathbf{m}_{\text{soft},t}" display="inline" intent=":literal"><semantics><msub><mi>𝐦</mi><mrow><mtext>soft</mtext><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{m}_{\text{soft},t}</annotation></semantics></math> or <math id="S3.SS2.SSS3.p1.m12" class="ltx_Math" alttext="\mathbf{m}_{\text{hard},t}" display="inline" intent=":literal"><semantics><msub><mi>𝐦</mi><mrow><mtext>hard</mtext><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{m}_{\text{hard},t}</annotation></semantics></math> (<math id="S3.SS2.SSS3.p1.m13" class="ltx_Math" alttext="\mathbf{m}_{\text{soft},t}" display="inline" intent=":literal"><semantics><msub><mi>𝐦</mi><mrow><mtext>soft</mtext><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{m}_{\text{soft},t}</annotation></semantics></math> means Soft Mask at timestep <math id="S3.SS2.SSS3.p1.m14" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>).
The diffusion model <math id="S3.SS2.SSS3.p1.m15" class="ltx_Math" alttext="\mathbf{D}_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>𝐃</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\mathbf{D}_{\theta}</annotation></semantics></math> is trained to denoise a corrupted version of <math id="S3.SS2.SSS3.p1.m16" class="ltx_Math" alttext="\mathbf{x}_{t+1}^{0}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐱</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mn>0</mn></msubsup><annotation encoding="application/x-tex">\mathbf{x}_{t+1}^{0}</annotation></semantics></math>, conditioned on the history of observations. To guide the model’s attention, we integrate our soft mask into the EDM architecture by concatenating it with the observations. The training loss is defined as:</p>
<table id="S3.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
