<meta property="og:title" content="The Future of Artificial Intelligence and the Mathematical and Physical Sciences (AI+MPS)" />
<meta property="og:url" content="https://arxiv.org/abs/2509.02661v3" />
<meta property="og:image" content="/static/browse/0.3.4/images/arxiv-logo-fb.png" />
