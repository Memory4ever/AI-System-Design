<td id="A3.T10.6.1.4" class="ltx_td ltx_align_center ltx_align_top ltx_border_tt" colspan="3">Forget (<math id="A3.T10.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</td>
<td id="A3.T10.6.1.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_tt">
<span id="A3.T10.6.1.5.1" class="ltx_inline-block ltx_align_top" style="width:28.5pt;">
<span id="A3.T10.6.1.5.1.1" class="ltx_p ltx_align_center">Ret.(<math id="A3.T10.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span>
</span></td>
<td id="A3.T10.6.1.6" class="ltx_td ltx_align_center ltx_align_top ltx_border_tt" colspan="3">Utility (<math id="A3.T10.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</td></tr>
<tr id="A3.T10.6.2" class="ltx_tr">
<td id="A3.T10.6.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
