<span id="A5.F21.pic1.p6.pic1.1.2" class="ltx_p ltx_align_center">
<span id="A5.F21.pic1.p6.pic1.1.2.1" class="ltx_inline-block ltx_parbox ltx_align_middle" style="width:407.9pt;--ltx-bg-color:#DCFFDC;">
