<td id="A1.SS1.p2.1.25.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m29" class="ltx_Math" alttext="\Pi_{\mathcal{U}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi class="ltx_font_mathcaligraphic">𝒰</mi></msub><annotation encoding="application/x-tex">\Pi_{\mathcal{U}}</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.25.2" class="ltx_td ltx_nopad_r ltx_align_left">User’s payoff</td></tr>
<tr id="A1.SS1.p2.1.26" class="ltx_tr">
<td id="A1.SS1.p2.1.26.1" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="A1.SS1.p2.1.26.1.1" class="ltx_text ltx_font_bold">Language Models</span></td></tr>
<tr id="A1.SS1.p2.1.27" class="ltx_tr">
<td id="A1.SS1.p2.1.27.1" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.SS1.m30" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.27.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">Input sequence (user query <math id="A1.SS1.m31" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>)</td></tr>
<tr id="A1.SS1.p2.1.28" class="ltx_tr">
<td id="A1.SS1.p2.1.28.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m32" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.28.2" class="ltx_td ltx_nopad_r ltx_align_left">Output sequence (model response <math id="A1.SS1.m33" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>)</td></tr>
<tr id="A1.SS1.p2.1.29" class="ltx_tr">
<td id="A1.SS1.p2.1.29.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m34" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.29.2" class="ltx_td ltx_nopad_r ltx_align_left">Reasoning sequence (CoT steps)</td></tr>
<tr id="A1.SS1.p2.1.30" class="ltx_tr">
<td id="A1.SS1.p2.1.30.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m35" class="ltx_Math" alttext="P(y\mid x)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(y\mid x)</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.30.2" class="ltx_td ltx_nopad_r ltx_align_left">Standard LM probability distribution</td></tr>
<tr id="A1.SS1.p2.1.31" class="ltx_tr">
<td id="A1.SS1.p2.1.31.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m36" class="ltx_Math" alttext="P(y,z\mid x)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>,</mo><mi>z</mi></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(y,z\mid x)</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.31.2" class="ltx_td ltx_nopad_r ltx_align_left">Chain-of-Thought (CoT) probability distribution</td></tr>
<tr id="A1.SS1.p2.1.32" class="ltx_tr">
<td id="A1.SS1.p2.1.32.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m37" class="ltx_Math" alttext="y_{k}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>k</mi></msub><annotation encoding="application/x-tex">y_{k}</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.32.2" class="ltx_td ltx_nopad_r ltx_align_left"><math id="A1.SS1.m38" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th token in output sequence <math id="A1.SS1.m39" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math></td></tr>
<tr id="A1.SS1.p2.1.33" class="ltx_tr">
<td id="A1.SS1.p2.1.33.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m40" class="ltx_math_unparsed" alttext="y_{1:k-1}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">y_{1:k-1}</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.33.2" class="ltx_td ltx_nopad_r ltx_align_left">Tokens <math id="A1.SS1.m41" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> to <math id="A1.SS1.m42" class="ltx_Math" alttext="k-1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k-1</annotation></semantics></math> in <math id="A1.SS1.m43" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math></td></tr>
<tr id="A1.SS1.p2.1.34" class="ltx_tr">
<td id="A1.SS1.p2.1.34.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m44" class="ltx_Math" alttext="z_{i}" display="inline" intent=":literal"><semantics><msub><mi>z</mi><mi>i</mi></msub><annotation encoding="application/x-tex">z_{i}</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.34.2" class="ltx_td ltx_nopad_r ltx_align_left"><math id="A1.SS1.m45" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th token in reasoning sequence <math id="A1.SS1.m46" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math></td></tr>
