<td id="S6.T4.4.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T4.4.1.3.6.1" class="ltx_text ltx_underline">79.40</span></td>
<td id="S6.T4.4.1.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T4.4.1.3.7.1" class="ltx_text ltx_font_bold">79.94</span></td>
<td id="S6.T4.4.1.3.8" class="ltx_td ltx_align_center ltx_border_t">79.36</td>
<td id="S6.T4.4.1.3.9" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">79.33</td></tr>
<tr id="S6.T4.4.1.4" class="ltx_tr">
<td id="S6.T4.4.1.4.1" class="ltx_td ltx_align_center ltx_border_r">ARC-c</td>
<td id="S6.T4.4.1.4.2" class="ltx_td ltx_align_center">92.88</td>
<td id="S6.T4.4.1.4.3" class="ltx_td ltx_align_center"><span id="S6.T4.4.1.4.3.1" class="ltx_text ltx_font_bold">93.90</span></td>
<td id="S6.T4.4.1.4.4" class="ltx_td ltx_align_center ltx_border_r">93.56</td>
<td id="S6.T4.4.1.4.5" class="ltx_td ltx_align_center"><span id="S6.T4.4.1.4.5.1" class="ltx_text ltx_font_bold">95.93</span></td>
<td id="S6.T4.4.1.4.6" class="ltx_td ltx_align_center"><span id="S6.T4.4.1.4.6.1" class="ltx_text ltx_underline">94.24</span></td>
<td id="S6.T4.4.1.4.7" class="ltx_td ltx_align_center">91.19</td>
<td id="S6.T4.4.1.4.8" class="ltx_td ltx_nopad_r ltx_align_center">93.56</td></tr>
