<td id="A1.SS1.p2.1.6.2" class="ltx_td ltx_nopad_r ltx_align_left">User type, <math id="A1.SS1.m6" class="ltx_Math" alttext="\theta\in\{\text{benign},\text{sensitive},\text{malicious}\}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mtext>benign</mtext><mo>,</mo><mtext>sensitive</mtext><mo>,</mo><mtext>malicious</mtext></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\theta\in\{\text{benign},\text{sensitive},\text{malicious}\}</annotation></semantics></math></td></tr>
