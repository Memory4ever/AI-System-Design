<td id="A1.SS1.p2.1.7.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m7" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math></td>
