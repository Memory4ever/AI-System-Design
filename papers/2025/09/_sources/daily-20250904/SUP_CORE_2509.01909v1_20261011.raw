<td id="S6.T1.4.1.6.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.4.1.6.3.1" class="ltx_text ltx_font_bold">84.33</span></td>
<td id="S6.T1.4.1.6.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.T1.4.1.6.4.1" class="ltx_text ltx_font_bold">84.20</span></td>
<td id="S6.T1.4.1.6.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.4.1.6.5.1" class="ltx_text ltx_font_bold">82.16</span></td>
<td id="S6.T1.4.1.6.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.4.1.6.6.1" class="ltx_text ltx_font_bold">81.81</span></td>
<td id="S6.T1.4.1.6.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.4.1.6.7.1" class="ltx_text ltx_font_bold">80.72</span></td>
<td id="S6.T1.4.1.6.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><span id="S6.T1.4.1.6.8.1" class="ltx_text ltx_font_bold">79.11</span></td></tr>
<tr id="S6.T1.4.1.7" class="ltx_tr">
