<td id="S6.T4.4.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T4.4.1.2.5.1" class="ltx_text ltx_font_bold">Oy1-SFT</span></td>
<td id="S6.T4.4.1.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T4.4.1.2.6.1" class="ltx_text ltx_font_bold">Oy1-ORPO</span></td>
<td id="S6.T4.4.1.2.7" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><span id="S6.T4.4.1.2.7.1" class="ltx_text ltx_font_bold">RealSafe</span></td></tr>
<tr id="S6.T4.4.1.3" class="ltx_tr">
<td id="S6.T4.4.1.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" rowspan="5"><span id="S6.T4.4.1.3.1.1" class="ltx_text">Knowledge</span></td>
<td id="S6.T4.4.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">C-Eval</td>
<td id="S6.T4.4.1.3.3" class="ltx_td ltx_align_center ltx_border_t">77.11</td>
<td id="S6.T4.4.1.3.4" class="ltx_td ltx_align_center ltx_border_t">84.63</td>
