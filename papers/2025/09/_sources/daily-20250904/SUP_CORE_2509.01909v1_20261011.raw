<td id="S6.T4.4.1.23.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S6.T4.4.1.23.2.1" class="ltx_text ltx_font_bold">82.75</span></td>
<td id="S6.T4.4.1.23.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S6.T4.4.1.23.3.1" class="ltx_text ltx_font_bold">84.33</span></td>
