<td id="A1.SS1.p2.1.35.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m47" class="ltx_math_unparsed" alttext="z_{1:i-1}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><msub><mrow></mrow><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></mrow></msub></mrow><annotation encoding="application/x-tex">z_{1:i-1}</annotation></semantics></math></td>
