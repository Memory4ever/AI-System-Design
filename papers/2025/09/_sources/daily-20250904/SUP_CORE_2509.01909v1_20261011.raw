<td id="A1.SS1.p2.1.10.1" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="A1.SS1.p2.1.10.1.1" class="ltx_text ltx_font_bold">Risk Dimensions</span></td></tr>
<tr id="A1.SS1.p2.1.11" class="ltx_tr">
<td id="A1.SS1.p2.1.11.1" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.SS1.m11" class="ltx_Math" alttext="C(q)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(q)</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.11.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">Risk category of query <math id="A1.SS1.m12" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> (68 categories)</td></tr>
<tr id="A1.SS1.p2.1.12" class="ltx_tr">
<td id="A1.SS1.p2.1.12.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m13" class="ltx_Math" alttext="L(q)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(q)</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.12.2" class="ltx_td ltx_nopad_r ltx_align_left">Risk level of query <math id="A1.SS1.m14" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math></td></tr>
<tr id="A1.SS1.p2.1.13" class="ltx_tr">
<td id="A1.SS1.p2.1.13.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m15" class="ltx_Math" alttext="I(q)" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I(q)</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.13.2" class="ltx_td ltx_nopad_r ltx_align_left">Risk intent of query <math id="A1.SS1.m16" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math></td></tr>
<tr id="A1.SS1.p2.1.14" class="ltx_tr">
<td id="A1.SS1.p2.1.14.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m17" class="ltx_Math" alttext="\mathcal{R}_{0}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\mathcal{R}_{0}</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.14.2" class="ltx_td ltx_nopad_r ltx_align_left">No risk (safe content)</td></tr>
<tr id="A1.SS1.p2.1.15" class="ltx_tr">
<td id="A1.SS1.p2.1.15.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m18" class="ltx_Math" alttext="\mathcal{R}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathcal{R}_{1}</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.15.2" class="ltx_td ltx_nopad_r ltx_align_left">Compliance risk (legal/ethical sensitivity)</td></tr>
<tr id="A1.SS1.p2.1.16" class="ltx_tr">
<td id="A1.SS1.p2.1.16.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m19" class="ltx_Math" alttext="\mathcal{R}_{2}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathcal{R}_{2}</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.16.2" class="ltx_td ltx_nopad_r ltx_align_left">Jailbreaking risk (intentional bypass)</td></tr>
<tr id="A1.SS1.p2.1.17" class="ltx_tr">
<td id="A1.SS1.p2.1.17.1" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="A1.SS1.p2.1.17.1.1" class="ltx_text ltx_font_bold">Safety Guideline</span></td></tr>
<tr id="A1.SS1.p2.1.18" class="ltx_tr">
<td id="A1.SS1.p2.1.18.1" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.SS1.m20" class="ltx_Math" alttext="G(q)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(q)</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.18.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">Safety guideline for query <math id="A1.SS1.m21" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math></td></tr>
<tr id="A1.SS1.p2.1.19" class="ltx_tr">
<td id="A1.SS1.p2.1.19.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m22" class="ltx_Math" alttext="f(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(\cdot)</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.19.2" class="ltx_td ltx_nopad_r ltx_align_left">Guideline mapping function: <math id="A1.SS1.m23" class="ltx_Math" alttext="G(q)=f(C(q),L(q),I(q))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G(q)=f(C(q),L(q),I(q))</annotation></semantics></math></td></tr>
<tr id="A1.SS1.p2.1.20" class="ltx_tr">
<td id="A1.SS1.p2.1.20.1" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="A1.SS1.p2.1.20.1.1" class="ltx_text ltx_font_bold">Evaluator Mechanisms</span></td></tr>
<tr id="A1.SS1.p2.1.21" class="ltx_tr">
<td id="A1.SS1.p2.1.21.1" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.SS1.m24" class="ltx_Math" alttext="E_{u}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>u</mi></msub><annotation encoding="application/x-tex">E_{u}</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.21.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">User judger: <math id="A1.SS1.m25" class="ltx_Math" alttext="E_{u}(q,r)\to[0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mi>u</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">E_{u}(q,r)\to[0,1]</annotation></semantics></math> (user satisfaction score)</td></tr>
<tr id="A1.SS1.p2.1.22" class="ltx_tr">
<td id="A1.SS1.p2.1.22.1" class="ltx_td ltx_align_center"><math id="A1.SS1.m26" class="ltx_Math" alttext="E_{s}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>s</mi></msub><annotation encoding="application/x-tex">E_{s}</annotation></semantics></math></td>
<td id="A1.SS1.p2.1.22.2" class="ltx_td ltx_nopad_r ltx_align_left">Safety judger: <math id="A1.SS1.m27" class="ltx_Math" alttext="E_{s}(q,r,g)\to\{\text{Safe},\text{Unsafe}\}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>g</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">{</mo><mtext>Safe</mtext><mo>,</mo><mtext>Unsafe</mtext><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">E_{s}(q,r,g)\to\{\text{Safe},\text{Unsafe}\}</annotation></semantics></math></td></tr>
<tr id="A1.SS1.p2.1.23" class="ltx_tr">
<td id="A1.SS1.p2.1.23.1" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="A1.SS1.p2.1.23.1.1" class="ltx_text ltx_font_bold">Game Theory</span></td></tr>
<tr id="A1.SS1.p2.1.24" class="ltx_tr">
<td id="A1.SS1.p2.1.24.1" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.SS1.m28" class="ltx_Math" alttext="\Pi_{\mathcal{M}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><annotation encoding="application/x-tex">\Pi_{\mathcal{M}}</annotation></semantics></math></td>
