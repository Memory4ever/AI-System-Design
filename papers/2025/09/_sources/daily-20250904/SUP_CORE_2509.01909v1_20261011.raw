<td id="A1.SS1.p2.1.5.2" class="ltx_td ltx_nopad_r ltx_align_left">A user query, <math id="A1.SS1.m4" class="ltx_Math" alttext="q\in\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">q\in\mathcal{Q}</annotation></semantics></math></td></tr>
