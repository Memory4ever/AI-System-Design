<td id="S6.T6.2.1.1.6" class="ltx_td ltx_align_center ltx_border_tt"><math id="S6.T6.m2" class="ltx_Math" alttext="R_{2}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mn>2</mn></msub><annotation encoding="application/x-tex">R_{2}</annotation></semantics></math></td>
