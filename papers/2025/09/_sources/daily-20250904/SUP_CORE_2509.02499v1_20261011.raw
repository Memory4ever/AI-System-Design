<tr id="S4.T3.2.1.3" class="ltx_tr">
<td id="S4.T3.2.1.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1.75pt;padding-bottom:1.75pt;" rowspan="2"><span id="S4.T3.2.1.3.1.1" class="ltx_text">Classification</span></td>
<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1.75pt;padding-bottom:1.75pt;">MoSEs-lr</td>
