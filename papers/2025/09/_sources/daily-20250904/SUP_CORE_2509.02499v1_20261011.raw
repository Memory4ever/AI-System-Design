<td id="S4.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.75pt;padding-bottom:1.75pt;">0.9203</td></tr>
<tr id="S4.T3.2.1.4" class="ltx_tr">
<td id="S4.T3.2.1.4.1" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1.75pt;padding-bottom:1.75pt;">MoSEs-xg</td>
