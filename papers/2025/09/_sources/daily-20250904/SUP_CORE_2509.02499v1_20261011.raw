<td id="S4.T3.2.1.4.3" class="ltx_td ltx_align_center" style="padding-top:1.75pt;padding-bottom:1.75pt;">0.9344</td></tr>
<tr id="S4.T3.2.1.5" class="ltx_tr">
<td id="S4.T3.2.1.5.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_t" style="padding-top:1.75pt;padding-bottom:1.75pt;" rowspan="2"><span id="S4.T3.2.1.5.1.1" class="ltx_text"><math id="S4.T3.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>-nearest prototypes</span></td>
<td id="S4.T3.2.1.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1.75pt;padding-bottom:1.75pt;">MoSEs-lr</td>
<td id="S4.T3.2.1.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.75pt;padding-bottom:1.75pt;">0.9350</td>
