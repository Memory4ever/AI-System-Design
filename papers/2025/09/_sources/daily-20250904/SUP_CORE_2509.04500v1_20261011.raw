<div id="A5.p8" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A5.p8.pic1" class="ltx_picture" height="726.95" overflow="visible" version="1.1" viewBox="0 0 653.15 726.95" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,726.95) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#FF8C00;" fill="#FF8C00" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 721.04 C 0 724.3 2.64 726.95 5.91 726.95 L 647.24 726.95 C 650.51 726.95 653.15 724.3 653.15 721.04 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 702.83 L 651.18 702.83 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 711.43)"><foreignObject style="--ltx-fo-width:38.32em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="530.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
