<td id="S4.T3.2.1.5.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r">Cleanliness</td>
<td id="S4.T3.2.1.5.2" class="ltx_td ltx_align_center ltx_border_bb">88.8</td>
<td id="S4.T3.2.1.5.3" class="ltx_td ltx_align_center ltx_border_bb">86.0</td>
<td id="S4.T3.2.1.5.4" class="ltx_td ltx_align_center ltx_border_bb">55.3</td>
<td id="S4.T3.2.1.5.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">70.0</td>
<td id="S4.T3.2.1.5.6" class="ltx_td ltx_align_center ltx_border_bb">88.2</td>
<td id="S4.T3.2.1.5.7" class="ltx_td ltx_align_center ltx_border_bb">84.7</td>
<td id="S4.T3.2.1.5.8" class="ltx_td ltx_align_center ltx_border_bb">75.5</td>
<td id="S4.T3.2.1.5.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">76.4</td>
