<div id="A2.T6.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:78pt;vertical-align:-37.7pt;"><span class="ltx_transformed_inner" style="transform:translate(-154.1pt,34.8pt) scale(0.528206206078103,0.528206206078103) ;">
