              <span id="alg1.l26.1" class="ltx_text" style="font-size:90%;">  Combine </span><math id="alg1.l26.m1" class="ltx_Math" alttext="R_{Judge}(\tau),R_{code}(\tau),R_{conf}(\tau)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathsize="0.900em">R</mi><mrow><mi mathsize="0.900em">J</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">τ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mrow><msub><mi mathsize="0.900em">R</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">τ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mrow><msub><mi mathsize="0.900em">R</mi><mrow><mi mathsize="0.900em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">f</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">τ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R_{Judge}(\tau),R_{code}(\tau),R_{conf}(\tau)</annotation></semantics></math><span id="alg1.l26.2" class="ltx_text" style="font-size:90%;"> to compute terminal reward </span><math id="alg1.l26.m2" class="ltx_Math" alttext="R(\tau)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">R</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">τ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">R(\tau)</annotation></semantics></math><span id="alg1.l26.3" class="ltx_text" style="font-size:90%;">
</span>
</div>
