<span id="S4.T2.3.1.1.1.4.3" class="ltx_td ltx_align_center"><math id="S4.T2.m30" class="ltx_Math" alttext="7.2\pm 1.0" display="inline" intent=":literal"><semantics><mrow><mn>7.2</mn><mo>±</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">7.2\pm 1.0</annotation></semantics></math> (<math id="S4.T2.m31" class="ltx_Math" alttext="0.84\pm 0.03" display="inline" intent=":literal"><semantics><mrow><mn>0.84</mn><mo>±</mo><mn>0.03</mn></mrow><annotation encoding="application/x-tex">0.84\pm 0.03</annotation></semantics></math>)</span>
