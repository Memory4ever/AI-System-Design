<span id="S4.T2.3.1.1.1.4.6" class="ltx_td ltx_align_center"><math id="S4.T2.m36" class="ltx_Math" alttext="0.65\pm 0.07" display="inline" intent=":literal"><semantics><mrow><mn>0.65</mn><mo>±</mo><mn>0.07</mn></mrow><annotation encoding="application/x-tex">0.65\pm 0.07</annotation></semantics></math> (<math id="S4.T2.m37" class="ltx_Math" alttext="0.33\pm 0.07" display="inline" intent=":literal"><semantics><mrow><mn>0.33</mn><mo>±</mo><mn>0.07</mn></mrow><annotation encoding="application/x-tex">0.33\pm 0.07</annotation></semantics></math>)</span></span>
