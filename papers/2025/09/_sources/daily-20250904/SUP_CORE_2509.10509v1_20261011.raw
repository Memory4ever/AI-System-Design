                 <math id="alg1.l9.m1" class="ltx_Math" alttext="S_{train}\leftarrow S_{gen}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">←</mo><msub><mi>S</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">S_{train}\leftarrow S_{gen}</annotation></semantics></math>

</div>
