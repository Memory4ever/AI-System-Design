                <math id="alg1.l11.m1" class="ltx_Math" alttext="M_{t+1}\leftarrow\text{FineTune}(M_{t},S_{train})" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mrow><mtext>FineTune</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>t</mi></msub><mo>,</mo><msub><mi>S</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">M_{t+1}\leftarrow\text{FineTune}(M_{t},S_{train})</annotation></semantics></math>

