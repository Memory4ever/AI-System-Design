<section id="Ax1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix">Appendix A: Our Three Algorithms</h2>

<div id="Ax1.p1" class="ltx_para">
<p id="Ax1.p1.1" class="ltx_p">In this section, we present pseudocode of our designed algorithms:</p>
</div>
<div id="Ax1.p2" class="ltx_para">
<ul id="Ax1.I3" class="ltx_itemize">
<li id="Ax1.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ax1.I3.i1.p1" class="ltx_para">
<p id="Ax1.I3.i1.p1.1" class="ltx_p">Algorithms <a href="#alg2" title="Algorithm 1 ‣ Appendix A: Our Three Algorithms ‣ Binary Quantization For LLMs Through Dynamic Grouping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>: Dynamic Grouping.</p>
</div></li>
<li id="Ax1.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="Ax1.I3.i2.p1" class="ltx_para">
<p id="Ax1.I3.i2.p1.1" class="ltx_p">Algorithms <a href="#alg1" title="Algorithm 2 ‣ Appendix A: Our Three Algorithms ‣ Binary Quantization For LLMs Through Dynamic Grouping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>: Greedy Grouping.</p>
</div></li>
</ul>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.2" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Greedy Grouping</figcaption>
<div id="alg1.3" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            
          <span id="alg1.l1.1" class="ltx_text ltx_font_bold">procedure</span> <span id="alg1.l1.2" class="ltx_text ltx_font_smallcaps">Greedy merging</span>(<math id="alg1.l1.m1" class="ltx_Math" alttext="\boldsymbol{A}\in\mathbb{R}^{m\times n}" display="inline" intent=":literal"><semantics><mrow><mi>𝑨</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{A}\in\mathbb{R}^{m\times n}</annotation></semantics></math>, <math id="alg1.l1.m2" class="ltx_Math" alttext="g\text{ (group size})" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mtext> (group size</mtext></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">g\text{ (group size})</annotation></semantics></math>)

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            sort absolute value of non-zero entry into an array

</div>
<div id="alg1.l3" class="ltx_listingline">
            
            initial the merge cost array <math id="alg1.l3.m1" class="ltx_math_unparsed" alttext="[(i\text{ (group start}),i+1\text{( group end}),cost,\mu)]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mtext> (group start</mtext><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>i</mi><mo>+</mo><mn>1</mn><mtext>( group end</mtext><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>c</mi><mi>o</mi><mi>s</mi><mi>t</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[(i\text{ (group start}),i+1\text{( group end}),cost,\mu)]</annotation></semantics></math> for <math id="alg1.l3.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> in range(<math id="alg1.l3.m3" class="ltx_Math" alttext="mn" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">mn</annotation></semantics></math> - 1)

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
            initially the ignore array

</div>
<div id="alg1.l5" class="ltx_listingline">
            
            heapify the merge cost array

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            <span id="alg1.l6.1" class="ltx_text ltx_font_bold">while</span> len(merge cost array) <math id="alg1.l6.m1" class="ltx_Math" alttext="&gt;" display="inline" intent=":literal"><semantics><mo>&gt;</mo><annotation encoding="application/x-tex">&gt;</annotation></semantics></math> g <span id="alg1.l6.2" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l7" class="ltx_listingline">
            
             currentMerge <math id="alg1.l7.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> heapop

</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
             <span id="alg1.l8.1" class="ltx_text ltx_font_bold">if</span> currentMerge in ignore array <span id="alg1.l8.2" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l9" class="ltx_listingline">
            
               remove currentMerge from ignore array

</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
               continue

</div>
<div id="alg1.l11" class="ltx_listingline">
            
             <span id="alg1.l11.1" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l11.2" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
             push two new merges as updates

</div>
<div id="alg1.l13" class="ltx_listingline">
            
             update ignore array by two merged, invalidated by the two new merges

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14:</span>
            
            <span id="alg1.l14.1" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l14.2" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
            
            <span id="alg1.l15.1" class="ltx_text ltx_font_bold">return</span> merge cost array

</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">16:</span>
            
          <span id="alg1.l16.1" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l16.2" class="ltx_text ltx_font_bold">procedure</span>
</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.2" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Dynamic Grouping</figcaption>
<div id="alg2.3" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">1:</span>
            
          <span id="alg2.l1.1" class="ltx_text ltx_font_bold">procedure</span> <span id="alg2.l1.2" class="ltx_text ltx_font_smallcaps">Sort</span>(<math id="alg2.l1.m1" class="ltx_Math" alttext="\boldsymbol{A}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">\boldsymbol{A}</annotation></semantics></math>)

</div>
<div id="alg2.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">2:</span>
            
            sort the absolute value of input matrix <math id="alg2.l2.m1" class="ltx_Math" alttext="\boldsymbol{A}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">\boldsymbol{A}</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">3:</span>
            
            <span id="alg2.l3.1" class="ltx_text ltx_font_bold">return</span> Sorted array of value and index in <math id="alg2.l3.m1" class="ltx_Math" alttext="\boldsymbol{A}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">\boldsymbol{A}</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">4:</span>
            
          <span id="alg2.l4.1" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l4.2" class="ltx_text ltx_font_bold">procedure</span>
</div>
<div id="alg2.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5:</span>
            
          <span id="alg2.l5.1" class="ltx_text ltx_font_bold">procedure</span> <span id="alg2.l5.2" class="ltx_text ltx_font_smallcaps">Prefix sum</span>(Array)

</div>
<div id="alg2.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">6:</span>
            
            prefix_sum, squared_prefix_sum <math id="alg2.l6.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> empty array

</div>
<div id="alg2.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">7:</span>
            
            <span id="alg2.l7.1" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l7.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> in Array <span id="alg2.l7.2" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">8:</span>
            
             prefix_sum <math id="alg2.l8.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> [prefix_sum, <math id="alg2.l8.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>]

</div>
<div id="alg2.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
             squared_prefix_sum <math id="alg2.l9.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> [squared_prefix_sum, <math id="alg2.l9.m2" class="ltx_Math" alttext="i^{2}" display="inline" intent=":literal"><semantics><msup><mi>i</mi><mn>2</mn></msup><annotation encoding="application/x-tex">i^{2}</annotation></semantics></math>]

</div>
<div id="alg2.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            <span id="alg2.l10.1" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l10.2" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            <span id="alg2.l11.1" class="ltx_text ltx_font_bold">return</span> prefix_sum, squared_prefix_sum

</div>
<div id="alg2.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
          <span id="alg2.l12.1" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l12.2" class="ltx_text ltx_font_bold">procedure</span>
</div>
<div id="alg2.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">13:</span>
            
