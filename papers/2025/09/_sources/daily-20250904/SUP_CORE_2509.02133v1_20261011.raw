<td id="Ax1.T11.3.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.072</td>
<td id="Ax1.T11.3.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.081</td></tr>
