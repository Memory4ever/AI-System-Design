<th id="S3.T5.3.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S3.T5.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:50%;">Category</span></th>
<th id="S3.T5.3.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S3.T5.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:50%;">Model</span></th>
<th id="S3.T5.3.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S3.T5.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:50%;">Reference / Citation</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T5.3.2" class="ltx_tr">
