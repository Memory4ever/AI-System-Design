<span id="lstnumberx1.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.18" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">content</span><span id="lstnumberx1.20" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.21" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">:</span><span id="lstnumberx1.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.23" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">Why</span><span id="lstnumberx1.25" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">is</span><span id="lstnumberx1.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">Article</span><span id="lstnumberx1.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.30" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">1</span><span id="lstnumberx1.31" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">6</span><span id="lstnumberx1.32" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">important</span><span id="lstnumberx1.34" class="ltx_text ltx_font_typewriter" style="font-size:90%;">?</span><span id="lstnumberx1.35" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.36" class="ltx_text ltx_font_typewriter" style="font-size:90%;">}</span><span id="lstnumberx1.37" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx1.38" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.39" class="ltx_text ltx_font_typewriter" style="font-size:90%;">{</span><span id="lstnumberx1.40" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">role</span><span id="lstnumberx1.42" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.43" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">:</span><span id="lstnumberx1.44" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.45" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.46" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">assistant</span><span id="lstnumberx1.47" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.48" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">,</span><span id="lstnumberx1.49" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.50" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.51" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">content</span><span id="lstnumberx1.52" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.53" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">:</span><span id="lstnumberx1.54" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.55" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">"</span><span id="lstnumberx1.56" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">Article</span><span id="lstnumberx1.57" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.58" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">1</span><span id="lstnumberx1.59" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">6</span><span id="lstnumberx1.60" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.61" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">guarantees</span><span id="lstnumberx1.62" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.63" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">equality</span><span id="lstnumberx1.64" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.65" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">of</span><span id="lstnumberx1.66" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span