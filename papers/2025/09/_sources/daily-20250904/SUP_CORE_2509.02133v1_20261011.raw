<td id="S3.T5.3.5.2" class="ltx_td ltx_align_left"><cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib26" title="" class="ltx_ref">Jiang et al. (2023)</a></cite></td></tr>
<tr id="S3.T5.3.6" class="ltx_tr">
<td id="S3.T5.3.6.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="4"><span id="S3.T5.3.6.1.1" class="ltx_text ltx_font_bold" style="font-size:50%;">Lightweight</span></td>
<td id="S3.T5.3.6.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T5.3.6.2.1" class="ltx_text" style="font-size:50%;">GPT-2</span></td>
<td id="S3.T5.3.6.3" class="ltx_td ltx_align_left ltx_border_t"><cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib50" title="" class="ltx_ref">Radford et al. (2019)</a></cite></td></tr>
<tr id="S3.T5.3.7" class="ltx_tr">
<td id="S3.T5.3.7.1" class="ltx_td ltx_align_left"><span id="S3.T5.3.7.1.1" class="ltx_text" style="font-size:50%;">GPT-2 Large</span></td>
<td id="S3.T5.3.7.2" class="ltx_td ltx_align_left"><cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib50" title="" class="ltx_ref">Radford et al. (2019)</a></cite></td></tr>
<tr id="S3.T5.3.8" class="ltx_tr">
