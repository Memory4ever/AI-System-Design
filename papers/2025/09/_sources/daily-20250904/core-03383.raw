<td id="S4.T1.2.1.5.1" class="ltx_td ltx_align_left ltx_border_r">RLBench<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib30" title="" class="ltx_ref">30</a>]</cite></td>
<td id="S4.T1.2.1.5.2" class="ltx_td ltx_align_center ltx_border_r">Manipulation</td>
<td id="S4.T1.2.1.5.3" class="ltx_td ltx_align_center">No</td></tr>
