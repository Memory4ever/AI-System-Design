<td id="S5.T2.4.11.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">Take coffee</td>
<td id="S5.T2.4.11.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">0.5</td>
<td id="S5.T2.4.11.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">1.57</td>
<td id="S5.T2.4.11.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">0.27</td>
<td id="S5.T2.4.11.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">1.0</td>
<td id="S5.T2.4.11.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">0.3</td>
