<td id="S5.T2.4.9.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">0.01</td>
<td id="S5.T2.4.9.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">1.0</td></tr>
<tr id="S5.T2.4.10" class="ltx_tr">
<td id="S5.T2.4.10.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">Pour wine to cup</td>
<td id="S5.T2.4.10.2" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">0.3</td>
<td id="S5.T2.4.10.3" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">6.6</td>
<td id="S5.T2.4.10.4" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">0.13</td>
<td id="S5.T2.4.10.5" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">0.25</td>
