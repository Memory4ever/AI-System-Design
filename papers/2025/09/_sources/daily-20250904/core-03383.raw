<td id="S4.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_border_r">Habitat<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib62" title="" class="ltx_ref">62</a>]</cite></td>
<td id="S4.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_r">PointNav, ObjectNav</td>
