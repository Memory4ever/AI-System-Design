<tr id="S4.T1.2.1.4" class="ltx_tr">
<td id="S4.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_border_r">Calvin<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib48" title="" class="ltx_ref">48</a>]</cite></td>
<td id="S4.T1.2.1.4.2" class="ltx_td ltx_align_center ltx_border_r">Manipulation</td>
<td id="S4.T1.2.1.4.3" class="ltx_td ltx_align_center">No</td></tr>
