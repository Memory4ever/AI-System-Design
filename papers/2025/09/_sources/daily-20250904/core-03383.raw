<td id="S4.T1.2.1.6.1" class="ltx_td ltx_align_left ltx_border_r">Libero<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib40" title="" class="ltx_ref">40</a>]</cite></td>
<td id="S4.T1.2.1.6.2" class="ltx_td ltx_align_center ltx_border_r">Manipulation</td>
<td id="S4.T1.2.1.6.3" class="ltx_td ltx_align_center">No</td></tr>
