          <span id="lstnumberx21.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">    </span><span id="lstnumberx21.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">pruned</span><span id="lstnumberx21.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx21.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">=</span><span id="lstnumberx21.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx21.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">rl_prune</span><span id="lstnumberx21.8" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span><span id="lstnumberx21.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">interference</span><span id="lstnumberx21.10" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx21.11" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx21.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">ewc_weights</span><span id="lstnumberx21.13" class="ltx_text ltx_font_typewriter" style="font-size:80%;">)</span>
</div>
<div id="lstnumberx22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">5</span>
            
            
            
          <span id="lstnumberx22.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">    </span><span id="lstnumberx22.3" class="ltx_text ltx_lst_comment ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#808080;">#<span id="lstnumberx22.3.1" class="ltx_text ltx_lst_space"> </span>0%<span id="lstnumberx22.3.2" class="ltx_text ltx_lst_space"> </span>forgetting,<span id="lstnumberx22.3.3" class="ltx_text ltx_lst_space"> </span>1%<span id="lstnumberx22.3.4" class="ltx_text ltx_lst_space"> </span>growth</span>
</div>
