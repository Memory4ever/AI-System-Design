<td id="A1.T6.5.5.3" class="ltx_td ltx_align_left"><span id="A1.T6.5.5.3.1" class="ltx_text" style="font-size:90%;">+38.1</span></td></tr>
<tr id="A1.T6.5.6" class="ltx_tr">
