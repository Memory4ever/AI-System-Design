<span id="S2.T1.6.1.5.3.1.1" class="ltx_p"><span id="S2.T1.6.1.5.3.1.1.1" class="ltx_text" style="font-size:90%;">Encodes multiple alternatives</span></span>
</span></td></tr>
<tr id="S2.T1.6.1.6" class="ltx_tr" style="--ltx-bg-color:#EAF8FD;">
<td id="S2.T1.6.1.6.1" class="ltx_td ltx_align_left ltx_align_middle" style="padding-top:4.65pt;padding-bottom:4.65pt;">
