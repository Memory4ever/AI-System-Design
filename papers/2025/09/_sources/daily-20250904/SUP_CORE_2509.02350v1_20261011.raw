<span id="S5.T9.6.1.4.1.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;--ltx-bg-color:#EAF8FD;">
<span id="S5.T9.6.1.4.1.1.1" class="ltx_p"><span id="S5.T9.6.1.4.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">WikiText-2</span><span id="S5.T9.6.1.4.1.1.1.2" class="ltx_text" style="font-size:90%;"> </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S5.T9.6.1.4.1.1.1.3" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib106" title="" class="ltx_ref">Merity et al., 2017</a><span id="S5.T9.6.1.4.1.1.1.5" class="ltx_text" style="font-size:90%;">)</span></cite></span>
</span></td>
<td id="S5.T9.6.1.4.2" class="ltx_td ltx_align_left ltx_align_middle" style="padding-top:4.65pt;padding-bottom:4.65pt;">
<span id="S5.T9.6.1.4.2.1" class="ltx_inline-block ltx_align_middle" style="width:99.6pt;--ltx-bg-color:#EAF8FD;">
<span id="S5.T9.6.1.4.2.1.1" class="ltx_p"><span id="S5.T9.6.1.4.2.1.1.1" class="ltx_text" style="font-size:90%;">Language modeling</span></span>
