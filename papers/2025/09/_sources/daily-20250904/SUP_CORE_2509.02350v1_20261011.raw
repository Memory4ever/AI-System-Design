<span id="S3.T6.6.1.1.6.1.1" class="ltx_p ltx_align_center"><span id="S3.T6.6.1.1.6.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Open Source</span></span>
</span></td></tr>
<tr id="S3.T6.6.1.2" class="ltx_tr" style="--ltx-bg-color:#EAF8FD;">
<td id="S3.T6.6.1.2.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding-top:4.65pt;padding-bottom:4.65pt;">
<span id="S3.T6.6.1.2.1.1" class="ltx_inline-block ltx_align_middle" style="width:85.4pt;--ltx-bg-color:#EAF8FD;">
<span id="S3.T6.6.1.2.1.1.1" class="ltx_p"><span id="S3.T6.6.1.2.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">ITT</span><span id="S3.T6.6.1.2.1.1.1.2" class="ltx_text" style="font-size:90%;"> </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S3.T6.6.1.2.1.1.1.3" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib20" title="" class="ltx_ref">Chen et al., 2025c</a><span id="S3.T6.6.1.2.1.1.1.5" class="ltx_text" style="font-size:90%;">)</span></cite></span>
</span></td>
<td id="S3.T6.6.1.2.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding-top:4.65pt;padding-bottom:4.65pt;">
<span id="S3.T6.6.1.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:128.0pt;--ltx-bg-color:#EAF8FD;">
<span id="S3.T6.6.1.2.2.1.1" class="ltx_p"><span id="S3.T6.6.1.2.2.1.1.1" class="ltx_text" style="font-size:90%;">Adaptive Token Routing, Thinking Step Encoding, Residual Thinking Connection</span></span>
</span></td>
<td id="S3.T6.6.1.2.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding-top:4.65pt;padding-bottom:4.65pt;">
<span id="S3.T6.6.1.2.3.1" class="ltx_inline-block ltx_align_middle" style="width:76.8pt;--ltx-bg-color:#EAF8FD;">
<span id="S3.T6.6.1.2.3.1.1" class="ltx_p"><span id="S3.T6.6.1.2.3.1.1.1" class="ltx_text" style="font-size:90%;">LLaMA-2 </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S3.T6.6.1.2.3.1.1.2" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib155" title="" class="ltx_ref">Touvron et al., 2023b</a><span id="S3.T6.6.1.2.3.1.1.4" class="ltx_text" style="font-size:90%;">)</span></cite><span id="S3.T6.6.1.2.3.1.1.5" class="ltx_text" style="font-size:90%;"> architecture</span></span>
</span></td>
<td id="S3.T6.6.1.2.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding-top:4.65pt;padding-bottom:4.65pt;">
