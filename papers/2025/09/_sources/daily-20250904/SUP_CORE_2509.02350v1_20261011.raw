<span id="S3.T5.6.1.1.2.1" class="ltx_inline-block ltx_align_middle" style="width:128.0pt;--ltx-bg-color:#FFFFFF;">
<span id="S3.T5.6.1.1.2.1.1" class="ltx_p"><span id="S3.T5.6.1.1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Main Techniques</span></span>
