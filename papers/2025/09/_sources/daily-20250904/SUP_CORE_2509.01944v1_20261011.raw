<td id="S4.T4.3.4.4" class="ltx_td ltx_align_center">0.26</td>
<td id="S4.T4.3.4.5" class="ltx_td ltx_align_center">0.20</td></tr>
<tr id="S4.T4.3.5" class="ltx_tr">
<th id="S4.T4.3.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S4.T4.3.5.1.1" class="ltx_text ltx_font_bold">w/. num = 6</span></th>
<td id="S4.T4.3.5.2" class="ltx_td ltx_align_center"><span id="S4.T4.3.5.2.1" class="ltx_text ltx_font_bold">0.13</span></td>
<td id="S4.T4.3.5.3" class="ltx_td ltx_align_center"><span id="S4.T4.3.5.3.1" class="ltx_text ltx_font_bold">0.19</span></td>
<td id="S4.T4.3.5.4" class="ltx_td ltx_align_center"><span id="S4.T4.3.5.4.1" class="ltx_text ltx_font_bold">0.25</span></td>
<td id="S4.T4.3.5.5" class="ltx_td ltx_align_center"><span id="S4.T4.3.5.5.1" class="ltx_text ltx_font_bold">0.19</span></td></tr>
<tr id="S4.T4.3.6" class="ltx_tr">
<th id="S4.T4.3.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">w/. num = 8</th>
