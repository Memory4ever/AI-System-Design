<th id="S4.T2.7.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;" colspan="3"><span id="S4.T2.7.1.3.1" class="ltx_text" style="font-size:80%;">block-wise</span></th></tr>
