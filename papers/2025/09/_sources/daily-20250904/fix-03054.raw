<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Detailed Derivation of Proposed Methods</h2>

<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p">Given the objective</p>
<table id="A1.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex12.m1" class="ltx_math_unparsed" alttext="\displaystyle g^{\ast},\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}=\argmin_{\begin{subarray}{c}\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}\in\mathbb{A}\\
\{\boldsymbol{B}_{i}^{\ast}\}^{g^{\ast}}_{i=1}\in\mathbb{B}\\
1\leq g\leq|\boldsymbol{A}|\end{subarray}}\sum^{g}_{i=1}||\boldsymbol{A}_{i}-\alpha_{i}\boldsymbol{B}_{i}||_{2}^{2}+\frac{1}{|\boldsymbol{B}_{i}|}" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝑨</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>g</mi><mo>∗</mo></msup></msubsup><mo>=</mo><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐀</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>g</mi><mo>∗</mo></msup></msubsup><mo>∈</mo><mi>𝔸</mi></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐁</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>g</mi><mo>∗</mo></msup></msubsup><mo>∈</mo><mi>𝔹</mi></mrow></mtd></mtr><mtr><mtd><mrow><mn>1</mn><mo>≤</mo><mi>g</mi><mo>≤</mo><mrow><mo stretchy="false">|</mo><mi>𝐀</mi><mo stretchy="false">|</mo></mrow></mrow></mtd></mtr></mtable></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>g</mi></munderover></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐀</mi><mi>i</mi></msub><mo>−</mo><msub><mi>α</mi><mi>i</mi></msub><msub><mi>𝐁</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mo fence="false" stretchy="false">|</mo><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>𝐁</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle g^{\ast},\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}=\argmin_{\begin{subarray}{c}\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}\in\mathbb{A}\\
\{\boldsymbol{B}_{i}^{\ast}\}^{g^{\ast}}_{i=1}\in\mathbb{B}\\
1\leq g\leq|\boldsymbol{A}|\end{subarray}}\sum^{g}_{i=1}||\boldsymbol{A}_{i}-\alpha_{i}\boldsymbol{B}_{i}||_{2}^{2}+\frac{1}{|\boldsymbol{B}_{i}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p1.2" class="ltx_p">Since <math id="A1.p1.m1" class="ltx_Math" alttext="|\boldsymbol{A}_{i}|=|\boldsymbol{B}_{i}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝑩</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|\boldsymbol{A}_{i}|=|\boldsymbol{B}_{i}|</annotation></semantics></math>, the optimization objective can be rewritten to</p>
<table id="A1.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex13.m1" class="ltx_math_unparsed" alttext="\displaystyle g^{\ast},\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}=\argmin_{\begin{subarray}{c}\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}\in\mathbb{A}\\
\{\boldsymbol{B}_{i}^{\ast}\}^{g^{\ast}}_{i=1}\in\mathbb{B}\\
1\leq g\leq|\boldsymbol{A}|\end{subarray}}\sum^{g}_{i=1}||\boldsymbol{A}_{i}-\alpha_{i}\boldsymbol{B}_{i}||_{2}^{2}+\frac{1}{|\boldsymbol{A}_{i}|}" display="inline" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝑨</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>g</mi><mo>∗</mo></msup></msubsup><mo>=</mo><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐀</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>g</mi><mo>∗</mo></msup></msubsup><mo>∈</mo><mi>𝔸</mi></mrow></mtd></mtr><mtr><mtd><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐁</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>g</mi><mo>∗</mo></msup></msubsup><mo>∈</mo><mi>𝔹</mi></mrow></mtd></mtr><mtr><mtd><mrow><mn>1</mn><mo>≤</mo><mi>g</mi><mo>≤</mo><mrow><mo stretchy="false">|</mo><mi>𝐀</mi><mo stretchy="false">|</mo></mrow></mrow></mtd></mtr></mtable></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>g</mi></munderover></mstyle><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐀</mi><mi>i</mi></msub><mo>−</mo><msub><mi>α</mi><mi>i</mi></msub><msub><mi>𝐁</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mo fence="false" stretchy="false">|</mo><mn>2</mn><mn>2</mn></msubsup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>𝐀</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle g^{\ast},\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}=\argmin_{\begin{subarray}{c}\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}\in\mathbb{A}\\
\{\boldsymbol{B}_{i}^{\ast}\}^{g^{\ast}}_{i=1}\in\mathbb{B}\\
1\leq g\leq|\boldsymbol{A}|\end{subarray}}\sum^{g}_{i=1}||\boldsymbol{A}_{i}-\alpha_{i}\boldsymbol{B}_{i}||_{2}^{2}+\frac{1}{|\boldsymbol{A}_{i}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p1.3" class="ltx_p">As shown in <a href="#S3.Ex1" title="Equation 1 ‣ 3.1 Preliminary ‣ 3 Methodology ‣ Calibration and Transformation-Free Weight-Only LLMs Quantization via Dynamic Grouping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>,</p>
<table id="A1.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14.m1" class="ltx_Math" alttext="\displaystyle\argmin_{\alpha^{\ast},\boldsymbol{B}^{\ast}}||\boldsymbol{A}-\alpha\boldsymbol{B}||_{2}^{2},\quad\alpha^{\ast}=\frac{||\boldsymbol{A}||_{1}}{|\boldsymbol{A}|},\;\boldsymbol{B}^{\ast}=\text{sign}(\boldsymbol{A})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mrow><msup><mi>α</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>𝐁</mi><mo>∗</mo></msup></mrow></msub><mo>⁡</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝐀</mi><mo>−</mo><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐁</mi></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo rspace="1.167em">,</mo><mrow><msup><mi>α</mi><mo>∗</mo></msup><mo>=</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝐀</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mrow><mo stretchy="false">|</mo><mi>𝐀</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow><mo rspace="0.447em">,</mo><mrow><msup><mi>𝐁</mi><mo>∗</mo></msup><mo>=</mo><mrow><mtext>sign</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐀</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\argmin_{\alpha^{\ast},\boldsymbol{B}^{\ast}}||\boldsymbol{A}-\alpha\boldsymbol{B}||_{2}^{2},\quad\alpha^{\ast}=\frac{||\boldsymbol{A}||_{1}}{|\boldsymbol{A}|},\;\boldsymbol{B}^{\ast}=\text{sign}(\boldsymbol{A})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p1.4" class="ltx_p">By substituting the optimal values, we can rewrite the squared 2-norm.</p>
<table id="A1.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex15.m1" class="ltx_Math" alttext="\displaystyle||\boldsymbol{A}-\alpha^{\ast}\boldsymbol{B}^{\ast}||_{2}^{2}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mi>𝑨</mi><mo>−</mo><mrow><msup><mi>α</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝑩</mi><mo>∗</mo></msup></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle||\boldsymbol{A}-\alpha^{\ast}\boldsymbol{B}^{\ast}||_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex15.m2" class="ltx_Math" alttext="\displaystyle=\sum^{i}\sum^{j}(A_{i,j}-\alpha^{\ast}\cdot\text{sign}(A_{i,j}))^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>i</mi></mover></mstyle><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>j</mi></mover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>−</mo><mrow><mrow><msup><mi>α</mi><mo>∗</mo></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext>sign</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{i}\sum^{j}(A_{i,j}-\alpha^{\ast}\cdot\text{sign}(A_{i,j}))^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16.m1" class="ltx_Math" alttext="\displaystyle=\sum^{i}\sum^{j}(|A_{i,j}|-\alpha^{\ast})^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>i</mi></mover></mstyle><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>j</mi></mover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><msup><mi>α</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{i}\sum^{j}(|A_{i,j}|-\alpha^{\ast})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\displaystyle=\sum^{i}\sum^{j}|A_{i,j}|^{2}-2\alpha^{\ast}\sum^{i}\sum^{j}|A_{i,j}|+\sum^{i}\sum^{j}{\alpha^{\ast}}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>i</mi></mover></mstyle><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>j</mi></mover></mstyle><msup><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>i</mi></mover></mstyle><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>j</mi></mover></mstyle><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>i</mi></mover></mstyle><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>j</mi></mover></mstyle><mmultiscripts><mi>α</mi><mrow></mrow><mo>∗</mo><mrow></mrow><mn>2</mn></mmultiscripts></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum^{i}\sum^{j}|A_{i,j}|^{2}-2\alpha^{\ast}\sum^{i}\sum^{j}|A_{i,j}|+\sum^{i}\sum^{j}{\alpha^{\ast}}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex18.m1" class="ltx_Math" alttext="\displaystyle=||\boldsymbol{A}||_{2}^{2}-2\alpha^{\ast}||\boldsymbol{A}||_{1}+|\boldsymbol{A}|{\alpha^{\ast}}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mmultiscripts><mi>α</mi><mrow></mrow><mo>∗</mo><mrow></mrow><mn>2</mn></mmultiscripts></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=||\boldsymbol{A}||_{2}^{2}-2\alpha^{\ast}||\boldsymbol{A}||_{1}+|\boldsymbol{A}|{\alpha^{\ast}}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex19.m1" class="ltx_Math" alttext="\displaystyle=||\boldsymbol{A}||_{2}^{2}-2\frac{||\boldsymbol{A}||_{1}}{|\boldsymbol{A}|}||\boldsymbol{A}||_{1}+|\boldsymbol{A}|\left(\frac{||\boldsymbol{A}||_{1}}{|\boldsymbol{A}|}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=||\boldsymbol{A}||_{2}^{2}-2\frac{||\boldsymbol{A}||_{1}}{|\boldsymbol{A}|}||\boldsymbol{A}||_{1}+|\boldsymbol{A}|\left(\frac{||\boldsymbol{A}||_{1}}{|\boldsymbol{A}|}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex20.m1" class="ltx_Math" alttext="\displaystyle=||\boldsymbol{A}||_{2}^{2}-2\frac{||\boldsymbol{A}||_{1}^{2}}{|\boldsymbol{A}|}+\frac{||\boldsymbol{A}||_{1}^{2}}{|\boldsymbol{A}|}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn><mn>2</mn></msubsup><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn><mn>2</mn></msubsup><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=||\boldsymbol{A}||_{2}^{2}-2\frac{||\boldsymbol{A}||_{1}^{2}}{|\boldsymbol{A}|}+\frac{||\boldsymbol{A}||_{1}^{2}}{|\boldsymbol{A}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex21.m1" class="ltx_Math" alttext="\displaystyle=||\boldsymbol{A}||_{2}^{2}-\frac{||\boldsymbol{A}||_{1}^{2}}{|\boldsymbol{A}|}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><mi>𝑨</mi><mo stretchy="false">‖</mo></mrow><mn>1</mn><mn>2</mn></msubsup><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=||\boldsymbol{A}||_{2}^{2}-\frac{||\boldsymbol{A}||_{1}^{2}}{|\boldsymbol{A}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p1.5" class="ltx_p">Consider the variance of absolute value of <math id="A1.p1.m2" class="ltx_Math" alttext="\boldsymbol{A}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝑨</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\boldsymbol{A}_{i}</annotation></semantics></math>, let <math id="A1.p1.m3" class="ltx_Math" alttext="\tilde{\boldsymbol{A}_{i}}" display="inline" intent=":literal"><semantics><mover accent="true"><msub><mi>𝑨</mi><mi>i</mi></msub><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\boldsymbol{A}_{i}}</annotation></semantics></math> be <math id="A1.p1.m4" class="ltx_Math" alttext="\boldsymbol{A}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝑨</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\boldsymbol{A}_{i}</annotation></semantics></math> with element-wise absolute value, such as <math id="A1.p1.m5" class="ltx_Math" alttext="|\tilde{\boldsymbol{A}_{i}}|=|\boldsymbol{A}_{i}|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mover accent="true"><msub><mi>𝑨</mi><mi>i</mi></msub><mo>~</mo></mover><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">|\tilde{\boldsymbol{A}_{i}}|=|\boldsymbol{A}_{i}|</annotation></semantics></math> and <math id="A1.p1.m6" class="ltx_Math" alttext="\tilde{A}_{i_{j,k}}=|A_{i_{j,k}}|" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>A</mi><mo>~</mo></mover><msub><mi>i</mi><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub></msub><mo>=</mo><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><msub><mi>i</mi><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub></msub><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{A}_{i_{j,k}}=|A_{i_{j,k}}|</annotation></semantics></math>.</p>
<table id="A1.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex22.m1" class="ltx_Math" alttext="\displaystyle Var(\tilde{\boldsymbol{A}_{i}})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mi>i</mi></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle Var(\tilde{\boldsymbol{A}_{i}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m2" class="ltx_Math" alttext="\displaystyle=E[\tilde{\boldsymbol{A}_{i}}^{2}]-E[\tilde{\boldsymbol{A}_{i}}]^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>E</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mover accent="true"><msub><mi>𝑨</mi><mi>i</mi></msub><mo>~</mo></mover><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><mover accent="true"><msub><mi>𝑨</mi><mi>i</mi></msub><mo>~</mo></mover><mo stretchy="false">]</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=E[\tilde{\boldsymbol{A}_{i}}^{2}]-E[\tilde{\boldsymbol{A}_{i}}]^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex23.m1" class="ltx_Math" alttext="\displaystyle=\frac{1}{|\boldsymbol{A}_{i}|}\sum^{j}\sum^{k}|A_{i_{j,k}}|^{2}-\left(\frac{1}{|\boldsymbol{A}_{i}|}\sum^{j}\sum^{k}|A_{i_{j,k}}|\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>j</mi></mover></mstyle><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>k</mi></mover></mstyle><msup><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><msub><mi>i</mi><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub></msub><mo stretchy="false">|</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>−</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>j</mi></mover></mstyle><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>k</mi></mover></mstyle><mrow><mo stretchy="false">|</mo><msub><mi>A</mi><msub><mi>i</mi><mrow><mi>j</mi><mo>,</mo><mi>k</mi></mrow></msub></msub><mo stretchy="false">|</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{|\boldsymbol{A}_{i}|}\sum^{j}\sum^{k}|A_{i_{j,k}}|^{2}-\left(\frac{1}{|\boldsymbol{A}_{i}|}\sum^{j}\sum^{k}|A_{i_{j,k}}|\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex24.m1" class="ltx_Math" alttext="\displaystyle=\frac{||\boldsymbol{A}_{i}||_{2}^{2}}{|\boldsymbol{A}_{i}|}-\left(\frac{||\boldsymbol{A}_{i}||_{1}}{|\boldsymbol{A}_{i}|}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo>−</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{||\boldsymbol{A}_{i}||_{2}^{2}}{|\boldsymbol{A}_{i}|}-\left(\frac{||\boldsymbol{A}_{i}||_{1}}{|\boldsymbol{A}_{i}|}\right)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex26.m1" class="ltx_Math" alttext="\displaystyle|\boldsymbol{A}_{i}|Var(\tilde{\boldsymbol{A}_{i}})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mi>i</mi></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle|\boldsymbol{A}_{i}|Var(\tilde{\boldsymbol{A}_{i}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26.m2" class="ltx_Math" alttext="\displaystyle=||\boldsymbol{A}_{i}||_{2}^{2}-\frac{||\boldsymbol{A}_{i}||_{1}^{2}}{|\boldsymbol{A}_{i}|}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mrow><mo stretchy="false">‖</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">‖</mo></mrow><mn>1</mn><mn>2</mn></msubsup><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=||\boldsymbol{A}_{i}||_{2}^{2}-\frac{||\boldsymbol{A}_{i}||_{1}^{2}}{|\boldsymbol{A}_{i}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p1.6" class="ltx_p">Together, we can conclude</p>
<table id="A1.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex27.m1" class="ltx_Math" alttext="\displaystyle||\boldsymbol{A}_{i}-\alpha_{i}^{\ast}\boldsymbol{B}_{i}^{\ast}||_{2}^{2}=|\boldsymbol{A}_{i}|Var(\tilde{\boldsymbol{A}_{i}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝑨</mi><mi>i</mi></msub><mo>−</mo><mrow><msubsup><mi>α</mi><mi>i</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝑩</mi><mi>i</mi><mo>∗</mo></msubsup></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mi>i</mi></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle||\boldsymbol{A}_{i}-\alpha_{i}^{\ast}\boldsymbol{B}_{i}^{\ast}||_{2}^{2}=|\boldsymbol{A}_{i}|Var(\tilde{\boldsymbol{A}_{i}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.p1.7" class="ltx_p">Finally, we rewrite the initial optimization objective as</p>
<table id="A1.EGx16" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="A1.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex28.m1" class="ltx_math_unparsed" alttext="\displaystyle g^{\ast},\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}=\argmin_{\begin{subarray}{c}\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}\in\mathbb{A}\\
1\leq g\leq|\boldsymbol{A}|\end{subarray}}\sum^{g}_{i=1}|\boldsymbol{A}_{i}|\text{Var}(\tilde{\boldsymbol{A}_{i}})+\frac{1}{|\boldsymbol{A}_{i}|}" display="block" intent=":literal"><semantics><mrow><msup><mi>g</mi><mo>∗</mo></msup><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝑨</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>g</mi><mo>∗</mo></msup></msubsup><mo>=</mo><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mtable rowspacing="0pt"><mtr><mtd><mrow><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐀</mi><mi>i</mi><mo>∗</mo></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msup><mi>g</mi><mo>∗</mo></msup></msubsup><mo>∈</mo><mi>𝔸</mi></mrow></mtd></mtr><mtr><mtd><mrow><mn>1</mn><mo>≤</mo><mi>g</mi><mo>≤</mo><mrow><mo stretchy="false">|</mo><mi>𝐀</mi><mo stretchy="false">|</mo></mrow></mrow></mtd></mtr></mtable></msub><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>g</mi></munderover><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐀</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mtext>Var</mtext><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝐀</mi><mi>i</mi></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow><mo>+</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>𝐀</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle g^{\ast},\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}=\argmin_{\begin{subarray}{c}\{\boldsymbol{A}_{i}^{\ast}\}^{g^{\ast}}_{i=1}\in\mathbb{A}\\
1\leq g\leq|\boldsymbol{A}|\end{subarray}}\sum^{g}_{i=1}|\boldsymbol{A}_{i}|\text{Var}(\tilde{\boldsymbol{A}_{i}})+\frac{1}{|\boldsymbol{A}_{i}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Remaining Three Algorithms</h2>

<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p">In this section, we present the pseudocode for the remaining three of our designed algorithms:</p>
</div>
<div id="A2.p2" class="ltx_para">
<ul id="A2.I1" class="ltx_itemize">
<li id="A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i1.p1" class="ltx_para">
