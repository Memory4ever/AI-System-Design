<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Greedy Grouping</figcaption>
<div id="alg3.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
           <span id="alg3.l1.3" class="ltx_text ltx_font_bold">Greedy merging: <math id="alg3.l1.m1" class="ltx_Math" alttext="\boldsymbol{A}\in\mathbb{R}^{m\times n},g\text{ (max group})" display="inline" intent=":literal"><semantics><mrow><mo fence="true" rspace="0em">𝐎𝐏𝐄𝐍</mo><mrow><mrow><mi>A</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><mo>,</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mtext> (max group</mtext></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\boldsymbol{A}\in\mathbb{R}^{m\times n},g\text{ (max group})</annotation></semantics></math></span>

</div>
<div id="alg3.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
           sort absolute value of non-zero entry into an array

</div>
<div id="alg3.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
           initial the merge cost array <math id="alg3.l3.m1" class="ltx_math_unparsed" alttext="[(i\text{ (group start}),i+1\text{( group end}),cost,\mu)]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mtext> (group start</mtext><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>i</mi><mo>+</mo><mn>1</mn><mtext>( group end</mtext><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>c</mi><mi>o</mi><mi>s</mi><mi>t</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[(i\text{ (group start}),i+1\text{( group end}),cost,\mu)]</annotation></semantics></math> for <math id="alg3.l3.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> in range(<math id="alg3.l3.m3" class="ltx_Math" alttext="mn" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">mn</annotation></semantics></math> - 1)

</div>
<div id="alg3.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
           initially the ignore array

</div>
<div id="alg3.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
           heapify the merge cost array

</div>
<div id="alg3.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
           <span id="alg3.l6.3" class="ltx_text ltx_font_bold">while</span> len(merge cost array) <math id="alg3.l6.m1" class="ltx_Math" alttext="&gt;" display="inline" intent=":literal"><semantics><mo>&gt;</mo><annotation encoding="application/x-tex">&gt;</annotation></semantics></math> g <span id="alg3.l6.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg3.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
            currentMerge <math id="alg3.l7.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> heap pop

</div>
<div id="alg3.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
            <span id="alg3.l8.3" class="ltx_text ltx_font_bold">if</span> currentMerge in ignore array <span id="alg3.l8.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg3.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
             remove currentMerge from ignore array

</div>
<div id="alg3.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
             continue

</div>
<div id="alg3.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
            <span id="alg3.l11.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l11.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg3.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
            push two new merges as updates

</div>
<div id="alg3.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
            update ignore array by two merged, invalidated by the two new merges

</div>
<div id="alg3.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
           <span id="alg3.l14.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l14.4" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="alg3.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
            
            
           <span id="alg3.l15.3" class="ltx_text ltx_font_bold">return</span> merge cost array

</div>
</div>
</figure>
<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.3" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> Local Optimizing Windowed Greedy Merging</figcaption>
<div id="alg4.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
           <span id="alg4.l1.3" class="ltx_text ltx_font_bold">LOWGM: <math id="alg4.l1.m1" class="ltx_math_unparsed" alttext="\boldsymbol{A}\in\mathbb{R}^{m\times n},g\text{ (max group}),k\text{ (window number}),b\text{ (local optimization range}),T\text{ (max iterations)},\epsilon\text{ (converge threshold)}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>A</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup><mo>,</mo><mi>g</mi><mtext> (max group</mtext><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>k</mi><mtext> (window number</mtext><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>b</mi><mtext> (local optimization range</mtext><mo stretchy="false">)</mo><mo>,</mo><mi>T</mi><mtext> (max iterations)</mtext><mo>,</mo><mi>ϵ</mi><mtext> (converge threshold)</mtext></mrow><annotation encoding="application/x-tex">\boldsymbol{A}\in\mathbb{R}^{m\times n},g\text{ (max group}),k\text{ (window number}),b\text{ (local optimization range}),T\text{ (max iterations)},\epsilon\text{ (converge threshold)}</annotation></semantics></math></span>

</div>
<div id="alg4.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
           sort absolute value of non-zero entry into an array

</div>
<div id="alg4.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
           initial the merge cost array with equal range binning, bin width <math id="alg4.l3.m1" class="ltx_Math" alttext="\Delta=(a_{max}-a_{min})/k" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>a</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>−</mo><msub><mi>a</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">\Delta=(a_{max}-a_{min})/k</annotation></semantics></math> and map each magnitude <math id="alg4.l3.m2" class="ltx_Math" alttext="|a|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi>a</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|a|</annotation></semantics></math> to bin index <math id="alg4.l3.m3" class="ltx_Math" alttext="=\min(k-1,\lfloor(|a|-a_{min})/\Delta\rfloor)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo stretchy="false">⌊</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi>a</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><msub><mi>a</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi mathvariant="normal">Δ</mi></mrow><mo stretchy="false">⌋</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">=\min(k-1,\lfloor(|a|-a_{min})/\Delta\rfloor)</annotation></semantics></math>

</div>
<div id="alg4.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
           initially the ignore array

</div>
<div id="alg4.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
           heapify the merge cost array

</div>
<div id="alg4.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
           <span id="alg4.l6.3" class="ltx_text ltx_font_bold">while</span> len(merge cost array) <math id="alg4.l6.m1" class="ltx_Math" alttext="&gt;" display="inline" intent=":literal"><semantics><mo>&gt;</mo><annotation encoding="application/x-tex">&gt;</annotation></semantics></math> g <span id="alg4.l6.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg4.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
            currentMerge <math id="alg4.l7.m1" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> heapop

</div>
<div id="alg4.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
            <span id="alg4.l8.3" class="ltx_text ltx_font_bold">if</span> currentMerge in ignore array <span id="alg4.l8.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg4.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
             remove currentMerge from ignore array

</div>
<div id="alg4.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
             continue

</div>
<div id="alg4.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
            <span id="alg4.l11.3" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l11.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg4.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
            push two new neighbouring merges as updates

</div>
<div id="alg4.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
            update ignore array by two old merges, invalidated by the two new merges

</div>
<div id="alg4.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
           <span id="alg4.l14.3" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l14.4" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="alg4.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
            
            
           <math id="alg4.l15.m1" class="ltx_math_unparsed" alttext="i=0,\varepsilon=\inf" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi>ε</mi><mo rspace="0.1389em">=</mo><mo lspace="0.1389em">inf</mo></mrow><annotation encoding="application/x-tex">i=0,\varepsilon=\inf</annotation></semantics></math>

</div>
<div id="alg4.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
            
            
           <span id="alg4.l16.3" class="ltx_text ltx_font_bold">while</span> <math id="alg4.l16.m1" class="ltx_Math" alttext="\varepsilon&gt;\epsilon" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\varepsilon&gt;\epsilon</annotation></semantics></math> or <math id="alg4.l16.m2" class="ltx_Math" alttext="i\geq T" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≥</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">i\geq T</annotation></semantics></math> <span id="alg4.l16.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg4.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
            
            
            <span id="alg4.l17.3" class="ltx_text ltx_font_bold">for</span> each group <span id="alg4.l17.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg4.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
            
            
             Try the move group boundary randomly within <math id="alg4.l18.m1" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> one time. If the total loss is lower, update the group boundary and <math id="alg4.l18.m2" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>.

</div>
<div id="alg4.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
            
            
             <math id="alg4.l19.m1" class="ltx_Math" alttext="i++" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo rspace="0em">+</mo></mrow><mo lspace="0em">+</mo></mrow><annotation encoding="application/x-tex">i++</annotation></semantics></math>

</div>
<div id="alg4.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
            
            
            <span id="alg4.l20.3" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l20.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg4.l21" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
            
            
           <span id="alg4.l21.3" class="ltx_text ltx_font_bold">end</span> <span id="alg4.l21.4" class="ltx_text ltx_font_bold">while</span>
</div>
<div id="alg4.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
            
            
           <span id="alg4.l22.3" class="ltx_text ltx_font_bold">return</span> merge cost array

</div>
</div>
</figure>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Determining the Boundary of <math id="A3.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math></h2>

<div id="A3.p1" class="ltx_para">
<p id="A3.p1.1" class="ltx_p">We further analysis the boundary of <math id="A3.p1.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, the objective in this section is</p>
</div>
<div id="A3.p2" class="ltx_para">
<table id="A3.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex29.m1" class="ltx_Math" alttext="\displaystyle\min_{g\in\mathbb{N}}\sum^{g}_{i=1}\left(\textstyle\frac{|\boldsymbol{A}_{i}|}{|\boldsymbol{A}|}Var(\tilde{\boldsymbol{A}_{i}})+\textstyle\frac{\lambda}{|\boldsymbol{A}_{i}|}\right)" display="inline" intent=":literal"><semantics><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mrow><mstyle displaystyle="true"><mmultiscripts><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>g</mi></munderover><mprescripts></mprescripts><mrow><mi>g</mi><mo>∈</mo><mi>ℕ</mi></mrow><mrow></mrow></mmultiscripts></mstyle><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mfrac><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mi>i</mi></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mfrac><mi>λ</mi><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\min_{g\in\mathbb{N}}\sum^{g}_{i=1}\left(\textstyle\frac{|\boldsymbol{A}_{i}|}{|\boldsymbol{A}|}Var(\tilde{\boldsymbol{A}_{i}})+\textstyle\frac{\lambda}{|\boldsymbol{A}_{i}|}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p3" class="ltx_para">
<p id="A3.p3.1" class="ltx_p">Firstly, we determine the lower bound of <math id="A3.p3.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>. Considering the case of group size 1 and number of groups <math id="A3.p3.m2" class="ltx_Math" alttext="g" display="inline" intent=":literal"><semantics><mi>g</mi><annotation encoding="application/x-tex">g</annotation></semantics></math> is the number of non-zero elements <math id="A3.p3.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. The cost is</p>
</div>
<div id="A3.p4" class="ltx_para">
<table id="A3.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex30.m1" class="ltx_Math" alttext="\displaystyle\sum^{g}0+\lambda\frac{1}{1}=n\lambda" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mi>g</mi></mover></mstyle><mn>0</mn></mrow><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>1</mn></mfrac></mstyle></mrow></mrow><mo>=</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{g}0+\lambda\frac{1}{1}=n\lambda</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p5" class="ltx_para">
<p id="A3.p5.1" class="ltx_p">The squared 2 norm is 0 since in the case of group size one <math id="A3.p5.m1" class="ltx_Math" alttext="\boldsymbol{A}_{i}=\alpha_{i}\boldsymbol{B}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑨</mi><mi>i</mi></msub><mo>=</mo><mrow><msub><mi>α</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑩</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{A}_{i}=\alpha_{i}\boldsymbol{B}_{i}</annotation></semantics></math>.</p>
</div>
<div id="A3.p6" class="ltx_para">
<p id="A3.p6.1" class="ltx_p">Now consider the case of the number of groups = <math id="A3.p6.m1" class="ltx_Math" alttext="g-1" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g-1</annotation></semantics></math>, so we have <math id="A3.p6.m2" class="ltx_Math" alttext="g-2" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">g-2</annotation></semantics></math> groups of size 1 and 1 group of size 2. The cost is</p>
</div>
<div id="A3.p7" class="ltx_para">
<table id="A3.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex31.m1" class="ltx_Math" alttext="\displaystyle\sum^{g-2}\left(0+\lambda\frac{1}{1}\right)+\frac{1}{n}(|a_{1}|-\alpha^{\ast})^{2}+\frac{1}{n}(|a_{2}|-\alpha^{\ast})^{2}+\frac{\lambda}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mrow><mi>g</mi><mo>−</mo><mn>2</mn></mrow></mover></mstyle><mrow><mo>(</mo><mrow><mn>0</mn><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>1</mn></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><msup><mi>α</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><msup><mi>α</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{g-2}\left(0+\lambda\frac{1}{1}\right)+\frac{1}{n}(|a_{1}|-\alpha^{\ast})^{2}+\frac{1}{n}(|a_{2}|-\alpha^{\ast})^{2}+\frac{\lambda}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex32.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex32.m2" class="ltx_Math" alttext="\displaystyle\sum^{n-2}\left(0+\lambda\frac{1}{1}\right)+\frac{1}{n}(|a_{1}|-\frac{|a_{1}|+|a_{2}|}{2})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mover><mo movablelimits="false">∑</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mover></mstyle><mrow><mo>(</mo><mrow><mn>0</mn><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>1</mn></mfrac></mstyle></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mn>2</mn></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum^{n-2}\left(0+\lambda\frac{1}{1}\right)+\frac{1}{n}(|a_{1}|-\frac{|a_{1}|+|a_{2}|}{2})^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex33.m1" class="ltx_Math" alttext="\displaystyle+\frac{1}{n}(|a_{2}|-\frac{|a_{1}|+|a_{2}|}{2})^{2}+\frac{\lambda}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mn>2</mn></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{1}{n}(|a_{2}|-\frac{|a_{1}|+|a_{2}|}{2})^{2}+\frac{\lambda}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex34.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex34.m2" class="ltx_Math" alttext="\displaystyle(n-2)\lambda+\frac{1}{n}(\frac{|a_{1}|-|a_{2}|}{2})^{2}+\frac{1}{n}(\frac{|a_{2}|-|a_{1}|}{2})^{2}+\frac{\lambda}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle(n-2)\lambda+\frac{1}{n}(\frac{|a_{1}|-|a_{2}|}{2})^{2}+\frac{1}{n}(\frac{|a_{2}|-|a_{1}|}{2})^{2}+\frac{\lambda}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex35.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex35.m2" class="ltx_Math" alttext="\displaystyle(n-2)\lambda+\frac{1}{n}(\frac{|a_{1}|-|a_{2}|}{2})^{2}+\frac{1}{n}(\frac{|a_{1}|-|a_{2}|}{2})^{2}+\frac{\lambda}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mn>2</mn></mfrac></mstyle><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle(n-2)\lambda+\frac{1}{n}(\frac{|a_{1}|-|a_{2}|}{2})^{2}+\frac{1}{n}(\frac{|a_{1}|-|a_{2}|}{2})^{2}+\frac{\lambda}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex36.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex36.m2" class="ltx_Math" alttext="\displaystyle(n-2)\lambda+\frac{(|a_{1}|-|a_{2}|)^{2}}{2n}+\frac{\lambda}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mn>2</mn></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle(n-2)\lambda+\frac{(|a_{1}|-|a_{2}|)^{2}}{2n}+\frac{\lambda}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p8" class="ltx_para">
<p id="A3.p8.1" class="ltx_p">Since we are minimizing the objective of equation <a href="#A3.Ex29" title="Equation 4 ‣ Appendix C Determining the Boundary of 𝜆 ‣ Calibration and Transformation-Free Weight-Only LLMs Quantization via Dynamic Grouping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, when (<a href="#A3.Ex30" title="Equation 5 ‣ Appendix C Determining the Boundary of 𝜆 ‣ Calibration and Transformation-Free Weight-Only LLMs Quantization via Dynamic Grouping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) <math id="A3.p8.m1" class="ltx_Math" alttext="&lt;" display="inline" intent=":literal"><semantics><mo>&lt;</mo><annotation encoding="application/x-tex">&lt;</annotation></semantics></math> (<a href="#A3.Ex36" title="Equation 6 ‣ Appendix C Determining the Boundary of 𝜆 ‣ Calibration and Transformation-Free Weight-Only LLMs Quantization via Dynamic Grouping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) we have n groups, else at most n-1 groups. Because we are using quantization for higher efficiency, a smaller number of groups, each with a larger size is desired. Therefore, we must avoid the n group case, i.e.(<a href="#A3.Ex30" title="Equation 5 ‣ Appendix C Determining the Boundary of 𝜆 ‣ Calibration and Transformation-Free Weight-Only LLMs Quantization via Dynamic Grouping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>) <math id="A3.p8.m2" class="ltx_Math" alttext="&gt;" display="inline" intent=":literal"><semantics><mo>&gt;</mo><annotation encoding="application/x-tex">&gt;</annotation></semantics></math> (<a href="#A3.Ex36" title="Equation 6 ‣ Appendix C Determining the Boundary of 𝜆 ‣ Calibration and Transformation-Free Weight-Only LLMs Quantization via Dynamic Grouping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>).</p>
</div>
<div id="A3.p9" class="ltx_para">
<table id="A3.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex38.m1" class="ltx_Math" alttext="\displaystyle n\lambda" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><annotation encoding="application/x-tex">\displaystyle n\lambda</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex38.m2" class="ltx_Math" alttext="\displaystyle&gt;(n-2)\lambda+\frac{(|a_{1}|-|a_{2}|)^{2}}{2n}+\frac{\lambda}{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mn>2</mn></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&gt;(n-2)\lambda+\frac{(|a_{1}|-|a_{2}|)^{2}}{2n}+\frac{\lambda}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex39.m1" class="ltx_Math" alttext="\displaystyle 2\lambda" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><annotation encoding="application/x-tex">\displaystyle 2\lambda</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex39.m2" class="ltx_Math" alttext="\displaystyle&gt;\frac{(|a_{1}|-|a_{2}|)^{2}}{2n}+\frac{\lambda}{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mn>2</mn></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&gt;\frac{(|a_{1}|-|a_{2}|)^{2}}{2n}+\frac{\lambda}{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex40.m1" class="ltx_Math" alttext="\displaystyle\frac{3\lambda}{2}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mn>2</mn></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{3\lambda}{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex40.m2" class="ltx_Math" alttext="\displaystyle&gt;\frac{(|a_{1}|-|a_{2}|)^{2}}{2n}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle&gt;\frac{(|a_{1}|-|a_{2}|)^{2}}{2n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex41.m1" class="ltx_Math" alttext="\displaystyle\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\displaystyle\lambda</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex41.m2" class="ltx_Math" alttext="\displaystyle&gt;\frac{(|a_{1}|-|a_{2}|)^{2}}{3n}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle&gt;\frac{(|a_{1}|-|a_{2}|)^{2}}{3n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex42.m1" class="ltx_Math" alttext="\displaystyle\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\displaystyle\lambda</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex42.m2" class="ltx_Math" alttext="\displaystyle&gt;\min_{1\leq i&lt;n}\frac{(|a_{i}|-|a_{i+1}|)^{2}}{3n}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>n</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&gt;\min_{1\leq i&lt;n}\frac{(|a_{i}|-|a_{i+1}|)^{2}}{3n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p10" class="ltx_para">
<p id="A3.p10.1" class="ltx_p">Since we also want to avoid the n-1 group case, and any group number that leads to a small group size, in general. So a good <math id="A3.p10.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> will not be in the close neighbourhood of the actual lower bound, thus we can estimate the lower bound roughly as</p>
</div>
<div id="A3.p11" class="ltx_para">
<table id="A3.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex43.m1" class="ltx_Math" alttext="\displaystyle\lambda&gt;\frac{(|a_{1}|-|a_{2}|)^{2}}{3n}&gt;\min_{1\leq i&lt;n}\frac{(|a_{i}|-|a_{i+1}|)^{2}}{3n}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle><mo>&gt;</mo><mrow><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>n</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lambda&gt;\frac{(|a_{1}|-|a_{2}|)^{2}}{3n}&gt;\min_{1\leq i&lt;n}\frac{(|a_{i}|-|a_{i+1}|)^{2}}{3n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p12" class="ltx_para">
<p id="A3.p12.1" class="ltx_p">We can just use the first two elements in the sorted array for fast computation and estimation of the lower bound of <math id="A3.p12.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>, so we have a lower bound</p>
</div>
<div id="A3.p13" class="ltx_para">
<table id="A3.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex44.m1" class="ltx_Math" alttext="\displaystyle\lambda&gt;\frac{(|a_{1}|-|a_{2}|)^{2}}{3n}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><msub><mi>a</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\lambda&gt;\frac{(|a_{1}|-|a_{2}|)^{2}}{3n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p14" class="ltx_para">
<p id="A3.p14.1" class="ltx_p">Next, we deduce the upper bound for <math id="A3.p14.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> with a similar method. Considering the case of one group, the cost is</p>
</div>
<div id="A3.p15" class="ltx_para">
<table id="A3.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex45.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{|\boldsymbol{A}|}|\boldsymbol{A}|Var(\tilde{\boldsymbol{A}})+\frac{\lambda}{|\boldsymbol{A}|}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{|\boldsymbol{A}|}|\boldsymbol{A}|Var(\tilde{\boldsymbol{A}})+\frac{\lambda}{|\boldsymbol{A}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex46.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex46.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{n}nVar(\tilde{\boldsymbol{A}})+\frac{\lambda}{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mi>n</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n}nVar(\tilde{\boldsymbol{A}})+\frac{\lambda}{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex47"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex47.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex47.m2" class="ltx_Math" alttext="\displaystyle Var(\tilde{\boldsymbol{A}})+\frac{\lambda}{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mi>n</mi></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle Var(\tilde{\boldsymbol{A}})+\frac{\lambda}{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p16" class="ltx_para">
<p id="A3.p16.1" class="ltx_p">Considering two group of matrix <math id="A3.p16.m1" class="ltx_Math" alttext="\boldsymbol{A}_{1},\boldsymbol{A}_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝑨</mi><mn>1</mn></msub><mo>,</mo><msub><mi>𝑨</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{A}_{1},\boldsymbol{A}_{2}</annotation></semantics></math> split at <math id="A3.p16.m2" class="ltx_Math" alttext="k^{\text{th}}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mtext>th</mtext></msup><annotation encoding="application/x-tex">k^{\text{th}}</annotation></semantics></math> sorted non-zero element of <math id="A3.p16.m3" class="ltx_Math" alttext="\boldsymbol{A}" display="inline" intent=":literal"><semantics><mi>𝑨</mi><annotation encoding="application/x-tex">\boldsymbol{A}</annotation></semantics></math>, the cost is</p>
</div>
<div id="A3.p17" class="ltx_para">
<table id="A3.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex48"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex48.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{|\boldsymbol{A}|}|\boldsymbol{A}_{1}|Var(\tilde{\boldsymbol{A}_{1}})+\frac{\lambda}{|\boldsymbol{A}_{1}|}+\frac{1}{|\boldsymbol{A}|}|\boldsymbol{A}_{2}|Var(\tilde{\boldsymbol{A}_{2}})+\frac{\lambda}{|\boldsymbol{A}_{2}|}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo fence="false">|</mo><mrow><mrow><msub><mi>𝑨</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mn>1</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi>𝑨</mi><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝑨</mi><mn>2</mn></msub></mrow><mo fence="false">|</mo><mrow><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>2</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mrow><mo stretchy="false">|</mo><msub><mi>𝑨</mi><mn>2</mn></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{|\boldsymbol{A}|}|\boldsymbol{A}_{1}|Var(\tilde{\boldsymbol{A}_{1}})+\frac{\lambda}{|\boldsymbol{A}_{1}|}+\frac{1}{|\boldsymbol{A}|}|\boldsymbol{A}_{2}|Var(\tilde{\boldsymbol{A}_{2}})+\frac{\lambda}{|\boldsymbol{A}_{2}|}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex49"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex49.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex49.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{n}\left(kVar(\tilde{\boldsymbol{A}_{1}})+(n-k)Var(\tilde{\boldsymbol{A}_{2}})\right)+\frac{\lambda}{k}+\frac{\lambda}{n-k}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>2</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mi>k</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n}\left(kVar(\tilde{\boldsymbol{A}_{1}})+(n-k)Var(\tilde{\boldsymbol{A}_{2}})\right)+\frac{\lambda}{k}+\frac{\lambda}{n-k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p18" class="ltx_para">
<p id="A3.p18.1" class="ltx_p">If we want to have at least 2 group, (<a href="#A3.Ex49" title="Equation 9 ‣ Appendix C Determining the Boundary of 𝜆 ‣ Calibration and Transformation-Free Weight-Only LLMs Quantization via Dynamic Grouping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>) <math id="A3.p18.m1" class="ltx_Math" alttext="&lt;" display="inline" intent=":literal"><semantics><mo>&lt;</mo><annotation encoding="application/x-tex">&lt;</annotation></semantics></math> (<a href="#A3.Ex47" title="Equation 8 ‣ Appendix C Determining the Boundary of 𝜆 ‣ Calibration and Transformation-Free Weight-Only LLMs Quantization via Dynamic Grouping" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>),</p>
</div>
<div id="A3.p19" class="ltx_para">
<table id="A3.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex50.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{n}\left(k\,\text{Var}(\tilde{\boldsymbol{A}_{1}})+(n-k)\,\text{Var}(\tilde{\boldsymbol{A}_{2}})\right)+\frac{\lambda}{k}+\frac{\lambda}{n-k}&lt;\text{Var}(\tilde{\boldsymbol{A}})+\frac{\lambda}{n}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>n</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>k</mi><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>2</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mi>k</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow></mfrac></mstyle></mrow><mo>&lt;</mo><mrow><mrow><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>λ</mi><mi>n</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{n}\left(k\,\text{Var}(\tilde{\boldsymbol{A}_{1}})+(n-k)\,\text{Var}(\tilde{\boldsymbol{A}_{2}})\right)+\frac{\lambda}{k}+\frac{\lambda}{n-k}&lt;\text{Var}(\tilde{\boldsymbol{A}})+\frac{\lambda}{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex51.m1" class="ltx_Math" alttext="\displaystyle k\,\text{Var}(\tilde{\boldsymbol{A}_{1}})+(n-k)\,\text{Var}(\tilde{\boldsymbol{A}_{2}})+\frac{n\lambda}{k}+\frac{n\lambda}{n-k}&lt;n\,\text{Var}(\tilde{\boldsymbol{A}})+\lambda" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>k</mi><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>2</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mi>k</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow></mfrac></mstyle></mrow><mo>&lt;</mo><mrow><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>λ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle k\,\text{Var}(\tilde{\boldsymbol{A}_{1}})+(n-k)\,\text{Var}(\tilde{\boldsymbol{A}_{2}})+\frac{n\lambda}{k}+\frac{n\lambda}{n-k}&lt;n\,\text{Var}(\tilde{\boldsymbol{A}})+\lambda</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52.m1" class="ltx_Math" alttext="\displaystyle\frac{n\lambda}{k}+\frac{n\lambda}{n-k}-\lambda&lt;n\,\text{Var}(\tilde{\boldsymbol{A}})-\left(k\,\text{Var}(\tilde{\boldsymbol{A}_{1}})+(n-k)\,\text{Var}(\tilde{\boldsymbol{A}_{2}})\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mi>k</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi></mrow><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow></mfrac></mstyle></mrow><mo>−</mo><mi>λ</mi></mrow><mo>&lt;</mo><mrow><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo>(</mo><mrow><mrow><mi>k</mi><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>2</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{n\lambda}{k}+\frac{n\lambda}{n-k}-\lambda&lt;n\,\text{Var}(\tilde{\boldsymbol{A}})-\left(k\,\text{Var}(\tilde{\boldsymbol{A}_{1}})+(n-k)\,\text{Var}(\tilde{\boldsymbol{A}_{2}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex53.m1" class="ltx_Math" alttext="\displaystyle\lambda\left(\frac{n}{k}+\frac{n}{n-k}-1\right)&lt;n\,\text{Var}(\tilde{\boldsymbol{A}})-\left(k\,\text{Var}(\tilde{\boldsymbol{A}_{1}})+(n-k)\,\text{Var}(\tilde{\boldsymbol{A}_{2}})\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>n</mi><mi>k</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>n</mi><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow></mfrac></mstyle></mrow><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>&lt;</mo><mrow><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo>(</mo><mrow><mrow><mi>k</mi><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>2</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lambda\left(\frac{n}{k}+\frac{n}{n-k}-1\right)&lt;n\,\text{Var}(\tilde{\boldsymbol{A}})-\left(k\,\text{Var}(\tilde{\boldsymbol{A}_{1}})+(n-k)\,\text{Var}(\tilde{\boldsymbol{A}_{2}})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex54.m1" class="ltx_Math" alttext="\displaystyle\lambda&lt;\frac{n\,\text{Var}(\tilde{\boldsymbol{A}})-\left(k\,\text{Var}(\tilde{\boldsymbol{A}_{1}})+(n-k)\,\text{Var}(\tilde{\boldsymbol{A}_{2}})\right)}{\frac{n}{k}+\frac{n}{n-k}-1}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&lt;</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>n</mi><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo>(</mo><mrow><mrow><mi>k</mi><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mtext>Var</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><msub><mi>𝑨</mi><mn>2</mn></msub><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mrow><mrow><mfrac><mi>n</mi><mi>k</mi></mfrac><mo>+</mo><mfrac><mi>n</mi><mrow><mi>n</mi><mo>−</mo><mi>k</mi></mrow></mfrac></mrow><mo>−</mo><mn>1</mn></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\lambda&lt;\frac{n\,\text{Var}(\tilde{\boldsymbol{A}})-\left(k\,\text{Var}(\tilde{\boldsymbol{A}_{1}})+(n-k)\,\text{Var}(\tilde{\boldsymbol{A}_{2}})\right)}{\frac{n}{k}+\frac{n}{n-k}-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p20" class="ltx_para">
<p id="A3.p20.1" class="ltx_p">Notice we can simplify the above expression by rewriting <math id="A3.p20.m1" class="ltx_Math" alttext="nVar(\tilde{\boldsymbol{A}})" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">nVar(\tilde{\boldsymbol{A}})</annotation></semantics></math></p>
</div>
<div id="A3.p21" class="ltx_para">
<table id="A3.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex55.m1" class="ltx_Math" alttext="\displaystyle nVar(\tilde{\boldsymbol{A}})=\sum_{x\in\tilde{\boldsymbol{A}}}(x-\mu)^{2}=\sum_{x_{1}\in\tilde{\boldsymbol{A}_{1}}}(x_{1}-\mu)^{2}+\sum_{x_{2}\in\tilde{\boldsymbol{A}_{2}}}(x_{2}-\mu)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∈</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>∈</mo><mover accent="true"><msub><mi>𝑨</mi><mn>2</mn></msub><mo>~</mo></mover></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>2</mn></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle nVar(\tilde{\boldsymbol{A}})=\sum_{x\in\tilde{\boldsymbol{A}}}(x-\mu)^{2}=\sum_{x_{1}\in\tilde{\boldsymbol{A}_{1}}}(x_{1}-\mu)^{2}+\sum_{x_{2}\in\tilde{\boldsymbol{A}_{2}}}(x_{2}-\mu)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.p22" class="ltx_para">
<p id="A3.p22.1" class="ltx_p">Where <math id="A3.p22.m1" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> is the average of elements of <math id="A3.p22.m2" class="ltx_Math" alttext="\tilde{\boldsymbol{A}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>𝑨</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{\boldsymbol{A}}</annotation></semantics></math>. Notice</p>
</div>
<div id="A3.p23" class="ltx_para">
<table id="A3.EGx27" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex56.m1" class="ltx_Math" alttext="\displaystyle\sum_{x_{1}\in\tilde{\boldsymbol{A}_{1}}}(x_{1}-\mu)^{2}=\sum_{x_{1}\in\tilde{\boldsymbol{A}_{1}}}((x_{1}-\mu_{1})+(\mu_{1}-\mu))^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∈</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∈</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo>+</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{x_{1}\in\tilde{\boldsymbol{A}_{1}}}(x_{1}-\mu)^{2}=\sum_{x_{1}\in\tilde{\boldsymbol{A}_{1}}}((x_{1}-\mu_{1})+(\mu_{1}-\mu))^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex57.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex57.m2" class="ltx_Math" alttext="\displaystyle\sum_{x_{1}\in\tilde{\boldsymbol{A}_{1}}}(x_{1}-\mu_{1})^{2}+2(x_{1}-\mu_{1})(\mu_{1}-\mu)+(\mu_{1}-\mu)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>∈</mo><mover accent="true"><msub><mi>𝑨</mi><mn>1</mn></msub><mo>~</mo></mover></mrow></munder></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>x</mi><mn>1</mn></msub><mo>−</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>1</mn></msub><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{x_{1}\in\tilde{\boldsymbol{A}_{1}}}(x_{1}-\mu_{1})^{2}+2(x_{1}-\mu_{1})(\mu_{1}-\mu)+(\mu_{1}-\mu)^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex58.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
