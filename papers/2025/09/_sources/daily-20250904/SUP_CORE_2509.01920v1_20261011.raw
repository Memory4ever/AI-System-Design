<td id="S5.T1.7.1.2.9" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="S5.T1.7.1.2.9.1" class="ltx_text ltx_markedasmath">G (<math id="S5.T1.m13.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>)</span></td>
