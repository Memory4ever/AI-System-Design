<td id="S5.T1.7.1.2.12" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:-1pt;padding-bottom:-1pt;"><math id="S5.T1.m16" class="ltx_Math" alttext="\overline{K}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>K</mi><mo stretchy="true">¯</mo></mover><annotation encoding="application/x-tex">\overline{K}</annotation></semantics></math></td></tr>
