<tr id="S4.T1.6.6" class="ltx_tr">
<td id="S4.T1.6.6.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" rowspan="3"><span id="S4.T1.6.6.1.1" class="ltx_text ltx_font_bold">General Capability</span></td>
