<figure id="A2.F13" class="ltx_figure"><img src="2509.02208v1/case1_gpt.png" id="A2.F13.g1" class="ltx_graphics ltx_centering ltx_img_portrait" style="aspect-ratio:476/733;" width="476" height="733" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A2.F13.3" class="ltx_text" style="font-size:90%;">Figure 13</span>: </span><span id="A2.F13.4" class="ltx_text" style="font-size:90%;">Gestational Diabetes case responded by gpt-oss-120b.</span></figcaption>
