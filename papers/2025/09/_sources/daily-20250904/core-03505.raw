<p id="A2.SS2.SSS1.p6.11" class="ltx_p"><span id="A2.SS2.SSS1.p6.11.1" class="ltx_text">Here the third equation is due to:</span></p>
<table id="A2.E12" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E12X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E12X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}}\left[\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo fence="false">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}}\left[\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E12X.m3" class="ltx_Math" alttext="\displaystyle=\int_{\Omega^{k}}\frac{\nabla_{\theta}q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)}{q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)}\cdot p\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\mathrm{d}\mathbf{X}^{\text{te}}_{\gamma}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi mathvariant="normal">Ω</mi><mi>k</mi></msup></msub></mstyle><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mrow><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\Omega^{k}}\frac{\nabla_{\theta}q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)}{q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)}\cdot p\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\mathrm{d}\mathbf{X}^{\text{te}}_{\gamma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(12)</span></td></tr>
<tr id="A2.E12Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E12Xa.m2" class="ltx_Math" alttext="\displaystyle=\int_{\Omega^{k}}\nabla_{\theta}q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\mathrm{d}\mathbf{X}^{\text{te}}_{\gamma}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi mathvariant="normal">Ω</mi><mi>k</mi></msup></msub></mstyle><mrow><mrow><msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\int_{\Omega^{k}}\nabla_{\theta}q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\mathrm{d}\mathbf{X}^{\text{te}}_{\gamma}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E12Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E12Xb.m2" class="ltx_Math" alttext="\displaystyle=\nabla_{\theta}\int_{\Omega^{k}}q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\mathrm{d}\mathbf{X}^{\text{te}}_{\gamma}=\nabla_{\theta}1=0." display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mstyle displaystyle="true"><mo>∫</mo></mstyle><msub><mrow></mrow><msup><mi mathvariant="normal">Ω</mi><mi>k</mi></msup></msub><mi>q</mi><msub><mrow></mrow><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo>(</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mi>γ</mi></msub><mo lspace="0em" rspace="0em">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mrow><mo>−</mo><mi>γ</mi></mrow></msub><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>)</mo><mi>d</mi><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mi>γ</mi></msub><mo>=</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mn>1</mn><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\nabla_{\theta}\int_{\Omega^{k}}q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\mathrm{d}\mathbf{X}^{\text{te}}_{\gamma}=\nabla_{\theta}1=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p6.12" class="ltx_p"><span id="A2.SS2.SSS1.p6.12.1" class="ltx_text">In addition, since <math id="A2.SS2.SSS1.p6.m17" class="ltx_Math" alttext="A\succeq 0" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⪰</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">A\succeq 0</annotation></semantics></math>, we have</span></p>
<table id="A2.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex36.m1" class="ltx_Math" alttext="\nabla^{2}_{\theta}L_{k+1}(\theta^{*})=A+B+B^{\top}+C=A+\nabla^{2}_{\theta}L_{k}(\theta^{*})\succeq\nabla^{2}_{\theta}L_{k}(\theta^{*})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi><mo>+</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo>+</mo><mi>C</mi></mrow><mo>=</mo><mrow><mi>A</mi><mo>+</mo><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⪰</mo><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla^{2}_{\theta}L_{k+1}(\theta^{*})=A+B+B^{\top}+C=A+\nabla^{2}_{\theta}L_{k}(\theta^{*})\succeq\nabla^{2}_{\theta}L_{k}(\theta^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p6.13" class="ltx_p"><span id="A2.SS2.SSS1.p6.13.1" class="ltx_text">Noting that <math id="A2.SS2.SSS1.p6.m18" class="ltx_Math" alttext="\Gamma_{k}=\big(\nabla^{2}_{\theta}L_{k}(\theta^{*})\big)^{-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub><mo>=</mo><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\Gamma_{k}=\big(\nabla^{2}_{\theta}L_{k}(\theta^{*})\big)^{-1}</annotation></semantics></math> by <a href="#A2.E10" title="In Proof of . ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">10</span></a>, it follows that <math id="A2.SS2.SSS1.p6.m19" class="ltx_Math" alttext="\Gamma_{k+1}\preceq\Gamma_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Γ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>⪯</mo><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">\Gamma_{k+1}\preceq\Gamma_{k}</annotation></semantics></math>. Now the claim follows.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.2.2 </span>Generalization for Joint Distribution Learning</h4>

<div id="A2.SS2.SSS2.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS2.p1.1" class="ltx_p">The generalization error for joint distribution learning is characterized by a key concept termed <em id="A2.SS2.SSS2.p1.1.1" class="ltx_emph ltx_font_italic">approximate tensorization of entropy</em>. It measures the “complexity” of the distribution over <math id="A2.SS2.SSS2.p1.m1" class="ltx_Math" alttext="(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> by evaluating how easily an algorithm can generate samples from the joint distribution <math id="A2.SS2.SSS2.p1.m2" class="ltx_Math" alttext="q(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> with access to local conditional distributions <math id="A2.SS2.SSS2.p1.m3" class="ltx_math_unparsed" alttext="q(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})</annotation></semantics></math>. Technically, approximate tensorization of entropy is associated with the mixing time of Gibbs sampling dynamics, which is the sample generation algorithm to be considered.</p>
</div>
<div id="A2.Thmdefinition1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmdefinition1.2" class="ltx_text ltx_font_bold">Definition B.1</span></span><span id="A2.Thmdefinition1.3" class="ltx_text ltx_font_bold"> </span>(Approximate Tensorization of Entropy <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib15" title="" class="ltx_ref">Caputo &amp; Parisi, 2021</a>)</cite>)<span id="A2.Thmdefinition1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmdefinition1.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmdefinition1.p1.1" class="ltx_p">For a distribution <math id="A2.Thmdefinition1.p1.m1" class="ltx_Math" alttext="q(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> and the set of <math id="A2.Thmdefinition1.p1.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-cell masks <math id="A2.Thmdefinition1.p1.m3" class="ltx_Math" alttext="\Pi_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Pi_{k}</annotation></semantics></math>, if there exists a constant <math id="A2.Thmdefinition1.p1.m4" class="ltx_Math" alttext="C_{k}(q)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{k}(q)</annotation></semantics></math> depending on <math id="A2.Thmdefinition1.p1.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> and <math id="A2.Thmdefinition1.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>, such that for any distribution <math id="A2.Thmdefinition1.p1.m7" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> over <math id="A2.Thmdefinition1.p1.m8" class="ltx_Math" alttext="(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math>,</p>
<table id="A2.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex37.m1" class="ltx_math_unparsed" alttext="D_{\operatorname{KL}}(r\parallel q)\leq C_{k}(q)\cdot\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right]," display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><msub><mi>C</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>q</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">D_{\operatorname{KL}}(r\parallel q)\leq C_{k}(q)\cdot\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmdefinition1.p1.2" class="ltx_p">then <math id="A2.Thmdefinition1.p1.m9" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> satisfies approximate tensorization of entropy with respect to the constant <math id="A2.Thmdefinition1.p1.m10" class="ltx_Math" alttext="C_{k}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>k</mi></msub><annotation encoding="application/x-tex">C_{k}</annotation></semantics></math> and the mask set <math id="A2.Thmdefinition1.p1.m11" class="ltx_Math" alttext="\Pi_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Pi_{k}</annotation></semantics></math>. Let <math id="A2.Thmdefinition1.p1.m12" class="ltx_Math" alttext="\underline{C_{k}}(q)" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{C_{k}}(q)</annotation></semantics></math> be the minimum of all possible constants <math id="A2.Thmdefinition1.p1.m13" class="ltx_Math" alttext="C_{k}(q)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{k}(q)</annotation></semantics></math> such that <math id="A2.Thmdefinition1.p1.m14" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> satisfies approximate tensorization of entropy.</p>
</div>
</div>
<div id="A2.SS2.SSS2.p2" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS2.p2.1" class="ltx_p">Before presenting the main result, we introduce a few regularity conditions in the parametric class <math id="A2.SS2.SSS2.p2.m1" class="ltx_Math" alttext="q_{\theta}(\mathbf{X}^{\text{te}}|\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\theta}(\mathbf{X}^{\text{te}}|\mathbf{X}^{\text{ct}})</annotation></semantics></math> that defines the model.</p>
</div>
<div id="A2.Thmassumption1" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmassumption1.2" class="ltx_text ltx_font_bold">Assumption B.1</span></span><span id="A2.Thmassumption1.3" class="ltx_text ltx_font_bold"> </span>(Regularity Conditions in the Parametric Class <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib61" title="" class="ltx_ref">Li et al., 2024c</a>)</cite>)<span id="A2.Thmassumption1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmassumption1.p1" class="ltx_para">
<ol id="A2.I2" class="ltx_enumerate ltx_leftmargin_flush">
<li id="A2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A2.I2.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I2.i1.p1.1" class="ltx_p">There exists <math id="A2.I2.i1.p1.m1" class="ltx_Math" alttext="\beta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in(0,1)</annotation></semantics></math> such that <math id="A2.I2.i1.p1.m2" class="ltx_Math" alttext="\forall\penalty\ 1\leq k\leq d,\forall\penalty\ \pi\in\Pi_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mn> 1</mn></mrow><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>d</mi></mrow><mo>,</mo><mrow><mrow><mo rspace="0.667em">∀</mo><mi>π</mi></mrow><mo>∈</mo><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\forall\penalty\ 1\leq k\leq d,\forall\penalty\ \pi\in\Pi_{k}</annotation></semantics></math> and <math id="A2.I2.i1.p1.m3" class="ltx_Math" alttext="\forall\penalty\ \theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.667em">∀</mo><mi>θ</mi></mrow><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\forall\penalty\ \theta\in\Theta</annotation></semantics></math>, <math id="A2.I2.i1.p1.m4" class="ltx_Math" alttext="p(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})&gt;0</annotation></semantics></math> implies <math id="A2.I2.i1.p1.m5" class="ltx_Math" alttext="q_{\theta}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})&gt;\beta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">q_{\theta}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})&gt;\beta</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A2.I2.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I2.i2.p1.1" class="ltx_p">For any <math id="A2.I2.i2.p1.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math>, there exists a partition <math id="A2.I2.i2.p1.m2" class="ltx_Math" alttext="\text{Par}(\Theta)=\{\Theta_{1},\dots,\Theta_{|\text{Par}(\Theta)|}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>Par</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">|</mo><mrow><mtext>Par</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Par}(\Theta)=\{\Theta_{1},\dots,\Theta_{|\text{Par}(\Theta)|}\}</annotation></semantics></math> of <math id="A2.I2.i2.p1.m3" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math>, such that <math id="A2.I2.i2.p1.m4" class="ltx_Math" alttext="\forall\penalty\ 1\leq k\leq d,\forall\penalty\ \pi\in\Pi_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∀</mo><mn> 1</mn></mrow><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>d</mi></mrow><mo>,</mo><mrow><mrow><mo rspace="0.667em">∀</mo><mi>π</mi></mrow><mo>∈</mo><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\forall\penalty\ 1\leq k\leq d,\forall\penalty\ \pi\in\Pi_{k}</annotation></semantics></math>, <math id="A2.I2.i2.p1.m5" class="ltx_Math" alttext="\forall\penalty\ \Theta_{i}\in\text{Par}(\Theta)" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.667em">∀</mo><msub><mi mathvariant="normal">Θ</mi><mi>i</mi></msub></mrow><mo>∈</mo><mrow><mtext>Par</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\forall\penalty\ \Theta_{i}\in\text{Par}(\Theta)</annotation></semantics></math>, <math id="A2.I2.i2.p1.m6" class="ltx_Math" alttext="\forall\penalty\ \theta_{1},\theta_{2}\in\Theta_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.667em">∀</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>∈</mo><msub><mi mathvariant="normal">Θ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\forall\penalty\ \theta_{1},\theta_{2}\in\Theta_{i}</annotation></semantics></math>, and any <math id="A2.I2.i2.p1.m7" class="ltx_Math" alttext="(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math>,</p>
<table id="A2.Ex38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex38.m1" class="ltx_Math" alttext="\left|\log q_{\theta_{1}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})-\log q_{\theta_{2}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\right|\leq\frac{\epsilon}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><msub><mi>θ</mi><mn>1</mn></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><msub><mi>θ</mi><mn>2</mn></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mfrac><mi>ϵ</mi><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\log q_{\theta_{1}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})-\log q_{\theta_{2}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\right|\leq\frac{\epsilon}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I2.i2.p1.2" class="ltx_p">Let <math id="A2.I2.i2.p1.m8" class="ltx_Math" alttext="N(\Theta,\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N(\Theta,\epsilon)</annotation></semantics></math> be the cardinality of the smallest partition <math id="A2.I2.i2.p1.m9" class="ltx_Math" alttext="\text{Par}(\Theta)" display="inline" intent=":literal"><semantics><mrow><mtext>Par</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Par}(\Theta)</annotation></semantics></math> that satisfies the condition above.</p>
</div></li>
</ol>
</div>
</div>
<div id="A2.SS2.SSS2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS2.p3.1" class="ltx_p">The first assumption implies that the true distribution <math id="A2.SS2.SSS2.p3.m1" class="ltx_math_unparsed" alttext="p(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})</annotation></semantics></math> supports the parametric distribution <math id="A2.SS2.SSS2.p3.m2" class="ltx_math_unparsed" alttext="q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})</annotation></semantics></math> . The second assumption specifies the covering number of the parameter space <math id="A2.SS2.SSS2.p3.m3" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math> and the lipschitz continuity of the log-likelihood loss function.</p>
</div>
<div id="A2.Thmtheorem5" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem5.2" class="ltx_text ltx_font_bold">Theorem B.5</span></span><span id="A2.Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(Formal Version of <a href="#S6.Thmtheorem3" title="Theorem 6.3 (Informal; See ). ‣ Generalization for joint distribution learning. ‣ 6.2 The Choice of Mask Number ‣ 6 Theoretical Analysis on Context-Conditional Masked Modeling ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">6.3</span></a>)<span id="A2.Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem5.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem5.p1.1" class="ltx_p"><span id="A2.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">For <math id="A2.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\theta\in\Theta</annotation></semantics></math>, assume <math id="A2.Thmtheorem5.p1.m2" class="ltx_Math" alttext="q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> satisfies approximate tensorization of entropy with respect to some constant <math id="A2.Thmtheorem5.p1.m3" class="ltx_Math" alttext="C_{1}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{1}(q_{\theta})</annotation></semantics></math> and the mask set <math id="A2.Thmtheorem5.p1.m4" class="ltx_Math" alttext="\Pi_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Pi_{1}</annotation></semantics></math>. Then for any <math id="A2.Thmtheorem5.p1.m5" class="ltx_Math" alttext="1\leq k\leq d" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq d</annotation></semantics></math>, <math id="A2.Thmtheorem5.p1.m6" class="ltx_Math" alttext="q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> satisfies approximate tensorization of entropy with respect to some constant <math id="A2.Thmtheorem5.p1.m7" class="ltx_Math" alttext="C_{k}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{k}(q_{\theta})</annotation></semantics></math> and the mask set <math id="A2.Thmtheorem5.p1.m8" class="ltx_Math" alttext="\Pi_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Pi_{k}</annotation></semantics></math>. Furthermore, <math id="A2.Thmtheorem5.p1.m9" class="ltx_Math" alttext="\underline{C_{k+1}}(q_{\theta})\leq\underline{C_{k}}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><msub><mi>C</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{C_{k+1}}(q_{\theta})\leq\underline{C_{k}}(q_{\theta})</annotation></semantics></math>.</span></p>
</div>
<div id="A2.Thmtheorem5.p2" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem5.p2.1" class="ltx_p"><span id="A2.Thmtheorem5.p2.1.1" class="ltx_text ltx_font_italic">Under <a href="#A2.Thmassumption1" title="Assumption B.1 (Regularity Conditions in the Parametric Class ( , )). ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">B.1</span></a>, for any <math id="A2.Thmtheorem5.p2.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math> and any <math id="A2.Thmtheorem5.p2.m2" class="ltx_Math" alttext="\delta\in(0,\frac{1}{d})" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,\frac{1}{d})</annotation></semantics></math>, with probability at least <math id="A2.Thmtheorem5.p2.m3" class="ltx_Math" alttext="1-d\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">1-d\delta</annotation></semantics></math>, for any <math id="A2.Thmtheorem5.p2.m4" class="ltx_Math" alttext="1\leq k\leq d" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq d</annotation></semantics></math> and any <math id="A2.Thmtheorem5.p2.m5" class="ltx_Math" alttext="\theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\theta\in\Theta</annotation></semantics></math>,</span></p>
<table id="A2.Ex39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex39.m1" class="ltx_math_unparsed" alttext="\mathbb{E}_{\mathbf{X}^{\text{ct}}\sim p}\left[D_{\operatorname{TV}}(q_{\theta}(\cdot|\mathbf{X}^{\text{ct}})\parallel p(\cdot|\mathbf{X}^{\text{ct}}))\right]&lt;\sqrt{\frac{1}{2}\underline{C_{k}}(q_{\theta})\left(\hat{L}_{k}(\theta)+B\log\frac{1}{\beta}+\epsilon\right)+C}," display="block" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">ct</mtext></msup><mo>∼</mo><mi>p</mi></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>TV</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">ct</mtext></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">ct</mtext></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>&lt;</mo><msqrt><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>B</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>β</mi></mfrac></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mi>C</mi></mrow></msqrt><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mathbf{X}^{\text{ct}}\sim p}\left[D_{\operatorname{TV}}(q_{\theta}(\cdot|\mathbf{X}^{\text{ct}})\parallel p(\cdot|\mathbf{X}^{\text{ct}}))\right]&lt;\sqrt{\frac{1}{2}\underline{C_{k}}(q_{\theta})\left(\hat{L}_{k}(\theta)+B\log\frac{1}{\beta}+\epsilon\right)+C},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem5.p2.2" class="ltx_p"><span id="A2.Thmtheorem5.p2.2.1" class="ltx_text ltx_font_italic">where <math id="A2.Thmtheorem5.p2.m6" class="ltx_Math" alttext="B=\sqrt{\frac{1}{\delta}\cdot(8|\Omega|)^{d(m+1)}N(\Theta,\epsilon)}+\sqrt{\frac{1}{2n}\cdot\log\frac{8N(\Theta,\epsilon)}{\delta}}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><msqrt><mrow><mrow><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><msqrt><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">B=\sqrt{\frac{1}{\delta}\cdot(8|\Omega|)^{d(m+1)}N(\Theta,\epsilon)}+\sqrt{\frac{1}{2n}\cdot\log\frac{8N(\Theta,\epsilon)}{\delta}}</annotation></semantics></math>, and
<math id="A2.Thmtheorem5.p2.m7" class="ltx_Math" alttext="C=\sqrt{\frac{|\Omega|^{3d(m+1)}}{8\delta n}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><msqrt><mfrac><msup><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">|</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></msqrt></mrow><annotation encoding="application/x-tex">C=\sqrt{\frac{|\Omega|^{3d(m+1)}}{8\delta n}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS2.SSS2.p4" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS2.p4.1" class="ltx_p">With a sufficiently large sample size <math id="A2.SS2.SSS2.p4.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> and a sufficiently small loss value <math id="A2.SS2.SSS2.p4.m2" class="ltx_Math" alttext="\hat{L}_{k}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{L}_{k}(\theta)</annotation></semantics></math>, the upper bound is dominated by the term <math id="A2.SS2.SSS2.p4.m3" class="ltx_Math" alttext="\sqrt{\frac{1}{2}\underline{C_{k}}(q_{\theta})(B\log\frac{1}{\beta}+\epsilon)}" display="inline" intent=":literal"><semantics><msqrt><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>B</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>β</mi></mfrac></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{\frac{1}{2}\underline{C_{k}}(q_{\theta})(B\log\frac{1}{\beta}+\epsilon)}</annotation></semantics></math>, which is scaled by <math id="A2.SS2.SSS2.p4.m4" class="ltx_Math" alttext="\underline{C_{k}}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{C_{k}}(q_{\theta})</annotation></semantics></math>, the constant for the approximate tensorization of entropy. The theorem implies a reduced upper bound for the estimation error of the joint distribution with an increasing number of masked cells.</p>
</div>
<div id="A2.SS2.SSS2.p5" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS2.p5.1" class="ltx_p">We prove the monotonicity of <math id="A2.SS2.SSS2.p5.m1" class="ltx_Math" alttext="\underline{C_{k}}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{C_{k}}(q_{\theta})</annotation></semantics></math> with respect to <math id="A2.SS2.SSS2.p5.m2" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> in <a href="#A2.Thmtheorem6" title="Proposition B.6. ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">B.6</span></a>, and prove the upper bound for generalization error in <a href="#A2.Thmtheorem7" title="Proposition B.7. ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">B.7</span></a>.</p>
</div>
<div id="A2.Thmtheorem6" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem6.2" class="ltx_text ltx_font_bold">Proposition B.6</span></span><span id="A2.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem6.p1" class="ltx_para">
<p id="A2.Thmtheorem6.p1.1" class="ltx_p"><span id="A2.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">For <math id="A2.Thmtheorem6.p1.m1" class="ltx_Math" alttext="\theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\theta\in\Theta</annotation></semantics></math>, assume <math id="A2.Thmtheorem6.p1.m2" class="ltx_Math" alttext="q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> satisfies approximate tensorization of entropy with respect to some constant <math id="A2.Thmtheorem6.p1.m3" class="ltx_Math" alttext="C_{1}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{1}(q_{\theta})</annotation></semantics></math> and the mask set <math id="A2.Thmtheorem6.p1.m4" class="ltx_Math" alttext="\Pi_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Pi_{1}</annotation></semantics></math>. Then for any <math id="A2.Thmtheorem6.p1.m5" class="ltx_Math" alttext="1\leq k\leq d" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq d</annotation></semantics></math>, <math id="A2.Thmtheorem6.p1.m6" class="ltx_Math" alttext="q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> satisfies approximate tensorization of entropy with respect to some constant <math id="A2.Thmtheorem6.p1.m7" class="ltx_Math" alttext="C_{k}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{k}(q_{\theta})</annotation></semantics></math> and the mask set <math id="A2.Thmtheorem6.p1.m8" class="ltx_Math" alttext="\Pi_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Pi_{k}</annotation></semantics></math>. Furthermore, <math id="A2.Thmtheorem6.p1.m9" class="ltx_Math" alttext="\underline{C_{k+1}}(q_{\theta})\leq\underline{C_{k}}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><msub><mi>C</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{C_{k+1}}(q_{\theta})\leq\underline{C_{k}}(q_{\theta})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS2.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#A2.Thmtheorem6" title="Proposition B.6. ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">B.6</span></a>.</h6>
<div id="A2.SS2.SSS2.p6" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS2.p6.1" class="ltx_p"><span id="A2.SS2.SSS2.p6.1.1" class="ltx_text">Since <math id="A2.SS2.SSS2.p6.m1" class="ltx_Math" alttext="q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> satisfies approximate tensorization of entropy with respect to some constant <math id="A2.SS2.SSS2.p6.m2" class="ltx_Math" alttext="C_{1}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{1}(q_{\theta})</annotation></semantics></math> and the mask set <math id="A2.SS2.SSS2.p6.m3" class="ltx_Math" alttext="\Pi_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Pi_{1}</annotation></semantics></math>, for any distribution <math id="A2.SS2.SSS2.p6.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> over <math id="A2.SS2.SSS2.p6.m5" class="ltx_Math" alttext="(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math>,</span></p>
<table id="A2.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex40.m1" class="ltx_math_unparsed" alttext="D_{\operatorname{KL}}(r\parallel q_{\theta})\leq C_{1}(q_{\theta})\cdot\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{1})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right]." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mo>≤</mo><msub><mi>C</mi><mn>1</mn></msub><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>q</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\operatorname{KL}}(r\parallel q_{\theta})\leq C_{1}(q_{\theta})\cdot\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{1})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS2.p6.2" class="ltx_p"><span id="A2.SS2.SSS2.p6.2.1" class="ltx_text">By <a href="#A2.Thmdefinition1" title="Definition B.1 (Approximate Tensorization of Entropy ( , )). ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Definition</span> <span class="ltx_text ltx_ref_tag">B.1</span></a>,</span></p>
<table id="A2.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex41.m1" class="ltx_math_unparsed" alttext="D_{\operatorname{KL}}(r\parallel q_{\theta})\leq\underline{C_{1}}(q_{\theta})\cdot\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{1})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right]." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mo>≤</mo><munder accentunder="true"><msub><mi>C</mi><mn>1</mn></msub><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>q</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\operatorname{KL}}(r\parallel q_{\theta})\leq\underline{C_{1}}(q_{\theta})\cdot\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{1})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS2.p6.3" class="ltx_p"><span id="A2.SS2.SSS2.p6.3.1" class="ltx_text">We prove the proposition by deduction. Assume for some <math id="A2.SS2.SSS2.p6.m6" class="ltx_Math" alttext="1\leq k&lt;d" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>&lt;</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">1\leq k&lt;d</annotation></semantics></math>, <math id="A2.SS2.SSS2.p6.m7" class="ltx_Math" alttext="q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> satisfies approximate tensorization of entropy with respect to some constant <math id="A2.SS2.SSS2.p6.m8" class="ltx_Math" alttext="C_{k}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{k}(q_{\theta})</annotation></semantics></math> and the mask set <math id="A2.SS2.SSS2.p6.m9" class="ltx_Math" alttext="\Pi_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Pi_{k}</annotation></semantics></math>. It follows that</span></p>
<table id="A2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E13.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\operatorname{KL}}(r\parallel q_{\theta})\leq\underline{C_{k}}(q_{\theta})\cdot\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right]." display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mo>≤</mo><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>q</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle D_{\operatorname{KL}}(r\parallel q_{\theta})\leq\underline{C_{k}}(q_{\theta})\cdot\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS2.p6.4" class="ltx_p"><span id="A2.SS2.SSS2.p6.4.1" class="ltx_text">We have</span></p>
<table id="A2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.E14.m1" class="ltx_Math" alttext="\displaystyle\begin{split}&amp;\quad\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k+1})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right]\\
&amp;=\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k}),a\sim\mathrm{Unif}([d]\backslash\pi)}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi\cup\{a\}})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi\cup\{a\}}))\right]\\
&amp;\geq\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k}),a\sim\mathrm{Unif}([d]\backslash\pi)}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right]\\
&amp;=\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right].\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mphantom></mphantom></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mo>[</mo><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>a</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">[</mo><mi>d</mi><mo rspace="0.222em" stretchy="false">]</mo></mrow><mo rspace="0.222em">\</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mo>[</mo><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mrow><mrow><mo>−</mo><mi>π</mi></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>a</mi><mo stretchy="false">}</mo></mrow></mrow></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mrow><mrow><mo>−</mo><mi>π</mi></mrow><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>a</mi><mo stretchy="false">}</mo></mrow></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>≥</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>a</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">[</mo><mi>d</mi><mo rspace="0.222em" stretchy="false">]</mo></mrow><mo rspace="0.222em">\</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mo>[</mo><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mo>[</mo><mi>D</mi><msub><mrow></mrow><mi>KL</mi></msub><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}&amp;\quad\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k+1})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right]\\
&amp;=\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k}),a\sim\mathrm{Unif}([d]\backslash\pi)}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi\cup\{a\}})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi\cup\{a\}}))\right]\\
&amp;\geq\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k}),a\sim\mathrm{Unif}([d]\backslash\pi)}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right]\\
&amp;=\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right].\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS2.p6.5" class="ltx_p"><span id="A2.SS2.SSS2.p6.5.1" class="ltx_text">The inequality follows from the data processing inequality:</span></p>
<table id="A2.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex42.m1" class="ltx_math_unparsed" alttext="D_{\operatorname{KL}}(p(x,y)\parallel q(x,y))=\mathbb{E}_{x}\left[D_{\operatorname{KL}}(p(y|x)\parallel q(y|x))\right]+D_{\operatorname{KL}}(p(x)\parallel q(x))\geq\mathbb{E}_{x}\left[D_{\operatorname{KL}}(p(y|x)\parallel q(y|x))\right]." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mi>x</mi></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>+</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≥</mo><msub><mi>𝔼</mi><mi>x</mi></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D_{\operatorname{KL}}(p(x,y)\parallel q(x,y))=\mathbb{E}_{x}\left[D_{\operatorname{KL}}(p(y|x)\parallel q(y|x))\right]+D_{\operatorname{KL}}(p(x)\parallel q(x))\geq\mathbb{E}_{x}\left[D_{\operatorname{KL}}(p(y|x)\parallel q(y|x))\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS2.p6.6" class="ltx_p"><span id="A2.SS2.SSS2.p6.6.1" class="ltx_text">Combining <a href="#A2.E13" title="In Proof of . ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">13</span></a> and <a href="#A2.E14" title="Equation 14 ‣ Proof of . ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>,</span></p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex43.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\operatorname{KL}}(r\parallel q_{\theta})\leq\underline{C_{k}}(q_{\theta})\cdot\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k+1})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right]." display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mo>≤</mo><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>q</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle D_{\operatorname{KL}}(r\parallel q_{\theta})\leq\underline{C_{k}}(q_{\theta})\cdot\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k+1})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi})\parallel q_{\theta}(\cdot|\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}}_{-\pi}))\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS2.p6.7" class="ltx_p"><span id="A2.SS2.SSS2.p6.7.1" class="ltx_text">Therefore, <math id="A2.SS2.SSS2.p6.m10" class="ltx_Math" alttext="q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> satisfies approximate tensorization of entropy with respect to <math id="A2.SS2.SSS2.p6.m11" class="ltx_Math" alttext="\underline{C_{k}}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\underline{C_{k}}(q_{\theta})</annotation></semantics></math> and the mask set <math id="A2.SS2.SSS2.p6.m12" class="ltx_Math" alttext="\Pi_{k+1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\Pi_{k+1}</annotation></semantics></math>. It follows that <math id="A2.SS2.SSS2.p6.m13" class="ltx_Math" alttext="\underline{C_{k+1}}(q_{\theta})\leq\underline{C_{k}}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><msub><mi>C</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\underline{C_{k+1}}(q_{\theta})\leq\underline{C_{k}}(q_{\theta})</annotation></semantics></math>. By deduction, for any <math id="A2.SS2.SSS2.p6.m14" class="ltx_Math" alttext="1\leq k\leq d" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq d</annotation></semantics></math>, <math id="A2.SS2.SSS2.p6.m15" class="ltx_Math" alttext="q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})</annotation></semantics></math> satisfies approximate tensorization of entropy with respect to some constant <math id="A2.SS2.SSS2.p6.m16" class="ltx_Math" alttext="C_{k}(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{k}(q_{\theta})</annotation></semantics></math> and the mask set <math id="A2.SS2.SSS2.p6.m17" class="ltx_Math" alttext="\Pi_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\Pi_{k}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A2.Thmtheorem7" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem7.2" class="ltx_text ltx_font_bold">Proposition B.7</span></span><span id="A2.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem7.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem7.p1.1" class="ltx_p"><span id="A2.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Under <a href="#A2.Thmassumption1" title="Assumption B.1 (Regularity Conditions in the Parametric Class ( , )). ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">B.1</span></a> and the condition in <a href="#A2.Thmtheorem6" title="Proposition B.6. ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">B.6</span></a>, for any <math id="A2.Thmtheorem7.p1.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math> and any <math id="A2.Thmtheorem7.p1.m2" class="ltx_Math" alttext="\delta\in(0,\frac{1}{d})" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,\frac{1}{d})</annotation></semantics></math>, with probability at least <math id="A2.Thmtheorem7.p1.m3" class="ltx_Math" alttext="1-d\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">1-d\delta</annotation></semantics></math>, for any <math id="A2.Thmtheorem7.p1.m4" class="ltx_Math" alttext="1\leq k\leq d" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq d</annotation></semantics></math> and any <math id="A2.Thmtheorem7.p1.m5" class="ltx_Math" alttext="\theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\theta\in\Theta</annotation></semantics></math>,</span></p>
<table id="A2.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex44.m1" class="ltx_math_unparsed" alttext="\mathbb{E}_{\mathbf{X}^{\text{ct}}\sim p}\left[D_{\operatorname{TV}}(q_{\theta}(\cdot|\mathbf{X}^{\text{ct}})\parallel p(\cdot|\mathbf{X}^{\text{ct}}))\right]&lt;\sqrt{\frac{1}{2}\underline{C_{k}}(q_{\theta})\left(\hat{L}_{k}(\theta)+B\log\frac{1}{\beta}+\epsilon\right)+C}," display="block" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">ct</mtext></msup><mo>∼</mo><mi>p</mi></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>TV</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">ct</mtext></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>𝐗</mi><mtext class="ltx_mathvariant_italic">ct</mtext></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>&lt;</mo><msqrt><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>B</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>β</mi></mfrac></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mi>C</mi></mrow></msqrt><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\mathbf{X}^{\text{ct}}\sim p}\left[D_{\operatorname{TV}}(q_{\theta}(\cdot|\mathbf{X}^{\text{ct}})\parallel p(\cdot|\mathbf{X}^{\text{ct}}))\right]&lt;\sqrt{\frac{1}{2}\underline{C_{k}}(q_{\theta})\left(\hat{L}_{k}(\theta)+B\log\frac{1}{\beta}+\epsilon\right)+C},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem7.p1.2" class="ltx_p"><span id="A2.Thmtheorem7.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A2.Thmtheorem7.p1.m6" class="ltx_Math" alttext="B=\sqrt{\frac{1}{\delta}\cdot(8|\Omega|)^{d(m+1)}N(\Theta,\epsilon)}+\sqrt{\frac{1}{2n}\cdot\log\frac{8N(\Theta,\epsilon)}{\delta}}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><msqrt><mrow><mrow><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><msqrt><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">B=\sqrt{\frac{1}{\delta}\cdot(8|\Omega|)^{d(m+1)}N(\Theta,\epsilon)}+\sqrt{\frac{1}{2n}\cdot\log\frac{8N(\Theta,\epsilon)}{\delta}}</annotation></semantics></math>, and
<math id="A2.Thmtheorem7.p1.m7" class="ltx_Math" alttext="C=\sqrt{\frac{|\Omega|^{3d(m+1)}}{8\delta n}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><msqrt><mfrac><msup><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">|</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></msqrt></mrow><annotation encoding="application/x-tex">C=\sqrt{\frac{|\Omega|^{3d(m+1)}}{8\delta n}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS2.SSS2.p7" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS2.p7.1" class="ltx_p">The proposition is a corollary from Theorem 4 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib61" title="" class="ltx_ref">Li et al. (2024c)</a></cite>, which provides an upper bound for <math id="A2.SS2.SSS2.p7.m1" class="ltx_math_unparsed" alttext="D_{\operatorname{TV}}(q_{\theta}\parallel p)" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>TV</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\operatorname{TV}}(q_{\theta}\parallel p)</annotation></semantics></math> in our setting. The remaining gap is an extension of the result to total variation between conditional distributions. We present <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib61" title="" class="ltx_ref">Li et al. (2024c)</a></cite>’s result as a lemma.</p>
</div>
<div id="A2.Thmtheorem8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem8.2" class="ltx_text ltx_font_bold">Lemma B.8</span></span><span id="A2.Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib61" title="" class="ltx_ref">Li et al. (2024c)</a></cite>, Theorem 4)<span id="A2.Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem8.p1" class="ltx_para ltx_noindent">
<p id="A2.Thmtheorem8.p1.1" class="ltx_p"><span id="A2.Thmtheorem8.p1.1.1" class="ltx_text ltx_font_italic">Consider random variables <math id="A2.Thmtheorem8.p1.m1" class="ltx_Math" alttext="\mathbf{X}\in\Omega^{d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐗</mi><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathbf{X}\in\Omega^{d}</annotation></semantics></math> and <math id="A2.Thmtheorem8.p1.m2" class="ltx_Math" alttext="\pi\subset[d]" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>⊂</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\pi\subset[d]</annotation></semantics></math>. We are given <math id="A2.Thmtheorem8.p1.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> i.i.d. samples <math id="A2.Thmtheorem8.p1.m4" class="ltx_Math" alttext="\{{\mathbf{x}}^{(i)}\}_{i=1}^{n}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>𝐱</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><annotation encoding="application/x-tex">\{{\mathbf{x}}^{(i)}\}_{i=1}^{n}</annotation></semantics></math> drawn from <math id="A2.Thmtheorem8.p1.m5" class="ltx_Math" alttext="p(\mathbf{X})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(\mathbf{X})</annotation></semantics></math>. For each sample <math id="A2.Thmtheorem8.p1.m6" class="ltx_Math" alttext="{\mathbf{x}}^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>𝐱</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\mathbf{x}}^{(i)}</annotation></semantics></math>, we observe <math id="A2.Thmtheorem8.p1.m7" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> i.i.d. masks <math id="A2.Thmtheorem8.p1.m8" class="ltx_Math" alttext="\{\pi_{j}^{(i)}\}_{j=1}^{l}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msubsup><mi>π</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></msubsup><annotation encoding="application/x-tex">\{\pi_{j}^{(i)}\}_{j=1}^{l}</annotation></semantics></math> drawn from <math id="A2.Thmtheorem8.p1.m9" class="ltx_Math" alttext="p(\pi|{\mathbf{x}}^{(i)})" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(\pi|{\mathbf{x}}^{(i)})</annotation></semantics></math>. Consider the empirical loss function:</span></p>
<table id="A2.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex45.m1" class="ltx_math_unparsed" alttext="\hat{L}(\theta)=\frac{1}{nl}\sum_{i=1}^{n}\sum_{j=1}^{l}-\log q_{\theta}\left({\mathbf{x}}_{\pi_{j}^{(i)}}^{(i)}|{\mathbf{x}}_{-\pi_{j}^{(i)}}^{(i)},\pi_{j}^{(i)}\right)." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>L</mi><mo>^</mo></mover><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mfrac><mn>1</mn><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mfrac><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>l</mi></munderover><mo lspace="0em">−</mo><mi>log</mi><msub><mi>q</mi><mi>θ</mi></msub><mrow><mo>(</mo><msubsup><mi>𝐱</mi><msubsup><mi>π</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐱</mi><mrow><mo>−</mo><msubsup><mi>π</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>π</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{L}(\theta)=\frac{1}{nl}\sum_{i=1}^{n}\sum_{j=1}^{l}-\log q_{\theta}\left({\mathbf{x}}_{\pi_{j}^{(i)}}^{(i)}|{\mathbf{x}}_{-\pi_{j}^{(i)}}^{(i)},\pi_{j}^{(i)}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem8.p1.2" class="ltx_p"><span id="A2.Thmtheorem8.p1.2.1" class="ltx_text ltx_font_italic">Suppose the following conditions are met:</span></p>
<ol id="A2.I3" class="ltx_enumerate ltx_leftmargin_flush">
<li id="A2.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A2.I3.i1.p1" class="ltx_para ltx_noindent">
<p id="A2.I3.i1.p1.1" class="ltx_p"><span id="A2.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">There exists a constant </span><math id="A2.I3.i1.p1.m1" class="ltx_Math" alttext="C(q_{\theta})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(q_{\theta})</annotation></semantics></math><span id="A2.I3.i1.p1.1.2" class="ltx_text ltx_font_italic"> depending on </span><math id="A2.I3.i1.p1.m2" class="ltx_Math" alttext="q_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">q_{\theta}</annotation></semantics></math><span id="A2.I3.i1.p1.1.3" class="ltx_text ltx_font_italic">, such that for any distribution </span><math id="A2.I3.i1.p1.m3" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math><span id="A2.I3.i1.p1.1.4" class="ltx_text ltx_font_italic"> over </span><math id="A2.I3.i1.p1.m4" class="ltx_Math" alttext="\mathbf{X}" display="inline" intent=":literal"><semantics><mi>𝐗</mi><annotation encoding="application/x-tex">\mathbf{X}</annotation></semantics></math><span id="A2.I3.i1.p1.1.5" class="ltx_text ltx_font_italic">,</span></p>
<table id="A2.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex46.m1" class="ltx_math_unparsed" alttext="D_{\operatorname{KL}}(r\parallel q)\leq C(q_{\theta})\cdot\mathbb{E}_{\mathbf{X}\sim p(\mathbf{X}),\pi\sim p(\pi|\mathbf{X})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}_{-\pi},\pi)\parallel q(\cdot|\mathbf{X}_{-\pi},\pi)\right]." display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><mrow><mi>𝐗</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo lspace="0em" rspace="0em">|</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mrow><mo>[</mo><msub><mi>D</mi><mi>KL</mi></msub><mrow><mo stretchy="false">(</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo>,</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>q</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo>,</mo><mi>π</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow></mrow><annotation encoding="application/x-tex">D_{\operatorname{KL}}(r\parallel q)\leq C(q_{\theta})\cdot\mathbb{E}_{\mathbf{X}\sim p(\mathbf{X}),\pi\sim p(\pi|\mathbf{X})}\left[D_{\operatorname{KL}}(r(\cdot|\mathbf{X}_{-\pi},\pi)\parallel q(\cdot|\mathbf{X}_{-\pi},\pi)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A2.I3.i2.p1" class="ltx_para ltx_noindent">
<p id="A2.I3.i2.p1.1" class="ltx_p"><span id="A2.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">There exists </span><math id="A2.I3.i2.p1.m1" class="ltx_Math" alttext="\beta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\beta\in(0,1)</annotation></semantics></math><span id="A2.I3.i2.p1.1.2" class="ltx_text ltx_font_italic"> such that </span><math id="A2.I3.i2.p1.m2" class="ltx_Math" alttext="\forall\penalty\ \pi\subset[d]" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.667em">∀</mo><mi>π</mi></mrow><mo>⊂</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\forall\penalty\ \pi\subset[d]</annotation></semantics></math><span id="A2.I3.i2.p1.1.3" class="ltx_text ltx_font_italic"> and </span><math id="A2.I3.i2.p1.m3" class="ltx_Math" alttext="\forall\penalty\ \theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.667em">∀</mo><mi>θ</mi></mrow><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\forall\penalty\ \theta\in\Theta</annotation></semantics></math><span id="A2.I3.i2.p1.1.4" class="ltx_text ltx_font_italic">, </span><math id="A2.I3.i2.p1.m4" class="ltx_Math" alttext="p({\mathbf{x}}_{\pi}|{\mathbf{x}}_{-\pi},\pi)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐱</mi><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo>,</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p({\mathbf{x}}_{\pi}|{\mathbf{x}}_{-\pi},\pi)&gt;0</annotation></semantics></math><span id="A2.I3.i2.p1.1.5" class="ltx_text ltx_font_italic"> implies </span><math id="A2.I3.i2.p1.m5" class="ltx_Math" alttext="q_{\theta}({\mathbf{x}}_{\pi}|{\mathbf{x}}_{-\pi},\pi)&gt;\beta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐱</mi><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo>,</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">q_{\theta}({\mathbf{x}}_{\pi}|{\mathbf{x}}_{-\pi},\pi)&gt;\beta</annotation></semantics></math><span id="A2.I3.i2.p1.1.6" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A2.I3.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A2.I3.i3.p1" class="ltx_para ltx_noindent">
<p id="A2.I3.i3.p1.1" class="ltx_p"><span id="A2.I3.i3.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="A2.I3.i3.p1.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math><span id="A2.I3.i3.p1.1.2" class="ltx_text ltx_font_italic">, there exists a partition </span><math id="A2.I3.i3.p1.m2" class="ltx_Math" alttext="\text{Par}(\Theta)=\{\Theta_{1},\dots,\Theta_{|\text{Par}(\Theta)|}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_italic">Par</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi mathvariant="normal">Θ</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mo stretchy="false">|</mo><mrow><mtext class="ltx_mathvariant_italic">Par</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Par}(\Theta)=\{\Theta_{1},\dots,\Theta_{|\text{Par}(\Theta)|}\}</annotation></semantics></math><span id="A2.I3.i3.p1.1.3" class="ltx_text ltx_font_italic"> of </span><math id="A2.I3.i3.p1.m3" class="ltx_Math" alttext="\Theta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Θ</mi><annotation encoding="application/x-tex">\Theta</annotation></semantics></math><span id="A2.I3.i3.p1.1.4" class="ltx_text ltx_font_italic">, such that </span><math id="A2.I3.i3.p1.m4" class="ltx_Math" alttext="\forall\penalty\ \pi\subset[d]" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.667em">∀</mo><mi>π</mi></mrow><mo>⊂</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\forall\penalty\ \pi\subset[d]</annotation></semantics></math><span id="A2.I3.i3.p1.1.5" class="ltx_text ltx_font_italic">, </span><math id="A2.I3.i3.p1.m5" class="ltx_Math" alttext="\forall\penalty\ \Theta_{i}\in\text{Par}(\Theta)" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.667em">∀</mo><msub><mi mathvariant="normal">Θ</mi><mi>i</mi></msub></mrow><mo>∈</mo><mrow><mtext class="ltx_mathvariant_italic">Par</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\forall\penalty\ \Theta_{i}\in\text{Par}(\Theta)</annotation></semantics></math><span id="A2.I3.i3.p1.1.6" class="ltx_text ltx_font_italic">, </span><math id="A2.I3.i3.p1.m6" class="ltx_Math" alttext="\forall\penalty\ \theta_{1},\theta_{2}\in\Theta_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.667em">∀</mo><msub><mi>θ</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><msub><mi>θ</mi><mn>2</mn></msub><mo>∈</mo><msub><mi mathvariant="normal">Θ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\forall\penalty\ \theta_{1},\theta_{2}\in\Theta_{i}</annotation></semantics></math><span id="A2.I3.i3.p1.1.7" class="ltx_text ltx_font_italic">, and any </span><math id="A2.I3.i3.p1.m7" class="ltx_Math" alttext="{\mathbf{x}}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">{\mathbf{x}}</annotation></semantics></math><span id="A2.I3.i3.p1.1.8" class="ltx_text ltx_font_italic">,</span></p>
<table id="A2.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex47.m1" class="ltx_Math" alttext="\left|\log q_{\theta_{1}}({\mathbf{x}}_{\pi}|{\mathbf{x}}_{-\pi},\pi)-\log q_{\theta_{2}}({\mathbf{x}}_{\pi}|{\mathbf{x}}_{-\pi},\pi)\right|\leq\frac{\epsilon}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><msub><mi>θ</mi><mn>1</mn></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐱</mi><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo>,</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><msub><mi>θ</mi><mn>2</mn></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐱</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">|</mo><mrow><msub><mi>𝐱</mi><mrow><mo>−</mo><mi>π</mi></mrow></msub><mo>,</mo><mi>π</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mfrac><mi>ϵ</mi><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\log q_{\theta_{1}}({\mathbf{x}}_{\pi}|{\mathbf{x}}_{-\pi},\pi)-\log q_{\theta_{2}}({\mathbf{x}}_{\pi}|{\mathbf{x}}_{-\pi},\pi)\right|\leq\frac{\epsilon}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.I3.i3.p1.2" class="ltx_p"><span id="A2.I3.i3.p1.2.1" class="ltx_text ltx_font_italic">Let </span><math id="A2.I3.i3.p1.m8" class="ltx_Math" alttext="N(\Theta,\epsilon)" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">N(\Theta,\epsilon)</annotation></semantics></math><span id="A2.I3.i3.p1.2.2" class="ltx_text ltx_font_italic"> be the cardinality of the smallest partition </span><math id="A2.I3.i3.p1.m9" class="ltx_Math" alttext="\text{Par}(\Theta)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">Par</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{Par}(\Theta)</annotation></semantics></math><span id="A2.I3.i3.p1.2.3" class="ltx_text ltx_font_italic"> that satisfies the condition above.</span></p>
</div></li>
</ol>
<p id="A2.Thmtheorem8.p1.3" class="ltx_p"><span id="A2.Thmtheorem8.p1.3.1" class="ltx_text ltx_font_italic">Then for any <math id="A2.Thmtheorem8.p1.m10" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math> and any <math id="A2.Thmtheorem8.p1.m11" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, with probability at least <math id="A2.Thmtheorem8.p1.m12" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, for any <math id="A2.Thmtheorem8.p1.m13" class="ltx_Math" alttext="\theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\theta\in\Theta</annotation></semantics></math>,</span></p>
<table id="A2.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex48.m1" class="ltx_math_unparsed" alttext="D_{\operatorname{TV}}(q_{\theta}(\mathbf{X})\parallel p(\mathbf{X}))&lt;\sqrt{\frac{1}{2}C(q_{\theta})\left(\hat{L}(\theta)+B\log\frac{1}{\beta}+\epsilon\right)+C}," display="block" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>TV</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><mi>𝐗</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><msqrt><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mover accent="true"><mi>L</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>B</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mn>1</mn><mi>β</mi></mfrac></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mi>C</mi></mrow></msqrt><mo>,</mo></mrow><annotation encoding="application/x-tex">D_{\operatorname{TV}}(q_{\theta}(\mathbf{X})\parallel p(\mathbf{X}))&lt;\sqrt{\frac{1}{2}C(q_{\theta})\left(\hat{L}(\theta)+B\log\frac{1}{\beta}+\epsilon\right)+C},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem8.p1.4" class="ltx_p"><span id="A2.Thmtheorem8.p1.4.1" class="ltx_text ltx_font_italic">where <math id="A2.Thmtheorem8.p1.m14" class="ltx_Math" alttext="B=\sqrt{\frac{1}{l\delta}\cdot(8|\Omega|)^{d}N(\Theta,\epsilon)}+\sqrt{\frac{1}{2n}\cdot\log\frac{8N(\Theta,\epsilon)}{\delta}}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><msqrt><mrow><mrow><mfrac><mn>1</mn><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><msqrt><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">B=\sqrt{\frac{1}{l\delta}\cdot(8|\Omega|)^{d}N(\Theta,\epsilon)}+\sqrt{\frac{1}{2n}\cdot\log\frac{8N(\Theta,\epsilon)}{\delta}}</annotation></semantics></math>, and
<math id="A2.Thmtheorem8.p1.m15" class="ltx_Math" alttext="C=\sqrt{\frac{|\Omega|^{3d}}{8\delta n}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><msqrt><mfrac><msup><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">|</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></msqrt></mrow><annotation encoding="application/x-tex">C=\sqrt{\frac{|\Omega|^{3d}}{8\delta n}}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.Thmremark1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmremark1.2" class="ltx_text ltx_font_italic">Remark B.1</span></span><span id="A2.Thmremark1.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="A2.Thmremark1.p1" class="ltx_para">
<p id="A2.Thmremark1.p1.1" class="ltx_p">Theorem 4 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib61" title="" class="ltx_ref">Li et al. (2024c)</a></cite> is specified for <math id="A2.Thmremark1.p1.m1" class="ltx_Math" alttext="\hat{\theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>θ</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{\theta}</annotation></semantics></math> as the minimizer of the empirical loss function. In fact, the proof applies uniformly to arbitrarily <math id="A2.Thmremark1.p1.m2" class="ltx_Math" alttext="\theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\theta\in\Theta</annotation></semantics></math>.</p>
</div>
</div>
<div id="A2.SS2.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#A2.Thmtheorem7" title="Proposition B.7. ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">B.7</span></a>.</h6>
<div id="A2.SS2.SSS2.p8" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS2.p8.1" class="ltx_p"><span id="A2.SS2.SSS2.p8.1.1" class="ltx_text">For each pair of <math id="A2.SS2.SSS2.p8.m1" class="ltx_Math" alttext="(\mathbf{x}^{\text{ct},(i)},\mathbf{x}^{\text{te},(i)})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mrow><mtext>ct</mtext><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo>,</mo><msup><mi>𝐱</mi><mrow><mtext>te</mtext><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{x}^{\text{ct},(i)},\mathbf{x}^{\text{te},(i)})</annotation></semantics></math>, exactly one mask <math id="A2.SS2.SSS2.p8.m2" class="ltx_Math" alttext="\pi_{i}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\pi_{i}</annotation></semantics></math> is drawn independently from <math id="A2.SS2.SSS2.p8.m3" class="ltx_Math" alttext="\mathrm{Unif}(\Pi_{k})" display="inline" intent=":literal"><semantics><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Unif}(\Pi_{k})</annotation></semantics></math>.
Therefore, <math id="A2.SS2.SSS2.p8.m4" class="ltx_Math" alttext="\pi\perp\mkern-9.0mu\perp(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mpadded style="width:0.528em;" width="0.528em"><mo>⟂</mo></mpadded><mphantom></mphantom><mo>⟂</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi\perp\mkern-9.0mu\perp(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})</annotation></semantics></math>.
It follows from <a href="#A2.Thmtheorem8" title="Lemma B.8 ( ( ) , Theorem 4). ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.8</span></a> that for each <math id="A2.SS2.SSS2.p8.m5" class="ltx_Math" alttext="1\leq k\leq d" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq d</annotation></semantics></math>,
for any <math id="A2.SS2.SSS2.p8.m6" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math> and any <math id="A2.SS2.SSS2.p8.m7" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>,
with probability at least <math id="A2.SS2.SSS2.p8.m8" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, for any <math id="A2.SS2.SSS2.p8.m9" class="ltx_Math" alttext="\theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\theta\in\Theta</annotation></semantics></math>,</span></p>
<table id="A2.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E15.m1" class="ltx_math_unparsed" alttext="\displaystyle D_{\operatorname{TV}}(q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})\parallel p(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}}))&lt;\sqrt{\frac{1}{2}\underline{C_{k}}(q_{\theta})\left(\hat{L}_{k}(\theta)+B\log\frac{1}{\beta}+\epsilon\right)+C}," display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>TV</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><msqrt><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><munder accentunder="true"><msub><mi>C</mi><mi>k</mi></msub><mo stretchy="true">¯</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>B</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>β</mi></mfrac></mstyle></mrow></mrow><mo>+</mo><mi>ϵ</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mi>C</mi></mrow></msqrt><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle D_{\operatorname{TV}}(q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})\parallel p(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}}))&lt;\sqrt{\frac{1}{2}\underline{C_{k}}(q_{\theta})\left(\hat{L}_{k}(\theta)+B\log\frac{1}{\beta}+\epsilon\right)+C},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS2.p8.2" class="ltx_p"><span id="A2.SS2.SSS2.p8.2.1" class="ltx_text">where <math id="A2.SS2.SSS2.p8.m10" class="ltx_Math" alttext="B=\sqrt{\frac{1}{\delta}\cdot(8|\Omega|)^{d(m+1)}N(\Theta,\epsilon)}+\sqrt{\frac{1}{2n}\cdot\log\frac{8N(\Theta,\epsilon)}{\delta}}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mrow><msqrt><mrow><mrow><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>+</mo><msqrt><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo>,</mo><mi>ϵ</mi><mo stretchy="false">)</mo></mrow></mrow><mi>δ</mi></mfrac></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">B=\sqrt{\frac{1}{\delta}\cdot(8|\Omega|)^{d(m+1)}N(\Theta,\epsilon)}+\sqrt{\frac{1}{2n}\cdot\log\frac{8N(\Theta,\epsilon)}{\delta}}</annotation></semantics></math>, and
<math id="A2.SS2.SSS2.p8.m11" class="ltx_Math" alttext="C=\sqrt{\frac{|\Omega|^{3d(m+1)}}{8\delta n}}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><msqrt><mfrac><msup><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Ω</mi><mo stretchy="false">|</mo></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></mfrac></msqrt></mrow><annotation encoding="application/x-tex">C=\sqrt{\frac{|\Omega|^{3d(m+1)}}{8\delta n}}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.SSS2.p9" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS2.p9.1" class="ltx_p"><span id="A2.SS2.SSS2.p9.1.1" class="ltx_text">By union bound, for any <math id="A2.SS2.SSS2.p9.m1" class="ltx_Math" alttext="\epsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon&gt;0</annotation></semantics></math> and any <math id="A2.SS2.SSS2.p9.m2" class="ltx_Math" alttext="\delta\in(0,\frac{1}{d})" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mfrac><mn>1</mn><mi>d</mi></mfrac><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,\frac{1}{d})</annotation></semantics></math>, with probability at least <math id="A2.SS2.SSS2.p9.m3" class="ltx_Math" alttext="1-d\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">1-d\delta</annotation></semantics></math>, <a href="#A2.E15" title="In Proof of . ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">15</span></a> is satisfied for any <math id="A2.SS2.SSS2.p9.m4" class="ltx_Math" alttext="1\leq k\leq d" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>≤</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">1\leq k\leq d</annotation></semantics></math> and any <math id="A2.SS2.SSS2.p9.m5" class="ltx_Math" alttext="\theta\in\Theta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow><annotation encoding="application/x-tex">\theta\in\Theta</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.SSS2.p10" class="ltx_para">
<p id="A2.SS2.SSS2.p10.1" class="ltx_p"><span id="A2.SS2.SSS2.p10.1.1" class="ltx_text">Furthermore, we have</span></p>
<table id="A2.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.E16.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\mathbb{E}_{\mathbf{X}^{\text{ct}}\sim p}\left[D_{\operatorname{TV}}(q_{\theta}(\cdot|\mathbf{X}^{\text{ct}})\parallel p(\cdot|\mathbf{X}^{\text{ct}}))\right]&amp;=\sum_{\mathbf{x}^{\text{ct}}\in\Omega^{m\times d}}p(\mathbf{x}^{\text{ct}})D_{\operatorname{TV}}(q_{\theta}(\cdot|\mathbf{X}^{\text{ct}}=\mathbf{x}^{\text{ct}})\parallel p(\cdot|\mathbf{X}^{\text{ct}}=\mathbf{x}^{\text{ct}}))\\
&amp;=\sum_{\mathbf{x}^{\text{ct}}\in\Omega^{m\times d}}p(\mathbf{x}^{\text{ct}})\cdot\frac{1}{2}\sum_{\mathbf{x}^{\text{te}}\in\Omega^{d}}\left|q_{\theta}(\mathbf{x}^{\text{te}}|\mathbf{x}^{\text{ct}})-p(\mathbf{x}^{\text{te}}|\mathbf{x}^{\text{ct}})\right|\\
&amp;=\frac{1}{2}\sum_{\mathbf{x}^{\text{ct}}\in\Omega^{m\times d},\mathbf{x}^{\text{te}}\in\Omega^{d}}\left|p(\mathbf{x}^{\text{ct}})q_{\theta}(\mathbf{x}^{\text{te}}|\mathbf{x}^{\text{ct}})-p(\mathbf{x}^{\text{ct}})p(\mathbf{x}^{\text{te}}|\mathbf{x}^{\text{ct}})\right|\\
&amp;=\frac{1}{2}\sum_{\mathbf{x}^{\text{ct}}\in\Omega^{m\times d},\mathbf{x}^{\text{te}}\in\Omega^{d}}\left|q_{\theta}(\mathbf{x}^{\text{te}},\mathbf{x}^{\text{ct}})-p(\mathbf{x}^{\text{te}},\mathbf{x}^{\text{ct}})\right|\\
&amp;=D_{\operatorname{TV}}(q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})\parallel p(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})).\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>∼</mo><mi>p</mi></mrow></msub><mo>[</mo><mi>D</mi><msub><mrow></mrow><mi>TV</mi></msub><mo stretchy="false">(</mo><mi>q</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><msup><mi>𝐱</mi><mtext>ct</mtext></msup><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow></msub><mi>p</mi><mo stretchy="false">(</mo><mi>𝐱</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo stretchy="false">)</mo><mi>D</mi><msub><mrow></mrow><mi>TV</mi></msub><mo stretchy="false">(</mo><mi>q</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>=</mo><mi>𝐱</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>=</mo><mi>𝐱</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><msup><mi>𝐱</mi><mtext>ct</mtext></msup><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow></msub><mi>p</mi><mo stretchy="false">(</mo><mi>𝐱</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><msup><mi>𝐱</mi><mtext>te</mtext></msup><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mi>d</mi></msup></mrow></msub><mo fence="false" rspace="0.167em">|</mo><mi>q</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝐱</mi><msup><mrow></mrow><mtext>te</mtext></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐱</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo stretchy="false">)</mo><mo>−</mo><mi>p</mi><mo stretchy="false">(</mo><mi>𝐱</mi><msup><mrow></mrow><mtext>te</mtext></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐱</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo stretchy="false">)</mo><mo fence="false">|</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><msup><mi>𝐱</mi><mtext>ct</mtext></msup><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><mo>,</mo><mrow><msup><mi>𝐱</mi><mtext>te</mtext></msup><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mi>d</mi></msup></mrow></mrow></munder></mstyle><mrow><mo>|</mo><mrow><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mtext>te</mtext></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mtext>te</mtext></msup><mo lspace="0em" rspace="0em">|</mo><msup><mi>𝐱</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><msup><mi>𝐱</mi><mtext>ct</mtext></msup><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><mo>,</mo><mrow><msup><mi>𝐱</mi><mtext>te</mtext></msup><mo>∈</mo><msup><mi mathvariant="normal">Ω</mi><mi>d</mi></msup></mrow></mrow></munder></mstyle><mrow><mo>|</mo><mrow><mrow><msub><mi>q</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐱</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐱</mi><mtext>te</mtext></msup><mo>,</mo><msup><mi>𝐱</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mo>=</mo><mi>D</mi><msub><mrow></mrow><mi>TV</mi></msub><mo stretchy="false">(</mo><mi>q</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>p</mi><mo stretchy="false">(</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\mathbb{E}_{\mathbf{X}^{\text{ct}}\sim p}\left[D_{\operatorname{TV}}(q_{\theta}(\cdot|\mathbf{X}^{\text{ct}})\parallel p(\cdot|\mathbf{X}^{\text{ct}}))\right]&amp;=\sum_{\mathbf{x}^{\text{ct}}\in\Omega^{m\times d}}p(\mathbf{x}^{\text{ct}})D_{\operatorname{TV}}(q_{\theta}(\cdot|\mathbf{X}^{\text{ct}}=\mathbf{x}^{\text{ct}})\parallel p(\cdot|\mathbf{X}^{\text{ct}}=\mathbf{x}^{\text{ct}}))\\
&amp;=\sum_{\mathbf{x}^{\text{ct}}\in\Omega^{m\times d}}p(\mathbf{x}^{\text{ct}})\cdot\frac{1}{2}\sum_{\mathbf{x}^{\text{te}}\in\Omega^{d}}\left|q_{\theta}(\mathbf{x}^{\text{te}}|\mathbf{x}^{\text{ct}})-p(\mathbf{x}^{\text{te}}|\mathbf{x}^{\text{ct}})\right|\\
&amp;=\frac{1}{2}\sum_{\mathbf{x}^{\text{ct}}\in\Omega^{m\times d},\mathbf{x}^{\text{te}}\in\Omega^{d}}\left|p(\mathbf{x}^{\text{ct}})q_{\theta}(\mathbf{x}^{\text{te}}|\mathbf{x}^{\text{ct}})-p(\mathbf{x}^{\text{ct}})p(\mathbf{x}^{\text{te}}|\mathbf{x}^{\text{ct}})\right|\\
&amp;=\frac{1}{2}\sum_{\mathbf{x}^{\text{ct}}\in\Omega^{m\times d},\mathbf{x}^{\text{te}}\in\Omega^{d}}\left|q_{\theta}(\mathbf{x}^{\text{te}},\mathbf{x}^{\text{ct}})-p(\mathbf{x}^{\text{te}},\mathbf{x}^{\text{ct}})\right|\\
&amp;=D_{\operatorname{TV}}(q_{\theta}(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})\parallel p(\mathbf{X}^{\text{te}},\mathbf{X}^{\text{ct}})).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS2.p10.2" class="ltx_p"><span id="A2.SS2.SSS2.p10.2.1" class="ltx_text">The proof is complete by combining <a href="#A2.E15" title="In Proof of . ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">15</span></a> and <a href="#A2.E16" title="Equation 16 ‣ Proof of . ‣ B.2.2 Generalization for Joint Distribution Learning ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>.
∎</span></p>
