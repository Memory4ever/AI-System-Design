<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17.m1" class="ltx_Math" alttext="\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\pi}\left[\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right]=\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\pi}\left[\frac{\nabla_{\theta}q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})}{q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><mi>π</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><mi>π</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\pi}\left[\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right]=\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\pi}\left[\frac{\nabla_{\theta}q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})}{q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})}\right]</annotation></semantics></math></td>
