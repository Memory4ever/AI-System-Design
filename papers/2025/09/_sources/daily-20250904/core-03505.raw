<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex20.m4" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex20.m5" class="ltx_Math" alttext="\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\pi}\mathbb{E}_{\mathbf{X}^{\text{te}}_{-\pi}|\mathbf{X}^{\text{ct}}}\left[\int_{\Omega^{k}}\nabla_{\theta}q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\mathrm{d}\mathbf{X}^{\text{te}}_{\pi}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><mi>π</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo fence="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi mathvariant="normal">Ω</mi><mi>k</mi></msup></msub></mstyle><mrow><mrow><msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\pi}\mathbb{E}_{\mathbf{X}^{\text{te}}_{-\pi}|\mathbf{X}^{\text{ct}}}\left[\int_{\Omega^{k}}\nabla_{\theta}q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\mathrm{d}\mathbf{X}^{\text{te}}_{\pi}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(Due to the assumption <math id="A2.Ex20.m1" class="ltx_Math" alttext="q_{\theta^{*}}=p" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo>=</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">q_{\theta^{*}}=p</annotation></semantics></math>)</span></td></tr></tbody>
<tbody id="A2.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex21.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex21.m2" class="ltx_math_unparsed" alttext="\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\pi}\mathbb{E}_{\mathbf{X}^{\text{te}}_{-\pi}|\mathbf{X}^{\text{ct}}}\left[\nabla_{\theta}\int_{\Omega^{k}}q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\mathrm{d}\mathbf{X}^{\text{te}}_{\pi}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><mi>π</mi></mrow></msub><msub><mi>𝔼</mi><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo fence="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow></msub><mrow><mo>[</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi mathvariant="normal">Ω</mi><mi>k</mi></msup></msub></mstyle><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo stretchy="false">)</mo></mrow><mi>d</mi><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\pi}\mathbb{E}_{\mathbf{X}^{\text{te}}_{-\pi}|\mathbf{X}^{\text{ct}}}\left[\nabla_{\theta}\int_{\Omega^{k}}q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\mathrm{d}\mathbf{X}^{\text{te}}_{\pi}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22.m2" class="ltx_Math" alttext="\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\pi}\mathbb{E}_{\mathbf{X}^{\text{te}}_{-\pi}|\mathbf{X}^{\text{ct}}}\left[\nabla_{\theta}1\right]=0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><mi>π</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo fence="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mn>1</mn></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\pi}\mathbb{E}_{\mathbf{X}^{\text{te}}_{-\pi}|\mathbf{X}^{\text{ct}}}\left[\nabla_{\theta}1\right]=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p4.7" class="ltx_p"><span id="A2.SS2.SSS1.p4.7.1" class="ltx_text">Combined with <a href="#A2.E8" title="In Proof. ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">8</span></a>, we can get that</span></p>
<table id="A2.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E9.m1" class="ltx_Math" alttext="\mathrm{Cov}\left(-\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\pi}\mid\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}}\right)\right)=\mathbb{E}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)^{\top}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Cov</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo rspace="0.167em">−</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Cov}\left(-\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\pi}\mid\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}}\right)\right)=\mathbb{E}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)^{\top}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p4.8" class="ltx_p"><span id="A2.SS2.SSS1.p4.8.1" class="ltx_text">Now the claim follows from <a href="#A2.E7" title="In Proof. ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equations</span> <span class="ltx_text ltx_ref_tag">7</span></a> and <a href="#A2.E9" title="Equation 9 ‣ Proof. ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>.
∎</span></p>
</div>
</div>
<div id="A2.SS2.SSS1.p5" class="ltx_para">
<p id="A2.SS2.SSS1.p5.1" class="ltx_p">Based on the above lemmas, we can now prove <a href="#A2.Thmtheorem2" title="Theorem B.2 (Formal Version of ). ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">B.2</span></a>. The proof follows a similar idea to that of Theorem 1 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib61" title="" class="ltx_ref">Li et al. (2024c)</a></cite>.</p>
</div>
<div id="A2.SS2.SSS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of <a href="#A2.Thmtheorem2" title="Theorem B.2 (Formal Version of ). ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">B.2</span></a>.</h6>
<div id="A2.SS2.SSS1.p6" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS1.p6.4" class="ltx_p"><span id="A2.SS2.SSS1.p6.4.1" class="ltx_text">It is easy to verify that <math id="A2.SS2.SSS1.p6.m1" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math> is the minimizer of <math id="A2.SS2.SSS1.p6.m2" class="ltx_Math" alttext="L_{k}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L_{k}(\theta)</annotation></semantics></math> for any <math id="A2.SS2.SSS1.p6.m3" class="ltx_Math" alttext="k\in[d]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[d]</annotation></semantics></math> and hence <math id="A2.SS2.SSS1.p6.m4" class="ltx_Math" alttext="\theta^{*}_{k}=\theta^{*}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>θ</mi><mi>k</mi><mo>∗</mo></msubsup><mo>=</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">\theta^{*}_{k}=\theta^{*}</annotation></semantics></math> by assumption. According to <a href="#A2.Thmtheorem3" title="Lemma B.3 ( ( ) , Theorem 5.23; statement adapted from ( ) ). ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.3</span></a>, it holds that for every sufficiently small neighborhood <math id="A2.SS2.SSS1.p6.m5" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> of <math id="A2.SS2.SSS1.p6.m6" class="ltx_Math" alttext="\theta^{*}" display="inline" intent=":literal"><semantics><msup><mi>θ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\theta^{*}</annotation></semantics></math>, there exists a sufficiently large <math id="A2.SS2.SSS1.p6.m7" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>, such that there is a unique minimizer <math id="A2.SS2.SSS1.p6.m8" class="ltx_Math" alttext="\hat{\theta}_{k,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\hat{\theta}_{k,n}</annotation></semantics></math> in <math id="A2.SS2.SSS1.p6.m9" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>. Furthermore, <math id="A2.SS2.SSS1.p6.m10" class="ltx_Math" alttext="\hat{\theta}_{k,n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">\hat{\theta}_{k,n}</annotation></semantics></math> satisfies:</span></p>
<table id="A2.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex23.m1" class="ltx_Math" alttext="\sqrt{n}\left(\hat{\theta}_{k,n}-\theta^{*}\right)\xrightarrow{d}{\mathcal{N}}\left(0,\Gamma_{k}\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>,</mo><mi>n</mi></mrow></msub><mo>−</mo><msup><mi>θ</mi><mo>∗</mo></msup></mrow><mo>)</mo></mrow></mrow><mover accent="true"><mo>→</mo><mo mathsize="0.700em">𝑑</mo></mover><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo>(</mo><mn>0</mn><mo>,</mo><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sqrt{n}\left(\hat{\theta}_{k,n}-\theta^{*}\right)\xrightarrow{d}{\mathcal{N}}\left(0,\Gamma_{k}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p6.5" class="ltx_p"><span id="A2.SS2.SSS1.p6.5.1" class="ltx_text">Here due to <a href="#A2.Thmtheorem4" title="Lemma B.4. ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">B.4</span></a>, it holds that</span></p>
<table id="A2.E10" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E10X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E10X.m2" class="ltx_Math" alttext="\displaystyle\Gamma_{k}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Γ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\displaystyle\Gamma_{k}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E10X.m3" class="ltx_Math" alttext="\displaystyle=\left(\nabla_{\theta}^{2}L_{k}\left(\theta^{*}\right)\right)^{-1}\mathrm{Cov}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\,\pi\sim\mathrm{Unif}(\Pi_{k})}\left(-\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}}\right)\right)\left(\nabla_{\theta}^{2}L_{k}\left(\theta^{*}\right)\right)^{-1}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo>(</mo><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>Cov</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo rspace="0.337em">,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo rspace="0.167em">−</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\nabla_{\theta}^{2}L_{k}\left(\theta^{*}\right)\right)^{-1}\mathrm{Cov}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\,\pi\sim\mathrm{Unif}(\Pi_{k})}\left(-\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}}\right)\right)\left(\nabla_{\theta}^{2}L_{k}\left(\theta^{*}\right)\right)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(10)</span></td></tr>
<tr id="A2.E10Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E10Xa.m2" class="ltx_Math" alttext="\displaystyle=\left(\nabla_{\theta}^{2}L_{k}\left(\theta^{*}\right)\right)^{-1}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo>(</mo><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left(\nabla_{\theta}^{2}L_{k}\left(\theta^{*}\right)\right)^{-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p6.6" class="ltx_p"><span id="A2.SS2.SSS1.p6.6.1" class="ltx_text">Fix a <math id="A2.SS2.SSS1.p6.m11" class="ltx_Math" alttext="k\in[d-1]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[d-1]</annotation></semantics></math>. Then for every <math id="A2.SS2.SSS1.p6.m12" class="ltx_Math" alttext="\pi\in\Pi_{k+1}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><msub><mi mathvariant="normal">Π</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\pi\in\Pi_{k+1}</annotation></semantics></math> and <math id="A2.SS2.SSS1.p6.m13" class="ltx_Math" alttext="j\in\pi" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mi>π</mi></mrow><annotation encoding="application/x-tex">j\in\pi</annotation></semantics></math>, let <math id="A2.SS2.SSS1.p6.m14" class="ltx_Math" alttext="\gamma=\pi\setminus\{j\}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><mi>π</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma=\pi\setminus\{j\}</annotation></semantics></math> and we have</span></p>
<table id="A2.E11" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E11X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E11X.m2" class="ltx_Math" alttext="\displaystyle\log q_{\theta}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log q_{\theta}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E11X.m3" class="ltx_Math" alttext="\displaystyle=\log q_{\theta}\left(\mathbf{X}^{\text{te}}_{\gamma},X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>log</mi><mi>q</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>(</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mi>γ</mi></msub><mo>,</mo><mi>X</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mi>j</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>te</mtext></msup><msub><mrow></mrow><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>𝐗</mi><msup><mrow></mrow><mtext>ct</mtext></msup><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\log q_{\theta}\left(\mathbf{X}^{\text{te}}_{\gamma},X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(11)</span></td></tr>
<tr id="A2.E11Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E11Xa.m2" class="ltx_Math" alttext="\displaystyle=\log q_{\theta}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)+\log q_{\theta}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>X</mi><mi>j</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\log q_{\theta}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)+\log q_{\theta}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p6.7" class="ltx_p"><span id="A2.SS2.SSS1.p6.7.1" class="ltx_text">As a result, we have</span></p>
<table id="A2.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\displaystyle\,\nabla^{2}_{\theta}L_{k+1}(\theta^{*})" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\nabla^{2}_{\theta}L_{k+1}(\theta^{*})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex25.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25.m2" class="ltx_Math" alttext="\displaystyle\,\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k+1})}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>π</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\pi\sim\mathrm{Unif}(\Pi_{k+1})}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)^{\top}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(Due to <a href="#A2.E7" title="In Proof. ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">7</span></a>)</span></td></tr></tbody>
<tbody id="A2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex26.m4" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26.m5" class="ltx_Math" alttext="\displaystyle\,\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\gamma\sim\mathrm{Unif}(\Pi_{k}),j\in\mathrm{Unif}([d]\setminus\gamma)}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mrow><mrow><mo stretchy="false">(</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi>p</mi></mrow><mo>,</mo><mrow><mi>γ</mi><mo>∼</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Π</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mi>Unif</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow><mo>∖</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{E}_{(\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}})\sim p,\gamma\sim\mathrm{Unif}(\Pi_{k}),j\in\mathrm{Unif}([d]\setminus\gamma)}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)\left(\nabla_{\theta}\log q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\right)^{\top}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(Letting <math id="A2.Ex26.m1" class="ltx_Math" alttext="\pi=\gamma\cup\{j\}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi=\gamma\cup\{j\}</annotation></semantics></math>)</span></td></tr></tbody>
<tbody id="A2.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex27.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex27.m2" class="ltx_math_unparsed" alttext="\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\gamma,j}\Bigg[\left(\nabla_{\theta}\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)+\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)\times" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><mi>γ</mi><mo>,</mo><mi>j</mi></mrow></msub><mrow><mo maxsize="2.600em" minsize="2.600em">[</mo><mrow><mo>(</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>log</mi><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mrow><mo>(</mo><msubsup><mi>X</mi><mi>j</mi><mtext>te</mtext></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>)</mo></mrow><mo>+</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>log</mi><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>)</mo></mrow><mo rspace="0.055em">)</mo></mrow><mo>×</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\gamma,j}\Bigg[\left(\nabla_{\theta}\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)+\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)\times</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex28.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\left(\nabla_{\theta}\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)+\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\Bigg]." display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>(</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>log</mi><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mrow><mo>(</mo><msubsup><mi>X</mi><mi>j</mi><mtext>te</mtext></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>)</mo></mrow><mo>+</mo><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>log</mi><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>)</mo></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo maxsize="2.600em" minsize="2.600em">]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\left(\nabla_{\theta}\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)+\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\Bigg].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(By <a href="#A2.E11" title="In Proof of . ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">11</span></a>)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p6.8" class="ltx_p"><span id="A2.SS2.SSS1.p6.8.1" class="ltx_text">Define</span></p>
<table id="A2.Ex30" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex30X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex30X.m2" class="ltx_Math" alttext="\displaystyle A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">\displaystyle A</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex30X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\gamma,j}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)\left(\nabla_{\theta}\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><mi>γ</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>X</mi><mi>j</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>X</mi><mi>j</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\gamma,j}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)\left(\nabla_{\theta}\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex30Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex30Xa.m2" class="ltx_Math" alttext="\displaystyle B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\displaystyle B</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex30Xa.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\gamma,j}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)\left(\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><mi>γ</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>X</mi><mi>j</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\gamma,j}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)\left(\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex30Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex30Xb.m2" class="ltx_Math" alttext="\displaystyle C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">\displaystyle C</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex30Xb.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\gamma,j}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)\left(\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><mi>γ</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mi>log</mi><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\gamma,j}\left[\left(\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)\left(\nabla_{\theta}\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p6.9" class="ltx_p"><span id="A2.SS2.SSS1.p6.9.1" class="ltx_text">Then we have</span></p>
<table id="A2.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex31.m1" class="ltx_Math" alttext="\nabla^{2}_{\theta}L_{k+1}(\theta^{*})=A+B+B^{\top}+C." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>A</mi><mo>+</mo><mi>B</mi><mo>+</mo><msup><mi>B</mi><mo>⊤</mo></msup><mo>+</mo><mi>C</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla^{2}_{\theta}L_{k+1}(\theta^{*})=A+B+B^{\top}+C.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p6.10" class="ltx_p"><span id="A2.SS2.SSS1.p6.10.1" class="ltx_text">It is easy to verify that <math id="A2.SS2.SSS1.p6.m15" class="ltx_Math" alttext="C=\nabla^{2}_{\theta}L_{k}(\theta^{*})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><mrow><msubsup><mo>∇</mo><mi>θ</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>θ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C=\nabla^{2}_{\theta}L_{k}(\theta^{*})</annotation></semantics></math>. Now consider <math id="A2.SS2.SSS1.p6.m16" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>. It holds that</span></p>
<table id="A2.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex32.m1" class="ltx_Math" alttext="\displaystyle B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\displaystyle B</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex32.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\gamma,j}\left[\left(\nabla\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)\left(\nabla\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><msup><mi>𝐗</mi><mtext>te</mtext></msup><mo>,</mo><mi>γ</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>X</mi><mi>j</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\mathbf{X}^{\text{te}},\gamma,j}\left[\left(\nabla\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)\left(\nabla\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
