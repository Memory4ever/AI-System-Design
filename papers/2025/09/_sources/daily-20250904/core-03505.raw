<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex33.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\gamma,j,\mathbf{X}^{\text{te}}_{-\gamma}}\left[\left(\nabla\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)\cdot\mathbb{E}_{\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}}\left[\left(\nabla\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\right]\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><mi>γ</mi><mo>,</mo><mi>j</mi><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo>(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>X</mi><mi>j</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mrow><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo fence="false">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>𝐗</mi><mi>γ</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo>]</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\gamma,j,\mathbf{X}^{\text{te}}_{-\gamma}}\left[\left(\nabla\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)\cdot\mathbb{E}_{\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}}\left[\left(\nabla\log q_{\theta^{*}}\left(\mathbf{X}^{\text{te}}_{\gamma}|\mathbf{X}^{\text{te}}_{-\gamma},\mathbf{X}^{\text{ct}}\right)\right)^{\top}\right]\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex34.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\gamma,j,\mathbf{X}^{\text{te}}_{-\gamma}}\left[\left(\nabla\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)\cdot 0\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><mi>γ</mi><mo>,</mo><mi>j</mi><mo>,</mo><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>γ</mi></mrow><mtext>te</mtext></msubsup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>log</mi></mrow><mo lspace="0.167em">⁡</mo><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msubsup><mi>X</mi><mi>j</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>γ</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>j</mi><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo>)</mo></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mn>0</mn></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\mathbf{X}^{\text{ct}},\gamma,j,\mathbf{X}^{\text{te}}_{-\gamma}}\left[\left(\nabla\log q_{\theta^{*}}\left(X^{\text{te}}_{j}|\mathbf{X}^{\text{te}}_{-(\gamma\cup\{j\})},\mathbf{X}^{\text{ct}}\right)\right)\cdot 0\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(See <a href="#A2.E12" title="In Proof of . ‣ B.2.1 Sample Efficiency ‣ B.2 Omitted Details in ‣ Appendix B Omitted Details in ‣ LimiX: Unleashing Structured-Data Modeling Capability for Generalist Intelligence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">12</span></a> below)</span></td></tr></tbody>
<tbody id="A2.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
