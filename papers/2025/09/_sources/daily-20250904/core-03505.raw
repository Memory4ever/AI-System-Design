<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex35.m1" class="ltx_Math" alttext="\displaystyle=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=0.</annotation></semantics></math></td>
