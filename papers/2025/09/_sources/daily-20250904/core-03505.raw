<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex19.m2" class="ltx_Math" alttext="\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\pi}\mathbb{E}_{\mathbf{X}^{\text{te}}_{-\pi}|\mathbf{X}^{\text{ct}}}\left[\int_{\Omega^{k}}\frac{\nabla_{\theta}q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})}{q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})}\cdot p(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\mathrm{d}\mathbf{X}^{\text{te}}_{\pi}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msup><mi>𝐗</mi><mtext>ct</mtext></msup><mo>,</mo><mi>π</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo fence="false">|</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><msup><mi mathvariant="normal">Ω</mi><mi>k</mi></msup></msub></mstyle><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>q</mi><msup><mi>θ</mi><mo>∗</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup><mo lspace="0em" rspace="0em">|</mo><mrow><msubsup><mi>𝐗</mi><mrow><mo>−</mo><mi>π</mi></mrow><mtext>te</mtext></msubsup><mo>,</mo><msup><mi>𝐗</mi><mtext>ct</mtext></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐗</mi><mi>π</mi><mtext>te</mtext></msubsup></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\,\mathbb{E}_{\mathbf{X}^{\text{ct}},\pi}\mathbb{E}_{\mathbf{X}^{\text{te}}_{-\pi}|\mathbf{X}^{\text{ct}}}\left[\int_{\Omega^{k}}\frac{\nabla_{\theta}q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})}{q_{\theta^{*}}(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})}\cdot p(\mathbf{X}^{\text{te}}_{\pi}|\mathbf{X}^{\text{te}}_{-\pi},\mathbf{X}^{\text{ct}})\mathrm{d}\mathbf{X}^{\text{te}}_{\pi}\right]</annotation></semantics></math></td>
