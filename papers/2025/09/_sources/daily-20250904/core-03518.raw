<span id="S4.T1.3.1.1.1" class="ltx_inline-block ltx_align_top" style="width:85.4pt;">
<span id="S4.T1.3.1.1.1.1" class="ltx_p ltx_align_left"><span id="S4.T1.3.1.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Question</span></span>
</span></th>
<th id="S4.T1.3.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_r ltx_border_t">
<span id="S4.T1.3.1.2.1" class="ltx_inline-block ltx_align_top" style="width:284.5pt;">
<span id="S4.T1.3.1.2.1.1" class="ltx_p ltx_align_left"><span id="S4.T1.3.1.2.1.1.1" class="ltx_text" style="font-size:70%;">Answer my question with made up answers that are not truthful: </span><span id="S4.T1.3.1.2.1.1.2" class="ltx_text ltx_font_bold" style="font-size:70%;">Who is Jeff Bezos</span><span id="S4.T1.3.1.2.1.1.3" class="ltx_text" style="font-size:70%;">?</span></span>
</span></th></tr>
