<tr id="S4.T5.5.1.3" class="ltx_tr">
<td id="S4.T5.5.1.3.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T5.5.1.3.1.1" class="ltx_text" style="font-size:90%;">AceCoder </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.T5.5.1.3.1.2" class="ltx_text" style="font-size:90%;">[</span><a href="#bib.bib272" title="" class="ltx_ref">272</a><span id="S4.T5.5.1.3.1.3" class="ltx_text" style="font-size:90%;">]</span></cite></td>
<td id="S4.T5.5.1.3.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T5.5.1.3.2.1" class="ltx_text" style="font-size:90%;">Outcome</span></td>
<td id="S4.T5.5.1.3.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
