<td id="S2.T2.5.36.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
<span id="S2.T2.5.36.4.1" class="ltx_inline-block ltx_align_top" style="width:17.1pt;">
<span id="S2.T2.5.36.4.1.1" class="ltx_p"><span id="S2.T2.5.36.4.1.1.1" class="ltx_text" style="font-size:50%;">Yes</span></span>
</span></td>
<td id="S2.T2.5.36.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
<span id="S2.T2.5.36.5.1" class="ltx_inline-block ltx_align_top" style="width:34.1pt;">
<span id="S2.T2.5.36.5.1.1" class="ltx_p"><span id="S2.T2.5.36.5.1.1.1" class="ltx_text" style="font-size:50%;">Yes</span></span>
</span></td>
<td id="S2.T2.5.36.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_r">
<span id="S2.T2.5.36.6.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="S2.T2.5.36.6.1.1" class="ltx_p"><span id="S2.T2.5.36.6.1.1.1" class="ltx_text" style="font-size:50%;">Encourage learning to perceive while learning to reason through the Implicit Perception Loss</span></span>
</span></td>
<td id="S2.T2.5.36.7" class="ltx_td ltx_align_left ltx_align_top">
<span id="S2.T2.5.36.7.1" class="ltx_inline-block ltx_align_top" style="width:76.8pt;">
<span id="S2.T2.5.36.7.1.1" class="ltx_p"><span id="S2.T2.5.36.7.1.1.1" class="ltx_text" style="font-size:50%;">Group-based reward</span></span>
</span></td></tr>
<tr id="S2.T2.5.37" class="ltx_tr">
<th id="S2.T2.5.37.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r"><span id="S2.T2.5.37.1.1" class="ltx_text" style="font-size:50%;">Pass@k Training</span></th>
<td id="S2.T2.5.37.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r">
<span id="S2.T2.5.37.2.1" class="ltx_inline-block ltx_align_top" style="width:17.1pt;">
<span id="S2.T2.5.37.2.1.1" class="ltx_p"><span id="S2.T2.5.37.2.1.1.1" class="ltx_text" style="font-size:50%;">2025</span></span>
</span></td>
<td id="S2.T2.5.37.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_r">
