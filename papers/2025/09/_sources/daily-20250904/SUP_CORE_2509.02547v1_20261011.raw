<span id="S4.T5.5.1.3.3.1.1" class="ltx_p"><span id="S4.T5.5.1.3.3.1.1.1" class="ltx_text" style="font-size:90%;">Qwen2.5-Coder-7B-Base/Instruct,
Qwen2.5-7B-Instruct</span></span>
</span></td>
<td id="S4.T5.5.1.3.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t">
<span id="S4.T5.5.1.3.4.1" class="ltx_inline-block fas fa-github" aria-hidden="true">
</span><span id="S4.T5.5.1.3.4.2" class="ltx_text" style="font-size:90%;"> </span><a href="https://github.com/TIGER-AI-Lab/AceCoder" title="" class="ltx_ref ltx_href" style="font-size:90%;">GitHub</a></td></tr>
