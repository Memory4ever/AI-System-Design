<td id="S4.T7.5.11.4" class="ltx_td ltx_nopad_r ltx_align_left">
<span id="S4.T7.5.11.4.1" class="ltx_inline-block fas fa-github" aria-hidden="true">
</span><span id="S4.T7.5.11.4.2" class="ltx_text" style="font-size:90%;"> <a href="https://github.com/lll6gg/UI-R1" title="" class="ltx_ref ltx_href">GitHub</a> <img src="2509.02547v1/figures/hf-logo.png" id="S4.T7.g5" class="ltx_graphics ltx_img_square" style="aspect-ratio:14/13;" width="14" height="13" alt="[Uncaptioned image]"> <a href="https://huggingface.co/LZXzju/Qwen2.5-VL-3B-UI-R1-E" title="" class="ltx_ref ltx_href">HuggingFace</a></span></td></tr>
