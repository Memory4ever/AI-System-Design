<td id="S4.T5.2.1.8.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T5.2.1.8.2.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T5.2.1.8.2.1.1" class="ltx_p"><span id="S4.T5.2.1.8.2.1.1.1" class="ltx_text ltx_font_bold">TarnishedLab</span></span>
</span></td>
<td id="S4.T5.2.1.8.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T5.2.1.8.3.1" class="ltx_inline-block ltx_align_top" style="width:31.3pt;">
<span id="S4.T5.2.1.8.3.1.1" class="ltx_p"><span id="S4.T5.2.1.8.3.1.1.1" class="ltx_text ltx_font_bold">62.84%</span></span>
</span></td>
<td id="S4.T5.2.1.8.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T5.2.1.8.4.1" class="ltx_inline-block ltx_align_top" style="width:62.6pt;">
<span id="S4.T5.2.1.8.4.1.1" class="ltx_p"><span id="S4.T5.2.1.8.4.1.1.1" class="ltx_text ltx_font_italic">Qwen2.5-3B-Instruct</span></span>
</span></td>
<td id="S4.T5.2.1.8.5" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T5.2.1.8.5.1" class="ltx_inline-block ltx_align_top" style="width:22.8pt;">
<span id="S4.T5.2.1.8.5.1.1" class="ltx_p"><span id="S4.T5.2.1.8.5.1.1.1" class="ltx_text ltx_font_bold">–</span></span>
</span></td>
<td id="S4.T5.2.1.8.6" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb">
<span id="S4.T5.2.1.8.6.1" class="ltx_inline-block ltx_align_top" style="width:136.6pt;">
<span id="S4.T5.2.1.8.6.1.1" class="ltx_p"><span id="S4.T5.2.1.8.6.1.1.1" class="ltx_text ltx_font_italic">–</span></span>
</span></td>
<td id="S4.T5.2.1.8.7" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_bb">
