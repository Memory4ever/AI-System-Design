</div>
<figure id="A5.T5" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table">Table 5: </span>Per-utterance rates for Belief Contradictions</figcaption>
</figure>
<div id="A5.p3" class="ltx_para">
<div id="A5.p3.1" class="ltx_inline-block ltx_transformed_outer" style="width:345.0pt;height:89.9pt;vertical-align:-42.3pt;"><span class="ltx_transformed_inner" style="transform:translate(9.0pt,-2.3pt) scale(1.05499920209862,1.05499920209862) ;">
<table id="A5.p3.1.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A5.p3.1.1.1" class="ltx_tr">
<th id="A5.p3.1.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt">Dialogue</th>
<th id="A5.p3.1.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">o3-mini</th>
<th id="A5.p3.1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Claude Sonnet 4</th>
<th id="A5.p3.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Gemma 8.5B</th>
<th id="A5.p3.1.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Naive Human</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A5.p3.1.1.2" class="ltx_tr">
<th id="A5.p3.1.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">D1</th>
<td id="A5.p3.1.1.2.2" class="ltx_td ltx_align_center ltx_border_t">0.035</td>
