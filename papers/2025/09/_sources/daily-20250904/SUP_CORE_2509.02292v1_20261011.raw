<td id="S4.T2.2.1.27.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.2.1.27.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">141</span></td>
<td id="S4.T2.2.1.27.7" class="ltx_td ltx_align_center ltx_border_bb">443</td>
