<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex50.m2" class="ltx_Math" alttext="\displaystyle\frac{\kappa\sqrt{r}}{(1-\mu)\sqrt{b}}+T\kappa\sqrt{\frac{r(1-\mu)}{b}}+\frac{T\mu L\epsilon}{1-\mu}+\frac{\mu\eta L}{1-\mu}\sqrt{T}\left(\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]\right)^{\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>b</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>b</mi></mfrac></mstyle></msqrt></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\kappa\sqrt{r}}{(1-\mu)\sqrt{b}}+T\kappa\sqrt{\frac{r(1-\mu)}{b}}+\frac{T\mu L\epsilon}{1-\mu}+\frac{\mu\eta L}{1-\mu}\sqrt{T}\left(\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]\right)^{\frac{1}{2}}</annotation></semantics></math></td>
