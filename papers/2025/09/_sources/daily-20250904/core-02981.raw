<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex100.m2" class="ltx_Math" alttext="\displaystyle\mathcal{O}\left(\frac{\kappa\sqrt{r}+L+\Delta}{\sqrt{T}}\right)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mo>+</mo><mi>L</mi><mo>+</mo><mi mathvariant="normal">Δ</mi></mrow><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{O}\left(\frac{\kappa\sqrt{r}+L+\Delta}{\sqrt{T}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
