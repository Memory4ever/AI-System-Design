          <span id="alg1.l8.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l8.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
          <span id="alg1.l9.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l9.m1" class="ltx_Math" alttext="\Theta_{T}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Θ</mi><mi>T</mi></msub><annotation encoding="application/x-tex">\Theta_{T}</annotation></semantics></math>

