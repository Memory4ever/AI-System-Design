<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex34.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t}\left[2\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})-M_{t}\right\|_{*}\right]-\mathbb{E}_{t}\left[\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]+\frac{L\epsilon^{2}}{2}+\frac{\eta^{2}L}{2}\mathbb{E}_{t}\left[\alpha_{t}^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mi>max</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>M</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t}\left[2\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})-M_{t}\right\|_{*}\right]-\mathbb{E}_{t}\left[\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]+\frac{L\epsilon^{2}}{2}+\frac{\eta^{2}L}{2}\mathbb{E}_{t}\left[\alpha_{t}^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p1.3" class="ltx_p"><span id="A3.p1.3.1" class="ltx_text">Then by the law of total expectation,</span></p>
<table id="A3.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex35"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
