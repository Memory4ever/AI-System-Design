<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex35.m2" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex36.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex36.m2" class="ltx_Math" alttext="\displaystyle\mathcal{L}(\Theta_{0})-\mathcal{L}_{\star}+2\sum_{t=1}^{T}\mathbb{E}\left[\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})-M_{t}\right\|_{*}\right]+\frac{L\epsilon^{2}T}{2}+\frac{\eta^{2}L}{2}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⋆</mo></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>M</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(\Theta_{0})-\mathcal{L}_{\star}+2\sum_{t=1}^{T}\mathbb{E}\left[\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})-M_{t}\right\|_{*}\right]+\frac{L\epsilon^{2}T}{2}+\frac{\eta^{2}L}{2}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E7.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E7.m2" class="ltx_Math" alttext="\displaystyle\mathcal{L}(\Theta_{0})-\mathcal{L}_{\star}+2\epsilon\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\right]+2\eta\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}\left\|E_{t}\right\|_{*}\right]+\frac{L\epsilon^{2}T}{2}+\frac{\eta^{2}L}{2}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⋆</mo></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(\Theta_{0})-\mathcal{L}_{\star}+2\epsilon\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\right]+2\eta\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}\left\|E_{t}\right\|_{*}\right]+\frac{L\epsilon^{2}T}{2}+\frac{\eta^{2}L}{2}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
</table>
<p id="A3.p1.4" class="ltx_p"><span id="A3.p1.4.1" class="ltx_text">where <math id="A3.p1.m3" class="ltx_Math" alttext="E_{t}:=M_{t}-\nabla\!\mathcal{L}(\Theta_{t-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>t</mi></msub><mo>:=</mo><mrow><msub><mi>M</mi><mi>t</mi></msub><mo>−</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">E_{t}:=M_{t}-\nabla\!\mathcal{L}(\Theta_{t-1})</annotation></semantics></math> and <math id="A3.p1.m4" class="ltx_Math" alttext="\mathcal{L}_{*}:=\min_{\Theta}\mathcal{L}(\Theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>∗</mo></msub><mo>:=</mo><mrow><msub><mi>min</mi><mi mathvariant="normal">Θ</mi></msub><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{*}:=\min_{\Theta}\mathcal{L}(\Theta)</annotation></semantics></math>.</span></p>
</div>
<div id="A3.p2" class="ltx_para ltx_noindent">
<p id="A3.p2.1" class="ltx_p"><span id="A3.p2.1.1" class="ltx_text">By Cauchy-Schwarz inequality and Lemma <a href="#A2.Thmthm2" title="Lemma B.2. ‣ Appendix B Useful Lemmas ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>, the third term on the right side of the above inequality satisfies</span></p>
<table id="A3.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex37.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}\left\|E_{t}\right\|_{*}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mi>α</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}\left\|E_{t}\right\|_{*}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex37.m2" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\sqrt{\mathbb{E}\left[\left\|E_{t}\right\|_{*}^{2}\right]\mathbb{E}\left[\alpha_{t}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msqrt><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\sqrt{\mathbb{E}\left[\left\|E_{t}\right\|_{*}^{2}\right]\mathbb{E}\left[\alpha_{t}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex38.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex38.m2" class="ltx_Math" alttext="\displaystyle\sqrt{\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}^{2}\right]}\sqrt{\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}^{2}\right]}\sqrt{\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
