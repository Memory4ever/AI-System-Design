<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex99.m2" class="ltx_Math" alttext="\displaystyle\frac{\Delta}{\sqrt{T}}+\frac{L}{2\sqrt{T}}+\frac{2\kappa\sqrt{r}}{\sqrt{T}}+\frac{\kappa\sqrt{r}}{T^{\frac{1}{2}+2q}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)+\frac{L}{2T^{\frac{1}{2}+2q}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msup><mi>T</mi><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\Delta}{\sqrt{T}}+\frac{L}{2\sqrt{T}}+\frac{2\kappa\sqrt{r}}{\sqrt{T}}+\frac{\kappa\sqrt{r}}{T^{\frac{1}{2}+2q}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)+\frac{L}{2T^{\frac{1}{2}+2q}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
