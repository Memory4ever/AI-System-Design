<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex51.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|E_{t+1}\right\|_{F}^{2}\right]=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|E_{t+1}\right\|_{F}^{2}\right]=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex51.m2" class="ltx_Math" alttext="\displaystyle\mu^{2t}\mathbb{E}\left[\left\|E_{1}\right\|_{F}^{2}\right]+\mu^{t+1}\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\left\langle E_{1},\nabla\!\mathcal{L}(\Theta_{t-\tau-1})-\nabla\!\mathcal{L}(\Theta_{t-\tau})\right\rangle\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mn>1</mn></msub><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msup><mi>μ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>⟨</mo><mrow><msub><mi>E</mi><mn>1</mn></msub><mo>,</mo><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>⟩</mo></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu^{2t}\mathbb{E}\left[\left\|E_{1}\right\|_{F}^{2}\right]+\mu^{t+1}\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\left\langle E_{1},\nabla\!\mathcal{L}(\Theta_{t-\tau-1})-\nabla\!\mathcal{L}(\Theta_{t-\tau})\right\rangle\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex52.m1" class="ltx_math_unparsed" alttext="\displaystyle+(1-\mu)^{2}\sum_{\tau=0}^{t-1}\mu^{2\tau}\mathbb{E}\left[\left\|\tilde{E}_{t+1-\tau}\right\|_{F}^{2}\right]+\mu^{2}\mathbb{E}\left[\left\|\sum_{\tau=0}^{t-1}\mu^{\tau}\left(\nabla\!\mathcal{L}(\Theta_{t-\tau-1})-\nabla\!\mathcal{L}(\Theta_{t-\tau})\right)\right\|_{F}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></msup><mi>𝔼</mi><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mover accent="true"><mi>E</mi><mo>~</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>τ</mi></mrow></msub><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow><mo>+</mo><msup><mi>μ</mi><mn>2</mn></msup><mi>𝔼</mi><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>μ</mi><mi>τ</mi></msup><mrow><mo>(</mo><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+(1-\mu)^{2}\sum_{\tau=0}^{t-1}\mu^{2\tau}\mathbb{E}\left[\left\|\tilde{E}_{t+1-\tau}\right\|_{F}^{2}\right]+\mu^{2}\mathbb{E}\left[\left\|\sum_{\tau=0}^{t-1}\mu^{\tau}\left(\nabla\!\mathcal{L}(\Theta_{t-\tau-1})-\nabla\!\mathcal{L}(\Theta_{t-\tau})\right)\right\|_{F}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex53.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex53.m2" class="ltx_Math" alttext="\displaystyle\frac{\mu^{2t}\kappa^{2}}{b}+L\mu^{t+1}\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\left\|E_{1}\right\|_{F}\max\{\epsilon,\eta\alpha_{t-\tau}\}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><mi>b</mi></mfrac></mstyle><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>E</mi><mn>1</mn></msub><mo>‖</mo></mrow><mi>F</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mu^{2t}\kappa^{2}}{b}+L\mu^{t+1}\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\left\|E_{1}\right\|_{F}\max\{\epsilon,\eta\alpha_{t-\tau}\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex54.m1" class="ltx_math_unparsed" alttext="\displaystyle+(1-\mu)^{2}\frac{\kappa^{2}}{b}\sum_{\tau=0}^{t-1}\mu^{2\tau}+\mu^{2}\mathbb{E}\left[\left(\sum_{\tau=0}^{t-1}\mu^{\tau}\left\|\nabla\!\mathcal{L}(\Theta_{t-\tau-1})-\nabla\!\mathcal{L}(\Theta_{t-\tau})\right\|_{F}\right)^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>2</mn></msup><mi>b</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></msup><mo>+</mo><msup><mi>μ</mi><mn>2</mn></msup><mi>𝔼</mi><mrow><mo>[</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>μ</mi><mi>τ</mi></msup><msub><mrow><mo>‖</mo><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+(1-\mu)^{2}\frac{\kappa^{2}}{b}\sum_{\tau=0}^{t-1}\mu^{2\tau}+\mu^{2}\mathbb{E}\left[\left(\sum_{\tau=0}^{t-1}\mu^{\tau}\left\|\nabla\!\mathcal{L}(\Theta_{t-\tau-1})-\nabla\!\mathcal{L}(\Theta_{t-\tau})\right\|_{F}\right)^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p2.8" class="ltx_p"><span id="A3.p2.8.1" class="ltx_text">Then by Cauchy-Schwarz inequality,</span></p>
<table id="A3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex56"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex56.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|E_{t+1}\right\|_{F}^{2}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|E_{t+1}\right\|_{F}^{2}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex56.m2" class="ltx_Math" alttext="\displaystyle\frac{\mu^{2t}\kappa^{2}}{b}+\frac{L\kappa\epsilon\mu^{t+1}}{\sqrt{b}}\frac{1-\mu^{t}}{1-\mu}+\frac{\eta L\kappa\mu^{t+1}}{\sqrt{b}}\sum_{\tau=0}^{t-1}\mu^{\tau}\sqrt{\mathbb{E}\left[\alpha_{t-\tau}^{2}\right]}+\frac{\kappa^{2}}{b}\frac{(1-\mu)(1-\mu^{2t})}{1+\mu}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><mi>b</mi></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mi>t</mi></msup></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></msqrt></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>2</mn></msup><mi>b</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mi>μ</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mu^{2t}\kappa^{2}}{b}+\frac{L\kappa\epsilon\mu^{t+1}}{\sqrt{b}}\frac{1-\mu^{t}}{1-\mu}+\frac{\eta L\kappa\mu^{t+1}}{\sqrt{b}}\sum_{\tau=0}^{t-1}\mu^{\tau}\sqrt{\mathbb{E}\left[\alpha_{t-\tau}^{2}\right]}+\frac{\kappa^{2}}{b}\frac{(1-\mu)(1-\mu^{2t})}{1+\mu}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex57.m1" class="ltx_Math" alttext="\displaystyle+L^{2}\mu^{2}\epsilon^{2}\left(\frac{1-\mu^{2t}}{1-\mu^{2}}\right)+\eta^{2}L^{2}\mu^{2}\left(\sum_{\tau=0}^{t-1}\mu^{2\tau}\right)\mathbb{E}\left[\sum_{\tau=0}^{t-1}\alpha_{t-\tau}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mn>2</mn></msubsup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+L^{2}\mu^{2}\epsilon^{2}\left(\frac{1-\mu^{2t}}{1-\mu^{2}}\right)+\eta^{2}L^{2}\mu^{2}\left(\sum_{\tau=0}^{t-1}\mu^{2\tau}\right)\mathbb{E}\left[\sum_{\tau=0}^{t-1}\alpha_{t-\tau}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex58"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex58.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex58.m2" class="ltx_Math" alttext="\displaystyle\frac{\mu^{2t}\kappa^{2}}{b}+\frac{L\kappa\epsilon\mu^{t+1}}{\sqrt{b}}\frac{1-\mu^{t}}{1-\mu}+\frac{\eta L\kappa\mu^{t+1}}{\sqrt{b}}\left(\sqrt{\frac{1-\mu^{2t}}{1-\mu^{2}}}\right)\sqrt{\mathbb{E}\left[\sum_{\tau=0}^{t-1}\alpha_{t-\tau}^{2}\right]}+\frac{\kappa^{2}}{b}\frac{(1-\mu)(1-\mu^{2t})}{1+\mu}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup></mrow><mi>b</mi></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mi>t</mi></msup></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msup></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></msqrt><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mn>2</mn></msubsup></mrow><mo>]</mo></mrow></mrow></msqrt></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>2</mn></msup><mi>b</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mi>μ</mi></mrow></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mu^{2t}\kappa^{2}}{b}+\frac{L\kappa\epsilon\mu^{t+1}}{\sqrt{b}}\frac{1-\mu^{t}}{1-\mu}+\frac{\eta L\kappa\mu^{t+1}}{\sqrt{b}}\left(\sqrt{\frac{1-\mu^{2t}}{1-\mu^{2}}}\right)\sqrt{\mathbb{E}\left[\sum_{\tau=0}^{t-1}\alpha_{t-\tau}^{2}\right]}+\frac{\kappa^{2}}{b}\frac{(1-\mu)(1-\mu^{2t})}{1+\mu}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E11.m1" class="ltx_Math" alttext="\displaystyle+L^{2}\mu^{2}\epsilon^{2}\left(\frac{1-\mu^{2t}}{1-\mu^{2}}\right)+\eta^{2}L^{2}\mu^{2}\left(\frac{1-\mu^{2t}}{1-\mu^{2}}\right)\mathbb{E}\left[\sum_{\tau=0}^{t-1}\alpha_{t-\tau}^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mn>2</mn></msubsup></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+L^{2}\mu^{2}\epsilon^{2}\left(\frac{1-\mu^{2t}}{1-\mu^{2}}\right)+\eta^{2}L^{2}\mu^{2}\left(\frac{1-\mu^{2t}}{1-\mu^{2}}\right)\mathbb{E}\left[\sum_{\tau=0}^{t-1}\alpha_{t-\tau}^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="A3.p2.9" class="ltx_p"><span id="A3.p2.9.1" class="ltx_text">Applying <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib34" title="" class="ltx_ref">34</a>, Lemma 3.2]</cite> gives</span></p>
<table id="A3.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex59.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\sum_{\tau=0}^{t-1}\alpha_{t-\tau}^{2}=\sum_{t=1}^{T}\sum_{\tau=1}^{t}\alpha_{\tau}^{2}=\sum_{t=1}^{T}(T-t+1)\alpha_{t}^{2}\leq T\sum_{t=1}^{T}\alpha_{t}^{2}\leq T\ln\left(\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><munderover><mo lspace="0.167em" movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></munderover><msubsup><mi>α</mi><mi>τ</mi><mn>2</mn></msubsup></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><mo>≤</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><mo>≤</mo><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\sum_{\tau=0}^{t-1}\alpha_{t-\tau}^{2}=\sum_{t=1}^{T}\sum_{\tau=1}^{t}\alpha_{\tau}^{2}=\sum_{t=1}^{T}(T-t+1)\alpha_{t}^{2}\leq T\sum_{t=1}^{T}\alpha_{t}^{2}\leq T\ln\left(\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p2.10" class="ltx_p"><span id="A3.p2.10.1" class="ltx_text">Also note that</span></p>
<table id="A3.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex60.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\frac{(1-\mu)(1-\mu^{2t})}{1+\mu}=\frac{1-\mu}{1+\mu}T-\frac{\mu^{2}}{(1+\mu)^{2}}(1-\mu^{2T})\leq\frac{1-\mu}{1+\mu}T." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>+</mo><mi>μ</mi></mrow></mfrac></mrow><mo>=</mo><mrow><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>μ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>−</mo><mrow><mfrac><msup><mi>μ</mi><mn>2</mn></msup><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>μ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\frac{(1-\mu)(1-\mu^{2t})}{1+\mu}=\frac{1-\mu}{1+\mu}T-\frac{\mu^{2}}{(1+\mu)^{2}}(1-\mu^{2T})\leq\frac{1-\mu}{1+\mu}T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p2.11" class="ltx_p"><span id="A3.p2.11.1" class="ltx_text">Therefore, it follows from Eq. (<a href="#A3.Ex56" title="In Proof. ‣ Appendix C Proof of Theorem ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>) that</span></p>
<table id="A3.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex61.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=0}^{T}\mathbb{E}\left[\left\|E_{t+1}\right\|_{F}^{2}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=0}^{T}\mathbb{E}\left[\left\|E_{t+1}\right\|_{F}^{2}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex61.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{1-\mu^{2}}\frac{\kappa^{2}}{b}+\frac{L\kappa\epsilon}{(1-\mu)^{2}\sqrt{b}}+\frac{1-\mu}{1+\mu}\frac{\kappa^{2}T}{b}+\frac{\eta^{2}L^{2}\mu^{2}}{1-\mu^{2}}T\left(\ln\left(\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>2</mn></msup><mi>b</mi></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>b</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>μ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mi>b</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{1-\mu^{2}}\frac{\kappa^{2}}{b}+\frac{L\kappa\epsilon}{(1-\mu)^{2}\sqrt{b}}+\frac{1-\mu}{1+\mu}\frac{\kappa^{2}T}{b}+\frac{\eta^{2}L^{2}\mu^{2}}{1-\mu^{2}}T\left(\ln\left(\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex62.m1" class="ltx_Math" alttext="\displaystyle+\frac{L^{2}\mu^{2}\epsilon^{2}T}{1-\mu^{2}}+\frac{\eta L\kappa}{\sqrt{b}\sqrt{1-\mu^{2}}}\sqrt{\left(\sum_{t=1}^{T}\mu^{2t+2}\right)\left(\sum_{t=1}^{T}\sum_{\tau=0}^{t-1}\alpha_{t-\tau}^{2}\right)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><msqrt><mi>b</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msup><mi>μ</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mn>2</mn></mrow></msup></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msubsup><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow><mn>2</mn></msubsup></mrow></mrow><mo>)</mo></mrow></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{L^{2}\mu^{2}\epsilon^{2}T}{1-\mu^{2}}+\frac{\eta L\kappa}{\sqrt{b}\sqrt{1-\mu^{2}}}\sqrt{\left(\sum_{t=1}^{T}\mu^{2t+2}\right)\left(\sum_{t=1}^{T}\sum_{\tau=0}^{t-1}\alpha_{t-\tau}^{2}\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex63.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex63.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{1-\mu^{2}}\frac{\kappa^{2}}{b}+\frac{L\kappa\epsilon}{(1-\mu)^{2}\sqrt{b}}+\frac{1-\mu}{1+\mu}\frac{\kappa^{2}T}{b}+\frac{\eta^{2}L^{2}\mu^{2}}{1-\mu^{2}}T\left(\ln\left(\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msup><mi>κ</mi><mn>2</mn></msup><mi>b</mi></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>b</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>μ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mi>b</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{1-\mu^{2}}\frac{\kappa^{2}}{b}+\frac{L\kappa\epsilon}{(1-\mu)^{2}\sqrt{b}}+\frac{1-\mu}{1+\mu}\frac{\kappa^{2}T}{b}+\frac{\eta^{2}L^{2}\mu^{2}}{1-\mu^{2}}T\left(\ln\left(\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E12.m1" class="ltx_Math" alttext="\displaystyle+\frac{L^{2}\mu^{2}\epsilon^{2}T}{1-\mu^{2}}+\frac{\mu\eta L\kappa}{(1-\mu^{2})\sqrt{b}}\sqrt{T\ln\left(\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>b</mi></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>T</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{L^{2}\mu^{2}\epsilon^{2}T}{1-\mu^{2}}+\frac{\mu\eta L\kappa}{(1-\mu^{2})\sqrt{b}}\sqrt{T\ln\left(\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="A3.p2.12" class="ltx_p"><span id="A3.p2.12.1" class="ltx_text">Then by Eq. (<a href="#A3.Ex35" title="In Proof. ‣ Appendix C Proof of Theorem ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>) and Eq. (<a href="#A3.Ex37" title="In Proof. ‣ Appendix C Proof of Theorem ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">8</span></a>),</span></p>
<table id="A3.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex64.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex65.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex65.m2" class="ltx_Math" alttext="\displaystyle\mathcal{L}(\Theta_{0})-\mathcal{L}_{\star}+2\eta\sqrt{\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}^{2}\right]}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}+2\epsilon\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\right]+\frac{L}{2}\epsilon^{2}T+\frac{\eta^{2}L}{2}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⋆</mo></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msqrt></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(\Theta_{0})-\mathcal{L}_{\star}+2\eta\sqrt{\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}^{2}\right]}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}+2\epsilon\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\right]+\frac{L}{2}\epsilon^{2}T+\frac{\eta^{2}L}{2}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex66.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex66.m2" class="ltx_Math" alttext="\displaystyle\mathcal{L}(\Theta_{0})-\mathcal{L}_{\star}+2\eta\sqrt{r\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{F}^{2}\right]}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}+2\epsilon\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\right]+\frac{L\epsilon^{2}T}{2}+\frac{\eta^{2}L}{2}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⋆</mo></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msqrt></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(\Theta_{0})-\mathcal{L}_{\star}+2\eta\sqrt{r\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{F}^{2}\right]}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}+2\epsilon\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\right]+\frac{L\epsilon^{2}T}{2}+\frac{\eta^{2}L}{2}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p2.13" class="ltx_p"><span id="A3.p2.13.1" class="ltx_text">where <math id="A3.p2.m5" class="ltx_Math" alttext="r:=\min\{m,n\}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>:=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>m</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r:=\min\{m,n\}.</annotation></semantics></math>
Combining the above with Eq. (<a href="#A3.Ex48" title="In Proof. ‣ Appendix C Proof of Theorem ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>) and Eq. (<a href="#A3.Ex61" title="In Proof. ‣ Appendix C Proof of Theorem ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) gives</span></p>
<table id="A3.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex67.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex68.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{T\epsilon}\sum_{t=1}^{T}\mathbb{E}\left[\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo>{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T\epsilon}\sum_{t=1}^{T}\mathbb{E}\left[\max\left\{\epsilon,\eta\alpha_{t}\right\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex69.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69.m2" class="ltx_Math" alttext="\displaystyle\frac{\Delta}{\epsilon T}+\frac{L\epsilon}{2}+\frac{\eta^{2}L}{2\epsilon T}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)+\frac{2}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\right]+\frac{2\eta}{T\epsilon}\sqrt{r\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{F}^{2}\right]}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\Delta}{\epsilon T}+\frac{L\epsilon}{2}+\frac{\eta^{2}L}{2\epsilon T}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)+\frac{2}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\right]+\frac{2\eta}{T\epsilon}\sqrt{r\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{F}^{2}\right]}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex70.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex70.m2" class="ltx_Math" alttext="\displaystyle\frac{\Delta}{\epsilon T}+\frac{L\epsilon}{2}+\frac{\eta^{2}L}{2\epsilon T}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)+2\left(\frac{\kappa\sqrt{r}}{(1-\mu)T\sqrt{b}}+\kappa\sqrt{\frac{r(1-\mu)}{b}}+\frac{\mu L\epsilon}{1-\mu}\right." display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>b</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>b</mi></mfrac></mstyle></msqrt></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\Delta}{\epsilon T}+\frac{L\epsilon}{2}+\frac{\eta^{2}L}{2\epsilon T}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)+2\left(\frac{\kappa\sqrt{r}}{(1-\mu)T\sqrt{b}}+\kappa\sqrt{\frac{r(1-\mu)}{b}}+\frac{\mu L\epsilon}{1-\mu}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex71.m1" class="ltx_Math" alttext="\displaystyle\left.+\frac{\mu\eta L}{(1-\mu)\sqrt{T}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)\right)+\frac{2\eta\sqrt{r}}{\sqrt{T}\epsilon}\left(\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}\right)\left(\frac{\sqrt{L\kappa\epsilon}}{(1-\mu)\sqrt{T}b^{1/4}}+\frac{L\mu\epsilon}{\sqrt{1-\mu^{2}}}\right." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><msqrt><mi>T</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msqrt><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msqrt><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></msqrt><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mi>b</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></msqrt></mfrac></mstyle></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\frac{\mu\eta L}{(1-\mu)\sqrt{T}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)\right)+\frac{2\eta\sqrt{r}}{\sqrt{T}\epsilon}\left(\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}\right)\left(\frac{\sqrt{L\kappa\epsilon}}{(1-\mu)\sqrt{T}b^{1/4}}+\frac{L\mu\epsilon}{\sqrt{1-\mu^{2}}}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.E13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E13.m1" class="ltx_Math" alttext="\displaystyle\left.+\frac{\kappa}{\sqrt{bT}\sqrt{1-\mu^{2}}}+\sqrt{\frac{1-\mu}{1+\mu}}\frac{\kappa}{\sqrt{b}}+\frac{\eta L\mu}{\sqrt{1-\mu^{2}}}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}+\frac{1}{(bT)^{1/4}}\sqrt{\frac{\mu\eta L\kappa}{1-\mu^{2}}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)^{1/4}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>κ</mi><mrow><msqrt><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></msqrt></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mrow><mn>1</mn><mo>+</mo><mi>μ</mi></mrow></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>κ</mi><msqrt><mi>b</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msqrt></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></msqrt><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.+\frac{\kappa}{\sqrt{bT}\sqrt{1-\mu^{2}}}+\sqrt{\frac{1-\mu}{1+\mu}}\frac{\kappa}{\sqrt{b}}+\frac{\eta L\mu}{\sqrt{1-\mu^{2}}}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}+\frac{1}{(bT)^{1/4}}\sqrt{\frac{\mu\eta L\kappa}{1-\mu^{2}}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)^{1/4}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
</div>
<div id="A3.p3" class="ltx_para">
<p id="A3.p3.1" class="ltx_p"><span id="A3.p3.1.1" class="ltx_text">In particular, if choosing <math id="A3.p3.m1" class="ltx_Math" alttext="b=1" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">b=1</annotation></semantics></math>, <math id="A3.p3.m2" class="ltx_Math" alttext="\epsilon=T^{-\frac{3}{4}}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><msup><mi>T</mi><mrow><mo>−</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">\epsilon=T^{-\frac{3}{4}}</annotation></semantics></math>,
<math id="A3.p3.m3" class="ltx_Math" alttext="1-\mu=T^{-\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo>=</mo><msup><mi>T</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">1-\mu=T^{-\frac{1}{2}}</annotation></semantics></math>, and <math id="A3.p3.m4" class="ltx_Math" alttext="\eta=T^{-\left(\frac{3}{8}+q\right)}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msup><mi>T</mi><mrow><mo>−</mo><mrow><mo>(</mo><mrow><mfrac><mn>3</mn><mn>8</mn></mfrac><mo>+</mo><mi>q</mi></mrow><mo>)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\eta=T^{-\left(\frac{3}{8}+q\right)}</annotation></semantics></math> for arbitrary <math id="A3.p3.m5" class="ltx_Math" alttext="q&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">q&gt;0</annotation></semantics></math>, then by Eq. (<a href="#A3.Ex67" title="In Proof. ‣ Appendix C Proof of Theorem ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>),</span></p>
<table id="A3.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex73.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex73.m2" class="ltx_Math" alttext="\displaystyle\frac{\Delta}{T^{1/4}}+\frac{L}{2T^{3/4}}+\frac{L}{2T^{1+2q}}\left(\ln T+1\right)+2\left(\frac{\kappa\sqrt{r}}{T^{1/2}}+\frac{\kappa\sqrt{r}}{T^{1/4}}+\frac{L}{T^{1/4}}+\frac{L}{T^{3/8+q}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>3</mn><mo>/</mo><mn>4</mn></mrow></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mn>1</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>L</mi><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><msup><mi>T</mi><mrow><mrow><mn>3</mn><mo>/</mo><mn>8</mn></mrow><mo>+</mo><mi>q</mi></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\Delta}{T^{1/4}}+\frac{L}{2T^{3/4}}+\frac{L}{2T^{1+2q}}\left(\ln T+1\right)+2\left(\frac{\kappa\sqrt{r}}{T^{1/2}}+\frac{\kappa\sqrt{r}}{T^{1/4}}+\frac{L}{T^{1/4}}+\frac{L}{T^{3/8+q}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex74"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex74.m1" class="ltx_Math" alttext="\displaystyle+2\left(\sqrt{\ln T+1}\right)\left(\frac{\sqrt{L\kappa r}}{T^{1/2+q}}+\frac{L\sqrt{r}}{T^{5/8+q}}+\frac{2\kappa\sqrt{r}}{T^{3/8+q}}+\frac{L\sqrt{r}}{T^{1/4+q}}\sqrt{\ln T+1}+\frac{\sqrt{rL\kappa}}{T^{5/16+3q/2}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)^{\frac{1}{4}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msqrt><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>+</mo><mn>1</mn></mrow></msqrt><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msqrt><msup><mi>T</mi><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mi>q</mi></mrow></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msup><mi>T</mi><mrow><mrow><mn>5</mn><mo>/</mo><mn>8</mn></mrow><mo>+</mo><mi>q</mi></mrow></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msup><mi>T</mi><mrow><mrow><mn>3</mn><mo>/</mo><mn>8</mn></mrow><mo>+</mo><mi>q</mi></mrow></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msup><mi>T</mi><mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow><mo>+</mo><mi>q</mi></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>ln</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow><mo>+</mo><mn>1</mn></mrow></msqrt></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msqrt><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></msqrt><msup><mi>T</mi><mrow><mrow><mn>5</mn><mo>/</mo><mn>16</mn></mrow><mo>+</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>/</mo><mn>2</mn></mrow></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow><mfrac><mn>1</mn><mn>4</mn></mfrac></msup></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+2\left(\sqrt{\ln T+1}\right)\left(\frac{\sqrt{L\kappa r}}{T^{1/2+q}}+\frac{L\sqrt{r}}{T^{5/8+q}}+\frac{2\kappa\sqrt{r}}{T^{3/8+q}}+\frac{L\sqrt{r}}{T^{1/4+q}}\sqrt{\ln T+1}+\frac{\sqrt{rL\kappa}}{T^{5/16+3q/2}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)^{\frac{1}{4}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex75"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex75.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex75.m2" class="ltx_Math" alttext="\displaystyle\mathcal{O}\left(\frac{\Delta+\kappa\sqrt{r}+L}{T^{1/4}}+\frac{L\sqrt{r}}{T^{1/4+q}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mo>+</mo><mi>L</mi></mrow><msup><mi>T</mi><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msup><mi>T</mi><mrow><mrow><mn>1</mn><mo>/</mo><mn>4</mn></mrow><mo>+</mo><mi>q</mi></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{O}\left(\frac{\Delta+\kappa\sqrt{r}+L}{T^{1/4}}+\frac{L\sqrt{r}}{T^{1/4+q}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p3.2" class="ltx_p"><span id="A3.p3.2.1" class="ltx_text">for large <math id="A3.p3.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>. The proof is thus completed.
∎</span></p>
</div>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Proof of Theorem <a href="#S3.Thmthm4" title="Theorem 3.4. ‣ 3 Convergence Analysis ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a></h2>

<div id="A4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p"><span id="A4.p1.1.1" class="ltx_text">Write</span></p>
<table id="A4.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex76.m1" class="ltx_Math" alttext="\alpha_{t}:=\frac{\min\{\left\|\nabla\!\mathcal{L}(\Theta_{t})\right\|,\gamma\}}{v_{t}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>:=</mo><mfrac><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>,</mo><mi>γ</mi><mo stretchy="false">}</mo></mrow></mrow><msub><mi>v</mi><mi>t</mi></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha_{t}:=\frac{\min\{\left\|\nabla\!\mathcal{L}(\Theta_{t})\right\|,\gamma\}}{v_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.2" class="ltx_p"><span id="A4.p1.2.1" class="ltx_text">By Lemma <a href="#A2.Thmthm1" title="Lemma B.1. ‣ Appendix B Useful Lemmas ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>,</span></p>
<table id="A4.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex77.m1" class="ltx_Math" alttext="\displaystyle\mathcal{L}(\Theta_{t})-\mathcal{L}(\Theta_{t-1})\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(\Theta_{t})-\mathcal{L}(\Theta_{t-1})\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex77.m2" class="ltx_Math" alttext="\displaystyle-\left\langle\nabla\!\mathcal{L}(\Theta_{t-1}),\max\{\epsilon,\eta\alpha_{t}\}O_{t}\right\rangle+\frac{L}{2}\max\{\epsilon^{2},\eta^{2}\alpha_{t}^{2}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>O</mi><mi>t</mi></msub></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mi>max</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo>,</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\left\langle\nabla\!\mathcal{L}(\Theta_{t-1}),\max\{\epsilon,\eta\alpha_{t}\}O_{t}\right\rangle+\frac{L}{2}\max\{\epsilon^{2},\eta^{2}\alpha_{t}^{2}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex78"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex78.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex78.m2" class="ltx_Math" alttext="\displaystyle-\max\{\epsilon,\eta\alpha_{t}\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}+\frac{L\epsilon^{2}}{2}+\frac{\eta^{2}L}{2}\alpha_{t}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">−</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\max\{\epsilon,\eta\alpha_{t}\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}+\frac{L\epsilon^{2}}{2}+\frac{\eta^{2}L}{2}\alpha_{t}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.3" class="ltx_p"><span id="A4.p1.3.1" class="ltx_text">Hence, by Lemma <a href="#A2.Thmthm2" title="Lemma B.2. ‣ Appendix B Useful Lemmas ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>,</span></p>
<table id="A4.Ex79" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex79.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\max\{\epsilon,\alpha_{t}\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\leq\Delta+\frac{L\epsilon^{2}T}{2}+\frac{\eta^{2}L}{2}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><msub><mi>α</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow></mrow></mrow><mo>≤</mo><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mn>2</mn></mfrac><mo>+</mo><mrow><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\max\{\epsilon,\alpha_{t}\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\leq\Delta+\frac{L\epsilon^{2}T}{2}+\frac{\eta^{2}L}{2}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p1.4" class="ltx_p"><span id="A4.p1.4.1" class="ltx_text">It follows that</span></p>
<table id="A4.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex80.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=1}^{T}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=1}^{T}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex80.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{T\epsilon}\sum_{t=1}^{T}\max\{\epsilon,\alpha_{t}\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><msub><mi>α</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T\epsilon}\sum_{t=1}^{T}\max\{\epsilon,\alpha_{t}\}\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex81.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex81.m2" class="ltx_Math" alttext="\displaystyle\frac{\Delta}{T\epsilon}+\frac{L\epsilon}{2}+\frac{\eta^{2}L}{2T\epsilon}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\Delta}{T\epsilon}+\frac{L\epsilon}{2}+\frac{\eta^{2}L}{2T\epsilon}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.p2" class="ltx_para ltx_noindent">
<p id="A4.p2.1" class="ltx_p"><span id="A4.p2.1.1" class="ltx_text">In particular, if choosing <math id="A4.p2.m1" class="ltx_Math" alttext="\epsilon=T^{-\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><msup><mi>T</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">\epsilon=T^{-\frac{1}{2}}</annotation></semantics></math> and <math id="A4.p2.m2" class="ltx_Math" alttext="\eta=T^{-q}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msup><mi>T</mi><mrow><mo>−</mo><mi>q</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\eta=T^{-q}</annotation></semantics></math> for arbitrary <math id="A4.p2.m3" class="ltx_Math" alttext="q&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q&gt;0,</annotation></semantics></math> then</span></p>
<table id="A4.Ex82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex82.m1" class="ltx_Math" alttext="\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]\leq\frac{2\Delta+L}{2\sqrt{T}}+\frac{L}{2T^{2q+1/2}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow><mo>+</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mfrac><mo>+</mo><mrow><mfrac><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow><mo>+</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow></msup></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]\leq\frac{2\Delta+L}{2\sqrt{T}}+\frac{L}{2T^{2q+1/2}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.2" class="ltx_p"><span id="A4.p2.2.1" class="ltx_text">For large <math id="A4.p2.m4" class="ltx_Math" alttext="T&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">T&gt;0</annotation></semantics></math>,</span></p>
<table id="A4.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex83.m1" class="ltx_Math" alttext="\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]\leq\mathcal{O}\left(\frac{\Delta+L}{\sqrt{T}}\right)" display="block" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo>+</mo><mi>L</mi></mrow><msqrt><mi>T</mi></msqrt></mfrac><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]\leq\mathcal{O}\left(\frac{\Delta+L}{\sqrt{T}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p2.3" class="ltx_p"><span id="A4.p2.3.1" class="ltx_text">The proof is thus completed.
∎</span></p>
</div>
</div>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Proof of Theorem <a href="#S3.Thmthm5" title="Theorem 3.5. ‣ 3 Convergence Analysis ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.5</span></a></h2>

<div id="A5.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.p1" class="ltx_para ltx_noindent">
<p id="A5.p1.1" class="ltx_p"><span id="A5.p1.1.1" class="ltx_text">Write</span></p>
<table id="A5.Ex84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex84.m1" class="ltx_Math" alttext="\alpha_{t}:=\frac{\min\{\left\|G_{t}\right\|,\gamma\}}{v_{t}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>α</mi><mi>t</mi></msub><mo>:=</mo><mfrac><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>‖</mo><msub><mi>G</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>,</mo><mi>γ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><msub><mi>v</mi><mi>t</mi></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\alpha_{t}:=\frac{\min\{\left\|G_{t}\right\|,\gamma\}}{v_{t}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p1.2" class="ltx_p"><span id="A5.p1.2.1" class="ltx_text">Let <math id="A5.p1.m1" class="ltx_math_unparsed" alttext="\mathbb{E}_{t}[\cdot]:=\mathbb{E}[\cdot|\Theta_{t-1}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow><mo>:=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{t}[\cdot]:=\mathbb{E}[\cdot|\Theta_{t-1}]</annotation></semantics></math> denote the conditional expectation given the previous iterates
<math id="A5.p1.m2" class="ltx_Math" alttext="\Theta_{0},\cdots,\Theta_{t-1}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi mathvariant="normal">Θ</mi><mn>0</mn></msub><mo>,</mo><mo lspace="0em" rspace="0em">⋯</mo><mo>,</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Theta_{0},\cdots,\Theta_{t-1}.</annotation></semantics></math> By Lemma <a href="#A2.Thmthm1" title="Lemma B.1. ‣ Appendix B Useful Lemmas ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>,</span></p>
<table id="A5.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex85.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t}\left[\mathcal{L}(\Theta_{t})-\mathcal{L}(\Theta_{t-1})\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t}\left[\mathcal{L}(\Theta_{t})-\mathcal{L}(\Theta_{t-1})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex86.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex86.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t}\left[-\left\langle\nabla\!\mathcal{L}(\Theta_{t-1}),\max\{\epsilon,\eta\alpha_{t}\}O_{t}\right\rangle\right]+\frac{L}{2}\mathbb{E}_{t}\left[\max\{\epsilon^{2},\eta^{2}\alpha_{t}^{2}\}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>O</mi><mi>t</mi></msub></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msup><mi>ϵ</mi><mn>2</mn></msup><mo>,</mo><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t}\left[-\left\langle\nabla\!\mathcal{L}(\Theta_{t-1}),\max\{\epsilon,\eta\alpha_{t}\}O_{t}\right\rangle\right]+\frac{L}{2}\mathbb{E}_{t}\left[\max\{\epsilon^{2},\eta^{2}\alpha_{t}^{2}\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex87.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex87.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t}\left[-\left\langle\nabla\!\mathcal{L}(\Theta_{t-1})-G_{t},\max\{\epsilon,\eta\alpha_{t}\}O_{t}\right\rangle\right]-\mathbb{E}_{t}\left[\max\{\epsilon,\eta\alpha_{t}\}\left\|G_{t}\right\|_{*}\right]+\frac{L\epsilon^{2}}{2}+\frac{\eta^{2}L}{2}\mathbb{E}_{t}\left[\alpha_{t}^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mo>−</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>G</mi><mi>t</mi></msub></mrow><mo>,</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>O</mi><mi>t</mi></msub></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>G</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t}\left[-\left\langle\nabla\!\mathcal{L}(\Theta_{t-1})-G_{t},\max\{\epsilon,\eta\alpha_{t}\}O_{t}\right\rangle\right]-\mathbb{E}_{t}\left[\max\{\epsilon,\eta\alpha_{t}\}\left\|G_{t}\right\|_{*}\right]+\frac{L\epsilon^{2}}{2}+\frac{\eta^{2}L}{2}\mathbb{E}_{t}\left[\alpha_{t}^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex88.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex88.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})-G_{t}\right\|_{*}\left(\epsilon+\eta\alpha_{t}\right)\right]-\mathbb{E}_{t}\left[\max\{\epsilon,\eta\alpha_{t}\}\left\|G_{t}\right\|_{*}\right]+\frac{L\epsilon^{2}}{2}+\frac{\eta^{2}L}{2}\mathbb{E}_{t}\left[\alpha_{t}^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>G</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>ϵ</mi><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow></mrow><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>G</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})-G_{t}\right\|_{*}\left(\epsilon+\eta\alpha_{t}\right)\right]-\mathbb{E}_{t}\left[\max\{\epsilon,\eta\alpha_{t}\}\left\|G_{t}\right\|_{*}\right]+\frac{L\epsilon^{2}}{2}+\frac{\eta^{2}L}{2}\mathbb{E}_{t}\left[\alpha_{t}^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p1.3" class="ltx_p"><span id="A5.p1.3.1" class="ltx_text">Write <math id="A5.p1.m3" class="ltx_Math" alttext="E_{t}:=\nabla\!\mathcal{L}(\Theta_{t-1})-G_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>E</mi><mi>t</mi></msub><mo>:=</mo><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>G</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">E_{t}:=\nabla\!\mathcal{L}(\Theta_{t-1})-G_{t}</annotation></semantics></math>. It follows that</span></p>
<table id="A5.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex89.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t}\left[\left\|G_{t}\right\|_{*}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><msub><mi>G</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t}\left[\left\|G_{t}\right\|_{*}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex89.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{\epsilon}\mathbb{E}_{t}\left[\max\{\epsilon,\eta\alpha_{t}\}\left\|G_{t}\right\|_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>ϵ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>G</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\epsilon}\mathbb{E}_{t}\left[\max\{\epsilon,\eta\alpha_{t}\}\left\|G_{t}\right\|_{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex90.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex90.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{t}\left[\frac{\mathcal{L}(\Theta_{t-1})-\mathcal{L}(\Theta_{t})}{\epsilon}\right]+\mathbb{E}_{t}\left[\left\|E_{t}\right\|_{*}\right]+\frac{\eta}{\epsilon}\mathbb{E}_{t}\left[\left\|E_{t}\right\|_{*}\alpha_{t}\right]+\frac{L\epsilon}{2}+\frac{\eta^{2}L}{2\epsilon}\mathbb{E}_{t}\left[\alpha_{t}^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>ϵ</mi></mfrac></mstyle><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mi>ϵ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{t}\left[\frac{\mathcal{L}(\Theta_{t-1})-\mathcal{L}(\Theta_{t})}{\epsilon}\right]+\mathbb{E}_{t}\left[\left\|E_{t}\right\|_{*}\right]+\frac{\eta}{\epsilon}\mathbb{E}_{t}\left[\left\|E_{t}\right\|_{*}\alpha_{t}\right]+\frac{L\epsilon}{2}+\frac{\eta^{2}L}{2\epsilon}\mathbb{E}_{t}\left[\alpha_{t}^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p1.4" class="ltx_p"><span id="A5.p1.4.1" class="ltx_text">Then by Jensen’s inequality,</span></p>
<table id="A5.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex91.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex91.m2" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}_{t}\left[\left\|G_{t}\right\|_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><msub><mi>G</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}_{t}\left[\left\|G_{t}\right\|_{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex92.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex92.m2" class="ltx_Math" alttext="\displaystyle\frac{\Delta}{\epsilon T}+\frac{1}{T}\sum_{t=1}^{T}\sqrt{\mathbb{E}_{t}\left[\left\|E_{t}\right\|_{*}^{2}\right]}+\frac{\epsilon L}{2}+\frac{\eta^{2}L}{2\epsilon T}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]+\frac{\eta}{T\epsilon}\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\alpha_{t}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msqrt><mrow><msub><mi>𝔼</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></msqrt></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\Delta}{\epsilon T}+\frac{1}{T}\sum_{t=1}^{T}\sqrt{\mathbb{E}_{t}\left[\left\|E_{t}\right\|_{*}^{2}\right]}+\frac{\epsilon L}{2}+\frac{\eta^{2}L}{2\epsilon T}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]+\frac{\eta}{T\epsilon}\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\alpha_{t}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E14.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E14.m2" class="ltx_Math" alttext="\displaystyle\frac{\Delta}{\epsilon T}+\frac{\epsilon L}{2}+\frac{\kappa\sqrt{r}}{T}\sum_{t=1}^{T}\frac{1}{\sqrt{b_{t}}}+\frac{\eta^{2}L}{2\epsilon T}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]+\frac{\eta}{T\epsilon}\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\alpha_{t}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>b</mi><mi>t</mi></msub></msqrt></mfrac></mstyle></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>η</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\Delta}{\epsilon T}+\frac{\epsilon L}{2}+\frac{\kappa\sqrt{r}}{T}\sum_{t=1}^{T}\frac{1}{\sqrt{b_{t}}}+\frac{\eta^{2}L}{2\epsilon T}\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]+\frac{\eta}{T\epsilon}\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\alpha_{t}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
<p id="A5.p1.5" class="ltx_p"><span id="A5.p1.5.1" class="ltx_text">By Lemma <a href="#A2.Thmthm2" title="Lemma B.2. ‣ Appendix B Useful Lemmas ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>,</span></p>
<table id="A5.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E15.m1" class="ltx_Math" alttext="\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]\leq\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]\leq\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A5.p1.6" class="ltx_p"><span id="A5.p1.6.1" class="ltx_text">Then by Cauchy-Schwarz inequality,</span></p>
<table id="A5.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex93.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\alpha_{t}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\mathbb{E}\left[\left\|E_{t}\right\|_{*}\alpha_{t}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex93.m2" class="ltx_Math" alttext="\displaystyle\sum_{t=1}^{T}\sqrt{\mathbb{E}\left[\left\|E_{t}\right\|_{*}^{2}\right]\mathbb{E}\left[\alpha_{t}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><msqrt><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><msub><mi>E</mi><mi>t</mi></msub><mo>‖</mo></mrow><mo>∗</mo><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=1}^{T}\sqrt{\mathbb{E}\left[\left\|E_{t}\right\|_{*}^{2}\right]\mathbb{E}\left[\alpha_{t}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex94.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex94.m2" class="ltx_Math" alttext="\displaystyle\sqrt{\sum_{t=1}^{T}\frac{\kappa^{2}r}{b_{t}}}\sqrt{\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]}" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>b</mi><mi>t</mi></msub></mfrac></mstyle></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msubsup><mi>α</mi><mi>t</mi><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{\sum_{t=1}^{T}\frac{\kappa^{2}r}{b_{t}}}\sqrt{\sum_{t=1}^{T}\mathbb{E}\left[\alpha_{t}^{2}\right]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E16.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E16.m2" class="ltx_Math" alttext="\displaystyle\kappa\sqrt{\sum_{t=1}^{T}\frac{r}{b_{t}}}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mi>r</mi><msub><mi>b</mi><mi>t</mi></msub></mfrac></mstyle></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\kappa\sqrt{\sum_{t=1}^{T}\frac{r}{b_{t}}}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A5.p1.7" class="ltx_p"><span id="A5.p1.7.1" class="ltx_text">Combining Eq. (<a href="#A5.Ex91" title="In Proof. ‣ Appendix E Proof of Theorem ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">14</span></a>), Eq. (<a href="#A5.E15" title="Equation 15 ‣ Proof. ‣ Appendix E Proof of Theorem ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) and Eq. (<a href="#A5.Ex93" title="In Proof. ‣ Appendix E Proof of Theorem ‣ AdaGrad Meets Muon: Adaptive Stepsizesfor Orthogonal Updates" class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>) gives</span></p>
<table id="A5.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex95.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex96.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex96.m2" class="ltx_Math" alttext="\displaystyle\frac{\Delta}{\epsilon T}+\frac{\epsilon L}{2}+\frac{\eta^{2}L}{2T\epsilon}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)+\frac{\kappa\sqrt{r}}{T}\left(\sum_{t=1}^{T}\frac{1}{\sqrt{b_{t}}}\right)+\frac{\kappa\eta}{T\epsilon}\sqrt{\sum_{t=1}^{T}\frac{r}{b_{t}}}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><msub><mi>b</mi><mi>t</mi></msub></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mi>r</mi><msub><mi>b</mi><mi>t</mi></msub></mfrac></mstyle></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\Delta}{\epsilon T}+\frac{\epsilon L}{2}+\frac{\eta^{2}L}{2T\epsilon}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)+\frac{\kappa\sqrt{r}}{T}\left(\sum_{t=1}^{T}\frac{1}{\sqrt{b_{t}}}\right)+\frac{\kappa\eta}{T\epsilon}\sqrt{\sum_{t=1}^{T}\frac{r}{b_{t}}}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.p2" class="ltx_para">
<p id="A5.p2.1" class="ltx_p"><span id="A5.p2.1.1" class="ltx_text">In particular, if the batch size <math id="A5.p2.m1" class="ltx_Math" alttext="b_{t}=\sqrt{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>b</mi><mi>t</mi></msub><mo>=</mo><msqrt><mi>t</mi></msqrt></mrow><annotation encoding="application/x-tex">b_{t}=\sqrt{t}</annotation></semantics></math>, <math id="A5.p2.m2" class="ltx_Math" alttext="\epsilon=T^{-\frac{1}{2}}" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>=</mo><msup><mi>T</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">\epsilon=T^{-\frac{1}{2}}</annotation></semantics></math> and <math id="A5.p2.m3" class="ltx_Math" alttext="\eta=T^{-q}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><msup><mi>T</mi><mrow><mo>−</mo><mi>q</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\eta=T^{-q}</annotation></semantics></math> for
arbitrary <math id="A5.p2.m4" class="ltx_Math" alttext="q&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mi>q</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">q&gt;0,</annotation></semantics></math> then</span></p>
<table id="A5.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex97.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=1}^{T}\mathbb{E}\left[\left\|\nabla\!\mathcal{L}(\Theta_{t-1})\right\|_{*}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex97.m2" class="ltx_Math" alttext="\displaystyle\frac{\Delta}{\sqrt{T}}+\frac{L}{2\sqrt{T}}+\frac{4\kappa\sqrt{r}}{3T^{\frac{1}{4}}}+\frac{\sqrt{2r}\kappa}{T^{\frac{1}{4}+q}}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}+\frac{L}{2T^{\frac{1}{2}+2q}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi mathvariant="normal">Δ</mi><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mfrac><mn>1</mn><mn>4</mn></mfrac></msup></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><msup><mi>T</mi><mrow><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>+</mo><mi>q</mi></mrow></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></msqrt></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>T</mi><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>q</mi></mrow></mrow></msup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\Delta}{\sqrt{T}}+\frac{L}{2\sqrt{T}}+\frac{4\kappa\sqrt{r}}{3T^{\frac{1}{4}}}+\frac{\sqrt{2r}\kappa}{T^{\frac{1}{4}+q}}\sqrt{\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1}+\frac{L}{2T^{\frac{1}{2}+2q}}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
