<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E10.m2" class="ltx_Math" alttext="\displaystyle\frac{\kappa\sqrt{r}}{(1-\mu)\sqrt{b}}+T\kappa\sqrt{\frac{r(1-\mu)}{b}}+\frac{T\mu L\epsilon}{1-\mu}+\frac{\mu\eta L}{1-\mu}\sqrt{T}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>b</mi></msqrt></mrow></mfrac></mstyle><mo>+</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>b</mi></mfrac></mstyle></msqrt></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>γ</mi><mn>2</mn></msup><msubsup><mi>v</mi><mn>0</mn><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\kappa\sqrt{r}}{(1-\mu)\sqrt{b}}+T\kappa\sqrt{\frac{r(1-\mu)}{b}}+\frac{T\mu L\epsilon}{1-\mu}+\frac{\mu\eta L}{1-\mu}\sqrt{T}\left(\ln\left(\frac{\gamma^{2}}{v_{0}^{2}}T\right)+1\right).</annotation></semantics></math></td>
