<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex47.m2" class="ltx_Math" alttext="\displaystyle\frac{\mu^{t}\kappa\sqrt{r}}{\sqrt{b}}+(1-\mu)\frac{\kappa\sqrt{r}}{\sqrt{b}}\sqrt{\frac{1-\mu^{2t}}{1-\mu^{2}}}+\mu L\epsilon\frac{1-\mu^{t}}{1-\mu}+\mu\eta L\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\alpha_{t-\tau}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>μ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msup></mrow><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mn>2</mn></msup></mrow></mfrac></mstyle></msqrt></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mi>t</mi></msup></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mu^{t}\kappa\sqrt{r}}{\sqrt{b}}+(1-\mu)\frac{\kappa\sqrt{r}}{\sqrt{b}}\sqrt{\frac{1-\mu^{2t}}{1-\mu^{2}}}+\mu L\epsilon\frac{1-\mu^{t}}{1-\mu}+\mu\eta L\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\alpha_{t-\tau}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p2.6" class="ltx_p"><span id="A3.p2.6.1" class="ltx_text">Therefore,</span></p>
