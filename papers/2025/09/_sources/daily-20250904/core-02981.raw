</table>
<p id="A3.p2.2" class="ltx_p"><span id="A3.p2.2.1" class="ltx_text">Now write <math id="A3.p2.m1" class="ltx_Math" alttext="\tilde{E}_{t}:=G_{t}-\nabla\!\mathcal{L}(\Theta_{t-1})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>E</mi><mo>~</mo></mover><mi>t</mi></msub><mo>:=</mo><mrow><msub><mi>G</mi><mi>t</mi></msub><mo>−</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{E}_{t}:=G_{t}-\nabla\!\mathcal{L}(\Theta_{t-1})</annotation></semantics></math> for <math id="A3.p2.m2" class="ltx_Math" alttext="t\geq 1." display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>≥</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t\geq 1.</annotation></semantics></math>
Then</span></p>
<table id="A3.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex39.m1" class="ltx_Math" alttext="\displaystyle M_{t+1}=" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle M_{t+1}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex39.m2" class="ltx_Math" alttext="\displaystyle\mu M_{t}+(1-\mu)G_{t+1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>G</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu M_{t}+(1-\mu)G_{t+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex40.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex40.m2" class="ltx_Math" alttext="\displaystyle\mu\left(E_{t}+\nabla\!\mathcal{L}(\Theta_{t-1})\right)+(1-\mu)\left(\tilde{E}_{t+1}+\nabla\!\mathcal{L}(\Theta_{t})\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>E</mi><mi>t</mi></msub><mo>+</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>E</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>+</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mu\left(E_{t}+\nabla\!\mathcal{L}(\Theta_{t-1})\right)+(1-\mu)\left(\tilde{E}_{t+1}+\nabla\!\mathcal{L}(\Theta_{t})\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex41.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex41.m2" class="ltx_Math" alttext="\displaystyle\nabla\!\mathcal{L}(\Theta_{t})+\mu\left(\nabla\!\mathcal{L}(\Theta_{t-1})-\nabla\!\mathcal{L}(\Theta_{t})\right)+\mu E_{t}+(1-\mu)\tilde{E}_{t+1}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>E</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\nabla\!\mathcal{L}(\Theta_{t})+\mu\left(\nabla\!\mathcal{L}(\Theta_{t-1})-\nabla\!\mathcal{L}(\Theta_{t})\right)+\mu E_{t}+(1-\mu)\tilde{E}_{t+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p2.3" class="ltx_p"><span id="A3.p2.3.1" class="ltx_text">Hence, for <math id="A3.p2.m3" class="ltx_Math" alttext="t\geq 0," display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">t\geq 0,</annotation></semantics></math></span></p>
<table id="A3.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex42.m1" class="ltx_Math" alttext="E_{t+1}=\mu\left(\nabla\!\mathcal{L}(\Theta_{t-1})-\nabla\!\mathcal{L}(\Theta_{t})\right)+\mu E_{t}+(1-\mu)\tilde{E}_{t+1}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><mi>μ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mi>t</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>E</mi><mo>~</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{t+1}=\mu\left(\nabla\!\mathcal{L}(\Theta_{t-1})-\nabla\!\mathcal{L}(\Theta_{t})\right)+\mu E_{t}+(1-\mu)\tilde{E}_{t+1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.p2.4" class="ltx_p"><span id="A3.p2.4.1" class="ltx_text">A recursive formula can be derived as in the proof of <cite class="ltx_cite ltx_citemacro_citep">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>, Theorem]</cite>:</span></p>
<table id="A3.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E9.m1" class="ltx_Math" alttext="E_{t+1}=\mu^{t}E_{1}+(1-\mu)\sum_{\tau=0}^{t-1}\mu^{\tau}\tilde{E}_{t+1-\tau}+\mu\sum_{\tau=0}^{t-1}\mu^{\tau}\left(\nabla\!\mathcal{L}(\Theta_{t-\tau-1})-\nabla\!\mathcal{L}(\Theta_{t-\tau})\right)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>E</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><msup><mi>μ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>E</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>E</mi><mo>~</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>τ</mi></mrow></msub></mrow></mrow></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo>∇</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi mathvariant="normal">Θ</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">E_{t+1}=\mu^{t}E_{1}+(1-\mu)\sum_{\tau=0}^{t-1}\mu^{\tau}\tilde{E}_{t+1-\tau}+\mu\sum_{\tau=0}^{t-1}\mu^{\tau}\left(\nabla\!\mathcal{L}(\Theta_{t-\tau-1})-\nabla\!\mathcal{L}(\Theta_{t-\tau})\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
<p id="A3.p2.5" class="ltx_p"><span id="A3.p2.5.1" class="ltx_text">Assuming a minibatch of size <math id="A3.p2.m4" class="ltx_Math" alttext="b&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">b&gt;0</annotation></semantics></math> is sampled independently at each iteration, it follows that</span></p>
<table id="A3.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex43"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex43.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left\|E_{t+1}\right\|_{*}\right]\leq\mu^{t}\mathbb{E}\left[\left\|E_{1}\right\|_{*}\right]+(1-\mu)\mathbb{E}\left[\left\|\sum_{\tau=0}^{t-1}\mu^{\tau}\tilde{E}_{t+1-\tau}\right\|_{*}\right]+\mu L\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\max\{\epsilon,\eta\alpha_{t-\tau}\}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><msub><mi>E</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><msup><mi>μ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><msub><mi>E</mi><mn>1</mn></msub><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>E</mi><mo>~</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>τ</mi></mrow></msub></mrow></mrow><mo>‖</mo></mrow><mo>∗</mo></msub><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mi>ϵ</mi><mo>,</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msub></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left\|E_{t+1}\right\|_{*}\right]\leq\mu^{t}\mathbb{E}\left[\left\|E_{1}\right\|_{*}\right]+(1-\mu)\mathbb{E}\left[\left\|\sum_{\tau=0}^{t-1}\mu^{\tau}\tilde{E}_{t+1-\tau}\right\|_{*}\right]+\mu L\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\max\{\epsilon,\eta\alpha_{t-\tau}\}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex44.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex44.m2" class="ltx_Math" alttext="\displaystyle\frac{\mu^{t}\kappa\sqrt{r}}{\sqrt{b}}+(1-\mu)\sqrt{r}\mathbb{E}\left[\left\|\sum_{\tau=0}^{t-1}\mu^{\tau}\tilde{E}_{t+1-\tau}\right\|_{F}\right]+\mu L\epsilon\frac{1-\mu^{t}}{1-\mu}+\mu\eta L\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\alpha_{t-\tau}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>μ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>E</mi><mo>~</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>τ</mi></mrow></msub></mrow></mrow><mo>‖</mo></mrow><mi>F</mi></msub><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mi>t</mi></msup></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mu^{t}\kappa\sqrt{r}}{\sqrt{b}}+(1-\mu)\sqrt{r}\mathbb{E}\left[\left\|\sum_{\tau=0}^{t-1}\mu^{\tau}\tilde{E}_{t+1-\tau}\right\|_{F}\right]+\mu L\epsilon\frac{1-\mu^{t}}{1-\mu}+\mu\eta L\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\alpha_{t-\tau}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex45"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex45.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex45.m2" class="ltx_Math" alttext="\displaystyle\frac{\mu^{t}\kappa\sqrt{r}}{\sqrt{b}}+(1-\mu)\sqrt{r}\mathbb{E}\left[\left\|\sum_{\tau=0}^{t-1}\mu^{\tau}\tilde{E}_{t+1-\tau}\right\|_{F}^{2}\right]^{\frac{1}{2}}+\mu L\epsilon\frac{1-\mu^{t}}{1-\mu}+\mu\eta L\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\alpha_{t-\tau}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>μ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>[</mo><msubsup><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>E</mi><mo>~</mo></mover><mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mi>τ</mi></mrow></msub></mrow></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo>]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mi>t</mi></msup></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mu^{t}\kappa\sqrt{r}}{\sqrt{b}}+(1-\mu)\sqrt{r}\mathbb{E}\left[\left\|\sum_{\tau=0}^{t-1}\mu^{\tau}\tilde{E}_{t+1-\tau}\right\|_{F}^{2}\right]^{\frac{1}{2}}+\mu L\epsilon\frac{1-\mu^{t}}{1-\mu}+\mu\eta L\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\alpha_{t-\tau}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex46"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex46.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex46.m2" class="ltx_Math" alttext="\displaystyle\frac{\mu^{t}\kappa\sqrt{r}}{\sqrt{b}}+(1-\mu)\frac{\kappa\sqrt{r}}{\sqrt{b}}\sqrt{\sum_{\tau=0}^{t-1}\mu^{2\tau}}+\mu L\epsilon\frac{1-\mu^{t}}{1-\mu}+\mu\eta L\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\alpha_{t-\tau}\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>μ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>r</mi></msqrt></mrow><msqrt><mi>b</mi></msqrt></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mi>μ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></msup></mrow></msqrt></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>μ</mi><mi>t</mi></msup></mrow><mrow><mn>1</mn><mo>−</mo><mi>μ</mi></mrow></mfrac></mstyle></mrow><mo>+</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>τ</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>μ</mi><mi>τ</mi></msup><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msub><mi>α</mi><mrow><mi>t</mi><mo>−</mo><mi>τ</mi></mrow></msub><mo>]</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mu^{t}\kappa\sqrt{r}}{\sqrt{b}}+(1-\mu)\frac{\kappa\sqrt{r}}{\sqrt{b}}\sqrt{\sum_{\tau=0}^{t-1}\mu^{2\tau}}+\mu L\epsilon\frac{1-\mu^{t}}{1-\mu}+\mu\eta L\sum_{\tau=0}^{t-1}\mu^{\tau}\mathbb{E}\left[\alpha_{t-\tau}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
