<span id="A13.T19.5.3.3.1.1" class="ltx_p"><math id="A13.T19.m2" class="ltx_Math" alttext="8.7\%" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">8.7</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">8.7\%</annotation></semantics></math></span>
</span></td>
