</span></th>
<th id="S4.T1.5.2.6" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t">
<span id="S4.T1.5.2.6.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.5.2.6.1.1" class="ltx_p"><span id="S4.T1.5.2.6.1.1.1" class="ltx_text" style="font-size:80%;">cog</span><math id="S4.T1.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.800em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
</span></th>
<th id="S4.T1.5.2.7" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t">
<span id="S4.T1.5.2.7.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.5.2.7.1.1" class="ltx_p"><span id="S4.T1.5.2.7.1.1.1" class="ltx_text" style="font-size:80%;">acc</span><math id="S4.T1.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo mathsize="0.800em" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span>
</span></th>
