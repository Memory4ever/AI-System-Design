<td id="S3.T2.3.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">All</span></td>
<td id="S3.T2.3.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Perplexity</span></td>
<td id="S3.T2.3.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Bing Copilot</span></td>
<td id="S3.T2.3.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.2.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">YouChat</span></td>
<td id="S3.T2.3.2.6" class="ltx_td"></td>
<td id="S3.T2.3.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.2.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">All</span></td>
<td id="S3.T2.3.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.2.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Perplexity</span></td>
<td id="S3.T2.3.2.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.2.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Bing Copilot</span></td>
<td id="S3.T2.3.2.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.2.10.1" class="ltx_text ltx_font_bold" style="font-size:90%;">YouChat</span></td></tr>
<tr id="S3.T2.3.3" class="ltx_tr">
<td id="S3.T2.3.3.1" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.3.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Mean</span></td>
<td id="S3.T2.3.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.3.3.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">4.31</span></td>
