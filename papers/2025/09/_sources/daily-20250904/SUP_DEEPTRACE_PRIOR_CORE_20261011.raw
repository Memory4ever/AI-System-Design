<td id="S5.F8.sf1.3.17.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">24.4 <span id="S5.F8.sf1.3.17.2.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td>
<td id="S5.F8.sf1.3.17.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">20.5 <span id="S5.F8.sf1.3.17.3.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td>
<td id="S5.F8.sf1.3.17.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">23.0 <span id="S5.F8.sf1.3.17.4.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td></tr>
