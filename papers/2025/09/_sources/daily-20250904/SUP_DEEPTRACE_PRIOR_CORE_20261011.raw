<td id="S5.F8.sf1.3.10.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">75.5 <span id="S5.F8.sf1.3.10.2.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td>
