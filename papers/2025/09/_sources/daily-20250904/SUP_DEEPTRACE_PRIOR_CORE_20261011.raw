<td id="S5.F8.sf1.3.12.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">1.1 <span id="S5.F8.sf1.3.12.2.1" class="ltx_text" style="--ltx-fg-color:#16C056;">▲</span></td>
<td id="S5.F8.sf1.3.12.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">36.2 <span id="S5.F8.sf1.3.12.3.1" class="ltx_text" style="--ltx-fg-color:#EF2E65;">▼</span></td>
<td id="S5.F8.sf1.3.12.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">8.4 <span id="S5.F8.sf1.3.12.4.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td></tr>
