<span id="S4.T6.3.1.4.1.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
<span id="S4.T6.3.1.4.1.1.1" class="ltx_p">Minimize fluff information</span>
</span></td>
<td id="S4.T6.3.1.4.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:2pt;padding-bottom:2pt;">
