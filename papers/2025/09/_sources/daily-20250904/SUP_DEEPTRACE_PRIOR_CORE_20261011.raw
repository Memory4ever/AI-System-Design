<td id="S5.F8.sf1.3.13.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">30.8 <span id="S5.F8.sf1.3.13.2.1" class="ltx_text" style="--ltx-fg-color:#EF2E65;">▼</span></td>
<td id="S5.F8.sf1.3.13.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">23.1 <span id="S5.F8.sf1.3.13.3.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td>
<td id="S5.F8.sf1.3.13.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">31.6 <span id="S5.F8.sf1.3.13.4.1" class="ltx_text" style="--ltx-fg-color:#EF2E65;">▼</span></td></tr>
<tr id="S5.F8.sf1.3.14" class="ltx_tr">
<th id="S5.F8.sf1.3.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:1pt;padding-bottom:1pt;">%Source Necessity</th>
<td id="S5.F8.sf1.3.14.2" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">69.0 <span id="S5.F8.sf1.3.14.2.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td>
<td id="S5.F8.sf1.3.14.3" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">50.4 <span id="S5.F8.sf1.3.14.3.1" class="ltx_text" style="--ltx-fg-color:#EF2E65;">▼</span></td>
<td id="S5.F8.sf1.3.14.4" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">68.9 <span id="S5.F8.sf1.3.14.4.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td></tr>
<tr id="S5.F8.sf1.3.15" class="ltx_tr">
<th id="S5.F8.sf1.3.15.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="--ltx-bg-color:#F7F7F7;padding-top:1pt;padding-bottom:1pt;" colspan="4"><img src="2410.22349v1/Images/icons/citation_color.png" id="S5.F8.sf1.g3" class="ltx_graphics ltx_img_square" style="aspect-ratio:16/16;" width="16" height="16" alt="Refer to caption"><span id="S5.F8.sf1.3.15.1.1" class="ltx_text" style="--ltx-fg-color:#4A86E8;--ltx-bg-color:#F7F7F7;"> Citation Metrics</span></th></tr>
<tr id="S5.F8.sf1.3.16" class="ltx_tr">
<th id="S5.F8.sf1.3.16.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">%Citation Accuracy</th>
<td id="S5.F8.sf1.3.16.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">68.3 <span id="S5.F8.sf1.3.16.2.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td>
<td id="S5.F8.sf1.3.16.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">65.8 <span id="S5.F8.sf1.3.16.3.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span></td>
<td id="S5.F8.sf1.3.16.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">49.0 <span id="S5.F8.sf1.3.16.4.1" class="ltx_text" style="--ltx-fg-color:#EF2E65;">▼</span></td></tr>
<tr id="S5.F8.sf1.3.17" class="ltx_tr">
