<th id="S5.T7.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T7.3.1.2.1" class="ltx_text" style="--ltx-fg-color:#16C056;">▲</span>  Acceptable</th>
<th id="S5.T7.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T7.3.1.3.1" class="ltx_text" style="--ltx-fg-color:#EDBF2F;">⚫</span>  Borderline</th>
<th id="S5.T7.3.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T7.3.1.4.1" class="ltx_text" style="--ltx-fg-color:#EF2E65;">▼</span>  Problematic</th></tr>
