<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Design Recommendations and Metrics</h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1. </span>Answer Engine Design Recommendation</h3>

<figure id="S4.T6" class="ltx_table">
<div id="S4.T6.3" class="ltx_inline-block ltx_transformed_outer" style="width:338.1pt;height:296.5pt;vertical-align:-146.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-75.4pt,66.1pt) scale(0.691541666839623,0.691541666839623) ;">
<table id="S4.T6.3.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T6.3.1.1" class="ltx_tr">
<th id="S4.T6.3.1.1.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt" style="padding-top:2pt;padding-bottom:2pt;">
<span id="S4.T6.3.1.1.1.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
<span id="S4.T6.3.1.1.1.1.1" class="ltx_p"><span id="S4.T6.3.1.1.1.1.1.1" class="ltx_text ltx_font_bold">Design Recommendation</span></span>
</span></th>
<th id="S4.T6.3.1.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt" style="padding-top:2pt;padding-bottom:2pt;">
<span id="S4.T6.3.1.1.2.1" class="ltx_inline-block ltx_align_top" style="width:213.4pt;">
<span id="S4.T6.3.1.1.2.1.1" class="ltx_p"><span id="S4.T6.3.1.1.2.1.1.1" class="ltx_text ltx_font_bold">Associated System Weakness</span></span>
</span></th>
<th id="S4.T6.3.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-top:2pt;padding-bottom:2pt;"><span id="S4.T6.3.1.1.3.1" class="ltx_text ltx_font_bold">Metric Developed</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T6.3.1.2" class="ltx_tr">
<td id="S4.T6.3.1.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:2pt;padding-bottom:2pt;">
<span id="S4.T6.3.1.2.1.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
<span id="S4.T6.3.1.2.1.1.1" class="ltx_p">Provide balanced answers</span>
</span></td>
<td id="S4.T6.3.1.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:2pt;padding-bottom:2pt;">
<span id="S4.T6.3.1.2.2.1" class="ltx_inline-block ltx_align_top" style="width:213.4pt;">
<span id="S4.T6.3.1.2.2.1.1" class="ltx_p">Lack of holistic viewpoints for opinionated questions <span id="S4.T6.3.1.2.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#E61670;">[A.II]</span></span>
</span></td>
<td id="S4.T6.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2pt;padding-bottom:2pt;">One-Sided Answers</td></tr>
<tr id="S4.T6.3.1.3" class="ltx_tr">
<td id="S4.T6.3.1.3.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:2pt;padding-bottom:2pt;">
<span id="S4.T6.3.1.3.1.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
<span id="S4.T6.3.1.3.1.1.1" class="ltx_p">Provide objective detail to claims</span>
</span></td>
<td id="S4.T6.3.1.3.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:2pt;padding-bottom:2pt;">
<span id="S4.T6.3.1.3.2.1" class="ltx_inline-block ltx_align_top" style="width:213.4pt;">
<span id="S4.T6.3.1.3.2.1.1" class="ltx_p">Overly confident language when presenting claims <span id="S4.T6.3.1.3.2.1.1.1" class="ltx_text" style="--ltx-fg-color:#E61670;">[A.III]</span></span>
</span></td>
<td id="S4.T6.3.1.3.3" class="ltx_td ltx_align_center" style="padding-top:2pt;padding-bottom:2pt;">Overconfident Answers</td></tr>
