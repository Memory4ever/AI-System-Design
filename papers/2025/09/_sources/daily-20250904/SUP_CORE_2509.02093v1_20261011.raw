<td id="S4.T2.2.9.4" class="ltx_td ltx_align_center"><span id="S4.T2.2.9.4.1" class="ltx_text" style="font-size:90%;">0.7526</span></td>
<td id="S4.T2.2.9.5" class="ltx_td ltx_align_center"><span id="S4.T2.2.9.5.1" class="ltx_text" style="font-size:90%;">0.4025</span></td>
<td id="S4.T2.2.9.6" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T2.2.9.6.1" class="ltx_text" style="font-size:90%;">0.6602</span></td>
<td id="S4.T2.2.9.7" class="ltx_td ltx_align_center"><span id="S4.T2.2.9.7.1" class="ltx_text" style="font-size:90%;">0.5138</span></td></tr>
