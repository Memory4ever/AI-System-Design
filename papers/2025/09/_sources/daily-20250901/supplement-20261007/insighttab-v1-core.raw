              <span id="alg1.l4.2" class="ltx_text ltx_font_typewriter">group</span>: <math id="alg1.l4.m1" class="ltx_Math" alttext="\mathcal{D}_{i}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{D}_{i}\leftarrow</annotation></semantics></math> samples in the <math id="alg1.l4.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th leaf of <math id="alg1.l4.m3" class="ltx_Math" alttext="M_{1}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>1</mn></msub><annotation encoding="application/x-tex">M_{1}</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5:</span>
              
              
              <span id="alg1.l5.2" class="ltx_text ltx_font_typewriter">summarize</span>: <math id="alg1.l5.m1" class="ltx_Math" alttext="R_{i}\leftarrow\texttt{LLM}_{s}(\mathcal{D}_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><msub><mtext class="ltx_mathvariant_monospace">LLM</mtext><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R_{i}\leftarrow\texttt{LLM}_{s}(\mathcal{D}_{i})</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6:</span>
              
              
             <span id="alg1.l6.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l6.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">7:</span>
              
              
             Merge rules: <math id="alg1.l7.m1" class="ltx_Math" alttext="R\leftarrow\texttt{LLM}_{s}(R_{1},\dots,R_{F})" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">←</mo><mrow><msub><mtext class="ltx_mathvariant_monospace">LLM</mtext><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>R</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>R</mi><mi>F</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R\leftarrow\texttt{LLM}_{s}(R_{1},\dots,R_{F})</annotation></semantics></math>

</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">8:</span>
              
              
             Compute: <math id="alg1.l8.m1" class="ltx_Math" alttext="h^{(i)}\leftarrow\texttt{entropy}(M(x^{(i)}))" display="inline" intent=":literal"><semantics><mrow><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">entropy</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">h^{(i)}\leftarrow\texttt{entropy}(M(x^{(i)}))</annotation></semantics></math>, <math id="alg1.l8.m2" class="ltx_Math" alttext="i\in\{1,\dots,n\}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>n</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">i\in\{1,\dots,n\}</annotation></semantics></math>

</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">9:</span>
              
              
             <span id="alg1.l9.2" class="ltx_text ltx_font_typewriter">rank</span>: <math id="alg1.l9.m1" class="ltx_Math" alttext="\mathcal{D}_{e}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>e</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{D}_{e}\leftarrow</annotation></semantics></math> subset of <math id="alg1.l9.m2" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> with the top-<math id="alg1.l9.m3" class="ltx_Math" alttext="n_{e}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>e</mi></msub><annotation encoding="application/x-tex">n_{e}</annotation></semantics></math> lowest <math id="alg1.l9.m4" class="ltx_Math" alttext="h^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">h^{(i)}</annotation></semantics></math>

</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">10:</span>
              
              
             <span id="alg1.l10.2" class="ltx_text ltx_font_typewriter">rank</span>: <math id="alg1.l10.m1" class="ltx_Math" alttext="\mathcal{D}_{h}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>h</mi></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{D}_{h}\leftarrow</annotation></semantics></math> subset of <math id="alg1.l10.m2" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> with the top-<math id="alg1.l10.m3" class="ltx_Math" alttext="n_{h}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>h</mi></msub><annotation encoding="application/x-tex">n_{h}</annotation></semantics></math> highest <math id="alg1.l10.m4" class="ltx_Math" alttext="h^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">h^{(i)}</annotation></semantics></math>

</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">11:</span>
              
              
             <math id="alg1.l11.m1" class="ltx_Math" alttext="\mathcal{D}^{\prime}_{h}\subset\mathcal{D}_{h}=\{(x,y)\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>h</mi><mo>′</mo></msubsup><mo>⊂</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>h</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}^{\prime}_{h}\subset\mathcal{D}_{h}=\{(x,y)\}</annotation></semantics></math> <em id="alg1.l11.2" class="ltx_emph ltx_font_italic">s.t.</em> <math id="alg1.l11.m2" class="ltx_Math" alttext="\texttt{LLM}_{p}(\texttt{MSP}(x,T,\mathcal{D}_{e},R))\neq y" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mtext class="ltx_mathvariant_monospace">LLM</mtext><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext class="ltx_mathvariant_monospace">MSP</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>T</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>e</mi></msub><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">\texttt{LLM}_{p}(\texttt{MSP}(x,T,\mathcal{D}_{e},R))\neq y</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">12:</span>
              
              
             <span id="alg1.l12.2" class="ltx_text ltx_font_typewriter">summarize</span>: <math id="alg1.l12.m1" class="ltx_Math" alttext="R_{h}\leftarrow\texttt{LLM}_{s}(\mathcal{D}^{\prime}_{h})" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>h</mi></msub><mo stretchy="false">←</mo><mrow><msub><mtext class="ltx_mathvariant_monospace">LLM</mtext><mi>s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>h</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R_{h}\leftarrow\texttt{LLM}_{s}(\mathcal{D}^{\prime}_{h})</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">13:</span>
              
              
             Enhance rule: <math id="alg1.l13.m1" class="ltx_Math" alttext="R^{+}\leftarrow R\oplus R_{h}" display="inline" intent=":literal"><semantics><mrow><msup><mi>R</mi><mo>+</mo></msup><mo stretchy="false">←</mo><mrow><mi>R</mi><mo>⊕</mo><msub><mi>R</mi><mi>h</mi></msub></mrow></mrow><annotation encoding="application/x-tex">R^{+}\leftarrow R\oplus R_{h}</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">14:</span>
              
              
             Predict: <math id="alg1.l14.m1" class="ltx_Math" alttext="\tilde{y}\leftarrow\texttt{LLM}_{p}(\texttt{MSP}(\tilde{x},T,\mathcal{D}_{e},R^{+}))" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>y</mi><mo>~</mo></mover><mo stretchy="false">←</mo><mrow><msub><mtext class="ltx_mathvariant_monospace">LLM</mtext><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext class="ltx_mathvariant_monospace">MSP</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>~</mo></mover><mo>,</mo><mi>T</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>e</mi></msub><mo>,</mo><msup><mi>R</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{y}\leftarrow\texttt{LLM}_{p}(\texttt{MSP}(\tilde{x},T,\mathcal{D}_{e},R^{+}))</annotation></semantics></math>

</div>
</div>
</figure>
<div id="S3.SS3.p1" class="ltx_para ltx_noindent">
<p id="S3.SS3.p1.1" class="ltx_p">We introduce an algorithmic implementation of our method in Algorithm <a href="#alg1" title="Algorithm 1 ‣ 3.3 Algorithm ‣ 3 Methodology ‣ Summarize-Exemplify-Reflect: Data-driven Insight Distillation Empowers LLMs for Few-shot Tabular Classification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. In detail, we adopt gradient-boosting decision trees, <em id="S3.SS3.p1.1.1" class="ltx_emph ltx_font_italic">e.g.,</em> XGBoost <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib6" title="" class="ltx_ref">Chen and Guestrin (2016)</a></cite>, as the data modeling technique with the flexibility to adopt other approaches as long as the requirements of <span id="S3.SS3.p1.1.2" class="ltx_text ltx_font_typewriter">group</span> and <span id="S3.SS3.p1.1.3" class="ltx_text ltx_font_typewriter">rank</span> are satisfied (we make a performance comparison in Appendix <a href="#A3.SS3" title="C.3 Comparative Strategy Details ‣ Appendix C Extra Experimental Results ‣ Summarize-Exemplify-Reflect: Data-driven Insight Distillation Empowers LLMs for Few-shot Tabular Classification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.3</span></a>).
Our algorithm takes the classification task description <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, the training dataset <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math>, a test sample <math id="S3.SS3.p1.m3" class="ltx_Math" alttext="\tilde{x}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>x</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{x}</annotation></semantics></math>, a summarizer LLM, and a predictor LLM as input, and outputs the corresponding label <math id="S3.SS3.p1.m4" class="ltx_Math" alttext="\tilde{y}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>y</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{y}</annotation></semantics></math> for <math id="S3.SS3.p1.m5" class="ltx_Math" alttext="\tilde{x}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>x</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{x}</annotation></semantics></math>.
It first fits a XGBoost model <math id="S3.SS3.p1.m6" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> on <math id="S3.SS3.p1.m7" class="ltx_Math" alttext="\mathcal{D}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒟</mi><annotation encoding="application/x-tex">\mathcal{D}</annotation></semantics></math> to support <span id="S3.SS3.p1.1.4" class="ltx_text ltx_font_typewriter">group</span> and <span id="S3.SS3.p1.1.5" class="ltx_text ltx_font_typewriter">rank</span> (lines 1–2). Specifically, we use the first tree of <math id="S3.SS3.p1.m8" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> for sample grouping: samples within each leaf are grouped together and fed into a strong LLM <math id="S3.SS3.p1.m9" class="ltx_Math" alttext="\texttt{LLM}_{s}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_monospace">LLM</mtext><mi>s</mi></msub><annotation encoding="application/x-tex">\texttt{LLM}_{s}</annotation></semantics></math> for rule summarization (lines 3–6). Since the group-wise rules could contain redundancy, we then perform a rule merging process, resulting in a concise set of task-level rules (line 7).
The method then computes the entropy of the predicted class probabilities <math id="S3.SS3.p1.m10" class="ltx_Math" alttext="M(x^{(i)})\in\mathbb{R}^{|\mathcal{C}|}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo stretchy="false">|</mo></mrow></msup></mrow><annotation encoding="application/x-tex">M(x^{(i)})\in\mathbb{R}^{|\mathcal{C}|}</annotation></semantics></math> of each training sample <math id="S3.SS3.p1.m11" class="ltx_Math" alttext="x^{(i)}\in\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">x^{(i)}\in\mathcal{D}</annotation></semantics></math> by the obtained model <math id="S3.SS3.p1.m12" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> (line 8). These entropy values are used as the ranking scores for selecting easy and hard samples (lines 9–10).
For each chosen hard sample, we let the predictor LLM <math id="S3.SS3.p1.m13" class="ltx_Math" alttext="\texttt{LLM}_{p}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_monospace">LLM</mtext><mi>p</mi></msub><annotation encoding="application/x-tex">\texttt{LLM}_{p}</annotation></semantics></math> (could be LLMs with a smaller size to save budget) make an intermediate prediction using easy examples as few-shot demonstrations and current rules as insights. Those incorrectly predicted hard samples are retained and sent to the summarizer LLM for rule enhancement (lines 11–13).
Finally, we use the easy examples and updated rules as insights and derive the class prediction for <math id="S3.SS3.p1.m14" class="ltx_Math" alttext="\tilde{y}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>y</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{y}</annotation></semantics></math>. An illustration of the mined rules see Appendix <a href="#A1" title="Appendix A Mined Rules ‣ Summarize-Exemplify-Reflect: Data-driven Insight Distillation Empowers LLMs for Few-shot Tabular Classification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A</span></a>.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Experiments</h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Experimental Setup</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p"><span id="S4.SS1.p1.1.1" class="ltx_text ltx_font_bold">Datasets</span>.
Following previous works <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib9" title="" class="ltx_ref">Fang et al. (2024)</a></cite>, we evaluate our approach with nine datasets, all collected by <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib14" title="" class="ltx_ref">Hegselmann et al. (2022)</a></cite>. These datasets, with their diverse sizes and feature sets, serve as an ideal testbed for LLM-based tabular classification methods (details in Appendix <a href="#A2.SS1" title="B.1 Datasets ‣ Appendix B Experimental Setup Details ‣ Summarize-Exemplify-Reflect: Data-driven Insight Distillation Empowers LLMs for Few-shot Tabular Classification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>).</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p"><span id="S4.SS1.p2.1.1" class="ltx_text ltx_font_bold">Baselines</span>.
We select a broad spectrum of methods for comparison, with an emphasis on few-shot approaches. These include classic tree-ensemble model <span id="S4.SS1.p2.1.2" class="ltx_text ltx_font_bold">XGBoost</span> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib6" title="" class="ltx_ref">Chen and Guestrin (2016)</a></cite>, pre-trained Transformer <span id="S4.SS1.p2.1.3" class="ltx_text ltx_font_bold">TabPFN</span> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib15" title="" class="ltx_ref">Hollmann et al. (2022)</a></cite>, a base LLM classifier <span id="S4.SS1.p2.1.4" class="ltx_text ltx_font_bold">Original</span>, and more advanced LLM methods including <span id="S4.SS1.p2.1.5" class="ltx_text ltx_font_bold">Tablet</span> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib31" title="" class="ltx_ref">Slack and Singh (2023)</a></cite>, <span id="S4.SS1.p2.1.6" class="ltx_text ltx_font_bold">TabLLM</span> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib14" title="" class="ltx_ref">Hegselmann et al. (2022)</a></cite>, and <span id="S4.SS1.p2.1.7" class="ltx_text ltx_font_bold">SumBoost</span> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib23" title="" class="ltx_ref">Manikandan et al. (2023)</a></cite>.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p"><span id="S4.SS1.p3.1.1" class="ltx_text ltx_font_bold">Implementation</span>.
We employ both open- and close-sourced LLMs for prediction, <em id="S4.SS1.p3.1.2" class="ltx_emph ltx_font_italic">i.e.,</em> <span id="S4.SS1.p3.1.3" class="ltx_text ltx_font_italic">mistral-7b</span> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib18" title="" class="ltx_ref">Jin and Lu (2023)</a></cite> and <span id="S4.SS1.p3.1.4" class="ltx_text ltx_font_italic">gpt-3.5-turbo</span> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib4" title="" class="ltx_ref">Brown et al. (2020)</a></cite>.
For rule summarization in the preprocessing step, we use <span id="S4.SS1.p3.1.5" class="ltx_text ltx_font_italic">gpt-4-turbo</span>. All base prompts are borrowed from TabLLM. We conduct five-fold cross-validation by randomly sampling some instances from the training split as the training set, and reporting the average F1 score for comparison.</p>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<p id="S4.SS1.p4.1" class="ltx_p">Detailed experimental setup information can be found in Appendix <a href="#A2" title="Appendix B Experimental Setup Details ‣ Summarize-Exemplify-Reflect: Data-driven Insight Distillation Empowers LLMs for Few-shot Tabular Classification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B</span></a> (datasets in <a href="#A2.SS1" title="B.1 Datasets ‣ Appendix B Experimental Setup Details ‣ Summarize-Exemplify-Reflect: Data-driven Insight Distillation Empowers LLMs for Few-shot Tabular Classification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>, baselines in <a href="#A2.SS2" title="B.2 Baselines ‣ Appendix B Experimental Setup Details ‣ Summarize-Exemplify-Reflect: Data-driven Insight Distillation Empowers LLMs for Few-shot Tabular Classification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>, and the parameter used in <a href="#A2.SS3" title="B.3 Implementation Details ‣ Appendix B Experimental Setup Details ‣ Summarize-Exemplify-Reflect: Data-driven Insight Distillation Empowers LLMs for Few-shot Tabular Classification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>), with all prompt templates provided in Appendix <a href="#A5" title="Appendix E LLM Prompts ‣ Summarize-Exemplify-Reflect: Data-driven Insight Distillation Empowers LLMs for Few-shot Tabular Classification" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E</span></a>.</p>
</div>
