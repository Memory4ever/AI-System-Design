             classification label <math id="alg1.l0a.m1" class="ltx_Math" alttext="\tilde{y}\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>y</mi><mo>~</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\tilde{y}\in\mathcal{C}</annotation></semantics></math> of <math id="alg1.l0a.m2" class="ltx_Math" alttext="\tilde{x}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>x</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{x}</annotation></semantics></math>

</div>
