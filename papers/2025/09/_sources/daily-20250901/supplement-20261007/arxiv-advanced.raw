        <span>&nbsp;[<a href="https://arxiv.org/pdf/2508.21454">pdf</a>, <a href="https://arxiv.org/ps/2508.21454">ps</a>, <a href="https://arxiv.org/format/2508.21454">other</a>]&nbsp;</span>
