    <p class="title is-5 mathjax">
      
        Chameleon: Adaptive Fault Tolerance for Distributed Training via Real-time Policy Selection
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Zhou%2C+Y">Yuhang Zhou</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+Z">Zhibin Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jiang%2C+P">Peng Jiang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xia%2C+H">Haoran Xia</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lu%2C+J">Junhe Lu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jiang%2C+Q">Qianyu Jiang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gu%2C+R">Rong Gu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xu%2C+H">Hengxi Xu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Huang%2C+X">Xinjing Huang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fang%2C+G">Guanghuan Fang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Hu%2C+Z">Zhiheng Hu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+J">Jingyi Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cai%2C+Y">Yongjin Cai</a>, 
      
