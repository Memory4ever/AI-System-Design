        <span>&nbsp;[<a href="https://arxiv.org/pdf/2508.21693">pdf</a>, <a href="https://arxiv.org/ps/2508.21693">ps</a>, <a href="https://arxiv.org/format/2508.21693">other</a>]&nbsp;</span>
