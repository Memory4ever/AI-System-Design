<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Pseudocode of Human-crafted Prompting</h2>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Sequential Prompting</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
          Task Description <math id="alg1.l1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>, Initial Prompt <math id="alg1.l1.m2" class="ltx_Math" alttext="P_{0}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mn>0</mn></msub><annotation encoding="application/x-tex">P_{0}</annotation></semantics></math>, Generation Rules <math id="alg1.l1.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, Max Rounds <math id="alg1.l1.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
          Final Output <math id="alg1.l2.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
          Initialize dialogue history <math id="alg1.l3.m1" class="ltx_Math" alttext="H\leftarrow[\,]" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo stretchy="false">←</mo><mrow><mo rspace="0.170em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">H\leftarrow[\,]</annotation></semantics></math>

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
          Attacker sends <math id="alg1.l4.m1" class="ltx_Math" alttext="P_{0}+T+R" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mn>0</mn></msub><mo>+</mo><mi>T</mi><mo>+</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">P_{0}+T+R</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
          Append <math id="alg1.l5.m1" class="ltx_Math" alttext="(\text{Attacker},P_{0}+T+R)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mtext>Attacker</mtext><mo>,</mo><mrow><msub><mi>P</mi><mn>0</mn></msub><mo>+</mo><mi>T</mi><mo>+</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\text{Attacker},P_{0}+T+R)</annotation></semantics></math> to <math id="alg1.l5.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
          <span id="alg1.l6.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l6.m1" class="ltx_Math" alttext="t=1\dots N" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">t=1\dots N</annotation></semantics></math> <span id="alg1.l6.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
            <math id="alg1.l7.m1" class="ltx_Math" alttext="Y_{t}\leftarrow LLM(H)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>H</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Y_{t}\leftarrow LLM(H)</annotation></semantics></math>

</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
            Append <math id="alg1.l8.m1" class="ltx_Math" alttext="(\text{Model},Y_{t})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mtext>Model</mtext><mo>,</mo><msub><mi>Y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\text{Model},Y_{t})</annotation></semantics></math> to <math id="alg1.l8.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>

</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
            <math id="alg1.l9.m1" class="ltx_Math" alttext="P_{t}\leftarrow AttackerUpdate(Y_{t},R)" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>U</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mi>t</mi></msub><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{t}\leftarrow AttackerUpdate(Y_{t},R)</annotation></semantics></math>

</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
            Append <math id="alg1.l10.m1" class="ltx_Math" alttext="(\text{Attacker},P_{t}+T+R)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mtext>Attacker</mtext><mo>,</mo><mrow><msub><mi>P</mi><mi>t</mi></msub><mo>+</mo><mi>T</mi><mo>+</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\text{Attacker},P_{t}+T+R)</annotation></semantics></math> to <math id="alg1.l10.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>

</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
          <span id="alg1.l11.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l11.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
          <math id="alg1.l12.m1" class="ltx_Math" alttext="Y\leftarrow Y_{N}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo stretchy="false">←</mo><msub><mi>Y</mi><mi>N</mi></msub></mrow><annotation encoding="application/x-tex">Y\leftarrow Y_{N}</annotation></semantics></math>

</div>
<div id="alg1.l13" class="ltx_listingline">
