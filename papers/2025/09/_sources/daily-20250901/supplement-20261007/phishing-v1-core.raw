<td id="S4.T1.5.1.4.6" class="ltx_td ltx_align_left" style="--ltx-bg-color:#E6FFE6;"><span id="S4.T1.5.1.4.6.1" class="ltx_text" style="--ltx-bg-color:#E6FFE6;">BART, GPT-2</span></td>
