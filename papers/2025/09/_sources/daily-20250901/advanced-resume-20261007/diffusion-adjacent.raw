        <span>&nbsp;[<a href="https://arxiv.org/pdf/2508.20424">pdf</a>, <a href="https://arxiv.org/ps/2508.20424">ps</a>, <a href="https://arxiv.org/format/2508.20424">other</a>]&nbsp;</span>
