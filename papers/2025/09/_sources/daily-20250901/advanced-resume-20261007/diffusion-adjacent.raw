    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Su%2C+Y">Yang Su</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tan%2C+S">Shunquan Tan</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Huang%2C+J">Jiwu Huang</a>
      
