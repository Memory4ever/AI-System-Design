      <a href="/search/?searchtype=author&amp;query=Hassidof%2C+Y">Yaniv Hassidof</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Jurgenson%2C+T">Tom Jurgenson</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Solovey%2C+K">Kiril Solovey</a>
      
