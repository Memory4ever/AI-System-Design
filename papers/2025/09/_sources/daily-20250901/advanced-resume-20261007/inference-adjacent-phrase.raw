      <a href="/search/?searchtype=author&amp;query=He%2C+J">Jiajie He</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+M">Min-Chun Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+X">Xintong Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Fang%2C+X">Xinyang Fang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gu%2C+Y">Yuechun Gu</a>, 
      
