        <span>&nbsp;[<a href="https://arxiv.org/pdf/2508.21463">pdf</a>, <a href="https://arxiv.org/ps/2508.21463">ps</a>, <a href="https://arxiv.org/format/2508.21463">other</a>]&nbsp;</span>
