      <a href="/search/?searchtype=author&amp;query=Zhang%2C+Y">Yue Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+S">Shuaiqing Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ling%2C+Z">Zhen Ling</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cao%2C+J">Jiannong Cao</a>, 
      
