    <p class="title is-5 mathjax">
      
        <span class="search-hit mathjax">Reasoning</span>-Intensive Regression
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Tchuindjo%2C+D">Diane Tchuindjo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Khattab%2C+O">Omar Khattab</a>
      
