      <a href="/search/?searchtype=author&amp;query=Chen%2C+G">Guanxu Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yin%2C+R">Ruicheng Yin</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zheng%2C+X">Xiaoqing Zheng</a>, 
      
