      <a href="/search/?searchtype=author&amp;query=Chen%2C+Z">Zhirui Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Shen%2C+W">Wei Shen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Huang%2C+J">Jiashui Huang</a>, 
      
