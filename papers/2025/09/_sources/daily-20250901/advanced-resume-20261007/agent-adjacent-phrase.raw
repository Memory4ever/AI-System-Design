      <a href="/search/?searchtype=author&amp;query=Jeong%2C+H">Hyejun Jeong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Teymoorianfard%2C+M">Mohammadreza Teymoorianfard</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kumar%2C+A">Abhinav Kumar</a>, 
      
