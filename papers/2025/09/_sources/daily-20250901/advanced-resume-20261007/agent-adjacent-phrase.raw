      <a href="/search/?searchtype=author&amp;query=Wang%2C+J">Ji Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Chen%2C+K">Kashing Chen</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Song%2C+X">Xinyuan Song</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+K">Ke Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ai%2C+L">Lynn Ai</a>, 
      
