        <span>&nbsp;[<a href="https://arxiv.org/pdf/2508.19567">pdf</a>, <a href="https://arxiv.org/ps/2508.19567">ps</a>, <a href="https://arxiv.org/format/2508.19567">other</a>]&nbsp;</span>
