      <a href="/search/?searchtype=author&amp;query=Huo%2C+F">Fushuo Huo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Cui%2C+L">Laizhong Cui</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Guo%2C+S">Song Guo</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gui%2C+J">Jie Gui</a>, 
      
