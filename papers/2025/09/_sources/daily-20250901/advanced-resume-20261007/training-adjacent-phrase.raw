        <span>&nbsp;[<a href="https://arxiv.org/pdf/2508.18847">pdf</a>, <a href="https://arxiv.org/ps/2508.18847">ps</a>, <a href="https://arxiv.org/format/2508.18847">other</a>]&nbsp;</span>
