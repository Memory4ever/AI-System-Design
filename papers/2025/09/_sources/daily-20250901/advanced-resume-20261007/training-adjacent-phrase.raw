    <p class="title is-5 mathjax">
      
        End-to-End Agentic RAG System <span class="search-hit mathjax">Training</span> for Traceable Diagnostic Reasoning
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Zheng%2C+Q">Qiaoyu Zheng</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sun%2C+Y">Yuze Sun</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wu%2C+C">Chaoyi Wu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhao%2C+W">Weike Zhao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Qiu%2C+P">Pengcheng Qiu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yu%2C+Y">Yongguo Yu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Sun%2C+K">Kun Sun</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+J">Jian Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+Y">Yanfeng Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+Y">Ya Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Xie%2C+W">Weidi Xie</a>
      
