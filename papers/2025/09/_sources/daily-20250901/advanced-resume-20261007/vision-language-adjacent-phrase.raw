  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2508.21066">arXiv:2508.21066</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2508.21066">pdf</a>, <a href="https://arxiv.org/ps/2508.21066">ps</a>, <a href="https://arxiv.org/format/2508.21066">other</a>]&nbsp;</span>
