        <span>&nbsp;[<a href="https://arxiv.org/pdf/2508.17588">pdf</a>, <a href="https://arxiv.org/ps/2508.17588">ps</a>, <a href="https://arxiv.org/format/2508.17588">other</a>]&nbsp;</span>
