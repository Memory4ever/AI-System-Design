        <span>&nbsp;[<a href="https://arxiv.org/pdf/2508.16512">pdf</a>, <a href="https://arxiv.org/ps/2508.16512">ps</a>, <a href="https://arxiv.org/format/2508.16512">other</a>]&nbsp;</span>
