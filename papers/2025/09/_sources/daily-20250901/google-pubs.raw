<div class="row-card">
  <div class="row-card__container">
    
    <div class="row-card__body">
        
          <a class="row-card__heading glue-link" href=https://research.google/pubs/sexual-dimorphism-in-the-complete-connectome-of-the-drosophila-male-central-nervous-system/ >
            
              Sexual dimorphism in the complete connectome of the Drosophila male central nervous system
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        Stuart Berg
                      
                    </div>
                
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
                    <div class="row-card__subheading__item small-text">
                      
