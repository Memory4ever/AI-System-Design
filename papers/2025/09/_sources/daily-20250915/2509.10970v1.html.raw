<td id="S4.T3.4.6.4" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S4.T3.m5" class="ltx_Math" alttext="43.75" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">43.75</mn><annotation encoding="application/x-tex">43.75</annotation></semantics></math></td></tr>
