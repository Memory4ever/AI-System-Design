<td id="S4.T3.4.7.3" class="ltx_td ltx_align_center"><span id="S4.T3.4.7.3.1" class="ltx_text" style="font-size:80%;">16</span></td>
<td id="S4.T3.4.7.4" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S4.T3.m6" class="ltx_Math" alttext="25.00" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">25.00</mn><annotation encoding="application/x-tex">25.00</annotation></semantics></math></td></tr>
