<tr id="S4.T1.2.7" class="ltx_tr">
<th id="S4.T1.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">
<span id="S4.T1.2.7.1.1" class="ltx_inline-block ltx_align_top">
<span id="S4.T1.2.7.1.1.1" class="ltx_p ltx_align_left">openai/gpt-40</span>
</span></th>
<th id="S4.T1.2.7.2" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S4.T1.m19" class="ltx_Math" alttext="1.08\pm 0.55" display="inline" intent=":literal"><semantics><mrow><mn>1.08</mn><mo>±</mo><mn>0.55</mn></mrow><annotation encoding="application/x-tex">1.08\pm 0.55</annotation></semantics></math></th>
