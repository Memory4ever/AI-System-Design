<td id="S5.T5.1.3.2" class="ltx_td ltx_align_center"><img src="2509.11141v1/images/emojis/scroll-1f4dc.png" id="S5.T5.g4" class="ltx_graphics ltx_img_square" style="aspect-ratio:12/12;" width="12" height="12" alt="[Uncaptioned image]">   <img src="2509.11141v1/images/emojis/hit-1f3af.png" id="S5.T5.g5" class="ltx_graphics ltx_img_square" style="aspect-ratio:12/12;" width="12" height="12" alt="[Uncaptioned image]">   <img src="2509.11141v1/images/emojis/computer-1f5a5.png" id="S5.T5.g6" class="ltx_graphics ltx_img_square" style="aspect-ratio:12/12;" width="12" height="12" alt="[Uncaptioned image]">   <img src="2509.11141v1/images/emojis/credit-card-1f4b3.png" id="S5.T5.g7" class="ltx_graphics ltx_img_square" style="aspect-ratio:12/12;" width="12" height="12" alt="[Uncaptioned image]">   <img src="2509.11141v1/images/emojis/robot-1f916.png" id="S5.T5.g8" class="ltx_graphics ltx_img_square" style="aspect-ratio:12/12;" width="12" height="12" alt="[Uncaptioned image]"> <img src="2509.11141v1/images/emojis/money-1f4b0.png" id="S5.T5.g9" class="ltx_graphics ltx_img_square" style="aspect-ratio:12/12;" width="12" height="12" alt="[Uncaptioned image]"></td></tr>
