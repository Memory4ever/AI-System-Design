{\lx@inpgf@ignorespaces}\lxSVG@begingroup@{_scopebegin=1} \lxSVG@begingroup@{stroke=#000000} \lxSVG@begingroup@{fill=#000000} \lxSVG@setlinewidth{\the\pgflinewidth}\lxSVG@begingroup@{stroke-width=1.6pt} \lx@inpgf@ignorespaces{}\lxSVG@fillstroke\lxSVG@drawpath@unclipped{M 1517.65 -499.24 C 1517.65 -508.1 1509.53 -520.27 1493.29 -535.77 C 1480.01 -548.32 1454.18 -579.31 1415.81 -628.76 L 1069.33 -1081.5 L 1139.07 -1222.09 L 1316.18 -1600.67 C 1309.54 -1616.17 1299.21 -1626.87 1285.19 -1632.77 L 1285.19 -1650.48 C 1284.45 -1651.22 1275.59 -1656.76 1258.62 -1667.09 C 1246.07 -1675.21 1239.8 -1681.85 1239.8 -1687.01 C 1239.8 -1693.66 1243.49 -1704.36 1250.87 -1719.12 C 1248.66 -1732.4 1239.06 -1745.31 1222.09 -1757.86 C 1205.12 -1769.67 1189.62 -1775.57 1175.6 -1775.57 C 1160.84 -1775.57 1132.06 -1742.36 1089.25 -1675.94 L 876.72 -1347.18 L 427.29 -2043.46 C 403.67 -2061.17 364.56 -2070.02 309.95 -2070.02 C 297.4 -2070.02 281.54 -2054.89 262.35 -2024.64 C 239.47 -1988.48 228.03 -1965.23 228.03 -1954.9 C 228.03 -1946.04 230.25 -1933.87 234.68 -1918.37 C 241.32 -1895.49 240.58 -1880.73 232.46 -1874.09 C 225.08 -1866.71 221.39 -1861.18 221.39 -1857.49 C 221.39 -1844.94 239.47 -1807.67 275.63 -1745.68 L 329.88 -1652.7 C 388.18 -1553.07 517.69 -1381.86 718.42 -1139.07 L 744.99 -1106.96 L 577.84 -644.25 C 560.86 -597.02 552.38 -571.19 552.38 -566.77 C 552.38 -560.12 562.34 -544.26 582.26 -519.17 L 597.76 -505.88 C 602.93 -501.45 608.09 -499.24 613.26 -499.24 C 621.38 -499.24 633.55 -505.88 649.79 -519.17 C 658.64 -511.79 670.82 -508.1 686.32 -508.1 C 690.75 -505.88 697.39 -500.72 706.24 -492.6 C 713.62 -480.05 722.11 -473.78 731.7 -473.78 C 745.72 -473.78 759.38 -487.43 772.66 -514.74 L 944.24 -855.68 L 1001.8 -784.84 L 1112.5 -657.54 C 1250.5 -498.87 1322.82 -419.54 1329.46 -419.54 C 1347.91 -419.54 1374.48 -433.93 1409.17 -462.71 L 1434.63 -440.57 C 1444.96 -425.07 1453.08 -417.33 1458.98 -417.33 C 1462.67 -417.33 1467.1 -423.6 1472.26 -436.14 C 1475.21 -442.79 1484.07 -454.