<th id="S6.T2.8.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S6.T2.8.1.2.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">QQ Music<sup id="S6.T2.8.1.2.6.1.1" class="ltx_sup"><span id="S6.T2.8.1.2.6.1.1.1" class="ltx_text" style="--ltx-fg-color:#808080;">5.99%</span></sup></span></th></tr>
