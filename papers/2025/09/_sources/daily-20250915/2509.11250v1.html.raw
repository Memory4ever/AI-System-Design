<td id="S6.T2.8.1.4.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F4FBF4;padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S6.T2.8.1.4.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F4FBF4;">20.75</span></td>
