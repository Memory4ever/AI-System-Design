<td id="S6.T2.8.1.4.7" class="ltx_td ltx_align_center" style="--ltx-bg-color:#F4FBF4;padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S6.T2.8.1.4.7.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F4FBF4;">8.08</span></td>
<td id="S6.T2.8.1.4.8" class="ltx_td ltx_nopad_r ltx_align_center" style="--ltx-bg-color:#F4FBF4;padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S6.T2.8.1.4.8.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F4FBF4;">26.22</span></td></tr>
<tr id="S6.T2.8.1.5" class="ltx_tr">
<th id="S6.T2.8.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;" rowspan="2"><span id="S6.T2.8.1.5.1.1" class="ltx_text" style="font-size:90%;">OS-Atlas-Base-7B</span></th>
<td id="S6.T2.8.1.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S6.T2.8.1.5.2.1" class="ltx_text" style="font-size:90%;">Baseline</span></td>
