<tr id="S6.T3.5.1.6" class="ltx_tr">
<th id="S6.T3.5.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S6.T3.5.1.6.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">w/o ABH</span></th>
