{"data":[{"id":"10.48550/arxiv.2509.11079","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11079","identifiers":[{"identifier":"2509.11079","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinwei","familyName":"Su","name":"Su, Jinwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qizhen","familyName":"Lan","name":"Lan, Qizhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinghui","familyName":"Xia","name":"Xia, Yinghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifan","familyName":"Sun","name":"Sun, Lifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiyou","familyName":"Tian","name":"Tian, Weiyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Shi","name":"Shi, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyuan","familyName":"Song","name":"Song, Xinyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lewei","familyName":"He","name":"He, Lewei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Jingsong","name":"Jingsong, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Difficulty-Aware Agentic Orchestration for Query-Specific Multi-Agent Workflows"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T03:57:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T02:48:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T13:32:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:52:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-11T12:33:57Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-14T00:35:55Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-12-08T06:37:01Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-12-09T02:14:51Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02-13T16:13:15Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-02-16T01:50:46Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Model (LLM)-based agentic systems have shown strong capabilities across various tasks. However, existing multi-agent frameworks often rely on static or task-level workflows, which either over-process simple queries or underperform on complex ones, while also neglecting the efficiency-performance trade-offs across heterogeneous LLMs. To address these limitations, we propose Difficulty-Aware Agentic Orchestration (DAAO), which can dynamically generate query-specific multi-agent workflows guided by predicted query difficulty. DAAO comprises three interdependent modules: a variational autoencoder (VAE) for difficulty estimation, a modular operator allocator, and a cost- and performance-aware LLM router. A self-adjusting policy updates difficulty estimates based on workflow success, enabling simpler workflows for easy queries and more complex strategies for harder ones. Experiments on six benchmarks demonstrate that DAAO surpasses prior multi-agent systems in both accuracy and inference efficiency, validating its effectiveness for adaptive, difficulty-aware reasoning."},{"descriptionType":"Other","description":"Accepted to WWW2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11079","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:16Z","registered":"2025-09-16T02:54:17Z","published":null,"updated":"2026-02-16T02:59:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026query=subjects.subject%3A%28%22cs.AI%22+OR+%22cs.CL%22+OR+%22cs.IR%22+OR+%22cs.MA%22%29+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs%29%29+AND+%28titles.title%3A%28agent+OR+agents+OR+agentic+OR+retrieval+OR+memory+OR+memories+OR+safety+OR+jailbreak+OR+jailbreaks+OR+%22tool+calling%22+OR+%22tool+use%22+OR+tool+OR+tools%29+OR+descriptions.description%3A%28agent+OR+agents+OR+agentic+OR+retrieval+OR+memory+OR+memories+OR+safety+OR+jailbreak+OR+jailbreaks+OR+%22tool+calling%22+OR+%22tool+use%22+OR+tool+OR+tools%29%29+AND+doi%3A%2210.48550%2Farxiv.2509.11079%22+AND+registered%3A%5B2025-09-16T00%3A00%3A00Z+TO+2025-09-16T23%3A59%3A59Z%5D\u0026page%5Bsize%5D=10"}}