{"data":[{"id":"10.48550/arxiv.2509.11337","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11337","identifiers":[{"identifier":"2509.11337","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ying","familyName":"Cao","name":"Cao, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Yuan","name":"Yuan, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali H.","familyName":"Sayed","name":"Sayed, Ali H.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On the Escaping Efficiency of Distributed Adversarial Training Algorithms"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T16:28:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:48:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-01T15:19:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-02T01:22:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Adversarial training has been widely studied in recent years due to its role in improving model robustness against adversarial attacks. This paper focuses on comparing different distributed adversarial training algorithms--including centralized and decentralized strategies--within multi-agent learning environments. Previous studies have highlighted the importance of model flatness in determining robustness. To this end, we develop a general theoretical framework to study the escaping efficiency of these algorithms from local minima, which is closely related to the flatness of the resulting models. We show that when the perturbation bound is sufficiently small (i.e., when the attack strength is relatively mild) and a large batch size is used, decentralized adversarial training algorithms--including consensus and diffusion--are guaranteed to escape faster from local minima than the centralized strategy, thereby favoring flatter minima. However, as the perturbation bound increases, this trend may no longer hold. In the simulation results, we illustrate our theoretical findings and systematically compare the performance of models obtained through decentralized and centralized adversarial training algorithms. The results highlight the potential of decentralized strategies to enhance the robustness of models in distributed settings."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11337","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:21Z","registered":"2025-09-16T03:00:22Z","published":null,"updated":"2026-10-02T03:27:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11218","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11218","identifiers":[{"identifier":"2509.11218","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Johann","familyName":"Schmidt","name":"Schmidt, Johann","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tom","familyName":"Siegl","name":"Siegl, Tom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Becker","name":"Becker, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Stober","name":"Stober, Sebastian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geometrically Constrained and Token-Based Probabilistic Spatial Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T11:30:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:42:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-17T08:50:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-18T01:23:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-29T08:23:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-30T01:01:30Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Spatial transformations such as rotation and scale obscure the morphological cues needed for accurate image classification. Careful consideration is required for reliable use in high stakes settings. A model should stay robust under such transformations, expose why a correction was applied, and signal when its input is ambiguous. While geometrically equivariant architectures provide a mathematically grounded solution, they often limit model flexibility through strict symmetry constraints and incur significant computational overhead. Spatial Transformer Networks (STNs) offer a data-driven, flexible alternative for learning pseudo-equivariances to affine transformations. However, STNs have historically been restricted to convolutional architectures and suffer from training instability. To address this, we introduce a novel STN framework. It leverages the global modeling capabilities of transformers to regress the affine transformation acting on the input. For this, we decompose affine transformations into interpretable primitives, regressed under adaptable geometric constraints, thereby preventing the training instability typically caused by degenerate transformations. By sharing weights between the localization network and the classification backbone, the framework requires minimal computational overhead. Extensive experiments on challenging insect biodiversity and medical imaging benchmarks demonstrate that our approach achieves superior predictive performance under diverse spatial transformations while maintaining high efficiency. Code is available at https://github.com/johSchm/TokenSTN."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11218","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:57:29Z","registered":"2025-09-16T02:57:30Z","published":null,"updated":"2026-09-30T04:01:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11353","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11353","identifiers":[{"identifier":"2509.11353","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hanpei","familyName":"Fang","name":"Fang, Hanpei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sijie","familyName":"Tao","name":"Tao, Sijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nuo","familyName":"Chen","name":"Chen, Nuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai-Xin","familyName":"Chang","name":"Chang, Kai-Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tetsuya","familyName":"Sakai","name":"Sakai, Tetsuya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Do Large Language Models Favor Recent Content? A Study on Recency Bias in LLM-Based Reranking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T17:11:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:49:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-21T16:59:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-22T02:16:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are increasingly deployed in information systems, including being used as second-stage rerankers in information retrieval pipelines, yet their susceptibility to recency bias has received little attention. We investigate whether LLMs implicitly favour newer documents by prepending artificial publication dates to passages in the TREC Deep Learning passage retrieval collections in 2021 (DL21) and 2022 (DL22). Across seven models, GPT-3.5-turbo, GPT-4o, GPT-4, LLaMA-3 8B/70B, and Qwen-2.5 7B/72B, \"fresh\" passages are consistently promoted, shifting the Top-10's mean publication year forward by up to 4.78 years and moving individual items by as many as 95 ranks in our listwise reranking experiments. Although larger models attenuate the effect, none eliminate it. We also observe that the preference of LLMs between two passages with an identical relevance level can be reversed by up to 25% on average after date injection in our pairwise preference experiments. These findings provide quantitative evidence of a pervasive recency bias in LLMs and highlight the importance of effective bias-mitigation strategies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11353","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:43Z","registered":"2025-09-16T03:00:44Z","published":null,"updated":"2026-09-22T04:42:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11252","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11252","identifiers":[{"identifier":"2509.11252","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chengze","familyName":"Li","name":"Li, Chengze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yitong","familyName":"Zhang","name":"Zhang, Yitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Li","name":"Li, Jia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liyi","familyName":"Cai","name":"Cai, Liyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ge","familyName":"Li","name":"Li, Ge","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring the Potential of Diffusion Large Language Models in Code Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T12:51:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:43:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-02T02:15:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-04T01:46:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-13T07:24:51Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-15T01:00:00Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"LLMs have become the mainstream approaches to code generation. Existing LLMs mainly employ autoregressive generation, i.e. generating code token-by-token from left to right. However, the underlying autoregressive generation has two limitations in code generation. First, autoregressive LLMs only generate a token at each step, showing low efficiency in practice. Second, programming is a non-sequential process involving back-and-forth editing, while autoregressive LLMs only employ the left-to-right generation order. These two intrinsic limitations hinder the further development of LLMs in code generation. Recently, diffusion LLMs have emerged as a promising alternative. Diffusion LLMs address the above limitations with two advances, including multi-token prediction (i.e. generating multiple tokens at each step) and flexible generation order (i.e. flexibly determining which positions to generate tokens). However, there is no systematic study exploring diffusion LLMs in code generation. To bridge the knowledge gap, we present the first empirical study of diffusion LLMs for code generation. Our study involves 9 representative diffusion LLMs and conduct experiments on 4 widely used benchmarks. Based on the results, we summarize the following findings. (1) Existing diffusion LLMs are competitive with autoregressive LLMs with similar sizes. (2) Diffusion LLMs have a stronger length extrapolation ability than autoregressive LLMs and perform better in long code understanding. (3) We explore factors impacting the effectiveness and efficiency of diffusion LLMs, and provide practical guidance. (4) We discuss several promising further directions to improve diffusion LLMs on code generation. We open-source all source code, data, and results to facilitate the following research. The code is publicly available at https://github.com/zhangyitonggg/dllm4code."},{"descriptionType":"Other","description":"Accepted by ACM TOSEM"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11252","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:58:18Z","registered":"2025-09-16T02:58:18Z","published":null,"updated":"2026-09-15T04:41:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11250","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11250","identifiers":[{"identifier":"2509.11250","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yitong","familyName":"Zhang","name":"Zhang, Yitong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ximo","familyName":"Li","name":"Li, Ximo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liyi","familyName":"Cai","name":"Cai, Liyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"Li","name":"Li, Jia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Environmental Injection Attacks against GUI Agents in Realistic Dynamic Environments"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T12:47:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:43:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-31T08:50:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T01:34:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-24T12:04:58Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-25T01:35:03Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graphical User Interface (GUI) agents are increasingly deployed to interact with online web services, yet their exposure to open-world content renders them vulnerable to Environmental Injection Attacks (EIAs). In these attacks, an attacker can inject crafted triggers into website to manipulate the behavior of GUI agents used by other users. In this paper, we find that most existing EIA studies fall short of realism. In particular, they fail to capture the dynamic nature of real-world web content, often assuming that a trigger's on-screen position and surrounding visual context remain largely consistent between training and testing. To better reflect practice, we introduce a realistic dynamic-environment threat model in which the attacker is a regular user and the trigger is embedded within a dynamically changing environment. Under this threat model, existing approaches largely fail, suggesting that their effectiveness in exposing GUI agent vulnerabilities has been substantially overestimated.\n To expose the hidden vulnerabilities of existing GUI agents effectively, we propose Chameleon, an attack framework with two key novelties designed for dynamic environments. (1) To synthesize more realistic training data, we introduce LLM-Driven Environment Simulation, which automatically generates diverse, high-fidelity webpage simulations that mimic the variability of real-world dynamic environments. (2) To optimize the trigger more effectively, we introduce Attention Black Hole, which converts attention weights into explicit supervisory signals. This mechanism encourages the agent to remain insensitive to irrelevant surrounding content, thereby improving robustness in dynamic environments. We evaluate Chameleon on six realistic websites and four representative LVLM-powered GUI agents, where it significantly outperforms existing methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11250","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:58:15Z","registered":"2025-09-16T02:58:15Z","published":null,"updated":"2026-08-25T03:49:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11109","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11109","identifiers":[{"identifier":"2509.11109","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaxin","familyName":"Huang","name":"Huang, Jiaxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanyu","familyName":"Liu","name":"Liu, Hanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunsheng","familyName":"Ma","name":"Ma, Yunsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Shen","name":"Shen, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilin","familyName":"Zheng","name":"Zheng, Yilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Wen","name":"Wen, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhigong","familyName":"Song","name":"Song, Zhigong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FEWT: Frequency-Enhanced Wavelet-based Transformer for Multimodal Wheeled Bimanual Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T05:56:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:35:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T09:55:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:37:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-16T09:22:24Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-17T00:39:52Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-08-12T08:32:21Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-08-13T00:31:51Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Embodied intelligence bridges the physical world and information spaces, with robots demonstrating immense potential through imitation learning algorithms. In this study, a custom-built wheeled bimanual robotic platform equipped with an exoskeleton-style teleoperation system was utilized to realize intuitive remote manipulation and the efficient collection of anthropomorphic action data. To overcome the representation mismatch between spatial visual semantics and localized high-frequency physical dynamics, we propose a lightweight frequency-aligned imitation-learning framework, termed the Frequency-Enhanced Wavelet-based Transformer (FEWT). FEWT integrates two primary modules: Frequency-Enhanced Efficient Multi-Scale Attention (FE-EMA) and Time-Series Discrete Wavelet Transform (TS-DWT) to explicitly extract and align multi-scale features, improving the compatibility between spatial visual representations and temporal-frequency recalibration. Crucially, for real-world deployment, this framework is further extended into a multimodal system by seamlessly integrating a self-developed Smart Tactile Fabric (STF) sensor into the physical end-effectors, providing local contact-stress information that complements proprioceptive and chassis-motion cues in the shared multimodal representation. Experimental evaluations demonstrate that the core FEWT architecture significantly improves the success rate over the widely used Action Chunking with Transformers baseline, particularly during the most challenging phases of simulated bimanual insertion tasks. Furthermore, in complex real-world mobile and desktop manipulation tasks, the full STF-enhanced system effectively adapts to microscopic dynamic perturbations, yielding substantial performance enhancements."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11109","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:57Z","registered":"2025-09-16T02:54:58Z","published":null,"updated":"2026-08-13T02:10:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11076","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11076","identifiers":[{"identifier":"2509.11076","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zibo","familyName":"Wang","name":"Wang, Zibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Zhou","name":"Zhou, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhibin","familyName":"Wang","name":"Wang, Zhibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shipeng","familyName":"Li","name":"Li, Shipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinjing","familyName":"Huang","name":"Huang, Xinjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chendong","familyName":"Cai","name":"Cai, Chendong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingxu","familyName":"Mu","name":"Mu, Bingxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqing","familyName":"Sun","name":"Sun, Yuqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiheng","familyName":"Hu","name":"Hu, Zhiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"She","name":"She, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shu","familyName":"You","name":"You, Shu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanghuan","familyName":"Fang","name":"Fang, Guanghuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rong","familyName":"Gu","name":"Gu, Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanchun","familyName":"Dou","name":"Dou, Wanchun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guihai","familyName":"Chen","name":"Chen, Guihai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Tian","name":"Tian, Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SmartSwap: Swap-Based Memory Optimization for LLM Training under Varying Operator Sequences"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T03:55:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:33:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-15T13:51:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-16T00:48:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The increasing size of large language models (LLMs) has led to a surge in memory requirements during training, often exceeding the capacity of high-bandwidth memory (HBM). Swap-based memory optimization incurs neither accuracy loss nor additional end-to-end overhead when effectively overlapped, thus being an attractive solution. However, existing swap methods assume consistent operator sequences, which is impractical in Eager Mode, where operator sequences can vary during change.\n We propose Chameleon, which redesigns the end-to-end process of swap-based memory optimization and is the first work to consider varying operator sequences in Eager Mode. Chameleon (i) introduces a lightweight online profiler to enable continuous profiling for monitoring operator sequences, (ii) generates effective swap policies with limited operator information, and (iii) optimizes the policy execution module for accurate policy application and better performance. Experimental results demonstrate that Chameleon reduces profiling overhead by 84.25%, enables training models up to 4x larger than hardware memory while adapting to changes in operator sequences, improves performance by up to 38.94% compared to recomputation or high-degree parallelism."},{"descriptionType":"Other","description":"Accepted to DAC 2026. Previously titled \"Chameleon: Taming Dynamic Operator Sequences for Memory-Intensive LLM Training.\""}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11076","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:12Z","registered":"2025-09-16T02:54:13Z","published":null,"updated":"2026-07-16T02:33:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11259","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11259","identifiers":[{"identifier":"2509.11259","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"David","familyName":"Schiff","name":"Schiff, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ofir","familyName":"Lindenbaum","name":"Lindenbaum, Ofir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yonathan","familyName":"Efroni","name":"Efroni, Yonathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ICR-RL: Deep Reinforcement Learning via In-Context Regression"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T13:09:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:44:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-06T06:45:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T02:02:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in machine learning have largely been driven by foundation models (FMs) trained on large, diverse datasets, enabling them to generalize effectively to new, related tasks. However, extending this paradigm to reinforcement learning (RL), where an agent interacts with an environment to select actions, remains a significant challenge. Most existing approaches train FMs directly on sets of control tasks, but developing diverse RL environments and scaling training across them can be costly and complex. In this study, we explore a simpler alternative approach based on a classical reduction from RL to regression. We demonstrate that a foundation model pre-trained for regression tasks, when used as an in-context regression (ICR) model, can be directly applied to RL problems. Building on this insight, we introduce a gradient-free method, ICR-RL, that requires no additional training and leverages an ICR foundation model to tackle RL tasks. We evaluate our approach by applying the ICR model with the recently proposed TabPFN, which is trained on a wide range of regression tasks. Experiments conducted on the Gymnasium classic-control benchmark indicate that ICR-RL can compete with commonly used methods, including DQN, PPO and TRPO. These results show that ICR foundation models can effectively solve RL tasks without fine-tuning, demonstrating their potential as a foundation for RL-oriented models."},{"descriptionType":"Other","description":"Accepted to ICML 2026 Main Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11259","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:58:28Z","registered":"2025-09-16T02:58:28Z","published":null,"updated":"2026-07-07T04:57:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11208","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11208","identifiers":[{"identifier":"2509.11208","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leon","familyName":"Chlon","name":"Chlon, Leon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahmed","familyName":"Karim","name":"Karim, Ahmed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maggie","familyName":"Chlon","name":"Chlon, Maggie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"MarcAntonio","familyName":"Awada","name":"Awada, MarcAntonio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Predictable Compression Failures: Order Sensitivity and Information Budgeting for Evidence-Grounded Binary Adjudication"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T10:32:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:41:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-22T15:10:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-24T01:52:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-05T12:26:10Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-08T00:43:20Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Transformers used for evidence-grounded binary adjudication (e.g., support/refute, yes/no, or verifier-backed pass/fail decisions) can be sensitive to the order in which exchangeable evidence is presented, producing dispersion across permutations and unreliable attempted answers under a verifier-relative Bernoulli predicate. We treat evidence order as a nuisance variable and formalize an expectation-realization gap: next-token training can minimize expected conditional description length over orderings while a fixed ordering remains position-sensitive. Our Quantified Martingale Violation (QMV) bound predicts the dispersion induced by adjacent-rank positional sensitivity, with $O(\\log n)$ growth in the harmonic regime; our Expectation-level Decompression Law (EDFL) specializes a KL convexity/data-processing bound to Bernoulli predicates, yielding Bits-to-Trust (B2T), Risk-of-Hallucination (RoH), and an Information Sufficiency Ratio (ISR) gate for answer/abstain decisions. On 3,059 grounded items from FEVER, HotpotQA, NQ-Open, PopQA, and Controls, we observe logarithmic dispersion and positive Jensen gains from uniform permutation mixtures. In one pre-specified held-out audit (528 items), the analytically fixed ISR$=1$ gate attains 0.0-0.7% hallucination with 20.6-27.9% abstention (95% CIs), supporting the operating point without claiming universal calibration across all model families or unrestricted generation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11208","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:57:16Z","registered":"2025-09-16T02:57:16Z","published":null,"updated":"2026-06-08T02:01:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11056","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11056","identifiers":[{"identifier":"2509.11056","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuhang","familyName":"Li","name":"Li, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Lu","name":"Lu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Chen","name":"Chen, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Ai","name":"Ai, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiguo","familyName":"Ding","name":"Ding, Zhiguo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"BERT4beam: Large AI Model Enabled Generalized Beamforming Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T02:49:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:32:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-01T13:14:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T02:07:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Artificial intelligence (AI) is anticipated to emerge as a pivotal enabler for the forthcoming sixth-generation (6G) wireless communication systems. However, current research efforts regarding large AI models for wireless communications primarily focus on fine-tuning pre-trained large language models (LLMs) for specific tasks. This paper investigates the large-scale AI model designed for beamforming optimization to adapt and generalize to diverse tasks defined by system utilities and scales. We propose a novel framework based on bidirectional encoder representations from transformers (BERT), termed BERT4beam. We aim to formulate the beamforming optimization problem as a token-level sequence learning task, perform tokenization of the channel state information, construct the BERT model, and conduct task-specific pre-training and fine-tuning strategies. Based on the framework, we propose two BERT-based approaches for single-task and multi-task beamforming optimization, respectively. Both approaches are generalizable for varying user scales. Moreover, the former can adapt to varying system utilities and antenna configurations by re-configuring the input and output module of the BERT model, while the latter, termed UBERT, can directly generalize to diverse tasks, due to a finer-grained tokenization strategy. Extensive simulation results demonstrate that the two proposed approaches can achieve near-optimal performance and outperform existing AI models across various beamforming optimization tasks, showcasing strong adaptability and generalizability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11056","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:53:44Z","registered":"2025-09-16T02:53:45Z","published":null,"updated":"2026-06-02T04:52:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11206","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11206","identifiers":[{"identifier":"2509.11206","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tae Soo","familyName":"Kim","name":"Kim, Tae Soo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heechan","familyName":"Lee","name":"Lee, Heechan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoonjoo","familyName":"Lee","name":"Lee, Yoonjoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joseph","familyName":"Seering","name":"Seering, Joseph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juho","familyName":"Kim","name":"Kim, Juho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evalet: Evaluating Large Language Models through Functional Fragmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T10:24:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:41:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T02:46:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:17:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-03T11:40:26Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-04T01:54:47Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-20T05:43:30Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-21T01:41:57Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Practitioners increasingly rely on Large Language Models (LLMs) to evaluate generative AI outputs through \"LLM-as-a-Judge\" approaches. However, these methods produce holistic scores that obscure which specific elements influenced the assessments. We propose functional fragmentation, a method that dissects each output into key fragments and interprets the rhetoric functions that each fragment serves relative to evaluation criteria -- surfacing the elements of interest and revealing how they fulfill or hinder user goals. We instantiate this approach in Evalet, an interactive system that visualizes fragment-level functions across many outputs to support inspection, rating, and comparison of evaluations. A user study (N=10) found that, while practitioners struggled to validate holistic scores, our approach helped them identify 48% more evaluation misalignments. This helped them calibrate trust in LLM evaluations and rely on them to find more actionable issues in model outputs. Our work shifts LLM evaluation from quantitative scores toward qualitative, fine-grained analysis of model behavior."},{"descriptionType":"Other","description":"The first two authors hold equal contribution. Presented at CHI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11206","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:57:13Z","registered":"2025-09-16T02:57:13Z","published":null,"updated":"2026-04-21T04:48:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11125","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11125","identifiers":[{"identifier":"2509.11125","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zheng","familyName":"Li","name":"Li, Zheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pei","familyName":"Qu","name":"Qu, Pei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufei","familyName":"Jia","name":"Jia, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihui","familyName":"Zhou","name":"Zhou, Shihui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haizhou","familyName":"Ge","name":"Ge, Haizhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahang","familyName":"Cao","name":"Cao, Jiahang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinni","familyName":"Zhou","name":"Zhou, Jinni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guyue","familyName":"Zhou","name":"Zhou, Guyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Ma","name":"Ma, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ManiVID-3D: Generalizable View-Invariant Reinforcement Learning for Robotic Manipulation via Disentangled 3D Representations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T06:31:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:35:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-07T18:04:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-10T01:43:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-12T07:19:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-13T00:30:20Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deploying visual reinforcement learning (RL) policies in real-world manipulation is often hindered by camera viewpoint changes. A policy trained from a fixed front-facing camera may fail when the camera is shifted -- an unavoidable situation in real-world settings where sensor placement is hard to manage appropriately. Existing methods often rely on precise camera calibration or struggle with large perspective changes. To address these limitations, we propose ManiVID-3D, a novel 3D RL architecture designed for robotic manipulation, which learns view-invariant representations through self-supervised disentangled feature learning. The framework incorporates ViewNet, a lightweight yet effective module that automatically aligns point cloud observations from arbitrary viewpoints into a unified spatial coordinate system without the need for extrinsic calibration. Additionally, we develop an efficient GPU-accelerated batch rendering module capable of processing over 5000 frames per second, enabling large-scale training for 3D visual RL at unprecedented speeds. Extensive evaluation across 10 simulated and 5 real-world tasks demonstrates that our approach achieves a 40.6% higher success rate than state-of-the-art methods under viewpoint variations while using 80% fewer parameters. The system's robustness to severe perspective changes and strong sim-to-real performance highlight the effectiveness of learning geometrically consistent representations for scalable robotic manipulation in unstructured environments."},{"descriptionType":"Other","description":"Accepted to RA-L. Project website: https://zheng-joe-lee.github.io/manivid3d/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11125","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:55:19Z","registered":"2025-09-16T02:55:20Z","published":null,"updated":"2026-03-13T02:19:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11364","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11364","identifiers":[{"identifier":"2509.11364","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sheng","familyName":"Liu","name":"Liu, Sheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Li","name":"Li, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiheng","familyName":"Wang","name":"Wang, Weiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Sun","name":"Sun, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng","familyName":"Zhang","name":"Zhang, Heng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongpeng","familyName":"Chen","name":"Chen, Hongpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yusen","familyName":"Qin","name":"Qin, Yusen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arash","familyName":"Ajoudani","name":"Ajoudani, Arash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yizhao","familyName":"Wang","name":"Wang, Yizhao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ActivePose: Active 6D Object Pose Estimation and Tracking for Robotic Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T17:39:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:50:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-07T13:25:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T00:44:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate 6-DoF object pose estimation and tracking are critical for reliable robotic manipulation. However, zero-shot methods often fail under viewpoint-induced ambiguities and fixed-camera setups struggle when objects move or become self-occluded. To address these challenges, we propose an active pose estimation pipeline that combines a Vision-Language Model (VLM) with \"robotic imagination\" to dynamically detect and resolve ambiguities in real time. In an offline stage, we render a dense set of views of the CAD model, compute the FoundationPose entropy for each view, and construct a geometric-aware prompt that includes low-entropy (unambiguous) and high-entropy (ambiguous) examples. At runtime, the system: (1) queries the VLM on the live image for an ambiguity score; (2) if ambiguity is detected, imagines a discrete set of candidate camera poses by rendering virtual views, scores each based on a weighted combination of VLM ambiguity probability and FoundationPose entropy, and then moves the camera to the Next-Best-View (NBV) to obtain a disambiguated pose estimation. Furthermore, since moving objects may leave the camera's field of view, we introduce an active pose tracking module: a diffusion-policy trained via imitation learning, which generates camera trajectories that preserve object visibility and minimize pose ambiguity. Experiments in simulation and real-world show that our approach significantly outperforms classical baselines."},{"descriptionType":"Other","description":"6D Pose, Diffusion Policy, Robot Learning"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11364","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:58Z","registered":"2025-09-16T03:00:59Z","published":null,"updated":"2026-03-10T04:49:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11165","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11165","identifiers":[{"identifier":"2509.11165","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Waikit","familyName":"Xiu","name":"Xiu, Waikit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Lu","name":"Lu, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingchen","familyName":"Liu","name":"Liu, Bingchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Sun","name":"Sun, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiying","familyName":"Li","name":"Li, Xiying","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Traffic-MLLM: Curiosity-Regularized Supervised Learning for Traffic Scenario Case-Based Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T08:53:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:38:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-07T14:12:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-10T00:45:52Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"For safe and robust autonomous driving, decision-making systems must effectively leverage past experiences to handle the inherent long-tail of traffic scenarios. Case-Based Reasoning (CBR) provides a natural paradigm for this by adapting solutions from prior cases. However, in complex and dynamic traffic environments, traditional CBR methods struggle to effectively abstract and adapt knowledge under uncertainty. Meanwhile, although multimodal large language models (MLLMs) exhibit strong perceptual and linguistic capabilities, their reasoning behavior often relies on empirical pattern fitting, limiting robustness under distribution shift and long-tail scenarios. We propose Traffic-MLLM, a retrieval-free neural case modeling framework for multimodal traffic reasoning. Instead of performing explicit case retrieval at inference time, Traffic-MLLM learns a structured and generalizable case space directly during training. To support this learning process, we construct a multi-source case base by integrating dynamic traffic videos and large-scale static visual question-answering data, serving as a unified training substrate for learning structured case representations. To further improve representation quality near knowledge boundaries, we introduce a curiosity-driven refinement mechanism based on Random Network Distillation (RND), encouraging the model to internalize cross-case structural regularities rather than surface correlations. Experiments on the SUTD-TrafficQA and DriveQA benchmarks demonstrate consistent improvements in dynamic reasoning, regulatory understanding, and cross-domain transfer. Traffic-MLLM achieves 50.8% accuracy on SUTD-TrafficQA, 74.8% on the CARLA-based DriveQA split, and 83.1% on the real-world Mapillary split, indicating that representation-level case-space refinement provides an effective alternative to explicit retrieval for scalable multimodal case adaptation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11165","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:16Z","registered":"2025-09-16T02:56:17Z","published":null,"updated":"2026-03-10T04:49:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11128","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11128","identifiers":[{"identifier":"2509.11128","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yibo","familyName":"Zhang","name":"Zhang, Yibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Lin","name":"Lin, Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ERIS: Evolutionary Real-world Interference Scheme for Jailbreaking Audio Large Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T06:39:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:35:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-02T12:47:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T03:05:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing Audio Large Models (ALMs) alignment focuses on clean inputs, neglecting security risks in complex environments. We propose ERIS, a framework transforming real-world interference into a strategically optimized carrier for jailbreaking ALMs. Unlike methods relying on manually designed acoustic patterns, ERIS uses a genetic algorithm to optimize the selection and synthesis of naturalistic signals. Through population initialization, crossover fusion, and probabilistic mutation, it evolves audio fusing malicious instructions with real-world interference. To humans and safety filters, these samples present as natural speech with harmless background noise, yet bypass alignment. Evaluations on multiple ALMs show ERIS significantly outperforms both text and audio jailbreak baselines. Our findings reveal that seemingly innocuous real-world interference can be leveraged to circumvent safety constraints, providing new insights for defensive mechanisms in complex acoustic scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11128","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:55:24Z","registered":"2025-09-16T02:55:24Z","published":null,"updated":"2026-03-03T05:42:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11079","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11079","identifiers":[{"identifier":"2509.11079","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinwei","familyName":"Su","name":"Su, Jinwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qizhen","familyName":"Lan","name":"Lan, Qizhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinghui","familyName":"Xia","name":"Xia, Yinghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifan","familyName":"Sun","name":"Sun, Lifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiyou","familyName":"Tian","name":"Tian, Weiyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Shi","name":"Shi, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyuan","familyName":"Song","name":"Song, Xinyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lewei","familyName":"He","name":"He, Lewei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Jingsong","name":"Jingsong, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Difficulty-Aware Agentic Orchestration for Query-Specific Multi-Agent Workflows"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T03:57:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T02:48:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T13:32:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:52:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-11T12:33:57Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-14T00:35:55Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-12-08T06:37:01Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-12-09T02:14:51Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-02-13T16:13:15Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-02-16T01:50:46Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Model (LLM)-based agentic systems have shown strong capabilities across various tasks. However, existing multi-agent frameworks often rely on static or task-level workflows, which either over-process simple queries or underperform on complex ones, while also neglecting the efficiency-performance trade-offs across heterogeneous LLMs. To address these limitations, we propose Difficulty-Aware Agentic Orchestration (DAAO), which can dynamically generate query-specific multi-agent workflows guided by predicted query difficulty. DAAO comprises three interdependent modules: a variational autoencoder (VAE) for difficulty estimation, a modular operator allocator, and a cost- and performance-aware LLM router. A self-adjusting policy updates difficulty estimates based on workflow success, enabling simpler workflows for easy queries and more complex strategies for harder ones. Experiments on six benchmarks demonstrate that DAAO surpasses prior multi-agent systems in both accuracy and inference efficiency, validating its effectiveness for adaptive, difficulty-aware reasoning."},{"descriptionType":"Other","description":"Accepted to WWW2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11079","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:16Z","registered":"2025-09-16T02:54:17Z","published":null,"updated":"2026-02-16T02:59:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11362","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11362","identifiers":[{"identifier":"2509.11362","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Loka","familyName":"Li","name":"Li, Loka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wong Yu","familyName":"Kang","name":"Kang, Wong Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghao","familyName":"Fu","name":"Fu, Minghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangyi","familyName":"Chen","name":"Chen, Guangyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenhao","familyName":"Chen","name":"Chen, Zhenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gongxu","familyName":"Luo","name":"Luo, Gongxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuewen","familyName":"Sun","name":"Sun, Yuewen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salman","familyName":"Khan","name":"Khan, Salman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Spirtes","name":"Spirtes, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Zhang","name":"Zhang, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PersonaX: Multimodal Datasets with LLM-Inferred Behavior Traits"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T17:30:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:49:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-10T12:33:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-11T01:48:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding human behavior traits is central to applications in human-computer interaction, computational social science, and personalized AI systems. Such understanding often requires integrating multiple modalities to capture nuanced patterns and relationships. However, existing resources rarely provide datasets that combine behavioral descriptors with complementary modalities such as facial attributes and biographical information. To address this gap, we present PersonaX, a curated collection of multimodal datasets designed to enable comprehensive analysis of public traits across modalities. PersonaX consists of (1) CelebPersona, featuring 9444 public figures from diverse occupations, and (2) AthlePersona, covering 4181 professional athletes across 7 major sports leagues. Each dataset includes behavioral trait assessments inferred by three high-performing large language models, alongside facial imagery and structured biographical features. We analyze PersonaX at two complementary levels. First, we abstract high-level trait scores from text descriptions and apply five statistical independence tests to examine their relationships with other modalities. Second, we introduce a novel causal representation learning (CRL) framework tailored to multimodal and multi-measurement data, providing theoretical identifiability guarantees. Experiments on both synthetic and real-world data demonstrate the effectiveness of our approach. By unifying structured and unstructured analysis, PersonaX establishes a foundation for studying LLM-inferred behavioral traits in conjunction with visual and biographical attributes, advancing multimodal trait analysis and causal reasoning. The code is available at https://github.com/lokali/PersonaX."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11362","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:55Z","registered":"2025-09-16T03:00:56Z","published":null,"updated":"2026-02-11T03:28:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11361","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11361","identifiers":[{"identifier":"2509.11361","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yichen","familyName":"Han","name":"Han, Yichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhang","familyName":"Han","name":"Han, Yuhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siteng","familyName":"Huang","name":"Huang, Siteng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanyu","familyName":"Liu","name":"Liu, Guanyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengpeng","familyName":"Zhou","name":"Zhou, Zhengpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bojun","familyName":"Liu","name":"Liu, Bojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujia","familyName":"Zhang","name":"Zhang, Yujia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isaac N","familyName":"Shi","name":"Shi, Isaac N","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lewei","familyName":"He","name":"He, Lewei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Shi","name":"Shi, Tianyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MAPGD: Multi-Agent Prompt Gradient Descent for Collaborative Prompt Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T17:28:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:49:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-07T09:25:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-08T00:35:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-03T09:31:40Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-04T01:46:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Prompt engineering is crucial for fully leveraging large language models (LLMs), yet most existing optimization methods follow a single trajectory, resulting in limited adaptability, gradient conflicts, and high computational overhead. We propose MAPGD (Multi-Agent Prompt Gradient Descent), a novel framework that reconceptualizes prompt optimization as a collaborative process among specialized agents. Each agent focuses on a distinct refinement dimension, such as instruction clarity, example selection, format structure, or stylistic adaptation, and their contributions are coordinated through semantic gradient embedding, conflict detection, and fusion. To further enhance robustness and stability, MAPGD introduces two new mechanisms: Hypersphere Constrained Gradient Clustering (HCGC), which enforces angular margin constraints for compact and well-separated clusters, and Channel Adaptive Agent Weighting (CAAW), which dynamically reweights agent contributions based on validation performance. Experiments on classification and reasoning benchmarks show that MAPGD consistently surpasses single-agent and random baselines in both accuracy and efficiency. Ablation studies confirm the effectiveness of gradient fusion, agent specialization, and conflict resolution. Together, these components establish MAPGD as a unified, gradient-based, and interpretable framework for robust prompt optimization with theoretical convergence guarantees."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11361","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:54Z","registered":"2025-09-16T03:00:55Z","published":null,"updated":"2026-02-04T03:40:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11311","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11311","identifiers":[{"identifier":"2509.11311","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bingchen","familyName":"Wang","name":"Wang, Bingchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zi-Yu","familyName":"Khoo","name":"Khoo, Zi-Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingtan","familyName":"Wang","name":"Wang, Jingtan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prompts to Proxies: Emulating Human Preferences via a Compact LLM Ensemble"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T15:08:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:46:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-28T19:39:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-30T01:04:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models are increasingly used as proxies for human subjects in social science research, yet external validity requires that synthetic agents faithfully reflect the preferences of target human populations. We introduce *preference reconstruction theory*, a framework that formalizes preference alignment as a representation learning problem: constructing a functional basis of proxy agents and recovering population preferences through weighted aggregation. We implement this via *Prompts to Proxies* ($\\texttt{P2P}$), a modular two-stage system. Stage 1 uses structured prompting with entropy-based adaptive sampling to construct a diverse agent pool spanning the latent preference space. Stage 2 employs L1-regularized regression to select a compact ensemble whose aggregate response distributions align with observed data from the target population. $\\texttt{P2P}$ requires no finetuning and no access to sensitive demographic data, incurring only API inference costs. We validate the approach on 14 waves of the American Trends Panel, achieving an average test MSE of 0.014 across diverse topics at approximately 0.8 USD per survey. We additionally test it on the World Values Survey, demonstrating its potential to generalize across locales. When stress-tested against an SFT-aligned baseline, $\\texttt{P2P}$ achieves competitive performance using less than 3% of the training data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11311","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:59:40Z","registered":"2025-09-16T02:59:41Z","published":null,"updated":"2026-01-30T03:41:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11078","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11078","identifiers":[{"identifier":"2509.11078","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunghwei","familyName":"Lai","name":"Lai, Yunghwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyue","familyName":"Wang","name":"Wang, Ziyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weizhi","familyName":"Ma","name":"Ma, Weizhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Liu","name":"Liu, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Patient-Zero: Scaling Synthetic Patient Agents to Real-World Distributions without Real Patient Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T03:56:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:33:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-06T13:16:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-07T01:42:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthetic data generation with Large Language Models (LLMs) has emerged as a promising solution in the medical domain to mitigate data scarcity and privacy constraints. However, existing approaches remain constrained by their derivative nature, relying on real-world records, which pose privacy risks and distribution biases. Furthermore, current patient agents face the Stability-Plasticity Dilemma, struggling to maintain clinical consistency during dynamic inquiries. To address these challenges, we introduce Patient-Zero, a novel framework for ab initio patient simulation that requires no real medical records. Our Medically-Aligned Hierarchical Synthesis framework generates comprehensive and diverse patient records from abstract clinical guidelines via stratified attribute permutation. To support rigorous clinical interaction, we design a Dual-Track Cognitive Memory System to enable agents dynamically update memory while preserving logical consistency and persona adherence. Extensive evaluations show that Patient-Zero establishes a new state-of-the-art in both data quality and interaction fidelity. In human expert evaluations, senior licensed physicians judge our synthetic data to be statistically indistinguishable from real human-authored data and higher in clinical quality. Furthermore, downstream medical reasoning model trained on our synthetic dataset shows substantial performance gains (MedQA +24.0%; MMLU +14.5%), demonstrating the practical utility of our framework."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11078","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:15Z","registered":"2025-09-16T02:54:15Z","published":null,"updated":"2026-01-07T02:59:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10975","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10975","identifiers":[{"identifier":"2509.10975","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jielong","familyName":"Tang","name":"Tang, Jielong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Wang","name":"Wang, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenxing","familyName":"Wang","name":"Wang, Zhenxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianxing","familyName":"Yu","name":"Yu, Jianxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Yin","name":"Yin, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ReFineG: Synergizing Small Supervised Models and LLMs for Low-Resource Grounded Multimodal NER"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T20:32:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:27:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-12T08:01:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-13T01:31:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Grounded Multimodal Named Entity Recognition (GMNER) extends traditional NER by jointly detecting textual mentions and grounding them to visual regions. While existing supervised methods achieve strong performance, they rely on costly multimodal annotations and often underperform in low-resource domains. Multimodal Large Language Models (MLLMs) show strong generalization but suffer from Domain Knowledge Conflict, producing redundant or incorrect mentions for domain-specific entities. To address these challenges, we propose ReFineG, a three-stage collaborative framework that integrates small supervised models with frozen MLLMs for low-resource GMNER. In the Training Stage, a domain-aware NER data synthesis strategy transfers LLM knowledge to small models with supervised training while avoiding domain knowledge conflicts. In the Refinement Stage, an uncertainty-based mechanism retains confident predictions from supervised models and delegates uncertain ones to the MLLM. In the Grounding Stage, a multimodal context selection algorithm enhances visual grounding through analogical reasoning. In the CCKS2025 GMNER Shared Task, ReFineG ranked second with an F1 score of 0.6461 on the online leaderboard, demonstrating its effectiveness with limited annotations."},{"descriptionType":"Other","description":"CCKS 2025 Shared Task Paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10975","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:51:50Z","registered":"2025-09-16T02:51:51Z","published":null,"updated":"2025-11-13T03:08:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.19331","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.19331","identifiers":[{"identifier":"2509.19331","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Enhao","familyName":"Huang","name":"Huang, Enhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyu","familyName":"Zhang","name":"Zhang, Zhiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianxiang","familyName":"Xu","name":"Xu, Tianxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunshu","familyName":"Xia","name":"Xia, Chunshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaichun","familyName":"Hu","name":"Hu, Kaichun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Yang","name":"Yang, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongtong","familyName":"Pan","name":"Pan, Tongtong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Dong","name":"Dong, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhan","familyName":"Qin","name":"Qin, Zhan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Holographic Transformers for Complex-Valued Signal Processing: Integrating Phase Interference into Self-Attention"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T15:24:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-25T00:00:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-30T03:42:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-31T00:22:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Complex-valued signals encode both amplitude and phase, yet most deep models treat attention as real-valued correlation, overlooking interference effects. We introduce the Holographic Transformer, a physics-inspired architecture that incorporates wave interference principles into self-attention. Holographic attention modulates interactions by relative phase and coherently superimposes values, ensuring consistency between amplitude and phase. A dual-headed decoder simultaneously reconstructs the input and predicts task outputs, preventing phase collapse when losses prioritize magnitude over phase. We demonstrate that holographic attention implements a discrete interference operator and maintains phase consistency under linear mixing. Experiments on PolSAR image classification and wireless channel prediction show strong performance, achieving high classification accuracy and F1 scores, low regression error, and increased robustness to phase perturbations. These results highlight that enforcing physical consistency in attention leads to generalizable improvements in complex-valued learning and provides a unified, physics-based framework for coherent signal modeling. The code is available at https://github.com/EonHao/Holographic-Transformers."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.19331","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-25T01:42:32Z","registered":"2025-09-25T01:42:32Z","published":null,"updated":"2025-10-31T02:10:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11348","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11348","identifiers":[{"identifier":"2509.11348","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Viet-Hoang","familyName":"Tran","name":"Tran, Viet-Hoang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Van Hoan","familyName":"Trinh","name":"Trinh, Van Hoan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khanh Vinh","familyName":"Bui","name":"Bui, Khanh Vinh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tan M.","familyName":"Nguyen","name":"Nguyen, Tan M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Linear Mode Connectivity of Mixture-of-Experts Architectures"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T16:51:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:49:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-25T03:12:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-28T00:23:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Linear Mode Connectivity (LMC) is a notable phenomenon in the loss landscapes of neural networks, wherein independently trained models have been observed to be connected--up to permutation symmetries--by linear paths in parameter space along which the loss remains consistently low. This observation challenges classical views of non-convex optimization and has implications for model ensembling, generalization, and our understanding of neural loss geometry. Inspired by recent studies on LMC in standard neural networks, we systematically investigate this phenomenon within Mixture-of-Experts (MoE) architectures--a class of models known for their scalability and computational efficiency, which combine traditional neural networks--referred to as experts--through a learnable gating mechanism. We begin by conducting a comprehensive analysis of both dense and sparse gating regimes, demonstrating that the symmetries inherent to MoE architectures are fully characterized by permutations acting on both the expert components and the gating function. Building on these foundational findings, we propose a matching algorithm that enables alignment between independently trained MoEs, thereby facilitating the discovery of LMC. Finally, we empirically validate the presence of LMC using our proposed algorithm across diverse MoE configurations--including dense, sparse, and shared-expert variants--under a wide range of model settings and datasets of varying scales and modalities. Our results confirm the existence of LMC in MoE architectures and offer fundamental insights into the functional landscape and optimization dynamics of deep learning models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11348","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:36Z","registered":"2025-09-16T03:00:37Z","published":null,"updated":"2025-10-28T04:02:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.21715","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.21715","identifiers":[{"identifier":"2510.21715","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sergio","familyName":"Rojas-Galeano","name":"Rojas-Galeano, Sergio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond IVR Touch-Tones: Customer Intent Routing using LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T02:26:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-28T00:00:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Widespread frustration with rigid touch-tone Interactive Voice Response (IVR) systems for customer service underscores the need for more direct and intuitive language interaction. While speech technologies are necessary, the key challenge lies in routing intents from user phrasings to IVR menu paths, a task where Large Language Models (LLMs) show strong potential. Progress, however, is limited by data scarcity, as real IVR structures and interactions are often proprietary. We present a novel LLM-based methodology to address this gap. Using three distinct models, we synthesized a realistic 23-node IVR structure, generated 920 user intents (230 base and 690 augmented), and performed the routing task. We evaluate two prompt designs: descriptive hierarchical menus and flattened path representations, across both base and augmented datasets. Results show that flattened paths consistently yield higher accuracy, reaching 89.13% on the base dataset compared to 81.30% with the descriptive format, while augmentation introduces linguistic noise that slightly reduces performance. Confusion matrix analysis further suggests that low-performing routes may reflect not only model limitations but also redundancies in menu design. Overall, our findings demonstrate proof-of-concept that LLMs can enable IVR routing through a smoother, more seamless user experience -- moving customer service one step ahead of touch-tone menus."},{"descriptionType":"Other","description":"Accepted for publication in the Proceedings of the Workshop on Engineering Applications 2025 (WEA 2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.21715","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-28T02:58:15Z","registered":"2025-10-28T02:58:15Z","published":null,"updated":"2025-10-28T02:58:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11145","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11145","identifiers":[{"identifier":"2509.11145","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yi","familyName":"Wang","name":"Wang, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lihai","familyName":"Yang","name":"Yang, Lihai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Boyu","familyName":"Chen","name":"Chen, Boyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gongyi","familyName":"Zou","name":"Zou, Gongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kerun","familyName":"Xu","name":"Xu, Kerun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Tang","name":"Tang, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feiyu","familyName":"Xiong","name":"Xiong, Feiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siheng","familyName":"Chen","name":"Chen, Siheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyu","familyName":"Li","name":"Li, Zhiyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Text2Mem: A Unified Memory Operation Language for Memory Operating System"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T07:30:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-22T17:38:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-23T17:53:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-24T01:03:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language model agents increasingly depend on memory to sustain long horizon interaction, but existing frameworks remain limited. Most expose only a few basic primitives such as encode, retrieve, and delete, while higher order operations like merge, promote, demote, split, lock, and expire are missing or inconsistently supported. Moreover, there is no formal and executable specification for memory commands, leaving scope and lifecycle rules implicit and causing unpredictable behavior across systems. We introduce Text2Mem, a unified memory operation language that provides a standardized pathway from natural language to reliable execution. Text2Mem defines a compact yet expressive operation set aligned with encoding, storage, and retrieval. Each instruction is represented as a JSON based schema instance with required fields and semantic invariants, which a parser transforms into typed operation objects with normalized parameters. A validator ensures correctness before execution, while adapters map typed objects either to a SQL prototype backend or to real memory frameworks. Model based services such as embeddings or summarization are integrated when required. All results are returned through a unified execution contract. This design ensures safety, determinism, and portability across heterogeneous backends. We also outline Text2Mem Bench, a planned benchmark that separates schema generation from backend execution to enable systematic evaluation. Together, these components establish the first standardized foundation for memory control in agents."},{"descriptionType":"Other","description":"12 pages, 3 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11145","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:55:48Z","registered":"2025-09-16T02:55:48Z","published":null,"updated":"2025-10-24T02:14:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2510.18880","type":"dois","attributes":{"doi":"10.48550/arxiv.2510.18880","identifiers":[{"identifier":"2510.18880","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rory","familyName":"Sayres","name":"Sayres, Rory","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuexing","familyName":"Hao","name":"Hao, Yuexing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abbi","familyName":"Ward","name":"Ward, Abbi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amy","familyName":"Wang","name":"Wang, Amy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beverly","familyName":"Freeman","name":"Freeman, Beverly","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Serena","familyName":"Zhan","name":"Zhan, Serena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Diego","familyName":"Ardila","name":"Ardila, Diego","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jimmy","familyName":"Li","name":"Li, Jimmy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"I-Ching","familyName":"Lee","name":"Lee, I-Ching","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Iurchenko","name":"Iurchenko, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyi","familyName":"Kou","name":"Kou, Siyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kartikeya","familyName":"Badola","name":"Badola, Kartikeya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jimmy","familyName":"Hu","name":"Hu, Jimmy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bhawesh","familyName":"Kumar","name":"Kumar, Bhawesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keith","familyName":"Johnson","name":"Johnson, Keith","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Supriya","familyName":"Vijay","name":"Vijay, Supriya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Justin","familyName":"Krogue","name":"Krogue, Justin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avinatan","familyName":"Hassidim","name":"Hassidim, Avinatan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yossi","familyName":"Matias","name":"Matias, Yossi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dale R.","familyName":"Webster","name":"Webster, Dale R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunny","familyName":"Virmani","name":"Virmani, Sunny","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Liu","name":"Liu, Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Quang","familyName":"Duong","name":"Duong, Quang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mike","familyName":"Schaekermann","name":"Schaekermann, Mike","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Better Health Conversations: The Benefits of Context-seeking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T01:08:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-23T00:00:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Navigating health questions can be daunting in the modern information landscape. Large language models (LLMs) may provide tailored, accessible information, but also risk being inaccurate, biased or misleading. We present insights from 4 mixed-methods studies (total N=163), examining how people interact with LLMs for their own health questions. Qualitative studies revealed the importance of context-seeking in conversational AIs to elicit specific details a person may not volunteer or know to share. Context-seeking by LLMs was valued by participants, even if it meant deferring an answer for several turns. Incorporating these insights, we developed a \"Wayfinding AI\" to proactively solicit context. In a randomized, blinded study, participants rated the Wayfinding AI as more helpful, relevant, and tailored to their concerns compared to a baseline AI. These results demonstrate the strong impact of proactive context-seeking on conversational dynamics, and suggest design patterns for conversational AI to help navigate health topics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2510.18880","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-10-23T01:41:02Z","registered":"2025-10-23T01:41:02Z","published":null,"updated":"2025-10-23T01:41:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18133","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18133","identifiers":[{"identifier":"2509.18133","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiazheng","familyName":"Kang","name":"Kang, Jiazheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Le","familyName":"Huang","name":"Huang, Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Hou","name":"Hou, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Zhao","name":"Zhao, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenxiang","familyName":"Yan","name":"Yan, Zhenxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting","familyName":"Bai","name":"Bai, Ting","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Self-Evolving LLMs via Continual Instruction Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T04:04:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-24T00:01:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T08:15:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:33:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-29T09:42:58Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-30T01:49:24Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10-15T02:31:11Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-16T00:19:56Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In real-world industrial settings, large language models (LLMs) must learn continually to keep pace with diverse and evolving tasks, requiring self-evolution to refine knowledge under dynamic data distributions. However, existing continual learning (CL) approaches, such as replay and parameter isolation, often suffer from catastrophic forgetting: training on new tasks degrades performance on earlier ones by overfitting to the new distribution and weakening generalization.We propose MoE-CL, a parameter-efficient adversarial mixture-of-experts framework for industrial-scale, self-evolving continual instruction tuning of LLMs. MoE-CL uses a dual-expert design: (1) a dedicated LoRA expert per task to preserve task-specific knowledge via parameter independence, mitigating forgetting; and (2) a shared LoRA expert to enable cross-task transfer. To prevent transferring task-irrelevant noise through the shared pathway, we integrate a task-aware discriminator within a GAN. The discriminator encourages the shared expert to pass only task-aligned information during sequential training. Through adversarial learning, the shared expert acquires generalized representations that mimic the discriminator, while dedicated experts retain task-specific details, balancing knowledge retention and cross-task generalization and thereby supporting self-evolution.Extensive experiments on the public MTL5 benchmark and an industrial Tencent3 benchmark validate the effectiveness of MoE-CL for continual instruction tuning. In real-world A/B testing for content compliance review on the Tencent Video platform, MoE-CL reduced manual review costs by 15.3%. These results demonstrate that MoE-CL is practical for large-scale industrial deployment where continual adaptation and stable transfer are critical."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18133","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-24T01:51:04Z","registered":"2025-09-24T01:51:05Z","published":null,"updated":"2025-10-16T02:25:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11178","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11178","identifiers":[{"identifier":"2509.11178","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chengde","familyName":"Lin","name":"Lin, Chengde","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuezhu","familyName":"Gong","name":"Gong, Xuezhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuxue","familyName":"Ding","name":"Ding, Shuxue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingzhe","familyName":"Yang","name":"Yang, Mingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xijun","familyName":"Lu","name":"Lu, Xijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengjun","familyName":"Mo","name":"Mo, Chengjun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"StegOT: Trade-offs in Steganography via Optimal Transport"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T09:18:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:39:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-14T12:16:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-15T00:45:58Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Image hiding is often referred to as steganography, which aims to hide a secret image in a cover image of the same resolution. Many steganography models are based on genera-tive adversarial networks (GANs) and variational autoencoders (VAEs). However, most existing models suffer from mode collapse. Mode collapse will lead to an information imbalance between the cover and secret images in the stego image and further affect the subsequent extraction. To address these challenges, this paper proposes StegOT, an autoencoder-based steganography model incorporating optimal transport theory. We designed the multiple channel optimal transport (MCOT) module to transform the feature distribution, which exhibits multiple peaks, into a single peak to achieve the trade-off of information. Experiments demonstrate that we not only achieve a trade-off between the cover and secret images but also enhance the quality of both the stego and recovery images. The source code will be released on https://github.com/Rss1124/StegOT."},{"descriptionType":"Other","description":"Accepted by IEEE International Conference on Multimedia and Expo (ICME 2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11178","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:35Z","registered":"2025-09-16T02:56:35Z","published":null,"updated":"2025-10-15T02:21:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11303","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11303","identifiers":[{"identifier":"2509.11303","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dasol","familyName":"Choi","name":"Choi, Dasol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungwhan","familyName":"Kim","name":"Kim, Jungwhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guijin","familyName":"Son","name":"Son, Guijin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Ko-PIQA: A Korean Physical Commonsense Reasoning Dataset with Cultural Context"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T14:47:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:46:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T06:44:01Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:27:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-29T01:32:59Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-30T01:26:28Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Physical commonsense reasoning datasets like PIQA are predominantly English-centric and lack cultural diversity. We introduce Ko-PIQA, a Korean physical commonsense reasoning dataset that incorporates cultural context. Starting from 3.01 million web-crawled questions, we employed a multi-stage filtering approach using three language models to identify 11,553 PIQA-style questions. Through GPT-4o refinement and human validation, we obtained 441 high-quality question-answer pairs. A key feature of Ko-PIQA is its cultural grounding: 19.7% of questions contain culturally specific elements like traditional Korean foods (kimchi), clothing (hanbok), and specialized appliances (kimchi refrigerators) that require culturally-aware reasoning beyond direct translation. We evaluate seven language models on Ko-PIQA, with the best model achieving 83.22% accuracy while the weakest reaches only 59.86%, demonstrating significant room for improvement. Models particularly struggle with culturally specific scenarios, highlighting the importance of culturally diverse datasets. Ko-PIQA serves as both a benchmark for Korean language models and a foundation for more inclusive commonsense reasoning research. The dataset and code will be publicly available."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11303","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:59:29Z","registered":"2025-09-16T02:59:30Z","published":null,"updated":"2025-09-30T05:17:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.22674","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.22674","identifiers":[{"identifier":"2509.22674","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yash","familyName":"Thube","name":"Thube, Yash","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pathological Truth Bias in Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T14:46:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-30T00:00:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision Language Models (VLMs) are improving quickly, but standard benchmarks can hide systematic failures that reduce real world trust. We introduce MATS (Multimodal Audit for Truthful Spatialization), a compact behavioral audit that measures whether models reject visually contradicted statements, and two metrics Spatial Consistency Score (SCS) and Incorrect Agreement Rate (IAR). Instruction tuned generative VLMs (LLaVA 1.5, QwenVLchat) exhibit very low SCS and high IAR, while contrastive encoders (CLIP, SigLIP) are far more robust. Activation patching causally localizes failure loci (mid to late cross attention for generative models, pooled projection components for contrastive models) and suggests concrete repair paths."},{"descriptionType":"Other","description":"10 pages, 12 figures. Code for MATS released at https://github.com/thubZ09/mats-spatial-reasoning"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.22674","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-30T03:28:56Z","registered":"2025-09-30T03:28:57Z","published":null,"updated":"2025-09-30T03:28:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.19329","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.19329","identifiers":[{"identifier":"2509.19329","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Julie","familyName":"Jung","name":"Jung, Julie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Max","familyName":"Lu","name":"Lu, Max","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sina Chole","familyName":"Benker","name":"Benker, Sina Chole","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dogus","familyName":"Darici","name":"Darici, Dogus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Model Size, Temperature, and Prompt Style Affect LLM-Human Assessment Score Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T02:24:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-25T00:00:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We examined how model size, temperature, and prompt style affect Large Language Models' (LLMs) alignment within itself, between models, and with human in assessing clinical reasoning skills. Model size emerged as a key factor in LLM-human score alignment. Study highlights the importance of checking alignments across multiple levels."},{"descriptionType":"Other","description":"9 pages, 4 figures, accepted at NCME AIME 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.19329","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-25T01:42:29Z","registered":"2025-09-25T01:42:29Z","published":null,"updated":"2025-09-25T01:42:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.19326","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.19326","identifiers":[{"identifier":"2509.19326","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruochi","familyName":"Li","name":"Li, Ruochi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxuan","familyName":"Zhang","name":"Zhang, Haoxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edward","familyName":"Gehringer","name":"Gehringer, Edward","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting","familyName":"Xiao","name":"Xiao, Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhua","familyName":"Ding","name":"Ding, Junhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haihua","familyName":"Chen","name":"Chen, Haihua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unveiling the Merits and Defects of LLMs in Automatic Review Generation for Scientific Papers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T19:15:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-25T00:00:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The surge in scientific submissions has placed increasing strain on the traditional peer-review process, prompting the exploration of large language models (LLMs) for automated review generation. While LLMs demonstrate competence in producing structured and coherent feedback, their capacity for critical reasoning, contextual grounding, and quality sensitivity remains limited. To systematically evaluate these aspects, we propose a comprehensive evaluation framework that integrates semantic similarity analysis and structured knowledge graph metrics to assess LLM-generated reviews against human-written counterparts. We construct a large-scale benchmark of 1,683 papers and 6,495 expert reviews from ICLR and NeurIPS in multiple years, and generate reviews using five LLMs. Our findings show that LLMs perform well in descriptive and affirmational content, capturing the main contributions and methodologies of the original work, with GPT-4o highlighted as an illustrative example, generating 15.74% more entities than human reviewers in the strengths section of good papers in ICLR 2025. However, they consistently underperform in identifying weaknesses, raising substantive questions, and adjusting feedback based on paper quality. GPT-4o produces 59.42% fewer entities than real reviewers in the weaknesses and increases node count by only 5.7% from good to weak papers, compared to 50% in human reviews. Similar trends are observed across all conferences, years, and models, providing empirical foundations for understanding the merits and defects of LLM-generated reviews and informing the development of future LLM-assisted reviewing tools. Data, code, and more detailed results are publicly available at https://github.com/RichardLRC/Peer-Review."},{"descriptionType":"Other","description":"Accepted as short paper at 25th IEEE International Conference on Data Mining"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.19326","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-25T01:42:24Z","registered":"2025-09-25T01:42:25Z","published":null,"updated":"2025-09-25T01:42:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.19325","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.19325","identifiers":[{"identifier":"2509.19325","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jian","familyName":"Ouyang","name":"Ouyang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arman","familyName":"T","name":"T, Arman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ge","familyName":"Jin","name":"Jin, Ge","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"How Much of Your Data Can Suck? Thresholds for Domain Performance and Emergent Misalignment in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T18:55:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-25T00:00:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates the impact of incorrect data on the performance and safety of large language models (LLMs), specifically gpt-4o, during supervised fine-tuning (SFT). Although LLMs become increasingly vital across broad domains like finance, coding, law, and health, fine-tuning on incorrect data can lead to \"emergent misalignment,\" producing harmful or deceptive outputs unrelated to the intended task. We evaluate gpt-4o models fine-tuned with varying ratios (10\\% to 90\\% correct) of both obviously and subtly incorrect data across four domains: coding, finance, health, and legal. Our findings show that even modest amounts of incorrect data (10-25\\%) dramatically degrade domain performance and not moral alignment. A clear threshold of at least 50\\% correct data is needed for models to consistently recover strong performance, though they rarely match the robustness and safety of the base model, which exhibits near-perfect alignment and zero dangerous completions out-of-the-box. This research emphasizes that the cost of incorrect data is heavy, highlighting the critical need for extremely high-quality data curation or, alternatively, leveraging robust base models without unnecessary fine-tuning for high-stakes applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.19325","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-25T01:42:23Z","registered":"2025-09-25T01:42:24Z","published":null,"updated":"2025-09-25T01:42:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11101","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11101","identifiers":[{"identifier":"2509.11101","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haokun","familyName":"Li","name":"Li, Haokun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yazhou","familyName":"Zhang","name":"Zhang, Yazhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jizhi","familyName":"Ding","name":"Ding, Jizhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiuchi","familyName":"Li","name":"Li, Qiuchi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Zhang","name":"Zhang, Peng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Seeing is Not Understanding: A Benchmark on Perception-Cognition Disparities in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T05:40:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:34:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-22T08:45:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-23T01:20:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-23T02:12:08Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-24T00:22:45Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid advancement of Multimodal Large Language Models (MLLMs), they have demonstrated exceptional capabilities across a variety of vision-language tasks. However, current evaluation benchmarks predominantly focus on objective visual question answering or captioning, inadequately assessing the models' ability to understand complex and subjective human emotions. To bridge this gap, we introduce EmoBench-Reddit, a novel, hierarchical benchmark for multimodal emotion understanding. The dataset comprises 350 meticulously curated samples from the social media platform Reddit, each containing an image, associated user-provided text, and an emotion category (sad, humor, sarcasm, happy) confirmed by user flairs. We designed a hierarchical task framework that progresses from basic perception to advanced cognition, with each data point featuring six multiple-choice questions and one open-ended question of increasing difficulty. Perception tasks evaluate the model's ability to identify basic visual elements (e.g., colors, objects), while cognition tasks require scene reasoning, intent understanding, and deep empathy integrating textual context. We ensured annotation quality through a combination of AI assistance (Claude 4) and manual verification.We conducted a comprehensive evaluation of nine leading MLLMs, including GPT-5, Gemini-2.5-pro, and GPT-4o, on EmoBench-Reddit."},{"descriptionType":"Other","description":"I need to modify the content of the article"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11101","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:46Z","registered":"2025-09-16T02:54:47Z","published":null,"updated":"2025-09-24T02:35:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18137","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18137","identifiers":[{"identifier":"2509.18137","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shaoheng","familyName":"Wang","name":"Wang, Shaoheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Lu","name":"Lu, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Li","name":"Li, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaxin","familyName":"Gao","name":"Gao, Yaxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Nie","name":"Nie, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shanqing","familyName":"Yu","name":"Yu, Shanqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingli","familyName":"Tian","name":"Tian, Yingli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Xuan","name":"Xuan, Qi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LoRALib: A Standardized Benchmark for Evaluating LoRA-MoE Methods"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T16:33:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-24T00:01:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As a parameter efficient fine-tuning (PEFT) method, low-rank adaptation (LoRA) can save significant costs in storage and computing, but its strong adaptability to a single task is often accompanied by insufficient cross-task generalization capabilities. To improve this, existing work combines LoRA with mixture-of-experts (MoE) to enhance the model's adaptability through expert modules and routing mechanisms. However, existing LoRA-MoE methods lack unified standards in models, datasets, hyperparameters, and evaluation methods, making it difficult to conduct fair comparisons between different methods. To this end, we proposed a unified benchmark named LoRALib. Specifically, we standardized datasets from $40$ downstream tasks into a unified format, fine-tuned them using the same hyperparameters and obtained $680$ LoRA modules across $17$ model architectures. Based on this LoRA library, we conduct large-scale experiments on $3$ representative LoRA-MoE methods and different LoRA selection mechanisms using the open-sourced testing tool OpenCompass. Extensive experiments show that LoRAMoE performs best, and that prioritizing LoRAs relevant to the target task can further improve the performance of MoE. We hope these findings will inspire future work. Our datasets and LoRA library are available at https://huggingface.co/datasets/YaoLuzjut/LoRAOcean_dataset and https://huggingface.co/YaoLuzjut/models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18137","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-24T01:51:10Z","registered":"2025-09-24T01:51:10Z","published":null,"updated":"2025-09-24T01:51:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18134","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18134","identifiers":[{"identifier":"2509.18134","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Furan","familyName":"Xie","name":"Xie, Furan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Liu","name":"Liu, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Chai","name":"Chai, Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Weighted Gradient Tracking Privacy-Preserving Method for Distributed Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T07:29:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-24T00:01:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper investigates the privacy-preserving distributed optimization problem, aiming to protect agents' private information from potential attackers during the optimization process. Gradient tracking, an advanced technique for improving the convergence rate in distributed optimization, has been applied to most first-order algorithms in recent years. We first reveal the inherent privacy leakage risk associated with gradient tracking. Building upon this insight, we propose a weighted gradient tracking distributed privacy-preserving algorithm, eliminating the privacy leakage risk in gradient tracking using decaying weight factors. Then, we characterize the convergence of the proposed algorithm under time-varying heterogeneous step sizes. We prove the proposed algorithm converges precisely to the optimal solution under mild assumptions. Finally, numerical simulations validate the algorithm's effectiveness through a classical distributed estimation problem and the distributed training of a convolutional neural network."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18134","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-24T01:51:05Z","registered":"2025-09-24T01:51:06Z","published":null,"updated":"2025-09-24T01:51:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.14263","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14263","identifiers":[{"identifier":"2509.14263","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luan","familyName":"Vejsiu","name":"Vejsiu, Luan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianyu","familyName":"Zheng","name":"Zheng, Qianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxuan","familyName":"Chen","name":"Chen, Haoxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yizhou","familyName":"Han","name":"Han, Yizhou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Context-Enhanced Granular Edit Representation for Efficient and Accurate ASR Post-editing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T16:57:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T04:18:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite ASR technology being full-scale adopted by industry and for large portions of the population, ASR systems often have errors that require editors to post-edit text quality. While LLMs are powerful post-editing tools, baseline full rewrite models have inference inefficiencies because they often generate the same redundant text over and over again. Compact edit representations have existed but often lack the efficacy and context required for optimal accuracy. This paper introduces CEGER (Context-Enhanced Granular Edit Representation), a compact edit representation that was generated for highly accurate, efficient ASR post-editing. CEGER allows LLMs to generate a sequence of structured, fine-grained, contextually rich commands to modify the original ASR output. A separate expansion module deterministically reconstructs the corrected text based on the commands. Extensive experiments on the LibriSpeech dataset that were conducted, CEGER achieves state-of-the-art accuracy, achieving the lowest word error rate (WER) versus full rewrite and prior compact representations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.14263","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:27:56Z","registered":"2025-09-19T01:27:57Z","published":null,"updated":"2025-09-22T02:43:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12275","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12275","identifiers":[{"identifier":"2509.12275","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinghua","familyName":"Zhao","name":"Zhao, Jinghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Su","name":"Su, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lichun","familyName":"Fan","name":"Fan, Lichun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenbo","familyName":"Luo","name":"Luo, Zhenbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui","familyName":"Wang","name":"Wang, Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoqin","familyName":"Sun","name":"Sun, Haoqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Qin","name":"Qin, Yong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Omni-CLST: Error-aware Curriculum Learning with guided Selective chain-of-Thought for audio question answering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T06:54:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:01:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T03:05:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:18:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-18T07:19:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-19T00:25:12Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid progress of large audio-language models (LALMs), audio question answering (AQA) has emerged as a challenging task requiring both fine-grained audio understanding and complex reasoning. While current methods mainly rely on constructing new datasets via captioning or reasoning traces, existing high-quality AQA data remains underutilized. To address this, we propose Omni-CLST, an error-aware Curriculum Learning framework with guided Selective Chain-of-Thought. The framework efficiently leverages existing high-quality dataset through two key strategies: an error-aware curriculum that organizes samples by difficulty, and a guided thought dropout mechanism that focuses reasoning on challenging cases. Experiments show that Omni-CLST achieves 73.80% on MMAU-mini and a new state of the art of 64.30% on MMAR, demonstrating robust generalization in multimodal audio-language understanding."},{"descriptionType":"Other","description":"5 pages, 1 figure, 2 tables submitted to icassp, under prereview"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12275","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:36:43Z","registered":"2025-09-17T01:36:43Z","published":null,"updated":"2025-09-19T02:11:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.14265","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14265","identifiers":[{"identifier":"2509.14265","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siyuan","familyName":"Chen","name":"Chen, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhichao","familyName":"Lu","name":"Lu, Zhichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingfu","familyName":"Zhang","name":"Zhang, Qingfu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evolution of Kernels: Automated RISC-V Kernel Optimization with Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T08:11:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T00:00:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Automated kernel design is critical for overcoming software ecosystem barriers in emerging hardware platforms like RISC-V. While large language models (LLMs) have shown promise for automated kernel optimization, demonstrating success in CUDA domains with comprehensive technical documents and mature codebases, their effectiveness remains unproven for reference-scarce domains like RISC-V. We present Evolution of Kernels (EoK), a novel LLM-based evolutionary program search framework that automates kernel design for domains with limited reference material. EoK mitigates reference scarcity by mining and formalizing reusable optimization ideas (general design principles + actionable thoughts) from established kernel libraries' development histories; it then guides parallel LLM explorations using these ideas, enriched via Retrieval-Augmented Generation (RAG) with RISC-V-specific context, prioritizing historically effective techniques. Empirically, EoK achieves a median 1.27x speedup, surpassing human experts on all 80 evaluated kernel design tasks and improving upon prior LLM-based automated kernel design methods by 20%. These results underscore the viability of incorporating human experience into emerging domains and highlight the immense potential of LLM-based automated kernel optimization."},{"descriptionType":"Other","description":"Technical report"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.14265","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:27:59Z","registered":"2025-09-19T01:27:59Z","published":null,"updated":"2025-09-19T01:27:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10970","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10970","identifiers":[{"identifier":"2509.10970","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Joshua Au","familyName":"Yeung","name":"Yeung, Joshua Au","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacopo","familyName":"Dalmasso","name":"Dalmasso, Jacopo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Foschini","name":"Foschini, Luca","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Richard JB","familyName":"Dobson","name":"Dobson, Richard JB","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeljko","familyName":"Kraljevic","name":"Kraljevic, Zeljko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Psychogenic Machine: Simulating AI Psychosis, Delusion Reinforcement and Harm Enablement in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T20:10:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:26:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-17T01:44:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-18T00:15:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Background: Emerging reports of \"AI psychosis\" are on the rise, where user-LLM interactions may exacerbate or induce psychosis or adverse psychological symptoms. Whilst the sycophantic and agreeable nature of LLMs can be beneficial, it becomes a vector for harm by reinforcing delusional beliefs in vulnerable users.\n Methods: Psychosis-bench is a novel benchmark designed to systematically evaluate the psychogenicity of LLMs comprises 16 structured, 12-turn conversational scenarios simulating the progression of delusional themes(Erotic Delusions, Grandiose/Messianic Delusions, Referential Delusions) and potential harms. We evaluated eight prominent LLMs for Delusion Confirmation (DCS), Harm Enablement (HES), and Safety Intervention(SIS) across explicit and implicit conversational contexts.\n Findings: Across 1,536 simulated conversation turns, all LLMs demonstrated psychogenic potential, showing a strong tendency to perpetuate rather than challenge delusions (mean DCS of 0.91 $\\pm$0.88). Models frequently enabled harmful user requests (mean HES of 0.69 $\\pm$0.84) and offered safety interventions in only roughly a third of applicable turns (mean SIS of 0.37 $\\pm$0.48). 51 / 128 (39.8%) of scenarios had no safety interventions offered. Performance was significantly worse in implicit scenarios, models were more likely to confirm delusions and enable harm while offering fewer interventions (p \u0026lt; .001). A strong correlation was found between DCS and HES (rs = .77). Model performance varied widely, indicating that safety is not an emergent property of scale alone.\n Conclusion: This study establishes LLM psychogenicity as a quantifiable risk and underscores the urgent need for re-thinking how we train LLMs. We frame this issue not merely as a technical challenge but as a public health imperative requiring collaboration between developers, policymakers, and healthcare professionals."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10970","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:51:43Z","registered":"2025-09-16T02:51:44Z","published":null,"updated":"2025-09-18T17:43:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.13351","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.13351","identifiers":[{"identifier":"2509.13351","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pulkit","familyName":"Verma","name":"Verma, Pulkit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ngoc","familyName":"La","name":"La, Ngoc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anthony","familyName":"Favier","name":"Favier, Anthony","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Swaroop","familyName":"Mishra","name":"Mishra, Swaroop","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julie A.","familyName":"Shah","name":"Shah, Julie A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Teaching LLMs to Plan: Logical Chain-of-Thought Instruction Tuning for Symbolic Planning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T02:42:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-18T00:00:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have demonstrated impressive capabilities across diverse tasks, yet their ability to perform structured symbolic planning remains limited, particularly in domains requiring formal representations like the Planning Domain Definition Language (PDDL). In this paper, we present a novel instruction tuning framework, PDDL-Instruct, designed to enhance LLMs' symbolic planning capabilities through logical chain-of-thought reasoning. Our approach focuses on teaching models to rigorously reason about action applicability, state transitions, and plan validity using explicit logical inference steps. By developing instruction prompts that guide models through the precise logical reasoning required to determine when actions can be applied in a given state, we enable LLMs to self-correct their planning processes through structured reflection. The framework systematically builds verification skills by decomposing the planning process into explicit reasoning chains about precondition satisfaction, effect application, and invariant preservation. Experimental results on multiple planning domains show that our chain-of-thought reasoning based instruction-tuned models are significantly better at planning, achieving planning accuracy of up to 94% on standard benchmarks, representing a 66% absolute improvement over baseline models. This work bridges the gap between the general reasoning capabilities of LLMs and the logical precision required for automated planning, offering a promising direction for developing better AI planning systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.13351","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-18T17:33:23Z","registered":"2025-09-18T17:33:24Z","published":null,"updated":"2025-09-18T17:33:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11292","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11292","identifiers":[{"identifier":"2509.11292","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziling","familyName":"Liu","name":"Liu, Ziling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziwei","familyName":"Chen","name":"Chen, Ziwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingqi","familyName":"Gao","name":"Gao, Mingqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinyu","familyName":"Yang","name":"Yang, Jinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Zheng","name":"Zheng, Feng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Leveraging Geometric Priors for Unaligned Scene Change Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T14:31:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:45:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T06:25:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:26:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Unaligned Scene Change Detection aims to detect scene changes between image pairs captured at different times without assuming viewpoint alignment. To handle viewpoint variations, current methods rely solely on 2D visual cues to establish cross-image correspondence to assist change detection. However, large viewpoint changes can alter visual observations, causing appearance-based matching to drift or fail. Additionally, supervision limited to 2D change masks from small-scale SCD datasets restricts the learning of generalizable multi-view knowledge, making it difficult to reliably identify visual overlaps and handle occlusions. This lack of explicit geometric reasoning represents a critical yet overlooked limitation. In this work, we introduce geometric priors for the first time to address the core challenges of unaligned SCD, for reliable identification of visual overlaps, robust correspondence establishment, and explicit occlusion detection. Building on these priors, we propose a training-free framework that integrates them with the powerful representations of a visual foundation model to enable reliable change detection under viewpoint misalignment. Through extensive evaluation on the PSCD, ChangeSim, and PASLCD datasets, we demonstrate that our approach achieves superior and robust performance. Our code will be released at https://github.com/ZilingLiu/GeoSCD."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11292","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:59:14Z","registered":"2025-09-16T02:59:14Z","published":null,"updated":"2025-09-17T02:12:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11177","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11177","identifiers":[{"identifier":"2509.11177","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hang","familyName":"Guo","name":"Guo, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawei","familyName":"Li","name":"Li, Yawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luca","familyName":"Benini","name":"Benini, Luca","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimal Brain Restoration for Joint Quantization and Sparsification of LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T09:17:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:39:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T03:17:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:18:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Large Language Model (LLM) compression, such as quantization and pruning, have achieved notable success. However, as these techniques gradually approach their respective limits, relying on a single method for further compression has become increasingly challenging. In this work, we explore an alternative solution by combining quantization and sparsity. This joint approach, though promising, introduces new difficulties due to the inherently conflicting requirements on weight distributions: quantization favors compact ranges, while pruning benefits from high variance. To attack this problem, we propose Optimal Brain Restoration (OBR), a general and training-free framework that aligns pruning and quantization by error compensation between both. OBR minimizes performance degradation on downstream tasks by building on a second-order Hessian objective, which is then reformulated into a tractable problem through surrogate approximation and ultimately reaches a closed-form solution via group error compensation. Experiments show that OBR enables aggressive W4A4KV4 quantization with 50% sparsity on existing LLMs, and delivers up to 4.72x speedup and 6.4x memory reduction compared to the FP16-dense baseline."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11177","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:33Z","registered":"2025-09-16T02:56:34Z","published":null,"updated":"2025-09-17T02:12:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11067","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11067","identifiers":[{"identifier":"2509.11067","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liangxuan","familyName":"Guo","name":"Guo, Liangxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Zhu","name":"Zhu, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingqian","familyName":"Tao","name":"Tao, Qingqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kangning","familyName":"Liu","name":"Liu, Kangning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xun","familyName":"Zhao","name":"Zhao, Xun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianzhe","familyName":"Qin","name":"Qin, Xianzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jin","familyName":"Gao","name":"Gao, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangfu","familyName":"Hao","name":"Hao, Guangfu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agentic Lybic: Multi-Agent Execution System with Tiered Reasoning and Orchestration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T03:22:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T01:16:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-16T02:49:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-17T00:17:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Autonomous agents for desktop automation struggle with complex multi-step tasks due to poor coordination and inadequate quality control. We introduce Agentic Lybic, a novel multi-agent system where the entire architecture operates as a finite-state machine (FSM). This core innovation enables dynamic orchestration. Our system comprises four components: a Controller, a Manager, three Workers (Technician for code-based operations, Operator for GUI interactions, and Analyst for decision support), and an Evaluator. The critical mechanism is the FSM-based routing between these components, which provides flexibility and generalization by dynamically selecting the optimal execution strategy for each subtask. This principled orchestration, combined with robust quality gating, enables adaptive replanning and error recovery. Evaluated officially on the OSWorld benchmark, Agentic Lybic achieves a state-of-the-art 57.07% success rate in 50 steps, substantially outperforming existing methods. Results demonstrate that principled multi-agent orchestration with continuous quality control provides superior reliability for generalized desktop automation in complex computing environments."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11067","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:53:59Z","registered":"2025-09-16T02:54:00Z","published":null,"updated":"2025-09-17T02:12:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12278","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12278","identifiers":[{"identifier":"2509.12278","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wanru","familyName":"Zhuang","name":"Zhuang, Wanru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenbo","familyName":"Li","name":"Li, Wenbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhibin","familyName":"Lan","name":"Lan, Zhibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Han","name":"Han, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Li","name":"Li, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinsong","familyName":"Su","name":"Su, Jinsong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PATIMT-Bench: A Multi-Scenario Benchmark for Position-Aware Text Image Machine Translation in Large Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T08:33:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:01:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Text Image Machine Translation (TIMT) aims to translate texts embedded within an image into another language. Current TIMT studies primarily focus on providing translations for all the text within an image, while neglecting to provide bounding boxes and covering limited scenarios. In this work, we extend traditional TIMT into position-aware TIMT (PATIMT), aiming to support fine-grained and layoutpreserving translation, which holds great practical value but remains largely unexplored. This task comprises two key sub-tasks: regionspecific translation and full-image translation with grounding. To support existing models on PATIMT and conduct fair evaluation, we construct the PATIMT benchmark (PATIMTBench), which consists of 10 diverse real-world scenarios. Specifically, we introduce an Adaptive Image OCR Refinement Pipeline, which adaptively selects appropriate OCR tools based on scenario and refines the results of text-rich images. To ensure evaluation reliability, we further construct a test set, which contains 1,200 high-quality instances manually annotated and reviewed by human experts. After fine-tuning on our data, compact Large Vision-Language Models (LVLMs) achieve state-of-the-art performance on both sub-tasks. Experimental results also highlight the scalability and generalizability of our training data"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12278","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:36:47Z","registered":"2025-09-17T01:36:47Z","published":null,"updated":"2025-09-17T01:36:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.12273","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.12273","identifiers":[{"identifier":"2509.12273","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Liangqi","familyName":"Yuan","name":"Yuan, Liangqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong-Jun","familyName":"Han","name":"Han, Dong-Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christopher G.","familyName":"Brinton","name":"Brinton, Christopher G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sabine","familyName":"Brunswicker","name":"Brunswicker, Sabine","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLMAP: LLM-Assisted Multi-Objective Route Planning with User Preferences"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T02:30:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-17T00:01:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rise of large language models (LLMs) has made natural language-driven route planning an emerging research area that encompasses rich user objectives. Current research exhibits two distinct approaches: direct route planning using LLM-as-Agent and graph-based searching strategies. However, LLMs in the former approach struggle to handle extensive map data, while the latter shows limited capability in understanding natural language preferences. Additionally, a more critical challenge arises from the highly heterogeneous and unpredictable spatio-temporal distribution of users across the globe. In this paper, we introduce a novel LLM-Assisted route Planning (LLMAP) system that employs an LLM-as-Parser to comprehend natural language, identify tasks, and extract user preferences and recognize task dependencies, coupled with a Multi-Step Graph construction with iterative Search (MSGS) algorithm as the underlying solver for optimal route finding. Our multi-objective optimization approach adaptively tunes objective weights to maximize points of interest (POI) quality and task completion rate while minimizing route distance, subject to three key constraints: user time limits, POI opening hours, and task dependencies. We conduct extensive experiments using 1,000 routing prompts sampled with varying complexity across 14 countries and 27 cities worldwide. The results demonstrate that our approach achieves superior performance with guarantees across multiple constraints."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.12273","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-17T01:36:40Z","registered":"2025-09-17T01:36:41Z","published":null,"updated":"2025-09-17T01:36:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11367","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11367","identifiers":[{"identifier":"2509.11367","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chang-Hwan","familyName":"Lee","name":"Lee, Chang-Hwan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Shim","name":"Shim, Alexander","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Detecting Model Drifts in Non-Stationary Environment Using Edit Operation Measures"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T17:48:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:50:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) agents typically assume stationary environment dynamics. Yet in real-world applications such as healthcare, robotics, and finance, transition probabilities or reward functions may evolve, leading to model drift. This paper proposes a novel framework to detect such drifts by analyzing the distributional changes in sequences of agent behavior. Specifically, we introduce a suite of edit operation-based measures to quantify deviations between state-action trajectories generated under stationary and perturbed conditions. Our experiments demonstrate that these measures can effectively distinguish drifted from non-drifted scenarios, even under varying levels of noise, providing a practical tool for drift detection in non-stationary RL environments."},{"descriptionType":"Other","description":"28 pages, 3 figures, 17 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11367","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:01:02Z","registered":"2025-09-16T03:01:03Z","published":null,"updated":"2025-09-16T03:01:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11357","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11357","identifiers":[{"identifier":"2509.11357","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yahav","familyName":"Bechavod","name":"Bechavod, Yahav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiuyao","familyName":"Lu","name":"Lu, Jiuyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaron","familyName":"Roth","name":"Roth, Aaron","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Online Omniprediction with Long-Term Constraints"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Science and Game Theory (cs.GT)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T17:22:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:49:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce and study the problem of online omniprediction with long-term constraints. At each round, a forecaster is tasked with generating predictions for an underlying (adaptively, adversarially chosen) state that are broadcast to a collection of downstream agents, who must each choose an action. Each of the downstream agents has both a utility function mapping actions and state to utilities, and a vector-valued constraint function mapping actions and states to vector-valued costs. The utility and constraint functions can arbitrarily differ across downstream agents. Their goal is to choose actions that guarantee themselves no regret while simultaneously guaranteeing that they do not cumulatively violate the constraints across time. We show how to make a single set of predictions so that each of the downstream agents can guarantee this by acting as a simple function of the predictions, guaranteeing each of them $\\tilde{O}(\\sqrt{T})$ regret and $O(1)$ cumulative constraint violation. We also show how to extend our guarantees to arbitrary intersecting contextually defined \\emph{subsequences}, guaranteeing each agent both regret and constraint violation bounds not just marginally, but simultaneously on each subsequence, against a benchmark set of actions simultaneously tailored to each subsequence."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11357","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:49Z","registered":"2025-09-16T03:00:49Z","published":null,"updated":"2025-09-16T03:00:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11328","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11328","identifiers":[{"identifier":"2509.11328","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingyuan","familyName":"Meng","name":"Meng, Mingyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward Next-generation Medical Vision Backbones: Modeling Finer-grained Long-range Visual Dependency"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T16:14:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:48:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Medical Image Computing (MIC) is a broad research topic covering both pixel-wise (e.g., segmentation, registration) and image-wise (e.g., classification, regression) vision tasks. Effective analysis demands models that capture both global long-range context and local subtle visual characteristics, necessitating fine-grained long-range visual dependency modeling. Compared to Convolutional Neural Networks (CNNs) that are limited by intrinsic locality, transformers excel at long-range modeling; however, due to the high computational loads of self-attention, transformers typically cannot process high-resolution features (e.g., full-scale image features before downsampling or patch embedding) and thus face difficulties in modeling fine-grained dependency among subtle medical image details. Concurrently, Multi-layer Perceptron (MLP)-based visual models are recognized as computation/memory-efficient alternatives in modeling long-range visual dependency but have yet to be widely investigated in the MIC community. This doctoral research advances deep learning-based MIC by investigating effective long-range visual dependency modeling. It first presents innovative use of transformers for both pixel- and image-wise medical vision tasks. The focus then shifts to MLPs, pioneeringly developing MLP-based visual models to capture fine-grained long-range visual dependency in medical images. Extensive experiments confirm the critical role of long-range dependency modeling in MIC and reveal a key finding: MLPs provide feasibility in modeling finer-grained long-range dependency among higher-resolution medical features containing enriched anatomical/pathological details. This finding establishes MLPs as a superior paradigm over transformers/CNNs, consistently enhancing performance across various medical vision tasks and paving the way for next-generation medical vision backbones."},{"descriptionType":"Other","description":"Invited as Long Oral Presentation (Top 8) at MICCAI 2025 Doctoral Consortium"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11328","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T03:00:05Z","registered":"2025-09-16T03:00:06Z","published":null,"updated":"2025-09-16T03:00:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11287","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11287","identifiers":[{"identifier":"2509.11287","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yifan","familyName":"Lu","name":"Lu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Zhang","name":"Zhang, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunfeng","familyName":"Yuan","name":"Yuan, Chunfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Gao","name":"Gao, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Congxuan","familyName":"Zhang","name":"Zhang, Congxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojuan","familyName":"Qi","name":"Qi, Xiaojuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bing","familyName":"Li","name":"Li, Bing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiming","familyName":"Hu","name":"Hu, Weiming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mitigating Hallucinations in Large Vision-Language Models by Self-Injecting Hallucinations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T14:26:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:45:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Vision-Language Models (LVLMs) suffer from serious hallucination problems, where the model-generated responses are inconsistent with the visual inputs. Existing hallucination mitigation methods are mainly based on preference alignment and require external human annotations or auxiliary models for preference data collection, which increase costs and limit sustainable improvement. To tackle these challenges, we propose Autonomous Preference Alignment via Self-Injection (APASI), a novel and generalizable method that mitigates hallucinations without external dependencies. APASI leverages the target LVLM to self-inject hallucinations into a generated response, creating a pair of responses with varying preference levels. During the self-injection process, the dis-preferred response is generated based on three key observations of hallucinations, ensuring it simulates real hallucination patterns. This fidelity offers an accurate learning signal for hallucination mitigation. Moreover, APASI incorporates an iterative alignment training strategy combined with curriculum learning to periodically update the preference data with increasing challenge, enabling stable and continuous enhancement of the LVLM. Extensive experiments across six benchmarks show that APASI not only effectively mitigates hallucinations for three baseline models but also achieves comparable or even superior performance to alignment-based methods with external dependency, thereby demonstrating its effectiveness and generalization capability. The code is available at https://github.com/davidluciolu/APASI."},{"descriptionType":"Other","description":"emnlp 2025 accepted"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11287","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:59:07Z","registered":"2025-09-16T02:59:07Z","published":null,"updated":"2025-09-16T02:59:07Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11284","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11284","identifiers":[{"identifier":"2509.11284","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Achmad Ardani","familyName":"Prasha","name":"Prasha, Achmad Ardani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Clavino Ourizqi","familyName":"Rachmadi","name":"Rachmadi, Clavino Ourizqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhamad Fauzan Ibnu","familyName":"Syahlan","name":"Syahlan, Muhamad Fauzan Ibnu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naufal Rahfi","familyName":"Anugerah","name":"Anugerah, Naufal Rahfi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nanda Garin","familyName":"Raditya","name":"Raditya, Nanda Garin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Putri","familyName":"Amelia","name":"Amelia, Putri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sabrina Laila","familyName":"Mutiara","name":"Mutiara, Sabrina Laila","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hilman Syachr","familyName":"Ramadhan","name":"Ramadhan, Hilman Syachr","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PINGS: Physics-Informed Neural Network for Fast Generative Sampling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Physics (physics.comp-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T14:22:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:45:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce PINGS (Physics-Informed Neural Network for Fast Generative Sampling), a framework that amortizes diffusion sampling by training a physics-informed network to approximate reverse-time probability-flow dynamics, reducing sampling to a single forward pass (NFE = 1). As a proof of concept, we learn a direct map from a 3D standard normal to a non-Gaussian Gaussian Mixture Model (GMM). PINGS preserves the target's distributional structure (multi-bandwidth kernel $MMD^2 = 1.88 \\times 10^{-2}$ with small errors in mean, covariance, skewness, and excess kurtosis) and achieves constant-time generation: $10^4$ samples in $16.54 \\pm 0.56$ millisecond on an RTX 3090, versus 468-843 millisecond for DPM-Solver (10/20) and 960 millisecond for DDIM (50) under matched conditions. We also sanity-check the PINN/automatic-differentiation pipeline on a damped harmonic oscillator, obtaining MSEs down to $\\mathcal{O}(10^{-5})$. Compared to fast but iterative ODE solvers and direct-map families (Flow, Rectified-Flow, Consistency), PINGS frames generative sampling as a PINN-style residual problem with endpoint anchoring, yielding a white-box, differentiable map with NFE = 1. These proof-of-concept results position PINGS as a promising route to fast, function-based generative sampling with potential extensions to scientific simulation (e.g., fast calorimetry)."},{"descriptionType":"Other","description":"19 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11284","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:59:03Z","registered":"2025-09-16T02:59:03Z","published":null,"updated":"2025-09-16T02:59:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11254","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11254","identifiers":[{"identifier":"2509.11254","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shengping","familyName":"Xie","name":"Xie, Shengping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuyan","familyName":"Chen","name":"Chen, Chuyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Yuan","name":"Yuan, Kun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From PowerSGD to PowerSGD+: Low-Rank Gradient Compression for Distributed Optimization with Convergence Guarantees"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Optimization and Control (math.OC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T12:54:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:43:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Low-rank gradient compression methods, such as PowerSGD, have gained attention in communication-efficient distributed optimization. However, the convergence guarantees of PowerSGD remain unclear, particularly in stochastic settings. In this paper, we show that PowerSGD does not always converge to the optimal solution and provide a clear counterexample to support this finding. To address this, we introduce PowerSGD+, which periodically updates the projection subspace via singular value decomposition, ensuring that it remains aligned with the optimal subspace. We prove that PowerSGD+ converges under standard assumptions and validate its effectiveness through empirical evaluation on large language model tasks."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11254","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:58:21Z","registered":"2025-09-16T02:58:21Z","published":null,"updated":"2025-09-16T02:58:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11233","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11233","identifiers":[{"identifier":"2509.11233","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Emil","familyName":"Malmsten","name":"Malmsten, Emil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wendelin","familyName":"Böhmer","name":"Böhmer, Wendelin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TransZero: Parallel Tree Expansion in MuZero using Transformer Networks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T12:20:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:43:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present TransZero, a model-based reinforcement learning algorithm that removes the sequential bottleneck in Monte Carlo Tree Search (MCTS). Unlike MuZero, which constructs its search tree step by step using a recurrent dynamics model, TransZero employs a transformer-based network to generate multiple latent future states simultaneously. Combined with the Mean-Variance Constrained (MVC) evaluator that eliminates dependence on inherently sequential visitation counts, our approach enables the parallel expansion of entire subtrees during planning. Experiments in MiniGrid and LunarLander show that TransZero achieves up to an eleven-fold speedup in wall-clock time compared to MuZero while maintaining sample efficiency. These results demonstrate that parallel tree construction can substantially accelerate model-based reinforcement learning, bringing real-time decision-making in complex environments closer to practice. The code is publicly available on GitHub."},{"descriptionType":"Other","description":"Submitted to BNAIC/BeNeLearn 2025. 15 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11233","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:57:50Z","registered":"2025-09-16T02:57:51Z","published":null,"updated":"2025-09-16T02:57:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11213","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11213","identifiers":[{"identifier":"2509.11213","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yufei","familyName":"Tang","name":"Tang, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daiheng","familyName":"Gao","name":"Gao, Daiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pingyu","familyName":"Wu","name":"Wu, Pingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenbo","familyName":"Zhou","name":"Zhou, Wenbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bang","familyName":"Zhang","name":"Zhang, Bang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiming","familyName":"Zhang","name":"Zhang, Weiming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Beyond Sliders: Mastering the Art of Diffusion-based Image Manipulation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T10:48:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:41:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In the realm of image generation, the quest for realism and customization has never been more pressing. While existing methods like concept sliders have made strides, they often falter when it comes to no-AIGC images, particularly images captured in real world settings. To bridge this gap, we introduce Beyond Sliders, an innovative framework that integrates GANs and diffusion models to facilitate sophisticated image manipulation across diverse image categories. Improved upon concept sliders, our method refines the image through fine grained guidance both textual and visual in an adversarial manner, leading to a marked enhancement in image quality and realism. Extensive experimental validation confirms the robustness and versatility of Beyond Sliders across a spectrum of applications."},{"descriptionType":"Other","description":"6 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11213","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:57:23Z","registered":"2025-09-16T02:57:23Z","published":null,"updated":"2025-09-16T02:57:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11197","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11197","identifiers":[{"identifier":"2509.11197","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunheng","familyName":"Wang","name":"Wang, Yunheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuetong","familyName":"Fang","name":"Fang, Yuetong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taowen","familyName":"Wang","name":"Wang, Taowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixiao","familyName":"Feng","name":"Feng, Yixiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yawen","familyName":"Tan","name":"Tan, Yawen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuning","familyName":"Zhang","name":"Zhang, Shuning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peiran","familyName":"Liu","name":"Liu, Peiran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiding","familyName":"Ji","name":"Ji, Yiding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renjing","familyName":"Xu","name":"Xu, Renjing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DreamNav: A Trajectory-Based Imaginative Framework for Zero-Shot Vision-and-Language Navigation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T09:54:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:40:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-and-Language Navigation in Continuous Environments (VLN-CE), which links language instructions to perception and control in the real world, is a core capability of embodied robots. Recently, large-scale pretrained foundation models have been leveraged as shared priors for perception, reasoning, and action, enabling zero-shot VLN without task-specific training. However, existing zero-shot VLN methods depend on costly perception and passive scene understanding, collapsing control to point-level choices. As a result, they are expensive to deploy, misaligned in action semantics, and short-sighted in planning. To address these issues, we present DreamNav that focuses on the following three aspects: (1) for reducing sensory cost, our EgoView Corrector aligns viewpoints and stabilizes egocentric perception; (2) instead of point-level actions, our Trajectory Predictor favors global trajectory-level planning to better align with instruction semantics; and (3) to enable anticipatory and long-horizon planning, we propose an Imagination Predictor to endow the agent with proactive thinking capability. On VLN-CE and real-world tests, DreamNav sets a new zero-shot state-of-the-art (SOTA), outperforming the strongest egocentric baseline with extra information by up to 7.49\\% and 18.15\\% in terms of SR and SPL metrics. To our knowledge, this is the first zero-shot VLN method to unify trajectory-level planning and active imagination while using only egocentric inputs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11197","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:57:01Z","registered":"2025-09-16T02:57:01Z","published":null,"updated":"2025-09-16T02:57:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11191","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11191","identifiers":[{"identifier":"2509.11191","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jian","familyName":"Chen","name":"Chen, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyi","familyName":"Lv","name":"Lv, Shengyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leilei","familyName":"Su","name":"Su, Leilei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RanAT4BIE: Random Adversarial Training for Biomedical Information Extraction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T09:40:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:40:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce random adversarial training (RAT), a novel framework successfully applied to biomedical information extraction (BioIE) tasks. Building on PubMedBERT as the foundational architecture, our study first validates the effectiveness of conventional adversarial training in enhancing pre-trained language models' performance on BioIE tasks. While adversarial training yields significant improvements across various performance metrics, it also introduces considerable computational overhead. To address this limitation, we propose RAT as an efficiency solution for biomedical information extraction. This framework strategically integrates random sampling mechanisms with adversarial training principles, achieving dual objectives: enhanced model generalization and robustness while significantly reducing computational costs. Through comprehensive evaluations, RAT demonstrates superior performance compared to baseline models in BioIE tasks. The results highlight RAT's potential as a transformative framework for biomedical natural language processing, offering a balanced solution to the model performance and computational efficiency."},{"descriptionType":"Other","description":"Accepted for publication at the International Joint Conference on Neural Networks (IJCNN) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11191","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:52Z","registered":"2025-09-16T02:56:53Z","published":null,"updated":"2025-09-16T02:56:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11176","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11176","identifiers":[{"identifier":"2509.11176","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Erion","familyName":"Çano","name":"Çano, Erion","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ivan","familyName":"Habernal","name":"Habernal, Ivan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Differentially-private text generation degrades output language quality"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T09:16:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:39:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Ensuring user privacy by synthesizing data from large language models (LLMs) tuned under differential privacy (DP) has become popular recently. However, the impact of DP fine-tuned LLMs on the quality of the language and the utility of the texts they produce has not been investigated. In this work, we tune five LLMs with three corpora under four levels of privacy and assess the length, the grammatical correctness, and the lexical diversity of the text outputs they produce. We also probe the utility of the synthetic outputs in downstream classification tasks such as book genre recognition based on book descriptions and cause of death recognition based on verbal autopsies. The results indicate that LLMs tuned under stronger privacy constrains produce texts that are shorter by at least 77 %, that are less grammatically correct by at least 9 %, and are less diverse by at least 10 % in bi-gram diversity. Furthermore, the accuracy they reach in downstream classification tasks decreases, which might be detrimental to the usefulness of the generated synthetic data."},{"descriptionType":"Other","description":"20 pages, 3 figures, 35 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11176","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:32Z","registered":"2025-09-16T02:56:32Z","published":null,"updated":"2025-09-16T02:56:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11167","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11167","identifiers":[{"identifier":"2509.11167","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pouria","familyName":"Mahdavinia","name":"Mahdavinia, Pouria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hamed","familyName":"Mahdavi","name":"Mahdavi, Hamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niloofar","familyName":"Mireshghallah","name":"Mireshghallah, Niloofar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehrdad","familyName":"Mahdavi","name":"Mahdavi, Mehrdad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Harnessing Optimization Dynamics for Curvature-Informed Model Merging"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T08:59:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:39:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Model merging is an effective post-training strategy for composing capabilities in large language models without joint retraining. We study this in the supervised fine-tuning (SFT) stage, where multiple capability-based SFT checkpoints -- spanning math, code, precise instruction following, general instruction following, and knowledge recall -- must be consolidated into a single model. We introduce Optimization Trajectory Aware (OTA) Merging, a curvature-aware aggregation that leverages optimizer second-moment statistics as a diagonal curvature proxy to reweight parameter edits and mitigate interference. Complementing OTA, we propose Fast Fisher Grafting (FFG), a curvature-driven task-localization step that sparsifies conflicting or low-importance edits. FFG induces extremely low-rank masks concentrated in early attention query/key projections and token embeddings, exploiting shared curvature across capabilities. We further develop a memory-light compression of the second moments that preserves OTA's effect. Across diverse capability-based SFT checkpoints, OTA+FFG improves merged-model quality over strong weight-space baselines, reduces negative transfer, and remains robust across sparsity levels. Analyses reveal substantial curvature overlap between checkpoints, offering a novel lens on why simple linear merging can be effective in practice. Ablations confirm that FFG is critical for reducing task interference and that the compressed second moments retain the gains of the full formulation. To facilitate reproducibility, we open-source all code, training and evaluation scripts, visualization artifacts, and capability-specific SFT checkpoints at https://github.com/pmahdavi/ota-merge."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11167","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:20Z","registered":"2025-09-16T02:56:20Z","published":null,"updated":"2025-09-16T02:56:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11155","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11155","identifiers":[{"identifier":"2509.11155","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Santhosh G","familyName":"S","name":"S, Santhosh G","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saurav","familyName":"Prakash","name":"Prakash, Saurav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Balaraman","familyName":"Ravindran","name":"Ravindran, Balaraman","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AQUA: Attention via QUery mAgnitudes for Memory and Compute Efficient Inference in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T08:20:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:38:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The quadratic complexity of the attention mechanism remains a fundamental barrier to scaling Large Language Models (LLMs) to longer contexts, creating a critical bottleneck in both computation and memory. To address this, we introduce AQUA (Attention via QUery mAgnitudes) a novel and versatile approximation strategy that significantly reduces the cost of attention with a graceful performance trade-off. Our method operates in two phases: an efficient offline step where we compute a universal, language agnostic projection matrix via SVD on a calibration dataset, and an online inference step where we project query and key vectors and dynamically select a sparse subset of dimensions based on the query's magnitude. We provide a formal theoretical analysis of AQUA, establishing the break-even point at which it becomes more computationally efficient than standard attention. Our empirical evaluations on state-of-the-art models like Llama-3.1-8B demonstrate that a 25% reduction in the attention dot-product computation can be achieved with a statistically insignificant impact on performance across a wide range of benchmarks. We further showcase the versatility of AQUA by demonstrating its ability to synergistically accelerate existing token eviction methods like H2O and to directly reduce KV-cache memory size. By offering a controllable knob to balance efficiency and accuracy, AQUA provides a practical and powerful tool for making large-scale LLM inference more accessible and sustainable."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11155","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:56:02Z","registered":"2025-09-16T02:56:03Z","published":null,"updated":"2025-09-16T02:56:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11141","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11141","identifiers":[{"identifier":"2509.11141","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shiyao","familyName":"Cui","name":"Cui, Shiyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xijia","familyName":"Feng","name":"Feng, Xijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingkang","familyName":"Wang","name":"Wang, Yingkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junxiao","familyName":"Yang","name":"Yang, Junxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhexin","familyName":"Zhang","name":"Zhang, Zhexin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Biplab","familyName":"Sikdar","name":"Sikdar, Biplab","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongning","familyName":"Wang","name":"Wang, Hongning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Han","familyName":"Qiu","name":"Qiu, Han","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minlie","familyName":"Huang","name":"Huang, Minlie","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Smiley Turns Hostile: Interpreting How Emojis Trigger LLMs' Toxicity"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T07:21:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:36:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Emojis are globally used non-verbal cues in digital communication, and extensive research has examined how large language models (LLMs) understand and utilize emojis across contexts. While usually associated with friendliness or playfulness, it is observed that emojis may trigger toxic content generation in LLMs. Motivated by such a observation, we aim to investigate: (1) whether emojis can clearly enhance the toxicity generation in LLMs and (2) how to interpret this phenomenon. We begin with a comprehensive exploration of emoji-triggered LLM toxicity generation by automating the construction of prompts with emojis to subtly express toxic intent. Experiments across 5 mainstream languages on 7 famous LLMs along with jailbreak tasks demonstrate that prompts with emojis could easily induce toxicity generation. To understand this phenomenon, we conduct model-level interpretations spanning semantic cognition, sequence generation and tokenization, suggesting that emojis can act as a heterogeneous semantic channel to bypass the safety mechanisms. To pursue deeper insights, we further probe the pre-training corpus and uncover potential correlation between the emoji-related data polution with the toxicity generation behaviors. Supplementary materials provide our implementation code and data. (Warning: This paper contains potentially sensitive contents)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11141","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:55:42Z","registered":"2025-09-16T02:55:43Z","published":null,"updated":"2025-09-16T02:55:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11134","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11134","identifiers":[{"identifier":"2509.11134","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaang","familyName":"Duan","name":"Duan, Jiaang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenglin","familyName":"Xu","name":"Xu, Shenglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiyou","familyName":"Qian","name":"Qian, Shiyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingyu","familyName":"Yang","name":"Yang, Dingyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kangjin","familyName":"Wang","name":"Wang, Kangjin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenzhi","familyName":"Liao","name":"Liao, Chenzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yinghao","familyName":"Yu","name":"Yu, Yinghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qin","familyName":"Hua","name":"Hua, Qin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanwen","familyName":"Hu","name":"Hu, Hanwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Wang","name":"Wang, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenchao","familyName":"Wu","name":"Wu, Wenchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongqing","familyName":"Bao","name":"Bao, Dongqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Lu","name":"Lu, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Cao","name":"Cao, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangtao","familyName":"Xue","name":"Xue, Guangtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guodong","familyName":"Yang","name":"Yang, Guodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liping","familyName":"Zhang","name":"Zhang, Liping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gang","familyName":"Chen","name":"Chen, Gang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GFS: A Preemption-aware Scheduling Framework for GPU Clusters with Predictive Spot Instance Management"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T07:05:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:36:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The surge in large language models (LLMs) has fundamentally reshaped the landscape of GPU usage patterns, creating an urgent need for more efficient management strategies. While cloud providers employ spot instances to reduce costs for low-priority (LP) tasks, existing schedulers still grapple with high eviction rates and lengthy queuing times. To address these limitations, we present GFS, a novel preemptive scheduling framework that enhances service-level objective (SLO) compliance for high-priority (HP) tasks while minimizing preemptions to LP tasks. Firstly, GFS utilizes a lightweight forecasting model that predicts GPU demand among different tenants, enabling proactive resource management. Secondly, GFS employs a dynamic allocation mechanism to adjust the spot quota for LP tasks with guaranteed durations. Lastly, GFS incorporates a preemptive scheduling policy that prioritizes HP tasks while minimizing the impact on LP tasks. We demonstrate the effectiveness of GFS through both real-world implementation and simulations. The results show that GFS reduces eviction rates by 33.0\\%, and cuts queuing delays by 44.1\\% for LP tasks. Furthermore, GFS enhances the GPU allocation rate by up to 22.8\\% in real production clusters. In a production cluster of more than 10,000 GPUs, GFS yields roughly \\$459,715 in monthly benefits."},{"descriptionType":"Other","description":"This paper has been accepted to the 31st ACM International Conference on Architectural Support for Programming Languages and Operating Systems (ASPLOS 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11134","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:55:32Z","registered":"2025-09-16T02:55:33Z","published":null,"updated":"2025-09-16T02:55:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11127","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11127","identifiers":[{"identifier":"2509.11127","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hongxu","familyName":"Zhou","name":"Zhou, Hongxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hylke","familyName":"Westerdijk","name":"Westerdijk, Hylke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Khondoker Ittehadul","familyName":"Islam","name":"Islam, Khondoker Ittehadul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Joint Effects of Argumentation Theory, Audio Modality and Data Enrichment on LLM-Based Fallacy Classification"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T06:35:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:35:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study investigates how context and emotional tone metadata influence large language model (LLM) reasoning and performance in fallacy classification tasks, particularly within political debate settings. Using data from U.S. presidential debates, we classify six fallacy types through various prompting strategies applied to the Qwen-3 (8B) model. We introduce two theoretically grounded Chain-of-Thought frameworks: Pragma-Dialectics and the Periodic Table of Arguments, and evaluate their effectiveness against a baseline prompt under three input settings: text-only, text with context, and text with both context and audio-based emotional tone metadata. Results suggest that while theoretical prompting can improve interpretability and, in some cases, accuracy, the addition of context and especially emotional tone metadata often leads to lowered performance. Emotional tone metadata biases the model toward labeling statements as \\textit{Appeal to Emotion}, worsening logical reasoning. Overall, basic prompts often outperformed enhanced ones, suggesting that attention dilution from added inputs may worsen rather than improve fallacy classification in LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11127","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:55:22Z","registered":"2025-09-16T02:55:23Z","published":null,"updated":"2025-09-16T02:55:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11106","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11106","identifiers":[{"identifier":"2509.11106","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Valentin","familyName":"Hofmann","name":"Hofmann, Valentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Heineman","name":"Heineman, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Magnusson","name":"Magnusson, Ian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyle","familyName":"Lo","name":"Lo, Kyle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jesse","familyName":"Dodge","name":"Dodge, Jesse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maarten","familyName":"Sap","name":"Sap, Maarten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pang Wei","familyName":"Koh","name":"Koh, Pang Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun","familyName":"Wang","name":"Wang, Chun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hannaneh","familyName":"Hajishirzi","name":"Hajishirzi, Hannaneh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Noah A.","familyName":"Smith","name":"Smith, Noah A.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fluid Language Model Benchmarking"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T05:49:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:34:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Language model (LM) benchmarking faces several challenges: comprehensive evaluations are costly, benchmarks often fail to measure the intended capabilities, and evaluation quality can degrade due to labeling errors and benchmark saturation. Although various strategies have been proposed to mitigate these issues, they tend to address individual aspects in isolation, neglecting broader questions about overall evaluation quality. Here, we introduce Fluid Benchmarking, a new evaluation approach that advances LM benchmarking across multiple dimensions. Inspired by psychometrics, Fluid Benchmarking is based on the insight that the relative value of benchmark items depends on an LM's capability level, suggesting that evaluation should adapt to each LM. Methodologically, Fluid Benchmarking estimates an item response model based on existing LM evaluation results and uses the inferred quantities to select evaluation items dynamically, similar to computerized adaptive testing in education. In our experiments, we compare Fluid Benchmarking against the common practice of random item sampling as well as more sophisticated baselines, including alternative methods grounded in item response theory. We examine four dimensions -- efficiency, validity, variance, and saturation -- and find that Fluid Benchmarking achieves superior performance in all of them (e.g., higher validity and less variance on MMLU with fifty times fewer items). Our analysis shows that the two components of Fluid Benchmarking have distinct effects: item response theory, used to map performance into a latent ability space, increases validity, while dynamic item selection reduces variance. Overall, our results suggest that LM benchmarking can be substantially improved by moving beyond static evaluation."},{"descriptionType":"Other","description":"COLM 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11106","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":3,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:53Z","registered":"2025-09-16T02:54:53Z","published":null,"updated":"2025-09-16T02:54:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11092","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11092","identifiers":[{"identifier":"2509.11092","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zeyu","familyName":"Dong","name":"Dong, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Yin","name":"Yin, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Li","name":"Li, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Li","name":"Li, Eric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao-Xiang","familyName":"Guo","name":"Guo, Hao-Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yikai","familyName":"Wang","name":"Wang, Yikai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PanoLora: Bridging Perspective and Panoramic Video Generation with LoRA Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T05:05:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:34:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generating high-quality 360° panoramic videos remains a significant challenge due to the fundamental differences between panoramic and traditional perspective-view projections. While perspective videos rely on a single viewpoint with a limited field of view, panoramic content requires rendering the full surrounding environment, making it difficult for standard video generation models to adapt. Existing solutions often introduce complex architectures or large-scale training, leading to inefficiency and suboptimal results. Motivated by the success of Low-Rank Adaptation (LoRA) in style transfer tasks, we propose treating panoramic video generation as an adaptation problem from perspective views. Through theoretical analysis, we demonstrate that LoRA can effectively model the transformation between these projections when its rank exceeds the degrees of freedom in the task. Our approach efficiently fine-tunes a pretrained video diffusion model using only approximately 1,000 videos while achieving high-quality panoramic generation. Experimental results demonstrate that our method maintains proper projection geometry and surpasses previous state-of-the-art approaches in visual quality, left-right consistency, and motion diversity."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11092","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:34Z","registered":"2025-09-16T02:54:35Z","published":null,"updated":"2025-09-16T02:54:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11084","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11084","identifiers":[{"identifier":"2509.11084","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyeongju","familyName":"Kim","name":"Kim, Hyeongju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juheon","familyName":"Lee","name":"Lee, Juheon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinhyeok","familyName":"Yang","name":"Yang, Jinhyeok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacob","familyName":"Morton","name":"Morton, Jacob","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Length-Aware Rotary Position Embedding for Text-Speech Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T04:25:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:33:54Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Many recent text-to-speech (TTS) systems are built on transformer architectures and employ cross-attention mechanisms for text-speech alignment. Within these systems, rotary position embedding (RoPE) is commonly used to encode positional information in text and speech representations. In this work, we introduce length-aware RoPE (LARoPE), a simple yet effective extension of RoPE that improves text-speech alignment. Unlike RoPE, which relies on absolute indices, LARoPE computes relative distances between query and key positions using length-normalized indices. Experimental results show that LARoPE consistently outperforms RoPE, offering faster loss convergence, more accurate text-speech alignment, and higher overall TTS quality. Furthermore, LARoPE demonstrates greater resilience to variations in utterance duration and maintains stable performance in extended speech generation up to 30 seconds, whereas RoPE suffers from notable degradation. Notably, our method achieves a state-of-the-art word error rate on a standard zero-shot TTS benchmark."},{"descriptionType":"Other","description":"5 pages, 3 figures, preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11084","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:23Z","registered":"2025-09-16T02:54:24Z","published":null,"updated":"2025-09-16T02:54:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11068","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11068","identifiers":[{"identifier":"2509.11068","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zan-Kai","familyName":"Chong","name":"Chong, Zan-Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hiroyuki","familyName":"Ohsaki","name":"Ohsaki, Hiroyuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryan","familyName":"Ng","name":"Ng, Bryan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tractable Asymmetric Verification for Large Language Models via Deterministic Replicability"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T03:30:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:32:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The landscape of Large Language Models (LLMs) shifts rapidly towards dynamic, multi-agent systems. This introduces a fundamental challenge in establishing computational trust, specifically how one agent can verify that another's output was genuinely produced by a claimed LLM, and not falsified or generated by a cheaper or inferior model. To address this challenge, this paper proposes a verification framework that achieves tractable asymmetric effort, where the cost to verify a computation is substantially lower than the cost to perform it. Our approach is built upon the principle of deterministic replicability, a property inherent to autoregressive models that strictly necessitates a computationally homogeneous environment where all agents operate on identical hardware and software stacks. Within this defined context, our framework enables multiple validators to probabilistically audit small, random segments of an LLM's output and it distributes the verification workload effectively. The simulations demonstrated that targeted verification can be over 12 times faster than full regeneration, with tunable parameters to adjust the detection probability. By establishing a tractable mechanism for auditable LLM systems, our work offers a foundational layer for responsible AI and serves as a cornerstone for future research into the more complex, heterogeneous multi-agent systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11068","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:54:00Z","registered":"2025-09-16T02:54:01Z","published":null,"updated":"2025-09-16T02:54:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11065","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11065","identifiers":[{"identifier":"2509.11065","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuan","familyName":"Si","name":"Si, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daming","familyName":"Li","name":"Li, Daming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanyuan","familyName":"Shi","name":"Shi, Hanyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialu","familyName":"Zhang","name":"Zhang, Jialu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ViScratch: Using Large Language Models and Gameplay Videos for Automated Feedback in Scratch"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T03:12:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:32:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Block-based programming environments such as Scratch are increasingly popular in programming education, in particular for young learners. While the use of blocks helps prevent syntax errors, semantic bugs remain common and difficult to debug. Existing tools for Scratch debugging rely heavily on predefined rules or user manual inputs, and crucially, they ignore the platform's inherently visual nature.\n We introduce ViScratch, the first multimodal feedback generation system for Scratch that leverages both the project's block code and its generated gameplay video to diagnose and repair bugs. ViScratch uses a two-stage pipeline: a vision-language model first aligns visual symptoms with code structure to identify a single critical issue, then proposes minimal, abstract syntax tree level repairs that are verified via execution in the Scratch virtual machine.\n We evaluate ViScratch on a set of real-world Scratch projects against state-of-the-art LLM-based tools and human testers. Results show that gameplay video is a crucial debugging signal: ViScratch substantially outperforms prior tools in both bug identification and repair quality, even without access to project descriptions or goals. This work demonstrates that video can serve as a first-class specification in visual programming environments, opening new directions for LLM-based debugging beyond symbolic code alone."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11065","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:53:56Z","registered":"2025-09-16T02:53:57Z","published":null,"updated":"2025-09-16T02:53:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11035","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11035","identifiers":[{"identifier":"2509.11035","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Cui","name":"Cui, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Fu","name":"Fu, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haibin","familyName":"Zhang","name":"Zhang, Haibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Licheng","familyName":"Wang","name":"Wang, Licheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cong","familyName":"Zuo","name":"Zuo, Cong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Free-MAD: Consensus-Free Multi-Agent Debate"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T01:55:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:31:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-agent debate (MAD) is an emerging approach to improving the reasoning capabilities of large language models (LLMs). Existing MAD methods rely on multiple rounds of interaction among agents to reach consensus, and the final output is selected by majority voting in the last round. However, this consensus-based design faces several limitations. First, multiple rounds of communication increases token overhead and limits scalability. Second, due to the inherent conformity of LLMs, agents that initially produce correct responses may be influenced by incorrect ones during the debate process, causing error propagation. Third, majority voting introduces randomness and unfairness in the decision-making phase, and can degrade the reasoning performance.\n To address these issues, we propose \\textsc{Free-MAD}, a novel MAD framework that eliminates the need for consensus among agents. \\textsc{Free-MAD} introduces a novel score-based decision mechanism that evaluates the entire debate trajectory rather than relying on the last round only. This mechanism tracks how each agent's reasoning evolves, enabling more accurate and fair outcomes. In addition, \\textsc{Free-MAD} reconstructs the debate phase by introducing anti-conformity, a mechanism that enables agents to mitigate excessive influence from the majority. Experiments on eight benchmark datasets demonstrate that \\textsc{Free-MAD} significantly improves reasoning performance while requiring only a single-round debate and thus reducing token costs. We also show that compared to existing MAD approaches, \\textsc{Free-MAD} exhibits improved robustness in real-world attack scenarios."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11035","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:53:15Z","registered":"2025-09-16T02:53:15Z","published":null,"updated":"2025-09-16T02:53:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.11026","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.11026","identifiers":[{"identifier":"2509.11026","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziang","familyName":"Li","name":"Li, Ziang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manasi","familyName":"Ganti","name":"Ganti, Manasi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixian","familyName":"Ma","name":"Ma, Zixian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Helena","familyName":"Vasconcelos","name":"Vasconcelos, Helena","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qijia","familyName":"He","name":"He, Qijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ranjay","familyName":"Krishna","name":"Krishna, Ranjay","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rethinking Human Preference Evaluation of LLM Rationales"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-14T01:33:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:30:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) often generate natural language rationales -- free-form explanations that help improve performance on complex reasoning tasks and enhance interpretability for human users. However, evaluating these rationales remains challenging. While recent work has relied on binary preference judgments from humans or LLM judges, such evaluations are often opaque and coarse-grained, offering limited insight into what makes one rationale better than another. In this work, we rethink preference evaluation for LLM-generated rationales by asking: (1) What attributes define good rationales? (2) Can human preferences be explained by these attributes? (3) Can attribute-based evaluation overcome the limitations of binary comparisons? We identify a set of key rationale attributes from prior literature and assess them using automatic metrics, LLM judgments, and human annotations. We then analyze two standard human preference datasets MT Bench and Chatbot Arena using SHAP to identify which attributes best explain human preference outcomes. Finally, we re-evaluate model-generated rationales using attribute-specific ELO scores, revealing more nuanced model comparisons and insights. Our findings suggest that fine-grained attribute evaluations can better characterize rationale quality and guide future research toward more interpretable and reliable evaluation practices."},{"descriptionType":"Other","description":"Published in the XLLM-Reason-Plan Workshop on the Application of LLM Explainability to Reasoning and Planning at COLM 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.11026","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:53:02Z","registered":"2025-09-16T02:53:03Z","published":null,"updated":"2025-09-16T02:53:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10963","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10963","identifiers":[{"identifier":"2509.10963","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aranyak","familyName":"Acharyya","name":"Acharyya, Aranyak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carey E.","familyName":"Priebe","name":"Priebe, Carey E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hayden S.","familyName":"Helm","name":"Helm, Hayden S.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Testing for LLM response differences: the case of a composite null consisting of semantically irrelevant query perturbations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Statistics Theory (math.ST)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Methodology (stat.ME)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T19:44:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:26:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Given an input query, generative models such as large language models produce a random response drawn from a response distribution. Given two input queries, it is natural to ask if their response distributions are the same. While traditional statistical hypothesis testing is designed to address this question, the response distribution induced by an input query is often sensitive to semantically irrelevant perturbations to the query, so much so that a traditional test of equality might indicate that two semantically equivalent queries induce statistically different response distributions. As a result, the outcome of the statistical test may not align with the user's requirements. In this paper, we address this misalignment by incorporating into the testing procedure consideration of a collection of semantically similar queries. In our setting, the mapping from the collection of user-defined semantically similar queries to the corresponding collection of response distributions is not known a priori and must be estimated, with a fixed budget. Although the problem we address is quite general, we focus our analysis on the setting where the responses are binary, show that the proposed test is asymptotically valid and consistent, and discuss important practical considerations with respect to power and computation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10963","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:51:34Z","registered":"2025-09-16T02:51:35Z","published":null,"updated":"2025-09-16T02:51:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10946","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10946","identifiers":[{"identifier":"2509.10946","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Roberto","familyName":"Morabito","name":"Morabito, Roberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanghan","familyName":"Wu","name":"Wu, Guanghan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When the Code Autopilot Breaks: Why LLMs Falter in Embedded Machine Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T19:00:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:25:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly used to automate software generation in embedded machine learning workflows, yet their outputs often fail silently or behave unpredictably. This article presents an empirical investigation of failure modes in LLM-powered ML pipelines, based on an autopilot framework that orchestrates data preprocessing, model conversion, and on-device inference code generation. We show how prompt format, model behavior, and structural assumptions influence both success rates and failure characteristics, often in ways that standard validation pipelines fail to detect. Our analysis reveals a diverse set of error-prone behaviors, including format-induced misinterpretations and runtime-disruptive code that compiles but breaks downstream. We derive a taxonomy of failure categories and analyze errors across multiple LLMs, highlighting common root causes and systemic fragilities. Though grounded in specific devices, our study reveals broader challenges in LLM-based code generation. We conclude by discussing directions for improving reliability and traceability in LLM-powered embedded ML systems."},{"descriptionType":"Other","description":"This paper has been accepted for publication in Computer (IEEE). Upon publication, the copyright will be transferred to IEEE"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10946","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:51:10Z","registered":"2025-09-16T02:51:10Z","published":null,"updated":"2025-09-16T02:51:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10932","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10932","identifiers":[{"identifier":"2509.10932","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seongho","familyName":"Joo","name":"Joo, Seongho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyukhun","familyName":"Koh","name":"Koh, Hyukhun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyomin","familyName":"Jung","name":"Jung, Kyomin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Public Data Assisted Differentially Private In-Context Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T18:11:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:24:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In-context learning (ICL) in Large Language Models (LLMs) has shown remarkable performance across various tasks without requiring fine-tuning. However, recent studies have highlighted the risk of private data leakage through the prompt in ICL, especially when LLMs are exposed to malicious attacks. While differential privacy (DP) provides strong privacy guarantees, it often significantly reduces the utility of in-context learning (ICL). To address this challenge, we incorporate task-related public data into the ICL framework while maintaining the DP guarantee. Based on this approach, we propose a private in-context learning algorithm that effectively balances privacy protection and model utility. Through experiments, we demonstrate that our approach significantly improves the utility of private ICL with the assistance of public data. Additionally, we show that our method is robust against membership inference attacks, demonstrating empirical privacy protection."},{"descriptionType":"Other","description":"EMNLP 2025 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10932","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:50:50Z","registered":"2025-09-16T02:50:51Z","published":null,"updated":"2025-09-16T02:50:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10931","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10931","identifiers":[{"identifier":"2509.10931","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seongho","familyName":"Joo","name":"Joo, Seongho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyukhun","familyName":"Koh","name":"Koh, Hyukhun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyomin","familyName":"Jung","name":"Jung, Kyomin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Harmful Prompt Laundering: Jailbreaking LLMs with Abductive Styles and Symbolic Encoding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T18:07:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:24:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have demonstrated remarkable capabilities across diverse tasks, but their potential misuse for harmful purposes remains a significant concern. To strengthen defenses against such vulnerabilities, it is essential to investigate universal jailbreak attacks that exploit intrinsic weaknesses in the architecture and learning paradigms of LLMs. In response, we propose \\textbf{H}armful \\textbf{P}rompt \\textbf{La}undering (HaPLa), a novel and broadly applicable jailbreaking technique that requires only black-box access to target models. HaPLa incorporates two primary strategies: 1) \\textit{abductive framing}, which instructs LLMs to infer plausible intermediate steps toward harmful activities, rather than directly responding to explicit harmful queries; and 2) \\textit{symbolic encoding}, a lightweight and flexible approach designed to obfuscate harmful content, given that current LLMs remain sensitive primarily to explicit harmful keywords. Experimental results show that HaPLa achieves over 95% attack success rate on GPT-series models and 70% across all targets. Further analysis with diverse symbolic encoding rules also reveals a fundamental challenge: it remains difficult to safely tune LLMs without significantly diminishing their helpfulness in responding to benign queries."},{"descriptionType":"Other","description":"EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10931","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:50:49Z","registered":"2025-09-16T02:50:50Z","published":null,"updated":"2025-09-16T02:50:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10919","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10919","identifiers":[{"identifier":"2509.10919","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohanad","familyName":"Albughdadi","name":"Albughdadi, Mohanad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Lightweight Metadata-Aware Mixture-of-Experts Masked Autoencoder for Earth Observation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T17:35:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:23:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Earth Observation have focused on large-scale foundation models. However, these models are computationally expensive, limiting their accessibility and reuse for downstream tasks. In this work, we investigate compact architectures as a practical pathway toward smaller general-purpose EO models. We propose a Metadata-aware Mixture-of-Experts Masked Autoencoder (MoE-MAE) with only 2.5M parameters. The model combines sparse expert routing with geo-temporal conditioning, incorporating imagery alongside latitude/longitude and seasonal/daily cyclic encodings. We pretrain the MoE-MAE on the BigEarthNet-Landsat dataset and evaluate embeddings from its frozen encoder using linear probes. Despite its small size, the model competes with much larger architectures, demonstrating that metadata-aware pretraining improves transfer and label efficiency. To further assess generalization, we evaluate on the EuroSAT-Landsat dataset, which lacks explicit metadata, and still observe competitive performance compared to models with hundreds of millions of parameters. These results suggest that compact, metadata-aware MoE-MAEs are an efficient and scalable step toward future EO foundation models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10919","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:50:32Z","registered":"2025-09-16T02:50:33Z","published":null,"updated":"2025-09-16T02:50:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10913","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10913","identifiers":[{"identifier":"2509.10913","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ali","familyName":"Hedayatnia","name":"Hedayatnia, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mostafa","familyName":"Tavassolipour","name":"Tavassolipour, Mostafa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Babak Nadjar","familyName":"Araabi","name":"Araabi, Babak Nadjar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdol-Hossein","familyName":"Vahabie","name":"Vahabie, Abdol-Hossein","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robustifying Diffusion-Denoised Smoothing Against Covariate Shift"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T17:27:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:23:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Randomized smoothing is a well-established method for achieving certified robustness against l2-adversarial perturbations. By incorporating a denoiser before the base classifier, pretrained classifiers can be seamlessly integrated into randomized smoothing without significant performance degradation. Among existing methods, Diffusion Denoised Smoothing - where a pretrained denoising diffusion model serves as the denoiser - has produced state-of-the-art results. However, we show that employing a denoising diffusion model introduces a covariate shift via misestimation of the added noise, ultimately degrading the smoothed classifier's performance. To address this issue, we propose a novel adversarial objective function focused on the added noise of the denoising diffusion model. This approach is inspired by our understanding of the origin of the covariate shift. Our goal is to train the base classifier to ensure it is robust against the covariate shift introduced by the denoiser. Our method significantly improves certified accuracy across three standard classification benchmarks - MNIST, CIFAR-10, and ImageNet - achieving new state-of-the-art performance in l2-adversarial perturbations. Our implementation is publicly available at https://github.com/ahedayat/Robustifying-DDS-Against-Covariate-Shift"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10913","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:50:24Z","registered":"2025-09-16T02:50:24Z","published":null,"updated":"2025-09-16T02:50:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10886","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10886","identifiers":[{"identifier":"2509.10886","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinyu","familyName":"Zhang","name":"Zhang, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pei","familyName":"Zhang","name":"Zhang, Pei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Luo","name":"Luo, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialong","familyName":"Tang","name":"Tang, Jialong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Wan","name":"Wan, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baosong","familyName":"Yang","name":"Yang, Baosong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Huang","name":"Huang, Fei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CultureSynth: A Hierarchical Taxonomy-Guided and Retrieval-Augmented Framework for Cultural Question-Answer Synthesis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T16:33:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:21:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Cultural competence, defined as the ability to understand and adapt to multicultural contexts, is increasingly vital for large language models (LLMs) in global environments. While several cultural benchmarks exist to assess LLMs' cultural competence, current evaluations suffer from fragmented taxonomies, domain specificity, and heavy reliance on manual data annotation. To address these limitations, we introduce CultureSynth, a novel framework comprising (1) a comprehensive hierarchical multilingual cultural taxonomy covering 12 primary and 130 secondary topics, and (2) a Retrieval-Augmented Generation (RAG)-based methodology leveraging factual knowledge to synthesize culturally relevant question-answer pairs. The CultureSynth-7 synthetic benchmark contains 19,360 entries and 4,149 manually verified entries across 7 languages. Evaluation of 14 prevalent LLMs of different sizes reveals clear performance stratification led by ChatGPT-4o-Latest and Qwen2.5-72B-Instruct. The results demonstrate that a 3B-parameter threshold is necessary for achieving basic cultural competence, models display varying architectural biases in knowledge processing, and significant geographic disparities exist across models. We believe that CultureSynth offers a scalable framework for developing culturally aware AI systems while reducing reliance on manual annotation\\footnote{Benchmark is available at https://github.com/Eyr3/CultureSynth.}."},{"descriptionType":"Other","description":"Accepted as a Findings paper at EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10886","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:49:45Z","registered":"2025-09-16T02:49:46Z","published":null,"updated":"2025-09-16T02:49:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.10884","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.10884","identifiers":[{"identifier":"2509.10884","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qingxiang","familyName":"Liu","name":"Liu, Qingxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting","familyName":"Huang","name":"Huang, Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Zhang","name":"Zhang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Tang","name":"Tang, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Nav-R1: Reasoning and Navigation in Embodied Scenes"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-13T16:31:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-16T00:21:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Embodied navigation requires agents to integrate perception, reasoning, and action for robust interaction in complex 3D environments. Existing approaches often suffer from incoherent and unstable reasoning traces that hinder generalization across diverse environments, and difficulty balancing long-horizon semantic reasoning with low-latency control for real-time navigation. To address these challenges, we propose Nav-R1, an embodied foundation model that unifies reasoning in embodied environments. We first construct Nav-CoT-110K, a large-scale dataset of step-by-step Chains-of-Thought (CoT) for embodied tasks, which enables cold-start initialization with structured reasoning. Building on this foundation, we design a GRPO-based reinforcement learning framework with three complementary rewards: format, understanding, and navigation, to improve structural adherence, semantic grounding, and path fidelity. Furthermore, we introduce a Fast-in-Slow reasoning paradigm, decoupling deliberate semantic reasoning from low-latency reactive control for efficient yet coherent navigation. Extensive evaluations on embodied AI benchmarks demonstrate that Nav-R1 consistently outperforms strong baselines, with over 8% average improvement in reasoning and navigation performance. Real-world deployment on a mobile robot further validates its robustness under limited onboard resources. Code: https://github.com/AIGeeksGroup/Nav-R1. Website: https://aigeeksgroup.github.io/Nav-R1."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.10884","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-16T02:49:42Z","registered":"2025-09-16T02:49:43Z","published":null,"updated":"2025-09-16T02:49:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":77,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=doi%3A%2810.48550%2Farxiv.2509.10884+OR+10.48550%2Farxiv.2509.10886+OR+10.48550%2Farxiv.2509.10913+OR+10.48550%2Farxiv.2509.10919+OR+10.48550%2Farxiv.2509.10931+OR+10.48550%2Farxiv.2509.10932+OR+10.48550%2Farxiv.2509.10946+OR+10.48550%2Farxiv.2509.10963+OR+10.48550%2Farxiv.2509.10970+OR+10.48550%2Farxiv.2509.10975+OR+10.48550%2Farxiv.2509.11026+OR+10.48550%2Farxiv.2509.11035+OR+10.48550%2Farxiv.2509.11056+OR+10.48550%2Farxiv.2509.11065+OR+10.48550%2Farxiv.2509.11067+OR+10.48550%2Farxiv.2509.11068+OR+10.48550%2Farxiv.2509.11076+OR+10.48550%2Farxiv.2509.11078+OR+10.48550%2Farxiv.2509.11079+OR+10.48550%2Farxiv.2509.11084+OR+10.48550%2Farxiv.2509.11092+OR+10.48550%2Farxiv.2509.11101+OR+10.48550%2Farxiv.2509.11106+OR+10.48550%2Farxiv.2509.11109+OR+10.48550%2Farxiv.2509.11125+OR+10.48550%2Farxiv.2509.11127+OR+10.48550%2Farxiv.2509.11128+OR+10.48550%2Farxiv.2509.11134+OR+10.48550%2Farxiv.2509.11141+OR+10.48550%2Farxiv.2509.11145+OR+10.48550%2Farxiv.2509.11155+OR+10.48550%2Farxiv.2509.11165+OR+10.48550%2Farxiv.2509.11167+OR+10.48550%2Farxiv.2509.11176+OR+10.48550%2Farxiv.2509.11177+OR+10.48550%2Farxiv.2509.11178+OR+10.48550%2Farxiv.2509.11191+OR+10.48550%2Farxiv.2509.11197+OR+10.48550%2Farxiv.2509.11206+OR+10.48550%2Farxiv.2509.11208+OR+10.48550%2Farxiv.2509.11213+OR+10.48550%2Farxiv.2509.11218+OR+10.48550%2Farxiv.2509.11233+OR+10.48550%2Farxiv.2509.11250+OR+10.48550%2Farxiv.2509.11252+OR+10.48550%2Farxiv.2509.11254+OR+10.48550%2Farxiv.2509.11259+OR+10.48550%2Farxiv.2509.11284+OR+10.48550%2Farxiv.2509.11287+OR+10.48550%2Farxiv.2509.11292+OR+10.48550%2Farxiv.2509.11303+OR+10.48550%2Farxiv.2509.11311+OR+10.48550%2Farxiv.2509.11328+OR+10.48550%2Farxiv.2509.11337+OR+10.48550%2Farxiv.2509.11348+OR+10.48550%2Farxiv.2509.11353+OR+10.48550%2Farxiv.2509.11357+OR+10.48550%2Farxiv.2509.11361+OR+10.48550%2Farxiv.2509.11362+OR+10.48550%2Farxiv.2509.11364+OR+10.48550%2Farxiv.2509.11367+OR+10.48550%2Farxiv.2509.12273+OR+10.48550%2Farxiv.2509.12275+OR+10.48550%2Farxiv.2509.12278+OR+10.48550%2Farxiv.2509.13351+OR+10.48550%2Farxiv.2509.14263+OR+10.48550%2Farxiv.2509.14265+OR+10.48550%2Farxiv.2509.18133+OR+10.48550%2Farxiv.2509.18134+OR+10.48550%2Farxiv.2509.18137+OR+10.48550%2Farxiv.2509.19325+OR+10.48550%2Farxiv.2509.19326+OR+10.48550%2Farxiv.2509.19329+OR+10.48550%2Farxiv.2509.19331+OR+10.48550%2Farxiv.2509.22674+OR+10.48550%2Farxiv.2510.18880+OR+10.48550%2Farxiv.2510.21715%29\u0026page%5Bsize%5D=100\u0026page%5Bnumber%5D=1"}}