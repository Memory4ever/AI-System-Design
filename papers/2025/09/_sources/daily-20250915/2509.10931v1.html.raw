<section id="A10.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">J.1.2 </span>Full Masking</h4>

<div id="A10.SS1.SSS2.p1" class="ltx_para ltx_align_center"><span class="ltx_inline-block"><svg id="A10.SS1.SSS2.p1.pic1" class="ltx_picture" height="212.21" overflow="visible" version="1.1" viewBox="0 0 620.49 212.21" width="620.49"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,212.21) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#666666;" fill="#666666" fill-opacity="1.0"><path style="stroke:none" d="M 0 0 L 0 206.3 C 0 209.56 2.64 212.21 5.91 212.21 L 614.58 212.21 C 617.85 212.21 620.49 209.56 620.49 206.3 L 620.49 0 Z"></path></g><g style="--ltx-fill-color:#ECECEC;" fill="#ECECEC" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 1.97 L 1.97 188.1 L 618.52 188.1 L 618.52 1.97 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 196.69)"><foreignObject style="--ltx-fo-width:41.71em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="577.15"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
