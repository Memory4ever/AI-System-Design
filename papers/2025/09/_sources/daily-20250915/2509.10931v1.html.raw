</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="A13.F10.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.10931v1/Figures/3/3_qwen2.png" id="A13.F10.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/476;" width="476" height="476" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(b) </span>qwen2.5-7b</figcaption>
