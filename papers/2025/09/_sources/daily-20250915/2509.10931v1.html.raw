<td id="S4.T2.2.1.11.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T2.2.1.11.8.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">95.38</span></td>
<td id="S4.T2.2.1.11.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.1.11.9.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">3.25</span></td>
<td id="S4.T2.2.1.11.10" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T2.2.1.11.10.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">55.96</span></td>
<td id="S4.T2.2.1.11.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.1.11.11.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">4.28</span></td>
<td id="S4.T2.2.1.11.12" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T2.2.1.11.12.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">62.11</span></td>
<td id="S4.T2.2.1.11.13" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.1.11.13.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">4.75</span></td>
<td id="S4.T2.2.1.11.14" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.2.1.11.14.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">82.88</span></td></tr>
