<td id="S4.T2.2.1.10.7" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T2.2.1.10.7.1" class="ltx_text ltx_font_bold">98.84</span></td>
<td id="S4.T2.2.1.10.8" class="ltx_td ltx_align_center"><span id="S4.T2.2.1.10.8.1" class="ltx_text ltx_font_bold">3.85</span></td>
