<td id="S4.T2.2.1.12.8" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.2.1.12.8.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">3.86</span></td>
<td id="S4.T2.2.1.12.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T2.2.1.12.9.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">70.76</span></td>
<td id="S4.T2.2.1.12.10" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.2.1.12.10.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">4.28</span></td>
<td id="S4.T2.2.1.12.11" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T2.2.1.12.11.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">72.88</span></td>
