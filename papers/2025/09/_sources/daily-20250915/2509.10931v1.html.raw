<th id="S4.T2.2.1.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r"><span id="S4.T2.2.1.12.1.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">HaPLa</span></th>
<td id="S4.T2.2.1.12.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.2.1.12.2.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">4.93</span></td>
<td id="S4.T2.2.1.12.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T2.2.1.12.3.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">95.77</span></td>
<td id="S4.T2.2.1.12.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.2.1.12.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">4.92</span></td>
