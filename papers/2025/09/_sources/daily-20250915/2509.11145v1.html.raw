<td id="S3.T1.3.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S3.T1.3.2.2.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">Encode</span></td>
<td id="S3.T1.3.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;">
<span id="S3.T1.3.2.3.1" class="ltx_inline-block ltx_align_top" style="width:148.0pt;">
<span id="S3.T1.3.2.3.1.1" class="ltx_p"><span id="S3.T1.3.2.3.1.1.1" class="ltx_text" style="font-size:90%;">Insert new memory with metadata</span></span>
</span></td>
<td id="S3.T1.3.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S3.T1.3.2.4.1" class="ltx_text" style="font-size:90%;">✓</span></td>
<td id="S3.T1.3.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S3.T1.3.2.5.1" class="ltx_text" style="font-size:90%;">✓</span></td>
