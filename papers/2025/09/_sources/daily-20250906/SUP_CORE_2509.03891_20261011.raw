<td id="Sx4.T6.1.1.2" class="ltx_td ltx_align_center ltx_border_tt">AS</td>
<td id="Sx4.T6.1.1.3" class="ltx_td ltx_align_center ltx_border_tt">AF</td>
<td id="Sx4.T6.1.1.4" class="ltx_td ltx_align_center ltx_border_tt">RP</td>
