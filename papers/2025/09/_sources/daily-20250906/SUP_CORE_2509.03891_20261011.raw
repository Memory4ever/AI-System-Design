</table></td>
<td id="Sx4.T1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;">
<table id="Sx4.T1.1.1.4.1" class="ltx_tabular ltx_align_middle">
<tr id="Sx4.T1.1.1.4.1.1" class="ltx_tr">
<td id="Sx4.T1.1.1.4.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">No-App</td></tr>
<tr id="Sx4.T1.1.1.4.1.2" class="ltx_tr">
<td id="Sx4.T1.1.1.4.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">Tasks</td></tr>
</table></td>
<td id="Sx4.T1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;">Apps</td>
<td id="Sx4.T1.1.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;">
