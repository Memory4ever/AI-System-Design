</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A4.F8.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.04343v1/s_v_n_additional.svg" id="A4.F8.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:698/258;" width="698" height="258"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span>Information processing style (Sensing vs. Intuitive)</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A4.F8.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.04343v1/f_v_t_additional.svg" id="A4.F8.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:698/259;" width="698" height="259"></object>
