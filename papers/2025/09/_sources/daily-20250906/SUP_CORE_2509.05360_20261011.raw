<th id="S3.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.5pt 4.0pt;"><span id="S3.T3.2.1.3.1" class="ltx_text ltx_font_bold">AUROC</span></th>
