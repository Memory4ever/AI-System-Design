</span>
<span class="ltx_contact ltx_role_email"><span class="ltx_contact_name">email: </span><a href="mailto:jli793@ucr.edu">jli793@ucr.edu</a>
</span></span></span></span>
<span class="ltx_author_before"> and </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Evangelos Papalexakis
</span><span class="ltx_author_notes"><span class="ltx_author_notes_content">
<span class="ltx_contact ltx_role_affiliation"><span class="ltx_contact_name">Affiliation: </span><span id="id2" class="ltx_text ltx_affiliation_institution">University of California, Riverside</span>
</span>
<span class="ltx_contact ltx_role_email"><span class="ltx_contact_name">email: </span><a href="mailto:epapalex@cs.ucr.edu">epapalex@cs.ucr.edu</a>
