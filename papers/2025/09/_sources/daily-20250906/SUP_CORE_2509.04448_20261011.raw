x2.89" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.90" class="ltx_text ltx_lst_identifier ltx_font_typewriter">credible</span><span id="lstnumberx2.91" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.92" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="--ltx-fg-color:#000000;">and</span><span id="lstnumberx2.93" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.94" class="ltx_text ltx_lst_identifier ltx_font_typewriter">faithfully</span><span id="lstnumberx2.95" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.96" class="ltx_text ltx_lst_identifier ltx_font_typewriter">represent</span><span id="lstnumberx2.97" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.98" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx2.99" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.100" class="ltx_text ltx_lst_identifier ltx_font_typewriter">news</span><span id="lstnumberx2.101" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.102" class="ltx_text ltx_lst_identifier ltx_font_typewriter">event</span><span id="lstnumberx2.103" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx2.104" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.105" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx2.106" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.107" class="ltx_text ltx_lst_identifier ltx_font_typewriter">will</span><span id="lstnumberx2.108" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.109" class="ltx_text ltx_lst_identifier ltx_font_typewriter">be</span><span id="lstnumberx2.110" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.111" class