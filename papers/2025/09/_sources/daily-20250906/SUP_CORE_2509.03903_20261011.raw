<article class="ltx_document ltx_authors_1line" lang="en">
<h1 class="ltx_title ltx_title_document">
<span id="1" class="ltx_inline-block">
<span id="1.1" class="ltx_p ltx_align_left">A Generative Foundation Model for Chest Radiography</span>
</span></h1>

<div id="p1" class="ltx_para ltx_noindent">
<p id="p1.1" class="ltx_p">Yuanfeng Ji<sup id="p1.1.1" class="ltx_sup"><span id="p1.1.1.1" class="ltx_text ltx_font_italic">1,2‡</span></sup>, Dan Lin<sup id="p1.1.2" class="ltx_sup"><span id="p1.1.2.1" class="ltx_text ltx_font_italic">3‡</span></sup>, Xiyue Wang<sup id="p1.1.3" class="ltx_sup"><span id="p1.1.3.1" class="ltx_text ltx_font_italic">1‡</span></sup>, Lu Zhang<sup id="p1.1.4" class="ltx_sup"><span id="p1.1.4.1" class="ltx_text ltx_font_italic">4</span></sup>, Wenhui Zhou<sup id="p1.1.5" class="ltx_sup"><span id="p1.1.5.1" class="ltx_text ltx_font_italic">5</span></sup>, Chongjian Ge<sup id="p1.1.6" class="ltx_sup"><span id="p1.1.6.1" class="ltx_text ltx_font_italic">2</span></sup>, Ruihang Chu<sup id="p1.1.7" class="ltx_sup"><span id="p1.1.7.1" class="ltx_text ltx_font_italic">6</span></sup>, Xiaoli Yang<sup id="p1.1.8" class="ltx_sup"><span id="p1.1.8.1" class="ltx_text ltx_font_italic">1</span></sup>, Junhan Zhao<sup id="p1.1.9" class="ltx_sup"><span id="p1.1.9.1" class="ltx_text ltx_font_italic">7</span></sup>, Junsong Chen<sup id="p1.1.10" class="ltx_sup"><span id="p1.1.10.1" class="ltx_text ltx_font_italic">2</span></sup>, Xiangde Luo<sup id="p1.1.11" class="ltx_sup"><span id="p1.1.11.1" class="ltx_text ltx_font_italic">1</span></sup>, Sen Yang<sup id="p1.1.12" class="ltx_sup"><span id="p1.1.12.1" class="ltx_text ltx_font_italic">1</span></sup>, Jin Fang<sup id="p1.1.13" class="ltx_sup"><span id="p1.1.13.1" class="ltx_text ltx_font_italic">4</span></sup>, Ping Luo<sup id="p1.1.14" class="ltx_sup"><span id="p1.1.14.1" class="ltx_text ltx_font_italic">∗2</span></sup>, Ruijiang Li<sup id="p1.1.15" class="ltx_sup"><span id="p1.1.15.1" class="ltx_text ltx_font_italic">∗1</span></sup></p>
</div>
<div id="p2" class="ltx_para"><span id="p2.1" class="ltx_ERROR undefined">{affiliations}</span>
</div>
