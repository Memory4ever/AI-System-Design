<td id="S5.T6.2.2.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:2.0pt;padding-right:2.0pt;">0.0050</td></tr>
<tr id="S5.T6.2.3" class="ltx_tr">
<th id="S5.T6.2.3.1" class="ltx_td ltx_th ltx_th_row ltx_border_l ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;"></th>
<th id="S5.T6.2.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">0.1-DP</th>
<td id="S5.T6.2.3.3" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">0.5991</td>
<td id="S5.T6.2.3.4" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">0.7474</td>
<td id="S5.T6.2.3.5" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">0.4998</td>
<td id="S5.T6.2.3.6" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;">0.7984</td>
<td id="S5.T6.2.3.7" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:2.0pt;padding-right:2.0pt;">0.0074</td></tr>
