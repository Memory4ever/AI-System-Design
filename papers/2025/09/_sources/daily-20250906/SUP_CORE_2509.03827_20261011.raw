<td id="Sx4.T1.1.9.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx4.T1.1.9.2.1" class="ltx_text ltx_font_bold">40%</span></td>
<td id="Sx4.T1.1.9.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx4.T1.1.9.3.1" class="ltx_text ltx_font_bold">0.07</span></td></tr>
