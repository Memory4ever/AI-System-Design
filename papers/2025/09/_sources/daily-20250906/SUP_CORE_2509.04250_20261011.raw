ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Bayesian</span><span id="lstnumberx3.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">model</span><span id="lstnumberx3.27" class="ltx_text ltx_font_typewriter">.</span>
