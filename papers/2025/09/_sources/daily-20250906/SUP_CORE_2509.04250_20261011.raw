ext ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">empirical</span><span id="lstnumberx11.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">data</span><span id="lstnumberx11.27" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx11.28" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter">or</span><span id="lstnumberx11.30" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.31" class="ltx_text ltx_lst_identifier ltx_font_typewriter">established</span><span id="lstnumberx11.32" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.33" class="ltx_text ltx_lst_identifier ltx_font_typewriter">domain</span><span id="lstnumberx11.34" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter">knowledge</span><span id="lstnumberx11.36" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.37" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx11.38" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">set</span><span id="lstnumberx11.40" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.41" class="ltx_text ltx_lst_identifier ltx_font_typewriter">informative</span><span id="lstnumberx11.42" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx11.43" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx11.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter">not</span><span id="lstnumberx11.45" class="ltx_text ltx_lst_space ltx_font_typewrite