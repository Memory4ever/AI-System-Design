an><span id="lstnumberx6.24" class="ltx_text ltx_font_typewriter">~</span><span id="lstnumberx6.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Poisson</span><span id="lstnumberx6.27" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx6.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">lambda_j</span><span id="lstnumberx6.29" class="ltx_text ltx_font_typewriter">)</span>
