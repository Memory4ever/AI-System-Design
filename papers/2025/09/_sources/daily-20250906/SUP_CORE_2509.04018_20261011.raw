<td id="S3.T1.2.1.6.2" class="ltx_td ltx_align_center" style="padding:-1pt 14.0pt;" rowspan="2"><span id="S3.T1.2.1.6.2.1" class="ltx_text"><math id="S3.T1.m6" class="ltx_Math" alttext="\Delta z" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">\Delta z</annotation></semantics></math></span></td>
