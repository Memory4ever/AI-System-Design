<td id="S4.T3.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S4.T3.2.1.1.2.1" class="ltx_text"><span id="S4.T3.2.1.1.2.1.1" class="ltx_text"></span> <span id="S4.T3.2.1.1.2.1.2" class="ltx_text">
