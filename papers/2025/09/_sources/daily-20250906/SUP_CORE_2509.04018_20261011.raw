<td id="S3.T1.2.1.8.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-1pt 14.0pt;" rowspan="2"><span id="S3.T1.2.1.8.2.1" class="ltx_text"><math id="S3.T1.m8" class="ltx_Math" alttext="\Delta r_{z}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>z</mi></msub></mrow><annotation encoding="application/x-tex">\Delta r_{z}</annotation></semantics></math></span></td>
