<td id="S4.T3.2.1.2.2" class="ltx_td ltx_align_center">Success</td>
<td id="S4.T3.2.1.2.3" class="ltx_td ltx_align_center">Grasp</td>
<td id="S4.T3.2.1.2.4" class="ltx_td ltx_align_center">Success</td>
<td id="S4.T3.2.1.2.5" class="ltx_td ltx_align_center">Grasp</td>
<td id="S4.T3.2.1.2.6" class="ltx_td ltx_align_center">Success</td>
<td id="S4.T3.2.1.2.7" class="ltx_td ltx_align_center">Grasp</td>
<td id="S4.T3.2.1.2.8" class="ltx_td ltx_align_center">Success</td></tr>
<tr id="S4.T3.2.1.3" class="ltx_tr">
<td id="S4.T3.2.1.3.1" class="ltx_td ltx_align_center ltx_border_t">RT-1-X <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite></td>
<td id="S4.T3.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t">✗</td>
<td id="S4.T3.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t">16.7</td>
<td id="S4.T3.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t">0.0</td>
<td id="S4.T3.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t">20.8</td>
<td id="S4.T3.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t">4.2</td>
<td id="S4.T3.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t">8.3</td>
<td id="S4.T3.2.1.3.8" class="ltx_td ltx_align_center ltx_border_t">0.0</td>
<td id="S4.T3.2.1.3.9" class="ltx_td ltx_align_center ltx_border_t">0.0</td>
