<td id="S3.T1.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-1pt 14.0pt;"><span id="S3.T1.2.1.1.4.1" class="ltx_text ltx_font_bold">Direction</span> <math id="S3.T1.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math></td></tr>
