<td id="S3.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-1pt 14.0pt;" rowspan="2"><span id="S3.T1.2.1.2.2.1" class="ltx_text"><math id="S3.T1.m2" class="ltx_Math" alttext="\Delta x" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><annotation encoding="application/x-tex">\Delta x</annotation></semantics></math></span></td>
<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-1pt 14.0pt;">+</td>
<td id="S3.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-1pt 14.0pt;">forward</td></tr>
<tr id="S3.T1.2.1.3" class="ltx_tr">
<td id="S3.T1.2.1.3.1" class="ltx_td ltx_align_center" style="padding:-1pt 14.0pt;"><math id="S3.T1.m3" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math></td>
<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_center" style="padding:-1pt 14.0pt;">backward</td></tr>
<tr id="S3.T1.2.1.4" class="ltx_tr">
<td id="S3.T1.2.1.4.1" class="ltx_td ltx_align_center" style="padding:-1pt 14.0pt;" rowspan="2"><span id="S3.T1.2.1.4.1.1" class="ltx_text">Y</span></td>
<td id="S3.T1.2.1.4.2" class="ltx_td ltx_align_center" style="padding:-1pt 14.0pt;" rowspan="2"><span id="S3.T1.2.1.4.2.1" class="ltx_text"><math id="S3.T1.m4" class="ltx_Math" alttext="\Delta y" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">\Delta y</annotation></semantics></math></span></td>
<td id="S3.T1.2.1.4.3" class="ltx_td ltx_align_center" style="padding:-1pt 14.0pt;">+</td>
<td id="S3.T1.2.1.4.4" class="ltx_td ltx_align_center" style="padding:-1pt 14.0pt;">left</td></tr>
<tr id="S3.T1.2.1.5" class="ltx_tr">
<td id="S3.T1.2.1.5.1" class="ltx_td ltx_align_center" style="padding:-1pt 14.0pt;"><math id="S3.T1.m5" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math></td>
