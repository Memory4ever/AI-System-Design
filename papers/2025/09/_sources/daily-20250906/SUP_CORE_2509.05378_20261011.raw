umberx2.29" class="ltx_text ltx_lst_identifier">terms</span><span id="lstnumberx2.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.31" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx2.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.33" class="ltx_text ltx_lst_identifier">their</span><span id="lstnumberx2.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx2.35" class="ltx_text ltx_lst_identifier">modifiers</span>.
