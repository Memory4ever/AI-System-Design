            <span id="alg1.l7.3" class="ltx_text ltx_font_bold">for</span> generation <math id="alg1.l7.m1" class="ltx_Math" alttext="g=0" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g=0</annotation></semantics></math> to <math id="alg1.l7.m2" class="ltx_Math" alttext="G-1" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">G-1</annotation></semantics></math> <span id="alg1.l7.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
              <math id="alg1.l8.m1" class="ltx_Math" alttext="R\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">R\leftarrow\emptyset</annotation></semantics></math> <span id="alg1.l8.3" class="ltx_text" style="float:right;"><math id="alg1.l8.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Reward storage for current generation
</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
              <span id="alg1.l9.3" class="ltx_text ltx_font_bold">for</span> each policy <math id="alg1.l9.m1" class="ltx_Math" alttext="\pi_{\omega}\in P_{g}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>ω</mi></msub><mo>∈</mo><msub><mi>P</mi><mi>g</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{\omega}\in P_{g}</annotation></semantics></math> <span id="alg1.l9.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
               <span id="alg1.l10.3" class="ltx_text ltx_font_smallcaps">Nego-simulation</span>(<math id="alg1.l10.m1" class="ltx_Math" alttext="\pi_{\omega},\mathcal{M}_{1},\mathcal{M}_{2},\mathcal{M}_{3},D" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>ω</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>1</mn></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>2</mn></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>3</mn></msub><mo>,</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">\pi_{\omega},\mathcal{M}_{1},\mathcal{M}_{2},\mathcal{M}_{3},D</annotation></semantics></math>)

</div>
<div id="alg1.l11" class="ltx_listingline">
