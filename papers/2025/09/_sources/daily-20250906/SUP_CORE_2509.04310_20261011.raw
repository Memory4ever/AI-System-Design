               <math id="alg1.l11.m1" class="ltx_Math" alttext="R(\pi_{\omega})\leftarrow\textsc{Reward}(\text{outcome})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>ω</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">Reward</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>outcome</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R(\pi_{\omega})\leftarrow\textsc{Reward}(\text{outcome})</annotation></semantics></math> <span id="alg1.l11.3" class="ltx_text" style="float:right;"><math id="alg1.l11.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Store policy reward
</span>
</div>
<div id="alg1.l12" class="ltx_listingline">
