              <span id="alg1.l12.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l12.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
              <math id="alg1.l13.m1" class="ltx_Math" alttext="P^{\prime}\leftarrow\textsc{SelectParents}(P_{g},R)" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">SelectParents</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>g</mi></msub><mo>,</mo><mi>R</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P^{\prime}\leftarrow\textsc{SelectParents}(P_{g},R)</annotation></semantics></math> <span id="alg1.l13.3" class="ltx_text" style="float:right;"><math id="alg1.l13.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Tournament selection
</span>
</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
              <math id="alg1.l14.m1" class="ltx_Math" alttext="P^{\prime\prime}\leftarrow\textsc{ApplyGeneticOperations}(P^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>′′</mo></msup><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">ApplyGeneticOperations</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P^{\prime\prime}\leftarrow\textsc{ApplyGeneticOperations}(P^{\prime})</annotation></semantics></math> <span id="alg1.l14.3" class="ltx_text" style="float:right;"><math id="alg1.l14.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Crossover and mutation
</span>
</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
              <math id="alg1.l15.m1" class="ltx_Math" alttext="P_{g+1}\leftarrow\textsc{FormNewPopulation}(P^{\prime\prime})" display="inline" intent=":literal"><semantics><mrow><msub><mi>P</mi><mrow><mi>g</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">FormNewPopulation</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>′′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P_{g+1}\leftarrow\textsc{FormNewPopulation}(P^{\prime\prime})</annotation></semantics></math> <span id="alg1.l15.3" class="ltx_text" style="float:right;"><math id="alg1.l15.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Elitism preservation
</span>
</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
            <span id="alg1.l16.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l16.4" class="ltx_text ltx_font_bold">for</span>
</div>
