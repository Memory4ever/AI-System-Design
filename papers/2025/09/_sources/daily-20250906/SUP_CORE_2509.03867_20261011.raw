<th id="S5.T2.2.2.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t"><span id="S5.T2.2.2.2.1" class="ltx_text ltx_font_bold">Hard</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.2.3" class="ltx_tr">
<th id="S5.T2.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="3"><span id="S5.T2.2.3.1.1" class="ltx_text">English</span></th>
<th id="S5.T2.2.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">4B</th>
<td id="S5.T2.2.3.3" class="ltx_td ltx_align_right ltx_border_t">81.00</td>
<td id="S5.T2.2.3.4" class="ltx_td ltx_align_right ltx_border_t">6.00</td></tr>
<tr id="S5.T2.2.4" class="ltx_tr">
<th id="S5.T2.2.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">8B</th>
<td id="S5.T2.2.4.2" class="ltx_td ltx_align_right">83.17</td>
<td id="S5.T2.2.4.3" class="ltx_td ltx_align_right">26.78</td></tr>
<tr id="S5.T2.2.5" class="ltx_tr">
<th id="S5.T2.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">14B</th>
