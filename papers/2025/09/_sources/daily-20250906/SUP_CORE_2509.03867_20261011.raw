<tr id="S5.T2.2.6" class="ltx_tr">
<th id="S5.T2.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" rowspan="3"><span id="S5.T2.2.6.1.1" class="ltx_text">Mandarin</span></th>
<th id="S5.T2.2.6.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">4B</th>
<td id="S5.T2.2.6.3" class="ltx_td ltx_align_right ltx_border_t">77.61</td>
<td id="S5.T2.2.6.4" class="ltx_td ltx_align_right ltx_border_t">2.44</td></tr>
<tr id="S5.T2.2.7" class="ltx_tr">
<th id="S5.T2.2.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">8B</th>
<td id="S5.T2.2.7.2" class="ltx_td ltx_align_right">81.11</td>
<td id="S5.T2.2.7.3" class="ltx_td ltx_align_right">19.11</td></tr>
<tr id="S5.T2.2.8" class="ltx_tr">
