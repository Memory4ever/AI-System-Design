<tr id="S2.T1.2.4" class="ltx_tr">
<th id="S2.T1.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Space Size</th>
<td id="S2.T1.2.4.2" class="ltx_td ltx_align_left">50 <math id="S2.T1.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> 50</td></tr>
<tr id="S2.T1.2.5" class="ltx_tr">
<th id="S2.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Bar Size</th>
<td id="S2.T1.2.5.2" class="ltx_td ltx_align_left">10 <math id="S2.T1.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> 10</td></tr>
<tr id="S2.T1.2.6" class="ltx_tr">
