<td id="S5.T1.2.1.13.4" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="S5.T1.2.1.13.4.1" class="ltx_text ltx_font_bold">89.67 <math id="S5.T1.m38" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.77</span></td>
<td id="S5.T1.2.1.13.5" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="S5.T1.2.1.13.5.1" class="ltx_text ltx_font_bold">83.67 <math id="S5.T1.m39" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.48</span></td></tr>
