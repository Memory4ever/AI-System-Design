rl\":\"/transparency\"},{\"title\":\"Responsible Scaling Policy\",\"url\":\"/responsible-scaling-policy\"},{\"title\":\"Beneficial Deployments\",\"url\":\"/beneficial-deployments\"}],\"title\":\"Initiatives\"},{\"_key\":\"16af50a6e2dd\",\"links\":[{\"title\":\"Security and compliance\",\"url\":\"https://trust.anthropic.com/\"}],\"title\":\"Trust center\"}]},{\"_key\":\"861a11ed9931\",\"category\":\"Learn\",\"displayType\":\"sections\",\"sections\":[{\"_key\":\"9f9f720a8793\",\"links\":[{\"title\":\"Claude Academy\",\"url\":\"https://academy.claude.com\"},{\"title\":\"Tutorials\",\"url\":\"https://claude.com/resources/tutorials\"},{\"title\":\"Use cases\",\"url\":\"https://claude.com/resources/use-cases\"},{\"title\":\"Developer docs\",\"url\":\"https://platform.claude.com/docs\"}],\"title\":\"Learn\"},{\"_key\":\"6bd061c46b10\",\"links\":[{\"title\":\"About\",\"url\":\"/company\"},{\"title\":\"Leadership\",\"url\":\"/company/leadership\"},{\"title\":\"Careers\",\"url\":\"/careers\"},{\"title\":\"Events\",\"url\":\"/events\"}],\"title\":\"Company\"}]},{\"_key\":\"22e8d8d2923d\",\"category\":\"News\",\"displayType\":\"singleLink\",\"sections\":null,\"url\":\"/news\"}],\"claudeCta\":{\"desktopCtas\":null,\"mobileCtas\":[{\"title\":\"Log in to Claude\",\"url\":\"https://claude.ai/login\"},{\"title\":\"Download app\",\"url\":\"https://claude.ai/download\"}],\"sections\":[{\"category\":\"About Claude\",\"links\":[{\"title\":\"Overview\",\"url\":\"https://claude.com/product/overview\"},{\"title\":\"Pricing\",\"url\":\"https://claude.com/pricing\"},{\"title\":\"Contact sales\",\"url\":\"https://claude.com/contact-sales\"}]},{\"category\":\"Models\",\"links\":[{\"title\":\"Mythos\",\"url\":\"/claude/mythos\"},{\"title\":\"Fable\",\"url\":\"/claude/fable\"},{\"title\":\"Opus\",\"url\":\"/claude/opus\"},{\"title\":\"Sonnet\",\"url\":\"/claude/sonnet\"},{\"title\":\"Haiku\",\"url\":\"/claude/haiku\"}]},{\"category\":\"Log in\",\"links\":[{\"title\":\"Claude.ai\",\"url\":\"https://claude.ai\"},{\"title\":\"Claude Console\",\"url\":\"https://platform.claude.com/\"}]}],\"title\":\"Try Claude\",\"url\":\"https://claude.ai/\"}},\"page\":{\"_type\":\"page\",\"_id\":\"not-found\",\"_rev\":\"\",\"_createdAt\":\"\",\"_updatedAt\":\"\",\"title\":\"Not Found\",\"slug\":{\"_type\":\"slug\",\"current\":\"not-found\"},\"meta\":{},\"sections\":[]},\"theme\":\"$undefined\",\"hideOnScroll\":\"$undefined\"}],[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"\",\"children\":[\"$\",\"$L19\",null,{}]}],null]}]\nc:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#141413\"}]]\n1a:I[605500,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/2hwbhylgw726z.js\",\"/_next/static/chunks/3p5jmm60ya981.js\",\"/_next/static/chunks/2jb2vo5bbt4aq.js\",\"/_next/static/chunks/3uj_4q3griim_.js\",\"/_next/static/chunks/1nhl105b9imrb.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"Image\"]\n1b:I[366829,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/2hwbhylgw726z.js\",\"/_next/static/chunks/3p5jmm60ya981.js\",\"/_next/static/chunks/2jb2vo5bbt4aq.js\",\"/_next/static/chunks/3uj_4q3griim_.js\",\"/_next/static/chunks/1nhl105b9imrb.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"default\"]\n21:I[27201,[\"/_next/static/chunks/1fvd0nqqmo54p.js\"],\"IconMark\"]\n1c:[]\n6:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"children\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Why do we take LLMs seriously as a potential source of biorisk?\\\",\\\"description\\\":\\\"This article explains why we believe that evaluating biorisk and safeguarding against it is a critical element of responsible AI development.\\\",\\\"image\\\":[\\\"https://www-cdn.anthropic.com/images/4zrzovbb/website/3765b916249947d7e8652906724ef6ed96f9f934-1200x630.jpg\\\"],\\\"datePublished\\\":\\\"2025-09-05T00:00:00.000Z\\\",\\\"dateModified\\\":\\\"2026-07-08T20:53:48.000Z\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Anthropic\\\",\\\"url\\\":\\\"https://www.anthropic.com\\\"},\\\"mainEntityOfPage\\\":\\\"https://www.anthropic.com/research/biorisk\\\",\\\"url\\\":\\\"https://www.anthropic.com/research/biorisk\\\"}\"}],[\"$\",\"$L17\",null,{\"children\":[null,[\"$\",\"$L18\",null,{\"isMinimalNavigation\":\"$undefined\",\"siteSettings\":{\"headerNavigation\":\"$16:props:children:1:props:siteSettings:headerNavigation\",\"claudeCta\":\"$16:props:children:1:props:siteSettings:claudeCta\"},\"page\":\"$undefined\",\"theme\":\"$undefined\",\"hideOnScroll\":\"$undefined\"}],[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"\",\"children\":[\"$\",\"article\",null,{\"className\":\"\",\"children\":[[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__hero\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__header\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__subjects body-3 bold\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Frontier Red Team\"}]]}],[\"$\",\"h1\",null,{\"className\":\"headline-1 PostDetail-module-scss-module__UQuRMa__title\",\"children\":\"Why do we take LLMs seriously as a potential source of biorisk?\"}],[\"$\",\"div\",null,{\"className\":\"body-3 agate\",\"children\":[\"$\",\"time\",null,{\"dateTime\":\"2025-09-05T00:00:00.000Z\",\"children\":\"Sep 5, 2025\"}]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__illustrationHeroWrapper\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/a6bcc8984390309c6bcd517e294db35ae3fdb56d-1920x1080.jpg\",\"alt\":\"Why do we take LLMs seriously as a potential source of biorisk?\",\"className\":\"PostDetail-module-scss-module__UQuRMa__heroImage\",\"width\":1920,\"height\":1080,\"priority\":true}]}]]}],[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[\"$\",\"$L1b\",null,{\"body\":[{\"_key\":\"e4i46x30\",\"_type\":\"block\",\"children\":[{\"_key\":\"8dqvphfh\",\"_type\":\"span\",\"marks\":[],\"text\":\"Our work at Anthropic is animated by the potential for AI to advance scientific discovery—especially in biology and medicine—and improve the human condition. \"},{\"_key\":\"x1hpi0b3\",\"_type\":\"span\",\"marks\":[\"8vsuumpd\"],\"text\":\"Benchling\"},{\"_key\":\"5ndgh4ho\",\"_type\":\"span\",\"marks\":[],\"text\":\" is \"},{\"_key\":\"mkut32xl\",\"_type\":\"span\",\"marks\":[\"0yvfj0nv\"],\"text\":\"using Claude\"},{\"_key\":\"8hp8de6t\",\"_type\":\"span\",\"marks\":[],\"text\":\" to help researchers structure data, ask better questions, generate insights faster, and spend more time on science. \"},{\"_key\":\"8o6rl6iq\",\"_type\":\"span\",\"marks\":[\"9m4obf0q\"],\"text\":\"Biomni\"},{\"_key\":\"lpjrsggx\",\"_type\":\"span\",\"marks\":[],\"text\":\" is \"},{\"_key\":\"qcj0ofjs\",\"_type\":\"span\",\"marks\":[\"thrf3l6w\"],\"text\":\"using Claude\"},{\"_key\":\"mn3672z6\",\"_type\":\"span\",\"marks\":[],\"text\":\" to speed up bioinformatics analysis and even automate experimental design.\"}],\"markDefs\":[{\"_key\":\"8vsuumpd\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.benchling.com/ai\"},{\"_key\":\"0yvfj0nv\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.anthropic.com/customers/benchling\"},{\"_key\":\"9m4obf0q\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://biomni.stanford.edu/\"},{\"_key\":\"thrf3l6w\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.anthropic.com/customers/biomni\"}],\"style\":\"normal\"},{\"_key\":\"zkrdvvng\",\"_type\":\"block\",\"children\":[{\"_key\":\"c81x5jc8\",\"_type\":\"span\",\"marks\":[],\"text\":\"At the same time, AI is fundamentally a dual-use technology. A key tenet of our effort to develop AI responsibly is to identify, measure, and mitigate the prospects for malicious actors to misuse the same capabilities that make AI so promising for scientists and innovators.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0xycstde\",\"_type\":\"block\",\"children\":[{\"_key\":\"28lx5ost\",\"_type\":\"span\",\"marks\":[],\"text\":\"When Anthropic released Claude Opus 4, we \"},{\"_key\":\"27yn0on8\",\"_type\":\"span\",\"marks\":[\"ohymglwo\"],\"text\":\"activated AI Safety Level 3\"},{\"_key\":\"vcdcvd7l\",\"_type\":\"span\",\"marks\":[],\"text\":\" (ASL-3) protections, which included deployment measures narrowly focused on preventing the model from assisting with certain tasks related to chemical, biological, radiological, and nuclear (CBRN) weapons development. As we noted at the time, this was a precautionary decision—improving model performance on our evaluations meant we could no longer confidently rule out the ability of our most advanced model to uplift people with basic STEM backgrounds if they were to try to develop such weapons. Because of our assessment of the potential consequences, a major initial focus of our evaluations and the corresponding safety measures was on biological weapons. In this post, we want to expand on our perspective on AI and biological risk (biorisk). \"}],\"markDefs\":[{\"_key\":\"ohymglwo\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.anthropic.com/news/activating-asl3-protections\"}],\"style\":\"normal\"},{\"_key\":\"yqnomt3o\",\"_type\":\"block\",\"children\":[{\"_key\":\"bpk1b5kk\",\"_type\":\"span\",\"marks\":[],\"text\":\"It is striking—but not necessarily intuitive—that every safety framework released by frontier AI labs includes some reference to biorisk.\"},{\"_key\":\"186vo230\",\"_type\":\"span\",\"marks\":[\"sup\"],\"text\":\"[1]\"},{\"_key\":\"fwuxlj5n\",\"_type\":\"span\",\"marks\":[],\"text\":\" After all, frontier large language models (LLMs) are generalists; they are not usually specialized for biological applications (unlike other foundation models, such as AlphaFold). And because of this generalist nature, there are numerous other security threats that could be prioritized. We understand why one might be skeptical of prioritizing biorisk when considering the security implications of AI. This post will engage with several questions that might be posed by such a skeptic.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"jpk4rl1q\",\"_type\":\"block\",\"children\":[{\"_key\":\"xdwfxq8m\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Our aim is not alarmism; discussions of AI and biorisk are firmly in the category of low-probability/high-impact scenarios.\"},{\"_key\":\"euhecyk4\",\"_type\":\"span\",\"marks\":[\"sup\",\"strong\"],\"text\":\"[2]\"},{\"_key\":\"248rr8uv\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\" Rather, we want to establish why we believe that evaluating these risks and safeguarding against them is a critical element of responsible AI development.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"hl9w41mr\",\"_type\":\"block\",\"children\":[{\"_key\":\"vh7rbqgj\",\"_type\":\"span\",\"marks\":[],\"text\":\"What does AI have to do with dangerous weapons at all?\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"173pmn60\",\"_type\":\"block\",\"children\":[{\"_key\":\"f2pbfxla\",\"_type\":\"span\",\"marks\":[],\"text\":\"We worry about how AI might assist malicious actors with weapon acquisition and development both because of how it is similar to historical information and communication technologies and how it is different.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"maumk0uv\",\"_type\":\"block\",\"children\":[{\"_key\":\"m98u01yr\",\"_type\":\"span\",\"marks\":[],\"text\":\"In recent years, terrorist groups have rapidly adopted technologies like encrypted communications, cryptocurrency, and social media. We should expect nothing different from AI. Just as those seeking information about how to build weapons shifted from needing to acquire physical pamphlets or manuals to searching the internet, we can expect that they will query AI.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"p0xqmeob\",\"_type\":\"block\",\"children\":[{\"_key\":\"bqgne2f1\",\"_type\":\"span\",\"marks\":[],\"text\":\"What is different, though, is the potential for AI to act as a true assistant. The internet is cluttered with contradictory and misleading information, and a website cannot provide real-time assistance if one encounters difficulties in a complex and unfamiliar process. Sufficiently advanced AI models may serve as a guide to reliable information, a source of otherwise tacit and inaccessible knowledge about implementation, and a research assistant capable of immediately processing data and generating insight.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ryzcinno\",\"_type\":\"block\",\"children\":[{\"_key\":\"m1rjrn6k\",\"_type\":\"span\",\"marks\":[],\"text\":\"Why focus on biorisk?\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"ngbglmy6\",\"_type\":\"block\",\"children\":[{\"_key\":\"8o03y063\",\"_type\":\"span\",\"marks\":[],\"text\":\"Within the realm of threat actors seeking assistance from AI, biological risks—and catastrophic risks more generally—are by no means the only concern. In fact, we invest considerable resources in researching the potential implications of AI for \"},{\"_key\":\"4s0ztk1t\",\"_type\":\"span\",\"marks\":[\"hi04ll8e\"],\"text\":\"cybersecurity\"},{\"_key\":\"ikprz9rl\",\"_type\":\"span\",\"marks\":[],\"text\":\" and gathering \"},{\"_key\":\"xei0i28o\",\"_type\":\"span\",\"marks\":[\"petqfv1y\"],\"text\":\"intelligence\"},{\"_key\":\"e4rn4m9r\",\"_type\":\"span\",\"marks\":[],\"text\":\" about actual uses of our platforms by those who would cause harm through fraud, malware development, and influence operations, among other areas.\"}],\"markDefs\":[{\"_key\":\"hi04ll8e\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://red.anthropic.com/2025/cyber-toolkits/\"},{\"_key\":\"petqfv1y\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.anthropic.com/news/detecting-and-countering-malicious-uses-of-claude-march-2025\"}],\"style\":\"normal\"},{\"_key\":\"u3f2sssq\",\"_type\":\"block\",\"children\":[{\"_key\":\"v3yownv7\",\"_type\":\"span\",\"marks\":[],\"text\":\"Nevertheless, at least two factors make biorisk especially concerning. First, the potential consequences of a successful biological attack are unusually severe. The effects of an attack with a virus could spread far beyond the initial target in a way that is qualitatively different from weapons with more local effects.    \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"wfqts78e\",\"_type\":\"block\",\"children\":[{\"_key\":\"h3xasyq9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Second, improvements in other areas of biotechnology may have lowered some of the material barriers that previously served as a “passive” biodefense. For instance, the decreasing cost of nucleic acid synthesis, standardization of reagent kits, and easy access to standard molecular biology equipment (such as PCR machines), are making material acquisition less of a bottleneck. AI models further reduce barriers to information and know-how. As a result, this combination of high consequences and increasing plausibility make addressing additional biorisk from AI an important priority.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"j8g5utrl\",\"_type\":\"block\",\"children\":[{\"_key\":\"0tzccgom\",\"_type\":\"span\",\"marks\":[],\"text\":\"Don’t experts know more about biology than AI models?\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"ji0c9scw\",\"_type\":\"block\",\"children\":[{\"_key\":\"m6uvixv4\",\"_type\":\"span\",\"marks\":[],\"text\":\"LLMs are trained on vast amounts of data ranging from financial models to fanfiction. In the course of this training, they learn something about almost everything. Since the training data includes things like scientific papers, books, and online discussions about biological sciences, the models absorb information about protein structures, genetic engineering techniques, virology, and synthetic biology, alongside everything else. What may be surprising is the degree to which this biological knowledge has scaled up as models have improved.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"sst8egrw\",\"_type\":\"block\",\"children\":[{\"_key\":\"y2dxto55\",\"_type\":\"span\",\"marks\":[],\"text\":\"To be sure, Claude and other LLMs are not currently capable of actually doing science autonomously at an expert level. However, on several evaluations designed to test knowledge relevant to potentially dangerous aspects of biology, models are nearing—and sometimes exceeding—expert human performance.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"h96yd01v\",\"_type\":\"block\",\"children\":[{\"_key\":\"1qe8n4nz\",\"_type\":\"span\",\"marks\":[],\"text\":\"Within a year, Claude went from underperforming world-class experts on an evaluation designed to test virology troubleshooting scenarios in a lab setting, to comfortably exceeding that baseline (see Figure 1).\\n        \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"gm2utvvz\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-c1a9a5f88426b3e2fb7041e8143f1e3413b09ddf-889x390-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"llxfuhgv\",\"_type\":\"block\",\"children\":[{\"_key\":\"1uqofoe7\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 1.\"},{\"_key\":\"505e48ec382b\",\"_type\":\"span\",\"marks\":[],\"text\":\" Claude’s performance has improved on VCT, an evaluation of model capabilities in troubleshooting virology tasks designed by SecureBio.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"columnWidth\":\"inline-width\",\"height\":390,\"markDefs\":null,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/c1a9a5f88426b3e2fb7041e8143f1e3413b09ddf-889x390.png\",\"width\":889},{\"_key\":\"dc2136yt\",\"_type\":\"block\",\"children\":[{\"_key\":\"sj9cxhgz\",\"_type\":\"span\",\"marks\":[],\"text\":\"We see this behavior of exceeding expert performance across multiple benchmarks, especially in molecular biology. \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9ynd5uob\",\"_type\":\"block\",\"children\":[{\"_key\":\"jl0wdo05\",\"_type\":\"span\",\"marks\":[],\"text\":\"Moreover, the human baseline in this evaluation is based on scientists answering questions within their own speciality. So it is not only the case that LLMs can develop a breadth of knowledge across subdisciplines that human experts struggle to match, but also that LLMs are in some cases outpacing specialists on their own turf.  \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a75slqmk\",\"_type\":\"block\",\"children\":[{\"_key\":\"ly8edbpr\",\"_type\":\"span\",\"marks\":[],\"text\":\"Is an LLM’s knowledge useful in an applied scenario?\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"crzfxcrc\",\"_type\":\"block\",\"children\":[{\"_key\":\"u8ueebam\",\"_type\":\"span\",\"marks\":[],\"text\":\"In considering the contribution of AI to biorisk, we need to know more than just how well it performs on a quiz. We need to look at evaluations that involve real people, and closely mirror our actual threat scenarios. Moreover, just as we benchmark AI knowledge by comparing it to experts, we need to measure AI utility by comparing it to the most easily accessible alternative—in this case, the internet.\\n        \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"l40m7bzc\",\"_type\":\"block\",\"children\":[{\"_key\":\"mgivnvqp\",\"_type\":\"span\",\"marks\":[],\"text\":\"To meet both of these criteria, we have conducted several controlled trials measuring AI’s ability to assist in the planning of a hypothetical bioweapons acquisition process. Participants were given up to two days to draft a comprehensive bioweapons acquisition plan. The control group only had access to basic internet resources, while the model-assisted group had additional access to Claude with safeguards removed. (In limited cases like this, it is important to provide trusted parties with access to the unsafeguarded version of the model in order to more accurately assess the maximum capabilities of the technology.) The resulting plans were graded by biodefense experts using a detailed rubric that assesses key steps of the acquisition pathway. Participants with access to Claude 4 models—especially Claude Opus 4—received much higher scores and developed plans with substantially fewer critical failures compared to the internet-only control group.\\n        \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7xm9ja8u\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-b6b552ad3b9b9cc2312d55ef98c5d343078753c3-980x580-png\",\"_type\":\"reference\"},\"caption\":null,\"columnWidth\":\"inline-width\",\"height\":580,\"markDefs\":null,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/b6b552ad3b9b9cc2312d55ef98c5d343078753c3-980x580.png\",\"width\":980},{\"_key\":\"amgvn82b\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-4dabd0ce91dd00553db423a8d24496e52ad4308d-980x580-png\",\"_type\":\"reference\"},\"caption\":[{\"_key\":\"xzzx14l3\",\"_type\":\"block\",\"children\":[{\"_key\":\"dvdbo0mb\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Figure 2. \"},{\"_key\":\"5d356fbc84bd\",\"_type\":\"span\",\"marks\":[],\"text\":\"Bioweapons acquisition uplift trial results. Top: raw scores from the uplift trial. Bottom: critical failures hit by participants.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"columnWidth\":\"inline-width\",\"height\":580,\"markDefs\":null,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/4dabd0ce91dd00553db423a8d24496e52ad4308d-980x580.png\",\"width\":980},{\"_key\":\"ghpq7shh\",\"_type\":\"block\",\"children\":[{\"_key\":\"8hio1phr\",\"_type\":\"span\",\"marks\":[],\"text\":\"Text-based uplift trials like this are imperfect proxies for real-world scenarios—which involve additional factors like tacit knowledge, materials access, and actor persistence—but they demonstrate the underlying plausibility of AIs providing differentially superior assistance to a non-expert malicious actor.\"},{\"_key\":\"m0pmww1g\",\"_type\":\"span\",\"marks\":[\"sup\"],\"text\":\"[3]\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"yzow1k3n\",\"_type\":\"block\",\"children\":[{\"_key\":\"3hqkdsek\",\"_type\":\"span\",\"marks\":[],\"text\":\"Ok, but we’ve been talking about information. How does this translate to an actual lab?\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"94fhvbh9\",\"_type\":\"block\",\"children\":[{\"_key\":\"90vh03wp\",\"_type\":\"span\",\"marks\":[],\"text\":\"There is clearly a difference between answering multiple-choice questions about virology, assisting with text-based plans for bioweapons acquisition, and actually helping a threat actor working in a lab to develop a biological threat. \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"45mfd4if\",\"_type\":\"block\",\"children\":[{\"_key\":\"2z77ij3b\",\"_type\":\"span\",\"marks\":[],\"text\":\"First, one might think that there is too much tacit knowledge required for laboratory biology for AI knowledge provision to have any effect. Tacit knowledge includes technical skills that are difficult to verbalize, like knowing the subtle visual cues associated with the timing of different reactions, and received wisdom, like elements of a protocol that are not written down. If these barriers are so great as to thwart the efforts of any novice in a lab, we would be less worried about the potential for AI to uplift inexperienced actors to the point of being a threat. Second, to truly validate the plausibility of the scenarios underlying the concern behind AI and biorisk, we would want large scale evidence from an actual laboratory experiment. We have some initial evidence about the first question and are actively investing in the second approach.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"j0f7p7fw\",\"_type\":\"block\",\"children\":[{\"_key\":\"mcpre5eu\",\"_type\":\"span\",\"marks\":[],\"text\":\"In 2024, we did a preliminary wet lab uplift trial with basic biology lab protocols, where some participants had access to a version of Claude, while others only had access to the internet. We did not observe any evidence of uplift in this study. However, we noted that all participants, including the internet-only group, did surprisingly well on all tasks in the real lab. So although this pilot study did not provide strong evidence one way or another about AI uplift, it did suggest that tacit knowledge may not be as significant of a bottleneck as many have suggested. To be clear, this was a very small (n=8) experiment and the protocols participants were asked to do were fairly basic. Still, this finding underscored the importance of scaling up to a larger study that would provide additional insight into the role of tacit knowledge and the potential for AI to provide uplift in an actual lab.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"u4l0h7qv\",\"_type\":\"block\",\"children\":[{\"_key\":\"e44tczqj\",\"_type\":\"span\",\"marks\":[],\"text\":\"In order to follow up on this initial research, we are co-sponsoring a \"},{\"_key\":\"4pwdobp5\",\"_type\":\"span\",\"marks\":[\"vob50vqk\"],\"text\":\"larger study\"},{\"_key\":\"rav4a6kc\",\"_type\":\"span\",\"marks\":[],\"text\":\" through the \"},{\"_key\":\"tx6labe8\",\"_type\":\"span\",\"marks\":[\"q0wg5zen\"],\"text\":\"Frontier Model Forum\"},{\"_key\":\"f0mh1um9\",\"_type\":\"span\",\"marks\":[],\"text\":\" (FMF) to further investigate the ability of AI to aid people engaged in real tasks in a laboratory. In conjunction with the pandemic prevention non-profit \"},{\"_key\":\"accvddxr\",\"_type\":\"span\",\"marks\":[\"aumte217\"],\"text\":\"Sentinel Bio\"},{\"_key\":\"81hm7axv\",\"_type\":\"span\",\"marks\":[],\"text\":\", this wet lab study will gather evidence by simulating many of the scenarios with which we are concerned, including whether AI can uplift non-experts to the point of being able to carry out expert-level laboratory biology tasks. The performance of the control group will provide a better sense of the degree to which tacit knowledge limits non-expert performance in a lab, and the comparison to the treatment group will provide a clearer measure of uplift due to the larger sample size of this trial.\"}],\"markDefs\":[{\"_key\":\"vob50vqk\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.frontiermodelforum.org/updates/latest-from-the-fmf-grant-making-to-address-ai-bio-risk-challenges/\"},{\"_key\":\"q0wg5zen\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.frontiermodelforum.org/\"},{\"_key\":\"aumte217\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://sentinelbio.org/\"}],\"style\":\"normal\"},{\"_key\":\"h34gv0me\",\"_type\":\"block\",\"children\":[{\"_key\":\"dtqfxlsq\",\"_type\":\"span\",\"marks\":[],\"text\":\"We look forward to learning more from the results of this study, which will be important to informing our assessment of risk.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"nstf1ld1\",\"_type\":\"block\",\"children\":[{\"_key\":\"v5sw8g3n\",\"_type\":\"span\",\"marks\":[],\"text\":\"What can be done to address biorisk?\"}],\"markDefs\":[],\"style\":\"h3\"},{\"_key\":\"h6f9ufut\",\"_type\":\"block\",\"children\":[{\"_key\":\"p0ulyakp\",\"_type\":\"span\",\"marks\":[],\"text\":\"Information sharing\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"alip85lj\",\"_type\":\"block\",\"children\":[{\"_key\":\"k4tijkkp\",\"_type\":\"span\",\"marks\":[],\"text\":\"We are currently focused on evaluating the ability of AI models to assist non-experts in producing biological threats, which is informed by consultations with biodefense experts and our understanding of the evolving capabilities of LLMs. \"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"yf1ft6i7\",\"_type\":\"block\",\"children\":[{\"_key\":\"89zqdsll\",\"_type\":\"span\",\"marks\":[],\"text\":\"Still, we recognize that this is far from the only scenario in which AI could contribute to biorisk. We invest in studying these scenarios, but governments have differentiated knowledge and expertise of the plans and intentions of threat actors. We have benefited immensely from the insights gained through our voluntary collaborations and pre-deployment testing with the US \"},{\"_key\":\"hm3pt06u\",\"_type\":\"span\",\"marks\":[\"vh2t6sem\"],\"text\":\"Center for AI Standards and Innovation\"},{\"_key\":\"4h57hwwl\",\"_type\":\"span\",\"marks\":[],\"text\":\" (CAISI) and the UK \"},{\"_key\":\"bftwzpnv\",\"_type\":\"span\",\"marks\":[\"9wigjxmv\"],\"text\":\"AI Security Institute\"},{\"_key\":\"l6y84lrf\",\"_type\":\"span\",\"marks\":[],\"text\":\" and look forward to additional opportunities to deepen our collaboration with governments. \"},{\"_key\":\"z9dfyz43\",\"_type\":\"span\",\"marks\":[\"3osbo6ap\"],\"text\":\"Public-private partnerships\"},{\"_key\":\"bvj1o7vu\",\"_type\":\"span\",\"marks\":[],\"text\":\" in which government expertise in understanding the threat landscape complement industry knowledge of cutting edge AI are a promising path to optimizing the evaluation and mitigation of biorisk.\"}],\"markDefs\":[{\"_key\":\"vh2t6sem\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.nist.gov/caisi\"},{\"_key\":\"9wigjxmv\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.aisi.gov.uk/\"},{\"_key\":\"3osbo6ap\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://red.anthropic.com/2025/nuclear-safeguards/\"}],\"style\":\"normal\"},{\"_key\":\"m0spgvhm\",\"_type\":\"block\",\"children\":[{\"_key\":\"r34xnsf1\",\"_type\":\"span\",\"marks\":[],\"text\":\"We believe it’s important to support transparency norms—like the push for developers to have a Secure Development Framework (like Anthropic’s \"},{\"_key\":\"jt1hy62m\",\"_type\":\"span\",\"marks\":[\"6e4p0aae\"],\"text\":\"Responsible Scaling Policy\"},{\"_key\":\"0cg0bh48\",\"_type\":\"span\",\"marks\":[],\"text\":\") and publish results of model evaluations for dangerous capabilities—in order to inform society about the implications of AI as models continue to grow in capabilities.\"}],\"markDefs\":[{\"_key\":\"6e4p0aae\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.anthropic.com/rsp-updates\"}],\"style\":\"normal\"},{\"_key\":\"pef0dghj\",\"_type\":\"block\",\"children\":[{\"_key\":\"keqksszb\",\"_type\":\"span\",\"marks\":[],\"text\":\"Deployment safeguards\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"vlg9el5g\",\"_type\":\"block\",\"children\":[{\"_key\":\"auoaxxp5\",\"_type\":\"span\",\"marks\":[],\"text\":\"We have developed automated deployment safeguards based on our \"},{\"_key\":\"daakfcox\",\"_type\":\"span\",\"marks\":[\"ekbbbtvu\"],\"text\":\"constitutional classifiers\"},{\"_key\":\"mgeteoud\",\"_type\":\"span\",\"marks\":[],\"text\":\" research. These classifier guards work by monitoring inputs and outputs in real time and blocking a narrow class of potentially harmful information. We apply this protection to models for which we cannot rule out their potential to meaningfully uplift threat actors; to date this is only the Claude Opus 4 family of models, which we did as a \"},{\"_key\":\"9anlzqv9\",\"_type\":\"span\",\"marks\":[\"r1cvkktj\"],\"text\":\"precautionary measure\"},{\"_key\":\"ehl777t4\",\"_type\":\"span\",\"marks\":[],\"text\":\". (For more details on our implementation of ASL-3 protections, see this \"},{\"_key\":\"qo53tyyc\",\"_type\":\"span\",\"marks\":[\"22xhk85z\"],\"text\":\"report\"},{\"_key\":\"kghwzi50\",\"_type\":\"span\",\"marks\":[],\"text\":\".)\"}],\"markDefs\":[{\"_key\":\"ekbbbtvu\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.anthropic.com/research/constitutional-classifiers\"},{\"_key\":\"r1cvkktj\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.anthropic.com/news/activating-asl3-protections\"},{\"_key\":\"22xhk85z\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www-cdn.anthropic.com/807c59454757214bfd37592d6e048079cd7a7728.pdf\"}],\"style\":\"normal\"},{\"_key\":\"xdb0d3oo\",\"_type\":\"block\",\"children\":[{\"_key\":\"iklbw4w3\",\"_type\":\"span\",\"marks\":[],\"text\":\"Across all models, our \"},{\"_key\":\"tjxtdqcu\",\"_type\":\"span\",\"marks\":[\"mves5o1o\"],\"text\":\"Safeguards\"},{\"_key\":\"ugx84unq\",\"_type\":\"span\",\"marks\":[],\"text\":\" team monitors activity on our platforms for signs of misuse, including dangerous applications of biology. This monitoring provides insight into patterns of misuse and helps us determine if and when to take enforcement action.\"}],\"markDefs\":[{\"_key\":\"mves5o1o\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.anthropic.com/news/building-safeguards-for-claude\"}],\"style\":\"normal\"},{\"_key\":\"uxbofuj0\",\"_type\":\"block\",\"children\":[{\"_key\":\"h2iib91h\",\"_type\":\"span\",\"marks\":[],\"text\":\"National action\"}],\"markDefs\":[],\"style\":\"h4\"},{\"_key\":\"eq2fzxq6\",\"_type\":\"block\",\"children\":[{\"_key\":\"oved8t1f\",\"_type\":\"span\",\"marks\":[],\"text\":\"We are heartened to see investment in biosecurity as a key component of the new US \"},{\"_key\":\"p3qb9g27\",\"_type\":\"span\",\"marks\":[\"9wpxnw6s\"],\"text\":\"AI Action Plan\"},{\"_key\":\"6rk5de2i\",\"_type\":\"span\",\"marks\":[],\"text\":\". Both the emphasis on national security evaluations through the CAISI and the move to bolster nucleic acid synthesis screening will help build more resilience to biorisk.\"}],\"markDefs\":[{\"_key\":\"9wpxnw6s\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://whitehouse.gov/wp-content/uploads/2025/07/Americas-AI-Action-Plan.pdf\"}],\"style\":\"normal\"},{\"_key\":\"ujo1p10m\",\"_type\":\"block\",\"children\":[{\"_key\":\"ttgi0ioh\",\"_type\":\"span\",\"marks\":[],\"text\":\"The topic of AI and biorisk is rife with uncertainty—about threat actors, the capabilities of models, and how exactly those capabilities translate to risk. But we believe that a growing body of evidence about AI and the underlying gravity of biological threats mean that this is a topic to which AI developers and policymakers must attend. We will be sharing more about our work on biorisk to advance this critical conversation.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"footnotes\":{\"body\":\"$6:1:props:children:2:props:children:props:children:1:props:children:props:body\",\"count\":0,\"numberByListItemKey\":{},\"referenced\":\"$W1c\"},\"sidebar\":{\"isVisible\":false}}]}],\"$L1d\",\"$L1e\",\"$L1f\"]}]}],\"$L20\"]}]]\n9:null\ne:[[\"$\",\"title\",\"0\",{\"children\":\"LLMs and biorisk \\\\ Anthropic\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"This article explains why we believe that evaluating biorisk and safeguarding against it is a critical element of responsible AI development.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"msapplication-TileColor\",\"content\":\"141413\"}],[\"$\",\"meta\",\"3\",{\"name\":\"msapplication-config\",\"content\":\"/browserconfig.xml\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://www.anthropic.com/research/biorisk\"}],[\"$\",\"meta\",\"5\",{\"name\":\"google-site-verification\",\"content\":\"BqiAW_sWOg-KrPk-Accxm6ge9dtnFEyV6DB6vzVZSGs\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"LLMs and biorisk\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"This article explains why we believe that evaluating biorisk and safeguarding against it is a critical element of responsible AI development.\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:image\",\"content\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/3765b916249947d7e8652906724ef6ed96f9f934-1200x630.jpg\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:image:alt\",\"content\":\"Anthropic logo\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"11\",{\"property\":\"article:published_time\",\"content\":\"2025-09-05T00:00:00.000Z\"}],[\"$\",\"meta\",\"12\",{\"property\":\"article:modified_time\",\"content\":\"2026-07-08T20:53:48.000Z\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:site\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:creator\",\"content\":\"@AnthropicAI\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:title\",\"content\":\"LLMs and biorisk\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:description\",\"content\":\"This article explains why we believe that evaluating biorisk and safeguarding against it is a critical element of responsible AI development.\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:image\",\"content\":\"https://www-cdn.anthropic.com/images/4zrzovbb/website/3765b916249947d7e8652906724ef6ed96f9f934-1200x630.jpg\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:image:alt\",\"content\":\"Anthropic logo\"}],[\"$\",\"link\",\"20\",{\"rel\":\"shortcut icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"21\",{\"rel\":\"icon\",\"href\":\"/images/icons/favicon-32x32.png\"}],[\"$\",\"link\",\"22\",{\"rel\":\"apple-touch-icon\",\"href\":\"/images/icons/apple-touch-icon.png\"}],[\"$\",\"link\",\"23\",{\"rel\":\"apple-touch-icon\",\"href\":\"/images/icons/apple-touch-icon.png\",\"sizes\":\"180x180\"}],[\"$\",\"link\",\"24\",{\"rel\":\"mask-icon\",\"href\":\"/images/icons/safari-pinned-tab.svg\",\"color\":\"141413\"}],[\"$\",\"$L21\",\"25\",{}]]\n22:I[645533,[\"/_next/static/chunks/1fvd0nqqmo54p.js\",\"/_next/static/chunks/2hwbhylgw726z.js\",\"/_next/static/ch