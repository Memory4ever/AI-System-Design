ks/2hwbhylgw726z.js\",\"/_next/static/chunks/3p5jmm60ya981.js\",\"/_next/static/chunks/2jb2vo5bbt4aq.js\",\"/_next/static/chunks/3uj_4q3griim_.js\",\"/_next/static/chunks/1nhl105b9imrb.js\",\"/_next/static/chunks/2q7zgbd7qicdr.js\",\"/_next/static/chunks/0nawt0ap340lw.js\",\"/_next/static/chunks/3syu72y118s_7.js\"],\"IconLogoMark\"]\n1d:[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__postFooter\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__footnotes\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"headline-5\",\"children\":\"Footnotes\"}],[[\"$\",\"p\",\"b23bkzov\",{\"children\":[\"[1] This is based on a review of the published safety frameworks collected by METR at \",[\"$\",\"a\",\"hsggj5t0\",{\"href\":\"https://metr.org/faisc\",\"children\":[\"https://metr.org/faisc\"]}],\" as of July 2025.\"]}],[\"$\",\"p\",\"krt0ksf0\",{\"children\":[\"[2] Indeed, the magnitude of this risk (and even our ability to meaningfully estimate the magnitude) is a source of healthy debate within Anthropic.\"]}],[\"$\",\"p\",\"0yfd7ky1\",{\"children\":[\"[3] These results provide an important update to previous research. An \",[\"$\",\"a\",\"f3g5s6hj\",{\"href\":\"https://www.rand.org/pubs/research_reports/RRA2977-2.html\",\"children\":[\"experiment\"]}],\" conducted in 2023 with a similar research design found no statistically significant difference between biological weapons attack plans formulated with LLMs as opposed to only the internet. However, as the study authors noted at the time, “[g]iven the rapid evolution of AI, it is prudent to monitor future developments in LLM technology.” Frontier AI models are substantially better in mid-2025 than they were in late-2023, and our results demonstrate that they are now showing clearer warning signs of contributing to biorisk.\"]}]]]}],[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__socialShare\",\"children\":[[\"$\",\"a\"