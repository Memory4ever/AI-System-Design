<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 7: </span>Prompt used for the Questioning agent in <span id="A1.F7.2" class="ltx_text ltx_font_typewriter">MAGneT</span>.</figcaption>
</figure>
<figure id="A1.F8" class="ltx_figure"><object type="image/svg+xml" data="2509.04183v1/solutions.svg" id="A1.F8.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:628/589;" width="628" height="589"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 8: </span>Prompt used for the Solutions agent in <span id="A1.F8.2" class="ltx_text ltx_font_typewriter">MAGneT</span>.</figcaption>
</figure>
<figure id="A1.F9" class="ltx_figure"><object type="image/svg+xml" data="2509.04183v1/normalization.svg" id="A1.F9.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:628/589;" width="628" height="589"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 9: </span>Prompt used for the Normalizing agent in <span id="A1.F9.2" class="ltx_text ltx_font_typewriter">MAGneT</span>.</figcaption>
</figure>
<figure id="A1.F10" class="ltx_figure"><object type="image/svg+xml" data="2509.04183v1/psychoed.svg" id="A1.F10.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:628/589;" width="628" height="589"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 10: </span>Prompt used for the Psycho-education agent in <span id="A1.F10.2" class="ltx_text ltx_font_typewriter">MAGneT</span>.</figcaption>
</figure>
<figure id="A1.F11" class="ltx_figure"><object type="image/svg+xml" data="2509.04183v1/technique.svg" id="A1.F11.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:628/456;" width="628" height="456"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 11: </span>Prompt used for the Technique agent in <span id="A1.F11.2" class="ltx_text ltx_font_typewriter">MAGneT</span>.</figcaption>
</figure>
