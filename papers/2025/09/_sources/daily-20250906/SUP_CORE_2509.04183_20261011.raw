<td id="S3.T3.1.6.7" class="ltx_td ltx_align_center"><span id="S3.T3.1.6.7.1" class="ltx_text ltx_markedasmath ltx_font_bold">3.76</span></td>
<td id="S3.T3.1.6.8" class="ltx_td ltx_align_center"><span id="S3.T3.1.6.8.1" class="ltx_text ltx_markedasmath ltx_font_bold">2.93</span></td>
