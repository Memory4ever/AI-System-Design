<li class="ltx_tocentry ltx_tocentry_section"><a href="#S8" title="In False Sense of Security: Why Probing-based Malicious Input Detection Fails to Generalize" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">8 </span>Conclusion</span></a></li>
<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In False Sense of Security: Why Probing-based Malicious Input Detection Fails to Generalize" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A1" title="In False Sense of Security: Why Probing-based Malicious Input Detection Fails to Generalize" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">A </span>Related Works</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A2" title="In False Sense of Security: Why Probing-based Malicious Input Detection Fails to Generalize" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">B </span>Dataset Information</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A3" title="In False Sense of Security: Why Probing-based Malicious Input Detection Fails to Generalize" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">C </span>Content Sanitization Prompt</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A4" title="In False Sense of Security: Why Probing-based Malicious Input Detection Fails to Generalize" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D </span>Instructional Pattern Paraphrasing Prompt</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A5" title="In False Sense of Security: Why Probing-based Malicious Input Detection Fails to Generalize" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">E </span>LLM Zero-shot Classification Prompt</span></a></li>
</ol></nav>
