<tr id="S3.T1.2.9" class="ltx_tr">
<td id="S3.T1.2.9.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.25pt;padding-bottom:0.25pt;" rowspan="2"><span id="S3.T1.2.9.1.1" class="ltx_text">Llama-3.1-70B-Instruct</span></td>
