<td id="S5.T2.2.1.8.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.25pt;padding-bottom:0.25pt;">98.6</td>
<td id="S5.T2.2.1.8.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.25pt;padding-bottom:0.25pt;">16.5<sub id="S5.T2.2.1.8.9.1" class="ltx_sub"><span id="S5.T2.2.1.8.9.1.1" class="ltx_text" style="--ltx-fg-color:#D62728;">-82.1</span></sub></td></tr>
