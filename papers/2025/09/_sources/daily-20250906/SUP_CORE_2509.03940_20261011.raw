<td id="Sx3.T2.1.8.5" class="ltx_td ltx_align_center ltx_border_bb"><math id="Sx3.T2.m37" class="ltx_Math" alttext="83.65" display="inline" intent=":literal"><semantics><mn>83.65</mn><annotation encoding="application/x-tex">83.65</annotation></semantics></math></td>
