</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S5.F3.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.25198v1/hydro.png" id="S5.F3.sf4.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/476;" width="476" height="476" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F3.sf4.3" class="ltx_text" style="font-size:90%;">(d)</span> </span><span id="S5.F3.sf4.4" class="ltx_text" style="font-size:90%;">Hydrophobic surface view of binding site with bound ligand</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F3.4" class="ltx_text" style="font-size:90%;">Figure 3</span>: </span><span id="S5.F3.5" class="ltx_text" style="font-size:90%;">Renderings of molecule generated by SOLD</span></figcaption>
</figure>
