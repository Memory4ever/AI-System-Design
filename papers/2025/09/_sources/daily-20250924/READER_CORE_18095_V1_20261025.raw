<td id="S4.T2.10.15.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.10.15.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">61.1</span></td>
<td id="S4.T2.10.15.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.10.15.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">61.9</span></td>
