<td id="S4.T2.10.14.8" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.10.14.8.1" class="ltx_text" style="font-size:90%;">58.7</span></td>
