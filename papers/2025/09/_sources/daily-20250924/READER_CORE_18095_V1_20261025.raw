<td id="S4.T2.10.14.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.10.14.2.1" class="ltx_text" style="font-size:90%;">3B</span></td>
<td id="S4.T2.10.14.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.10.14.3.1" class="ltx_text" style="font-size:90%;">63.7</span></td>
