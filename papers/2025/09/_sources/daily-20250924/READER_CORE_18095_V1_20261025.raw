<td id="S4.T2.10.14.6" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.10.14.6.1" class="ltx_text ltx_underline" style="font-size:90%;">62.6</span></td>
