{"data":[{"id":"10.48550/arxiv.2509.16788","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16788","identifiers":[{"identifier":"2509.16788","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Salha","familyName":"Alyami","name":"Alyami, Salha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amani","familyName":"Jamal","name":"Jamal, Amani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Areej","familyName":"Alhothali","name":"Alhothali, Areej","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Domain-Adaptive Pre-Training for Arabic Aspect-Based Sentiment Analysis: A Comparative Study of Domain Adaptation and Fine-Tuning Strategies"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T19:32:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:38:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Aspect-based sentiment analysis (ABSA) in natural language processing enables organizations to understand customer opinions on specific product aspects. While deep learning models are widely used for English ABSA, their application in Arabic is limited due to the scarcity of labeled data. Researchers have attempted to tackle this issue by using pre-trained contextualized language models such as BERT. However, these models are often based on fact-based data, which can introduce bias in domain-specific tasks like ABSA. To our knowledge, no studies have applied adaptive pre-training with Arabic contextualized models for ABSA. This research proposes a novel approach using domain-adaptive pre-training for aspect-sentiment classification (ASC) and opinion target expression (OTE) extraction. We examine fine-tuning strategies - feature extraction, full fine-tuning, and adapter-based methods - to enhance performance and efficiency, utilizing multiple adaptation corpora and contextualized models. Our results show that in-domain adaptive pre-training yields modest improvements. Adapter-based fine-tuning is a computationally efficient method that achieves competitive results. However, error analyses reveal issues with model predictions and dataset labeling. In ASC, common problems include incorrect sentiment labeling, misinterpretation of contrastive markers, positivity bias for early terms, and challenges with conflicting opinions and subword tokenization. For OTE, issues involve mislabeling targets, confusion over syntactic roles, difficulty with multi-word expressions, and reliance on shallow heuristics. These findings underscore the need for syntax- and semantics-aware models, such as graph convolutional networks, to more effectively capture long-distance relations and complex aspect-based opinion alignments."},{"descriptionType":"Other","description":"26 excluding bibliography , journal article"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16788","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:56:36Z","registered":"2025-09-23T02:56:37Z","published":null,"updated":"2025-09-23T02:56:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16784","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16784","identifiers":[{"identifier":"2509.16784","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammed Al","familyName":"Owayyed","name":"Owayyed, Mohammed Al","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adarsh","familyName":"Denga","name":"Denga, Adarsh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Willem-Paul","familyName":"Brinkman","name":"Brinkman, Willem-Paul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Controlled Yet Natural: A Hybrid BDI-LLM Conversational Agent for Child Helpline Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T19:17:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:38:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3717511.3747075","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Child helpline training often relies on human-led roleplay, which is both time- and resource-consuming. To address this, rule-based interactive agent simulations have been proposed to provide a structured training experience for new counsellors. However, these agents might suffer from limited language understanding and response variety. To overcome these limitations, we present a hybrid interactive agent that integrates Large Language Models (LLMs) into a rule-based Belief-Desire-Intention (BDI) framework, simulating more realistic virtual child chat conversations. This hybrid solution incorporates LLMs into three components: intent recognition, response generation, and a bypass mechanism. We evaluated the system through two studies: a script-based assessment comparing LLM-generated responses to human-crafted responses, and a within-subject experiment (N=37) comparing the LLM-integrated agent with a rule-based version. The first study provided evidence that the three LLM components were non-inferior to human-crafted responses. In the second study, we found credible support for two hypotheses: participants perceived the LLM-integrated agent as more believable and reported more positive attitudes toward it than the rule-based agent. Additionally, although weaker, there was some support for increased engagement (posterior probability = 0.845, 95% HDI [-0.149, 0.465]). Our findings demonstrate the potential of integrating LLMs into rule-based systems, offering a promising direction for more flexible but controlled training systems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16784","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T02:56:31Z","registered":"2025-09-23T02:56:31Z","published":null,"updated":"2025-09-23T02:56:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16778","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16778","identifiers":[{"identifier":"2509.16778","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eason","familyName":"Chen","name":"Chen, Eason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sophia","familyName":"Judicke","name":"Judicke, Sophia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kayla","familyName":"Beigh","name":"Beigh, Kayla","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Tang","name":"Tang, Xinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimo","familyName":"Xiao","name":"Xiao, Zimo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuangji","familyName":"Li","name":"Li, Chuangji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shizhuo","familyName":"Li","name":"Li, Shizhuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reed","familyName":"Luttmer","name":"Luttmer, Reed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shreya","familyName":"Singh","name":"Singh, Shreya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria","familyName":"Yampolsky","name":"Yampolsky, Maria","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naman","familyName":"Parikh","name":"Parikh, Naman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Zhao","name":"Zhao, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meiyi","familyName":"Chen","name":"Chen, Meiyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Scarlett","familyName":"Huang","name":"Huang, Scarlett","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anishka","familyName":"Mohanty","name":"Mohanty, Anishka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gregory","familyName":"Johnson","name":"Johnson, Gregory","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Mackey","name":"Mackey, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jionghao","familyName":"Lin","name":"Lin, Jionghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ken","familyName":"Koedinger","name":"Koedinger, Ken","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generative AI alone may not be enough: Evaluating AI Support for Learning Mathematical Proof"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T18:57:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:37:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We evaluate the effectiveness of LLM-Tutor, a large language model (LLM)-powered tutoring system that combines an AI-based proof-review tutor for real-time feedback on proof-writing and a chatbot for mathematics-related queries. Our experiment, involving 148 students, demonstrated that the use of LLM-Tutor significantly improved homework performance compared to a control group without access to the system. However, its impact on exam performance and time spent on tasks was found to be insignificant. Mediation analysis revealed that students with lower self-efficacy tended to use the chatbot more frequently, which partially contributed to lower midterm scores. Furthermore, students with lower self-efficacy were more likely to engage frequently with the proof-review-AI-tutor, a usage pattern that positively contributed to higher final exam scores. Interviews with 19 students highlighted the accessibility of LLM-Tutor and its effectiveness in addressing learning needs, while also revealing limitations and concerns regarding potential over-reliance on the tool. Our results suggest that generative AI alone like chatbot may not suffice for comprehensive learning support, underscoring the need for iterative design improvements with learning sciences principles with generative AI educational tools like LLM-Tutor."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16778","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:56:22Z","registered":"2025-09-23T02:56:23Z","published":null,"updated":"2025-09-23T02:56:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16768","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16768","identifiers":[{"identifier":"2509.16768","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Omid","familyName":"Bonakdar","name":"Bonakdar, Omid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nasser","familyName":"Mozayani","name":"Mozayani, Nasser","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MMPart: Harnessing Multi-Modal Large Language Models for Part-Aware 3D Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T18:25:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:37:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative 3D modeling has advanced rapidly, driven by applications in VR/AR, metaverse, and robotics. However, most methods represent the target object as a closed mesh devoid of any structural information, limiting editing, animation, and semantic understanding. Part-aware 3D generation addresses this problem by decomposing objects into meaningful components, but existing pipelines face challenges: in existing methods, the user has no control over which objects are separated and how model imagine the occluded parts in isolation phase. In this paper, we introduce MMPart, an innovative framework for generating part-aware 3D models from a single image. We first use a VLM to generate a set of prompts based on the input image and user descriptions. In the next step, a generative model generates isolated images of each object based on the initial image and the previous step's prompts as supervisor (which control the pose and guide model how imagine previously occluded areas). Each of those images then enters the multi-view generation stage, where a number of consistent images from different views are generated. Finally, a reconstruction model converts each of these multi-view images into a 3D model."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16768","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:56:09Z","registered":"2025-09-23T02:56:09Z","published":null,"updated":"2025-09-23T02:56:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16742","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16742","identifiers":[{"identifier":"2509.16742","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammad","familyName":"Beigi","name":"Beigi, Mohammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Shen","name":"Shen, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Parshin","familyName":"Shojaee","name":"Shojaee, Parshin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qifan","familyName":"Wang","name":"Wang, Qifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zichao","familyName":"Wang","name":"Wang, Zichao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chandan","familyName":"Reddy","name":"Reddy, Chandan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming","familyName":"Jin","name":"Jin, Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifu","familyName":"Huang","name":"Huang, Lifu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Sycophancy Mitigation Through Reinforcement Learning with Uncertainty-Aware Adaptive Reasoning Trajectories"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T17:09:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:35:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite the remarkable capabilities of large language models, current training paradigms inadvertently foster \\textit{sycophancy}, i.e., the tendency of a model to agree with or reinforce user-provided information even when it's factually incorrect. To address this challenge, we introduce \\textbf{SMART} (Sycophancy Mitigation through Adaptive Reasoning Trajectories), which reframes sycophancy as a \\textit{reasoning optimization problem} rather than an output alignment issue. SMART is a two-stage framework comprising: (1) Uncertainty-Aware Adaptive Monte Carlo Tree Search (UA-MCTS), which dynamically adjusts model exploration based on state-level uncertainty to collect high-quality, diverse reasoning trajectories alongside both stepwise progress and final outcome rewards; and (2) progress-based reinforcement learning, which fine-tunes the model using the collected trajectories and reward signals to reinforce effective reasoning patterns. Through extensive experiments, we show that SMART significantly reduces sycophantic behavior while preserving strong performance on out-of-distribution inputs and maintaining general capabilities. These results underscore the importance of optimizing internal reasoning mechanisms to build more truthful and aligned AI assistants."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16742","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:55:32Z","registered":"2025-09-23T02:55:33Z","published":null,"updated":"2025-09-23T02:55:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16736","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16736","identifiers":[{"identifier":"2509.16736","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minfeng","familyName":"Qi","name":"Qi, Minfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianqing","familyName":"Zhu","name":"Zhu, Tianqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lefeng","familyName":"Zhang","name":"Zhang, Lefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ningran","familyName":"Li","name":"Li, Ningran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wanlei","familyName":"Zhou","name":"Zhou, Wanlei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Transparent and Incentive-Compatible Collaboration in Decentralized LLM Multi-Agent Systems: A Blockchain-Driven Approach"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Multiagent Systems (cs.MA)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T16:00:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:34:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have enabled the emergence of autonomous agents capable of complex reasoning, planning, and interaction. However, coordinating such agents at scale remains a fundamental challenge, particularly in decentralized environments where communication lacks transparency and agent behavior cannot be shaped through centralized incentives. We propose a blockchain-based framework that enables transparent agent registration, verifiable task allocation, and dynamic reputation tracking through smart contracts. The core of our design lies in two mechanisms: a matching score-based task allocation protocol that evaluates agents by reputation, capability match, and workload; and a behavior-shaping incentive mechanism that adjusts agent behavior via feedback on performance and reward. Our implementation integrates GPT-4 agents with Solidity contracts and demonstrates, through 50-round simulations, strong task success rates, stable utility distribution, and emergent agent specialization. The results underscore the potential for trustworthy, incentive-compatible multi-agent coordination in open environments."},{"descriptionType":"Other","description":"17 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16736","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:55:24Z","registered":"2025-09-23T02:55:25Z","published":null,"updated":"2025-09-23T02:55:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16721","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16721","identifiers":[{"identifier":"2509.16721","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoyuan","familyName":"Li","name":"Li, Haoyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Liu","name":"Liu, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hehe","familyName":"Fan","name":"Fan, Hehe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Yang","name":"Yang, Yi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Text-Scene: A Scene-to-Language Parsing Framework for 3D Scene Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T15:10:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:33:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Enabling agents to understand and interact with complex 3D scenes is a fundamental challenge for embodied artificial intelligence systems. While Multimodal Large Language Models (MLLMs) have achieved significant progress in 2D image understanding, extending such capabilities to 3D scenes remains difficult: 1) 3D environment involves richer concepts such as spatial relationships, affordances, physics, layout, and so on, 2) the absence of large-scale 3D vision-language datasets has posed a significant obstacle. In this paper, we introduce Text-Scene, a framework that automatically parses 3D scenes into textual descriptions for scene understanding. Given a 3D scene, our model identifies object attributes and spatial relationships, and then generates a coherent summary of the whole scene, bridging the gap between 3D observation and language without requiring human-in-the-loop intervention. By leveraging both geometric analysis and MLLMs, Text-Scene produces descriptions that are accurate, detailed, and human-interpretable, capturing object-level details and global-level context. Experimental results on benchmarks demonstrate that our textual parses can faithfully represent 3D scenes and benefit downstream tasks. To evaluate the reasoning capability of MLLMs, we present InPlan3D, a comprehensive benchmark for 3D task planning, consisting of 3174 long-term planning tasks across 636 indoor scenes. We emphasize clarity and accessibility in our approach, aiming to make 3D scene content understandable through language. Code and datasets will be released."},{"descriptionType":"Other","description":"19 pages, 12 figures, 6 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16721","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:55:03Z","registered":"2025-09-23T02:55:04Z","published":null,"updated":"2025-09-23T02:55:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16720","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16720","identifiers":[{"identifier":"2509.16720","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Auss","familyName":"Abbood","name":"Abbood, Auss","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zaiqiao","familyName":"Meng","name":"Meng, Zaiqiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nigel","familyName":"Collier","name":"Collier, Nigel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Time to Revist Exact Match"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T15:10:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:33:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Temporal question answering is an established method for evaluating temporal reasoning in large language models. Expected answers are often numeric (e.g., dates or durations), yet model responses are evaluated like regular text with exact match (EM), unable to distinguish small from large errors. In this investigative work, we frame temporal question answering as a numerical estimation task to assess the shortcomings of EM. We introduce TempAnswerQA, a benchmark distilled from Test of Time and TempTabQA, where all questions require a numerical, temporal answer, allowing us to evaluate models beyond EM. We use the forecasting metrics symmetric mean absolute percentage error (sMAPE) and mean absolute scaled error (MASE). With sMAPE, we find that error size and EM are decoupled. Models with low EM still have low sMAPE (both ~20%), and some models have high sMAPE despite high EM. Scaling errors by the deviation of the ground truth data with MASE reshuffles model rankings compared to EM, revealing gaps in models' understanding of temporal domain knowledge, especially when trained with synthetic data. Lastly, the models' most frequent error is to deviate by only $\\pm1$ from the ground truth. sMAPE and MASE, unlike EM, adequately weight these errors. Our findings underscore the need for specialised metrics for temporal QA tasks. Code and data are available on https://github.com/aauss/temporal-answer-qa."},{"descriptionType":"Other","description":"Accepted for Findings of EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16720","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:55:02Z","registered":"2025-09-23T02:55:02Z","published":null,"updated":"2025-09-23T02:55:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16713","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16713","identifiers":[{"identifier":"2509.16713","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyang","familyName":"Xu","name":"Xu, Tianyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongqiu","familyName":"Wu","name":"Wu, Hongqiu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiqi","familyName":"Wu","name":"Wu, Weiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hai","familyName":"Zhao","name":"Zhao, Hai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OPEN-THEATRE: An Open-Source Toolkit for LLM-based Interactive Drama"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T14:53:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:33:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"LLM-based Interactive Drama introduces a novel dialogue scenario in which the player immerses into a character and engages in a dramatic story by interacting with LLM agents. Despite the fact that this emerging area holds significant promise, it remains largely underexplored due to the lack of a well-designed playground to develop a complete drama. This makes a significant barrier for researchers to replicate, extend, and study such systems. Hence, we present Open-Theatre, the first open-source toolkit for experiencing and customizing LLM-based interactive drama. It refines prior work with an efficient multi-agent architecture and a hierarchical retrieval-based memory system, designed to enhance narrative coherence and realistic long-term behavior in complex interactions. In addition, we provide a highly configurable pipeline, making it easy for researchers to develop and optimize new approaches."},{"descriptionType":"Other","description":"Accepted by EMNLP 2025 demo"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16713","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:54:52Z","registered":"2025-09-23T02:54:53Z","published":null,"updated":"2025-09-23T02:54:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16701","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16701","identifiers":[{"identifier":"2509.16701","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shunyu","familyName":"Liu","name":"Liu, Shunyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangdong","familyName":"Bai","name":"Bai, Guangdong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Utting","name":"Utting, Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guowei","familyName":"Yang","name":"Yang, Guowei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RelRepair: Enhancing Automated Program Repair by Retrieving Relevant Code"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"D.2.5; I.2.2; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-20T14:07:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:32:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Automated Program Repair (APR) has emerged as a promising paradigm for reducing debugging time and improving the overall efficiency of software development. Recent advances in Large Language Models (LLMs) have demonstrated their potential for automated bug fixing and other software engineering tasks. Nevertheless, the general-purpose nature of LLM pre-training means these models often lack the capacity to perform project-specific repairs, which require understanding of domain-specific identifiers, code structures, and contextual relationships within a particular codebase. As a result, LLMs may struggle to generate correct patches when the repair depends on project-specific information.\n To address this limitation, we introduce RelRepair, a novel approach that retrieves relevant project-specific code to enhance automated program repair. RelRepair first identifies relevant function signatures by analyzing function names and code comments within the project. It then conducts deeper code analysis to retrieve code snippets relevant to the repair context. The retrieved relevant information is then incorporated into the LLM's input prompt, guiding the model to generate more accurate and informed patches. We evaluate RelRepair on two widely studied datasets, Defects4J V1.2 and ManySStuBs4J, and compare its performance against several state-of-the-art LLM-based APR approaches. RelRepair successfully repairs 101 bugs in Defects4J V1.2. Furthermore, RelRepair achieves a 17.1\\% improvement in the ManySStuBs4J dataset, increasing the overall fix rate to 48.3\\%. These results highlight the importance of providing relevant project-specific information to LLMs, shedding light on effective strategies for leveraging LLMs in APR tasks."},{"descriptionType":"Other","description":"11 pages, 5 figures, under review at TSE"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16701","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:54:35Z","registered":"2025-09-23T02:54:36Z","published":null,"updated":"2025-09-23T02:54:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16696","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16696","identifiers":[{"identifier":"2509.16696","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wataru","familyName":"Hashimoto","name":"Hashimoto, Wataru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hidetaka","familyName":"Kamigaito","name":"Kamigaito, Hidetaka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taro","familyName":"Watanabe","name":"Watanabe, Taro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Decoding Uncertainty: The Impact of Decoding Strategies for Uncertainty Estimation in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T13:48:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:31:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Decoding strategies manipulate the probability distribution underlying the output of a language model and can therefore affect both generation quality and its uncertainty. In this study, we investigate the impact of decoding strategies on uncertainty estimation in Large Language Models (LLMs). Our experiments show that Contrastive Search, which mitigates repetition, yields better uncertainty estimates on average across a range of preference-aligned LLMs. In contrast, the benefits of these strategies sometimes diverge when the model is only post-trained with supervised fine-tuning, i.e. without explicit alignment."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16696","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:54:28Z","registered":"2025-09-23T02:54:29Z","published":null,"updated":"2025-09-23T02:54:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16686","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16686","identifiers":[{"identifier":"2509.16686","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhengge","familyName":"Cai","name":"Cai, Zhengge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haowen","familyName":"Hou","name":"Hou, Haowen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"EG-MLA: Embedding-Gated Multi-head Latent Attention for Scalable and Efficient LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T13:27:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:30:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reducing the key-value (KV) cache size is a crucial step toward enabling efficient inference in large language models (LLMs), especially under latency and memory constraints. While Multi-Head Attention (MHA) offers strong representational power, it incurs significant memory overhead. Recent work on Multi-head Latent Attention (MLA) mitigates this by compressing KV representations into a shared latent space, achieving a better trade-off between performance and cache efficiency. While MLA already achieves significant KV cache reduction, the scope for further compression remains limited without performance loss. In this paper, we propose \\textbf{Embedding-Gated Multi-head Latent Attention (EG-MLA)}, a novel extension of MLA that further reduces KV cache size while enhancing representational expressiveness. EG-MLA introduces a token-specific embedding gating mechanism applied in the latent space, enabling fine-grained modulation of compressed KV vectors with minimal additional computation. Compared to MHA, EG-MLA achieves over 91.6\\% reduction in KV cache size with negligible performance degradation. Relative to MLA, EG-MLA consistently improves task accuracy across diverse reasoning benchmarks while achieving up to 59.9\\% additional memory savings. Our theoretical analysis highlights how embedding gating induces implicit high-order interactions, and empirical evaluations demonstrate robust generalization across model scales and compression regimes. Notably, we successfully scale EG-MLA to over 1 billion parameters, demonstrating its practical viability for large-scale LLM deployment. These results establish EG-MLA as a memory- and compute-efficient attention mechanism that enables scalable, high-performance inference in modern LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16686","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:54:14Z","registered":"2025-09-23T02:54:15Z","published":null,"updated":"2025-09-23T02:54:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16682","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16682","identifiers":[{"identifier":"2509.16682","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Javier","familyName":"Jiménez-Román","name":"Jiménez-Román, Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Florina","familyName":"Almenares-Mendoza","name":"Almenares-Mendoza, Florina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alfonso","familyName":"Sánchez-Macián","name":"Sánchez-Macián, Alfonso","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Design and Development of an Intelligent LLM-based LDAP Honeypot"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T13:16:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:30:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Cybersecurity threats continue to increase, with a growing number of previously unknown attacks each year targeting both large corporations and smaller entities. This scenario demands the implementation of advanced security measures, not only to mitigate damage but also to anticipate emerging attack trends. In this context, deception tools have become a key strategy, enabling the detection, deterrence, and deception of potential attackers while facilitating the collection of information about their tactics and methods. Among these tools, honeypots have proven their value, although they have traditionally been limited by rigidity and configuration complexity, hindering their adaptability to dynamic scenarios. The rise of artificial intelligence, and particularly general-purpose Large Language Models (LLMs), is driving the development of new deception solutions capable of offering greater adaptability and ease of use. This work proposes the design and implementation of an LLM-based honeypot to simulate an LDAP server, a critical protocol present in most organizations due to its central role in identity and access management. The proposed solution aims to provide a flexible and realistic tool capable of convincingly interacting with attackers, thereby contributing to early detection and threat analysis while enhancing the defensive capabilities of infrastructures against intrusions targeting this service."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16682","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:54:09Z","registered":"2025-09-23T02:54:09Z","published":null,"updated":"2025-09-23T02:54:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16679","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16679","identifiers":[{"identifier":"2509.16679","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Keliang","familyName":"Liu","name":"Liu, Keliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingkang","familyName":"Yang","name":"Yang, Dingkang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyun","familyName":"Qian","name":"Qian, Ziyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weijie","familyName":"Yin","name":"Yin, Weijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchi","familyName":"Wang","name":"Wang, Yuchi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongsheng","familyName":"Li","name":"Li, Hongsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Liu","name":"Liu, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Zhai","name":"Zhai, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Liu","name":"Liu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lihua","familyName":"Zhang","name":"Zhang, Lihua","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reinforcement Learning Meets Large Language Models: A Survey of Advancements and Applications Across the LLM Lifecycle"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T13:11:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:30:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In recent years, training methods centered on Reinforcement Learning (RL) have markedly enhanced the reasoning and alignment performance of Large Language Models (LLMs), particularly in understanding human intents, following user instructions, and bolstering inferential strength. Although existing surveys offer overviews of RL augmented LLMs, their scope is often limited, failing to provide a comprehensive summary of how RL operates across the full lifecycle of LLMs. We systematically review the theoretical and practical advancements whereby RL empowers LLMs, especially Reinforcement Learning with Verifiable Rewards (RLVR). First, we briefly introduce the basic theory of RL. Second, we thoroughly detail application strategies for RL across various phases of the LLM lifecycle, including pre-training, alignment fine-tuning, and reinforced reasoning. In particular, we emphasize that RL methods in the reinforced reasoning phase serve as a pivotal driving force for advancing model reasoning to its limits. Next, we collate existing datasets and evaluation benchmarks currently used for RL fine-tuning, spanning human-annotated datasets, AI-assisted preference data, and program-verification-style corpora. Subsequently, we review the mainstream open-source tools and training frameworks available, providing clear practical references for subsequent research. Finally, we analyse the future challenges and trends in the field of RL-enhanced LLMs. This survey aims to present researchers and practitioners with the latest developments and frontier trends at the intersection of RL and LLMs, with the goal of fostering the evolution of LLMs that are more intelligent, generalizable, and secure."},{"descriptionType":"Other","description":"A Survey of Reinforcement Learning for Large Language Models"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16679","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:54:03Z","registered":"2025-09-23T02:54:04Z","published":null,"updated":"2025-09-23T02:54:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16676","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16676","identifiers":[{"identifier":"2509.16676","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nauman Ali","familyName":"Murad","name":"Murad, Nauman Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Safia","familyName":"Baloch","name":"Baloch, Safia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Governed By Agents: A Survey On The Role Of Agentic AI In Future Computing Environments"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T13:03:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:30:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The emergence of agentic Artificial Intelligence (AI), which can operate autonomously, demonstrate goal-directed behavior, and adaptively learn, indicates the onset of a massive change in today's computing infrastructure. This study investigates how agentic AI models' multiple characteristics may impact the architecture, governance, and operation under which computing environments function. Agentic AI has the potential to reduce reliance on extremely large (public) cloud environments due to resource efficiency, especially with processing and/or storage. The aforementioned characteristics provide us with an opportunity to canvas the likelihood of strategic migration in computing infrastructures away from massive public cloud services, towards more locally distributed architectures: edge computing and on-premises computing infrastructures. Many of these likely migrations will be spurred by factors like on-premises processing needs, diminished data consumption footprints, and cost savings. This study examines how a solution for implementing AI's autonomy could result in a re-architecture of the systems and model a departure from today's governance models to help us manage these increasingly autonomous agents, and an operational overhaul of processes over a very diverse computing systems landscape that bring together computing via cloud, edge, and on-premises computing solutions. To enable us to explore these intertwined decisions, it will be fundamentally important to understand how to best position agentic AI, and to navigate the future state of computing infrastructures."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16676","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:59Z","registered":"2025-09-23T02:54:00Z","published":null,"updated":"2025-09-23T02:54:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16673","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16673","identifiers":[{"identifier":"2509.16673","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sinuo","familyName":"Wang","name":"Wang, Sinuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutong","familyName":"Xie","name":"Xie, Yutong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyuan","familyName":"Liu","name":"Liu, Yuyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Wu","name":"Wu, Qi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MedCutMix: A Data-Centric Approach to Improve Radiology Vision-Language Pre-training with Disease Awareness"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T12:51:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:29:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Pre-training (VLP) is drawing increasing interest for its ability to minimize manual annotation requirements while enhancing semantic understanding in downstream tasks. However, its reliance on image-text datasets poses challenges due to privacy concerns and the high cost of obtaining paired annotations. Data augmentation emerges as a viable strategy to address this issue, yet existing methods often fall short of capturing the subtle and complex variations in medical data due to limited diversity. To this end, we propose MedCutMix, a novel multi-modal disease-centric data augmentation method. MedCutMix performs diagnostic sentence CutMix within medical reports and establishes the cross-attention between the diagnostic sentence and medical image to guide attentive manifold mix within the imaging modality. Our approach surpasses previous methods across four downstream radiology diagnosis datasets, highlighting its effectiveness in enhancing performance and generalizability in radiology VLP."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16673","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:55Z","registered":"2025-09-23T02:53:55Z","published":null,"updated":"2025-09-23T02:53:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16671","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16671","identifiers":[{"identifier":"2509.16671","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ekin","familyName":"Böke","name":"Böke, Ekin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon","familyName":"Torka","name":"Torka, Simon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"\"Digital Camouflage\": The LLVM Challenge in LLM-Based Malware Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T12:47:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:29:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) have emerged as promising tools for malware detection by analyzing code semantics, identifying vulnerabilities, and adapting to evolving threats. However, their reliability under adversarial compiler-level obfuscation is yet to be discovered. In this study, we empirically evaluate the robustness of three state-of-the-art LLMs: ChatGPT-4o, Gemini Flash 2.5, and Claude Sonnet 4 against compiler-level obfuscation techniques implemented via the LLVM infrastructure. These include control flow flattening, bogus control flow injection, instruction substitution, and split basic blocks, which are widely used to evade detection while preserving malicious behavior. We perform a structured evaluation on 40~C functions (20 vulnerable, 20 secure) sourced from the Devign dataset and obfuscated using LLVM passes. Our results show that these models often fail to correctly classify obfuscated code, with precision, recall, and F1-score dropping significantly after transformation. This reveals a critical limitation: LLMs, despite their language understanding capabilities, can be easily misled by compiler-based obfuscation strategies. To promote reproducibility, we release all evaluation scripts, prompts, and obfuscated code samples in a public repository. We also discuss the implications of these findings for adversarial threat modeling, and outline future directions such as software watermarking, compiler-aware defenses, and obfuscation-resilient model design."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16671","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:52Z","registered":"2025-09-23T02:53:53Z","published":null,"updated":"2025-09-23T02:53:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16670","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16670","identifiers":[{"identifier":"2509.16670","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenhuan","familyName":"Lu","name":"Lu, Wenhuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyue","familyName":"Song","name":"Song, Xinyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjun","familyName":"Ke","name":"Ke, Wenjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhizhi","familyName":"Yu","name":"Yu, Zhizhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Yang","name":"Yang, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianguo","familyName":"Wei","name":"Wei, Jianguo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Speech-to-See: End-to-End Speech-Driven Open-Set Object Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T12:43:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:29:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Audio grounding, or speech-driven open-set object detection, aims to localize and identify objects directly from speech, enabling generalization beyond predefined categories. This task is crucial for applications like human-robot interaction where textual input is impractical. However, progress in this domain faces a fundamental bottleneck from the scarcity of large-scale, paired audio-image data, and is further constrained by previous methods that rely on indirect, text-mediated pipelines. In this paper, we introduce Speech-to-See (Speech2See), an end-to-end approach built on a pre-training and fine-tuning paradigm. Specifically, in the pre-training stage, we design a Query-Guided Semantic Aggregation module that employs learnable queries to condense redundant speech embeddings into compact semantic representations. During fine-tuning, we incorporate a parameter-efficient Mixture-of-LoRA-Experts (MoLE) architecture to achieve deeper and more nuanced cross-modal adaptation. Extensive experiments show that Speech2See achieves robust and adaptable performance across multiple benchmarks, demonstrating its strong generalization ability and broad applicability."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16670","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:51Z","registered":"2025-09-23T02:53:51Z","published":null,"updated":"2025-09-23T02:53:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16660","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16660","identifiers":[{"identifier":"2509.16660","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zuhair Hasan","familyName":"Shaik","name":"Shaik, Zuhair Hasan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdullah","familyName":"Mazhar","name":"Mazhar, Abdullah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aseem","familyName":"Srivastava","name":"Srivastava, Aseem","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Md Shad","familyName":"Akhtar","name":"Akhtar, Md Shad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Redefining Experts: Interpretable Decomposition of Language Models for Toxicity Mitigation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T12:21:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:29:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models have demonstrated impressive fluency across diverse tasks, yet their tendency to produce toxic content remains a critical challenge for AI safety and public trust. Existing toxicity mitigation approaches primarily manipulate individual neuron activations, but these methods suffer from instability, context dependence, and often compromise the model's core language abilities. To address these shortcomings, we investigate three key questions: the stability of neuron-level toxicity indicators, the advantages of structural (layer-wise) representations, and the interpretability of mechanisms driving toxic generation. Through extensive experiments on Jigsaw and ToxiCN datasets, we show that aggregated layer-wise features provide more robust signals than single neurons. Moreover, we observe conceptual limitations in prior works that conflate toxicity detection experts and generation experts within neuron-based interventions. To mitigate this, we propose a novel principled intervention technique, EigenShift, based on eigen-decomposition of the language model's final output layer. This method selectively targets generation-aligned components, enabling precise toxicity suppression without impairing linguistic competence. Our method requires no additional training or fine-tuning, incurs minimal computational cost, and is grounded in rigorous theoretical analysis."},{"descriptionType":"Other","description":"Accepted to the NeurIPS 2025 Research Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16660","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:36Z","registered":"2025-09-23T02:53:37Z","published":null,"updated":"2025-09-23T02:53:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16649","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16649","identifiers":[{"identifier":"2509.16649","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyun Jun","familyName":"Kim","name":"Kim, Hyun Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyeong Yong","familyName":"Choi","name":"Choi, Hyeong Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changwon","familyName":"Lim","name":"Lim, Changwon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AISTAT lab system for DCASE2025 Task6: Language-based audio retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T11:53:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:28:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This report presents the AISTAT team's submission to the language-based audio retrieval task in DCASE 2025 Task 6. Our proposed system employs dual encoder architecture, where audio and text modalities are encoded separately, and their representations are aligned using contrastive learning. Drawing inspiration from methodologies of the previous year's challenge, we implemented a distillation approach and leveraged large language models (LLMs) for effective data augmentation techniques, including back-translation and LLM mix. Additionally, we incorporated clustering to introduce an auxiliary classification task for further finetuning. Our best single system achieved a mAP@16 of 46.62, while an ensemble of four systems reached a mAP@16 of 48.83 on the Clotho development test split."},{"descriptionType":"Other","description":"5 pages, 1 figure, DCASE2025 Task2 technical report"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16649","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:20Z","registered":"2025-09-23T02:53:21Z","published":null,"updated":"2025-09-23T02:53:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16645","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16645","identifiers":[{"identifier":"2509.16645","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yichen","familyName":"Wang","name":"Wang, Yichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangtao","familyName":"Zhang","name":"Zhang, Hangtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hewen","familyName":"Pan","name":"Pan, Hewen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Zhou","name":"Zhou, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianlong","familyName":"Wang","name":"Wang, Xianlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peijin","familyName":"Guo","name":"Guo, Peijin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lulu","familyName":"Xue","name":"Xue, Lulu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengshan","familyName":"Hu","name":"Hu, Shengshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghui","familyName":"Li","name":"Li, Minghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leo Yu","familyName":"Zhang","name":"Zhang, Leo Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ADVEDM:Fine-grained Adversarial Attack against VLM-based Embodied Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T11:48:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:28:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs), with their strong reasoning and planning capabilities, are widely used in embodied decision-making (EDM) tasks in embodied agents, such as autonomous driving and robotic manipulation. Recent research has increasingly explored adversarial attacks on VLMs to reveal their vulnerabilities. However, these attacks either rely on overly strong assumptions, requiring full knowledge of the victim VLM, which is impractical for attacking VLM-based agents, or exhibit limited effectiveness. The latter stems from disrupting most semantic information in the image, which leads to a misalignment between the perception and the task context defined by system prompts. This inconsistency interrupts the VLM's reasoning process, resulting in invalid outputs that fail to affect interactions in the physical world. To this end, we propose a fine-grained adversarial attack framework, ADVEDM, which modifies the VLM's perception of only a few key objects while preserving the semantics of the remaining regions. This attack effectively reduces conflicts with the task context, making VLMs output valid but incorrect decisions and affecting the actions of agents, thus posing a more substantial safety threat in the physical world. We design two variants of based on this framework, ADVEDM-R and ADVEDM-A, which respectively remove the semantics of a specific object from the image and add the semantics of a new object into the image. The experimental results in both general scenarios and EDM tasks demonstrate fine-grained control and excellent attack performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16645","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:15Z","registered":"2025-09-23T02:53:16Z","published":null,"updated":"2025-09-23T02:53:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16638","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16638","identifiers":[{"identifier":"2509.16638","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinrui","familyName":"Han","name":"Han, Jinrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiji","familyName":"Xie","name":"Xie, Weiji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiakun","familyName":"Zheng","name":"Zheng, Jiakun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiyuan","familyName":"Shi","name":"Shi, Jiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weinan","familyName":"Zhang","name":"Zhang, Weinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting","familyName":"Xiao","name":"Xiao, Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenjia","familyName":"Bai","name":"Bai, Chenjia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KungfuBot2: Learning Versatile Motion Skills for Humanoid Whole-Body Control"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T11:31:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:27:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Learning versatile whole-body skills by tracking various human motions is a fundamental step toward general-purpose humanoid robots. This task is particularly challenging because a single policy must master a broad repertoire of motion skills while ensuring stability over long-horizon sequences. To this end, we present VMS, a unified whole-body controller that enables humanoid robots to learn diverse and dynamic behaviors within a single policy. Our framework integrates a hybrid tracking objective that balances local motion fidelity with global trajectory consistency, and an Orthogonal Mixture-of-Experts (OMoE) architecture that encourages skill specialization while enhancing generalization across motions. A segment-level tracking reward is further introduced to relax rigid step-wise matching, enhancing robustness when handling global displacements and transient inaccuracies. We validate VMS extensively in both simulation and real-world experiments, demonstrating accurate imitation of dynamic skills, stable performance over minute-long sequences, and strong generalization to unseen motions. These results highlight the potential of VMS as a scalable foundation for versatile humanoid whole-body control. The project page is available at https://kungfubot2-humanoid.github.io."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16638","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:05Z","registered":"2025-09-23T02:53:06Z","published":null,"updated":"2025-09-23T02:53:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16633","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16633","identifiers":[{"identifier":"2509.16633","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Abhirama Subramanyam","familyName":"Penamakuri","name":"Penamakuri, Abhirama Subramanyam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Navlika","familyName":"Singh","name":"Singh, Navlika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Piyush","familyName":"Arora","name":"Arora, Piyush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anand","familyName":"Mishra","name":"Mishra, Anand","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"When Big Models Train Small Ones: Label-Free Model Parity Alignment for Efficient Visual Question Answering using Small VLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T11:12:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:26:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Vision-Language Models (L-VLMs) have demonstrated remarkable performance in various vision and language tasks, including visual question answering (VQA). However, their high computational cost makes them impractical for resource-constrained settings and inference-heavy applications. In contrast, Small Vision-Language Models (S-VLMs) offer efficiency but suffer from a significant performance gap compared to their larger counterparts. In this work, we introduce the Model Parity Aligner (MPA), a novel framework designed to systematically improve S-VLMs by leveraging unlabeled images and effective knowledge transfer from L-VLMs. Instead of traditional knowledge distillation methods that rely on labeled training data, MPA employs a strategic parity-based approach that precisely identifies the knowledge disparities between S-VLMs and L-VLMs, and optimizes training by targeting only these disparities. We conduct extensive experiments on four diverse VQA benchmarks, namely TextVQA, ST-VQA, ChartQA, and OKVQA, each of which requires specialized reasoning capabilities such as text recognition, chart interpretation, and commonsense and factual understanding. Our results demonstrate that MPA consistently enhances the performance of S-VLMs on all benchmarks, reducing the performance gap while maintaining computational efficiency. We make our code publicly available."},{"descriptionType":"Other","description":"Accepted to EMNLP (Main) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16633","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:52:58Z","registered":"2025-09-23T02:52:59Z","published":null,"updated":"2025-09-23T02:52:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16628","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16628","identifiers":[{"identifier":"2509.16628","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Janak","familyName":"Kapuriya","name":"Kapuriya, Janak","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anwar","familyName":"Shaikh","name":"Shaikh, Anwar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arnav","familyName":"Goel","name":"Goel, Arnav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Medha","familyName":"Hira","name":"Hira, Medha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Apoorv","familyName":"Singh","name":"Singh, Apoorv","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jay","familyName":"Saraf","name":"Saraf, Jay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Organizational","affiliation":[],"name":"Sanjana","nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vaibhav","familyName":"Nauriyal","name":"Nauriyal, Vaibhav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avinash","familyName":"Anand","name":"Anand, Avinash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengkui","familyName":"Wang","name":"Wang, Zhengkui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rajiv Ratn","familyName":"Shah","name":"Shah, Rajiv Ratn","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Scientific Visual Question Answering via Vision-Caption aware Supervised Fine-Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T11:07:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:26:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this study, we introduce Vision-Caption aware Supervised FineTuning (VCASFT), a novel learning paradigm designed to enhance the performance of smaller Vision Language Models(VLMs) on scientific visual question answering(VQA) tasks. VCASFT leverages image captions as zero-shot prompts alongside question-answer pairs and instruction-tunes models to yield significant performance improvements. To comprehensively evaluate VCASFT, we benchmark it on ScienceQA, which consists of questions across diverse languages, subjects, and fields, demonstrating its adaptability and effectiveness in a variety of educational contexts. Additionally, to further demonstrate the effectiveness of this technique on lowresource languages, we developed HiSciVQA, a dataset comprising 2,245 high-quality, hand-annotated Hindi multimodal Q\u0026amp;A pairs. This dataset addresses the critical need for low-resource language Q\u0026amp;A datasets and serves as a foundation for testing VCASFT. Additionally, we introduce a novel LLM-based evaluation scheme to evaluate VLMs on HiSciVQA which offers deeper insights into model effectiveness surpassing traditional n-gram matching accuracy metrics. We are committed to advancing the field by open-sourcing all code files and the HiSciVQA dataset for the research community."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16628","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:52:51Z","registered":"2025-09-23T02:52:51Z","published":null,"updated":"2025-09-23T02:52:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16623","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16623","identifiers":[{"identifier":"2509.16623","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junjie","familyName":"Zhou","name":"Zhou, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haijun","familyName":"Xiong","name":"Xiong, Haijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhao","familyName":"Lu","name":"Lu, Junhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyu","familyName":"Lin","name":"Lin, Ziyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Feng","name":"Feng, Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CGTGait: Collaborative Graph and Transformer for Gait Emotion Recognition"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T10:48:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:26:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Skeleton-based gait emotion recognition has received significant attention due to its wide-ranging applications. However, existing methods primarily focus on extracting spatial and local temporal motion information, failing to capture long-range temporal representations. In this paper, we propose \\textbf{CGTGait}, a novel framework that collaboratively integrates graph convolution and transformers to extract discriminative spatiotemporal features for gait emotion recognition. Specifically, CGTGait consists of multiple CGT blocks, where each block employs graph convolution to capture frame-level spatial topology and the transformer to model global temporal dependencies. Additionally, we introduce a Bidirectional Cross-Stream Fusion (BCSF) module to effectively aggregate posture and motion spatiotemporal features, facilitating the exchange of complementary information between the two streams. We evaluate our method on two widely used datasets, Emotion-Gait and ELMD, demonstrating that our CGTGait achieves state-of-the-art or at least competitive performance while reducing computational complexity by approximately \\textbf{82.2\\%} (only requiring 0.34G FLOPs) during testing. Code is available at \\small{https://github.com/githubzjj1/CGTGait.}"},{"descriptionType":"Other","description":"Accepted by IJCB2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16623","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:52:44Z","registered":"2025-09-23T02:52:44Z","published":null,"updated":"2025-09-23T02:52:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":440,"totalPages":18,"page":15},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=15\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=16\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29"}}