<span id="A1.T6.4.1.1.1.3.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A1.T6.4.1.1.1.3.1.1" class="ltx_text ltx_font_bold">GPT-4o-FC</span></span>
<span id="A1.T6.4.1.1.1.3.2" class="ltx_td ltx_border_t"></span>
<span id="A1.T6.4.1.1.1.3.3" class="ltx_td ltx_border_t"></span>
<span id="A1.T6.4.1.1.1.3.4" class="ltx_td ltx_border_t"></span>
