<td id="S4.T1.6.1.11.2" class="ltx_td ltx_align_center"><span id="S4.T1.6.1.11.2.1" class="ltx_text ltx_font_bold">78.30</span> / <span id="S4.T1.6.1.11.2.2" class="ltx_text ltx_font_bold">79.79</span></td>
<td id="S4.T1.6.1.11.3" class="ltx_td ltx_align_center">– / –</td></tr>
<tr id="S4.T1.6.1.12" class="ltx_tr">
<td id="S4.T1.6.1.12.1" class="ltx_td ltx_align_left ltx_border_t" colspan="3"><span id="S4.T1.6.1.12.1.1" class="ltx_text ltx_font_bold">Function Calling and Thought Generation</span></td></tr>
<tr id="S4.T1.6.1.13" class="ltx_tr">
<td id="S4.T1.6.1.13.1" class="ltx_td ltx_align_left ltx_border_t" colspan="3">GPT-4o Prompting</td></tr>
<tr id="S4.T1.6.1.14" class="ltx_tr">
<td id="S4.T1.6.1.14.1" class="ltx_td ltx_align_left">+ No Thought</td>
<td id="S4.T1.6.1.14.2" class="ltx_td ltx_align_center">79.40 / 78.52</td>
<td id="S4.T1.6.1.14.3" class="ltx_td ltx_align_center">47.83 / 45.42</td></tr>
<tr id="S4.T1.6.1.15" class="ltx_tr">
<td id="S4.T1.6.1.15.1" class="ltx_td ltx_align_left">+ CoT Prompting</td>
