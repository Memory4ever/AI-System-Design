<td id="S4.T1.6.1.7.2" class="ltx_td ltx_align_center"><span id="S4.T1.6.1.7.2.1" class="ltx_text ltx_font_bold">78.99</span> / <span id="S4.T1.6.1.7.2.2" class="ltx_text ltx_font_bold">80.26</span></td>
<td id="S4.T1.6.1.7.3" class="ltx_td ltx_align_center">– / –</td></tr>
