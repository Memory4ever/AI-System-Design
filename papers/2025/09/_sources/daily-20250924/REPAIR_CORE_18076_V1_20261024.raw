<span id="A1.T6.4.1.1.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A1.T6.4.1.1.1.1.1.1" class="ltx_text ltx_font_bold">Model</span></span>
<span id="A1.T6.4.1.1.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T6.4.1.1.1.1.2.1" class="ltx_text ltx_font_bold">Non-Live Cases</span></span>
<span id="A1.T6.4.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T6.4.1.1.1.1.3.1" class="ltx_text ltx_font_bold">Live-Cases</span></span>
<span id="A1.T6.4.1.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T6.4.1.1.1.1.4.1" class="ltx_text ltx_font_bold">Relevancy</span></span>
<span id="A1.T6.4.1.1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T6.4.1.1.1.1.5.1" class="ltx_text ltx_font_bold">W / BFCL <math id="A1.T6.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></span></span>
<span id="A1.T6.4.1.1.1.2" class="ltx_tr">
<span id="A1.T6.4.1.1.1.2.1" class="ltx_td ltx_align_center ltx_border_t ltx_colspan ltx_colspan_5"><span id="A1.T6.4.1.1.1.2.1.1" class="ltx_text ltx_font_bold">Prompting Strategies</span></span></span>
