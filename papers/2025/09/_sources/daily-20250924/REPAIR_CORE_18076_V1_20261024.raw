<td id="A1.T4.2.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A1.T4.2.1.1.1.1" class="ltx_text ltx_font_bold">Hyperparameter</span></td>
<td id="A1.T4.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T4.2.1.1.2.1" class="ltx_text ltx_font_bold">Value</span></td></tr>
<tr id="A1.T4.2.1.2" class="ltx_tr">
<td id="A1.T4.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">Batch Size (per device)</td>
<td id="A1.T4.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t">2</td></tr>
<tr id="A1.T4.2.1.3" class="ltx_tr">
<td id="A1.T4.2.1.3.1" class="ltx_td ltx_align_left">Thought Generation Model</td>
<td id="A1.T4.2.1.3.2" class="ltx_td ltx_align_center">GPT-4o-mini</td></tr>
<tr id="A1.T4.2.1.4" class="ltx_tr">
<td id="A1.T4.2.1.4.1" class="ltx_td ltx_align_left">Training Sample Verification</td>
<td id="A1.T4.2.1.4.2" class="ltx_td ltx_align_center">GPT-4o-mini</td></tr>
<tr id="A1.T4.2.1.5" class="ltx_tr">
<td id="A1.T4.2.1.5.1" class="ltx_td ltx_align_left">Learning Rate</td>
