<span id="A1.T6.4.1.1.1.4.1" class="ltx_td ltx_align_left">+No Thought</span>
<span id="A1.T6.4.1.1.1.4.2" class="ltx_td ltx_align_center">84.87</span>
<span id="A1.T6.4.1.1.1.4.3" class="ltx_td ltx_align_center">69.81</span>
<span id="A1.T6.4.1.1.1.4.4" class="ltx_td ltx_align_center">67.32</span>
