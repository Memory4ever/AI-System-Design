<span id="A1.T6.4.1.1.1.7" class="ltx_tr">
<span id="A1.T6.4.1.1.1.7.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A1.T6.4.1.1.1.7.1.1" class="ltx_text ltx_font_bold">GPT-4o-mini-FC</span></span>
<span id="A1.T6.4.1.1.1.7.2" class="ltx_td ltx_border_t"></span>
