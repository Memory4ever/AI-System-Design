<td id="A1.T2.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T2.2.1.1.4.1" class="ltx_text ltx_font_bold">Openness</span></td>
<td id="A1.T2.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T2.2.1.1.5.1" class="ltx_text ltx_font_bold">Consc.</span></td>
