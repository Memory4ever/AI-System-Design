<td id="A1.T2.2.1.1.8" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T2.2.1.1.8.1" class="ltx_text ltx_font_bold">Neurotic.</span></td>
<td id="A1.T2.2.1.1.9" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T2.2.1.1.9.1" class="ltx_text ltx_font_bold">Scale / Test</span></td>
<td id="A1.T2.2.1.1.10" class="ltx_td ltx_align_center ltx_border_tt"><span id="A1.T2.2.1.1.10.1" class="ltx_text ltx_font_bold">Source</span></td></tr>
<tr id="A1.T2.2.1.2" class="ltx_tr">
<td id="A1.T2.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">BART</td>
