<td id="A5.T4.2.4.2" class="ltx_td ltx_align_center"><math id="A5.T4.m1" class="ltx_math_unparsed" alttext="2.24\times" display="inline" intent=":literal"><semantics><mrow><mn>2.24</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">2.24\times</annotation></semantics></math></td>
<td id="A5.T4.2.4.3" class="ltx_td ltx_align_center"><math id="A5.T4.m2" class="ltx_math_unparsed" alttext="2.45\times" display="inline" intent=":literal"><semantics><mrow><mn>2.45</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">2.45\times</annotation></semantics></math></td>
<td id="A5.T4.2.4.4" class="ltx_td ltx_align_center"><math id="A5.T4.m3" class="ltx_math_unparsed" alttext="2.56\times" display="inline" intent=":literal"><semantics><mrow><mn>2.56</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">2.56\times</annotation></semantics></math></td>
