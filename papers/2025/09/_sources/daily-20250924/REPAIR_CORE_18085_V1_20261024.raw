<td id="A5.T4.2.6.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T4.m10" class="ltx_math_unparsed" alttext="2.45\times" display="inline" intent=":literal"><semantics><mrow><mn>2.45</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">2.45\times</annotation></semantics></math></td>
<td id="A5.T4.2.6.4" class="ltx_td ltx_align_center ltx_border_bb"><math id="A5.T4.m11" class="ltx_math_unparsed" alttext="2.62\times" display="inline" intent=":literal"><semantics><mrow><mn>2.62</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">2.62\times</annotation></semantics></math></td>
