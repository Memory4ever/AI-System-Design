<td id="S5.T1.4.11.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S5.T1.m116" class="ltx_Math" alttext="0.25\pm 0.02" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-fg-color:#FF8C32;" mathcolor="#FF8C32">0.25</mn><mo style="--ltx-fg-color:#FF8C32;" mathcolor="#FF8C32">±</mo><mn style="--ltx-fg-color:#FF8C32;" mathcolor="#FF8C32">0.02</mn></mrow><annotation encoding="application/x-tex">0.25\pm 0.02</annotation></semantics></math></td>
