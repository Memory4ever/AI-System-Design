<th id="A2.T3.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Branin</th>
<td id="A2.T3.5.4.2" class="ltx_td ltx_align_center"><math id="A2.T3.m5" class="ltx_Math" alttext="[-5,10]^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>5</mn></mrow><mo>,</mo><mn>10</mn></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">[-5,10]^{2}</annotation></semantics></math></td>
<td id="A2.T3.5.4.3" class="ltx_td ltx_nopad_r ltx_align_center">2</td></tr>
