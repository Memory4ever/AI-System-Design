<th id="A2.T3.5.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Eggholder</th>
<td id="A2.T3.5.6.2" class="ltx_td ltx_align_center"><math id="A2.T3.m7" class="ltx_Math" alttext="[-512,512]^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mo>−</mo><mn>512,512</mn></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">[-512,512]^{2}</annotation></semantics></math></td>
