<td id="A2.T3.5.3.2" class="ltx_td ltx_align_center"><math id="A2.T3.m4" class="ltx_Math" alttext="[-1,1]^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">[-1,1]^{2}</annotation></semantics></math></td>
