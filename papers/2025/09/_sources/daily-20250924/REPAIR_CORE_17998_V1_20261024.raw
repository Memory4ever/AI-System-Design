<td id="A2.T3.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A2.T3.m3" class="ltx_Math" alttext="[-5,5]^{d}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mn>5</mn></mrow><mo>,</mo><mn>5</mn></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup><annotation encoding="application/x-tex">[-5,5]^{d}</annotation></semantics></math></td>
