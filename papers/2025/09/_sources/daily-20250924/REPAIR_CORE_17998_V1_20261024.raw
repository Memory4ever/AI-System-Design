<th id="A2.T3.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Domain</th>
<th id="A2.T3.5.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A2.T3.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math></th></tr>
</thead>
