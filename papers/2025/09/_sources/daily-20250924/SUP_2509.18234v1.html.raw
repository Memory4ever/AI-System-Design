<td id="Sx1.T7.6.8.4" class="ltx_td ltx_align_center"><span id="Sx1.T7.6.8.4.1" class="ltx_text" style="font-size:90%;">0.094</span></td>
<td id="Sx1.T7.6.8.5" class="ltx_td ltx_align_center"><span id="Sx1.T7.6.8.5.1" class="ltx_text" style="font-size:90%;">0.198</span></td>
