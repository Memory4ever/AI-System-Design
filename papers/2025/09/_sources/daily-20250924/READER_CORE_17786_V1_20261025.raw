<td id="S5.T4.4.1.4.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T4.4.1.4.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#DFF1DF;">43.5</span></td>
