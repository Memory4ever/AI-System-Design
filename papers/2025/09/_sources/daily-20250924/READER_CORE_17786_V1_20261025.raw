<td id="S5.T4.4.1.4.9" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T4.4.1.4.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#DFF1DF;">55.7</span></td>
