<td id="S5.T5.2.1.3.3" class="ltx_td ltx_align_left"><math id="S5.T5.m9" class="ltx_Math" alttext="m\times Tr" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>T</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">m\times Tr</annotation></semantics></math></td>
<td id="S5.T5.2.1.3.4" class="ltx_td ltx_align_center">61.6</td>
