<td id="S5.T4.4.1.2.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T4.4.1.2.11.1" class="ltx_text" style="font-size:90%;">52.1</span></td></tr>
<tr id="S5.T4.4.1.3" class="ltx_tr">
