<td id="S5.T4.4.1.4.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T4.4.1.4.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#DFF1DF;">47.6</span></td>
<td id="S5.T4.4.1.4.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T4.4.1.4.5.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#DFF1DF;">44.5</span></td>
