<td id="S4.T2.8.1.16.8" class="ltx_td ltx_align_center ltx_border_l"><span id="S4.T2.8.1.16.8.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">3.4</span><math id="S4.T2.m19" class="ltx_Math" alttext="\times 10^{5}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mn mathsize="0.900em">5</mn></msup></mrow><annotation encoding="application/x-tex">\times 10^{5}</annotation></semantics></math><span id="S4.T2.8.1.16.8.2" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">/</span><math id="S4.T2.m20" class="ltx_Math" alttext="3.9\times 10^{5}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">3.9</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mn mathsize="0.900em">5</mn></msup></mrow><annotation encoding="application/x-tex">3.9\times 10^{5}</annotation></semantics></math></td></tr>
