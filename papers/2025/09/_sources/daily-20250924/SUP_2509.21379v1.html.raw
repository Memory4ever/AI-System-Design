<td id="S5.T2.7.9.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.7.9.3.1" class="ltx_text ltx_font_bold">0.916</span></td></tr>
<tr id="S5.T2.7.10" class="ltx_tr">
