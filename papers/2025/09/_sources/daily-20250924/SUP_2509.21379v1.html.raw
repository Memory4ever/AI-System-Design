<td id="S5.T2.7.8.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.7.8.3.1" class="ltx_text ltx_font_bold">0.91</span></td></tr>
<tr id="S5.T2.7.9" class="ltx_tr">
<td id="S5.T2.7.9.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r">7 (8 objects)</td>
