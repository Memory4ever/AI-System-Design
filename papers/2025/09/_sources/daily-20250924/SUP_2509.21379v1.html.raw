<td id="S5.T2.7.5.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.7.5.3.1" class="ltx_text ltx_font_bold">0.9975</span></td></tr>
<tr id="S5.T2.7.6" class="ltx_tr">
<td id="S5.T2.7.6.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r">4 (5 objects)</td>
