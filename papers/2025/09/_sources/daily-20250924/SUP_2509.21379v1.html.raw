<td id="S5.T2.7.4.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.7.4.3.1" class="ltx_text ltx_font_bold">1.0</span></td></tr>
<tr id="S5.T2.7.5" class="ltx_tr">
<td id="S5.T2.7.5.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r">3 (4 objects)</td>
