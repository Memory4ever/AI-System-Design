<td id="S7.T4.9.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S7.T4.9.1.5.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Avg.</span></td></tr>
