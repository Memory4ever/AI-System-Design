<th id="S7.T5.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="S7.T5.5.1.1.1" class="ltx_text ltx_font_bold">Object</span></th>
<th id="S7.T5.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S7.T5.5.1.2.1" class="ltx_text ltx_font_bold">SAeUron</span></th>
<th id="S7.T5.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S7.T5.5.1.3.1" class="ltx_text ltx_font_bold">S-OS-CA-FS</span></th>
<th id="S7.T5.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S7.T5.5.1.4.1" class="ltx_text ltx_font_bold">S-OS-OC-CA-FT</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S7.T5.5.2" class="ltx_tr">
<th id="S7.T5.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">Architectures</th>
<td id="S7.T5.5.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">-20.0</td>
<td id="S7.T5.5.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">-5.0</td>
<td id="S7.T5.5.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">-5.0</td></tr>
<tr id="S7.T5.5.3" class="ltx_tr">
<th id="S7.T5.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r">Bears</th>
<td id="S7.T5.5.3.2" class="ltx_td ltx_align_center ltx_border_r">-30.0</td>
<td id="S7.T5.5.3.3" class="ltx_td ltx_align_center ltx_border_r">-10.0</td>
