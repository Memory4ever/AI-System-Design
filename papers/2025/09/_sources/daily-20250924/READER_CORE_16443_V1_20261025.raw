<td id="S2.T2.2.1.17.3" class="ltx_td ltx_align_center">10 ns <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>, <a href="#bib.bib16" title="" class="ltx_ref">16</a>]</cite></td></tr>
