<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S2.E1Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S2.E1Xc.m2" class="ltx_Math" alttext="\displaystyle\tau_{ij}(s)" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\tau_{ij}(s)</annotation></semantics></math></td>
