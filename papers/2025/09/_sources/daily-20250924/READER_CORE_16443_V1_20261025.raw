<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S2.E1Xd.m3" class="ltx_Math" alttext="\displaystyle=s_{i,j}\cdot E_{\text{local}}\cdot E_{\text{SRAM}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>s</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>E</mi><mtext>local</mtext></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>E</mi><mtext>SRAM</mtext></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=s_{i,j}\cdot E_{\text{local}}\cdot E_{\text{SRAM}}</annotation></semantics></math></td>
