<td id="S5.T8.5.2.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T8.m5" class="ltx_Math" alttext="+0.08\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>0.08</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+0.08\%</annotation></semantics></math></td>
<td id="S5.T8.5.2.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T8.m6" class="ltx_Math" alttext="+0.29\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>0.29</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+0.29\%</annotation></semantics></math></td>
