<td id="S5.T7.5.2.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T7.m5" class="ltx_Math" alttext="+0.66\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>0.66</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+0.66\%</annotation></semantics></math></td>
<td id="S5.T7.5.2.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T7.m6" class="ltx_Math" alttext="+0.41\%" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>0.41</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">+0.41\%</annotation></semantics></math></td>
<td id="S5.T7.5.2.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S5.T7.m7" class="ltx_Math" alttext="-0.17\%" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>0.17</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">-0.17\%</annotation></semantics></math></td></tr>
