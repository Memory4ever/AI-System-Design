<div id="alg1.4.43" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="alg1.4.43.1" class="ltx_text ltx_font_bold">if</span> <em id="alg1.4.43.2" class="ltx_emph ltx_font_italic"><math id="alg1.m36" class="ltx_Math" alttext="p(t+1)&gt;=PFT" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;=</mo><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">p(t+1)&gt;=PFT</annotation></semantics></math> or <math id="alg1.m37" class="ltx_Math" alttext="t+1\%MSL=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>+</mo><mrow><mrow><mn>1</mn><mo>%</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t+1\%MSL=0</annotation></semantics></math> or <math id="alg1.m38" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math></em> <span id="alg1.4.43.3" class="ltx_text ltx_font_bold">then</span>
</div>
