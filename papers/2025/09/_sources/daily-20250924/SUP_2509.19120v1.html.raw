<span id="S2.T2.6.1.3.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S2.T2.6.1.3.1.1" class="ltx_p"><span id="S2.T2.6.1.3.1.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps" style="font-size:80%;">FedFiTS<span id="S2.T2.6.1.3.1.1.1.1" class="ltx_text ltx_font_upright"> (this work)</span></span></span>
</span></td></tr>
<tr id="S2.T2.6.2" class="ltx_tr">
<td id="S2.T2.6.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.2.1.1" class="ltx_inline-block ltx_align_top" style="width:59.8pt;">
<span id="S2.T2.6.2.1.1.1" class="ltx_p"><span id="S2.T2.6.2.1.1.1.1" class="ltx_text" style="font-size:80%;">Client selection</span></span>
</span></td>
<td id="S2.T2.6.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.2.2.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S2.T2.6.2.2.1.1" class="ltx_p"><span id="S2.T2.6.2.2.1.1.1" class="ltx_text" style="font-size:80%;">Heuristic scalar fitness; top-</span><math id="S2.T2.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math><span id="S2.T2.6.2.2.1.1.2" class="ltx_text" style="font-size:80%;"> per round</span></span>
</span></td>
<td id="S2.T2.6.2.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.2.3.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S2.T2.6.2.3.1.1" class="ltx_p"><span id="S2.T2.6.2.3.1.1.1" class="ltx_text ltx_font_italic" style="font-size:80%;">Multi-objective</span><span id="S2.T2.6.2.3.1.1.2" class="ltx_text" style="font-size:80%;"> fitness (utility, grad. coherence, diversity, staleness/energy, DP); explore–exploit to avoid starvation</span></span>
</span></td></tr>
<tr id="S2.T2.6.3" class="ltx_tr">
<td id="S2.T2.6.3.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.3.1.1" class="ltx_inline-block ltx_align_top" style="width:59.8pt;">
<span id="S2.T2.6.3.1.1.1" class="ltx_p"><span id="S2.T2.6.3.1.1.1.1" class="ltx_text" style="font-size:80%;">Team slots / scheduling</span></span>
</span></td>
<td id="S2.T2.6.3.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.3.2.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S2.T2.6.3.2.1.1" class="ltx_p"><span id="S2.T2.6.3.2.1.1.1" class="ltx_text" style="font-size:80%;">Fixed slotted teams; round-based cadence</span></span>
</span></td>
<td id="S2.T2.6.3.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.3.3.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S2.T2.6.3.3.1.1" class="ltx_p"><span id="S2.T2.6.3.3.1.1.1" class="ltx_text ltx_font_italic" style="font-size:80%;">Adaptive</span><span id="S2.T2.6.3.3.1.1.2" class="ltx_text" style="font-size:80%;"> team slots (size/length by gradient variance/plateau tests); late-arrival handling; optional async catch-up</span></span>
</span></td></tr>
<tr id="S2.T2.6.4" class="ltx_tr">
<td id="S2.T2.6.4.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.4.1.1" class="ltx_inline-block ltx_align_top" style="width:59.8pt;">
<span id="S2.T2.6.4.1.1.1" class="ltx_p"><span id="S2.T2.6.4.1.1.1.1" class="ltx_text" style="font-size:80%;">Aggregation</span></span>
</span></td>
<td id="S2.T2.6.4.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.4.2.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S2.T2.6.4.2.1.1" class="ltx_p"><span id="S2.T2.6.4.2.1.1.1" class="ltx_text" style="font-size:80%;">FedAvg/FedAdam (+ optional trust)</span></span>
</span></td>
<td id="S2.T2.6.4.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.4.3.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S2.T2.6.4.3.1.1" class="ltx_p"><span id="S2.T2.6.4.3.1.1.1" class="ltx_text" style="font-size:80%;">Two-stage: </span><span id="S2.T2.6.4.3.1.1.2" class="ltx_text ltx_font_italic" style="font-size:80%;">slot-internal</span><span id="S2.T2.6.4.3.1.1.3" class="ltx_text" style="font-size:80%;"> </span><math id="S2.T2.m2" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.800em" stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math><span id="S2.T2.6.4.3.1.1.4" class="ltx_text" style="font-size:80%;"> </span><span id="S2.T2.6.4.3.1.1.5" class="ltx_text ltx_font_italic" style="font-size:80%;">cross-slot</span><span id="S2.T2.6.4.3.1.1.6" class="ltx_text" style="font-size:80%;">; robust fallback (median/Krum); optional similarity-aware head mixing; secure-agg ready</span></span>
</span></td></tr>
<tr id="S2.T2.6.5" class="ltx_tr">
<td id="S2.T2.6.5.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.5.1.1" class="ltx_inline-block ltx_align_top" style="width:59.8pt;">
<span id="S2.T2.6.5.1.1.1" class="ltx_p"><span id="S2.T2.6.5.1.1.1.1" class="ltx_text" style="font-size:80%;">Fairness</span></span>
</span></td>
<td id="S2.T2.6.5.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.5.2.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S2.T2.6.5.2.1.1" class="ltx_p"><span id="S2.T2.6.5.2.1.1.1" class="ltx_text" style="font-size:80%;">Implicit</span></span>
</span></td>
<td id="S2.T2.6.5.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.5.3.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S2.T2.6.5.3.1.1" class="ltx_p"><span id="S2.T2.6.5.3.1.1.1" class="ltx_text" style="font-size:80%;">Participation floors/quotas; minority-cohort reweighting</span></span>
</span></td></tr>
<tr id="S2.T2.6.6" class="ltx_tr">
<td id="S2.T2.6.6.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.6.1.1" class="ltx_inline-block ltx_align_top" style="width:59.8pt;">
<span id="S2.T2.6.6.1.1.1" class="ltx_p"><span id="S2.T2.6.6.1.1.1.1" class="ltx_text" style="font-size:80%;">Robustness</span></span>
</span></td>
<td id="S2.T2.6.6.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.6.2.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S2.T2.6.6.2.1.1" class="ltx_p"><span id="S2.T2.6.6.2.1.1.1" class="ltx_text" style="font-size:80%;">Basic quality gating</span></span>
</span></td>
<td id="S2.T2.6.6.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.6.3.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S2.T2.6.6.3.1.1" class="ltx_p"><span id="S2.T2.6.6.3.1.1.1" class="ltx_text" style="font-size:80%;">Trust decay; gradient-cosine outlier checks; drift guards</span></span>
</span></td></tr>
<tr id="S2.T2.6.7" class="ltx_tr">
<td id="S2.T2.6.7.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.7.1.1" class="ltx_inline-block ltx_align_top" style="width:59.8pt;">
<span id="S2.T2.6.7.1.1.1" class="ltx_p"><span id="S2.T2.6.7.1.1.1.1" class="ltx_text" style="font-size:80%;">Convergence view</span></span>
</span></td>
<td id="S2.T2.6.7.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.7.2.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S2.T2.6.7.2.1.1" class="ltx_p"><span id="S2.T2.6.7.2.1.1.1" class="ltx_text" style="font-size:80%;">Empirical</span></span>
</span></td>
<td id="S2.T2.6.7.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.7.3.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S2.T2.6.7.3.1.1" class="ltx_p"><span id="S2.T2.6.7.3.1.1.1" class="ltx_text" style="font-size:80%;">Non-convex </span><span id="S2.T2.6.7.3.1.1.2" class="ltx_text ltx_font_italic" style="font-size:80%;">stationarity</span><span id="S2.T2.6.7.3.1.1.3" class="ltx_text" style="font-size:80%;"> bound with residuals for mixing/clustering/label-noise</span></span>
</span></td></tr>
<tr id="S2.T2.6.8" class="ltx_tr">
<td id="S2.T2.6.8.1" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.8.1.1" class="ltx_inline-block ltx_align_top" style="width:59.8pt;">
<span id="S2.T2.6.8.1.1.1" class="ltx_p"><span id="S2.T2.6.8.1.1.1.1" class="ltx_text" style="font-size:80%;">Overhead</span></span>
</span></td>
<td id="S2.T2.6.8.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.8.2.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S2.T2.6.8.2.1.1" class="ltx_p"><span id="S2.T2.6.8.2.1.1.1" class="ltx_text" style="font-size:80%;">Low</span></span>
</span></td>
<td id="S2.T2.6.8.3" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.8.3.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S2.T2.6.8.3.1.1" class="ltx_p"><span id="S2.T2.6.8.3.1.1.1" class="ltx_text" style="font-size:80%;">Low–moderate (selection + robust agg), offset by fewer wasted rounds</span></span>
</span></td></tr>
<tr id="S2.T2.6.9" class="ltx_tr">
<td id="S2.T2.6.9.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.9.1.1" class="ltx_inline-block ltx_align_top" style="width:59.8pt;">
<span id="S2.T2.6.9.1.1.1" class="ltx_p"><span id="S2.T2.6.9.1.1.1.1" class="ltx_text" style="font-size:80%;">When preferable</span></span>
</span></td>
<td id="S2.T2.6.9.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.9.2.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S2.T2.6.9.2.1.1" class="ltx_p"><span id="S2.T2.6.9.2.1.1.1" class="ltx_text" style="font-size:80%;">Stable/homogeneous FL</span></span>
</span></td>
<td id="S2.T2.6.9.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_b" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S2.T2.6.9.3.1" class="ltx_inline-block ltx_align_top" style="width:74.0pt;">
<span id="S2.T2.6.9.3.1.1" class="ltx_p"><span id="S2.T2.6.9.3.1.1.1" class="ltx_text" style="font-size:80%;">Non-IID, unreliable participation; fairness/robustness needed</span></span>
</span></td></tr>
</table>
</figure>
</section>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">III </span><span id="S3.2" class="ltx_text ltx_font_smallcaps">Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model</span></h2>

<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S3.SS1.6" class="ltx_text">III-A</span> </span><span id="S3.SS1.7" class="ltx_text ltx_font_italic">FedFiTS Problem Formulation</span></h3>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">FedFiTS is a selective federated learning algorithm that relies on the following metrics to select the fittest clients in the aggregation and training processes.</p>
</div>
<div id="S3.SS1.p2" class="ltx_para ltx_noindent">
<p id="S3.SS1.p2.1" class="ltx_p"><span id="S3.SS1.p2.1.1" class="ltx_text ltx_font_bold">Quality of Learning (QoL): <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="\theta_{k}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\theta_{k}</annotation></semantics></math> &amp; <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="score_{k}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">score_{k}</annotation></semantics></math> </span></p>
</div>
<div id="S3.SS1.p3" class="ltx_para">
<p id="S3.SS1.p3.1" class="ltx_p">Let us consider the global model <math id="S3.SS1.p3.m1" class="ltx_Math" alttext="w(t-1)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(t-1)</annotation></semantics></math> and the local model <math id="S3.SS1.p3.m2" class="ltx_Math" alttext="w_{k}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w_{k}(t)</annotation></semantics></math> at round <math id="S3.SS1.p3.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> on client <math id="S3.SS1.p3.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>. Let <math id="S3.SS1.p3.m5" class="ltx_Math" alttext="GL_{k}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">GL_{k}</annotation></semantics></math>, <math id="S3.SS1.p3.m6" class="ltx_Math" alttext="GA_{k}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">GA_{k}</annotation></semantics></math>, <math id="S3.SS1.p3.m7" class="ltx_Math" alttext="LL_{k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">LL_{k}</annotation></semantics></math>, and <math id="S3.SS1.p3.m8" class="ltx_Math" alttext="LA_{k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">LA_{k}</annotation></semantics></math> denote the training performance metrics in terms of accuracy and loss. <math id="S3.SS1.p3.m9" class="ltx_Math" alttext="GL_{k}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">GL_{k}</annotation></semantics></math> and <math id="S3.SS1.p3.m10" class="ltx_Math" alttext="GA_{k}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">GA_{k}</annotation></semantics></math> represent respectively the loss and accuracy of the global model <math id="S3.SS1.p3.m11" class="ltx_Math" alttext="w(t-1)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(t-1)</annotation></semantics></math> while <math id="S3.SS1.p3.m12" class="ltx_Math" alttext="LL_{k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">LL_{k}</annotation></semantics></math> and <math id="S3.SS1.p3.m13" class="ltx_Math" alttext="LA_{k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">LA_{k}</annotation></semantics></math> are loss and accuracy of the local model <math id="S3.SS1.p3.m14" class="ltx_Math" alttext="w_{k}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w_{k}(t)</annotation></semantics></math> using the local dataset <math id="S3.SS1.p3.m15" class="ltx_Math" alttext="D_{k}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mi>k</mi></msub><annotation encoding="application/x-tex">D_{k}</annotation></semantics></math>. To measure the gap between models <math id="S3.SS1.p3.m16" class="ltx_Math" alttext="w(t-1)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(t-1)</annotation></semantics></math> and <math id="S3.SS1.p3.m17" class="ltx_Math" alttext="w_{k}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w_{k}(t)</annotation></semantics></math>, we consider <math id="S3.SS1.p3.m18" class="ltx_Math" alttext="GL_{k}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">GL_{k}</annotation></semantics></math>, <math id="S3.SS1.p3.m19" class="ltx_Math" alttext="GA_{k}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">GA_{k}</annotation></semantics></math>, <math id="S3.SS1.p3.m20" class="ltx_Math" alttext="LL_{k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">LL_{k}</annotation></semantics></math>, <math id="S3.SS1.p3.m21" class="ltx_Math" alttext="LA_{k}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">LA_{k}</annotation></semantics></math> to be the coordinates of points <math id="S3.SS1.p3.m22" class="ltx_Math" alttext="G(GL_{k},GA_{k})" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(GL_{k},GA_{k})</annotation></semantics></math> and <math id="S3.SS1.p3.m23" class="ltx_Math" alttext="L(LL_{k},LA_{k})" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(LL_{k},LA_{k})</annotation></semantics></math> in a two-dimensional plane where the loss is represented by the <math id="S3.SS1.p3.m24" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>-axis while the accuracy by the
<math id="S3.SS1.p3.m25" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math>-axis. As shown in Fig.<a href="#S3.F1.sf1" title="In Fig. 1 ‣ III-A FedFiTS Problem Formulation ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1a</span></a>, a middle point <math id="S3.SS1.p3.m26" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> located on the OM segment is defined by
M(<math id="S3.SS1.p3.m27" class="ltx_Math" alttext="\frac{GL_{k}+LL_{k}}{2},\frac{GA_{k}+LA_{k}}{2}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow></mrow><mn>2</mn></mfrac><mo>,</mo><mfrac><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow></mrow><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\frac{GL_{k}+LL_{k}}{2},\frac{GA_{k}+LA_{k}}{2}</annotation></semantics></math>). Owing to the difference between accuracy <math id="S3.SS1.p3.m28" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math> and loss <math id="S3.SS1.p3.m29" class="ltx_math_unparsed" alttext="]0,+\infty[" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">]</mo><mn>0</mn><mo rspace="0em">,</mo><mo lspace="0em">+</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">[</mo></mrow><annotation encoding="application/x-tex">]0,+\infty[</annotation></semantics></math> domains and for the sake of standardization between the two metrics, we propose to use the angle <math id="S3.SS1.p3.m30" class="ltx_Math" alttext="\theta_{k}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\theta_{k}</annotation></semantics></math> as a measure of the distance between <math id="S3.SS1.p3.m31" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> and the loss unit vector <math id="S3.SS1.p3.m32" class="ltx_Math" alttext="[1,0]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1,0]</annotation></semantics></math>.</p>
<table id="S3.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E1.m1" class="ltx_Math" alttext="\theta_{k}=arcos(\frac{GL_{k}+LL_{k}}{\sqrt{(GL_{k}+GA_{k})^{2}+(LL_{k}+LA_{k})^{2}}})" display="block" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>k</mi></msub><mo>=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow></mrow><msqrt><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></msqrt></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{k}=arcos(\frac{GL_{k}+LL_{k}}{\sqrt{(GL_{k}+GA_{k})^{2}+(LL_{k}+LA_{k})^{2}}})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(1)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p3.2" class="ltx_p">Eq. (<a href="#S3.E1" title="In III-A FedFiTS Problem Formulation ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) denotes the gap between client <math id="S3.SS1.p3.m33" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>’s model performance and the server’s model performance. When comparing the clients <math id="S3.SS1.p3.m34" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> and <math id="S3.SS1.p3.m35" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math>, if <math id="S3.SS1.p3.m36" class="ltx_Math" alttext="\theta_{k}&gt;\theta_{k+1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>k</mi></msub><mo>&gt;</mo><msub><mi>θ</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\theta_{k}&gt;\theta_{k+1}</annotation></semantics></math>, client <math id="S3.SS1.p3.m37" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>’s performance is closer to server’s global model <math id="S3.SS1.p3.m38" class="ltx_Math" alttext="w(t-1)" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">w(t-1)</annotation></semantics></math> than that of <math id="S3.SS1.p3.m39" class="ltx_Math" alttext="k+1" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">k+1</annotation></semantics></math>.</p>
</div>
<figure id="S3.F1" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F1.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.19120v1/images/image_point_milieu.PNG" id="S3.F1.sf1.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:105/108;" width="105" height="108" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span><math id="S3.F1.sf1.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> and <math id="S3.F1.sf1.m4" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> representation</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S3.F1.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.19120v1/images/Solution_design.PNG" id="S3.F1.sf2.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:105/94;" width="105" height="94" alt="Refer to caption">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span>FedFiTS clients selection</figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 1: </span>Showing client performance and FedFiTS client selection</figcaption>
</figure>
<div id="S3.SS1.p4" class="ltx_para">
<p id="S3.SS1.p4.1" class="ltx_p">Let <math id="S3.SS1.p4.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> be the size of the global dataset (including all clients), <math id="S3.SS1.p4.m2" class="ltx_Math" alttext="n_{k}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>k</mi></msub><annotation encoding="application/x-tex">n_{k}</annotation></semantics></math> the local client <math id="S3.SS1.p4.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>’s dataset size and <math id="S3.SS1.p4.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> the total number of clients. The expression
<math id="S3.SS1.p4.m5" class="ltx_Math" alttext="q_{k}=\frac{n_{k}}{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>=</mo><mfrac><msub><mi>n</mi><mi>k</mi></msub><mi>n</mi></mfrac></mrow><annotation encoding="application/x-tex">q_{k}=\frac{n_{k}}{n}</annotation></semantics></math>
represents the data quality measure for client <math id="S3.SS1.p4.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> such that <math id="S3.SS1.p4.m7" class="ltx_Math" alttext="\sum_{k=1}^{K}{\frac{n_{k}}{n}=1}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mfrac><msub><mi>n</mi><mi>k</mi></msub><mi>n</mi></mfrac></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{K}{\frac{n_{k}}{n}=1}</annotation></semantics></math>.
The client’s fitness to enter the training and
aggregation team, referred to as the <span id="S3.SS1.p4.1.1" class="ltx_text ltx_font_italic">training performance metric</span>, is defined by a weighted sum of the client’s performance measure expressed by Eq. (<a href="#S3.E2" title="In III-A FedFiTS Problem Formulation ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) and data quality measure defined above.
For client <math id="S3.SS1.p4.m8" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> at round <math id="S3.SS1.p4.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, the training performance metric is defined by:</p>
<table id="S3.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E2.m1" class="ltx_Math" alttext="\\
score_{k}(t)=\alpha q_{k}+(1-\alpha)\theta_{k}" display="block" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>θ</mi><mi>k</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\\
score_{k}(t)=\alpha q_{k}+(1-\alpha)\theta_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p4.2" class="ltx_p">where <math id="S3.SS1.p4.m10" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is a hyper-parameter controlling the trade-off between the quality of data held by the client (<math id="S3.SS1.p4.m11" class="ltx_Math" alttext="q_{k}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>k</mi></msub><annotation encoding="application/x-tex">q_{k}</annotation></semantics></math>) and performance (<math id="S3.SS1.p4.m12" class="ltx_Math" alttext="\theta_{k}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\theta_{k}</annotation></semantics></math>).</p>
</div>
<div id="S3.SS1.p5" class="ltx_para ltx_noindent">
<p id="S3.SS1.p5.1" class="ltx_p"><span id="S3.SS1.p5.1.1" class="ltx_text ltx_font_bold">Clients’ Fitness Threshold: <math id="S3.SS1.p5.m1" class="ltx_Math" alttext="threshold(t)" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">threshold(t)</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS1.p6" class="ltx_para">
<p id="S3.SS1.p6.1" class="ltx_p">FedFiTS uses a threshold-aware fitness assessment of clients. During the current round, the clients with
performance above a threshold are elected as fit to enter the
training and aggregation team for the next slot; and those with
performance below the threshold are left aside for fitness
re-evaluation at the end of the current slot. As depicted in
Fig. <a href="#S3.F1.sf1" title="In Fig. 1 ‣ III-A FedFiTS Problem Formulation ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1a</span></a>, the segment OM represents a trade-off in
terms of performance between the global (<math id="S3.SS1.p6.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>) and local (<math id="S3.SS1.p6.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>) models. It should therefore be used to guide the definition of a threshold to be applied to the client’s ranking/scoring to differentiate between the fittest and unfit clients. Such a threshold is given by</p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_Math" alttext="\\
threshold(t)=\frac{\Sigma_{k=1}^{K}{score_{k}}}{k}\times(1-\beta)" display="block" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><msubsup><mi mathvariant="normal">Σ</mi><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub></mrow><mi>k</mi></mfrac><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\\
threshold(t)=\frac{\Sigma_{k=1}^{K}{score_{k}}}{k}\times(1-\beta)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p6.2" class="ltx_p">where the hyper-parameter <math id="S3.SS1.p6.m3" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> smooths the selection
process to enable border-line clients just below the average line in Fig. <a href="#S3.F1.sf2" title="In Fig. 1 ‣ III-A FedFiTS Problem Formulation ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1b</span></a> to be selected in the training team.
While <math id="S3.SS1.p6.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> and <math id="S3.SS1.p6.m5" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>
control the
clients’ participation in the training and aggregation processes, the
threshold line in Fig. <a href="#S3.F1.sf2" title="In Fig. 1 ‣ III-A FedFiTS Problem Formulation ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1b</span></a> indicates how close/far the clients’ selection scheme is to the average solution where the threshold line coincides with the average line.</p>
</div>
<div id="S3.SS1.p7" class="ltx_para">
<p id="S3.SS1.p7.1" class="ltx_p">Fig. <a href="#S3.F1.sf2" title="In Fig. 1 ‣ III-A FedFiTS Problem Formulation ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1b</span></a> provides a pictorial
representation of the FedFiTS clients’ selection process where i) the green clients over the average line are controlled by hyper-parameter <math id="S3.SS1.p7.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>,
ii) the red clients are in the waiting zone for re-evaluation, and iii)
the yellow clients located between the green and red clients are just below the average line and controlled by <math id="S3.SS1.p7.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>.</p>
</div>
<div id="S3.SS1.p8" class="ltx_para ltx_noindent">
<p id="S3.SS1.p8.1" class="ltx_p"><span id="S3.SS1.p8.1.1" class="ltx_text ltx_font_bold">Training Slots: MSL, PFT, and </span><span id="S3.SS1.p8.1.2" class="ltx_text ltx_font_italic">p(t)</span></p>
</div>
<div id="S3.SS1.p9" class="ltx_para">
<p id="S3.SS1.p9.1" class="ltx_p">One of the critical challenges in federated learning is managing how often and which clients participate during training rounds. Frequent client switching can cause instability and degrade fairness, while infrequent switching might prevent the inclusion of diverse updates from heterogeneous clients. To strike a balance, FedFiTS introduces a <span id="S3.SS1.p9.1.1" class="ltx_text ltx_font_bold">slot-based training mechanism</span> that dynamically adjusts the <span id="S3.SS1.p9.1.2" class="ltx_text ltx_font_bold">duration</span> of client team participation based on their performance.</p>
</div>
<div id="S3.SS1.p10" class="ltx_para">
<p id="S3.SS1.p10.1" class="ltx_p">We define three key components in this mechanism:</p>
</div>
<div id="S3.SS1.p11" class="ltx_para">
<ul id="S3.I1" class="ltx_itemize">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p"><span id="S3.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">MSL (Maximum Slot Length)</span>: the maximum number of consecutive rounds a selected team of clients can participate before a mandatory reassessment.</p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p"><span id="S3.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">PFT (Performance Fluctuation Threshold)</span>: a tolerance threshold that defines how many consecutive rounds of declining team performance are allowed before triggering a reselection.</p>
</div></li>
<li id="S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i3.p1.1" class="ltx_p"><math id="S3.I1.i3.p1.m1" class="ltx_Math" alttext="p(t)" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p(t)</annotation></semantics></math>: a dynamic counter at round <math id="S3.I1.i3.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> that tracks how many successive rounds the team’s overall performance has decreased.</p>
</div></li>
</ul>
</div>
<div id="S3.SS1.p12" class="ltx_para">
<p id="S3.SS1.p12.1" class="ltx_p">To determine team stability, we observe the evolution of the overall performance metric <math id="S3.SS1.p12.m1" class="ltx_Math" alttext="\theta(t)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta(t)</annotation></semantics></math>. If performance declines compared to the previous round (<math id="S3.SS1.p12.m2" class="ltx_Math" alttext="\theta(t)&lt;\theta(t-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta(t)&lt;\theta(t-1)</annotation></semantics></math>), we increment the counter <math id="S3.SS1.p12.m3" class="ltx_Math" alttext="p(t+1)=p(t)+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">p(t+1)=p(t)+1</annotation></semantics></math>; otherwise, we reset it to zero:</p>
</div>
<div id="S3.SS1.p13" class="ltx_para">
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_Math" alttext="p(t+1)=\begin{cases}p(t)+1,&amp;\text{if }\theta(t)&lt;\theta(t-1)\\
0,&amp;\text{otherwise}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">p(t+1)=\begin{cases}p(t)+1,&amp;\text{if }\theta(t)&lt;\theta(t-1)\\
0,&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS1.p14" class="ltx_para">
<p id="S3.SS1.p14.1" class="ltx_p">A reselection is triggered when either of the following conditions is met:</p>
<ol id="S3.I2" class="ltx_enumerate">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="S3.I2.i1.p1" class="ltx_para">
<p id="S3.I2.i1.p1.1" class="ltx_p">The number of consecutive declining rounds exceeds the threshold: <math id="S3.I2.i1.p1.m1" class="ltx_Math" alttext="p(t+1)\geq\text{PFT}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mtext>PFT</mtext></mrow><annotation encoding="application/x-tex">p(t+1)\geq\text{PFT}</annotation></semantics></math></p>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="S3.I2.i2.p1" class="ltx_para">
<p id="S3.I2.i2.p1.1" class="ltx_p">The round count reaches a multiple of MSL: <math id="S3.I2.i2.p1.m1" class="ltx_Math" alttext="(t+1)\bmod\text{MSL}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>mod</mo><mtext>MSL</mtext></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(t+1)\bmod\text{MSL}=0</annotation></semantics></math></p>
</div></li>
</ol>
</div>
<div id="S3.SS1.p15" class="ltx_para">
<p id="S3.SS1.p15.1" class="ltx_p">This is formalized using a Boolean switching function <math id="S3.SS1.p15.m1" class="ltx_Math" alttext="h(t+1)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h(t+1)</annotation></semantics></math> that determines whether a new client selection should be made at round <math id="S3.SS1.p15.m2" class="ltx_Math" alttext="t+1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t+1</annotation></semantics></math>:</p>
</div>
<div id="S3.SS1.p16" class="ltx_para">
<table id="S3.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E5.m1" class="ltx_Math" alttext="h(t+1)=\begin{cases}\text{True},&amp;\text{if }p(t+1)\geq\text{PFT}\text{ or }(t+1)\%\text{MSL}=0\\
\text{False},&amp;\text{otherwise}\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>True</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mrow><mrow><mtext>PFT</mtext><mtext> or </mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>%</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>MSL</mtext></mrow><mo>=</mo><mn>0</mn></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>False</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mtext>otherwise</mtext></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">h(t+1)=\begin{cases}\text{True},&amp;\text{if }p(t+1)\geq\text{PFT}\text{ or }(t+1)\%\text{MSL}=0\\
\text{False},&amp;\text{otherwise}\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(5)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS1.p17" class="ltx_para">
<p id="S3.SS1.p17.1" class="ltx_p">This mechanism allows FedFiTS to <span id="S3.SS1.p17.1.1" class="ltx_text ltx_font_bold">dynamically adapt the frequency of client team updates</span>. Teams that show consistent performance improvements remain active longer, thereby reducing unnecessary communication overhead. Conversely, if performance declines, quicker reselection is enforced to ensure the learning process remains robust and convergent.</p>
</div>
<div id="S3.SS1.p18" class="ltx_para">
<p id="S3.SS1.p18.1" class="ltx_p">To optimize performance, the algorithm prefers <span id="S3.SS1.p18.1.1" class="ltx_text ltx_font_bold">larger MSL values</span> (encouraging team stability) and <span id="S3.SS1.p18.1.2" class="ltx_text ltx_font_bold">smaller PFT values</span> (allowing quicker reaction to declining performance).</p>
</div>
<div id="S3.SS1.p19" class="ltx_para ltx_noindent">
<p id="S3.SS1.p19.1" class="ltx_p"><span id="S3.SS1.p19.1.1" class="ltx_text ltx_font_bold">Problem Formulation</span></p>
</div>
<div id="S3.SS1.p20" class="ltx_para">
<p id="S3.SS1.p20.1" class="ltx_p">FedFiTS aims to maximize <math id="S3.SS1.p20.m1" class="ltx_math_unparsed" alttext="\theta(.)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0.167em">.</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\theta(.)</annotation></semantics></math>, the Quality of Learning <span id="S3.SS1.p20.1.1" class="ltx_text ltx_font_italic">QoL</span> for a round <math id="S3.SS1.p20.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> or a slot <math id="S3.SS1.p20.m3" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> using fittest clients.
This maximization thus refers to the selection of clients capable of boosting the model to better overall performance. It intrinsically involves the elimination of clients whose impact to the global model is weak or bad, malicious clients, non-compliant with the task or attacked clients, to avoid propagation of bad parameters to the global model.</p>
</div>
<div id="S3.SS1.p21" class="ltx_para">
<p id="S3.SS1.p21.1" class="ltx_p">The problem is then formulated as follows.</p>
</div>
<div id="S3.SS1.p22" class="ltx_para">
<table id="S3.EGx1" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S3.E6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E6.m1" class="ltx_Math" alttext="\displaystyle maximize\sum_{t}\sum_{k}\theta_{k}(t)X(k,t)" display="block" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><munder><mo movablelimits="false" rspace="0em">∑</mo><mi>t</mi></munder><mrow><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder><mrow><msub><mi>θ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle maximize\sum_{t}\sum_{k}\theta_{k}(t)X(k,t)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(6)</span></td></tr></tbody>
<tbody id="S3.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><span id="S3.E7.2" class="ltx_text ltx_markedasmath">subject to <math id="S3.E7.m1.m1" class="ltx_Math" alttext="score_{k}(t)\geq threshold(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">score_{k}(t)\geq threshold(t)</annotation></semantics></math> </span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="0" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
<tbody id="S3.EGx1.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.EGx1.m1" class="ltx_Math" alttext="\displaystyle X(k,t)=\left\{\begin{array}[]{lr}1,&amp;\text{if $k$ is selected}\\
0,&amp;\text{other wise }\end{array}\right." display="block" intent=":literal"><semantics><mrow><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mtext>if </mtext><mi>k</mi><mtext> is selected</mtext></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mtext>other wise </mtext></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\displaystyle X(k,t)=\left\{\begin{array}[]{lr}1,&amp;\text{if $k$ is selected}\\
0,&amp;\text{other wise }\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p22.1" class="ltx_p">where <math id="S3.SS1.p22.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> represents a client, <math id="S3.SS1.p22.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> a round, and <math id="S3.SS1.p22.m3" class="ltx_Math" alttext="\theta_{k}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\theta_{k}</annotation></semantics></math> the client <math id="S3.SS1.p22.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> proximity to the global model (its quality of learning).</p>
</div>
<div id="S3.SS1.p23" class="ltx_para">
<p id="S3.SS1.p23.1" class="ltx_p">As expressed above, FedFiTS builds around its key performance metrics to 1) maximize a reward function expressed as a weighted sum of the clients training performance <math id="S3.SS1.p23.m1" class="ltx_Math" alttext="\sum_{t}\sum_{k}\theta_{k}(t)X(k,t)" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mi>t</mi></msub><mrow><msub><mo lspace="0.167em">∑</mo><mi>k</mi></msub><mrow><msub><mi>θ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{t}\sum_{k}\theta_{k}(t)X(k,t)</annotation></semantics></math> and the quality of datasets held by these clients and 2) minimize the number of clients participating in the training process <math id="S3.SS1.p23.m2" class="ltx_Math" alttext="score_{k}(t)\geq threshold(t)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">score_{k}(t)\geq threshold(t)</annotation></semantics></math> with the expectation to increasing the algorithm convergence, increase accuracy and reduce training time. The FedFiTS algorithm is presented below along with the proof of its convergence and performance results revealing its relative performance compared to other key algorithms on different datasets, both images and numerical.</p>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S3.SS2.6" class="ltx_text">III-B</span> </span><span id="S3.SS2.7" class="ltx_text ltx_font_italic">FedFiTS Algorithmic Solution</span></h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">The main algorithm of FedFiTS is depicted in Algorithm <a href="#alg1" title="In III-B FedFiTS Algorithmic Solution ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> while its client updates process is described in Algorithm <a href="#alg2" title="In III-B FedFiTS Algorithmic Solution ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. At initialization, the algorithm considers <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> as the total number of rounds and starts with an empty set of selected clients. Free-for-all training allows all available clients in <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="N_{t}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>t</mi></msub><annotation encoding="application/x-tex">N_{t}</annotation></semantics></math> to train the global model at least twice. At round <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math>, all clients train and send their parameters for aggregation. At round <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="t=2" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">t=2</annotation></semantics></math>, all clients will train but a threshold-aware selection is made to determine the clients which should participate in the aggregation and training for round <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="t=3" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">t=3</annotation></semantics></math>. The team changing process is decided server-side by calculating <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="h(t+1)" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h(t+1)</annotation></semantics></math> at round <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, and that change is performed when <math id="S3.SS2.p1.m8" class="ltx_Math" alttext="h(t+1)=True" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></mrow><annotation encoding="application/x-tex">h(t+1)=True</annotation></semantics></math>. The selection process follows three steps: (i) calculate the score of each client following Eq. (<a href="#S3.E2" title="In III-A FedFiTS Problem Formulation ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>), (ii) calculate the threshold using Eq. (<a href="#S3.E3" title="In III-A FedFiTS Problem Formulation ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>), and (iii) select all clients whose score is greater than or equal to the threshold and add them to the current set of selected clients <math id="S3.SS2.p1.m9" class="ltx_Math" alttext="S_{t}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>t</mi></msub><annotation encoding="application/x-tex">S_{t}</annotation></semantics></math> previously referred to as the “training and aggregation team”. The aggregation of parameters (weights) is performed in each slot with the clients in <math id="S3.SS2.p1.m10" class="ltx_Math" alttext="S_{t}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>t</mi></msub><annotation encoding="application/x-tex">S_{t}</annotation></semantics></math>.</p>
</div>
<figure id="alg1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>FedFiST Algorithm</figcaption>
<div id="alg1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.4.1" class="ltx_listingline">
initialize <math id="alg1.m1" class="ltx_Math" alttext="w_{0}" display="inline" intent=":literal"><semantics><msub><mi>w</mi><mn>0</mn></msub><annotation encoding="application/x-tex">w_{0}</annotation></semantics></math> 
</div>
<div id="alg1.4.2" class="ltx_listingline">initialize <math id="alg1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>   ;  <span id="alg1.4.2.1" class="ltx_text ltx_font_typewriter">/* </span><span id="alg1.4.2.2" class="ltx_text ltx_font_typewriter">Total number of rounds */</span>
</div>
<div id="alg1.4.3" class="ltx_listingline">initialize <math id="alg1.m3" class="ltx_Math" alttext="MSL" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">MSL</annotation></semantics></math>   ;  <span id="alg1.4.3.1" class="ltx_text ltx_font_typewriter">/* </span><span id="alg1.4.3.2" class="ltx_text ltx_font_typewriter">Max Slot length */</span>
</div>
<div id="alg1.4.4" class="ltx_listingline">initialize <math id="alg1.m4" class="ltx_Math" alttext="PFT" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">PFT</annotation></semantics></math>   ;  <span id="alg1.4.4.1" class="ltx_text ltx_font_typewriter">/* </span><span id="alg1.4.4.2" class="ltx_text ltx_font_typewriter">frequency threshold */</span>
</div>
<div id="alg1.4.5" class="ltx_listingline"><math id="alg1.m5" class="ltx_Math" alttext="p(1)\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p(1)\leftarrow 0</annotation></semantics></math>   ;  <span id="alg1.4.5.1" class="ltx_text ltx_font_typewriter">/* </span><span id="alg1.4.5.2" class="ltx_text ltx_font_typewriter">slot monitoring */</span>
</div>
<div id="alg1.4.6" class="ltx_listingline"><math id="alg1.m6" class="ltx_Math" alttext="S_{0}\leftarrow\{\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mn>0</mn></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S_{0}\leftarrow\{\}</annotation></semantics></math>  ;  <span id="alg1.4.6.1" class="ltx_text ltx_font_typewriter">/* </span><span id="alg1.4.6.2" class="ltx_text ltx_font_typewriter">set of selected clients */</span>
</div>
<div id="alg1.4.7" class="ltx_listingline"><span id="alg1.4.7.1" class="ltx_text ltx_font_bold">foreach</span> <em id="alg1.4.7.2" class="ltx_emph ltx_font_italic">communication round <math id="alg1.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>=1,2,…<math id="alg1.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></em> <span id="alg1.4.7.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="alg1.4.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="alg1.m9" class="ltx_Math" alttext="N_{t}\leftarrow(Availaible~clients~at~round~" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo fence="true" lspace="0.330em">CLOSE</mo></mrow></mrow><annotation encoding="application/x-tex">N_{t}\leftarrow(Availaible~clients~at~round~</annotation></semantics></math>t<math id="alg1.m10" class="ltx_Math" alttext=")" display="inline" intent=":literal"><semantics><mo stretchy="false">)</mo><annotation encoding="application/x-tex">)</annotation></semantics></math> ;  <span id="alg1.4.8.1" class="ltx_text ltx_font_typewriter">/* </span><span id="alg1.4.8.2" class="ltx_text ltx_font_typewriter">set of all clients */</span>
</div>
<div id="alg1.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="alg1.4.9.1" class="ltx_text ltx_font_bold">if</span> <em id="alg1.4.9.2" class="ltx_emph ltx_font_italic"><math id="alg1.m11" class="ltx_Math" alttext="h(t)=True" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></mrow><annotation encoding="application/x-tex">h(t)=True</annotation></semantics></math></em> <span id="alg1.4.9.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="alg1.4.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="alg1.4.10.1" class="ltx_text ltx_font_bold">foreach</span> <em id="alg1.4.10.2" class="ltx_emph ltx_font_italic">client <math id="alg1.m12" class="ltx_Math" alttext="c_{k}\in" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>∈</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">c_{k}\in</annotation></semantics></math>N<sub id="alg1.4.10.2.1" class="ltx_sub"><span id="alg1.4.10.2.1.1" class="ltx_text ltx_font_italic">t</span></sub></em> <span id="alg1.4.10.3" class="ltx_text ltx_font_bold">do</span>
</div>
