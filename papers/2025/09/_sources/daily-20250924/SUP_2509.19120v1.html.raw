</div>
<div id="alg2.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="alg2.m9" class="ltx_Math" alttext="LL_{k},LA_{k}\leftarrow evaluate(w_{k}(t),testset_{k})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow><mo stretchy="false">←</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">LL_{k},LA_{k}\leftarrow evaluate(w_{k}(t),testset_{k})</annotation></semantics></math> ;
</div>
<div id="alg2.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="alg2.m10" class="ltx_Math" alttext="\theta_{k}\leftarrow arcos(\frac{GL_{k}+LL_{k}}{\sqrt{(GL_{k}+GA_{k})^{2}+(LL_{k}+LA_{k})^{2}}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>k</mi></msub><mo stretchy="false">←</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mfrac><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow></mrow><msqrt><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></msqrt></mfrac><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{k}\leftarrow arcos(\frac{GL_{k}+LL_{k}}{\sqrt{(GL_{k}+GA_{k})^{2}+(LL_{k}+LA_{k})^{2}}})</annotation></semantics></math>;
</div>
<div id="alg2.4.15" class="ltx_listingline">end if
</div>
<div id="alg2.4.16" class="ltx_listingline"><span id="alg2.4.16.1" class="ltx_text ltx_font_bold">return</span> <math id="alg2.m11" class="ltx_Math" alttext="w_{k},\theta_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mi>k</mi></msub><mo>,</mo><msub><mi>θ</mi><mi>k</mi></msub></mrow><annotation encoding="application/x-tex">w_{k},\theta_{k}</annotation></semantics></math>;
</div>
<div id="alg2.4.17" class="ltx_listingline">
</div>
</div>
</figure>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S3.SS3.6" class="ltx_text">III-C</span> </span><span id="S3.SS3.7" class="ltx_text ltx_font_italic">FedFiTS in the Selective FL Landscape</span></h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">FedFiST is a Federated Learning approach which differs from other approaches on such aspects as the fitness model, client scoring and selection model, and local training process.</p>
</div>
<figure id="S3.F2" class="ltx_figure"><img src="2509.19120v1/images/SlotFonts.PNG" id="S3.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:334/107;" width="334" height="107" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 2: </span>FedFiST: The Slotted training illustration </figcaption>
</figure>
<figure id="S3.F3" class="ltx_figure"><img src="2509.19120v1/images/FedRandSlots.PNG" id="S3.F3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:354/76;" width="354" height="76" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 3: </span>FedRand and FedPow: Round-based training </figcaption>
</figure>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p">Figures <a href="#S3.F2" title="Fig. 2 ‣ III-C FedFiTS in the Selective FL Landscape ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and <a href="#S3.F3" title="Fig. 3 ‣ III-C FedFiTS in the Selective FL Landscape ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> reveal a key difference between FedFiST and FedRand <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib2" title="" class="ltx_ref">2</a>]</cite> and FedPow <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib3" title="" class="ltx_ref">3</a>]</cite> in terms of clients participation profile in the training and aggregation. For instance, FedFiST uses a <span id="S3.SS3.p2.1.1" class="ltx_text ltx_font_italic">slot-based profile</span> where the clients are evaluated after each slot to form a team of fittest clients. On the other hand, FedRand and FedPow algorithms rely on a <span id="S3.SS3.p2.1.2" class="ltx_text ltx_font_italic">round-based profile</span> where the clients are evaluated at each round to make the fittest client team. Moreover, in FedRand and FedPow, the slot size is of 1 round, whereas in FedFiST, the slots are made of more than one rounds of the FL model execution.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">IV </span><span id="S4.2" class="ltx_text ltx_font_smallcaps">Convergence Analysis of FedFiTS</span></h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS1.6" class="ltx_text">IV-A</span> </span><span id="S4.SS1.7" class="ltx_text ltx_font_italic">Problem Setting and Notation</span></h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Let <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="F(w)\!\triangleq\!\sum_{i=1}^{N}p_{i}\,f_{i}(w)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.108em" rspace="0.0539em">≜</mo><mrow><msubsup><mo lspace="0.0539em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F(w)\!\triangleq\!\sum_{i=1}^{N}p_{i}\,f_{i}(w)</annotation></semantics></math> be the global objective with <math id="S4.SS1.p1.m2" class="ltx_Math" alttext="p_{i}\!\geq\!0" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0.108em">≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{i}\!\geq\!0</annotation></semantics></math>, <math id="S4.SS1.p1.m3" class="ltx_Math" alttext="\sum_{i}p_{i}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><msub><mi>p</mi><mi>i</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i}p_{i}=1</annotation></semantics></math>.
At round <math id="S4.SS1.p1.m4" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, a team <math id="S4.SS1.p1.m5" class="ltx_Math" alttext="S_{t}\subseteq\{1,\dots,N\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>t</mi></msub><mo>⊆</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>N</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">S_{t}\subseteq\{1,\dots,N\}</annotation></semantics></math> participates (FedFiTS uses slotted teams).
Each <math id="S4.SS1.p1.m6" class="ltx_Math" alttext="i\in S_{t}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><msub><mi>S</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">i\in S_{t}</annotation></semantics></math> runs <math id="S4.SS1.p1.m7" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> local SGD steps with step size <math id="S4.SS1.p1.m8" class="ltx_Math" alttext="\eta_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\eta_{\ell}</annotation></semantics></math> on minibatches <math id="S4.SS1.p1.m9" class="ltx_Math" alttext="\xi" display="inline" intent=":literal"><semantics><mi>ξ</mi><annotation encoding="application/x-tex">\xi</annotation></semantics></math>:</p>
<table id="S4.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E10.m1" class="ltx_math_unparsed" alttext="w_{i}^{(e+1)}\;=\;w_{i}^{(e)}-\eta_{\ell}\,g_{i}\!\big(w_{i}^{(e)},\xi\big),\qquad e=0,\dots,E-1,\ \ w_{i}^{(0)}=w_{t}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mrow><mi>e</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0.558em" rspace="0.558em">=</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msub><mi>η</mi><mi mathvariant="normal">ℓ</mi></msub><msub><mi>g</mi><mi>i</mi></msub><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi>ξ</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo rspace="2.167em">,</mo><mi>e</mi><mo>=</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>E</mi><mo>−</mo><mn>1</mn><mo rspace="1.167em">,</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msub><mi>w</mi><mi>t</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">w_{i}^{(e+1)}\;=\;w_{i}^{(e)}-\eta_{\ell}\,g_{i}\!\big(w_{i}^{(e)},\xi\big),\qquad e=0,\dots,E-1,\ \ w_{i}^{(0)}=w_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p1.2" class="ltx_p">The server forms a (possibly robust) aggregate gradient surrogate <math id="S4.SS1.p1.m10" class="ltx_Math" alttext="\bar{g}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>g</mi><mo>¯</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\bar{g}_{t}</annotation></semantics></math> from <math id="S4.SS1.p1.m11" class="ltx_Math" alttext="\{w_{i}^{(E)}\}_{i\in S_{t}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msubsup><mi>w</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>S</mi><mi>t</mi></msub></mrow></msub><annotation encoding="application/x-tex">\{w_{i}^{(E)}\}_{i\in S_{t}}</annotation></semantics></math> and updates</p>
<table id="S4.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E11.m1" class="ltx_Math" alttext="w_{t+1}\;=\;w_{t}\;-\;\eta_{g}\,\bar{g}_{t}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo rspace="0.502em">−</mo><mrow><msub><mi>η</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">w_{t+1}\;=\;w_{t}\;-\;\eta_{g}\,\bar{g}_{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p1.3" class="ltx_p">with global step size <math id="S4.SS1.p1.m12" class="ltx_Math" alttext="\eta_{g}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>g</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{g}&gt;0</annotation></semantics></math>. Write <math id="S4.SS1.p1.m13" class="ltx_Math" alttext="\tilde{g}_{i,t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">\tilde{g}_{i,t}</annotation></semantics></math> for the effective client gradient after <math id="S4.SS1.p1.m14" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> local steps, and define</p>
<table id="S4.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E12.m1" class="ltx_Math" alttext="\bar{g}_{t}\;=\;\mathcal{A}\big(\{\alpha_{i,t}\,\tilde{g}_{i,t}\}_{i\in S_{t}}\big),\quad\alpha_{i,t}\!\geq\!0,\ \sum_{i\in S_{t}}\alpha_{i,t}=1," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>g</mi><mo>¯</mo></mover><mi>t</mi></msub><mo lspace="0.558em" rspace="0.558em">=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>∈</mo><msub><mi>S</mi><mi>t</mi></msub></mrow></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>≥</mo><mn>0</mn></mrow><mo rspace="0.500em">,</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>S</mi><mi>t</mi></msub></mrow></munder><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo>=</mo><mn>1</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\bar{g}_{t}\;=\;\mathcal{A}\big(\{\alpha_{i,t}\,\tilde{g}_{i,t}\}_{i\in S_{t}}\big),\quad\alpha_{i,t}\!\geq\!0,\ \sum_{i\in S_{t}}\alpha_{i,t}=1,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p1.4" class="ltx_p">where <math id="S4.SS1.p1.m15" class="ltx_Math" alttext="\mathcal{A}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}(\cdot)</annotation></semantics></math> is a robust aggregator (FedAvg/median/trimmed mean/Krum, etc.).</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS2.6" class="ltx_text">IV-B</span> </span><span id="S4.SS2.7" class="ltx_text ltx_font_italic">Assumptions</span></h3>

<div id="S4.SS2.p1" class="ltx_para">
<ul id="S4.I1" class="ltx_itemize">
<li id="S4.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A1)</span> 
<div id="S4.I1.ix1.p1" class="ltx_para">
<p id="S4.I1.ix1.p1.1" class="ltx_p"><span id="S4.I1.ix1.p1.1.1" class="ltx_text ltx_font_bold">Smoothness:</span> Each <math id="S4.I1.ix1.p1.m1" class="ltx_Math" alttext="f_{i}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>i</mi></msub><annotation encoding="application/x-tex">f_{i}</annotation></semantics></math> is <math id="S4.I1.ix1.p1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-smooth:
<math id="S4.I1.ix1.p1.m3" class="ltx_Math" alttext="\|\nabla f_{i}(x)-\nabla f_{i}(y)\|\leq L\|x-y\|" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|\nabla f_{i}(x)-\nabla f_{i}(y)\|\leq L\|x-y\|</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A2)</span> 
<div id="S4.I1.ix2.p1" class="ltx_para">
<p id="S4.I1.ix2.p1.1" class="ltx_p"><span id="S4.I1.ix2.p1.1.1" class="ltx_text ltx_font_bold">Stochastic noise:</span> <math id="S4.I1.ix2.p1.m1" class="ltx_Math" alttext="\mathbb{E}[g_{i}(w,\xi)\mid w]=\nabla f_{i}(w)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><msub><mi>g</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>w</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[g_{i}(w,\xi)\mid w]=\nabla f_{i}(w)</annotation></semantics></math> and
<math id="S4.I1.ix2.p1.m2" class="ltx_Math" alttext="\mathbb{E}\|g_{i}(w,\xi)-\nabla f_{i}(w)\|^{2}\leq\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>g</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbb{E}\|g_{i}(w,\xi)-\nabla f_{i}(w)\|^{2}\leq\sigma^{2}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A3)</span> 
<div id="S4.I1.ix3.p1" class="ltx_para">
<p id="S4.I1.ix3.p1.1" class="ltx_p"><span id="S4.I1.ix3.p1.1.1" class="ltx_text ltx_font_bold">Client dissimilarity:</span>
<math id="S4.I1.ix3.p1.m1" class="ltx_Math" alttext="\sum_{i=1}^{N}p_{i}\|\nabla f_{i}(w)-\nabla F(w)\|^{2}\leq\zeta^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mrow><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>≤</mo><msup><mi>ζ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{N}p_{i}\|\nabla f_{i}(w)-\nabla F(w)\|^{2}\leq\zeta^{2}</annotation></semantics></math>, <math id="S4.I1.ix3.p1.m2" class="ltx_Math" alttext="\forall w" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∀</mo><mi>w</mi></mrow><annotation encoding="application/x-tex">\forall w</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A4)</span> 
<div id="S4.I1.ix4.p1" class="ltx_para">
<p id="S4.I1.ix4.p1.1" class="ltx_p"><span id="S4.I1.ix4.p1.1.1" class="ltx_text ltx_font_bold">Selection floors &amp; bias:</span> FedFiTS’ quotas/exploration ensure
<math id="S4.I1.ix4.p1.m1" class="ltx_Math" alttext="\Pr(i\!\in\!S_{t})\geq p_{\min}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0.108em" rspace="0.108em">∈</mo><msub><mi>S</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msub><mi>p</mi><mi>min</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Pr(i\!\in\!S_{t})\geq p_{\min}&gt;0</annotation></semantics></math> and the selection bias</p>
<table id="S4.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E13.m1" class="ltx_math_unparsed" alttext="\varepsilon_{\mathrm{sel},t}\;\triangleq\;\Big\|\sum_{i\in S_{t}}\alpha_{i,t}\nabla f_{i}(w_{t})-\sum_{i=1}^{N}p_{i}\nabla f_{i}(w_{t})\Big\|" display="block" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mrow><mi>sel</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0.558em" rspace="0em">≜</mo><mo mathsize="1.600em" rspace="0em">∥</mo><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>S</mi><mi>t</mi></msub></mrow></munder><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">−</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><msub><mi>p</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" mathsize="1.600em">∥</mo></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathrm{sel},t}\;\triangleq\;\Big\|\sum_{i\in S_{t}}\alpha_{i,t}\nabla f_{i}(w_{t})-\sum_{i=1}^{N}p_{i}\nabla f_{i}(w_{t})\Big\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
<p id="S4.I1.ix4.p1.2" class="ltx_p">satisfies <math id="S4.I1.ix4.p1.m2" class="ltx_Math" alttext="\mathbb{E}\,\varepsilon_{\mathrm{sel},t}^{2}\leq\varepsilon_{\mathrm{sel}}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi>sel</mi><mo>,</mo><mi>t</mi></mrow><mn>2</mn></msubsup></mrow><mo>≤</mo><msubsup><mi>ε</mi><mi>sel</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{E}\,\varepsilon_{\mathrm{sel},t}^{2}\leq\varepsilon_{\mathrm{sel}}^{2}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.ix5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A5)</span> 
<div id="S4.I1.ix5.p1" class="ltx_para">
<p id="S4.I1.ix5.p1.1" class="ltx_p"><span id="S4.I1.ix5.p1.1.1" class="ltx_text ltx_font_bold">Robust aggregation error:</span>
<math id="S4.I1.ix5.p1.m1" class="ltx_Math" alttext="\mathbb{E}\|\bar{g}_{t}-\sum_{i\in S_{t}}\alpha_{i,t}\tilde{g}_{i,t}\|^{2}\leq\varepsilon_{\mathrm{agg}}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>g</mi><mo>¯</mo></mover><mi>t</mi></msub><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><msub><mi>S</mi><mi>t</mi></msub></mrow></msub><mrow><msub><mi>α</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><msubsup><mi>ε</mi><mi>agg</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{E}\|\bar{g}_{t}-\sum_{i\in S_{t}}\alpha_{i,t}\tilde{g}_{i,t}\|^{2}\leq\varepsilon_{\mathrm{agg}}^{2}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.ix6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A6)</span> 
<div id="S4.I1.ix6.p1" class="ltx_para">
<p id="S4.I1.ix6.p1.1" class="ltx_p"><span id="S4.I1.ix6.p1.1.1" class="ltx_text ltx_font_bold">Local/slot drift:</span>
<math id="S4.I1.ix6.p1.m1" class="ltx_Math" alttext="\mathbb{E}\|\tilde{g}_{i,t}-\nabla f_{i}(w_{t})\|^{2}\leq\varepsilon_{\mathrm{loc}}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>g</mi><mo>~</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><msubsup><mi>ε</mi><mi>loc</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{E}\|\tilde{g}_{i,t}-\nabla f_{i}(w_{t})\|^{2}\leq\varepsilon_{\mathrm{loc}}^{2}</annotation></semantics></math>, and slot staleness (fixed team within a slot) yields
<math id="S4.I1.ix6.p1.m2" class="ltx_Math" alttext="\mathbb{E}\,\varepsilon_{\mathrm{slot},t}^{2}\leq\varepsilon_{\mathrm{slot}}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>ε</mi><mrow><mi>slot</mi><mo>,</mo><mi>t</mi></mrow><mn>2</mn></msubsup></mrow><mo>≤</mo><msubsup><mi>ε</mi><mi>slot</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{E}\,\varepsilon_{\mathrm{slot},t}^{2}\leq\varepsilon_{\mathrm{slot}}^{2}</annotation></semantics></math>.</p>
</div></li>
<li id="S4.I1.ix7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A7)</span> 
<div id="S4.I1.ix7.p1" class="ltx_para">
<p id="S4.I1.ix7.p1.1" class="ltx_p"><span id="S4.I1.ix7.p1.1.1" class="ltx_text ltx_font_bold">Stepsizes:</span> <math id="S4.I1.ix7.p1.m1" class="ltx_Math" alttext="\eta_{g}\leq 1/(2L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>g</mi></msub><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{g}\leq 1/(2L)</annotation></semantics></math>; choose <math id="S4.I1.ix7.p1.m2" class="ltx_Math" alttext="\eta_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">\eta_{\ell}</annotation></semantics></math> such that
<math id="S4.I1.ix7.p1.m3" class="ltx_Math" alttext="\varepsilon_{\mathrm{loc}}^{2}=O\!\big(E\,\eta_{\ell}^{2}(\sigma^{2}+\zeta^{2})\big)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ε</mi><mi>loc</mi><mn>2</mn></msubsup><mo>=</mo><mrow><mpadded style="width:0.621em;" width="0.621em"><mi>O</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>E</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>η</mi><mi mathvariant="normal">ℓ</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ζ</mi><mn>2</mn></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\mathrm{loc}}^{2}=O\!\big(E\,\eta_{\ell}^{2}(\sigma^{2}+\zeta^{2})\big)</annotation></semantics></math>.</p>
</div></li>
</ul>
<p id="S4.SS2.p1.1" class="ltx_p">Collect residuals in</p>
<table id="S4.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E14.m1" class="ltx_Math" alttext="\mathcal{R}\;\triangleq\;\varepsilon_{\mathrm{sel}}^{2}+\varepsilon_{\mathrm{agg}}^{2}+\varepsilon_{\mathrm{loc}}^{2}+\varepsilon_{\mathrm{slot}}^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo lspace="0.558em" rspace="0.558em">≜</mo><mrow><msubsup><mi>ε</mi><mi>sel</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>ε</mi><mi>agg</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>ε</mi><mi>loc</mi><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>ε</mi><mi>slot</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{R}\;\triangleq\;\varepsilon_{\mathrm{sel}}^{2}+\varepsilon_{\mathrm{agg}}^{2}+\varepsilon_{\mathrm{loc}}^{2}+\varepsilon_{\mathrm{slot}}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS3.6" class="ltx_text">IV-C</span> </span><span id="S4.SS3.7" class="ltx_text ltx_font_italic">One-Step Descent</span></h3>

<div id="S4.SS3.p1" class="ltx_para ltx_noindent">
<p id="S4.SS3.p1.1" class="ltx_p"><span id="S4.SS3.p1.1.1" class="ltx_text ltx_font_bold">Lemma 1 (Expected Descent).</span>
<em id="S4.SS3.p1.1.2" class="ltx_emph ltx_font_italic">Under (A1)–(A7), there exist constants <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="c_{1},c_{2},c_{3}=O(1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><msub><mi>c</mi><mn>2</mn></msub><mo>,</mo><mrow><msub><mi>c</mi><mn>3</mn></msub><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{1},c_{2},c_{3}=O(1)</annotation></semantics></math> such that</em></p>
</div>
<div id="S4.SS3.p2" class="ltx_para">
<table id="S4.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E15.m1" class="ltx_Math" alttext="\mathbb{E}\big[F(w_{t+1})\big]\;\leq\;\mathbb{E}\big[F(w_{t})\big]-\frac{\eta_{g}}{2}\,\mathbb{E}\|\nabla F(w_{t})\|^{2}\\
+\eta_{g}\,\Big(c_{1}\,\sigma^{2}+c_{2}\,\zeta^{2}+c_{3}\,\mathcal{R}\Big)" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.560em">]</mo></mrow></mrow><mo rspace="0.838em">≤</mo><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>−</mo><mrow><mfrac><msub><mi>η</mi><mi>g</mi></msub><mn>2</mn></mfrac><mo lspace="0.340em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>g</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ζ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>3</mn></msub><mo lspace="0.170em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\mathbb{E}\big[F(w_{t+1})\big]\;\leq\;\mathbb{E}\big[F(w_{t})\big]-\frac{\eta_{g}}{2}\,\mathbb{E}\|\nabla F(w_{t})\|^{2}\\
+\eta_{g}\,\Big(c_{1}\,\sigma^{2}+c_{2}\,\zeta^{2}+c_{3}\,\mathcal{R}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
</div>
<div id="S4.SS3.p3" class="ltx_para">
<p id="S4.SS3.p3.1" class="ltx_p"><em id="S4.SS3.p3.1.1" class="ltx_emph ltx_font_italic">Sketch.</em> Apply <math id="S4.SS3.p3.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-smoothness to <math id="S4.SS3.p3.m2" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math> at <math id="S4.SS3.p3.m3" class="ltx_Math" alttext="w_{t+1}=w_{t}-\eta_{g}\bar{g}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>w</mi><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>η</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">w_{t+1}=w_{t}-\eta_{g}\bar{g}_{t}</annotation></semantics></math>, decompose <math id="S4.SS3.p3.m4" class="ltx_Math" alttext="\bar{g}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>g</mi><mo>¯</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\bar{g}_{t}</annotation></semantics></math> into the ideal global gradient plus (zero-mean) stochastic noise, heterogeneity, selection/aggregation errors, and local/slot drift; then use Young’s inequality and <math id="S4.SS3.p3.m5" class="ltx_Math" alttext="\eta_{g}\leq 1/(2L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>g</mi></msub><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{g}\leq 1/(2L)</annotation></semantics></math>.</p>
</div>
</section>
<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS4.6" class="ltx_text">IV-D</span> </span><span id="S4.SS4.7" class="ltx_text ltx_font_italic">Non-Convex Stationarity</span></h3>

<div id="S4.SS4.p1" class="ltx_para ltx_noindent">
<p id="S4.SS4.p1.1" class="ltx_p"><span id="S4.SS4.p1.1.1" class="ltx_text ltx_font_bold">Theorem 1 (Stationarity Bound).</span>
<em id="S4.SS4.p1.1.2" class="ltx_emph ltx_font_italic">Let <math id="S4.SS4.p1.m1" class="ltx_Math" alttext="F^{\star}\!\triangleq\!\inf_{w}F(w)" display="inline" intent=":literal"><semantics><mrow><msup><mi>F</mi><mo>⋆</mo></msup><mo lspace="0.108em" rspace="0.0539em">≜</mo><mrow><msub><mo lspace="0.0539em" rspace="0.167em">inf</mo><mi>w</mi></msub><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">F^{\star}\!\triangleq\!\inf_{w}F(w)</annotation></semantics></math>.
Under (A1)–(A7) with <math id="S4.SS4.p1.m2" class="ltx_Math" alttext="\eta_{g}\leq 1/(2L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>g</mi></msub><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{g}\leq 1/(2L)</annotation></semantics></math>,</em></p>
</div>
<div id="S4.SS4.p2" class="ltx_para">
<table id="S4.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E16.m1" class="ltx_Math" alttext="\min_{0\leq t&lt;T}\ \mathbb{E}\|\nabla F(w_{t})\|^{2}\;\leq\;\frac{2\big(F(w_{0})-F^{\star}\big)}{\eta_{g}T}\\
+2\Big(c_{1}\,\sigma^{2}+c_{2}\,\zeta^{2}+c_{3}\,\mathcal{R}\Big)" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><munder><mi>min</mi><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>&lt;</mo><mi>T</mi></mrow></munder><mo lspace="1.167em">⁡</mo><mi>𝔼</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.280em" stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo rspace="0.838em">≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>F</mi><mo>⋆</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><msub><mi>η</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mi>c</mi><mn>1</mn></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo lspace="0.170em" rspace="0em">​</mo><msup><mi>ζ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>c</mi><mn>3</mn></msub><mo lspace="0.170em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\min_{0\leq t&lt;T}\ \mathbb{E}\|\nabla F(w_{t})\|^{2}\;\leq\;\frac{2\big(F(w_{0})-F^{\star}\big)}{\eta_{g}T}\\
+2\Big(c_{1}\,\sigma^{2}+c_{2}\,\zeta^{2}+c_{3}\,\mathcal{R}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.p3" class="ltx_para">
<p id="S4.SS4.p3.1" class="ltx_p"><em id="S4.SS4.p3.1.1" class="ltx_emph ltx_font_italic">Proof.</em> Sum Lemma 1 over <math id="S4.SS4.p3.m1" class="ltx_Math" alttext="t=0,\dots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=0,\dots,T-1</annotation></semantics></math> and rearrange.</p>
</div>
</section>
<section id="S4.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS5.6" class="ltx_text">IV-E</span> </span><span id="S4.SS5.7" class="ltx_text ltx_font_italic">Linear Rate under Polyak–Łojasiewicz (PL)</span></h3>

<div id="S4.SS5.p1" class="ltx_para ltx_noindent">
<p id="S4.SS5.p1.1" class="ltx_p"><span id="S4.SS5.p1.1.1" class="ltx_text ltx_font_bold">Assumption (PL).</span>
There exists <math id="S4.SS5.p1.m1" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math> such that <math id="S4.SS5.p1.m2" class="ltx_Math" alttext="\tfrac{1}{2}\|\nabla F(w)\|^{2}\geq\mu\,(F(w)-F^{\star})" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≥</mo><mrow><mi>μ</mi><mo lspace="0.170em">⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>F</mi><mo>⋆</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tfrac{1}{2}\|\nabla F(w)\|^{2}\geq\mu\,(F(w)-F^{\star})</annotation></semantics></math> for all <math id="S4.SS5.p1.m3" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>.</p>
</div>
<div id="S4.SS5.p2" class="ltx_para ltx_noindent">
<p id="S4.SS5.p2.1" class="ltx_p"><span id="S4.SS5.p2.1.1" class="ltx_text ltx_font_bold">Corollary 1 (Linear Convergence to a Neighborhood).</span>
<em id="S4.SS5.p2.1.2" class="ltx_emph ltx_font_italic">Under (A1)–(A7) and PL, with <math id="S4.SS5.p2.m1" class="ltx_Math" alttext="\eta_{g}\leq 1/(2L)" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>g</mi></msub><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{g}\leq 1/(2L)</annotation></semantics></math>,</em></p>
</div>
<div id="S4.SS5.p3" class="ltx_para">
<table id="S4.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E17.m1" class="ltx_Math" alttext="\mathbb{E}\big[F(w_{t+1})-F^{\star}\big]\;\leq\;(1-\mu\eta_{g})\,\mathbb{E}\big[F(w_{t})-F^{\star}\big]\\
+\eta_{g}\,\tilde{c}\,\big(\sigma^{2}+\zeta^{2}+\mathcal{R}\big)" display="block" intent=":literal"><semantics><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>F</mi><mo>⋆</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.560em">]</mo></mrow></mrow><mo rspace="0.838em">≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>g</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.340em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>F</mi><mo>⋆</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>c</mi><mo>~</mo></mover><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ζ</mi><mn>2</mn></msup><mo>+</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\mathbb{E}\big[F(w_{t+1})-F^{\star}\big]\;\leq\;(1-\mu\eta_{g})\,\mathbb{E}\big[F(w_{t})-F^{\star}\big]\\
+\eta_{g}\,\tilde{c}\,\big(\sigma^{2}+\zeta^{2}+\mathcal{R}\big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
</div>
<div id="S4.SS5.p4" class="ltx_para">
<p id="S4.SS5.p4.1" class="ltx_p"><em id="S4.SS5.p4.1.1" class="ltx_emph ltx_font_italic">for some <math id="S4.SS5.p4.m1" class="ltx_Math" alttext="\tilde{c}=O(1)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>c</mi><mo>~</mo></mover><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{c}=O(1)</annotation></semantics></math>. Hence, for all <math id="S4.SS5.p4.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>,</em></p>
<table id="S4.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E18.m1" class="ltx_Math" alttext="\mathbb{E}\big[F(w_{t})-F^{\star}\big]\;\leq\;(1-\mu\eta_{g})^{t}\,\big(F(w_{0})-F^{\star}\big)+\frac{\tilde{c}}{\mu}\,\big(\sigma^{2}+\zeta^{2}+\mathcal{R}\big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>F</mi><mo>⋆</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">]</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>g</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>F</mi><mo>⋆</mo></msup></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mover accent="true"><mi>c</mi><mo>~</mo></mover><mi>μ</mi></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><msup><mi>ζ</mi><mn>2</mn></msup><mo>+</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\big[F(w_{t})-F^{\star}\big]\;\leq\;(1-\mu\eta_{g})^{t}\,\big(F(w_{0})-F^{\star}\big)+\frac{\tilde{c}}{\mu}\,\big(\sigma^{2}+\zeta^{2}+\mathcal{R}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S4.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S4.SS6.6" class="ltx_text">IV-F</span> </span><span id="S4.SS6.7" class="ltx_text ltx_font_italic">Remarks</span></h3>

<div id="S4.SS6.p1" class="ltx_para">
<ul id="S4.I2" class="ltx_itemize">
<li id="S4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i1.p1" class="ltx_para">
<p id="S4.I2.i1.p1.1" class="ltx_p"><span id="S4.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Selection floors / explore–exploit</span> in FedFiTS bound <math id="S4.I2.i1.p1.m1" class="ltx_Math" alttext="\varepsilon_{\mathrm{sel}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>ε</mi><mi>sel</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\varepsilon_{\mathrm{sel}}^{2}</annotation></semantics></math> and improve gradient representativeness.</p>
</div></li>
<li id="S4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i2.p1" class="ltx_para">
<p id="S4.I2.i2.p1.1" class="ltx_p"><span id="S4.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Multi-objective fitness</span> favors larger/consistent clients, effectively reducing <math id="S4.I2.i2.p1.m1" class="ltx_Math" alttext="\zeta^{2}" display="inline" intent=":literal"><semantics><msup><mi>ζ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\zeta^{2}</annotation></semantics></math> and noise.</p>
</div></li>
<li id="S4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i3.p1" class="ltx_para">
<p id="S4.I2.i3.p1.1" class="ltx_p"><span id="S4.I2.i3.p1.1.1" class="ltx_text ltx_font_bold">Robust aggregation</span> tightens <math id="S4.I2.i3.p1.m1" class="ltx_Math" alttext="\varepsilon_{\mathrm{agg}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>ε</mi><mi>agg</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\varepsilon_{\mathrm{agg}}^{2}</annotation></semantics></math> under outliers/poisoning.</p>
</div></li>
<li id="S4.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S4.I2.i4.p1" class="ltx_para">
<p id="S4.I2.i4.p1.1" class="ltx_p"><span id="S4.I2.i4.p1.1.1" class="ltx_text ltx_font_bold">Adaptive slots (MSL/PFT)</span> cap <math id="S4.I2.i4.p1.m1" class="ltx_Math" alttext="\varepsilon_{\mathrm{slot}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi>ε</mi><mi>slot</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\varepsilon_{\mathrm{slot}}^{2}</annotation></semantics></math> by early reselection when plateaus are detected.</p>
</div></li>
</ul>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">V </span><span id="S5.2" class="ltx_text ltx_font_smallcaps">Dynamic <math id="S5.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> parameter determination</span></h2>

<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS1.6" class="ltx_text">V-A</span> </span><span id="S5.SS1.7" class="ltx_text ltx_font_italic">Dynamic <math id="S5.SS1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> determination principle</span></h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">The <span id="S5.SS1.p1.1.1" class="ltx_text ltx_font_bold">FedFiST</span> scoring function has been formulated and expressed by Eq. (<a href="#S3.E2" title="In III-A FedFiTS Problem Formulation ‣ III Fittest Selection, Slotted Client Scheduling for Trusthworthy FL Model ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>). To find the optimal <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, we express each client’s score function in terms of <math id="S5.SS1.p1.m2" class="ltx_Math" alttext="\alpha_{k}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\alpha_{k}</annotation></semantics></math> as <math id="S5.SS1.p1.m3" class="ltx_Math" alttext="score(\alpha_{k},t)=(q_{k}-\theta_{k})\times\alpha_{k}+\theta_{k}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>α</mi><mi>k</mi></msub><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>−</mo><msub><mi>θ</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><msub><mi>α</mi><mi>k</mi></msub></mrow><mo>+</mo><msub><mi>θ</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">score(\alpha_{k},t)=(q_{k}-\theta_{k})\times\alpha_{k}+\theta_{k}</annotation></semantics></math>, which results in a line segment with <math id="S5.SS1.p1.m4" class="ltx_Math" alttext="\alpha_{k}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\alpha_{k}</annotation></semantics></math> bounded between <math id="S5.SS1.p1.m5" class="ltx_Math" alttext="[0,1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,1]</annotation></semantics></math>. Finding the <math id="S5.SS1.p1.m6" class="ltx_Math" alttext="\alpha_{k}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\alpha_{k}</annotation></semantics></math> that maximizes the score for the client is equivalent to finding the maximum of the segment, implying the calculation of its values at the boundaries. In our case,</p>
<table id="S5.EGx2" class="ltx_equationgroup ltx_eqn_gather ltx_eqn_table">

<tbody id="S5.EGx2.1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.EGx2.m1" class="ltx_Math" alttext="\displaystyle\alpha_{k}=\left\{\begin{array}[]{lr}1,&amp;\text{if }q_{k}&gt;\theta_{k}\\
0,&amp;\text{if }q_{k}\leq\theta_{k}\end{array}\right." display="block" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>k</mi></msub><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><mo>&gt;</mo><msub><mi>θ</mi><mi>k</mi></msub></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>k</mi></msub></mrow><mo>≤</mo><msub><mi>θ</mi><mi>k</mi></msub></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\alpha_{k}=\left\{\begin{array}[]{lr}1,&amp;\text{if }q_{k}&gt;\theta_{k}\\
0,&amp;\text{if }q_{k}\leq\theta_{k}\end{array}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p1.2" class="ltx_p">After determining all the <math id="S5.SS1.p1.m7" class="ltx_Math" alttext="\alpha_{k}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\alpha_{k}</annotation></semantics></math> values, which are the abscissas maximizing the clients’ score function, we need to find the unique <math id="S5.SS1.p1.m8" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> value to be used for client selection.
The principle of function maximization would suggest using the <math id="S5.SS1.p1.m9" class="ltx_Math" alttext="\alpha_{k}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\alpha_{k}</annotation></semantics></math> that maximizes the segment with the highest maximum value as the abscissa of the global function.
However, in our context, it is very risky to choose 1 or 0 as values due to (1) exposure to attacks when <math id="S5.SS1.p1.m10" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> = 1, and (2) strict exclusion of all clients that are not performing well no matter what sizes they have when <math id="S5.SS1.p1.m11" class="ltx_Math" alttext="\alpha=0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha=0</annotation></semantics></math>.
To avoid these extremes values, we use the average of the <math id="S5.SS1.p1.m12" class="ltx_Math" alttext="\alpha_{k}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\alpha_{k}</annotation></semantics></math>, as it theoretically provides information on the proximity to the maximum.</p>
<table id="S5.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S5.E21.m1" class="ltx_Math" alttext="\alpha=\sum_{k}\alpha_{k}" display="block" intent=":literal"><semantics><mrow><mi>α</mi><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder><msub><mi>α</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha=\sum_{k}\alpha_{k}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="S5.SS1.p1.3" class="ltx_p">This dynamic <math id="S5.SS1.p1.m13" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is subject to the quality and the size of the clients. Whenever <math id="S5.SS1.p1.m14" class="ltx_Math" alttext="\sum_{k=1}^{K}1(q_{k}&gt;\theta_{k})&gt;\sum_{k=1}^{K}1(q_{k}&lt;\theta_{k})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>&gt;</mo><msub><mi>θ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">&gt;</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>q</mi><mi>k</mi></msub><mo>&lt;</mo><msub><mi>θ</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{K}1(q_{k}&gt;\theta_{k})&gt;\sum_{k=1}^{K}1(q_{k}&lt;\theta_{k})</annotation></semantics></math> <math id="S5.SS1.p1.m15" class="ltx_Math" alttext="\alpha&gt;0.5" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0.5</annotation></semantics></math> and <math id="S5.SS1.p1.m16" class="ltx_Math" alttext="\alpha&lt;0.5" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&lt;</mo><mn>0.5</mn></mrow><annotation encoding="application/x-tex">\alpha&lt;0.5</annotation></semantics></math> otherwise.</p>
</div>
<div id="S5.SS1.p2" class="ltx_para">
<p id="S5.SS1.p2.1" class="ltx_p">“‘latex</p>
</div>
</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">VI </span><span id="S6.2" class="ltx_text ltx_font_smallcaps">Experimental Evaluation</span></h2>

<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p">This section evaluates the performance of <span id="S6.p1.1.1" class="ltx_text ltx_font_italic">FedFiTS</span> in terms of accuracy, convergence speed, robustness to poisoning, communication efficiency, and fairness considerations. The experiments are conducted across multiple datasets and compared against standard and selective FL baselines.</p>
</div>
<section id="S6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S6.SS1.6" class="ltx_text">VI-A</span> </span><span id="S6.SS1.7" class="ltx_text ltx_font_italic">Experimental Setup</span></h3>

<div id="S6.SS1.p1" class="ltx_para">
<p id="S6.SS1.p1.1" class="ltx_p">We evaluate <span id="S6.SS1.p1.1.1" class="ltx_text ltx_font_bold">FedFiTS</span> on three categories of datasets:
(i) <span id="S6.SS1.p1.1.2" class="ltx_text ltx_font_bold">Medical imaging datasets</span>, including the X-ray Pneumonia Detection dataset;
(ii) <span id="S6.SS1.p1.1.3" class="ltx_text ltx_font_bold">Vision benchmarks</span>, namely MNIST and Fashion-MNIST; and
(iii) <span id="S6.SS1.p1.1.4" class="ltx_text ltx_font_bold">Tabular datasets</span>, including the Crop Recommendation dataset which demonstrates cross-domain applicability.
Data distributions are partitioned under non-IID settings to reflect real-world heterogeneity.</p>
</div>
<div id="S6.SS1.p2" class="ltx_para">
<p id="S6.SS1.p2.1" class="ltx_p">Baselines include <span id="S6.SS1.p2.1.1" class="ltx_text ltx_font_bold">FedAvg</span>, <span id="S6.SS1.p2.1.2" class="ltx_text ltx_font_bold">FedRand</span>, and <span id="S6.SS1.p2.1.3" class="ltx_text ltx_font_bold">FedPow</span>, representing standard and selective FL approaches. In all cases, we simulate client unreliability and adversarial behavior through data and model poisoning attacks. Hyperparameters are tuned to ensure fairness across methods.</p>
</div>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S6.SS2.6" class="ltx_text">VI-B</span> </span><span id="S6.SS2.7" class="ltx_text ltx_font_italic">Performance Metrics</span></h3>

<div id="S6.SS2.p1" class="ltx_para">
<p id="S6.SS2.p1.1" class="ltx_p">Evaluation is based on the following dimensions:</p>
<ul id="S6.I1" class="ltx_itemize">
<li id="S6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S6.I1.i1.p1" class="ltx_para">
<p id="S6.I1.i1.p1.1" class="ltx_p"><span id="S6.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Accuracy and Convergence Speed</span>: classification accuracy over training rounds and rate of convergence.</p>
</div></li>
<li id="S6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S6.I1.i2.p1" class="ltx_para">
<p id="S6.I1.i2.p1.1" class="ltx_p"><span id="S6.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Robustness to Attacks</span>: degradation under poisoning and adversarial scenarios.</p>
</div></li>
<li id="S6.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S6.I1.i3.p1" class="ltx_para">
<p id="S6.I1.i3.p1.1" class="ltx_p"><span id="S6.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Communication Efficiency</span>: per-round uplink/downlink cost relative to FedAvg and FedPow.</p>
</div></li>
<li id="S6.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S6.I1.i4.p1" class="ltx_para">
<p id="S6.I1.i4.p1.1" class="ltx_p"><span id="S6.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">Fairness Considerations</span>: analysis of participation ratios and client inclusion balance, serving as a proxy for fairness. While explicit fairness metrics (e.g., group accuracy balance, disparity reduction) are not directly measured here, <span id="S6.I1.i4.p1.1.2" class="ltx_text ltx_font_bold">FedFiTS</span>’s selective strategy inherently promotes fairness by dynamically including reliable but minority clients. We highlight this as a future direction.</p>
</div></li>
</ul>
</div>
</section>
<section id="S6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S6.SS3.6" class="ltx_text">VI-C</span> </span><span id="S6.SS3.7" class="ltx_text ltx_font_italic">Results on Imaging and Vision Datasets</span></h3>

<div id="S6.SS3.p1" class="ltx_para">
<p id="S6.SS3.p1.1" class="ltx_p">Figures <a href="#S6.F4" title="Fig. 4 ‣ Results on MNIST Dataset ‣ VI Experimental Evaluation ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>–<a href="#S6.F11" title="Fig. 11 ‣ VI-F Hyperparameter Sensitivity Analysis ‣ VI Experimental Evaluation ‣ FedFiTS: Fitness-Selected, Slotted Client Scheduling for Trustworthy Federated Learning in Healthcare AI" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>, together with the corresponding tables, present the comparative evaluation of <span id="S6.SS3.p1.1.1" class="ltx_text ltx_font_italic">FedFiTS</span> against baseline algorithms including FedAvg, FedRand, and FedPow. The results span multiple datasets—MNIST, Fashion-MNIST, and X-ray Pneumonia—covering both vision benchmarks and real-world medical imaging tasks.</p>
</div>
</section>
<section id="S6.SSx1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection">Results on MNIST Dataset</h3>

<div id="S6.SSx1.p1" class="ltx_para">
<p id="S6.SSx1.p1.1" class="ltx_p">We first compare <span id="S6.SSx1.p1.1.1" class="ltx_text ltx_font_bold">FedFiTS</span> (slot size = 1) with FedAvg (<math id="S6.SSx1.p1.m1" class="ltx_Math" alttext="c=1.0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">c=1.0</annotation></semantics></math>). Both use all available clients per round.
Training/testing: 10,000 / 2,000 MNIST images. Teams of 10, 50, 100, and 200 clients, partitioned using Dirichlet distributions with <math id="S6.SSx1.p1.m2" class="ltx_Math" alttext="\alpha=0.3,0.2,2.0,1.0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>α</mi><mo>=</mo><mn>0.3</mn></mrow><mo>,</mo><mn>0.2</mn><mo>,</mo><mn>2.0</mn><mo>,</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\alpha=0.3,0.2,2.0,1.0</annotation></semantics></math>.</p>
</div>
<figure id="S6.F4" class="ltx_figure"><img src="2509.19120v1/images/FedFiTS_comp_FedAVG.PNG" id="S6.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:287/222;" width="287" height="222" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Fig. 4: </span>Accuracy comparison of FedAvg and <span id="S6.F4.3" class="ltx_text ltx_font_bold">FedFiTS</span> under normal and attack modes on MNIST.</figcaption>
</figure>
<figure id="S6.T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">TABLE III: </span><span id="S6.T3.3" class="ltx_text ltx_font_bold">FedFiTS</span> (slot size = 1) vs. FedAvg (<math id="S6.T3.m2" class="ltx_Math" alttext="c=1.0" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">c=1.0</annotation></semantics></math>) on MNIST: Accuracy and Execution Time</figcaption>
<table id="S6.T3.4" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S6.T3.4.1" class="ltx_tr">
<td id="S6.T3.4.1.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Data</td>
