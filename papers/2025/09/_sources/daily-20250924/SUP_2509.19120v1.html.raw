<figure id="alg2" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span>UpdateClient</figcaption>
<div id="alg2.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.4.1" class="ltx_listingline">

<span id="alg2.4.1.1" class="ltx_text ltx_font_typewriter">ClientUpdate(<em id="alg2.4.1.1.1" class="ltx_emph ltx_font_serif ltx_font_italic">(<math id="alg2.m1" class="ltx_Math" alttext="c_{k},w(t-1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>,</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{k},w(t-1)</annotation></semantics></math>)</em>)</span>
</div>
<div id="alg2.4.2" class="ltx_listingline"><math id="alg2.m2" class="ltx_Math" alttext="w_{k}(t-1)\leftarrow w(t-1)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w_{k}(t-1)\leftarrow w(t-1)</annotation></semantics></math>;
</div>
<div id="alg2.4.3" class="ltx_listingline"><span id="alg2.4.3.1" class="ltx_text ltx_font_bold">foreach</span> <em id="alg2.4.3.2" class="ltx_emph ltx_font_italic">local epoch from 1 to <math id="alg2.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math></em> <span id="alg2.4.3.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="alg2.4.4" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <span id="alg2.4.4.1" class="ltx_text ltx_font_bold">foreach</span> <em id="alg2.4.4.2" class="ltx_emph ltx_font_italic">batch <math id="alg2.m4" class="ltx_Math" alttext="b\in B" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>∈</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">b\in B</annotation></semantics></math></em> <span id="alg2.4.4.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="alg2.4.5" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="alg2.m5" class="ltx_math_unparsed" alttext="w_{k}(t)\leftarrow w(t-1)-\eta_{t}\nabla(F_{k}(w(t-1),b)" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mi>w</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>η</mi><mi>t</mi></msub><mo lspace="0.167em">∇</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><mi>w</mi><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">w_{k}(t)\leftarrow w(t-1)-\eta_{t}\nabla(F_{k}(w(t-1),b)</annotation></semantics></math> ;
</div>
<div id="alg2.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> end foreach
</div>
<div id="alg2.4.7" class="ltx_listingline">end foreach
</div>
<div id="alg2.4.8" class="ltx_listingline"><span id="alg2.4.8.1" class="ltx_text ltx_font_bold">if</span> <em id="alg2.4.8.2" class="ltx_emph ltx_font_italic"><math id="alg2.m6" class="ltx_Math" alttext="t=1" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=1</annotation></semantics></math></em> <span id="alg2.4.8.3" class="ltx_text ltx_font_bold">then</span>
</div>
<div id="alg2.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="alg2.m7" class="ltx_Math" alttext="\theta_{k}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mi>k</mi></msub><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\theta_{k}\leftarrow 0</annotation></semantics></math> ;  <span id="alg2.4.9.1" class="ltx_text ltx_font_typewriter">/* </span><span id="alg2.4.9.2" class="ltx_text ltx_font_typewriter">at round t=1 no angle calculation */</span>
</div>
<div id="alg2.4.10" class="ltx_listingline">end if
