{"data":[{"id":"10.48550/arxiv.2509.17401","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17401","identifiers":[{"identifier":"2509.17401","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinyeong","familyName":"Kim","name":"Kim, Jinyeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhyeok","familyName":"Kim","name":"Kim, Junhyeok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yumin","familyName":"Shim","name":"Shim, Yumin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joohyeok","familyName":"Kim","name":"Kim, Joohyeok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunyoung","familyName":"Jung","name":"Jung, Sunyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seong Jae","familyName":"Hwang","name":"Hwang, Seong Jae","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interpreting vision transformers via residual replacement model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:00:57Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:13:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-22T11:28:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-23T00:54:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"How do vision transformers (ViTs) represent and process the world? This paper addresses this long-standing question through the first systematic analysis of 6.6K features across all layers, extracted via sparse autoencoders, and by introducing the residual replacement model, which replaces ViT computations with interpretable features in the residual stream. Our analysis reveals not only a feature evolution from low-level patterns to high-level semantics, but also how ViTs encode curves and spatial positions through specialized feature types. The residual replacement model scalably produces a faithful yet parsimonious circuit for human-scale interpretability by significantly simplifying the original computations. As a result, this framework enables intuitive understanding of ViT mechanisms. Finally, we demonstrate the utility of our framework in debiasing spurious correlations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17401","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:07Z","registered":"2025-09-23T03:11:08Z","published":null,"updated":"2026-10-23T02:50:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16444","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16444","identifiers":[{"identifier":"2509.16444","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenhan","familyName":"Lyu","name":"Lyu, Chenhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutong","familyName":"Song","name":"Song, Yutong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengfei","familyName":"Zhang","name":"Zhang, Pengfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amir M.","familyName":"Rahmani","name":"Rahmani, Amir M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Domain-Specific Constitutional AI: Enhancing Safety in LLM-Powered Mental Health Chatbots"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; J.3; K.4.1","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-19T21:46:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-14T00:14:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-20T03:08:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-23T01:13:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/bsn66969.2025.11337405","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Mental health applications have emerged as a critical area in computational health, driven by rising global rates of mental illness, the integration of AI in psychological care, and the need for scalable solutions in underserved communities. These include therapy chatbots, crisis detection, and wellness platforms handling sensitive data, requiring specialized AI safety beyond general safeguards due to emotional vulnerability, risks like misdiagnosis or symptom exacerbation, and precise management of vulnerable states to avoid severe outcomes such as self-harm or loss of trust. Despite AI safety advances, general safeguards inadequately address mental health-specific challenges, including crisis intervention accuracy to avert escalations, therapeutic guideline adherence to prevent misinformation, scale limitations in resource-constrained settings, and adaptation to nuanced dialogues where generics may introduce biases or miss distress signals. We introduce an approach to apply Constitutional AI training with domain-specific mental health principles for safe, domain-adapted CAI systems in computational mental health applications."},{"descriptionType":"Other","description":"Accepted to 2025 IEEE 21st International Conference on Body Sensor Networks (BSN)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16444","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T02:48:32Z","registered":"2025-09-23T02:48:33Z","published":null,"updated":"2026-10-23T02:50:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16886","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16886","identifiers":[{"identifier":"2509.16886","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yingzhen","familyName":"Hu","name":"Hu, Yingzhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiheng","familyName":"Zhong","name":"Zhong, Yiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aijing","familyName":"Yang","name":"Yang, Aijing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georges El","familyName":"Fakhri","name":"Fakhri, Georges El","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofeng","familyName":"Liu","name":"Liu, Xiaofeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SAM-DCE: Decoupled Context Enhancement for Prompt-Free Medical Image Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T02:39:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:43:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T09:14:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:43:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-21T04:16:00Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-22T00:34:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The Segment Anything Model (SAM) is a promising foundation model for medical image segmentation, but its prompt-driven design is not directly suitable for fully automatic multi-class anatomical segmentation. Without manual point, box, or mask prompts, SAM faces a dual over-smoothing problem: deep image features may lose fine local structural evidence, while mask tokens may become semantically ambiguous. We propose SAM-DCE, a decoupled context enhancement framework for prompt-free medical image segmentation. SAM-DCE introduces Spatial Representation Compensation (SRC) to recover anatomical evidence from intermediate ViT features and Semantic Token Calibration (STC) to improve the category consistency of foreground mask tokens. Rather than replacing the pretrained decoder or fusing output masks, SAM-DCE refines the spatial and semantic representations before recombining them through SAM's original token-to-mask mechanism. On the Synapse multi-organ CT segmentation dataset, SAM-DCE achieved a mean Dice score of 83.86\\% and an HD95 of 16.04 mm, outperforming the representative CNN-, Transformer-, and SAM-based baselines evaluated here. Ablation experiments further showed that SRC and STC provide complementary improvements, supporting the proposed spatial--semantic factorization for prompt-free SAM adaptation."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16886","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:58:54Z","registered":"2025-09-23T02:58:54Z","published":null,"updated":"2026-10-22T03:00:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16998","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16998","identifiers":[{"identifier":"2509.16998","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nishka","familyName":"Khendry","name":"Khendry, Nishka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christos","familyName":"Margadji","name":"Margadji, Christos","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian W.","familyName":"Pattinson","name":"Pattinson, Sebastian W.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IDfRA: Self-Verification for Iterative Design in Robotic Assembly"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T09:31:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:50:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-14T20:29:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-16T00:14:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icra57385.2026.11697014","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Design for Robotic Assembly (DfRA) remains largely dependent on manual planning and heuristic simulation, limiting scalability and robustness in complex industrial settings. Although large language models (LLMs) show promise for semantic reasoning and task planning, most approaches remain tightly coupled to pre-built simulators that assume an accurate world model. We introduce Iterative Design for Robotic Assembly (IDfRA), a closed-loop framework that combines an LLM for plan generation with a vision-language model (VLM) for execution assessment. Given a target structure and a partial environmental signature, the LLM proposes an assembly plan, the robot executes it once at test time, and the VLM evaluates the resulting state to provide feedback for replanning. Through this iterative planning-execution-verification loop, the system progressively improves semantic fidelity and physical feasibility. Crucially, IDfRA does not require an accurate a priori world model before deployment. Instead, physical constraints are discovered online through interaction, enabling adaptation to under-specified environments. Empirical evaluation demonstrates that IDfRA attains 73.3% top-1 accuracy in semantic recognisability, surpassing the baseline on this metric. Moreover, the resulting assembly plans exhibit robust physical feasibility, achieving an overall 86.9% construction success rate, with design quality improving across iterations, albeit not always monotonically. Pairwise human evaluation further corroborates the advantages of IDfRA relative to alternative approaches. By integrating self-verification with context-aware adaptation, the framework evidences strong potential for deployment in unstructured manufacturing scenarios."},{"descriptionType":"Other","description":"8 pages, 8 figures. Published at ICRA 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16998","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:01:35Z","registered":"2025-09-23T03:01:36Z","published":null,"updated":"2026-10-16T03:15:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16615","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16615","identifiers":[{"identifier":"2509.16615","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jelle","familyName":"Luijkx","name":"Luijkx, Jelle","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runyu","familyName":"Ma","name":"Ma, Runyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zlatan","familyName":"Ajanović","name":"Ajanović, Zlatan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jens","familyName":"Kober","name":"Kober, Jens","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-Guided Task- and Affordance-Level Exploration in Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.9; I.2.6; I.2.7","lang":"en","subjectScheme":"ACM"},{"subject":"68T40","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-20T10:37:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:26:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-14T09:38:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-07T01:15:34Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/icra57385.2026.11695912","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) is a promising approach for robotic manipulation, but it can suffer from low sample efficiency and requires extensive exploration of large state-action spaces. Recent methods leverage the commonsense knowledge and reasoning abilities of large language models (LLMs) to guide exploration toward more meaningful states. However, LLMs can produce plans that are semantically plausible yet physically infeasible, yielding unreliable behavior. We introduce LLM-TALE, a framework that uses LLMs' planning to directly steer RL exploration. LLM-TALE integrates planning at both the task level and the affordance level, improving learning efficiency by directing agents toward semantically meaningful actions. Unlike prior approaches that assume optimal LLM-generated plans or rewards, LLM-TALE corrects suboptimality online and explores multimodal affordance-level plans without human supervision. We evaluate LLM-TALE on pick-and-place tasks in standard RL benchmarks, observing improvements in both sample efficiency and success rates over strong baselines. Real-robot experiments indicate promising zero-shot sim-to-real transfer. Code and supplementary material are available at llm-tale.github.io."},{"descriptionType":"Other","description":"8 pages, 7 figures, ICRA 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16615","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T02:52:33Z","registered":"2025-09-23T02:52:33Z","published":null,"updated":"2026-10-07T03:15:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17411","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17411","identifiers":[{"identifier":"2509.17411","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siqi","familyName":"Li","name":"Li, Siqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Molei","familyName":"Liu","name":"Liu, Molei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiwei","familyName":"Lyu","name":"Lyu, Yiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziye","familyName":"Tian","name":"Tian, Ziye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuan","familyName":"Hong","name":"Hong, Chuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Liu","name":"Liu, Nan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Mixture Models for Algorithmic Fairness Under Latent Heterogeneity"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (stat.ML)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:03:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:14:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-18T05:09:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-21T00:26:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Machine learning models optimized for average performance can perform poorly on vulnerable subpopulations. Existing approaches often rely on groups specified in advance, yet fairness-relevant subgroup structure may be latent, intersectional, and driven by complex interactions among continuous and discrete attributes. We introduce \\textbf{ROME} (\\textbf{\\underline{RO}}bust \\textbf{\\underline{M}}ixture \\textbf{\\underline{E}}nsemble), a framework that learns latent group structure while optimizing worst-group predictive performance. ROME connects latent-variable modeling with distributionally robust optimization (DRO) through two complementary approaches: an Expectation-Maximization formulation with robust aggregation for linear models and a neural Mixture-of-Experts formulation for nonlinear settings. Across simulations and three real-world regression datasets, ROME improves worst-group performance while maintaining competitive overall accuracy, including in comparisons with established group-aware and group-label-free robust learning methods. ROME provides a flexible approach to robust prediction when fairness-relevant attributes are available for subgroup discovery but their direct use in group-specific outcome models is restricted."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17411","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:22Z","registered":"2025-09-23T03:11:23Z","published":null,"updated":"2026-09-21T02:23:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18052","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18052","identifiers":[{"identifier":"2509.18052","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaxu","familyName":"Zhou","name":"Zhou, Jiaxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jen-tse","familyName":"Huang","name":"Huang, Jen-tse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuhui","familyName":"Zhou","name":"Zhou, Xuhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Man Ho","familyName":"Lam","name":"Lam, Man Ho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xintao","familyName":"Wang","name":"Wang, Xintao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhu","name":"Zhu, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenxuan","familyName":"Wang","name":"Wang, Wenxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maarten","familyName":"Sap","name":"Sap, Maarten","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The PIMMUR Principles: Ensuring Validity in Collective Behavior of LLM Societies"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:27:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:49:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-26T14:24:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-27T02:31:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-06T17:12:41Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-07T01:40:25Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-09-10T01:02:12Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-09-11T00:17:38Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are increasingly used to simulate human collective behavior, yet claims that such simulations are human-like remain largely untested. We conducted a systematic audit (pre-registered on OSF) of LLM-based social simulations across four databases (Scopus, IEEE Xplore, ACM Digital Library, and arXiv). Across 576 studies reported in 350 recent papers, we applied six methodological evaluations: agent Profile, Interaction, Memory, Minimal-Control, Unawareness, and Realism (PIMMUR). Coding every study against pre-specified rules, we revealed that PIM were met more often than MUR. Frontier LLMs correctly identified the underlying social experiment in 65.2% of cases, and 50.6% of prompts imposed constraints that pre-determined the outcome. These compliance rates are upper bounds, because incomplete methodological reporting (for example, unreleased prompts) limits the available evidence. Reproducing five representative experiments (e.g., opinion dynamics), we found that reported collective phenomena often vanish or reverse once PIMMUR principles are enforced, indicating that many \"emergent\" behaviors are methodological artifacts rather than genuine social dynamics. Current LLM simulations may therefore capture model-specific biases rather than universal features of human social behavior, raising concerns about their use as scientific proxies for human society."},{"descriptionType":"Other","description":"Added more studies in our systematic audit (350 papers; 576 simulations)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18052","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:26:29Z","registered":"2025-09-23T03:26:29Z","published":null,"updated":"2026-09-11T02:36:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17920","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17920","identifiers":[{"identifier":"2509.17920","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jamiyan","familyName":"Sukhbaatar","name":"Sukhbaatar, Jamiyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satoshi","familyName":"Imamura","name":"Imamura, Satoshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ibuki","familyName":"Inoue","name":"Inoue, Ibuki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shoya","familyName":"Murakami","name":"Murakami, Shoya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kazi Mahmudul","familyName":"Hassan","name":"Hassan, Kazi Mahmudul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seungwoo","familyName":"Han","name":"Han, Seungwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ingon","familyName":"Chanpornpakdi","name":"Chanpornpakdi, Ingon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Toshihisa","familyName":"Tanaka","name":"Tanaka, Toshihisa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SingLEM: Single-Channel Large EEG Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T15:46:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:43:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-03T04:32:46Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-04T01:28:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-07T10:25:59Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-09T01:36:15Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/jbhi.2026.3732223","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Current deep learning models for electroencephalography (EEG) are often task-specific and depend on large labeled datasets, limiting their adaptability. Although EEG foundation models seek broader applicability, many still rely on predefined multi-channel inputs, electrode-layout assumptions, or model-specific channel handling. To address these limitations, we introduce the Single-Channel Large EEG Model (SingLEM), a self-supervised foundation model whose hybrid convolutional--Transformer encoder maps each channel independently to a reusable representation capturing local and long-range temporal structure. These representations can be used individually or combined through channel-wise feature concatenation. We assembled 71 public EEG datasets comprising approximately 9,200 subjects and 357,000 single-channel hours. For leakage-controlled evaluation, downstream results were obtained with a model pretrained on 68 datasets after excluding the three source datasets underlying the six tasks. A model pretrained on all 71 datasets is provided for general reuse. Across six motor imagery and cognitive tasks under strict leave-one-subject-out (LOSO) evaluation, the leakage-controlled model with concatenated representations and a support vector machine (SVM) classifier achieved the best overall performance among the compared pretrained and classical feature-based methods. Additional classifier and subject-adapted analyses supported the robustness of its representations. These findings support single-channel self-supervised learning as a montage-flexible foundation for reusable EEG feature extraction and electrode-level spatial analysis. The source code and pretrained models are available at https://github.com/ttlabtuat/SingLEM."},{"descriptionType":"Other","description":"Accepted for publication in IEEE Journal of Biomedical and Health Informatics. Updated to the accepted manuscript following peer review, including revised experiments, analyses, and figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17920","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:23:23Z","registered":"2025-09-23T03:23:23Z","published":null,"updated":"2026-09-09T05:54:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17458","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17458","identifiers":[{"identifier":"2509.17458","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seyed Amir","familyName":"Kasaei","name":"Kasaei, Seyed Amir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Aghayari","name":"Aghayari, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arash","familyName":"Marioriyad","name":"Marioriyad, Arash","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Niki","familyName":"Sepasian","name":"Sepasian, Niki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shayan Baghayi","familyName":"Nejad","name":"Nejad, Shayan Baghayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"MohammadAmin","familyName":"Fazli","name":"Fazli, MohammadAmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahdieh Soleymani","familyName":"Baghshah","name":"Baghshah, Mahdieh Soleymani","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad Hossein","familyName":"Rohban","name":"Rohban, Mohammad Hossein","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CARINOX: Inference-time Scaling with Category-Aware Reward-based Initial Noise Optimization and Exploration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:51:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-26T00:33:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-10T15:47:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-11T02:01:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-11T12:35:18Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-14T00:35:31Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-09-05T14:37:15Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-09-09T00:37:17Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Text-to-image diffusion models, such as Stable Diffusion, can produce high-quality and diverse images but often fail to achieve compositional alignment, particularly when prompts describe complex object relationships, attributes, or spatial arrangements. Recent inference-time approaches address this by optimizing or exploring the initial noise under the guidance of reward functions that score text-image alignment without requiring model fine-tuning. While promising, each strategy has intrinsic limitations when used alone: optimization can stall due to poor initialization or unfavorable search trajectories, whereas exploration may require a prohibitively large number of samples to locate a satisfactory output. Our analysis further shows that neither single reward metrics nor ad-hoc combinations reliably capture all aspects of compositionality, leading to weak or inconsistent guidance. To overcome these challenges, we present Category-Aware Reward-based Initial Noise Optimization and EXploration (CARINOX), a unified framework that combines noise optimization and exploration with a principled reward selection procedure grounded in correlation with human judgments. Evaluations on two complementary benchmarks covering diverse compositional challenges show that CARINOX raises average alignment scores by approximately 19% on both T2I-CompBench++ and HRS, consistently outperforming state-of-the-art optimization and exploration-based methods across all major categories, while preserving image quality and diversity. The project page is available at https://amirkasaei.com/carinox/."},{"descriptionType":"Other","description":"Accepted to TMLR (2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17458","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:12:28Z","registered":"2025-09-23T03:12:29Z","published":null,"updated":"2026-09-09T05:54:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17037","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17037","identifiers":[{"identifier":"2509.17037","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yajing","familyName":"Yang","name":"Yang, Yajing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tony","familyName":"Deng","name":"Deng, Tony","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min-Yen","familyName":"Kan","name":"Kan, Min-Yen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KAHAN: Knowledge-Augmented Hierarchical Analysis and Narration for Financial Data Narration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T11:15:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-09-09T02:44:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2025.findings-emnlp.1405","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose KAHAN, a knowledge-augmented hierarchical framework that systematically extracts insights from raw tabular data at entity, pairwise, group, and system levels. KAHAN uniquely leverages LLMs as domain experts to drive the analysis. On DataTales financial reporting benchmark, KAHAN outperforms existing approaches by over 20% on narrative quality (GPT-4o), maintains 98.2% factuality, and demonstrates practical utility in human evaluation. Our results reveal that knowledge quality drives model performance through distillation, hierarchical analysis benefits vary with market complexity, and the framework transfers effectively to healthcare domains. The data and code are available at https://github.com/yajingyang/kahan."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17037","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:02:30Z","registered":"2025-09-23T03:02:31Z","published":null,"updated":"2026-09-09T05:53:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16691","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16691","identifiers":[{"identifier":"2509.16691","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiang","familyName":"Xiang","name":"Xiang, Qiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuang","familyName":"Sun","name":"Sun, Shuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Binglei","familyName":"Li","name":"Li, Binglei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dejia","familyName":"Song","name":"Song, Dejia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaxia","familyName":"Li","name":"Li, Huaxia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nemo","familyName":"Chen","name":"Chen, Nemo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Tang","name":"Tang, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Hu","name":"Hu, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junping","familyName":"Zhang","name":"Zhang, Junping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"InstanceAssemble: Layout-Aware Image Generation via Instance Assembling Attention"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T13:37:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:31:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-28T03:37:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-03T00:43:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.52202/085713-3849","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have demonstrated remarkable capabilities in generating high-quality images. Recent advancements in Layout-to-Image (L2I) generation have leveraged positional conditions and textual descriptions to facilitate precise and controllable image synthesis. Despite overall progress, current L2I methods still exhibit suboptimal performance. Therefore, we propose InstanceAssemble, a novel architecture that incorporates layout conditions via instance-assembling attention, enabling position control with bounding boxes (bbox) and multimodal content control including texts and additional visual content. Our method achieves flexible adaption to existing DiT-based T2I models through light-weighted LoRA modules. Additionally, we propose a Layout-to-Image benchmark, Denselayout, a comprehensive benchmark for layout-to-image generation, containing 5k images with 90k instances in total. We further introduce Layout Grounding Score (LGS), an interpretable evaluation metric to more precisely assess the accuracy of L2I generation. Experiments demonstrate that our InstanceAssemble method achieves state-of-the-art performance under complex layout conditions, while exhibiting strong compatibility with diverse style LoRA modules. The code and pretrained models are publicly available at https://github.com/FireRedTeam/InstanceAssemble."},{"descriptionType":"Other","description":"Accepted in NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16691","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T02:54:21Z","registered":"2025-09-23T02:54:22Z","published":null,"updated":"2026-09-03T02:35:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17569","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17569","identifiers":[{"identifier":"2509.17569","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Daniel","familyName":"Quinn","name":"Quinn, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lorenzo","familyName":"Buffoni","name":"Buffoni, Lorenzo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Gherardini","name":"Gherardini, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriele","familyName":"De Chiara","name":"De Chiara, Gabriele","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conditioning in Generative Quantum Denoising Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:01:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-18T01:07:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-01T14:25:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-02T01:07:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1088/2058-9565/ae8881","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantum denoising diffusion models have recently emerged as a powerful framework for generative quantum machine learning. In this work, we extend these models by introducing a conditioning mechanism that enables the generation of quantum states drawn from multiple target distributions. By sharing parameters across distinct classes of quantum states, our approach avoids the need to train separate models for each distribution. We validate our method through numerical simulations that span single-qubit generation tasks, entangled state preparation, and many-body ground state generation. Across these tasks, conditioning significantly reduced the error of targeted state generation by more than an order of magnitude. Finally, we perform an ablation study to quantify the effect of key hyperparameters on the model performance."},{"descriptionType":"Other","description":"Close to published version. 17 pages, 13 figures, 3 tables. Code, notebooks, and data at https://github.com/DanielQuinn53/CQDD"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17569","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:15:07Z","registered":"2025-09-23T03:15:08Z","published":null,"updated":"2026-09-02T02:59:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17930","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17930","identifiers":[{"identifier":"2509.17930","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiwen","familyName":"Guan","name":"Guan, Yiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacob","familyName":"Whitehill","name":"Whitehill, Jacob","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transformer-Encoder Trees for Efficient Multilingual Machine Translation and Speech Translation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T15:52:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:43:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-17T14:57:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-18T01:11:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-28T19:40:55Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-01T00:08:23Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multilingual translation suffers from computational redundancy, especially when translating into multiple languages simultaneously. In addition, translation quality can suffer for low-resource languages. To address this, we introduce Transformer Encoder Tree (TET), a hierarchical, non-autoregressive encoder-only architecture trained with Connectionist Temporal Classification (CTC) for multilingual translation. TET shares intermediate representations among linguistically similar target languages, improving accuracy on low-resource languages while reducing computational redundancy and enabling the generation of all target languages in a single forward pass. TET eliminates the sequential bottleneck of autoregressive models and supports fully parallel decoding of all tokens across all target languages. Compared to a naive one-to-many multilingual design, TET reduces the total parameter count by 66% and lowers inference computation by 60%. In speech translation, combining TET with a non-autoregressive speech recognition backbone (Wav2Vec2) shows competitive translation quality compared to autoregressive systems while speeding up inference by approximately 7-14 times."},{"descriptionType":"Other","description":"Accepted in the Findings of EMNLP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17930","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:23:37Z","registered":"2025-09-23T03:23:38Z","published":null,"updated":"2026-09-01T05:00:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17449","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17449","identifiers":[{"identifier":"2509.17449","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Leonor","familyName":"Veloso","name":"Veloso, Leonor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lea","familyName":"Hirlimann","name":"Hirlimann, Lea","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lucija Mihić","familyName":"Zidar","name":"Zidar, Lucija Mihić","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philipp","familyName":"Wicke","name":"Wicke, Philipp","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Valentin","familyName":"Hofmann","name":"Hofmann, Valentin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hinrich","familyName":"Schütze","name":"Schütze, Hinrich","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SLAyiNG: A Diverse and Community-validated Dataset of Queer Slang"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:41:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:15:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-13T15:11:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-14T00:55:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Queer vernacular is rarely studied in NLP, despite advancements in resources and evaluation for other sociolects and informal language. Because of this, NLP systems often process queer language incorrectly, e.g., they misclassify it as hate speech or generate negative responses. To address this problem, we propose Slaying, the first real-world dataset of English queer slang. Slaying is community-validated, and includes over 500 queer slang terms that pertain to more than 20 queer subcommunities. We argue that queer language data resources have great potential in NLP -- e.g., as components of large pretraining corpora and as the basis for benchmarks -- and can improve queer users' experience of NLP systems. We leverage Slaying for two novel findings in support of this argument: (i) For a number of language models, we show that they are unbiased towards the queer community, but at the same time unable to process its language, i.e., absence of representation bias does not entail the absence of linguistic bias. (ii) Model performance on queer slang varies across queer subcommunities; it is generally worse for slang pertaining to African-American and Latine communities. These findings are relevant for both the queer NLP and the broader ML communities. Slaying is available to the public, and open to future revisions and extensions. Warning: This paper contains profane and potentially offensive language."},{"descriptionType":"Other","description":"Preprint"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17449","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:12:15Z","registered":"2025-09-23T03:12:16Z","published":null,"updated":"2026-08-14T02:22:41Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16749","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16749","identifiers":[{"identifier":"2509.16749","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Anna","familyName":"Bertiger","name":"Bertiger, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bobby","familyName":"Filar","name":"Filar, Bobby","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aryan","familyName":"Luthra","name":"Luthra, Aryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Meschiari","name":"Meschiari, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aiden","familyName":"Mitchell","name":"Mitchell, Aiden","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sam","familyName":"Scholten","name":"Scholten, Sam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vivek","familyName":"Sharath","name":"Sharath, Vivek","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating LLM Generated Detection Rules in Cybersecurity"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T17:21:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-08-13T00:06:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLMs are increasingly pervasive in the security environment, with limited measures of their effectiveness, which limits trust and usefulness to security practitioners. Here, we present an open-source evaluation framework and benchmark metrics for evaluating LLM-generated cybersecurity rules. The benchmark employs a holdout set-based methodology to measure the effectiveness of LLM-generated security rules in comparison to a human-generated corpus of rules. It provides three key metrics inspired by the way experts evaluate security rules, offering a realistic, multifaceted evaluation of the effectiveness of an LLM-based security rule generator. This methodology is illustrated using rules from Sublime Security's detection team and those written by Sublime Security's Automated Detection Engineer (ADE), with a thorough analysis of ADE's skills presented in the results section."},{"descriptionType":"Other","description":"Preprint of a paper accepted at the Conference on Applied Machine Learning in Information Security (CAMLIS 2025). 11 pages, 3 figures, 4 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16749","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:55:42Z","registered":"2025-09-23T02:55:43Z","published":null,"updated":"2026-08-13T02:11:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16462","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16462","identifiers":[{"identifier":"2509.16462","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mina","familyName":"Arzaghi","name":"Arzaghi, Mina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alireza Dehghanpour","familyName":"Farashah","name":"Farashah, Alireza Dehghanpour","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Florian","familyName":"Carichon","name":"Carichon, Florian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean-François","familyName":"Plante","name":"Plante, Jean-François","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Golnoosh","familyName":"Farnadi","name":"Farnadi, Golnoosh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Let's Unlearn Stereotypes Before Decision-Making: Assessing the Impact of Intrinsic Bias Mitigation on Downstream Fairness in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T22:59:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:11:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T19:07:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-10T00:04:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly used in high-stakes decision-making systems, where biased predictions can reinforce social and economic disparities. Although prior work has examined intrinsic representational bias and unfair downstream behavior separately, it remains unclear whether mitigating intrinsic bias leads to fairer downstream outcomes. We introduce Fairness-Aware Concept Unlearning (FACU), a model-level mitigation method that adapts concept unlearning to fairness-oriented representation balancing. Unlike suppression-based approaches, FACU explicitly regularizes probability differences between stereotypical and anti-stereotypical associations while preserving predictive performance and language modeling quality. We evaluate FACU across three open-source LLMs, multiple intrinsic bias benchmarks, and three socio-economic classification datasets using both frozen LLM embeddings and LoRA-fine-tuned classifiers. FACU produces statistically significant reductions in intrinsic gender bias that are associated with downstream fairness improvements across most evaluated settings, datasets, models, and fairness metrics, without significantly degrading predictive performance. Combining FACU with extrinsic mitigation methods, particularly counterfactual data augmentation, yields further fairness improvements. These findings suggest that fairness-aware intrinsic mitigation can support fairer LLM-based decision-making and that bias mitigation should be addressed across both model development and downstream deployment stages."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16462","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:58Z","registered":"2025-09-23T02:48:59Z","published":null,"updated":"2026-08-10T02:05:49Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16666","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16666","identifiers":[{"identifier":"2509.16666","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ahmet Yavuz","familyName":"Uluslu","name":"Uluslu, Ahmet Yavuz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tannon","familyName":"Kew","name":"Kew, Tannon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tilia","familyName":"Ellendorff","name":"Ellendorff, Tilia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gerold","familyName":"Schneider","name":"Schneider, Gerold","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rico","familyName":"Sennrich","name":"Sennrich, Rico","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust Native Language Identification through Agentic Decomposition"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T12:38:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:29:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-06T13:53:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-07T00:50:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2025.emnlp-main.423","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) often achieve high performance in native language identification (NLI) benchmarks by leveraging superficial contextual clues such as names, locations, and cultural stereotypes, rather than the underlying linguistic patterns indicative of native language (L1) influence. To improve robustness, previous work has instructed LLMs to disregard such clues. In this work, we demonstrate that such a strategy is unreliable and model predictions can be easily altered by misleading hints. To address this problem, we introduce an agentic NLI pipeline inspired by forensic linguistics, where specialized agents accumulate and categorize diverse linguistic evidence before an independent final overall assessment. In this final assessment, a goal-aware coordinating agent synthesizes all evidence to make the NLI prediction. On two benchmark datasets, our approach significantly enhances NLI robustness against misleading contextual clues and performance consistency compared to standard prompting methods."},{"descriptionType":"Other","description":"Accepted at EMNLP* 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16666","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T02:53:45Z","registered":"2025-09-23T02:53:46Z","published":null,"updated":"2026-08-07T02:14:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17192","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17192","identifiers":[{"identifier":"2509.17192","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Glenn","familyName":"Matlin","name":"Matlin, Glenn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Isaac","familyName":"Song","name":"Song, Isaac","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixiong","familyName":"Hao","name":"Hao, Yixiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Parv","familyName":"Mahajan","name":"Mahajan, Parv","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Evan","familyName":"Montoya","name":"Montoya, Evan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Bard","name":"Bard, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stuart R.","familyName":"Topp","name":"Topp, Stuart R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anthony Wen-Ming","familyName":"Zang","name":"Zang, Anthony Wen-Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammed Rehan","familyName":"Parwani","name":"Parwani, Mohammed Rehan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soham","familyName":"Shetty","name":"Shetty, Soham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Riedl","name":"Riedl, Mark","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Shall We Play a Game? Language Models for Open-ended Wargames"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-21T18:37:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-23T00:23:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-23T02:21:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-24T00:18:30Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-31T04:27:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-03T00:21:26Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLM-based social simulations can make a generated transcript look like a single behavioral signal, but the model behind that transcript may be doing several different jobs: choosing what an actor says or does, deciding what happens after an action, or both. The difference matters especially in open-ended wargames, where models are prized for handling unusual actions and ambiguous consequences. We report a scoping review of 223 de-duplicated AI-in-wargames and strategic-simulation papers retrieved through May 1, 2026, describing each simulation by its model-control profile: whether the language model has open-ended control over player actions, adjudication, or both. Only 20 of 223 studies (~9%) give language models both roles. Before treating LM outputs as social simulations, researchers need to know how much creative control the model has over actions and consequences. For open-ended simulations, fidelity depends not only on whether agents behave plausibly, but also on whether language models can reliably act as adjudicators or world models."},{"descriptionType":"Other","description":"49 pages (9-page body), 3 figures. Published at the Social Sim'26 Workshop at COLM 2026 (non-archival)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17192","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:06:12Z","registered":"2025-09-23T03:06:12Z","published":null,"updated":"2026-08-03T02:08:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16780","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16780","identifiers":[{"identifier":"2509.16780","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Eason","familyName":"Chen","name":"Chen, Eason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuangji","familyName":"Li","name":"Li, Chuangji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eric","familyName":"Li","name":"Li, Eric","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimo","familyName":"Xiao","name":"Xiao, Zimo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jionghao","familyName":"Lin","name":"Lin, Jionghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenneth R.","familyName":"Koedinger","name":"Koedinger, Kenneth R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Comparing RAG and GraphRAG for Page-Level Retrieval Question Answering on a Math Textbook"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T19:06:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:38:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-26T05:24:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T00:32:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-28T14:37:23Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-29T00:55:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) show promise as educational aids but often lack alignment with specific course materials. We investigate Retrieval-Augmented Generation (RAG) and GraphRAG for page-level question answering on an undergraduate mathematics textbook. Using a curated dataset of 477 question-answer pairs, each tied to a specific textbook page, we compare five embedding-based RAG models, a BM25 baseline, and GraphRAG across two metrics: retrieval accuracy (whether the correct page is retrieved) and answer quality (F1 score). Our results show that embedding-based RAG outperforms GraphRAG for page-level retrieval, with voyage-3-large achieving 99.4% accuracy at top-10 (bootstrap 95% CI for top-1: [.644, .728]). BM25 proves a strong baseline, outperforming several embedding models. Error analysis reveals that 63.3% of top-1 failures retrieve same-chapter content, suggesting pedagogical relevance even in failure cases. GraphRAG retrieves excessive context (~47K tokens vs. ~3.7K for RAG), reducing generation quality. We further replicate key experiments using an open-source local LLM (Qwen3.5-35B-A3B), finding that RAG benefits are proportionally larger for weaker models (+39% vs. +16% relative F1 improvement), an important result for cost-sensitive educational deployments. These findings inform the design of AI tutoring systems that reference specific textbook pages."},{"descriptionType":"Other","description":"6 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16780","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:56:25Z","registered":"2025-09-23T02:56:26Z","published":null,"updated":"2026-07-29T02:27:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16909","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16909","identifiers":[{"identifier":"2509.16909","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yijun","familyName":"Yuan","name":"Yuan, Yijun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuoguang","familyName":"Chen","name":"Chen, Zhuoguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kenan","familyName":"Li","name":"Li, Kenan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weibang","familyName":"Wang","name":"Wang, Weibang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghui","familyName":"Qin","name":"Qin, Minghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijian","familyName":"Fang","name":"Fang, Zhijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weicheng","familyName":"Zheng","name":"Zheng, Weicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Zhao","name":"Zhao, Hang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SLAM-Former: Putting SLAM into One Transformer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T04:04:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:45:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-27T07:54:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-28T01:19:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present SLAM-Former, a neural approach that integrates full SLAM capabilities into a single transformer. Similar to traditional SLAM systems, SLAM-Former comprises both a frontend and a back-end that operate in tandem. The frontend processes sequential monocular images in real-time for incremental mapping and tracking, while the backend performs global refinement to ensure a geometrically consistent result. This alternating execution allows the frontend and back-end to mutually promote one another, enhancing overall system performance. Comprehensive experimental results demonstrate that SLAM- Former achieves superior or highly competitive performance compared to state-of-the-art dense SLAM methods."},{"descriptionType":"Other","description":"Published on ECCV 2026, Project Page:https://tsinghua-mars-lab.github.io/SLAM-Former"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16909","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:59:26Z","registered":"2025-09-23T02:59:27Z","published":null,"updated":"2026-07-28T03:48:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16727","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16727","identifiers":[{"identifier":"2509.16727","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin Lei","familyName":"Lin","name":"Lin, Xin Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soroush","familyName":"Mehraban","name":"Mehraban, Soroush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhishek","familyName":"Moturu","name":"Moturu, Abhishek","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Babak","familyName":"Taati","name":"Taati, Babak","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pain in 3D: Generating Controllable Synthetic Faces for Automated Pain Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T15:41:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:34:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T00:50:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:18:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-11T21:18:27Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-13T01:55:59Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-13T20:50:25Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-15T01:05:37Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-07-21T04:38:40Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-07-22T00:24:23Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Automated pain assessment from facial expressions is crucial for non-communicative patient. Progress has been limited by two challenges: (i) existing datasets exhibit severe demographic and label imbalance due to ethical constraints, and (ii) current generative models cannot precisely control facial action units (AUs), facial structure, or clinically validated pain levels. We introduce 3DPain, a large-scale synthetic dataset designed to overcome data scarcity in automated pain assessment. Comprising 82,500 frames across 2,500 unique identities, 3DPain offers extensive heterogeneity in facial pain responses across demographic groups balanced by age, gender, and ethnicity. Our three-stage framework samples diverse 3D meshes, textures them with diffusion models, and applies AU-driven face rigging to synthesize multi-view faces with paired neutral/pain images, facial action units, PSPI scores, and pain-region heatmaps. We further introduce ViTPain, a Vision Transformer based framework leveraging cross-attention with a neutral reference face to achieve identityaware pain estimation. Together, 3DPain and ViTPain establish a controllable, diverse, and clinically grounded foundation for generalizable automated pain assessment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16727","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:55:11Z","registered":"2025-09-23T02:55:12Z","published":null,"updated":"2026-07-22T02:18:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16496","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16496","identifiers":[{"identifier":"2509.16496","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Seyyedali","familyName":"Hosseinalipour","name":"Hosseinalipour, Seyyedali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shimiao","familyName":"Li","name":"Li, Shimiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Adedoyin","familyName":"Inaolaji","name":"Inaolaji, Adedoyin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Filippo","familyName":"Malandra","name":"Malandra, Filippo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luis","familyName":"Herrera","name":"Herrera, Luis","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nicholas","familyName":"Mastronarde","name":"Mastronarde, Nicholas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Synergies between Federated Foundation Models and Smart Power Grids"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T02:00:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-07-16T00:11:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/mele.2025.3639354","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The recent emergence of large language models (LLMs) such as GPT-3 has marked a significant paradigm shift in machine learning. Trained on massive corpora of data, these models demonstrate remarkable capabilities in language understanding, generation, summarization, and reasoning, transforming how intelligent systems process and interact with human language. Although LLMs may still seem like a recent breakthrough, the field is already witnessing the rise of a new and more general category: multi-modal, multi-task foundation models (M3T FMs). These models go beyond language and can process heterogeneous data types/modalities, such as time-series measurements, audio, imagery, tabular records, and unstructured logs, while supporting a broad range of downstream tasks spanning forecasting, classification, control, and retrieval. When combined with federated learning (FL), they give rise to M3T Federated Foundation Models (FedFMs): a highly recent and largely unexplored class of models that enable scalable, privacy-preserving model training/fine-tuning across distributed data sources. In this paper, we take one of the first steps toward introducing these models to the power systems research community by offering a bidirectional perspective: (i) M3T FedFMs for smart grids and (ii) smart grids for FedFMs. In the former, we explore how M3T FedFMs can enhance key grid functions, such as load/demand forecasting and fault detection, by learning from distributed, heterogeneous data available at the grid edge in a privacy-preserving manner. In the latter, we investigate how the constraints and structure of smart grids, spanning energy, communication, and regulatory dimensions, shape the design, training, and deployment of M3T FedFMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16496","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T02:49:46Z","registered":"2025-09-23T02:49:47Z","published":null,"updated":"2026-07-16T02:34:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17255","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17255","identifiers":[{"identifier":"2509.17255","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Thorsten","familyName":"Hellert","name":"Hellert, Thorsten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Drew","familyName":"Bertwistle","name":"Bertwistle, Drew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simon C.","familyName":"Leemann","name":"Leemann, Simon C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antonin","familyName":"Sulc","name":"Sulc, Antonin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco","familyName":"Venturini","name":"Venturini, Marco","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Agentic Artificial Intelligence for Multistage Physics Experiments at a Large-Scale User Facility Particle Accelerator"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Accelerator Physics (physics.acc-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T22:11:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-28T01:09:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-04T21:07:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-07-07T01:25:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/jtqy-9jz1","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present the first language-model-driven agentic artificial intelligence (AI) system to autonomously execute multi-stage physics experiments on a production synchrotron light source. Implemented at the Advanced Light Source particle accelerator, the system translates natural language user prompts into structured execution plans that combine archive data retrieval, control-system channel resolution, automated script generation, controlled machine interaction, and analysis. In a representative machine physics task, we show that preparation time was reduced by two orders of magnitude relative to manual scripting even for a system expert, while operator-standard safety constraints were strictly upheld. Core architectural features, plan-first orchestration, bounded tool access, and dynamic capability selection, enable transparent, auditable execution with fully reproducible artifacts. These results establish a blueprint for the safe integration of agentic AI into accelerator experiments and demanding machine physics studies, as well as routine operations, with direct portability across accelerators worldwide and, more broadly, to other large-scale scientific infrastructures."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17255","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:07:41Z","registered":"2025-09-23T03:07:42Z","published":null,"updated":"2026-07-07T04:57:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17314","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17314","identifiers":[{"identifier":"2509.17314","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Juyeon","familyName":"Yoon","name":"Yoon, Juyeon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Somin","familyName":"Kim","name":"Kim, Somin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Robert","familyName":"Feldt","name":"Feldt, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shin","familyName":"Yoo","name":"Yoo, Shin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Clotho: Measuring Task-Specific Pre-Generation Test Adequacy for LLM Inputs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T02:34:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:09:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T19:15:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:06:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-25T09:24:49Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-28T00:26:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-07-01T05:02:47Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-07-02T00:24:16Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3797114","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Software increasingly relies on the emergent capabilities of Large Language Models (LLMs), from natural language understanding to program analysis and generation. Yet testing them on specific tasks remains difficult and costly: many prompts lack ground truths, forcing reliance on human judgments, while existing test adequacy measures typically rely on output uncertainty and thus are only available after full inference. A key challenge is to assess how useful a test input is in a way that reflects the demands of the task, ideally before even generating any output. We introduce Clotho, a task-specific, pre-generation test adequacy measure that estimates input difficulty directly from LLM hidden states. Given a large pool of unlabelled inputs for a specific task, Clotho uses a Gaussian Mixture Model (GMM) to adaptively sample the most informative cases for human labelling. Based on this reference set the GMM can then rank unseen inputs by their likelihood of failure. In our empirical evaluation across eight benchmark tasks and three open-weight LLMs, Clotho can predict failures with a ROC-AUC of 0.716, after labelling reference sets that are on average only 5.4% of inputs. It does so without generating any outputs, thereby significantly reducing LLM execution costs compared to output-based uncertainty or confidence measures. Comparison of Clotho and these post-generation adequacy measures shows that the two approaches complement each other. Crucially, we show that adequacy scores learnt from open-weight LLMs transfer effectively to proprietary models, extending the applicability of the approach. When prioritising test inputs for proprietary models, Clotho increases the average number of failing inputs from 18.7 to 42.5 out of 100, compared to random prioritisation."},{"descriptionType":"Other","description":"FSE 2026 Camera Ready version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17314","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:09:03Z","registered":"2025-09-23T03:09:04Z","published":null,"updated":"2026-07-02T02:10:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17932","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17932","identifiers":[{"identifier":"2509.17932","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Runheng","familyName":"Liu","name":"Liu, Runheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heyan","familyName":"Huang","name":"Huang, Heyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingchen","familyName":"Xiao","name":"Xiao, Xingchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanghao","familyName":"Zhou","name":"Zhou, Yanghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhijing","familyName":"Wu","name":"Wu, Zhijing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Training-free Truthfulness Detection via Sparse MLP Value Vectors"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T15:54:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:43:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-26T02:30:40Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-29T00:15:12Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) are prone to generating factually incorrect content, motivating methods for assessing truthfulness from internal model signals. While supervised probing approaches can be effective, they require labeled data and classifier training. Recent training-free methods avoid parameter optimization but rely on coarse activation statistics that provide limited insight into how truthfulness-related signals arise within the model. We present a training-free approach that operates at the level of individual multi-layer perceptron (MLP) value vectors. Through a systematic analysis, we find that although most value vectors show no meaningful signal, a sparse subset exhibits stable and directionally consistent correlations with content truthfulness. Leveraging this observation, we propose \\textbf{TruthV}, a simple inference method that aggregates preferences expressed by these value vectors. TruthV requires only a small support set to identify relevant vectors and introduces no additional model parameters or classifier weights. We evaluate TruthV across model scales from 2B to 13B and multiple benchmarks, including question answering, natural language understanding, and hallucination evaluation. TruthV consistently outperforms existing training-free baselines, demonstrating that truthfulness-related variation in LLMs is captured in a sparse and structured manner at the level of MLP value vectors."},{"descriptionType":"Other","description":"KDD 2026 Oral"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17932","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:23:40Z","registered":"2025-09-23T03:23:41Z","published":null,"updated":"2026-06-29T01:59:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":440,"totalPages":18,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z%20TO%202025-09-23T15%3A59%3A59.999Z%5D%20AND%20(titles.title%3A(%22language%20model%22%20OR%20%22language%20models%22%20OR%20LLM%20OR%20LLMs%20OR%20transformer%20OR%20transformers%20OR%20%22foundation%20model%22%20OR%20%22foundation%20models%22%20OR%20%22LLM%20agent%22%20OR%20%22LLM%20agents%22%20OR%20%22language%20agent%22%20OR%20%22language%20agents%22%20OR%20agentic%20OR%20%22vision%20language%22%20OR%20%22vision-language%22%20OR%20multimodal%20OR%20%22multi-modal%22%20OR%20diffusion%20OR%20%22world%20model%22%20OR%20%22world%20models%22%20OR%20%22mixture%20of%20experts%22%20OR%20%22mixture-of-experts%22)%20OR%20descriptions.description%3A(%22language%20model%22%20OR%20%22language%20models%22%20OR%20LLM%20OR%20LLMs%20OR%20%22transformer%20model%22%20OR%20%22transformer%20models%22%20OR%20%22transformer%20architecture%22%20OR%20%22transformer%20architectures%22%20OR%20%22foundation%20model%22%20OR%20%22foundation%20models%22%20OR%20%22LLM%20agent%22%20OR%20%22LLM%20agents%22%20OR%20%22language%20agent%22%20OR%20%22language%20agents%22%20OR%20agentic%20OR%20%22vision%20language%20model%22%20OR%20%22vision%20language%20models%22%20OR%20%22vision-language%20model%22%20OR%20%22vision-language%20models%22%20OR%20%22multimodal%20model%22%20OR%20%22multimodal%20models%22%20OR%20%22multi-modal%20model%22%20OR%20%22multi-modal%20models%22%20OR%20%22multimodal%20learning%22%20OR%20%22diffusion%20model%22%20OR%20%22diffusion%20models%22%20OR%20%22world%20model%22%20OR%20%22world%20models%22%20OR%20%22mixture%20of%20experts%22%20OR%20%22mixture-of-experts%22))","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=2\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29"}}