{"data":[{"id":"10.48550/arxiv.2509.17693","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17693","identifiers":[{"identifier":"2509.17693","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Adam","familyName":"Wesołowski","name":"Wesołowski, Adam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ronin","familyName":"Wu","name":"Wu, Ronin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karim","familyName":"Essafi","name":"Essafi, Karim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fast, Accurate and Interpretable Graph Classification with Topological Kernels"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:31:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:28:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a novel class of explicit feature maps based on topological indices that represent each graph by a compact feature vector, enabling fast and interpretable graph classification. Using radial basis function kernels on these compact vectors, we define a measure of similarity between graphs. We perform evaluation on standard molecular datasets and observe that classification accuracies based on single topological-index feature vectors underperform compared to state-of-the-art substructure-based kernels. However, we achieve significantly faster Gram matrix evaluation -- up to $20\\times$ faster -- compared to the Weisfeiler--Lehman subtree kernel. To enhance performance, we propose two extensions: 1) concatenating multiple topological indices into an \\emph{Extended Feature Vector} (EFV), and 2) \\emph{Linear Combination of Topological Kernels} (LCTK) by linearly combining Radial Basis Function kernels computed on feature vectors of individual topological graph indices. These extensions deliver up to $12\\%$ percent accuracy gains across all the molecular datasets. A complexity analysis highlights the potential for exponential quantum speedup for some of the vector components. Our results indicate that LCTK and EFV offer a favourable trade-off between accuracy and efficiency, making them strong candidates for practical graph learning applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17693","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:18:03Z","registered":"2025-09-23T03:18:04Z","published":null,"updated":"2025-09-23T03:18:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17460","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17460","identifiers":[{"identifier":"2509.17460","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jianlong","familyName":"Chang","name":"Chang, Jianlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haixin","familyName":"Wang","name":"Wang, Haixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyuan","familyName":"Dang","name":"Dang, Zhiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Huang","name":"Huang, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyu","familyName":"Wang","name":"Wang, Zhiyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruoqi","familyName":"Cao","name":"Cao, Ruoqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihao","familyName":"Piao","name":"Piao, Shihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongzhe","familyName":"Li","name":"Li, Dongzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dianyu","familyName":"Gao","name":"Gao, Dianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongsheng","familyName":"Wang","name":"Wang, Dongsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yin","familyName":"Li","name":"Li, Yin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinan","familyName":"Sun","name":"Sun, Jinan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Fang","name":"Fang, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhouchen","familyName":"Lin","name":"Lin, Zhouchen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AI Pangaea: Unifying Intelligence Islands for Adapting Myriad Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:54:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:16:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The pursuit of artificial general intelligence continuously demands generalization in one model across myriad tasks, even those not seen before. However, current AI models are isolated from each other for being limited to specific tasks, now first defined as Intelligence Islands. To unify Intelligence Islands into one, we propose Pangaea, the first AI supercontinent akin to the geological Pangaea. Pangaea encodes any data into a unified format and accumulates universal knowledge through pre-training on 296 datasets across diverse modalities. Eventually, it demonstrates remarkable generalization across 45 general tasks and 15 scientific tasks encompassing a wide range of scientific subjects. By investigating Pangaea deeper, the scaling effect of modality is revealed, quantifying the universal knowledge accumulation across modalities as the cumulative distribution function of a geometric distribution. On the whole, Pangaea shows strong potential to handle myriad tasks, indicating a new direction toward artificial general intelligence."},{"descriptionType":"Other","description":"65 pages, 28 figures, paper under review"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17460","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:12:31Z","registered":"2025-09-23T03:12:31Z","published":null,"updated":"2025-09-23T03:12:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17351","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17351","identifiers":[{"identifier":"2509.17351","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Slava","familyName":"Kitaeff","name":"Kitaeff, Slava","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luc","familyName":"Betbeder-Matibet","name":"Betbeder-Matibet, Luc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jake","familyName":"Carroll","name":"Carroll, Jake","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephen","familyName":"Giugni","name":"Giugni, Stephen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Abramson","name":"Abramson, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Zaitseff","name":"Zaitseff, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sarah","familyName":"Walters","name":"Walters, Sarah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Powell","name":"Powell, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chris","familyName":"Bording","name":"Bording, Chris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Trung","familyName":"Nguyen","name":"Nguyen, Trung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Angus","familyName":"Macoustra","name":"Macoustra, Angus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabien","familyName":"Voisin","name":"Voisin, Fabien","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Chen","name":"Chen, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jarrod","familyName":"Hurley","name":"Hurley, Jarrod","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Institutional Research Computing Capabilities in Australia: 2024"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T04:28:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:11:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Institutional research computing infrastructure plays a vital role in Australia's research ecosystem, complementing and extending national facilities. This paper analyses research computing capabilities across Australian universities and organisations, showing how institutional systems support research excellence through local compute resources, specialised hardware, and cluster solutions. Our study finds that nearly 112,258 CPU cores and 2,241 GPUs serve over 6,000 researchers as essential bridges between desktops and national facilities, enabling workflows from development to large-scale computations. The estimated replacement value of this infrastructure is $144M AUD. Drawing on detailed data from multiple institutions, we identify key patterns in deployment, utilisation, and strategic alignment with research priorities. Institutional resources provide critical support for data-intensive projects, facilitate training and higher-degree student research, enable prototyping and development, and ensure data sovereignty compliance when required. The analysis shows how these facilities leverage national investments while addressing institution-specific needs that national systems cannot meet. We present evidence that strategic investment in institutional capabilities yields significant returns through greater research productivity, enhanced graduate training, and improved outcomes. The study offers insights for organisations planning computing strategies and highlights the importance of maintaining robust institutional resources alongside national facilities."},{"descriptionType":"Other","description":"9 pages in IEEE Proceedings format, International Conference on eScience 2025, Accepted"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17351","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:09:56Z","registered":"2025-09-23T03:09:56Z","published":null,"updated":"2025-09-23T03:09:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17182","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17182","identifiers":[{"identifier":"2509.17182","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sam Jacob","familyName":"Jacob","name":"Jacob, Sam Jacob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Markus","familyName":"Mrosek","name":"Mrosek, Markus","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carsten","familyName":"Othmer","name":"Othmer, Carsten","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harald","familyName":"Köstler","name":"Köstler, Harald","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PMRT: A Training Recipe for Fast, 3D High-Resolution Aerodynamic Prediction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T18:05:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:01:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The aerodynamic optimization of cars requires close collaboration between aerodynamicists and stylists, while slow, expensive simulations remain a bottleneck. Surrogate models have been shown to accurately predict aerodynamics within the design space for which they were trained. However, many of these models struggle to scale to higher resolutions because of the 3D nature of the problem and data scarcity. We propose Progressive Multi-Resolution Training (PMRT), a probabilistic multi-resolution training schedule that enables training a U-Net to predict the drag coefficient ($c_d$) and high-resolution velocity fields (512 x 128 x 128) in 24 hours on a single NVIDIA H100 GPU, 7x cheaper than the high-resolution-only baseline, with similar accuracy. PMRT samples batches from three resolutions based on probabilities that change during training, starting with an emphasis on lower resolutions and gradually shifting toward higher resolutions. Since this is a training methodology, it can be adapted to other high-resolution-focused backbones. We also show that a single model can be trained across five datasets from different solvers, including a real-world dataset, by conditioning on the simulation parameters. In the DrivAerML dataset, our models achieve a $c_d$ $R^2$ of 0.975, matching literature baselines at a fraction of the training cost."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17182","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:05:58Z","registered":"2025-09-23T03:05:58Z","published":null,"updated":"2025-09-23T03:05:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17006","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17006","identifiers":[{"identifier":"2509.17006","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruonan","familyName":"Zhang","name":"Zhang, Ruonan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyang","familyName":"Hao","name":"Hao, Xiaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yichen","familyName":"Han","name":"Han, Yichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Cao","name":"Cao, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Liu","name":"Liu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Zhang","name":"Zhang, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MBCodec:Thorough disentangle for high-fidelity audio compression"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T09:52:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:51:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"High-fidelity neural audio codecs in Text-to-speech (TTS) aim to compress speech signals into discrete representations for faithful reconstruction. However, prior approaches faced challenges in effectively disentangling acoustic and semantic information within tokens, leading to a lack of fine-grained details in synthesized speech. In this study, we propose MBCodec, a novel multi-codebook audio codec based on Residual Vector Quantization (RVQ) that learns a hierarchically structured representation. MBCodec leverages self-supervised semantic tokenization and audio subband features from the raw signals to construct a functionally-disentangled latent space. In order to encourage comprehensive learning across various layers of the codec embedding space, we introduce adaptive dropout depths to differentially train codebooks across layers, and employ a multi-channel pseudo-quadrature mirror filter (PQMF) during training. By thoroughly decoupling semantic and acoustic features, our method not only achieves near-lossless speech reconstruction but also enables a remarkable 170x compression of 24 kHz audio, resulting in a low bit rate of just 2.2 kbps. Experimental evaluations confirm its consistent and substantial outperformance of baselines across all evaluations."},{"descriptionType":"Other","description":"5 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17006","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:01:47Z","registered":"2025-09-23T03:01:47Z","published":null,"updated":"2025-09-23T03:01:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16949","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16949","identifiers":[{"identifier":"2509.16949","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruicong","familyName":"Liu","name":"Liu, Ruicong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Takehiko","familyName":"Ohkawa","name":"Ohkawa, Takehiko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tze Ho Elden","familyName":"Tse","name":"Tse, Tze Ho Elden","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingfang","familyName":"Zhang","name":"Zhang, Mingfang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Angela","familyName":"Yao","name":"Yao, Angela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yoichi","familyName":"Sato","name":"Sato, Yoichi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Leveraging RGB Images for Pre-Training of Event-Based Hand Pose Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T07:07:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:48:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents RPEP, the first pre-training method for event-based 3D hand pose estimation using labeled RGB images and unpaired, unlabeled event data. Event data offer significant benefits such as high temporal resolution and low latency, but their application to hand pose estimation is still limited by the scarcity of labeled training data. To address this, we repurpose real RGB datasets to train event-based estimators. This is done by constructing pseudo-event-RGB pairs, where event data is generated and aligned with the ground-truth poses of RGB images. Unfortunately, existing pseudo-event generation techniques assume stationary objects, thus struggling to handle non-stationary, dynamically moving hands. To overcome this, RPEP introduces a novel generation strategy that decomposes hand movements into smaller, step-by-step motions. This decomposition allows our method to capture temporal changes in articulation, constructing more realistic event data for a moving hand. Additionally, RPEP imposes a motion reversal constraint, regularizing event generation using reversed motion. Extensive experiments show that our pre-trained model significantly outperforms state-of-the-art methods on real event data, achieving up to 24% improvement on EvRealHands. Moreover, it delivers strong performance with minimal labeled samples for fine-tuning, making it well-suited for practical deployment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16949","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:00:25Z","registered":"2025-09-23T03:00:26Z","published":null,"updated":"2025-09-23T03:00:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16892","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16892","identifiers":[{"identifier":"2509.16892","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiahe","familyName":"Qian","name":"Qian, Jiahe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaoyu","familyName":"Fang","name":"Fang, Yaoyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqiao","familyName":"Weng","name":"Weng, Ziqiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinkun","familyName":"Wang","name":"Wang, Xinkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lee A.","familyName":"Cooper","name":"Cooper, Lee A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Zhou","name":"Zhou, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning from Gene Names, Expression Values and Images: Contrastive Masked Text-Image Pretraining for Spatial Transcriptomics Representation Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T03:05:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:44:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Spatial transcriptomics aims to connect high-resolution histology images with spatially resolved gene expression. To achieve better performance on downstream tasks such as gene expression prediction, large-scale pre-training is required to obtain generalisable representations that can bridge histology and transcriptomics across tissues, protocols, and laboratories. Existing cross-modal pre-training approaches for spatial transcriptomics rely on either gene names or expression values in isolation, which strips the gene branch of essential semantics and breaks the association between each gene and its quantitative magnitude. In addition, by restricting supervision to image-text alignment, these methods ignore intrinsic visual cues that are critical for learning robust image features. We present CoMTIP, the first Contrastive Masked Text-Image Pretraining framework that jointly learns from images, gene names, and expression values while capturing fine-grained visual context for spatial transcriptomics. The vision branch uses Masked Feature Modeling to reconstruct occluded patches and learn context-aware image embeddings. The text branch applies a scalable Gene-Text Encoder that processes all gene sentences in parallel, enriches each gene and its numerical value with dedicated embeddings, and employs Pair-aware Adversarial Training (PAAT) to preserve correct gene-value associations. Image and text representations are aligned in a shared InfoNCE-optimised space. Experiments on public spatial transcriptomics datasets show that CoMTIP not only surpasses previous methods on diverse downstream tasks but also achieves zero-shot gene expression prediction, a capability that existing approaches do not provide."},{"descriptionType":"Other","description":"9 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16892","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:59:02Z","registered":"2025-09-23T02:59:03Z","published":null,"updated":"2025-09-23T02:59:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16876","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16876","identifiers":[{"identifier":"2509.16876","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiun-Ting","familyName":"Li","name":"Li, Jiun-Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bi-Cheng","familyName":"Yan","name":"Yan, Bi-Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi-Cheng","familyName":"Wang","name":"Wang, Yi-Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Berlin","familyName":"Chen","name":"Chen, Berlin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-task Pretraining for Enhancing Interpretable L2 Pronunciation Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T02:04:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:43:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Automatic pronunciation assessment (APA) analyzes second-language (L2) learners' speech by providing fine-grained pronunciation feedback at various linguistic levels. Most existing efforts on APA typically adopt segmental-level features as inputs and predict pronunciation scores at different granularities via hierarchical (or parallel) pronunciation modeling. This, however, inevitably causes assessments across linguistic levels (e.g., phone, word, and utterance) to rely solely on phoneme-level pronunciation features, nearly sidelining supra-segmental pronunciation cues. To address this limitation, we introduce multi-task pretraining (MTP) for APA, a simple yet effective strategy that attempts to capture long-term temporal pronunciation cues while strengthening the intrinsic structures within an utterance via the objective of reconstructing input features. Specifically, for a phoneme-level encoder of an APA model, the proposed MTP strategy randomly masks segmental-level pronunciation features and reconstructs the masked ones based on their surrounding pronunciation context. Furthermore, current APA systems lack integration with automated speaking assessment (ASA), limiting holistic proficiency evaluation. Drawing on empirical studies and prior knowledge in ASA, our framework bridges this gap by incorporating handcrafted features (HCFs), such as fluency (speech rate, silence duration) and stress (pitch accent strength), derived from human-designed formulas via regressors to generate interpretable proficiency scores. Experiments on speechocean762 show improved pronunciation scoring and ASA proficiency correlation, enabling targeted training and comprehensive proficiency assessment."},{"descriptionType":"Other","description":"Accepted by APSIPA-ASC 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16876","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:58:40Z","registered":"2025-09-23T02:58:40Z","published":null,"updated":"2025-09-23T02:58:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16862","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16862","identifiers":[{"identifier":"2509.16862","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rinka","familyName":"Nobukawa","name":"Nobukawa, Rinka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Makito","familyName":"Kitamura","name":"Kitamura, Makito","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomohiko","familyName":"Nakamura","name":"Nakamura, Tomohiko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shinnosuke","familyName":"Takamichi","name":"Takamichi, Shinnosuke","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hiroshi","familyName":"Saruwatari","name":"Saruwatari, Hiroshi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Drum-to-Vocal Percussion Sound Conversion and Its Evaluation Methodology"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T01:27:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:43:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper defines the novel task of drum-to-vocal percussion (VP) sound conversion. VP imitates percussion instruments through human vocalization and is frequently employed in contemporary a cappella music. It exhibits acoustic properties distinct from speech and singing (e.g., aperiodicity, noisy transients, and the absence of linguistic structure), making conventional speech or singing synthesis methods unsuitable. We thus formulate VP synthesis as a timbre transfer problem from drum sounds, leveraging their rhythmic and timbral correspondence. To support this formulation, we define three requirements for successful conversion: rhythmic fidelity, timbral consistency, and naturalness as VP. We also propose corresponding subjective evaluation criteria. We implement two baseline conversion methods using a neural audio synthesizer, the real-time audio variational autoencoder (RAVE), with and without vector quantization (VQ). Subjective experiments show that both methods produce plausible VP outputs, with the VQ-based RAVE model yielding more consistent conversion."},{"descriptionType":"Other","description":"6 pages, 5 figures, accepted for 2025 Asia Pacific Signal and Information Processing Association Annual Summit and Conference (APSIPA ASC)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16862","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:58:20Z","registered":"2025-09-23T02:58:21Z","published":null,"updated":"2025-09-23T02:58:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16769","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16769","identifiers":[{"identifier":"2509.16769","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Prasanth K","familyName":"K","name":"K, Prasanth K","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shubham","familyName":"Sharma","name":"Sharma, Shubham","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geometric Mixture Classifier (GMC): A Discriminative Per-Class Mixture of Hyperplanes"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.5.1; I.5.2; G.3","lang":"en","subjectScheme":"ACM"},{"subject":"68T05, 62H30, 62M45","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-20T18:32:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:37:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Many real world categories are multimodal, with single classes occupying disjoint regions in feature space. Classical linear models (logistic regression, linear SVM) use a single global hyperplane and perform poorly on such data, while high-capacity methods (kernel SVMs, deep nets) fit multimodal structure but at the expense of interpretability, heavier tuning, and higher computational cost. We propose the Geometric Mixture Classifier (GMC), a discriminative model that represents each class as a mixture of hyperplanes. Within each class, GMC combines plane scores via a temperature-controlled soft-OR (log-sum-exp), smoothly approximating the max; across classes, standard softmax yields probabilistic posteriors. GMC optionally uses Random Fourier Features (RFF) for nonlinear mappings while keeping inference linear in the number of planes and features. Our practical training recipe: geometry-aware k-means initialization, silhouette-based plane budgeting, alpha annealing, usage-aware L2 regularization, label smoothing, and early stopping, makes GMC plug-and-play. Across synthetic multimodal datasets (moons, circles, blobs, spirals) and tabular/image benchmarks (iris, wine, WDBC, digits), GMC consistently outperforms linear baselines and k-NN, is competitive with RBF-SVM, Random Forests, and small MLPs, and provides geometric introspection via per-plane and class responsibility visualizations. Inference scales linearly in planes and features, making GMC CPU-friendly, with single-digit microsecond latency per example, often faster than RBF-SVM and compact MLPs. Post-hoc temperature scaling reduces ECE from about 0.06 to 0.02. GMC thus strikes a favorable balance of accuracy, interpretability, and efficiency: it is more expressive than linear models and lighter, more transparent, and faster than kernel or deep models."},{"descriptionType":"Other","description":"21 pages, 6 figures, 14 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16769","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:56:10Z","registered":"2025-09-23T02:56:11Z","published":null,"updated":"2025-09-23T02:56:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16735","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16735","identifiers":[{"identifier":"2509.16735","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dongdong","familyName":"Chen","name":"Chen, Dongdong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linlin","familyName":"Yao","name":"Yao, Linlin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengjun","familyName":"Liu","name":"Liu, Mengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenrong","familyName":"Shen","name":"Shen, Zhenrong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Hu","name":"Hu, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyun","familyName":"Song","name":"Song, Zhiyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengyu","familyName":"Lu","name":"Lu, Shengyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"Wang","name":"Wang, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dinggang","familyName":"Shen","name":"Shen, Dinggang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lichi","familyName":"Zhang","name":"Zhang, Lichi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Brain Connectivity Network Structure Learning For Brain Disorder Diagnosis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Graphics (cs.GR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T15:59:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:34:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent studies in neuroscience highlight the significant potential of brain connectivity networks, which are commonly constructed from functional magnetic resonance imaging (fMRI) data for brain disorder diagnosis. Traditional brain connectivity networks are typically obtained using predefined methods that incorporate manually-set thresholds to estimate inter-regional relationships. However, such approaches often introduce redundant connections or overlook essential interactions, compromising the value of the constructed networks. Besides, the insufficiency of labeled data further increases the difficulty of learning generalized representations of intrinsic brain characteristics. To mitigate those issues, we propose a self-supervised framework to learn an optimal structure and representation for brain connectivity networks, focusing on individualized generation and optimization in an unsupervised manner. We firstly employ two existing whole-brain connectomes to adaptively construct their complementary brain network structure learner, and then introduce a multi-state graph-based encoder with a joint iterative learning strategy to simultaneously optimize both the generated network structure and its representation. By leveraging self-supervised pretraining on large-scale unlabeled brain connectivity data, our framework enables the brain connectivity network learner to generalize e ffectively to unseen disorders, while requiring only minimal finetuning of the encoder for adaptation to new diagnostic tasks. Extensive experiments on cross-dataset brain disorder diagnosis demonstrate that our method consistently outperforms state-of-the-art approaches, validating its effectiveness and generalizability. The code is publicly available at https://github.com/neochen1/BCNSL."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16735","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:55:22Z","registered":"2025-09-23T02:55:23Z","published":null,"updated":"2025-09-23T02:55:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16709","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16709","identifiers":[{"identifier":"2509.16709","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nicolò","familyName":"Botteghi","name":"Botteghi, Nicolò","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matteo","familyName":"Tomasetto","name":"Tomasetto, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Urban","familyName":"Fasel","name":"Fasel, Urban","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Francesco","familyName":"Braghin","name":"Braghin, Francesco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Manzoni","name":"Manzoni, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HypeMARL: Multi-Agent Reinforcement Learning For High-Dimensional, Parametric, and Distributed Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T14:42:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:33:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Deep reinforcement learning has recently emerged as a promising feedback control strategy for complex dynamical systems governed by partial differential equations (PDEs). When dealing with distributed, high-dimensional problems in state and control variables, multi-agent reinforcement learning (MARL) has been proposed as a scalable approach for breaking the curse of dimensionality. In particular, through decentralized training and execution, multiple agents cooperate to steer the system towards a target configuration, relying solely on local state and reward information. However, the principle of locality may become a limiting factor whenever a collective, nonlocal behavior of the agents is crucial to maximize the reward function, as typically happens in PDE-constrained optimal control problems. In this work, we propose HypeMARL: a decentralized MARL algorithm tailored to the control of high-dimensional, parametric, and distributed systems. HypeMARL employs hypernetworks to effectively parametrize the agents' policies and value functions with respect to the system parameters and the agents' relative positions, encoded by sinusoidal positional encoding. Through the application on challenging control problems, such as density and flow control, we show that HypeMARL (i) can effectively control systems through a collective behavior of the agents, outperforming state-of-the-art decentralized MARL, (ii) can efficiently deal with parametric dependencies, (iii) requires minimal hyperparameter tuning and (iv) can reduce the amount of expensive environment interactions by a factor of ~10 thanks to its model-based extension, MB-HypeMARL, which relies on computationally efficient deep learning-based surrogate models approximating the dynamics locally, with minimal deterioration of the policy performance."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16709","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:54:47Z","registered":"2025-09-23T02:54:47Z","published":null,"updated":"2025-09-23T02:54:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16705","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16705","identifiers":[{"identifier":"2509.16705","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuubham","familyName":"Ojha","name":"Ojha, Shuubham","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Felix","familyName":"Gervits","name":"Gervits, Felix","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carol","familyName":"Espy-Wilson","name":"Espy-Wilson, Carol","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reverse Attention for Lightweight Speech Enhancement on Edge Devices"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T14:31:23Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:32:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper introduces a lightweight deep learning model for real-time speech enhancement, designed to operate efficiently on resource-constrained devices. The proposed model leverages a compact architecture that facilitates rapid inference without compromising performance. Key contributions include infusing soft attention-based attention gates in the U-Net architecture which is known to perform well for segmentation tasks and is optimized for GPUs. Experimental evaluations demonstrate that the model achieves competitive speech quality and intelligibility metrics, such as PESQ and Word Error Rates (WER), improving the performance of similarly sized baseline models. We are able to achieve a 6.24% WER improvement and a 0.64 PESQ score improvement over un-enhanced waveforms."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16705","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:54:41Z","registered":"2025-09-23T02:54:41Z","published":null,"updated":"2025-09-23T02:54:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16588","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16588","identifiers":[{"identifier":"2509.16588","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haiming","familyName":"Zhang","name":"Zhang, Haiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiyao","familyName":"Zhu","name":"Zhu, Yiyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wending","familyName":"Zhou","name":"Zhou, Wending","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Yan","name":"Yan, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingjie","familyName":"Cai","name":"Cai, Yingjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingbing","familyName":"Liu","name":"Liu, Bingbing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuguang","familyName":"Cui","name":"Cui, Shuguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Li","name":"Li, Zhen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SQS: Enhancing Sparse Perception Models via Query-based Splatting in Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T09:25:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:23:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Sparse Perception Models (SPMs) adopt a query-driven paradigm that forgoes explicit dense BEV or volumetric construction, enabling highly efficient computation and accelerated inference. In this paper, we introduce SQS, a novel query-based splatting pre-training specifically designed to advance SPMs in autonomous driving. SQS introduces a plug-in module that predicts 3D Gaussian representations from sparse queries during pre-training, leveraging self-supervised splatting to learn fine-grained contextual features through the reconstruction of multi-view images and depth maps. During fine-tuning, the pre-trained Gaussian queries are seamlessly integrated into downstream networks via query interaction mechanisms that explicitly connect pre-trained queries with task-specific queries, effectively accommodating the diverse requirements of occupancy prediction and 3D object detection. Extensive experiments on autonomous driving benchmarks demonstrate that SQS delivers considerable performance gains across multiple query-based 3D perception tasks, notably in occupancy prediction and 3D object detection, outperforming prior state-of-the-art pre-training approaches by a significant margin (i.e., +1.3 mIoU on occupancy prediction and +1.0 NDS on 3D detection)."},{"descriptionType":"Other","description":"NeurIPS 2025 (Spotlight)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16588","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:51:54Z","registered":"2025-09-23T02:51:55Z","published":null,"updated":"2025-09-23T02:51:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16581","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16581","identifiers":[{"identifier":"2509.16581","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohsen","familyName":"Ahmadvand","name":"Ahmadvand, Mohsen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pedro","familyName":"Souto","name":"Souto, Pedro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Cost-Effective ZK-Rollups: Modeling and Optimization of Proving Infrastructure"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T09:03:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:23:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Zero-knowledge rollups rely on provers to generate multi-step state transition proofs under strict finality and availability constraints. These steps require expensive hardware (e.g., GPUs), and finality is reached only once all stages complete and results are posted on-chain. As rollups scale, staying economically viable becomes increasingly difficult due to rising throughput, fast finality demands, volatile gas prices, and dynamic resource needs. We base our study on Halo2-based proving systems and identify transactions per second (TPS), average gas usage, and finality time as key cost drivers. To address this, we propose a parametric cost model that captures rollup-specific constraints and ensures provers can keep up with incoming transaction load. We formulate this model as a constraint system and solve it using the Z3 SMT solver to find cost-optimal configurations. To validate our approach, we implement a simulator that detects lag and estimates operational costs. Our method shows a potential cost reduction of up to 70\\%."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16581","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:51:45Z","registered":"2025-09-23T02:51:45Z","published":null,"updated":"2025-09-23T02:51:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16513","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16513","identifiers":[{"identifier":"2509.16513","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wesley","familyName":"Brewer","name":"Brewer, Wesley","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Maiterth","name":"Maiterth, Matthias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Damien","familyName":"Fay","name":"Fay, Damien","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Trace Replay Simulation of MIT SuperCloud for Studying Optimal Sustainability Policies"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T03:20:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:15:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid growth of AI supercomputing is creating unprecedented power demands, with next-generation GPU datacenters requiring hundreds of megawatts and producing fast, large swings in consumption. To address the resulting challenges for utilities and system operators, we extend ExaDigiT, an open-source digital twin framework for modeling power, cooling, and scheduling of supercomputers. Originally developed for replaying traces from leadership-class HPC systems, ExaDigiT now incorporates heterogeneity, multi-tenancy, and cloud-scale workloads. In this work, we focus on trace replay and rescheduling of jobs on the MIT SuperCloud TX-GAIA system to enable reinforcement learning (RL)-based experimentation with sustainability policies. The RAPS module provides a simulation environment with detailed power and performance statistics, supporting the study of scheduling strategies, incentive structures, and hardware/software prototyping. Preliminary RL experiments using Proximal Policy Optimization demonstrate the feasibility of learning energy-aware scheduling decisions, highlighting ExaDigiT's potential as a platform for exploring optimal policies to improve throughput, efficiency, and sustainability."},{"descriptionType":"Other","description":"2 pages, 2 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16513","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:50:10Z","registered":"2025-09-23T02:50:11Z","published":null,"updated":"2025-09-23T02:50:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16512","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16512","identifiers":[{"identifier":"2509.16512","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md Tawsif Rahman","familyName":"Chowdhury","name":"Chowdhury, Md Tawsif Rahman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alireza","familyName":"Moazzeni","name":"Moazzeni, Alireza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gozde","familyName":"Tutuncuoglu","name":"Tutuncuoglu, Gozde","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Atomic-Scale Insights into the Switching Mechanisms of RRAM Devices"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T03:20:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:15:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The growing energy demands of information and communication technologies, driven by data-intensive computing and the von Neumann bottleneck, underscore the need for energy-efficient alternatives. Resistive random-access memory (RRAM) devices have emerged as promising candidates for beyond von Neumann computing paradigms, such as neuromorphic computing, offering voltage-history-dependent switching that mimics synaptic and neural behaviors. Atomic-scale mechanisms, such as defect-driven filament formation and ionic transport, govern these switching processes. In this work, we present a comprehensive characterization of Tantalum Oxide based RRAM devices featuring both oxygen-rich and oxygen-deficient switching layers. We analyze the dominant conduction mechanisms underpinning resistive switching and systematically evaluate how oxygen stoichiometry influences device behavior. Leveraging a bottom-up design methodology, we link material composition to electrical performance metrics-such as endurance, cycle-to-cycle variability, and multilevel resistance states-providing actionable guidelines for optimizing RRAM architectures for energy-efficient memory and computing applications."},{"descriptionType":"Other","description":"\\c{opyright} 2025 IEEE. Personal use of this material is permitted. Permission from IEEE must be obtained for all other uses, in any current or future media, including reprinting/republishing this material for advertising or promotional purposes, creating new collective works, for resale or redistribution to servers or lists, or reuse of any copyrighted component of this work in other works"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16512","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:50:09Z","registered":"2025-09-23T02:50:10Z","published":null,"updated":"2025-09-23T02:50:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16434","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16434","identifiers":[{"identifier":"2509.16434","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ritvik","familyName":"Singh","name":"Singh, Ritvik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karl","familyName":"Van Wyk","name":"Van Wyk, Karl","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pieter","familyName":"Abbeel","name":"Abbeel, Pieter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jitendra","familyName":"Malik","name":"Malik, Jitendra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"Ratliff","name":"Ratliff, Nathan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ankur","familyName":"Handa","name":"Handa, Ankur","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"End-to-end RL Improves Dexterous Grasping Policies"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T21:21:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:09:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This work explores techniques to scale up image-based end-to-end learning for dexterous grasping with an arm + hand system. Unlike state-based RL, vision-based RL is much more memory inefficient, resulting in relatively low batch sizes, which is not amenable for algorithms like PPO. Nevertheless, it is still an attractive method as unlike the more commonly used techniques which distill state-based policies into vision networks, end-to-end RL can allow for emergent active vision behaviors. We identify a key bottleneck in training these policies is the way most existing simulators scale to multiple GPUs using traditional data parallelism techniques. We propose a new method where we disaggregate the simulator and RL (both training and experience buffers) onto separate GPUs. On a node with four GPUs, we have the simulator running on three of them, and PPO running on the fourth. We are able to show that with the same number of GPUs, we can double the number of existing environments compared to the previous baseline of standard data parallelism. This allows us to train vision-based environments, end-to-end with depth, which were previously performing far worse with the baseline. We train and distill both depth and state-based policies into stereo RGB networks and show that depth distillation leads to better results, both in simulation and reality. This improvement is likely due to the observability gap between state and vision policies which does not exist when distilling depth policies into stereo RGB. We further show that the increased batch size brought about by disaggregated simulation also improves real world performance. When deploying in the real world, we improve upon the previous state-of-the-art vision-based results using our end-to-end policies."},{"descriptionType":"Other","description":"See our blog post: https://e2e4robotics.com/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16434","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:19Z","registered":"2025-09-23T02:48:19Z","published":null,"updated":"2025-09-23T02:48:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16415","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16415","identifiers":[{"identifier":"2509.16415","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhengri","familyName":"Wu","name":"Wu, Zhengri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiran","familyName":"Wang","name":"Wang, Yiran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Wen","name":"Wen, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Zhang","name":"Zhang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Biao","familyName":"Wu","name":"Wu, Biao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Tang","name":"Tang, Hao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"StereoAdapter: Adapting Stereo Depth Estimation to Underwater Scenes"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T20:57:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:08:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Underwater stereo depth estimation provides accurate 3D geometry for robotics tasks such as navigation, inspection, and mapping, offering metric depth from low-cost passive cameras while avoiding the scale ambiguity of monocular methods. However, existing approaches face two critical challenges: (i) parameter-efficiently adapting large vision foundation encoders to the underwater domain without extensive labeled data, and (ii) tightly fusing globally coherent but scale-ambiguous monocular priors with locally metric yet photometrically fragile stereo correspondences. To address these challenges, we propose StereoAdapter, a parameter-efficient self-supervised framework that integrates a LoRA-adapted monocular foundation encoder with a recurrent stereo refinement module. We further introduce dynamic LoRA adaptation for efficient rank selection and pre-training on the synthetic UW-StereoDepth-40K dataset to enhance robustness under diverse underwater conditions. Comprehensive evaluations on both simulated and real-world benchmarks show improvements of 6.11% on TartanAir and 5.12% on SQUID compared to state-of-the-art methods, while real-world deployment with the BlueROV2 robot further demonstrates the consistent robustness of our approach. Code: https://github.com/AIGeeksGroup/StereoAdapter. Website: https://aigeeksgroup.github.io/StereoAdapter."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16415","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:47:52Z","registered":"2025-09-23T02:47:53Z","published":null,"updated":"2025-09-23T02:47:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16393","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16393","identifiers":[{"identifier":"2509.16393","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Manuel","familyName":"Noseda","name":"Noseda, Manuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alberto","familyName":"De Luca","name":"De Luca, Alberto","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lukas","familyName":"Von Briel","name":"Von Briel, Lukas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nathan","familyName":"Lacour","name":"Lacour, Nathan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Federated Learning for Financial Forecasting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T20:15:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:07:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper studies Federated Learning (FL) for binary classification of volatile financial market trends. Using a shared Long Short-Term Memory (LSTM) classifier, we compare three scenarios: (i) a centralized model trained on the union of all data, (ii) a single-agent model trained on an individual data subset, and (iii) a privacy-preserving FL collaboration in which agents exchange only model updates, never raw data. We then extend the study with additional market features, deliberately introducing not independent and identically distributed data (non-IID) across agents, personalized FL and employing differential privacy. Our numerical experiments show that FL achieves accuracy and generalization on par with the centralized baseline, while significantly outperforming the single-agent model. The results show that collaborative, privacy-preserving learning provides collective tangible value in finance, even under realistic data heterogeneity and personalization requirements."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16393","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:47:23Z","registered":"2025-09-23T02:47:23Z","published":null,"updated":"2025-09-23T02:47:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":45,"totalPages":2,"page":2},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=2\u0026page%5Bsize%5D=25\u0026query=%28registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28GPU+OR+GPUs+OR+CUDA+OR+kernel+OR+kernels+OR+accelerator+OR+accelerators+OR+compiler+OR+compilers+OR+collective+OR+collectives+OR+quantization+OR+quantisation+OR+pretraining+OR+%22pre-training%22+OR+%22post-training%22+OR+%22post+training%22+OR+VLA+OR+VLM+OR+VLMs+OR+MLLM+OR+MLLMs+OR+RAG+OR+%22retrieval-augmented%22+OR+%22retrieval+augmented%22+OR+%22KV+cache%22+OR+%22KV+caches%22+OR+%22key-value+cache%22+OR+%22key-value+caches%22+OR+%22state+space+model%22+OR+%22state+space+models%22+OR+%22state-space+model%22+OR+%22state-space+models%22+OR+%22model+serving%22+OR+%22inference+serving%22+OR+%22distributed+training%22+OR+%22tensor+parallel%22+OR+%22pipeline+parallel%22%29+OR+descriptions.description%3A%28GPU+OR+GPUs+OR+CUDA+OR+kernel+OR+kernels+OR+accelerator+OR+accelerators+OR+compiler+OR+compilers+OR+collective+OR+collectives+OR+quantization+OR+quantisation+OR+pretraining+OR+%22pre-training%22+OR+%22post-training%22+OR+%22post+training%22+OR+VLA+OR+VLM+OR+VLMs+OR+MLLM+OR+MLLMs+OR+RAG+OR+%22retrieval-augmented%22+OR+%22retrieval+augmented%22+OR+%22KV+cache%22+OR+%22KV+caches%22+OR+%22key-value+cache%22+OR+%22key-value+caches%22+OR+%22state+space+model%22+OR+%22state+space+models%22+OR+%22state-space+model%22+OR+%22state-space+models%22+OR+%22model+serving%22+OR+%22inference+serving%22+OR+%22distributed+training%22+OR+%22tensor+parallel%22+OR+%22pipeline+parallel%22%29%29+AND+NOT+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22L