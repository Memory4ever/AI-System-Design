<th id="S5.T1.7.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S5.T1.7.4.1.1" class="ltx_text ltx_font_italic">Early Fusion</span></th>
<td id="S5.T1.7.4.2" class="ltx_td ltx_align_center">3.48</td>
<td id="S5.T1.7.4.3" class="ltx_td ltx_align_center">5.61</td>
