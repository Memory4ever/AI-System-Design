<td id="S5.T1.7.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="4">CR (%) <math id="S5.T1.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
