<td id="S5.T1.2.7.8" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FCE5BF;padding-left:7.0pt;padding-right:7.0pt;"><span id="S5.T1.2.7.8.1" class="ltx_text" style="--ltx-bg-color:#FCE5BF;">0.424</span></td>
