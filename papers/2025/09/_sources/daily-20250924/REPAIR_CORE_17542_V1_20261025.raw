<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S4.F10.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.17542v1/Fig10.1.png" id="S4.F10.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:236/142;" width="236" height="142" alt="Refer to caption">
