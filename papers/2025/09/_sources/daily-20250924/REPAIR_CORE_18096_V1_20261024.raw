<tr id="S4.T2.fig1.1.1.5" class="ltx_tr">
<th id="S4.T2.fig1.1.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">iSeg <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib54" title="" class="ltx_ref">54</a>]</cite></th>
