<tr id="S4.T2.fig1.1.1.4" class="ltx_tr">
<th id="S4.T2.fig1.1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">DiffSegmenter <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib60" title="" class="ltx_ref">60</a>]</cite></th>
<th id="S4.T2.fig1.1.1.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">SD1.5</th>
<th id="S4.T2.fig1.1.1.4.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t">–</th>
<td id="S4.T2.fig1.1.1.4.4" class="ltx_td ltx_align_center ltx_border_t">66.4</td>
<td id="S4.T2.fig1.1.1.4.5" class="ltx_td ltx_align_center ltx_border_t">40.0</td>
