<tr id="A6.T10.5.1.7" class="ltx_tr">
<th id="A6.T10.5.1.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="A6.T10.m29" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi>✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></th>
