<th id="S4.T2.5.1.17.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb"><math id="S4.T2.m22" class="ltx_Math" alttext="B_{\lambda}(\phi_{\text{new}})/B_{\lambda}(\phi_{\text{new}})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>B</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mtext>new</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>B</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mtext>new</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{\lambda}(\phi_{\text{new}})/B_{\lambda}(\phi_{\text{new}})</annotation></semantics></math></th>
