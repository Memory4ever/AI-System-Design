<th id="S4.T2.5.1.14.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="S4.T2.m19" class="ltx_Math" alttext="F(\phi_{\text{old}})/F(\phi_{\text{old}})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mtext>old</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mtext>old</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\phi_{\text{old}})/F(\phi_{\text{old}})</annotation></semantics></math></th>
<td id="S4.T2.5.1.14.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFF0E0;"><span id="S4.T2.5.1.14.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFF0E0;">59.92</span></td>
