<tr id="S4.T2.5.1.15" class="ltx_tr">
<th id="S4.T2.5.1.15.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><math id="S4.T2.m20" class="ltx_Math" alttext="B_{\lambda}(\phi_{\text{new}})/F(\phi_{\text{old}})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mtext>new</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mtext>old</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{\lambda}(\phi_{\text{new}})/F(\phi_{\text{old}})</annotation></semantics></math></th>
<td id="S4.T2.5.1.15.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9EDD9;"><span id="S4.T2.5.1.15.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#D9EDD9;">70.72</span></td>
<td id="S4.T2.5.1.15.3" class="ltx_td"></td>
<td id="S4.T2.5.1.15.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#D9EDD9;"><span id="S4.T2.5.1.15.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#D9EDD9;">72.08</span></td>
<td id="S4.T2.5.1.15.5" class="ltx_td"></td></tr>
<tr id="S4.T2.5.1.16" class="ltx_tr">
<th id="S4.T2.5.1.16.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><math id="S4.T2.m21" class="ltx_Math" alttext="B_{\lambda}(\phi_{\text{new}})/\phi_{\text{old}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>ϕ</mi><mtext>new</mtext></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>ϕ</mi><mtext>old</mtext></msub></mrow><annotation encoding="application/x-tex">B_{\lambda}(\phi_{\text{new}})/\phi_{\text{old}}</annotation></semantics></math></th>
<td id="S4.T2.5.1.16.2" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E0F2FA;"><span id="S4.T2.5.1.16.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E0F2FA;">60.64</span></td>
