<div id="p6" class="ltx_para">
<p id="p6.1" class="ltx_p ltx_align_center"><span id="p6.1.1" class="ltx_text ltx_font_bold">Sankeerth Durvasula</span> <sup id="p6.1.2" class="ltx_sup">1 </sup><sup id="p6.1.3" class="ltx_sup">2 </sup><sup id="p6.1.4" class="ltx_sup">3 </sup> 
