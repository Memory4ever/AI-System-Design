<th id="A3.T10.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A3.T10.2.1.1.2.1" class="ltx_text ltx_font_bold">Weighted Cohen’s <math id="A3.T10.m1" class="ltx_Math" alttext="\kappa_{w}" display="inline" intent=":literal"><semantics><msub><mi>κ</mi><mi>w</mi></msub><annotation encoding="application/x-tex">\kappa_{w}</annotation></semantics></math></span></th>
