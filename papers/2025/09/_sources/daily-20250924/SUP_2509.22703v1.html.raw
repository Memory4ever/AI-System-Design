<td id="S5.T4.2.1.10.3" class="ltx_td ltx_align_center ltx_border_b" style="--ltx-bg-color:#FFE1E1;"><span id="S5.T4.2.1.10.3.1" class="ltx_text" style="--ltx-bg-color:#FFE1E1;">43.69</span></td>
<td id="S5.T4.2.1.10.4" class="ltx_td ltx_align_center ltx_border_b" style="--ltx-bg-color:#FFB4B4;"><span id="S5.T4.2.1.10.4.1" class="ltx_text" style="--ltx-bg-color:#FFB4B4;">37.21</span></td></tr>
