<td id="S5.T1.2.1.8.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFE1E1;"><span id="S5.T1.2.1.8.4.1" class="ltx_text" style="--ltx-bg-color:#FFE1E1;">25.26</span></td></tr>
