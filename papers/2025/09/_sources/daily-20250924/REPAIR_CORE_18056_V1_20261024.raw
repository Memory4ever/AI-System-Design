<span id="S4.T5.3.1.1.1.1.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.5pt 5.7pt;">TempSamp-R1 (<math id="S4.T5.m3" class="ltx_Math" alttext="+\Delta" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">+\Delta</annotation></semantics></math>)</span></span>
