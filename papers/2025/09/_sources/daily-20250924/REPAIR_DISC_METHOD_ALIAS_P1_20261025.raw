{"data":[{"id":"10.48550/arxiv.2509.18046","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18046","identifiers":[{"identifier":"2509.18046","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yinuo","familyName":"Wang","name":"Wang, Yinuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanyang","familyName":"Qi","name":"Qi, Yuanyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinzhao","familyName":"Zhou","name":"Zhou, Jinzhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengxiang","familyName":"Meng","name":"Meng, Pengxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaowen","familyName":"Tao","name":"Tao, Xiaowen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HuMam: Humanoid Motion Control via End-to-End Deep Reinforcement Learning with Mamba"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:19:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:48:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-11T16:00:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T01:25:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"End-to-end reinforcement learning (RL) for humanoid locomotion is appealing for its compact perception-action mapping, yet practical policies often suffer from training instability, inefficient feature fusion, and high actuation cost. We present HuMam, a state-centric end-to-end RL framework that employs a single-layer Mamba encoder to fuse robot-centric states with oriented footstep targets and a continuous phase clock. The policy outputs joint position targets tracked by a low-level PD loop and is optimized with PPO. A concise six-term reward balances contact quality, swing smoothness, foot placement, posture, and body stability while implicitly promoting energy saving. On the JVRC-1 humanoid in mc-mujoco, HuMam consistently improves learning efficiency, training stability, and overall task performance over a strong feedforward baseline, while reducing power consumption and torque peaks. To our knowledge, this is the first end-to-end humanoid RL controller that adopts Mamba as the fusion backbone, demonstrating tangible gains in efficiency, stability, and control economy."},{"descriptionType":"Other","description":"12 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18046","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:26:20Z","registered":"2025-09-23T03:26:21Z","published":null,"updated":"2026-06-02T04:52:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17428","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17428","identifiers":[{"identifier":"2509.17428","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyesung","familyName":"Jeon","name":"Jeon, Hyesung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seojune","familyName":"Lee","name":"Lee, Seojune","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Beomseok","familyName":"Kang","name":"Kang, Beomseok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yulhwa","familyName":"Kim","name":"Kim, Yulhwa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jae-Joon","familyName":"Kim","name":"Kim, Jae-Joon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"QWHA: Quantization-Aware Walsh-Hadamard Adaptation for Parameter-Efficient Fine-Tuning on Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:21:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:14:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T07:49:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:38:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-26T11:23:43Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-29T00:53:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-27T03:15:59Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-05-20T00:28:39Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The demand for efficient deployment of large language models (LLMs) has driven interest in quantization, which reduces inference cost, and parameter-efficient fine-tuning (PEFT), which lowers training overhead. This motivated the development of quantization-aware PEFT to produce accurate yet efficient quantized models. In this setting, reducing quantization error prior to fine-tuning is crucial for achieving high model accuracy. However, existing methods that rely on low-rank adaptation suffer from limited representational capacity. Recent Fourier-related transform (FT)-based adapters offer greater representational power than low-rank adapters, but their direct integration into quantized models often results in ineffective error reduction and increased computational overhead. To overcome these limitations, we propose QWHA, a method that integrates FT-based adapters into quantized models by employing the Walsh-Hadamard Transform (WHT) as the transform kernel, together with a novel adapter initialization scheme incorporating adaptive parameter selection and value refinement. We demonstrate that QWHA effectively mitigates quantization errors while facilitating fine-tuning, and that its design substantially reduces computational cost. Experimental results show that QWHA consistently outperforms baselines in low-bit quantization accuracy and achieves significant training speedups over existing FT-based adapters. The code is available at https://github.com/vantaa89/qwha."},{"descriptionType":"Other","description":"25 pages, 9 figures, 14 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17428","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:46Z","registered":"2025-09-23T03:11:46Z","published":null,"updated":"2026-05-20T02:45:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16889","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16889","identifiers":[{"identifier":"2509.16889","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaoqiang","familyName":"Kang","name":"Kang, Xiaoqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengen","familyName":"Wu","name":"Wu, Shengen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimu","familyName":"Wang","name":"Wang, Zimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilin","familyName":"Liu","name":"Liu, Yilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobo","familyName":"Jin","name":"Jin, Xiaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaizhu","familyName":"Huang","name":"Huang, Kaizhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wang","name":"Wang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutao","familyName":"Yue","name":"Yue, Yutao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaowei","familyName":"Huang","name":"Huang, Xiaowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiufeng","familyName":"Wang","name":"Wang, Qiufeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can GRPO Boost Complex Multimodal Table Understanding?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T02:51:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:44:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T02:52:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:25:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-26T02:16:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-27T00:22:01Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing table understanding methods face challenges due to complex table structures and intricate logical reasoning. While supervised finetuning (SFT) dominates existing research, reinforcement learning (RL), such as Group Relative Policy Optimization (GRPO), has shown promise but struggled with low initial policy accuracy and coarse rewards in tabular contexts. In this paper, we introduce Table-R1, a three-stage RL framework that enhances multimodal table understanding through: (1) Warm-up that prompts initial perception and reasoning capabilities, (2) Perception Alignment GRPO (PA-GRPO), which employs continuous Tree-Edit-Distance Similarity (TEDS) rewards for recognizing table structures and contents, and (3) Hint-Completion GRPO (HC-GRPO), which utilizes fine-grained rewards of residual steps based on the hint-guided question. Extensive experiments demonstrate that Table-R1 can boost the model's table reasoning performance obviously on both held-in and held-out datasets, outperforming SFT and GRPO largely. Notably, Qwen2-VL-7B with Table-R1 surpasses larger specific table understanding models (e.g., Table-LLaVA 13B), even achieving comparable performance to the closed-source model GPT-4o on held-in datasets, demonstrating the efficacy of each stage of Table-R1 in overcoming initialization bottlenecks and reward sparsity, thereby advancing robust multimodal table understanding."},{"descriptionType":"Other","description":"EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16889","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:58:58Z","registered":"2025-09-23T02:58:59Z","published":null,"updated":"2026-03-27T02:22:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17010","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17010","identifiers":[{"identifier":"2509.17010","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Rajpal","familyName":"Singh","name":"Singh, Rajpal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aditya","familyName":"Singh","name":"Singh, Aditya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chidre Shravista","familyName":"Kashyap","name":"Kashyap, Chidre Shravista","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jishnu","familyName":"Keshavan","name":"Keshavan, Jishnu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalized Momenta-Based Koopman Formalism for Robust Control of Euler-Lagrangian Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Systems and Control (eess.SY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T09:56:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:51:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-27T05:03:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-02T01:23:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper presents a novel Koopman operator formulation for Euler Lagrangian dynamics that employs an implicit generalized momentum-based state space representation, which decouples a known linear actuation channel from state dependent dynamics and makes the system more amenable to linear Koopman modeling. By leveraging this structural separation, the proposed formulation only requires to learn the unactuated dynamics rather than the complete actuation dependent system, thereby significantly reducing the number of learnable parameters, improving data efficiency, and lowering overall model complexity. In contrast, conventional explicit formulations inherently couple inputs with the state dependent terms in a nonlinear manner, making them more suitable for bilinear Koopman models, which are more computationally expensive to train and deploy. Notably, the proposed scheme enables the formulation of linear models that achieve superior prediction performance compared to conventional bilinear models while remaining substantially more efficient. To realize this framework, we present two neural network architectures that construct Koopman embeddings from actuated or unactuated data, enabling flexible and efficient modeling across different tasks. Robustness is ensured through the integration of a linear Generalized Extended State Observer (GESO), which explicitly estimates disturbances and compensates for them in real time. The combined momentum-based Koopman and GESO framework is validated through comprehensive trajectory tracking simulations and experiments on robotic manipulators, demonstrating superior accuracy, robustness, and learning efficiency relative to state of the art alternatives."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17010","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:01:52Z","registered":"2025-09-23T03:01:53Z","published":null,"updated":"2026-03-02T03:06:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17797","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17797","identifiers":[{"identifier":"2509.17797","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuan","familyName":"Gao","name":"Gao, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Liu","name":"Liu, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runze","familyName":"Yu","name":"Yu, Runze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengli","familyName":"Liu","name":"Liu, Shengli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanliang","familyName":"Jin","name":"Jin, Yanliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shunqing","familyName":"Zhang","name":"Zhang, Shunqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shugong","familyName":"Xu","name":"Xu, Shugong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoli","familyName":"Chu","name":"Chu, Xiaoli","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SSNet: Flexible and robust channel extrapolation for fluid antenna systems enabled by an self-supervised learning framework"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:52:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-02T01:47:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/jsac.2025.3619472","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Fluid antenna systems (FAS) signify a pivotal advancement in 6G communication by enhancing spectral efficiency and robustness. However, obtaining accurate channel state information (CSI) in FAS poses challenges due to its complex physical structure. Traditional methods, such as pilot-based interpolation and compressive sensing, are not only computationally intensive but also lack adaptability. Current extrapolation techniques relying on rigid parametric models do not accommodate the dynamic environment of FAS, while data-driven deep learning approaches demand extensive training and are vulnerable to noise and hardware imperfections. To address these challenges, this paper introduces a novel self-supervised learning network (SSNet) designed for efficient and adaptive channel extrapolation in FAS. We formulate the problem of channel extrapolation in FAS as an image reconstruction task. Here, a limited number of unmasked pixels (representing the known CSI of the selected ports) are used to extrapolate the masked pixels (the CSI of unselected ports). SSNet capitalizes on the intrinsic structure of FAS channels, learning generalized representations from raw CSI data, thus reducing dependency on large labelled datasets. For enhanced feature extraction and noise resilience, we propose a mix-of-expert (MoE) module. In this setup, multiple feedforward neural networks (FFNs) operate in parallel. The outputs of the MoE module are combined using a weighted sum, determined by a gating function that computes the weights of each FFN using a softmax function. Extensive simulations validate the superiority of the proposed model. Results indicate that SSNet significantly outperforms benchmark models, such as AGMAE and long short-term memory (LSTM) networks by using a much smaller labelled dataset."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17797","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:20:30Z","registered":"2025-09-23T03:20:30Z","published":null,"updated":"2026-02-02T03:24:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17786","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17786","identifiers":[{"identifier":"2509.17786","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aniello","familyName":"Panariello","name":"Panariello, Aniello","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Marczak","name":"Marczak, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Magistri","name":"Magistri, Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Angelo","familyName":"Porrello","name":"Porrello, Angelo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bartłomiej","familyName":"Twardowski","name":"Twardowski, Bartłomiej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrew D.","familyName":"Bagdanov","name":"Bagdanov, Andrew D.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Simone","familyName":"Calderara","name":"Calderara, Simone","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joost","familyName":"van de Weijer","name":"van de Weijer, Joost","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Accurate and Efficient Low-Rank Model Merging in Core Space"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:48:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:35:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-28T18:21:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T01:17:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-20T10:33:14Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-21T01:22:27Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-30T13:02:35Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-02-02T01:50:51Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we address the challenges associated with merging low-rank adaptations of large neural networks. With the rise of parameter-efficient adaptation techniques, such as Low-Rank Adaptation (LoRA), model fine-tuning has become more accessible. While fine-tuning models with LoRA is highly efficient, existing merging methods often sacrifice this efficiency by merging fully-sized weight matrices. We propose the Core Space merging framework, which enables the merging of LoRA-adapted models within a common alignment basis, thereby preserving the efficiency of low-rank adaptation while substantially improving accuracy across tasks. We further provide a formal proof that projection into Core Space ensures no loss of information and provide a complexity analysis showing the efficiency gains. Extensive empirical results demonstrate that Core Space significantly improves existing merging techniques and achieves state-of-the-art results on both vision and language tasks while utilizing a fraction of the computational resources. Codebase is available at https://github.com/apanariello4/core-space-merging."},{"descriptionType":"Other","description":"Accepted at 39th Conference on Neural Information Processing Systems (NeurIPS 2025), San Diego, USA"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17786","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:20:14Z","registered":"2025-09-23T03:20:14Z","published":null,"updated":"2026-02-02T03:24:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17816","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17816","identifiers":[{"identifier":"2509.17816","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Brown","familyName":"Ebouky","name":"Ebouky, Brown","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ajad","familyName":"Chhatkuli","name":"Chhatkuli, Ajad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristiano","familyName":"Malossi","name":"Malossi, Cristiano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christoph","familyName":"Studer","name":"Studer, Christoph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roy","familyName":"Assaf","name":"Assaf, Roy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Bartezzaghi","name":"Bartezzaghi, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Semantic Segmentation with Continual Self-Supervised Pre-training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:11:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:37:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T10:21:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-30T01:42:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-supervised learning (SSL) has emerged as a central paradigm for training foundation models by leveraging large-scale unlabeled datasets, often producing representations with strong generalization capabilities. These models are typically pre-trained on general-purpose datasets such as ImageNet and subsequently adapted to various downstream tasks through finetuning. While prior work has investigated parameter-efficient adaptation methods like adapters, LoRA, and prompt tuning, primarily targeting downstream finetuning, extending the SSL pre-training itself in a continual manner to new domains under limited data remains largely underexplored, especially for downstream dense prediction tasks like semantic segmentation. In this work, we address the challenge of adapting vision foundation models to low-data target domains through continual self-supervised pre-training, specifically targeting downstream semantic segmentation. We propose GLARE (Global Local and Regional Enforcement), a novel continual self-supervised pre-training task designed to enhance downstream semantic segmentation performance. GLARE introduces patch-level augmentations to encourage local consistency and incorporates a regional consistency constraint that leverages spatial semantics in the data. For efficient continual pre-training, we initialize Vision Transformers (ViTs) with weights from existing SSL models and update only lightweight adapter modules specifically UniAdapter - while keeping the rest of the backbone frozen. Experiments across multiple semantic segmentation benchmarks on different domains demonstrate that GLARE consistently improves downstream performance with minimal computational and parameter overhead."},{"descriptionType":"Other","description":"23 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17816","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:20:56Z","registered":"2025-09-23T03:20:57Z","published":null,"updated":"2026-01-30T03:41:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16891","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16891","identifiers":[{"identifier":"2509.16891","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sha","familyName":"Li","name":"Li, Sha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Petrangeli","name":"Petrangeli, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Shen","name":"Shen, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naren","familyName":"Ramakrishnan","name":"Ramakrishnan, Naren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLMs as Layout Designers: Enhanced Spatial Reasoning for Content-Aware Layout Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T03:02:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:44:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-03T23:19:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-05T01:10:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-05T20:28:27Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-07T01:05:35Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-25T23:11:38Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-27T02:03:10Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While Large Language Models (LLMs) have demonstrated impressive reasoning and planning abilities in textual domains and can effectively follow instructions for complex tasks, their ability to understand and manipulate spatial relationships remains limited. Such capabilities are crucial for content-aware graphic layout design, where the goal is to arrange heterogeneous elements onto a canvas so that final design remains visually balanced and structurally feasible. This problem requires precise coordination of placement, alignment, and structural organization of multiple elements within a constrained visual space. To address this limitation, we introduce LaySPA, a reinforcement learning-based framework that augments LLM-based agents with explicit spatial reasoning capabilities for layout design. LaySPA employs hybrid reward signals that jointly capture geometric constraints, structural fidelity, and visual quality, enabling agents to navigate the canvas, model inter-element relationships, and optimize spatial arrangements. Through group-relative policy optimization, the agent generates content-aware layouts that reflect salient regions, respect spatial constraints, and produces an interpretable reasoning trace explaining placement decisions and a structured layout specification. Experimental results show that LaySPA substantially improves the generation of structurally valid and visually appealing layouts, outperforming larger general-purpose LLMs and achieving performance comparable to state-of-the-art specialized layout models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16891","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:59:01Z","registered":"2025-09-23T02:59:02Z","published":null,"updated":"2026-01-27T04:34:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17514","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17514","identifiers":[{"identifier":"2509.17514","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyi","familyName":"Chen","name":"Chen, Tianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengxiao","familyName":"Lin","name":"Lin, Pengxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiwei","familyName":"Wang","name":"Wang, Zhiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhi-Qin John","familyName":"Xu","name":"Xu, Zhi-Qin John","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Achilles' Heel of Mamba: Essential difficulties of the Mamba architecture demonstrated by synthetic data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:38:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:19:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-21T02:41:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-22T01:15:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"State Space Models (SSMs) have emerged as promising alternatives to attention mechanisms, with the Mamba architecture demonstrating impressive performance and linear complexity for processing long sequences. However, the fundamental differences between Mamba and Transformer architectures remain incompletely understood. In this work, we use carefully designed synthetic tasks to reveal Mamba's inherent limitations. Through experiments, we identify that Mamba's nonlinear convolution introduces an asymmetry bias that significantly impairs its ability to recognize symmetrical patterns and relationships. Using composite function and inverse sequence matching tasks, we demonstrate that Mamba strongly favors compositional solutions over symmetrical ones and struggles with tasks requiring the matching of reversed sequences. We show these limitations stem not from the SSM module itself but from the nonlinear convolution preceding it, which fuses token information asymmetrically. These insights provide a new understanding of Mamba's constraints and suggest concrete architectural improvements for future sequence models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17514","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:13:48Z","registered":"2025-09-23T03:13:48Z","published":null,"updated":"2026-01-22T03:17:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17209","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17209","identifiers":[{"identifier":"2509.17209","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lourdes","familyName":"Moreno","name":"Moreno, Lourdes","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jesus M.","familyName":"Sanchez-Gomez","name":"Sanchez-Gomez, Jesus M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marco Antonio","familyName":"Sanchez-Escudero","name":"Sanchez-Escudero, Marco Antonio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paloma","familyName":"Martínez","name":"Martínez, Paloma","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prompt-Based Simplification for Plain Language using Spanish Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T19:28:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-01-13T01:31:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper describes the participation of HULAT-UC3M in CLEARS 2025 Subtask 1: Adaptation of Text to Plain Language (PL) in Spanish. We explored strategies based on models trained on Spanish texts, including a zero-shot configuration using prompt engineering and a fine-tuned version with Low-Rank Adaptation (LoRA). Different strategies were evaluated on representative internal subsets of the training data, using the official task metrics, cosine similarity (SIM) and the Fernández-Huerta readability index (FH) to guide the selection of the optimal model and prompt combination. The final system was selected for its balanced and consistent performance, combining normalization steps, the RigoChat-7B-v2 model, and a dedicated PL-oriented prompt. It ranked first in semantic similarity (SIM = 0.75), however, fourth in readability (FH = 69.72). We also discuss key challenges related to training data heterogeneity and the limitations of current evaluation metrics in capturing both linguistic clarity and content preservation."},{"descriptionType":"Other","description":"11 pages, 7 tables,"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17209","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:06:36Z","registered":"2025-09-23T03:06:37Z","published":null,"updated":"2026-01-13T04:26:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16935","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16935","identifiers":[{"identifier":"2509.16935","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lavish","familyName":"Ramchandani","name":"Ramchandani, Lavish","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gunjan","familyName":"Deotale","name":"Deotale, Gunjan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dev Kumar","familyName":"Das","name":"Das, Dev Kumar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Parameter-efficient fine-tuning (PEFT) of Vision Foundation Models for Atypical Mitotic Figure Classification"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.10; I.4.9; I.5.4","lang":"en","subjectScheme":"ACM"},{"subject":"68T07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-21T05:46:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:46:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-10T07:07:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-13T01:18:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Atypical mitotic figures (AMFs) are rare abnormal cell divisions associated with tumor aggressiveness and poor prognosis. Their detection remains a significant challenge due to subtle morphological cues, class imbalance, and inter-observer variability among pathologists. The MIDOG 2025 challenge introduced a dedicated track for atypical mitosis classification, enabling systematic evaluation of deep learning methods. In this study, we investigated the use of large vision foundation models, including Virchow, Virchow2, and UNI, with Low-Rank Adaptation (LoRA) for parameter-efficient fine-tuning. We conducted extensive experiments with different LoRA ranks, as well as random and group-based data splits, to analyze robustness under varied conditions. Our best approach, Virchow with LoRA rank 8 and ensemble of three-fold cross-validation, achieved a balanced accuracy of 88.37% on the preliminary test set, ranking joint 9th in the challenge leaderboard. These results highlight the promise of foundation models with efficient adaptation strategies for the classification of atypical mitosis, while underscoring the need for improvements in specificity and domain generalization."},{"descriptionType":"Other","description":"MIDOG'25"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16935","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:00:03Z","registered":"2025-09-23T03:00:04Z","published":null,"updated":"2026-01-13T04:26:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16986","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16986","identifiers":[{"identifier":"2509.16986","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Feng","familyName":"Han","name":"Han, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Gong","name":"Gong, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhipeng","familyName":"Wei","name":"Wei, Zhipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingjing","familyName":"Chen","name":"Chen, Jingjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Gang","familyName":"Jiang","name":"Jiang, Yu-Gang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VCE: Safe Autoregressive Image Generation via Visual Contrast Exploitation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T09:00:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:50:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-22T06:42:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-25T01:23:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recently, autoregressive image generation models have wowed audiences with their remarkable capability in creating surprisingly realistic images. Models such as GPT-4o and LlamaGen can not only produce images that faithfully mimic renowned artistic styles like Ghibli, Van Gogh, or Picasso, but also potentially generate Not-Safe-For-Work (NSFW) content, raising significant concerns regarding copyright infringement and ethical use. Despite these concerns, methods to safeguard autoregressive text-to-image models remain underexplored. Previous concept erasure methods, primarily designed for diffusion models that operate in denoising latent space, are not directly applicable to autoregressive models that generate images token by token. To address this critical gap, we propose Visual Contrast Exploitation (VCE), a novel framework comprising: (1) an innovative contrastive image pair construction paradigm that precisely decouples unsafe concepts from their associated content semantics, and (2) a sophisticated DPO-based training approach that enhances the model's ability to identify and leverage visual contrastive features from image pairs, enabling precise concept erasure. Our comprehensive experiments across three challenging tasks-artist style erasure, explicit content erasure, and object removal-demonstrate that our method effectively secures the model, achieving state-of-the-art results while erasing unsafe concepts and maintaining the integrity of unrelated safe concepts. The code and models are available at https://github.com/Maplebb/VCE."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16986","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:01:19Z","registered":"2025-09-23T03:01:19Z","published":null,"updated":"2025-11-25T04:49:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17238","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17238","identifiers":[{"identifier":"2509.17238","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Soheil","familyName":"Zibakhsh","name":"Zibakhsh, Soheil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad","familyName":"Samragh","name":"Samragh, Mohammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kumari","familyName":"Nishu","name":"Nishu, Kumari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lauren","familyName":"Hannah","name":"Hannah, Lauren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arnav","familyName":"Kundu","name":"Kundu, Arnav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minsik","familyName":"Cho","name":"Cho, Minsik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MoEs Are Stronger than You Think: Hyper-Parallel Inference Scaling with RoE"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T21:05:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:04:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T16:48:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-15T00:01:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The generation quality of large language models (LLMs) is often improved by utilizing inference-time sequence-level scaling methods (e.g., Chain-of-Thought). We introduce hyper-parallel scaling, a complementary framework that improves prediction quality at the token level. Hyper-parallel scaling computes and aggregates multiple output proposals for a single token from the model. We implement this concept in Mixture-of-Experts (MoE) models, which we refer to as Roster of Experts (RoE). RoE is a training-free inference algorithm that turns a single MoE into a dynamic ensemble of MoEs. RoE injects controlled stochasticity into the expert routing mechanism, enabling it to sample multiple diverse experts for each token and aggregate their outputs for a more accurate final prediction. To overcome the computational cost, we introduce an efficient batching strategy and a specialized KV-caching mechanism that minimizes compute and memory overhead. For example, RoE enables a 7B MoE model to match the performance of a 10.5B MoE model while using 30% less compute for inference. These gains are achieved without any fine-tuning of model parameters."},{"descriptionType":"Other","description":"Corrected typo in arxiv abstract"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17238","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:07:17Z","registered":"2025-09-23T03:07:18Z","published":null,"updated":"2025-10-15T02:21:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16360","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16360","identifiers":[{"identifier":"2509.16360","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weikang","familyName":"Qiu","name":"Qiu, Weikang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tinglin","familyName":"Huang","name":"Huang, Tinglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Rullo","name":"Rullo, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yucheng","familyName":"Kuang","name":"Kuang, Yucheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Maatouk","name":"Maatouk, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. Raquel","familyName":"Ramos","name":"Ramos, S. Raquel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rex","familyName":"Ying","name":"Ying, Rex","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RephQA: Evaluating Readability of Large Language Models in Public Health Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T19:09:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:04:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T00:51:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:14:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) hold promise in addressing complex medical problems. However, while most prior studies focus on improving accuracy and reasoning abilities, a significant bottleneck in developing effective healthcare agents lies in the readability of LLM-generated responses, specifically, their ability to answer public health problems clearly and simply to people without medical backgrounds. In this work, we introduce RephQA, a benchmark for evaluating the readability of LLMs in public health question answering (QA). It contains 533 expert-reviewed QA pairs from 27 sources across 13 topics, and includes a proxy multiple-choice task to assess informativeness, along with two readability metrics: Flesch-Kincaid grade level and professional score. Evaluation of 25 LLMs reveals that most fail to meet readability standards, highlighting a gap between reasoning and effective communication. To address this, we explore four readability-enhancing strategies-standard prompting, chain-of-thought prompting, Group Relative Policy Optimization (GRPO), and a token-adapted variant. Token-adapted GRPO achieves the best results, advancing the development of more practical and user-friendly public health agents. These results represent a step toward building more practical agents for public health."},{"descriptionType":"Other","description":"ACM KDD Health Track 2025 Blue Sky Best Paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16360","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:46:37Z","registered":"2025-09-23T02:46:37Z","published":null,"updated":"2025-10-06T02:01:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18056","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18056","identifiers":[{"identifier":"2509.18056","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunheng","familyName":"Li","name":"Li, Yunheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Cheng","name":"Cheng, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoyong","familyName":"Jia","name":"Jia, Shaoyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangyi","familyName":"Kuang","name":"Kuang, Hangyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaohui","familyName":"Jiao","name":"Jiao, Shaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qibin","familyName":"Hou","name":"Hou, Qibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming-Ming","familyName":"Cheng","name":"Cheng, Ming-Ming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TempSamp-R1: Effective Temporal Sampling with Reinforcement Fine-Tuning for Video LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:30:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:49:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T14:28:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:53:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper introduces TempSamp-R1, a new reinforcement fine-tuning framework designed to improve the effectiveness of adapting multimodal large language models (MLLMs) to video temporal grounding tasks. We reveal that existing reinforcement learning methods, such as Group Relative Policy Optimization (GRPO), rely on on-policy sampling for policy updates. However, in tasks with large temporal search spaces, this strategy becomes both inefficient and limited in performance, as it often fails to identify temporally accurate solutions. To address this limitation, TempSamp-R1 leverages ground-truth annotations as off-policy supervision to provide temporally precise guidance, effectively compensating for the sparsity and misalignment in on-policy solutions. To further stabilize training and reduce variance in reward-based updates, TempSamp-R1 provides a non-linear soft advantage computation method that dynamically reshapes the reward feedback via an asymmetric transformation. By employing a hybrid Chain-of-Thought (CoT) training paradigm, TempSamp-R1 optimizes a single unified model to support both CoT and non-CoT inference modes, enabling efficient handling of queries with varying reasoning complexity. Experimental results demonstrate that TempSamp-R1 outperforms GRPO-based baselines, establishing new state-of-the-art performance on benchmark datasets: Charades-STA (R1@0.7: 52.9%, +2.7%), ActivityNet Captions (R1@0.5: 56.0%, +5.3%), and QVHighlights (mAP: 30.0%, +3.0%). Moreover, TempSamp-R1 shows robust few-shot generalization capabilities under limited data. Code: https://github.com/HVision-NKU/TempSamp-R1"},{"descriptionType":"Other","description":"Accepted at NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18056","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:26:34Z","registered":"2025-09-23T03:26:35Z","published":null,"updated":"2025-09-26T02:16:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17993","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17993","identifiers":[{"identifier":"2509.17993","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoxin","familyName":"Yang","name":"Yang, Haoxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bangzhen","familyName":"Liu","name":"Liu, Bangzhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuemiao","familyName":"Xu","name":"Xu, Xuemiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Xu","name":"Xu, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Yu","name":"Yu, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zikai","familyName":"Huang","name":"Huang, Zikai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Wang","name":"Wang, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengfeng","familyName":"He","name":"He, Shengfeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"StableGuard: Towards Unified Copyright Protection and Tamper Localization in Latent Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:35:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:46:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T13:36:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:52:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The advancement of diffusion models has enhanced the realism of AI-generated content but also raised concerns about misuse, necessitating robust copyright protection and tampering localization. Although recent methods have made progress toward unified solutions, their reliance on post hoc processing introduces considerable application inconvenience and compromises forensic reliability. We propose StableGuard, a novel framework that seamlessly integrates a binary watermark into the diffusion generation process, ensuring copyright protection and tampering localization in Latent Diffusion Models through an end-to-end design. We develop a Multiplexing Watermark VAE (MPW-VAE) by equipping a pretrained Variational Autoencoder (VAE) with a lightweight latent residual-based adapter, enabling the generation of paired watermarked and watermark-free images. These pairs, fused via random masks, create a diverse dataset for training a tampering-agnostic forensic network. To further enhance forensic synergy, we introduce a Mixture-of-Experts Guided Forensic Network (MoE-GFN) that dynamically integrates holistic watermark patterns, local tampering traces, and frequency-domain cues for precise watermark verification and tampered region detection. The MPW-VAE and MoE-GFN are jointly optimized in a self-supervised, end-to-end manner, fostering a reciprocal training between watermark embedding and forensic accuracy. Extensive experiments demonstrate that StableGuard consistently outperforms state-of-the-art methods in image fidelity, watermark verification, and tampering localization."},{"descriptionType":"Other","description":"Accepted by NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17993","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:25:06Z","registered":"2025-09-23T03:25:07Z","published":null,"updated":"2025-09-24T02:40:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17894","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17894","identifiers":[{"identifier":"2509.17894","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siu Hang","familyName":"Ho","name":"Ho, Siu Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prasad","familyName":"Ganesan","name":"Ganesan, Prasad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nguyen","familyName":"Duong","name":"Duong, Nguyen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Schlabig","name":"Schlabig, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimizing Inference in Transformer-Based Models: A Multi-Method Benchmark"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.5.1","lang":"en","subjectScheme":"ACM"},{"subject":"68T07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-22T15:25:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:41:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T05:20:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:31:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Efficient inference is a critical challenge in deep generative modeling, particularly as diffusion models grow in capacity and complexity. While increased complexity often improves accuracy, it raises compute costs, latency, and memory requirements. This work investigates techniques such as pruning, quantization, knowledge distillation, and simplified attention to reduce computational overhead without impacting performance. The study also explores the Mixture of Experts (MoE) approach to further enhance efficiency. These experiments provide insights into optimizing inference for the state-of-the-art Fast Diffusion Transformer (fast-DiT) model."},{"descriptionType":"Other","description":"6 pages, 4 figures. Technical report"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17894","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:22:46Z","registered":"2025-09-23T03:22:47Z","published":null,"updated":"2025-09-24T02:40:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18093","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18093","identifiers":[{"identifier":"2509.18093","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"William","familyName":"Fleshman","name":"Fleshman, William","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Benjamin","familyName":"Van Durme","name":"Van Durme, Benjamin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SEQR: Secure and Efficient QR-based LoRA Routing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:59:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:51:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Low-Rank Adaptation (LoRA) has become a standard technique for parameter-efficient fine-tuning of large language models, enabling large libraries of LoRAs, each for a specific task or domain. Efficiently selecting the correct LoRA adapter for a given input remains a challenge, particularly in secure environments where supervised training of routers may raise privacy concerns. Motivated by previous approaches, we formalize the goal of unsupervised LoRA routing in terms of activation norm maximization, providing a theoretical framework for analysis. We demonstrate the discriminative power of activation norms and introduce SEQR, an unsupervised LoRA routing algorithm designed to maximize efficiency while providing strict routing guarantees. SEQR provably identifies the norm-maximizing adapter with significantly greater efficiency, making it a highly scalable and effective solution for dynamic LoRA composition. We validate our results through experiments that demonstrate improved multi-task performance and efficiency."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18093","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:27:25Z","registered":"2025-09-23T03:27:26Z","published":null,"updated":"2025-09-23T03:27:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18005","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18005","identifiers":[{"identifier":"2509.18005","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","affiliation":["School of Software Northwestern Polytechnical University"],"givenName":"Yanxin","familyName":"Zhang","name":"Zhang, Yanxin","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Software Northwestern Polytechnical University"],"givenName":"Liang","familyName":"He","name":"He, Liang","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Software Northwestern Polytechnical University"],"givenName":"Zeyi","familyName":"Kang","name":"Kang, Zeyi","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["Laboratoire L2Tl University Sorbonne Paris Nord"],"givenName":"Zuheng","familyName":"Ming","name":"Ming, Zuheng","nameIdentifiers":[]},{"nameType":"Personal","affiliation":["School of Software Yangtze River Delta Research Institute"],"givenName":"Kaixing","familyName":"Zhao","name":"Zhao, Kaixing","nameIdentifiers":[]}],"titles":[{"title":"M3ET: Efficient Vision-Language Learning for Robotics based on Multimodal Mamba-Enhanced Transformer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:44:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:47:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In recent years, multimodal learning has become essential in robotic vision and information fusion, especially for understanding human behavior in complex environments. However, current methods struggle to fully leverage the textual modality, relying on supervised pretrained models, which limits semantic extraction in unsupervised robotic environments, particularly with significant modality loss. These methods also tend to be computationally intensive, leading to high resource consumption in real-world applications. To address these challenges, we propose the Multi Modal Mamba Enhanced Transformer (M3ET), a lightweight model designed for efficient multimodal learning, particularly on mobile platforms. By incorporating the Mamba module and a semantic-based adaptive attention mechanism, M3ET optimizes feature fusion, alignment, and modality reconstruction. Our experiments show that M3ET improves cross-task performance, with a 2.3 times increase in pretraining inference speed. In particular, the core VQA task accuracy of M3ET remains at 0.74, while the model's parameter count is reduced by 0.67. Although performance on the EQA task is limited, M3ET's lightweight design makes it well suited for deployment on resource-constrained robotic platforms."},{"descriptionType":"Other","description":"8 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18005","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:25:23Z","registered":"2025-09-23T03:25:23Z","published":null,"updated":"2025-09-23T03:25:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17940","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17940","identifiers":[{"identifier":"2509.17940","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuyao","familyName":"Shang","name":"Shang, Shuyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuntao","familyName":"Chen","name":"Chen, Yuntao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Wang","name":"Wang, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingyan","familyName":"Li","name":"Li, Yingyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaoxiang","familyName":"Zhang","name":"Zhang, Zhaoxiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DriveDPO: Policy Learning via Safety DPO For End-to-End Autonomous Driving"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:01:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:44:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"End-to-end autonomous driving has substantially progressed by directly predicting future trajectories from raw perception inputs, which bypasses traditional modular pipelines. However, mainstream methods trained via imitation learning suffer from critical safety limitations, as they fail to distinguish between trajectories that appear human-like but are potentially unsafe. Some recent approaches attempt to address this by regressing multiple rule-driven scores but decoupling supervision from policy optimization, resulting in suboptimal performance. To tackle these challenges, we propose DriveDPO, a Safety Direct Preference Optimization Policy Learning framework. First, we distill a unified policy distribution from human imitation similarity and rule-based safety scores for direct policy optimization. Further, we introduce an iterative Direct Preference Optimization stage formulated as trajectory-level preference alignment. Extensive experiments on the NAVSIM benchmark demonstrate that DriveDPO achieves a new state-of-the-art PDMS of 90.0. Furthermore, qualitative results across diverse challenging scenarios highlight DriveDPO's ability to produce safer and more reliable driving behaviors."},{"descriptionType":"Other","description":"NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17940","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:23:51Z","registered":"2025-09-23T03:23:51Z","published":null,"updated":"2025-09-23T03:23:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17806","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17806","identifiers":[{"identifier":"2509.17806","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Beatrice","familyName":"Cantoni","name":"Cantoni, Beatrice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Savannah V.","familyName":"Rauschendorfer","name":"Rauschendorfer, Savannah V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael E.","familyName":"Roth","name":"Roth, Michael E.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"J. Andrew","familyName":"Livingston","name":"Livingston, J. Andrew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eugenie S.","familyName":"Kleinerman","name":"Kleinerman, Eugenie S.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Corwin M.","familyName":"Zigler","name":"Zigler, Corwin M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Bayesian Nonhomogeneous hidden Markov models to leverage routine in physical activity monitoring with informative wear time"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Applications (stat.AP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:01:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:36:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Missing data is among the most prominent challenges in the analysis of physical activity (PA) data collected from wearable devices, with the threat of nonignorabile missingness arising when patterns of device wear relate to underlying activity patterns. We offer a rigorous consideration of assumptions about missing data mechanisms in the context of the common modeling paradigm of state space models with a finite, meaningful, set of underlying PA states. Focusing in particular on hidden Markov models, we identify inherent limitations in the presence of missing data when covariates are required to satisfy common missing data assumptions. In response to this limitation, we propose a Bayesian non-homogeneous state space model that can accommodate covariate dependence in the transitions between latent activity states, which in this case relates to whether patients' routine behavior can inform how they transition between PA states and thus support imputation of missing PA data. We show the benefits of the proposed model for missing data imputation and inference for relevant PA summaries. Our development advances analytic capacity to confront the ubiquitous challenge of missing data when analyzing PA studies using wearables. We illustrate with the analysis of a cohort of adolescent and young adult (AYA) cancer patients who wore commercial Fitbit devices for varying durations during the course of treatment."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17806","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:20:42Z","registered":"2025-09-23T03:20:43Z","published":null,"updated":"2025-09-23T03:20:43Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17711","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17711","identifiers":[{"identifier":"2509.17711","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shenwei","familyName":"Kang","name":"Kang, Shenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Zhang","name":"Zhang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wen","familyName":"Liu","name":"Liu, Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Li","name":"Li, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujie","familyName":"Liu","name":"Liu, Yujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Gao","name":"Gao, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DA-Mamba: Dialogue-aware selective state-space model for multimodal engagement estimation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:48:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:30:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Human engagement estimation in conversational scenarios is essential for applications such as adaptive tutoring, remote healthcare assessment, and socially aware human--computer interaction. Engagement is a dynamic, multimodal signal conveyed by facial expressions, speech, gestures, and behavioral cues over time. In this work we introduce DA-Mamba, a dialogue-aware multimodal architecture that replaces attention-heavy dialogue encoders with Mamba-based selective state-space processing to achieve linear time and memory complexity while retaining expressive cross-modal reasoning. We design a Mamba dialogue-aware selective state-space model composed of three core modules: a Dialogue-Aware Encoder, and two Mamba-based fusion mechanisms: Modality-Group Fusion and Partner-Group Fusion, these modules achieve expressive dialogue understanding. Extensive experiments on three standard benchmarks (NoXi, NoXi-Add, and MPIIGI) show that DA-Mamba surpasses prior state-of-the-art (SOTA) methods in concordance correlation coefficient (CCC), while reducing training time and peak memory; these gains enable processing much longer sequences and facilitate real-time deployment in resource-constrained, multi-party conversational settings. The source code will be available at: https://github.com/kksssssss-ssda/MMEA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17711","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:18:28Z","registered":"2025-09-23T03:18:29Z","published":null,"updated":"2025-09-23T03:18:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17651","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17651","identifiers":[{"identifier":"2509.17651","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Filippo","familyName":"Botti","name":"Botti, Filippo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Ergasti","name":"Ergasti, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomaso","familyName":"Fontanini","name":"Fontanini, Tomaso","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claudio","familyName":"Ferrari","name":"Ferrari, Claudio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Massimo","familyName":"Bertozzi","name":"Bertozzi, Massimo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Prati","name":"Prati, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SISMA: Semantic Face Image Synthesis with Mamba"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:55:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:26:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion Models have become very popular for Semantic Image Synthesis (SIS) of human faces. Nevertheless, their training and inference is computationally expensive and their computational requirements are high due to the quadratic complexity of attention layers. In this paper, we propose a novel architecture called SISMA, based on the recently proposed Mamba. SISMA generates high quality samples by controlling their shape using a semantic mask at a reduced computational demand. We validated our approach through comprehensive experiments with CelebAMask-HQ, revealing that our architecture not only achieves a better FID score yet also operates at three times the speed of state-of-the-art architectures. This indicates that the proposed design is a viable, lightweight substitute to transformer-based models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17651","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:17:03Z","registered":"2025-09-23T03:17:03Z","published":null,"updated":"2025-09-23T03:17:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17589","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17589","identifiers":[{"identifier":"2509.17589","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jun","familyName":"Ling","name":"Ling, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Qi","name":"Qi, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Huang","name":"Huang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shibo","familyName":"Zhou","name":"Zhou, Shibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanqin","familyName":"Huang","name":"Huang, Yanqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiang","familyName":"Yang","name":"Yang, Jiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Song","name":"Song, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Zhou","name":"Zhou, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Yang","name":"Yang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng Tao","familyName":"Shen","name":"Shen, Heng Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Table2LaTeX-RL: High-Fidelity LaTeX Code Generation from Table Images via Reinforced Multimodal Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:13:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:23:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, we address the task of table image to LaTeX code generation, with the goal of automating the reconstruction of high-quality, publication-ready tables from visual inputs. A central challenge of this task lies in accurately handling complex tables -- those with large sizes, deeply nested structures, and semantically rich or irregular cell content -- where existing methods often fail. We begin with a comprehensive analysis, identifying key challenges and highlighting the limitations of current evaluation protocols. To overcome these issues, we propose a reinforced multimodal large language model (MLLM) framework, where a pre-trained MLLM is fine-tuned on a large-scale table-to-LaTeX dataset. To further improve generation quality, we introduce a dual-reward reinforcement learning strategy based on Group Relative Policy Optimization (GRPO). Unlike standard approaches that optimize purely over text outputs, our method incorporates both a structure-level reward on LaTeX code and a visual fidelity reward computed from rendered outputs, enabling direct optimization of the visual output quality. We adopt a hybrid evaluation protocol combining TEDS-Structure and CW-SSIM, and show that our method achieves state-of-the-art performance, particularly on structurally complex tables, demonstrating the effectiveness and robustness of our approach."},{"descriptionType":"Other","description":"NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17589","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:15:36Z","registered":"2025-09-23T03:15:37Z","published":null,"updated":"2025-09-23T03:15:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17397","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17397","identifiers":[{"identifier":"2509.17397","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaqi","familyName":"Zhu","name":"Zhu, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shouyi","familyName":"Lu","name":"Lu, Shouyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyao","familyName":"Li","name":"Li, Ziyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guirong","familyName":"Zhuo","name":"Zhuo, Guirong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Xiong","name":"Xiong, Lu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diff-GNSS: Diffusion-based Pseudorange Error Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T06:57:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:13:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Global Navigation Satellite Systems (GNSS) are vital for reliable urban positioning. However, multipath and non-line-of-sight reception often introduce large measurement errors that degrade accuracy. Learning-based methods for predicting and compensating pseudorange errors have gained traction, but their performance is limited by complex error distributions. To address this challenge, we propose Diff-GNSS, a coarse-to-fine GNSS measurement (pseudorange) error estimation framework that leverages a conditional diffusion model to capture such complex distributions. Firstly, a Mamba-based module performs coarse estimation to provide an initial prediction with appropriate scale and trend. Then, a conditional denoising diffusion layer refines the estimate, enabling fine-grained modeling of pseudorange errors. To suppress uncontrolled generative diversity and achieve controllable synthesis, three key features related to GNSS measurement quality are used as conditions to precisely guide the reverse denoising process. We further incorporate per-satellite uncertainty modeling within the diffusion stage to assess the reliability of the predicted errors. We have collected and publicly released a real-world dataset covering various scenes. Experiments on public and self-collected datasets show that DiffGNSS consistently outperforms state-of-the-art baselines across multiple metrics. To the best of our knowledge, this is the first application of diffusion models to pseudorange error estimation. The proposed diffusion-based refinement module is plug-and-play and can be readily integrated into existing networks to markedly improve estimation accuracy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17397","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:01Z","registered":"2025-09-23T03:11:02Z","published":null,"updated":"2025-09-23T03:11:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":41,"totalPages":2,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28MoE+OR+MoEs+OR+PEFT+OR+DPO+OR+GRPO+OR+MLA+OR+SSM+OR+SSMs+OR+Mamba+OR+%22low-rank+adaptation%22+OR+%22low+rank+adaptation%22+OR+%22parameter-efficient%22+OR+%22parameter+efficient%22+OR+%22direct+preference+optimization%22+OR+%22group+relative+policy+optimization%22+OR+%22multi-head+latent+attention%22+OR+%22multihead+latent+attention%22+OR+%22state-space%22+OR+%22state+space%22%29+OR+descriptions.description%3A%28MoE+OR+MoEs+OR+PEFT+OR+DPO+OR+GRPO+OR+MLA+OR+SSM+OR+SSMs+OR+Mamba+OR+%22low-rank+adaptation%22+OR+%22low+rank+adaptation%22+OR+%22parameter-efficient%22+OR+%22parameter+efficient%22+OR+%22direct+preference+optimization%22+OR+%22group+relative+policy+optimization%22+OR+%22multi-head+latent+attention%22+OR+%22multihead+latent+attention%22+OR+%22state-space%22+OR+%22state+space%22%29%29+AND+%28titles.title%3A%28neural+OR+learning+OR+training+OR+inference+OR+transformer+OR+transformers+OR+LLM+OR+LLMs%29+OR+descriptions.description%3A%28neural+OR+learning+OR+training+OR+inference+OR+transformer+OR+transformers+OR+LLM+OR+LLMs%29%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=2\u0026page%5Bsize%5D=25\u0026query=registered