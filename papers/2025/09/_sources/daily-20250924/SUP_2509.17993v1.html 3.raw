<td id="S4.T1.6.1.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">FID↓</td>
<td id="S4.T1.6.1.2.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">Bit Acc↑</td></tr>
<tr id="S4.T1.6.1.3" class="ltx_tr">
<td id="S4.T1.6.1.3.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">HiDDeN <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite></td>
<td id="S4.T1.6.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">32</td>
<td id="S4.T1.6.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">31.95</td>
<td id="S4.T1.6.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0.879</td>
<td id="S4.T1.6.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0.104</td>
<td id="S4.T1.6.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">20.0</td>
<td id="S4.T1.6.1.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">98.80</td>
<td id="S4.T1.6.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">32.03</td>
<td id="S4.T1.6.1.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0.881</td>
<td id="S4.T1.6.1.3.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">0.101</td>
<td id="S4.T1.6.1.3.11" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;">19.9</td>
