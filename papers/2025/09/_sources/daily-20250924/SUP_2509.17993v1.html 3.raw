<td id="S4.T1.6.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;" rowspan="2"><span id="S4.T1.6.1.1.2.1" class="ltx_text">B.L.</span></td>
<td id="S4.T1.6.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;" colspan="5">COCO Dataset <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib56" title="" class="ltx_ref">56</a>]</cite></td>
<td id="S4.T1.6.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1pt;padding-bottom:1pt;" colspan="5">T2I-Dataset</td></tr>
