<td id="S2.T3.17.10.1" class="ltx_td ltx_align_left ltx_border_r"><span id="S2.T3.17.10.1.1" class="ltx_text" style="font-size:80%;">Memory Registration</span></td>
<td id="S2.T3.17.10.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S2.T3.17.10.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">N/A</span></td>
<td id="S2.T3.17.10.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S2.T3.17.10.3.1" class="ltx_text" style="font-size:80%;">Basic</span></td>
