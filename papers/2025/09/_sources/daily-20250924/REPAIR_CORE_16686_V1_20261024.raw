<td id="Sx5.T6.1.1.3.4" class="ltx_td ltx_align_center">86743</td>
<td id="Sx5.T6.1.1.3.5" class="ltx_td ltx_align_center">188.88</td>
<td id="Sx5.T6.1.1.3.6" class="ltx_td ltx_align_center">16.25</td></tr>
<tr id="Sx5.T6.1.1.4" class="ltx_tr">
<td id="Sx5.T6.1.1.4.1" class="ltx_td ltx_align_center">vanilla</td>
