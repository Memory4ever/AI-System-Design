<td id="S3.T3.5.1.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="S3.T3.5.1.1.2.1" class="ltx_text ltx_font_bold">Task</span></td>
<td id="S3.T3.5.1.1.3" class="ltx_td ltx_align_left ltx_border_tt"><span id="S3.T3.5.1.1.3.1" class="ltx_text ltx_font_bold">Split</span></td>
<td id="S3.T3.5.1.1.4" class="ltx_td ltx_align_right ltx_border_tt"><span id="S3.T3.5.1.1.4.1" class="ltx_text ltx_font_bold"># Training Samples</span></td>
