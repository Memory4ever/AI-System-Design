<td id="S5.T6.5.1.20.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T6.5.1.20.3.1" class="ltx_text" style="--ltx-bg-color:#E0E0FF;">29.15</span></td>
<td id="S5.T6.5.1.20.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T6.5.1.20.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E0E0FF;">88.40</span></td>
