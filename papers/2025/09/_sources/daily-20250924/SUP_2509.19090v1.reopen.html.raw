<td id="S5.T7.5.1.21.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T7.5.1.21.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E0E0FF;">90.01</span></td>
<td id="S5.T7.5.1.21.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T7.5.1.21.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E0E0FF;">96.29</span></td>
<td id="S5.T7.5.1.21.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T7.5.1.21.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E0E0FF;">87.99</span></td>
<td id="S5.T7.5.1.21.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T7.5.1.21.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E0E0FF;">83.08</span></td>
