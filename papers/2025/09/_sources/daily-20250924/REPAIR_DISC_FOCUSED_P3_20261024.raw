{"data":[{"id":"10.48550/arxiv.2509.16445","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16445","identifiers":[{"identifier":"2509.16445","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Naoki","familyName":"Yokoyama","name":"Yokoyama, Naoki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sehoon","familyName":"Ha","name":"Ha, Sehoon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FiLM-Nav: Efficient and Generalizable Navigation via VLM Fine-tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T21:51:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:10:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-15T00:41:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-16T00:18:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Enabling robotic assistants to navigate complex environments and locate objects described in free-form language is a critical capability for real-world deployment. While foundation models, particularly Vision-Language Models (VLMs), offer powerful semantic understanding, effectively adapting their web-scale knowledge for embodied decision-making remains a key challenge. We present FiLM-Nav (Fine-tuned Language Model for Navigation), an approach that directly fine-tunes pre-trained VLM as the navigation policy. In contrast to methods that use foundation models primarily in a zero-shot manner or for map annotation, FiLM-Nav learns to select the next best exploration frontier by conditioning directly on raw visual trajectory history and the navigation goal. Leveraging targeted simulated embodied experience allows the VLM to ground its powerful pre-trained representations in the specific dynamics and visual patterns relevant to goal-driven navigation. Critically, fine-tuning on a diverse data mixture combining ObjectNav, OVON, ImageNav, and an auxiliary spatial reasoning task proves essential for achieving robustness and broad generalization. FiLM-Nav sets a new state-of-the-art in both SPL and success rate on HM3D ObjectNav among open-vocabulary methods, and sets a state-of-the-art SPL on the challenging HM3D-OVON benchmark, demonstrating strong generalization to unseen object categories. Our work validates that directly fine-tuning VLMs on diverse simulated embodied data is a highly effective pathway towards generalizable and efficient semantic navigation capabilities."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16445","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:34Z","registered":"2025-09-23T02:48:35Z","published":null,"updated":"2026-04-16T02:18:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17995","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17995","identifiers":[{"identifier":"2509.17995","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yefan","familyName":"Zhou","name":"Zhou, Yefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Austin","familyName":"Xu","name":"Xu, Austin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilun","familyName":"Zhou","name":"Zhou, Yilun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Janvijay","familyName":"Singh","name":"Singh, Janvijay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiang","familyName":"Gui","name":"Gui, Jiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shafiq","familyName":"Joty","name":"Joty, Shafiq","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Variation in Verification: Understanding Verification Dynamics in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:36:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:46:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-14T03:25:43Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-15T00:22:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances have shown that scaling test-time computation enables large language models (LLMs) to solve increasingly complex problems across diverse domains. One effective paradigm for test-time scaling (TTS) involves LLM generators producing multiple solution candidates, with LLM verifiers assessing the correctness of these candidates without reference answers. In this paper, we study generative verifiers, which perform verification by generating chain-of-thought (CoT) reasoning followed by a binary verdict. We systematically analyze verification dynamics across three dimensions - problem difficulty, generator capability, and verifier generation capability - with empirical studies on 12 benchmarks across mathematical reasoning, knowledge, and natural language reasoning tasks using 14 open-source models (2B to 72B parameter range) and GPT-4o. Our experiments reveal three key findings about verification effectiveness: (1) Easy problems allow verifiers to more reliably certify correct responses; (2) Weak generators produce errors that are easier to detect than strong generators; (3) Verification ability is generally correlated with the verifier's own problem-solving capability, but this relationship varies with problem difficulty. These findings reveal opportunities to optimize basic verification strategies in TTS applications. First, given the same verifier, some weak generators can nearly match stronger ones in post-verification TTS performance (e.g., the Gemma2-9B to Gemma2-27B performance gap shrinks by 75.7%). Second, we identify cases where strong verifiers offer limited advantage over weak ones, as both fail to provide meaningful verification gains, suggesting that verifier scaling alone cannot overcome fundamental verification challenges."},{"descriptionType":"Other","description":"ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17995","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:25:09Z","registered":"2025-09-23T03:25:10Z","published":null,"updated":"2026-04-15T02:23:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16806","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16806","identifiers":[{"identifier":"2509.16806","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kacper","familyName":"Marzol","name":"Marzol, Kacper","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ignacy","familyName":"Kolton","name":"Kolton, Ignacy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weronika","familyName":"Smolak-Dyżewska","name":"Smolak-Dyżewska, Weronika","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Joanna","familyName":"Kaleta","name":"Kaleta, Joanna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Żaneta","familyName":"Świderska-Chadaj","name":"Świderska-Chadaj, Żaneta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Marcin","familyName":"Mazur","name":"Mazur, Marcin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mirosław","familyName":"Dziekiewicz","name":"Dziekiewicz, Mirosław","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomasz","familyName":"Markiewicz","name":"Markiewicz, Tomasz","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Przemysław","familyName":"Spurek","name":"Spurek, Przemysław","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MedGS: Gaussian Splatting for Multi-Modal 3D Medical Imaging"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T20:52:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:39:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-03T08:35:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-06T00:31:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-06T08:36:17Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-07T01:19:43Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-04-14T14:25:32Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-04-15T00:57:37Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Endoluminal endoscopic procedures are essential for diagnosing colorectal cancer and other severe conditions in the digestive tract, urogenital system, and airways. 3D reconstruction and novel-view synthesis from endoscopic images are promising tools for enhancing diagnosis. Moreover, integrating physiological deformations and interaction with the endoscope enables the development of simulation tools from real video data. However, constrained camera trajectories and view-dependent lighting create artifacts, leading to inaccurate or overfitted reconstructions. We present MedGS, a novel 3D reconstruction framework leveraging the unique property of endoscopic imaging, where a single light source is closely aligned with the camera. Our method separates light effects from tissue properties. MedGS enhances 3D Gaussian Splatting with a physically based relightable model. We boost the traditional light transport formulation with a specialized MLP capturing complex light-related effects while ensuring reduced artifacts and better generalization across novel views. MedGS achieves superior reconstruction quality compared to baseline methods on both public and in-house datasets. Unlike existing approaches, MedGS enables tissue modifications while preserving a physically accurate response to light, making it closer to real-world clinical use. Repository: https://github.com/gmum/MedGS"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16806","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:57:01Z","registered":"2025-09-23T02:57:02Z","published":null,"updated":"2026-04-15T02:23:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17183","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17183","identifiers":[{"identifier":"2509.17183","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junsong","familyName":"Li","name":"Li, Junsong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Zhou","name":"Zhou, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bihao","familyName":"Zhan","name":"Zhan, Bihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutao","familyName":"Yang","name":"Yang, Yutao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianjun","familyName":"Pan","name":"Pan, Qianjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shilian","familyName":"Chen","name":"Chen, Shilian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Huai","name":"Huai, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Li","name":"Li, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qin","familyName":"Chen","name":"Chen, Qin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"He","name":"He, Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LifeAlign: Lifelong Alignment for Large Language Models with Memory-Augmented Focalized Preference Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T18:06:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:01:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-07T07:18:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-08T00:33:54Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04-08T01:32:04Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-04-09T00:17:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Alignment plays a crucial role in Large Language Models (LLMs) in aligning with human preferences on a specific task/domain. Traditional alignment methods suffer from catastrophic forgetting, where models lose previously acquired knowledge when adapting to new preferences or domains. We introduce LifeAlign, a novel framework for lifelong alignment that enables LLMs to maintain consistent human preference alignment across sequential learning tasks without forgetting previously learned knowledge. Our approach consists of two key innovations. First, we propose a focalized preference optimization strategy that aligns LLMs with new preferences while preventing the erosion of knowledge acquired from previous tasks. Second, we develop a short-to-long memory consolidation mechanism that merges denoised short-term preference representations into stable long-term memory using intrinsic dimensionality reduction, enabling efficient storage and retrieval of alignment patterns across diverse domains. We evaluate LifeAlign across multiple sequential alignment tasks spanning different domains and preference types. Experimental results demonstrate that our method achieves superior performance in maintaining both preference alignment quality and knowledge retention compared to existing lifelong learning approaches. The codes and datasets have been released on https://github.com/real-ljs/LifeAlign."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17183","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:05:59Z","registered":"2025-09-23T03:06:00Z","published":null,"updated":"2026-04-09T02:18:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18095","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18095","identifiers":[{"identifier":"2509.18095","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zilin","familyName":"Xiao","name":"Xiao, Zilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Ma","name":"Ma, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mengting","familyName":"Gu","name":"Gu, Mengting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chun-cheng Jason","familyName":"Chen","name":"Chen, Chun-cheng Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xintao","familyName":"Chen","name":"Chen, Xintao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vicente","familyName":"Ordonez","name":"Ordonez, Vicente","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vijai","familyName":"Mohan","name":"Mohan, Vijai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MetaEmbed: Scaling Multimodal Retrieval at Test-Time with Flexible Late Interaction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:59:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:51:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-06T19:57:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-08T00:07:16Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Universal multimodal embedding models have achieved great success in capturing semantic relevance between queries and candidates. However, current methods either condense queries and candidates into a single vector, potentially limiting the expressiveness for fine-grained information, or produce too many vectors that are prohibitive for multi-vector retrieval. In this work, we introduce MetaEmbed, a new framework for multimodal retrieval that rethinks how multimodal embeddings are constructed and interacted with at scale. During training, a fixed number of learnable Meta Tokens are appended to the input sequence. At test-time, their last-layer contextualized representations serve as compact yet expressive multi-vector embeddings. Through the proposed Matryoshka Multi-Vector Retrieval training, MetaEmbed learns to organize information by granularity across multiple vectors. As a result, we enable test-time scaling in multimodal retrieval where users can balance retrieval quality against efficiency demands by selecting the number of tokens used for indexing and retrieval interactions. Extensive evaluations on the Massive Multimodal Embedding Benchmark (MMEB) and the Visual Document Retrieval Benchmark (ViDoRe) confirm that MetaEmbed achieves state-of-the-art retrieval performance while scaling robustly to models with 32B parameters. Code is available at https://github.com/facebookresearch/MetaEmbed."},{"descriptionType":"Other","description":"ICLR 2026 Oral"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18095","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:27:28Z","registered":"2025-09-23T03:27:29Z","published":null,"updated":"2026-04-08T02:30:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17766","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17766","identifiers":[{"identifier":"2509.17766","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ziyi","familyName":"Liu","name":"Liu, Ziyi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A State-Update Prompting Strategy for Efficient and Robust Multi-turn Dialogue"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:26:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:33:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04-07T13:32:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-08T00:56:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) struggle with information forgetting and inefficiency in long-horizon, multi-turn dialogues. To address this, we propose a training-free prompt engineering method, the State-Update Multi-turn Dialogue Strategy. It utilizes \"State Reconstruction\" and \"History Remind\" mechanisms to effectively manage dialogue history. Our strategy shows strong performance across multiple multi-hop QA datasets. For instance, on the HotpotQA dataset, it improves the core information filtering score by 32.6%, leading to a 14.1% increase in the downstream QA score, while also reducing inference time by 73.1% and token consumption by 59.4%. Ablation studies confirm the pivotal roles of both components. Our work offers an effective solution for optimizing LLMs in long-range interactions, providing new insights for developing more robust Agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17766","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:19:45Z","registered":"2025-09-23T03:19:46Z","published":null,"updated":"2026-04-08T02:30:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16483","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16483","identifiers":[{"identifier":"2509.16483","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xujia","familyName":"Zhang","name":"Zhang, Xujia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brendan","familyName":"Crowe","name":"Crowe, Brendan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christoffer","familyName":"Heckman","name":"Heckman, Christoffer","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Octree Diffusion for Semantic Scene Generation and Completion"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T00:53:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:12:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-31T22:13:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-04-02T00:12:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The completion, extension, and generation of 3D semantic scenes are an interrelated set of capabilities that are useful for robotic navigation and exploration. Existing approaches seek to decouple these problems and solve them one-off. Additionally, these approaches are often domain-specific, requiring separate models for different data distributions, e.g.\\ indoor vs.\\ outdoor scenes.\n To unify these techniques and provide cross-domain compatibility, we develop a single framework that can perform scene completion, extension, and generation in both indoor and outdoor scenes, which we term Octree Latent Semantic Diffusion. Our approach operates directly on an efficient dual octree graph latent representation: a hierarchical, sparse, and memory-efficient occupancy structure. This technique disentangles synthesis into two stages: (i) structure diffusion, which predicts binary split signals to construct a coarse occupancy octree, and (ii) latent semantic diffusion, which generates semantic embeddings decoded by a graph VAE into voxel-level semantic labels. To perform semantic scene completion or extension, our model leverages inference-time latent inpainting, or outpainting respectively. These inference-time methods use partial LiDAR scans or maps to condition generation, without the need for retraining or finetuning.\n We demonstrate high-quality structure, coherent semantics, and robust completion from single LiDAR scans, as well as zero-shot generalization to out-of-distribution LiDAR data. These results indicate that completion-through-generation in a dual octree graph latent space is a practical and scalable alternative to regression-based pipelines for real-world robotic perception tasks."},{"descriptionType":"Other","description":"Accepted to ICRA 2026. Revised version with updated paragraphs"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16483","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:49:28Z","registered":"2025-09-23T02:49:28Z","published":null,"updated":"2026-04-02T02:27:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16952","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16952","identifiers":[{"identifier":"2509.16952","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tiancheng","familyName":"Huang","name":"Huang, Tiancheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruisheng","familyName":"Cao","name":"Cao, Ruisheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxin","familyName":"Zhang","name":"Zhang, Yuxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhangyi","familyName":"Kang","name":"Kang, Zhangyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijian","familyName":"Wang","name":"Wang, Zijian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenrun","familyName":"Wang","name":"Wang, Chenrun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yijie","familyName":"Luo","name":"Luo, Yijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hang","familyName":"Zheng","name":"Zheng, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lirong","familyName":"Qian","name":"Qian, Lirong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Chen","name":"Chen, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Yu","name":"Yu, Kai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AirQA: A Comprehensive QA Dataset for AI Research with Instance-Level Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T07:24:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:48:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-30T06:47:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-31T01:23:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The growing volume of academic papers has made it increasingly difficult for researchers to efficiently extract key information. While large language models (LLMs) based agents are capable of automating question answering (QA) workflows for scientific papers, there still lacks a comprehensive and realistic benchmark to evaluate their capabilities. Moreover, training an interactive agent for this specific task is hindered by the shortage of high-quality interaction trajectories. In this work, we propose AirQA, a human-annotated comprehensive paper QA dataset in the field of artificial intelligence (AI), with 13,956 papers and 1,246 questions, that encompasses multi-task, multi-modal and instance-level evaluation. Furthermore, we propose ExTrActor, an automated framework for instruction data synthesis. With three LLM-based agents, ExTrActor can perform example generation and trajectory collection without human intervention. Evaluations of multiple open-source and proprietary models show that most models underperform on AirQA, demonstrating the quality of our dataset. Extensive experiments confirm that ExTrActor consistently improves the multi-turn tool-use capability of small models, enabling them to achieve performance comparable to larger ones."},{"descriptionType":"Other","description":"29 page, 6 figures, 17 tables, accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16952","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:00:30Z","registered":"2025-09-23T03:00:31Z","published":null,"updated":"2026-03-31T04:01:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16889","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16889","identifiers":[{"identifier":"2509.16889","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiaoqiang","familyName":"Kang","name":"Kang, Xiaoqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengen","familyName":"Wu","name":"Wu, Shengen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimu","familyName":"Wang","name":"Wang, Zimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilin","familyName":"Liu","name":"Liu, Yilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobo","familyName":"Jin","name":"Jin, Xiaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaizhu","familyName":"Huang","name":"Huang, Kaizhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wang","name":"Wang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutao","familyName":"Yue","name":"Yue, Yutao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaowei","familyName":"Huang","name":"Huang, Xiaowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiufeng","familyName":"Wang","name":"Wang, Qiufeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can GRPO Boost Complex Multimodal Table Understanding?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T02:51:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:44:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T02:52:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:25:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-26T02:16:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-27T00:22:01Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Existing table understanding methods face challenges due to complex table structures and intricate logical reasoning. While supervised finetuning (SFT) dominates existing research, reinforcement learning (RL), such as Group Relative Policy Optimization (GRPO), has shown promise but struggled with low initial policy accuracy and coarse rewards in tabular contexts. In this paper, we introduce Table-R1, a three-stage RL framework that enhances multimodal table understanding through: (1) Warm-up that prompts initial perception and reasoning capabilities, (2) Perception Alignment GRPO (PA-GRPO), which employs continuous Tree-Edit-Distance Similarity (TEDS) rewards for recognizing table structures and contents, and (3) Hint-Completion GRPO (HC-GRPO), which utilizes fine-grained rewards of residual steps based on the hint-guided question. Extensive experiments demonstrate that Table-R1 can boost the model's table reasoning performance obviously on both held-in and held-out datasets, outperforming SFT and GRPO largely. Notably, Qwen2-VL-7B with Table-R1 surpasses larger specific table understanding models (e.g., Table-LLaVA 13B), even achieving comparable performance to the closed-source model GPT-4o on held-in datasets, demonstrating the efficacy of each stage of Table-R1 in overcoming initialization bottlenecks and reward sparsity, thereby advancing robust multimodal table understanding."},{"descriptionType":"Other","description":"EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16889","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:58:58Z","registered":"2025-09-23T02:58:59Z","published":null,"updated":"2026-03-27T02:22:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17325","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17325","identifiers":[{"identifier":"2509.17325","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weihua","familyName":"Du","name":"Du, Weihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hailei","familyName":"Gong","name":"Gong, Hailei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhan","familyName":"Ling","name":"Ling, Zhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kang","familyName":"Liu","name":"Liu, Kang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingfeng","familyName":"Shen","name":"Shen, Lingfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuesong","familyName":"Yao","name":"Yao, Xuesong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufei","familyName":"Xu","name":"Xu, Yufei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dingyuan","familyName":"Shi","name":"Shi, Dingyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Yang","name":"Yang, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiecao","familyName":"Chen","name":"Chen, Jiecao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Generalizable End-to-End Tool-Use RL with Synthetic CodeGym"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T03:03:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:10:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-17T01:17:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-18T00:26:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tool-augmented large language models (LLMs), hereafter LLM agents, leverage external tools to solve diverse tasks and interface with the real world. However, current training practices largely rely on supervised fine-tuning (SFT) over static trajectories or reinforcement learning (RL) on narrow tasks, which generalize poorly beyond development settings and lead to brittleness with new tools and unseen workflows. Because code execution reflects many structural patterns of real-world workflows, we use coding problems as a structured substrate to build tool-use agent training environments with diverse task configurations. To this end, we introduce CodeGym, a scalable framework that synthesizes diverse, verifiable, and controllable multi-turn tool-use environments for agent RL, enabling LLM agents to explore and master various workflows actively. CodeGym converts static coding problems into interactive environments by extracting atomic functions or logic into callable tools, yielding verifiable tasks that span various tool-execution workflows. Models of varying sizes and chain-of-thought configurations trained in CodeGym exhibit consistent out-of-distribution generalizability; for example, Qwen2.5-32B-Instruct achieves an absolute accuracy gain of 8.7 points on the OOD benchmark $τ$-Bench. These results highlight CodeGym as a step toward scalable general-purpose RL environments for training tool-use behaviors that align with real-world agent workflows."},{"descriptionType":"Other","description":"24 pages. Accepted to ICLR 2026. Project repository: https://github.com/StigLidu/CodeGym"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17325","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:09:19Z","registered":"2025-09-23T03:09:20Z","published":null,"updated":"2026-03-18T02:48:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17374","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17374","identifiers":[{"identifier":"2509.17374","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ankit","familyName":"Yadav","name":"Yadav, Ankit","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ta Duc","familyName":"Huy","name":"Huy, Ta Duc","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingqiao","familyName":"Liu","name":"Liu, Lingqiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revisiting Vision Language Foundations for No-Reference Image Quality Assessment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T06:24:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:12:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-14T03:54:15Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-17T00:35:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large-scale vision language pre-training has recently shown promise for no-reference image-quality assessment (NR-IQA), yet the relative merits of modern Vision Transformer foundations remain poorly understood. In this work, we present the first systematic evaluation of six prominent pretrained backbones, CLIP, SigLIP2, DINOv2, DINOv3, Perception, and ResNet, for the task of No-Reference Image Quality Assessment (NR-IQA), each finetuned using an identical lightweight MLP head. Our study uncovers two previously overlooked factors: (1) SigLIP2 consistently achieves strong performance; and (2) the choice of activation function plays a surprisingly crucial role, particularly for enhancing the generalization ability of image quality assessment models. Notably, we find that simple sigmoid activations outperform commonly used ReLU and GELU on several benchmarks. Motivated by this finding, we introduce a learnable activation selection mechanism that adaptively determines the nonlinearity for each channel, eliminating the need for manual activation design, and achieving new state-of-the-art SRCC on CLIVE, KADID10K, and AGIQA3K. Extensive ablations confirm the benefits across architectures and regimes, establishing strong, resource-efficient NR-IQA baselines."},{"descriptionType":"Other","description":"23 pages, 16 figures. Accepted at WACV 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17374","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:10:28Z","registered":"2025-09-23T03:10:29Z","published":null,"updated":"2026-03-17T04:55:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16447","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16447","identifiers":[{"identifier":"2509.16447","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arwen","familyName":"Bradley","name":"Bradley, Arwen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Local Mechanisms of Compositional Generalization in Conditional Diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T22:02:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:10:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T07:19:02Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:29:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-13T00:01:09Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-16T00:13:56Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Conditional diffusion models appear capable of compositional generalization, i.e., generating convincing samples for out-of-distribution combinations of conditioners, but the mechanisms underlying this ability remain unclear. To make this concrete, we study length generalization, the ability to generate images with more objects than seen during training. In a controlled CLEVR setting (Johnson et al., 2017), we find that length generalization is achievable in some cases but not others, suggesting that models only sometimes learn the underlying compositional structure. We then investigate locality as a structural mechanism for compositional generalization. Prior works proposed score locality as a mechanism for creativity in unconditional diffusion models (Kamb \u0026amp; Ganguli, 2024; Niedoba et al., 2024), but did not address flexible conditioning or compositional generalization. In this paper, we prove an exact equivalence between a specific compositional structure (\"conditional projective composition\") (Bradley et al., 2025) and scores with sparse dependencies on both pixels and conditioners (\"local conditional scores\"). This theory also extends to feature-space compositionality. We validate our theory empirically: CLEVR models that succeed at length generalization exhibit local conditional scores, while those that fail do not. Furthermore, we show that a causal intervention explicitly enforcing local conditional scores restores length generalization in a previously failing model. Finally, we investigate SDXL and find that in pixel-space, spatial locality is present but conditional-locality is mostly absent; however, we find quantitative evidence of local conditional scores in the network's learned feature-space."},{"descriptionType":"Other","description":"10 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16447","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:37Z","registered":"2025-09-23T02:48:37Z","published":null,"updated":"2026-03-16T02:07:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17072","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17072","identifiers":[{"identifier":"2509.17072","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junyi","familyName":"Wu","name":"Wu, Junyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Fang","name":"Fang, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongfeng","familyName":"Wang","name":"Wang, Zhongfeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SnipSnap: A Joint Compression Format and Dataflow Co-Optimization Framework for Efficient Sparse LLM Accelerator Design"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Hardware Architecture (cs.AR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T13:07:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:54:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-27T12:25:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-13T00:16:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/asp-dac66049.2026.11420607","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The growing scale of large language models (LLMs) has intensified demands on computation and memory, making efficient inference a key challenge. While sparsity can reduce these costs, existing design space exploration (DSE) frameworks often overlook compression formats, a key factor for leveraging sparsity on accelerators. This paper proposes SnipSnap, a joint compression format and dataflow co-optimization framework for efficient sparse LLM accelerator design. SnipSnap introduces: (1) a hierarchical compression format encoding to expand the design space; (2) an adaptive compression engine for selecting formats under diverse sparsity; and (3) a progressive co-search workflow that jointly optimizes dataflow and compression formats. SnipSnap achieves 18.24% average memory energy savings via format optimization, along with 2248.3$\\times$ and 21.0$\\times$ speedups over Sparseloop and DiMO-Sparse frameworks, respectively."},{"descriptionType":"Other","description":"To appear in the 31st Asia and South Pacific Design Automation Conference (ASP-DAC 2026)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17072","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:03:22Z","registered":"2025-09-23T03:03:22Z","published":null,"updated":"2026-03-13T02:20:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18057","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18057","identifiers":[{"identifier":"2509.18057","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ansh","familyName":"Nagda","name":"Nagda, Ansh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prabhakar","familyName":"Raghavan","name":"Raghavan, Prabhakar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abhradeep","familyName":"Thakurta","name":"Thakurta, Abhradeep","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Reinforced Generation of Combinatorial Structures: Hardness of Approximation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Complexity (cs.CC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Combinatorics (math.CO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:30:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:49:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T17:34:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T01:10:27Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-29T16:56:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-30T02:17:34Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10-06T17:09:53Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-07T01:46:50Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-11-20T23:53:58Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2025-11-24T01:09:45Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-12-19T16:58:50Z","dateType":"Submitted","dateInformation":"v6"},{"date":"2025-12-22T01:52:25Z","dateType":"Updated","dateInformation":"v6"},{"date":"2026-03-09T21:00:18Z","dateType":"Submitted","dateInformation":"v7"},{"date":"2026-03-11T00:10:11Z","dateType":"Updated","dateInformation":"v7"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"7","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Can AI based methods help us make advances in complexity theory? We provide evidence towards answering this in the affirmative, using AlphaEvolve (an LLM code mutation agent) to obtain new results in three settings:\n a) We improve a recent result of Kunisky and Yu to obtain near-optimal upper and (conditional) lower bounds on certification algorithms for MAX-CUT and MAX-Independent Set on random 3- and 4-regular graphs. Our improved lower bounds are obtained by constructing nearly extremal Ramanujan graphs on as many as $163$ vertices, and our upper bounds are obtained via analytical arguments.\n b) We obtain new inapproximability results for MAX-4-CUT and MAX-3-CUT, proving that it is NP-hard to approximate them within factors of $0.987$ and $0.9649$ respectively, using AlphaEvolve to discover new gadget reductions. Our MAX-4-CUT result improves upon the SOTA of $0.9883$, and our MAX-3-CUT result improves on the current best gadget-based inapproximability result of $0.9853$, but falls short of the SOTA of $16/17$ that relies on a custom PCP (rather than a reduction from ``standard'' Håstad-style PCPs).\n c) Inapproximability for the metric Traveling Salesman Problem (TSP): We show that it is NP-hard to approximate the minimum cost tour within a factor of $111/110$ using AlphaEvolve to discover a new gadget, thus improving the SOTA of $117/116$. Along the way, we provide new modular soundness and completeness arguments that can be of independent interest.\n A key technical challenge we faced: verifying a candidate construction produced by AlphaEvolve is costly (sometimes requiring time exponential in the size of the construction). We used AlphaEvolve itself to evolve the verification procedure to be faster (sometimes by $10,000\\times$ for our gadgets). Our results suggest that gadget based proofs would benefit from a pass through AI-based tools to obtain stronger results."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18057","contentUrl":null,"metadataVersion":6,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":2,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:26:35Z","registered":"2025-09-23T03:26:36Z","published":null,"updated":"2026-03-11T02:33:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17965","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17965","identifiers":[{"identifier":"2509.17965","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sai Samrat","familyName":"Kankanala","name":"Kankanala, Sai Samrat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ram","familyName":"Chandra","name":"Chandra, Ram","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sriram","familyName":"Ganapathy","name":"Ganapathy, Sriram","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Benchmarking Humans and Machines on Complex Multilingual Speech Understanding Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:18:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:45:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-10T08:26:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-11T00:42:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Auditory attention and selective phase-locking are central to human speech understanding in complex acoustic scenes and cocktail party settings, yet these capabilities in multilingual subjects remain poorly understood. While machine understanding of natural speech has advanced in recent years, questions persist about comprehension of overlapped and mixed-channel speech. We propose a systematic paradigm for studying humans and machines in speech question-answering tasks in multilingual settings with clean and mixed-channel speech. For human listeners, selective attention to a target speaker was significantly better in their native language (L1) than in their second language (L2). For machine listening, speech-based large language models (LLMs) match or exceed human performance in clean, single-speaker conditions but often struggle to selectively attend in two-speaker settings. These results reveal a key divergence: humans rely on attentional cues that are more streamlined in their native language, whereas LLMs default to parallel information extraction which exceed human skills."},{"descriptionType":"Other","description":"5 Pages, 1 Figure, 2026 IEEE International Conference on Acoustics, Speech, and Signal Processing"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17965","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:24:26Z","registered":"2025-09-23T03:24:27Z","published":null,"updated":"2026-03-11T02:33:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17874","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17874","identifiers":[{"identifier":"2509.17874","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paulius","familyName":"Rauba","name":"Rauba, Paulius","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mihaela","familyName":"van der Schaar","name":"van der Schaar, Mihaela","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Deep Hierarchical Learning with Nested Subspace Networks for Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T15:13:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:40:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-04T13:06:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-05T01:55:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large neural networks are typically trained for a fixed computational budget, creating a rigid trade-off between performance and efficiency that is ill-suited for deployment in resource-constrained or dynamic environments. Existing approaches to this problem present a difficult choice: training a discrete collection of specialist models is computationally prohibitive, while dynamic methods like slimmable networks often lack the flexibility to be applied to large, pre-trained foundation models. In this work, we propose Nested Subspace Networks (NSNs), a novel architectural paradigm that enables a single model to be dynamically and granularly adjusted across a continuous spectrum of compute budgets at inference time. The core of our approach is to re-parameterize linear layers to satisfy a nested subspace property, such that the function computed at a given rank is a strict subspace of the function at any higher rank. We show that this entire hierarchy of models can be optimized jointly via an uncertainty-aware objective that learns to balance the contributions of different ranks based on their intrinsic difficulty. We demonstrate empirically that NSNs can be surgically applied to pre-trained LLMs and unlock a smooth and predictable compute-performance frontier. For example, a single NSN-adapted model can achieve a 50% reduction in inference FLOPs with only a 5 percentage point loss in accuracy. Our findings establish NSNs as a powerful framework for creating the next generation of adaptive foundation models."},{"descriptionType":"Other","description":"Published as a conference paper at ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17874","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:22:18Z","registered":"2025-09-23T03:22:18Z","published":null,"updated":"2026-03-05T03:43:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16654","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16654","identifiers":[{"identifier":"2509.16654","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Chen","name":"Chen, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jia","familyName":"He","name":"He, Jia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maozheng","familyName":"Li","name":"Li, Maozheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongliang","familyName":"Xu","name":"Xu, Dongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Wang","name":"Wang, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixiao","familyName":"Chen","name":"Chen, Yixiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhixin","familyName":"Lin","name":"Lin, Zhixin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Yao","name":"Yao, Yue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Are VLMs Ready for Lane Topology Awareness in Autonomous Driving?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T12:02:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:28:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-28T04:38:55Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T00:55:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03-03T12:52:59Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-04T01:49:28Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs) have recently shown remarkable progress in multimodal reasoning, yet their applications in autonomous driving remain limited. In particular, the ability to understand road topology, a key requirement for safe navigation, has received relatively little attention. While some recent works have begun to explore VLMs in driving contexts, their performance on topology reasoning is far from satisfactory. In this work, we systematically evaluate VLMs' capabilities in road topology understanding. Specifically, multi-view images are projected into unified ground-plane coordinate system and fused into bird's-eye-view (BEV) lanes. Based on these BEV lanes, we formulate four topology-related diagnostic VQA tasks, which together capture essential components of spatial topology reasoning. Through extensive evaluation, we find that while frontier closed-source models (e.g., GPT-4o) achieve relatively high accuracy in some tasks, they still fail in some spatial questions that humans can answer (e.g., GPT-4o achieve only 67.8% in vector, a two-class classification problem). Furthermore, we find open-source VLMs, even at 30B scale, struggle significantly. These results indicate that spatial reasoning remains a fundamental bottleneck for current VLMs. We also find that the model's capability is positively correlated with model size, length of reasoning tokens and shots provided as examples, showing direction for future research."},{"descriptionType":"Other","description":"5 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16654","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:28Z","registered":"2025-09-23T02:53:28Z","published":null,"updated":"2026-03-04T03:17:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17050","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17050","identifiers":[{"identifier":"2509.17050","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junhao","familyName":"Jia","name":"Jia, Junhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunyou","familyName":"Liu","name":"Liu, Yunyou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifei","familyName":"Sun","name":"Sun, Yifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huangwei","familyName":"Chen","name":"Chen, Huangwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feiwei","familyName":"Qin","name":"Qin, Feiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changmiao","familyName":"Wang","name":"Wang, Changmiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong","familyName":"Peng","name":"Peng, Yong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Geodesic Prototype Matching via Diffusion Maps for Interpretable Fine-Grained Recognition"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T12:15:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:53:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03-01T08:29:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-03-03T02:04:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Nonlinear manifolds are pervasive in deep visual features, where Euclidean distances can misrepresent true similarity. This mismatch is particularly detrimental to prototype-based interpretable fine-grained recognition, where even subtle semantic distinctions are crucial. To mitigate this issue, this work presents a novel paradigm for prototype-based recognition by grounding similarity in the intrinsic geometry of deep features. Concretely, we distill the latent manifold structure of each class into a diffusion space and, critically, devise a differentiable Nyström interpolation to make this geometry accessible to both unseen samples and learnable prototypes. To maintain efficiency, we employ compact per-class landmark sets with periodic updates. This strategy keeps the embedding synchronized with the evolving backbone, enabling fast inference at scale. Comprehensive experiments on two benchmark datasets demonstrate that our GeoProto yields prototypes focusing on semantically corresponding parts, significantly outperforming Euclidean prototype networks."},{"descriptionType":"Other","description":"The paper has been accepted by ICASSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17050","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:02:49Z","registered":"2025-09-23T03:02:49Z","published":null,"updated":"2026-03-03T05:42:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16622","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16622","identifiers":[{"identifier":"2509.16622","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mengqi","familyName":"Wang","name":"Wang, Mengqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhan","familyName":"Liu","name":"Liu, Zhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zengrui","familyName":"Jin","name":"Jin, Zengrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangzhi","familyName":"Sun","name":"Sun, Guangzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Zhang","name":"Zhang, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip C.","familyName":"Woodland","name":"Woodland, Philip C.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Audio-Conditioned Diffusion LLMs for ASR and Deliberation Processing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T10:48:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:26:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-09T07:55:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T00:37:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-27T09:09:57Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-03-02T01:34:45Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion-based large language models (DLLMs) have recently attracted growing interest as an alternative to autoregressive decoders. In this work, we present an empirical study on using the diffusion-based large language model LLaDA for automatic speech recognition (ASR). We first investigate its use as an external deliberation-based processing module for Whisper-LLaMA transcripts. By leveraging the bidirectional attention and denoising capabilities of LLaDA, we explore random masking, low-confidence masking, and semi-autoregressive strategies, showing that Whisper-LLaDA substantially reduces WER compared with the baseline. On LibriSpeech, the best cascade system achieves 2.25%/4.94% WER on test-clean/test-other, representing a 12.3% relative improvement over the Whisper-LLaMA baseline on the test-other split. In contrast, a plain-text LLaDA without acoustic features fails to improve accuracy, highlighting the importance of audio-conditioned embeddings. We further evaluate Whisper-LLaDA as a standalone decoder for ASR with diffusion-based and semi-autoregressive decoding. Most experimental configurations achieve faster inference than the Whisper-LLaMA baseline, although recognition accuracy is slightly lower. These findings offer an empirical view of diffusion-based LLMs for ASR and point to promising directions for improvements. Code and model are open-sourced at https://github.com/liuzhan22/Diffusion-ASR."},{"descriptionType":"Other","description":"Accepted to ICASSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16622","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:52:42Z","registered":"2025-09-23T02:52:43Z","published":null,"updated":"2026-03-02T03:06:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17562","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17562","identifiers":[{"identifier":"2509.17562","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuxuan","familyName":"Li","name":"Li, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yicheng","familyName":"Zhang","name":"Zhang, Yicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenhao","familyName":"Tang","name":"Tang, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yimian","familyName":"Dai","name":"Dai, Yimian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming-Ming","familyName":"Cheng","name":"Cheng, Ming-Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Li","name":"Li, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Yang","name":"Yang, Jian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Visual Instruction Pretraining for Domain-Specific Foundation Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T10:57:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:22:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T04:33:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:30:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-28T07:15:09Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-29T01:28:33Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02-26T07:40:53Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-02-27T01:30:46Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern computer vision is converging on a closed loop in which perception, reasoning and generation mutually reinforce each other. However, this loop remains incomplete: the top-down influence of high-level reasoning on the foundational learning of low-level perceptual features is not yet underexplored. This paper addresses this gap by proposing a new paradigm for pretraining foundation models in downstream domains. We introduce Visual insTruction Pretraining (ViTP), a novel approach that directly leverages reasoning to enhance perception. ViTP embeds a Vision Transformer (ViT) backbone within a Vision-Language Model and pretrains it end-to-end using a rich corpus of visual instruction data curated from target downstream domains. ViTP is powered by our proposed Visual Robustness Learning (VRL), which compels the ViT to learn robust and domain-relevant features from a sparse set of visual tokens. Extensive experiments on 16 challenging remote sensing and medical imaging benchmarks demonstrate that ViTP establishes new state-of-the-art performance across a diverse range of downstream tasks. The code is available at https://github.com/zcablii/ViTP."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17562","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:14:57Z","registered":"2025-09-23T03:14:58Z","published":null,"updated":"2026-02-27T03:14:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17544","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17544","identifiers":[{"identifier":"2509.17544","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Juan","familyName":"Cañada","name":"Cañada, Juan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raúl","familyName":"Alonso","name":"Alonso, Raúl","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julio","familyName":"Molleda","name":"Molleda, Julio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fidel","familyName":"Díez","name":"Díez, Fidel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Multimodal Conversational Assistant for the Characterization of Agricultural Plots from Geospatial Open Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T09:02:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:21:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T14:32:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-19T01:28:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/girst67753.2025.11382141","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The increasing availability of open Earth Observation (EO) and agricultural datasets holds great potential for supporting sustainable land management. However, their high technical entry barrier limits accessibility for non-expert users. This study presents an open-source conversational assistant that integrates multimodal retrieval and large language models (LLMs) to enable natural language interaction with heterogeneous agricultural and geospatial data. The proposed architecture combines orthophotos, Sentinel-2 vegetation indices, and user-provided documents through retrieval-augmented generation (RAG), allowing the system to flexibly determine whether to rely on multimodal evidence, textual knowledge, or both in formulating an answer. To assess response quality, we adopt an LLM-as-a-judge methodology using Qwen3-32B in a zero-shot, unsupervised setting, applying direct scoring in a multi-dimensional quantitative evaluation framework. Preliminary results show that the system is capable of generating clear, relevant, and context-aware responses to agricultural queries, while remaining reproducible and scalable across geographic regions. The primary contributions of this work include an architecture for fusing multimodal EO and textual knowledge sources, a demonstration of lowering the barrier to access specialized agricultural information through natural language interaction, and an open and reproducible design."},{"descriptionType":"Other","description":"Accepted at 2025 4th International Conference on Geographic Information and Remote Sensing Technology"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17544","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:14:31Z","registered":"2025-09-23T03:14:32Z","published":null,"updated":"2026-02-19T03:01:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16779","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16779","identifiers":[{"identifier":"2509.16779","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jason","familyName":"Wu","name":"Wu, Jason","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amanda","familyName":"Swearngin","name":"Swearngin, Amanda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arun Krishna","familyName":"Vajjala","name":"Vajjala, Arun Krishna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alan","familyName":"Leung","name":"Leung, Alan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeffrey","familyName":"Nichols","name":"Nichols, Jeffrey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Titus","familyName":"Barik","name":"Barik, Titus","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improving User Interface Generation Models from Designer Feedback"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T19:02:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:38:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-16T19:19:25Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-18T01:03:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772318.3791567","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite being trained on vast amounts of data, most LLMs are unable to reliably generate well-designed UIs. Designer feedback is essential to improving performance on UI generation; however, we find that existing RLHF methods based on ratings or rankings are not well-aligned with with designers' workflows and ignore the rich rationale used to critique and improve UI designs. In this paper, we investigate several approaches for designers to give feedback to UI generation models, using familiar interactions such as commenting, sketching and direct manipulation. We first perform an evaluation with 21 designers where they gave feedback using these interactions, which resulted in 1500 design annotations. We then use this data to finetune a series of LLMs to generate higher quality UIs. Finally, we evaluate these models with human judges, and we find that our designer-aligned approaches outperform models trained with traditional ranking feedback and all tested baselines, including GPT-5."},{"descriptionType":"Other","description":"Version accepted to CHI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16779","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T02:56:24Z","registered":"2025-09-23T02:56:25Z","published":null,"updated":"2026-02-18T02:56:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18053","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18053","identifiers":[{"identifier":"2509.18053","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hsu-kuang","familyName":"Chiu","name":"Chiu, Hsu-kuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryo","familyName":"Hachiuma","name":"Hachiuma, Ryo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chien-Yi","familyName":"Wang","name":"Wang, Chien-Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu-Chiang Frank","familyName":"Wang","name":"Wang, Yu-Chiang Frank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min-Hung","familyName":"Chen","name":"Chen, Min-Hung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephen F.","familyName":"Smith","name":"Smith, Stephen F.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"V2V-GoT: Vehicle-to-Vehicle Cooperative Autonomous Driving with Multimodal Large Language Models and Graph-of-Thoughts"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:27:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:49:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T15:30:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T01:02:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-25T01:34:08Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-26T00:14:49Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02-16T01:56:37Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-02-17T02:12:00Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Current state-of-the-art autonomous vehicles could face safety-critical situations when their local sensors are occluded by large nearby objects on the road. Vehicle-to-vehicle (V2V) cooperative autonomous driving has been proposed as a means of addressing this problem, and one recently introduced framework for cooperative autonomous driving has further adopted an approach that incorporates a Multimodal Large Language Model (MLLM) to integrate cooperative perception and planning processes. However, despite the potential benefit of applying graph-of-thoughts reasoning to the MLLM, this idea has not been considered by previous cooperative autonomous driving research. In this paper, we propose a novel graph-of-thoughts framework specifically designed for MLLM-based cooperative autonomous driving. Our graph-of-thoughts includes our proposed novel ideas of occlusion-aware perception and planning-aware prediction. We curate the V2V-GoT-QA dataset and develop the V2V-GoT model for training and testing the cooperative driving graph-of-thoughts. Our experimental results show that our method outperforms other baselines in cooperative perception, prediction, and planning tasks. Our project website: https://eddyhkchiu.github.io/v2vgot.github.io/ ."},{"descriptionType":"Other","description":"Accepted by ICRA 2026 (IEEE International Conference on Robotics and Automation). Project: https://eddyhkchiu.github.io/v2vgot.github.io/ Code: https://github.com/eddyhkchiu/V2V-GoT Dataset: https://huggingface.co/datasets/eddyhkchiu/V2V-GoT-QA"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18053","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:26:30Z","registered":"2025-09-23T03:26:31Z","published":null,"updated":"2026-02-17T04:45:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18008","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18008","identifiers":[{"identifier":"2509.18008","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bingsheng","familyName":"Yao","name":"Yao, Bingsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaju","familyName":"Chen","name":"Chen, Jiaju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaoran","familyName":"Chen","name":"Chen, Chaoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"April","familyName":"Wang","name":"Wang, April","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Toby Jia-jun","familyName":"Li","name":"Li, Toby Jia-jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dakuo","familyName":"Wang","name":"Wang, Dakuo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Through the Lens of Human-Human Collaboration: A Configurable Research Platform for Exploring Human-Agent Collaboration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:47:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:47:28Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-16T00:15:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-17T02:09:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Intelligent systems have traditionally been designed as tools rather than collaborators, often lacking critical characteristics that collaboration partnerships require. Recent advances in large language model (LLM) agents open new opportunities for human-LLM-agent collaboration by enabling natural communication and various social and cognitive behaviors. Yet it remains unclear whether principles of computer-mediated collaboration established in HCI and CSCW persist, change, or fail when humans collaborate with LLM agents. To support systematic investigations of these questions, we introduce an open and configurable research platform for HCI researchers. The platform's modular design allows seamless adaptation of classic CSCW experiments and manipulation of theory-grounded interaction controls. We demonstrate the platform's research efficacy and usability through three case studies: (1) two Shape Factory experiments for resource negotiation with 16 participants, (2) one Hidden Profile experiment for information pooling with 16 participants, and (3) a participatory cognitive walkthrough with five HCI researchers to refine workflows of researcher interface for experiment setup and analysis."},{"descriptionType":"Other","description":"Accepted at CHI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18008","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:25:27Z","registered":"2025-09-23T03:25:27Z","published":null,"updated":"2026-02-17T04:45:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17196","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17196","identifiers":[{"identifier":"2509.17196","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xuyang","familyName":"Ge","name":"Ge, Xuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wentao","familyName":"Shu","name":"Shu, Wentao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaxing","familyName":"Wu","name":"Wu, Jiaxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunhua","familyName":"Zhou","name":"Zhou, Yunhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengfu","familyName":"He","name":"He, Zhengfu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xipeng","familyName":"Qiu","name":"Qiu, Xipeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evolution of Concepts in Language Model Pre-Training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T18:53:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:01:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-14T07:17:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-17T01:25:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Language models obtain extensive capabilities through pre-training. However, the pre-training process remains a black box. In this work, we track linear interpretable feature evolution across pre-training snapshots using a sparse dictionary learning method called crosscoders. We find that most features begin to form around a specific point, while more complex patterns emerge in later training stages. Feature attribution analyses reveal causal connections between feature evolution and downstream performance. Our feature-level observations are highly consistent with previous findings on Transformer's two-stage learning process, which we term a statistical learning phase and a feature learning phase. Our work opens up the possibility to track fine-grained representation progress during language model learning dynamics."},{"descriptionType":"Other","description":"35 pages, 35 figures. Accepted to ICLR 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17196","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:06:17Z","registered":"2025-09-23T03:06:18Z","published":null,"updated":"2026-02-17T04:44:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":440,"totalPages":18,"page":3},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=3\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=4\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22languag