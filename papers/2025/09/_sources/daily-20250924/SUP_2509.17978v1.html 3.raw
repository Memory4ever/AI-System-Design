<td id="S5.I9.i1.I1.i1.p2.1.6.2" class="ltx_td ltx_align_left"><span id="S5.I9.i1.I1.i1.p2.1.6.2.1" class="ltx_text" style="font-size:90%;">G3P22R</span></td>
<td id="S5.I9.i1.I1.i1.p2.1.6.3" class="ltx_td ltx_align_center"><span id="S5.I9.i1.I1.i1.p2.1.6.3.1" class="ltx_text" style="font-size:90%;">2</span></td>
<td id="S5.I9.i1.I1.i1.p2.1.6.4" class="ltx_td ltx_align_left"><span id="S5.I9.i1.I1.i1.p2.1.6.4.1" class="ltx_text" style="font-size:90%;">B2100</span></td></tr>
