<td id="S5.I9.i1.I1.i1.p2.1.7.1" class="ltx_td ltx_align_left"><span id="S5.I9.i1.I1.i1.p2.1.7.1.1" class="ltx_text" style="font-size:90%;">P31</span></td>
<td id="S5.I9.i1.I1.i1.p2.1.7.2" class="ltx_td ltx_align_left"><span id="S5.I9.i1.I1.i1.p2.1.7.2.1" class="ltx_text" style="font-size:90%;">G2P31R</span></td>
<td id="S5.I9.i1.I1.i1.p2.1.7.3" class="ltx_td ltx_align_center"><span id="S5.I9.i1.I1.i1.p2.1.7.3.1" class="ltx_text" style="font-size:90%;">3</span></td>
<td id="S5.I9.i1.I1.i1.p2.1.7.4" class="ltx_td ltx_align_left"><span id="S5.I9.i1.I1.i1.p2.1.7.4.1" class="ltx_text" style="font-size:90%;">B1202</span></td></tr>
<tr id="S5.I9.i1.I1.i1.p2.1.8" class="ltx_tr">
<td id="S5.I9.i1.I1.i1.p2.1.8.1" class="ltx_td ltx_align_left"><span id="S5.I9.i1.I1.i1.p2.1.8.1.1" class="ltx_text" style="font-size:90%;">P41</span></td>
