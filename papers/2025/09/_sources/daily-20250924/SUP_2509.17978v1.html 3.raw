<p id="S5.I25.i3.I1.i5.p1.1" class="ltx_p"><span id="S5.I25.i3.I1.i5.p1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Current Inventory:</span><span id="S5.I25.i3.I1.i5.p1.1.2" class="ltx_text" style="font-size:90%;"> </span><span id="S5.I25.i3.I1.i5.p1.1.3" class="ltx_text ltx_font_typewriter" style="font-size:90%;">{ G1: 0, G2: 0, G3: 0, G4: 0 }</span></p>
