<th id="S5.I9.i1.I1.i1.p2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t"><span id="S5.I9.i1.I1.i1.p2.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Immutable Prefix</span></th>
<th id="S5.I9.i1.I1.i1.p2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S5.I9.i1.I1.i1.p2.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Dynamic Rot.</span></th>
