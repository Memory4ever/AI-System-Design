<span id="S2.T1.3.1.2.2.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">CPU (single core)</span></span>
</span></span><span id="S2.T1.3.1.2.2.2" class="ltx_text"></span></span></td>
