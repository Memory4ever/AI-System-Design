          <math id="alg2.l5.m1" class="ltx_Math" alttext="\alpha_{(0)}\leftarrow[1,1]\otimes\mathbf{1}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">⊗</mo><msub><mn>𝟏</mn><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha_{(0)}\leftarrow[1,1]\otimes\mathbf{1}_{n}</annotation></semantics></math> <span id="alg2.l5.2" class="ltx_text" style="float:right;"><math id="alg2.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Uniform initial scaling coefficients
</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
