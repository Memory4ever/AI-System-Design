</div>
<div id="alg2.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">13:</span>
            
            
             Solve <math id="alg2.l13.m1" class="ltx_Math" alttext="\alpha_{(i,t)}\leftarrow(A_{i})^{-1}b_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">←</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>b</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\alpha_{(i,t)}\leftarrow(A_{i})^{-1}b_{i}</annotation></semantics></math> <span id="alg2.l13.2" class="ltx_text" style="float:right;"><math id="alg2.l13.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Ridge regression solution
</span>
</div>
<div id="alg2.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14:</span>
            
            
             <math id="alg2.l14.m1" class="ltx_Math" alttext="\lambda_{i,new}\leftarrow\lambda_{i}\sqrt{{\kappa_{i,approx}/{10^{12}}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>κ</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></msub><mo>/</mo><msup><mn>10</mn><mn>12</mn></msup></mrow></msqrt></mrow></mrow><annotation encoding="application/x-tex">\lambda_{i,new}\leftarrow\lambda_{i}\sqrt{{\kappa_{i,approx}/{10^{12}}}}</annotation></semantics></math> when <math id="alg2.l14.m2" class="ltx_Math" alttext="\kappa_{i,approx}\geq 10^{12}" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mrow><mi>i</mi><mo>,</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></msub><mo>≥</mo><msup><mn>10</mn><mn>12</mn></msup></mrow><annotation encoding="application/x-tex">\kappa_{i,approx}\geq 10^{12}</annotation></semantics></math>

</div>
<div id="alg2.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">15:</span>
            
            
