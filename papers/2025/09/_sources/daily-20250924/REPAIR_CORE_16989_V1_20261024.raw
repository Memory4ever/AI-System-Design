<td id="S4.T1.8.1.21.5" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">1.34E5</td>
<td id="S4.T1.8.1.21.6" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">5.02E5</td>
<td id="S4.T1.8.1.21.7" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">37.10</td></tr>
