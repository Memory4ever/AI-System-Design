<th id="A5.T9.6.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:-0.75pt 2.0pt;">FP16/16.00</th>
<td id="A5.T9.6.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.75pt 2.0pt;">5.68</td>
