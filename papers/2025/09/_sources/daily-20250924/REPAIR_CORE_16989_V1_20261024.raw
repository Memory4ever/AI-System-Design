<tr id="S4.T1.8.1.4" class="ltx_tr">
<th id="S4.T1.8.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.5pt 5.0pt;">AWQ</th>
<td id="S4.T1.8.1.4.2" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">2.00</td>
