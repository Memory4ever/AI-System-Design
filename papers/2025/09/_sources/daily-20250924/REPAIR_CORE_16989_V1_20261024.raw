          <math id="alg2.l6.m1" class="ltx_Math" alttext="\lambda_{(0)}\leftarrow 10^{-8}\cdot\mathbf{1}_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">←</mo><mrow><msup><mn>10</mn><mrow><mo>−</mo><mn>8</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟏</mn><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\lambda_{(0)}\leftarrow 10^{-8}\cdot\mathbf{1}_{n}</annotation></semantics></math> <span id="alg2.l6.2" class="ltx_text" style="float:right;"><math id="alg2.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Initial regularization parameters
