</div>
<div id="alg2.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">9:</span>
            
            
            <span id="alg2.l9.2" class="ltx_text ltx_font_bold">for</span> row <math id="alg2.l9.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> <span id="alg2.l9.3" class="ltx_text ltx_font_bold">to</span> <math id="alg2.l9.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> <span id="alg2.l9.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">10:</span>
            
            
             <math id="alg2.l10.m1" class="ltx_Math" alttext="S_{i}\leftarrow[T^{(1)T}_{i,(t-1)}\quad T^{(2)T}_{i,(t-1)}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mrow><msubsup><mi>T</mi><mrow><mi>i</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msubsup><mspace style="width:1em;" width="1em"></mspace><msubsup><mi>T</mi><mrow><mi>i</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msubsup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S_{i}\leftarrow[T^{(1)T}_{i,(t-1)}\quad T^{(2)T}_{i,(t-1)}]</annotation></semantics></math> <span id="alg2.l10.2" class="ltx_text" style="float:right;"><math id="alg2.l10.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Local basis matrix
</span>
</div>
<div id="alg2.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">11:</span>
            
            
             <math id="alg2.l11.m1" class="ltx_Math" alttext="A_{i}\leftarrow(S_{i})^{T}S_{i}+\lambda_{i}I_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mi>T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>i</mi></msub></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>I</mi><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{i}\leftarrow(S_{i})^{T}S_{i}+\lambda_{i}I_{2}</annotation></semantics></math>

</div>
<div id="alg2.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">12:</span>
            
            
