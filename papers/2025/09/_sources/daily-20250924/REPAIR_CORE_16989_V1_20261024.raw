<th id="S4.T1.8.1.22.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.5pt 5.0pt;">GPTQ</th>
<td id="S4.T1.8.1.22.2" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">2.00</td>
<td id="S4.T1.8.1.22.3" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">2.38E4</td>
<td id="S4.T1.8.1.22.4" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">6.55E2</td>
<td id="S4.T1.8.1.22.5" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">5.92E5</td>
<td id="S4.T1.8.1.22.6" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">7.77E4</td>
<td id="S4.T1.8.1.22.7" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">38.40</td></tr>
<tr id="S4.T1.8.1.23" class="ltx_tr">
<th id="S4.T1.8.1.23.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.5pt 5.0pt;">BiLLM</th>
<td id="S4.T1.8.1.23.2" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">1.06</td>
<td id="S4.T1.8.1.23.3" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">5.87E4</td>
<td id="S4.T1.8.1.23.4" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">7.54E4</td>
<td id="S4.T1.8.1.23.5" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">299.86</td>
<td id="S4.T1.8.1.23.6" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">113.45</td>
<td id="S4.T1.8.1.23.7" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">17.10</td></tr>
<tr id="S4.T1.8.1.24" class="ltx_tr">
<th id="S4.T1.8.1.24.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.5pt 5.0pt;">ARB-LLM<sub id="S4.T1.8.1.24.1.1" class="ltx_sub">RC</sub></th>
<td id="S4.T1.8.1.24.2" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">1.06</td>
<td id="S4.T1.8.1.24.3" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">8.43E2</td>
<td id="S4.T1.8.1.24.4" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">3.26E2</td>
<td id="S4.T1.8.1.24.5" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;"><span id="S4.T1.8.1.24.5.1" class="ltx_text ltx_underline">50.30</span></td>
<td id="S4.T1.8.1.24.6" class="ltx_td ltx_align_center" style="padding:0.5pt 5.0pt;">32.26</td>
