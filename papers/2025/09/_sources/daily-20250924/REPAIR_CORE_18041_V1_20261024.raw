<th id="S6.T5.1.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Overall Accuracy (<math id="S6.T5.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</th>
<td id="S6.T5.1.1.4.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S6.T5.1.1.4.2.1" class="ltx_text ltx_font_bold">58.33</span></td>
