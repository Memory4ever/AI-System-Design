<td id="S6.T2.1.1.6.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">25.85</td></tr>
<tr id="S6.T2.1.1.7" class="ltx_tr">
<td id="S6.T2.1.1.7.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S6.T2.1.1.7.1.1" class="ltx_text">
<span id="S6.T2.1.1.7.1.1.1" class="ltx_inline-block">
<span id="S6.T2.1.1.7.1.1.1.1" class="ltx_p"><span id="S6.T2.1.1.7.1.1.1.1.1" class="ltx_text ltx_font_italic">NeuS-QA</span> (Ours)</span>
</span></span></td>
