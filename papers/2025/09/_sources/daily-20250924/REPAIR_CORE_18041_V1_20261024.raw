<td id="S6.T2.1.1.3.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">50.24</td></tr>
<tr id="S6.T2.1.1.4" class="ltx_tr">
<td id="S6.T2.1.1.4.1" class="ltx_td ltx_align_left" style="padding-left:2.8pt;padding-right:2.8pt;">Llama-3.2-11B-Vision-Instruct</td>
<td id="S6.T2.1.1.4.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">20.98</td></tr>
<tr id="S6.T2.1.1.5" class="ltx_tr">
<td id="S6.T2.1.1.5.1" class="ltx_td ltx_align_left" style="padding-left:2.8pt;padding-right:2.8pt;">LLaVA-OneVision-Qwen2-7B</td>
<td id="S6.T2.1.1.5.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">31.71</td></tr>
