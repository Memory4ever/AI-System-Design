{"data":[{"id":"10.48550/arxiv.2509.17570","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17570","identifiers":[{"identifier":"2509.17570","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sergey","familyName":"Troshin","name":"Troshin, Sergey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Irina","familyName":"Saparina","name":"Saparina, Irina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Antske","familyName":"Fokkens","name":"Fokkens, Antske","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vlad","familyName":"Niculae","name":"Niculae, Vlad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Asking a Language Model for Diverse Responses"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:01:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:22:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models increasingly rely on explicit reasoning chains and can produce multiple plausible responses for a given context. We study the candidate sampler that produces the set of plausible responses contrasting the ancestral (parallel) sampling against two alternatives: enumeration, which asks the model to produce $n$ candidates in one pass, and iterative sampling, which proposes candidates sequentially while conditioning on the currently generated response set. Under matched budgets, we compare these samplers on quality, lexical and computation flow diversity, and efficiency. Our empirical results demonstrate that enumeration and iterative strategies result in higher diversity at comparable quality. Our findings highlight the potential of simple non-independent sampling strategies to improve response diversity without sacrificing generation quality."},{"descriptionType":"Other","description":"UncertaiNLP workshop, 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17570","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:15:09Z","registered":"2025-09-23T03:15:09Z","published":null,"updated":"2025-09-23T03:15:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17566","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17566","identifiers":[{"identifier":"2509.17566","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ding","familyName":"Shaodong","name":"Shaodong, Ding","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liu","familyName":"Ziyang","name":"Ziyang, Liu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhou","familyName":"Yijun","name":"Yijun, Zhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liu","familyName":"Tao","name":"Tao, Liu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MRN: Harnessing 2D Vision Foundation Models for Diagnosing Parkinson's Disease with Limited 3D MR Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T10:59:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:22:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The automatic diagnosis of Parkinson's disease is in high clinical demand due to its prevalence and the importance of targeted treatment. Current clinical practice often relies on diagnostic biomarkers in QSM and NM-MRI images. However, the lack of large, high-quality datasets makes training diagnostic models from scratch prone to overfitting. Adapting pre-trained 3D medical models is also challenging, as the diversity of medical imaging leads to mismatches in voxel spacing and modality between pre-training and fine-tuning data. In this paper, we address these challenges by leveraging 2D vision foundation models (VFMs). Specifically, we crop multiple key ROIs from NM and QSM images, process each ROI through separate branches to compress the ROI into a token, and then combine these tokens into a unified patient representation for classification. Within each branch, we use 2D VFMs to encode axial slices of the 3D ROI volume and fuse them into the ROI token, guided by an auxiliary segmentation head that steers the feature extraction toward specific brain nuclei. Additionally, we introduce multi-ROI supervised contrastive learning, which improves diagnostic performance by pulling together representations of patients from the same class while pushing away those from different classes. Our approach achieved first place in the MICCAI 2025 PDCADxFoundation challenge, with an accuracy of 86.0% trained on a dataset of only 300 labeled QSM and NM-MRI scans, outperforming the second-place method by 5.5%.These results highlight the potential of 2D VFMs for clinical analysis of 3D MR images."},{"descriptionType":"Other","description":"First-place solution of the classification track for MICCAI'2025 PDCADxFoundation Challenge"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17566","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:15:03Z","registered":"2025-09-23T03:15:04Z","published":null,"updated":"2025-09-23T03:15:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17559","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17559","identifiers":[{"identifier":"2509.17559","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yoko","familyName":"Kayano","name":"Kayano, Yoko","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saku","familyName":"Sugawara","name":"Sugawara, Saku","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Specification-Aware Machine Translation and Evaluation for Purpose Alignment"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T10:50:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:22:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In professional settings, translation is guided by communicative goals and client needs, often formalized as specifications. While existing evaluation frameworks acknowledge the importance of such specifications, these specifications are often treated only implicitly in machine translation (MT) research. Drawing on translation studies, we provide a theoretical rationale for why specifications matter in professional translation, as well as a practical guide to implementing specification-aware MT and evaluation. Building on this foundation, we apply our framework to the translation of investor relations texts from 33 publicly listed companies. In our experiment, we compare five translation types, including official human translations and prompt-based outputs from large language models (LLMs), using expert error analysis, user preference rankings, and an automatic metric. The results show that LLM translations guided by specifications consistently outperformed official human translations in human evaluations, highlighting a gap between perceived and expected quality. These findings demonstrate that integrating specifications into MT workflows, with human oversight, can improve translation quality in ways aligned with professional practice."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17559","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:14:53Z","registered":"2025-09-23T03:14:54Z","published":null,"updated":"2025-09-23T03:14:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17553","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17553","identifiers":[{"identifier":"2509.17553","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Congcong","familyName":"Ge","name":"Ge, Congcong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yachuan","familyName":"Liu","name":"Liu, Yachuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixuan","familyName":"Tang","name":"Tang, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Zhu","name":"Zhu, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaofeng","familyName":"Tu","name":"Tu, Yaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunjun","familyName":"Gao","name":"Gao, Yunjun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MontePrep: Monte-Carlo-Driven Automatic Data Preparation without Target Data Instances"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T09:17:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:21:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In commercial systems, a pervasive requirement for automatic data preparation (ADP) is to transfer relational data from disparate sources to targets with standardized schema specifications. Previous methods rely on labor-intensive supervision signals or target table data access permissions, limiting their usage in real-world scenarios. To tackle these challenges, we propose an effective end-to-end ADP framework MontePrep, which enables training-free pipeline synthesis with zero target-instance requirements. MontePrep is formulated as an open-source large language model (LLM) powered tree-structured search problem. It consists of three pivot components, i.e., a data preparation action sandbox (DPAS), a fundamental pipeline generator (FPG), and an execution-aware pipeline optimizer (EPO). We first introduce DPAS, a lightweight action sandbox, to navigate the search-based pipeline generation. The design of DPAS circumvents exploration of infeasible pipelines. Then, we present FPG to build executable DP pipelines incrementally, which explores the predefined action sandbox by the LLM-powered Monte Carlo Tree Search. Furthermore, we propose EPO, which invokes pipeline execution results from sources to targets to evaluate the reliability of the generated pipelines in FPG. In this way, unreasonable pipelines are eliminated, thus facilitating the search process from both efficiency and effectiveness perspectives. Extensive experimental results demonstrate the superiority of MontePrep with significant improvement against five state-of-the-art competitors."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17553","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:14:44Z","registered":"2025-09-23T03:14:45Z","published":null,"updated":"2025-09-23T03:14:45Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17548","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17548","identifiers":[{"identifier":"2509.17548","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hugo","familyName":"Villamizar","name":"Villamizar, Hugo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jannik","familyName":"Fischbach","name":"Fischbach, Jannik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander","familyName":"Korn","name":"Korn, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andreas","familyName":"Vogelsang","name":"Vogelsang, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Mendez","name":"Mendez, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prompts as Software Engineering Artifacts: A Research Agenda and Preliminary Findings"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Software Engineering (cs.SE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T09:08:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:21:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Developers now routinely interact with large language models (LLMs) to support a range of software engineering (SE) tasks. This prominent role positions prompts as potential SE artifacts that, like other artifacts, may require systematic development, documentation, and maintenance. However, little is known about how prompts are actually used and managed in LLM-integrated workflows, what challenges practitioners face, and whether the benefits of systematic prompt management outweigh the associated effort. To address this gap, we propose a research programme that (a) characterizes current prompt practices, challenges, and influencing factors in SE; (b) analyzes prompts as software artifacts, examining their evolution, traceability, reuse, and the trade-offs of systematic management; and (c) develops and empirically evaluates evidence-based guidelines for managing prompts in LLM-integrated workflows. As a first step, we conducted an exploratory survey with 74 software professionals from six countries to investigate current prompt practices and challenges. The findings reveal that prompt usage in SE is largely ad-hoc: prompts are often refined through trial-and-error, rarely reused, and shaped more by individual heuristics than standardized practices. These insights not only highlight the need for more systematic approaches to prompt management but also provide the empirical foundation for the subsequent stages of our research programme."},{"descriptionType":"Other","description":"This paper has been accepted for presentation at the 26th International Conference on Product-Focused Software Process Improvement (PROFES 2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17548","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:14:37Z","registered":"2025-09-23T03:14:38Z","published":null,"updated":"2025-09-23T03:14:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17532","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17532","identifiers":[{"identifier":"2509.17532","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guanxiong","familyName":"Sun","name":"Sun, Guanxiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Majid","familyName":"Mirmehdi","name":"Mirmehdi, Majid","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zahraa","familyName":"Abdallah","name":"Abdallah, Zahraa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Raul","familyName":"Santos-Rodriguez","name":"Santos-Rodriguez, Raul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ian","familyName":"Craddock","name":"Craddock, Ian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Telmo de Menezes e Silva","familyName":"Filho","name":"Filho, Telmo de Menezes e Silva","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TACTFL: Temporal Contrastive Training for Multi-modal Federated Learning with Similarity-guided Model Aggregation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:52:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:20:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-world federated learning faces two key challenges: limited access to labelled data and the presence of heterogeneous multi-modal inputs. This paper proposes TACTFL, a unified framework for semi-supervised multi-modal federated learning. TACTFL introduces a modality-agnostic temporal contrastive training scheme that conducts representation learning from unlabelled client data by leveraging temporal alignment across modalities. However, as clients perform self-supervised training on heterogeneous data, local models may diverge semantically. To mitigate this, TACTFL incorporates a similarity-guided model aggregation strategy that dynamically weights client models based on their representational consistency, promoting global alignment. Extensive experiments across diverse benchmarks and modalities, including video, audio, and wearable sensors, demonstrate that TACTFL achieves state-of-the-art performance. For instance, on the UCF101 dataset with only 10% labelled data, TACTFL attains 68.48% top-1 accuracy, significantly outperforming the FedOpt baseline of 35.35%. Code will be released upon publication."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17532","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:14:13Z","registered":"2025-09-23T03:14:14Z","published":null,"updated":"2025-09-23T03:14:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17522","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17522","identifiers":[{"identifier":"2509.17522","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hangzhou","familyName":"He","name":"He, Hangzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Zhu","name":"Zhu, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaiwen","familyName":"Li","name":"Li, Kaiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinliang","familyName":"Zhang","name":"Zhang, Xinliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiakui","familyName":"Hu","name":"Hu, Jiakui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ourui","familyName":"Fu","name":"Fu, Ourui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengjian","familyName":"Yao","name":"Yao, Zhengjian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanye","familyName":"Lu","name":"Lu, Yanye","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Chat-CBM: Towards Interactive Concept Bottleneck Models with Frozen Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:48:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:20:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Concept Bottleneck Models (CBMs) provide inherent interpretability by first predicting a set of human-understandable concepts and then mapping them to labels through a simple classifier. While users can intervene in the concept space to improve predictions, traditional CBMs typically employ a fixed linear classifier over concept scores, which restricts interventions to manual value adjustments and prevents the incorporation of new concepts or domain knowledge at test time. These limitations are particularly severe in unsupervised CBMs, where concept activations are often noisy and densely activated, making user interventions ineffective. We introduce Chat-CBM, which replaces score-based classifiers with a language-based classifier that reasons directly over concept semantics. By grounding prediction in the semantic space of concepts, Chat-CBM preserves the interpretability of CBMs while enabling richer and more intuitive interventions, such as concept correction, addition or removal of concepts, incorporation of external knowledge, and high-level reasoning guidance. Leveraging the language understanding and few-shot capabilities of frozen large language models, Chat-CBM extends the intervention interface of CBMs beyond numerical editing and remains effective even in unsupervised settings. Experiments on nine datasets demonstrate that Chat-CBM achieves higher predictive performance and substantially improves user interactivity while maintaining the concept-based interpretability of CBMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17522","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:13:59Z","registered":"2025-09-23T03:14:00Z","published":null,"updated":"2025-09-23T03:14:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17520","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17520","identifiers":[{"identifier":"2509.17520","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mingda","familyName":"Zhang","name":"Zhang, Mingda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Zheng","name":"Zheng, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruixiang","familyName":"Tang","name":"Tang, Ruixiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingru","familyName":"Qiu","name":"Qiu, Jingru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyan","familyName":"Ding","name":"Ding, Haiyan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Unified Multimodal Coherent Field: Synchronous Semantic-Spatial-Vision Fusion for Brain Tumor Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:45:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:20:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Brain tumor segmentation requires accurate identification of hierarchical regions including whole tumor (WT), tumor core (TC), and enhancing tumor (ET) from multi-sequence magnetic resonance imaging (MRI) images. Due to tumor tissue heterogeneity, ambiguous boundaries, and contrast variations across MRI sequences, methods relying solely on visual information or post-hoc loss constraints show unstable performance in boundary delineation and hierarchy preservation. To address this challenge, we propose the Unified Multimodal Coherent Field (UMCF) method. This method achieves synchronous interactive fusion of visual, semantic, and spatial information within a unified 3D latent space, adaptively adjusting modal contributions through parameter-free uncertainty gating, with medical prior knowledge directly participating in attention computation, avoiding the traditional \"process-then-concatenate\" separated architecture. On Brain Tumor Segmentation (BraTS) 2020 and 2021 datasets, UMCF+nnU-Net achieves average Dice coefficients of 0.8579 and 0.8977 respectively, with an average 4.18% improvement across mainstream architectures. By deeply integrating clinical knowledge with imaging features, UMCF provides a new technical pathway for multimodal information fusion in precision medicine."},{"descriptionType":"Other","description":"8 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17520","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:13:56Z","registered":"2025-09-23T03:13:57Z","published":null,"updated":"2025-09-23T03:13:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17505","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17505","identifiers":[{"identifier":"2509.17505","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tuğba Pamay","familyName":"Arslan","name":"Arslan, Tuğba Pamay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emircan","familyName":"Erol","name":"Erol, Emircan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gülşen","familyName":"Eryiğit","name":"Eryiğit, Gülşen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CorefInst: Leveraging LLMs for Multilingual Coreference Resolution"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:35:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:19:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Coreference Resolution (CR) is a crucial yet challenging task in natural language understanding, often constrained by task-specific architectures and encoder-based language models that demand extensive training and lack adaptability. This study introduces the first multilingual CR methodology which leverages decoder-only LLMs to handle both overt and zero mentions. The article explores how to model the CR task for LLMs via five different instruction sets using a controlled inference method. The approach is evaluated across three LLMs; Llama 3.1, Gemma 2, and Mistral 0.3. The results indicate that LLMs, when instruction-tuned with a suitable instruction set, can surpass state-of-the-art task-specific architectures. Specifically, our best model, a fully fine-tuned Llama 3.1 for multilingual CR, outperforms the leading multilingual CR model (i.e., Corpipe 24 single stage variant) by 2 pp on average across all languages in the CorefUD v1.2 dataset collection."},{"descriptionType":"Other","description":"Accepted for publication in Transactions of the Association for Computational Linguistics (TACL) (2025 August). Submission: March, 2025. Revision: July, 2025. Acceptance: August, 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17505","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:13:35Z","registered":"2025-09-23T03:13:35Z","published":null,"updated":"2025-09-23T03:13:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17493","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17493","identifiers":[{"identifier":"2509.17493","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wenhao","familyName":"Zhuang","name":"Zhuang, Wenhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Sun","name":"Sun, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobing","familyName":"Zhao","name":"Zhao, Xiaobing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Cross-Lingual Transfer through Reversible Transliteration: A Huffman-Based Approach for Low-Resource Languages"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:24:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:18:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2025.acl-long.795","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As large language models (LLMs) are trained on increasingly diverse and extensive multilingual corpora, they demonstrate cross-lingual transfer capabilities. However, these capabilities often fail to effectively extend to low-resource languages, particularly those utilizing non-Latin scripts. While transliterating low-resource languages into Latin script presents a natural solution, there currently lacks a comprehensive framework for integrating transliteration into LLMs training and deployment. Taking a pragmatic approach, this paper innovatively combines character transliteration with Huffman coding to design a complete transliteration framework. Our proposed framework offers the following advantages: 1) Compression: Reduces storage requirements for low-resource language content, achieving up to 50% reduction in file size and 50-80% reduction in token count. 2) Accuracy: Guarantees 100% lossless conversion from transliterated text back to the source language. 3) Efficiency: Eliminates the need for vocabulary expansion for low-resource languages, improving training and inference efficiency. 4) Scalability: The framework can be extended to other low-resource languages. We validate the effectiveness of our framework across multiple downstream tasks, including text classification, machine reading comprehension, and machine translation. Experimental results demonstrate that our method significantly enhances the model's capability to process low-resource languages while maintaining performance on high-resource languages. Our data and code are publicly available at https://github.com/CMLI-NLP/HuffmanTranslit."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17493","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:13:17Z","registered":"2025-09-23T03:13:18Z","published":null,"updated":"2025-09-23T03:13:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17488","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17488","identifiers":[{"identifier":"2509.17488","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shouju","familyName":"Wang","name":"Wang, Shouju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fenglin","familyName":"Yu","name":"Yu, Fenglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xirui","familyName":"Liu","name":"Liu, Xirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoting","familyName":"Qin","name":"Qin, Xiaoting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jue","familyName":"Zhang","name":"Zhang, Jue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingwei","familyName":"Lin","name":"Lin, Qingwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongmei","familyName":"Zhang","name":"Zhang, Dongmei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saravan","familyName":"Rajmohan","name":"Rajmohan, Saravan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Privacy in Action: Towards Realistic Privacy Mitigation and Evaluation for LLM-Powered Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:19:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:17:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The increasing autonomy of LLM agents in handling sensitive communications, accelerated by Model Context Protocol (MCP) and Agent-to-Agent (A2A) frameworks, creates urgent privacy challenges. While recent work reveals significant gaps between LLMs' privacy Q\u0026amp;A performance and their agent behavior, existing benchmarks remain limited to static, simplified scenarios. We present PrivacyChecker, a model-agnostic, contextual integrity based mitigation approach that effectively reduces privacy leakage from 36.08% to 7.30% on DeepSeek-R1 and from 33.06% to 8.32% on GPT-4o, all while preserving task helpfulness. We also introduce PrivacyLens-Live, transforming static benchmarks into dynamic MCP and A2A environments that reveal substantially higher privacy risks in practical. Our modular mitigation approach integrates seamlessly into agent protocols through three deployment strategies, providing practical privacy protection for the emerging agentic ecosystem. Our data and code will be made available at https://aka.ms/privacy_in_action."},{"descriptionType":"Other","description":"To appear at EMNLP 2025 (Findings)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17488","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:13:10Z","registered":"2025-09-23T03:13:11Z","published":null,"updated":"2025-09-23T03:13:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17486","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17486","identifiers":[{"identifier":"2509.17486","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lvzhou","familyName":"Luo","name":"Luo, Lvzhou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixuan","familyName":"Cao","name":"Cao, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Luo","name":"Luo, Ping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AttnComp: Attention-Guided Adaptive Context Compression for Retrieval-Augmented Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:18:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:17:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Retrieval-augmented generation improves the factual accuracy of Large Language Models (LLMs) by incorporating external context, but often suffers from irrelevant retrieved content that hinders effectiveness. Context compression addresses this issue by filtering out irrelevant information from context before LLM generation. However, existing methods struggle to adaptively adjust compression rates for different context, maintain low latency and integrate information across multiple documents. To overcome these limitations, We introduce AttnComp, an adaptive, efficient and context-aware compression framework. By leveraging the attention mechanism of LLMs to identify relevant information, AttnComp employs a Top-P compression algorithm to retain the minimal set of documents whose cumulative attention weights exceeds a predefined threshold. In addition to compression, AttnComp estimates response confidence by assessing the overall relevance of the retrieved content, enabling users to gauge response reliability. Experiments demonstrate that AttnComp outperforms existing compression methods and uncompressed baselines, achieving higher accuracy with substantial compression rates and lower latency."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025 (Findings)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17486","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:13:07Z","registered":"2025-09-23T03:13:08Z","published":null,"updated":"2025-09-23T03:13:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17482","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17482","identifiers":[{"identifier":"2509.17482","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tsung-Hsuan","familyName":"Pan","name":"Pan, Tsung-Hsuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chung-Chi","familyName":"Chen","name":"Chen, Chung-Chi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hen-Hsen","familyName":"Huang","name":"Huang, Hen-Hsen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hsin-Hsi","familyName":"Chen","name":"Chen, Hsin-Hsi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diagnosing Model Editing via Knowledge Spectrum"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:16:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:17:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Model editing, the process of efficiently modifying factual knowledge in pre-trained language models, is critical for maintaining their accuracy and relevance. However, existing editing methods often introduce unintended side effects, degrading model performance in unpredictable ways. While much research has focused on improving editing algorithms, the role of the target knowledge's intrinsic properties remains a significant, underexplored factor. This paper addresses this gap by first proposing the ``Knowledge Spectrum,'' a systematic framework for categorizing knowledge based on its real-world popularity, the model's pre-edit familiarity, and the linguistic structure of the eliciting question. Our empirical analysis reveals that these characteristics are strong predictors of editing success and stability. Informed by these findings, we introduce the ``Knowledge-Diagnostic Framework,'' an adaptive strategy that tailors editing intensity to the diagnosed difficulty of a knowledge item. We demonstrate that this framework significantly improves success rates for challenging edits while optimizing computational resources. Our work provides a more comprehensive understanding of the factors governing model editing."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17482","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:13:02Z","registered":"2025-09-23T03:13:02Z","published":null,"updated":"2025-09-23T03:13:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17481","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17481","identifiers":[{"identifier":"2509.17481","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xingqi","familyName":"Wang","name":"Wang, Xingqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiming","familyName":"Cui","name":"Cui, Yiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Yao","name":"Yao, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijin","familyName":"Wang","name":"Wang, Shijin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoping","familyName":"Hu","name":"Hu, Guoping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyu","familyName":"Qin","name":"Qin, Xiaoyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ChartHal: A Fine-grained Framework Evaluating Hallucination of Large Vision Language Models in Chart Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:15:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:17:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Vision-Language Models (LVLMs) have recently demonstrated remarkable progress, yet hallucination remains a critical barrier, particularly in chart understanding, which requires sophisticated perceptual and cognitive abilities as well as rigorous factual accuracy. While prior work has investigated hallucinations and chart comprehension independently, their intersection remains largely unexplored. To address this gap, we present ChartHal, a benchmark that features a fine-grained taxonomy of hallucination scenarios in chart understanding, along with a human-validated dataset of 1,062 samples. Our evaluation shows that state-of-the-art LVLMs suffer from severe hallucinations on ChartHal, including proprietary models such as GPT-5 and o4-mini, which achieve only 34.46% and 22.79% accuracy, respectively. Further analysis reveals that questions involving information absent from or contradictory to charts are especially likely to trigger hallucinations, underscoring the urgent need for more robust mitigation strategies. Code and data are available at https://github.com/ymcui/ChartHal ."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17481","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:13:00Z","registered":"2025-09-23T03:13:01Z","published":null,"updated":"2025-09-23T03:13:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17476","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17476","identifiers":[{"identifier":"2509.17476","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mallikarjun B.","familyName":"R.","name":"R., Mallikarjun B.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Yin","name":"Yin, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vikram","familyName":"Voleti","name":"Voleti, Vikram","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nikita","familyName":"Drobyshev","name":"Drobyshev, Nikita","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maksim","familyName":"Lapin","name":"Lapin, Maksim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aaryaman","familyName":"Vasishta","name":"Vasishta, Aaryaman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Varun","familyName":"Jampani","name":"Jampani, Varun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Stable Video-Driven Portraits"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:11:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:17:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Portrait animation aims to generate photo-realistic videos from a single source image by reenacting the expression and pose from a driving video. While early methods relied on 3D morphable models or feature warping techniques, they often suffered from limited expressivity, temporal inconsistency, and poor generalization to unseen identities or large pose variations. Recent advances using diffusion models have demonstrated improved quality but remain constrained by weak control signals and architectural limitations. In this work, we propose a novel diffusion based framework that leverages masked facial regions specifically the eyes, nose, and mouth from the driving video as strong motion control cues. To enable robust training without appearance leakage, we adopt cross identity supervision. To leverage the strong prior from the pretrained diffusion model, our novel architecture introduces minimal new parameters that converge faster and help in better generalization. We introduce spatial temporal attention mechanisms that allow inter frame and intra frame interactions, effectively capturing subtle motions and reducing temporal artifacts. Our model uses history frames to ensure continuity across segments. At inference, we propose a novel signal fusion strategy that balances motion fidelity with identity preservation. Our approach achieves superior temporal consistency and accurate expression control, enabling high-quality, controllable portrait animation suitable for real-world applications."},{"descriptionType":"Other","description":"https://stable-video-driven-portraits.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17476","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:12:53Z","registered":"2025-09-23T03:12:54Z","published":null,"updated":"2025-09-23T03:12:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17461","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17461","identifiers":[{"identifier":"2509.17461","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuhao","familyName":"Zhang","name":"Zhang, Yuhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengjun","familyName":"Zhang","name":"Zhang, Chengjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Di","familyName":"Wu","name":"Wu, Di","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Yang","name":"Yang, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohamad","familyName":"Sawan","name":"Sawan, Mohamad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CSDformer: A Conversion Method for Fully Spike-Driven Transformer"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:55:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:16:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Spike-based transformer is a novel architecture aiming to enhance the performance of spiking neural networks while mitigating the energy overhead inherent to transformers. However, methods for generating these models suffer from critical limitations: excessive training costs introduced by direct training methods, or unavoidably hardware-unfriendly operations in existing conversion methods. In this paper, we propose CSDformer, a novel conversion method for fully spike-driven transformers. We tailor a conversion-oriented transformer-based architecture and propose a new function NReLU to replace softmax in self-attention. Subsequently, this model is quantized and trained, and converted into a fully spike-driven model with temporal decomposition technique. Also, we propose delayed Integrate-andFire neurons to reduce conversion errors and improve the performance of spiking models. We evaluate CSDformer on ImageNet, CIFAR-10 and CIFAR-100 datasets and achieve 76.36% top-1 accuracy under 7 time-steps on ImageNet, demonstrating superiority over state-of-the-art models. Furthermore, CSDformer eliminates the need for training SNNs, thereby reducing training costs (reducing computational resource by 75% and accelerating training speed by 2-3$\\times$). To the best of our knowledge, this is the first fully spike-driven transformer-based model developed via conversion method, achieving high performance under ultra-low latency, while dramatically reducing both computational complexity and training overhead."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17461","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:12:32Z","registered":"2025-09-23T03:12:33Z","published":null,"updated":"2025-09-23T03:12:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17437","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17437","identifiers":[{"identifier":"2509.17437","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guizhen","familyName":"Chen","name":"Chen, Guizhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiwen","familyName":"Xu","name":"Xu, Weiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hao","familyName":"Zhang","name":"Zhang, Hao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hou Pong","familyName":"Chan","name":"Chan, Hou Pong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deli","familyName":"Zhao","name":"Zhao, Deli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anh Tuan","familyName":"Luu","name":"Luu, Anh Tuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Rong","name":"Rong, Yu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GeoPQA: Bridging the Visual Perception Gap in MLLMs for Geometric Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:28:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:15:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in reinforcement learning (RL) have enhanced the reasoning abilities of large language models (LLMs), yet the impact on multimodal LLMs (MLLMs) is limited. Particularly in vision-intensive tasks like geometric reasoning, MLLMs hallucinate frequently, leading to inaccurate reasoning. We attribute this to the perceptual bottleneck in MLLMs, which caps the benefits of reasoning training. To quantify this, we design a Geo-Perception Question-Answering (GeoPQA) benchmark, targeting basic geometric concepts and spatial relationships. Experiments on GeoPQA reveal significant shortcomings of MLLMs in visual perception, which constrain RL reward signals for effective training. To address this bottleneck, we propose a two-stage RL training framework by first enhancing the visual perception of geometric structures, then fostering reasoning capabilities. Applied to Qwen2.5-VL-3B-Instruct, our two-stage training improves geometric reasoning by 9.7% and geometric problem solving by 9.1%, compared to the direct reasoning training approach. Our method also generalizes to other vision-intensive domains like figure understanding, highlighting the importance of perceptual grounding in effective MLLM reasoning."},{"descriptionType":"Other","description":"Accepted to EMNLP2025 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17437","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:58Z","registered":"2025-09-23T03:11:59Z","published":null,"updated":"2025-09-23T03:11:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17436","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17436","identifiers":[{"identifier":"2509.17436","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tong","familyName":"Chen","name":"Chen, Tong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimu","familyName":"Wang","name":"Wang, Zimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yiyi","familyName":"Miao","name":"Miao, Yiyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoran","familyName":"Luo","name":"Luo, Haoran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanfei","familyName":"Sun","name":"Sun, Yuanfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wang","name":"Wang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengyong","familyName":"Jiang","name":"Jiang, Zhengyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Procheta","familyName":"Sen","name":"Sen, Procheta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jionglong","familyName":"Su","name":"Su, Jionglong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MedFact: A Large-scale Chinese Dataset for Evidence-based Medical Fact-checking of LLM Responses"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:26:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:15:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Medical fact-checking has become increasingly critical as more individuals seek medical information online. However, existing datasets predominantly focus on human-generated content, leaving the verification of content generated by large language models (LLMs) relatively unexplored. To address this gap, we introduce MedFact, the first evidence-based Chinese medical fact-checking dataset of LLM-generated medical content. It consists of 1,321 questions and 7,409 claims, mirroring the complexities of real-world medical scenarios. We conduct comprehensive experiments in both in-context learning (ICL) and fine-tuning settings, showcasing the capability and challenges of current LLMs on this task, accompanied by an in-depth error analysis to point out key directions for future research. Our dataset is publicly available at https://github.com/AshleyChenNLP/MedFact."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025. Camera-ready version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17436","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:57Z","registered":"2025-09-23T03:11:57Z","published":null,"updated":"2025-09-23T03:11:57Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17421","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17421","identifiers":[{"identifier":"2509.17421","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fei","familyName":"Zhao","name":"Zhao, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chengqiang","familyName":"Lu","name":"Lu, Chengqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufan","familyName":"Shen","name":"Shen, Yufan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qimeng","familyName":"Wang","name":"Wang, Qimeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yicheng","familyName":"Qian","name":"Qian, Yicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxin","familyName":"Zhang","name":"Zhang, Haoxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Gao","name":"Gao, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Wu","name":"Wu, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Hu","name":"Hu, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Wu","name":"Wu, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shangyu","familyName":"Xing","name":"Xing, Shangyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Dai","name":"Dai, Xinyu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RealBench: A Chinese Multi-image Understanding Benchmark Close to Real-world Scenarios"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:14:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:14:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"While various multimodal multi-image evaluation datasets have been emerged, but these datasets are primarily based on English, and there has yet to be a Chinese multi-image dataset. To fill this gap, we introduce RealBench, the first Chinese multimodal multi-image dataset, which contains 9393 samples and 69910 images. RealBench distinguishes itself by incorporating real user-generated content, ensuring high relevance to real-world applications. Additionally, the dataset covers a wide variety of scenes, image resolutions, and image structures, further increasing the difficulty of multi-image understanding. Ultimately, we conduct a comprehensive evaluation of RealBench using 21 multimodal LLMs of different sizes, including closed-source models that support multi-image inputs as well as open-source visual and video models. The experimental results indicate that even the most powerful closed-source models still face challenges when handling multi-image Chinese scenarios. Moreover, there remains a noticeable performance gap of around 71.8\\% on average between open-source visual/video models and closed-source models. These results show that RealBench provides an important research foundation for further exploring multi-image understanding capabilities in the Chinese context."},{"descriptionType":"Other","description":"Findings of EMNLP 2025 camera-ready"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17421","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:36Z","registered":"2025-09-23T03:11:37Z","published":null,"updated":"2025-09-23T03:11:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17418","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17418","identifiers":[{"identifier":"2509.17418","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junhong","familyName":"Liang","name":"Liang, Junhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bojun","familyName":"Zhang","name":"Zhang, Bojun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Vision Language Models Are Not (Yet) Spelling Correctors"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:10:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:14:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Spelling correction from visual input poses unique challenges for vision language models (VLMs), as it requires not only detecting but also correcting textual errors directly within images. We present ReViCo (Real Visual Correction), the first benchmark that systematically evaluates VLMs on real-world visual spelling correction across Chinese and English. ReViCo contains naturally occurring errors collected from real-world image data and supports fine-grained evaluation at both image and token levels. Through comprehensive experiments on representative cascaded (Qwen) and native (InternVL) open-source models, as well as closed-source systems (GPT-4o, Claude), we show that current VLMs fall significantly short of human performance, particularly in correction. To address these limitations, we explore two solution paradigms: a Joint OCR-Correction pipeline and a Background Information enhanced approach, both of which yield consistent performance gains. Our analysis highlights fundamental limitations of existing architectures and provides actionable insights for advancing multimodal spelling correction."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17418","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:32Z","registered":"2025-09-23T03:11:33Z","published":null,"updated":"2025-09-23T03:11:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17404","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17404","identifiers":[{"identifier":"2509.17404","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Wei","familyName":"Tan","name":"Tan, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shun","familyName":"Lei","name":"Lei, Shun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huaicheng","familyName":"Zhang","name":"Zhang, Huaicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangzheng","familyName":"Li","name":"Li, Guangzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yixuan","familyName":"Zhang","name":"Zhang, Yixuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangting","familyName":"Chen","name":"Chen, Hangting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianwei","familyName":"Yu","name":"Yu, Jianwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongzhi","familyName":"Gu","name":"Gu, Rongzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Yu","name":"Yu, Dong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SongPrep: A Preprocessing Framework and End-to-end Model for Full-song Structure Parsing and Lyrics Transcription"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:01:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:13:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Artificial Intelligence Generated Content (AIGC) is currently a popular research area. Among its various branches, song generation has attracted growing interest. Despite the abundance of available songs, effective data preparation remains a significant challenge. Converting these songs into training-ready datasets typically requires extensive manual labeling, which is both time consuming and costly. To address this issue, we propose SongPrep, an automated preprocessing pipeline designed specifically for song data. This framework streamlines key processes such as source separation, structure analysis, and lyric recognition, producing structured data that can be directly used to train song generation models. Furthermore, we introduce SongPrepE2E, an end-to-end structured lyrics recognition model based on pretrained language models. Without the need for additional source separation, SongPrepE2E is able to analyze the structure and lyrics of entire songs and provide precise timestamps. By leveraging context from the whole song alongside pretrained semantic knowledge, SongPrepE2E achieves low Diarization Error Rate (DER) and Word Error Rate (WER) on the proposed SSLD-200 dataset. Downstream tasks demonstrate that training song generation models with the data output by SongPrepE2E enables the generated songs to closely resemble those produced by humans."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17404","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:12Z","registered":"2025-09-23T03:11:13Z","published":null,"updated":"2025-09-23T03:11:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17397","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17397","identifiers":[{"identifier":"2509.17397","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiaqi","familyName":"Zhu","name":"Zhu, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shouyi","familyName":"Lu","name":"Lu, Shouyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyao","familyName":"Li","name":"Li, Ziyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guirong","familyName":"Zhuo","name":"Zhuo, Guirong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Xiong","name":"Xiong, Lu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Diff-GNSS: Diffusion-based Pseudorange Error Estimation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T06:57:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:13:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Global Navigation Satellite Systems (GNSS) are vital for reliable urban positioning. However, multipath and non-line-of-sight reception often introduce large measurement errors that degrade accuracy. Learning-based methods for predicting and compensating pseudorange errors have gained traction, but their performance is limited by complex error distributions. To address this challenge, we propose Diff-GNSS, a coarse-to-fine GNSS measurement (pseudorange) error estimation framework that leverages a conditional diffusion model to capture such complex distributions. Firstly, a Mamba-based module performs coarse estimation to provide an initial prediction with appropriate scale and trend. Then, a conditional denoising diffusion layer refines the estimate, enabling fine-grained modeling of pseudorange errors. To suppress uncontrolled generative diversity and achieve controllable synthesis, three key features related to GNSS measurement quality are used as conditions to precisely guide the reverse denoising process. We further incorporate per-satellite uncertainty modeling within the diffusion stage to assess the reliability of the predicted errors. We have collected and publicly released a real-world dataset covering various scenes. Experiments on public and self-collected datasets show that DiffGNSS consistently outperforms state-of-the-art baselines across multiple metrics. To the best of our knowledge, this is the first application of diffusion models to pseudorange error estimation. The proposed diffusion-based refinement module is plug-and-play and can be readily integrated into existing networks to markedly improve estimation accuracy."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17397","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:01Z","registered":"2025-09-23T03:11:02Z","published":null,"updated":"2025-09-23T03:11:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17395","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17395","identifiers":[{"identifier":"2509.17395","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianshi","familyName":"Cai","name":"Cai, Tianshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanxu","familyName":"Li","name":"Li, Guanxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nijia","familyName":"Han","name":"Han, Nijia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ce","familyName":"Huang","name":"Huang, Ce","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimu","familyName":"Wang","name":"Wang, Zimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changyu","familyName":"Zeng","name":"Zeng, Changyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Wang","name":"Wang, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingshi","familyName":"Zhou","name":"Zhou, Jingshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haiyang","familyName":"Zhang","name":"Zhang, Haiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Chen","name":"Chen, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yushan","familyName":"Pan","name":"Pan, Yushan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuihua","familyName":"Wang","name":"Wang, Shuihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wang","name":"Wang, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FinDebate: Multi-Agent Collaborative Intelligence for Financial Analysis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T06:56:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:13:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce FinDebate, a multi-agent framework for financial analysis, integrating collaborative debate with domain-specific Retrieval-Augmented Generation (RAG). Five specialized agents, covering earnings, market, sentiment, valuation, and risk, run in parallel to synthesize evidence into multi-dimensional insights. To mitigate overconfidence and improve reliability, we introduce a safe debate protocol that enables agents to challenge and refine initial conclusions while preserving coherent recommendations. Experimental results, based on both LLM-based and human evaluations, demonstrate the framework's efficacy in producing high-quality analysis with calibrated confidence levels and actionable investment strategies across multiple time horizons."},{"descriptionType":"Other","description":"Accepted at FinNLP@EMNLP 2025. Camera-ready version"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17395","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:10:59Z","registered":"2025-09-23T03:10:59Z","published":null,"updated":"2025-09-23T03:10:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17380","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17380","identifiers":[{"identifier":"2509.17380","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhizhang","familyName":"FU","name":"FU, Zhizhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangsheng","familyName":"Bao","name":"Bao, Guangsheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongbo","familyName":"Zhang","name":"Zhang, Hongbo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenkai","familyName":"Hu","name":"Hu, Chenkai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Zhang","name":"Zhang, Yue","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Correlation or Causation: Analyzing the Causal Structures of LLM and LRM Reasoning Process"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T06:44:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:13:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"LLMs suffer from critical reasoning issues such as unfaithfulness, bias, and inconsistency, since they lack robust causal underpinnings and may rely on superficial correlations rather than genuine understanding. Successive LRMs have emerged as a promising alternative, leveraging advanced training techniques such as reinforcement learning (RL) and distillation to improve task accuracy. However, the impact of these training methods on causality remains largely unexplored. In this study, we conduct a systematic causal analysis on LLMs and LRMs, examining structural causal models (SCMs) of four key variables: problem instruction (Z), thinking process (T), reasoning steps (X), and answer (Y). Our findings reveal that RLVR-trained LRMs exhibit enhanced causal reasoning capabilities, aligning more closely with ideal causal structures, while LLMs and distilled LRMs fail to address causality-related deficiencies. Our further investigation indicates that RLVR reduces spurious correlations and strengthens genuine causal patterns, thereby mitigating unfaithfulness and bias. In addition, our inspection on the dynamics of the RLVR training process observes a high correlation between reduced spurious features and improved causal structures, where the causal relationships consistently improve in the training process. This study contributes to the understanding of causality in reasoning models, highlights the critical role of RLVR in enhancing causal reasoning, and provides insights for designing future AI systems with stronger causal foundations. We release our code and data at https://github.com/Harryking1999/CoT_Causal_Analysis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17380","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:10:37Z","registered":"2025-09-23T03:10:37Z","published":null,"updated":"2025-09-23T03:10:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17367","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17367","identifiers":[{"identifier":"2509.17367","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoyang","familyName":"Chen","name":"Chen, Haoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kumiko","familyName":"Tanaka-Ishii","name":"Tanaka-Ishii, Kumiko","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Scale-free Characteristics of Multilingual Legal Texts and the Limitations of LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T05:34:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:11:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1007/978-3-032-02551-7_10","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present a comparative analysis of text complexity across domains using scale-free metrics. We quantify linguistic complexity via Heaps' exponent $β$ (vocabulary growth), Taylor's exponent $α$ (word-frequency fluctuation scaling), compression rate $r$ (redundancy), and entropy. Our corpora span three domains: legal documents (statutes, cases, deeds) as a specialized domain, general natural language texts (literature, Wikipedia), and AI-generated (GPT) text. We find that legal texts exhibit slower vocabulary growth (lower $β$) and higher term consistency (higher $α$) than general texts. Within legal domain, statutory codes have the lowest $β$ and highest $α$, reflecting strict drafting conventions, while cases and deeds show higher $β$ and lower $α$. In contrast, GPT-generated text shows the statistics more aligning with general language patterns. These results demonstrate that legal texts exhibit domain-specific structures and complexities, which current generative models do not fully replicate."},{"descriptionType":"Other","description":"to be published in Text, Speech, and Dialogue (TSD 2025)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17367","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:10:19Z","registered":"2025-09-23T03:10:19Z","published":null,"updated":"2025-09-23T03:10:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":440,"totalPages":18,"page":11},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=11\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=12\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%