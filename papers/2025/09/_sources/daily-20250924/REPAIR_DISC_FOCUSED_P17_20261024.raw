{"data":[{"id":"10.48550/arxiv.2509.16487","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16487","identifiers":[{"identifier":"2509.16487","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zixun","familyName":"Chen","name":"Chen, Zixun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Petr","familyName":"Babkin","name":"Babkin, Petr","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Akshat","familyName":"Gupta","name":"Gupta, Akshat","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gopala","familyName":"Anumanchipalli","name":"Anumanchipalli, Gopala","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaomo","familyName":"Liu","name":"Liu, Xiaomo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Oracle Has Spoken: A Multi-Aspect Evaluation of Dialogue in Pythia"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T01:11:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:13:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Dialogue is one of the landmark abilities of large language models (LLMs). Despite its ubiquity, few studies actually distinguish specific ingredients underpinning dialogue behavior emerging during post-training. We employ a comprehensive suite of model-based metrics, each targeting a distinct fine-grained aspect of dialogue, motivated by linguistic theory. We evaluate how the performance of pre-trained Pythia models changes with respect to each of those dimensions, depending on model size and as a result of supervised fine-tuning on conversational datasets. We observe only a mild impact of raw model size on most metrics, whereas fine-tuning quickly saturates the scores for all but the smallest models tested. Somewhat contrary to our expectations, many metrics show very similar trends, especially if they are all rooted in the same evaluator model, which raises the question of their reliability in measuring a specific dimension. To that end, we conduct additional analyses of score distributions, metric correlations, and term frequencies in generated responses to help explain our observations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16487","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:49:33Z","registered":"2025-09-23T02:49:34Z","published":null,"updated":"2025-09-23T02:49:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16476","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16476","identifiers":[{"identifier":"2509.16476","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qinyu","familyName":"Chen","name":"Chen, Qinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawen","familyName":"Qi","name":"Qi, Jiawen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Eye Gaze Tells You Where to Compute: Gaze-Driven Efficient VLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T00:16:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:12:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Vision-Language Models (VLMs) deliver impressive performance in understanding visual content with language instructions. However, redundancy in vision tokens results in the degenerated inference efficiency of VLMs, which hinders real-time use on edge consumer devices such as AR/VR devices. Existing efficiency methods commonly prune visual tokens using learned saliency, sparse attention schedules, or controller policies, but they often require architectural modification or access to intermediate activations. These pipelines add inference-time modules that increase compute and memory and often lead to an accuracy trade-off. Moreover, they also suffer from misalignment between the prompts and the region of interest in the images. Without human guidance, the model may focus on the wrong regions and miss small, high-frequency details when prompts or scenes change. In this paper, we propose GazeVLM, a training-free framework that uses the human eye gaze as a natural supervisory signal to allocate computation where it matters. By extracting gaze-driven regions of interest (ROIs) and optionally combining them with a low-resolution global view, GazeVLM mimics fovea-periphery perception to cut redundant visual tokens while preserving task-relevant details. We evaluate the visual question answering tasks on Qwen2.5-VL-3B/7B on the VOILA-COCO benchmark with human gaze. Quality of the answer is assessed by GPT-4o pairwise judging and a weighted score over coverage, accuracy, details, and fluency. Efficiency is measured by token counts and FLOPs. GazeVLM reduces visual tokens by up to 93.1%, total tokens by up to 59.6%, and FLOPs by 50%, while keeping better answer quality relative to full-resolution baselines. Our results show that aligning model computation with human gaze offers a simple, plug-and-play path toward efficient VLM inference on consumer devices."},{"descriptionType":"Other","description":"11 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16476","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:49:18Z","registered":"2025-09-23T02:49:19Z","published":null,"updated":"2025-09-23T02:49:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16475","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16475","identifiers":[{"identifier":"2509.16475","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianchun","familyName":"Li","name":"Li, Tianchun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianci","familyName":"Liu","name":"Liu, Tianci","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingchen","familyName":"Wang","name":"Wang, Xingchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rongzhe","familyName":"Wei","name":"Wei, Rongzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pan","familyName":"Li","name":"Li, Pan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Su","name":"Su, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Gao","name":"Gao, Jing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Universal Debiasing for Language Models-based Tabular Data Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T00:06:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:12:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have achieved promising results in tabular data generation. However, inherent historical biases in tabular datasets often cause LLMs to exacerbate fairness issues, particularly when multiple advantaged and protected features are involved. In this work, we introduce a universal debiasing framework that minimizes group-level dependencies by simultaneously reducing the mutual information between advantaged and protected attributes. By leveraging the autoregressive structure and analytic sampling distributions of LLM-based tabular data generators, our approach efficiently computes mutual information, reducing the need for cumbersome numerical estimations. Building on this foundation, we propose two complementary methods: a direct preference optimization (DPO)-based strategy, namely UDF-DPO, that integrates seamlessly with existing models, and a targeted debiasing technique, namely UDF-MIX, that achieves debiasing without tuning the parameters of LLMs. Extensive experiments demonstrate that our framework effectively balances fairness and utility, offering a scalable and practical solution for debiasing in high-stakes applications."},{"descriptionType":"Other","description":"EMNLP 2025 Findings"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16475","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:49:17Z","registered":"2025-09-23T02:49:18Z","published":null,"updated":"2025-09-23T02:49:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16457","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16457","identifiers":[{"identifier":"2509.16457","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunzhe","familyName":"Wang","name":"Wang, Yunzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gale M.","familyName":"Lucas","name":"Lucas, Gale M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Burcin","familyName":"Becerik-Gerber","name":"Becerik-Gerber, Burcin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Volkan","familyName":"Ustun","name":"Ustun, Volkan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Implicit Behavioral Alignment of Language Agents in High-Stakes Crowd Simulations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T22:35:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:11:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Language-driven generative agents have enabled large-scale social simulations with transformative uses, from interpersonal training to aiding global policy-making. However, recent studies indicate that generative agent behaviors often deviate from expert expectations and real-world data--a phenomenon we term the Behavior-Realism Gap. To address this, we introduce a theoretical framework called Persona-Environment Behavioral Alignment (PEBA), formulated as a distribution matching problem grounded in Lewin's behavior equation stating that behavior is a function of the person and their environment. Leveraging PEBA, we propose PersonaEvolve (PEvo), an LLM-based optimization algorithm that iteratively refines agent personas, implicitly aligning their collective behaviors with realistic expert benchmarks within a specified environmental context. We validate PEvo in an active shooter incident simulation we developed, achieving an 84% average reduction in distributional divergence compared to no steering and a 34% improvement over explicit instruction baselines. Results also show PEvo-refined personas generalize to novel, related simulation scenarios. Our method greatly enhances behavioral realism and reliability in high-stakes social simulations. More broadly, the PEBA-PEvo framework provides a principled approach to developing trustworthy LLM-driven social simulations."},{"descriptionType":"Other","description":"Proceedings of the 2025 Conference on Empirical Methods in Natural Language Processing (EMNLP 2025), Main Conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16457","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:51Z","registered":"2025-09-23T02:48:51Z","published":null,"updated":"2025-09-23T02:48:51Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16452","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16452","identifiers":[{"identifier":"2509.16452","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Son Hai","familyName":"Nguyen","name":"Nguyen, Son Hai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Diwei","familyName":"Wang","name":"Wang, Diwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinhyeok","familyName":"Jang","name":"Jang, Jinhyeok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyewon","familyName":"Seo","name":"Seo, Hyewon","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"KRAST: Knowledge-Augmented Robotic Action Recognition with Structured Text for Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T22:12:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:10:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate vision-based action recognition is crucial for developing autonomous robots that can operate safely and reliably in complex, real-world environments. In this work, we advance video-based recognition of indoor daily actions for robotic perception by leveraging vision-language models (VLMs) enriched with domain-specific knowledge. We adapt a prompt-learning framework in which class-level textual descriptions of each action are embedded as learnable prompts into a frozen pre-trained VLM backbone. Several strategies for structuring and encoding these textual descriptions are designed and evaluated. Experiments on the ETRI-Activity3D dataset demonstrate that our method, using only RGB video inputs at test time, achieves over 95\\% accuracy and outperforms state-of-the-art approaches. These results highlight the effectiveness of knowledge-augmented prompts in enabling robust action recognition with minimal supervision."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16452","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:44Z","registered":"2025-09-23T02:48:44Z","published":null,"updated":"2025-09-23T02:48:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16446","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16446","identifiers":[{"identifier":"2509.16446","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ruohan","familyName":"Zhang","name":"Zhang, Ruohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiacheng","familyName":"Li","name":"Li, Jiacheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julian","familyName":"McAuley","name":"McAuley, Julian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yupeng","familyName":"Hou","name":"Hou, Yupeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Purely Semantic Indexing for LLM-based Generative Recommendation and Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T21:59:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:10:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Semantic identifiers (IDs) have proven effective in adapting large language models for generative recommendation and retrieval. However, existing methods often suffer from semantic ID conflicts, where semantically similar documents (or items) are assigned identical IDs. A common strategy to avoid conflicts is to append a non-semantic token to distinguish them, which introduces randomness and expands the search space, therefore hurting performance. In this paper, we propose purely semantic indexing to generate unique, semantic-preserving IDs without appending non-semantic tokens. We enable unique ID assignment by relaxing the strict nearest-centroid selection and introduce two model-agnostic algorithms: exhaustive candidate matching (ECM) and recursive residual searching (RRS). Extensive experiments on sequential recommendation, product search, and document retrieval tasks demonstrate that our methods improve both overall and cold-start performance, highlighting the effectiveness of ensuring ID uniqueness."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16446","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:35Z","registered":"2025-09-23T02:48:36Z","published":null,"updated":"2025-09-23T02:48:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16443","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16443","identifiers":[{"identifier":"2509.16443","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ryan","familyName":"Tomich","name":"Tomich, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhizhen","familyName":"Zhong","name":"Zhong, Zhizhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dirk","familyName":"Englund","name":"Englund, Dirk","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LightCode: Compiling LLM Inference for Photonic-Electronic Systems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Applied Physics (physics.app-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Programming Languages (cs.PL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T21:45:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:10:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The growing demand for low-latency, energy-efficient inference in large language models (LLMs) has catalyzed interest in heterogeneous architectures. While GPUs remain dominant, they are poorly suited for integration with emerging domain-specific accelerators like the Photonic Tensor Units (PTUs), which offer low-power, high-throughput linear computation. This motivates hybrid compilation strategies that combine photonic and electronic resources. We present LightCode, a compiler framework and simulator for mapping LLM inference workloads across hybrid photonic-electronic systems. LightCode introduces the Stacked Graph, an intermediate representation that encodes multiple hardware-specific realizations of each tensor operation. Hardware assignment is formulated as a constrained subgraph selection problem optimized for latency or energy under parametric cost models. We evaluate LightCode on the prefill stage of GPT-2 and Llama-7B showing that under our workload and hardware assumptions, (i) Photonic hardware reduced energy by up to 50% in our simulated workloads at maximum sequence length; (ii) multiplexing and assignment strategy yielded latency improvements exceeding 10x; and (iii) Optimizing for latency or energy resulted in distinct hardware mappings in our simulations. LightCode offers a module, foundational framework and simulator for compiling LLMs to emerging photonic accelerators."},{"descriptionType":"Other","description":"9 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16443","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:31Z","registered":"2025-09-23T02:48:32Z","published":null,"updated":"2025-09-23T02:48:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16442","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16442","identifiers":[{"identifier":"2509.16442","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pranjal A.","familyName":"Chitale","name":"Chitale, Pranjal A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bishal","familyName":"Santra","name":"Santra, Bishal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yashoteja","familyName":"Prabhu","name":"Prabhu, Yashoteja","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Amit","familyName":"Sharma","name":"Sharma, Amit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating the Effectiveness and Scalability of LLM-Based Data Augmentation for Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T21:43:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:10:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Compact dual-encoder models are widely used for retrieval owing to their efficiency and scalability. However, such models often underperform compared to their Large Language Model (LLM)-based retrieval counterparts, likely due to their limited world knowledge. While LLM-based data augmentation has been proposed as a strategy to bridge this performance gap, there is insufficient understanding of its effectiveness and scalability to real-world retrieval problems. Existing research does not systematically explore key factors such as the optimal augmentation scale, the necessity of using large augmentation models, and whether diverse augmentations improve generalization, particularly in out-of-distribution (OOD) settings. This work presents a comprehensive study of the effectiveness of LLM augmentation for retrieval, comprising over 100 distinct experimental settings of retrieval models, augmentation models and augmentation strategies. We find that, while augmentation enhances retrieval performance, its benefits diminish beyond a certain augmentation scale, even with diverse augmentation strategies. Surprisingly, we observe that augmentation with smaller LLMs can achieve performance competitive with larger augmentation models. Moreover, we examine how augmentation effectiveness varies with retrieval model pre-training, revealing that augmentation provides the most benefit to models which are not well pre-trained. Our insights pave the way for more judicious and efficient augmentation strategies, thus enabling informed decisions and maximizing retrieval performance while being more cost-effective. Code and augmented datasets accompanying this work are publicly available at https://aka.ms/DAGR."},{"descriptionType":"Other","description":"EMNLP 2025 (MAIN Conference)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16442","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:30Z","registered":"2025-09-23T02:48:30Z","published":null,"updated":"2025-09-23T02:48:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16438","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16438","identifiers":[{"identifier":"2509.16438","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohamed","familyName":"Eltahir","name":"Eltahir, Mohamed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Osamah","familyName":"Sarraj","name":"Sarraj, Osamah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Abdulrahman","familyName":"Alfrihidi","name":"Alfrihidi, Abdulrahman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taha","familyName":"Alshatiri","name":"Alshatiri, Taha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammed","familyName":"Khurd","name":"Khurd, Mohammed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammed","familyName":"Bremoo","name":"Bremoo, Mohammed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tanveer","familyName":"Hussain","name":"Hussain, Tanveer","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AutoArabic: A Three-Stage Framework for Localizing Video-Text Retrieval Benchmarks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T21:35:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:09:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Video-to-text and text-to-video retrieval are dominated by English benchmarks (e.g. DiDeMo, MSR-VTT) and recent multilingual corpora (e.g. RUDDER), yet Arabic remains underserved, lacking localized evaluation metrics. We introduce a three-stage framework, AutoArabic, utilizing state-of-the-art large language models (LLMs) to translate non-Arabic benchmarks into Modern Standard Arabic, reducing the manual revision required by nearly fourfold. The framework incorporates an error detection module that automatically flags potential translation errors with 97% accuracy. Applying the framework to DiDeMo, a video retrieval benchmark produces DiDeMo-AR, an Arabic variant with 40,144 fluent Arabic descriptions. An analysis of the translation errors is provided and organized into an insightful taxonomy to guide future Arabic localization efforts. We train a CLIP-style baseline with identical hyperparameters on the Arabic and English variants of the benchmark, finding a moderate performance gap (about 3 percentage points at Recall@1), indicating that Arabic localization preserves benchmark difficulty. We evaluate three post-editing budgets (zero/ flagged-only/ full) and find that performance improves monotonically with more post-editing, while the raw LLM output (zero-budget) remains usable. To ensure reproducibility to other languages, we made the code available at https://github.com/Tahaalshatiri/AutoArabic."},{"descriptionType":"Other","description":"Accepted at ArabicNLP 2025 (EMNLP 2025 workshop)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16438","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:24Z","registered":"2025-09-23T02:48:25Z","published":null,"updated":"2025-09-23T02:48:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16437","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16437","identifiers":[{"identifier":"2509.16437","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jina","familyName":"Suh","name":"Suh, Jina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lindy","familyName":"Le","name":"Le, Lindy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Erfan","familyName":"Shayegani","name":"Shayegani, Erfan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gonzalo","familyName":"Ramos","name":"Ramos, Gonzalo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Judith","familyName":"Amores","name":"Amores, Judith","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Desmond C.","familyName":"Ong","name":"Ong, Desmond C.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mary","familyName":"Czerwinski","name":"Czerwinski, Mary","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Javier","familyName":"Hernandez","name":"Hernandez, Javier","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SENSE-7: Taxonomy and Dataset for Measuring User Perceptions of Empathy in Sustained Human-AI Conversations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T21:32:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:09:47Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Empathy is increasingly recognized as a key factor in human-AI communication, yet conventional approaches to \"digital empathy\" often focus on simulating internal, human-like emotional states while overlooking the inherently subjective, contextual, and relational facets of empathy as perceived by users. In this work, we propose a human-centered taxonomy that emphasizes observable empathic behaviors and introduce a new dataset, Sense-7, of real-world conversations between information workers and Large Language Models (LLMs), which includes per-turn empathy annotations directly from the users, along with user characteristics, and contextual details, offering a more user-grounded representation of empathy. Analysis of 695 conversations from 109 participants reveals that empathy judgments are highly individualized, context-sensitive, and vulnerable to disruption when conversational continuity fails or user expectations go unmet. To promote further research, we provide a subset of 672 anonymized conversation and provide exploratory classification analysis, showing that an LLM-based classifier can recognize 5 levels of empathy with an encouraging average Spearman $ρ$=0.369 and Accuracy=0.487 over this set. Overall, our findings underscore the need for AI designs that dynamically tailor empathic behaviors to user contexts and goals, offering a roadmap for future research and practical development of socially attuned, human-centered artificial agents."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16437","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:23Z","registered":"2025-09-23T02:48:24Z","published":null,"updated":"2025-09-23T02:48:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16429","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16429","identifiers":[{"identifier":"2509.16429","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Itzik","familyName":"Waizman","name":"Waizman, Itzik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yakov","familyName":"Gusakov","name":"Gusakov, Yakov","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Itay","familyName":"Benou","name":"Benou, Itay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tammy Riklin","familyName":"Raviv","name":"Raviv, Tammy Riklin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TractoTransformer: Diffusion MRI Streamline Tractography using CNN and Transformer Networks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T21:10:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:09:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"White matter tractography is an advanced neuroimaging technique that reconstructs the 3D white matter pathways of the brain from diffusion MRI data. It can be framed as a pathfinding problem aiming to infer neural fiber trajectories from noisy and ambiguous measurements, facing challenges such as crossing, merging, and fanning white-matter configurations. In this paper, we propose a novel tractography method that leverages Transformers to model the sequential nature of white matter streamlines, enabling the prediction of fiber directions by integrating both the trajectory context and current diffusion MRI measurements. To incorporate spatial information, we utilize CNNs that extract microstructural features from local neighborhoods around each voxel. By combining these complementary sources of information, our approach improves the precision and completeness of neural pathway mapping compared to traditional tractography models. We evaluate our method with the Tractometer toolkit, achieving competitive performance against state-of-the-art approaches, and present qualitative results on the TractoInferno dataset, demonstrating strong generalization to real-world data."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16429","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:12Z","registered":"2025-09-23T02:48:12Z","published":null,"updated":"2025-09-23T02:48:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16422","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16422","identifiers":[{"identifier":"2509.16422","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tom","familyName":"Mackintosh","name":"Mackintosh, Tom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harish Tayyar","familyName":"Madabushi","name":"Madabushi, Harish Tayyar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claire","familyName":"Bonial","name":"Bonial, Claire","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating CxG Generalisation in LLMs via Construction-Based NLI Fine Tuning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T21:03:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:09:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We probe large language models' ability to learn deep form-meaning mappings as defined by construction grammars. We introduce the ConTest-NLI benchmark of 80k sentences covering eight English constructions from highly lexicalized to highly schematic. Our pipeline generates diverse synthetic NLI triples via templating and the application of a model-in-the-loop filter. This provides aspects of human validation to ensure challenge and label reliability. Zero-shot tests on leading LLMs reveal a 24% drop in accuracy between naturalistic (88%) and adversarial data (64%), with schematic patterns proving hardest. Fine-tuning on a subset of ConTest-NLI yields up to 9% improvement, yet our results highlight persistent abstraction gaps in current LLMs and offer a scalable framework for evaluating construction-informed learning."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16422","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:02Z","registered":"2025-09-23T02:48:03Z","published":null,"updated":"2025-09-23T02:48:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16413","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16413","identifiers":[{"identifier":"2509.16413","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Richard Diehl","familyName":"Martinez","name":"Martinez, Richard Diehl","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David Demitri","familyName":"Africa","name":"Africa, David Demitri","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuval","familyName":"Weiss","name":"Weiss, Yuval","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suchir","familyName":"Salhan","name":"Salhan, Suchir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Daniels","name":"Daniels, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paula","familyName":"Buttery","name":"Buttery, Paula","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pico: A Modular Framework for Hypothesis-Driven Small Language Model Research"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T20:55:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:08:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Building language models (LMs), especially small and medium ones, remains more art than science. While large LMs often improve by sheer scale, it is still unclear why many design choices work. For small LMs, this uncertainty is more limiting: tight parameter budgets make each decision critical, yet researchers still lack systematic, scientific ways to test and refine new ideas.\n We introduce Pico, a lightweight, modular framework that enables systematic, hypothesis-driven research for small and medium-scale language model development. Pico consists of two libraries that together provide a practical sandbox where researchers can make targeted changes to a model's architecture or training procedures and directly observe their effects on the model's behavior. To support reproducible experimentation, we also release a suite of baseline models, pico-decoder, trained under standardized conditions and open-sourced for the community. Case studies highlight how Pico can support iterative small LM design and analysis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16413","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:47:50Z","registered":"2025-09-23T02:47:50Z","published":null,"updated":"2025-09-23T02:47:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16400","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16400","identifiers":[{"identifier":"2509.16400","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huy","familyName":"Nghiem","name":"Nghiem, Huy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Phuong-Anh","familyName":"Nguyen-Le","name":"Nguyen-Le, Phuong-Anh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Prindle","name":"Prindle, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rachel","familyName":"Rudinger","name":"Rudinger, Rachel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hal","familyName":"Daumé","name":"Daumé, Hal","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"'Rich Dad, Poor Lad': How do Large Language Models Contextualize Socioeconomic Factors in College Admission ?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T20:22:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:07:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly involved in high-stakes domains, yet how they reason about socially sensitive decisions remains underexplored. We present a large-scale audit of LLMs' treatment of socioeconomic status (SES) in college admissions decisions using a novel dual-process framework inspired by cognitive science. Leveraging a synthetic dataset of 30,000 applicant profiles grounded in real-world correlations, we prompt 4 open-source LLMs (Qwen 2, Mistral v0.3, Gemma 2, Llama 3.1) under 2 modes: a fast, decision-only setup (System 1) and a slower, explanation-based setup (System 2). Results from 5 million prompts reveal that LLMs consistently favor low-SES applicants -- even when controlling for academic performance -- and that System 2 amplifies this tendency by explicitly invoking SES as compensatory justification, highlighting both their potential and volatility as decision-makers. We then propose DPAF, a dual-process audit framework to probe LLMs' reasoning behaviors in sensitive applications."},{"descriptionType":"Other","description":"EMNLP 2025, ver 1, 35 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16400","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:47:33Z","registered":"2025-09-23T02:47:33Z","published":null,"updated":"2025-09-23T02:47:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16399","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16399","identifiers":[{"identifier":"2509.16399","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guojun","familyName":"Xiong","name":"Xiong, Guojun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Milind","familyName":"Tambe","name":"Tambe, Milind","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VORTEX: Aligning Task Utility and Human Preferences through LLM-Guided Reward Shaping"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T20:22:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:07:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In social impact optimization, AI decision systems often rely on solvers that optimize well-calibrated mathematical objectives. However, these solvers cannot directly accommodate evolving human preferences, typically expressed in natural language rather than formal constraints. Recent approaches address this by using large language models (LLMs) to generate new reward functions from preference descriptions. While flexible, they risk sacrificing the system's core utility guarantees. In this paper, we propose \\texttt{VORTEX}, a language-guided reward shaping framework that preserves established optimization goals while adaptively incorporating human feedback. By formalizing the problem as multi-objective optimization, we use LLMs to iteratively generate shaping rewards based on verbal reinforcement and text-gradient prompt updates. This allows stakeholders to steer decision behavior via natural language without modifying solvers or specifying trade-off weights. We provide theoretical guarantees that \\texttt{VORTEX} converges to Pareto-optimal trade-offs between utility and preference satisfaction. Empirical results in real-world allocation tasks demonstrate that \\texttt{VORTEX} outperforms baselines in satisfying human-aligned coverage goals while maintaining high task performance. This work introduces a practical and theoretically grounded paradigm for human-AI collaborative optimization guided by natural language."},{"descriptionType":"Other","description":"28pages, 19figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16399","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:47:31Z","registered":"2025-09-23T02:47:32Z","published":null,"updated":"2025-09-23T02:47:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16397","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16397","identifiers":[{"identifier":"2509.16397","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Taqiya","familyName":"Ehsan","name":"Ehsan, Taqiya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuren","familyName":"Xia","name":"Xia, Shuren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jorge","familyName":"Ortiz","name":"Ortiz, Jorge","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"GRID: Graph-based Reasoning for Intervention and Discovery in Built Environments"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T20:19:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:07:13Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Manual HVAC fault diagnosis in commercial buildings takes 8-12 hours per incident and achieves only 60 percent diagnostic accuracy, reflecting analytics that stop at correlation instead of causation. To close this gap, we present GRID (Graph-based Reasoning for Intervention and Discovery), a three-stage causal discovery pipeline that combines constraint-based search, neural structural equation modeling, and language model priors to recover directed acyclic graphs from building sensor data. Across six benchmarks: synthetic rooms, EnergyPlus simulation, the ASHRAE Great Energy Predictor III dataset, and a live office testbed, GRID achieves F1 scores ranging from 0.65 to 1.00, with exact recovery (F1 = 1.00) in three controlled environments (Base, Hidden, Physical) and strong performance on real-world data (F1 = 0.89 on ASHRAE, 0.86 in noisy conditions). The method outperforms ten baseline approaches across all evaluation scenarios. Intervention scheduling achieves low operational impact in most scenarios (cost \u0026lt;= 0.026) while reducing risk metrics compared to baseline approaches. The framework integrates constraint-based methods, neural architectures, and domain-specific language model prompts to address the observational-causal gap in building analytics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16397","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:47:28Z","registered":"2025-09-23T02:47:29Z","published":null,"updated":"2025-09-23T02:47:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16394","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16394","identifiers":[{"identifier":"2509.16394","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Deuksin","familyName":"Kwon","name":"Kwon, Deuksin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaleen","familyName":"Shrestha","name":"Shrestha, Kaleen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Han","name":"Han, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elena Hayoung","familyName":"Lee","name":"Lee, Elena Hayoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gale","familyName":"Lucas","name":"Lucas, Gale","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating Behavioral Alignment in Conflict Dialogue: A Multi-Dimensional Comparison of LLM Agents and Humans"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T20:15:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:07:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) are increasingly deployed in socially complex, interaction-driven tasks, yet their ability to mirror human behavior in emotionally and strategically complex contexts remains underexplored. This study assesses the behavioral alignment of personality-prompted LLMs in adversarial dispute resolution by simulating multi-turn conflict dialogues that incorporate negotiation. Each LLM is guided by a matched Five-Factor personality profile to control for individual variation and enhance realism. We evaluate alignment across three dimensions: linguistic style, emotional expression (e.g., anger dynamics), and strategic behavior. GPT-4.1 achieves the closest alignment with humans in linguistic style and emotional dynamics, while Claude-3.7-Sonnet best reflects strategic behavior. Nonetheless, substantial alignment gaps persist. Our findings establish a benchmark for alignment between LLMs and humans in socially complex interactions, underscoring both the promise and the limitations of personality conditioning in dialogue modeling."},{"descriptionType":"Other","description":"Accepted to EMNLP 2025 (Main Conference)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16394","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:47:24Z","registered":"2025-09-23T02:47:25Z","published":null,"updated":"2025-09-23T02:47:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16372","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16372","identifiers":[{"identifier":"2509.16372","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Balu","familyName":"Bhasuran","name":"Bhasuran, Balu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mattia","familyName":"Prosperi","name":"Prosperi, Mattia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karim","familyName":"Hanna","name":"Hanna, Karim","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Petrilli","name":"Petrilli, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Caretia JeLayne","familyName":"Washington","name":"Washington, Caretia JeLayne","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"He","name":"He, Zhe","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluation of Causal Reasoning for Large Language Models in Contextualized Clinical Scenarios of Laboratory Test Interpretation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T19:28:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:05:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This study evaluates causal reasoning in large language models (LLMs) using 99 clinically grounded laboratory test scenarios aligned with Pearl's Ladder of Causation: association, intervention, and counterfactual reasoning. We examined common laboratory tests such as hemoglobin A1c, creatinine, and vitamin D, and paired them with relevant causal factors including age, gender, obesity, and smoking. Two LLMs - GPT-o1 and Llama-3.2-8b-instruct - were tested, with responses evaluated by four medically trained human experts. GPT-o1 demonstrated stronger discriminative performance (AUROC overall = 0.80 +/- 0.12) compared to Llama-3.2-8b-instruct (0.73 +/- 0.15), with higher scores across association (0.75 vs 0.72), intervention (0.84 vs 0.70), and counterfactual reasoning (0.84 vs 0.69). Sensitivity (0.90 vs 0.84) and specificity (0.93 vs 0.80) were also greater for GPT-o1, with reasoning ratings showing similar trends. Both models performed best on intervention questions and worst on counterfactuals, particularly in altered outcome scenarios. These findings suggest GPT-o1 provides more consistent causal reasoning, but refinement is required before adoption in high-stakes clinical applications."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16372","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:46:53Z","registered":"2025-09-23T02:46:54Z","published":null,"updated":"2025-09-23T02:46:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16369","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16369","identifiers":[{"identifier":"2509.16369","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Akshay Govind","familyName":"Srinivasan","name":"Srinivasan, Akshay Govind","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan Jacob","familyName":"George","name":"George, Ryan Jacob","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jayden Koshy","familyName":"Joe","name":"Joe, Jayden Koshy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hrushikesh","familyName":"Kant","name":"Kant, Hrushikesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harshith M","familyName":"R","name":"R, Harshith M","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sachin","familyName":"Sundar","name":"Sundar, Sachin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sudharshan","familyName":"Suresh","name":"Suresh, Sudharshan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rahul","familyName":"Vimalkanth","name":"Vimalkanth, Rahul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Organizational","affiliation":[],"name":"Vijayavallabh","nameIdentifiers":[]}],"titles":[{"title":"Enhancing Financial RAG with Agentic AI and Multi-HyDE: A Novel Approach to Knowledge Retrieval and Hallucination Reduction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.4; H.5; H.3.3","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-19T19:24:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:05:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate and reliable knowledge retrieval is vital for financial question-answering, where continually updated data sources and complex, high-stakes contexts demand precision. Traditional retrieval systems rely on a single database and retriever, but financial applications require more sophisticated approaches to handle intricate regulatory filings, market analyses, and extensive multi-year reports. We introduce a framework for financial Retrieval Augmented Generation (RAG) that leverages agentic AI and the Multi-HyDE system, an approach that generates multiple, nonequivalent queries to boost the effectiveness and coverage of retrieval from large, structured financial corpora. Our pipeline is optimized for token efficiency and multi-step financial reasoning, and we demonstrate that their combination improves accuracy by 11.2% and reduces hallucinations by 15%. Our method is evaluated on standard financial QA benchmarks, showing that integrating domain-specific retrieval mechanisms such as Multi-HyDE with robust toolsets, including keyword and table-based retrieval, significantly enhances both the accuracy and reliability of answers. This research not only delivers a modular, adaptable retrieval framework for finance but also highlights the importance of structured agent workflows and multi-perspective retrieval for trustworthy deployment of AI in high-stakes financial applications."},{"descriptionType":"Other","description":"14 Pages, 8 Tables, 2 Figures. Accepted and to be published in the proceedings of FinNLP, Empirical Methods in Natural Language Processing 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16369","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:46:49Z","registered":"2025-09-23T02:46:50Z","published":null,"updated":"2025-09-23T02:46:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16357","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16357","identifiers":[{"identifier":"2509.16357","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aniruddh","familyName":"Raghu","name":"Raghu, Aniruddh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Ober","name":"Ober, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maxwell","familyName":"Kazman","name":"Kazman, Maxwell","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hunter","familyName":"Elliott","name":"Elliott, Hunter","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Guided Sequence-Structure Generative Modeling for Iterative Antibody Optimization"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T19:03:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:04:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Therapeutic antibody candidates often require extensive engineering to improve key functional and developability properties before clinical development. This can be achieved through iterative design, where starting molecules are optimized over several rounds of in vitro experiments. While protein structure can provide a strong inductive bias, it is rarely used in iterative design due to the lack of structural data for continually evolving lead molecules over the course of optimization. In this work, we propose a strategy for iterative antibody optimization that leverages both sequence and structure as well as accumulating lab measurements of binding and developability. Building on prior work, we first train a sequence-structure diffusion generative model that operates on antibody-antigen complexes. We then outline an approach to use this model, together with carefully predicted antibody-antigen complexes, to optimize lead candidates throughout the iterative design process. Further, we describe a guided sampling approach that biases generation toward desirable properties by integrating models trained on experimental data from iterative design. We evaluate our approach in multiple in silico and in vitro experiments, demonstrating that it produces high-affinity binders at multiple stages of an active antibody optimization campaign."},{"descriptionType":"Other","description":"GEM Workshop, ICLR 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16357","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:46:33Z","registered":"2025-09-23T02:46:33Z","published":null,"updated":"2025-09-23T02:46:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16354","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16354","identifiers":[{"identifier":"2509.16354","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sivan","familyName":"Sarafian","name":"Sarafian, Sivan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yehudit","familyName":"Aperstein","name":"Aperstein, Yehudit","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Improving Deep Tabular Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T18:51:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:04:24Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Tabular data remain a dominant form of real-world information but pose persistent challenges for deep learning due to heterogeneous feature types, lack of natural structure, and limited label-preserving augmentations. As a result, ensemble models based on decision trees continue to dominate benchmark leaderboards. In this work, we introduce RuleNet, a transformer-based architecture specifically designed for deep tabular learning. RuleNet incorporates learnable rule embeddings in a decoder, a piecewise linear quantile projection for numerical features, and feature masking ensembles for robustness and uncertainty estimation. Evaluated on eight benchmark datasets, RuleNet matches or surpasses state-of-the-art tree-based methods in most cases, while remaining computationally efficient, offering a practical neural alternative for tabular prediction tasks."},{"descriptionType":"Other","description":"18 pages, 4 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16354","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:46:28Z","registered":"2025-09-23T02:46:29Z","published":null,"updated":"2025-09-23T02:46:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16348","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16348","identifiers":[{"identifier":"2509.16348","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minxiao","familyName":"Wang","name":"Wang, Minxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saurabh","familyName":"Kataria","name":"Kataria, Saurabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juntong","familyName":"Ni","name":"Ni, Juntong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timothy G.","familyName":"Buchman","name":"Buchman, Timothy G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jocelyn","familyName":"Grunwell","name":"Grunwell, Jocelyn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mark","familyName":"Mai","name":"Mai, Mark","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Jin","name":"Jin, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Clark","name":"Clark, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephanie","familyName":"Brown","name":"Brown, Stephanie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Fundora","name":"Fundora, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Puneet","familyName":"Sharma","name":"Sharma, Puneet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tony","familyName":"Pan","name":"Pan, Tony","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sam","familyName":"Khan","name":"Khan, Sam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timothy","familyName":"Ruchti","name":"Ruchti, Timothy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naveen","familyName":"Muthu","name":"Muthu, Naveen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kevin","familyName":"Maher","name":"Maher, Kevin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sivasubramanium V","familyName":"Bhavani","name":"Bhavani, Sivasubramanium V","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Hu","name":"Hu, Xiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Unified AI Approach for Continuous Monitoring of Human Health and Diseases from Intensive Care Unit to Home with Physiological Foundation Models (UNIPHY+)"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T18:40:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:04:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present UNIPHY+, a unified physiological foundation model (physioFM) framework designed to enable continuous human health and diseases monitoring across care settings using ubiquitously obtainable physiological data. We propose novel strategies for incorporating contextual information during pretraining, fine-tuning, and lightweight model personalization via multi-modal learning, feature fusion-tuning, and knowledge distillation. We advocate testing UNIPHY+ with a broad set of use cases from intensive care to ambulatory monitoring in order to demonstrate that UNIPHY+ can empower generalizable, scalable, and personalized physiological AI to support both clinical decision-making and long-term health monitoring."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16348","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:46:20Z","registered":"2025-09-23T02:46:21Z","published":null,"updated":"2025-09-23T02:46:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16345","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16345","identifiers":[{"identifier":"2509.16345","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Minxiao","familyName":"Wang","name":"Wang, Minxiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Runze","familyName":"Yan","name":"Yan, Runze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carol","familyName":"Li","name":"Li, Carol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saurabh","familyName":"Kataria","name":"Kataria, Saurabh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Hu","name":"Hu, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew","familyName":"Clark","name":"Clark, Matthew","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timothy","familyName":"Ruchti","name":"Ruchti, Timothy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Timothy G.","familyName":"Buchman","name":"Buchman, Timothy G.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sivasubramanium V","familyName":"Bhavani","name":"Bhavani, Sivasubramanium V","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Randall J.","familyName":"Lee","name":"Lee, Randall J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Estimating Clinical Lab Test Result Trajectories from PPG using Physiological Foundation Model and Patient-Aware State Space Model -- a UNIPHY+ Approach"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T18:38:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:03:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Clinical laboratory tests provide essential biochemical measurements for diagnosis and treatment, but are limited by intermittent and invasive sampling. In contrast, photoplethysmogram (PPG) is a non-invasive, continuously recorded signal in intensive care units (ICUs) that reflects cardiovascular dynamics and can serve as a proxy for latent physiological changes. We propose UNIPHY+Lab, a framework that combines a large-scale PPG foundation model for local waveform encoding with a patient-aware Mamba model for long-range temporal modeling. Our architecture addresses three challenges: (1) capturing extended temporal trends in laboratory values, (2) accounting for patient-specific baseline variation via FiLM-modulated initial states, and (3) performing multi-task estimation for interrelated biomarkers. We evaluate our method on the two ICU datasets for predicting the five key laboratory tests. The results show substantial improvements over the LSTM and carry-forward baselines in MAE, RMSE, and $R^2$ among most of the estimation targets. This work demonstrates the feasibility of continuous, personalized lab value estimation from routine PPG monitoring, offering a pathway toward non-invasive biochemical surveillance in critical care."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16345","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:46:16Z","registered":"2025-09-23T02:46:17Z","published":null,"updated":"2025-09-23T02:46:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16342","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16342","identifiers":[{"identifier":"2509.16342","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sean","familyName":"Turland","name":"Turland, Sean","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eloi","familyName":"Moliner","name":"Moliner, Eloi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vesa","familyName":"Välimäki","name":"Välimäki, Vesa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Similarity-Guided Diffusion for Long-Gap Music Inpainting"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T18:33:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:03:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Music inpainting aims to reconstruct missing segments of a corrupted recording. While diffusion-based generative models improve reconstruction for medium-length gaps, they often struggle to preserve musical plausibility over multi-second gaps. We introduce Similarity-Guided Diffusion Posterior Sampling (SimDPS), a hybrid method that combines diffusion-based inference with similarity search. Candidate segments are first retrieved from a corpus based on contextual similarity, then incorporated into a modified likelihood that guides the diffusion process toward contextually consistent reconstructions. Subjective evaluation on piano music inpainting with 2-s gaps shows that the proposed SimDPS method enhances perceptual plausibility compared to unguided diffusion and frequently outperforms similarity search alone when moderately similar candidates are available. These results demonstrate the potential of a hybrid similarity approach for diffusion-based audio enhancement with long gaps."},{"descriptionType":"Other","description":"5 pages, 2 figures. Submitted to IEEE ICASSP 2026. Audio examples and supplementary material are available at: https://s-turland.github.io/SimDPS/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16342","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:46:12Z","registered":"2025-09-23T02:46:13Z","published":null,"updated":"2025-09-23T02:46:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16332","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16332","identifiers":[{"identifier":"2509.16332","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Stephen","familyName":"Fitz","name":"Fitz, Stephen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Romero","name":"Romero, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Steven","familyName":"Basart","name":"Basart, Steven","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sipeng","familyName":"Chen","name":"Chen, Sipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jose","familyName":"Hernandez-Orallo","name":"Hernandez-Orallo, Jose","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Psychometric Personality Shaping Modulates Capabilities and Safety in Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T18:19:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:03:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models increasingly mediate high-stakes interactions, intensifying research on their capabilities and safety. While recent work has shown that LLMs exhibit consistent and measurable synthetic personality traits, little is known about how modulating these traits affects model behavior. We address this gap by investigating how psychometric personality control grounded in the Big Five framework influences AI behavior in the context of capability and safety benchmarks. Our experiments reveal striking effects: for example, reducing conscientiousness leads to significant drops in safety-relevant metrics on benchmarks such as WMDP, TruthfulQA, ETHICS, and Sycophancy as well as reduction in general capabilities as measured by MMLU. These findings highlight personality shaping as a powerful and underexplored axis of model control that interacts with both safety and general competence. We discuss the implications for safety evaluation, alignment strategies, steering model behavior after deployment, and risks associated with possible exploitation of these findings. Our findings motivate a new line of research on personality-sensitive safety evaluations and dynamic behavioral control in LLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16332","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:45:58Z","registered":"2025-09-23T02:45:58Z","published":null,"updated":"2025-09-23T02:45:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":440,"totalPages":18,"page":17},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=17\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=18\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision