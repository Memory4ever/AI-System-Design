{"data":[{"id":"10.48550/arxiv.2509.17850","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17850","identifiers":[{"identifier":"2509.17850","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiao","familyName":"Zhou","name":"Zhou, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zengqi","familyName":"Peng","name":"Peng, Zengqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Ma","name":"Ma, Jun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SocialTraj: Two-Stage Socially-Aware Trajectory Prediction for Autonomous Driving via Conditional Diffusion Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:42:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:39:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate trajectory prediction of surrounding vehicles (SVs) is crucial for autonomous driving systems to avoid misguided decisions and potential accidents. However, achieving reliable predictions in highly dynamic and complex traffic scenarios remains a significant challenge. One of the key impediments lies in the limited effectiveness of current approaches to capture the multi-modal behaviors of drivers, which leads to predicted trajectories that deviate from actual future motions. To address this issue, we propose SocialTraj, a novel trajectory prediction framework integrating social psychology principles through social value orientation (SVO). By utilizing Bayesian inverse reinforcement learning (IRL) to estimate the SVO of SVs, we obtain the critical social context to infer the future interaction trend. To ensure modal consistency in predicted behaviors, the estimated SVOs of SVs are embedded into a conditional denoising diffusion model that aligns generated trajectories with historical driving styles. Additionally, the planned future trajectory of the ego vehicle (EV) is explicitly incorporated to enhance interaction modeling. Extensive experiments on NGSIM and HighD datasets demonstrate that SocialTraj is capable of adapting to highly dynamic and interactive scenarios while generating socially compliant and behaviorally consistent trajectory predictions, outperforming existing baselines. Ablation studies demonstrate that dynamic SVO estimation and explicit ego-planning components notably improve prediction accuracy and substantially reduce inference time."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17850","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:21:44Z","registered":"2025-09-23T03:21:44Z","published":null,"updated":"2025-09-23T03:21:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17845","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17845","identifiers":[{"identifier":"2509.17845","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kai","familyName":"Zhang","name":"Zhang, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siming","familyName":"Sun","name":"Sun, Siming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengyu","familyName":"Fan","name":"Fan, Zhengyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinmin","familyName":"Yang","name":"Yang, Qinmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuejun","familyName":"Jiang","name":"Jiang, Xuejun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conv-like Scale-Fusion Time Series Transformer: A Multi-Scale Representation for Variable-Length Long Time Series"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:37:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:38:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Time series analysis faces significant challenges in handling variable-length data and achieving robust generalization. While Transformer-based models have advanced time series tasks, they often struggle with feature redundancy and limited generalization capabilities. Drawing inspiration from classical CNN architectures' pyramidal structure, we propose a Multi-Scale Representation Learning Framework based on a Conv-like ScaleFusion Transformer. Our approach introduces a temporal convolution-like structure that combines patching operations with multi-head attention, enabling progressive temporal dimension compression and feature channel expansion. We further develop a novel cross-scale attention mechanism for effective feature fusion across different temporal scales, along with a log-space normalization method for variable-length sequences. Extensive experiments demonstrate that our framework achieves superior feature independence, reduced redundancy, and better performance in forecasting and classification tasks compared to state-of-the-art methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17845","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:21:37Z","registered":"2025-09-23T03:21:37Z","published":null,"updated":"2025-09-23T03:21:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17834","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17834","identifiers":[{"identifier":"2509.17834","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Duygu","familyName":"Kabakci-Zorlu","name":"Kabakci-Zorlu, Duygu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio","familyName":"Lorenzi","name":"Lorenzi, Fabio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"John","familyName":"Sheehan","name":"Sheehan, John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Karol","familyName":"Lynch","name":"Lynch, Karol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bradley","familyName":"Eck","name":"Eck, Bradley","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Documents to Database: Failure Modes for Industrial Assets"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:23:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:38:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose an interactive system using foundation models and user-provided technical documents to generate Failure Mode and Effects Analyses (FMEA) for industrial equipment. Our system aggregates unstructured content across documents to generate an FMEA and stores it in a relational database. Leveraging this tool, the time required for creation of this knowledge-intensive content is reduced, outperforming traditional manual approaches. This demonstration showcases the potential of foundation models to facilitate the creation of specialized structured content for enterprise asset management systems."},{"descriptionType":"Other","description":"7 pages, 4 figures. Artificial Intelligence for Knowledge Acquisition \u0026amp; Management (AI4KAM) Workshop @ IJCAI 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17834","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:21:22Z","registered":"2025-09-23T03:21:23Z","published":null,"updated":"2025-09-23T03:21:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17832","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17832","identifiers":[{"identifier":"2509.17832","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xiangmin","familyName":"Shen","name":"Shen, Xiangmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenyuan","familyName":"Cheng","name":"Cheng, Wenyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yan","familyName":"Chen","name":"Chen, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenyuan","familyName":"Li","name":"Li, Zhenyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqiao","familyName":"Gu","name":"Gu, Yuqiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingzhi","familyName":"Wang","name":"Wang, Lingzhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wencheng","familyName":"Zhao","name":"Zhao, Wencheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dawei","familyName":"Sun","name":"Sun, Dawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiashui","familyName":"Wang","name":"Wang, Jiashui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AEAS: Actionable Exploit Assessment System"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:23:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:38:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Security practitioners face growing challenges in exploit assessment, as public vulnerability repositories are increasingly populated with inconsistent and low-quality exploit artifacts. Existing scoring systems, such as CVSS and EPSS, offer limited support for this task. They either rely on theoretical metrics or produce opaque probability estimates without assessing whether usable exploit code exists. In practice, security teams often resort to manual triage of exploit repositories, which is time-consuming, error-prone, and difficult to scale. We present AEAS, an automated system designed to assess and prioritize actionable exploits through static analysis. AEAS analyzes both exploit code and associated documentation to extract a structured set of features reflecting exploit availability, functionality, and setup complexity. It then computes an actionability score for each exploit and produces ranked exploit recommendations. We evaluate AEAS on a dataset of over 5,000 vulnerabilities derived from 600+ real-world applications frequently encountered by red teams. Manual validation and expert review on representative subsets show that AEAS achieves a 100% top-3 success rate in recommending functional exploits and shows strong alignment with expert-validated rankings. These results demonstrate the effectiveness of AEAS in supporting exploit-driven vulnerability prioritization."},{"descriptionType":"Other","description":"AEAS has been implemented in the planning agent of PentestAgent, our LLM-driven automated penetration testing framework. Check out our repository: https://github.com/nbshenxm/pentest-agent"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17832","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:21:19Z","registered":"2025-09-23T03:21:20Z","published":null,"updated":"2025-09-23T03:21:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17809","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17809","identifiers":[{"identifier":"2509.17809","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuhan","familyName":"Zhong","name":"Zhong, Shuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weipeng","familyName":"Zhuo","name":"Zhuo, Weipeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sizhe","familyName":"Song","name":"Song, Sizhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guanyao","familyName":"Li","name":"Li, Guanyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongyi","familyName":"Yu","name":"Yu, Zhongyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. -H. Gary","familyName":"Chan","name":"Chan, S. -H. Gary","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MTM: A Multi-Scale Token Mixing Transformer for Irregular Multivariate Time Series Classification"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:03:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:36:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3711896.3737058","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Irregular multivariate time series (IMTS) is characterized by the lack of synchronized observations across its different channels. In this paper, we point out that this channel-wise asynchrony can lead to poor channel-wise modeling of existing deep learning methods. To overcome this limitation, we propose MTM, a multi-scale token mixing transformer for the classification of IMTS. We find that the channel-wise asynchrony can be alleviated by down-sampling the time series to coarser timescales, and propose to incorporate a masked concat pooling in MTM that gradually down-samples IMTS to enhance the channel-wise attention modules. Meanwhile, we propose a novel channel-wise token mixing mechanism which proactively chooses important tokens from one channel and mixes them with other channels, to further boost the channel-wise learning of our model. Through extensive experiments on real-world datasets and comparison with state-of-the-art methods, we demonstrate that MTM consistently achieves the best performance on all the benchmarks, with improvements of up to 3.8% in AUPRC for classification."},{"descriptionType":"Other","description":"KDD 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17809","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:20:46Z","registered":"2025-09-23T03:20:47Z","published":null,"updated":"2025-09-23T03:20:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17793","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17793","identifiers":[{"identifier":"2509.17793","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qian","familyName":"Luo","name":"Luo, Qian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aiguo","familyName":"Xiao","name":"Xiao, Aiguo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoqiang","familyName":"Yan","name":"Yan, Xiaoqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingmin","familyName":"Xia","name":"Xia, Jingmin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Solving time-fractional diffusion equations with Robin boundary conditions via fractional Hamiltonian boundary value methods"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Numerical Analysis (math.NA)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:51:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:35:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we propose a novel numerical scheme for solving time-fractional reaction-diffusion problems with Robin boundary conditions, where the time derivative is in the Caputo sense of order $α\\in(0,1)$. The existence and uniqueness of the solution is proved. Our proposed method is based on the spectral collocation method in space and Fractional Hamiltonian boundary value methods in time. For the considered spectral collocation method, the basis functions used are not the standard polynomial basis functions, but rather adapt to Robin boundary conditions, and the exponential convergence property is provided. The proposed procedure achieves spectral accuracy in space and is also capable of getting spectral accuracy in time. Some numerical examples are provided to support the theoretical results."},{"descriptionType":"Other","description":"26 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17793","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:20:24Z","registered":"2025-09-23T03:20:24Z","published":null,"updated":"2025-09-23T03:20:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17791","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17791","identifiers":[{"identifier":"2509.17791","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Robert","familyName":"Hu","name":"Hu, Robert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Carlo","familyName":"Luschi","name":"Luschi, Carlo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Balanca","name":"Balanca, Paul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Elucidating the Design Space of FP4 training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:50:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:35:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The increasing computational demands of foundation models have spurred research into low-precision training, with 4-bit floating-point (\\texttt{FP4}) formats emerging as a frontier for maximizing hardware throughput. While numerous techniques have been proposed to stabilize \\texttt{FP4} training, they often present isolated solutions with varying, and not always clear, computational overheads. This paper aims to provide a unified view of the design space of \\texttt{FP4} training. We introduce a comprehensive, quantisation gradient-based framework for microscaling quantization that allows for a theoretical analysis of the computational costs associated with different stabilization methods on both the forward and backward passes. Using a simulator built on this framework, we conduct an extensive empirical study across a wide range of machine learning tasks, including regression, image classification, diffusion models, and language models. By systematically evaluating thousands of combinations of techniques, such as novel gradient approximations, rounding strategies, and scaling methods, we identify which configurations offer the most favourable performance-to-overhead trade-off. We find that the techniques enabling the best trade-off involve carefully combining Hadamard transformations, tensor scaling and stochastic rounding. We further find that using \\texttt{UE5M3} as a scaling factor potentially offers a good compromise between range and precision with manageable computational overhead."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17791","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:20:21Z","registered":"2025-09-23T03:20:22Z","published":null,"updated":"2025-09-23T03:20:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17790","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17790","identifiers":[{"identifier":"2509.17790","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alzahra","familyName":"Altalib","name":"Altalib, Alzahra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chunhui","familyName":"Li","name":"Li, Chunhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro","familyName":"Perelli","name":"Perelli, Alessandro","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conditional Diffusion Models for CT Image Synthesis from CBCT: A Systematic Review"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Medical Physics (physics.med-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"J.2","lang":"en","subjectScheme":"ACM"},{"subject":"68T07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-22T13:50:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:35:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Objective: Cone-beam computed tomography (CBCT) provides a low-dose imaging alternative to conventional CT, but suffers from noise, scatter, and artifacts that degrade image quality. Synthetic CT (sCT) aims to translate CBCT to high-quality CT-like images for improved anatomical accuracy and dosimetric precision. Although deep learning approaches have shown promise, they often face limitations in generalizability and detail preservation. Conditional diffusion models (CDMs), with their iterative refinement process, offers a novel solution. This review systematically examines the use of CDMs for CBCT-to-sCT synthesis.\n Methods: A systematic search was conducted in Web of Science, Scopus, and Google Scholar for studies published between 2013 and 2024. Inclusion criteria targeted works employing conditional diffusion models specifically for sCT generation. Eleven relevant studies were identified and analyzed to address three questions: (1) What conditional diffusion methods are used? (2) How do they compare to conventional deep learning in accuracy? (3) What are their clinical implications?\n Results: CDMs incorporating anatomical priors and spatial-frequency features demonstrated improved structural preservation and noise robustness. Energy-guided and hybrid latent models enabled enhanced dosimetric accuracy and personalized image synthesis. Across studies, CDMs consistently outperformed traditional deep learning models in noise suppression and artefact reduction, especially in challenging cases like lung imaging and dual-energy CT.\n Conclusion: Conditional diffusion models show strong potential for generalized, accurate sCT generation from CBCT. However, clinical adoption remains limited. Future work should focus on scalability, real-time inference, and integration with multi-modal imaging to enhance clinical relevance."},{"descriptionType":"Other","description":"36 pages, 8 figures, 3 tables, submitted to Elsevier Computerized Medical Imaging and Graphics"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17790","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:20:20Z","registered":"2025-09-23T03:20:20Z","published":null,"updated":"2025-09-23T03:20:20Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17765","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17765","identifiers":[{"identifier":"2509.17765","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jin","familyName":"Xu","name":"Xu, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhifang","familyName":"Guo","name":"Guo, Zhifang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangrui","familyName":"Hu","name":"Hu, Hangrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunfei","familyName":"Chu","name":"Chu, Yunfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiong","familyName":"Wang","name":"Wang, Xiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinzheng","familyName":"He","name":"He, Jinzheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Wang","name":"Wang, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xian","familyName":"Shi","name":"Shi, Xian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ting","familyName":"He","name":"He, Ting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinfa","familyName":"Zhu","name":"Zhu, Xinfa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuanjun","familyName":"Lv","name":"Lv, Yuanjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongqi","familyName":"Wang","name":"Wang, Yongqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dake","familyName":"Guo","name":"Guo, Dake","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"He","familyName":"Wang","name":"Wang, He","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Linhan","familyName":"Ma","name":"Ma, Linhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pei","familyName":"Zhang","name":"Zhang, Pei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Zhang","name":"Zhang, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongkun","familyName":"Hao","name":"Hao, Hongkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zishan","familyName":"Guo","name":"Guo, Zishan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baosong","familyName":"Yang","name":"Yang, Baosong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Zhang","name":"Zhang, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziyang","familyName":"Ma","name":"Ma, Ziyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xipin","familyName":"Wei","name":"Wei, Xipin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Bai","name":"Bai, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keqin","familyName":"Chen","name":"Chen, Keqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuejing","familyName":"Liu","name":"Liu, Xuejing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingkun","familyName":"Yang","name":"Yang, Mingkun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dayiheng","familyName":"Liu","name":"Liu, Dayiheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingzhang","familyName":"Ren","name":"Ren, Xingzhang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Zheng","name":"Zheng, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Men","name":"Men, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Zhou","name":"Zhou, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Yu","name":"Yu, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianxin","familyName":"Yang","name":"Yang, Jianxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Le","familyName":"Yu","name":"Yu, Le","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingren","familyName":"Zhou","name":"Zhou, Jingren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyang","familyName":"Lin","name":"Lin, Junyang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Qwen3-Omni Technical Report"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:26:24Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:33:31Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We present Qwen3-Omni, a single multimodal model that, for the first time, maintains state-of-the-art performance across text, image, audio, and video without any degradation relative to single-modal counterparts. Qwen3-Omni matches the performance of same-sized single-modal models within the Qwen series and excels particularly on audio tasks. Across 36 audio and audio-visual benchmarks, Qwen3-Omni achieves open-source SOTA on 32 benchmarks and overall SOTA on 22, outperforming strong closed-source models such as Gemini-2.5-Pro, Seed-ASR, and GPT-4o-Transcribe. Qwen3-Omni adopts a Thinker-Talker MoE architecture that unifies perception and generation across text, images, audio, and video, yielding fluent text and natural real-time speech. It supports text interaction in 119 languages, speech understanding in 19 languages, and speech generation in 10 languages. To reduce first-packet latency in streaming synthesis, Talker autoregressively predicts discrete speech codecs using a multi-codebook scheme. Leveraging the representational capacity of these codebooks, we replace computationally intensive block-wise diffusion with a lightweight causal ConvNet, enabling streaming from the first codec frame. In cold-start settings, Qwen3-Omni achieves a theoretical end-to-end first-packet latency of 234 ms. To further strengthen multimodal reasoning, we introduce a Thinking model that explicitly reasons over inputs from any modality. Since the research community currently lacks a general-purpose audio captioning model, we fine-tuned Qwen3-Omni-30B-A3B to obtain Qwen3-Omni-30B-A3B-Captioner, which produces detailed, low-hallucination captions for arbitrary audio inputs. Qwen3-Omni-30B-A3B, Qwen3-Omni-30B-A3B-Thinking, and Qwen3-Omni-30B-A3B-Captioner are publicly released under the Apache 2.0 license."},{"descriptionType":"Other","description":"https://github.com/QwenLM/Qwen3-Omni"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17765","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:19:44Z","registered":"2025-09-23T03:19:44Z","published":null,"updated":"2025-09-23T03:19:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17762","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17762","identifiers":[{"identifier":"2509.17762","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sitian","familyName":"Shen","name":"Shen, Sitian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Georgi","familyName":"Pramatarov","name":"Pramatarov, Georgi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifu","familyName":"Tao","name":"Tao, Yifu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniele","familyName":"De Martini","name":"De Martini, Daniele","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Neural-MMGS: Multi-modal Neural Gaussian Splats for Large-Scale Scene Reconstruction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:24:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:33:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper proposes Neural-MMGS, a novel neural 3DGS framework for multimodal large-scale scene reconstruction that fuses multiple sensing modalities in a per-gaussian compact, learnable embedding. While recent works focusing on large-scale scene reconstruction have incorporated LiDAR data to provide more accurate geometric constraints, we argue that LiDAR's rich physical properties remain underexplored. Similarly, semantic information has been used for object retrieval, but could provide valuable high-level context for scene reconstruction. Traditional approaches append these properties to Gaussians as separate parameters, increasing memory usage and limiting information exchange across modalities. Instead, our approach fuses all modalities -- image, LiDAR, and semantics -- into a compact, learnable embedding that implicitly encodes optical, physical, and semantic features in each Gaussian. We then train lightweight neural decoders to map these embeddings to Gaussian parameters, enabling the reconstruction of each sensing modality with lower memory overhead and improved scalability. We evaluate Neural-MMGS on the Oxford Spires and KITTI-360 datasets. On Oxford Spires, we achieve higher-quality reconstructions, while on KITTI-360, our method reaches competitive results with less storage consumption compared with current approaches in LiDAR-based novel-view synthesis."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17762","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:19:39Z","registered":"2025-09-23T03:19:40Z","published":null,"updated":"2025-09-23T03:19:40Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17740","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17740","identifiers":[{"identifier":"2509.17740","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiwen","familyName":"Jiang","name":"Jiang, Yiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deval","familyName":"Mehta","name":"Mehta, Deval","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyuan","familyName":"Yan","name":"Yan, Siyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaling","familyName":"Shen","name":"Shen, Yaling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimu","familyName":"Wang","name":"Wang, Zimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zongyuan","familyName":"Ge","name":"Ge, Zongyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WISE: Weak-Supervision-Guided Step-by-Step Explanations for Multimodal LLMs in Image Classification"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:05:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:32:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Large Language Models (MLLMs) have shown promise in visual-textual reasoning, with Multimodal Chain-of-Thought (MCoT) prompting significantly enhancing interpretability. However, existing MCoT methods rely on rationale-rich datasets and largely focus on inter-object reasoning, overlooking the intra-object understanding crucial for image classification. To address this gap, we propose WISE, a Weak-supervision-guided Step-by-step Explanation method that augments any image classification dataset with MCoTs by reformulating the concept-based representations from Concept Bottleneck Models (CBMs) into concise, interpretable reasoning chains under weak supervision. Experiments across ten datasets show that our generated MCoTs not only improve interpretability by 37% but also lead to gains in classification accuracy when used to fine-tune MLLMs. Our work bridges concept-based interpretability and generative MCoT reasoning, providing a generalizable framework for enhancing MLLMs in fine-grained visual understanding."},{"descriptionType":"Other","description":"Accepted at EMNLP 2025 (Main)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17740","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:19:09Z","registered":"2025-09-23T03:19:09Z","published":null,"updated":"2025-09-23T03:19:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17730","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17730","identifiers":[{"identifier":"2509.17730","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Bonan","familyName":"Zhang","name":"Zhang, Bonan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongqi","familyName":"Chen","name":"Chen, Zhongqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bowen","familyName":"Song","name":"Song, Bowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinya","familyName":"Li","name":"Li, Qinya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fan","familyName":"Wu","name":"Wu, Fan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guihai","familyName":"Chen","name":"Chen, Guihai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ConfClip: Confidence-Weighted and Clipped Reward for Reinforcement Learning in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:00:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:31:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Reinforcement learning (RL) has become a standard paradigm for refining large language models (LLMs) beyond pre-training and instruction tuning. A prominent line of work is RL with verifiable rewards (RLVR), which leverages automatically verifiable outcomes (e.g., correctness or executability) to generate reward signals. While efficient, this framework faces two key limitations: First, its binary feedback is too sparse to capture the quality of the reasoning process. Second, its coarse-grained rewards potentially lead to vanishing gradients. Inspired by observations from human learning, we introduce a RL technique that integrates verifiable outcomes with the model's own confidence estimates. This joint design enriches the reward signal, providing finer-grained feedback and implicitly supervising the reasoning process. Experimental results demonstrate that our proposed method enhances RL performance across multiple datasets and reduces token consumption during inference, while incurring negligible additional training cost. Moreover, it can be used as a plug-in module to enhance other state-of-the-art RL methods."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17730","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:18:55Z","registered":"2025-09-23T03:18:55Z","published":null,"updated":"2025-09-23T03:18:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17711","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17711","identifiers":[{"identifier":"2509.17711","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shenwei","familyName":"Kang","name":"Kang, Shenwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Zhang","name":"Zhang, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wen","familyName":"Liu","name":"Liu, Wen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Li","name":"Li, Bin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujie","familyName":"Liu","name":"Liu, Yujie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Gao","name":"Gao, Bo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DA-Mamba: Dialogue-aware selective state-space model for multimodal engagement estimation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:48:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:30:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Human engagement estimation in conversational scenarios is essential for applications such as adaptive tutoring, remote healthcare assessment, and socially aware human--computer interaction. Engagement is a dynamic, multimodal signal conveyed by facial expressions, speech, gestures, and behavioral cues over time. In this work we introduce DA-Mamba, a dialogue-aware multimodal architecture that replaces attention-heavy dialogue encoders with Mamba-based selective state-space processing to achieve linear time and memory complexity while retaining expressive cross-modal reasoning. We design a Mamba dialogue-aware selective state-space model composed of three core modules: a Dialogue-Aware Encoder, and two Mamba-based fusion mechanisms: Modality-Group Fusion and Partner-Group Fusion, these modules achieve expressive dialogue understanding. Extensive experiments on three standard benchmarks (NoXi, NoXi-Add, and MPIIGI) show that DA-Mamba surpasses prior state-of-the-art (SOTA) methods in concordance correlation coefficient (CCC), while reducing training time and peak memory; these gains enable processing much longer sequences and facilitate real-time deployment in resource-constrained, multi-party conversational settings. The source code will be available at: https://github.com/kksssssss-ssda/MMEA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17711","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:18:28Z","registered":"2025-09-23T03:18:29Z","published":null,"updated":"2025-09-23T03:18:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17684","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17684","identifiers":[{"identifier":"2509.17684","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"ThankGod","familyName":"Egbe","name":"Egbe, ThankGod","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihao","familyName":"Guo","name":"Guo, Zhihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zidong","familyName":"Chen","name":"Chen, Zidong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DINOv3-Diffusion Policy: Self-Supervised Large Visual Model for Visuomotor Diffusion Policy Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:27:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:28:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper evaluates DINOv3, a recent large-scale self-supervised vision backbone, for visuomotor diffusion policy learning in robotic manipulation. We investigate whether a purely self-supervised encoder can match or surpass conventional supervised ImageNet-pretrained backbones (e.g., ResNet-18) under three regimes: training from scratch, frozen, and finetuned. Across four benchmark tasks (Push-T, Lift, Can, Square) using a unified FiLM-conditioned diffusion policy, we find that (i) finetuned DINOv3 matches or exceeds ResNet-18 on several tasks, (ii) frozen DINOv3 remains competitive, indicating strong transferable priors, and (iii) self-supervised features improve sample efficiency and robustness. These results support self-supervised large visual models as effective, generalizable perceptual front-ends for action diffusion policies, motivating further exploration of scalable label-free pretraining in robotic manipulation. Compared to using ResNet18 as a backbone, our approach with DINOv3 achieves up to a 10% absolute increase in test-time success rates on challenging tasks such as Can, and on-the-par performance in tasks like Lift, PushT, and Square."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17684","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:17:50Z","registered":"2025-09-23T03:17:50Z","published":null,"updated":"2025-09-23T03:17:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17671","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17671","identifiers":[{"identifier":"2509.17671","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Selva","familyName":"Taş","name":"Taş, Selva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahmut El","familyName":"Huseyni","name":"Huseyni, Mahmut El","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Özay","familyName":"Ezerceli","name":"Ezerceli, Özay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reyhan","familyName":"Bayraktar","name":"Bayraktar, Reyhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fatma Betül","familyName":"Terzioğlu","name":"Terzioğlu, Fatma Betül","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Turk-LettuceDetect: A Hallucination Detection Models for Turkish RAG Applications"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:14:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:27:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The widespread adoption of Large Language Models (LLMs) has been hindered by their tendency to hallucinate, generating plausible but factually incorrect information. While Retrieval-Augmented Generation (RAG) systems attempt to address this issue by grounding responses in external knowledge, hallucination remains a persistent challenge, particularly for morphologically complex, low-resource languages like Turkish. This paper introduces Turk-LettuceDetect, the first suite of hallucination detection models specifically designed for Turkish RAG applications. Building on the LettuceDetect framework, we formulate hallucination detection as a token-level classification task and fine-tune three distinct encoder architectures: a Turkish-specific ModernBERT, TurkEmbed4STS, and multilingual EuroBERT. These models were trained on a machine-translated version of the RAGTruth benchmark dataset containing 17,790 instances across question answering, data-to-text generation, and summarization tasks. Our experimental results show that the ModernBERT-based model achieves an F1-score of 0.7266 on the complete test set, with particularly strong performance on structured tasks. The models maintain computational efficiency while supporting long contexts up to 8,192 tokens, making them suitable for real-time deployment. Comparative analysis reveals that while state-of-the-art LLMs demonstrate high recall, they suffer from low precision due to over-generation of hallucinated content, underscoring the necessity of specialized detection mechanisms. By releasing our models and translated dataset, this work addresses a critical gap in multilingual NLP and establishes a foundation for developing more reliable and trustworthy AI applications for Turkish and other languages."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17671","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:17:31Z","registered":"2025-09-23T03:17:31Z","published":null,"updated":"2025-09-23T03:17:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17669","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17669","identifiers":[{"identifier":"2509.17669","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yan","familyName":"Zhuang","name":"Zhuang, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Sun","name":"Sun, Yuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PG-CE: A Progressive Generation Dataset with Constraint Enhancement for Controllable Text Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:12:41Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:27:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"With the rapid development of Large Language Models (LLMs), Controllable Text Generation (CTG) has become a critical technology for enhancing system reliability and user experience. Addressing the limitations of traditional methods, this paper proposes the PG-CE (Progressive Generation with Constraint Enhancement) approach, which decomposes CTG tasks into three steps: type prediction, constraint construction, and guided generation. This method employs constraint generation models to dynamically build multi-dimensional constraints including tone, expression style, and thematic focus to guide output. Experiments demonstrate that PG-CE significantly improves generation quality across multiple scenarios while maintaining text controllability, thematic relevance, and response practicality. The research developed a dataset containing 90,000 constraint-text pairs (with an 8:2 ratio between daily and other topics), effectively reflecting real-world application requirements."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17669","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:17:28Z","registered":"2025-09-23T03:17:29Z","published":null,"updated":"2025-09-23T03:17:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17665","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17665","identifiers":[{"identifier":"2509.17665","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Katharina","familyName":"Simbeck","name":"Simbeck, Katharina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mariam","familyName":"Mahran","name":"Mahran, Mariam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mechanistic Interpretability with SAEs: Probing Religion, Violence, and Geography in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:09:21Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:27:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Despite growing research on bias in large language models (LLMs), most work has focused on gender and race, with little attention to religious identity. This paper explores how religion is internally represented in LLMs and how it intersects with concepts of violence and geography. Using mechanistic interpretability and Sparse Autoencoders (SAEs) via the Neuronpedia API, we analyze latent feature activations across five models. We measure overlap between religion- and violence-related prompts and probe semantic patterns in activation contexts. While all five religions show comparable internal cohesion, Islam is more frequently linked to features associated with violent language. In contrast, geographic associations largely reflect real-world religious demographics, revealing how models embed both factual distributions and cultural stereotypes. These findings highlight the value of structural analysis in auditing not just outputs but also internal representations that shape model behavior."},{"descriptionType":"Other","description":"Accepted at AEQUITAS 2025: Workshop on Fairness and Bias in AI | co-located with ECAI, October 26th, 2025, Bologna, Italy. 12 pages, 1 figure"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17665","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:17:22Z","registered":"2025-09-23T03:17:23Z","published":null,"updated":"2025-09-23T03:17:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17664","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17664","identifiers":[{"identifier":"2509.17664","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Pingyi","familyName":"Chen","name":"Chen, Pingyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yujing","familyName":"Lou","name":"Lou, Yujing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shen","familyName":"Cao","name":"Cao, Shen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinhui","familyName":"Guo","name":"Guo, Jinhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lubin","familyName":"Fan","name":"Fan, Lubin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Wu","name":"Wu, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lin","familyName":"Yang","name":"Yang, Lin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lizhuang","familyName":"Ma","name":"Ma, Lizhuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jieping","familyName":"Ye","name":"Ye, Jieping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SD-VLM: Spatial Measuring and Understanding with Depth-Encoded Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:08:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:27:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While vision language models (VLMs) excel in 2D semantic visual understanding, their ability to quantitatively reason about 3D spatial relationships remains under-explored, due to the deficiency of 2D images' spatial representation ability. In this paper, we analyze the problem hindering VLMs' spatial understanding abilities and propose SD-VLM, a novel framework that significantly enhances fundamental spatial perception abilities of VLMs through two key contributions: (1) propose Massive Spatial Measuring and Understanding (MSMU) dataset with precise spatial annotations, and (2) introduce a simple depth positional encoding method strengthening VLMs' spatial awareness. MSMU dataset covers massive quantitative spatial tasks with 700K QA pairs, 2.5M physical numerical annotations, and 10K chain-of-thought augmented samples. We have trained SD-VLM, a strong generalist VLM which shows superior quantitative spatial measuring and understanding capability. SD-VLM not only achieves state-of-the-art performance on our proposed MSMU-Bench, but also shows spatial generalization abilities on other spatial understanding benchmarks including Q-Spatial and SpatialRGPT-Bench. Extensive experiments demonstrate that SD-VLM outperforms GPT-4o and Intern-VL3-78B by 26.91% and 25.56% respectively on MSMU-Bench. Code and models are released at https://github.com/cpystan/SD-VLM."},{"descriptionType":"Other","description":"Accepted by NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17664","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:17:21Z","registered":"2025-09-23T03:17:22Z","published":null,"updated":"2025-09-23T03:17:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17651","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17651","identifiers":[{"identifier":"2509.17651","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Filippo","familyName":"Botti","name":"Botti, Filippo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alex","familyName":"Ergasti","name":"Ergasti, Alex","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomaso","familyName":"Fontanini","name":"Fontanini, Tomaso","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Claudio","familyName":"Ferrari","name":"Ferrari, Claudio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Massimo","familyName":"Bertozzi","name":"Bertozzi, Massimo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Prati","name":"Prati, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SISMA: Semantic Face Image Synthesis with Mamba"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:55:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:26:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion Models have become very popular for Semantic Image Synthesis (SIS) of human faces. Nevertheless, their training and inference is computationally expensive and their computational requirements are high due to the quadratic complexity of attention layers. In this paper, we propose a novel architecture called SISMA, based on the recently proposed Mamba. SISMA generates high quality samples by controlling their shape using a semantic mask at a reduced computational demand. We validated our approach through comprehensive experiments with CelebAMask-HQ, revealing that our architecture not only achieves a better FID score yet also operates at three times the speed of state-of-the-art architectures. This indicates that the proposed design is a viable, lightweight substitute to transformer-based models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17651","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:17:03Z","registered":"2025-09-23T03:17:03Z","published":null,"updated":"2025-09-23T03:17:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17627","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17627","identifiers":[{"identifier":"2509.17627","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinshu","familyName":"Chen","name":"Chen, Jinshu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinghui","familyName":"Li","name":"Li, Xinghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xu","familyName":"Bai","name":"Bai, Xu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianxiang","familyName":"Ma","name":"Ma, Tianxiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengze","familyName":"Zhang","name":"Zhang, Pengze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuowei","familyName":"Chen","name":"Chen, Zhuowei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gen","familyName":"Li","name":"Li, Gen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lijie","familyName":"Liu","name":"Liu, Lijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Songtao","familyName":"Zhao","name":"Zhao, Songtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bingchuan","familyName":"Li","name":"Li, Bingchuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qian","familyName":"He","name":"He, Qian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OmniInsert: Mask-Free Video Insertion of Any Reference via Diffusion Transformer Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:35:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:24:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in video insertion based on diffusion models are impressive. However, existing methods rely on complex control signals but struggle with subject consistency, limiting their practical applicability. In this paper, we focus on the task of Mask-free Video Insertion and aim to resolve three key challenges: data scarcity, subject-scene equilibrium, and insertion harmonization. To address the data scarcity, we propose a new data pipeline InsertPipe, constructing diverse cross-pair data automatically. Building upon our data pipeline, we develop OmniInsert, a novel unified framework for mask-free video insertion from both single and multiple subject references. Specifically, to maintain subject-scene equilibrium, we introduce a simple yet effective Condition-Specific Feature Injection mechanism to distinctly inject multi-source conditions and propose a novel Progressive Training strategy that enables the model to balance feature injection from subjects and source video. Meanwhile, we design the Subject-Focused Loss to improve the detailed appearance of the subjects. To further enhance insertion harmonization, we propose an Insertive Preference Optimization methodology to optimize the model by simulating human preferences, and incorporate a Context-Aware Rephraser module during reference to seamlessly integrate the subject into the original scenes. To address the lack of a benchmark for the field, we introduce InsertBench, a comprehensive benchmark comprising diverse scenes with meticulously selected subjects. Evaluation on InsertBench indicates OmniInsert outperforms state-of-the-art closed-source commercial solutions. The code will be released."},{"descriptionType":"Other","description":"Github Page: https://phantom-video.github.io/OmniInsert/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17627","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:16:30Z","registered":"2025-09-23T03:16:31Z","published":null,"updated":"2025-09-23T03:16:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17615","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17615","identifiers":[{"identifier":"2509.17615","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lars","familyName":"Heckler-Kram","name":"Heckler-Kram, Lars","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ashwin","familyName":"Vaidya","name":"Vaidya, Ashwin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jan-Hendrik","familyName":"Neudeck","name":"Neudeck, Jan-Hendrik","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ulla","familyName":"Scheler","name":"Scheler, Ulla","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dick","familyName":"Ameln","name":"Ameln, Dick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samet","familyName":"Akcay","name":"Akcay, Samet","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paula","familyName":"Ramos","name":"Ramos, Paula","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Benchmarks to Reality: Advancing Visual Anomaly Detection by the VAND 3.0 Challenge"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:27:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:24:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Visual anomaly detection is a strongly application-driven field of research. Consequently, the connection between academia and industry is of paramount importance. In this regard, we present the VAND 3.0 Challenge to showcase current progress in anomaly detection across different practical settings whilst addressing critical issues in the field. The challenge hosted two tracks, fostering the development of anomaly detection methods robust against real-world distribution shifts (Category 1) and exploring the capabilities of Vision Language Models within the few-shot regime (Category 2), respectively. The participants' solutions reached significant improvements over previous baselines by combining or adapting existing approaches and fusing them with novel pipelines. While for both tracks the progress in large pre-trained vision (language) backbones played a pivotal role for the performance increase, scaling up anomaly detection methods more efficiently needs to be addressed by future research to meet real-time and computational constraints on-site."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17615","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:16:13Z","registered":"2025-09-23T03:16:13Z","published":null,"updated":"2025-09-23T03:16:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17602","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17602","identifiers":[{"identifier":"2509.17602","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Giulio","familyName":"Martellucci","name":"Martellucci, Giulio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Herve","familyName":"Goeau","name":"Goeau, Herve","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pierre","familyName":"Bonnet","name":"Bonnet, Pierre","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabrice","familyName":"Vinatier","name":"Vinatier, Fabrice","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexis","familyName":"Joly","name":"Joly, Alexis","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Overview of PlantCLEF 2025: Multi-Species Plant Identification in Vegetation Quadrat Images"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:21:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:23:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quadrat images are essential for ecological studies, as they enable standardized sampling, the assessment of plant biodiversity, long-term monitoring, and large-scale field campaigns. These images typically cover an area of fifty centimetres or one square meter, and botanists carefully identify all the species present. Integrating AI could help specialists accelerate their inventories and expand the spatial coverage of ecological studies. To assess progress in this area, the PlantCLEF 2025 challenge relies on a new test set of 2,105 high-resolution multi-label images annotated by experts and covering around 400 species. It also provides a large training set of 1.4 million individual plant images, along with vision transformer models pre-trained on this data. The task is formulated as a (weakly labelled) multi-label classification problem, where the goal is to predict all species present in a quadrat image using single-label training data. This paper provides a detailed description of the data, the evaluation methodology, the methods and models used by participants, and the results achieved."},{"descriptionType":"Other","description":"13 pages, 4 figures, CLEF 2025 Conference and Labs of the Evaluation Forum, September 09 to 12, 2024, Madrid, Spain"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17602","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:15:55Z","registered":"2025-09-23T03:15:55Z","published":null,"updated":"2025-09-23T03:15:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17589","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17589","identifiers":[{"identifier":"2509.17589","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jun","familyName":"Ling","name":"Ling, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yao","familyName":"Qi","name":"Qi, Yao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Huang","name":"Huang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shibo","familyName":"Zhou","name":"Zhou, Shibo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanqin","familyName":"Huang","name":"Huang, Yanqin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiang","familyName":"Yang","name":"Yang, Jiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziqi","familyName":"Song","name":"Song, Ziqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Zhou","name":"Zhou, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Yang","name":"Yang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Heng Tao","familyName":"Shen","name":"Shen, Heng Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Table2LaTeX-RL: High-Fidelity LaTeX Code Generation from Table Images via Reinforced Multimodal Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:13:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:23:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"In this work, we address the task of table image to LaTeX code generation, with the goal of automating the reconstruction of high-quality, publication-ready tables from visual inputs. A central challenge of this task lies in accurately handling complex tables -- those with large sizes, deeply nested structures, and semantically rich or irregular cell content -- where existing methods often fail. We begin with a comprehensive analysis, identifying key challenges and highlighting the limitations of current evaluation protocols. To overcome these issues, we propose a reinforced multimodal large language model (MLLM) framework, where a pre-trained MLLM is fine-tuned on a large-scale table-to-LaTeX dataset. To further improve generation quality, we introduce a dual-reward reinforcement learning strategy based on Group Relative Policy Optimization (GRPO). Unlike standard approaches that optimize purely over text outputs, our method incorporates both a structure-level reward on LaTeX code and a visual fidelity reward computed from rendered outputs, enabling direct optimization of the visual output quality. We adopt a hybrid evaluation protocol combining TEDS-Structure and CW-SSIM, and show that our method achieves state-of-the-art performance, particularly on structurally complex tables, demonstrating the effectiveness and robustness of our approach."},{"descriptionType":"Other","description":"NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17589","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:15:36Z","registered":"2025-09-23T03:15:37Z","published":null,"updated":"2025-09-23T03:15:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17588","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17588","identifiers":[{"identifier":"2509.17588","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinyeong","familyName":"Kim","name":"Kim, Jinyeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seil","familyName":"Kang","name":"Kang, Seil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiwoo","familyName":"Park","name":"Park, Jiwoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhyeok","familyName":"Kim","name":"Kim, Junhyeok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seong Jae","familyName":"Hwang","name":"Hwang, Seong Jae","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Interpreting Attention Heads for Image-to-Text Information Flow in Large Vision-Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:12:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:23:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Vision-Language Models (LVLMs) answer visual questions by transferring information from images to text through a series of attention heads. While this image-to-text information flow is central to visual question answering, its underlying mechanism remains difficult to interpret due to the simultaneous operation of numerous attention heads. To address this challenge, we propose head attribution, a technique inspired by component attribution methods, to identify consistent patterns among attention heads that play a key role in information transfer. Using head attribution, we investigate how LVLMs rely on specific attention heads to identify and answer questions about the main object in an image. Our analysis reveals that a distinct subset of attention heads facilitates the image-to-text information flow. Remarkably, we find that the selection of these heads is governed by the semantic content of the input image rather than its visual appearance. We further examine the flow of information at the token level and discover that (1) text information first propagates to role-related tokens and the final token before receiving image information, and (2) image information is embedded in both object-related and background tokens. Our work provides evidence that image-to-text information flow follows a structured process, and that analysis at the attention-head level offers a promising direction toward understanding the mechanisms of LVLMs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17588","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:15:35Z","registered":"2025-09-23T03:15:35Z","published":null,"updated":"2025-09-23T03:15:35Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17585","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17585","identifiers":[{"identifier":"2509.17585","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Viola","familyName":"Negroni","name":"Negroni, Viola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Davide","familyName":"Salvi","name":"Salvi, Davide","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessandro Ilic","familyName":"Mezza","name":"Mezza, Alessandro Ilic","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paolo","familyName":"Bestagini","name":"Bestagini, Paolo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Tubaro","name":"Tubaro, Stefano","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Attention-based Mixture of Experts for Robust Speech Deepfake Detection"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:09:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:23:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"AI-generated speech is becoming increasingly used in everyday life, powering virtual assistants, accessibility tools, and other applications. However, it is also being exploited for malicious purposes such as impersonation, misinformation, and biometric spoofing. As speech deepfakes become nearly indistinguishable from real human speech, the need for robust detection methods and effective countermeasures has become critically urgent. In this paper, we present the ISPL's submission to the SAFE challenge at IH\u0026amp;MMSec 2025, where our system ranked first across all tasks. Our solution introduces a novel approach to audio deepfake detection based on a Mixture of Experts architecture. The proposed system leverages multiple state-of-the-art detectors, combining their outputs through an attention-based gating network that dynamically weights each expert based on the input speech signal. In this design, each expert develops a specialized understanding of the shared training data by learning to capture different complementary aspects of the same input through inductive biases. Experimental results indicate that our method outperforms existing approaches across multiple datasets. We further evaluate and analyze the performance of our system in the SAFE challenge."},{"descriptionType":"Other","description":"Accepted @ IEEE WIFS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17585","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:15:30Z","registered":"2025-09-23T03:15:31Z","published":null,"updated":"2025-09-23T03:15:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":440,"totalPages":18,"page":10},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=10\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=11\u0026page%5Bsize