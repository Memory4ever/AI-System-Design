{"data":[{"id":"10.48550/arxiv.2509.16839","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16839","identifiers":[{"identifier":"2509.16839","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yu","familyName":"Yao","name":"Yao, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Dong","name":"Dong, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Yang","name":"Yang, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ju","familyName":"Li","name":"Li, Ju","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilun","familyName":"Du","name":"Du, Yilun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Roundtable Policy: Confidence-Weighted-Consensus Aggregation Improves Multi-Agent-System Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T23:31:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:41:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-11T23:26:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-13T01:13:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-agent systems have demonstrated exceptional performance in downstream tasks beyond diverse single agent baselines. A growing body of work has explored ways to improve their reasoning and collaboration, from vote, debate, to complex interaction protocols. However, it still remains opaque why specific choice would be preferred in multi-agent systems. Inspired by the decision-making mechanism of democratic committees and The Society of Mind, we introduce Roundtable Policy, an inference-time reasoning framework for multi-agent systems that performs inference through the weighted consensus of multiple LLMs. Through extensive experiments, we demonstrate its that this approach significantly enhances reasoning in complex heterogeneous scientific tasks. Roundtable Policy emphasizes structured and interpretable inference rather than opaque convergence, while requires only black-box access and uniform procedures, making it broadly applicable to diverse multi-agent systems."},{"descriptionType":"Other","description":"Project page: https://ai4scidisc.github.io/roundtable/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16839","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:57:48Z","registered":"2025-09-23T02:57:48Z","published":null,"updated":"2026-02-13T03:20:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17143","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17143","identifiers":[{"identifier":"2509.17143","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junhyeok","familyName":"Lee","name":"Lee, Junhyeok","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Helin","familyName":"Wang","name":"Wang, Helin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaohan","familyName":"Guan","name":"Guan, Yaohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thomas","familyName":"Thebaud","name":"Thebaud, Thomas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Laureano","familyName":"Moro-Velazquez","name":"Moro-Velazquez, Laureano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jesús","familyName":"Villalba","name":"Villalba, Jesús","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Najim","familyName":"Dehak","name":"Dehak, Najim","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MaskVCT: Masked Voice Codec Transformer for Zero-Shot Voice Conversion With Increased Controllability via Multiple Guidances"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T16:14:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:58:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-11T16:15:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-12T01:58:33Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce MaskVCT, a zero-shot voice conversion (VC) model that offers multi-factor controllability through multiple classifier-free guidances (CFGs). While previous VC models rely on a fixed conditioning scheme, MaskVCT integrates diverse conditions in a single model. To further enhance robustness and control, the model can leverage continuous or quantized linguistic features to enhance intelligibility and speaker similarity, and can use or omit pitch contour to control prosody. These choices allow users to seamlessly balance speaker identity, linguistic content, and prosodic factors in a zero-shot VC setting. Extensive experiments demonstrate that MaskVCT achieves the best target speaker and accent similarities while obtaining competitive word and character error rates compared to existing baselines. Audio samples are available at https://maskvct.github.io/."},{"descriptionType":"Other","description":"ICASSP 2026 Accepted"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17143","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:05:03Z","registered":"2025-09-23T03:05:03Z","published":null,"updated":"2026-02-12T03:20:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16944","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16944","identifiers":[{"identifier":"2509.16944","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuheng","familyName":"Shi","name":"Shi, Yuheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaohuan","familyName":"Pei","name":"Pei, Xiaohuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minjing","familyName":"Dong","name":"Dong, Minjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang","familyName":"Xu","name":"Xu, Chang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Catching the Details: Self-Distilled RoI Predictors for Fine-Grained MLLM Perception"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T06:54:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:47:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T10:53:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-17T00:44:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-11T09:45:24Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-12T01:38:07Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal Large Language Models (MLLMs) require high-resolution visual information to perform fine-grained perception, yet processing entire high-resolution images is computationally prohibitive. While recent methods leverage a Region-of-Interest (RoI) mechanism to focus on salient areas, they typically present a difficult trade-off: training-based approaches depend on large-scale annotated datasets, while training-free methods that utilize the model's internal attention are computationally inefficient and less accurate, requiring either multi-pass prefill stages or reliance on the slow auto-regressive decoding process. In this paper, we propose an efficient, annotation-free Self-Distilled Region Proposal Network (SD-RPN) that resolves this trade-off. The SD-RPN is built around a pipeline that transforms the noisy attention maps from the MLLM's middle layers into high-quality pseudo-RoI labels by explicitly denoising the signal and resolving ambiguity. We use these labels to train a lightweight Region Proposal Network (RPN) that learns a more precise localization. This RPN is also highly efficient, predicting the RoI in a single forward pass using features from the MLLM's middle layers, decoupling RoI identification from the auto-regressive generation and avoiding costly multi-pass operations. To validate our approach, we integrate the framework into multiple MLLM families. Despite being trained on only a few (e.g. 10K) question-answer pairs, our method demonstrates exceptional data efficiency and generalization, achieving over a 10% absolute accuracy improvement on unseen benchmarks, including TextVQA, DocVQA, and V-Star. Our work presents a practical and scalable solution for enhancing the fine-grained perception of MLLMs without requiring costly supervision or full model fine-tuning. Code is available at https://github.com/YuHengsss/SD-RPN."},{"descriptionType":"Other","description":"20 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16944","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:00:17Z","registered":"2025-09-23T03:00:18Z","published":null,"updated":"2026-02-12T03:20:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16871","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16871","identifiers":[{"identifier":"2509.16871","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yitian","familyName":"Shi","name":"Shi, Yitian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zicheng","familyName":"Guo","name":"Guo, Zicheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rosa","familyName":"Wolf","name":"Wolf, Rosa","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Edgar","familyName":"Welte","name":"Welte, Edgar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rania","familyName":"Rayyes","name":"Rayyes, Rania","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HOGraspFlow: Taxonomy-Aware Hand-Object Retargeting for Multi-Modal SE(3) Grasp Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T01:46:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:43:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-11T12:29:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-12T01:45:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose Hand-Object\\emph{(HO)GraspFlow}, an affordance-centric approach that retargets a single RGB with hand-object interaction (HOI) into multi-modal executable parallel jaw grasps without explicit geometric priors on target objects. Building on foundation models for hand reconstruction and vision, we synthesize $SE(3)$ grasp poses with denoising flow matching (FM), conditioned on the following three complementary cues: RGB foundation features as visual semantics, HOI contact reconstruction, and taxonomy-aware prior on grasp types. Our approach demonstrates high fidelity in grasp synthesis without explicit HOI contact input or object geometry, while maintaining strong contact and taxonomy recognition. Another controlled comparison shows that \\emph{HOGraspFlow} consistently outperforms diffusion-based variants (\\emph{HOGraspDiff}), achieving high distributional fidelity and more stable optimization in $SE(3)$. We demonstrate a reliable, object-agnostic grasp synthesis from human demonstrations in real-world experiments, where an average success rate of over $83\\%$ is achieved. Code: https://github.com/YitianShi/HOGraspFlow"},{"descriptionType":"Other","description":"Accepted to ICRA 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16871","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:58:33Z","registered":"2025-09-23T02:58:33Z","published":null,"updated":"2026-02-12T03:20:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16596","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16596","identifiers":[{"identifier":"2509.16596","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junjie","familyName":"Ye","name":"Ye, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuming","familyName":"Yang","name":"Yang, Yuming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Nan","name":"Nan, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Li","name":"Li, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Zhang","name":"Zhang, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Gui","name":"Gui, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuanjing","familyName":"Huang","name":"Huang, Xuanjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Wang","name":"Wang, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongchao","familyName":"Shi","name":"Shi, Zhongchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianping","familyName":"Fan","name":"Fan, Jianping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analyzing the Effects of Supervised Fine-Tuning on Model Knowledge from Token and Parameter Levels"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T09:40:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:24:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-10T09:28:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-11T01:38:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2025.emnlp-main.25","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) acquire substantial world knowledge during pre-training, which is further shaped by post-training techniques such as supervised fine-tuning (SFT). However, the impact of SFT on a model's knowledge remains underexplored, limiting our ability to control knowledge change behavior in fine-tuned models. To address this gap, we evaluate closed-book question answering (CBQA) performance across five LLMs from the LLaMA-2 and LLaMA-3 families. Surprisingly, models fine-tuned on 1,920 samples perform up to 14% worse than those fine-tuned on only 240 samples. Furthermore, varying the level of knowledge mastery in the fine-tuning data leads to performance fluctuations of over 12%. To investigate these effects, we analyze model behavior at both the token and parameter levels. Our analysis reveals that up to 90% of parameter updates during SFT do not contribute to knowledge enhancement. Restoring these updates can improve performance on the CBQA task, depending on the characteristics of the fine-tuning data. These insights offer practical guidance for developing fine-tuning strategies that more effectively strengthen model knowledge."},{"descriptionType":"Other","description":"Accepted by EMNLP 2025 Main Conference. Codes for parameter restoration are available at https://github.com/UmeanNever/ParamRestore"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16596","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T02:52:06Z","registered":"2025-09-23T02:52:06Z","published":null,"updated":"2026-02-11T03:28:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17321","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17321","identifiers":[{"identifier":"2509.17321","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Paweł","familyName":"Budzianowski","name":"Budzianowski, Paweł","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emilia","familyName":"Wiśnios","name":"Wiśnios, Emilia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michał","familyName":"Tyrolski","name":"Tyrolski, Michał","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gracjan","familyName":"Góral","name":"Góral, Gracjan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Igor","familyName":"Kulakov","name":"Kulakov, Igor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Viktor","familyName":"Petrenko","name":"Petrenko, Viktor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krzysztof","familyName":"Walas","name":"Walas, Krzysztof","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"OpenGVL -- Benchmarking Visual Temporal Progress for Data Curation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T02:52:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:09:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T23:27:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T17:26:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-12-01T21:24:29Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-12-03T01:07:52Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-02-09T08:29:03Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-02-10T02:36:16Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Data scarcity remains one of the most limiting factors in driving progress in robotics. However, the amount of available robotics data in the wild is growing exponentially, creating new opportunities for large-scale data utilization. Reliable temporal task completion prediction could help automatically annotate and curate this data at scale. The Generative Value Learning (GVL) approach was recently proposed, leveraging the knowledge embedded in vision-language models (VLMs) to predict task progress from visual observations. Building upon GVL, we propose OpenGVL, a comprehensive benchmark for estimating task progress across diverse challenging manipulation tasks involving both robotic and human embodiments. We evaluate the capabilities of publicly available open-source foundation models, showing that open-source model families significantly underperform closed-source counterparts, achieving only approximately $70\\%$ of their performance on temporal progress prediction tasks. Furthermore, we demonstrate how OpenGVL can serve as a practical tool for automated data curation and filtering, enabling efficient quality assessment of large-scale robotics datasets. We release the benchmark along with the complete codebase at \\href{github.com/budzianowski/opengvl}{OpenGVL}."},{"descriptionType":"Other","description":"Workshop on Making Sense of Data in Robotics: Composition, Curation, and Interpretability at Scale at CoRL 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17321","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:09:13Z","registered":"2025-09-23T03:09:14Z","published":null,"updated":"2026-02-10T05:20:28Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17107","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17107","identifiers":[{"identifier":"2509.17107","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lingzhao","familyName":"Kong","name":"Kong, Lingzhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiacheng","familyName":"Lin","name":"Lin, Jiacheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyu","familyName":"Li","name":"Li, Siyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Luo","name":"Luo, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiyong","familyName":"Li","name":"Li, Zhiyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kailun","familyName":"Yang","name":"Yang, Kailun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CoBEVMoE: Heterogeneity-aware Feature Fusion with Dynamic Mixture-of-Experts for Collaborative Perception"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T14:56:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:57:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-09T14:31:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-10T02:55:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Collaborative perception aims to extend sensing coverage and improve perception accuracy by sharing information among multiple agents. However, due to differences in viewpoints and spatial positions, agents often acquire heterogeneous observations. Existing intermediate fusion methods primarily focus on aligning similar features, often overlooking the perceptual diversity among agents. To address this limitation, we propose CoBEVMoE, a novel collaborative perception framework that operates in the Bird's Eye View (BEV) space and incorporates a Dynamic Mixture-of-Experts (DMoE) architecture. In DMoE, each expert is dynamically generated based on the input features of a specific agent, enabling it to extract distinctive and reliable cues while attending to shared semantics. This design allows the fusion process to explicitly model both feature similarity and heterogeneity across agents. Furthermore, we introduce a Dynamic Expert Metric Loss (DEML) to enhance inter-expert diversity and improve the discriminability of the fused representation. Extensive experiments on the OPV2V and DAIR-V2X-C datasets demonstrate that CoBEVMoE achieves state-of-the-art performance. Specifically, it improves the IoU for Camera-based BEV segmentation by +1.5% on OPV2V and the AP@0.5 for LiDAR-based 3D object detection by +3.0% on DAIR-V2X-C, verifying the effectiveness of expert-based heterogeneous feature modeling in multi-agent collaborative perception. The source code will be made publicly available at https://github.com/godk0509/CoBEVMoE."},{"descriptionType":"Other","description":"Accepted to ICRA 2026. The source code will be made publicly available at https://github.com/godk0509/CoBEVMoE"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17107","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:04:11Z","registered":"2025-09-23T03:04:12Z","published":null,"updated":"2026-02-10T05:20:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16813","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16813","identifiers":[{"identifier":"2509.16813","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Devin R.","familyName":"Wright","name":"Wright, Devin R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jisun","familyName":"An","name":"An, Jisun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yong-Yeol","familyName":"Ahn","name":"Ahn, Yong-Yeol","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cognitive Linguistic Identity Fusion Score (CLIFS): A Scalable Cognition-Informed Approach to Quantifying Identity Fusion from Text"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.7; H.3.1; I.5.4; J.4","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-20T21:32:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-10T01:51:45Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2025.emnlp-main.588","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Quantifying identity fusion -- the psychological merging of self with another entity or abstract target (e.g., a religious group, political party, ideology, value, brand, belief, etc.) -- is vital for understanding a wide range of group-based human behaviors. We introduce the Cognitive Linguistic Identity Fusion Score (CLIFS), a novel metric that integrates cognitive linguistics with large language models (LLMs), which builds on implicit metaphor detection. Unlike traditional pictorial and verbal scales, which require controlled surveys or direct field contact, CLIFS delivers fully automated, scalable assessments while maintaining strong alignment with the established verbal measure. In benchmarks, CLIFS outperforms both existing automated approaches and human annotation. As a proof of concept, we apply CLIFS to violence risk assessment to demonstrate that it can improve violence risk assessment by more than 240%. Building on our identification of a new NLP task and early success, we underscore the need to develop larger, more diverse datasets that encompass additional fusion-target domains and cultural backgrounds to enhance generalizability and further advance this emerging area. CLIFS models and code are public at https://github.com/DevinW-sudo/CLIFS."},{"descriptionType":"Other","description":"Authors' accepted manuscript (postprint; camera-ready). To appear in the Proceedings of EMNLP 2025. Pagination/footer layout may differ from the Version of Record"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16813","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T02:57:11Z","registered":"2025-09-23T02:57:12Z","published":null,"updated":"2026-02-10T05:20:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17093","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17093","identifiers":[{"identifier":"2509.17093","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xin","familyName":"Tong","name":"Tong, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Feng","name":"Feng, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiwei","familyName":"Xu","name":"Xu, Weiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao-Hsi","familyName":"Chang","name":"Chang, Chao-Hsi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guo-Li","familyName":"Wang","name":"Wang, Guo-Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiang","familyName":"Li","name":"Li, Qiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Meson properties and symmetry emergence based on the deep neural network"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Experiment (hep-ex)","lang":"en","subjectScheme":"arXiv"},{"subject":"High Energy Physics - Lattice (hep-lat)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T14:15:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:56:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-12-31T03:24:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-06T01:19:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1088/0256-307x/43/2/020201","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"As a key property of hadrons, the total width is quite difficult to obtain in theory due to the extreme complexity of the strong and electroweak interactions. In this work, a deep neural network model with the Transformer architecture is built to precisely predict meson widths in the range of $10^{-14} \\sim 625$ MeV based on meson quantum numbers and masses. The relative errors of the predictions are $0.12\\%, 2.0\\%,$ and $0.54\\%$ in the training set, the test set, and all the data, respectively. We present the predicted meson width spectra for the currently discovered states and some theoretically predicted ones. The model is also used as a probe to study the quantum numbers and inner structures for some undetermined states including the exotic states. Notably, this data-driven model is investigated to spontaneously exhibit good charge conjugation symmetry and approximate isospin symmetry consistent with physical principles. The results indicate that the deep neural network can serve as an independent complementary research paradigm to describe and explore the hadron structures and the complicated interactions in particle physics alongside the traditional experimental measurements, theoretical calculations, and lattice simulations."},{"descriptionType":"Other","description":"31 pages,16 figures,3 table; Accepted by CPL"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17093","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:03:52Z","registered":"2025-09-23T03:03:52Z","published":null,"updated":"2026-02-06T03:21:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17489","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17489","identifiers":[{"identifier":"2509.17489","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Woongkyu","familyName":"Lee","name":"Lee, Woongkyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhee","familyName":"Cho","name":"Cho, Junhee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungwook","familyName":"Choi","name":"Choi, Jungwook","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MapCoder-Lite: Distilling Multi-Agent Coding into a Single Small LLM"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:19:11Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:17:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-04T07:25:55Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-05T01:32:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have advanced code generation from single-function tasks to competitive-programming problems, but existing multi-agent solutions either rely on costly large-scale (\u0026gt;30B) models or collapse when downsized to small open-source models. We present MapCoder-Lite, a framework for distilling the complex reasoning of large, multi-agent coding systems into a single 7B model. Our contribution is a novel, three-pillar methodology that synergistically generates, refines, and encodes multi-agent knowledge: (i) pass-based trajectory distillation from strong LLMs fixes format fragility in retrieval and reduces failures in debugging, (ii) supervisor-guided correction with global feedback strengthens planning and coding agents, and (iii) agent-wise LoRA fine-tuning delivers memory-efficient specialisation. Comprehensive evaluation on xCodeEval, APPS, and CodeContests shows that MapCoder-Lite more than doubles xCodeEval accuracy (from 13.2% to 28.3%), eliminates all format failures, while reducing GPU memory and token-generation time by 4x compared to a 32B model. It also achieves over 10% gains on simpler coding benchmarks, demonstrating broad improvements beyond competitive programming. These results demonstrate that careful agent-wise fine-tuning unleashes high-quality multi-agent coding on a small language model. Our code is publicly available at https://github.com/aiha-lab/MapCoder-Lite."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17489","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:13:12Z","registered":"2025-09-23T03:13:12Z","published":null,"updated":"2026-02-05T03:20:34Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17360","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17360","identifiers":[{"identifier":"2509.17360","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chaoyi","familyName":"Ruan","name":"Ruan, Chaoyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chao","familyName":"Bi","name":"Bi, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaiwen","familyName":"Zheng","name":"Zheng, Kaiwen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ziji","familyName":"Shi","name":"Shi, Ziji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Wan","name":"Wan, Xinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialin","familyName":"Li","name":"Li, Jialin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Cortex: Achieving Low-Latency, Cost-Efficient Remote Data Access For LLM via Semantic-Aware Knowledge Caching"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T05:24:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:11:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02-03T14:36:53Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-04T02:05:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Model (LLM) agents tackle data-intensive tasks such as deep research and code generation. However, their effectiveness depends on frequent interactions with knowledge sources across remote clouds or regions. Such interactions can create non-trivial latency and cost bottlenecks. Existing caching solutions focus on exact-match queries, limiting their effectiveness for semantic knowledge reuse.\n To address this challenge, we introduce Cortex, a novel cross-region knowledge caching architecture for LLM agents. At its core are two abstractions: Semantic Element (SE) and Semantic Retrieval Index (Seri). A semantic element captures the semantic embedding representation of an LLM query together with performance-aware metadata such as latency, cost, and staticity. Seri then provides two-stage retrieval: a vector similar index with semantic embedding for fast candidate selection and a lightweight LLM-powered semantic judger for precise validation. Atop these primitives, Cortex builds a new cache interface that includes a new semantic-aware cache hit definition, a cost-efficient eviction policy, and proactive prefetching. To reduce overhead, Cortex co-locates the small LLM judger with the main LLM using adaptive scheduling and resource sharing. Our evaluation demonstrates that Cortex delivers substantial performance improvements without compromising correctness. On representative search workloads, Cortex achieves up to a 3.6x increase in throughput by maintaining cache hit rates of over 85%, while preserving accuracy virtually identical to non-cached baselines. Cortex also improves throughput for coding tasks by 20%, showcasing its versatility across diverse agentic workloads."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17360","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:10:09Z","registered":"2025-09-23T03:10:09Z","published":null,"updated":"2026-02-04T03:41:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17942","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17942","identifiers":[{"identifier":"2509.17942","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nicholas","familyName":"Kraabel","name":"Kraabel, Nicholas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiangtao","familyName":"Liu","name":"Liu, Jiangtao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuchen","familyName":"Bian","name":"Bian, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Kifer","name":"Kifer, Daniel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chaopeng","familyName":"Shen","name":"Shen, Chaopeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"StefaLand: An Efficient Geoscience Foundation Model That Improves Dynamic Land-Surface Predictions"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:05:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:44:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-28T00:59:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T00:50:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-02-02T15:56:25Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-02-03T03:10:35Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Managing natural resources and mitigating risks from floods, droughts, wildfires, and landslides require models that can accurately predict climate-driven land-surface responses. Traditional models often struggle with spatial generalization because they are trained or calibrated on limited observations and can degrade under concept drift. Recently proposed vision foundation models trained on satellite imagery demand massive compute, and they are not designed for dynamic land surface prediction tasks. We introduce StefaLand, a generative spatiotemporal Earth representation learning model centered on learning cross-domain interactions to suppress overfitting. StefaLand demonstrates especially strong spatial generalization on five datasets across four important tasks: streamflow, soil moisture, soil composition and landslides, compared to previous state-of-the-art methods. The domain-inspired design choices include a location-aware masked autoencoder that fuses static and time-series inputs, an attribute-based rather than image-based representation that drastically reduces compute demands, and residual fine-tuning adapters that strengthen knowledge transfer across tasks. StefaLand can be pretrained and finetuned on commonly available academic compute resources, yet consistently outperforms state-of-the-art supervised learning baselines, fine-tuned vision foundation models and commercially available embeddings, highlighting the previously overlooked value of cross-domain interactions and providing assistance to data-poor regions of the world."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17942","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:23:54Z","registered":"2025-09-23T03:23:54Z","published":null,"updated":"2026-02-03T05:39:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16584","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16584","identifiers":[{"identifier":"2509.16584","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Benlu","familyName":"Wang","name":"Wang, Benlu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Iris","familyName":"Xia","name":"Xia, Iris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Zhang","name":"Zhang, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junda","familyName":"Wang","name":"Wang, Junda","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feiyun","familyName":"Ouyang","name":"Ouyang, Feiyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Han","name":"Han, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arman","familyName":"Cohan","name":"Cohan, Arman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hong","familyName":"Yu","name":"Yu, Hong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zonghai","familyName":"Yao","name":"Yao, Zonghai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Scores to Steps: Diagnosing and Improving LLM Performance in Evidence-Based Medical Calculations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T09:10:26Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:23:44Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-31T05:45:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-02-03T01:29:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have demonstrated promising performance on medical benchmarks; however, their ability to perform medical calculations, a crucial aspect of clinical decision-making, remains underexplored and poorly evaluated. Existing benchmarks often assess only the final answer with a wide numerical tolerance, overlooking systematic reasoning failures and potentially causing serious clinical misjudgments. In this work, we revisit medical calculation evaluation with a stronger focus on clinical trustworthiness. First, we clean and restructure the MedCalc-Bench dataset and propose a new step-by-step evaluation pipeline that independently assesses formula selection, entity extraction, and arithmetic computation. Under this granular framework, the accuracy of GPT-4o drops from 62.7% to 43.6%, revealing errors masked by prior evaluations. Second, we introduce an automatic error analysis framework that generates structured attribution for each failure mode. Human evaluation confirms its alignment with expert judgment, enabling scalable and explainable diagnostics. Finally, we propose a modular agentic pipeline, MedRaC, that combines retrieval-augmented generation and Python-based code execution. Without any fine-tuning, MedRaC improves the accuracy of different LLMs from 16.35% up to 53.19%. Our work highlights the limitations of current benchmark practices and proposes a more clinically faithful methodology. By enabling transparent and transferable reasoning evaluation, we move closer to making LLM-based systems trustworthy for real-world medical applications."},{"descriptionType":"Other","description":"Equal contribution for the first two authors. To appear as an Oral presentation in the proceedings of the Main Conference on Empirical Methods in Natural Language Processing (EMNLP) 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16584","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:51:49Z","registered":"2025-09-23T02:51:50Z","published":null,"updated":"2026-02-03T05:39:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16648","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16648","identifiers":[{"identifier":"2509.16648","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Debarpan","familyName":"Bhattacharya","name":"Bhattacharya, Debarpan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Apoorva","familyName":"Kulkarni","name":"Kulkarni, Apoorva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sriram","familyName":"Ganapathy","name":"Ganapathy, Sriram","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FESTA: Functionally Equivalent Sampling for Trust Assessment of Multimodal LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T11:50:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:28:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-30T06:55:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-31T00:29:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-02T05:16:52Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-04T01:49:25Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-30T10:50:00Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-02-02T01:44:07Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The accurate trust assessment of multimodal large language models (MLLMs) generated predictions, which can enable selective prediction and improve user confidence, is challenging due to the diverse multi-modal input paradigms. We propose Functionally Equivalent Sampling for Trust Assessment (FESTA), a multimodal input sampling technique for MLLMs, that generates an uncertainty measure based on the equivalent and complementary input samplings. The proposed task-preserving sampling approach for uncertainty quantification expands the input space to probe the consistency (through equivalent samples) and sensitivity (through complementary samples) of the model. FESTA uses only input-output access of the model (black-box), and does not require ground truth (unsupervised). The experiments are conducted with various off-the-shelf multi-modal LLMs, on both visual and audio reasoning tasks. The proposed FESTA uncertainty estimate achieves significant improvement (33.3% relative improvement for vision-LLMs and 29.6% relative improvement for audio-LLMs) in selective prediction performance, based on area-under-receiver-operating-characteristic curve (AUROC) metric in detecting mispredictions. The code implementation is open-sourced."},{"descriptionType":"Other","description":"Accepted in the Findings of EMNLP, 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16648","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:19Z","registered":"2025-09-23T02:53:20Z","published":null,"updated":"2026-02-02T03:24:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17866","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17866","identifiers":[{"identifier":"2509.17866","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xinyu","familyName":"He","name":"He, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xianghui","familyName":"Cao","name":"Cao, Xianghui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Understanding Post-Training Structural Changes in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T15:03:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:40:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-14T20:48:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-18T01:10:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-28T14:10:41Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-29T01:49:06Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-29T13:16:15Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-30T01:54:42Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Post-training fundamentally alters the behavior of large language models (LLMs), yet its impact on the internal parameter space remains poorly understood. In this work, we conduct a systematic singular value decomposition (SVD) analysis of principal linear layers in pretrained LLMs, focusing on two widely adopted post-training methods: instruction tuning and long-chain-of-thought (Long-CoT) distillation. Our analysis reveals two unexpected and robust structural changes: (1) a near-uniform geometric scaling of singular values across layers; and (2) highly consistent orthogonal transformations are applied to the left and right singular vectors of each matrix. Based on these findings, We propose a simple yet effective framework to describe the coordinated dynamics of parameters in LLMs, which elucidates why post-training inherently relies on the foundational capabilities developed during pre-training. Further experiments demonstrate that singular value scaling underpins the temperature-controlled regulatory mechanisms of post-training, while the coordinated rotation of singular vectors encodes the essential semantic alignment. These results challenge the prevailing view of the parameter space in large models as a black box, uncovering the first clear regularities in how parameters evolve during training, and providing a new perspective for deeper investigation into model parameter changes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17866","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:22:06Z","registered":"2025-09-23T03:22:07Z","published":null,"updated":"2026-01-30T03:41:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17816","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17816","identifiers":[{"identifier":"2509.17816","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Brown","familyName":"Ebouky","name":"Ebouky, Brown","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ajad","familyName":"Chhatkuli","name":"Chhatkuli, Ajad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cristiano","familyName":"Malossi","name":"Malossi, Cristiano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christoph","familyName":"Studer","name":"Studer, Christoph","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Roy","familyName":"Assaf","name":"Assaf, Roy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Andrea","familyName":"Bartezzaghi","name":"Bartezzaghi, Andrea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Enhancing Semantic Segmentation with Continual Self-Supervised Pre-training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:11:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:37:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-29T10:21:21Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-30T01:42:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Self-supervised learning (SSL) has emerged as a central paradigm for training foundation models by leveraging large-scale unlabeled datasets, often producing representations with strong generalization capabilities. These models are typically pre-trained on general-purpose datasets such as ImageNet and subsequently adapted to various downstream tasks through finetuning. While prior work has investigated parameter-efficient adaptation methods like adapters, LoRA, and prompt tuning, primarily targeting downstream finetuning, extending the SSL pre-training itself in a continual manner to new domains under limited data remains largely underexplored, especially for downstream dense prediction tasks like semantic segmentation. In this work, we address the challenge of adapting vision foundation models to low-data target domains through continual self-supervised pre-training, specifically targeting downstream semantic segmentation. We propose GLARE (Global Local and Regional Enforcement), a novel continual self-supervised pre-training task designed to enhance downstream semantic segmentation performance. GLARE introduces patch-level augmentations to encourage local consistency and incorporates a regional consistency constraint that leverages spatial semantics in the data. For efficient continual pre-training, we initialize Vision Transformers (ViTs) with weights from existing SSL models and update only lightweight adapter modules specifically UniAdapter - while keeping the rest of the backbone frozen. Experiments across multiple semantic segmentation benchmarks on different domains demonstrate that GLARE consistently improves downstream performance with minimal computational and parameter overhead."},{"descriptionType":"Other","description":"23 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17816","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:20:56Z","registered":"2025-09-23T03:20:57Z","published":null,"updated":"2026-01-30T03:41:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17641","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17641","identifiers":[{"identifier":"2509.17641","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hyunjong","familyName":"Ok","name":"Ok, Hyunjong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Suho","familyName":"Yoo","name":"Yoo, Suho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyeonjun","familyName":"Kim","name":"Kim, Hyeonjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jaeho","familyName":"Lee","name":"Lee, Jaeho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AuditoryBench++: Can Language Models Understand Auditory Knowledge without Hearing?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:45:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:25:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-28T06:19:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-29T01:25:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Even without directly hearing sounds, humans can effortlessly reason about auditory properties, such as pitch, loudness, or sound-source associations, drawing on auditory commonsense. In contrast, language models often lack this capability, limiting their effectiveness in multimodal interactions. As an initial step to address this gap, we present AuditoryBench++, a comprehensive benchmark for evaluating auditory knowledge and reasoning in text-only settings. The benchmark encompasses tasks that range from basic auditory comparisons to contextually grounded reasoning, enabling fine-grained analysis of how models process and integrate auditory concepts. In addition, we introduce AIR-CoT, a novel auditory imagination reasoning method that generates and integrates auditory information during inference through span detection with special tokens and knowledge injection. Extensive experiments with recent LLMs and Multimodal LLMs demonstrate that AIR-CoT generally outperforms both the off-the-shelf models and those augmented with auditory knowledge. The project page is available at https://auditorybenchpp.github.io."},{"descriptionType":"Other","description":"ICASSP 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17641","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:16:50Z","registered":"2025-09-23T03:16:50Z","published":null,"updated":"2026-01-29T03:12:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16656","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16656","identifiers":[{"identifier":"2509.16656","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Changyu","familyName":"Zeng","name":"Zeng, Changyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Wang","name":"Wang, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimu","familyName":"Wang","name":"Wang, Zimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wang","name":"Wang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhengni","familyName":"Yang","name":"Yang, Zhengni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muyi","familyName":"Bao","name":"Bao, Muyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiming","familyName":"Xiao","name":"Xiao, Jiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anh","familyName":"Nguyen","name":"Nguyen, Anh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutao","familyName":"Yue","name":"Yue, Yutao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"NUMINA: A Natural Understanding Benchmark for Multi-dimensional Intelligence and Numerical Reasoning Abilities"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T12:05:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:28:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-01T01:50:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-29T01:49:29Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advancements in 2D multimodal large language models (MLLMs) have significantly improved performance in vision-language tasks. However, extending these capabilities to 3D environments remains a distinct challenge due to the complexity of spatial reasoning. Nevertheless, existing 3D benchmarks often lack fine-grained numerical reasoning task annotations, limiting MLLMs' ability to perform precise spatial measurements and complex numerical reasoning. To address this gap, we introduce NUMINA, the first Natural Understanding benchmark for Multi-dimensional Intelligence and Numerical reasoning Abilities to enhance multimodal indoor perceptual understanding. NUMINA features multi-scale annotations and various question-answer pairs, generated using NUMINA-Flow, an automated annotation pipeline that integrates LLM rewriting and rule-based self-verification. We evaluate the performance of various state-of-the-art LLMs on NUMINA following the Chat-Scene framework, demonstrating that current LLMs struggle with multimodal numerical reasoning, particularly in performing precise computations such as distance and volume estimation, highlighting the need for further advancements in 3D models. The dataset and source codes can be obtained from https://github.com/fengshun124/NUMINA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16656","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:53:30Z","registered":"2025-09-23T02:53:31Z","published":null,"updated":"2026-01-29T03:12:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17477","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17477","identifiers":[{"identifier":"2509.17477","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yeonsun","familyName":"Yang","name":"Yang, Yeonsun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sang Won","familyName":"Lee","name":"Lee, Sang Won","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean Y.","familyName":"Song","name":"Song, Jean Y.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sangdoo","familyName":"Yun","name":"Yun, Sangdoo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Young-Ho","familyName":"Kim","name":"Kim, Young-Ho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LingoQ: Bridging the Gap between EFL Learning and Work through AI-Generated Work-Related Quizzes"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.5.2; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-22T08:12:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:17:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-27T09:23:51Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-28T01:41:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772318.3791342","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Non-native English speakers performing English-related tasks at work struggle to sustain EFL learning, despite their motivation. Often, study materials are disconnected from their work context. Our formative study revealed that reviewing work-related English becomes burdensome with current systems, especially after work. Although workers rely on LLM-based assistants to address their immediate needs, these interactions may not directly contribute to their English skills. We present LingoQ, an AI-mediated system that allows workers to practice English using quizzes generated from their LLM queries during work. LingoQ leverages these on-the-fly queries using AI to generate personalized quizzes that workers can review and practice on their smartphones. We conducted a three-week deployment study with 28 EFL workers to evaluate LingoQ. Participants valued the quality-assured, work-situated quizzes and constantly engaging with the app during the study. This active engagement improved self-efficacy and led to learning gains for beginners and, potentially, for intermediate learners. Drawing on these results, we discuss design implications for leveraging workers' growing reliance on LLMs to foster proficiency and engagement while respecting work boundaries and ethics."},{"descriptionType":"Other","description":"18 pages except reference. Conditionally accepted to ACM CHI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17477","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:12:54Z","registered":"2025-09-23T03:12:55Z","published":null,"updated":"2026-01-28T03:23:32Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17743","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17743","identifiers":[{"identifier":"2509.17743","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chenglin","familyName":"Li","name":"Li, Chenglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Han","name":"Han, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yikun","familyName":"Wang","name":"Wang, Yikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruilin","familyName":"Li","name":"Li, Ruilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuai","familyName":"Dong","name":"Dong, Shuai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haowen","familyName":"Hou","name":"Hou, Haowen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haitao","familyName":"Li","name":"Li, Haitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qianglong","familyName":"Chen","name":"Chen, Qianglong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Tao","name":"Tao, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingqi","familyName":"Tong","name":"Tong, Jingqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yin","familyName":"Zhang","name":"Zhang, Yin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Wang","name":"Wang, Jiaqi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VideoPro: Adaptive Program Reasoning for Long Video Understanding"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:06:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:32:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T07:31:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:37:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-22T10:02:24Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-23T01:32:37Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-26T02:54:26Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-27T02:06:44Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language models (LLMs) have shown promise in generating program workflows for visual tasks. However, previous approaches often rely on closed-source models, lack systematic reasoning, and struggle with long-form video question answering (videoQA). To address these challenges, we introduce the FS-VisPR framework, an adaptive visual program reasoning approach that balances fast reasoning for simple queries with slow reasoning for difficult ones. First, we design efficient visual modules (e.g., key clip retrieval and subtitle retrieval) to support long-form video tasks. Then, we construct a diverse and high-quality fast-slow reasoning dataset with a strong LLM to align open-source language models' ability to generate visual program workflows as FS-LLM. Next, we design a fast-slow reasoning framework with FS-LLM: Simple queries are directly solved by VideoLLMs, while difficult ones invoke visual program reasoning, motivated by human-like reasoning processes. During this process, low-confidence fast-thinking answers will trigger a second-stage slow-reasoning process, and a fallback mechanism to fast reasoning is activated if the program execution fails. Moreover, we improve visual programs through parameter search during both training and inference. By adjusting the parameters of the visual modules within the program, multiple variants are generated: during training, programs that yield correct answers are selected, while during inference, the program with the highest confidence result is applied. Experiments show that FS-VisPR improves both efficiency and reliability in visual program workflows. It achieves 50.4% accuracy on LVBench, surpassing GPT-4o, matching the performance of Qwen2.5VL-72B on VideoMME."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17743","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:19:13Z","registered":"2025-09-23T03:19:14Z","published":null,"updated":"2026-01-27T04:34:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17466","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17466","identifiers":[{"identifier":"2509.17466","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Migyeong","familyName":"Yang","name":"Yang, Migyeong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyungah","familyName":"Lee","name":"Lee, Kyungah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinyoung","familyName":"Han","name":"Han, Jinyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"SoHyun","familyName":"Park","name":"Park, SoHyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Young-Ho","familyName":"Kim","name":"Kim, Young-Ho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Autiverse: Eliciting Autistic Adolescents' Daily Narratives through AI-guided Multimodal Journaling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"H.5.2; I.2.7","lang":"en","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-22T08:02:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:17:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-21T14:47:03Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-22T01:47:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-26T15:44:08Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-27T02:35:59Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3772318.3791381","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Journaling can potentially serve as an effective method for autistic adolescents to improve narrative skills. However, its text-centric nature and high executive functioning demands present barriers to practice. We present Autiverse, an AI-guided multimodal journaling app for tablets that scaffolds daily narratives through conversational prompts and visual supports. Autiverse elicits key details of an adolescent-selected event through a stepwise dialogue with peer-like, customizable AI and composes them into an editable four-panel comic strip. Through a two-week deployment study with 10 autistic adolescent-parent dyads, we examine how Autiverse supports autistic adolescents to organize their daily experience and emotion. Our findings show Autiverse scaffolded adolescents' coherent narratives, while enabling parents to learn additional details of their child's events and emotions. Moreover, the customized AI peer created a comfortable space for sharing, fostering enjoyment and a strong sense of agency. Drawing on these results, we discuss implications for adaptive scaffolding across autism profiles, socio-emotionally appropriate AI peer design, and balancing autonomy with parental involvement."},{"descriptionType":"Other","description":"19 pages excluding reference. Conditionally accepted to ACM CHI 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17466","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:12:39Z","registered":"2025-09-23T03:12:40Z","published":null,"updated":"2026-01-27T04:34:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17429","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17429","identifiers":[{"identifier":"2509.17429","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhitao","familyName":"Zeng","name":"Zeng, Zhitao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guojian","familyName":"Yuan","name":"Yuan, Guojian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junyuan","familyName":"Mao","name":"Mao, Junyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxuan","familyName":"Wang","name":"Wang, Yuxuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoshuang","familyName":"Jia","name":"Jia, Xiaoshuang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueming","familyName":"Jin","name":"Jin, Yueming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-scale Temporal Prediction via Incremental Generation and Multi-agent Collaboration"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.10","lang":"en","subjectScheme":"ACM"},{"subject":"68T45","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-22T07:22:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:15:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T06:52:04Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:35:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-11-26T07:20:37Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-27T01:29:39Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-24T15:15:35Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-27T01:31:05Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Accurate temporal prediction is the bridge between comprehensive scene understanding and embodied artificial intelligence. However, predicting multiple fine-grained states of a scene at multiple temporal scales is difficult for vision-language models. We formalize the Multi-Scale Temporal Prediction (MSTP) task in general and surgical scenes by decomposing multi-scale into two orthogonal dimensions: the temporal scale, forecasting states of humans and surgery at varying look-ahead intervals, and the state scale, modeling a hierarchy of states in general and surgical scenes. For example, in general scenes, states of contact relationships are finer-grained than states of spatial relationships. In surgical scenes, medium-level steps are finer-grained than high-level phases yet remain constrained by their encompassing phase. To support this unified task, we introduce the first MSTP Benchmark, featuring synchronized annotations across multiple state scales and temporal scales. We further propose a method, Incremental Generation and Multi-agent Collaboration (IG-MC), which integrates two key innovations. First, we present a plug-and-play incremental generation module that continuously synthesizes up-to-date visual previews at expanding temporal scales to inform multiple decision-making agents, keeping decisions and generated visuals synchronized and preventing performance degradation as look-ahead intervals lengthen. Second, we present a decision-driven multi-agent collaboration framework for multi-state prediction, comprising generation, initiation, and multi-state assessment agents that dynamically trigger and evaluate prediction cycles to balance global coherence and local fidelity."},{"descriptionType":"Other","description":"20 pages, 6 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17429","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:47Z","registered":"2025-09-23T03:11:48Z","published":null,"updated":"2026-01-27T04:34:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17191","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17191","identifiers":[{"identifier":"2509.17191","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jinchao","familyName":"Ge","name":"Ge, Jinchao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tengfei","familyName":"Cheng","name":"Cheng, Tengfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Biao","familyName":"Wu","name":"Wu, Biao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zeyu","familyName":"Zhang","name":"Zhang, Zeyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shiya","familyName":"Huang","name":"Huang, Shiya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Judith","familyName":"Bishop","name":"Bishop, Judith","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gillian","familyName":"Shepherd","name":"Shepherd, Gillian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Meng","familyName":"Fang","name":"Fang, Meng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ling","familyName":"Chen","name":"Chen, Ling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Zhao","name":"Zhao, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VaseVQA: Multimodal Agent and Benchmark for Ancient Greek Pottery"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T18:36:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:01:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-24T03:28:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-27T01:14:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding cultural heritage artifacts such as ancient Greek pottery requires expert-level reasoning that remains challenging for current MLLMs due to limited domain-specific data. We introduce VaseVQA, a benchmark of 31,773 images and 67,614 question-answer pairs across seven expert-defined categories, enabling systematic evaluation of expert-level cultural heritage understanding. Using this dataset, we explore effective training strategies for domain-specific reasoning. While supervised fine-tuning improves adaptation to domain knowledge, it struggles with deeper reasoning tasks. We propose VaseVL, which augments SFT with reinforcement learning using verifiable rewards. Experiments show that VaseVL consistently outperforms supervised baselines, especially on reasoning-intensive questions, highlighting the value of targeted reinforcement learning for cultural heritage visual question answering. Our code and dataset will be released at https://github.com/AIGeeksGroup/VaseVQA."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17191","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:06:10Z","registered":"2025-09-23T03:06:11Z","published":null,"updated":"2026-01-27T04:34:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16891","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16891","identifiers":[{"identifier":"2509.16891","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sha","familyName":"Li","name":"Li, Sha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stefano","familyName":"Petrangeli","name":"Petrangeli, Stefano","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Shen","name":"Shen, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Chen","name":"Chen, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naren","familyName":"Ramakrishnan","name":"Ramakrishnan, Naren","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLMs as Layout Designers: Enhanced Spatial Reasoning for Content-Aware Layout Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T03:02:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:44:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-03T23:19:39Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-05T01:10:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-05T20:28:27Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-07T01:05:35Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-01-25T23:11:38Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-01-27T02:03:10Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While Large Language Models (LLMs) have demonstrated impressive reasoning and planning abilities in textual domains and can effectively follow instructions for complex tasks, their ability to understand and manipulate spatial relationships remains limited. Such capabilities are crucial for content-aware graphic layout design, where the goal is to arrange heterogeneous elements onto a canvas so that final design remains visually balanced and structurally feasible. This problem requires precise coordination of placement, alignment, and structural organization of multiple elements within a constrained visual space. To address this limitation, we introduce LaySPA, a reinforcement learning-based framework that augments LLM-based agents with explicit spatial reasoning capabilities for layout design. LaySPA employs hybrid reward signals that jointly capture geometric constraints, structural fidelity, and visual quality, enabling agents to navigate the canvas, model inter-element relationships, and optimize spatial arrangements. Through group-relative policy optimization, the agent generates content-aware layouts that reflect salient regions, respect spatial constraints, and produces an interpretable reasoning trace explaining placement decisions and a structured layout specification. Experimental results show that LaySPA substantially improves the generation of structurally valid and visually appealing layouts, outperforming larger general-purpose LLMs and achieving performance comparable to state-of-the-art specialized layout models."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16891","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:59:01Z","registered":"2025-09-23T02:59:02Z","published":null,"updated":"2026-01-27T04:34:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16495","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16495","identifiers":[{"identifier":"2509.16495","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mert","familyName":"Hidayetoglu","name":"Hidayetoglu, Mert","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Aurick","familyName":"Qiao","name":"Qiao, Aurick","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Michael","familyName":"Wyatt","name":"Wyatt, Michael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jeff","familyName":"Rasley","name":"Rasley, Jeff","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuxiong","familyName":"He","name":"He, Yuxiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Samyam","familyName":"Rajbhandari","name":"Rajbhandari, Samyam","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Shift Parallelism: Low-Latency, High-Throughput LLM Inference for Dynamic Workloads"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T01:56:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:13:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-01-26T12:31:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-01-27T02:26:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Efficient parallelism is necessary for achieving low-latency, high-throughput inference with large language models (LLMs). Tensor parallelism (TP) is the state-of-the-art method for reducing LLM response latency, however GPU communications reduces combined token throughput. On the other hand, data parallelism (DP) obtains a higher throughput yet is slow in response latency. Best of both worlds does not exist, and it is not possible to combine TP and DP because of the KV cache variance across the parallelisms.\n We notice Sequence Parallelism (SP - Ulysses in training) has similar properties as DP but with KV cache invariance. We adapt SP to inference, and combine it with TP to get the best of both worlds. Our solution: Shift Parallelism.\n Shift Parallelism dynamically switches across TP and SP, and minimizes latency in low traffic without losing throughput in high traffic. The efficient GPU communications of Shift Parallelism yields up to i) 1.51x faster response in interactive workloads and ii) 50% higher throughput in batch workloads, compared to a TP-only solution.\n We evaluate Shift Parallelism with real-world production traces with dynamic traffic patterns as well as synthetic benchmarking patterns across models, context sizes, and arrival rates. All results affirm the same: Shift Parallelism has a better the latency vs. throughput tradeoff than TP or DP, and hence obtains low latency without degrading throughput in dynamic workloads."},{"descriptionType":"Other","description":"Revised"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16495","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:49:45Z","registered":"2025-09-23T02:49:46Z","published":null,"updated":"2026-01-27T04:34:46Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":440,"totalPages":18,"page":4},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=4\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimoda