{"data":[{"id":"10.48550/arxiv.2509.17875","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17875","identifiers":[{"identifier":"2509.17875","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Andreas","familyName":"Celary","name":"Celary, Andreas","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Krühner","name":"Krühner, Paul","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Shape of term structures compatible with flexible choice of diffusion"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Mathematical Finance (q-fin.MF)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Economics and business","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T15:13:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:40:46Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-14T12:55:20Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-17T01:42:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We identify all smooth manifolds of curves for Heath-Jarrow-Morton models that are consistent with any tangential diffusion coefficient. In fact, we show that these manifolds cannot be affine but must be of linear-rational type."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17875","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:22:19Z","registered":"2025-09-23T03:22:20Z","published":null,"updated":"2025-11-17T03:05:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17289","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17289","identifiers":[{"identifier":"2509.17289","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Sydney","familyName":"Anuyah","name":"Anuyah, Sydney","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mehedi Mahmud","familyName":"Kaushik","name":"Kaushik, Mehedi Mahmud","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Krishna","familyName":"Dwarampudi","name":"Dwarampudi, Krishna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rakesh","familyName":"Shiradkar","name":"Shiradkar, Rakesh","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arjan","familyName":"Durresi","name":"Durresi, Arjan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sunandan","familyName":"Chakraborty","name":"Chakraborty, Sunandan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automated Knowledge Graph Construction using Large Language Models and Sentence Complexity Modelling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T00:01:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-13T01:11:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.18653/v1/2025.emnlp-main.783","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce CoDe-KG, an open-source, end-to-end pipeline for extracting sentence-level knowledge graphs by combining robust coreference resolution with syntactic sentence decomposition. Using our model, we contribute a dataset of over 150,000 knowledge triples, which is open source. We also contribute a training corpus of 7248 rows for sentence complexity, 190 rows of gold human annotations for co-reference resolution using open source lung-cancer abstracts from PubMed, 900 rows of gold human annotations for sentence conversion policies, and 398 triples of gold human annotations. We systematically select optimal prompt-model pairs across five complexity categories, showing that hybrid chain-of-thought and few-shot prompting yields up to 99.8% exact-match accuracy on sentence simplification. On relation extraction (RE), our pipeline achieves 65.8% macro-F1 on REBEL, an 8-point gain over the prior state of the art, and 75.7% micro-F1 on WebNLG2, while matching or exceeding performance on Wiki-NRE and CaRB. Ablation studies demonstrate that integrating coreference and decomposition increases recall on rare relations by over 20%. Code and dataset are available at https://github.com/KaushikMahmud/CoDe-KG_EMNLP_2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17289","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T03:08:28Z","registered":"2025-09-23T03:08:29Z","published":null,"updated":"2025-11-13T03:09:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18094","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18094","identifiers":[{"identifier":"2509.18094","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ye","familyName":"Liu","name":"Liu, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zongyang","familyName":"Ma","name":"Ma, Zongyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junfu","familyName":"Pu","name":"Pu, Junfu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhongang","familyName":"Qi","name":"Qi, Zhongang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Wu","name":"Wu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Shan","name":"Shan, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chang Wen","familyName":"Chen","name":"Chen, Chang Wen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"UniPixel: Unified Object Referring and Segmentation for Pixel-Level Visual Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:59:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:51:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-21T13:48:43Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-22T00:54:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-27T08:58:16Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-28T01:30:45Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-11-10T14:50:20Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-11-11T02:40:27Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent advances in Large Multi-modal Models (LMMs) have demonstrated their remarkable success as general-purpose multi-modal assistants, with particular focuses on holistic image- and video-language understanding. Conversely, less attention has been given to scaling fine-grained pixel-level understanding capabilities, where the models are expected to realize pixel-level alignment between visual signals and language semantics. Some previous studies have applied LMMs to related tasks such as region-level captioning and referring expression segmentation. However, these models are limited to performing either referring or segmentation tasks independently and fail to integrate these fine-grained perception capabilities into visual reasoning. To bridge this gap, we propose UniPixel, a large multi-modal model capable of flexibly comprehending visual prompt inputs and generating mask-grounded responses. Our model distinguishes itself by seamlessly integrating pixel-level perception with general visual understanding capabilities. Specifically, UniPixel processes visual prompts and generates relevant masks on demand, and performs subsequent reasoning conditioning on these intermediate pointers during inference, thereby enabling fine-grained pixel-level reasoning. The effectiveness of our approach has been verified on 10 benchmarks across a diverse set of tasks, including pixel-level referring/segmentation and object-centric understanding in images/videos. A novel PixelQA task that jointly requires referring, segmentation, and question answering is also designed to verify the flexibility of our method."},{"descriptionType":"Other","description":"NeurIPS 2025 Camera Ready. Project Page: https://polyu-chenlab.github.io/unipixel/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18094","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:27:27Z","registered":"2025-09-23T03:27:27Z","published":null,"updated":"2025-11-12T03:28:26Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17377","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17377","identifiers":[{"identifier":"2509.17377","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hannah","familyName":"Bansal","name":"Bansal, Hannah","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kemal","familyName":"Kurniawan","name":"Kurniawan, Kemal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lea","familyName":"Frermann","name":"Frermann, Lea","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robustness of Neurosymbolic Reasoners on First-Order Logic Problems"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T06:35:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:12:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-09T12:20:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-11T01:54:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent trends in NLP aim to improve reasoning capabilities in Large Language Models (LLMs), with key focus on generalization and robustness to variations in tasks. Counterfactual task variants introduce minimal but semantically meaningful changes to otherwise valid first-order logic (FOL) problem instances altering a single predicate or swapping roles of constants to probe whether a reasoning system can maintain logical consistency under perturbation. Previous studies showed that LLMs becomes brittle on counterfactual variations, suggesting that they often rely on spurious surface patterns to generate responses. In this work, we explore if a neurosymbolic (NS) approach that integrates an LLM and a symbolic logical solver could mitigate this problem. Experiments across LLMs of varying sizes show that NS methods are more robust but perform worse overall that purely neural methods. We then propose NSCoT that combines an NS method and Chain-of-Thought (CoT) prompting and demonstrate that while it improves performance, NSCoT still lags behind standard CoT. Our analysis opens research directions for future work."},{"descriptionType":"Other","description":"Accepted to ALA Conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17377","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:10:33Z","registered":"2025-09-23T03:10:33Z","published":null,"updated":"2025-11-12T03:28:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16328","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16328","identifiers":[{"identifier":"2509.16328","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jyun-Ping","familyName":"Kao","name":"Kao, Jyun-Ping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Role of High-Performance GPU Resources in Large Language Model Based Radiology Imaging Diagnosis"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Tissues and Organs (q-bio.TO)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Medical Physics (physics.med-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T18:13:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:03:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T19:08:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-11T01:43:51Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large-language models (LLMs) are rapidly being applied to radiology, enabling automated image interpretation and report generation tasks. Their deployment in clinical practice requires both high diagnostic accuracy and low inference latency, which in turn demands powerful hardware. High-performance graphical processing units (GPUs) provide the necessary compute and memory throughput to run large LLMs on imaging data. We review modern GPU architectures (e.g. NVIDIA A100/H100, AMD Instinct MI250X/MI300) and key performance metrics of floating-point throughput, memory bandwidth, VRAM capacity. We show how these hardware capabilities affect radiology tasks: for example, generating reports or detecting findings on CheXpert and MIMIC-CXR images is computationally intensive and benefits from GPU parallelism and tensor-core acceleration. Empirical studies indicate that using appropriate GPU resources can reduce inference time and improve throughput. We discuss practical challenges including privacy, deployment, cost, power and optimization strategies: mixed-precision, quantization, compression, and multi-GPU scaling. Finally, we anticipate that next-generation features (8-bit tensor cores, enhanced interconnect) will further enable on-premise and federated radiology AI. Advancing GPU infrastructure is essential for safe, efficient LLM-based radiology diagnostics."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16328","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:45:52Z","registered":"2025-09-23T02:45:53Z","published":null,"updated":"2025-11-12T03:28:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16204","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16204","identifiers":[{"identifier":"2509.16204","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xingang","familyName":"Guo","name":"Guo, Xingang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yaxin","familyName":"Li","name":"Li, Yaxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangyi","familyName":"Kong","name":"Kong, Xiangyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilan","familyName":"Jiang","name":"Jiang, Yilan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiayu","familyName":"Zhao","name":"Zhao, Xiayu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihua","familyName":"Gong","name":"Gong, Zhihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yufan","familyName":"Zhang","name":"Zha