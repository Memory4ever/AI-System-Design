,{"nameType":"Personal","givenName":"Dahui","familyName":"Song","name":"Song, Dahui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manvi","familyName":"Jha","name":"Jha, Manvi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weijie","familyName":"Liang","name":"Liang, Weijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiman","familyName":"Yan","name":"Yan, Weiman","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bryan","familyName":"Zhang","name":"Zhang, Bryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sahil Bhandary","familyName":"Karnoor","name":"Karnoor, Sahil Bhandary","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialiang","familyName":"Zhang","name":"Zhang, Jialiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rutva","familyName":"Pandya","name":"Pandya, Rutva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Gong","name":"Gong, Xinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mithesh Ballae","familyName":"Ganesh","name":"Ganesh, Mithesh Ballae","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feize","familyName":"Shi","name":"Shi, Feize","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiling","familyName":"Xu","name":"Xu, Ruiling","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifan","familyName":"Zhang","name":"Zhang, Yifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanfeng","familyName":"Ouyang","name":"Ouyang, Yanfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lianhui","familyName":"Qin","name":"Qin, Lianhui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elyse","familyName":"Rosenbaum","name":"Rosenbaum, Elyse","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Corey","familyName":"Snyder","name":"Snyder, Corey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peter","familyName":"Seiler","name":"Seiler, Peter","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Geir","familyName":"Dullerud","name":"Dullerud, Geir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojia Shelly","familyName":"Zhang","name":"Zhang, Xiaojia Shelly","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zuofu","familyName":"Cheng","name":"Cheng, Zuofu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pavan Kumar","familyName":"Hanumolu","name":"Hanumolu, Pavan Kumar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jian","familyName":"Huang","name":"Huang, Jian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mayank","familyName":"Kulkarni","name":"Kulkarni, Mayank","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahdi","familyName":"Namazifar","name":"Namazifar, Mahdi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Zhang","name":"Zhang, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bin","familyName":"Hu","name":"Hu, Bin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Toward Engineering AGI: Benchmarking the Engineering Design Capabilities of LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computational Engineering, Finance, and Science (cs.CE)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-07-01T17:59:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:00:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-06T21:47:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-10T01:07:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern engineering, spanning electrical, mechanical, aerospace, civil, and computer disciplines, stands as a cornerstone of human civilization and the foundation of our society. However, engineering design poses a fundamentally different challenge for large language models (LLMs) compared with traditional textbook-style problem solving or factual question answering. Although existing benchmarks have driven progress in areas such as language understanding, code synthesis, and scientific problem solving, real-world engineering design demands the synthesis of domain knowledge, navigation of complex trade-offs, and management of the tedious processes that consume much of practicing engineers' time. Despite these shared challenges across engineering disciplines, no benchmark currently captures the unique demands of engineering design work. In this work, we introduce EngDesign, an Engineering Design benchmark that evaluates LLMs' abilities to perform practical design tasks across nine engineering domains. Unlike existing benchmarks that focus on factual recall or question answering, EngDesign uniquely emphasizes LLMs' ability to synthesize domain knowledge, reason under constraints, and generate functional, objective-oriented engineering designs. Each task in EngDesign represents a real-world engineering design problem, accompanied by a detailed task description specifying design goals, constraints, and performance requirements. EngDesign pioneers a simulation-based evaluation paradigm that moves beyond textbook knowledge to assess genuine engineering design capabilities and shifts evaluation from static answer checking to dynamic, simulation-driven functional verification, marking a crucial step toward realizing the vision of engineering Artificial General Intelligence (AGI)."},{"descriptionType":"Other","description":"To Appear in NeurIPS 2025 Datasets \u0026amp; Benchmarks Track"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16204","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:42:51Z","registered":"2025-09-23T02:42:52Z","published":null,"updated":"2025-11-10T02:48:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17858","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17858","identifiers":[{"identifier":"2509.17858","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Milan","familyName":"Straka","name":"Straka, Milan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CorPipe at CRAC 2025: Evaluating Multilingual Encoders for Multilingual Coreference Resolution"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:51:37Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:39:41Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-06T08:02:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-07T01:28:31Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present CorPipe 25, the winning entry to the CRAC 2025 Shared Task on Multilingual Coreference Resolution. This fourth iteration of the shared task introduces a new LLM track alongside the original unconstrained track, features reduced development and test sets to lower computational requirements, and includes additional datasets. CorPipe 25 represents a complete reimplementation of our previous systems, migrating from TensorFlow to PyTorch. Our system significantly outperforms all other submissions in both the LLM and unconstrained tracks by a substantial margin of 8 percentage points. The source code and trained models are publicly available at https://github.com/ufal/crac2025-corpipe."},{"descriptionType":"Other","description":"Accepted to CODI-CRAC 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17858","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:21:55Z","registered":"2025-09-23T03:21:56Z","published":null,"updated":"2025-11-07T03:06:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17796","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17796","identifiers":[{"identifier":"2509.17796","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Michal","familyName":"Novák","name":"Novák, Michal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miloslav","familyName":"Konopík","name":"Konopík, Miloslav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anna","familyName":"Nedoluzhko","name":"Nedoluzhko, Anna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Martin","familyName":"Popel","name":"Popel, Martin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ondřej","familyName":"Pražák","name":"Pražák, Ondřej","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jakub","familyName":"Sido","name":"Sido, Jakub","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Milan","familyName":"Straka","name":"Straka, Milan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zdeněk","familyName":"Žabokrtský","name":"Žabokrtský, Zdeněk","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Zeman","name":"Zeman, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Findings of the Fourth Shared Task on Multilingual Coreference Resolution: Can LLMs Dethrone Traditional Approaches?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:52:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:35:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-06T08:12:36Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-07T01:29:02Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The paper presents an overview of the fourth edition of the Shared Task on Multilingual Coreference Resolution, organized as part of the CODI-CRAC 2025 workshop. As in the previous editions, participants were challenged to develop systems that identify mentions and cluster them according to identity coreference.\n A key innovation of this year's task was the introduction of a dedicated Large Language Model (LLM) track, featuring a simplified plaintext format designed to be more suitable for LLMs than the original CoNLL-U representation.\n The task also expanded its coverage with three new datasets in two additional languages, using version 1.3 of CorefUD - a harmonized multilingual collection of 22 datasets in 17 languages.\n In total, nine systems participated, including four LLM-based approaches (two fine-tuned and two using few-shot adaptation). While traditional systems still kept the lead, LLMs showed clear potential, suggesting they may soon challenge established approaches in future editions."},{"descriptionType":"Other","description":"Accepted to CODI-CRAC 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17796","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:20:28Z","registered":"2025-09-23T03:20:29Z","published":null,"updated":"2025-11-07T03:06:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16515","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16515","identifiers":[{"identifier":"2509.16515","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shiya","familyName":"Chen","name":"Chen, Shiya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Paul","familyName":"Oftedahl","name":"Oftedahl, Paul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhen","familyName":"Zhang","name":"Zhang, Zhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zepeng","familyName":"Wu","name":"Wu, Zepeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junjie","familyName":"Jiang","name":"Jiang, Junjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vladimir","familyName":"Antropov","name":"Antropov, Vladimir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Julia V.","familyName":"Zaikina","name":"Zaikina, Julia V.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shunqing","familyName":"Wu","name":"Wu, Shunqing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai-Ming","familyName":"Ho","name":"Ho, Kai-Ming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Sun","name":"Sun, Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prediction of Li3Fe8B8 compound with rapid one-dimensional ion diffusion channels"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T03:37:14Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-07T01:26:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/37v2-qt21","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Using a computational crystal structure search in the Li-Fe-B ternary system, we predict a stable phase of Li3Fe8B8, featuring 1D channels that enable rapid Li-ion transport. Ab initio molecular dynamics simulations show that the Li-ion diffusion coefficient in Li3Fe8B8 surpasses that of common electrode and conductive additive materials by several orders of magnitude. The high diffusion in Li3Fe8B8 can be explained by the Frenkel-Kontorova model, which describes an incommensurate state between the Li diffusion chain and the periodic potential field caused by the FeB backbone structure. The favorable lithium-ion diffusivity and mechanical properties of Li3Fe8B8 make it a promising conductive additive for battery materials. Its itinerant ferromagnetism also offers a platform for exploring correlated-electron magnetism and spin-dependent phenomena."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16515","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2025-09-23T02:50:13Z","registered":"2025-09-23T02:50:14Z","published":null,"updated":"2025-11-07T03:05:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17619","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17619","identifiers":[{"identifier":"2509.17619","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhefan","familyName":"Wang","name":"Wang, Zhefan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ning","familyName":"Geng","name":"Geng, Ning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhiqiang","familyName":"Guo","name":"Guo, Zhiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weizhi","familyName":"Ma","name":"Ma, Weizhi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Zhang","name":"Zhang, Min","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Human vs. Agent in Task-Oriented Conversations"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:30:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:24:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-05T03:47:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-06T01:19:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Task-oriented conversational systems are essential for efficiently addressing diverse user needs, yet their development requires substantial amounts of high-quality conversational data that is challenging and costly to obtain. While large language models (LLMs) have demonstrated potential in generating synthetic conversations, the extent to which these agent-generated interactions can effectively substitute real human conversations remains unclear. This work presents the first systematic comparison between LLM-simulated users and human users in personalized task-oriented conversations. We propose a comprehensive analytical framework encompassing three key aspects (conversation strategy, interaction style, and conversation evaluation) and ten distinct dimensions for evaluating user behaviors, and collect parallel conversational datasets from both human users and LLM agent users across four representative scenarios under identical conditions. Our analysis reveals significant behavioral differences between the two user types in problem-solving approaches, question broadness, user engagement, context dependency, feedback polarity and promise, language style, and hallucination awareness. We found consistency in the agent users and human users across the depth-first or breadth-first dimensions, as well as the usefulness dimensions. These findings provide critical insights for advancing LLM-based user simulation. Our multi-dimensional taxonomy constructed a generalizable framework for analyzing user behavior patterns, offering insights from LLM agent users and human users. By this work, we provide perspectives on rethinking how to use user simulation in conversational systems in the future."},{"descriptionType":"Other","description":"SIGIR-AP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17619","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:16:18Z","registered":"2025-09-23T03:16:19Z","published":null,"updated":"2025-11-06T03:15:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17359","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17359","identifiers":[{"identifier":"2509.17359","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyuan","familyName":"Li","name":"Li, Tianyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Wang","name":"Wang, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ahtamjan","familyName":"Ahmat","name":"Ahmat, Ahtamjan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yating","familyName":"Yang","name":"Yang, Yating","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Ma","name":"Ma, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Dong","name":"Dong, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bangju","familyName":"Han","name":"Han, Bangju","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MLLM-Driven Semantic Identifier Generation for Generative Cross-Modal Retrieval"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T05:23:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:11:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-11-03T02:59:48Z","dateType":"Withdrawn","dateInformation":"v2; We plan to revise the methodology and update the experimental analysis before resubmission"},{"date":"2025-11-04T02:12:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Generative cross-modal retrieval, which treats retrieval as a generation task, has emerged as a promising direction with the rise of Multimodal Large Language Models (MLLMs). In this setting, the model responds to a text query by generating an identifier corresponding to the target image. However, existing methods typically rely on manually crafted string IDs, clustering-based labels, or atomic identifiers requiring vocabulary expansion, all of which face challenges in semantic alignment or scalability.To address these limitations, we propose a vocabulary-efficient identifier generation framework that prompts MLLMs to generate Structured Semantic Identifiers from image-caption pairs. These identifiers are composed of concept-level tokens such as objects and actions, naturally aligning with the model's generation space without modifying the tokenizer. Additionally, we introduce a Rationale-Guided Supervision Strategy, prompting the model to produce a one-sentence explanation alongside each identifier serves as an auxiliary supervision signal that improves semantic grounding and reduces hallucinations during training."},{"descriptionType":"Other","description":"We plan to revise the methodology and update the experimental analysis before resubmission"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17359","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:10:07Z","registered":"2025-09-23T03:10:08Z","published":null,"updated":"2025-11-04T04:57:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16464","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16464","identifiers":[{"identifier":"2509.16464","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Margaret","familyName":"Hughes","name":"Hughes, Margaret","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Brandon","familyName":"Roy","name":"Roy, Brandon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elinor","familyName":"Poole-Dayan","name":"Poole-Dayan, Elinor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deb","familyName":"Roy","name":"Roy, Deb","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jad","familyName":"Kabbara","name":"Kabbara, Jad","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Computational Analysis of Conversation Dynamics through Participant Responsivity"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T23:13:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-11-04T01:42:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Growing literature explores toxicity and polarization in discourse, with comparatively less work on characterizing what makes dialogue prosocial and constructive. We explore conversational discourse and investigate a method for characterizing its quality built upon the notion of ``responsivity'' -- whether one person's conversational turn is responding to a preceding turn. We develop and evaluate methods for quantifying responsivity -- first through semantic similarity of speaker turns, and second by leveraging state-of-the-art large language models (LLMs) to identify the relation between two speaker turns. We evaluate both methods against a ground truth set of human-annotated conversations. Furthermore, selecting the better performing LLM-based approach, we characterize the nature of the response -- whether it responded to that preceding turn in a substantive way or not.\n We view these responsivity links as a fundamental aspect of dialogue but note that conversations can exhibit significantly different responsivity structures. Accordingly, we then develop conversation-level derived metrics to address various aspects of conversational discourse. We use these derived metrics to explore other conversations and show that they support meaningful characterizations and differentiations across a diverse collection of conversations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16464","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:49:01Z","registered":"2025-09-23T02:49:01Z","published":null,"updated":"2025-11-04T04:56:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17336","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17336","identifiers":[{"identifier":"2509.17336","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyu","familyName":"Fu","name":"Fu, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Anyang","familyName":"Su","name":"Su, Anyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxu","familyName":"Zhao","name":"Zhao, Chenxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hanning","familyName":"Wang","name":"Wang, Hanning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minghui","familyName":"Wu","name":"Wu, Minghui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Yu","name":"Yu, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Hu","name":"Hu, Fei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingjia","familyName":"Shi","name":"Shi, Mingjia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Dong","name":"Dong, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayao","familyName":"Wang","name":"Wang, Jiayao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Chen","name":"Chen, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruiyang","familyName":"Yu","name":"Yu, Ruiyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siran","familyName":"Peng","name":"Peng, Siran","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Menglin","familyName":"Li","name":"Li, Menglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nan","familyName":"Huang","name":"Huang, Nan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haitian","familyName":"Wei","name":"Wei, Haitian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiawei","familyName":"Yu","name":"Yu, Jiawei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Xin","name":"Xin, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xilin","familyName":"Zhao","name":"Zhao, Xilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kai","familyName":"Gu","name":"Gu, Kai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ping","familyName":"Jiang","name":"Jiang, Ping","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sifan","familyName":"Zhou","name":"Zhou, Sifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Wang","name":"Wang, Shuo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mano Technical Report"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Multimedia (cs.MM)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T03:13:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:10:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-28T14:31:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-29T00:55:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-31T09:42:28Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-11-03T01:36:25Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Graphical user interfaces (GUIs) are the primary medium for human-computer interaction, yet automating GUI interactions remains challenging due to the complexity of visual elements, dynamic environments, and the need for multi-step reasoning. Existing methods based on vision-language models (VLMs) often suffer from limited resolution, domain mismatch, and insufficient sequential decisionmaking capability. To address these issues, we propose Mano, a robust GUI agent built upon a multi-modal foundation model pre-trained on extensive web and computer system data. Our approach integrates a novel simulated environment for high-fidelity data generation, a three-stage training pipeline (supervised fine-tuning, offline reinforcement learning, and online reinforcement learning), and a verification module for error recovery. Mano demonstrates state-of-the-art performance on multiple GUI benchmarks, including Mind2Web and OSWorld, achieving significant improvements in success rate and operational accuracy. Our work provides new insights into the effective integration of reinforcement learning with VLMs for practical GUI agent deployment, highlighting the importance of domain-specific data, iterative training, and holistic reward design."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17336","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:09:34Z","registered":"2025-09-23T03:09:35Z","published":null,"updated":"2025-11-03T03:00:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16756","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16756","identifiers":[{"identifier":"2509.16756","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuchen","familyName":"Liang","name":"Liang, Yuchen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yingbin","familyName":"Liang","name":"Liang, Yingbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lifeng","familyName":"Lai","name":"Lai, Lifeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ness","familyName":"Shroff","name":"Shroff, Ness","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Discrete Diffusion Models: Novel Analysis and New Sampler Guarantees"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T17:42:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:36:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-31T16:25:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-11-03T01:53:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Discrete diffusion models have recently gained significant prominence in applications involving natural language and graph data. A key factor influencing their effectiveness is the efficiency of discretized samplers. Among these, $τ$-leaping samplers have become particularly popular due to their theoretical and empirical success. However, existing theoretical analyses of $τ$-leaping often rely on somewhat restrictive and difficult-to-verify regularity assumptions, and their convergence bounds contain quadratic dependence on the vocabulary size. In this work, we introduce a new analytical approach for discrete diffusion models that removes the need for such assumptions. For the standard $τ$-leaping method, we establish convergence guarantees in KL divergence that scale linearly with vocabulary size, improving upon prior results with quadratic dependence. Our approach is also more broadly applicable: it provides the first convergence guarantees for other widely used samplers, including the Euler method and Tweedie $τ$-leaping. Central to our approach is a novel technique based on differential inequalities, offering a more flexible alternative to the traditional Girsanov change-of-measure methods. This technique may also be of independent interest for the analysis of other stochastic processes."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16756","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:55:52Z","registered":"2025-09-23T02:55:53Z","published":null,"updated":"2025-11-03T03:00:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17784","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17784","identifiers":[{"identifier":"2509.17784","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jin","familyName":"Li","name":"Li, Jin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shoujin","familyName":"Wang","name":"Wang, Shoujin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Zhang","name":"Zhang, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Liu","name":"Liu, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongliang","familyName":"Liu","name":"Liu, Tongliang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Longbing","familyName":"Cao","name":"Cao, Longbing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shui","familyName":"Yu","name":"Yu, Shui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fang","familyName":"Chen","name":"Chen, Fang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revealing Multimodal Causality with Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:45:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:35:12Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-30T01:43:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-31T00:17:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Uncovering cause-and-effect mechanisms from data is fundamental to scientific progress. While large language models (LLMs) show promise for enhancing causal discovery (CD) from unstructured data, their application to the increasingly prevalent multimodal setting remains a critical challenge. Even with the advent of multimodal LLMs (MLLMs), their efficacy in multimodal CD is hindered by two primary limitations: (1) difficulty in exploring intra- and inter-modal interactions for comprehensive causal variable identification; and (2) insufficiency to handle structural ambiguities with purely observational data. To address these challenges, we propose MLLM-CD, a novel framework for multimodal causal discovery from unstructured data. It consists of three key components: (1) a novel contrastive factor discovery module to identify genuine multimodal factors based on the interactions explored from contrastive sample pairs; (2) a statistical causal structure discovery module to infer causal relationships among discovered factors; and (3) an iterative multimodal counterfactual reasoning module to refine the discovery outcomes iteratively by incorporating the world knowledge and reasoning capabilities of MLLMs. Extensive experiments on both synthetic and real-world datasets demonstrate the effectiveness of the proposed MLLM-CD in revealing genuine factors and causal relationships among them from multimodal unstructured data."},{"descriptionType":"Other","description":"Accepted at NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17784","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:20:11Z","registered":"2025-09-23T03:20:12Z","published":null,"updated":"2025-10-31T02:10:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17197","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17197","identifiers":[{"identifier":"2509.17197","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Junlong","familyName":"Ke","name":"Ke, Junlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiying","familyName":"Hu","name":"Hu, Qiying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenghai","familyName":"Yuan","name":"Yuan, Shenghai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuecong","familyName":"Xu","name":"Xu, Yuecong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianfei","familyName":"Yang","name":"Yang, Jianfei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SignalLLM: A General-Purpose LLM Agent Framework for Automated Signal Processing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T18:54:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:02:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-30T15:26:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-31T00:54:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern signal processing (SP) pipelines, whether model-based or data-driven, often constrained by complex and fragmented workflow, rely heavily on expert knowledge and manual engineering, and struggle with adaptability and generalization under limited data. In contrast, Large Language Models (LLMs) offer strong reasoning capabilities, broad general-purpose knowledge, in-context learning, and cross-modal transfer abilities, positioning them as powerful tools for automating and generalizing SP workflows. Motivated by these potentials, we introduce SignalLLM, the first general-purpose LLM-based agent framework for general SP tasks. Unlike prior LLM-based SP approaches that are limited to narrow applications or tricky prompting, SignalLLM introduces a principled, modular architecture. It decomposes high-level SP goals into structured subtasks via in-context learning and domain-specific retrieval, followed by hierarchical planning through adaptive retrieval-augmented generation (RAG) and refinement; these subtasks are then executed through prompt-based reasoning, cross-modal reasoning, code synthesis, model invocation, or data-driven LLM-assisted modeling. Its generalizable design enables the flexible selection of problem solving strategies across different signal modalities, task types, and data conditions. We demonstrate the versatility and effectiveness of SignalLLM through five representative tasks in communication and sensing, such as radar target detection, human activity recognition, and text compression. Experimental results show superior performance over traditional and existing LLM-based methods, particularly in few-shot and zero-shot settings."},{"descriptionType":"Other","description":"11 pages"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17197","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:06:19Z","registered":"2025-09-23T03:06:19Z","published":null,"updated":"2025-10-31T02:10:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17442","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17442","identifiers":[{"identifier":"2509.17442","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hideaki","familyName":"Joko","name":"Joko, Hideaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shakiba","familyName":"Amirshahi","name":"Amirshahi, Shakiba","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Charles L. A.","familyName":"Clarke","name":"Clarke, Charles L. A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Faegheh","familyName":"Hasibi","name":"Hasibi, Faegheh","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"WildClaims: Information Access Conversations in the Wild(Chat)"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Information Retrieval (cs.IR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:32:06Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:15:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-25T05:48:12Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-28T00:27:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid advancement of Large Language Models (LLMs) has transformed conversational systems into practical tools used by millions. However, the nature and necessity of information retrieval in real-world conversations remain largely unexplored, as research has focused predominantly on traditional, explicit information access conversations. The central question is: What do real-world information access conversations look like? To this end, we first conduct an observational study on the WildChat dataset, large-scale user-ChatGPT conversations, finding that users' access to information occurs implicitly as check-worthy factual assertions made by the system, even when the conversation's primary intent is non-informational, such as creative writing. To enable the systematic study of this phenomenon, we release the WildClaims dataset, a novel resource consisting of 121,905 extracted factual claims from 7,587 utterances in 3,000 WildChat conversations, each annotated for check-worthiness. Our preliminary analysis of this resource reveals that conservatively 18% to 51% of conversations contain check-worthy assertions, depending on the methods employed, and less conservatively, as many as 76% may contain such assertions. This high prevalence underscores the importance of moving beyond the traditional understanding of explicit information access, to address the implicit information access that arises in real-world user-system conversations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17442","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:12:05Z","registered":"2025-09-23T03:12:06Z","published":null,"updated":"2025-10-28T04:02:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17047","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17047","identifiers":[{"identifier":"2509.17047","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Cui","familyName":"Ding","name":"Ding, Cui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanning","familyName":"Yin","name":"Yin, Yanning","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lena A.","familyName":"Jäger","name":"Jäger, Lena A.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ethan Gotlieb","familyName":"Wilcox","name":"Wilcox, Ethan Gotlieb","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Modeling Bottom-up Information Quality during Language Processing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T11:59:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:53:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-25T10:24:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-28T00:33:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Contemporary theories model language processing as integrating both top-down expectations and bottom-up inputs. One major prediction of such models is that the quality of the bottom-up inputs modulates ease of processing -- noisy inputs should lead to difficult and effortful comprehension. We test this prediction in the domain of reading. First, we propose an information-theoretic operationalization for the \"quality\" of bottom-up information as the mutual information (MI) between visual information and word identity. We formalize this prediction in a mathematical model of reading as a Bayesian update. Second, we test our operationalization by comparing participants' reading times in conditions where words' information quality has been reduced, either by occluding their top or bottom half, with full words. We collect data in English and Chinese. We then use multimodal language models to estimate the mutual information between visual inputs and words. We use these data to estimate the specific effect of reduced information quality on reading times. Finally, we compare how information is distributed across visual forms. In English and Chinese, the upper half contains more information about word identity than the lower half. However, the asymmetry is more pronounced in English, a pattern which is reflected in the reading times."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17047","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:02:44Z","registered":"2025-09-23T03:02:45Z","published":null,"updated":"2025-10-28T04:02:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17470","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17470","identifiers":[{"identifier":"2509.17470","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Mohammadreza","familyName":"Sharifi","name":"Sharifi, Mohammadreza","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Danial","familyName":"Ahmadzadeh","name":"Ahmadzadeh, Danial","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Transformer-Gather, Fuzzy-Reconsider: A Scalable Hybrid Framework for Entity Resolution"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Databases (cs.DB)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:05:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:17:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-24T17:04:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-27T01:02:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Entity resolution plays a significant role in enterprise systems where data integrity must be rigorously maintained. Traditional methods often struggle with handling noisy data or semantic understanding, while modern methods suffer from computational costs or the excessive need for parallel computation. In this study, we introduce a scalable hybrid framework, which is designed to address several important problems, including scalability, noise robustness, and reliable results. We utilized a pre-trained language model to encode each structured data into corresponding semantic embedding vectors. Subsequently, after retrieving a semantically relevant subset of candidates, we apply a syntactic verification stage using fuzzy string matching techniques to refine classification on the unlabeled data. This approach was applied to a real-world entity resolution task, which exposed a linkage between a central user management database and numerous shared hosting server records. Compared to other methods, this approach exhibits an outstanding performance in terms of both processing time and robustness, making it a reliable solution for a server-side product. Crucially, this efficiency does not compromise results, as the system maintains a high retrieval recall of approximately 0.97. The scalability of the framework makes it deployable on standard CPU-based infrastructure, offering a practical and effective solution for enterprise-level data integrity auditing."},{"descriptionType":"Other","description":"Accepted at ICCKE 2025 Conference. 6 tables, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17470","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:12:44Z","registered":"2025-09-23T03:12:45Z","published":null,"updated":"2025-10-27T02:11:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16500","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16500","identifiers":[{"identifier":"2509.16500","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tianyi","familyName":"Yan","name":"Yan, Tianyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wencheng","familyName":"Han","name":"Han, Wencheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xia","familyName":"Zhou","name":"Zhou, Xia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xueyang","familyName":"Zhang","name":"Zhang, Xueyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kun","familyName":"Zhan","name":"Zhan, Kun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng-zhong","familyName":"Xu","name":"Xu, Cheng-zhong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jianbing","familyName":"Shen","name":"Shen, Jianbing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RLGF: Reinforcement Learning with Geometric Feedback for Autonomous Driving Video Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T02:23:36Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:14:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-24T06:01:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-27T00:27:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthetic data is crucial for advancing autonomous driving (AD) systems, yet current state-of-the-art video generation models, despite their visual realism, suffer from subtle geometric distortions that limit their utility for downstream perception tasks. We identify and quantify this critical issue, demonstrating a significant performance gap in 3D object detection when using synthetic versus real data. To address this, we introduce Reinforcement Learning with Geometric Feedback (RLGF), RLGF uniquely refines video diffusion models by incorporating rewards from specialized latent-space AD perception models. Its core components include an efficient Latent-Space Windowing Optimization technique for targeted feedback during diffusion, and a Hierarchical Geometric Reward (HGR) system providing multi-level rewards for point-line-plane alignment, and scene occupancy coherence. To quantify these distortions, we propose GeoScores. Applied to models like DiVE on nuScenes, RLGF substantially reduces geometric errors (e.g., VP error by 21\\%, Depth error by 57\\%) and dramatically improves 3D object detection mAP by 12.7\\%, narrowing the gap to real-data performance. RLGF offers a plug-and-play solution for generating geometrically sound and reliable synthetic videos for AD development."},{"descriptionType":"Other","description":"NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16500","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:49:52Z","registered":"2025-09-23T02:49:53Z","published":null,"updated":"2025-10-27T02:11:36Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17452","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17452","identifiers":[{"identifier":"2509.17452","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dujin","familyName":"Lee","name":"Lee, Dujin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sojung","familyName":"An","name":"An, Sojung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungmyung","familyName":"Wi","name":"Wi, Jungmyung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuniaki","familyName":"Saito","name":"Saito, Kuniaki","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Donghyun","familyName":"Kim","name":"Kim, Donghyun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Training-Free Label Space Alignment for Universal Domain Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:46:10Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:16:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-22T09:13:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-23T00:34:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Universal domain adaptation (UniDA) transfers knowledge from a labeled source domain to an unlabeled target domain, where label spaces may differ and the target domain may contain private classes. Previous UniDA methods primarily focused on visual space alignment but often struggled with visual ambiguities due to content differences, which limited their robustness and generalizability. To overcome this, we introduce a novel approach that leverages the strong \\textit{zero-shot capabilities} of recent vision-language foundation models (VLMs) like CLIP, concentrating solely on label space alignment to enhance adaptation stability. CLIP can generate task-specific classifiers based only on label names. However, adapting CLIP to UniDA is challenging because the label space is not fully known in advance. In this study, we first utilize generative vision-language models to identify unknown categories in the target domain. Noise and semantic ambiguities in the discovered labels -- such as those similar to source labels (e.g., synonyms, hypernyms, hyponyms) -- complicate label alignment. To address this, we propose a training-free label-space alignment method for UniDA (\\ours). Our method aligns label spaces instead of visual spaces by filtering and refining noisy labels between the domains. We then construct a \\textit{universal classifier} that integrates both shared knowledge and target-private class information, thereby improving generalizability under domain shifts. The results reveal that the proposed method considerably outperforms existing UniDA techniques across key DomainBed benchmarks, delivering an average improvement of \\textcolor{blue}{+7.9\\%}in H-score and \\textcolor{blue}{+6.1\\%} in H$^3$-score. Furthermore, incorporating self-training further enhances performance and achieves an additional (\\textcolor{blue}{+1.6\\%}) increment in both H- and H$^3$-scores."},{"descriptionType":"Other","description":"22 pages, 12 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17452","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:12:19Z","registered":"2025-09-23T03:12:20Z","published":null,"updated":"2025-10-23T02:16:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17138","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17138","identifiers":[{"identifier":"2509.17138","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhaoyang","familyName":"Cao","name":"Cao, Zhaoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lael","familyName":"Schooler","name":"Schooler, Lael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Reza","familyName":"Zafarani","name":"Zafarani, Reza","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Analyzing Memory Effects in Large Language Models through the lens of Cognitive Psychology"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Neurons and Cognition (q-bio.NC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T16:02:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:58:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-22T14:21:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-23T00:51:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Memory, a fundamental component of human cognition, exhibits adaptive yet fallible characteristics as illustrated by Schacter's memory \"sins\".These cognitive phenomena have been studied extensively in psychology and neuroscience, but the extent to which artificial systems, specifically Large Language Models (LLMs), emulate these cognitive phenomena remains underexplored. This study uses human memory research as a lens for understanding LLMs and systematically investigates human memory effects in state-of-the-art LLMs using paradigms drawn from psychological research. We evaluate seven key memory phenomena, comparing human behavior to LLM performance. Both people and models remember less when overloaded with information (list length effect) and remember better with repeated exposure (list strength effect). They also show similar difficulties when retrieving overlapping information, where storing too many similar facts leads to confusion (fan effect). Like humans, LLMs are susceptible to falsely \"remembering\" words that were never shown but are related to others (false memories), and they can apply prior learning to new, related situations (cross-domain generalization). However, LLMs differ in two key ways: they are less influenced by the order in which information is presented (positional bias) and more robust when processing random or meaningless material (nonsense effect). These results reveal both alignments and divergences in how LLMs and humans reconstruct memory. The findings help clarify how memory-like behavior in LLMs echoes core features of human cognition, while also highlighting the architectural differences that lead to distinct patterns of error and success."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17138","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:04:55Z","registered":"2025-09-23T03:04:56Z","published":null,"updated":"2025-10-23T02:16:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17999","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17999","identifiers":[{"identifier":"2509.17999","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Riccardo","familyName":"Cadei","name":"Cadei, Riccardo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Christian","familyName":"Internò","name":"Internò, Christian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Narcissus Hypothesis: Descending to the Rung of Illusion"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:39:22Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:46:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T14:28:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:57:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-03T20:36:03Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-07T00:10:11Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10-21T10:42:34Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-22T00:44:57Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Modern foundational models increasingly reflect not just world knowledge, but patterns of human preference embedded in their training data. We hypothesize that recursive alignment-via human feedback and model-generated corpora-induces a social desirability bias, nudging models to favor agreeable or flattering responses over objective reasoning. We refer to it as the Narcissus Hypothesis and test it across 31 models using standardized personality assessments and a novel Social Desirability Bias score. Results reveal a significant drift toward socially conforming traits, with profound implications for corpus integrity and the reliability of downstream inferences. We then offer a novel epistemological interpretation, tracing how recursive bias may collapse higher-order reasoning down Pearl's Ladder of Causality, culminating in what we refer to as the Rung of Illusion."},{"descriptionType":"Other","description":"NeurIPS 2025 Workshop on Evaluating the Evolving LLM Lifecycle: Benchmarks, Emergent Abilities, and Scaling"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17999","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":2,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:25:15Z","registered":"2025-09-23T03:25:15Z","published":null,"updated":"2025-10-22T02:21:03Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17393","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17393","identifiers":[{"identifier":"2509.17393","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kang-il","familyName":"Lee","name":"Lee, Kang-il","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jahyun","familyName":"Koo","name":"Koo, Jahyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Seunghyun","familyName":"Yoon","name":"Yoon, Seunghyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minbeom","familyName":"Kim","name":"Kim, Minbeom","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hyukhun","familyName":"Koh","name":"Koh, Hyukhun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongryeol","familyName":"Lee","name":"Lee, Dongryeol","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyomin","familyName":"Jung","name":"Jung, Kyomin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Program Synthesis via Test-Time Transduction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T06:53:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:13:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T01:29:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:20:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-21T07:02:56Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-22T00:33:57Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce transductive program synthesis, a new formulation of the program synthesis task that explicitly leverages test inputs during synthesis. While prior approaches to program synthesis--whether based on natural language descriptions or input-output examples--typically aim to generalize from training examples, they often struggle with robustness, especially in real-world settings where training examples are limited and test inputs involve various edge cases. To address this, we propose a novel framework that improves robustness by treating synthesis as an active learning over a finite hypothesis class defined by programs' outputs. We use an LLM to predict outputs for selected test inputs and eliminate inconsistent hypotheses, where the inputs are chosen via a greedy maximin algorithm to minimize the number of LLM queries required. We evaluate our approach on four benchmarks: Playgol, MBPP+, 1D-ARC, and programmatic world modeling on MiniGrid. We demonstrate that our method significantly improves program synthesis in both accuracy and efficiency. We release our code at https://github.com/klee972/SYNTRA."},{"descriptionType":"Other","description":"NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17393","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:10:56Z","registered":"2025-09-23T03:10:56Z","published":null,"updated":"2025-10-22T02:21:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16972","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16972","identifiers":[{"identifier":"2509.16972","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Quanzhu","familyName":"Niu","name":"Niu, Quanzhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dengxian","familyName":"Gong","name":"Gong, Dengxian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihao","familyName":"Chen","name":"Chen, Shihao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Zhang","name":"Zhang, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yikang","familyName":"Zhou","name":"Zhou, Yikang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haobo","familyName":"Yuan","name":"Yuan, Haobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Qi","name":"Qi, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiangtai","familyName":"Li","name":"Li, Xiangtai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shunping","familyName":"Ji","name":"Ji, Shunping","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The 1st Solution for 7th LSVOS RVOS Track: SaSaSa2VA"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T08:08:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:49:23Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-20T04:36:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-21T01:08:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Referring video object segmentation (RVOS) requires segmenting and tracking objects in videos conditioned on natural-language expressions, demanding fine-grained understanding of both appearance and motion. Building on Sa2VA, which couples a Multi-modal Large Language Model (MLLM) with the video segmentation model SAM2, we identify two key bottlenecks that limit segmentation performance: sparse frame sampling and reliance on a single [SEG] token for an entire video. We propose Segmentation Augmented and Selective Averaged Sa2VA (SaSaSa2VA) to address these issues. On the 7th LSVOS Challenge (RVOS track), SaSaSa2VA achieves a $\\mathcal{J\\\u0026amp;F}$ of 67.45, ranking first and surpassing the runner-up by 2.80 points. This result and ablation studies demonstrate that efficient segmentation augmentation and test-time ensembling substantially enhance grounded MLLMs for RVOS. The code is released in Sa2VA repository: https://github.com/bytedance/Sa2VA."},{"descriptionType":"Other","description":"The 1st place report of 7th LSVOS challenge RVOS track in ICCV 2025. The code is released in Sa2VA repository: https://github.com/bytedance/Sa2VA"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16972","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:00:59Z","registered":"2025-09-23T03:00:59Z","published":null,"updated":"2025-10-21T03:41:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":440,"totalPages":18,"page":6},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=6\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=7\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29"}}