<td id="S5.T1.2.10.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_l ltx_border_r">
<span id="S5.T1.2.10.1.1" class="ltx_inline-block ltx_align_top" style="width:45.5pt;">
