<td id="S6.T2.2.1.12.5" class="ltx_td ltx_align_left ltx_align_top">
<span id="S6.T2.2.1.12.5.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S6.T2.2.1.12.5.1.1" class="ltx_p">On-the-fly possible</span>
</span></td></tr>
