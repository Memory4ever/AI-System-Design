{"data":[{"id":"10.48550/arxiv.2509.16293","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16293","identifiers":[{"identifier":"2509.16293","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Borui","familyName":"Wan","name":"Wan, Borui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gaohong","familyName":"Liu","name":"Liu, Gaohong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zuquan","familyName":"Song","name":"Song, Zuquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Wang","name":"Wang, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yun","familyName":"Zhang","name":"Zhang, Yun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guangming","familyName":"Sheng","name":"Sheng, Guangming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuguang","familyName":"Wang","name":"Wang, Shuguang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Houmin","familyName":"Wei","name":"Wei, Houmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyuan","familyName":"Wang","name":"Wang, Chenyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiqiang","familyName":"Lou","name":"Lou, Weiqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"Yang","name":"Yang, Xi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mofan","familyName":"Zhang","name":"Zhang, Mofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kaihua","familyName":"Jiang","name":"Jiang, Kaihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Ren","name":"Ren, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaoyun","familyName":"Zhi","name":"Zhi, Xiaoyun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Menghan","familyName":"Yu","name":"Yu, Menghan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhe","familyName":"Nan","name":"Nan, Zhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhuolin","familyName":"Zheng","name":"Zheng, Zhuolin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baoquan","familyName":"Zhong","name":"Zhong, Baoquan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qinlong","familyName":"Wang","name":"Wang, Qinlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huan","familyName":"Yu","name":"Yu, Huan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinxin","familyName":"Chi","name":"Chi, Jinxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wang","familyName":"Zhang","name":"Zhang, Wang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhan","familyName":"Li","name":"Li, Yuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zixian","familyName":"Du","name":"Du, Zixian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sida","familyName":"Zhao","name":"Zhao, Sida","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yongqiang","familyName":"Zhang","name":"Zhang, Yongqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingzhe","familyName":"Tang","name":"Tang, Jingzhe","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zherui","familyName":"Liu","name":"Liu, Zherui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chuan","familyName":"Wu","name":"Wu, Chuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanghua","familyName":"Peng","name":"Peng, Yanghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haibin","familyName":"Lin","name":"Lin, Haibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wencong","familyName":"Xiao","name":"Xiao, Wencong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Liu","name":"Liu, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Xiang","name":"Xiang, Liang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Robust LLM Training Infrastructure at ByteDance"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T15:08:33Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:02:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-30T15:06:10Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-01T01:10:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-10-10T09:31:38Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-10-13T00:37:17Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-10-20T09:35:27Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-21T01:19:46Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The training scale of large language models (LLMs) has reached tens of thousands of GPUs and is still continuously expanding, enabling faster learning of larger models. Accompanying the expansion of the resource scale is the prevalence of failures (CUDA error, NaN values, job hang, etc.), which poses significant challenges to training stability. Any large-scale LLM training infrastructure should strive for minimal training interruption, efficient fault diagnosis, and effective failure tolerance to enable highly efficient continuous training. This paper presents ByteRobust, a large-scale GPU infrastructure management system tailored for robust and stable training of LLMs. It exploits the uniqueness of LLM training process and gives top priorities to detecting and recovering failures in a routine manner. Leveraging parallelisms and characteristics of LLM training, ByteRobust enables high-capacity fault tolerance, prompt fault demarcation, and localization with an effective data-driven approach, comprehensively ensuring continuous and efficient training of LLM tasks. ByteRobust is deployed on a production GPU platform and achieves 97% ETTR for a three-month training job on 9,600 GPUs."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16293","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:45:02Z","registered":"2025-09-23T02:45:02Z","published":null,"updated":"2025-10-21T03:41:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18092","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18092","identifiers":[{"identifier":"2509.18092","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Guocheng Gordon","familyName":"Qian","name":"Qian, Guocheng Gordon","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniil","familyName":"Ostashev","name":"Ostashev, Daniil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Egor","familyName":"Nemchinov","name":"Nemchinov, Egor","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Avihay","familyName":"Assouline","name":"Assouline, Avihay","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergey","familyName":"Tulyakov","name":"Tulyakov, Sergey","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kuan-Chieh Jackson","familyName":"Wang","name":"Wang, Kuan-Chieh Jackson","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kfir","familyName":"Aberman","name":"Aberman, Kfir","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"ComposeMe: Attribute-Specific Image Prompts for Controllable Human Image Generation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:59:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:51:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T05:30:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-17T00:28:22Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Share Alike 4.0 International","rightsIdentifier":"cc-by-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generating high-fidelity images of humans with fine-grained control over attributes such as hairstyle and clothing remains a core challenge in personalized text-to-image synthesis. While prior methods emphasize identity preservation from a reference image, they lack modularity and fail to provide disentangled control over specific visual attributes. We introduce a new paradigm for attribute-specific image prompting, in which distinct sets of reference images are used to guide the generation of individual aspects of human appearance, such as hair, clothing, and identity. Our method encodes these inputs into attribute-specific tokens, which are injected into a pre-trained text-to-image diffusion model. This enables compositional and disentangled control over multiple visual factors, even across multiple people within a single image. To promote natural composition and robust disentanglement, we curate a cross-reference training dataset featuring subjects in diverse poses and expressions, and propose a multi-attribute cross-reference training strategy that encourages the model to generate faithful outputs from misaligned attribute inputs while adhering to both identity and textual conditioning. Extensive experiments show that our method achieves state-of-the-art performance in accurately following both visual and textual prompts. Our framework paves the way for more configurable human image synthesis by combining visual prompting with text-driven generation. Webpage is available at: https://snap-research.github.io/composeme/."},{"descriptionType":"Other","description":"Accepted to SIGGRAPH Asia 2025, webpage: https://snap-research.github.io/composeme/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18092","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:27:24Z","registered":"2025-09-23T03:27:25Z","published":null,"updated":"2025-10-17T04:14:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17040","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17040","identifiers":[{"identifier":"2509.17040","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hang","familyName":"Du","name":"Du, Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayang","familyName":"Zhang","name":"Zhang, Jiayang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guoshun","familyName":"Nan","name":"Nan, Guoshun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wendi","familyName":"Deng","name":"Deng, Wendi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenyan","familyName":"Chen","name":"Chen, Zhenyan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenyang","familyName":"Zhang","name":"Zhang, Chenyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wang","familyName":"Xiao","name":"Xiao, Wang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shan","familyName":"Huang","name":"Huang, Shan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuqi","familyName":"Pan","name":"Pan, Yuqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tao","familyName":"Qi","name":"Qi, Tao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sicong","familyName":"Leng","name":"Leng, Sicong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Easy to Hard: The MIR Benchmark for Progressive Interleaved Multi-Image Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T11:19:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:52:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-16T02:56:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-17T00:22:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multi-image Interleaved Reasoning aims to improve Multi-modal Large Language Models (MLLMs) ability to jointly comprehend and reason across multiple images and their associated textual contexts, introducing unique challenges beyond single-image or non-interleaved multi-image tasks. While current multi-image benchmarks overlook interleaved textual contexts and neglect distinct relationships between individual images and their associated texts, enabling models to reason over multi-image interleaved data may significantly enhance their comprehension of complex scenes and better capture cross-modal correlations. To bridge this gap, we introduce a novel benchmark MIR, requiring joint reasoning over multiple images accompanied by interleaved textual contexts to accurately associate image regions with corresponding texts and logically connect information across images. To enhance MLLMs ability to comprehend multi-image interleaved data, we introduce reasoning steps for each instance within the benchmark and propose a stage-wise curriculum learning strategy. This strategy follows an \"easy to hard\" approach, progressively guiding models from simple to complex scenarios, thereby enhancing their ability to handle challenging tasks. Extensive experiments benchmarking multiple MLLMs demonstrate that our method significantly enhances models reasoning performance on MIR and other established benchmarks. We believe that MIR will encourage further research into multi-image interleaved reasoning, facilitating advancements in MLLMs capability to handle complex inter-modal tasks."},{"descriptionType":"Other","description":"Accepted by ICCV 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17040","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:02:34Z","registered":"2025-09-23T03:02:35Z","published":null,"updated":"2025-10-17T04:13:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16971","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16971","identifiers":[{"identifier":"2509.16971","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yan","familyName":"Rong","name":"Rong, Yan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chenxing","familyName":"Li","name":"Li, Chenxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dong","familyName":"Yu","name":"Yu, Dong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Liu","name":"Liu, Li","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AudioGenie-Reasoner: A Training-Free Multi-Agent Framework for Coarse-to-Fine Audio Deep Reasoning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T08:08:08Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:49:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-15T15:51:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-16T01:00:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Audio deep reasoning is a challenging task that requires expert-level perception, multi-step logical inference, and the integration of contextual knowledge. However, existing models suffer from a gap between audio perception and reasoning abilities due to the lack of training data with explicit reasoning chains and the absence of mechanisms for active exploration and iterative refinement. To address these challenges, we propose AudioGenie-Reasoner (AGR), the first unified training-free multi-agent system that coordinates perception and reasoning over an evolving chain of textual evidence. Our key idea is a paradigm shift that transforms audio deep reasoning into complex text understanding task from a new perspective, thereby unlocking the full potential of large language models. Specifically, the design of AGR mimics the human coarse-to-fine cognitive process. It first transforms the input audio into a coarse text-based document. Then, we design a novel proactive iterative document refinement loop, featuring tool-augmented routes and specialized agents, to continuously search for missing information and augment the evidence chain in a coarse-to-fine manner until sufficient question-related information is gathered for making final predictions. Experimental results show that AGR achieves state-of-the-art (SOTA) performance over existing open-source audio deep reasoning models across various benchmarks. The code will be available at https://github.com/ryysayhi/AudioGenie-Reasoner."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16971","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:00:57Z","registered":"2025-09-23T03:00:58Z","published":null,"updated":"2025-10-16T02:25:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16494","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16494","identifiers":[{"identifier":"2509.16494","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fengyuan","familyName":"Liu","name":"Liu, Fengyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rui","familyName":"Zhao","name":"Zhao, Rui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Chen","name":"Chen, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guohao","familyName":"Li","name":"Li, Guohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Philip","familyName":"Torr","name":"Torr, Philip","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Han","name":"Han, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jindong","familyName":"Gu","name":"Gu, Jindong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can an Individual Manipulate the Collective Decisions of Multi-Agents?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T01:54:20Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:13:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-15T07:53:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-16T00:33:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Individual Large Language Models (LLMs) have demonstrated significant capabilities across various domains, such as healthcare and law. Recent studies also show that coordinated multi-agent systems exhibit enhanced decision-making and reasoning abilities through collaboration. However, due to the vulnerabilities of individual LLMs and the difficulty of accessing all agents in a multi-agent system, a key question arises: If attackers only know one agent, could they still generate adversarial samples capable of misleading the collective decision? To explore this question, we formulate it as a game with incomplete information, where attackers know only one target agent and lack knowledge of the other agents in the system. With this formulation, we propose M-Spoiler, a framework that simulates agent interactions within a multi-agent system to generate adversarial samples. These samples are then used to manipulate the target agent in the target system, misleading the system's collaborative decision-making process. More specifically, M-Spoiler introduces a stubborn agent that actively aids in optimizing adversarial samples by simulating potential stubborn responses from agents in the target system. This enhances the effectiveness of the generated adversarial samples in misleading the system. Through extensive experiments across various tasks, our findings confirm the risks posed by the knowledge of an individual agent in multi-agent systems and demonstrate the effectiveness of our framework. We also explore several defense mechanisms, showing that our proposed attack framework remains more potent than baselines, underscoring the need for further research into defensive strategies."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16494","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:49:44Z","registered":"2025-09-23T02:49:44Z","published":null,"updated":"2025-10-16T02:25:21Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17238","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17238","identifiers":[{"identifier":"2509.17238","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Soheil","familyName":"Zibakhsh","name":"Zibakhsh, Soheil","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohammad","familyName":"Samragh","name":"Samragh, Mohammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kumari","familyName":"Nishu","name":"Nishu, Kumari","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lauren","familyName":"Hannah","name":"Hannah, Lauren","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arnav","familyName":"Kundu","name":"Kundu, Arnav","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minsik","familyName":"Cho","name":"Cho, Minsik","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MoEs Are Stronger than You Think: Hyper-Parallel Inference Scaling with RoE"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T21:05:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:04:51Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-13T16:48:37Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-15T00:01:25Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The generation quality of large language models (LLMs) is often improved by utilizing inference-time sequence-level scaling methods (e.g., Chain-of-Thought). We introduce hyper-parallel scaling, a complementary framework that improves prediction quality at the token level. Hyper-parallel scaling computes and aggregates multiple output proposals for a single token from the model. We implement this concept in Mixture-of-Experts (MoE) models, which we refer to as Roster of Experts (RoE). RoE is a training-free inference algorithm that turns a single MoE into a dynamic ensemble of MoEs. RoE injects controlled stochasticity into the expert routing mechanism, enabling it to sample multiple diverse experts for each token and aggregate their outputs for a more accurate final prediction. To overcome the computational cost, we introduce an efficient batching strategy and a specialized KV-caching mechanism that minimizes compute and memory overhead. For example, RoE enables a 7B MoE model to match the performance of a 10.5B MoE model while using 30% less compute for inference. These gains are achieved without any fine-tuning of model parameters."},{"descriptionType":"Other","description":"Corrected typo in arxiv abstract"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17238","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:07:17Z","registered":"2025-09-23T03:07:18Z","published":null,"updated":"2025-10-15T02:21:42Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16548","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16548","identifiers":[{"identifier":"2509.16548","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yuyang","familyName":"Ding","name":"Ding, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyu","familyName":"Shi","name":"Shi, Xinyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juntao","familyName":"Li","name":"Li, Juntao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobo","familyName":"Liang","name":"Liang, Xiaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhaopeng","familyName":"Tu","name":"Tu, Zhaopeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Min","familyName":"Zhang","name":"Zhang, Min","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SCAN: Self-Denoising Monte Carlo Annotation for Robust Process Reward Learning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T06:19:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:19:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-14T11:57:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-15T00:45:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Process reward models (PRMs) offer fine-grained, step-level evaluations that facilitate deeper reasoning processes in large language models (LLMs), proving effective in complex tasks like mathematical reasoning. However, developing PRMs is challenging due to the high cost and limited scalability of human-annotated data. Synthetic data from Monte Carlo (MC) estimation is a promising alternative but suffers from a high noise ratio, which can cause overfitting and hinder large-scale training. In this work, we conduct a preliminary study on the noise distribution in synthetic data from MC estimation, identifying that annotation models tend to both underestimate and overestimate step correctness due to limitations in their annotation capabilities. Building on these insights, we propose Self-Denoising Monte Carlo Annotation (SCAN), an efficient data synthesis and noise-tolerant learning framework. Our key findings indicate that: (1) Even lightweight models (e.g., 1.5B parameters) can produce high-quality annotations through a self-denoising strategy, enabling PRMs to achieve superior performance with only 6% the inference cost required by vanilla MC estimation. (2) With our robust learning strategy, PRMs can effectively learn from this weak supervision, achieving a 39.2 F1 score improvement (from 19.9 to 59.1) in ProcessBench. Despite using only a compact synthetic dataset, our models surpass strong baselines, including those trained on large-scale human-annotated datasets such as PRM800K. Furthermore, performance continues to improve as we scale up the synthetic data, highlighting the potential of SCAN for scalable, cost-efficient, and robust PRM training."},{"descriptionType":"Other","description":"NeurIPS 2025. Project page: https://scan-prm.github.io/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16548","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:50:59Z","registered":"2025-09-23T02:51:00Z","published":null,"updated":"2025-10-15T02:21:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17178","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17178","identifiers":[{"identifier":"2509.17178","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tian","familyName":"Lan","name":"Lan, Tian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinyuan","familyName":"Xu","name":"Xu, Jinyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xue","familyName":"He","name":"He, Xue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jenq-Neng","familyName":"Hwang","name":"Hwang, Jenq-Neng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Li","name":"Li, Lei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Attention Consistency for LLMs Explanation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T17:55:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-10-14T01:47:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Understanding the decision-making processes of large language models (LLMs) is essential for their trustworthy development and deployment. However, current interpretability methods often face challenges such as low resolution and high computational cost. To address these limitations, we propose the \\textbf{Multi-Layer Attention Consistency Score (MACS)}, a novel, lightweight, and easily deployable heuristic for estimating the importance of input tokens in decoder-based models. MACS measures contributions of input tokens based on the consistency of maximal attention. Empirical evaluations demonstrate that MACS achieves a favorable trade-off between interpretability quality and computational efficiency, showing faithfulness comparable to complex techniques with a 22\\% decrease in VRAM usage and 30\\% reduction in latency."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17178","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:05:52Z","registered":"2025-09-23T03:05:53Z","published":null,"updated":"2025-10-14T04:21:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17694","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17694","identifiers":[{"identifier":"2509.17694","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dongxu","familyName":"Lu","name":"Lu, Dongxu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Johan","familyName":"Jeuring","name":"Jeuring, Johan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Albert","familyName":"Gatt","name":"Gatt, Albert","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evaluating LLM-Generated Versus Human-Authored Responses in Role-Play Dialogues"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:33:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:28:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-08T23:27:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T00:15:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Evaluating large language models (LLMs) in long-form, knowledge-grounded role-play dialogues remains challenging. This study compares LLM-generated and human-authored responses in multi-turn professional training simulations through human evaluation ($N=38$) and automated LLM-as-a-judge assessment. Human evaluation revealed significant degradation in LLM-generated response quality across turns, particularly in naturalness, context maintenance and overall quality, while human-authored responses progressively improved. In line with this finding, participants also indicated a consistent preference for human-authored dialogue. These human judgements were validated by our automated LLM-as-a-judge evaluation, where Gemini 2.0 Flash achieved strong alignment with human evaluators on both zero-shot pairwise preference and stochastic 6-shot construct ratings, confirming the widening quality gap between LLM and human responses over time. Our work contributes a multi-turn benchmark exposing LLM degradation in knowledge-grounded role-play dialogues and provides a validated hybrid evaluation framework to guide the reliable integration of LLMs in training simulations."},{"descriptionType":"Other","description":"Accepted for publication at the 18th International Natural Language Generation Conference (INLG 2025). Revised version: improved image quality and minor corrections. No change to conclusions"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17694","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:18:04Z","registered":"2025-09-23T03:18:05Z","published":null,"updated":"2025-10-10T02:38:11Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16767","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16767","identifiers":[{"identifier":"2509.16767","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Ozgur","familyName":"Kara","name":"Kara, Ozgur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Harris","familyName":"Nisar","name":"Nisar, Harris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"James M.","familyName":"Rehg","name":"Rehg, James M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DiffEye: Diffusion-Based Continuous Eye-Tracking Data Generation Conditioned on Natural Images"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T18:20:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:37:07Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-09T12:52:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-10T00:53:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Numerous models have been developed for scanpath and saliency prediction, which are typically trained on scanpaths, which model eye movement as a sequence of discrete fixation points connected by saccades, while the rich information contained in the raw trajectories is often discarded. Moreover, most existing approaches fail to capture the variability observed among human subjects viewing the same image. They generally predict a single scanpath of fixed, pre-defined length, which conflicts with the inherent diversity and stochastic nature of real-world visual attention. To address these challenges, we propose DiffEye, a diffusion-based training framework designed to model continuous and diverse eye movement trajectories during free viewing of natural images. Our method builds on a diffusion model conditioned on visual stimuli and introduces a novel component, namely Corresponding Positional Embedding (CPE), which aligns spatial gaze information with the patch-based semantic features of the visual input. By leveraging raw eye-tracking trajectories rather than relying on scanpaths, DiffEye captures the inherent variability in human gaze behavior and generates high-quality, realistic eye movement patterns, despite being trained on a comparatively small dataset. The generated trajectories can also be converted into scanpaths and saliency maps, resulting in outputs that more accurately reflect the distribution of human visual attention. DiffEye is the first method to tackle this task on natural images using a diffusion model while fully leveraging the richness of raw eye-tracking data. Our extensive evaluation shows that DiffEye not only achieves state-of-the-art performance in scanpath generation but also enables, for the first time, the generation of continuous eye movement trajectories. Project webpage: https://diff-eye.github.io/"},{"descriptionType":"Other","description":"Accepted to NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16767","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:56:07Z","registered":"2025-09-23T02:56:08Z","published":null,"updated":"2025-10-10T02:38:08Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16765","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16765","identifiers":[{"identifier":"2509.16765","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Fagun","familyName":"Patel","name":"Patel, Fagun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duc Q.","familyName":"Nguyen","name":"Nguyen, Duc Q.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sang T.","familyName":"Truong","name":"Truong, Sang T.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jody","familyName":"Vaynshtok","name":"Vaynshtok, Jody","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sanmi","familyName":"Koyejo","name":"Koyejo, Sanmi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nick","familyName":"Haber","name":"Haber, Nick","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The Sound of Syntax: Finetuning and Comprehensive Evaluation of Language Models for Speech Pathology"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Sound (cs.SD)","lang":"en","subjectScheme":"arXiv"},{"subject":"Audio and Speech Processing (eess.AS)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T18:10:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:36:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-08T14:02:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-09T00:49:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"According to the U.S. National Institutes of Health, more than 3.4 million children experience speech disorders that require clinical intervention. The number of speech-language pathologists (SLPs) is roughly 20 times fewer than the number of affected children, highlighting a significant gap in children's care and a pressing need for technological support that improves the productivity of SLPs. State-of-the-art multimodal language models (MLMs) show promise for supporting SLPs, but their use remains underexplored largely due to a limited understanding of their performance in high-stakes clinical settings. To address this gap, we collaborate with domain experts to develop a taxonomy of real-world use cases of MLMs in speech-language pathologies. Building on this taxonomy, we introduce the first comprehensive benchmark for evaluating MLM across five core use cases, each containing 1,000 manually annotated data points. This benchmark includes robustness and sensitivity tests under various settings, including background noise, speaker gender, and accent. Our evaluation of 15 state-of-the-art MLMs reveals that no single model consistently outperforms others across all tasks. Notably, we find systematic disparities, with models performing better on male speakers, and observe that chain-of-thought prompting can degrade performance on classification tasks with large label spaces and narrow decision boundaries. Furthermore, we study fine-tuning MLMs on domain-specific data, achieving improvements of over 10\\% compared to base models. These findings highlight both the potential and limitations of current MLMs for speech-language pathology applications, underscoring the need for further research and targeted development."},{"descriptionType":"Other","description":"EMNLP 2025 Oral Presentation"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16765","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:56:05Z","registered":"2025-09-23T02:56:05Z","published":null,"updated":"2025-10-09T02:20:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17794","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17794","identifiers":[{"identifier":"2509.17794","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Tobias","familyName":"Groot","name":"Groot, Tobias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Salo","familyName":"Lacunes","name":"Lacunes, Salo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Evgenia","familyName":"Ilia","name":"Ilia, Evgenia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Learning to vary: Teaching LMs to reproduce human linguistic variability in next-word prediction"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:51:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:35:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-06T20:22:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-08T00:09:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Natural language generation (NLG) tasks are often subject to inherent variability; e.g. predicting the next word given a context has multiple valid responses, evident when asking multiple humans to complete the task. While having language models (LMs) that are aligned pluralistically, so that they are able to reproduce well the inherent diversity in perspectives of an entire population of interest is clearly beneficial, Ilia and Aziz (2024) show that LMs do not reproduce this type of linguistic variability well. They speculate this inability might stem from the lack of consistent training of LMs with data reflecting this type of inherent variability. As such, we investigate whether training LMs on multiple plausible word continuations per context can improve their ability to reproduce human linguistic variability for next-word prediction. We employ fine-tuning techniques for pre-trained and instruction-tuned models; and demonstrate their potential when fine-tuning GPT-2 and Mistral-7B-IT, using Provo Corpus. Our evaluation, which measures divergence among empirically estimated human and model next-word distributions across contexts before and after fine-tuning, shows that our multi-label fine-tuning improves the LMs' ability to reproduce linguistic variability; both for contexts that admit higher and lower variability."},{"descriptionType":"Other","description":"EMNLP UncertaiNLP Workshop 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17794","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:20:25Z","registered":"2025-09-23T03:20:26Z","published":null,"updated":"2025-10-08T02:21:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16551","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16551","identifiers":[{"identifier":"2509.16551","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dan John","familyName":"Velasco","name":"Velasco, Dan John","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthew Theodore","familyName":"Roque","name":"Roque, Matthew Theodore","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Rethinking the Role of Text Complexity in Language Model Pretraining"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T06:33:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:19:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-04T06:12:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-07T00:24:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Improving pretraining data quality and size is known to boost downstream performance, but the role of text complexity--how hard a text is to read--remains less explored. We reduce surface-level complexity (shorter sentences, simpler words, simpler structure) while keeping core content approximately constant and ask: (i) How does complexity affect language modeling across model sizes? (ii) Can useful representations be learned from simpler text alone? (iii) How does pretraining text complexity influence downstream language understanding? We simplify human-written texts using a large language model, pretrain causal models (28M-500M) from scratch on original vs. simplified data, and evaluate them in fine-tuning and zero-shot setups. We find that perplexity is sensitive to the interaction between model capacity and text complexity--smaller models degrade far less on simpler texts--while text complexity has little impact on fine-tuning evaluations, with zero-shot evaluations indicating that simpler texts benefit performance on linguistic knowledge tasks, whereas more complex texts favor tasks requiring world knowledge and entity tracking. Our findings suggest that different types of data diversity affect transfer and zero-shot performance differently, providing insight into tailoring data curation to specific goals."},{"descriptionType":"Other","description":"Camera-ready version for BabyLM Workshop at EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16551","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:51:03Z","registered":"2025-09-23T02:51:04Z","published":null,"updated":"2025-10-07T03:45:48Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16929","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16929","identifiers":[{"identifier":"2509.16929","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yongrui","familyName":"Chen","name":"Chen, Yongrui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Huang","name":"Huang, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunchang","familyName":"Liu","name":"Liu, Yunchang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shenyu","familyName":"Zhang","name":"Zhang, Shenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junhao","familyName":"He","name":"He, Junhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongtong","familyName":"Wu","name":"Wu, Tongtong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guilin","familyName":"Qi","name":"Qi, Guilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianxing","familyName":"Wu","name":"Wu, Tianxing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"K-DeCore: Facilitating Knowledge Transfer in Continual Structured Knowledge Reasoning via Knowledge Decoupling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T05:24:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:46:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T12:42:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:49:43Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09-28T23:34:21Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2025-09-30T01:23:28Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09-30T09:16:42Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2025-10-01T00:47:43Z","dateType":"Updated","dateInformation":"v4"},{"date":"2025-10-04T02:50:41Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2025-10-07T00:20:04Z","dateType":"Updated","dateInformation":"v5"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Continual Structured Knowledge Reasoning (CSKR) focuses on training models to handle sequential tasks, where each task involves translating natural language questions into structured queries grounded in structured knowledge. Existing general continual learning approaches face significant challenges when applied to this task, including poor generalization to heterogeneous structured knowledge and inefficient reasoning due to parameter growth as tasks increase. To address these limitations, we propose a novel CSKR framework, \\textsc{K-DeCore}, which operates with a fixed number of tunable parameters. Unlike prior methods, \\textsc{K-DeCore} introduces a knowledge decoupling mechanism that disentangles the reasoning process into task-specific and task-agnostic stages, effectively bridging the gaps across diverse tasks. Building on this foundation, \\textsc{K-DeCore} integrates a dual-perspective memory consolidation mechanism for distinct stages and introduces a structure-guided pseudo-data synthesis strategy to further enhance the model's generalization capabilities. Extensive experiments on four benchmark datasets demonstrate the superiority of \\textsc{K-DeCore} over existing continual learning methods across multiple metrics, leveraging various backbone large language models."},{"descriptionType":"Other","description":"Accepted in Neurips 2025 (poster)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16929","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:59:54Z","registered":"2025-09-23T02:59:54Z","published":null,"updated":"2025-10-07T03:45:24Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16360","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16360","identifiers":[{"identifier":"2509.16360","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Weikang","familyName":"Qiu","name":"Qiu, Weikang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tinglin","familyName":"Huang","name":"Huang, Tinglin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ryan","familyName":"Rullo","name":"Rullo, Ryan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yucheng","familyName":"Kuang","name":"Kuang, Yucheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ali","familyName":"Maatouk","name":"Maatouk, Ali","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"S. Raquel","familyName":"Ramos","name":"Ramos, S. Raquel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rex","familyName":"Ying","name":"Ying, Rex","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RephQA: Evaluating Readability of Large Language Models in Public Health Question Answering"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T19:09:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:04:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-03T00:51:44Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:14:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large Language Models (LLMs) hold promise in addressing complex medical problems. However, while most prior studies focus on improving accuracy and reasoning abilities, a significant bottleneck in developing effective healthcare agents lies in the readability of LLM-generated responses, specifically, their ability to answer public health problems clearly and simply to people without medical backgrounds. In this work, we introduce RephQA, a benchmark for evaluating the readability of LLMs in public health question answering (QA). It contains 533 expert-reviewed QA pairs from 27 sources across 13 topics, and includes a proxy multiple-choice task to assess informativeness, along with two readability metrics: Flesch-Kincaid grade level and professional score. Evaluation of 25 LLMs reveals that most fail to meet readability standards, highlighting a gap between reasoning and effective communication. To address this, we explore four readability-enhancing strategies-standard prompting, chain-of-thought prompting, Group Relative Policy Optimization (GRPO), and a token-adapted variant. Token-adapted GRPO achieves the best results, advancing the development of more practical and user-friendly public health agents. These results represent a step toward building more practical agents for public health."},{"descriptionType":"Other","description":"ACM KDD Health Track 2025 Blue Sky Best Paper"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16360","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:46:37Z","registered":"2025-09-23T02:46:37Z","published":null,"updated":"2025-10-06T02:01:04Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17650","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17650","identifiers":[{"identifier":"2509.17650","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Soroush","familyName":"Mahdi","name":"Mahdi, Soroush","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fardin","familyName":"Ayar","name":"Ayar, Fardin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ehsan","familyName":"Javanmardi","name":"Javanmardi, Ehsan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manabu","familyName":"Tsukada","name":"Tsukada, Manabu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mahdi","familyName":"Javanmardi","name":"Javanmardi, Mahdi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Evict3R: Training-Free Token Eviction for Memory-Bounded Streaming Visual Geometry Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T11:54:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:26:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-02T18:38:00Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-06T00:04:50Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Streaming visual transformers like StreamVGGT achieve strong 3D perception but suffer from unbounded growth of key value (KV) memory, which limits scalability. We propose a training-free, inference-time token eviction policy that bounds memory by discarding redundant tokens while keeping the most informative ones. Our method uses significantly less memory with little to no drop in accuracy: on 7-Scenes with long sequences it reduces peak memory from 18.63 GB to 9.39 GB while accuracy and completeness drop by only 0.003. Under strict memory budgets, eviction enables denser frame sampling, which improves reconstruction accuracy compared to the baseline. Experiments across video depth estimation (Sintel, KITTI), 3D reconstruction (7-Scenes, NRGBD), and camera pose estimation (Sintel, TUM-dynamics) show that our approach closely matches StreamVGGT at a fraction of the memory and makes long-horizon streaming inference more practical."},{"descriptionType":"Other","description":"project page: https://soroush-mim.github.io/projects/evict3r/"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17650","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:17:02Z","registered":"2025-09-23T03:17:02Z","published":null,"updated":"2025-10-06T01:59:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17847","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17847","identifiers":[{"identifier":"2509.17847","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Saghir","familyName":"Alfasly","name":"Alfasly, Saghir","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wataru","familyName":"Uegami","name":"Uegami, Wataru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"MD Enamul","familyName":"Hoq","name":"Hoq, MD Enamul","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ghazal","familyName":"Alabtah","name":"Alabtah, Ghazal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"H. R.","familyName":"Tizhoosh","name":"Tizhoosh, H. R.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semantic and Visual Crop-Guided Diffusion Models for Heterogeneous Tissue Synthesis in Histopathology"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:41:43Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:38:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-10-01T19:22:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-10-03T00:07:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Synthetic data generation in histopathology faces unique challenges: preserving tissue heterogeneity, capturing subtle morphological features, and scaling to unannotated datasets. We present a latent diffusion model that generates realistic heterogeneous histopathology images through a novel dual-conditioning approach combining semantic segmentation maps with tissue-specific visual crops. Unlike existing methods that rely on text prompts or abstract visual embeddings, our approach preserves critical morphological details by directly incorporating raw tissue crops from corresponding semantic regions. For annotated datasets (i.e., Camelyon16, Panda), we extract patches ensuring 20-80% tissue heterogeneity. For unannotated data (i.e., TCGA), we introduce a self-supervised extension that clusters whole-slide images into 100 tissue types using foundation model embeddings, automatically generating pseudo-semantic maps for training. Our method synthesizes high-fidelity images with precise region-wise annotations, achieving superior performance on downstream segmentation tasks. When evaluated on annotated datasets, models trained on our synthetic data show competitive performance to those trained on real data, demonstrating the utility of controlled heterogeneous tissue generation. In quantitative evaluation, prompt-guided synthesis reduces Frechet Distance by up to 6X on Camelyon16 (from 430.1 to 72.0) and yields 2-3x lower FD across Panda and TCGA. Downstream DeepLabv3+ models trained solely on synthetic data attain test IoU of 0.71 and 0.95 on Camelyon16 and Panda, within 1-2% of real-data baselines (0.72 and 0.96). By scaling to 11,765 TCGA whole-slide images without manual annotations, our framework offers a practical solution for an urgent need for generating diverse, annotated histopathology data, addressing a critical bottleneck in computational pathology."},{"descriptionType":"Other","description":"NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17847","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:21:39Z","registered":"2025-09-23T03:21:40Z","published":null,"updated":"2025-10-03T02:28:06Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16811","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16811","identifiers":[{"identifier":"2509.16811","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zihan","familyName":"Ding","name":"Ding, Zihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xinyi","familyName":"Wang","name":"Wang, Xinyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junlong","familyName":"Chen","name":"Chen, Junlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Per Ola","familyName":"Kristensson","name":"Kristensson, Per Ola","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junxiao","familyName":"Shen","name":"Shen, Junxiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Prompt-Driven Agentic Video Editing System: Autonomous Comprehension of Long-Form, Story-Driven Media"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Human-Computer Interaction (cs.HC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T21:22:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:39:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-28T07:22:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T00:59:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Creators struggle to edit long-form, narrative-rich videos not because of UI complexity, but due to the cognitive demands of searching, storyboarding, and sequencing hours of footage. Existing transcript- or embedding-based methods fall short for creative workflows, as models struggle to track characters, infer motivations, and connect dispersed events. We present a prompt-driven, modular editing system that helps creators restructure multi-hour content through free-form prompts rather than timelines. At its core is a semantic indexing pipeline that builds a global narrative via temporal segmentation, guided memory compression, and cross-granularity fusion, producing interpretable traces of plot, dialogue, emotion, and context. Users receive cinematic edits while optionally refining transparent intermediate outputs. Evaluated on 400+ videos with expert ratings, QA, and preference studies, our system scales prompt-driven editing, preserves narrative coherence, and balances automation with creator control."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16811","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:57:08Z","registered":"2025-09-23T02:57:09Z","published":null,"updated":"2025-09-30T05:15:05Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17542","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17542","identifiers":[{"identifier":"2509.17542","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Xing","familyName":"Chen","name":"Chen, Xing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rong","familyName":"Shi","name":"Shi, Rong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lu","familyName":"Zhao","name":"Zhao, Lu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lingbin","familyName":"Wang","name":"Wang, Lingbin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiao","familyName":"Jin","name":"Jin, Xiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueqiang","familyName":"Chen","name":"Chen, Yueqiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongfeng","familyName":"Sun","name":"Sun, Hongfeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Disaggregated Prefill and Decoding Inference System for Large Language Model Serving on Multi-Vendor GPUs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T09:00:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:20:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-28T03:02:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-30T00:53:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"LLM-based applications have been widely used in various industries, but with the increasing of models size, an efficient large language model (LLM) inference system is an urgent problem to be solved for service providers. Since the inference system is divided into two stage with different characteristics: Prefill and Decode, the two stage will interfere with each other during the inference process. Toward this end, a P-D disaggregated inference framework is proposed by some researchers. Current research is done on homogeneous GPUs, and lacks deployment solutions based on business scenarios. Compared with homogeneous GPUs, using heterogeneous GPUs to construct inference systems can better improve resource utilization and reduce costs. Even if GPUs from different vendors are used to build inference systems, on the basis of reducing costs, the resource utilization rate can be improved and the dependence on a single vendor can be reduced. Therefore, a P-D disaggreagetd inference system based on heterogeneous GPUs is designed, and the heterogeneous compatible transmission module in the system is designed to address heterogeneous GPU data compatibility issues. Then, a joint optimization algorithm of parallel strategy and instance number allocation is proposed to obtain the deployment solutions. Finally, the experimental results show that the P-D disaggregated inference system can well solve the hybrid inference problem of heterogeneous GPUs from different vendors, and the joint optimization algorithm can obtain the optimal deployment solution."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17542","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:14:28Z","registered":"2025-09-23T03:14:29Z","published":null,"updated":"2025-09-30T05:14:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17433","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17433","identifiers":[{"identifier":"2509.17433","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Miriam","familyName":"Schwarze","name":"Schwarze, Miriam","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hui Khee","familyName":"Looe","name":"Looe, Hui Khee","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Björn","familyName":"Poppe","name":"Poppe, Björn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pichaya","familyName":"Tappayuthpijarn","name":"Tappayuthpijarn, Pichaya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leo","familyName":"Thomas","name":"Thomas, Leo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hans","familyName":"Rabus","name":"Rabus, Hans","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Exploring Machine Learning Models for Physical Dose Calculation in Carbon Ion Therapy Using Heterogeneous Imaging Data -- A Proof of Concept Study"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Medical Physics (physics.med-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:25:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-29T17:27:04Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Background: Accurate and fast dose calculation is essential for optimizing carbon ion therapy. Existing machine learning (ML) models have been developed for other radiotherapy modalities. They use patient data with uniform CT imaging properties. Purpose: This study investigates the application of several ML models for physical dose calculation in carbon ion therapy and compares their ability to generalize to CT data with varying resolutions. Among the models examined is a Diffusion Model, which is tested for the first time for the calculation of physical dose distributions. Methods: A dataset was generated using publicly available CT images of the head and neck region. Monoenergetic carbon ion beams were simulated at various initial energies using Geant4 simulation software. A U-Net architecture was developed for dose prediction based on distributions of material density in patients and of absorbed dose in water. It was trained as a Generative Adversarial Network (GAN) generator, a Diffusion Model noise estimator, and as a standalone network. Their performances were compared with two models from literature. Results: All models produced dose distributions deviating by less than 2% from that obtained by a full Monte Carlo simulation, even for a patient not seen during training. Dose calculation time on a GPU was in the range of 3 ms to 15 s. The resource-efficient U-Net appears to perform comparably to the more computationally intensive GAN and Diffusion Model. Conclusion: This study demonstrates that ML models can effectively balance accuracy and speed for physical dose calculation in carbon ion therapy. Using the computationally efficient U-Net can help conserve resources. The generalizability of the models to different CT image resolutions enables the use for different patients without extensive retraining."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17433","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:52Z","registered":"2025-09-23T03:11:53Z","published":null,"updated":"2025-09-30T05:09:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17427","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17427","identifiers":[{"identifier":"2509.17427","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Hodaka","familyName":"Kawachi","name":"Kawachi, Hodaka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jose Reinaldo Cunha Santos A. V. Silva","familyName":"Neto","name":"Neto, Jose Reinaldo Cunha Santos A. V. Silva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yasushi","familyName":"Yagi","name":"Yagi, Yasushi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hajime","familyName":"Nagahara","name":"Nagahara, Hajime","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tomoya","familyName":"Nakamura","name":"Nakamura, Tomoya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Single-Image Depth from Defocus with Coded Aperture and Diffusion Posterior Sampling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:20:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-29T16:17:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"We propose a single-snapshot depth-from-defocus (DFD) reconstruction method for coded-aperture imaging that replaces hand-crafted priors with a learned diffusion prior used purely as regularization. Our optimization framework enforces measurement consistency via a differentiable forward model while guiding solutions with the diffusion prior in the denoised image domain, yielding higher accuracy and stability than classical optimization. Unlike U-Net-style regressors, our approach requires no paired defocus-RGBD training data and does not tie training to a specific camera configuration. Experiments on comprehensive simulations and a prototype camera demonstrate consistently strong RGBD reconstructions across noise levels, outperforming both U-Net baselines and a classical coded-aperture DFD method."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17427","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:11:44Z","registered":"2025-09-23T03:11:45Z","published":null,"updated":"2025-09-30T05:09:33Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17365","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17365","identifiers":[{"identifier":"2509.17365","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Amanuel Tafese","familyName":"Dufera","name":"Dufera, Amanuel Tafese","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pre-Trained CNN Architecture for Transformer-Based Image Caption Generation Model"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T05:32:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-29T16:25:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Automatic image captioning, a multifaceted task bridging computer vision and natural language processing, aims to generate descriptive textual content from visual input. While Convolutional Neural Networks (CNNs) and Long Short-Term Memory (LSTM) networks have achieved significant advancements, they present limitations. The inherent sequential nature of RNNs leads to sluggish training and inference times. LSTMs further struggle with retaining information from earlier sequence elements when dealing with very long sequences. This project presents a comprehensive guide to constructing and comprehending transformer models for image captioning. Transformers employ self-attention mechanisms, capturing both short- and long-range dependencies within the data. This facilitates efficient parallelization during both training and inference phases. We leverage the well-established Transformer architecture, recognized for its effectiveness in managing sequential data, and present a meticulous methodology. Utilizing the Flickr30k dataset, we conduct data pre-processing, construct a model architecture that integrates an EfficientNetB0 CNN for feature extraction, and train the model with attention mechanisms incorporated. Our approach exemplifies the utilization of parallelization for efficient training and inference. You can find the project on GitHub."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17365","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:10:16Z","registered":"2025-09-23T03:10:17Z","published":null,"updated":"2025-09-30T05:09:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17978","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17978","identifiers":[{"identifier":"2509.17978","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Antoni","familyName":"Guasch","name":"Guasch, Antoni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria Isabel","familyName":"Valdez","name":"Valdez, Maria Isabel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"The STAR-XAI Protocol: A Framework for Inducing and Verifying Agency, Reasoning, and Reliability in AI Agents"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Logic in Computer Science (cs.LO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:24:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:45:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-26T17:49:26Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T01:20:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The \"black box\" nature of Large Reasoning Models (LRMs) presents critical limitations in reliability and transparency, fueling the debate around the \"illusion of thinking\" and the challenge of state hallucinations in agentic systems. In response, we introduce The STAR-XAI Protocol (Socratic, Transparent, Agentic, Reasoning - for eXplainable Artificial Intelligence), a novel operational methodology for training and operating verifiably reliable AI agents. Our method reframes the human-AI interaction as a structured Socratic dialogue governed by an explicit, evolving symbolic rulebook (the Consciousness Transfer Package - CTP) and a suite of integrity protocols, including a state-locking Checksum that eradicates internal state corruption. Through an exhaustive case study in the complex strategic game \"Caps i Caps,\" we demonstrate that this \"Clear Box\" framework transforms an opaque LRM into a disciplined strategist. The agent not only exhibits the emergence of complex tactics, such as long-term planning, but also achieves ante-hoc transparency by justifying its intentions before acting. Crucially, it demonstrates Second-Order Agency by identifying and correcting flaws in its own supervisor-approved plans, leading to empirically-proven, 100% reliable state tracking and achieving \"zero hallucinations by design.\" The STAR-XAI Protocol thus offers a practical pathway toward building AI agents that are not just high-performing but intrinsically auditable, trustworthy, and reliable."},{"descriptionType":"Other","description":"Version 2: This article consolidates and replaces a previous version to present the complete research in a single, comprehensive manuscript"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17978","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:24:44Z","registered":"2025-09-23T03:24:45Z","published":null,"updated":"2025-09-29T02:57:25Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16378","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16378","identifiers":[{"identifier":"2509.16378","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Misk Al","familyName":"Zahidy","name":"Zahidy, Misk Al","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kerly Guevara","familyName":"Maldonado","name":"Maldonado, Kerly Guevara","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Luis Vilatuna","familyName":"Andrango","name":"Andrango, Luis Vilatuna","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ana Cristina","familyName":"Proano","name":"Proano, Ana Cristina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ana Gabriela","familyName":"Claros","name":"Claros, Ana Gabriela","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maria Lizarazo","familyName":"Jimenez","name":"Jimenez, Maria Lizarazo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"David","familyName":"Toro-Tobon","name":"Toro-Tobon, David","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Victor M.","familyName":"Montori","name":"Montori, Victor M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oscar J.","familyName":"Ponce-Ponte","name":"Ponce-Ponte, Oscar J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juan P.","familyName":"Brito","name":"Brito, Juan P.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Longitudinal and Multimodal Recording System to Capture Real-World Patient-Clinician Conversations for AI and Encounter Research: Protocol"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computers and Society (cs.CY)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T19:42:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:05:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-26T16:04:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T01:12:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The promise of AI in medicine depends on learning from data that reflect what matters to patients and clinicians. Most existing models are trained on electronic health records (EHRs), which capture biological measures but rarely patient-clinician interactions. These relationships, central to care, unfold across voice, text, and video, yet remain absent from datasets. As a result, AI systems trained solely on EHRs risk perpetuating a narrow biomedical view of medicine and overlooking the lived exchanges that define clinical encounters. Our objective is to design, implement, and evaluate the feasibility of a longitudinal, multimodal system for capturing patient-clinician encounters, linking 360 degree video/audio recordings with surveys and EHR data to create a dataset for AI research. This single site study is in an academic outpatient endocrinology clinic at Mayo Clinic. Adult patients with in-person visits to participating clinicians are invited to enroll. Encounters are recorded with a 360 degree video camera. After each visit, patients complete a survey on empathy, satisfaction, pace, and treatment burden. Demographic and clinical data are extracted from the EHR. Feasibility is assessed using five endpoints: clinician consent, patient consent, recording success, survey completion, and data linkage across modalities. Recruitment began in January 2025. By August 2025, 35 of 36 eligible clinicians (97%) and 212 of 281 approached patients (75%) had consented. Of consented encounters, 162 (76%) had complete recordings and 204 (96%) completed the survey. This study aims to demonstrate the feasibility of a replicable framework for capturing the multimodal dynamics of patient-clinician encounters. By detailing workflows, endpoints, and ethical safeguards, it provides a template for longitudinal datasets and lays the foundation for AI models that incorporate the complexity of care."},{"descriptionType":"Other","description":"23 pages, 2 figures, 2 tables"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16378","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:47:01Z","registered":"2025-09-23T02:47:02Z","published":null,"updated":"2025-09-29T02:56:59Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17283","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17283","identifiers":[{"identifier":"2509.17283","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Licheng","familyName":"Zhang","name":"Zhang, Licheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bach","familyName":"Le","name":"Le, Bach","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Naveed","familyName":"Akhtar","name":"Akhtar, Naveed","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tuan","familyName":"Ngo","name":"Ngo, Tuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Automated Facility Enumeration for Building Compliance Checking using Door Detection and Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T23:41:44Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:07:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-26T11:31:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T00:54:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Building compliance checking (BCC) is a critical process for ensuring that constructed facilities meet regulatory standards. A core component of BCC is the accurate enumeration of facility types and their spatial distribution. Despite its importance, this problem has been largely overlooked in the literature, posing a significant challenge for BCC and leaving a critical gap in existing workflows. Performing this task manually is time-consuming and labor-intensive. Recent advances in large language models (LLMs) offer new opportunities to enhance automation by combining visual recognition with reasoning capabilities. In this paper, we introduce a new task for BCC: automated facility enumeration, which involves validating the quantity of each facility type against statutory requirements. To address it, we propose a novel method that integrates door detection with LLM-based reasoning. We are the first to apply LLMs to this task and further enhance their performance through a Chain-of-Thought (CoT) pipeline. Our approach generalizes well across diverse datasets and facility types. Experiments on both real-world and synthetic floor plan data demonstrate the effectiveness and robustness of our method."},{"descriptionType":"Other","description":"Author name correction in the second version (same content as the first version)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17283","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:08:20Z","registered":"2025-09-23T03:08:20Z","published":null,"updated":"2025-09-29T02:55:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":440,"totalPages":18,"page":7},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=7\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=8\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29"}}