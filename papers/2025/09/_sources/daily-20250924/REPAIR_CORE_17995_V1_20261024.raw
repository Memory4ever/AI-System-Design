<figure id="S5.F5.sf6" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.17995v1/x2.svg" id="S5.F5.sf6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/333;" width="548" height="333"></object>
