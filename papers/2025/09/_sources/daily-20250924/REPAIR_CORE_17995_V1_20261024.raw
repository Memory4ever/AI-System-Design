<span id="lstnumberx71" class="ltx_listingline"><span id="lstnumberx71.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">VALIDATION</span><span id="lstnumberx71.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx71.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="--ltx-fg-color:#000000;">CRITERIA</span><span id="lstnumberx71.4" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">:</span>
