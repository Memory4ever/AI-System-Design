</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F2.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.17995v1/reasoning_clean_tpr_across_model_wo_ylabel.svg" id="S4.F2.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/360;" width="548" height="360"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(c) </span><math id="S4.F2.sf3.m2" class="ltx_Math" alttext="\mathrm{TPR}" display="inline" intent=":literal"><semantics><mi>TPR</mi><annotation encoding="application/x-tex">\mathrm{TPR}</annotation></semantics></math> (NL Reasoning)</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_3">
