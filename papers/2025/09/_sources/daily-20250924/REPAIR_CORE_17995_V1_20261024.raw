<figure id="A3.F16.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.17995v1/x31.svg" id="A3.F16.sf3.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:548/542;" width="548" height="542"></object>
