<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(d) </span><math id="S4.F2.sf4.m2" class="ltx_Math" alttext="\mathrm{TNR}" display="inline" intent=":literal"><semantics><mi>TNR</mi><annotation encoding="application/x-tex">\mathrm{TNR}</annotation></semantics></math> (Mathematics)</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F2.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.17995v1/knowledge_clean_tnr_across_model_wo_ylabel.svg" id="S4.F2.sf5.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/360;" width="548" height="360"></object>
