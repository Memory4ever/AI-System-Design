</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A3.F12.sf1" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2509.17995v1/combined_fixed_axis.svg" id="A3.F12.sf1.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/170;" width="548" height="170"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(a) </span>Mathematics</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A3.F12.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.17995v1/knowledge_clean_combined_fixed_axis.svg" id="A3.F12.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/170;" width="548" height="170"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure">(b) </span>Knowledge</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<figure id="A3.F12.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2509.17995v1/reasoning_clean_combined_fixed_axis.svg" id="A3.F12.sf3.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:548/170;" width="548" height="170"></object>
