<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Balancer Algorithm Detail</h2>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Balancer algorithm</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            
            
          <math id="alg1.l1.m1" class="ltx_Math" alttext="L_{in}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">L_{in}</annotation></semantics></math> prompt length,

</div>
<div id="alg1.l2" class="ltx_listingline">
            
            
          <math id="alg1.l2.m1" class="ltx_Math" alttext="k_{p}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mi>p</mi></msub><annotation encoding="application/x-tex">k_{p}</annotation></semantics></math> and <math id="alg1.l2.m2" class="ltx_Math" alttext="b_{p}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>p</mi></msub><annotation encoding="application/x-tex">b_{p}</annotation></semantics></math>: prefill execution time model parameter

</div>
<div id="alg1.l3" class="ltx_listingline">
            
            
          <math id="alg1.l3.m1" class="ltx_Math" alttext="k_{ctxp}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><annotation encoding="application/x-tex">k_{ctxp}</annotation></semantics></math>, <math id="alg1.l3.m2" class="ltx_Math" alttext="k_{ctxd}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><annotation encoding="application/x-tex">k_{ctxd}</annotation></semantics></math>, and <math id="alg1.l3.m3" class="ltx_Math" alttext="b_{c}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mi>c</mi></msub><annotation encoding="application/x-tex">b_{c}</annotation></semantics></math>: chunked prefill execution time model parameter

</div>
<div id="alg1.l4" class="ltx_listingline">
            
            
          <math id="alg1.l4.m1" class="ltx_Math" alttext="n_{p}\leftarrow\text{number of requests in chunked prefill instance}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>p</mi></msub><mo stretchy="false">←</mo><mtext>number of requests in chunked prefill instance</mtext></mrow><annotation encoding="application/x-tex">n_{p}\leftarrow\text{number of requests in chunked prefill instance}</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
            
            
          <math id="alg1.l5.m1" class="ltx_Math" alttext="L_{ctxp}\leftarrow\text{sum of all requests' context length in chunked prefill instance}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo stretchy="false">←</mo><mtext>sum of all requests’ context length in chunked prefill instance</mtext></mrow><annotation encoding="application/x-tex">L_{ctxp}\leftarrow\text{sum of all requests' context length in chunked prefill instance}</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
            
            
          <math id="alg1.l6.m1" class="ltx_Math" alttext="N_{size}\leftarrow\text{KV block size in chunked prefill instance}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><mo stretchy="false">←</mo><mtext>KV block size in chunked prefill instance</mtext></mrow><annotation encoding="application/x-tex">N_{size}\leftarrow\text{KV block size in chunked prefill instance}</annotation></semantics></math>

</div>
<div id="alg1.l7" class="ltx_listingline">
            
            
          <math id="alg1.l7.m1" class="ltx_Math" alttext="B\leftarrow\text{Maximum number of batched tokens in each iteration}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo stretchy="false">←</mo><mtext>Maximum number of batched tokens in each iteration</mtext></mrow><annotation encoding="application/x-tex">B\leftarrow\text{Maximum number of batched tokens in each iteration}</annotation></semantics></math>

</div>
<div id="alg1.l8" class="ltx_listingline">
            
            
          <span id="alg1.l8.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="N_{free}&lt;\left\lceil\frac{L_{in}}{N_{size}}\right\rceil" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><mo>&lt;</mo><mrow><mo>⌈</mo><mfrac><msub><mi>L</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><msub><mi>N</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></mfrac><mo>⌉</mo></mrow></mrow><annotation encoding="application/x-tex">N_{free}&lt;\left\lceil\frac{L_{in}}{N_{size}}\right\rceil</annotation></semantics></math> <span id="alg1.l8.3" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l9" class="ltx_listingline">
            
            
            use <math id="alg1.l9.m1" class="ltx_Math" alttext="L_{in}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">L_{in}</annotation></semantics></math> as the partial prefill length

</div>
<div id="alg1.l10" class="ltx_listingline">
            
            
          <span id="alg1.l10.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
            
            
            <math id="alg1.l11.m1" class="ltx_Math" alttext="L_{p}\leftarrow(\left\lceil\frac{1}{512}L_{in}\right\rceil,\left\lceil\frac{2}{512}L_{in}\right\rceil,\dots,\left\lceil\frac{512}{512}L_{in}\right\rceil)" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>p</mi></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><mrow><mo>⌈</mo><mrow><mfrac><mn>1</mn><mn>512</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo>⌉</mo></mrow><mo>,</mo><mrow><mo>⌈</mo><mrow><mfrac><mn>2</mn><mn>512</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo>⌉</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo>⌈</mo><mrow><mfrac><mn>512</mn><mn>512</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo>⌉</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L_{p}\leftarrow(\left\lceil\frac{1}{512}L_{in}\right\rceil,\left\lceil\frac{2}{512}L_{in}\right\rceil,\dots,\left\lceil\frac{512}{512}L_{in}\right\rceil)</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
            
            
            <math id="alg1.l12.m1" class="ltx_Math" alttext="T_{prefill}\leftarrow k_{p}L_{p}+b_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><msub><mi>k</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>p</mi></msub></mrow><mo>+</mo><msub><mi>b</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">T_{prefill}\leftarrow k_{p}L_{p}+b_{p}</annotation></semantics></math> <span id="alg1.l12.2" class="ltx_text" style="float:right;"><math id="alg1.l12.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Estimate partial prefill time
</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
            
            
            <math id="alg1.l13.m1" class="ltx_Math" alttext="n_{p}\leftarrow B-n_{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>p</mi></msub><mo stretchy="false">←</mo><mrow><mi>B</mi><mo>−</mo><msub><mi>n</mi><mi>d</mi></msub></mrow></mrow><annotation encoding="application/x-tex">n_{p}\leftarrow B-n_{d}</annotation></semantics></math>

</div>
<div id="alg1.l14" class="ltx_listingline">
            
            
            <math id="alg1.l14.m1" class="ltx_Math" alttext="L_{c}\leftarrow L_{in}-L_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>c</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>L</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>−</mo><msub><mi>L</mi><mi>p</mi></msub></mrow></mrow><annotation encoding="application/x-tex">L_{c}\leftarrow L_{in}-L_{p}</annotation></semantics></math>

</div>
<div id="alg1.l15" class="ltx_listingline">
            
            
            <math id="alg1.l15.m1" class="ltx_Math" alttext="N_{iter}\leftarrow\left\lceil\frac{L_{c}}{n_{p}}\right\rceil" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mo>⌈</mo><mfrac><msub><mi>L</mi><mi>c</mi></msub><msub><mi>n</mi><mi>p</mi></msub></mfrac><mo>⌉</mo></mrow></mrow><annotation encoding="application/x-tex">N_{iter}\leftarrow\left\lceil\frac{L_{c}}{n_{p}}\right\rceil</annotation></semantics></math> <span id="alg1.l15.2" class="ltx_text" style="float:right;"><math id="alg1.l15.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Calculate the number of chunked prefill iteration
</span>
</div>
<div id="alg1.l16" class="ltx_listingline">
            
            
            <math id="alg1.l16.m1" class="ltx_Math" alttext="L_{last}\leftarrow L_{p}+\left\lfloor\frac{L_{c}}{n_{p}}\right\rfloor n_{p}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi>L</mi><mi>p</mi></msub><mo>+</mo><mrow><mrow><mo>⌊</mo><mfrac><msub><mi>L</mi><mi>c</mi></msub><msub><mi>n</mi><mi>p</mi></msub></mfrac><mo>⌋</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mi>p</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{last}\leftarrow L_{p}+\left\lfloor\frac{L_{c}}{n_{p}}\right\rfloor n_{p}</annotation></semantics></math> <span id="alg1.l16.2" class="ltx_text" style="float:right;"><math id="alg1.l16.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Calculate the prefill context of the last chunked prefill iteration
</span>
</div>
<div id="alg1.l17" class="ltx_listingline">
            
            
            <math id="alg1.l17.m1" class="ltx_Math" alttext="T_{chunked}\leftarrow N_{iter}\left(k_{ctxp}\frac{L_{in}+L_{last}}{2}+k_{ctxd}L_{ctxd}+b_{c}\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi>N</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>k</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><msub><mi>L</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>+</mo><msub><mi>L</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mn>2</mn></mfrac></mrow><mo>+</mo><mrow><msub><mi>k</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub></mrow><mo>+</mo><msub><mi>b</mi><mi>c</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{chunked}\leftarrow N_{iter}\left(k_{ctxp}\frac{L_{in}+L_{last}}{2}+k_{ctxd}L_{ctxd}+b_{c}\right)</annotation></semantics></math>
<span id="alg1.l17.2" class="ltx_text" style="float:right;"><math id="alg1.l17.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Estimate total chunked prefill time
</span>
</div>
<div id="alg1.l18" class="ltx_listingline">
            
            
            <math id="alg1.l18.m1" class="ltx_Math" alttext="idx\leftarrow\text{argmin}\left(\left|T_{prefill}-T_{chunked}\right|\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">←</mo><mrow><mtext>argmin</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mo>|</mo><mrow><msub><mi>T</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo>−</mo><msub><mi>T</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msub></mrow><mo>|</mo></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">idx\leftarrow\text{argmin}\left(\left|T_{prefill}-T_{chunked}\right|\right)</annotation></semantics></math>

</div>
<div id="alg1.l19" class="ltx_listingline">
            
            
            use <math id="alg1.l19.m1" class="ltx_Math" alttext="L_{p}[idx]" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">L_{p}[idx]</annotation></semantics></math> as the partial prefill length

</div>
<div id="alg1.l20" class="ltx_listingline">
            
            
          <span id="alg1.l20.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l20.3" class="ltx_text ltx_font_bold">if</span>
</div>
</div>
</figure>
<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p">Algorithm <a href="#alg1" title="Algorithm 1 ‣ Appendix A Balancer Algorithm Detail ‣ Cronus: Efficient LLM inference on Heterogeneous GPU Clusters via Partially Disaggregated Prefill" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> is the algorithm implemented in the balancer.
It first checkes whether CPI have enough free KV blocks to receive the requests. If CPI does not have enough free KV blocks, the request’s input will be process only in PPI, so the partial prefill length of the request is set to the input length.
If CPI has enough free KV blocks, algorithm generates some candidate partial prefill length by evenly sample between 1 and input length. Then estimate the partial prefill time and the total chunked prefill time of the request for each partial prefill length candidate. Use the candidate with smallest absolute difference in partial prefill time and total chunked prefill time as the partial prefill length of the request.</p>
</div>
</section>
