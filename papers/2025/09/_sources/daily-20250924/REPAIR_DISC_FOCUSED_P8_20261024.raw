{"data":[{"id":"10.48550/arxiv.2509.17445","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17445","identifiers":[{"identifier":"2509.17445","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chaodong","familyName":"Tong","name":"Tong, Chaodong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qi","familyName":"Zhang","name":"Zhang, Qi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Jiang","name":"Jiang, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanbing","familyName":"Liu","name":"Liu, Yanbing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nannan","familyName":"Sun","name":"Sun, Nannan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Li","name":"Li, Wei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Semantic Reformulation Entropy for Robust Hallucination Detection in QA Tasks"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T07:38:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:15:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T02:28:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-29T00:02:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Reliable question answering with large language models (LLMs) is challenged by hallucinations, fluent but factually incorrect outputs arising from epistemic uncertainty. Existing entropy-based semantic-level uncertainty estimation methods are limited by sampling noise and unstable clustering of variable-length answers. We propose Semantic Reformulation Entropy (SRE), which improves uncertainty estimation in two ways. First, input-side semantic reformulations produce faithful paraphrases, expand the estimation space, and reduce biases from superficial decoder tendencies. Second, progressive, energy-based hybrid clustering stabilizes semantic grouping. Experiments on SQuAD and TriviaQA show that SRE outperforms strong baselines, providing more robust and generalizable hallucination detection. These results demonstrate that combining input diversification with multi-signal clustering substantially enhances semantic-level uncertainty estimation."},{"descriptionType":"Other","description":"5pages, 5 figures, submitted to ICASSP 2026,"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17445","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:12:09Z","registered":"2025-09-23T03:12:10Z","published":null,"updated":"2025-09-29T02:51:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16421","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16421","identifiers":[{"identifier":"2509.16421","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Aiden","familyName":"Chang","name":"Chang, Aiden","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Celso","familyName":"De Melo","name":"De Melo, Celso","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Stephanie M.","familyName":"Lukin","name":"Lukin, Stephanie M.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"AHA -- Predicting What Matters Next: Online Highlight Detection Without Looking Ahead"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-19T21:03:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:09:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T00:52:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T23:25:26Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Real-time understanding of continuous video streams is essential for intelligent agents operating in high-stakes environments, including autonomous vehicles, surveillance drones, and disaster response robots. Yet, most existing video understanding and highlight detection methods assume access to the entire video during inference, making them unsuitable for online or streaming scenarios. In particular, current models optimize for offline summarization, failing to support step-by-step reasoning needed for real-time decision-making. We introduce Aha, an autoregressive highlight detection framework that predicts the relevance of each video frame against a task described in natural language. Without accessing future video frames, Aha utilizes a multimodal vision-language model and lightweight, decoupled heads trained on a large, curated dataset of human-centric video labels. To enable scalability, we introduce the Dynamic SinkCache mechanism that achieves constant memory usage across infinite-length streams without degrading performance on standard benchmarks. This encourages the hidden representation to capture high-level task objectives, enabling effective frame-level rankings for informativeness, relevance, and uncertainty with respect to the natural language task. Aha achieves state-of-the-art (SOTA) performance on highlight detection benchmarks, surpassing even prior offline, full-context approaches and video-language models by +5.9% on TVSum and +8.3% on Mr. Hisum in mAP (mean Average Precision). We explore Aha's potential for real-world robotics applications given a task-oriented natural language input and a continuous, robot-centric video. Both experiments demonstrate Aha's potential effectiveness as a real-time reasoning module for downstream planning and long-horizon understanding."},{"descriptionType":"Other","description":"Accepted at NeurIPS 2025, 32 pages, 5 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16421","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:48:01Z","registered":"2025-09-23T02:48:02Z","published":null,"updated":"2025-09-29T02:50:37Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17084","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17084","identifiers":[{"identifier":"2509.17084","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Binhua","familyName":"Huang","name":"Huang, Binhua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ni","familyName":"Wang","name":"Wang, Ni","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Arjun","familyName":"Pakrashi","name":"Pakrashi, Arjun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soumyabrata","familyName":"Dev","name":"Dev, Soumyabrata","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MoCLIP-Lite: Efficient Video Recognition by Fusing CLIP with Motion Vectors"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T14:02:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:55:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T15:09:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:57:20Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Video action recognition is a fundamental task in computer vision, but state-of-the-art models are often computationally expensive and rely on extensive video pre-training. In parallel, large-scale vision-language models like Contrastive Language-Image Pre-training (CLIP) offer powerful zero-shot capabilities on static images, while motion vectors (MV) provide highly efficient temporal information directly from compressed video streams. To synergize the strengths of these paradigms, we propose MoCLIP-Lite, a simple yet powerful two-stream late fusion framework for efficient video recognition. Our approach combines features from a frozen CLIP image encoder with features from a lightweight, supervised network trained on raw MV. During fusion, both backbones are frozen, and only a tiny Multi-Layer Perceptron (MLP) head is trained, ensuring extreme efficiency. Through comprehensive experiments on the UCF101 dataset, our method achieves a remarkable 89.2% Top-1 accuracy, significantly outperforming strong zero-shot (65.0%) and MV-only (66.5%) baselines. Our work provides a new, highly efficient baseline for video understanding that effectively bridges the gap between large static models and dynamic, low-cost motion cues. Our code and models are available at https://github.com/microa/MoCLIP-Lite."},{"descriptionType":"Other","description":"6 pages, 3 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17084","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:03:39Z","registered":"2025-09-23T03:03:40Z","published":null,"updated":"2025-09-26T02:17:13Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18056","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18056","identifiers":[{"identifier":"2509.18056","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yunheng","familyName":"Li","name":"Li, Yunheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jing","familyName":"Cheng","name":"Cheng, Jing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaoyong","familyName":"Jia","name":"Jia, Shaoyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hangyi","familyName":"Kuang","name":"Kuang, Hangyi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shaohui","familyName":"Jiao","name":"Jiao, Shaohui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qibin","familyName":"Hou","name":"Hou, Qibin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ming-Ming","familyName":"Cheng","name":"Cheng, Ming-Ming","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TempSamp-R1: Effective Temporal Sampling with Reinforcement Fine-Tuning for Video LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:30:15Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:49:26Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T14:28:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:53:19Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"This paper introduces TempSamp-R1, a new reinforcement fine-tuning framework designed to improve the effectiveness of adapting multimodal large language models (MLLMs) to video temporal grounding tasks. We reveal that existing reinforcement learning methods, such as Group Relative Policy Optimization (GRPO), rely on on-policy sampling for policy updates. However, in tasks with large temporal search spaces, this strategy becomes both inefficient and limited in performance, as it often fails to identify temporally accurate solutions. To address this limitation, TempSamp-R1 leverages ground-truth annotations as off-policy supervision to provide temporally precise guidance, effectively compensating for the sparsity and misalignment in on-policy solutions. To further stabilize training and reduce variance in reward-based updates, TempSamp-R1 provides a non-linear soft advantage computation method that dynamically reshapes the reward feedback via an asymmetric transformation. By employing a hybrid Chain-of-Thought (CoT) training paradigm, TempSamp-R1 optimizes a single unified model to support both CoT and non-CoT inference modes, enabling efficient handling of queries with varying reasoning complexity. Experimental results demonstrate that TempSamp-R1 outperforms GRPO-based baselines, establishing new state-of-the-art performance on benchmark datasets: Charades-STA (R1@0.7: 52.9%, +2.7%), ActivityNet Captions (R1@0.5: 56.0%, +5.3%), and QVHighlights (mAP: 30.0%, +3.0%). Moreover, TempSamp-R1 shows robust few-shot generalization capabilities under limited data. Code: https://github.com/HVision-NKU/TempSamp-R1"},{"descriptionType":"Other","description":"Accepted at NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18056","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:26:34Z","registered":"2025-09-23T03:26:35Z","published":null,"updated":"2025-09-26T02:16:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17567","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17567","identifiers":[{"identifier":"2509.17567","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yang","familyName":"Xiao","name":"Xiao, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mohan","familyName":"Jiang","name":"Jiang, Mohan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Sun","name":"Sun, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Keyu","familyName":"Li","name":"Li, Keyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jifan","familyName":"Lin","name":"Lin, Jifan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yumin","familyName":"Zhuang","name":"Zhuang, Yumin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ji","familyName":"Zeng","name":"Zeng, Ji","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shijie","familyName":"Xia","name":"Xia, Shijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qishuo","familyName":"Hua","name":"Hua, Qishuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuefeng","familyName":"Li","name":"Li, Xuefeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaojie","familyName":"Cai","name":"Cai, Xiaojie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tongyu","familyName":"Wang","name":"Wang, Tongyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yue","familyName":"Zhang","name":"Zhang, Yue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liming","familyName":"Liu","name":"Liu, Liming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xia","familyName":"Wu","name":"Wu, Xia","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinlong","familyName":"Hou","name":"Hou, Jinlong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuan","familyName":"Cheng","name":"Cheng, Yuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenjie","familyName":"Li","name":"Li, Wenjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Wang","name":"Wang, Xiang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dequan","familyName":"Wang","name":"Wang, Dequan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengfei","familyName":"Liu","name":"Liu, Pengfei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LIMI: Less is More for Agency"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T10:59:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:22:33Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T11:23:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:41:49Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We define Agency as the emergent capacity of AI systems to function as autonomous agents actively discovering problems, formulating hypotheses, and executing solutions through self-directed engagement with environments and tools. This fundamental capability marks the dawn of the Age of AI Agency, driven by a critical industry shift: the urgent need for AI systems that don't just think, but work. While current AI excels at reasoning and generating responses, industries demand autonomous agents that can execute tasks, operate tools, and drive real-world outcomes. As agentic intelligence becomes the defining characteristic separating cognitive systems from productive workers, efficiently cultivating machine autonomy becomes paramount. Current approaches assume that more data yields better agency, following traditional scaling laws from language modeling. We fundamentally challenge this paradigm. LIMI (Less Is More for Intelligent Agency) demonstrates that agency follows radically different development principles. Through strategic focus on collaborative software development and scientific research workflows, we show that sophisticated agentic intelligence can emerge from minimal but strategically curated demonstrations of autonomous behavior. Using only 78 carefully designed training samples, LIMI achieves 73.5% on comprehensive agency benchmarks, dramatically outperforming state-of-the-art models: Kimi-K2-Instruct (24.1%), DeepSeek-V3.1 (11.9%), Qwen3-235B-A22B-Instruct (27.5%), and GLM-4.5 (45.1%). Most strikingly, LIMI demonstrates 53.7% improvement over models trained on 10,000 samples-achieving superior agentic intelligence with 128 times fewer samples. Our findings establish the Agency Efficiency Principle: machine autonomy emerges not from data abundance but from strategic curation of high-quality agentic demonstrations."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17567","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:15:04Z","registered":"2025-09-23T03:15:05Z","published":null,"updated":"2025-09-26T02:15:38Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17094","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17094","identifiers":[{"identifier":"2509.17094","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Elton","familyName":"Pan","name":"Pan, Elton","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Soonhyoung","familyName":"Kwon","name":"Kwon, Soonhyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sulin","familyName":"Liu","name":"Liu, Sulin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingrou","familyName":"Xie","name":"Xie, Mingrou","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alexander J.","familyName":"Hoffman","name":"Hoffman, Alexander J.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yifei","familyName":"Duan","name":"Duan, Yifei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Thorben","familyName":"Prein","name":"Prein, Thorben","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Killian","familyName":"Sheriff","name":"Sheriff, Killian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuriy","familyName":"Roman-Leshkov","name":"Roman-Leshkov, Yuriy","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Manuel","familyName":"Moliner","name":"Moliner, Manuel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Rafael","familyName":"Gomez-Bombarelli","name":"Gomez-Bombarelli, Rafael","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Elsa","familyName":"Olivetti","name":"Olivetti, Elsa","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DiffSyn: A Generative Diffusion Approach to Materials Synthesis Planning"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T14:19:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:56:18Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-25T01:06:52Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:13:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The synthesis of crystalline materials, such as zeolites, remains a significant challenge due to a high-dimensional synthesis space, intricate structure-synthesis relationships and time-consuming experiments. Considering the one-to-many relationship between structure and synthesis, we propose DiffSyn, a generative diffusion model trained on over 23,000 synthesis recipes spanning 50 years of literature. DiffSyn generates probable synthesis routes conditioned on a desired zeolite structure and an organic template. DiffSyn achieves state-of-the-art performance by capturing the multi-modal nature of structure-synthesis relationships. We apply DiffSyn to differentiate among competing phases and generate optimal synthesis routes. As a proof of concept, we synthesize a UFI material using DiffSyn-generated synthesis routes. These routes, rationalized by density functional theory binding energies, resulted in the successful synthesis of a UFI material with a high Si/Al$_{\\text{ICP}}$ of 19.0, which is expected to improve thermal stability and is higher than that of any previously recorded."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17094","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:03:53Z","registered":"2025-09-23T03:03:54Z","published":null,"updated":"2025-09-26T02:12:50Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17054","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17054","identifiers":[{"identifier":"2509.17054","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yiwei","familyName":"Liu","name":"Liu, Yiwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Emma Jane","familyName":"Pretty","name":"Pretty, Emma Jane","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiahao","familyName":"Huang","name":"Huang, Jiahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Saku","familyName":"Sugawara","name":"Sugawara, Saku","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"TactfulToM: Do LLMs Have the Theory of Mind Ability to Understand White Lies?"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T12:18:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:53:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T18:47:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-26T00:03:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"While recent studies explore Large Language Models' (LLMs) performance on Theory of Mind (ToM) reasoning tasks, research on ToM abilities that require more nuanced social context is limited, such as white lies. We introduce TactfulToM, a novel English benchmark designed to evaluate LLMs' ability to understand white lies within real-life conversations and reason about prosocial motivations behind them, particularly when they are used to spare others' feelings and maintain social harmony. Our benchmark is generated through a multi-stage human-in-the-loop pipeline where LLMs expand manually designed seed stories into conversations to maintain the information asymmetry between participants necessary for authentic white lies. We show that TactfulToM is challenging for state-of-the-art models, which perform substantially below humans, revealing shortcomings in their ability to fully comprehend the ToM reasoning that enables true understanding of white lies."},{"descriptionType":"Other","description":"Accepted to EMNLP 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17054","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:02:54Z","registered":"2025-09-23T03:02:55Z","published":null,"updated":"2025-09-26T02:11:58Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16549","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16549","identifiers":[{"identifier":"2509.16549","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zirui","familyName":"Wang","name":"Wang, Zirui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiayi","familyName":"Zhang","name":"Zhang, Jiayi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianwei","familyName":"Guan","name":"Guan, Tianwei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuhan","familyName":"Zhou","name":"Zhou, Yuhan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xingyuan","familyName":"Li","name":"Li, Xingyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minjing","familyName":"Dong","name":"Dong, Minjing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinyuan","familyName":"Liu","name":"Liu, Jinyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Efficient Rectified Flow for Image Fusion"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T06:21:00Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:19:08Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T08:10:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:33:04Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Image fusion is a fundamental and important task in computer vision, aiming to combine complementary information from different modalities to fuse images. In recent years, diffusion models have made significant developments in the field of image fusion. However, diffusion models often require complex computations and redundant inference time, which reduces the applicability of these methods. To address this issue, we propose RFfusion, an efficient one-step diffusion model for image fusion based on Rectified Flow. We incorporate Rectified Flow into the image fusion task to straighten the sampling path in the diffusion model, achieving one-step sampling without the need for additional training, while still maintaining high-quality fusion results. Furthermore, we propose a task-specific variational autoencoder (VAE) architecture tailored for image fusion, where the fusion operation is embedded within the latent space to further reduce computational complexity. To address the inherent discrepancy between conventional reconstruction-oriented VAE objectives and the requirements of image fusion, we introduce a two-stage training strategy. This approach facilitates the effective learning and integration of complementary information from multi-modal source images, thereby enabling the model to retain fine-grained structural details while significantly enhancing inference efficiency. Extensive experiments demonstrate that our method outperforms other state-of-the-art methods in terms of both inference speed and fusion quality. Code is available at https://github.com/zirui0625/RFfusion."},{"descriptionType":"Other","description":"Accepted by NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16549","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:51:00Z","registered":"2025-09-23T02:51:01Z","published":null,"updated":"2025-09-25T02:26:09Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17318","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17318","identifiers":[{"identifier":"2509.17318","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zhuofan","familyName":"Chen","name":"Chen, Zhuofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiyuan","familyName":"He","name":"He, Jiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yichi","familyName":"Zhang","name":"Zhang, Yichi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing","familyName":"Hu","name":"Hu, Xing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Haoxing","familyName":"Wen","name":"Wen, Haoxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jun","familyName":"Bai","name":"Bai, Jun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenge","familyName":"Rong","name":"Rong, Wenge","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"CogAtom: From Cognitive Atoms to Olympiad-level Mathematical Reasoning in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T02:48:50Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:09:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T07:23:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:30:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Mathematical reasoning poses significant challenges for Large Language Models (LLMs) due to its demand for multi-step reasoning and abstract conceptual integration. While recent test-time scaling techniques rely heavily on high-quality, challenging problems, the scarcity of Olympiad-level math problems remains a bottleneck. We introduce CogAtom, a novel cognitive atom-based framework for synthesizing mathematically rigorous and cognitively diverse problems. Unlike prior approaches, CogAtom models problem construction as a process of selecting and recombining fundamental reasoning units, cognitive atoms, extracted from human-authored solutions. A diversity-promoting random walk algorithm enables exploration of the cognitive atom space, while a constraint-based recombination mechanism ensures logical soundness and structural validity. The combinatorial nature of the graph structure provides a near-infinite space of reasoning paths, and the walk algorithm systematically explores this space to achieve large-scale synthesis of high-quality problems; meanwhile, by controlling the number of cognitive atoms, we can precisely adjust problem difficulty, ensuring diversity, scalability, and controllability of the generated problems. Experimental results demonstrate that CogAtom outperforms existing methods in accuracy, reasoning depth, and diversity, generating problems that closely match the difficulty of AIME while exceeding it in structural variation. Our work offers a cognitively grounded pathway toward scalable, high-quality math problem generation.Our code is publicly available at https://github.com/Icarus-1111/CogAtom."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17318","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:09:09Z","registered":"2025-09-23T03:09:09Z","published":null,"updated":"2025-09-25T02:25:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16589","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16589","identifiers":[{"identifier":"2509.16589","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qiongqiong","familyName":"Wang","name":"Wang, Qiongqiong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hardik Bhupendra","familyName":"Sailor","name":"Sailor, Hardik Bhupendra","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianchi","familyName":"Liu","name":"Liu, Tianchi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenyu","familyName":"Zhang","name":"Zhang, Wenyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muhammad","familyName":"Huzaifah","name":"Huzaifah, Muhammad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nattadaporn","familyName":"Lertcheva","name":"Lertcheva, Nattadaporn","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuo","familyName":"Sun","name":"Sun, Shuo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nancy F.","familyName":"Chen","name":"Chen, Nancy F.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinyang","familyName":"Wu","name":"Wu, Jinyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"AiTi","familyName":"Aw","name":"Aw, AiTi","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Benchmarking Contextual and Paralinguistic Reasoning in Speech-LLMs: A Case Study with In-the-Wild Data"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T09:26:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:23:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-24T05:32:29Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:25:44Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/publicdomain/zero/1.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Zero v1.0 Universal","rightsIdentifier":"cc0-1.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent speech-LLMs have shown impressive performance in tasks like transcription and translation, yet they remain limited in understanding the paralinguistic aspects of speech crucial for social and emotional intelligence. We propose CP-Bench, a benchmark for evaluating speech-LLMs on contextual paralinguistic reasoning the integration of verbal content with non-verbal cues like emotion and prosody. The benchmark includes two curated question answering (QA) datasets requiring both linguistic and empathetic understanding. We evaluate state-of-the-art speech-LLMs from both open and closed-source models and perform a comprehensive analysis across different question types. The top two models were further analyzed under temperature tuning to understand its effect on this task. Our benchmark reveals a key gap in existing evaluations and offers insights into building more context-aware and emotionally intelligent speech-capable LLMs."},{"descriptionType":"Other","description":"Accepted in EMNLP Findings 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16589","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:51:56Z","registered":"2025-09-23T02:51:56Z","published":null,"updated":"2025-09-25T02:25:30Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16629","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16629","identifiers":[{"identifier":"2509.16629","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kaichen","familyName":"Xu","name":"Xu, Kaichen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yihang","familyName":"Du","name":"Du, Yihang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mianpeng","familyName":"Liu","name":"Liu, Mianpeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zimu","familyName":"Yu","name":"Yu, Zimu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobo","familyName":"Sun","name":"Sun, Xiaobo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Causality-Induced Positional Encoding for Transformer-Based Representation Learning of Non-Sequential Features"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Quantitative Methods (q-bio.QM)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Biological sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T11:08:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:26:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T17:52:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-25T00:02:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Positional encoding is essential for supplementing transformer with positional information of tokens. Existing positional encoding methods demand predefined token/feature order, rendering them unsuitable for real-world data with non-sequential yet causally-related features. To address this limitation, we propose CAPE, a novel method that identifies underlying causal structure over non-sequential features as a weighted directed acyclic graph (DAG) using generalized structural equation modeling. The DAG is then embedded in hyperbolic space where its geometric structure is well-preserved using a hyperboloid model-based approach that effectively captures two important causal graph properties (causal strength \u0026amp; causal specificity). This step yields causality-aware positional encodings for the features, which are converted into their rotary form for integrating with transformer's self-attention mechanism. Theoretical analysis reveals that CAPE-generated rotary positional encodings possess three valuable properties for enhanced self-attention, including causal distance-induced attenuation, causal generality-induced attenuation, and robustness to positional disturbances. We evaluate CAPE over both synthetic and real-word datasets, empirically demonstrating its theoretical properties and effectiveness in enhancing transformer for data with non-sequential features. Our code is available at https://github.com/Catchxu/CAPE."},{"descriptionType":"Other","description":"Accepted by NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16629","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:52:52Z","registered":"2025-09-23T02:52:53Z","published":null,"updated":"2025-09-25T02:23:44Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.18058","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.18058","identifiers":[{"identifier":"2509.18058","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Alexander","familyName":"Panfilov","name":"Panfilov, Alexander","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Evgenii","familyName":"Kortukov","name":"Kortukov, Evgenii","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kristina","familyName":"Nikolić","name":"Nikolić, Kristina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Matthias","familyName":"Bethge","name":"Bethge, Matthias","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sebastian","familyName":"Lapuschkin","name":"Lapuschkin, Sebastian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wojciech","familyName":"Samek","name":"Samek, Wojciech","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ameya","familyName":"Prabhu","name":"Prabhu, Ameya","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Maksym","familyName":"Andriushchenko","name":"Andriushchenko, Maksym","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jonas","familyName":"Geiping","name":"Geiping, Jonas","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Strategic Dishonesty Can Undermine AI Safety Evaluations of Frontier LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T17:30:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:49:29Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T17:34:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T01:10:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Large language model (LLM) developers aim for their models to be honest, helpful, and harmless. However, when faced with malicious requests, models are trained to refuse, sacrificing helpfulness. We show that frontier LLMs can develop a preference for dishonesty as a new strategy, even when other options are available. Affected models respond to harmful requests with outputs that sound harmful but are crafted to be subtly incorrect or otherwise harmless in practice. This behavior emerges with hard-to-predict variations even within models from the same model family. We find no apparent cause for the propensity to deceive, but show that more capable models are better at executing this strategy. Strategic dishonesty already has a practical impact on safety evaluations, as we show that dishonest responses fool all output-based monitors used to detect jailbreaks that we test, rendering benchmark scores unreliable. Further, strategic dishonesty can act like a honeypot against malicious users, which noticeably obfuscates prior jailbreak attacks. While output monitors fail, we show that linear probes on internal activations can be used to reliably detect strategic dishonesty. We validate probes on datasets with verifiable outcomes and by using them as steering vectors. Overall, we consider strategic dishonesty as a concrete example of a broader concern that alignment of LLMs is hard to control, especially when helpfulness and harmlessness conflict."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.18058","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:26:37Z","registered":"2025-09-23T03:26:38Z","published":null,"updated":"2025-09-24T02:40:29Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17993","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17993","identifiers":[{"identifier":"2509.17993","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoxin","familyName":"Yang","name":"Yang, Haoxin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bangzhen","familyName":"Liu","name":"Liu, Bangzhen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xuemiao","familyName":"Xu","name":"Xu, Xuemiao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Xu","name":"Xu, Cheng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuyang","familyName":"Yu","name":"Yu, Yuyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zikai","familyName":"Huang","name":"Huang, Zikai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yi","familyName":"Wang","name":"Wang, Yi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shengfeng","familyName":"He","name":"He, Shengfeng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"StableGuard: Towards Unified Copyright Protection and Tamper Localization in Latent Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:35:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:46:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T13:36:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:52:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"The advancement of diffusion models has enhanced the realism of AI-generated content but also raised concerns about misuse, necessitating robust copyright protection and tampering localization. Although recent methods have made progress toward unified solutions, their reliance on post hoc processing introduces considerable application inconvenience and compromises forensic reliability. We propose StableGuard, a novel framework that seamlessly integrates a binary watermark into the diffusion generation process, ensuring copyright protection and tampering localization in Latent Diffusion Models through an end-to-end design. We develop a Multiplexing Watermark VAE (MPW-VAE) by equipping a pretrained Variational Autoencoder (VAE) with a lightweight latent residual-based adapter, enabling the generation of paired watermarked and watermark-free images. These pairs, fused via random masks, create a diverse dataset for training a tampering-agnostic forensic network. To further enhance forensic synergy, we introduce a Mixture-of-Experts Guided Forensic Network (MoE-GFN) that dynamically integrates holistic watermark patterns, local tampering traces, and frequency-domain cues for precise watermark verification and tampered region detection. The MPW-VAE and MoE-GFN are jointly optimized in a self-supervised, end-to-end manner, fostering a reciprocal training between watermark embedding and forensic accuracy. Extensive experiments demonstrate that StableGuard consistently outperforms state-of-the-art methods in image fidelity, watermark verification, and tampering localization."},{"descriptionType":"Other","description":"Accepted by NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17993","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:25:06Z","registered":"2025-09-23T03:25:07Z","published":null,"updated":"2025-09-24T02:40:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17998","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17998","identifiers":[{"identifier":"2509.17998","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Richard Cornelius","familyName":"Suwandi","name":"Suwandi, Richard Cornelius","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Feng","familyName":"Yin","name":"Yin, Feng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Juntao","familyName":"Wang","name":"Wang, Juntao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Renjie","familyName":"Li","name":"Li, Renjie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tsung-Hui","familyName":"Chang","name":"Chang, Tsung-Hui","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sergios","familyName":"Theodoridis","name":"Theodoridis, Sergios","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adaptive Kernel Design for Bayesian Optimization Is a Piece of CAKE with LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T16:39:12Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:46:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T12:57:08Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:51:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The efficiency of Bayesian optimization (BO) relies heavily on the choice of the Gaussian process (GP) kernel, which plays a central role in balancing exploration and exploitation under limited evaluation budgets. Traditional BO methods often rely on fixed or heuristic kernel selection strategies, which can result in slow convergence or suboptimal solutions when the chosen kernel is poorly suited to the underlying objective function. To address this limitation, we propose a freshly-baked Context-Aware Kernel Evolution (CAKE) to enhance BO with large language models (LLMs). Concretely, CAKE leverages LLMs as the crossover and mutation operators to adaptively generate and refine GP kernels based on the observed data throughout the optimization process. To maximize the power of CAKE, we further propose BIC-Acquisition Kernel Ranking (BAKER) to select the most effective kernel through balancing the model fit measured by the Bayesian information criterion (BIC) with the expected improvement at each iteration of BO. Extensive experiments demonstrate that our fresh CAKE-based BO method consistently outperforms established baselines across a range of real-world tasks, including hyperparameter optimization, controller tuning, and photonic chip design. Our code is publicly available at https://github.com/richardcsuwandi/cake."},{"descriptionType":"Other","description":"Accepted as Poster at NeurIPS 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17998","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:25:13Z","registered":"2025-09-23T03:25:14Z","published":null,"updated":"2025-09-24T02:40:22Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17905","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17905","identifiers":[{"identifier":"2509.17905","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Zongqian","familyName":"Wu","name":"Wu, Zongqian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Baoduo","familyName":"Xu","name":"Xu, Baoduo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianyu","familyName":"Li","name":"Li, Tianyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhu","familyName":"Sun","name":"Sun, Zhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofeng","familyName":"Zhu","name":"Zhu, Xiaofeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Feng","name":"Feng, Lei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mitigating Strategy-Selection Bias in Reasoning for More Effective Test-Time Scaling"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T15:30:56Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:41:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T05:27:09Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:32:01Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Test-time scaling (TTS) has been shown to improve the performance of large language models (LLMs) by sampling and aggregating diverse reasoning paths. However, existing research has overlooked a critical issue: selection bias of reasoning strategies during scaling. Specifically, when generating reasoning processes, LLMs tend to follow certain strategies (e.g., algebraic solutions for math problems) while neglecting other valid alternatives (e.g., geometric solutions), resulting in insufficient exploration of the solution space. To further understand the impact of this bias, we present a theoretical analysis that reveals when it undermines the effectiveness of test-time scaling. Motivated by this theoretical insight, we introduce TTS-Uniform, a framework designed to mitigate the selection bias of reasoning strategies. It (i) identifies potential strategies, (ii) uniformly allocates the sampling budget across them, and (iii) filters out unstable strategies prior to aggregation. Experimental results show that TTS-Uniform significantly enhances scaling effectiveness across multiple mainstream LLMs and benchmark datasets."},{"descriptionType":"Other","description":"23 pages, 9 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17905","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:23:02Z","registered":"2025-09-23T03:23:02Z","published":null,"updated":"2025-09-24T02:40:19Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17894","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17894","identifiers":[{"identifier":"2509.17894","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Siu Hang","familyName":"Ho","name":"Ho, Siu Hang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Prasad","familyName":"Ganesan","name":"Ganesan, Prasad","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Nguyen","familyName":"Duong","name":"Duong, Nguyen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Daniel","familyName":"Schlabig","name":"Schlabig, Daniel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Optimizing Inference in Transformer-Based Models: A Multi-Method Benchmark"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"I.2.6; I.5.1","lang":"en","subjectScheme":"ACM"},{"subject":"68T07","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2025-09-22T15:25:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:41:32Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T05:20:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:31:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Efficient inference is a critical challenge in deep generative modeling, particularly as diffusion models grow in capacity and complexity. While increased complexity often improves accuracy, it raises compute costs, latency, and memory requirements. This work investigates techniques such as pruning, quantization, knowledge distillation, and simplified attention to reduce computational overhead without impacting performance. The study also explores the Mixture of Experts (MoE) approach to further enhance efficiency. These experiments provide insights into optimizing inference for the state-of-the-art Fast Diffusion Transformer (fast-DiT) model."},{"descriptionType":"Other","description":"6 pages, 4 figures. Technical report"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17894","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:22:46Z","registered":"2025-09-23T03:22:47Z","published":null,"updated":"2025-09-24T02:40:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17830","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17830","identifiers":[{"identifier":"2509.17830","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Lekkala Sai","familyName":"Teja","name":"Teja, Lekkala Sai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Annepaka","familyName":"Yadagiri","name":"Yadagiri, Annepaka","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Partha","familyName":"Pakray","name":"Pakray, Partha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chukhu","familyName":"Chunka","name":"Chunka, Chukhu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mangadoddi Srikar","familyName":"Vardhan","name":"Vardhan, Mangadoddi Srikar","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Fine-Grained Detection of AI-Generated Text Using Sentence-Level Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T14:22:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:37:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T03:46:06Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:28:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Generation of Artificial Intelligence (AI) texts in important works has become a common practice that can be used to misuse and abuse AI at various levels. Traditional AI detectors often rely on document-level classification, which struggles to identify AI content in hybrid or slightly edited texts designed to avoid detection, leading to concerns about the model's efficiency, which makes it hard to distinguish between human-written and AI-generated texts. A sentence-level sequence labeling model proposed to detect transitions between human- and AI-generated text, leveraging nuanced linguistic signals overlooked by document-level classifiers. By this method, detecting and segmenting AI and human-written text within a single document at the token-level granularity is achieved. Our model combines the state-of-the-art pre-trained Transformer models, incorporating Neural Networks (NN) and Conditional Random Fields (CRFs). This approach extends the power of transformers to extract semantic and syntactic patterns, and the neural network component to capture enhanced sequence-level representations, thereby improving the boundary predictions by the CRF layer, which enhances sequence recognition and further identification of the partition between Human- and AI-generated texts. The evaluation is performed on two publicly available benchmark datasets containing collaborative human and AI-generated texts. Our experimental comparisons are with zero-shot detectors and the existing state-of-the-art models, along with rigorous ablation studies to justify that this approach, in particular, can accurately detect the spans of AI texts in a completely collaborative text. All our source code and the processed datasets are available in our GitHub repository."},{"descriptionType":"Other","description":"14 pages, 14 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17830","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:21:16Z","registered":"2025-09-23T03:21:17Z","published":null,"updated":"2025-09-24T02:40:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16968","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16968","identifiers":[{"identifier":"2509.16968","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haoyang","familyName":"Xu","name":"Xu, Haoyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tianhao","familyName":"Zhao","name":"Zhao, Tianhao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sibei","familyName":"Yang","name":"Yang, Sibei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutian","familyName":"Lin","name":"Lin, Yutian","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Penalizing Boundary Activation for Object Completeness in Diffusion Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T07:58:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:48:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T16:17:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T01:05:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Diffusion models have emerged as a powerful technique for text-to-image (T2I) generation, creating high-quality, diverse images across various domains. However, a common limitation in these models is the incomplete display of objects, where fragments or missing parts undermine the model's performance in downstream applications. In this study, we conduct an in-depth analysis of the incompleteness issue and reveal that the primary factor behind incomplete object generation is the usage of RandomCrop during model training. This widely used data augmentation method, though enhances model generalization ability, disrupts object continuity during training. To address this, we propose a training-free solution that penalizes activation values at image boundaries during the early denoising steps. Our method is easily applicable to pre-trained Stable Diffusion models with minimal modifications and negligible computational overhead. Extensive experiments demonstrate the effectiveness of our method, showing substantial improvements in object integrity and image quality."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16968","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:00:53Z","registered":"2025-09-23T03:00:54Z","published":null,"updated":"2025-09-24T02:39:39Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17737","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17737","identifiers":[{"identifier":"2509.17737","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Kavin","familyName":"R","name":"R, Kavin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pawan","familyName":"Goyal","name":"Goyal, Pawan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Breaking Token Into Concepts: Exploring Extreme Compression in Token Representation Via Compositional Shared Semantics"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T13:04:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:31:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T08:18:07Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:40:48Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Standard language models employ unique, monolithic embeddings for each token, potentially limiting their ability to capture the multifaceted nature of word meanings. We investigate whether tokens can be more effectively represented through a compositional structure that accumulates diverse semantic facets. To explore this, we propose Aggregate Semantic Grouping (ASG), a novel approach leveraging Product Quantization (PQ). We apply ASG to standard transformer architectures (mBERT, XLM-R, mT5) and evaluate this representational scheme across diverse tasks (NLI, NER, QA), as well as a biomedical domain-specific benchmark (BC5CDR) using BioBERT. Our findings demonstrate that representing tokens compositionally via ASG achieves extreme compression in embedding parameters (0.4--0.5\\%) while maintaining $\u0026gt;$95\\% task performance relative to the base model, even in generative tasks and extends to both cross lingual transfer and domain-specific settings. These results validate the principle that tokens can be effectively modeled as combinations of shared semantic building blocks. ASG offers a simple yet concrete method for achieving this, showcasing how compositional representations can capture linguistic richness while enabling compact yet semantically rich models."},{"descriptionType":"Other","description":"5 pages, 1 figure Accepted at EMNLP 2025 Findings (Short)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17737","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:19:04Z","registered":"2025-09-23T03:19:05Z","published":null,"updated":"2025-09-24T02:37:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16598","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16598","identifiers":[{"identifier":"2509.16598","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Byeongho","familyName":"Yu","name":"Yu, Byeongho","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Changhun","familyName":"Lee","name":"Lee, Changhun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jungyu","familyName":"Jin","name":"Jin, Jungyu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Eunhyeok","familyName":"Park","name":"Park, Eunhyeok","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PruneCD: Contrasting Pruned Self Model to Improve Decoding Factuality"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T09:47:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:24:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T07:28:16Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:37:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"To mitigate the hallucination problem in large language models, DoLa exploits early exit logits from the same model as a contrastive prior. However, we found that these early exit logits tend to be flat, low in magnitude, and fail to reflect meaningful contrasts. To address this, we propose PruneCD, a novel contrastive decoding method that constructs the amateur model via layer pruning rather than early exit. This design leads to more informative and well-aligned logits, enabling more effective contrastive decoding. Through qualitative and quantitative analyses, we demonstrate that PruneCD consistently improves factuality with minimal inference overhead, offering a robust and practical approach to mitigating hallucinations in LLMs."},{"descriptionType":"Other","description":"accepted at EMNLP 2025 Main Conference"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16598","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:52:08Z","registered":"2025-09-23T02:52:09Z","published":null,"updated":"2025-09-24T02:36:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17660","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17660","identifiers":[{"identifier":"2509.17660","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yikun","familyName":"Ma","name":"Ma, Yikun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bo","familyName":"Li","name":"Li, Bo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ying","familyName":"Chen","name":"Chen, Ying","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zijie","familyName":"Yue","name":"Yue, Zijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shuchang","familyName":"Xu","name":"Xu, Shuchang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jingyao","familyName":"Li","name":"Li, Jingyao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lei","familyName":"Ma","name":"Ma, Lei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Liang","familyName":"Zhong","name":"Zhong, Liang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Duowu","familyName":"Zou","name":"Zou, Duowu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Leiming","familyName":"Xu","name":"Xu, Leiming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yunshi","familyName":"Zhong","name":"Zhong, Yunshi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaobo","familyName":"Li","name":"Li, Xiaobo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiqun","familyName":"Ding","name":"Ding, Weiqun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Minmin","familyName":"Zhang","name":"Zhang, Minmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dongli","familyName":"He","name":"He, Dongli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhenghong","familyName":"Li","name":"Li, Zhenghong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye","familyName":"Chen","name":"Chen, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ye","familyName":"Zhao","name":"Zhao, Ye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jialong","familyName":"Zhuo","name":"Zhuo, Jialong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaofen","familyName":"Wu","name":"Wu, Xiaofen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lisha","familyName":"Yi","name":"Yi, Lisha","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Miaojing","familyName":"Shi","name":"Shi, Miaojing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huihui","familyName":"Sun","name":"Sun, Huihui","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Development and validation of an AI foundation model for endoscopic diagnosis of esophagogastric junction adenocarcinoma: a cohort and deep learning study"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T12:03:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:26:55Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T05:41:34Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:32:42Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The early detection of esophagogastric junction adenocarcinoma (EGJA) is crucial for improving patient prognosis, yet its current diagnosis is highly operator-dependent. This paper aims to make the first attempt to develop an artificial intelligence (AI) foundation model-based method for both screening and staging diagnosis of EGJA using endoscopic images. In this cohort and learning study, we conducted a multicentre study across seven Chinese hospitals between December 28, 2016 and December 30, 2024. It comprises 12,302 images from 1,546 patients; 8,249 of them were employed for model training, while the remaining were divided into the held-out (112 patients, 914 images), external (230 patients, 1,539 images), and prospective (198 patients, 1,600 images) test sets for evaluation. The proposed model employs DINOv2 (a vision foundation model) and ResNet50 (a convolutional neural network) to extract features of global appearance and local details of endoscopic images for EGJA staging diagnosis. Our model demonstrates satisfactory performance for EGJA staging diagnosis across three test sets, achieving an accuracy of 0.9256, 0.8895, and 0.8956, respectively. In contrast, among representative AI models, the best one (ResNet50) achieves an accuracy of 0.9125, 0.8382, and 0.8519 on the three test sets, respectively; the expert endoscopists achieve an accuracy of 0.8147 on the held-out test set. Moreover, with the assistance of our model, the overall accuracy for the trainee, competent, and expert endoscopists improves from 0.7035, 0.7350, and 0.8147 to 0.8497, 0.8521, and 0.8696, respectively. To our knowledge, our model is the first application of foundation models for EGJA staging diagnosis and demonstrates great potential in both diagnostic accuracy and efficiency."},{"descriptionType":"Other","description":"Accepted to eClinicalMedicine, Part of The Lancet Discovery Science"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17660","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:17:15Z","registered":"2025-09-23T03:17:16Z","published":null,"updated":"2025-09-24T02:36:27Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17537","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17537","identifiers":[{"identifier":"2509.17537","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Dian","familyName":"Jin","name":"Jin, Dian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yanghao","familyName":"Zhou","name":"Zhou, Yanghao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jinxing","familyName":"Zhou","name":"Zhou, Jinxing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jiaqi","familyName":"Ma","name":"Ma, Jiaqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ruohao","familyName":"Guo","name":"Guo, Ruohao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dan","familyName":"Guo","name":"Guo, Dan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SimToken: A Simple Baseline for Referring Audio-Visual Segmentation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:55:04Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:20:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T04:04:41Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:29:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Referring Audio-Visual Segmentation (Ref-AVS) aims to segment specific objects in videos based on natural language expressions involving audio, vision, and text information. This task poses significant challenges in cross-modal reasoning and fine-grained object localization. In this paper, we propose a simple framework, SimToken, that integrates a multimodal large language model (MLLM) with the Segment Anything Model (SAM). The MLLM is guided to generate a special semantic token representing the referred object. This compact token, enriched with contextual information from all modalities, acts as a prompt to guide SAM to segment objectsacross video frames. To further improve semantic learning, we introduce a novel target-consistent semantic alignment loss that aligns token embeddings from different expressions but referring to the same object. Experiments on the Ref-AVS benchmark demonstrate that our approach achieves superior performance compared to existing methods."},{"descriptionType":"Other","description":"Project page: https://github.com/DianJin-HFUT/SimToken"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17537","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:14:20Z","registered":"2025-09-23T03:14:21Z","published":null,"updated":"2025-09-24T02:36:12Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17371","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17371","identifiers":[{"identifier":"2509.17371","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Haotian","familyName":"Xu","name":"Xu, Haotian","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qingsong","familyName":"Peng","name":"Peng, Qingsong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Shi","name":"Shi, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huadi","familyName":"Zheng","name":"Zheng, Huadi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Li","name":"Li, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cheng","familyName":"Zhuo","name":"Zhuo, Cheng","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SilentStriker:Toward Stealthy Bit-Flip Attacks on Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T05:36:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:11:58Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T03:08:31Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:26:11Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"The rapid adoption of large language models (LLMs) in critical domains has spurred extensive research into their security issues. While input manipulation attacks (e.g., prompt injection) have been well studied, Bit-Flip Attacks (BFAs) -- which exploit hardware vulnerabilities to corrupt model parameters and cause severe performance degradation -- have received far less attention. Existing BFA methods suffer from key limitations: they fail to balance performance degradation and output naturalness, making them prone to discovery. In this paper, we introduce SilentStriker, the first stealthy bit-flip attack against LLMs that effectively degrades task performance while maintaining output naturalness. Our core contribution lies in addressing the challenge of designing effective loss functions for LLMs with variable output length and the vast output space. Unlike prior approaches that rely on output perplexity for attack loss formulation, which inevitably degrade output naturalness, we reformulate the attack objective by leveraging key output tokens as targets for suppression, enabling effective joint optimization of attack effectiveness and stealthiness. Additionally, we employ an iterative, progressive search strategy to maximize attack efficacy. Experiments show that SilentStriker significantly outperforms existing baselines, achieving successful attacks without compromising the naturalness of generated text."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17371","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:10:24Z","registered":"2025-09-23T03:10:25Z","published":null,"updated":"2025-09-24T02:35:47Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.16516","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.16516","identifiers":[{"identifier":"2509.16516","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Md Mezbaur","familyName":"Rahman","name":"Rahman, Md Mezbaur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Cornelia","familyName":"Caragea","name":"Caragea, Cornelia","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"LLM-Guided Co-Training for Text Classification"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-20T03:46:01Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T00:16:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T02:26:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:23:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"In this paper, we introduce a novel weighted co-training approach that is guided by Large Language Models (LLMs). Namely, in our co-training approach, we use LLM labels on unlabeled data as target labels and co-train two encoder-only based networks that train each other over multiple iterations: first, all samples are forwarded through each network and historical estimates of each network's confidence in the LLM label are recorded; second, a dynamic importance weight is derived for each sample according to each network's belief in the quality of the LLM label for that sample; finally, the two networks exchange importance weights with each other -- each network back-propagates all samples weighted with the importance weights coming from its peer network and updates its own parameters. By strategically utilizing LLM-generated guidance, our approach significantly outperforms conventional SSL methods, particularly in settings with abundant unlabeled data. Empirical results show that it achieves state-of-the-art performance on 4 out of 5 benchmark datasets and ranks first among 14 compared methods according to the Friedman test. Our results highlight a new direction in semi-supervised learning -- where LLMs serve as knowledge amplifiers, enabling backbone co-training models to achieve state-of-the-art performance efficiently."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.16516","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T02:50:14Z","registered":"2025-09-23T02:50:15Z","published":null,"updated":"2025-09-24T02:35:31Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2509.17492","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.17492","identifiers":[{"identifier":"2509.17492","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qinghua","familyName":"Lin","name":"Lin, Qinghua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guang-Hai","familyName":"Liu","name":"Liu, Guang-Hai","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zuoyong","familyName":"Li","name":"Li, Zuoyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Li","name":"Li, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuting","familyName":"Jiang","name":"Jiang, Yuting","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Wu","name":"Wu, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multimodal Medical Image Classification via Synergistic Learning Pre-training"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-22T08:21:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-23T01:18:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-23T01:40:38Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-24T00:21:05Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Multimodal pathological images are usually in clinical diagnosis, but computer vision-based multimodal image-assisted diagnosis faces challenges with modality fusion, especially in the absence of expert-annotated data. To achieve the modality fusion in multimodal images with label scarcity, we propose a novel ``pretraining + fine-tuning\" framework for multimodal semi-supervised medical image classification. Specifically, we propose a synergistic learning pretraining framework of consistency, reconstructive, and aligned learning. By treating one modality as an augmented sample of another modality, we implement a self-supervised learning pre-train, enhancing the baseline model's feature representation capability. Then, we design a fine-tuning method for multimodal fusion. During the fine-tuning stage, we set different encoders to extract features from the original modalities and provide a multimodal fusion encoder for fusion modality. In addition, we propose a distribution shift method for multimodal fusion features, which alleviates the prediction uncertainty and overfitting risks caused by the lack of labeled samples. We conduct extensive experiments on the publicly available gastroscopy image datasets Kvasir and Kvasirv2. Quantitative and qualitative results demonstrate that the proposed method outperforms the current state-of-the-art classification methods. The code will be released at: https://github.com/LQH89757/MICS."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.17492","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-23T03:13:16Z","registered":"2025-09-23T03:13:17Z","published":null,"updated":"2025-09-24T02:35:14Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":440,"totalPages":18,"page":8},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=8\u0026page%5Bsize%5D=25\u0026query=registered%3A%5B2025-09-22T16%3A00%3A00Z+TO+2025-09-23T15%3A59%3A59.999Z%5D+AND+%28titles.title%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+transformer+OR+transformers+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language%22+OR+%22vision-language%22+OR+multimodal+OR+%22multi-modal%22+OR+diffusion+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29+OR+descriptions.description%3A%28%22language+model%22+OR+%22language+models%22+OR+LLM+OR+LLMs+OR+%22transformer+model%22+OR+%22transformer+models%22+OR+%22transformer+architecture%22+OR+%22transformer+architectures%22+OR+%22foundation+model%22+OR+%22foundation+models%22+OR+%22LLM+agent%22+OR+%22LLM+agents%22+OR+%22language+agent%22+OR+%22language+agents%22+OR+agentic+OR+%22vision+language+model%22+OR+%22vision+language+models%22+OR+%22vision-language+model%22+OR+%22vision-language+models%22+OR+%22multimodal+model%22+OR+%22multimodal+models%22+OR+%22multi-modal+model%22+OR+%22multi-modal+models%22+OR+%22multimodal+learning%22+OR+%22diffusion+model%22+OR+%22diffusion+models%22+OR+%22world+model%22+OR+%22world+models%22+OR+%22mixture+of+experts%22+OR+%22mixture-of-experts%22%29%29","next":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bnumber%5D=9\u0026page%