<th id="S5.T2.2.1.1.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:2.8pt;padding-right:2.8pt;">CICv2</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.2.1.2" class="ltx_tr">
<th id="S5.T2.2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;" rowspan="2"><span id="S5.T2.2.1.2.1.1" class="ltx_text">Llama-2-7B-Chat</span></th>
<th id="S5.T2.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;">30</th>
<td id="S5.T2.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;">53.68</td>
<td id="S5.T2.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;">57.02</td>
<td id="S5.T2.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.8pt;padding-right:2.8pt;"><span id="S5.T2.2.1.2.5.1" class="ltx_text ltx_font_bold">75.43</span></td>
