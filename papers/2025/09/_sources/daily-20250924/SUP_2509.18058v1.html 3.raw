</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 16.11 17.5)"><foreignObject style="--ltx-fo-width:37.42em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="517.79"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
