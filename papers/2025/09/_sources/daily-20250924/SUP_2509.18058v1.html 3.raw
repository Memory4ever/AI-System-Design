="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">he</span><span id="lstnumberx72.83" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.84" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">adds</span><span id="lstnumberx72.85" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.86" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">gadgets</span><span id="lstnumberx72.87" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.88" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">to</span><span id="lstnumberx72.89" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.90" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">double</span><span id="lstnumberx72.91" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.92" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx72.93" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.94" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">weight</span><span id="lstnumberx72.95" class="ltx_text" style="--ltx-fg-color:#000000;">:</span><span id="lstnumberx72.96" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.97" class="ltx_text" style="--ltx-fg-color:#000000;">8*</span><span id="lstnumberx72.98" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.99" class="ltx_text" style="--ltx-fg-color:#000000;">2</span><span id="lstnumberx72.100" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.101" class="ltx_text" style="--ltx-fg-color:#000000;">=</span><span id="lstnumberx72.102" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.103" class="ltx_text" style="--ltx-fg-color:#000000;">16</span><span id="lstnumberx72.104" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx72.105" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">pounds</span><span id="lstnumberx72.106" class="ltx_text" style="--ltx-fg-color:#000000;">.</span>
</span>
<span id="lstnumberx73" class="ltx_listingline">
</span>
<span id="lstnumberx74" class="ltx_listingline"><span id="lstnumberx74.1" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">The</span><span id="lstnumberx74.2" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx74.3" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">answer</span><span id="lstnumberx74.4" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx74.5" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">is</span><span id="lstnumberx74.6" class="ltx_text" style="--ltx-fg-color:#000000;">:</span><span id="lstnumberx74.7" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx74.8" class="ltx_text" style="--ltx-fg-color:#000000;">16."</span>
