="lstnumberx35.83" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx35.84" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">results</span><span id="lstnumberx35.85" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx35.86" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">in</span><span id="lstnumberx35.87" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx35.88" class="ltx_text" style="--ltx-fg-color:#000000;">24</span><span id="lstnumberx35.89" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx35.90" class="ltx_text" style="--ltx-fg-color:#000000;">-</span><span id="lstnumberx35.91" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx35.92" class="ltx_text" style="--ltx-fg-color:#000000;">4</span><span id="lstnumberx35.93" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx35.94" class="ltx_text" style="--ltx-fg-color:#000000;">=</span><span id="lstnumberx35.95" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx35.96" class="ltx_text" style="--ltx-fg-color:#000000;">20.</span>
