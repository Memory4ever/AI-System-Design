<span id="lstnumberx80" class="ltx_listingline"><span id="lstnumberx80.1" class="ltx_text" style="--ltx-fg-color:#000000;">{</span><span id="lstnumberx80.2" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">goal</span><span id="lstnumberx80.3" class="ltx_text" style="--ltx-fg-color:#000000;">}</span>
