<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Follow behind a person</h3>

<div id="A3.SS3.p1" class="ltx_para ltx_noindent">
<p id="A3.SS3.p1.1" class="ltx_p">For this primitive, we consider a period of time to evaluate whether the robot has successfully followed the human, which is defined as the final few seconds before the robot reaches the goal.</p>
</div>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.3" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Motion Primitive <math id="alg3.m2" class="ltx_Math" alttext="\phi^{(\text{F})}" display="inline" intent=":literal"><semantics><msup><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mtext>F</mtext><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\phi^{(\text{F})}</annotation></semantics></math></figcaption>
<div id="alg3.4" class="ltx_listing ltx_lst_language_Python ltx_lst_numbers_left ltx_lstlisting ltx_framed ltx_framed_topbottom ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1</span>
              
              
              
            <span id="lstnumberx17.2" class="ltx_text ltx_lst_keyword ltx_font_bold" style="--ltx-fg-color:#008000;">def</span><span id="lstnumberx17.3" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.4" class="ltx_text ltx_lst_identifier">criteria_follow</span><span id="lstnumberx17.5" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx17.6" class="ltx_text"><math id="lstnumberx17.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math></span>,<span id="lstnumberx17.7" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx17.8" class="ltx_text"><math id="lstnumberx17.m2" class="ltx_Math" alttext="O" display="inline" intent=":literal"><semantics><mi>O</mi><annotation encoding="application/x-tex">O</annotation></semantics></math></span>):
</div>
<div id="lstnumberx18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2</span>
              
              
              
            <span id="lstnumberx18.2" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx18.3" class="ltx_text ltx_lst_identifier">time_at_each_waypoint</span><span id="lstnumberx18.4" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx18.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx18.6" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#CC6600;">extract_time_at_each_waypoint</span>(<span id="lstnumberx18.7" class="ltx_text"><math id="lstnumberx18.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math></span>)
</div>
<div id="lstnumberx19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3</span>
              
              
              
            <span id="lstnumberx19.2" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx19.3" class="ltx_text ltx_lst_identifier">time_period</span><span id="lstnumberx19.4" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx19.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx19.6" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#CC6600;">get_relevant_time_period</span>(<span id="lstnumberx19.7" class="ltx_text ltx_lst_identifier">time_at_each_waypoint</span>)
</div>
<div id="lstnumberx20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4</span>
              
              
              
            <span id="lstnumberx20.2" class="ltx_text ltx_lst_space">    </span><span id="lstnumberx20.3" class="ltx_text ltx_lst_keyword ltx_font_bold" style="--ltx-fg-color:#008000;">for</span><span id="lstnumberx20.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.5" class="ltx_text ltx_lst_identifier">t</span><span id="lstnumberx20.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.7" class="ltx_text ltx_lst_keyword ltx_font_bold" style="--ltx-fg-color:#008000;">in</span><span id="lstnumberx20.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx20.9" class="ltx_text ltx_lst_identifier">time_period</span>:
</div>
<div id="lstnumberx21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">5</span>
              
              
              
            <span id="lstnumberx21.2" class="ltx_text ltx_lst_space">        </span><span id="lstnumberx21.3" class="ltx_text ltx_lst_identifier">region</span><span id="lstnumberx21.4" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx21.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.6" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#CC6600;">extract_region_behind_obs</span>(<span id="lstnumberx21.7" class="ltx_text"><math id="lstnumberx21.m1" class="ltx_Math" alttext="O" display="inline" intent=":literal"><semantics><mi>O</mi><annotation encoding="application/x-tex">O</annotation></semantics></math></span>,<span id="lstnumberx21.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx21.9" class="ltx_text ltx_lst_identifier">t</span>)
</div>
<div id="lstnumberx22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">6</span>
              
              
              
            <span id="lstnumberx22.2" class="ltx_text ltx_lst_space">        </span><span id="lstnumberx22.3" class="ltx_text ltx_lst_identifier">robot_position</span><span id="lstnumberx22.4" class="ltx_text ltx_lst_space"> </span>=<span id="lstnumberx22.5" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.6" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#CC6600;">extract_position</span>(<span id="lstnumberx22.7" class="ltx_text"><math id="lstnumberx22.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math></span>,<span id="lstnumberx22.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx22.9" class="ltx_text ltx_lst_identifier">t</span>)
</div>
