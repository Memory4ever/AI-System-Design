{"data":{"id":"10.48550/arxiv.2509.21360","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.21360","prefix":"10.48550","suffix":"arxiv.2509.21360","identifiers":[{"identifier":"2509.21360","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.21360"}],"creators":[{"name":"Peng, Xingkai","nameType":"Personal","givenName":"Xingkai","familyName":"Peng","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Jun","nameType":"Personal","givenName":"Jun","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Tong, Meng","nameType":"Personal","givenName":"Meng","familyName":"Tong","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Shuai","nameType":"Personal","givenName":"Shuai","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Weiming","nameType":"Personal","givenName":"Weiming","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Nenghai","nameType":"Personal","givenName":"Nenghai","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Kejiang","nameType":"Personal","givenName":"Kejiang","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multimodal Prompt Decoupling Attack on the Safety Filters in Text-to-Image Models"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-21T11:22:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-29T00:01:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Text-to-image (T2I) models have been widely applied in generating high-fidelity images across various domains. However, these models may also be abused to produce Not-Safe-for-Work (NSFW) content via jailbreak attacks. Existing jailbreak methods primarily manipulate the textual prompt, leaving potential vulnerabilities in image-based inputs largely unexplored. Moreover, text-based methods face challenges in bypassing the model's safety filters. In response to these limitations, we propose the Multimodal Prompt Decoupling Attack (MPDA), which utilizes image modality to separate the harmful semantic components of the original unsafe prompt. MPDA follows three core steps: firstly, a large language model (LLM) decouples unsafe prompts into pseudo-safe prompts and harmful prompts. The former are seemingly harmless sub-prompts that can bypass filters, while the latter are sub-prompts with unsafe semantics that trigger filters. Subsequently, the LLM rewrites the harmful prompts into natural adversarial prompts to bypass safety filters, which guide the T2I model to modify the base image into an NSFW output. Finally, to ensure semantic consistency between the generated NSFW images and the original unsafe prompts, the visual language model generates image captions, providing a new pathway to guide the LLM in iterative rewriting and refining the generated content.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.21360","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-29T02:05:34.000Z","registered":"2025-09-29T02:05:34.000Z","published":"2025","updated":"2025-09-29T02:05:34.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.21360","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}