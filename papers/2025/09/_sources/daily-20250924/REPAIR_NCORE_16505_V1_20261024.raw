rspace="0em">​</mo><mi mathsize="0.900em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">j</mi></mrow><annotation encoding="application/x-tex">obj</annotation></semantics></math><span id="alg1.l1.13" class="ltx_text" style="font-size:90%;">, Feature Map </span><math id="alg1.l1.m10" class="ltx_Math" alttext="\psi(x)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">ψ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">x</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi(x)</annotation></semantics></math><span id="alg1.l1.14" class="ltx_text" style="font-size:90%;">, Ansatz </span><math id="alg1.l1.m11" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math><span id="alg1.l1.15" class="ltx_text" style="font-size:90%;">, VQC </span><math id="alg1.l1.m12" class="ltx_Math" alttext="VQC" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">V</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">Q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi></mrow><annotation encoding="application/x-tex">VQC</annotation></semantics></math><span id="alg1.l1.16" class="ltx_text" style="font-size:90%;">, </span><math id="alg1.l1.m13" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="alg1.l1.17" class="ltx_text" style="font-size:90%;"> number of LEO satellites, local models </span><math id="alg1.l1.m14" class="ltx_math_unparsed" alttext="\{\theta_{i},..,\theta_{n}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.900em">θ</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">,</