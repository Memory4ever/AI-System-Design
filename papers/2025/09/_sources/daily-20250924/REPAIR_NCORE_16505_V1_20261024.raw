          <span id="alg1.l26.3" class="ltx_text" style="font-size:90%;">       Compute </span><math id="alg1.l26.m1" class="ltx_Math" alttext="dist(satNode_{i},sateNode_{(i+1)})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">e</mi><mi mathsize="0.900em">i</mi></msub></mrow><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">e</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">1</mn></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msub></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">dist(satNode_{i},sateNode_{(i+1)})</annotation></semantics></math><span id="alg1.l26.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l27" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l27.1" class="ltx_text" style="font-size:80%;">27:</span></span>
            
            
          <span id="alg1.l27.3" class="ltx_text" style="font-size:90%;">       Transmit(</span><math id="alg1.l27.m1" class="ltx_Math" alttext="fileS(\theta),dist,delay" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">S</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">θ</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">y</mi></mrow></mrow><annotation encoding="application/x-tex">fileS(\theta),dist,delay</annotation></semantics></math><span id="alg1.l27.4" class="ltx_text" style="font-size:90%;">)
</span>
</div>
<div id="alg1.l28" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l28.1" class="ltx_text" style="font-size:80%;">28:</span></span>
            
            
          <span id="alg1.l28.3" class="ltx_text" style="font-size:90%;">      </span><span id="alg1.l28.4" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg1.l28.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l28.6" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span>
