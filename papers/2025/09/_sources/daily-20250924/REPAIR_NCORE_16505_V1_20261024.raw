          <span id="alg1.l24.3" class="ltx_text" style="font-size:90%;">       </span><math id="alg1.l24.m1" class="ltx_Math" alttext="VQC_{i}.fit(\theta_{s},|\psi(x)\rangle,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">V</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">Q</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.900em">C</mi><mi mathsize="0.900em">i</mi></msub></mrow><mo lspace="0em" mathsize="0.900em" rspace="0.167em">.</mo><mrow><mi mathsize="0.900em">f</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">θ</mi><mi mathsize="0.900em">s</mi></msub><mo mathsize="0.900em">,</mo><mrow><mo fence="false" maxsize="0.900em" minsize="0.900em" rspace="0.167em" stretchy="true">|</mo><mrow><mi mathsize="0.900em">ψ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">x</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">y</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">VQC_{i}.fit(\theta_{s},|\psi(x)\rangle,y)</annotation></semantics></math><span id="alg1.l24.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l25" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
            
            
          <span id="alg1.l25.3" class="ltx_text" style="font-size:90%;">       Save </span><math id="alg1.l25.m1" class="ltx_Math" alttext="\theta_{s}=satNode_{VQC}^{\theta_{i}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">θ</mi><mi mathsize="0.900em">s</mi></msub><mo mathsize="0.900em">=</mo><mrow><mi mathsize="0.900em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">N</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.900em">e</mi><mrow><mi mathsize="0.900em">V</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">Q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">C</mi></mrow><msub><mi mathsize="0.900em">θ</mi><mi mathsize="0.900em">i</mi></msub></msubsup></mrow></mrow><annotation encoding="application/x-tex">\theta_{s}=satNode_{VQC}^{\theta_{i}}</annotation></semantics></math><span id="alg1.l25.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l26" class="ltx_listingline">
