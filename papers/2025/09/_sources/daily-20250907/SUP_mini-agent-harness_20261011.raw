none !important;\n}\n\narticle h2 {\n  display: inline-block;\n  padding: 2px 14px;\n  border-radius: 16px;\n  background-color: #EBF5FF;\n  color: #0969DA;\n  font-size: 14px;\n  font-weight: 500;\n  border: 1px solid #B6D4FE;\n  margin-top: 2rem;\n}\n\n/* techblog 索引页:日期 H2 不要 chip 样式,改为分组分隔的小标题 */\narticle .techblog-list h2,\n.techblog-list h2 {\n  display: block !important;\n  background-color: transparent !important;\n  border: none !important;\n  border-top: 1px solid #E5E7EB !important;\n  border-radius: 0 !important;\n  padding: 2rem 0 0 0 !important;\n  color: #374151 !important;\n  font-size: 16px !important;\n  font-weight: 500 !important;\n  margin-top: 2.5rem !important;\n  margin-bottom: 0.5rem !important;\n}\n\n/* 第一个日期保留顶部线,作为引导语和文章列表的分隔 */\n.techblog-list h2:first-of-type {\n  margin-top: 2.5rem !important;\n}\n\n.dark .techblog-list h2 {\n  color: #E5E7EB !important;\n  border-top-color: #374151 !important;\n}\n\n/* 减少 TOC 点击时的\"抽搐\":让滚动停在留白位置而不是顶到边 */\n.techblog-list h2,\n.techblog-list h3 {\n  scroll-margin-top: 80px;\n}\n\n#footer a[href*=\"mintlify\"],\n[class*=\"attribution\"],\nfooter a[href*=\"mintlify\"] {\n  display: none !important;\n}\n\nimg {\n  max-width: 100%;\n  height: auto;\n  object-fit: contain;\n}\n\n@media (min-width: 1024px) {\n  #sidebar {\n    top: max(\n      calc(var(--mintlify-slot-header-height, 7rem) + var(--banner-height, 0px)),\n      5rem\n    ) !important;\n  }\n}\n\n@media (max-width: 1023px) {\n  #sidebar \u003e div:first-child,\n  #sidebar-content \u003e div:first-child {\n    padding-top: 16px !important;\n  }\n}\n\n.code-docs h2,\n.code-docs h3 {\n  display: block !important;\n  padding: 0 !important;\n  border-radius: 0 !important;\n  background-color: transparent !important;\n  color: inherit !important;\n  border: none !important;\n}\n\n.code-image-placeholder {\n  border: 1px dashed #CBD5E1;\n  border-radius: 8px;\n  padding: 16px;\n  background: #F8FAFC;\n  color: #475569;\n  font-size: 14px;\n  line-height: 22px;\n  margin: 16px 0 24px;\n}\n\n.dark .code-image-placeholder {\n  border-color: #475569;\n  background: #111827;\n  color: #CBD5E1;\n}\n\n.code-screenshot {\n  display: block;\n  width: 100%;\n  margin: 16px 0 24px;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  background: #FFFFFF;\n}\n\n.dark .code-screenshot {\n  border-color: #334155;\n  background: #0F172A;\n}\n\n.code-community-panel {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 180px;\n  gap: 24px;\n  align-items: center;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  padding: 20px;\n  margin: 16px 0 8px;\n  background: #FFFFFF;\n}\n\n.code-community-panel p {\n  margin-bottom: 0;\n}\n\n.code-qr-placeholder {\n  display: flex;\n  min-height: 180px;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  border: 1px dashed #CBD5E1;\n  border-radius: 8px;\n  background: #F8FAFC;\n  color: #334155;\n  text-align: center;\n}\n\n.code-qr-placeholder small {\n  max-width: 140px;\n  color: #64748B;\n  font-size: 12px;\n  line-height: 18px;\n}\n\n.code-community-qr {\n  display: block;\n  width: 180px;\n  max-width: 100%;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  background: #FFFFFF;\n}\n\n.dark .code-community-panel {\n  border-color: #334155;\n  background: #0F172A;\n}\n\n.dark .code-qr-placeholder {\n  border-color: #475569;\n  background: #111827;\n  color: #CBD5E1;\n}\n\n.dark .code-qr-placeholder small {\n  color: #94A3B8;\n}\n\n@media (max-width: 640px) {\n  .code-community-panel {\n    grid-template-columns: 1fr;\n  }\n\n  .code-qr-placeholder {\n    min-height: 220px;\n  }\n}\n\nbody:has(.question-standalone-marker) header,\nbody:has(.question-standalone-marker) #navbar,\nbody:has(.question-standalone-marker) #sidebar,\nbody:has(.question-standalone-marker) #sidebar-content,\nbody:has(.question-standalone-marker) footer,\nbody:has(.question-standalone-marker) [class*=\"navbar\"],\nbody:has(.question-standalone-marker) [class*=\"Navbar\"],\nbody:has(.question-standalone-marker) [class*=\"sidebar\"],\nbody:has(.question-standalone-marker) [class*=\"Sidebar\"],\nbody:has(.question-standalone-marker) [class*=\"search\"],\nbody:has(.question-standalone-marker) [class*=\"Search\"],\nbody:has(.question-standalone-marker) button[aria-label*=\"Search\"],\nbody:has(.question-standalone-marker) button[aria-label*=\"搜索\"],\nbody:has(.question-standalone-marker) [role=\"search\"] {\n  display: none !important;\n}\n\nbody:has(.question-standalone-marker) #table-of-contents-layout,\nbody:has(.question-standalone-marker) [aria-label=\"目录\"],\nbody:has(.question-standalone-marker) [aria-label=\"Contents\"] {\n  display: none !important;\n}\n\nbody:has(.question-standalone-marker) main,\nbody:has(.question-standalone-marker) article {\n  padding-top: 0 !important;\n}\n\nbody:has(.question-standalone-marker) article {\n  max-width: 900px !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n}\n"])</script><script>self.__next_f.push([1,"54:[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"style.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$59\"}}]]\n5b:T147f,"])</script><script>self.__next_f.push([1,"(() =\u003e {\n  const PRODUCT_URL = 'https://agent.minimax.io';\n  const PRODUCT_NAME = 'MiniMax Agent';\n  const MINIMAX_URL = 'https://www.minimax.io';\n  const LOGO_URL = 'https://file.cdn.minimax.io/public/969d635c-cab6-45cc-8d61-47c9fe40c81f.png';\n  const LANGUAGE = 'en-US';\n  const DESCRIPTION = 'MiniMax Agent is a general-purpose AI agent that builds full-stack web apps, presentations, deep research reports, and more. Powered by a multi-agent system.';\n\n  const baseCount = 32182;\n  const startDate = new Date('2024-01-01').getTime();\n  const today = new Date().getTime();\n  const daysSinceStart = Math.floor((today - startDate) / (1000 * 60 * 60 * 24));\n  const dateNum = parseInt(new Date().toISOString().slice(0, 10).replace(/-/g, ''), 10);\n  const dailyIncrement = 50 + (dateNum % 40);\n  const ratingCount = baseCount + Math.floor(daysSinceStart * (dailyIncrement - 20));\n\n  const schema = {\n    '@context': 'https://schema.org',\n    '@graph': [\n      {\n        '@type': 'SoftwareApplication',\n        '@id': PRODUCT_URL + '/#softwareapplication',\n        name: PRODUCT_NAME,\n        url: PRODUCT_URL,\n        operatingSystem: 'Web, Windows, Mac, iOS, Android',\n        applicationCategory: 'ProductivityApplication',\n        aggregateRating: {\n          '@type': 'AggregateRating',\n          ratingValue: 4.9,\n          bestRating: 5,\n          ratingCount: ratingCount,\n        },\n        offers: {\n          '@type': 'Offer',\n          price: '0',\n          priceCurrency: 'USD',\n        },\n        logo: {\n          '@type': 'ImageObject',\n          '@id': PRODUCT_URL + '/#/schema/logo/image',\n          inLanguage: LANGUAGE,\n          url: LOGO_URL,\n          contentUrl: LOGO_URL,\n          caption: PRODUCT_NAME,\n        },\n        mainEntityOfPage: {\n          '@type': 'WebPage',\n          '@id': PRODUCT_URL + '/#webpage',\n        },\n        creator: {\n          '@type': 'Organization',\n          name: 'MiniMax',\n          url: MINIMAX_URL,\n        },\n        features: [\n          'Full-Stack Web App Development',\n          'PPT \u0026 Presentation Generation',\n          'Deep Research \u0026 Analysis',\n          'Browser Automation',\n          'Code Generation',\n          'MCP Ecosystem Integration',\n          'Multimodal Content Creation',\n        ],\n      },\n      {\n        '@type': 'WebSite',\n        '@id': PRODUCT_URL + '/#website',\n        url: PRODUCT_URL,\n        name: PRODUCT_NAME,\n        description: DESCRIPTION,\n        publisher: { '@id': PRODUCT_URL + '/#organization' },\n        inLanguage: LANGUAGE,\n        copyrightHolder: { '@id': PRODUCT_URL + '/#organization' },\n      },\n      {\n        '@type': 'WebPage',\n        '@id': PRODUCT_URL + '/#webpage',\n        url: window.location.href,\n        name: document.title,\n        about: { '@id': PRODUCT_URL + '/#organization' },\n        isPartOf: { '@id': PRODUCT_URL + '/#website' },\n        primaryImageOfPage: { '@id': PRODUCT_URL + '/#primaryimage' },\n        image: { '@id': PRODUCT_URL + '/#primaryimage' },\n        thumbnailUrl: LOGO_URL,\n        datePublished: new Date().toISOString(),\n        dateModified: new Date().toISOString(),\n        description: DESCRIPTION,\n        inLanguage: LANGUAGE,\n      },\n      {\n        '@type': 'ImageObject',\n        inLanguage: LANGUAGE,\n        '@id': PRODUCT_URL + '/#primaryimage',\n        url: LOGO_URL,\n        contentUrl: LOGO_URL,\n        width: 80,\n        height: 80,\n      },\n      {\n        '@type': 'BreadcrumbList',\n        '@id': PRODUCT_URL + '/#breadcrumb',\n        itemListElement: [\n          {\n            '@type': 'ListItem',\n            position: 1,\n            name: 'MiniMax Agent',\n            item: PRODUCT_URL,\n          },\n          {\n            '@type': 'ListItem',\n            position: 2,\n            name: document.title,\n            item: window.location.href,\n          },\n        ],\n      },\n      {\n        '@type': ['Organization', 'Brand'],\n        '@id': PRODUCT_URL + '/#organization',\n        name: PRODUCT_NAME,\n        legalName: PRODUCT_NAME,\n        url: PRODUCT_URL,\n        description: DESCRIPTION,\n        logo: {\n          '@type': 'ImageObject',\n          inLanguage: LANGUAGE,\n          '@id': PRODUCT_URL + '/#/schema/logo/image',\n        },\n        parentOrganization: {\n          '@type': ['Organization', 'Brand'],\n          name: 'MiniMax',\n          legalName: 'MiniMax',\n          url: MINIMAX_URL,\n          description: 'MiniMax is a leading general artificial intelligence technology company.',\n          logo: {\n            '@type': 'ImageObject',\n            inLanguage: LANGUAGE,\n            '@id': MINIMAX_URL + '/#schema/logo/image',\n            url: LOGO_URL,\n            contentUrl: LOGO_URL,\n            caption: 'MiniMax',\n          },\n          sameAs: [\n            'https://www.linkedin.com/company/minimax-ai/',\n            'https://en.wikipedia.org/wiki/MiniMax_(company)',\n            'https://x.com/MiniMax_AI',\n            'https://github.com/MiniMax-AI',\n            'https://discord.com/invite/hvvt8hAye6',\n          ],\n        },\n      },\n    ],\n  };\n\n  const script = document.createElement('script');\n  script.type = 'application/ld+json';\n  script.textContent = JSON.stringify(schema);\n  document.head.appendChild(script);\n})();\n"])</script><script>self.__next_f.push([1,"55:[\"$\",\"$L5a\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"69c794007ba705a2811a3dae\",\"filePath\":\"scripts/seo-schema.js\",\"subdomain\":\"agent-en\",\"__v\":0,\"content\":\"$5b\"}]}]\n5e:T877d,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,li:`li`,ol:`ol`,p:`p`,..._provideComponents(),...props.components},{Heading,Note,OptimizedImage,Tip}=_components;if(!Heading)_missingMdxReference(`Heading`,true);if(!Note)_missingMdxReference(`Note`,true);if(!OptimizedImage)_missingMdxReference(`OptimizedImage`,true);if(!Tip)_missingMdxReference(`Tip`,true);return _jsxs(_Fragment,{children:[_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cover.jpg?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=dce04f0eca0c1605cfbb22c9cb99c535`,alt:`MiniMax Code: Inside the Harness`,\"data-og-width\":`1774`,width:`1774`,\"data-og-height\":`887`,height:`887`,\"data-path\":`images/techblog/harness-cover.jpg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cover.jpg?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=46249c36603f6ce2215a04de6ca6162e 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cover.jpg?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=888aab69921a114fe4478a9274b1d184 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cover.jpg?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=32eae708aedc05e89a4251d68ea45bdc 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cover.jpg?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=09b36ad424c9183abed7d52d62c19784 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cover.jpg?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=5fe4fbadfc47db183465679e0564bb8a 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cover.jpg?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=5eb7c910f6ae5fef623ccf4a3bd97e6c 2500w`}),`\n`,_jsxs(_components.p,{children:[`On September 18, we announced in `,_jsx(_components.a,{href:`https://mp.weixin.qq.com/s/aZTOlQUnULqptBgGGKZXEg`,children:`MiniMax Code CLI Is Now Open Source`}),` (in Chinese) that v0.4.12 was released under the MIT license. MiniMax Code CLI is the core component of the MiniMax Code client, and with this release we also handed the Harness implementation behind it to the community.`]}),`\n`,_jsx(Note,{children:_jsxs(_components.p,{children:[`GitHub repository: `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code`,children:`github.com/MiniMax-AI/minimax-code`})]})}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cli.jpg?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=673bd0de98703ca9be7a5b0daad2ee87`,alt:`The MiniMax Code CLI welcome screen`,\"data-og-width\":`1080`,width:`1080`,\"data-og-height\":`1439`,height:`1439`,\"data-path\":`images/techblog/harness-cli.jpg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cli.jpg?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=863d3dceed2e20d59ffd2c065d579577 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cli.jpg?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=dbdb582e8e83f16cb50f37449d223d74 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cli.jpg?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=65d24453fabecef0b2615144e7c0aa6e 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cli.jpg?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=a4971d6c3d921778c40ea5782826a9e9 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cli.jpg?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=83d2fbac7ddd3139cea7e47ab59fb466 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-cli.jpg?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=bc01c768671860a976ef9afcef2d0274 2500w`}),`\n`,_jsxs(_components.p,{children:[`The announcement cited an evaluation run on FrontierHarness Eval: MiniMax Code v0.3.2 paired with Kimi K3 passed 23 of 30 tasks, a 76.7% pass rate, with a median runtime of 4 minutes 33 seconds per successful task. The `,_jsx(_components.a,{href:`https://github.com/frontier-harness-eval/eval/pull/13`,children:`evaluation report`}),` keeps the results and the comparison methodology.`]}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-speed.png?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=0dc024b7f542a3e38841032594f4fbe7`,alt:`FrontierHarness Eval: pass rate vs. median runtime per successful task`,\"data-og-width\":`1080`,width:`1080`,\"data-og-height\":`720`,height:`720`,\"data-path\":`images/techblog/harness-eval-speed.png`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-speed.png?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=e70db04c856d6e5c1422b828eb9d4836 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-speed.png?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=29182159e0b18a776713d9041615a064 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-speed.png?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=c5e4df48a930245a1d558d65819ab4cf 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-speed.png?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=5efd501b01d1c0fcd4bca3b7d92b7221 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-speed.png?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=22d2f3f9495c9a2d86ebee27590b00d7 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-speed.png?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=c26cea2a01083e5f0dca017046c6d3d0 2500w`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-cost.png?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=59291f099fc71f577f184db2aa257034`,alt:`FrontierHarness Eval: pass rate vs. recorded cost per pass`,\"data-og-width\":`1080`,width:`1080`,\"data-og-height\":`720`,height:`720`,\"data-path\":`images/techblog/harness-eval-cost.png`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-cost.png?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=056026efb24f44d648c7eb4f5f2a4fb4 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-cost.png?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=cd1845e4a51850805c1cf731176c49aa 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-cost.png?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=109e7d2a86afc123bd7da87c112f3ddc 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-cost.png?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=9d9dde85f8d14480d4fc3da358854ad3 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-cost.png?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=c81828583ebc1342e7440d58cbb2ca47 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-eval-cost.png?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=4209ed1b311873070f2b3919e31b7a0f 2500w`}),`\n`,_jsx(_components.p,{children:`This post is about the code. Say a tool finishes editing a file, but the process exits before history is committed. When the session resumes, can it still tell what just happened? Or the model has already read a tool’s description, but the plugin updates before the tool runs. Which version should be used? Questions like these have to be traced through the runtime’s state and call order.`}),`\n`,_jsx(_components.p,{children:`When we open-sourced the CLI, we said we hoped developers would scrutinize how tool calls and permissions are handled. So let’s start from the overall architecture, then look at how each turn’s capabilities are assembled, when a tool is allowed to run, how context is compacted, and when history and sub-task results are considered confirmed.`}),`\n`,_jsx(Heading,{level:`2`,id:`1-what-happens-when-a-task-enters-minimax-code`,children:`1. What happens when a task enters MiniMax Code`}),`\n`,_jsx(_components.p,{children:`Suppose we give MiniMax Code a task: fix an edge case in a function, check its callers, then run the tests. The model might search the code first, read a few files, propose a change, and finally decide whether to keep going based on the test results. A single user request goes through many rounds of model inference and tool execution.`}),`\n`,_jsxs(_components.p,{children:[`MiniMax Code has three entry points: interactive `,_jsx(_components.code,{children:`mcode`}),`, script-friendly `,_jsx(_components.code,{children:`mcode exec`}),`, and `,_jsx(_components.code,{children:`mcode acp`}),` for compatible clients. All three go through `,_jsx(_components.code,{children:`CliService`}),` and the local applications to reach the same in-process runtime. When the CLI starts, `,_jsx(_components.code,{children:`createEmbeddedRuntimeHost()`}),` creates a local host, waits for it to be ready, and obtains `,_jsx(_components.code,{children:`CliService`}),`, without going through the Desktop HTTP service. Model requests and some tools still reach remote services.`]}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-runtime.jpg?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=f983055c64e5b2364f9d7f8437ea404a`,alt:`MiniMax Code runtime execution architecture`,\"data-og-width\":`1536`,width:`1536`,\"data-og-height\":`1024`,height:`1024`,\"data-path\":`images/techblog/harness-runtime.jpg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-runtime.jpg?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=5e2bc91c28517f122b304430a81612a7 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-runtime.jpg?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=c9f0abb5fe8acf960d716e0449f5a178 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-runtime.jpg?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=8fa844053c8875220d5638c3c943e927 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-runtime.jpg?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=891394999fe99ae0d42ad171838a8593 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-runtime.jpg?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=fa56badf8bf4eb4cb2f21dcad2c0793c 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-runtime.jpg?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=b75d32a4540093d206761a4373cbbea9 2500w`}),`\n`,_jsx(_components.p,{children:`Once a task comes in, the Session holds working state that spans turns: conversation history, session configuration, and task relationships. The runtime admits this execution and creates a Turn with its own identity, cancellation signal, and final state. Model requests and tool steps all happen inside that Turn.`}),`\n`,_jsxs(_components.p,{children:[`The turn is orchestrated by `,_jsx(_components.code,{children:`LocalAgentHost`}),`. It prepares the turn’s runtime environment, assembles capabilities through `,_jsx(_components.code,{children:`agent-runtime`}),`, then hands off to `,_jsx(_components.code,{children:`PiTurnRunner`}),`, which uses Pi components to drive the model–tool loop. The Session system handles history storage and recovery.`]}),`\n`,_jsx(_components.p,{children:`At the start of the loop, the runtime prepares the current model request. If the model proposes a tool call, the runtime checks and executes it, then commits the result to history for later requests. In our example, search results, file contents, and test output gradually enter the context this way. Once the model returns a final answer or execution is interrupted, the Host still has to wrap up history and Turn state.`}),`\n`,_jsxs(_components.p,{children:[`So one Turn can contain many model requests, and one Session can span many Turns. `,_jsx(_components.code,{children:`PiTurnRunner`}),` itself is reusable, but every `,_jsx(_components.code,{children:`runTurn()`}),` creates a fresh Agent, event bridge, event queue, and history cursor. Mutable objects for a turn are created with that turn; anything the next turn needs is kept by the session layer.`]}),`\n`,_jsx(_components.p,{children:`The following sections walk this loop: first how input is prepared before each model request, then how the operations the model proposes are executed and recorded, and finally how the same process extends to sub-agents.`}),`\n`,_jsx(Heading,{level:`2`,id:`2-what-the-harness-prepares-before-each-model-request`,children:`2. What the Harness prepares before each model request`}),`\n`,_jsx(_components.p,{children:`To fix the function in our example, the model needs to see the task requirements and what has been found so far, and it needs to know which tools it can use. This input keeps changing as execution proceeds: freshly read files get added, test logs can be long, and plugin configuration may even update mid-task.`}),`\n`,_jsx(_components.p,{children:`Two constraints must hold at the same time: the tool descriptions in the input must match the capabilities actually used in this turn, and the whole request must fit in the model’s window. MiniMax Code handles them with capability assembly and context management respectively.`}),`\n`,_jsx(Heading,{level:`3`,id:`pin-the-turn’s-capabilities-first-then-build-the-request`,children:`Pin the turn’s capabilities first, then build the request`}),`\n`,_jsxs(_components.p,{children:[`The extension Registry normally moves through `,_jsx(_components.code,{children:`new → initializing → ready`}),`; if initialization fails, it goes to `,_jsx(_components.code,{children:`failed`}),`. Extensions register capabilities through owner-scoped interfaces, and only within their own initialization window. A registry that hasn’t finished initializing can’t be used as a normally available registry.`]}),`\n`,_jsxs(_components.p,{children:[`On entering `,_jsx(_components.code,{children:`assembleTurn()`}),`, the Registry synchronously snapshots each extension’s enabled state before the first `,_jsx(_components.code,{children:`await`}),`. A `,_jsx(_components.code,{children:`setEnabled()`}),` call made in between only takes effect at the next assembly. Each turn’s hooks create their own closures over that turn’s `,_jsx(_components.code,{children:`ctx`}),`, so concurrent assemblies can’t leak context into each other.`]}),`\n`,_jsxs(_components.p,{children:[`Plugin capabilities are leased by version. The turn capability lifecycle takes a revisioned capability view for each newly admitted execution, covering plugins, skills, runtime tools, and hooks. There is no `,_jsx(_components.code,{children:`await`}),` between capturing the view and registering the in-flight execution; both happen in the same synchronous JavaScript critical section. The reference is released when execution ends.`]}),`\n`,_jsx(_components.p,{children:`That way, once the model has read one version of a tool’s description, a plugin update can’t silently swap this turn’s capabilities for another version. The new version is used by Turns admitted later. What’s pinned is the capability view; the files and remote services that tools touch can still change.`}),`\n`,_jsx(_components.p,{children:`Tool descriptions take up context too. The MCP disclosure policy first checks the feature flag, the model allowlist, and the effective window, then estimates the size of the configured MCP tools’ descriptions. Once a threshold is reached, candidate tools move into a search index and a deferred-call registry, while the other tools stay directly exposed. The default threshold is 15% of the window; whether it actually kicks in also depends on model gating and configuration overrides.`}),`\n`,_jsx(_components.p,{children:`Deferred disclosure saves the space of a whole batch of tool descriptions, but the model has to take an extra step to discover tools, and whether it finds the right one depends on retrieval quality.`}),`\n`,_jsx(Heading,{level:`3`,id:`as-files-and-test-output-pile-up-can-the-next-request-still-go-out`,children:`As files and test output pile up, can the next request still go out?`}),`\n`,_jsx(_components.p,{children:`With capabilities ready, the turn’s history still has to be turned into model input. MiniMax Code’s local footprint measurer estimates tokens together with the system prompt and tool definitions, and computes the UTF-8 serialized byte size of the request. The local estimate may differ from the provider’s exact count of the final wire payload.`}),`\n`,_jsxs(_components.p,{children:[`The budget has to leave room for output and for the rest of execution. Let the context window be `,_jsx(_components.code,{children:`C`}),`, the output cap `,_jsx(_components.code,{children:`O`}),`, the reserve `,_jsx(_components.code,{children:`R`}),`, and the safety margin `,_jsx(_components.code,{children:`S`}),`. The current shared defaults are `,_jsx(_components.code,{children:`R = 16,384`}),` and `,_jsx(_components.code,{children:`S = 2,048`}),`.`]}),`\n`,_jsxs(_components.p,{children:[`When `,_jsx(_components.code,{children:`C − O − S ≥ R`}),`, the budget uses the full output `,_jsx(_components.code,{children:`O`}),`; otherwise it uses `,_jsx(_components.code,{children:`min(O, R)`}),`, written `,_jsx(_components.code,{children:`O_eff`}),`. The input limit is:`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.code,{children:`L = max(1, min(floor(0.95 × C), C − R, C − O_eff − S))`})}),`\n`,_jsx(_components.p,{children:`The automatic compaction threshold sits earlier:`}),`\n`,_jsx(_components.p,{children:_jsx(_components.code,{children:`T = min(L, max(1, C − min(2 × R, floor(C / 4))))`})}),`\n`,_jsxs(_components.p,{children:[`For example, with a window of `,_jsx(_components.code,{children:`131,072`}),` and an output cap of `,_jsx(_components.code,{children:`16,384`}),`, the defaults give `,_jsx(_components.code,{children:`L = 112,640`}),` and `,_jsx(_components.code,{children:`T = 98,304`}),`. In other words, context handling starts well before the input limit is hit. Changing the model or configuration means recomputing.`]}),`\n`,_jsxs(_components.p,{children:[`If the example task reads in lots of source code and test logs, the `,_jsx(_components.code,{children:`ToolResultArchiver`}),` assembled by the runtime picks what to archive based on the output watermark, candidate size, recent-turn protection, and expected gain. It first produces a plan that doesn’t mutate state, then actually archives. When a `,_jsx(_components.code,{children:`read`}),` tool is available, larger older outputs can be replaced with an archive handle, while the original stays on disk for later reads.`]}),`\n`,_jsx(_components.p,{children:`Archive candidates have to pass checks: at least one of token count or byte size must go down, tokens must fit within the input budget, and bytes must satisfy their limit. Without an explicit byte cap, the candidate’s serialized size can’t exceed the pre-archive size.`}),`\n`,_jsxs(_components.p,{children:[`When no archive candidate satisfies the conditions directly, the LLM checkpoint path takes over. The generated checkpoint is validated, history is replaced, and the request is measured again. If it’s still over the limit, `,_jsx(_components.code,{children:`POST_ADMISSION_FAILED`}),` is returned. So whether compaction succeeded is judged by whether the next request — prompt and tool definitions included — fits the limits.`]}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-context.jpg?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=a76b72a5cb9d3ad904044c338e6bb635`,alt:`Preparing the next model request: archiving, checkpointing, and full-request validation`,\"data-og-width\":`1536`,width:`1536`,\"data-og-height\":`1024`,height:`1024`,\"data-path\":`images/techblog/harness-context.jpg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-context.jpg?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=2ba6a0776a523d03bc6636e13112d787 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-context.jpg?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=26f8887136dae73d04020374c1a58279 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-context.jpg?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=0db11cce037ce500ea17592929605736 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-context.jpg?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=3a7cd00bb256a95aef61fde2c1eea248 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-context.jpg?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=2e113cb1f995f44c0cd52b1af5dea2e3 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-context.jpg?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=6f7285121c28caf0a9f8518d5a9d2e62 2500w`}),`\n`,_jsx(_components.p,{children:`The request that generates the checkpoint can itself be too long. The input degradation path tries to handle tool outputs, media, and middle history; history is trimmed in whole tool-interaction units, preserving the pairing between tool calls and results. Even when the size fits, compaction can still lose task information, so evaluations need to check whether the model drops constraints or repeats investigation.`}),`\n`,_jsx(_components.p,{children:`To help decide when to compact, there is also an in-process usage anchor: it anchors on qualifying assistant usage, adds an incremental estimate for what came after, and takes the larger of that and the current local estimate. The anchor is bound to the session scope, provider, API, model, system prompt/tools fingerprint, history epoch, and the identity of the anchored message. After switching models, changing tools, or replacing history, it has to be revalidated before it applies.`}),`\n`,_jsx(_components.p,{children:`Comparing pre- and post-compaction candidates still uses a fresh estimate for each. The historical anchor can help the trigger decision but cannot replace validating the current candidate. Only after all this can the runtime go back to the model with this turn’s capabilities and the current context.`}),`\n`,_jsx(Heading,{level:`2`,id:`3-how-the-harness-executes-and-records-what-the-model-proposes`,children:`3. How the Harness executes and records what the model proposes`}),`\n`,_jsx(_components.p,{children:`Now the model has read the code and decides to call a tool to edit a file. Two separate facts need confirming: whether the operation may run right now, and whether its result has made it into the history the next step will use. A tool returning output only answers part of that.`}),`\n`,_jsx(Heading,{level:`3`,id:`recheck-eligibility-before-a-tool-starts`,children:`Recheck eligibility before a tool starts`}),`\n`,_jsxs(_components.p,{children:[`The tool control chain first checks for duplicate tool-call IDs in the turn. For delegated calls carrying a host `,_jsx(_components.code,{children:`tool_ref`}),`, it also resolves the actual execution target, then passes through safety/plugin pre-checks, tool policy, and extension hooks before the permission decision. Later checks see the real target, so permissions aren’t evaluated only against the wrapper tool.`]}),`\n`,_jsxs(_components.p,{children:[`Suppose a tool is waiting for user approval, but the user cancels the task first. When the approval comes back, the original Turn may already be over even though permission was granted. So after permission passes, the control chain still has to attempt `,_jsx(_components.code,{children:`openToolResultTail()`}),`, which only succeeds if the matching active Turn is still in the `,_jsx(_components.code,{children:`running`}),` phase.`]}),`\n`,_jsxs(_components.p,{children:[`The Turn controller checks `,_jsx(_components.code,{children:`sessionId`}),`, `,_jsx(_components.code,{children:`turnId`}),`, `,_jsx(_components.code,{children:`leaseId`}),`, the admission sequence, the execution reason, and the signal identity. A session can run many turns one after another, and callbacks from an old turn must not take over a new one. The lease here rejects stale executions within the current runtime.`]}),`\n`,_jsxs(_components.p,{children:[`Actual filesystem and network access is further constrained by the enabled sandbox backend. V2 currently registers the macOS `,_jsx(_components.code,{children:`srt-macos`}),` backend by default; isolation on other platforms depends on whether a corresponding backend supports it.`]}),`\n`,_jsx(Heading,{level:`3`,id:`after-a-tool-returns-commit-the-result-to-canonical-history`,children:`After a tool returns, commit the result to canonical history`}),`\n`,_jsx(_components.p,{children:`Once the file edit succeeds, the model needs to know the result before it can go on to run tests. If the process exits before history is committed, the files on disk may not match the history read back after recovery. That’s why MiniMax Code separates in-flight execution events from canonical history: the former describes what is happening; the latter is the authoritative history used to continue.`}),`\n`,_jsx(_components.p,{children:`Canonical history is stored and recovered by the Session system. The Host handles plain appends, replacements, compaction, and reconciliation through a single committed-history writer. History commits happen during execution, and the compaction discussed in the previous section goes through the same commit path.`}),`\n`,_jsx(_components.p,{children:`A commit proceeds in this order:`}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsx(_components.li,{children:`Capture a semantic snapshot and validate the session, turn, and operation identity.`}),`\n`,_jsx(_components.li,{children:`Perform the durable mutation and read canonical history back within the same session operation lane.`}),`\n`,_jsx(_components.li,{children:`Validate the read-back result and obtain the committed revision.`}),`\n`,_jsxs(_components.li,{children:[`Wait for the required `,_jsx(_components.code,{children:`HistoryCommitted`}),` projection; when compaction is involved, also complete the compaction lifecycle.`]}),`\n`,_jsx(_components.li,{children:`Return an acknowledgement to the caller.`}),`\n`]}),`\n`,_jsx(_components.p,{children:`The snapshot keeps callers from mutating the pending object during the asynchronous commit. The read-back means downstream components use the version storage has confirmed, not the array the caller intended to write.`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-commit.jpg?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=6fe8744391ded4168b889bb93bed5471`,alt:`When history is acknowledged: commit order and turn finalization`,\"data-og-width\":`1536`,width:`1536`,\"data-og-height\":`1024`,height:`1024`,\"data-path\":`images/techblog/harness-commit.jpg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-commit.jpg?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=0d05c302e6e13a0c0b287e509b0706f5 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-commit.jpg?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=5785d83c94d50c176c26807214b8943b 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-commit.jpg?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=49fca7e9ed727da1131d2688dc62f6dd 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-commit.jpg?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=87425977f846ebdfe2ff072becf34d02 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-commit.jpg?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=63bf14c9f97c98a084cf5d1521c48c40 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/harness-commit.jpg?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=78f532816fc8007b3d0c8f8adfacf449 2500w`}),`\n`,_jsxs(_components.p,{children:[`On retry, the writer identifies an operation by `,_jsx(_components.code,{children:`sessionId + operationId`}),` and then compares semantic fingerprints. Only when both identity and content match is the earlier execution reused; the same identity with different content triggers conflict handling. This replay registry is bounded and process-local, and provides no exactly-once guarantee across processes or external services.`]}),`\n`,_jsx(_components.p,{children:`When a tool result carries appended input, taking it and confirming it are also kept apart: the control chain claims it first and acks it only after history is committed. If input is still being consumed when the Turn wraps up, shutdown is deferred. Unconsumed user steers have a path back into the queue, and machine input that has already been delivered can’t simply be dropped during wrap-up.`}),`\n`,_jsx(_components.p,{children:`Canonical history is only acknowledged after the required state projections finish. Usage accounting and diagnostics are best effort: failures are logged but don’t block history acknowledgement. External side effects need separate handling. If a remote write succeeds but the response is lost, you still need an idempotency key or business-level compensation on the target service; local history can’t undo it.`}),`\n`,_jsxs(_components.p,{children:[`After the tool result is committed, the loop returns to the previous section: prepare a context that includes the new result, then request the model again. The example task keeps editing and running tests this way until it can finish. When the turn exits, the Host confirms the runner’s terminal state, reconciles history, runs the `,_jsx(_components.code,{children:`turn_end`}),` handlers, and finally commits and confirms the Turn’s terminal state. The Host may still be doing this after the model has stopped generating.`]}),`\n`,_jsx(Heading,{level:`2`,id:`4-how-the-process-extends-when-a-task-is-split-across-agents`,children:`4. How the process extends when a task is split across agents`}),`\n`,_jsx(_components.p,{children:`The same fix can also be split up: the main agent edits the function while a sub-agent checks callers or does extra investigation. The sub-agent has its own session and execution, and the main agent needs to pick up its result at the right moment. Input preparation, tool execution, and history acknowledgement from the earlier sections still have to hold within each execution.`}),`\n`,_jsx(_components.p,{children:`MiniMax Code records an independent task ID, owning session, parent task, status, and output reference for each background task. Statuses are queued, running, stopping, succeeded, failed, canceled, and lost, and the TUI shows delegated agents according to the parent–child session relationship.`}),`\n`,_jsx(_components.p,{children:`What collaboration adds is this question: after a sub-task finishes, when does the main task count as having used its result? Completion, notification delivery, and reading the result can happen at different times, and the main task can fail after reading the result.`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.code,{children:`deliveredAt`}),` records delivery state; an automatic completion notification does not mark the result as consumed. The current Host records a consumption candidate only after it successfully reads a terminal task’s output; reading a running task’s progress doesn’t suppress the later completion notification. Only when the main task’s turn ends as completed and its terminal state is committed does the Host confirm the candidate as consumed.`]}),`\n`,_jsxs(_components.p,{children:[`For example, a sub-agent finishes investigating callers, the main agent reads the result with `,_jsx(_components.code,{children:`task_output`}),`, then fails later in the turn. If the result were permanently marked consumed the moment it was read, the next continuation might never get reminded again. Deferring confirmation until the Turn commits ties that read to whether the main task actually completed.`]}),`\n`,_jsx(_components.p,{children:`This follows the commit order from the previous section and keeps the same possible failure between steps: the Turn has been committed, and only then can the consumption confirmation or later settlement fail. In that case diagnostics are recorded, and the committed Turn isn’t retroactively marked failed; these steps don’t form one atomic transaction across all components.`}),`\n`,_jsxs(_components.p,{children:[`After a runtime restart, tasks are also checked for a live executor. Tasks without a valid executor are settled as `,_jsx(_components.code,{children:`lost`}),` instead of showing running forever. The main task can continue from the recovered session history, but sub-task processes that have disappeared need to be handled separately.`]}),`\n`,_jsx(Heading,{level:`2`,id:`closing-thoughts`,children:`Closing thoughts`}),`\n`,_jsx(_components.p,{children:`For a coding task to finish well, the model needs the right context, and tool execution, history commits, and sub-task delivery all have to hand off as agreed. MiniMax Code has open-sourced the implementation of each of these pieces, and we hope more developers can understand the trade-offs inside and use, test, and improve it in their own settings.`}),`\n`,_jsx(Tip,{children:_jsxs(_components.p,{children:[`If Agent Harnesses interest you, come take a look on `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code`,children:`GitHub`}),` and give MiniMax Code a Star. You’re also welcome to try it out and file Issues — thank you for your support!`]})})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"56:[\"$\",\"$L5c\",null,{\"slug\":\"techblog/minimax-code-harness\",\"pageMetadata\":\"$4b:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L5d\",null,{\"mdxSource\":{\"compiledSource\":\"$5e\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"title\":\"MiniMax Code Is Open Source: Inside the Harness Behind a Coding Agent\",\"sidebarTitle\":\"Inside the MiniMax Code Harness\",\"description\":\"Following one task through MiniMax Code: how each turn's capabilities are assembled, how context is managed, how tools are executed, how history is committed, and how sub-agent results are confirmed.\",\"og:title\":\"MiniMax Code Is Open Source: Inside the Harness Behind a Coding Agent\",\"og:description\":\"Capability assembly, context compaction, tool execution eligibility, canonical history commits, and sub-task delivery — MiniMax Code Engineering Notes, Part 1.\",\"href\":\"/techblog/minimax-code-harness\"}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"agent.minimax.io/docs\"}]}]\n"])</script></body></html>