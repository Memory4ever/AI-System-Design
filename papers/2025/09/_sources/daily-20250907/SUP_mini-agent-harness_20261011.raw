scription\":\"Use mcode exec from Shell, CI, batch jobs, and evaluations with structured output and stable exit codes.\",\"href\":\"/cli/automation\"},{\"title\":\"ACP integration\",\"sidebarTitle\":\"ACP integration\",\"description\":\"Connect MiniMax Code CLI to editors and Agent hosts that support Agent Client Protocol.\",\"href\":\"/cli/integrations\"},{\"title\":\"Command reference\",\"sidebarTitle\":\"Command reference\",\"description\":\"Review MiniMax Code CLI top-level commands, options, and machine-readable output entry points.\",\"href\":\"/cli/reference\"},{\"title\":\"Security and permissions\",\"sidebarTitle\":\"Security and permissions\",\"description\":\"Understand MiniMax Code CLI permission modes, credential protection, and automation boundaries.\",\"href\":\"/cli/security\"},{\"title\":\"Troubleshooting\",\"sidebarTitle\":\"Troubleshooting\",\"description\":\"Troubleshoot MiniMax Code CLI installation, sign-in, configuration, automation, and terminal issues.\",\"href\":\"/cli/faq\"}]},{\"tab\":\"Changelog\",\"pages\":[{\"title\":\"Changelog\",\"sidebarTitle\":\"Changelog\",\"description\":\"Track every update to MiniMax Code.\",\"og:title\":\"MiniMax Agent Changelog – Product Updates \u0026 Release Notes\",\"og:description\":\"Full history of MiniMax Agent updates from June 2025 to present. Desktop app, scheduled tasks, custom instructions, multi-model support, and 30+ feature releases.\",\"href\":\"/changelog\"}]},{\"tab\":\"Tech Blog\",\"pages\":[{\"title\":\"Tech Blog\",\"sidebarTitle\":\"Tech Blog\",\"description\":\"Technical articles from the MiniMax Agent engineering team.\",\"og:title\":\"MiniMax Agent Tech Blog\",\"og:description\":\"Engineering insights from the MiniMax Agent team.\",\"href\":\"/techblog\"}]}]},\"maps\":{\"firstHrefInVersion\":{},\"firstHrefInLanguage\":{}},\"children\":\"$L4b\"}]\n"])</script><script>self.__next_f.push([1,"4c:I[763509,[\"/docs/_next/static/chunks/0ea0e179f06dc225.js?dpl=dpl_FHTuezYwhxFJmZtMvTojAU2mWDym\