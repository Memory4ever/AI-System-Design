<th id="S5.T2.2.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.2.1.1.5.1" class="ltx_text ltx_font_bold">P-LOPO</span></th>
<th id="S5.T2.2.1.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.2.1.1.6.1" class="ltx_text ltx_font_bold">Processing Time (ms)</span></th>
<th id="S5.T2.2.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.2.1.1.7.1" class="ltx_text ltx_font_bold">FLOPs (G)</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.2.1.2" class="ltx_tr">
<th id="S5.T2.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="S5.T2.2.1.2.1.1" class="ltx_text ltx_font_bold">SAMoSA</span></th>
<th id="S5.T2.2.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">SAMoSA</th>
<td id="S5.T2.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t">1</td>
<td id="S5.T2.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">92.2</td>
<td id="S5.T2.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">N/A</td>
<td id="S5.T2.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t">56.4</td>
<td id="S5.T2.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t">1.71</td></tr>
