<td id="S6.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_t">80.80</td>
<td id="S6.T3.2.2.5" class="ltx_td ltx_align_center ltx_border_t">14.54</td></tr>
<tr id="S6.T3.2.3" class="ltx_tr">
<th id="S6.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">ResNet-22</th>
<td id="S6.T3.2.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T3.2.3.2.1" class="ltx_text ltx_font_bold">79.8</span></td>
<td id="S6.T3.2.3.3" class="ltx_td ltx_align_center ltx_border_t">86.5</td>
<td id="S6.T3.2.3.4" class="ltx_td ltx_align_center ltx_border_t">63.73</td>
<td id="S6.T3.2.3.5" class="ltx_td ltx_align_center ltx_border_t">10.36</td></tr>
<tr id="S6.T3.2.4" class="ltx_tr">
<th id="S6.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">MobileNetV1</th>
<td id="S6.T3.2.4.2" class="ltx_td ltx_align_center ltx_border_t">77.8</td>
<td id="S6.T3.2.4.3" class="ltx_td ltx_align_center ltx_border_t">85.5</td>
<td id="S6.T3.2.4.4" class="ltx_td ltx_align_center ltx_border_t">5.36</td>
<td id="S6.T3.2.4.5" class="ltx_td ltx_align_center ltx_border_t">1.25</td></tr>
<tr id="S6.T3.2.5" class="ltx_tr">
