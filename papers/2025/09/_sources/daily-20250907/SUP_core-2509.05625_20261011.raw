<td id="S4.T4.3.4.1" class="ltx_td ltx_align_center" style="padding:0.4pt 7.0pt;"><span id="S4.T4.3.4.1.1" class="ltx_text" style="font-size:70%;">CLIP: 0.29</span></td>
