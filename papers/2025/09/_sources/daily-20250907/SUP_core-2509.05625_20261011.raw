<td id="A6.T10.3.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.2.2.1" class="ltx_text" style="font-size:90%;">23</span></td>
<td id="A6.T10.3.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.2.3.1" class="ltx_text" style="font-size:90%;">23</span></td>
<td id="A6.T10.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.2.4.1" class="ltx_text" style="font-size:90%;">15</span></td>
<td id="A6.T10.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.2.5.1" class="ltx_text" style="font-size:90%;">15</span></td>
<td id="A6.T10.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.2.6.1" class="ltx_text" style="font-size:90%;">12</span></td></tr>
<tr id="A6.T10.3.1.3" class="ltx_tr">
<th id="A6.T10.3.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.3.1.1" class="ltx_text" style="font-size:90%;">MU (GB)</span></th>
<td id="A6.T10.3.1.3.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.3.2.1" class="ltx_text" style="font-size:90%;">12.21</span></td>
<td id="A6.T10.3.1.3.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.3.3.1" class="ltx_text" style="font-size:90%;">12.74</span></td>
<td id="A6.T10.3.1.3.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.3.4.1" class="ltx_text" style="font-size:90%;">11.67</span></td>
<td id="A6.T10.3.1.3.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.3.5.1" class="ltx_text" style="font-size:90%;">12.51</span></td>
<td id="A6.T10.3.1.3.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="A6.T10.3.1.3.6.1" class="ltx_text" style="font-size:90%;">11.19</span></td></tr>
