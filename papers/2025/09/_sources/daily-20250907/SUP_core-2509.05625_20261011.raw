<tr id="S4.T3.3.3" class="ltx_tr">
<th id="S4.T3.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.3.3.1.1" class="ltx_text" style="font-size:90%;">Step-30</span></th>
<td id="S4.T3.3.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.3.3.2.1" class="ltx_text" style="font-size:90%;">0.09</span></td>
<td id="S4.T3.3.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.3.3.3.1" class="ltx_text" style="font-size:90%;">19.11</span></td>
<td id="S4.T3.3.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.3.3.4.1" class="ltx_text" style="font-size:90%;">0.30</span></td>
<td id="S4.T3.3.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.3.3.5.1" class="ltx_text" style="font-size:90%;">0.08</span></td>
<td id="S4.T3.3.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.3.3.6.1" class="ltx_text" style="font-size:90%;">18.34</span></td>
<td id="S4.T3.3.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.3.3.7.1" class="ltx_text" style="font-size:90%;">0.29</span></td>
<td id="S4.T3.3.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T3.3.3.8.1" class="ltx_text" style="font-size:90%;">0.05</span></td>
