<td id="S3.T1.5.1.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt">Mamba2</td>
<td id="S3.T1.5.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><math id="S3.T1.m21" class="ltx_Math" alttext="\lambda_{t}^{j}=\mathrm{sigmoid}\left(-\mathbf{f}_{t}^{j}-\Delta^{j}\right)^{\exp(\mathbf{A}^{j})}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>j</mi></msubsup><mo>=</mo><mrow><mi>sigmoid</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mrow><mo>−</mo><msubsup><mi>𝐟</mi><mi>t</mi><mi>j</mi></msubsup></mrow><mo>−</mo><msup><mi mathvariant="normal">Δ</mi><mi>j</mi></msup></mrow><mo>)</mo></mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐀</mi><mi>j</mi></msup><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\lambda_{t}^{j}=\mathrm{sigmoid}\left(-\mathbf{f}_{t}^{j}-\Delta^{j}\right)^{\exp(\mathbf{A}^{j})}</annotation></semantics></math></td>
<td id="S3.T1.5.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">✗</td>
<td id="S3.T1.5.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">✓</td>
