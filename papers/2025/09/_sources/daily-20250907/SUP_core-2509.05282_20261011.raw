<span id="S3.T1.5.1.3.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">wo <math id="S3.T1.m22" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math></span></span>
</span></span><span id="S3.T1.5.1.3.1.3" class="ltx_text"></span></td>
<td id="S3.T1.5.1.3.2" class="ltx_td ltx_align_center ltx_border_r"><math id="S3.T1.m23" class="ltx_Math" alttext="\lambda_{t}^{j}=\mathrm{sigmoid}\left(-\mathbf{f}_{t}^{j}-\Delta^{j}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>j</mi></msubsup><mo>=</mo><mrow><mi>sigmoid</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mo>−</mo><msubsup><mi>𝐟</mi><mi>t</mi><mi>j</mi></msubsup></mrow><mo>−</mo><msup><mi mathvariant="normal">Δ</mi><mi>j</mi></msup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{t}^{j}=\mathrm{sigmoid}\left(-\mathbf{f}_{t}^{j}-\Delta^{j}\right)</annotation></semantics></math></td>
<td id="S3.T1.5.1.3.3" class="ltx_td ltx_align_center ltx_border_r">✗</td>
<td id="S3.T1.5.1.3.4" class="ltx_td ltx_align_center ltx_border_r">✓</td>
<td id="S3.T1.5.1.3.5" class="ltx_td ltx_align_center" rowspan="3"><span id="S3.T1.5.1.3.5.1" class="ltx_text"><math id="S3.T1.m24" class="ltx_Math" alttext="\mathbf{s}_{t}^{j}=\lambda_{t}^{j}\mathbf{s}_{t-1}^{j}+\mathbf{k}_{t}^{j}(\mathbf{v}_{t}^{j})^{\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>t</mi><mi>j</mi></msubsup><mo>=</mo><mrow><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>j</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐬</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow><mo>+</mo><mrow><msubsup><mi>𝐤</mi><mi>t</mi><mi>j</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐯</mi><mi>t</mi><mi>j</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{t}^{j}=\lambda_{t}^{j}\mathbf{s}_{t-1}^{j}+\mathbf{k}_{t}^{j}(\mathbf{v}_{t}^{j})^{\top}</annotation></semantics></math></span></td></tr>
<tr id="S3.T1.5.1.4" class="ltx_tr">
<td id="S3.T1.5.1.4.1" class="ltx_td ltx_align_left ltx_border_r"><span id="S3.T1.5.1.4.1.1" class="ltx_text"></span><span id="S3.T1.5.1.4.1.2" class="ltx_text">
