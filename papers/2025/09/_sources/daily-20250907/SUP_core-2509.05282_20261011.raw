<td id="S3.T1.5.1.5.2" class="ltx_td ltx_align_center ltx_border_r"><math id="S3.T1.m29" class="ltx_Math" alttext="\lambda_{t}^{j}=\mathrm{sigmoid}\left(-\mathbf{f}_{t}^{j}\right)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>j</mi></msubsup><mo>=</mo><mrow><mi>sigmoid</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><msubsup><mi>𝐟</mi><mi>t</mi><mi>j</mi></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{t}^{j}=\mathrm{sigmoid}\left(-\mathbf{f}_{t}^{j}\right)</annotation></semantics></math></td>
