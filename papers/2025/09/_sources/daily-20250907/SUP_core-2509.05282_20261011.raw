<td id="S3.T1.5.1.7.2" class="ltx_td ltx_align_center ltx_border_r"><math id="S3.T1.m32" class="ltx_Math" alttext="\lambda_{t}^{j}=\lambda^{j}+(1-\lambda^{j})\mathrm{sigmoid}(\mathbf{f}_{t}^{j})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>j</mi></msubsup><mo>=</mo><mrow><msup><mi>λ</mi><mi>j</mi></msup><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msup><mi>λ</mi><mi>j</mi></msup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>sigmoid</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐟</mi><mi>t</mi><mi>j</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda_{t}^{j}=\lambda^{j}+(1-\lambda^{j})\mathrm{sigmoid}(\mathbf{f}_{t}^{j})</annotation></semantics></math></td>
