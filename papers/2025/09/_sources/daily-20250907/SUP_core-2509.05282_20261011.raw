<td id="S3.T1.5.1.7.5" class="ltx_td ltx_align_center"><math id="S3.T1.m33" class="ltx_Math" alttext="\mathbf{s}_{t}^{j}=\mathrm{diag}(\lambda_{t}^{j})\mathbf{s}_{t-1}^{j}+(1-\lambda_{t}^{j})(\mathbf{v}_{t}^{j})^{\top}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐬</mi><mi>t</mi><mi>j</mi></msubsup><mo>=</mo><mrow><mrow><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>λ</mi><mi>t</mi><mi>j</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐬</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mi>j</mi></msubsup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msubsup><mi>λ</mi><mi>t</mi><mi>j</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐯</mi><mi>t</mi><mi>j</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{s}_{t}^{j}=\mathrm{diag}(\lambda_{t}^{j})\mathbf{s}_{t-1}^{j}+(1-\lambda_{t}^{j})(\mathbf{v}_{t}^{j})^{\top}</annotation></semantics></math></td></tr>
