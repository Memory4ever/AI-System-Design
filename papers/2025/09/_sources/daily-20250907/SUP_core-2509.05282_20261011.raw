<span id="S3.T1.5.1.5.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left">wo <math id="S3.T1.m27" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math> &amp; <math id="S3.T1.m28" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></span></span>
