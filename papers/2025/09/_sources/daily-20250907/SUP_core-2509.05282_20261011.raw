<td id="S3.T1.5.1.6.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S3.T1.m30" class="ltx_Math" alttext="\lambda_{t}^{j}=\mathrm{sigmoid}(\mathbf{f}_{t}^{j})^{1/\tau}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mi>t</mi><mi>j</mi></msubsup><mo>=</mo><mrow><mi>sigmoid</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐟</mi><mi>t</mi><mi>j</mi></msubsup><mo stretchy="false">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mi>τ</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\lambda_{t}^{j}=\mathrm{sigmoid}(\mathbf{f}_{t}^{j})^{1/\tau}</annotation></semantics></math></td>
