<span id="alg1.l2.3.1" class="ltx_p"><math id="alg1.l2.m1" class="ltx_Math" alttext="M_{best}\leftarrow M_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">←</mo><msub><mi>M</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">M_{best}\leftarrow M_{0}</annotation></semantics></math>, <math id="alg1.l2.m2" class="ltx_Math" alttext="acc_{best}\leftarrow acc_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">←</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">acc_{best}\leftarrow acc_{0}</annotation></semantics></math>, <math id="alg1.l2.m3" class="ltx_Math" alttext="params_{best}\leftarrow\text{Params}(M_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">←</mo><mrow><mtext>Params</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">params_{best}\leftarrow\text{Params}(M_{0})</annotation></semantics></math>, <math id="alg1.l2.m4" class="ltx_Math" alttext="lat_{best}\leftarrow lat_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">←</mo><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">lat_{best}\leftarrow lat_{0}</annotation></semantics></math></span>
</span>
</div>
