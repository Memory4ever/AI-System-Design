<span id="alg1.l12.3.1" class="ltx_p">Save and <span id="alg1.l12.3.1.1" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l12.m1" class="ltx_Math" alttext="M_{best},R_{best},E_{best}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>R</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi>E</mi><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">M_{best},R_{best},E_{best}</annotation></semantics></math></span>
</span>
</div>
