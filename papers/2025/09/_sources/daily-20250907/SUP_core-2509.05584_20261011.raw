<span id="alg1.l1.3" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:345.0pt;">
<span id="alg1.l1.3.1" class="ltx_p">Evaluate <math id="alg1.l1.m1" class="ltx_Math" alttext="M_{0}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mn>0</mn></msub><annotation encoding="application/x-tex">M_{0}</annotation></semantics></math>: <math id="alg1.l1.m2" class="ltx_Math" alttext="(lat_{0},acc_{0})\leftarrow\text{Evaluate}(M_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>t</mi><mn>0</mn></msub></mrow><mo>,</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><mtext>Evaluate</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(lat_{0},acc_{0})\leftarrow\text{Evaluate}(M_{0})</annotation></semantics></math></span>
