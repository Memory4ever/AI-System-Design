<td id="S5.T1.6.5.2" class="ltx_td ltx_align_left" style="padding:0.7pt 4.0pt;"><span id="S5.T1.6.5.2.1" class="ltx_text" style="font-size:90%;">v2.0.12</span></td>
<td id="S5.T1.6.5.3" class="ltx_td ltx_align_left" style="padding:0.7pt 4.0pt;"><span id="S5.T1.6.5.3.1" class="ltx_text" style="font-size:90%;">IDE</span></td>
<td id="S5.T1.6.5.4" class="ltx_td ltx_align_center" style="padding:0.7pt 4.0pt;"><math id="S5.T1.m5" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S5.T1.6.5.5" class="ltx_td ltx_align_center" style="padding:0.7pt 4.0pt;"><span id="S5.T1.6.5.5.1" class="ltx_text" style="font-size:90%;">✓</span></td>
<td id="S5.T1.6.5.6" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.7pt 4.0pt;"><span id="S5.T1.6.5.6.1" class="ltx_text" style="font-size:90%;">✓</span></td></tr>
<tr id="S5.T1.6.6" class="ltx_tr">
<td id="S5.T1.6.6.1" class="ltx_td ltx_align_left" style="padding:0.7pt 4.0pt;"><span id="S5.T1.6.6.1.1" class="ltx_text" style="font-size:90%;">WindSurf<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite></span></td>
<td id="S5.T1.6.6.2" class="ltx_td ltx_align_left" style="padding:0.7pt 4.0pt;"><span id="S5.T1.6.6.2.1" class="ltx_text" style="font-size:90%;">v1.12.2</span></td>
