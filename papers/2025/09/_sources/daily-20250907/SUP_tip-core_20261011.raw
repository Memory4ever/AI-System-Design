<td id="S7.T4.6.3.2" class="ltx_td ltx_align_center"><math id="S7.T4.m5" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
