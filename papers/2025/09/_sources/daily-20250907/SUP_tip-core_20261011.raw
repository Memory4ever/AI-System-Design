<td id="S5.T1.6.3.6" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.7pt 4.0pt;"><span id="S5.T1.6.3.6.1" class="ltx_text" style="font-size:90%;">✓</span></td></tr>
