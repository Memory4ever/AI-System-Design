<td id="S5.T1.6.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.7pt 4.0pt;"><span id="S5.T1.6.2.4.1" class="ltx_text" style="font-size:90%;">✓</span></td>
