<td id="S7.T4.6.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S7.T4.6.1.2.1" class="ltx_text ltx_font_bold">DoS Defense</span></td>
<td id="S7.T4.6.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S7.T4.6.1.3.1" class="ltx_text ltx_font_bold">RCE Defense</span></td></tr>
<tr id="S7.T4.6.2" class="ltx_tr">
<td id="S7.T4.6.2.1" class="ltx_td ltx_align_left ltx_border_t">Cherry Studio</td>
<td id="S7.T4.6.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S7.T4.m3" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S7.T4.6.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S7.T4.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td></tr>
