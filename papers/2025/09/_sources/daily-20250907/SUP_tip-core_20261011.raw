<td id="S5.T1.6.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding:0.7pt 4.0pt;"><span id="S5.T1.6.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Version</span></td>
