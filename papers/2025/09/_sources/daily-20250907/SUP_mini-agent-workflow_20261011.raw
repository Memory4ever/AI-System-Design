=\"ask-ai\"],\n[class*=\"AskAI\"],\nbutton[aria-label*=\"Ask AI\"] {\n  display: none !important;\n}\n\narticle h2 {\n  display: inline-block;\n  padding: 2px 14px;\n  border-radius: 16px;\n  background-color: #EBF5FF;\n  color: #0969DA;\n  font-size: 14px;\n  font-weight: 500;\n  border: 1px solid #B6D4FE;\n  margin-top: 2rem;\n}\n\n/* techblog 索引页:日期 H2 不要 chip 样式,改为分组分隔的小标题 */\narticle .techblog-list h2,\n.techblog-list h2 {\n  display: block !important;\n  background-color: transparent !important;\n  border: none !important;\n  border-top: 1px solid #E5E7EB !important;\n  border-radius: 0 !important;\n  padding: 2rem 0 0 0 !important;\n  color: #374151 !important;\n  font-size: 16px !important;\n  font-weight: 500 !important;\n  margin-top: 2.5rem !important;\n  margin-bottom: 0.5rem !important;\n}\n\n/* 第一个日期保留顶部线,作为引导语和文章列表的分隔 */\n.techblog-list h2:first-of-type {\n  margin-top: 2.5rem !important;\n}\n\n.dark .techblog-list h2 {\n  color: #E5E7EB !important;\n  border-top-color: #374151 !important;\n}\n\n/* 减少 TOC 点击时的\"抽搐\":让滚动停在留白位置而不是顶到边 */\n.techblog-list h2,\n.techblog-list h3 {\n  scroll-margin-top: 80px;\n}\n\n#footer a[href*=\"mintlify\"],\n[class*=\"attribution\"],\nfooter a[href*=\"mintlify\"] {\n  display: none !important;\n}\n\nimg {\n  max-width: 100%;\n  height: auto;\n  object-fit: contain;\n}\n\n@media (min-width: 1024px) {\n  #sidebar {\n    top: max(\n      calc(var(--mintlify-slot-header-height, 7rem) + var(--banner-height, 0px)),\n      5rem\n    ) !important;\n  }\n}\n\n@media (max-width: 1023px) {\n  #sidebar \u003e div:first-child,\n  #sidebar-content \u003e div:first-child {\n    padding-top: 16px !important;\n  }\n}\n\n.code-docs h2,\n.code-docs h3 {\n  display: block !important;\n  padding: 0 !important;\n  border-radius: 0 !important;\n  background-color: transparent !important;\n  color: inherit !important;\n  border: none !important;\n}\n\n.code-image-placeholder {\n  border: 1px dashed #CBD5E1;\n  border-radius: 8px;\n  padding: 16px;\n  background: #F8FAFC;\n  color: #475569;\n  font-size: 14px;\n  line-height: 22px;\n  margin: 16px 0 24px;\n}\n\n.dark .code-image-placeholder {\n  border-color: #475569;\n  background: #111827;\n  color: #CBD5E1;\n}\n\n.code-screenshot {\n  display: block;\n  width: 100%;\n  margin: 16px 0 24px;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  background: #FFFFFF;\n}\n\n.dark .code-screenshot {\n  border-color: #334155;\n  background: #0F172A;\n}\n\n.code-community-panel {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 180px;\n  gap: 24px;\n  align-items: center;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  padding: 20px;\n  margin: 16px 0 8px;\n  background: #FFFFFF;\n}\n\n.code-community-panel p {\n  margin-bottom: 0;\n}\n\n.code-qr-placeholder {\n  display: flex;\n  min-height: 180px;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  border: 1px dashed #CBD5E1;\n  border-radius: 8px;\n  background: #F8FAFC;\n  color: #334155;\n  text-align: center;\n}\n\n.code-qr-placeholder small {\n  max-width: 140px;\n  color: #64748B;\n  font-size: 12px;\n  line-height: 18px;\n}\n\n.code-community-qr {\n  display: block;\n  width: 180px;\n  max-width: 100%;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  background: #FFFFFF;\n}\n\n.dark .code-community-panel {\n  border-color: #334155;\n  background: #0F172A;\n}\n\n.dark .code-qr-placeholder {\n  border-color: #475569;\n  background: #111827;\n  color: #CBD5E1;\n}\n\n.dark .code-qr-placeholder small {\n  color: #94A3B8;\n}\n\n@media (max-width: 640px) {\n  .code-community-panel {\n    grid-template-columns: 1fr;\n  }\n\n  .code-qr-placeholder {\n    min-height: 220px;\n  }\n}\n\nbody:has(.question-standalone-marker) header,\nbody:has(.question-standalone-marker) #navbar,\nbody:has(.question-standalone-marker) #sidebar,\nbody:has(.question-standalone-marker) #sidebar-content,\nbody:has(.question-standalone-marker) footer,\nbody:has(.ques