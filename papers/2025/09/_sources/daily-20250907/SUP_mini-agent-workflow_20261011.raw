multi-agent system.';\n\n  const baseCount = 32182;\n  const startDate = new Date('2024-01-01').getTime();\n  const today = new Date().getTime();\n  const daysSinceStart = Math.floor((today - startDate) / (1000 * 60 * 60 * 24));\n  const dateNum = parseInt(new Date().toISOString().slice(0, 10).replace(/-/g, ''), 10);\n  const dailyIncrement = 50 + (dateNum % 40);\n  const ratingCount = baseCount + Math.floor(daysSinceStart * (dailyIncrement - 20));\n\n  const schema = {\n    '@context': 'https://schema.org',\n    '@graph': [\n      {\n        '@type': 'SoftwareApplication',\n        '@id': PRODUCT_URL + '/#softwareapplication',\n        name: PRODUCT_NAME,\n        url: PRODUCT_URL,\n        operatingSystem: 'Web, Windows, Mac, iOS, Android',\n        applicationCategory: 'ProductivityApplication',\n        aggregateRating: {\n          '@type': 'AggregateRating',\n          ratingValue: 4.9,\n          bestRating: 5,\n          ratingCount: ratingCount,\n        },\n        offers: {\n          '@type': 'Offer',\n          price: '0',\n          priceCurrency: 'USD',\n        },\n        logo: {\n          '@type': 'ImageObject',\n          '@id': PRODUCT_URL + '/#/schema/logo/image',\n          inLanguage: LANGUAGE,\n          url: LOGO_URL,\n          contentUrl: LOGO_URL,\n          caption: PRODUCT_NAME,\n        },\n        mainEntityOfPage: {\n          '@type': 'WebPage',\n          '@id': PRODUCT_URL + '/#webpage',\n        },\n        creator: {\n          '@type': 'Organization',\n          name: 'MiniMax',\n          url: MINIMAX_URL,\n        },\n        features: [\n          'Full-Stack Web App Development',\n          'PPT \u0026 Presentation Generation',\n          'Deep Research \u0026 Analysis',\n          'Browser Automation',\n          'Code Generation',\n          'MCP Ecosystem Integration',\n          'Multimodal Content Creation',\n        ],\n      },\n      {\n        '@type': 'WebSite',\n        '@id': PRODUCT_URL + '/#website',\n        url: PRODUCT_URL,\n        name: PRODUCT_NAME,\n        description: DESCRIPTION,\n        publisher: { '@id': PRODUCT_URL + '/#organization' },\n        inLanguage: LANGUAGE,\n        copyrightHolder: { '@id': PRODUCT_URL + '/#organization' },\n      },\n      {\n        '@type': 'WebPage',\n        '@id': PRODUCT_URL + '/#webpage',\n        url: window.location.href,\n        name: document.title,\n        about: { '@id': PRODUCT_URL + '/#organization' },\n        isPartOf: { '@id': PRODUCT_URL + '/#website' },\n        primaryImageOfPage: { '@id': PRODUCT_URL + '/#primaryimage' },\n        image: { '@id': PRODUCT_URL + '/#primaryimage' },\n        thumbnailUrl: LOGO_URL,\n        datePublished: new Date().toISOString(),\n        dateModified: new Date().toISOString(),\n        description: DESCRIPTION,\n        inLanguage: LANGUAGE,\n      },\n      {\n        '@type': 'ImageObject',\n        inLanguage: LANGUAGE,\n        '@id': PRODUCT_URL + '/#primaryimage',\n        url: LOGO_URL,\n        contentUrl: LOGO_URL,\n        width: 80,\n        height: 80,\n      },\n      {\n        '@type': 'BreadcrumbList',\n        '@id': PRODUCT_URL + '/#breadcrumb',\n        itemListElement: [\n          {\n            '@type': 'ListItem',\n            position: 1,\n            name: 'MiniMax Agent',\n            item: PRODUCT_URL,\n          },\n          {\n            '@type': 'ListItem',\n            position: 2,\n            name: document.title,\n            item: window.location.href,\n          },\n        ],\n      },\n      {\n        '@type': ['Organization', 'Brand'],\n        '@id': PRODUCT_URL + '/#organization',\n        name: PRODUCT_NAME,\n        legalName: PRODUCT_NAME,\n        url: PRODUCT_URL,\n        description: DESCRIPTION,\n        logo: {\n          '@type': 'ImageObject',\n          inLanguage: LANGUAGE,\n          '@id': PRODUCT_URL + '/#/schema/logo/image',\n        },\n        parentOrganization: {\n          '@type': ['Organization', 'Brand'],\n          name: 'MiniMax',\n          legalName: 'MiniMax',\n          url: MINIMAX_URL,\n          description: 'MiniMax is a leading general artificial intelligence technology company.',\n          logo: {\n            '@type': 'ImageObject',\n            inLanguage: LANGUAGE,\n            '@id': MINIMAX_URL + '/#schema/logo/image',\n            url: LOGO_URL,\n            contentUrl: LOGO_URL,\n            caption: 'MiniMax',\n          },\n          sameAs: [\n            'https://www.linkedin.com/company/minimax-ai/',\n            'https://en.wikipedia.org/wiki/MiniMax_(company)',\n            'https://x.com/MiniMax_AI',\n            'https://github.com/MiniMax-AI',\n            'https://discord.com/invite/hvvt8hAye6',\n          ],\n        },\n      },\n    ],\n  };\n\n  const script = document.createElement('script');\n  script.type = 'application/ld+json';\n  script.textContent = JSON.stringify(schema);\n  document.head.appendChild(script);\n})();\n"])</script><script>self.__next_f.push([1,"55:[\"$\",\"$L57\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"69c794007ba705a2811a3dae\",\"filePath\":\"scripts/seo-schema.js\",\"subdomain\":\"agent-en\",\"__v\":0,\"content\":\"$58\"}]}]\n5b:Tb891,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,blockquote:`blockquote`,code:`code`,li:`li`,ol:`ol`,p:`p`,pre:`pre`,span:`span`,strong:`strong`,ul:`ul`,..._provideComponents(),...props.components},{CodeBlock,Heading,OptimizedImage}=_components;if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!OptimizedImage)_missingMdxReference(`OptimizedImage`,true);return _jsxs(_Fragment,{children:[_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/cover.png?fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=caf1fc8a7146c0ea4d30b9644f56fb76`,alt:`Cover: you set the goal and the check, the spec is frozen, one agent builds and proves it, another model verifies, you read the decisions and merge`,\"data-og-width\":`2000`,width:`2000`,\"data-og-height\":`802`,height:`802`,\"data-path\":`images/techblog/coding-agent-workflow-and-skills/cover.png`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/cover.png?w=280\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=a3879cfae4405e9aaede952a0af8eeaf 280w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/cover.png?w=560\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=d688f36c76e7eeb9462ce8460f6f07bf 560w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/cover.png?w=840\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=c33da74e28a2315d9d54cc3878734636 840w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/cover.png?w=1100\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=3d4a67ece3ddef2dd392c07af614559f 1100w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/cover.png?w=1650\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=bd02540a8c63229e9a84b70e6aa4c8ca 1650w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/cover.png?w=2500\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=2550f52748ae8ca952f842c3b20a60f3 2500w`}),`\n`,_jsx(_components.p,{children:`I built an orchestrator to run coding agents in parallel. Then one eight-module job took 14 hours—and for about 76% of that time, only one CLI was working. I thought I needed more agents. The audit changed my mind.`}),`\n`,_jsx(_components.p,{children:`Here’s what went wrong, what I learned from OpenAI, Anthropic and Lauren Tan, and the workflow and three skills I use now.`}),`\n`,_jsx(Heading,{level:`2`,id:`where-i-started`,children:`Where I started`}),`\n`,_jsx(_components.p,{children:`I’m a backend engineer on MCode, MiniMax’s coding agent, which has a desktop app and a terminal UI. Nearly all my coding goes through agents, and MCode comes first: I work on it, so it’s what I use for my own work every day. I also keep Codex and Claude Code around, to cross-check work and see how they handle the same task.`}),`\n`,_jsx(_components.p,{children:`To get more done, I wrote Agent Lord, an orchestrator that lets one agent session hand work to others. From a Codex session, it split a feature into modules and sent each module to its own CLI, usually MCode, in its own git worktree. Modules that didn’t depend on each other ran at the same time. For reviews, two model families checked each other’s findings. At the end, an integrator merged everything. In the month I later measured, it dispatched 490 operations across 214 tasks.`}),`\n`,_jsx(_components.p,{children:`The bet was simple: more agents working at once, more work done.`}),`\n`,_jsx(_components.p,{children:`By mid-September it didn’t feel that way. Here’s what I typed to my agents in a single day:`}),`\n`,_jsxs(_components.blockquote,{children:[`\n`,_jsx(_components.p,{children:`“This is so tedious. Everything takes forever to build.”`}),`\n`]}),`\n`,_jsxs(_components.blockquote,{children:[`\n`,_jsx(_components.p,{children:`“Do we really need this many tickets? Can’t we merge some?”`}),`\n`]}),`\n`,_jsxs(_components.blockquote,{children:[`\n`,_jsx(_components.p,{children:`“It’s been reading for an hour.”`}),`\n`]}),`\n`,_jsxs(_components.blockquote,{children:[`\n`,_jsx(_components.p,{children:`“Why not send out more agents? If they don’t depend on each other, why can’t they all go at once?”`}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`more-agents-weren’t-the-answer`,children:`More agents weren’t the answer`}),`\n`,_jsx(_components.p,{children:`That last message was what I believed at the time: the fix was more parallelism. So after Agent Lord spent a night building a new version of MCode’s Goal feature in eight modules, I had an agent audit the run and tell me why so little of it ran in parallel.`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`At most four CLIs ran at once; the average was 1.27.`}),`\n`,_jsx(_components.li,{children:`Agent Lord didn’t cap parallelism. The plan did: the modules formed a chain, and each one waited for the one before it to be delivered.`}),`\n`,_jsx(_components.li,{children:`Waiting didn’t even help. A downstream module still started from the original code, so it couldn’t see what its upstream had just written. It coded against stubs, and the real pieces met for the first time at the final merge.`}),`\n`,_jsx(_components.li,{children:`Inside each CLI, most of the time went to waiting on the model, usually with one tool call per turn. One module made 91 round trips, about 56 minutes, before it wrote its first file.`}),`\n`]}),`\n`,_jsx(_components.p,{children:`Adding agents wouldn’t have fixed that dependency chain or made upstream code available downstream. It would have left me with more output to check and more handoffs where things could get lost.`}),`\n`,_jsx(Heading,{level:`2`,id:`what-was-actually-wrong`,children:`What was actually wrong`}),`\n`,_jsx(_components.p,{children:`The next day I had agents go through every session from the previous 30 days, about 1,700 across MCode, Codex and Claude Code, to see whether that run was a one-off. They read 40 task chains closely and checked the quotes against the raw logs. It wasn’t a one-off. Two problems ran through the whole month.`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Bugs showed up late, and I was the one who found them.`}),` The agent said it was done and the tests passed. The problem appeared when I used the feature myself, or when the pieces were wired together.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`The agent marked two PRs for the Goal feature done, tests green. I ran the dev build. If I updated the goal while the agent was waiting on background work, it never picked the work back up.`}),`\n`,_jsx(_components.li,{children:`The status bar said reasoning effort was xhigh. The session actually ran at medium, because new sessions never passed the setting through.`}),`\n`,_jsx(_components.li,{children:`Every module of the Goal rework was delivered, and the feature still wasn’t turned on in the default production setup.`}),`\n`]}),`\n`,_jsx(_components.p,{children:`Each piece passed its own tests. What broke was the wiring between pieces and the path a user actually takes.`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`A lot of my time went into relaying decisions to agents.`}),` I re-explained decisions I’d already made, checked whether an agent had stalled, and told it to keep going. Decisions didn’t survive the handoffs.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`I settled MCode’s four sandbox permission levels in August. In September I was still telling agents: four levels, no extra protections.`}),`\n`,_jsx(_components.li,{children:`My main session handed a plan to another CLI for cross-review and added “keep it concise” on its own. The 875-line plan was replaced by a 279-line one that had lost the file-by-file migration table, the interfaces, the wiring steps and the acceptance checks.`}),`\n`,_jsx(_components.li,{children:`I asked for a PR based on the latest integration branch. It was opened against a feature branch, and fixing it meant a rebase and three merge conflicts.`}),`\n`]}),`\n`,_jsx(_components.p,{children:`Put the two together and you get the real problem. Writing code isn’t the scarce part anymore; agents can do most of it. What’s scarce now is decision-making, and the decisions still fell to me. I had become the bottleneck in getting a feature delivered: switching from one feature’s context to another’s, making a call, switching again, until my attention ran out. The work was waiting on me, not on the agents.`}),`\n`,_jsx(_components.p,{children:`In the sessions I audited, two gaps in my setup kept showing up: the agents couldn’t operate the product they were building, and decisions I’d already made didn’t reliably survive handoffs. Checking the product and repeating those decisions both landed on me. More parallel work put more of both on my plate.`}),`\n`,_jsx(Heading,{level:`2`,id:`how-i-picked-the-three-sources`,children:`How I picked the three sources`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig0-research.png?fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=887b034e9bee1f2d5585db043f32237f`,alt:`How I picked the sources: my own sessions, then Lauren Tan, then 75 sources sorted into five schools, then three picked, then the originals re-read`,\"data-og-width\":`2000`,width:`2000`,\"data-og-height\":`1494`,height:`1494`,\"data-path\":`images/techblog/coding-agent-workflow-and-skills/fig0-research.png`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig0-research.png?w=280\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=b7b3dc53054308ccc0b0a8155290fc7e 280w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig0-research.png?w=560\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=2222be6e513f0734aaa3203671491734 560w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig0-research.png?w=840\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=91f24c933ebe2d67cdc069edc3d7677d 840w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig0-research.png?w=1100\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=4a8313e61eca69407f435eeb44cb7d79 1100w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig0-research.png?w=1650\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=bf226312259f5a5f85388c2bcf1cb660 1650w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig0-research.png?w=2500\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=1a7e7e9ff1eeab69f2ccaf757f1defc6 2500w`}),`\n`,_jsxs(_components.p,{children:[`I started with `,_jsx(_components.strong,{children:`Lauren Tan`}),`. Her 2,000 PRs in a month made me want to understand her setup. In her talk, she wanted an agent that could “run the application itself and take the traces for me.” Her warning about scaling to a hundred agents matched my audit: it fails “because you don’t have trust in your agent’s work yet.” (`,_jsx(_components.a,{href:`https://x.com/poteto/status/2102050467505430555`,children:`talk`}),`, at 4:00 and 6:24)`]}),`\n`,_jsx(_components.p,{children:`I widened the search to engineering teams, agent builders and research studies. Some approaches used fixed pipelines; others emphasized specs, task trackers or larger agent teams. The approach that most directly addressed my two problems was to give one agent ownership, let it run the real product, and preserve its progress in files.`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`OpenAI, Anthropic and Lauren`}),` gave me concrete mechanisms for that. OpenAI and Anthropic build the models I use every day and the coding agents around them; Lauren brought experience applying these ideas to a production codebase. All three publish enough to inspect: pstack’s source, OpenAI’s ExecPlan format, and Anthropic’s prompts and accounts of what failed.`]}),`\n`,_jsx(_components.p,{children:`I took their mechanisms, not their throughput claims. Lauren’s PR count, like the other throughput figures, is self-reported. The quotes below link to the live sources and were checked against saved copies.`}),`\n`,_jsxs(_components.p,{children:[`Out of all this came one idea: `,_jsx(_components.strong,{children:`the agent proves its own work on the real product, and someone other than the author checks the proof.`}),` I define the work at the start and review the decisions at the end. In between, I automate as much as I can, so I step in and decide as little as possible. I turned it into three skills, published in `,_jsx(_components.a,{href:`https://github.com/coder-xieshijie/dev-skills`,children:`dev-skills`}),`. They run in MCode, Claude Code and Codex.`]}),`\n`,_jsx(Heading,{level:`2`,id:`the-workflow-at-a-glance`,children:`The workflow at a glance`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig1-workflow.png?fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=a577941031b8520825da46e5e2f353e2`,alt:`The workflow: you, the owner agent and another model family across phases A to D, with your three touchpoints`,\"data-og-width\":`2000`,width:`2000`,\"data-og-height\":`1818`,height:`1818`,\"data-path\":`images/techblog/coding-agent-workflow-and-skills/fig1-workflow.png`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig1-workflow.png?w=280\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=e7684dd9ee4db89249b79037589bb111 280w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig1-workflow.png?w=560\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=591494d4fee163bc0c19e63c6c7816e8 560w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig1-workflow.png?w=840\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=2ede2b829cc5872dbb2d3cc84095cd9b 840w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig1-workflow.png?w=1100\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=bc1592c161f0bb2e6b1f745131d3a55f 1100w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig1-workflow.png?w=1650\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=5bec1a01d115c55af9cb4a2f19c74cd0 1650w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig1-workflow.png?w=2500\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=ded9f96ed8b2cbf868e045998459cbf3 2500w`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`A. Make the app drivable (once per repo).`}),` Give the agent commands to start and operate the app, a feature map, smoke tests, and quality checks. This is Lauren’s verification-skill idea. Each app needs its own setup; dev-skills doesn’t ship it.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`B. Define (you and the agent).`}),` `,_jsx(_components.code,{children:`core-grill`}),` clarifies the request; `,_jsx(_components.code,{children:`core-spec`}),` records the decisions and how to verify them. Another model family checks for gaps. I confirm the files, which are frozen on a feature branch with a draft PR.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`C. Deliver (the agent alone).`}),` In a new session I run `,_jsx(_components.code,{children:`/deliver \u003cdraft PR link\u003e`}),`. One owner builds and tests the feature, coordinates independent checks, and handles CI and review until the PR is mergeable. It pauses before irreversible actions and records its decisions for me to review.`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`D. Feed back.`}),` The PR lists gaps this run exposed in the repo. I decide which fixes belong in the repo’s tools and which belong in the skills.`]}),`\n`,_jsx(_components.p,{children:`My part comes down to three touchpoints: answer the questions, confirm spec.md and verify.md, then read the decision list and merge.`}),`\n`,_jsx(Heading,{level:`2`,id:`the-three-skills`,children:`The three skills`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig2-artifacts.png?fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=54464b7a358a22ad0f6a860600ec7af2`,alt:`What each skill takes in and hands on: requirement, core-grill, decision summary, core-spec, frozen spec and verify, draft PR, deliver, plan.md and evidence, mergeable PR`,\"data-og-width\":`2000`,width:`2000`,\"data-og-height\":`1292`,height:`1292`,\"data-path\":`images/techblog/coding-agent-workflow-and-skills/fig2-artifacts.png`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig2-artifacts.png?w=280\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=0076a07aaa683671f72e6f02d0031e00 280w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig2-artifacts.png?w=560\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=5ac82d5f24a53298017d0a071e091f6b 560w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig2-artifacts.png?w=840\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=6f1177a6cc8ed229b17db47b807da2f9 840w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig2-artifacts.png?w=1100\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=3ea30599eb307e72da9110499fddc986 1100w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig2-artifacts.png?w=1650\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=8d7d23a001fa24d48bc5f0ad4e8c8e42 1650w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig2-artifacts.png?w=2500\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=69b48a7323ccc5f7ce226ce00098d7a6 2500w`}),`\n`,_jsx(Heading,{level:`3`,id:`core-grill-ask-only-about-what-users-will-see`,children:`core-grill: ask only about what users will see`}),`\n`,_jsx(_components.p,{children:`It starts with the request, the goal, what “done” means, and what it’s allowed to do. If the repo can answer a question, it looks there first.`}),`\n`,_jsx(_components.p,{children:`It asks me about choices that change what users see: behavior, copy, defaults, entry points and whether data can be lost. Each question includes options, consequences and a recommendation. It handles implementation choices itself and records the defaults. I confirm the resulting decision summary.`}),`\n`,_jsx(Heading,{level:`3`,id:`core-spec-two-files-checked-by-another-model-then-frozen`,children:`core-spec: two files, checked by another model, then frozen`}),`\n`,_jsxs(_components.p,{children:[`It turns that summary into `,_jsx(_components.code,{children:`spec.md`}),` (what we decided) and `,_jsx(_components.code,{children:`verify.md`}),` (how to prove it).`]}),`\n`,_jsx(_components.p,{children:`The useful part is writing the checks before the code. Each scenario follows a complete user action from a real entry point and says what should happen on the old code. If that baseline wouldn’t expose the risk, it also describes a wrong implementation the check must reject. This forces gaps in the spec to surface early.`}),`\n`,_jsxs(_components.p,{children:[`Another model family reviews both files in a fresh, read-only session, without the author’s reasoning. If that reviewer is unavailable, the files don’t get frozen. Once the gaps are resolved and I confirm, both files are frozen and committed, and a draft PR is opened. That link is all `,_jsx(_components.code,{children:`deliver`}),` needs.`]}),`\n`,_jsx(Heading,{level:`3`,id:`deliver-one-owner-until-the-pr-is-mergeable`,children:`deliver: one owner until the PR is mergeable`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig3-deliver.png?fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=8f1f1312abfea11de9ce65e277a13e95`,alt:`Inside deliver: check out the branch, then per milestone implement, run scenarios, fresh subagent check; decisions go to another model family; final verification, check-delivery.mjs, mergeable PR`,\"data-og-width\":`2000`,width:`2000`,\"data-og-height\":`2164`,height:`2164`,\"data-path\":`images/techblog/coding-agent-workflow-and-skills/fig3-deliver.png`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig3-deliver.png?w=280\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=378b9138d3084cc3c43642539aef06a3 280w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig3-deliver.png?w=560\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=6f25762f041b803a25a4dce66ade93cb 560w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig3-deliver.png?w=840\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=23d7a2f5e1fa55d495471e5bad8fddc0 840w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig3-deliver.png?w=1100\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=c2c24e491730235f8547ab4aa968532d 1100w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig3-deliver.png?w=1650\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=7601af74bd01766a1c72a7912a346844 1650w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig3-deliver.png?w=2500\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=bafe2bb3161572c9e6bd1ae0c9dab80c 2500w`}),`\n`,_jsxs(_components.p,{children:[`The owner keeps a living `,_jsx(_components.code,{children:`plan.md`}),` in OpenAI’s ExecPlan format, committed with the code so a new session can pick up the work.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Build and prove each milestone.`}),` Implement it, run its scenarios on the real app, fix failures, then have a fresh subagent check it against the spec.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Get another model’s view on decisions.`}),` For choices affecting users or how a check is judged, consult another model family without sharing the owner’s preference. Then decide and continue.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Make those decisions reviewable.`}),` Put them at the top of the PR, including gaps, deviations in verification and anything unfinished. Each entry says what must be redone if I overturn it. The frozen spec and verify files stay unchanged.`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Get independent final verification.`}),` Another model family checks the final code in its own session and app instance. The owner addresses its code-quality notes or explains why it didn’t.`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`The owner continues until the PR is mergeable, pausing before irreversible actions such as merging, force-pushing a shared branch or changing a shared environment.`}),`\n`,_jsx(Heading,{level:`2`,id:`who-checks-what`,children:`Who checks what`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig4-checks.png?fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=ed78a6d777f4a80942a2f62e8f91765b`,alt:`Who checks what: gap check before freeze, fresh subagent per milestone, another model family for decisions and final verification, check-delivery.mjs as the final gate, you before merge`,\"data-og-width\":`2000`,width:`2000`,\"data-og-height\":`1008`,height:`1008`,\"data-path\":`images/techblog/coding-agent-workflow-and-skills/fig4-checks.png`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig4-checks.png?w=280\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=6f3074060872ebc1a77bcb7a76501979 280w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig4-checks.png?w=560\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=422345c45c8e499af19d6d8e1eb2ab8d 560w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig4-checks.png?w=840\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=d61e2ccfc664b55cd686fd3340adac41 840w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig4-checks.png?w=1100\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=4d8d20ce747abcdadc4432409a99e799 1100w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig4-checks.png?w=1650\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=730fba923a20ed356e5e96cd103a3047 1650w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig4-checks.png?w=2500\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=0550f878192ab4e1dd4710ba68b82e8c 2500w`}),`\n`,_jsxs(_components.p,{children:[`The owner tests its own work throughout; final acceptance requires an independent verifier. `,_jsx(_components.code,{children:`check-delivery.mjs`}),` enforces four conditions:`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`spec.md and verify.md are still the versions I confirmed;`}),`\n`,_jsx(_components.li,{children:`the verification report covers the code being merged;`}),`\n`,_jsx(_components.li,{children:`the verdict is PASS;`}),`\n`,_jsx(_components.li,{children:`the verifier comes from a different model family than the owner.`}),`\n`]}),`\n`,_jsx(Heading,{level:`2`,id:`the-seven-principles`,children:`The seven principles`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig5-principles.png?fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=950cb087d788c3cd178a1f2ed912661a`,alt:`Seven principles, with what OpenAI, Anthropic and Lauren Tan say about each, and where each lives in dev-skills`,\"data-og-width\":`2000`,width:`2000`,\"data-og-height\":`1232`,height:`1232`,\"data-path\":`images/techblog/coding-agent-workflow-and-skills/fig5-principles.png`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig5-principles.png?w=280\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=95680cdd4941c42385fb43840d022dc6 280w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig5-principles.png?w=560\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=1738e6e39a2b19eccbcde615d6e8bf0c 560w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig5-principles.png?w=840\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=f1ada8eb8bd89b34f323a40c26c39cba 840w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig5-principles.png?w=1100\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=837ba60a9ed9561996e944ca7c636f8c 1100w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig5-principles.png?w=1650\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=cabe561cdf44508c8a0d1112737127cd 1650w, https://mintcdn.com/agent-en/QyrUhc9mUtXpvlSD/images/techblog/coding-agent-workflow-and-skills/fig5-principles.png?w=2500\u0026fit=max\u0026auto=format\u0026n=QyrUhc9mUtXpvlSD\u0026q=85\u0026s=9ed3d10935d0f99d24071201c2eb601f 2500w`}),`\n`,_jsx(_components.p,{children:`For each one: what the three sources say, and where it lives in dev-skills.`}),`\n`,_jsx(Heading,{level:`3`,id:`1-you-set-the-goal-and-the-check-then-step-away`,children:`1. You set the goal and the check, then step away`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`OpenAI:`}),` “Humans steer. Agents execute.” (`,_jsx(_components.a,{href:`https://openai.com/index/harness-engineering/`,children:`Harness engineering`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Anthropic:`}),` “Give Claude a check it can run… It’s the difference between a session you watch and one you walk away from.” (`,_jsx(_components.a,{href:`https://code.claude.com/docs/en/best-practices`,children:`Claude Code best practices`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Lauren Tan:`}),` “Give the agent a goal and a way to check it, in your own words.” (`,_jsx(_components.a,{href:`https://github.com/cursor/plugins/blob/main/pstack/docs/guide/README.md`,children:`pstack guide`}),`)`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`Without a check it can run, the agent’s only signal is that the work looks done, and you become the test loop. In dev-skills this is phase B, taken one step further: verify.md is a full set of scenarios, written before any code, reviewed by another model, and frozen.`}),`\n`,_jsx(Heading,{level:`3`,id:`2-one-agent-owns-the-work-end-to-end`,children:`2. One agent owns the work end to end`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`OpenAI:`}),` in their own repo, given a single prompt, “the agent can now” go from reproducing a bug to merging the fix, and “escalate to a human only when judgment is required.” (`,_jsx(_components.a,{href:`https://openai.com/index/harness-engineering/`,children:`Harness engineering`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Anthropic:`}),` “A well-designed single agent with appropriate tools can accomplish far more than many developers expect.” (`,_jsx(_components.a,{href:`https://claude.com/blog/building-multi-agent-systems-when-and-how-to-use-them`,children:`Building multi-agent systems`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Lauren Tan:`}),` “Code-coupled work (one feature, one migration) goes to a single owner.” (`,_jsx(_components.a,{href:`https://github.com/cursor/plugins/tree/main/pstack/skills/poteto-mode`,children:`pstack playbooks`}),`)`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`Every handoff loses context; one stripped nearly 600 lines from my plan. In dev-skills this is `,_jsx(_components.code,{children:`deliver`}),`: the owner can hand coding, checks or scenario runs to subagents, but it integrates the work and makes the calls. That’s why I set Agent Lord aside. Work still happens in parallel, but one owner coordinates it.`]}),`\n`,_jsx(Heading,{level:`3`,id:`3-the-agent-can-run-operate-and-observe-the-real-product`,children:`3. The agent can run, operate and observe the real product`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`OpenAI:`}),` “we made the app bootable per git worktree, so Codex could launch and drive one instance per change.” (`,_jsx(_components.a,{href:`https://openai.com/index/harness-engineering/`,children:`Harness engineering`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Anthropic:`}),` left to itself, their agent passed unit tests without noticing the feature didn’t work end to end. It did much better once told to “do all testing as a human user would.” (`,_jsx(_components.a,{href:`https://www.anthropic.com/engineering/effective-harnesses-for-long-running-agents`,children:`Effective harnesses for long-running agents`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Lauren Tan:`}),` a verification skill is “critical infrastructure rather than ‘just’ a skill.” (`,_jsx(_components.a,{href:`https://x.com/poteto/status/2094457600259842065`,children:`The Complete Guide to pstack, Pt. 1`}),`)`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`Unit tests check the code you thought to test. Driving the real app also checks the wiring, the defaults and the entry points, which is where my late bugs came from. In dev-skills this is phase A, plus the scenarios in verify.md: each runs from the entry point the user actually uses and records what the old code does, which catches a check that could never fail.`}),`\n`,_jsx(Heading,{level:`3`,id:`4-plans-and-progress-live-in-files-in-the-repo`,children:`4. Plans and progress live in files in the repo`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`OpenAI:`}),` “It should always be possible to restart from only the ExecPlan.” (`,_jsx(_components.a,{href:`https://developers.openai.com/cookbook/articles/codex_exec_plans`,children:`Using PLANS.md for multi-hour problem solving`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Anthropic:`}),` “compaction isn’t sufficient.” Each session starts by reading a progress file and the git log. (`,_jsx(_components.a,{href:`https://www.anthropic.com/engineering/effective-harnesses-for-long-running-agents`,children:`Effective harnesses`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Lauren Tan:`}),` “Read the prior trail, don’t redo it.” (`,_jsx(_components.a,{href:`https://github.com/cursor/plugins/tree/main/pstack/skills/poteto-mode`,children:`pstack playbooks`}),`)`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`If the state only lives in the chat, the next session has to guess. In dev-skills, `,_jsx(_components.code,{children:`deliver`}),` keeps plan.md in ExecPlan format, committed with the code. When an upstream API error killed one of my long-running deliveries in Claude Code, I picked it up in MCode: a fresh session read plan.md and the git history and found where it had stopped in under half an hour.`]}),`\n`,_jsx(Heading,{level:`3`,id:`5-someone-else-decides-whether-it’s-right`,children:`5. Someone else decides whether it’s right`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Anthropic:`}),` “Out of the box, Claude is a poor QA agent.” Their fix: “Separating the agent doing the work from the agent judging it proves to be a strong lever.” (`,_jsx(_components.a,{href:`https://www.anthropic.com/engineering/harness-design-long-running-apps`,children:`Harness design for long-running application development`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`OpenAI:`}),` “we’ve pushed almost all review effort towards being handled agent-to-agent.” (`,_jsx(_components.a,{href:`https://openai.com/index/harness-engineering/`,children:`Harness engineering`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Lauren Tan:`}),` “Run a unit’s verifier on a different model family from its worker.” (`,_jsx(_components.a,{href:`https://github.com/cursor/plugins/tree/main/pstack/skills`,children:`pstack skills`}),`)`]}),`\n`]}),`\n`,_jsx(_components.p,{children:`The author’s blind spots live in its context, and models from the same family tend to share them. dev-skills has three layers: a fresh subagent after each milestone, another model family for the gap check and the final verification, and me, reading the decision list before I merge. On my first real run, the first cross-family verification caught an issue that two rounds of same-model checks had missed.`}),`\n`,_jsx(Heading,{level:`3`,id:`6-when-the-agent-gets-stuck-fix-the-repo-not-the-prompt`,children:`6. When the agent gets stuck, fix the repo, not the prompt`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`OpenAI:`}),` “When the agent struggles, we treat it as a signal: identify what is missing—tools, guardrails, documentation—and feed it back into the repository.” (`,_jsx(_components.a,{href:`https://openai.com/index/harness-engineering/`,children:`Harness engineering`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Anthropic:`}),` CLAUDE.md instructions “are advisory,” while hooks “are deterministic and guarantee the action happens.” (`,_jsx(_components.a,{href:`https://code.claude.com/docs/en/best-practices`,children:`Claude Code best practices`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Lauren Tan:`}),` “The instruction is the symptom.” (`,_jsx(_components.a,{href:`https://github.com/cursor/plugins/tree/main/pstack/skills/principle-encode-lessons-in-structure`,children:`Encode Lessons in Structure`}),`)`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`A rule in a prompt is a request the next agent may skip; a rule in code runs every time. In dev-skills, two scripts enforce what must always hold: `,_jsx(_components.code,{children:`freeze.mjs`}),` pins spec.md and verify.md, and `,_jsx(_components.code,{children:`check-delivery.mjs`}),` gates the result. Phase D turns each run’s friction into repo tooling.`]}),`\n`,_jsx(Heading,{level:`3`,id:`7-add-complexity-only-when-it-pays-one-piece-at-a-time`,children:`7. Add complexity only when it pays, one piece at a time`}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Anthropic:`}),` they recommend “finding the simplest solution possible, and only increasing complexity when needed.” (`,_jsx(_components.a,{href:`https://www.anthropic.com/engineering/building-effective-agents`,children:`Building effective agents`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`OpenAI:`}),` “Prefer a narrow correction to accumulating universal rules for every observed example.” (`,_jsx(_components.a,{href:`https://github.com/openai/codex/blob/main/codex-rs/skills/src/assets/samples/skill-creator/SKILL.md`,children:`Codex skill-creator`}),`)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.strong,{children:`Lauren Tan:`}),` pstack PR #419 cut 19 instructions. “Each cut held up in A/B runs on tasks that exercise it, with and without the text.” (`,_jsx(_components.a,{href:`https://github.com/cursor/plugins/pull/419`,children:`PR #419`}),`)`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`I learned this one the hard way. After each trial run I added a rule and a script to check it. `,_jsx(_components.code,{children:`deliver`}),` went from 3 scripts to 11, and its instructions grew by about 70%. Then I cut back to 1 script and less than half the instructions. The whole arc took 32 versions of the workflow in four days.`]}),`\n`,_jsx(Heading,{level:`2`,id:`how-to-use-it`,children:`How to use it`}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`What you need`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:`Models from two families. I develop in MCode and hand the checks to Codex, a different model family from the one I run in MCode; Claude Code plus Codex works too. The gap check and the final verification must come from the family that didn’t do the work, through a CLI that’s installed and logged in.`}),`\n`,_jsxs(_components.li,{children:[`Node.js 24, git, and `,_jsx(_components.code,{children:`gh`}),` or `,_jsx(_components.code,{children:`glab`}),`.`]}),`\n`,_jsxs(_components.li,{children:[`An app the agent can start, operate and observe from a worktree (phase A). The `,_jsx(_components.a,{href:`https://github.com/coder-xieshijie/dev-skills/blob/main/docs/repository-readiness.md`,children:`repository readiness guide`}),` in dev-skills covers what that takes, and Lauren’s `,_jsx(_components.a,{href:`https://github.com/cursor/plugins/tree/main/pstack/skills/create-verification-skill`,children:`create-verification-skill`}),` is a good place to start.`]}),`\n`]}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Install`}),` by asking your agent. Paste this into MCode, Claude Code or Codex:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`5`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`5`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Install dev-skills for me: https://github.com/coder-xieshijie/dev-skills`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Follow the \"From a clone\" steps in its README for the agent you're running in.`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`If the dev-skills plugin is already installed, stop and tell me instead.`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`Then list the skills you linked.`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsx(_components.p,{children:`It clones the repo and links each skill into the folder your agent reads. To update later, ask it to pull the latest dev-skills. MCode is what I use every day, and the experience has been great. If you haven’t tried it yet, I’d really recommend it.`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.strong,{children:`Run`}),` it in the target repo:`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`6`,language:`text`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`text`,children:_jsxs(_components.code,{language:`text`,numberOfLines:`6`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`/core-grill The request is \u003clink or text\u003e. Put the docs in \u003cdir\u003e/.`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`/core-spec Write spec.md and verify.md from the decision summary.`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`# in a new session`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{children:`/deliver Take over \u003cdraft PR link\u003e.`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{})})]})})}),`\n`,_jsxs(_components.ol,{children:[`\n`,_jsx(_components.li,{children:`core-grill asks its questions. Answer them and confirm the decision summary.`}),`\n`,_jsx(_components.li,{children:`core-spec writes spec and verify and has the other family check them for gaps. Read the result and confirm. It freezes both files and opens a draft PR.`}),`\n`,_jsx(_components.li,{children:`deliver works until the PR is mergeable. Read the decision list at the top, then merge.`}),`\n`]}),`\n`,_jsxs(_components.p,{children:[`In Codex, write `,_jsx(_components.code,{children:`$`}),` instead of `,_jsx(_components.code,{children:`/`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`sources`,children:`Sources`}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`OpenAI`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`https://openai.com/index/harness-engineering/`,children:`Harness engineering: leveraging Codex in an agent-first world`}),`, Ryan Lopopolo (@_lopopolo)`]}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`https://developers.openai.com/cookbook/articles/codex_exec_plans`,children:`Using PLANS.md for multi-hour problem solving`}),` (ExecPlans)`]}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://github.com/openai/codex/blob/main/codex-rs/skills/src/assets/samples/skill-creator/SKILL.md`,children:`Codex skill-creator`})}),`\n`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Anthropic`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://www.anthropic.com/engineering/effective-harnesses-for-long-running-agents`,children:`Effective harnesses for long-running agents`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://www.anthropic.com/engineering/harness-design-long-running-apps`,children:`Harness design for long-running application development`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://www.anthropic.com/engineering/building-effective-agents`,children:`Building effective agents`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://claude.com/blog/building-multi-agent-systems-when-and-how-to-use-them`,children:`Building multi-agent systems: when and how to use them`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://code.claude.com/docs/en/best-practices`,children:`Claude Code best practices`})}),`\n`]}),`\n`,_jsx(_components.p,{children:_jsx(_components.strong,{children:`Lauren Tan (@poteto)`})}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://x.com/poteto/status/2094457600259842065`,children:`The Complete Guide to pstack, Pt. 1`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://github.com/cursor/plugins/blob/main/pstack/docs/guide/README.md`,children:`pstack guide`})}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`https://github.com/cursor/plugins/tree/main/pstack/skills`,children:`pstack skills and playbooks`}),`: poteto-mode (feature, orchestrate, session-pickup), principle-encode-lessons-in-structure, create-verification-skill`]}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://github.com/cursor/plugins/pull/419`,children:`pstack PR #419`})}),`\n`,_jsxs(_components.li,{children:[_jsx(_components.a,{href:`https://x.com/poteto/status/2102050467505430555`,children:`Her talk on X`}),` (September 2026)`]}),`\n`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"56:[\"$\",\"$L59\",null,{\"slug\":\"techblog/coding-agent-workflow-and-skills\",\"pageMetadata\":\"$33:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L5a\",null,{\"mdxSource\":{\"compiledSource\":\"$5b\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"title\":\"I stopped babysitting my coding agents. Here's the workflow.\",\"sidebarTitle\":\"I stopped babysitting my coding agents. Here's the workflow.\",\"description\":\"What an audit of my multi-agent setup changed, and how I now define, verify and deliver work with core-grill, core-spec and deliver.\",\"og:title\":\"I stopped babysitting my coding agents. Here's the workflow.\",\"og:description\":\"What an audit of my multi-agent setup changed, and how I now define, verify and deliver work with core-grill, core-spec and deliver.\",\"href\":\"/techblog/coding-agent-workflow-and-skills\"}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"agent.minimax.io/docs\"}]}]\n"])</script></body></html>