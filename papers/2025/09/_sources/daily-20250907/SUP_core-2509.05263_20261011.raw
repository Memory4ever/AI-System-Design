<tr id="S8.T8.3.1" class="ltx_tr">
<td id="S8.T8.3.1.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">
<span id="S8.T8.3.1.1.1" class="ltx_inline-block ltx_align_middle" style="width:68.3pt;">
<span id="S8.T8.3.1.1.1.1" class="ltx_p ltx_align_center"><span id="S8.T8.3.1.1.1.1.1" class="ltx_text ltx_font_bold">Methods</span></span>
</span></td>
<td id="S8.T8.3.1.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">
<span id="S8.T8.3.1.2.1" class="ltx_inline-block ltx_align_middle" style="width:199.2pt;">
<span id="S8.T8.3.1.2.1.1" class="ltx_p ltx_align_center"><span id="S8.T8.3.1.2.1.1.1" class="ltx_text ltx_font_bold">Prompt or Description</span></span>
</span></td>
