<td id="S5.T2.2.8.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.8.3.1" class="ltx_text" style="font-size:90%;">2</span></td>
<td id="S5.T2.2.8.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.8.4.1" class="ltx_text" style="font-size:90%;">D, H</span></td></tr>
<tr id="S5.T2.2.9" class="ltx_tr">
<td id="S5.T2.2.9.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r"><span id="S5.T2.2.9.1.1" class="ltx_text" style="font-size:90%;">Desert</span></td>
<td id="S5.T2.2.9.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.9.2.1" class="ltx_text" style="font-size:90%;">6</span></td>
<td id="S5.T2.2.9.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.9.3.1" class="ltx_text" style="font-size:90%;">3</span></td>
<td id="S5.T2.2.9.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.9.4.1" class="ltx_text" style="font-size:90%;">D, R, W</span></td></tr>
<tr id="S5.T2.2.10" class="ltx_tr">
<td id="S5.T2.2.10.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r"><span id="S5.T2.2.10.1.1" class="ltx_text" style="font-size:90%;">Forest</span></td>
<td id="S5.T2.2.10.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.10.2.1" class="ltx_text" style="font-size:90%;">18</span></td>
<td id="S5.T2.2.10.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.10.3.1" class="ltx_text" style="font-size:90%;">4</span></td>
<td id="S5.T2.2.10.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.10.4.1" class="ltx_text" style="font-size:90%;">D, R</span></td></tr>
<tr id="S5.T2.2.11" class="ltx_tr">
<td id="S5.T2.2.11.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r"><span id="S5.T2.2.11.1.1" class="ltx_text" style="font-size:90%;">Crops</span></td>
<td id="S5.T2.2.11.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.11.2.1" class="ltx_text" style="font-size:90%;">4</span></td>
<td id="S5.T2.2.11.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.11.3.1" class="ltx_text" style="font-size:90%;">4</span></td>
<td id="S5.T2.2.11.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.11.4.1" class="ltx_text" style="font-size:90%;">D, R</span></td></tr>
<tr id="S5.T2.2.12" class="ltx_tr">
<td id="S5.T2.2.12.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r"><span id="S5.T2.2.12.1.1" class="ltx_text" style="font-size:90%;">Snow Mountain</span></td>
<td id="S5.T2.2.12.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.12.2.1" class="ltx_text" style="font-size:90%;">3</span></td>
<td id="S5.T2.2.12.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.12.3.1" class="ltx_text" style="font-size:90%;">3</span></td>
<td id="S5.T2.2.12.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T2.2.12.4.1" class="ltx_text" style="font-size:90%;">D, R, Sl</span></td></tr>
<tr id="S5.T2.2.13" class="ltx_tr">
<td id="S5.T2.2.13.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t"><span id="S5.T2.2.13.1.1" class="ltx_text" style="font-size:90%;">Height Map</span></td>
<td id="S5.T2.2.13.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="2"><span id="S5.T2.2.13.2.1" class="ltx_text" style="font-size:90%;">N/A</span></td>
<td id="S5.T2.2.13.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T2.2.13.3.1" class="ltx_text" style="font-size:90%;">HM</span></td></tr>
