tColor" width="1.5" linecap="round" linejoin="round"></path></svg></button></div><div class="code-block-copy-button z-10 select-none" id="base-ui-_R_1uacpbb9qnpfb39p7b9snpfiutb_" data-base-ui-tooltip-trigger=""><button class="size-6.5 flex items-center justify-center rounded-md group/copy-button [.code-block:not(:has([data-fade-overlay]))_[data-floating-buttons]_&amp;]:bg-gray-100 dark:[.code-block:not(:has([data-fade-overlay]))_[data-floating-buttons]_&amp;]:bg-gray-800" data-testid="copy-code-button" aria-label="Copy the contents from the code block"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4 shrink-0 text-gray-400 group-hover/copy-button:text-gray-500 dark:text-white/40 dark:group-hover/copy-button:text-white/60"><path d="M14.25 5.25H7.25C6.14543 5.25 5.25 6.14543 5.25 7.25V14.25C5.25 15.3546 6.14543 16.25 7.25 16.25H14.25C15.3546 16.25 16.25 15.3546 16.25 14.25V7.25C16.25 6.14543 15.3546 5.25 14.25 5.25Z" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.80103 11.998L1.77203 5.07397C1.61003 3.98097 2.36403 2.96397 3.45603 2.80197L10.38 1.77297C11.313 1.63397 12.19 2.16297 12.528 3.00097" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></button><span role="status" class="sr-only"></span></div></div><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px;font-variant-ligatures:none;height:auto;background-color:#ffffff;--shiki-dark-bg:#0B0C0E" data-component-part="code-block-root" class="w-0 min-w-full max-w-full h-full dark:bg-codeblock text-sm leading-6 transition-[height] duration-300 ease-in-out code-block-background **:ring-0 **:outline-0 **:focus:ring-0 **:focus:outline-0 rounded-2xl bg-white"><div role="presentation" data-id="base-ui-_R_1icpbb9qnpfb39p7b9snpfiutb_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] py-3.5 px-4 overflow-y-hidden! base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-full! h-full children:my-0! children:shadow-none! children:bg-transparent!"><div class="font-mono whitespace-pre leading-6"><pre class="shiki shiki-themes github-light-default dark-plus" style="background-color:#ffffff;--shiki-dark-bg:#0B0C0E;color:#1f2328;--shiki-dark:#D4D4D4" language="shellscript"><code language="shellscript" numberOfLines="11"><span class="line"><span style="color:#6E7781;--shiki-dark:#6A9955"># mcode build, model, and config are pinned; every trial uses a fresh DATA_DIR.</span></span>
<span class="line"><span style="color:#6E7781;--shiki-dark:#6A9955"># RAW_DIR is a log directory outside the agent environment, owned by the Runner.</span></span>
<span class="line"><span style="color:#1F2328;--shiki-dark:#9CDCFE">MINIMAX_DATA_DIR</span><span style="color:#CF222E;--shiki-dark:#D4D4D4">=</span><span style="color:#0A3069;--shiki-dark:#CE9178">&quot;</span><span style="color:#1F2328;--shiki-dark:#9CDCFE">$DATA_DIR</span><span style="color:#0A3069;--shiki-dark:#CE9178">&quot;</span><span style="color:#953800;--shiki-dark:#DCDCAA"> mcode</span><span style="color:#0A3069;--shiki-dark:#CE9178"> exec</span><span style="color:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
<span class="line"><span style="color:#0550AE;--shiki-dark:#569CD6">  --cwd</span><span style="color:#0A3069;--shiki-dark:#CE9178"> &quot;</span><span style="color:#1F2328;--shiki-dark:#9CDCFE">$WORKSPACE</span><span style="color:#0A3069;--shiki-dark:#CE9178">&quot;</span><span style="color:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
<span class="line"><span style="color:#0550AE;--shiki-dark:#569CD6">  --config</span><span style="color:#0A3069;--shiki-dark:#CE9178"> &quot;</span><span style="color:#1F2328;--shiki-dark:#9CDCFE">$RUN_CONFIG</span><span style="color:#0A3069;--shiki-dark:#CE9178">&quot;</span><span style="color:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
<span class="line"><span style="color:#0550AE;--shiki-dark:#569CD6">  --input</span><span style="color:#0A3069;--shiki-dark:#CE9178"> -</span><span style="color:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
<span class="line"><span style="color:#0550AE;--shiki-dark:#569CD6">  --output-format</span><span style="color:#0A3069;--shiki-dark:#CE9178"> stream-json</span><span style="color:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
<span class="line"><span style="color:#0550AE;--shiki-dark:#569CD6">  --timeout</span><span style="color:#0A3069;--shiki-dark:#CE9178"> 15m</span><span style="color:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
<span class="line"><span style="color:#0550AE;--shiki-dark:#569CD6">  --max-steps</span><span style="color:#0550AE;--shiki-dark:#B5CEA8"> 80</span><span style="color:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
<span class="line"><span style="color:#CF222E;--shiki-dark:#D4D4D4">  &lt;</span><span style="color:#0A3069;--shiki-dark:#CE9178"> &quot;</span><span style="color:#1F2328;--shiki-dark:#9CDCFE">$INSTRUCTION_FILE</span><span style="color:#0A3069;--shiki-dark:#CE9178">&quot;</span><span style="color:#CF222E;--shiki-dark:#D7BA7D"> \</span></span>
<span class="line"><span style="color:#CF222E;--shiki-dark:#D4D4D4">  &gt;</span><span style="color:#0A3069;--shiki-dark:#CE9178"> &quot;</span><span style="color:#1F2328;--shiki-dark:#9CDCFE">$RAW_DIR</span><span style="color:#0A3069;--shiki-dark:#CE9178">/stdout.jsonl&quot;</span><span style="color:#CF222E;--shiki-dark:#D4D4D4"> 2&gt;</span><span style="color:#0A3069;--shiki-dark:#CE9178"> &quot;</span><span style="color:#1F2328;--shiki-dark:#9CDCFE">$RAW_DIR</span><span style="color:#0A3069;--shiki-dark:#CE9178">/stderr.log&quot;</span></span>
</code></pre></div></div></div></div><div class="code-block-fade-overlay print:hidden" data-fade-overlay="true" aria-hidden="true" style="--fade-color-light:#ffffff;--fade-color-dark:#0B0C0E"></div></div>
<span data-as="p">In a real integration I read stdout and stderr concurrently through a process API so the pipes don’t fill up. If the agent runs in a container, the log streams are piped back to the host for storage. The command above doesn’t handle environment setup, permission policy, or cleanup; the Runner still has to implement those.</span>
<span data-as="p">The JSONL events carry <code>schemaVersion</code>, <code>sequence</code>, plus <code>runId</code>, <code>sessionId</code>, and <code>turnId</code>. The adapter validates event version, identity, and ordering, merges deltas by item ID, and keeps the raw stream too. Truncated lines, duplicate terminal events, or a wrong runId should all be recorded as anomalies.</span>
<span data-as="p">The terminal event <code>exec.completed</code> carries the execution result. <code>status: succeeded</code> only means this execution ended successfully; whether the code was fixed correctly still needs verification. <code>--output-schema</code> only validates the structure of the final answer, too. However tidy the answer JSON is, the tests can still fail.</span>
<span data-as="p">Sometimes there won’t even be a terminal event, for example on a preflight failure or a crash, so collect the exit code and stderr as well. If a headless run gets stuck on a question that needs a human, handle it according to the pre-agreed rules for unattended or interactive tasks; answering for one group on the fly changes the experimental conditions.</span>
<span data-as="p">When building the adapter, you can check directly against the <a href="https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/tui/src/cli/contract.ts" target="_blank" rel="noreferrer" class="link">CLI contract</a>, <a href="https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/tui/src/headless/events.ts" target="_blank" rel="noreferrer" class="link">event projection</a>, and <a href="https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/tui/src/headless/contract.ts" target="_blank" rel="noreferrer" class="link">result types</a>.</span>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="04-all-tests-green-check-who-changed-the-tests"><div class="absolute" tabindex="-1"><a href="#04-all-tests-green-check-who-changed-the-tests" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-3 shrink-0"><path d="M8.50001 6.827C8.14801 6.995 7.81801 7.225 7.52701 7.517L7.51701 7.527C6.13601 8.908 6.13601 11.146 7.51701 12.527L9.69201 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M9.50002 11.173C9.85202 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.30802 3.298C6.92702 1.917 4.68902 1.917 3.30802 3.298L3.29802 3.308C1.91702 4.689 1.91702 6.927 3.29802 8.308L4.22902 9.239" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></div></a></div><span class="cursor-pointer">04 All tests green? Check who changed the tests</span></h2>
<span data-as="p">The agent can modify tests, build scripts, and dependencies in its workspace. Printing “all tests passed” — or even genuinely turning the tests green — isn’t enough to accept the result.</span>
<span data-as="p">For code-change tasks, I first freeze the final workspace and have the host check protected files, file types, and the scope of changes, then move the deliverable changes into a clean verification environment. The image, test entry point, and hidden tests are pinned by the eval side. The candidate code is still untrusted, so the Verifier that runs it needs isolation too.</span>
<span data-as="p">Exporting artifacts has its own details. Storing only a plain Git diff can miss untracked files, binaries, permission changes, or symlinks. The artifact protocol has to spell these out. If the deliverable is service state or a database change, save the corresponding snapshot and check the actual behavior from the outside.</span>
<span data-ramka-trigger="" class="zoom-image-trigger contents cursor-zoom-in"><span class="contents"><picture class="contents"><img data-path="images/techblog/eval-verifier.jpg" src="https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=bb22558d6eaec5b29f67013a08f8ffe9" alt="Keep grading outside the agent: the trust boundary between the agent environment and the verifier environment" class="object-contain" width="1536" height="1024" decoding="async" sizes="(max-width: 1024px) 100vw, 1024px" srcSet="https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=280&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=2928dad928cae8148ca3a2bdde02e1a0 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=560&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=6274f6c3032cf6e576a95e4a10833b9d 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=840&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=df47704c58a01623cf0bf089f0ba620c 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=1100&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=03465810f674cfe219d6900f461de1d6 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=1650&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=3cab5e14e8eedafe76a7ebb846d62ce3 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=2500&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=d2acc50c79f4ee5af47d9908ff64794d 2500w" data-optimize="true" style="aspect-ratio:1536 / 1024"/></picture></span></span><button type="button" aria-haspopup="dialog" aria-expanded="false" data-ramka-trigger="" aria-label="Expand image" class="inline-flex shrink-0 cursor-pointer items-center justify-center rounded-full border border-black/20 bg-white/55 text-neutral-900 shadow-[0_0.5px_1px_rgb(0_0_0/0.12),0_1px_2px_rgb(0_0_0/0.08),inset_0_0.5px_0_rgb(255_255_255/0.65)] backdrop-blur-[40px] backdrop-saturate-150 transition-[background-color,box-shadow,scale,opacity,color] duration-150 ease-out hover:bg-white/65 active:scale-[0.96] active:bg-white/75 focus:outline-hidden focus-visible:shadow-[0_0_0_2px_rgb(0_0_0/0.25),0_0.5px_1px_rgb(0_0_0/0.12),0_1px_2px_rgb(0_0_0/0.08),inset_0_0.5px_0_rgb(255_255_255/0.65)] disabled:cursor-not-allowed disabled:opacity-30 disabled:active:scale-100 dark:border-white/25 dark:bg-neutral-900/45 dark:text-white dark:shadow-[0_0_0_0.5px_#000,0_0.5px_1px_rgb(0_0_0/0.45),0_1px_2px_rgb(0_0_0/0.35),inset_0_0.5px_0_rgb(255_255_255/0.14)] dark:hover:bg-neutral-900/55 dark:active:bg-neutral-900/65 dark:focus-visible:shadow-[0_0_0_2px_rgb(255_255_255/0.4),0_0_0_0.5px_#000,0_0.5px_1px_rgb(0_0_0/0.45),0_1px_2px_rgb(0_0_0/0.35),inset_0_0.5px_0_rgb(255_255_255/0.14)] absolute z-10 size-px overflow-hidden whitespace-nowrap [clip-path:inset(50%)] pointer-events-none focus-visible:size-9 focus-visible:overflow-visible focus-visible:[clip-path:none] focus-visible:pointer-events-auto in-[a]:hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4 shrink-0"><path d="M10.75 2.75H15.25V7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M15.25 2.75L10.75 7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 10.75V15.25H7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 15.25L7.25 10.75" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></button>
<span data-as="p"><em>The agent delivers candidate artifacts; the grading program and hidden tests stay in a separate environment.</em></span>
<span data-as="p">Back to the parser task: behavior tests, regression of existing functionality, and integrity checks should each report their own result. The task only counts as done when all three pass. A pass obtained by deleting tests can’t be offset by extra points elsewhere.</span>
<span data-as="p">For example, in the sample record below, execution ended normally and the behavior tests passed, but a protected file was modified, so <code>accepted</code> is still false. This is an example data structure, not a real score.</span>
<div class="code-block mt-5 mb-8 not-prose rounded-2xl relative group min-w-0 print:print-color-exact text-gray-950 dark:text-gray-50 codeblock-light border border-gray-950/10 dark:border-white/10 dark:twoslash-dark bg-transparent dark:bg-transparent" data-has-floating-buttons="" numberOfLines="12" language="json"><div data-floating-buttons="true" class="absolute top-3 right-4 flex items-center gap-1.5 print:hidden"><div class="z-10 select-none" id="base-ui-_R_1tajpbb9qnpfb39p7b9snpfiutb_" data-base-ui-tooltip-trigger=""><button class="size-6.5 flex items-center justify-center rounded-md group/code-snippet-feedback-button [.code-block:not(:has([data-fade-overlay]))_[data-floating-buttons]_&amp;]:bg-gray-100 dark:[.code-block:not(:has([data-fade-overlay]))_[data-floating-buttons]_&amp;]:bg-gray-800" id="code-snippet-feedback-button" aria-label="Report incorrect code"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4 shrink-0 text-gray-400 group-hover/code-snippet-feedback-button:text-gray-500 dark:text-white/40 dark:group-hover/code-snippet-feedback-button:text-white/60"><path d="M9 5.431V9.569" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M9 11.417C8.449 11.417 8 11.866 8 12.417C8 12.968 8.449 13.417 9 13.417C9.551 13.417 10 12.968 10 12.417C10 11.866 9.551 11.417 9 11.417Z" fill="currentColor" stroke="none"></path><path d="M10.968 2.25H7.03301C6.50301 2.25 5.99401 2.461 5.61901 2.836L2.83701 5.618C2.46201 5.993 2.25101 6.502 2.25101 7.032V10.967C2.25101 11.497 2.46201 12.006 2.83701 12.381L5.61901 15.163C5.99401 15.538 6.50301 15.749 7.03301 15.749H10.968C11.498 15.749 12.007 15.538 12.382 15.163L15.164 12.381C15.539 12.006 15.75 11.497 15.75 10.967V7.032C15.75 6.502 15.539 5.993 15.164 5.618L12.382 2.836C12.007 2.461 11.498 2.25 10.968 2.25Z" stroke="currentColor"