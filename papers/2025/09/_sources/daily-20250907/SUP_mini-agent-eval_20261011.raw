]&gt;&amp;]:[text-shadow:-0.15px_0_0_currentColor,0.15px_0_0_currentColor]">03 Run tasks with the real MiniMax Code</a></li><li class="toc-item relative" data-depth="0"><a style="--toc-padding-left:0rem" href="#04-all-tests-green-check-who-changed-the-tests" class="break-words py-1 block pl-[calc(var(--toc-padding-left)+var(--toc-focus-padding,0rem))] focus-visible:[--toc-focus-padding:0.25rem] focus-visible:-ml-1 focus-visible:-outline-offset-2 dark:text-gray-400 [li:not([data-active])&gt;&amp;:hover]:text-gray-900 dark:[li:not([data-active])&gt;&amp;:hover]:text-gray-300 [[data-active]&gt;&amp;]:text-primary dark:[[data-active]&gt;&amp;]:text-primary-light [[data-active]&gt;&amp;]:[text-shadow:-0.15px_0_0_currentColor,0.15px_0_0_currentColor]">04 All tests green? Check who changed the tests</a></li><li class="toc-item relative" data-depth="0"><a style="--toc-padding-left:0rem" href="#05-an-experiment-on-a-compaction-change" class="break-words py-1 block pl-[calc(var(--toc-padding-left)+var(--toc-focus-padding,0rem))] focus-visible:[--toc-focus-padding:0.25rem] focus-visible:-ml-1 focus-visible:-outline-offset-2 dark:text-gray-400 [li:not([data-active])&gt;&amp;:hover]:text-gray-900 dark:[li:not([data-active])&gt;&amp;:hover]:text-gray-300 [[data-active]&gt;&amp;]:text-primary dark:[[data-active]&gt;&amp;]:text-primary-light [[data-active]&gt;&amp;]:[text-shadow:-0.15px_0_0_currentColor,0.15px_0_0_currentColor]">05 An experiment on a compaction change</a></li><li class="toc-item relative" data-depth="0"><a style="--toc-padding-left:0rem" href="#06-beyond-the-score-what-records-to-keep" class="break-words py-1 block pl-[calc(var(--toc-padding-left)+var(--toc-focus-padding,0rem))] focus-visible:[--toc-focus-padding:0.25rem] focus-visible:-ml-1 focus-visible:-outline-offset-2 dark:text-gray-400 [li:not([data-active])&gt;&amp;:hover]:text-gray-900 dark:[li:not([data-active])&gt;&amp;:hover]:text-gray-300 [[data-active]&gt;&amp;]:text-primary dark:[[data-active]&gt;&amp;]:text-primary-light [[data-active]&gt;&amp;]:[text-shadow:-0.15px_0_0_currentColor,0.15px_0_0_currentColor]">06 Beyond the score: what records to keep</a></li><li class="toc-item relative" data-depth="0"><a style="--toc-padding-left:0rem" href="#07-how-to-compare-two-versions" class="break-words py-1 block pl-[calc(var(--toc-padding-left)+var(--toc-focus-padding,0rem))] focus-visible:[--toc-focus-padding:0.25rem] focus-visible:-ml-1 focus-visible:-outline-offset-2 dark:text-gray-400 [li:not([data-active])&gt;&amp;:hover]:text-gray-900 dark:[li:not([data-active])&gt;&amp;:hover]:text-gray-300 [[data-active]&gt;&amp;]:text-primary dark:[[data-active]&gt;&amp;]:text-primary-light [[data-active]&gt;&amp;]:[text-shadow:-0.15px_0_0_currentColor,0.15px_0_0_currentColor]">07 How to compare two versions</a></li><li class="toc-item relative" data-depth="0"><a style="--toc-padding-left:0rem" href="#08-don%E2%80%99t-let-the-eval-set-turn-into-a-dev-set" class="break-words py-1 block pl-[calc(var(--toc-padding-left)+var(--toc-focus-padding,0rem))] focus-visible:[--toc-focus-padding:0.25rem] focus-visible:-ml-1 focus-visible:-outline-offset-2 dark:text-gray-400 [li:not([data-active])&gt;&amp;:hover]:text-gray-900 dark:[li:not([data-active])&gt;&amp;:hover]:text-gray-300 [[data-active]&gt;&amp;]:text-primary dark:[[data-active]&gt;&amp;]:text-primary-light [[data-active]&gt;&amp;]:[text-shadow:-0.15px_0_0_currentColor,0.15px_0_0_currentColor]">08 Don’t let the eval set turn into a dev set</a></li><li class="toc-item relative" data-depth="0"><a style="--toc-padding-left:0rem" href="#implementation-and-references" class="break-words py-1 block pl-[calc(var(--toc-padding-left)+var(--toc-focus-padding,0rem))] focus-visible:[--toc-focus-padding:0.25rem] focus-visible:-ml-1 focus-visible:-outline-offset-2 dark:text-gray-400 [li:not([data-active])&gt;&amp;:hover]:text-gray-900 dark:[li:not([data-active])&gt;&amp;:hover]:text-gray-300 [[data-active]&gt;&amp;]:text-primary dark:[[data-active]&gt;&amp;]:text-primary-light [[data-active]&gt;&amp;]:[text-shadow:-0.15px_0_0_currentColor,0.15px_0_0_currentColor]">Implementation and references</a></li></ul></div></nav></div></div></div></div></div><div class="relative grow box-border flex-col w-full mx-auto px-1 lg:pl-[5.7rem] lg:-ml-12 xl:w-[calc(100%-28rem)] lg:max-w-[calc(var(--content-width,100vw)+5.95rem)]" data-empty-page-layout="" id="content-area"><header id="header" class="relative leading-none @container/page-header"><div class="mt-0.5 space-y-2.5"><div class="flex flex-col sm:flex-row items-start sm:items-center relative gap-2 min-w-0"><h1 id="page-title" class="text-3xl sm:text-4xl text-gray-900 tracking-tight dark:text-gray-200 [overflow-wrap:anywhere] font-semibold">Building a Testbed for Coding Agents</h1></div></div><div class="mt-2 text-lg prose prose-gray dark:prose-invert [&amp;&gt;*]:[overflow-wrap:anywhere]"><p>Starting from MiniMax Code, building an evaluation system that can tell whether a Harness change actually helps.</p></div></header><div class="mdx-content @container/columns-container relative mt-8 prose prose-gray dark:prose-invert [contain:inline-size] isolate empty:hidden mb-14" data-page-title="Building a Testbed for Coding Agents" data-page-href="/techblog/coding-agent-eval" id="content"><span data-ramka-trigger="" class="zoom-image-trigger contents cursor-zoom-in"><span class="contents"><picture class="contents"><img data-path="images/techblog/eval-cover.jpg" src="https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=91880378111887616d54cdd912fbd3df" alt="Building a Testbed for Coding Agents: how to build trustworthy harness evaluations" class="object-contain" width="1672" height="941" decoding="async" sizes="(max-width: 1024px) 100vw, 1024px" srcSet="https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=280&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=92d0dccee9005d596e4299393161bc1d 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=560&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=0ece5808608d7b3c6664a2df353a3d06 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=840&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=b687eab8532cd3bb3ceff200c131973c 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=1100&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=23538a357f7192035a3ba3a4171a2eb3 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=1650&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=3428da3f5187598f65f0892c701487b4 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=2500&amp;fit=max&amp;auto=format&amp;n=7xgBTBZFmaXlhwRp&amp;q=85&amp;s=aeb7a5fc24bd15c7b155540b362971e7 2500w" data-optimize="true" style="aspect-ratio:1672 / 941"/></picture></span></span><button type="button" aria-haspopup="dialog" aria-expanded="false" data-ramka-trigger="" aria-label="Expand image" class="inline-flex shrink-0 cursor-pointer items-center justify-center rounded-full border border-black/20 bg-white/55 text-neutral-900 shadow-[0_0.5px_1px_rgb(0_0_0/0.12),0_1px_2px_rgb(0_0_0/0.08),inset_0_0.5px_0_rgb(255_255_255/0.65)] backdrop-blur-[40px] backdrop-saturate-150 transition-[background-color,box-shadow,scale,opacity,color] duration-150 ease-out hover:bg-white/65 active:scale-[0.96] active:bg-white/75 focus:outline-hidden focus-visible:shadow-[0_0_0_2px_rgb(0_0_0/0.25),0_0.5px_1px_rgb(0_0_0/0.12),0_1px_2px_rgb(0_0_0/0.08),inset_0_0.5px_0_rgb(255_255_255/0.65)] disabled:cursor-not-allowed disabled:opacity-30 disabled:active:scale-100 dark:border-white/25 dark:bg-neutral-900/45 dark:text-white dark:shadow-[0_0_0_0.5px_#000,0_0.5px_1px_rgb(0_0_0/0.45),0_1px_2px_rgb(0_0_0/0.35),inset_0_0.5px_0_rgb(255_255_255/0.14)] dark:hover:bg-neutral-900/55 dark:active:bg-neutral-900/65 dark:focus-visible:shadow-[0_0_0_2px_rgb(255_255_255/0.4),0_0_0_0.5px_#000,0_0.5px_1px_rgb(0_0_0/0.45),0_1px_2px_rgb(0_0_0/0.35),inset_0_0.5px_0_rgb(255_255_255/0.14)] absolute z-10 size-px overflow-hidden whitespace-nowrap [clip-path:inset(50%)] pointer-events-none focus-visible:size-9 focus-visible:overflow-visible focus-visible:[clip-path:none] focus-visible:pointer-events-auto in-[a]:hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4 shrink-0"><path d="M10.75 2.75H15.25V7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M15.25 2.75L10.75 7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 10.75V15.25H7.25" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.75 15.25L7.25 10.75" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></button>
<span data-as="p"><a class="link" href="/docs/techblog/minimax-code-harness">Last time</a> we looked at the Harness design behind MiniMax Code. This time I want to take on a harder question: after we change the Harness, how do we know it got better?</span>
<span data-as="p">Take context compaction. We switch to a new checkpoint format, run a few long tasks, and the agent seems to forget things less often. That result is certainly worth pursuing, but I wouldn’t yet use it to decide whether to merge. Maybe those tasks happened to be easy; maybe the model service happened to be stable. It’s even possible that the tokens saved during compaction got spent again later on re-reading files.</span>
<span data-as="p">I want evaluation to help us tell these cases apart. In engineering terms, that means: how a task is prepared, how the agent runs, who verifies the result, and how two versions are finally compared. This post uses the open-source <a href="https://github.com/MiniMax-AI/minimax-code" target="_blank" rel="noreferrer" class="link">MiniMax Code</a> to walk through that design. The execution entry points and collection interfaces are already in the source; the external Runner, task protocol, and grading pipeline are what this post sets out to build.</span>
<h2 class="flex whitespace-pre-wrap group font-semibold" id="01-an-eval-task-has-to-ship-with-its-environment-and-acceptance-criteria"><div class="absolute" tabindex="-1"><a href="#01-an-eval-task-has-to-ship-with-its-environment-and-acceptance-criteria" class="-ml-10 flex items-center opacity-0 border-0 group-hover:opacity-100 focus:opacity-100 focus:outline-0 group/link" aria-label="Navigate to header">​<div class="size-6 rounded-md flex items-center justify-center shadow-xs text-gray-400 dark:text-white/50 dark:bg-background-dark dark:brightness-[1.35] dark:ring-1 dark:hover:brightness-150 bg-white ring-1 ring-gray-400/30 dark:ring-gray-700/25 hover:ring-gray-400/60 dark:hover:ring-white/20 group-focus/link:border-2 group-focus/link:border-primary dark:group-focus/link:border-primary-light"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-3 shrink-0"><path d="M8.50001 6.827C8.14801 6.995 7.81801 7.225 7.52701 7.517L7.51701 7.527C6.13601 8.908 6.13601 11.146 7.51701 12.527L9.69201 14.702C11.073 16.083 13.311 16.083 14.692 14.702L14.702 14.692C16.083 13.311 16.083 11.073 14.702 9.692L13.771 8.761" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M9.50002 11.173C9.85202 11.005 10.182 10.775 10.473 10.483L10.483 10.473C11.864 9.092 11.864 6.854 10.483 5.473L8.30802 3.298C6.92702 1.917 4.68902 1.917 3.30802 3.298L3.29802 3.308C1.91702 4.689 1.91702 6.927 3.29802 8.308L4.22902 9.239" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></div></a></div><span class="cursor-pointer">01 An eval task has to ship with its environment and acceptance criteria</span></h2>
<span data-as="p">Say we write a task: fix an edge case in the parser, keep the old API, and don’t touch the tests.</span>
<span data-as="p">Putting that sentence in a prompt isn’t enough. Which commit is the repo at? Are dependencies installed? Can the agent reach the network? If a previous run already produced a fix file, this run isn’t starting from the same place.</span>
<span data-as="p">I put these conditions into a task bundle: instructions, initial environment, allowed operations, budget, and the acceptance program. The model, Harness, and grader versions are each recorded separately; a single repo commit usually doesn’t capture the full run conditions. A task bundle might look like this:</span>
<div class="code-block mt-5 mb-8 not-prose rounded-2xl relative group min-w-0 print:print-color-exact text-gray-950 dark:text-gray-50 codeblock-light border border-gray-950/10 dark:border-white/10 dark:twoslash-dark bg-transparent dark:bg-transparent" data-has-floating-buttons="" numberOfLines="20" language="yaml"><div data-floating-buttons="true" class="absolute top-3 right-4 flex items-center gap-1.5 print:hidden"><div class="z-10 select-none" id="base-ui-_R_1ta49bb9qnpfb39p7b9snpfiutb_" data-base-ui-tooltip-trigger=""><button class="size-6.5 flex items-center justify-center rounded-md group/code-snippet-feedback-button [.code-block:not(:has([data-fade-overlay]))_[data-floating-buttons]_&amp;]:bg-gray-100 dark:[.code-block:not(:has([data-fade-overlay]))_[data-floating-buttons]_&amp;]:bg-gray-800" id="code-snippet-feedback-button" aria-label="Report incorrect code"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4 shrink-0 text-gray-400 group-hover/code-snippet-feedback-button:text-gray-500 dark:text-white/40 dark:group-hover/code-snippet-feedback-button:text-white/60"><path d="M9 5.431V9.569" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M9 11.417C8.449 11.417 8 11.866 8 12.417C8 12.968 8.449 13.417 9 13.417C9.551 13.417 10 12.968 10 12.417C10 11.866 9.551 11.417 9 11.417Z" fill="currentColor" stroke="none"></path><path d="M10.968 2.25H7.03301C6.50301 2.25 5.99401 2.461 5.61901 2.836L2.83701 5.618C2.46201 5.993 2.25101 6.502 2.25101 7.032V10.967C2.25101 11.497 2.46201 12.006 2.83701 12.381L5.61901 15.163C5.99401 15.538 6.50301 15.749 7.03301 15.749H10.968C11.498 15.749 12.007 15.538 12.382 15.163L15.164 12.381C15.539 12.006 15.75 11.497 15.75 10.967V7.032C15.75 6.502 15.539 5.993 15.164 5.618L12.382 2.836C12.007 2.461 11.498 2.25 10.968 2.25Z" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></button></div><div class="code-block-copy-button z-10 select-none" id="base-ui-_R_1ua49bb9qnpfb39p7b9snpfiutb_" data-base-ui-tooltip-trigger=""><button class="size-6.5 flex items-center justify-center rounded-md group/copy-button [.code-block:not(:has([data-fade-overlay]))_[data-floating-buttons]_&amp;]:bg-gray-100 dark:[.code-block:not(:has([data-fade-overlay]))_[data-floating-buttons]_&amp;]:bg-gray-800" data-testid="copy-code-button" aria-label="Copy the contents from the code block"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="size-4 shrink-0 text-gray-400 group-hover/copy-button:text-gray-500 dark:text-white/40 dark:group-hover/copy-button:text-white/60"><path d="M14.25 5.25H7.25C6.14543 5.25 5.25 6.14543 5.25 7.25V14.25C5.25 15.3546 6.14543 16.25 7.25 16.25H14.25C15.3546 16.25 16.25 15.3546 16.25 14.25V7.25C16.25 6.14543 15.3546 5.25 14.25 5.25Z" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path><path d="M2.80103 11.998L1.77203 5.07397C1.61003 3.98097 2.36403 2.96397 3.45603 2.80197L10.38 1.77297C11.313 1.63397 12.19 2.16297 12.528 3.00097" stroke="currentColor" width="1.5" linecap="round" linejoin="round"></path></svg></button><span role="status" class="sr-only"></span></div></div><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px;font-variant-ligatures:none;height:auto;background-color:#ffffff;--shiki-dark-bg:#0B0C0E" data-component-part="code-block-root" class="w-0 min-w-full max-w-full h-full dark:bg-codeblock text-sm leading-6 transition-[height] duration-300 ease-in-out code-block-background **:ring-0 **:outline-0 **:focus:ring-0 **:focus:outline-0 rounded-2xl bg-white"><div role="presentation" data-id="base-ui-_R_1i49bb9qnpfb39p7b9snpfiutb_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] py-3.5 px-4 overflow-y-hidden! base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-full! h-full children:my-0! children:shadow-none! children:bg-transparent!"><div class="font-mono whitespace-pre leading-6"><pre class="shiki shiki-themes github-light-default dark-plus" style="background-color:#ffffff;--shiki-dark-bg:#0B0C0E;color:#1f2328;--shiki-dark:#D4D4D4" language="yaml"><code language="yaml" numberOfLines="20"><span class="line"><span style="color:#6E7781;--shiki-dark:#6A9955"># task.yaml — example eval-layer protocol, not an mcode config format</span></span>
<span class="line"><span style="color:#116329;--shiki-dark:#569CD6">id</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">: </span><span style="color:#0A3069;--shiki-dark:#CE9178">parser-compat-017</span></span>
<span class="line"><span style="color:#116329;--shiki-dark:#569CD6">revision</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">: </span><span style="color:#0550AE;--shiki-dark:#B5CEA8">3</span></span>
<span class="line"><span style="color:#116329;--shiki-dark:#569CD6">instruction</span><span style="color:#1F2328;--shiki-dark:#D4D4D4">: </span><span style="color:#0A3069;--shiki-dark:#CE9178">instruction.md</span></span>
