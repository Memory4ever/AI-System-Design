24px) {\n  #sidebar {\n    top: max(\n      calc(var(--mintlify-slot-header-height, 7rem) + var(--banner-height, 0px)),\n      5rem\n    ) !important;\n  }\n}\n\n@media (max-width: 1023px) {\n  #sidebar \u003e div:first-child,\n  #sidebar-content \u003e div:first-child {\n    padding-top: 16px !important;\n  }\n}\n\n.code-docs h2,\n.code-docs h3 {\n  display: block !important;\n  padding: 0 !important;\n  border-radius: 0 !important;\n  background-color: transparent !important;\n  color: inherit !important;\n  border: none !important;\n}\n\n.code-image-placeholder {\n  border: 1px dashed #CBD5E1;\n  border-radius: 8px;\n  padding: 16px;\n  background: #F8FAFC;\n  color: #475569;\n  font-size: 14px;\n  line-height: 22px;\n  margin: 16px 0 24px;\n}\n\n.dark .code-image-placeholder {\n  border-color: #475569;\n  background: #111827;\n  color: #CBD5E1;\n}\n\n.code-screenshot {\n  display: block;\n  width: 100%;\n  margin: 16px 0 24px;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  background: #FFFFFF;\n}\n\n.dark .code-screenshot {\n  border-color: #334155;\n  background: #0F172A;\n}\n\n.code-community-panel {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 180px;\n  gap: 24px;\n  align-items: center;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  padding: 20px;\n  margin: 16px 0 8px;\n  background: #FFFFFF;\n}\n\n.code-community-panel p {\n  margin-bottom: 0;\n}\n\n.code-qr-placeholder {\n  display: flex;\n  min-height: 180px;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  border: 1px dashed #CBD5E1;\n  border-radius: 8px;\n  background: #F8FAFC;\n  color: #334155;\n  text-align: center;\n}\n\n.code-qr-placeholder small {\n  max-width: 140px;\n  color: #64748B;\n  font-size: 12px;\n  line-height: 18px;\n}\n\n.code-community-qr {\n  display: block;\n  width: 180px;\n  max-width: 100%;\n  border: 1px solid #E2E8F0;\n  border-radius: 8px;\n  background: #FFFFFF;\n}\n\n.dark .code-community-panel {\n  border-color: #334155;\n  background: #0F172A;\n}\n\n.dark .code-qr-placeholder {\n  border-color: #475569;\n  background: #111827;\n  color: #CBD5E1;\n}\n\n.dark .code-qr-placeholder small {\n  color: #94A3B8;\n}\n\n@media (max-width: 640px) {\n  .code-community-panel {\n    grid-template-columns: 1fr;\n  }\n\n  .code-qr-placeholder {\n    min-height: 220px;\n  }\n}\n\nbody:has(.question-standalone-marker) header,\nbody:has(.question-standalone-marker) #navbar,\nbody:has(.question-standalone-marker) #sidebar,\nbody:has(.question-standalone-marker) #sidebar-content,\nbody:has(.question-standalone-marker) footer,\nbody:has(.question-standalone-marker) [class*=\"navbar\"],\nbody:has(.question-standalone-marker) [class*=\"Navbar\"],\nbody:has(.question-standalone-marker) [class*=\"sidebar\"],\nbody:has(.question-standalone-marker) [class*=\"Sidebar\"],\nbody:has(.question-standalone-marker) [class*=\"search\"],\nbody:has(.question-standalone-marker) [class*=\"Search\"],\nbody:has(.question-standalone-marker) button[aria-label*=\"Search\"],\nbody:has(.question-standalone-marker) button[aria-label*=\"搜索\"],\nbody:has(.question-standalone-marker) [role=\"search\"] {\n  display: none !important;\n}\n\nbody:has(.question-standalone-marker) #table-of-contents-layout,\nbody:has(.question-standalone-marker) [aria-label=\"目录\"],\nbody:has(.question-standalone-marker) [aria-label=\"Contents\"] {\n  display: none !important;\n}\n\nbody:has(.question-standalone-marker) main,\nbody:has(.question-standalone-marker) article {\n  padding-top: 0 !important;\n}\n\nbody:has(.question-standalone-marker) article {\n  max-width: 900px !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n}\n"])</script><script>self.__next_f.push([1,"53:[[\"$\",\"style\",\"0\",{\"data-custom-css-index\":0,\"data-custom-css-path\":\"style.css\",\"dangerouslySetInnerHTML\":{\"__html\":\"$58\"}}]]\n5a:T147f,"])</script><script>self.__next_f.push([1,"(() =\u003e {\n  const PRODUCT_URL = 'https://agent.minimax.io';\n  const PRODUCT_NAME = 'MiniMax Agent';\n  const MINIMAX_URL = 'https://www.minimax.io';\n  const LOGO_URL = 'https://file.cdn.minimax.io/public/969d635c-cab6-45cc-8d61-47c9fe40c81f.png';\n  const LANGUAGE = 'en-US';\n  const DESCRIPTION = 'MiniMax Agent is a general-purpose AI agent that builds full-stack web apps, presentations, deep research reports, and more. Powered by a multi-agent system.';\n\n  const baseCount = 32182;\n  const startDate = new Date('2024-01-01').getTime();\n  const today = new Date().getTime();\n  const daysSinceStart = Math.floor((today - startDate) / (1000 * 60 * 60 * 24));\n  const dateNum = parseInt(new Date().toISOString().slice(0, 10).replace(/-/g, ''), 10);\n  const dailyIncrement = 50 + (dateNum % 40);\n  const ratingCount = baseCount + Math.floor(daysSinceStart * (dailyIncrement - 20));\n\n  const schema = {\n    '@context': 'https://schema.org',\n    '@graph': [\n      {\n        '@type': 'SoftwareApplication',\n        '@id': PRODUCT_URL + '/#softwareapplication',\n        name: PRODUCT_NAME,\n        url: PRODUCT_URL,\n        operatingSystem: 'Web, Windows, Mac, iOS, Android',\n        applicationCategory: 'ProductivityApplication',\n        aggregateRating: {\n          '@type': 'AggregateRating',\n          ratingValue: 4.9,\n          bestRating: 5,\n          ratingCount: ratingCount,\n        },\n        offers: {\n          '@type': 'Offer',\n          price: '0',\n          priceCurrency: 'USD',\n        },\n        logo: {\n          '@type': 'ImageObject',\n          '@id': PRODUCT_URL + '/#/schema/logo/image',\n          inLanguage: LANGUAGE,\n          url: LOGO_URL,\n          contentUrl: LOGO_URL,\n          caption: PRODUCT_NAME,\n        },\n        mainEntityOfPage: {\n          '@type': 'WebPage',\n          '@id': PRODUCT_URL + '/#webpage',\n        },\n        creator: {\n          '@type': 'Organization',\n          name: 'MiniMax',\n          url: MINIMAX_URL,\n        },\n        features: [\n          'Full-Stack Web App Development',\n          'PPT \u0026 Presentation Generation',\n          'Deep Research \u0026 Analysis',\n          'Browser Automation',\n          'Code Generation',\n          'MCP Ecosystem Integration',\n          'Multimodal Content Creation',\n        ],\n      },\n      {\n        '@type': 'WebSite',\n        '@id': PRODUCT_URL + '/#website',\n        url: PRODUCT_URL,\n        name: PRODUCT_NAME,\n        description: DESCRIPTION,\n        publisher: { '@id': PRODUCT_URL + '/#organization' },\n        inLanguage: LANGUAGE,\n        copyrightHolder: { '@id': PRODUCT_URL + '/#organization' },\n      },\n      {\n        '@type': 'WebPage',\n        '@id': PRODUCT_URL + '/#webpage',\n        url: window.location.href,\n        name: document.title,\n        about: { '@id': PRODUCT_URL + '/#organization' },\n        isPartOf: { '@id': PRODUCT_URL + '/#website' },\n        primaryImageOfPage: { '@id': PRODUCT_URL + '/#primaryimage' },\n        image: { '@id': PRODUCT_URL + '/#primaryimage' },\n        thumbnailUrl: LOGO_URL,\n        datePublished: new Date().toISOString(),\n        dateModified: new Date().toISOString(),\n        description: DESCRIPTION,\n        inLanguage: LANGUAGE,\n      },\n      {\n        '@type': 'ImageObject',\n        inLanguage: LANGUAGE,\n        '@id': PRODUCT_URL + '/#primaryimage',\n        url: LOGO_URL,\n        contentUrl: LOGO_URL,\n        width: 80,\n        height: 80,\n      },\n      {\n        '@type': 'BreadcrumbList',\n        '@id': PRODUCT_URL + '/#breadcrumb',\n        itemListElement: [\n          {\n            '@type': 'ListItem',\n            position: 1,\n            name: 'MiniMax Agent',\n            item: PRODUCT_URL,\n          },\n          {\n            '@type': 'ListItem',\n            position: 2,\n            name: document.title,\n            item: window.location.href,\n          },\n        ],\n      },\n      {\n        '@type': ['Organization', 'Brand'],\n        '@id': PRODUCT_URL + '/#organization',\n        name: PRODUCT_NAME,\n        legalName: PRODUCT_NAME,\n        url: PRODUCT_URL,\n        description: DESCRIPTION,\n        logo: {\n          '@type': 'ImageObject',\n          inLanguage: LANGUAGE,\n          '@id': PRODUCT_URL + '/#/schema/logo/image',\n        },\n        parentOrganization: {\n          '@type': ['Organization', 'Brand'],\n          name: 'MiniMax',\n          legalName: 'MiniMax',\n          url: MINIMAX_URL,\n          description: 'MiniMax is a leading general artificial intelligence technology company.',\n          logo: {\n            '@type': 'ImageObject',\n            inLanguage: LANGUAGE,\n            '@id': MINIMAX_URL + '/#schema/logo/image',\n            url: LOGO_URL,\n            contentUrl: LOGO_URL,\n            caption: 'MiniMax',\n          },\n          sameAs: [\n            'https://www.linkedin.com/company/minimax-ai/',\n            'https://en.wikipedia.org/wiki/MiniMax_(company)',\n            'https://x.com/MiniMax_AI',\n            'https://github.com/MiniMax-AI',\n            'https://discord.com/invite/hvvt8hAye6',\n          ],\n        },\n      },\n    ],\n  };\n\n  const script = document.createElement('script');\n  script.type = 'application/ld+json';\n  script.textContent = JSON.stringify(schema);\n  document.head.appendChild(script);\n})();\n"])</script><script>self.__next_f.push([1,"54:[\"$\",\"$L59\",null,{\"customJsDisabled\":false,\"jsFiles\":[{\"_id\":\"69c794007ba705a2811a3dae\",\"filePath\":\"scripts/seo-schema.js\",\"subdomain\":\"agent-en\",\"__v\":0,\"content\":\"$5a\"}]}]\n5d:Tda4b,"])</script><script>self.__next_f.push([1,"\"use strict\";const{Fragment:_Fragment,jsx:_jsx,jsxs:_jsxs}=arguments[0];const{useMDXComponents:_provideComponents}=arguments[0];function _createMdxContent(props){const _components={a:`a`,code:`code`,em:`em`,li:`li`,p:`p`,pre:`pre`,span:`span`,tbody:`tbody`,td:`td`,th:`th`,thead:`thead`,tr:`tr`,ul:`ul`,..._provideComponents(),...props.components},{CodeBlock,Heading,OptimizedImage,Table}=_components;if(!CodeBlock)_missingMdxReference(`CodeBlock`,true);if(!Heading)_missingMdxReference(`Heading`,true);if(!OptimizedImage)_missingMdxReference(`OptimizedImage`,true);if(!Table)_missingMdxReference(`Table`,true);return _jsxs(_Fragment,{children:[_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=91880378111887616d54cdd912fbd3df`,alt:`Building a Testbed for Coding Agents: how to build trustworthy harness evaluations`,\"data-og-width\":`1672`,width:`1672`,\"data-og-height\":`941`,height:`941`,\"data-path\":`images/techblog/eval-cover.jpg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=92d0dccee9005d596e4299393161bc1d 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=0ece5808608d7b3c6664a2df353a3d06 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=b687eab8532cd3bb3ceff200c131973c 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=23538a357f7192035a3ba3a4171a2eb3 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=3428da3f5187598f65f0892c701487b4 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-cover.jpg?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=aeb7a5fc24bd15c7b155540b362971e7 2500w`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`/techblog/minimax-code-harness`,children:`Last time`}),` we looked at the Harness design behind MiniMax Code. This time I want to take on a harder question: after we change the Harness, how do we know it got better?`]}),`\n`,_jsx(_components.p,{children:`Take context compaction. We switch to a new checkpoint format, run a few long tasks, and the agent seems to forget things less often. That result is certainly worth pursuing, but I wouldn’t yet use it to decide whether to merge. Maybe those tasks happened to be easy; maybe the model service happened to be stable. It’s even possible that the tokens saved during compaction got spent again later on re-reading files.`}),`\n`,_jsxs(_components.p,{children:[`I want evaluation to help us tell these cases apart. In engineering terms, that means: how a task is prepared, how the agent runs, who verifies the result, and how two versions are finally compared. This post uses the open-source `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code`,children:`MiniMax Code`}),` to walk through that design. The execution entry points and collection interfaces are already in the source; the external Runner, task protocol, and grading pipeline are what this post sets out to build.`]}),`\n`,_jsx(Heading,{level:`2`,id:`01-an-eval-task-has-to-ship-with-its-environment-and-acceptance-criteria`,children:`01 An eval task has to ship with its environment and acceptance criteria`}),`\n`,_jsx(_components.p,{children:`Say we write a task: fix an edge case in the parser, keep the old API, and don’t touch the tests.`}),`\n`,_jsx(_components.p,{children:`Putting that sentence in a prompt isn’t enough. Which commit is the repo at? Are dependencies installed? Can the agent reach the network? If a previous run already produced a fix file, this run isn’t starting from the same place.`}),`\n`,_jsx(_components.p,{children:`I put these conditions into a task bundle: instructions, initial environment, allowed operations, budget, and the acceptance program. The model, Harness, and grader versions are each recorded separately; a single repo commit usually doesn’t capture the full run conditions. A task bundle might look like this:`}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`20`,language:`yaml`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`yaml`,children:_jsxs(_components.code,{language:`yaml`,numberOfLines:`20`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# task.yaml — example eval-layer protocol, not an mcode config format`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`id`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`parser-compat-017`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`revision`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`3`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`instruction`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`instruction.md`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`initial_state`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`:`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  repository_commit`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\u003cfull-commit-sha\u003e`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  environment_image`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\u003cimage-at-sha256-digest\u003e`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  fixture_digest`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\u003csha256\u003e`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  network_policy`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`model-proxy-only`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`resources`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`:`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  cpu_cores`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`2`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  memory_limit_mib`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`4096`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`budget`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`:`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  agent_wall_seconds`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`900`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  assistant_steps`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`80`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  verifier_wall_seconds`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:`120`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`acceptance`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`:`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  verifier_revision`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\u003cfull-commit-sha\u003e`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  required`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`behavior`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`regression`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`integrity`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`]`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#569CD6`},children:`  protected_paths`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: [`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`tests/**`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`, `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`public-api.json`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`]`})]}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`This is an example eval-layer protocol, not mcode’s configuration format. The angle-bracket values get replaced with the real commit, image digest, and file digests when the task is checked in. The 900 seconds and 80 steps are also just example budgets that need calibrating per task.`}),`\n`,_jsx(_components.p,{children:`The agent can see the requirements, the code, and the public tests. The reference fix, hidden tests, and grading program stay on the eval side. Keeping them in the same repo for management is fine, but they must be mounted separately; otherwise the answer may get shipped in along with the question.`}),`\n`,_jsx(_components.p,{children:`Resource limits also have to actually take effect. A config that says 4 GiB but allows temporary overshoot can produce different results from one that kills the process the moment it hits the limit. Record the limits that were actually applied.`}),`\n`,_jsxs(_components.p,{children:[_jsx(_components.a,{href:`https://docs.harborframework.com/core-concepts/tasks/overview`,children:`Harbor’s task format`}),` bundles instructions, environment, and acceptance scripts together and is a good reference. Before a task is checked in, I first confirm that the unfixed version really fails and that the reference fix passes reliably. I also rerun it in a clean environment to rule out leftover local files and external dependencies like dead web pages. Otherwise you run tests all night and discover the next morning that the task itself was broken.`]}),`\n`,_jsx(Heading,{level:`2`,id:`02-the-runner-does-more-than-launch-a-process`,children:`02 The Runner does more than launch a process`}),`\n`,_jsx(_components.p,{children:`Some terminology first: a task is one problem; a trial is one attempt at that problem by a given version. Every trial gets its own runtime environment, data directory, and artifact directory. Memory, login configuration, caches, and background processes from the previous run must not quietly affect the next.`}),`\n`,_jsx(_components.p,{children:`The Runner executes in the stages below. State transitions are persisted to disk so that after a scheduler restart it knows which trials haven’t started, which are still running, and which only need grading. Running a task twice costs extra money and can mix artifacts from two runs into one result.`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-runner.jpg?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=e99c35db3a86002f599d97ec3083a936`,alt:`One trial, a complete record: prepare, run the agent, freeze artifacts, verify independently, seal and clean up`,\"data-og-width\":`1536`,width:`1536`,\"data-og-height\":`1024`,height:`1024`,\"data-path\":`images/techblog/eval-runner.jpg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-runner.jpg?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=48d8dc192f4ba37e929653a04cc197b8 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-runner.jpg?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=c7da965092f1c147b2cac4a235b8ca11 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-runner.jpg?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=3b0f48e993a087610173ba92ed2891c0 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-runner.jpg?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=d40c581221d142055d789c2070a73aed 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-runner.jpg?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=2d6093ca35a2b736694a74ceb4415c34 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-runner.jpg?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=e829ec6ee7fecb511e7dc79eed47e9c0 2500w`}),`\n`,_jsx(_components.p,{children:_jsx(_components.em,{children:`The Runner manages run state; raw records are kept on the host side, and the agent cannot rewrite them.`})}),`\n`,_jsx(_components.p,{children:`During preparation, verify the task fingerprint, image, and initial files, confirm the environment is healthy, then start the agent. When execution ends, first stop background processes and file writes, freeze the artifacts, then hand them to the grader. Even when something fails midway, collect evidence and clean up the environment.`}),`\n`,_jsx(_components.p,{children:`It’s easy to underestimate how far isolation has to go. Creating a Git worktree doesn’t clear memory stored in the user data directory, and it doesn’t isolate ports, plugin configuration, or external databases. External services used by each trial need their own namespaces, and resource quotas must be enforced. Read-only dependency caches can be shared, but their contents must be pinned; whether timing includes cache warm-up also needs to be agreed on.`}),`\n`,_jsx(_components.p,{children:`I keep two layers of timeouts: the agent’s own task time limit, plus a Runner watchdog. When internal cancellation fails, the outside can still kill the whole process group or container and record why it was force-terminated. Time environment setup, agent execution, and verification separately; otherwise a slightly slow dependency download can get counted as an agent performance regression.`}),`\n`,_jsx(_components.p,{children:`If the experiment has a cost cap, billing has to cover model calls from retries, compaction, and sub-tasks. A unified model gateway can accumulate usage and enforce a stop policy, with the usage in the final answer kept for reconciliation. If you only learn the cost after the answer arrives, it’s too late to control the budget. Pin the price table and cache pricing as well, and flag missing usage separately.`}),`\n`,_jsx(Heading,{level:`2`,id:`03-run-tasks-with-the-real-minimax-code`,children:`03 Run tasks with the real MiniMax Code`}),`\n`,_jsx(_components.p,{children:`The adapter only launches, reads output, stops, and collects artifacts. Tool scheduling, context compaction, and model retries stay with MiniMax Code. Rewriting an execution loop just to make evaluation convenient risks replacing exactly the Harness behavior you most want to test.`}),`\n`,_jsxs(_components.p,{children:[`MiniMax Code already has `,_jsx(_components.code,{children:`mcode exec`}),`, which can set the working directory, config, timeout, and step limit, and emit `,_jsx(_components.code,{children:`stream-json`}),`. Inside a prepared isolated environment, it’s launched like this. The Runner fills in the variables; the corresponding directories and config must be prepared beforehand.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`11`,language:`shellscript`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`shellscript`,children:_jsxs(_components.code,{language:`shellscript`,numberOfLines:`11`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# mcode build, model, and config are pinned; every trial uses a fresh DATA_DIR.`})}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#6E7781`,\"--shiki-dark\":`#6A9955`},children:`# RAW_DIR is a log directory outside the agent environment, owned by the Runner.`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`MINIMAX_DATA_DIR`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`=`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`$DATA_DIR`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"`}),_jsx(_components.span,{style:{color:`#953800`,\"--shiki-dark\":`#DCDCAA`},children:` mcode`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` exec`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --cwd`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`$WORKSPACE`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --config`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`$RUN_CONFIG`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --input`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` -`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --output-format`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` stream-json`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --timeout`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` 15m`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`  --max-steps`}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#B5CEA8`},children:` 80`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`  \u003c`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`$INSTRUCTION_FILE`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D7BA7D`},children:` \\\\`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:`  \u003e`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`$RAW_DIR`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`/stdout.jsonl\"`}),_jsx(_components.span,{style:{color:`#CF222E`,\"--shiki-dark\":`#D4D4D4`},children:` 2\u003e`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:` \"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#9CDCFE`},children:`$RAW_DIR`}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`/stderr.log\"`})]}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`In a real integration I read stdout and stderr concurrently through a process API so the pipes don’t fill up. If the agent runs in a container, the log streams are piped back to the host for storage. The command above doesn’t handle environment setup, permission policy, or cleanup; the Runner still has to implement those.`}),`\n`,_jsxs(_components.p,{children:[`The JSONL events carry `,_jsx(_components.code,{children:`schemaVersion`}),`, `,_jsx(_components.code,{children:`sequence`}),`, plus `,_jsx(_components.code,{children:`runId`}),`, `,_jsx(_components.code,{children:`sessionId`}),`, and `,_jsx(_components.code,{children:`turnId`}),`. The adapter validates event version, identity, and ordering, merges deltas by item ID, and keeps the raw stream too. Truncated lines, duplicate terminal events, or a wrong runId should all be recorded as anomalies.`]}),`\n`,_jsxs(_components.p,{children:[`The terminal event `,_jsx(_components.code,{children:`exec.completed`}),` carries the execution result. `,_jsx(_components.code,{children:`status: succeeded`}),` only means this execution ended successfully; whether the code was fixed correctly still needs verification. `,_jsx(_components.code,{children:`--output-schema`}),` only validates the structure of the final answer, too. However tidy the answer JSON is, the tests can still fail.`]}),`\n`,_jsx(_components.p,{children:`Sometimes there won’t even be a terminal event, for example on a preflight failure or a crash, so collect the exit code and stderr as well. If a headless run gets stuck on a question that needs a human, handle it according to the pre-agreed rules for unattended or interactive tasks; answering for one group on the fly changes the experimental conditions.`}),`\n`,_jsxs(_components.p,{children:[`When building the adapter, you can check directly against the `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/tui/src/cli/contract.ts`,children:`CLI contract`}),`, `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/tui/src/headless/events.ts`,children:`event projection`}),`, and `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/tui/src/headless/contract.ts`,children:`result types`}),`.`]}),`\n`,_jsx(Heading,{level:`2`,id:`04-all-tests-green-check-who-changed-the-tests`,children:`04 All tests green? Check who changed the tests`}),`\n`,_jsx(_components.p,{children:`The agent can modify tests, build scripts, and dependencies in its workspace. Printing “all tests passed” — or even genuinely turning the tests green — isn’t enough to accept the result.`}),`\n`,_jsx(_components.p,{children:`For code-change tasks, I first freeze the final workspace and have the host check protected files, file types, and the scope of changes, then move the deliverable changes into a clean verification environment. The image, test entry point, and hidden tests are pinned by the eval side. The candidate code is still untrusted, so the Verifier that runs it needs isolation too.`}),`\n`,_jsx(_components.p,{children:`Exporting artifacts has its own details. Storing only a plain Git diff can miss untracked files, binaries, permission changes, or symlinks. The artifact protocol has to spell these out. If the deliverable is service state or a database change, save the corresponding snapshot and check the actual behavior from the outside.`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=bb22558d6eaec5b29f67013a08f8ffe9`,alt:`Keep grading outside the agent: the trust boundary between the agent environment and the verifier environment`,\"data-og-width\":`1536`,width:`1536`,\"data-og-height\":`1024`,height:`1024`,\"data-path\":`images/techblog/eval-verifier.jpg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=2928dad928cae8148ca3a2bdde02e1a0 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=6274f6c3032cf6e576a95e4a10833b9d 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=df47704c58a01623cf0bf089f0ba620c 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=03465810f674cfe219d6900f461de1d6 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=3cab5e14e8eedafe76a7ebb846d62ce3 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-verifier.jpg?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=d2acc50c79f4ee5af47d9908ff64794d 2500w`}),`\n`,_jsx(_components.p,{children:_jsx(_components.em,{children:`The agent delivers candidate artifacts; the grading program and hidden tests stay in a separate environment.`})}),`\n`,_jsx(_components.p,{children:`Back to the parser task: behavior tests, regression of existing functionality, and integrity checks should each report their own result. The task only counts as done when all three pass. A pass obtained by deleting tests can’t be offset by extra points elsewhere.`}),`\n`,_jsxs(_components.p,{children:[`For example, in the sample record below, execution ended normally and the behavior tests passed, but a protected file was modified, so `,_jsx(_components.code,{children:`accepted`}),` is still false. This is an example data structure, not a real score.`]}),`\n`,_jsx(CodeBlock,{filename:``,numberOfLines:`12`,language:`json`,children:_jsx(_components.pre,{className:`shiki shiki-themes github-light-default dark-plus`,style:{backgroundColor:`#ffffff`,\"--shiki-dark-bg\":`#0B0C0E`,color:`#1f2328`,\"--shiki-dark\":`#D4D4D4`},language:`json`,children:_jsxs(_components.code,{language:`json`,numberOfLines:`12`,children:[_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`{`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"trial_id\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"parser-compat-017/B/03\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"execution\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`}),_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`\"status\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"succeeded\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`},`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"validity\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`}),_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`\"status\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"valid\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`},`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"checks\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: {`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"behavior\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"pass\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"regression\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"pass\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`    \"integrity\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"fail\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`  },`})}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"accepted\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0550AE`,\"--shiki-dark\":`#569CD6`},children:`false`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`,`})]}),`\n`,_jsxs(_components.span,{className:`line`,children:[_jsx(_components.span,{style:{color:`#116329`,\"--shiki-dark\":`#9CDCFE`},children:`  \"failure_code\"`}),_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`: `}),_jsx(_components.span,{style:{color:`#0A3069`,\"--shiki-dark\":`#CE9178`},children:`\"protected_file_changed\"`})]}),`\n`,_jsx(_components.span,{className:`line`,children:_jsx(_components.span,{style:{color:`#1F2328`,\"--shiki-dark\":`#D4D4D4`},children:`}`})}),`\n`]})})}),`\n`,_jsx(_components.p,{children:`Once the grader is written, the thing I most want to test is whether it accepts bad answers. Not changing the code at all, fixing only the ordinary inputs, deleting tests, and faking output can all serve as test samples. Add cases that use file links to bypass protected paths. A reference fix passing only verifies half of the grader’s job.`}),`\n`,_jsx(_components.p,{children:`Questions like “is this implementation overly complex” are hard to write as automatic assertions and can go to an LLM judge. Pin the model and rubric, and require conclusions to cite specific files or trajectory positions. For pairwise review, hide candidate identity, randomly swap the order, and check for misjudgments against human-labeled samples. Text the agent leaves behind is material to be judged; even if it says “ignore the previous grading rules,” it can never become an instruction to the judge.`}),`\n`,_jsx(Heading,{level:`2`,id:`05-an-experiment-on-a-compaction-change`,children:`05 An experiment on a compaction change`}),`\n`,_jsx(_components.p,{children:`With a run-and-verify pipeline in place, we can return to the opening question: does improving how a checkpoint preserves user constraints reduce constraint violations after compaction?`}),`\n`,_jsx(_components.p,{children:`MiniMax Code’s compaction already includes tool-output archiving, checkpoints, and programmatically appended recent state. This time only the way constraints are preserved changes; other prompts, archive thresholds, the model, and the budget stay the same. Change several things at once, and even if results improve, it’s hard to tell which change did it.`}),`\n`,_jsx(_components.p,{children:`I’d run this experiment at two levels. First, test the local mechanism: wait for tool calls to settle and background writes to stop, save a shared pre-compaction state, and let the baseline and candidate each continue from there. Observe whether user constraints survive, whether earlier evidence can be read back, whether work gets repeated afterward, and whether the task completes.`}),`\n`,_jsx(_components.p,{children:`That state can’t be just the messages. The workspace, session, compaction state, and archived artifacts referenced later all have to be restored; for tasks that depend on databases or external services, those resources have to be restored too. Archive files that are readable on the original machine but whose references break in a different directory will also skew the experiment. The public CLI can’t currently perform this fork in one step; it needs separate test interfaces for triggering compaction and restoring state.`}),`\n`,_jsx(_components.p,{children:`Then run end-to-end experiments from the task’s starting point, using the context capacity and trigger policy actually deployed. The candidate might trigger compaction earlier, or read files fewer times, or change the order of tool calls. All of these are effects of the full policy and should be counted.`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-compaction.jpg?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=0ed01328af492446b6b595f21990d785`,alt:`Evaluate compaction at two levels: a local mechanism test and an end-to-end evaluation`,\"data-og-width\":`1536`,width:`1536`,\"data-og-height\":`1024`,height:`1024`,\"data-path\":`images/techblog/eval-compaction.jpg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-compaction.jpg?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=07cdee47c011a51a3f6bd3f4473d06a7 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-compaction.jpg?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=83b75916c1e96ebd0865aeed06d6fb1e 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-compaction.jpg?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=81e83097785c55a501702a3c92f6cc43 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-compaction.jpg?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=0a65622988821a25be1ac2d53f28cfbe 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-compaction.jpg?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=649260a3a8ad51fa8a921cd788f74b9e 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-compaction.jpg?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=9c48bb26ff74e7b824d7a9b97d788483 2500w`}),`\n`,_jsx(_components.p,{children:_jsx(_components.em,{children:`Report the two kinds of experiments separately: local experiments compare behavior from the same starting point; end-to-end experiments observe the whole task.`})}),`\n`,_jsx(_components.p,{children:`Some runs may never trigger compaction. They still belong to the end-to-end results and just need to be marked “not triggered.” Comparing only the tasks where compaction happened, after the fact, introduces selection bias: the candidate policy may itself change the trigger probability, so the two sides no longer hold the same set of cases. To explain the causal effect of the compaction step, go back to local experiments with trigger conditions specified in advance.`}),`\n`,_jsx(_components.p,{children:`Tasks also have to be designed so compaction actually matters. For example, a compatibility constraint raised early still has to be honored during later code changes; evidence from early tool output is needed later. Long tasks should cover multiple compactions. Simply stuffing in a large block of irrelevant text can test behavior under long inputs, but it can hardly tell you whether the agent forgets useful information.`}),`\n`,_jsx(Heading,{level:`2`,id:`06-beyond-the-score-what-records-to-keep`,children:`06 Beyond the score: what records to keep`}),`\n`,_jsx(_components.p,{children:`When a task regresses, I want to be able to find what it read, which tools it called, and at which step it drifted from the requirements. When the grader changes, it should be possible to re-verify old artifacts. That’s the practical use of observability in evaluation.`}),`\n`,_jsx(_components.p,{children:`Records can be stored by purpose. The run manifest keeps versions and experimental conditions, the trajectory keeps model and tool events, and the artifact directory holds final files, environment snapshots, and verification output. Re-grading produces a new grade revision linked to the same frozen artifact, without overwriting old scores.`}),`\n`,_jsx(_components.p,{children:`A model name alone isn’t enough for the run manifest. You also need the model configuration and whatever service version is available, the Harness commit, fingerprints of the expanded prompt and tool schemas, and the task and grader versions. Permission policy, resources and budget, experiment group, and repetition index should also be queryable. If the server-side version can’t be pinned, record the run’s time window and carry that limitation into the analysis.`}),`\n`,_jsx(_components.p,{children:`MiniMax Code’s eval reporter already exposes collection interfaces for pre-call model snapshots, tool calls and results, usage, and turn end. Collection failures don’t interrupt the agent’s normal operation — a sensible trade-off for a product. In an evaluation, though, you also need evidence-completeness flags: a call missing from the logs may simply not have been captured.`}),`\n`,_jsxs(_components.p,{children:[`Usage can be missing too. `,_jsx(_components.code,{children:`usageSource`}),` and `,_jsx(_components.code,{children:`usageIncomplete`}),` in `,_jsx(_components.code,{children:`ExecResult`}),` exist for exactly this; in failure, compaction, and similar scenarios, the accounting may be incomplete. When computing cost, keep the unknown part unknown and record the confirmed cost as a lower bound. Filling gaps with zero underestimates cost; directly adding possibly overlapping cache, reasoning, and total-token fields may overcount.`]}),`\n`,_jsx(_components.p,{children:`How failures are handled also needs to be decided up front. The table below is one workable convention:`}),`\n`,_jsxs(Table,{children:[_jsx(_components.thead,{children:_jsxs(_components.tr,{children:[_jsx(_components.th,{children:`Observed situation`}),_jsx(_components.th,{children:`How the result is treated`}),_jsx(_components.th,{children:`Retry?`})]})}),_jsxs(_components.tbody,{children:[_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Image pull fails before the environment starts`}),_jsx(_components.td,{children:`Scheduling infrastructure error; keep the record`}),_jsx(_components.td,{children:`Restart up to a preset limit`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Agent exhausts its budget through looping or expensive operations`}),_jsx(_components.td,{children:`Task failure; counts in the pass-rate denominator`}),_jsx(_components.td,{children:`No re-running until it succeeds`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Candidate hits the declared memory limit`}),_jsx(_components.td,{children:`Run failure under that resource constraint`}),_jsx(_components.td,{children:`Handle per task rules`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`The grader itself crashes`}),_jsx(_components.td,{children:`No valid grade yet; cannot count as a pass`}),_jsx(_components.td,{children:`Re-grade the same frozen artifact`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Compaction events missing, but artifact verification complete`}),_jsx(_components.td,{children:`Task result can be kept; mechanism diagnostics unavailable`}),_jsx(_components.td,{children:`Flag the evidence gap`})]}),_jsxs(_components.tr,{children:[_jsx(_components.td,{children:`Agent actually asks a question that needs a human answer`}),_jsx(_components.td,{children:`Judge by the unattended or interactive task protocol`}),_jsx(_components.td,{children:`No ad-hoc human fallback`})]})]})]}),`\n`,_jsx(_components.p,{children:`Budget exhaustion and machine failure can both look like “the process is gone”; telling them apart takes event and resource records. Each retry keeps the original trial, the reason, and a new attempt ID. Report the infrastructure error rate and task coverage alongside the score; otherwise dropping a few failures makes the numbers look good.`}),`\n`,_jsx(_components.p,{children:`If retries hit the limit with still no valid grade, report the gap and its impact on the conclusions. Model call failures can’t all be written off as external faults either: if this evaluation is meant to test the Harness’s recovery ability, they are part of the test. Which cases are excluded follows what was agreed before the experiment started.`}),`\n`,_jsx(Heading,{level:`2`,id:`07-how-to-compare-two-versions`,children:`07 How to compare two versions`}),`\n`,_jsx(_components.p,{children:`Groups A and B first align on tasks, model configuration, and budget, then run randomly interleaved within the same time window. Concurrency, rate limits, and cache warmth also need to match. If one group runs in the morning and the other at night, service fluctuations can get mixed into the version difference.`}),`\n`,_jsxs(_components.p,{children:[`Resource allocation itself also has to be controlled. Anthropic’s `,_jsx(_components.a,{href:`https://www.anthropic.com/engineering/infrastructure-noise`,children:`research on infrastructure noise`}),` discusses how resource configuration affects agentic coding evals. So CPU, memory, network, and time limits should be recorded along with the model configuration.`]}),`\n`,_jsx(_components.p,{children:`Decide how many times each task runs before starting. First compute each task’s pass rate in both groups, then compare the differences. Write the pass rates for task i as pᴀ,ᵢ and pʙ,ᵢ; with tasks weighted equally, the overall difference is Δ = (1/N) Σᵢ(pʙ,ᵢ − pᴀ,ᵢ). If you want to weight by the real usage distribution, fix the weights in advance. A task shouldn’t count more in the total just because it was run a few more times.`}),`\n`,_jsx(OptimizedImage,{src:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-ab.jpg?fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=a0b73b6ab13f67273a2fbabb3e7eadcc`,alt:`Did the change actually help? Paired A/B tasks, aggregated task-level differences, and an independent holdout`,\"data-og-width\":`1536`,width:`1536`,\"data-og-height\":`1024`,height:`1024`,\"data-path\":`images/techblog/eval-ab.jpg`,\"data-optimize\":`true`,\"data-opv\":`3`,srcset:`https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-ab.jpg?w=280\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=4ae83cf79fad8f04061e426d1c6b0209 280w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-ab.jpg?w=560\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=7d5c3f7fa0a4dc1ce0e7714e965ed84f 560w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-ab.jpg?w=840\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=67ddfd86d8261b0451d84ebf60a2fe9a 840w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-ab.jpg?w=1100\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=d3f8e74b5269e51b8b11ee93b042b89a 1100w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-ab.jpg?w=1650\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=9ee404f43f16c69bc138dee3b36ce476 1650w, https://mintcdn.com/agent-en/7xgBTBZFmaXlhwRp/images/techblog/eval-ab.jpg?w=2500\u0026fit=max\u0026auto=format\u0026n=7xgBTBZFmaXlhwRp\u0026q=85\u0026s=a8c9d06262238d66fb3a3fa761ac1039 2500w`}),`\n`,_jsx(_components.p,{children:_jsx(_components.em,{children:`Compare each task first, then aggregate the differences and the uncertainty; finally verify the frozen candidate on an independent holdout set.`})}),`\n`,_jsx(_components.p,{children:`Repeating the same task ten times shows how unstable runs are, but it still covers just one scenario. To estimate the gain on new tasks, use a paired cluster bootstrap by task, preserving the A/B relationship when resampling. If several tasks come from the same repo and are highly correlated, cluster by repo or task family. With few tasks the interval may not be reliable either, so list per-task results alongside it.`}),`\n`,_jsx(_components.p,{children:`I pay special attention to which failures the candidate newly introduces. A higher overall pass rate can mask a clear regression on one category of tasks. Integrity violations and human interventions get reported separately, and cost includes failed attempts. “Total cost of all attempts in the group / number of successful tasks” can represent cost per completed task; when there are zero successes or usage is incomplete, the estimate must be marked as not computable or incomplete.`}),`\n`,_jsx(_components.p,{children:`Latency reports must keep timeouts too. List the runtime of every attempt and the timeout rate, with latency of successful samples reported separately. A run killed at the deadline can’t count as finishing right at that second. If the product allows taking the best of several attempts, report the number of attempts together with the budget, and don’t compare it directly against single runs.`}),`\n`,_jsx(_components.p,{children:`The bar for accepting a candidate is best written down before the runs start: how much quality regression is tolerable, how much improvement is hoped for, how much cost can increase, and what hard requirements the integrity checks impose. The specific thresholds depend on product goals. Adjusting the bar after seeing scores makes it easy to rationalize a change you already wanted to merge. Even if no violations were observed this time, that only means none showed up in this batch of runs.`}),`\n`,_jsx(Heading,{level:`2`,id:`08-don’t-let-the-eval-set-turn-into-a-dev-set`,children:`08 Don’t let the eval set turn into a dev set`}),`\n`,_jsx(_components.p,{children:`Adding real failures to the regression set is useful. But if we keep tuning the Harness against the same set of tasks, we grow familiar with them, and rising scores don’t necessarily mean better performance on new tasks.`}),`\n`,_jsx(_components.p,{children:`The dev set is for reproducing and tuning, the validation set for choosing candidates, and the final holdout set is only used once a candidate is frozen. Split by repo, problem family, or time period, so the same task can’t appear on both sides under a different name. Once a holdout set has been looked at enough and used to change strategy, admit that it has become part of the dev set.`}),`\n`,_jsx(_components.p,{children:`Compaction experiments can have a targeted task set, but you should also run regressions on common tasks, check for side effects, and add new tasks regularly. Collecting only failure cases overweights hard scenarios; collecting only demo-friendly tasks makes the system look more reliable than it is.`}),`\n`,_jsxs(_components.p,{children:[`Nor does every PR need to run the whole evaluation. Run protocol, grader, and short regressions first; trigger the relevant behavioral evals when compaction, tools, or permissions change. Schedule expensive repeated experiments and new-task testing periodically within budget. `,_jsx(_components.code,{children:`pnpm verify`}),` in the source continues to check engineering correctness, while real-model task performance is evaluated separately, and the two are reported separately.`]}),`\n`,_jsx(_components.p,{children:`If I were starting today, I’d begin with a single task: reset the environment, launch MiniMax Code, verify independently, and leave artifacts that can be re-examined. Then test the grader with a few known-good and known-bad versions. Only after all of that works would I add more tasks and concurrency. Building large-scale scheduling first will most likely just scale up the difficulty of debugging along with it.`}),`\n`,_jsx(_components.p,{children:`MiniMax Code’s public source already includes run entry points, structured events, and evaluation collection interfaces. If you want to get hands-on, you can hook up a Runner, or start by contributing a task that reliably reproduces a failure, or checking whether a grader wrongly accepts bad answers. All of this helps decide whether the next Harness change should stay.`}),`\n`,_jsxs(_components.p,{children:[`The project is on `,_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code`,children:`GitHub`}),`. Come discuss with reproductions and experiments in hand, and if you found this useful, a Star is always welcome.`]}),`\n`,_jsx(Heading,{level:`2`,id:`implementation-and-references`,children:`Implementation and references`}),`\n`,_jsxs(_components.p,{children:[`Source was checked against `,_jsx(_components.code,{children:`14053355f39c`}),`. The task protocol, external Runner, and fork experiments in this post are design proposals; this post did not run online model comparison experiments and does not report performance gains.`]}),`\n`,_jsxs(_components.ul,{children:[`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/tui/src/cli/contract.ts`,children:`MiniMax Code: headless CLI arguments`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/tui/src/headless/events.ts`,children:`MiniMax Code: JSONL events and terminal states`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/tui/src/headless/contract.ts`,children:`MiniMax Code: result and usage contracts`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/tui/src/headless/runner.ts`,children:`MiniMax Code: usage aggregation and incompleteness flags`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/local-runtime-v2/src/service/turn-system/agent-host/runner/eval-reporter.ts`,children:`MiniMax Code: eval reporter seam`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://github.com/MiniMax-AI/minimax-code/blob/14053355f39c9bc4575650ce0f48a3ae3cff9285/packages/local-runtime-v2/src/service/turn-system/compaction/algorithm/checkpoint-format.ts`,children:`MiniMax Code: checkpoint and state preservation`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://docs.harborframework.com/core-concepts/tasks/overview`,children:`Harbor: task structure`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://docs.harborframework.com/core-concepts/tasks/separate-verifier`,children:`Harbor: separate verifier environment`})}),`\n`,_jsx(_components.li,{children:_jsx(_components.a,{href:`https://www.anthropic.com/engineering/infrastructure-noise`,children:`Anthropic: infrastructure noise in agentic evals`})}),`\n`]})]})}function MDXContent(props={}){const{wrapper:MDXLayout}={..._provideComponents(),...props.components};return MDXLayout?_jsx(MDXLayout,{...props,children:_jsx(_createMdxContent,{...props})}):_createMdxContent(props)}return{default:MDXContent};function _missingMdxReference(id,component){throw new Error(`Expected `+(component?`component`:`object`)+\" `\"+id+\"` to be defined: you likely forgot to import, pass, or provide it.\")}"])</script><script>self.__next_f.push([1,"55:[\"$\",\"$L5b\",null,{\"slug\":\"techblog/coding-agent-eval\",\"pageMetadata\":\"$4a:props:pageMetadata\",\"theme\":\"mint\",\"children\":[\"$\",\"$L5c\",null,{\"mdxSource\":{\"compiledSource\":\"$5d\",\"frontmatter\":{},\"scope\":{\"config\":{},\"pageMetadata\":{\"title\":\"Building a Testbed for Coding Agents\",\"sidebarTitle\":\"A Testbed for Coding Agents\",\"description\":\"Starting from MiniMax Code, building an evaluation system that can tell whether a Harness change actually helps.\",\"og:title\":\"Building a Testbed for Coding Agents | MiniMax Code Engineering Notes, Part 2\",\"og:description\":\"Task bundles, the Runner, independent verification, compaction experiments, and A/B comparison — how to know a Harness change really made things better.\",\"href\":\"/techblog/coding-agent-eval\"}}},\"mdxSourceWithNoJs\":\"$undefined\",\"displayDomain\":\"agent.minimax.io/docs\"}]}]\n"])</script></body></html>