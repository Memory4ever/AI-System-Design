</table>
<p id="S8.SS7.p2.2" class="ltx_p"><span id="S8.SS7.p2.2.1" class="ltx_text">The Cauchy-Schwarz inequality, states <math id="S8.SS7.p2.m1" class="ltx_Math" alttext="(\sum u_{i}^{2})(\sum v_{i}^{2})\geq(\sum u_{i}v_{i})^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><msubsup><mi>u</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><msubsup><mi>v</mi><mi>i</mi><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em">∑</mo><mrow><msub><mi>u</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>i</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">(\sum u_{i}^{2})(\sum v_{i}^{2})\geq(\sum u_{i}v_{i})^{2}</annotation></semantics></math>. Let <math id="S8.SS7.p2.m2" class="ltx_Math" alttext="u_{i}=\sigma_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mi>i</mi></msub><mo>=</mo><msub><mi>σ</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">u_{i}=\sigma_{i}</annotation></semantics></math> and <math id="S8.SS7.p2.m3" class="ltx_Math" alttext="v_{i}=1/\sigma_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>=</mo><mrow><mn>1</mn><mo>/</mo><msub><mi>σ</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">v_{i}=1/\sigma_{i}</annotation></semantics></math>.</span></p>
