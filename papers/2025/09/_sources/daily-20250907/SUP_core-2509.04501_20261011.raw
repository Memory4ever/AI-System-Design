<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex67.m1" class="ltx_Math" alttext="\displaystyle=\frac{\sum_{i=1}^{\rho}\sigma_{i}^{2}\left(\frac{1}{\sigma_{i}^{2}}\right)^{2}}{\left(\sum_{j=1}^{\rho}\frac{1}{\sigma_{j}^{2}}\right)^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>ρ</mi></msubsup><mrow><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mn>1</mn><msubsup><mi>σ</mi><mi>i</mi><mn>2</mn></msubsup></mfrac><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow><msup><mrow><mo>(</mo><mrow><msubsup><mo lspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>ρ</mi></msubsup><mfrac><mn>1</mn><msubsup><mi>σ</mi><mi>j</mi><mn>2</mn></msubsup></mfrac></mrow><mo>)</mo></mrow><mn>2</mn></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sum_{i=1}^{\rho}\sigma_{i}^{2}\left(\frac{1}{\sigma_{i}^{2}}\right)^{2}}{\left(\sum_{j=1}^{\rho}\frac{1}{\sigma_{j}^{2}}\right)^{2}}</annotation></semantics></math></td>
