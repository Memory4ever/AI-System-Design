<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex69.m2" class="ltx_Math" alttext="\displaystyle\geq\left(\sum_{i=1}^{\rho}\sigma_{i}\cdot\frac{1}{\sigma_{i}}\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≥</mo><msup><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>ρ</mi></munderover></mstyle><msub><mi>σ</mi><mi>i</mi></msub></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>σ</mi><mi>i</mi></msub></mfrac></mstyle></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\geq\left(\sum_{i=1}^{\rho}\sigma_{i}\cdot\frac{1}{\sigma_{i}}\right)^{2}</annotation></semantics></math></td>
