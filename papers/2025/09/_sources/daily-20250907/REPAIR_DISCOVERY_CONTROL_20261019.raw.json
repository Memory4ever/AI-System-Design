{"data":[{"id":"10.48550/arxiv.2509.05297","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.05297","identifiers":[{"identifier":"2509.05297","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Matteo","familyName":"Poggi","name":"Poggi, Matteo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fabio","familyName":"Tosi","name":"Tosi, Fabio","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"FlowSeek: Optical Flow Made Easier with Depth Foundation Models and Motion Bases"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-05T17:59:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-08T00:51:42Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We present FlowSeek, a novel framework for optical flow requiring minimal hardware resources for training. FlowSeek marries the latest advances on the design space of optical flow networks with cutting-edge single-image depth foundation models and classical low-dimensional motion parametrization, implementing a compact, yet accurate architecture. FlowSeek is trained on a single consumer-grade GPU, a hardware budget about 8x lower compared to most recent methods, and still achieves superior cross-dataset generalization on Sintel Final and KITTI, with a relative improvement of 10 and 15% over the previous state-of-the-art SEA-RAFT, as well as on Spring and LayeredFlow datasets."},{"descriptionType":"Other","description":"ICCV 2025 - Project Page: https://flowseek25.github.io/ - Code: https://github.com/mattpoggi/flowseek"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.05297","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-08T01:45:23Z","registered":"2025-09-08T01:45:23Z","published":null,"updated":"2025-09-08T01:45:23Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?query=doi%3A%2210.48550%2Farxiv.2509.05297%22+AND+registered%3A%5B2025-09-08T00%3A00%3A00Z+TO+2025-09-08T15%3A59%3A59Z%5D\u0026client-id=arxiv.content\u0026page%5Bsize%5D=1"}}