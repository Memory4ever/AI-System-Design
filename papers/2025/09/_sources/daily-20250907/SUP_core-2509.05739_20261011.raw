<p id="A6.SS8.p234.103" class="ltx_p" style="width:345.0pt;"><span id="A6.SS8.p234.103.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:345.0pt;"><span id="A6.SS8.p234.103.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A6.SS8.p234.103.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A6.SS8.p234.103.1.3" class="ltx_text ltx_inline-block" style="width:21.0pt;"> </span><span id="A6.SS8.p234.103.1.4" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:324.0pt;">
