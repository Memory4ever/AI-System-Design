<span id="S3.F1.pic1.3.1" class="ltx_p"></span>
<span id="S3.F1.pic1.3.2" class="ltx_p"><span id="S3.F1.pic1.3.2.1" class="ltx_text ltx_font_sansserif ltx_font_bold" style="--ltx-fg-color:#2D3748;">Automated Reward Scoring</span></span>
<span id="S3.F1.pic1.3.3" class="ltx_p"><span id="S3.F1.pic1.3.3.1" class="ltx_text ltx_font_sansserif ltx_font_bold" style="--ltx-fg-color:#4A5568;">(LLM-as-a-Judge)<span id="S3.F1.pic1.3.3.1.1" class="ltx_text"></span></span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#CBD5E0;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#CBD5E0" stroke-width="0.8pt"><path d="M 476.31 49.21 L 272.69 49.21 C 266.58 49.21 261.62 44.26 261.62 38.14 L 261.62 -38.14 C 261.62 -44.26 266.58 -49.21 272.69 -49.21 L 476.31 -49.21 C 482.43 -49.21 487.38 -44.26 487.38 -38.14 L 487.38 38.14 C 487.38 44.26 482.43 49.21 476.31 49.21 Z M 261.62 -49.21"></path></g><g style="--ltx-stroke-color:#2D3748;--ltx-fill-color:#2D3748;" fill="#2D3748" stroke="#2D3748" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 266.24 5.23)"><foreignObject style="--ltx-fo-width:14.23em;--ltx-fo-height:0.69em;--ltx-fo-depth:1.45em;font-size:10pt;" height="29.67" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="196.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S3.F1.pic1.4" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:14.23em;">
<span id="S3.F1.pic1.4.1" class="ltx_p"></span>
<span id="S3.F1.pic1.4.2" class="ltx_p"><span id="S3.F1.pic1.4.2.1" class="ltx_text ltx_font_sansserif ltx_font_bold" style="--ltx-fg-color:#2D3748;">Policy Optimisation</span></span>
<span id="S3.F1.pic1.4.3" class="ltx_p"><span id="S3.F1.pic1.4.3.1" class="ltx_text ltx_font_sansserif ltx_font_bold" style="--ltx-fg-color:#4A5568;">(GRPO)<span id="S3.F1.pic1.4.3.1.1" class="ltx_text"></span></span></span>
</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#48BB78;--ltx-fill-color:#F0FFF4;" fill="#F0FFF4" stroke="#48BB78" stroke-width="0.8pt"><path d="M 111.65 -129.06 L -111.65 -129.06 C -117.77 -129.06 -122.72 -134.02 -122.72 -140.13 L -122.72 -196.73 C -122.72 -202.84 -117.77 -207.8 -111.65 -207.8 L 111.65 -207.8 C 117.77 -207.8 122.72 -202.84 122.72 -196.73 L 122.72 -140.13 C 122.72 -134.02 117.77 -129.06 111.65 -129.06 Z M -122.72 -207.8"></path></g><g style="--ltx-stroke-color:#2D3748;--ltx-fill-color:#2D3748;" fill="#2D3748" stroke="#2D3748" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -118.11 -171.89)"><foreignObject style="--ltx-fo-width:15.52em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="214.75"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
