<td id="S5.T4.5.1.4.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T4.5.1.4.4.1" class="ltx_text ltx_font_bold">0.880</span></td>
<td id="S5.T4.5.1.4.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T4.5.1.4.5.1" class="ltx_text ltx_font_bold">0.803</span></td>
