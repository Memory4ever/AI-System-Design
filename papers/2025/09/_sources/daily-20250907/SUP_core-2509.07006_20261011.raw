<td id="S5.T3.5.1.4.4" class="ltx_td ltx_nopad_r ltx_align_right"><span id="S5.T3.5.1.4.4.1" class="ltx_text ltx_font_bold">-7.4%</span></td></tr>
<tr id="S5.T3.5.1.5" class="ltx_tr">
