                <span id="lstnumberx58.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">    </span><span id="lstnumberx58.3" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#0000FF;">if</span><span id="lstnumberx58.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx58.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">resp_scope</span><span id="lstnumberx58.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx58.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;">==</span><span id="lstnumberx58.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx58.9" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#990033;">"S1"</span><span id="lstnumberx58.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx58.11" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#0000FF;">and</span><span id="lstnumberx58.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx58.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">prompt_scope</span><span id="lstnumberx58.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx58.15" class="ltx_text ltx_font_typewriter" style="font-size:80%;">!=</span><span id="lstnumberx58.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx58.17" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#990033;">"S0"</span><span id="lstnumberx58.18" class="ltx_text ltx_font_typewriter" style="font-size:80%;">:</span>
