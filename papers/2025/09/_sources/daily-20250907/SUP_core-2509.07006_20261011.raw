<td id="S5.T3.5.1.3.3" class="ltx_td ltx_align_center"><span id="S5.T3.5.1.3.3.1" class="ltx_text ltx_font_bold">0.9641 ± 0.0253</span></td>
<td id="S5.T3.5.1.3.4" class="ltx_td ltx_nopad_r ltx_align_right"><span id="S5.T3.5.1.3.4.1" class="ltx_text ltx_font_bold">+70.9%</span></td></tr>
<tr id="S5.T3.5.1.4" class="ltx_tr">
<td id="S5.T3.5.1.4.1" class="ltx_td ltx_align_left">Average Helpfulness Score</td>
