<td id="S5.T6.7.1.3.5" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S5.T6.7.1.3.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">-0.6%</span></td></tr>
