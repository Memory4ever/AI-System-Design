<span id="S3.T2.3.2.3.1.1" class="ltx_p"><span id="S3.T2.3.2.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Optional</span><span id="S3.T2.3.2.3.1.1.2" class="ltx_text" style="font-size:80%;"> (</span><math id="S3.T2.m1" class="ltx_Math" alttext="&lt;1\,\text{h}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.800em">&lt;</mo><mrow><mn mathsize="0.800em">1</mn><mo lspace="0.170em" rspace="0em">​</mo><mtext mathsize="0.800em">h</mtext></mrow></mrow><annotation encoding="application/x-tex">&lt;1\,\text{h}</annotation></semantics></math><span id="S3.T2.3.2.3.1.1.3" class="ltx_text" style="font-size:80%;"> on subset)</span></span>
</span></td>
<td id="S3.T2.3.2.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.2.4.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.2.4.1.1" class="ltx_p"><span id="S3.T2.3.2.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Minutes</span></span>
</span></td></tr>
<tr id="S3.T2.3.3" class="ltx_tr">
<td id="S3.T2.3.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.3.1.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.3.1.1.1" class="ltx_p"><span id="S3.T2.3.3.1.1.1.1" class="ltx_text" style="font-size:80%;">Constitutional AI</span></span>
</span></td>
<td id="S3.T2.3.3.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.3.2.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="S3.T2.3.3.2.1.1" class="ltx_p"><span id="S3.T2.3.3.2.1.1.1" class="ltx_text" style="font-size:80%;">Draft new constitutional clause; collect critiques; SL+RL fine-tune full model</span></span>
</span></td>
<td id="S3.T2.3.3.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.3.3.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.3.3.1.1" class="ltx_p"><span id="S3.T2.3.3.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Yes</span><span id="S3.T2.3.3.3.1.1.2" class="ltx_text" style="font-size:80%;"> (multi-day)</span></span>
</span></td>
<td id="S3.T2.3.3.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.3.4.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.3.4.1.1" class="ltx_p"><span id="S3.T2.3.3.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Days → Weeks</span></span>
</span></td></tr>
<tr id="S3.T2.3.4" class="ltx_tr">
<td id="S3.T2.3.4.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.4.1.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.4.1.1.1" class="ltx_p"><span id="S3.T2.3.4.1.1.1.1" class="ltx_text" style="font-size:80%;">RLAIF/RLHF</span></span>
</span></td>
<td id="S3.T2.3.4.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.4.2.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="S3.T2.3.4.2.1.1" class="ltx_p"><span id="S3.T2.3.4.2.1.1.1" class="ltx_text" style="font-size:80%;">Gather new preference data; retrain reward model; run RL fine-tuning</span></span>
</span></td>
<td id="S3.T2.3.4.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.4.3.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.4.3.1.1" class="ltx_p"><span id="S3.T2.3.4.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Yes</span><span id="S3.T2.3.4.3.1.1.2" class="ltx_text" style="font-size:80%;"> (GPU-intensive)</span></span>
</span></td>
<td id="S3.T2.3.4.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.4.4.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.4.4.1.1" class="ltx_p"><span id="S3.T2.3.4.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Days</span></span>
</span></td></tr>
<tr id="S3.T2.3.5" class="ltx_tr">
<td id="S3.T2.3.5.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.5.1.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.5.1.1.1" class="ltx_p"><span id="S3.T2.3.5.1.1.1.1" class="ltx_text" style="font-size:80%;">DPO</span></span>
</span></td>
<td id="S3.T2.3.5.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.5.2.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="S3.T2.3.5.2.1.1" class="ltx_p"><span id="S3.T2.3.5.2.1.1.1" class="ltx_text" style="font-size:80%;">Curate new positive/negative responses; run closed-form update</span></span>
</span></td>
<td id="S3.T2.3.5.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.5.3.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.5.3.1.1" class="ltx_p"><span id="S3.T2.3.5.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Yes</span><span id="S3.T2.3.5.3.1.1.2" class="ltx_text" style="font-size:80%;"> (fastest of end-to-end)</span></span>
</span></td>
<td id="S3.T2.3.5.4" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.3.5.4.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.5.4.1.1" class="ltx_p"><span id="S3.T2.3.5.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Hours</span></span>
</span></td></tr>
<tr id="S3.T2.3.6" class="ltx_tr">
<td id="S3.T2.3.6.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="S3.T2.3.6.1.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S3.T2.3.6.1.1.1" class="ltx_p"><span id="S3.T2.3.6.1.1.1.1" class="ltx_text" style="font-size:80%;">ReAct + Filters</span></span>
</span></td>
