</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#F97316;--ltx-fill-color:#FFEDD5;" fill="#FFEDD5" stroke="#F97316" stroke-width="0.8pt"><path d="M 101.81 -199.06 L -101.81 -199.06 C -107.92 -199.06 -112.88 -204.02 -112.88 -210.13 L -112.88 -266.73 C -112.88 -272.85 -107.92 -277.8 -101.81 -277.8 L 101.81 -277.8 C 107.92 -277.8 112.88 -272.85 112.88 -266.73 L 112.88 -210.13 C 112.88 -204.02 107.92 -199.06 101.81 -199.06 Z M -112.88 -277.8"></path></g><g style="--ltx-stroke-color:#2D3748;--ltx-fill-color:#2D3748;" fill="#2D3748" stroke="#2D3748" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 -108.27 -216.99)"><foreignObject style="--ltx-fo-width:14.23em;--ltx-fo-height:0.75em;--ltx-fo-depth:3.85em;font-size:10pt;" height="63.65" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="196.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
