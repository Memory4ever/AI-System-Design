<td id="S5.T3.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">0.6359</td>
<td id="S5.T3.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.5.1.2.3.1" class="ltx_text ltx_font_bold">0.7947 ± 0.0166</span></td>
<td id="S5.T3.5.1.2.4" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t"><span id="S5.T3.5.1.2.4.1" class="ltx_text ltx_font_bold">+25.0%</span></td></tr>
