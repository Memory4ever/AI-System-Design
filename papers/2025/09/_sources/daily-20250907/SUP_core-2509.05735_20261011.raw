             <span id="alg3.l7a.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l7a.m1" class="ltx_Math" alttext="i\%N==0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#E19C24;" mathcolor="#E19C24">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">%</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#E19C24;" mathcolor="#E19C24">N</mi></mrow><mo style="--ltx-fg-color:#E19C24;" mathcolor="#E19C24">=</mo><mphantom></mphantom><mo style="--ltx-fg-color:#E19C24;" mathcolor="#E19C24">=</mo><mn style="--ltx-fg-color:#E19C24;" mathcolor="#E19C24">0</mn></mrow><annotation encoding="application/x-tex">i\%N==0</annotation></semantics></math><span id="alg3.l7a.4" class="ltx_text" style="--ltx-fg-color:#E19C24;"> </span> <span id="alg3.l7a.5" class="ltx_text ltx_font_bold">then</span>   <span id="alg3.l7a.6" class="ltx_text" style="--ltx-fg-color:#929500;">// <math id="alg3.l7a.m2" class="ltx_Math" alttext="N=4\mathrm{K},20\mathrm{K},200\mathrm{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#929500;" mathcolor="#929500">N</mi><mo style="--ltx-fg-color:#929500;" mathcolor="#929500">=</mo><mrow><mn style="--ltx-fg-color:#929500;" mathcolor="#929500">4</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#929500;" mathcolor="#929500">K</mi></mrow></mrow><mo style="--ltx-fg-color:#929500;" mathcolor="#929500">,</mo><mrow><mn style="--ltx-fg-color:#929500;" mathcolor="#929500">20</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#929500;" mathcolor="#929500">K</mi></mrow><mo style="--ltx-fg-color:#929500;" mathcolor="#929500">,</mo><mrow><mn style="--ltx-fg-color:#929500;" mathcolor="#929500">200</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#929500;" mathcolor="#929500">K</mi></mrow></mrow><annotation encoding="application/x-tex">N=4\mathrm{K},20\mathrm{K},200\mathrm{K}</annotation></semantics></math></span>

