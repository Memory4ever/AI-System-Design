             <span id="alg3.l7b.3" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l7b.m1" class="ltx_Math" alttext="i\%5\mathrm{K}==0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">%</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mn style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">5</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">K</mi></mrow><mo style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">=</mo><mphantom></mphantom><mo style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">=</mo><mn style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">0</mn></mrow><annotation encoding="application/x-tex">i\%5\mathrm{K}==0</annotation></semantics></math><span id="alg3.l7b.4" class="ltx_text" style="--ltx-fg-color:#AF4BCE;"> and <math id="alg3.l7b.m2" class="ltx_Math" alttext="\mathrm{ood\_ratio}_{i}&gt;\mathrm{thres.}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">ood</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">_</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">ratio</mi><mi style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">i</mi></msub></mrow><mo style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">&gt;</mo><mi style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">thres</mi></mrow><mo style="--ltx-fg-color:#AF4BCE;" lspace="0em" mathcolor="#AF4BCE">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{ood\_ratio}_{i}&gt;\mathrm{thres.}</annotation></semantics></math></span> <span id="alg3.l7b.5" class="ltx_text ltx_font_bold">then</span>

</div>
