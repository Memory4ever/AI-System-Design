</div>
</div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="alg2.6" class="ltx_p ltx_figure_panel"><span id="alg2.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#AF4BCE;">Passive_sameWM (frozen)</span></p></div><div class="ltx_flex_break"></div>
<div id="alg2.7" class="ltx_listing ltx_listing">
<div id="alg2.l1a" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1a.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg2.l1a.3" class="ltx_text ltx_font_bold">Initialize:</span> Replay buffer <math id="alg2.l1a.m1" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> = final <math id="alg2.l1a.m2" class="ltx_Math" alttext="\mathcal{B}_{A}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#E06363;" class="ltx_font_mathcaligraphic" mathcolor="#E06363">ℬ</mi><mi style="--ltx-fg-color:#E06363;" mathcolor="#E06363">A</mi></msub><annotation encoding="application/x-tex">\mathcal{B}_{A}</annotation></semantics></math>.

</div>
<div id="alg2.l2a" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2a.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            World model <math id="alg2.l2a.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> = final <math id="alg2.l2a.m2" class="ltx_Math" alttext="M_{A}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#E06363;" mathcolor="#E06363">M</mi><mi style="--ltx-fg-color:#E06363;" mathcolor="#E06363">A</mi></msub><annotation encoding="application/x-tex">M_{A}</annotation></semantics></math>, only Policy <math id="alg2.l2a.m3" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> by seed <math id="alg2.l2a.m4" class="ltx_Math" alttext="S_{P}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">S</mi><mi style="--ltx-fg-color:#AF4BCE;" mathcolor="#AF4BCE">P</mi></msub><annotation encoding="application/x-tex">S_{P}</annotation></semantics></math>.

</div>
<div id="alg2.l3a" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3a.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg2.l3a.3" class="ltx_text ltx_font_bold">for</span> each step <math id="alg2.l3a.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> <span id="alg2.l3a.4" class="ltx_text ltx_font_bold">do</span>

