<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
             Update <math id="alg1.l5.m1" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> using <math id="alg1.l5.m2" class="ltx_Math" alttext="\mathcal{D}^{i}_{A}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒟</mi><mi>A</mi><mi>i</mi></msubsup><annotation encoding="application/x-tex">\mathcal{D}^{i}_{A}</annotation></semantics></math>

