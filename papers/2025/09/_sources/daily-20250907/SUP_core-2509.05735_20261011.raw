             Sample <math id="alg2.l5.m1" class="ltx_Math" alttext="{\color[rgb]{0.8789,0.3867,0.3867}\mathcal{D}^{i}_{A}}\sim\mathcal{B}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#E06363;" class="ltx_font_mathcaligraphic" mathcolor="#E06363">𝒟</mi><mi style="--ltx-fg-color:#E06363;" mathcolor="#E06363">A</mi><mi style="--ltx-fg-color:#E06363;" mathcolor="#E06363">i</mi></msubsup><mo>∼</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow><annotation encoding="application/x-tex">{\color[rgb]{0.8789,0.3867,0.3867}\mathcal{D}^{i}_{A}}\sim\mathcal{B}</annotation></semantics></math>

