<p id="alg1.6" class="ltx_p ltx_figure_panel"><span id="alg1.6.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#5E81B5;">Passive Agent</span></p></div><div class="ltx_flex_break"></div>
<div id="alg1.7" class="ltx_listing ltx_listing">
<div id="alg1.l1a" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1a.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <span id="alg1.l1a.3" class="ltx_text ltx_font_bold">Initialize:</span> Replay buffer <math id="alg1.l1a.m1" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math> = final <math id="alg1.l1a.m2" class="ltx_Math" alttext="\mathcal{B}_{A}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#E06363;" class="ltx_font_mathcaligraphic" mathcolor="#E06363">ℬ</mi><mi style="--ltx-fg-color:#E06363;" mathcolor="#E06363">A</mi></msub><annotation encoding="application/x-tex">\mathcal{B}_{A}</annotation></semantics></math>.

</div>
