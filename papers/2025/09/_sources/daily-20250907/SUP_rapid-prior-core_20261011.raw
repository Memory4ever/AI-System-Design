<tr id="S5.T4.6.1.2" class="ltx_tr">
<td id="S5.T4.6.1.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T4.6.1.2.1.1" class="ltx_text" style="font-size:70%;">RPC Calls</span></td>
<td id="S5.T4.6.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T4.6.1.2.2.1" class="ltx_text" style="font-size:70%;">522,230</span></td>
<td id="S5.T4.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T4.6.1.2.3.1" class="ltx_text" style="font-size:70%;">2,129,287</span></td>
<td id="S5.T4.6.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.m1" class="ltx_Math" alttext="\sim" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">∼</mo><annotation encoding="application/x-tex">\sim</annotation></semantics></math><span id="S5.T4.6.1.2.4.1" class="ltx_text" style="font-size:70%;">4</span><math id="S5.T4.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.700em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math><span id="S5.T4.6.1.2.4.2" class="ltx_text" style="font-size:70%;"> fewer</span></td></tr>
