<section id="S8" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">8 </span>Appendix</h2>

<section id="S8.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">8.1 </span>Proof</h3>

<div id="S8.SS1.p1" class="ltx_para">
<p id="S8.SS1.p1.1" class="ltx_p"><span id="S8.SS1.p1.1.1" class="ltx_text ltx_font_bold">Theorem</span> <a href="#S3.E13" title="In 3.2.2 Positional Information Capacity ‣ 3.2 Theoretical Analysis ‣ 3 HoPE ‣ HoPE: Hyperbolic Rotary Positional Encoding for Stable Long-Range Dependency Modeling in Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a> (Positional Discrimination Capacity)
For any relative position <math id="S8.SS1.p1.m1" class="ltx_Math" alttext="r\in\mathbb{Z}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mi>ℤ</mi></mrow><annotation encoding="application/x-tex">r\in\mathbb{Z}</annotation></semantics></math> and query vector <math id="S8.SS1.p1.m2" class="ltx_Math" alttext="q,~\exists" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo rspace="0.497em">,</mo><mo>∃</mo></mrow><annotation encoding="application/x-tex">q,~\exists</annotation></semantics></math> key vector <math id="S8.SS1.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> such that:</p>
<table id="S8.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.E15.m1" class="ltx_Math" alttext="\underset{s}{\mathrm{argmax}}(\langle f_{q}(m),f_{k}(m+s)\rangle)=r" display="block" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mi>argmax</mi><mo mathsize="0.700em">𝑠</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>f</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>f</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\underset{s}{\mathrm{argmax}}(\langle f_{q}(m),f_{k}(m+s)\rangle)=r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
</div>
<div id="S8.SS1.p2" class="ltx_para">
<p id="S8.SS1.p2.1" class="ltx_p">Frist, considering the 2-dimensional case, the attention weight can be calculated as:</p>
<table id="S8.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S8.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.E16.m1" class="ltx_Math" alttext="\displaystyle V(q_{m},k_{n})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>m</mi></msub><mo>,</mo><msub><mi>k</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V(q_{m},k_{n})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E16.m2" class="ltx_Math" alttext="\displaystyle=\boldsymbol{q}_{m}^{T}B(\theta,m)B^{\prime}(\theta,n)\boldsymbol{k}_{n}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝒒</mi><mi>m</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\boldsymbol{q}_{m}^{T}B(\theta,m)B^{\prime}(\theta,n)\boldsymbol{k}_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="S8.SS1.p2.2" class="ltx_p">if</p>
<table id="S8.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.E17.m1" class="ltx_Math" alttext="\underset{s}{\mathrm{argmax}}(\langle f_{q}(m),f_{k}(m+s)\rangle)=t\neq r" display="block" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mi>argmax</mi><mo mathsize="0.700em">𝑠</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>f</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>f</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>t</mi><mo>≠</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\underset{s}{\mathrm{argmax}}(\langle f_{q}(m),f_{k}(m+s)\rangle)=t\neq r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="S8.SS1.p2.3" class="ltx_p">which means</p>
<table id="S8.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S8.E18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.E18.m1" class="ltx_Math" alttext="\displaystyle V(q_{m},k_{t})" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>m</mi></msub><mo>,</mo><msub><mi>k</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V(q_{m},k_{t})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E18.m2" class="ltx_Math" alttext="\displaystyle&gt;V(q_{m},k_{r})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>&gt;</mo><mrow><mi>V</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>m</mi></msub><mo>,</mo><msub><mi>k</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle&gt;V(q_{m},k_{r})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(18)</span></td></tr></tbody>
</table>
<p id="S8.SS1.p2.4" class="ltx_p">such that</p>
<table id="S8.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S8.E19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.E19.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{q}_{m}^{T}B(\theta,m)B^{\prime}(\theta,t)\boldsymbol{k}_{t}&gt;\boldsymbol{q}_{m}^{T}B(\theta,m)B^{\prime}(\theta,r)\boldsymbol{k}_{r}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝒒</mi><mi>m</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>t</mi></msub></mrow><mo>&gt;</mo><mrow><msubsup><mi>𝒒</mi><mi>m</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>r</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{q}_{m}^{T}B(\theta,m)B^{\prime}(\theta,t)\boldsymbol{k}_{t}&gt;\boldsymbol{q}_{m}^{T}B(\theta,m)B^{\prime}(\theta,r)\boldsymbol{k}_{r}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
</table>
<p id="S8.SS1.p2.5" class="ltx_p">We only need to reconstruct <math id="S8.SS1.p2.m1" class="ltx_Math" alttext="\boldsymbol{k}_{r}" display="inline" intent=":literal"><semantics><msub><mi>𝒌</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\boldsymbol{k}_{r}</annotation></semantics></math> so that</p>
<table id="S8.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S8.E20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.E20.m1" class="ltx_Math" alttext="\displaystyle\boldsymbol{k}_{r}&gt;\frac{B^{\prime}(\theta,t)}{B^{\prime}(\theta,r)}\boldsymbol{k}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒌</mi><mi>r</mi></msub><mo>&gt;</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msup><mi>B</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝒌</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\boldsymbol{k}_{r}&gt;\frac{B^{\prime}(\theta,t)}{B^{\prime}(\theta,r)}\boldsymbol{k}_{t}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="S8.SS1.p2.6" class="ltx_p">So,in 2-dimension case,<math id="S8.SS1.p2.m2" class="ltx_Math" alttext="\exists" display="inline" intent=":literal"><semantics><mo>∃</mo><annotation encoding="application/x-tex">\exists</annotation></semantics></math> key vector <math id="S8.SS1.p2.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> such that:</p>
<table id="S8.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.E21.m1" class="ltx_Math" alttext="\underset{s}{\mathrm{argmax}}(\langle f_{q}(m),f_{k}(m+s)\rangle)=r" display="block" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mi>argmax</mi><mo mathsize="0.700em">𝑠</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>f</mi><mi>q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>f</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>m</mi><mo>+</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\underset{s}{\mathrm{argmax}}(\langle f_{q}(m),f_{k}(m+s)\rangle)=r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="S8.SS1.p2.7" class="ltx_p">When generalized to 2-n dimensions, the theorem maintains its original properties. By constructing k in this way for every 2-dimensional subspace, it ensures that</p>
<table id="S8.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S8.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.E22.m1" class="ltx_Math" alttext="\displaystyle\underset{s}{\mathrm{argmax}}\sum_{k=1}^{n}\left(\mathbf{q}_{m}^{(k)}\right)^{\top}\rho(g_{k})^{m-n}\mathbf{k}_{n}^{(k)}=r" display="inline" intent=":literal"><semantics><mrow><mrow><munder accentunder="true"><mi>argmax</mi><mo mathsize="0.700em">𝑠</mo></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msup><mrow><mo>(</mo><msubsup><mi>𝐪</mi><mi>m</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>m</mi><mo>−</mo><mi>n</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐤</mi><mi>n</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><mo>=</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\displaystyle\underset{s}{\mathrm{argmax}}\sum_{k=1}^{n}\left(\mathbf{q}_{m}^{(k)}\right)^{\top}\rho(g_{k})^{m-n}\mathbf{k}_{n}^{(k)}=r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="S8.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">8.2 </span>Analysis of RoPE and HoPE</h3>

<section id="S8.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">8.2.1 </span>RoPE</h4>

<div id="S8.SS2.SSS1.p1" class="ltx_para">
<p id="S8.SS2.SSS1.p1.1" class="ltx_p">For simplicity of notation in this work, we follow the assumption <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib4" title="" class="ltx_ref">Barbero et al. (2024)</a></cite> that queries and keys are <math id="S8.SS2.SSS1.p1.m1" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> dimensional vectors with <math id="S8.SS2.SSS1.p1.m2" class="ltx_Math" alttext="d\geq 2" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">d\geq 2</annotation></semantics></math> being an even number. We decompose queries and keys into 2-dimensional chunks <math id="S8.SS2.SSS1.p1.m3" class="ltx_Math" alttext="\mathbf{q}_{i}=\bigoplus_{k=1,\ldots,d/2}\mathbf{q}_{i}^{[k,k+1]}=\bigoplus_{k=1,\ldots,d/2}\mathbf{q}_{i}^{(k)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐪</mi><mi>i</mi></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>d</mi><mo>/</mo><mn>2</mn></mrow></mrow></msub><msubsup><mi>𝐪</mi><mi>i</mi><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></msubsup></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>d</mi><mo>/</mo><mn>2</mn></mrow></mrow></msub><msubsup><mi>𝐪</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathbf{q}_{i}=\bigoplus_{k=1,\ldots,d/2}\mathbf{q}_{i}^{[k,k+1]}=\bigoplus_{k=1,\ldots,d/2}\mathbf{q}_{i}^{(k)}</annotation></semantics></math>, where <math id="S8.SS2.SSS1.p1.m4" class="ltx_Math" alttext="\bigoplus" display="inline" intent=":literal"><semantics><mo>⨁</mo><annotation encoding="application/x-tex">\bigoplus</annotation></semantics></math> denotes direct sum (concatenation). In other words, we denote by <math id="S8.SS2.SSS1.p1.m5" class="ltx_Math" alttext="\mathbf{q}_{i}^{(k)}\in\mathbb{R}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐪</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\mathbf{q}_{i}^{(k)}\in\mathbb{R}^{2}</annotation></semantics></math> the <math id="S8.SS2.SSS1.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>-th 2-dimensional chunk of the query vector of the <math id="S8.SS2.SSS1.p1.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th token, using analogous notation for the key vectors.</p>
</div>
<div id="S8.SS2.SSS1.p2" class="ltx_para">
<p id="S8.SS2.SSS1.p2.1" class="ltx_p">RoPE considers a sequence of angles <math id="S8.SS2.SSS1.p2.m1" class="ltx_math_unparsed" alttext="G=\left(g_{k}=\theta^{-2(k-1)/d}:k=1,\ldots,d/2\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><msup><mrow><mo>(</mo><msub><mi>g</mi><mi>k</mi></msub><mo>=</mo><msup><mi>θ</mi><mrow><mo>−</mo><mn>2</mn><mo stretchy="false">(</mo><mi>k</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo>/</mo><mi>d</mi></mrow></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mi>k</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi><mo>/</mo><mn>2</mn><mo>)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">G=\left(g_{k}=\theta^{-2(k-1)/d}:k=1,\ldots,d/2\right)^{2}</annotation></semantics></math>, where <math id="S8.SS2.SSS1.p2.m2" class="ltx_Math" alttext="g_{1}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">g_{1}=1</annotation></semantics></math> is the fastest rotating component at 1 radian per token and <math id="S8.SS2.SSS1.p2.m3" class="ltx_math_unparsed" alttext="g_{d/2}=\theta^{-(d-2)/d}\approx\theta^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><msub><mrow></mrow><mrow><mi>d</mi><mo>/</mo><mn>2</mn></mrow></msub><mo>=</mo><mi>θ</mi><msup><mrow></mrow><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>d</mi><mo>−</mo><mn>2</mn><mo stretchy="false">)</mo><mo>/</mo><mi>d</mi></mrow></msup><mo>≈</mo><mi>θ</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">g_{d/2}=\theta^{-(d-2)/d}\approx\theta^{-1}</annotation></semantics></math> the slowest rotating component at approximately <math id="S8.SS2.SSS1.p2.m4" class="ltx_Math" alttext="1/\theta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">1/\theta</annotation></semantics></math> rotations per token. The parameter <math id="S8.SS2.SSS1.p2.m5" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> is called the base wavelength, which by default is 10,000. We denote by <math id="S8.SS2.SSS1.p2.m6" class="ltx_Math" alttext="\rho(g_{k})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(g_{k})</annotation></semantics></math> the matrix form of <math id="S8.SS2.SSS1.p2.m7" class="ltx_Math" alttext="g_{k}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>k</mi></msub><annotation encoding="application/x-tex">g_{k}</annotation></semantics></math>:</p>
<table id="S8.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.E23.m1" class="ltx_Math" alttext="\rho(g_{k})=\begin{bmatrix}\cos(g_{k})&amp;-\sin(g_{k})\\
\sin(g_{k})&amp;\cos(g_{k})\end{bmatrix}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mo rspace="0.167em">−</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\rho(g_{k})=\begin{bmatrix}\cos(g_{k})&amp;-\sin(g_{k})\\
\sin(g_{k})&amp;\cos(g_{k})\end{bmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="S8.SS2.SSS1.p2.2" class="ltx_p">highlighting that <math id="S8.SS2.SSS1.p2.m8" class="ltx_Math" alttext="\rho(g_{k})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(g_{k})</annotation></semantics></math> is a 2-dimensional orthogonal transformation (rotation). One can view <math id="S8.SS2.SSS1.p2.m9" class="ltx_Math" alttext="\rho(g_{k})" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho(g_{k})</annotation></semantics></math> as a ‘unit rotation’ by <math id="S8.SS2.SSS1.p2.m10" class="ltx_Math" alttext="g_{k}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>k</mi></msub><annotation encoding="application/x-tex">g_{k}</annotation></semantics></math> radians. The RoPE technique amounts to the construction of a block-diagonal matrix <math id="S8.SS2.SSS1.p2.m11" class="ltx_Math" alttext="\mathbf{R}^{i}=\bigoplus_{k=1,\ldots,d/2}\rho(g_{k})^{i}\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐑</mi><mi>i</mi></msup><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>d</mi><mo>/</mo><mn>2</mn></mrow></mrow></msub><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mi>i</mi></msup></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{R}^{i}=\bigoplus_{k=1,\ldots,d/2}\rho(g_{k})^{i}\in\mathbb{R}^{d\times d}</annotation></semantics></math>, where each <math id="S8.SS2.SSS1.p2.m12" class="ltx_Math" alttext="2\times 2" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">2\times 2</annotation></semantics></math> block on the diagonal is a rotation by a different frequency of RoPE. The <math id="S8.SS2.SSS1.p2.m13" class="ltx_Math" alttext="\mathbf{R}^{i}" display="inline" intent=":literal"><semantics><msup><mi>𝐑</mi><mi>i</mi></msup><annotation encoding="application/x-tex">\mathbf{R}^{i}</annotation></semantics></math> denotes in fact matrix exponentiation by an integer <math id="S8.SS2.SSS1.p2.m14" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, which is the position of <math id="S8.SS2.SSS1.p2.m15" class="ltx_Math" alttext="\mathbf{x}_{i}" display="inline" intent=":literal"><semantics><msub><mi>𝐱</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\mathbf{x}_{i}</annotation></semantics></math>. We can exploit a nice property of rotation matrices, i.e., that <math id="S8.SS2.SSS1.p2.m16" class="ltx_Math" alttext="\rho(g_{k})^{i}=\rho(ig_{k})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mi>i</mi></msup></mrow><mo>=</mo><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\rho(g_{k})^{i}=\rho(ig_{k})</annotation></semantics></math> to avoid the computation of the matrix power. As this matrix is block diagonal, computing <math id="S8.SS2.SSS1.p2.m17" class="ltx_Math" alttext="\mathbf{R}_{i}\mathbf{q}_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{R}_{i}\mathbf{q}_{i}</annotation></semantics></math> means that the rotations act only on 2-dimensional chunks of the query (or key), i.e., <math id="S8.SS2.SSS1.p2.m18" class="ltx_Math" alttext="\mathbf{R}_{i}\mathbf{q}_{i}=\bigoplus_{k=1,\ldots,d/2}\rho(ig_{k})\mathbf{q}_{i}^{(k)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐑</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mi>i</mi></msub></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>⨁</mo><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>d</mi><mo>/</mo><mn>2</mn></mrow></mrow></msub><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐪</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{R}_{i}\mathbf{q}_{i}=\bigoplus_{k=1,\ldots,d/2}\rho(ig_{k})\mathbf{q}_{i}^{(k)}</annotation></semantics></math>. This leads to the final formulation of <math id="S8.SS2.SSS1.p2.m19" class="ltx_Math" alttext="k_{\text{RoPE}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mtext>RoPE</mtext></msub><annotation encoding="application/x-tex">k_{\text{RoPE}}</annotation></semantics></math>:</p>
</div>
<div id="S8.SS2.SSS1.p3" class="ltx_para">
<table id="S8.E24" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S8.E24X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.E24X.m2" class="ltx_Math" alttext="\displaystyle k_{\text{RoPE}}(\mathbf{q}_{i},\mathbf{k}_{j})" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mtext>RoPE</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐪</mi><mi>i</mi></msub><mo>,</mo><msub><mi>𝐤</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle k_{\text{RoPE}}(\mathbf{q}_{i},\mathbf{k}_{j})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E24X.m3" class="ltx_Math" alttext="\displaystyle=(\mathbf{R}^{i}\mathbf{q}_{i})^{\top}(\mathbf{R}^{j}\mathbf{k}_{j})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐑</mi><mi>i</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐪</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>𝐑</mi><mi>j</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mi>j</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(\mathbf{R}^{i}\mathbf{q}_{i})^{\top}(\mathbf{R}^{j}\mathbf{k}_{j})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(24)</span></td></tr>
<tr id="S8.E24Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E24Xa.m2" class="ltx_Math" alttext="\displaystyle=\mathbf{q}_{i}^{\top}\mathbf{R}^{j-i}\mathbf{k}_{j}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msubsup><mi>𝐪</mi><mi>i</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>𝐑</mi><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐤</mi><mi>j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbf{q}_{i}^{\top}\mathbf{R}^{j-i}\mathbf{k}_{j}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S8.E24Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E24Xb.m2" class="ltx_Math" alttext="\displaystyle=\sum_{k=1,\ldots,d/2}\left(\mathbf{q}_{i}^{(k)}\right)^{\top}\rho(g_{k})^{j-i}\mathbf{k}_{j}^{(k)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>d</mi><mo>/</mo><mn>2</mn></mrow></mrow></munder></mstyle><mrow><msup><mrow><mo>(</mo><msubsup><mi>𝐪</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐤</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{k=1,\ldots,d/2}\left(\mathbf{q}_{i}^{(k)}\right)^{\top}\rho(g_{k})^{j-i}\mathbf{k}_{j}^{(k)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.SS2.SSS1.p3.1" class="ltx_p">where we use the fact that <math id="S8.SS2.SSS1.p3.m1" class="ltx_Math" alttext="\left(\rho(g_{k})^{i}\right)^{\top}\rho(g_{k})^{j}=\rho(g_{k})^{-i}\rho(g_{k})^{j}=\rho(g_{k})^{j-i}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>(</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mi>i</mi></msup></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mi>j</mi></msup></mrow><mo>=</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mi>i</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mi>j</mi></msup></mrow><mo>=</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>j</mi><mo>−</mo><mi>i</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\left(\rho(g_{k})^{i}\right)^{\top}\rho(g_{k})^{j}=\rho(g_{k})^{-i}\rho(g_{k})^{j}=\rho(g_{k})^{j-i}</annotation></semantics></math>. We highlight how the block diagonal structure of <math id="S8.SS2.SSS1.p3.m2" class="ltx_Math" alttext="\mathbf{R}" display="inline" intent=":literal"><semantics><mi>𝐑</mi><annotation encoding="application/x-tex">\mathbf{R}</annotation></semantics></math> allows one to decompose the dot product into the sum of dot products of 2-dimensional chunks, with each key vector chunk rotated at a frequency dictated by <math id="S8.SS2.SSS1.p3.m3" class="ltx_Math" alttext="g_{k}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>k</mi></msub><annotation encoding="application/x-tex">g_{k}</annotation></semantics></math>.

<br class="ltx_break">Considering the smallest and largest values of <math id="S8.SS2.SSS1.p3.m4" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> in RoPE , denoted as <math id="S8.SS2.SSS1.p3.m5" class="ltx_Math" alttext="\theta_{\text{min}}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mtext>min</mtext></msub><annotation encoding="application/x-tex">\theta_{\text{min}}</annotation></semantics></math> and <math id="S8.SS2.SSS1.p3.m6" class="ltx_Math" alttext="\theta_{\text{max}}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mtext>max</mtext></msub><annotation encoding="application/x-tex">\theta_{\text{max}}</annotation></semantics></math>, respectively, and their corresponding wavelengths, <math id="S8.SS2.SSS1.p3.m7" class="ltx_Math" alttext="\lambda_{\text{max}}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mtext>max</mtext></msub><annotation encoding="application/x-tex">\lambda_{\text{max}}</annotation></semantics></math> and <math id="S8.SS2.SSS1.p3.m8" class="ltx_Math" alttext="\lambda_{\text{min}}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mtext>min</mtext></msub><annotation encoding="application/x-tex">\lambda_{\text{min}}</annotation></semantics></math>. When a sequence is input into the model, it essentially performs an uneven positional encoding on the sequence.</p>
</div>
<div id="S8.SS2.SSS1.p4" class="ltx_para">
<p id="S8.SS2.SSS1.p4.1" class="ltx_p">When the sequence length begins to exceed <math id="S8.SS2.SSS1.p4.m1" class="ltx_Math" alttext="\lambda_{\text{min}}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mtext>min</mtext></msub><annotation encoding="application/x-tex">\lambda_{\text{min}}</annotation></semantics></math>, dimensions start completing one cycle of rotation. As the sequence length continues to increase, more dimensions reach their rotational cycles. This phenomenon endows RoPE with the ability to extrapolate. When the sequence length increases, some dimensions’ rotational values have been seen during the model’s previous training, providing familiarity for longer sequences. However, this also introduces noise into the training process. As the sequence length increases, the attention weights (<span id="S8.SS2.SSS1.p4.1.1" class="ltx_text ltx_markedasmath">attn_weight</span>) on these dimensions may become larger than those for shorter relative positions, confusing the model. This issue is difficult to mitigate by merely adjusting the frequency.</p>
</div>
<figure id="S8.F6" class="ltx_figure"><img src="2509.05218v1/picture/rope_trend_4.png" id="S8.F6.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:234/234;" width="234" height="234" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 6: </span>Attention weight decay trend with rope </figcaption>
</figure>
<div id="S8.SS2.SSS1.p5" class="ltx_para">
<p id="S8.SS2.SSS1.p5.1" class="ltx_p">The extrapolation capability of RoPE arises from this characteristic. In extreme cases, if the sequence length exceeds the lowest frequency, i.e., the longest wavelength <math id="S8.SS2.SSS1.p5.m1" class="ltx_Math" alttext="\lambda_{\text{max}}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mtext>max</mtext></msub><annotation encoding="application/x-tex">\lambda_{\text{max}}</annotation></semantics></math>, RoPE degenerates into no position encoding, failing to provide positional information to the model anymore.</p>
</div>
</section>
<section id="S8.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">8.2.2 </span>HoPE</h4>

<div id="S8.SS2.SSS2.p1" class="ltx_para">
<p id="S8.SS2.SSS2.p1.1" class="ltx_p">By substituting the rotation matrix of the RoPE (Rotary Position Embedding) with a hyperbolic rotation matrix, we characterize the relative information by rotating <math id="S8.SS2.SSS2.p1.m1" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> by <math id="S8.SS2.SSS2.p1.m2" class="ltx_Math" alttext="m\theta" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">m\theta</annotation></semantics></math> and <math id="S8.SS2.SSS2.p1.m3" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> by <math id="S8.SS2.SSS2.p1.m4" class="ltx_Math" alttext="-m\theta" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></mrow><annotation encoding="application/x-tex">-m\theta</annotation></semantics></math>. This approach employs hyperbolic matrices to encode the positional information differently, capturing the relative positions between tokens effectively. Consistent with the matrix form mentioned above, we can derive the following matrix.</p>
<table id="S8.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.E25.m1" class="ltx_Math" alttext="\rho(g_{k})=\begin{bmatrix}\cosh(g_{k})&amp;\sinh(g_{k})\\
\sinh(g_{k})&amp;\cosh(g_{k})\end{bmatrix}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>ρ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\rho(g_{k})=\begin{bmatrix}\cosh(g_{k})&amp;\sinh(g_{k})\\
\sinh(g_{k})&amp;\cosh(g_{k})\end{bmatrix},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="S8.SS2.SSS2.p1.2" class="ltx_p">However, the rotation matrix of RoPE is an orthogonal matrix, which means it will not change the modulus of any vector:</p>
<table id="S8.E26" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S8.E26X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E26X.m2" class="ltx_Math" alttext="\displaystyle\begin{bmatrix}\cos(\theta)&amp;-\sin(\theta)\\
\sin(\theta)&amp;\cos(\theta)\end{bmatrix}\begin{bmatrix}q_{1}\\
q_{2}\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mo rspace="0.167em">−</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>q</mi><mn>1</mn></msub></mtd></mtr><mtr><mtd><msub><mi>q</mi><mn>2</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\begin{bmatrix}\cos(\theta)&amp;-\sin(\theta)\\
\sin(\theta)&amp;\cos(\theta)\end{bmatrix}\begin{bmatrix}q_{1}\\
q_{2}\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(26)</span></td></tr>
<tr id="S8.E26Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E26Xa.m2" class="ltx_Math" alttext="\displaystyle=\begin{bmatrix}q_{1}\cos(\theta)-q_{2}\sin(\theta)\\
q_{1}\sin(\theta)+q_{2}\cos(\theta)\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>q</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sin</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cos</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}q_{1}\cos(\theta)-q_{2}\sin(\theta)\\
q_{1}\sin(\theta)+q_{2}\cos(\theta)\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.SS2.SSS2.p1.3" class="ltx_p"><span id="S8.SS2.SSS2.p1.3.1" class="ltx_text">The length after rotation remains unchanged.</span>
However, our hyperbolic rotation is not an orthogonal matrix, and it will change the modulus of the vector.</p>
<table id="S8.E27" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S8.E27X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E27X.m2" class="ltx_Math" alttext="\displaystyle\begin{bmatrix}\cosh(\theta)&amp;\sinh(\theta)\\
\sinh(\theta)&amp;\cosh(\theta)\end{bmatrix}\begin{bmatrix}q_{1}\\
q_{2}\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><msub><mi>q</mi><mn>1</mn></msub></mtd></mtr><mtr><mtd><msub><mi>q</mi><mn>2</mn></msub></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\begin{bmatrix}\cosh(\theta)&amp;\sinh(\theta)\\
\sinh(\theta)&amp;\cosh(\theta)\end{bmatrix}\begin{bmatrix}q_{1}\\
q_{2}\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(27)</span></td></tr>
<tr id="S8.E27Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E27Xa.m2" class="ltx_Math" alttext="\displaystyle=\begin{bmatrix}q_{1}\cosh(\theta)+q_{2}\sinh(\theta)\\
q_{1}\sinh(\theta)+q_{2}\cosh(\theta)\end{bmatrix}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>[</mo><mtable rowspacing="0pt"><mtr><mtd><mrow><mrow><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mrow><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>q</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{bmatrix}q_{1}\cosh(\theta)+q_{2}\sinh(\theta)\\
q_{1}\sinh(\theta)+q_{2}\cosh(\theta)\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.SS2.SSS2.p1.4" class="ltx_p"><span id="S8.SS2.SSS2.p1.4.1" class="ltx_text">Original length: </span></p>
<table id="S8.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.E28.m1" class="ltx_Math" alttext="\sqrt{q_{1}^{2}+q_{2}^{2}}=A" display="block" intent=":literal"><semantics><mrow><msqrt><mrow><msubsup><mi>q</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>q</mi><mn>2</mn><mn>2</mn></msubsup></mrow></msqrt><mo>=</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">\sqrt{q_{1}^{2}+q_{2}^{2}}=A</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="S8.SS2.SSS2.p1.5" class="ltx_p"><span id="S8.SS2.SSS2.p1.5.1" class="ltx_text">Rotated length: </span></p>
<table id="S8.E29" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S8.E29X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.E29X.m2" class="ltx_Math" alttext="\displaystyle\sqrt{(q_{1}^{2}+q_{2}^{2})\cosh(2\theta)+2q_{1}q_{2}\sinh(2\theta)}=B" display="inline" intent=":literal"><semantics><mrow><msqrt><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>q</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>q</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></msqrt><mo>=</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\displaystyle\sqrt{(q_{1}^{2}+q_{2}^{2})\cosh(2\theta)+2q_{1}q_{2}\sinh(2\theta)}=B</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="S8.SS2.SSS2.p1.6" class="ltx_p">To find the relationship between A and B, we got B divided by A</p>
<table id="S8.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.E30.m1" class="ltx_Math" alttext="\frac{B}{A}=\sqrt{\cosh(2\theta)+\frac{2q_{1}q_{2}\sinh(2\theta)}{q_{1}^{2}+q_{2}^{2}}}" display="block" intent=":literal"><semantics><mrow><mfrac><mi>B</mi><mi>A</mi></mfrac><mo>=</mo><msqrt><mrow><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mn>2</mn></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msubsup><mi>q</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mi>q</mi><mn>2</mn><mn>2</mn></msubsup></mrow></mfrac></mrow></msqrt></mrow><annotation encoding="application/x-tex">\frac{B}{A}=\sqrt{\cosh(2\theta)+\frac{2q_{1}q_{2}\sinh(2\theta)}{q_{1}^{2}+q_{2}^{2}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
<p id="S8.SS2.SSS2.p1.7" class="ltx_p">According to the inequality related to the binomial theorem: <math id="S8.SS2.SSS2.p1.m5" class="ltx_Math" alttext="a^{2}+b^{2}\geq 2ab" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>b</mi><mn>2</mn></msup></mrow><mo>≥</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></mrow><annotation encoding="application/x-tex">a^{2}+b^{2}\geq 2ab</annotation></semantics></math>.</p>
<table id="S8.E31" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S8.E31X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.E31X.m2" class="ltx_Math" alttext="\displaystyle\frac{B}{A}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mi>B</mi><mi>A</mi></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{B}{A}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E31X.m3" class="ltx_Math" alttext="\displaystyle\leq\sqrt{e^{2\theta}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><msqrt><msup><mi>e</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>θ</mi></mrow></msup></msqrt></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{e^{2\theta}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(31)</span></td></tr>
<tr id="S8.E31Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E31Xa.m2" class="ltx_Math" alttext="\displaystyle=e^{\theta}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mi>e</mi><mi>θ</mi></msup></mrow><annotation encoding="application/x-tex">\displaystyle=e^{\theta}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.SS2.SSS2.p1.8" class="ltx_p">Therefore, to account for the corresponding multiplication of the modulus change, we premultiply the hyperbolic rotation matrix by a penalty coefficient.</p>
<table id="S8.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.E32.m1" class="ltx_Math" alttext="e^{-\theta}\begin{bmatrix}\cosh(\theta)&amp;\sinh(\theta)\\
\sinh(\theta)&amp;\cosh(\theta)\end{bmatrix}" display="block" intent=":literal"><semantics><mrow><msup><mi>e</mi><mrow><mo>−</mo><mi>θ</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow></mtd></mtr></mtable><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">e^{-\theta}\begin{bmatrix}\cosh(\theta)&amp;\sinh(\theta)\\
\sinh(\theta)&amp;\cosh(\theta)\end{bmatrix}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="S8.SS2.SSS2.p1.9" class="ltx_p">This approach not only reduces the noise during training but also preserves the assumptions of positional encoding.</p>
</div>
</section>
</section>
<section id="S8.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">8.3 </span>Experimental Details</h3>

<section id="S8.SS3.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">8.3.1 </span>Perplexity Experiment</h4>

<div id="S8.SS3.SSS1.p1" class="ltx_para">
<p id="S8.SS3.SSS1.p1.1" class="ltx_p"><span id="S8.SS3.SSS1.p1.1.1" class="ltx_text ltx_font_bold">Model configurations.</span> In this experiment, we train decoder-only Transformer language models with different positional encoding techniques while keeping all the other configurations the same. For RoPE, we follow <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib42" title="" class="ltx_ref">Su et al. (2023)</a></cite> to set the hyperparameters in the rotary matrix, respectively. For ALiBi, we follow <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib30" title="" class="ltx_ref">Press et al. (2022)</a></cite> to set the slope values in each attention head. For the intra-segment encoding of BiPE, we use the learnable absolute positional encoding. For the inter-segment encoding of BiPE-RoPE, the hyperparameters are kept the same as the original setting. For the inter-segment encoding of our BiPE-ALiBi, the slope values are set to 96 times of the original ALiBi’s setting. Other model configurations are provided in Table <a href="#S8.T4" title="Table 4 ‣ 8.3.1 Perplexity Experiment ‣ 8.3 Experimental Details ‣ 8 Appendix ‣ HoPE: Hyperbolic Rotary Positional Encoding for Stable Long-Range Dependency Modeling in Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<figure id="S8.T4" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 4: </span>Model configurations for length extrapolation.</figcaption>
<table id="S8.T4.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S8.T4.2.1" class="ltx_tr">
<td id="S8.T4.2.1.1" class="ltx_td ltx_align_center ltx_border_tt">Layers</td>
<td id="S8.T4.2.1.2" class="ltx_td ltx_align_center ltx_border_tt">12</td></tr>
<tr id="S8.T4.2.2" class="ltx_tr">
<td id="S8.T4.2.2.1" class="ltx_td ltx_align_center">Attention heads</td>
<td id="S8.T4.2.2.2" class="ltx_td ltx_align_center">12</td></tr>
<tr id="S8.T4.2.3" class="ltx_tr">
<td id="S8.T4.2.3.1" class="ltx_td ltx_align_center">Head dimensions</td>
<td id="S8.T4.2.3.2" class="ltx_td ltx_align_center">64</td></tr>
<tr id="S8.T4.2.4" class="ltx_tr">
<td id="S8.T4.2.4.1" class="ltx_td ltx_align_center">Hidden dimensions</td>
<td id="S8.T4.2.4.2" class="ltx_td ltx_align_center">768</td></tr>
<tr id="S8.T4.2.5" class="ltx_tr">
<td id="S8.T4.2.5.1" class="ltx_td ltx_align_center">FFN dimensions</td>
<td id="S8.T4.2.5.2" class="ltx_td ltx_align_center">3072</td></tr>
<tr id="S8.T4.2.6" class="ltx_tr">
<td id="S8.T4.2.6.1" class="ltx_td ltx_align_center ltx_border_bb">Model parameters</td>
<td id="S8.T4.2.6.2" class="ltx_td ltx_align_center ltx_border_bb">155M</td></tr>
</tbody>
</table>
</figure>
<div id="S8.SS3.SSS1.p2" class="ltx_para ltx_noindent">
<p id="S8.SS3.SSS1.p2.1" class="ltx_p"><span id="S8.SS3.SSS1.p2.1.1" class="ltx_text ltx_font_bold">Training recipes.</span> The next token prediction objective is adopted for language model training. All models are trained on the Pile dataset with a total sequence length of 1024. The training recipes are shown in Table <a href="#S8.T5" title="Table 5 ‣ 8.3.1 Perplexity Experiment ‣ 8.3 Experimental Details ‣ 8 Appendix ‣ HoPE: Hyperbolic Rotary Positional Encoding for Stable Long-Range Dependency Modeling in Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
<figure id="S8.T5" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 5: </span>Training recipes for length extrapolation.</figcaption>
<table id="S8.T5.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S8.T5.2.1" class="ltx_tr">
<th id="S8.T5.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_tt">Batch size</th>
<td id="S8.T5.2.1.2" class="ltx_td ltx_align_center ltx_border_tt">256</td></tr>
<tr id="S8.T5.2.2" class="ltx_tr">
<th id="S8.T5.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Total training epochs</th>
<td id="S8.T5.2.2.2" class="ltx_td ltx_align_center">1</td></tr>
<tr id="S8.T5.2.3" class="ltx_tr">
<th id="S8.T5.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Dropout</th>
<td id="S8.T5.2.3.2" class="ltx_td ltx_align_center">0.0</td></tr>
<tr id="S8.T5.2.4" class="ltx_tr">
<th id="S8.T5.2.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Weight decay</th>
<td id="S8.T5.2.4.2" class="ltx_td ltx_align_center">0.01</td></tr>
<tr id="S8.T5.2.5" class="ltx_tr">
<th id="S8.T5.2.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">Optimizer</th>
<td id="S8.T5.2.5.2" class="ltx_td ltx_align_center">AdamW</td></tr>
<tr id="S8.T5.2.6" class="ltx_tr">
<th id="S8.T5.2.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">Learning rate</th>
<td id="S8.T5.2.6.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S8.T5.m1" class="ltx_Math" alttext="1e-4" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>−</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">1e-4</annotation></semantics></math></td></tr>
</tbody>
</table>
</figure>
</section>
<section id="S8.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">8.3.2 </span>Fine-Tuning Experiment</h4>

<div id="S8.SS3.SSS2.p1" class="ltx_para">
<p id="S8.SS3.SSS2.p1.1" class="ltx_p"><span id="S8.SS3.SSS2.p1.1.1" class="ltx_text ltx_font_bold">Fine-tuning on SCROLLS.</span> We fine-tune pretrained language models with different positional encoding methods on SCROLLS<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib35" title="" class="ltx_ref">Shaham et al. (2022)</a></cite>. It is a long context benchmark that consists of seven distinct datasets covering different tasks, e.g, Question-Answering (Qasper<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib13" title="" class="ltx_ref">Dasigi et al. (2021)</a></cite>, NarrativeQA<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib23" title="" class="ltx_ref">Kočiský et al. (2017)</a></cite>, and QuALITY<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib27" title="" class="ltx_ref">Pang et al. (2022)</a></cite>), Natural Language Inference (ContractNLI<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib22" title="" class="ltx_ref">Koreeda and
Manning (2021)</a></cite>) and Summarization (QMSum<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib52" title="" class="ltx_ref">Zhong et al. (2021)</a></cite>, SummScreenFD<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib7" title="" class="ltx_ref">Chen et al. (2022)</a></cite>, and GovReport<cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib20" title="" class="ltx_ref">Huang et al. (2021)</a></cite>). All the model configurations are the same as those in Table <a href="#S8.T4" title="Table 4 ‣ 8.3.1 Perplexity Experiment ‣ 8.3 Experimental Details ‣ 8 Appendix ‣ HoPE: Hyperbolic Rotary Positional Encoding for Stable Long-Range Dependency Modeling in Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
<figure id="S8.T6" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 6: </span>Finetuning recipes for long context benchmark.</figcaption>
<table id="S8.T6.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S8.T6.2.1" class="ltx_tr">
<th id="S8.T6.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt">Batch size</th>
<td id="S8.T6.2.1.2" class="ltx_td ltx_align_center ltx_border_tt">64</td></tr>
<tr id="S8.T6.2.2" class="ltx_tr">
<th id="S8.T6.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Total training steps</th>
<td id="S8.T6.2.2.2" class="ltx_td ltx_align_center">5000</td></tr>
<tr id="S8.T6.2.3" class="ltx_tr">
<th id="S8.T6.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Dropout</th>
<td id="S8.T6.2.3.2" class="ltx_td ltx_align_center">0.0</td></tr>
<tr id="S8.T6.2.4" class="ltx_tr">
<th id="S8.T6.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Weight decay</th>
<td id="S8.T6.2.4.2" class="ltx_td ltx_align_center">0.01</td></tr>
<tr id="S8.T6.2.5" class="ltx_tr">
<th id="S8.T6.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Optimizer</th>
<td id="S8.T6.2.5.2" class="ltx_td ltx_align_center">AdamW</td></tr>
<tr id="S8.T6.2.6" class="ltx_tr">
<th id="S8.T6.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Learning rate</th>
<td id="S8.T6.2.6.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S8.T6.m1" class="ltx_Math" alttext="1e-5" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>−</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">1e-5</annotation></semantics></math></td></tr>
</tbody>
</table>
</figure>
<div id="S8.SS3.SSS2.p2" class="ltx_para">
<p id="S8.SS3.SSS2.p2.1" class="ltx_p"><span id="S8.SS3.SSS2.p2.1.1" class="ltx_text ltx_font_bold">Fine-tuning recipes.</span> We fine-tune models using the next token prediction objective on each task with a sequence length of 8192. The fine-tuning recipes are provided in Table <a href="#S8.T6" title="Table 6 ‣ 8.3.2 Fine-Tuning Experiment ‣ 8.3 Experimental Details ‣ 8 Appendix ‣ HoPE: Hyperbolic Rotary Positional Encoding for Stable Long-Range Dependency Modeling in Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a></p>
</div>
</section>
</section>
<section id="S8.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">8.4 </span>Lorentz Transformation And Lorentz Group</h3>

<div id="S8.SS4.p1" class="ltx_para">
<p id="S8.SS4.p1.1" class="ltx_p">The general form of the Lorentz transformation can be written as:</p>
<table id="S8.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex1.m1" class="ltx_Math" alttext="x^{\prime\mu}=\Lambda^{\mu}_{\ \nu}x^{\nu}" display="block" intent=":literal"><semantics><mrow><msup><mi>x</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mi>μ</mi></mrow></msup><mo>=</mo><mrow><msubsup><mi mathvariant="normal">Λ</mi><mi>ν</mi><mi>μ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mi>ν</mi></msup></mrow></mrow><annotation encoding="application/x-tex">x^{\prime\mu}=\Lambda^{\mu}_{\ \nu}x^{\nu}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.SS4.p1.2" class="ltx_p">where <math id="S8.SS4.p1.m1" class="ltx_Math" alttext="\Lambda^{\mu}_{\ \nu}" display="inline" intent=":literal"><semantics><msubsup><mi mathvariant="normal">Λ</mi><mi>ν</mi><mi>μ</mi></msubsup><annotation encoding="application/x-tex">\Lambda^{\mu}_{\ \nu}</annotation></semantics></math> is the Lorentz transformation matrix satisfying the condition:</p>
<table id="S8.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex2.m1" class="ltx_Math" alttext="\eta_{\rho\sigma}\Lambda^{\rho}_{\ \mu}\Lambda^{\sigma}_{\ \nu}=\eta_{\mu\nu}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>μ</mi><mi>ρ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Λ</mi><mi>ν</mi><mi>σ</mi></msubsup></mrow><mo>=</mo><msub><mi>η</mi><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\eta_{\rho\sigma}\Lambda^{\rho}_{\ \mu}\Lambda^{\sigma}_{\ \nu}=\eta_{\mu\nu}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.SS4.p1.3" class="ltx_p">with <math id="S8.SS4.p1.m2" class="ltx_Math" alttext="\eta_{\mu\nu}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><annotation encoding="application/x-tex">\eta_{\mu\nu}</annotation></semantics></math> being the Minkowski metric:</p>
<table id="S8.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex3.m1" class="ltx_Math" alttext="\eta_{\mu\nu}=\text{diag}(1,-1,-1,-1)" display="block" intent=":literal"><semantics><mrow><msub><mi>η</mi><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><mo>=</mo><mrow><mtext>diag</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{\mu\nu}=\text{diag}(1,-1,-1,-1)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S8.SS4.p2" class="ltx_para">
<p id="S8.SS4.p2.1" class="ltx_p">For a specific case of a boost along the <math id="S8.SS4.p2.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>-axis, the transformations are given by:</p>
<table id="S8.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S8.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.Ex4.m1" class="ltx_Math" alttext="\displaystyle t^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>t</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\displaystyle t^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex4.m2" class="ltx_Math" alttext="\displaystyle=\gamma\left(t-\frac{vx}{c^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>t</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><msup><mi>c</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma\left(t-\frac{vx}{c^{2}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S8.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.Ex5.m1" class="ltx_Math" alttext="\displaystyle x^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>x</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\displaystyle x^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex5.m2" class="ltx_Math" alttext="\displaystyle=\gamma(x-vt)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><mrow><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma(x-vt)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S8.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.Ex6.m1" class="ltx_Math" alttext="\displaystyle y^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>y</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\displaystyle y^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex6.m2" class="ltx_Math" alttext="\displaystyle=y" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">\displaystyle=y</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S8.Ex7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.Ex7.m1" class="ltx_Math" alttext="\displaystyle z^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>z</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\displaystyle z^{\prime}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex7.m2" class="ltx_Math" alttext="\displaystyle=z" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mi>z</mi></mrow><annotation encoding="application/x-tex">\displaystyle=z</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.SS4.p2.2" class="ltx_p">where <math id="S8.SS4.p2.m2" class="ltx_Math" alttext="\gamma=\frac{1}{\sqrt{1-\frac{v^{2}}{c^{2}}}}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mfrac><mn>1</mn><msqrt><mrow><mn>1</mn><mo>−</mo><mfrac><msup><mi>v</mi><mn>2</mn></msup><msup><mi>c</mi><mn>2</mn></msup></mfrac></mrow></msqrt></mfrac></mrow><annotation encoding="application/x-tex">\gamma=\frac{1}{\sqrt{1-\frac{v^{2}}{c^{2}}}}</annotation></semantics></math> is the Lorentz factor.</p>
</div>
<div id="S8.SS4.p3" class="ltx_para">
<p id="S8.SS4.p3.1" class="ltx_p">The set of all such transformations forms the Lorentz group, denoted as <math id="S8.SS4.p3.m1" class="ltx_Math" alttext="\mathrm{O}(1,3)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{O}(1,3)</annotation></semantics></math>, which is defined as:</p>
<table id="S8.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.Ex8.m1" class="ltx_Math" alttext="\underbrace{\mathrm{O}(1,3)\equiv\left\{\Lambda\mid\Lambda\in\mathrm{GL}(4,\mathbb{R}),g_{\mu\nu}\Lambda^{\mu}{}_{\rho}\Lambda^{\nu}{}_{\sigma}=g_{\rho\sigma}\right\}}_{\dim\mathrm{O}(1,3)=6}" display="block" intent=":literal"><semantics><munder><munder accentunder="true"><mrow><mi>O</mi><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo><mo>≡</mo><mo>{</mo><mi mathvariant="normal">Λ</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi mathvariant="normal">Λ</mi><mo>∈</mo><mi>GL</mi><mo stretchy="false">(</mo><mn>4</mn><mo>,</mo><mi>ℝ</mi><mo stretchy="false">)</mo><mo>,</mo><mi>g</mi><msub><mrow></mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>ν</mi></mrow></msub><mi mathvariant="normal">Λ</mi><msup><mrow></mrow><mi>μ</mi></msup><msub><mrow></mrow><mi>ρ</mi></msub><mi mathvariant="normal">Λ</mi><msup><mrow></mrow><mi>ν</mi></msup><msub><mrow></mrow><mi>σ</mi></msub><mo>=</mo><mi>g</mi><msub><mrow></mrow><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow></msub><mo>}</mo></mrow><mo stretchy="true">⏟</mo></munder><mrow><mrow><mo rspace="0.167em">dim</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>6</mn></mrow></munder><annotation encoding="application/x-tex">\underbrace{\mathrm{O}(1,3)\equiv\left\{\Lambda\mid\Lambda\in\mathrm{GL}(4,\mathbb{R}),g_{\mu\nu}\Lambda^{\mu}{}_{\rho}\Lambda^{\nu}{}_{\sigma}=g_{\rho\sigma}\right\}}_{\dim\mathrm{O}(1,3)=6}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S8.SS4.p4" class="ltx_para">
<p id="S8.SS4.p4.1" class="ltx_p">This group includes rotations and boosts (velocity transformations) and has six degrees of freedom: three for rotations and three for boosts. It represents the fundamental symmetry group of special relativity, ensuring the invariance of physical laws across different inertial frames.</p>
</div>
<div id="S8.SS4.p5" class="ltx_para">
<p id="S8.SS4.p5.1" class="ltx_p">Essentially, <math id="S8.SS4.p5.m1" class="ltx_Math" alttext="\mathrm{O}(1,3)" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>3</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{O}(1,3)</annotation></semantics></math> is the group of linear transformations on Minkowski spacetime that preserve the metric. For more details on metric spaces and index notation, refer to Masaki Notation.</p>
</div>
<figure id="algorithm1" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="algorithm1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span>HoPE</figcaption>
<div id="algorithm1.4" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm1.4.1" class="ltx_listingline"><span id="algorithm1.4.1.1" class="ltx_text"><span id="algorithm1.4.1.1.1" class="ltx_text ltx_font_bold">Input:</span> </span>q, k: [batch, head, seq, dim]; theta: [dim//2] (per-dimension angle); theta_prime
</div>
<div id="algorithm1.4.2" class="ltx_listingline"><span id="algorithm1.4.2.1" class="ltx_text"><span id="algorithm1.4.2.1.1" class="ltx_text ltx_font_bold">Output:</span> </span>Modified q and k
</div>
<div id="algorithm1.4.3" class="ltx_listingline"><span id="algorithm1.4.3.1" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.3.2" class="ltx_emph ltx_font_italic"><math id="algorithm1.m1" class="ltx_Math" alttext="i\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">i\leftarrow 0</annotation></semantics></math> <span id="algorithm1.4.3.2.1" class="ltx_text ltx_font_bold">to</span> <math id="algorithm1.m2" class="ltx_Math" alttext="\text{dim}-2" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">dim</mtext><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\text{dim}-2</annotation></semantics></math> <span id="algorithm1.4.3.2.2" class="ltx_text ltx_font_bold">step</span> 2</em> <span id="algorithm1.4.3.3" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.4" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m3" class="ltx_Math" alttext="\text{angle}\leftarrow\text{pos}\cdot\theta[i/2]" display="inline" intent=":literal"><semantics><mrow><mtext>angle</mtext><mo stretchy="false">←</mo><mrow><mtext>pos</mtext><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>θ</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{angle}\leftarrow\text{pos}\cdot\theta[i/2]</annotation></semantics></math>;
</div>
<div id="algorithm1.4.5" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m4" class="ltx_Math" alttext="c,s\leftarrow\cosh(\text{angle}),\sinh(\text{angle})" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>,</mo><mrow><mi>s</mi><mo stretchy="false">←</mo><mrow><mi>cosh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>angle</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>sinh</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mtext>angle</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c,s\leftarrow\cosh(\text{angle}),\sinh(\text{angle})</annotation></semantics></math>;
</div>
<div id="algorithm1.4.6" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m5" class="ltx_Math" alttext="\text{rot\_q}\leftarrow[c\cdot q[...,i]+s\cdot q[...,i+1],\ s\cdot q[...,i]+c\cdot q[...,i+1]]" display="inline" intent=":literal"><semantics><mrow><mtext>rot_q</mtext><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi>c</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>s</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mi>s</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>c</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>q</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\text{rot\_q}\leftarrow[c\cdot q[...,i]+s\cdot q[...,i+1],\ s\cdot q[...,i]+c\cdot q[...,i+1]]</annotation></semantics></math>;
</div>
<div id="algorithm1.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m6" class="ltx_math_unparsed" alttext="\text{rot\_k}\leftarrow[c\cdot k[...,i]-s\cdot k[...,i+1],\ -s\cdot k[...,i]+c\cdot k[...,i+1]]" display="inline" intent=":literal"><semantics><mrow><mtext>rot_k</mtext><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>k</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><mi>s</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>k</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi><mo>+</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo rspace="0.278em">,</mo><mo>−</mo><mi>s</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>k</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi><mo stretchy="false">]</mo></mrow><mo>+</mo><mi>c</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>k</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi><mo>+</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\text{rot\_k}\leftarrow[c\cdot k[...,i]-s\cdot k[...,i+1],\ -s\cdot k[...,i]+c\cdot k[...,i+1]]</annotation></semantics></math>;
</div>
<div id="algorithm1.4.8" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m7" class="ltx_math_unparsed" alttext="q[...,i:i+2]\leftarrow\exp(-\text{pos}\cdot\theta_{\text{prime}})\cdot\text{rot\_q}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo>+</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">←</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em">−</mo><mtext>pos</mtext><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>θ</mi><mtext>prime</mtext></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mtext>rot_q</mtext></mrow><annotation encoding="application/x-tex">q[...,i:i+2]\leftarrow\exp(-\text{pos}\cdot\theta_{\text{prime}})\cdot\text{rot\_q}</annotation></semantics></math>;
</div>
<div id="algorithm1.4.9" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> <math id="algorithm1.m8" class="ltx_math_unparsed" alttext="k[...,i:i+2]\leftarrow\exp(\text{pos}\cdot\theta_{\text{prime}})\cdot\text{rot\_k}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mrow><mo stretchy="false">[</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>i</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mi>i</mi><mo>+</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><mo stretchy="false">←</mo><mi>exp</mi><mrow><mo stretchy="false">(</mo><mtext>pos</mtext><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>θ</mi><mtext>prime</mtext></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mtext>rot_k</mtext></mrow><annotation encoding="application/x-tex">k[...,i:i+2]\leftarrow\exp(\text{pos}\cdot\theta_{\text{prime}})\cdot\text{rot\_k}</annotation></semantics></math>;
