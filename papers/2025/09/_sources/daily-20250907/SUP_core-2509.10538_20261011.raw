<td id="Sx7.T7.1.3.1" class="ltx_td ltx_align_left ltx_border_r">Memory</td>
<td id="Sx7.T7.1.3.2" class="ltx_td ltx_align_left">1.000</td></tr>
<tr id="Sx7.T7.1.4" class="ltx_tr">
<td id="Sx7.T7.1.4.1" class="ltx_td ltx_align_left ltx_border_r">Learning/Perception</td>
<td id="Sx7.T7.1.4.2" class="ltx_td ltx_align_left">1.733</td></tr>
<tr id="Sx7.T7.1.5" class="ltx_tr">
<td id="Sx7.T7.1.5.1" class="ltx_td ltx_align_left ltx_border_r">Assistance Needed</td>
<td id="Sx7.T7.1.5.2" class="ltx_td ltx_align_left">1.531</td></tr>
<tr id="Sx7.T7.1.6" class="ltx_tr">
<td id="Sx7.T7.1.6.1" class="ltx_td ltx_align_left ltx_border_r">Physiological Changes</td>
<td id="Sx7.T7.1.6.2" class="ltx_td ltx_align_left">8.766</td></tr>
