/* ========================================
   MiMo Code — Scaling Coding Agents
   Clean Article Style
   ======================================== */

:root {
    --bg-primary: #FAF7F5;
    --bg-secondary: #F5F0EB;
    --text-primary: #1a1a1a;
    --text-secondary: #555;
    --text-tertiary: #888;
    --accent: #E1A555;
    --border: rgba(0, 0, 0, 0.1);
    --font-serif: &quot;PT Serif&quot;, Georgia, serif;
    --font-title: &quot;Ubuntu&quot;, -apple-system, BlinkMacSystemFont, sans-serif;
    --font-sans: -apple-system, BlinkMacSystemFont, &quot;SF Pro Text&quot;, &quot;Segoe UI&quot;, Roboto, sans-serif;
    --font-mono: &quot;SF Mono&quot;, &quot;Fira Code&quot;, Consolas, monospace;
}

*::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 16px;
    scroll-behavior: smooth;
    overflow-x: hidden;
}

body {
    overflow-x: hidden;
    font-family: var(--font-serif);
    font-weight: 450;
    font-optical-sizing: auto;
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    padding: 0;
    margin: 0;
}

.article {
    max-width: 900px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
}

.hero-section {
    text-align: center;
    margin-bottom: 4rem;
}

.hero-title {
    font-family: var(--font-title) !important;
    font-size: 2.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 1rem;
    line-height: 1.25;
}

.hero-buttons {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
}

.hero-buttons .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-title) !important;
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
    transition: all 0.2s;
    background: transparent;
    color: var(--text-primary);
    border: 1px solid #ccc;
}

.hero-buttons .btn:hover {
    border-color: #999;
    color: var(--text-primary);
    text-decoration: none;
}

.hero-buttons .btn-chevron {
    font-size: 1.1em;
    line-height: 1;
}

.hero-buttons .btn-filled {
    background: #1D0601;
    color: #fff;
    border: 1px solid #1D0601;
}

.hero-buttons .btn-filled:hover {
    background: #3a1a10;
    color: #fff;
    border-color: #3a1a10;
}

.hero-buttons .btn-outline {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid #ccc;
}

.hero-buttons .btn-outline:hover {
    border-color: #999;
    color: var(--text-primary);
}

.hero-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
}

.hero-date {
    display: block;
    text-align: center;
    font-family: var(--font-title) !important;
    font-size: 0.8rem;
    color: var(--text-tertiary);
    margin-bottom: 2rem;
}

.section {
    margin-bottom: 4.5rem;
}

h2 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 1rem;
    margin-top: 2.5rem;
    font-family: var(--font-title) !important;
}

h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    margin-top: 1.75rem;
    font-family: var(--font-title) !important;
    color: var(--text-primary);
}

h4 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    margin-top: 1.5rem;
    font-family: var(--font-title) !important;
    color: var(--text-primary);
}

p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
}

strong {
    font-weight: 500;
    color: var(--text-primary);
    font-family: var(--font-title) !important;
}

em {
    font-style: italic;
    color: var(--text-primary);
}

code {
    font-family: var(--font-mono) !important;
    font-size: 0.9em;
    background: var(--bg-secondary);
    padding: 0.1em 0.3em;
    border-radius: 3px;
    color: var(--text-primary);
}

pre {
    font-family: var(--font-mono) !important;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1.25rem 0 1.75rem;
    overflow-x: auto;
    line-height: 1.7;
}

pre code {
    font-family: var(--font-mono) !important;
    font-size: 0.85rem;
    background: none;
    padding: 0;
    color: var(--text-primary);
    white-space: pre;
}

ul, ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
}

.article ul {
    list-style-type: disc !important;
}

.article ul ul,
.article ol ul {
    list-style-type: circle !important;
    margin-top: 0.4rem;
    margin-bottom: 0.4rem;
}

.article ol {
    list-style-type: decimal !important;
}

li {
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
}

li::marker {
    color: var(--text-tertiary);
}

blockquote {
    border-left: 3px solid var(--accent);
    padding: 0.75rem 1rem;
    margin: 1rem 0;
    font-style: italic;
    color: var(--text-secondary);
    background: rgba(255, 103, 0, 0.03);
    border-radius: 0 4px 4px 0;
}

/* Inline subdued note */
.note {
    display: flex;
    gap: 0.5rem;
    margin: 1rem 0 1.5rem;
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--text-tertiary);
}

.note .note-tag {
    flex: none;
    font-family: var(--font-title) !important;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
    padding-top: 0.12rem;
}

.note p {
    margin: 0;
    color: var(--text-tertiary);
}

.lead p {
    color: var(--text-secondary);
}

.external-link {
    color: var(--accent);
    text-decoration: underline;
    font-weight: 500;
}

.external-link:hover {
    color: #E55C00;
    text-decoration: none;
}

/* Figure placeholder */
.figure-placeholder {
    margin: 1.5rem 0;
    border: 1px dashed #d9cfc4;
    border-radius: 10px;
    background: var(--bg-secondary);
    padding: 2.5rem 1.5rem;
    text-align: center;
}

.figure-placeholder .ph-label {
    font-family: var(--font-title) !important;
    font-size: 0.8rem;
    color: var(--text-tertiary);
    letter-spacing: 0.02em;
}

/* References */
.references {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
}

.references p {
    font-family: var(--font-title) !important;
    font-size: 0.78rem;
    color: var(--text-tertiary);
    margin-bottom: 0.4rem;
    word-break: break-all;
}

/* Footer */
.footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
    text-align: center;
    font-family: var(--font-title) !important;
    font-size: 0.75rem;
    color: var(--text-tertiary);
}

.footer p {
    font-family: var(--font-title) !important;
    color: var(--text-tertiary);
    margin-bottom: 0;
}

/* Comparison table */
.data-table-wrap {
    overflow-x: auto;
    margin: 1rem 0 1.5rem;
}

.data-table-wrap .data-table {
    display: table !important;
    width: 70% !important;
    min-width: 340px !important;
    max-width: 720px !important;
