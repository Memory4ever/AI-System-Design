<tr id="S4.T1.5.7" class="ltx_tr">
<th id="S4.T1.5.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" rowspan="3"><span id="S4.T1.5.7.1.1" class="ltx_text">
