<td id="S4.T1.9.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.m3" class="ltx_Math" alttext="R^{2}" display="inline" intent=":literal"><semantics><msup><mi>R</mi><mn>2</mn></msup><annotation encoding="application/x-tex">R^{2}</annotation></semantics></math> (<math id="S4.T1.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</td></tr>
<tr id="S4.T1.9.3" class="ltx_tr">
