<td id="S4.T1.9.4.6" class="ltx_td ltx_align_center ltx_border_t">0.222</td>
<td id="S4.T1.9.4.7" class="ltx_td ltx_align_center ltx_border_t">0.021</td>
<td id="S4.T1.9.4.8" class="ltx_td ltx_align_center ltx_border_t">0.58</td></tr>
<tr id="S4.T1.9.5" class="ltx_tr">
<th id="S4.T1.9.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">CycleGAN</th>
<td id="S4.T1.9.5.2" class="ltx_td ltx_align_center"><span id="S4.T1.9.5.2.1" class="ltx_text ltx_font_bold">0.0</span></td>
<td id="S4.T1.9.5.3" class="ltx_td ltx_align_center">0.4</td>
<td id="S4.T1.9.5.4" class="ltx_td ltx_align_center">n/a</td>
<td id="S4.T1.9.5.5" class="ltx_td ltx_align_center"><span id="S4.T1.9.5.5.1" class="ltx_text ltx_font_bold">1.0</span></td>
<td id="S4.T1.9.5.6" class="ltx_td ltx_align_center">0.0</td>
<td id="S4.T1.9.5.7" class="ltx_td ltx_align_center">n/a</td>
