<td id="S4.T1.9.3.5" class="ltx_td ltx_align_center ltx_border_t">Guy’s</td>
<td id="S4.T1.9.3.6" class="ltx_td ltx_align_center ltx_border_t">HH</td>
<td id="S4.T1.9.3.7" class="ltx_td ltx_align_center ltx_border_t">IOP</td>
<td id="S4.T1.9.3.8" class="ltx_td ltx_align_center ltx_border_t">IOP <math id="S4.T1.m5" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> Guy’s</td></tr>
<tr id="S4.T1.9.4" class="ltx_tr">
