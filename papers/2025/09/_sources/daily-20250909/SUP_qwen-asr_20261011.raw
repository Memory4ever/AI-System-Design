[{"type":"hugoFigure","name":"figure","src":"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/qwenasr-bear2.png#center","attributes":{"width":"100%"},"raw":"{{< figure src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/qwenasr-bear2.png#center\" width=\"100%\">}}","tokens":[]},{"type":"space","raw":"\n\n"},{"type":"paragraph","raw":"We introduce Qwen3-ASR-Flash, a speech recognition service built upon the strong intelligence of Qwen3-Omni and large amount of multi-modal data especially ASR data on the scale of tens of millions hours.","text":"We introduce Qwen3-ASR-Flash, a speech recognition service built upon the strong intelligence of Qwen3-Omni and large amount of multi-modal data especially ASR data on the scale of tens of millions hours.","tokens":[{"type":"text","raw":"We introduce Qwen3-ASR-Flash, a speech recognition service built upon the strong intelligence of Qwen3-Omni and large amount of multi-modal data especially ASR data on the scale of tens of millions hours.","text":"We introduce Qwen3-ASR-Flash, a speech recognition service built upon the strong intelligence of Qwen3-Omni and large amount of multi-modal data especially ASR data on the scale of tens of millions hours.","escaped":false}]},{"type":"space","raw":"\n\n"},{"type":"paragraph","raw":"Qwen3-ASR-Flash achieves accurate and robust speech recogition performance, supporting 11 languages and multiple accents. Novelly, Qwen3-ASR-Flash supports users to prompt the model with texture context in any format to obtain costumized ASR results, and is also good at singing voice recognition.","text":"Qwen3-ASR-Flash achieves accurate and robust speech recogition performance, supporting 11 languages and multiple accents. Novelly, Qwen3-ASR-Flash supports users to prompt the model with texture context in any format to obtain costumized ASR results, and is also good at singing voice recognition.","tokens":[{"type":"text","raw":"Qwen3-ASR-Flash achieves accurate and robust speech recogition performance, supporting 11 languages and multiple accents. Novelly, Qwen3-ASR-Flash supports users to prompt the model with texture context in any format to obtain costumized ASR results, and is also good at singing voice recognition.","text":"Qwen3-ASR-Flash achieves accurate and robust speech recogition performance, supporting 11 languages and multiple accents. Novelly, Qwen3-ASR-Flash supports users to prompt the model with texture context in any format to obtain costumized ASR results, and is also good at singing voice recognition.","escaped":false}]},{"type":"space","raw":"\n\n"},{"type":"paragraph","raw":"**📊 Performance:**","text":"**📊 Performance:**","tokens":[{"type":"strong","raw":"**📊 Performance:**","text":"📊 Performance:","tokens":[{"type":"text","raw":"📊 Performance:","text":"📊 Performance:","escaped":false}]}]},{"type":"space","raw":"\n\n"},{"type":"hugoFigure","name":"figure","src":"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/qwenasr-res4.png#center","attributes":{"width":"100%"},"raw":"{{< figure src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/qwenasr-res4.png#center\" width=\"100%\">}}","tokens":[]},{"type":"space","raw":"\n\n"},{"type":"paragraph","raw":"**💎 Key Features:**","text":"**💎 Key Features:**","tokens":[{"type":"strong","raw":"**💎 Key Features:**","text":"💎 Key Features:","tokens":[{"type":"text","raw":"💎 Key Features:","text":"💎 Key Features:","escaped":false}]}]},{"type":"space","raw":"\n\n"},{"type":"list","raw":"* Leading Recognition Accuracy: Qwen3-ASR-Flash surpasses a wide range of competing models on major industry benchmarks for Chinese, English and other 9 languages speech recognition.\n* Exceptional Singing Voice Recognition: It accurately transcribes  songs even with background music.\n* Flexible Contextual Biasing: Users can provide background text in any format to prompt the model to obtain customized ASR results.\n* Language Identification and Non-Speech Rejection: The model precisely identifies all 11 supported languages and rejects non-speech segments, including silence and background noise.\n* Robustness: Performance guaranteed under complex acousitc environments, and also for transcribing speech in difficult text patterns.","ordered":false,"start":"","loose":false,"items":[{"type":"list_item","raw":"* Leading Recognition Accuracy: Qwen3-ASR-Flash surpasses a wide range of competing models on major industry benchmarks for Chinese, English and other 9 languages speech recognition.\n","task":false,"loose":false,"text":"Leading Recognition Accuracy: Qwen3-ASR-Flash surpasses a wide range of competing models on major industry benchmarks for Chinese, English and other 9 languages speech recognition.","tokens":[{"type":"text","raw":"Leading Recognition Accuracy: Qwen3-ASR-Flash surpasses a wide range of competing models on major industry benchmarks for Chinese, English and other 9 languages speech recognition.","text":"Leading Recognition Accuracy: Qwen3-ASR-Flash surpasses a wide range of competing models on major industry benchmarks for Chinese, English and other 9 languages speech recognition.","tokens":[{"type":"text","raw":"Leading Recognition Accuracy: Qwen3-ASR-Flash surpasses a wide range of competing models on major industry benchmarks for Chinese, English and other 9 languages speech recognition.","text":"Leading Recognition Accuracy: Qwen3-ASR-Flash surpasses a wide range of competing models on major industry benchmarks for Chinese, English and other 9 languages speech recognition.","escaped":false}]}]},{"type":"list_item","raw":"* Exceptional Singing Voice Recognition: It accurately transcribes  songs even with background music.\n","task":false,"loose":false,"text":"Exceptional Singing Voice Recognition: It accurately transcribes  songs even with background music.","tokens":[{"type":"text","raw":"Exceptional Singing Voice Recognition: It accurately transcribes  songs even with background music.","text":"Exceptional Singing Voice Recognition: It accurately transcribes  songs even with background music.","tokens":[{"type":"text","raw":"Exceptional Singing Voice Recognition: It accurately transcribes  songs even with background music.","text":"Exceptional Singing Voice Recognition: It accurately transcribes  songs even with background music.","escaped":false}]}]},{"type":"list_item","raw":"* Flexible Contextual Biasing: Users can provide background text in any format to prompt the model to obtain customized ASR results.\n","task":false,"loose":false,"text":"Flexible Contextual Biasing: Users can provide background text in any format to prompt the model to obtain customized ASR results.","tokens":[{"type":"text","raw":"Flexible Contextual Biasing: Users can provide background text in any format to prompt the model to obtain customized ASR results.","text":"Flexible Contextual Biasing: Users can provide background text in any format to prompt the model to obtain customized ASR results.","tokens":[{"type":"text","raw":"Flexible Contextual Biasing: Users can provide background text in any format to prompt the model to obtain customized ASR results.","text":"Flexible Contextual Biasing: Users can provide background text in any format to prompt the model to obtain customized ASR results.","escaped":false}]}]},{"type":"list_item","raw":"* Language Identification and Non-Speech Rejection: The model precisely identifies all 11 supported languages and rejects non-speech segments, including silence and background noise.\n","task":false,"loose":false,"text":"Language Identification and Non-Speech Rejection: The model precisely identifies all 11 supported languages and rejects non-speech segments, including silence and background noise.","tokens":[{"type":"text","raw":"Language Identification and Non-Speech Rejection: The model precisely identifies all 11 supported languages and rejects non-speech segments, including silence and background noise.","text":"Language Identification and Non-Speech Rejection: The model precisely identifies all 11 supported languages and rejects non-speech segments, including silence and background noise.","tokens":[{"type":"text","raw":"Language Identification and Non-Speech Rejection: The model precisely identifies all 11 supported languages and rejects non-speech segments, including silence and background noise.","text":"Language Identification and Non-Speech Rejection: The model precisely identifies all 11 supported languages and rejects non-speech segments, including silence and background noise.","escaped":false}]}]},{"type":"list_item","raw":"* Robustness: Performance guaranteed under complex acousitc environments, and also for transcribing speech in difficult text patterns.","task":false,"loose":false,"text":"Robustness: Performance guaranteed under complex acousitc environments, and also for transcribing speech in difficult text patterns.","tokens":[{"type":"text","raw":"Robustness: Performance guaranteed under complex acousitc environments, and also for transcribing speech in difficult text patterns.","text":"Robustness: Performance guaranteed under complex acousitc environments, and also for transcribing speech in difficult text patterns.","tokens":[{"type":"text","raw":"Robustness: Performance guaranteed under complex acousitc environments, and also for transcribing speech in difficult text patterns.","text":"Robustness: Performance guaranteed under complex acousitc environments, and also for transcribing speech in difficult text patterns.","escaped":false}]}]}]},{"type":"space","raw":"\n\n"},{"type":"hr","raw":"---\n"},{"type":"paragraph","raw":"**🌏 Supported Languages:**","text":"**🌏 Supported Languages:**","tokens":[{"type":"strong","raw":"**🌏 Supported Languages:**","text":"🌏 Supported Languages:","tokens":[{"type":"text","raw":"🌏 Supported Languages:","text":"🌏 Supported Languages:","escaped":false}]}]},{"type":"space","raw":"\n\n"},{"type":"paragraph","raw":"Qwen3-ASR-Flash delivers accurate transcription across a wide range of languages, dialects, and accents, all within a single model:\n","text":"Qwen3-ASR-Flash delivers accurate transcription across a wide range of languages, dialects, and accents, all within a single model:","tokens":[{"type":"text","raw":"Qwen3-ASR-Flash delivers accurate transcription across a wide range of languages, dialects, and accents, all within a single model:","text":"Qwen3-ASR-Flash delivers accurate transcription across a wide range of languages, dialects, and accents, all within a single model:","escaped":false}]},{"type":"list","raw":"* Chinese: Includes Mandarin as well as major dialects such as Sichuanese, Minnan (Hokkien), Wu, and Cantonese.\n* English: Supports British, American, and various other regional accents.\n* Other Supported Languages: French, German, Russian, Italian, Spanish, Portuguese, Japanese, Korean, and Arabic.\n","ordered":false,"start":"","loose":false,"items":[{"type":"list_item","raw":"* Chinese: Includes Mandarin as well as major dialects such as Sichuanese, Minnan (Hokkien), Wu, and Cantonese.\n","task":false,"loose":false,"text":"Chinese: Includes Mandarin as well as major dialects such as Sichuanese, Minnan (Hokkien), Wu, and Cantonese.","tokens":[{"type":"text","raw":"Chinese: Includes Mandarin as well as major dialects such as Sichuanese, Minnan (Hokkien), Wu, and Cantonese.","text":"Chinese: Includes Mandarin as well as major dialects such as Sichuanese, Minnan (Hokkien), Wu, and Cantonese.","tokens":[{"type":"text","raw":"Chinese: Includes Mandarin as well as major dialects such as Sichuanese, Minnan (Hokkien), Wu, and Cantonese.","text":"Chinese: Includes Mandarin as well as major dialects such as Sichuanese, Minnan (Hokkien), Wu, and Cantonese.","escaped":false}]}]},{"type":"list_item","raw":"* English: Supports British, American, and various other regional accents.\n","task":false,"loose":false,"text":"English: Supports British, American, and various other regional accents.","tokens":[{"type":"text","raw":"English: Supports British, American, and various other regional accents.","text":"English: Supports British, American, and various other regional accents.","tokens":[{"type":"text","raw":"English: Supports British, American, and various other regional accents.","text":"English: Supports British, American, and various other regional accents.","escaped":false}]}]},{"type":"list_item","raw":"* Other Supported Languages: French, German, Russian, Italian, Spanish, Portuguese, Japanese, Korean, and Arabic.","task":false,"loose":false,"text":"Other Supported Languages: French, German, Russian, Italian, Spanish, Portuguese, Japanese, Korean, and Arabic.","tokens":[{"type":"text","raw":"Other Supported Languages: French, German, Russian, Italian, Spanish, Portuguese, Japanese, Korean, and Arabic.","text":"Other Supported Languages: French, German, Russian, Italian, Spanish, Portuguese, Japanese, Korean, and Arabic.","tokens":[{"type":"text","raw":"Other Supported Languages: French, German, Russian, Italian, Spanish, Portuguese, Japanese, Korean, and Arabic.","text":"Other Supported Languages: French, German, Russian, Italian, Spanish, Portuguese, Japanese, Korean, and Arabic.","escaped":false}]}]}]},{"type":"hr","raw":"---\n"},{"type":"paragraph","raw":"**💡 Contextual Biasing:**","text":"**💡 Contextual Biasing:**","tokens":[{"type":"strong","raw":"**💡 Contextual Biasing:**","text":"💡 Contextual Biasing:","tokens":[{"type":"text","raw":"💡 Contextual Biasing:","text":"💡 Contextual Biasing:","escaped":false}]}]},{"type":"space","raw":"\n\n"},{"type":"paragraph","raw":"To obtain customized ASR results, Qwen3-ASR-Flash eliminates the need for preprocessing of contextual information. Users can provide background text in any format to get biased ASR results.\nSupported formats include, but are not limited to:\n","text":"To obtain customized ASR results, Qwen3-ASR-Flash eliminates the need for preprocessing of contextual information. Users can provide background text in any format to get biased ASR results.\nSupported formats include, but are not limited to:","tokens":[{"type":"text","raw":"To obtain customized ASR results, Qwen3-ASR-Flash eliminates the need for preprocessing of contextual information. Users can provide background text in any format to get biased ASR results.","text":"To obtain customized ASR results, Qwen3-ASR-Flash eliminates the need for preprocessing of contextual information. Users can provide background text in any format to get biased ASR results.","escaped":false},{"type":"br","raw":"\n"},{"type":"text","raw":"Supported formats include, but are not limited to:","text":"Supported formats include, but are not limited to:","escaped":false}]},{"type":"list","raw":"* A simple list of keywords or hotwords.\n* Full paragraphs or entire documents of any length and from any source.\n* A mix of keyword lists and full-text paragraphs in any format.\n* Irrelevant or even nonsensical text (Unrelated context hardly affects general reognition).","ordered":false,"start":"","loose":false,"items":[{"type":"list_item","raw":"* A simple list of keywords or hotwords.\n","task":false,"loose":false,"text":"A simple list of keywords or hotwords.","tokens":[{"type":"text","raw":"A simple list of keywords or hotwords.","text":"A simple list of keywords or hotwords.","tokens":[{"type":"text","raw":"A simple list of keywords or hotwords.","text":"A simple list of keywords or hotwords.","escaped":false}]}]},{"type":"list_item","raw":"* Full paragraphs or entire documents of any length and from any source.\n","task":false,"loose":false,"text":"Full paragraphs or entire documents of any length and from any source.","tokens":[{"type":"text","raw":"Full paragraphs or entire documents of any length and from any source.","text":"Full paragraphs or entire documents of any length and from any source.","tokens":[{"type":"text","raw":"Full paragraphs or entire documents of any length and from any source.","text":"Full paragraphs or entire documents of any length and from any source.","escaped":false}]}]},{"type":"list_item","raw":"* A mix of keyword lists and full-text paragraphs in any format.\n","task":false,"loose":false,"text":"A mix of keyword lists and full-text paragraphs in any format.","tokens":[{"type":"text","raw":"A mix of keyword lists and full-text paragraphs in any format.","text":"A mix of keyword lists and full-text paragraphs in any format.","tokens":[{"type":"text","raw":"A mix of keyword lists and full-text paragraphs in any format.","text":"A mix of keyword lists and full-text paragraphs in any format.","escaped":false}]}]},{"type":"list_item","raw":"* Irrelevant or even nonsensical text (Unrelated context hardly affects general reognition).","task":false,"loose":false,"text":"Irrelevant or even nonsensical text (Unrelated context hardly affects general reognition).","tokens":[{"type":"text","raw":"Irrelevant or even nonsensical text (Unrelated context hardly affects general reognition).","text":"Irrelevant or even nonsensical text (Unrelated context hardly affects general reognition).","tokens":[{"type":"text","raw":"Irrelevant or even nonsensical text (Unrelated context hardly affects general reognition).","text":"Irrelevant or even nonsensical text (Unrelated context hardly affects general reognition).","escaped":false}]}]}]},{"type":"space","raw":" \n"},{"type":"hr","raw":"---\n"},{"type":"paragraph","raw":"**🔮 Demos:**","text":"**🔮 Demos:**","tokens":[{"type":"strong","raw":"**🔮 Demos:**","text":"🔮 Demos:","tokens":[{"type":"text","raw":"🔮 Demos:","text":"🔮 Demos:","escaped":false}]}]},{"type":"space","raw":"\n\n"},{"type":"paragraph","raw":"*Qwen3-ASR-Flash single time inference without any context except Example2.*","text":"*Qwen3-ASR-Flash single time inference without any context except Example2.*","tokens":[{"type":"em","raw":"*Qwen3-ASR-Flash single time inference without any context except Example2.*","text":"Qwen3-ASR-Flash single time inference without any context except Example2.","tokens":[{"type":"text","raw":"Qwen3-ASR-Flash single time inference without any context except Example2.","text":"Qwen3-ASR-Flash single time inference without any context except Example2.","escaped":false}]}]},{"type":"space","raw":"\n\n"},{"type":"paragraph","raw":"Example1: Continuous noise of different types\n","text":"Example1: Continuous noise of different types","tokens":[{"type":"text","raw":"Example1: Continuous noise of different types","text":"Example1: Continuous noise of different types","escaped":false}]},{"type":"html","block":true,"raw":"<div>\n<audio controls><source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/noise3.wav\" type=\"audio/wav\"></audio>\n</div>\n\n","pre":false,"text":"<div>\n<audio controls><source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/noise3.wav\" type=\"audio/wav\"></audio>\n</div>\n\n"},{"type":"hugoFigure","name":"figure","src":"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/res-noise3.png","attributes":{"width":"80%"},"raw":"{{< figure src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/res-noise3.png\" width=\"80%\" >}}","tokens":[]},{"type":"space","raw":"\n\n"},{"type":"paragraph","raw":"Example2: CSGO match commentary\n","text":"Example2: CSGO match commentary","tokens":[{"type":"text","raw":"Example2: CSGO match commentary","text":"Example2: CSGO match commentary","escaped":false}]},{"type":"html","block":true,"raw":"<div>\n<audio controls><source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/csgo.wav\" type=\"audio/wav\"></audio>\n</div>\n\n","pre":false,"text":"<div>\n<audio controls><source src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/csgo.wav\" type=\"audio/wav\"></audio>\n</div>\n\n"},{"type":"hugoFigure","name":"figure","src":"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/res-csgo2.png","attributes":{"width":"80%"},"raw":"{{< figure src=\"https://qianwen-res.oss-cn-beijing.aliyuncs.com/Qwen3-ASR/res-csgo2.png\" width