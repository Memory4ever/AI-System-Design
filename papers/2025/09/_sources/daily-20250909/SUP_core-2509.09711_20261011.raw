<div class="ltx_flex_cell ltx_flex_size_1"><span class="ltx_inline-block"><svg id="S10.F8.pic1" class="ltx_picture ltx_centering ltx_figure_panel" height="61.05" overflow="visible" version="1.1" viewBox="0 0 664.39 61.05" width="664.39"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,61.05) matrix(1 0 0 -1 0 0) translate(332.2,0) translate(0,30.53)"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#F5F5F5;" fill="#F5F5F5" stroke="#808080"><path d="M 326.38 30.25 L -326.38 30.25 C -329.44 30.25 -331.92 27.77 -331.92 24.71 L -331.92 -24.71 C -331.92 -27.77 -329.44 -30.25 -326.38 -30.25 L 326.38 -30.25 C 329.44 -30.25 331.92 -27.77 331.92 -24.71 L 331.92 24.71 C 331.92 27.77 329.44 30.25 326.38 30.25 Z M -331.92 -30.25"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -325 12.95)"><foreignObject style="--ltx-fo-width:46.98em;--ltx-fo-height:0.75em;--ltx-fo-depth:2.62em;font-size:10pt;" height="46.66" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="650.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S10.F8.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:46.98em;">
<span id="S10.F8.pic1.1.1" class="ltx_p"></span><pre id="S10.F8.pic1.1.2" class="ltx_verbatim ltx_align_left ltx_font_typewriter">
