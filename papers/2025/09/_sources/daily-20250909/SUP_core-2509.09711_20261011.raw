<th id="S10.T20.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">P1</th>
<td id="S10.T20.2.2.2" class="ltx_td ltx_align_center ltx_border_t">0</td>
<td id="S10.T20.2.2.3" class="ltx_td ltx_align_center ltx_border_t">0</td>
<td id="S10.T20.2.2.4" class="ltx_td ltx_align_center ltx_border_t">56</td>
