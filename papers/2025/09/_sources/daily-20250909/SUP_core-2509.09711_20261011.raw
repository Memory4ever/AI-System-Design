<td id="S10.T21.2.3.2" class="ltx_td ltx_align_left"><span id="S10.T21.2.3.2.1" class="ltx_text ltx_font_bold ltx_framed ltx_framed_underline" style="--ltx-border-color:#000000;">73.99</span></td>
<td id="S10.T21.2.3.3" class="ltx_td ltx_align_left"><span id="S10.T21.2.3.3.1" class="ltx_text ltx_font_bold ltx_framed ltx_framed_underline" style="--ltx-border-color:#000000;">77.42</span></td>
<td id="S10.T21.2.3.4" class="ltx_td ltx_align_left"><span id="S10.T21.2.3.4.1" class="ltx_text ltx_font_bold ltx_framed ltx_framed_underline" style="--ltx-border-color:#000000;">77.78</span></td>
<td id="S10.T21.2.3.5" class="ltx_td ltx_align_left"><span id="S10.T21.2.3.5.1" class="ltx_text ltx_font_bold ltx_framed ltx_framed_underline" style="--ltx-border-color:#000000;">77.15</span></td>
<td id="S10.T21.2.3.6" class="ltx_td ltx_align_left"><span id="S10.T21.2.3.6.1" class="ltx_text ltx_font_bold ltx_framed ltx_framed_underline" style="--ltx-border-color:#000000;">76.32</span></td></tr>
<tr id="S10.T21.2.4" class="ltx_tr">
