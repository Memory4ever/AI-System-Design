{"data":[{"id":"10.48550/arxiv.2509.06336","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.06336","identifiers":[{"identifier":"2509.06336","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jeongmin","familyName":"Yu","name":"Yu, Jeongmin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Susang","familyName":"Kim","name":"Kim, Susang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kisu","familyName":"Lee","name":"Lee, Kisu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Taekyoung","familyName":"Kwon","name":"Kwon, Taekyoung","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Won-Yong","familyName":"Shin","name":"Shin, Won-Yong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ha Young","familyName":"Kim","name":"Kim, Ha Young","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Multi-View Slot Attention Using Paraphrased Texts for Face Anti-Spoofing"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"Cryptography and Security (cs.CR)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-08T04:53:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-09T00:59:57Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-15T05:55:24Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-16T01:03:57Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsIdentifier":"cc-by-nc-nd-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Recent face anti-spoofing (FAS) methods have shown remarkable cross-domain performance by employing vision-language models like CLIP. However, existing CLIP-based FAS models do not fully exploit CLIP's patch embedding tokens, failing to detect critical spoofing clues. Moreover, these models rely on a single text prompt per class (e.g., 'live' or 'fake'), which limits generalization. To address these issues, we propose MVP-FAS, a novel framework incorporating two key modules: Multi-View Slot attention (MVS) and Multi-Text Patch Alignment (MTPA). Both modules utilize multiple paraphrased texts to generate generalized features and reduce dependence on domain-specific text. MVS extracts local detailed spatial features and global context from patch embeddings by leveraging diverse texts with multiple perspectives. MTPA aligns patches with multiple text representations to improve semantic robustness. Extensive experiments demonstrate that MVP-FAS achieves superior generalization performance, outperforming previous state-of-the-art methods on cross-domain datasets. Code: https://github.com/Elune001/MVP-FAS."},{"descriptionType":"Other","description":"Accepted to ICCV 2025"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2509.06336","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-09T02:46:55Z","registered":"2025-09-09T02:46:56Z","published":null,"updated":"2025-09-16T03:40:10Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}}],"meta":{"total":1,"totalPages":1,"page":1},"links":{"self":"https://api.datacite.org/dois?client-id=arxiv.content\u0026page%5Bsize%5D=100\u0026query=registered%3A%5B2025-09-08T16%3A00%3A00Z%20TO%202025-09-09T15%3A59%3A59Z%5D%20AND%20doi%3A%2210.48550%2Farxiv.2509.06336%22"}}