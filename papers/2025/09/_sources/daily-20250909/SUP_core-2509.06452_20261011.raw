<tr id="S3.T1.2.4.1.1.2" class="ltx_tr">
<td id="S3.T1.2.4.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S3.T1.2.4.1.1.2.1.1" class="ltx_text" style="font-size:80%;">+ query completions</span></td></tr>
</table></td>
<td id="S3.T1.2.4.2" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t">
<table id="S3.T1.2.4.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S3.T1.2.4.2.1.1" class="ltx_tr">
<td id="S3.T1.2.4.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S3.T1.2.4.2.1.1.1.1" class="ltx_text ltx_font_bold">Configuration 3</span></td></tr>
<tr id="S3.T1.2.4.2.1.2" class="ltx_tr">
<td id="S3.T1.2.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S3.T1.2.4.2.1.2.1.1" class="ltx_text ltx_font_italic">audiobook</span>: 34.49 %</td></tr>
