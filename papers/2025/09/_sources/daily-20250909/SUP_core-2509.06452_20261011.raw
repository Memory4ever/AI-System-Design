<tr id="S3.T1.2.3.3.1.2" class="ltx_tr">
<td id="S3.T1.2.3.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S3.T1.2.3.3.1.2.1.1" class="ltx_text ltx_font_italic">audiobook</span>: 26.20 %</td></tr>
<tr id="S3.T1.2.3.3.1.3" class="ltx_tr">
<td id="S3.T1.2.3.3.1.3.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S3.T1.2.3.3.1.3.1.1" class="ltx_text ltx_font_italic">playlist</span>: 16.67 %</td></tr>
<tr id="S3.T1.2.3.3.1.4" class="ltx_tr">
<td id="S3.T1.2.3.3.1.4.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S3.T1.2.3.3.1.4.1.1" class="ltx_text ltx_font_italic">podcast</span>: 57.11 %</td></tr>
</table></td></tr>
<tr id="S3.T1.2.4" class="ltx_tr">
<td id="S3.T1.2.4.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t">
<table id="S3.T1.2.4.1.1" class="ltx_tabular ltx_align_middle">
