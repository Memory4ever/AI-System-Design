 max-width: 100%;
 overflow-x: hidden;
}
.e-loop-item {
 min-width:0px;
}
#spotlight-event-adjust, #popular-posts-adjust {
 margin-top:-48px;
}
.e-loop-item h1 a:hover, 
.e-loop-item h3 a:hover {
 text-decoration:underline;
}
.catcha-area  {
 transform:scale(0.85);
 transform-origin:0 0;
}  @media (min-width:801px) {
 .desktop-menu .menu-search-item {
 display:none!important;
 }
}
.searchwp-modal-form__overlay {
 background-color:var(--e-global-color-secondary)!important;
 opacity:0.9;
 color:var(--e-global-color-secondary)!important;
}
.search-field, .search-submit {
 border-color:var(--e-global-color-primary)!important;
 color:var(--e-global-color-primary);
}
input[type="search"] {
 border-radius:0px;
}
input[type="search"]:focus {
 border: 3px solid var(--e-global-color-primary)!important;
}
.search-submit:hover {
 background-color:var(--e-global-color-primary);
}
.searchwp-modal-form-default .searchwp-modal-form__content .search-form label input, .searchwp-modal-form-default .searchwp-modal-form__close {
 border-color:var(--e-global-color-primary)!important;
 color:var(--e-global-color-primary);
}
.micro-loop .e-loop-item:last-child .elementor-widget-divider {
 height:20px;
}
.micro-loop .e-loop-item:last-child .elementor-widget-divider .elementor-divider {
 display:none;
}
.page-numbers {
 font-size:16px!important;
 border:1px solid var(--e-global-color-secondary);
 padding: 10px 20px;
}
.author-index-navigation {
 text-align:center;
 border:3px solid var(--e-global-color-secondary);
 font-weight:900;
}
.author-index-navigation li a:hover {
 color:grey;
}
.author-index-navigation li a:active {
 color:var(--e-global-color-secondary);
}  .gform-button {
 color:white;
}
.contact-form .gform_required_legend {
 color:var(--e-global-color-primary);
}
h1 a, h3 a {
 font-family: "Oswald", Sans-serif!important;
 font-weight: 900!important;
 text-transform: none!important;
}
#lostpasswordform p, #lostpasswordform a, #lostpasswordform legend, #lostpasswordform button {
 font-family: "Mulish", sans-serif;
 font-size: 16px;
 font-weight: 400;
 line-height: 24px
}
.mobile-menu .eael-simple-menu {
 min-height:100vh;
 background-color:var(--e-global-color-secondary)!important;
 opacity:0.9;
 padding-top:20vh!important;
}
.mobile-menu ul:has(.eael-simple-menu-indicator-open) {
 padding-top:0vh!important;
}
.social-bar-footer div , .social-bar-header .elementor-icon-wrapper {
 border-left:1px solid white;
}
.social-bar-footer div:nth-child(1) {
 border-left:0px!important;
}
.social-bar-header .elementor-icon-wrapper   {
 padding:5px 0px 0px 10px; 
}
.social-bar-footer .elementor-icon-wrapper  {
 padding:5px 0vw 0px 1vw; 
}
@media (max-width:801px) {
 .social-bar-footer .elementor-icon-wrapper  {
 padding:5px 5vw 0px 5vw;
} 
 .social-bar-footer div , .social-bar-header .elementor-icon-wrapper {
 border-left:none;
}
}
/*api post feed*/
#tf_post_list {
 display:flex;
 columns: 3; 
 width:100%;
 margin:0px;
 padding:0px;
 gap: 30px;
}
@media only screen and (max-width: 768px) {
 #tf_post_list {
 flex-direction:column!important;
 columns: 1!important;
 }
 #tf_article_list {
 flex-direction:column!important;
 columns: 1!important;
 padding:5%!important;
 }
 .tf_post_row {
 columns: 1!important;
 flex-direction:column!important;
 } 
.tf-post-inline {
 height:60px!important;
 }
}
#tf_article_list {
 display:flex;
 flex-direction:column;
 columns: 3; 
 gap: 20px;
 width:100%;
 margin:0px;
 padding:0px;
}
.tf_post_row {
 display:flex;
 gap: 20px;
 margin:0px;
 padding:0px;
}
.tf_post {
 flex: 1;
 display: flex;
 flex-direction: column;
 margin:0px;
 padding:0px;
}
.tf-post-inline {
 height:30px;
 display: flex;
 flex-direction: row;
 margin-bottom:-10px;
}
.tf_post .sd_post_content {
 flex-grow: 1;
}
.tf_post_image {
 width: 100%;
}
.tf_post_image img {
 width:100%;
 height:320px;
 object-fit:cover;
}  .tf_post_title h2 {
 font-family: "Oswald", sans-serif!important;
 font-size: 20px!important;
 font-weight: 900!important;
 line-height: 26px!important;
}
.tf_post_title h2 a {
 color:black;
}
.tf_post_tags {
 display:flex;
 flex-direction:row;
}
.tf_post_author p {
 margin-top:5px;
 color:var(--e-global-color-secondary);
 font-weight:700;
 font-size:12px;
}
.tf_post_date {
 margin-left: auto;
}
.tf_post_date p {
 margin-top:5px;
 margin-left:10px;
 color:#aaaaaa;
 font-weight:700;
 font-size:12px;
}
.tf_post_tags {
 display:flex;
 flex-direction:row;
 fill:whitesmoke;
}  .tf_post_tags p {
 margin-top:5px;
 margin-bottom:10px;
 padding-left:12px;
 color:whitesmoke;
 font-weight:500;
 font-size:12px;
}
.tf_post_source a {
 margin-right:5px;
 font-weight:700;
 font-size:12px!important;
}
.tf_post_content {
 color:whitesmoke;
}
.tf_post_content p::after {
 content:'...';
}
.tf_post_content a {
 display:none;
}
.elementor-button-text {
 text-decoration: underline!important;
 text-decoration-color: var(--e-global-color-primary)!important;
 text-underline-offset: 8px;
}
.elementor-button-icon {
 fill:var(--e-global-color-primary)!important;
}
.gfield--type-html {
 color:grey;
} </style></head><body data-cmplz=1 class="wp-singular post-template-default single single-post postid-109271 single-format-standard wp-custom-logo wp-embed-responsive wp-theme-hello-elementor hello-elementor-default elementor-default elementor-kit-16829 elementor-page-16957"> <a class="skip-link screen-reader-text" href="#content">Skip to content</a><header data-elementor-type="header" data-elementor-id="16980" class="elementor elementor-16980 elementor-location-header" data-elementor-post-type="elementor_library"><div class="elementor-element elementor-element-29a52ff3 e-con-full e-flex e-con e-parent" data-id="29a52ff3" data-element_type="container" data-e-type="container" id="100" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}"><div class="elementor-element elementor-element-6c2a3712 e-con-full e-flex e-con e-child" data-id="6c2a3712" data-element_type="container" data-e-type="container" id="header-pubs-dropdown"><div class="elementor-element elementor-element-713f392d elementor-widget elementor-widget-text-editor" data-id="713f392d" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default"><div class="elementor-widget-container"><p>AI News is part of the TechForge Publications series</p></div></div><div class="elementor-element elementor-element-dbe2ddb elementor-nav-menu__align-justify elementor-widget-mobile__width-inherit elementor-widget__width-inherit elementor-nav-menu--dropdown-none elementor-hidden-mobile techforge-dropdown elementor-widget elementor-widget-nav-menu" data-id="dbe2ddb" data-element_type="widget" data-e-type="widget" data-settings="{&quot;layout&quot;:&quot;horizontal&quot;,&quot;submenu_icon&quot;:{&quot;value&quot;:&quot;&lt;svg aria-hidden=\&quot;true\&quot; class=\&quot;e-font-icon-svg e-fas-caret-down\&quot; viewBox=\&quot;0 0 320 512\&quot; xmlns=\&quot;http:\/\/www.w3.org\/2000\/svg\&quot;&gt;&lt;path d=\&quot;M31.3 192h257.3c17.8 0 26.7 21.5 14.1 34.1L174.1 354.8c-7.8 7.8-20.5 7