<td id="S4.T5.6.7.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T5.6.7.7.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;--ltx-bg-color:#ECECEC;">63.8</span></td></tr>
