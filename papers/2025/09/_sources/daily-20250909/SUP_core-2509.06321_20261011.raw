<td id="S4.T11.6.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T11.6.1.4.1" class="ltx_text ltx_font_bold">refCOCO+</span></td>
<td id="S4.T11.6.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T11.6.1.5.1" class="ltx_text ltx_font_bold">refCOCOg</span></td></tr>
