<td id="S4.T2.6.36.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding:-0.1pt 7.0pt;"><span id="S4.T2.6.36.2.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">Qwen2.5-14B</span></td>
