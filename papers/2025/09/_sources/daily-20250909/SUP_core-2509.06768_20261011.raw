<td id="S4.T1.2.4.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.4.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">22.1</span></td></tr>
<tr id="S4.T1.2.5" class="ltx_tr">
<th id="S4.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="S4.T1.2.5.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Anomalies Detected</span></th>
<td id="S4.T1.2.5.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.5.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">–</span></td>
<td id="S4.T1.2.5.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.5.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">2</span></td></tr>
<tr id="S4.T1.2.6" class="ltx_tr">
<th id="S4.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="S4.T1.2.6.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Sudden Stops</span></th>
