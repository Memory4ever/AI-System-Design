<tr id="S4.T1.2.3" class="ltx_tr">
<th id="S4.T1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="S4.T1.2.3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Total Trajectory (m)</span></th>
<td id="S4.T1.2.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T1.2.3.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">5.76</span></td>
<td id="S4.T1.2.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S4.T1.2.3.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">5.76</span></td></tr>
<tr id="S4.T1.2.4" class="ltx_tr">
<th id="S4.T1.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="S4.T1.2.4.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Total Time (s)</span></th>
