<td id="S4.T1.2.6.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.2.6.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">15</span></td></tr>
<tr id="S4.T1.2.7" class="ltx_tr">
<th id="S4.T1.2.7.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t" colspan="3"><span id="S4.T1.2.7.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Test 2: Autonomous Navigation</span></th></tr>
<tr id="S4.T1.2.8" class="ltx_tr">
<th id="S4.T1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="S4.T1.2.8.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Total Trajectory (m)</span></th>
