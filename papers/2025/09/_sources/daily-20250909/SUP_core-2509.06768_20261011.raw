<td id="S5.T3.2.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T3.2.4.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">16.7%</span></td>
<td id="S5.T3.2.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T3.2.4.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">16.7%</span></td></tr>
