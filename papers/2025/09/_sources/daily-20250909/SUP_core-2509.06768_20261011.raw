<td id="S5.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T3.2.2.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">20%</span></td>
<td id="S5.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T3.2.2.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">6.7%</span></td></tr>
<tr id="S5.T3.2.3" class="ltx_tr">
