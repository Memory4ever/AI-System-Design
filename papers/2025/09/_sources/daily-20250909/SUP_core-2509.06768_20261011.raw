<span id="S5.T3.2.5.1.1.2" class="ltx_p"><span id="S5.T3.2.5.1.1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">anomaly detection was active</span></span>
</span></td>
<td id="S5.T3.2.5.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t"><span id="S5.T3.2.5.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">70%</span></td>
