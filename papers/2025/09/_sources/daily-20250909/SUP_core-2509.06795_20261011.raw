<td id="S5.T5.4.12.2" class="ltx_td ltx_align_center"><span id="S5.T5.4.12.2.1" class="ltx_text" style="font-size:90%;">46.09%</span></td>
<td id="S5.T5.4.12.3" class="ltx_td ltx_align_center"><span id="S5.T5.4.12.3.1" class="ltx_text" style="font-size:90%;">75.00%</span></td></tr>
