<td id="S5.T4.19.12.8" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T4.19.12.8.1" class="ltx_text" style="font-size:90%;">1.00%</span></td>
<td id="S5.T4.19.12.9" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T4.19.12.9.1" class="ltx_text" style="font-size:90%;">10.49%</span></td></tr>
<tr id="S5.T4.19.13" class="ltx_tr">
<td id="S5.T4.19.13.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T4.19.13.1.1" class="ltx_text" style="font-size:90%;">w/o Loss<sub id="S5.T4.19.13.1.1.1" class="ltx_sub"><span id="S5.T4.19.13.1.1.1.1" class="ltx_text ltx_font_italic">CL</span></sub></span></td>
<td id="S5.T4.19.13.2" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T4.19.13.2.1" class="ltx_text" style="font-size:90%;">0.91%</span></td>
<td id="S5.T4.19.13.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T4.19.13.3.1" class="ltx_text" style="font-size:90%;">11.00%</span></td>
