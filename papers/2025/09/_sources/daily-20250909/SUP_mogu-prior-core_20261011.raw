<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Collection of Rejection Expressions</h2>

<figure id="A1.T5" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 5: </span>Rejection expressions.</figcaption>
<table id="A1.T5.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="A1.T5.2.1" class="ltx_tr">
<td id="A1.T5.2.1.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r ltx_border_tt" rowspan="5"><span id="A1.T5.2.1.1.1" class="ltx_text">Rejection Expression</span></td>
<td id="A1.T5.2.1.2" class="ltx_td ltx_align_left ltx_border_tt">I’m sorry</td>
<td id="A1.T5.2.1.3" class="ltx_td ltx_align_left ltx_border_tt">I do not</td></tr>
<tr id="A1.T5.2.2" class="ltx_tr">
<td id="A1.T5.2.2.1" class="ltx_td ltx_align_left">Sorry</td>
<td id="A1.T5.2.2.2" class="ltx_td ltx_align_left">I cannot create</td></tr>
