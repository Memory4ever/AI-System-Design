                            <h1 class="mb-2 text-break fs-5 text-justify " dir="ltr"><span class="article_title fw-bold"> EPT Benchmark: Evaluation of Persian Trustworthiness in Large Language Models</span></h1>
                                <div>
                                                
                                                
                                        <div class="mb-1">
                                                                                    </div>
            
                                                                                    <p class="mb-1">Document Type : Research Article</p>
                                                    
                                                
                                                                            <p class="p-1"><strong>Authors</strong></p>
            
