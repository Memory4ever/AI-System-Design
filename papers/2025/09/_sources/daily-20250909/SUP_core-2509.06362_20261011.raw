<div id="alg2.l17" class="ltx_listingline">
                  <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
                  
                 <span id="alg2.l17.2" class="ltx_text ltx_font_bold">return</span>  <math id="alg2.l17.m1" class="ltx_Math" alttext="[G_{t},G_{l}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>G</mi><mi>t</mi></msub><mo>,</mo><msub><mi>G</mi><mi>l</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[G_{t},G_{l}]</annotation></semantics></math>, <math id="alg2.l17.m2" class="ltx_Math" alttext="[\mathcal{I}^{t},\mathcal{I}^{l}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>t</mi></msup><mo>,</mo><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mi>l</mi></msup><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[\mathcal{I}^{t},\mathcal{I}^{l}]</annotation></semantics></math>

