<td id="S5.T1.1.12.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" rowspan="2"><span id="S5.T1.1.12.2.1" class="ltx_text">300-500</span></td>
<td id="S5.T1.1.12.3" class="ltx_td ltx_align_center ltx_border_t">0.8-1.0</td>
