<td id="S5.T1.1.6.4" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="S5.T1.1.6.4.1" class="ltx_text"><math id="S5.T1.m5" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math></span></td></tr>
