<td id="S5.T1.1.3.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.1.3.2.1" class="ltx_text">300-1000</span></td>
<td id="S5.T1.1.3.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.1.3.3.1" class="ltx_text">0.8-1.5</span></td>
<td id="S5.T1.1.3.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T1.1.3.4.1" class="ltx_text"><math id="S5.T1.m3" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math></span></td></tr>
