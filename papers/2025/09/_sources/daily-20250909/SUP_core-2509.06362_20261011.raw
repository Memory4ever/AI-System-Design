<td id="S5.T1.1.2.2" class="ltx_td ltx_align_center"><span id="S5.T1.1.2.2.1" class="ltx_text ltx_font_bold">(<math id="S5.T1.m1" class="ltx_Math" alttext="S_{r}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>r</mi></msub><annotation encoding="application/x-tex">S_{r}</annotation></semantics></math> tokens)</span></td>
<td id="S5.T1.1.2.3" class="ltx_td ltx_align_center">(<math id="S5.T1.m2" class="ltx_Math" alttext="\theta_{r}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\theta_{r}</annotation></semantics></math>)</td></tr>
