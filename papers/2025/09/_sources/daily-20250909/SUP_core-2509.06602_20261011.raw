            <span id="alg1.l7.3" class="ltx_text ltx_font_bold">for</span> each <math id="alg1.l7.m1" class="ltx_Math" alttext="note\in notes" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>∈</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><annotation encoding="application/x-tex">note\in notes</annotation></semantics></math> <span id="alg1.l7.4" class="ltx_text ltx_font_bold">do</span>

</div>
