<td id="S4.T1.3.1.8.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="S4.T1.3.1.8.1.1" class="ltx_text ltx_font_bold">Average</span></td>
<td id="S4.T1.3.1.8.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.3.1.8.2.1" class="ltx_text ltx_font_bold">79.67%</span></td>
<td id="S4.T1.3.1.8.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.3.1.8.3.1" class="ltx_text ltx_font_bold">86.00%</span></td>
<td id="S4.T1.3.1.8.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S4.T1.3.1.8.4.1" class="ltx_text ltx_font_bold">85.67%</span></td></tr>
