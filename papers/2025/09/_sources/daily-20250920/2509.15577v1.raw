<span id="S4.T1.2.1.1.4.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T1.2.1.1.4.1.2.1.2.1.1" class="ltx_text ltx_font_bold">Size</span></span></span>
</span></span><span id="S4.T1.2.1.1.4.1.3" class="ltx_text"></span></span></td>
<td id="S4.T1.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S4.T1.2.1.1.5.1" class="ltx_text ltx_font_bold">AmbigQA</span></td>
<td id="S4.T1.2.1.1.6" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S4.T1.2.1.1.6.1" class="ltx_text ltx_font_bold">HotpotQA</span></td>
<td id="S4.T1.2.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S4.T1.2.1.1.7.1" class="ltx_text ltx_font_bold">2WIKI</span></td>
<td id="S4.T1.2.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" colspan="2"><span id="S4.T1.2.1.1.8.1" class="ltx_text ltx_font_bold">MuSiQue</span></td>
<td id="S4.T1.2.1.1.9" class="ltx_td ltx_align_center ltx_border_l ltx_border_tt" colspan="2"><span id="S4.T1.2.1.1.9.1" class="ltx_text ltx_font_bold">Average</span></td></tr>
<tr id="S4.T1.2.1.2" class="ltx_tr">
<td id="S4.T1.2.1.2.1" class="ltx_td ltx_align_center ltx_border_t">EM</td>
<td id="S4.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t">F1</td>
