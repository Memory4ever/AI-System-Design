<td id="S4.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S4.T1.2.1.1.2.1" class="ltx_text"><span id="S4.T1.2.1.1.2.1.1" class="ltx_text"></span> <span id="S4.T1.2.1.1.2.1.2" class="ltx_text">
<span id="S4.T1.2.1.1.2.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.2.1.1.2.1.2.1.1" class="ltx_tr">
<span id="S4.T1.2.1.1.2.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T1.2.1.1.2.1.2.1.1.1.1" class="ltx_text ltx_font_bold">True</span></span></span>
<span id="S4.T1.2.1.1.2.1.2.1.2" class="ltx_tr">
<span id="S4.T1.2.1.1.2.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T1.2.1.1.2.1.2.1.2.1.1" class="ltx_text ltx_font_bold">Utility</span></span></span>
</span></span><span id="S4.T1.2.1.1.2.1.3" class="ltx_text"></span></span></td>
<td id="S4.T1.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S4.T1.2.1.1.3.1" class="ltx_text ltx_font_bold">Distill</span></td>
<td id="S4.T1.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S4.T1.2.1.1.4.1" class="ltx_text"><span id="S4.T1.2.1.1.4.1.1" class="ltx_text"></span> <span id="S4.T1.2.1.1.4.1.2" class="ltx_text">
<span id="S4.T1.2.1.1.4.1.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.2.1.1.4.1.2.1.1" class="ltx_tr">
<span id="S4.T1.2.1.1.4.1.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S4.T1.2.1.1.4.1.2.1.1.1.1" class="ltx_text ltx_font_bold">Module</span></span></span>
