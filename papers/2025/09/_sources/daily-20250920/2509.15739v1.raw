<td id="S5.T8.2.9.15" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_bb" style="padding-left:3.3pt;padding-right:3.3pt;">0.51</td>
<td id="S5.T8.2.9.16" class="ltx_td ltx_nopad_l ltx_border_bb" style="padding-left:3.3pt;padding-right:3.3pt;"></td>
<td id="S5.T8.2.9.17" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:3.3pt;padding-right:3.3pt;">0.29</td>
