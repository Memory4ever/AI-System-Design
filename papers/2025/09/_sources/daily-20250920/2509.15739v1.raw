<td id="A2.T10.2.4.2" class="ltx_td ltx_align_right ltx_border_t">282</td></tr>
<tr id="A2.T10.2.5" class="ltx_tr">
<th id="A2.T10.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Avg. In-Degree</th>
<td id="A2.T10.2.5.2" class="ltx_td ltx_align_right">0.92 <math id="A2.T10.m1" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 2.14</td></tr>
<tr id="A2.T10.2.6" class="ltx_tr">
<th id="A2.T10.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Avg. Out-Degree</th>
<td id="A2.T10.2.6.2" class="ltx_td ltx_align_right">0.92 <math id="A2.T10.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.25</td></tr>
<tr id="A2.T10.2.7" class="ltx_tr">
<th id="A2.T10.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"># Edges</th>
<td id="A2.T10.2.7.2" class="ltx_td ltx_align_right ltx_border_t">260</td></tr>
<tr id="A2.T10.2.8" class="ltx_tr">
<th id="A2.T10.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">      # Support Edges</th>
<td id="A2.T10.2.8.2" class="ltx_td ltx_align_right">140</td></tr>
<tr id="A2.T10.2.9" class="ltx_tr">
