<td id="S3.T2.6.1.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="S3.T2.6.1.2.1" class="ltx_text ltx_font_sansserif ltx_font_bold" style="font-size:80%;">Specification (Value)</span></td></tr>
