<td id="S1.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S1.T1.2.1.3.2.1" class="ltx_text ltx_font_bold">Heterogeneous query size</span></td>
<td id="S1.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S1.T1.2.1.3.3.1" class="ltx_text ltx_font_bold">Exact <span id="S1.T1.2.1.3.3.1.1" class="ltx_text ltx_font_typewriter">Oracle</span>?</span></td>
<td id="S1.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S1.T1.2.1.3.4.1" class="ltx_text ltx_font_bold">Problem-dependent regret</span></td>
<td id="S1.T1.2.1.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S1.T1.2.1.3.5.1" class="ltx_text ltx_font_bold">Problem-independent regret</span></td></tr>
<tr id="S1.T1.2.1.4" class="ltx_tr">
<td id="S1.T1.2.1.4.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_t"><span id="S1.T1.2.1.4.1.1" class="ltx_text ltx_font_bold">VSOCB (<a href="#alg1" title="In 4.1 Algorithm with Exact Oracle ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">1</span></a>)</span></td>
<td id="S1.T1.2.1.4.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S1.T1.m5" class="ltx_Math" alttext="\surd" display="inline" intent=":literal"><semantics><mo>√</mo><annotation encoding="application/x-tex">\surd</annotation></semantics></math></td>
<td id="S1.T1.2.1.4.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S1.T1.m6" class="ltx_Math" alttext="\surd" display="inline" intent=":literal"><semantics><mo>√</mo><annotation encoding="application/x-tex">\surd</annotation></semantics></math></td>
<td id="S1.T1.2.1.4.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S1.T1.m7" class="ltx_Math" alttext="\widetilde{O}\left(\sum_{q\in\mathcal{M}^{*}}\frac{P(q)MN}{\Delta_{q}}\right)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup></mrow></msub><mfrac><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><msub><mi mathvariant="normal">Δ</mi><mi>q</mi></msub></mfrac></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{O}\left(\sum_{q\in\mathcal{M}^{*}}\frac{P(q)MN}{\Delta_{q}}\right)</annotation></semantics></math> (<a href="#S4.Thmtheorem4" title="Theorem 4.4. ‣ 4.2 Exact Solution Bound ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.4</span></a>)</td>
<td id="S1.T1.2.1.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S1.T1.m8" class="ltx_Math" alttext="\widetilde{O}\left(\sqrt{MNT}\right)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msqrt><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{O}\left(\sqrt{MNT}\right)</annotation></semantics></math> (<a href="#S4.Thmtheorem4" title="Theorem 4.4. ‣ 4.2 Exact Solution Bound ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">4.4</span></a>)</td></tr>
<tr id="S1.T1.2.1.5" class="ltx_tr">
<td id="S1.T1.2.1.5.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_l"><span id="S1.T1.2.1.5.1.1" class="ltx_text ltx_font_bold">VSOCB-APX</span></td>
<td id="S1.T1.2.1.5.2" class="ltx_td ltx_align_center ltx_border_b"><math id="S1.T1.m9" class="ltx_Math" alttext="\surd" display="inline" intent=":literal"><semantics><mo>√</mo><annotation encoding="application/x-tex">\surd</annotation></semantics></math></td>
<td id="S1.T1.2.1.5.3" class="ltx_td ltx_align_center ltx_border_b"><math id="S1.T1.m10" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S1.T1.2.1.5.4" class="ltx_td ltx_align_center ltx_border_b"><math id="S1.T1.m11" class="ltx_Math" alttext="\widetilde{O}\left(\sum_{q\in\mathcal{Q}}\frac{P(q)N(N-l_{min})}{\Delta_{q}^{c}}\right)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow></msub><mfrac><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>l</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>q</mi><mi>c</mi></msubsup></mfrac></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{O}\left(\sum_{q\in\mathcal{Q}}\frac{P(q)N(N-l_{min})}{\Delta_{q}^{c}}\right)</annotation></semantics></math> (<a href="#S5.Thmtheorem4" title="Theorem 5.4. ‣ 5.2 Approximate Solution Bound ‣ 5 VSOCB with Approximate Oracle ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.4</span></a>)</td>
<td id="S1.T1.2.1.5.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r"><math id="S1.T1.m12" class="ltx_Math" alttext="\widetilde{O}\left(\sqrt{N(N-l_{min})T}\right)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msqrt><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>l</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{O}\left(\sqrt{N(N-l_{min})T}\right)</annotation></semantics></math> (<a href="#S5.Thmtheorem4" title="Theorem 5.4. ‣ 5.2 Approximate Solution Bound ‣ 5 VSOCB with Approximate Oracle ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">5.4</span></a>)</td></tr>
</tbody>
</table>
<ul id="S1.I1" class="ltx_itemize ltx_centering">
<li id="S1.I1.1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item"></span>
<div id="S1.I1.p1" class="ltx_para">
<p id="S1.I1.p1.1" class="ltx_p"><math id="S1.I1.p1.m1" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> is the set of all queries, <math id="S1.I1.p1.m2" class="ltx_Math" alttext="\mathcal{M}^{*}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathcal{M}^{*}</annotation></semantics></math> is the optimal cache, <math id="S1.I1.p1.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is the number of queries, <math id="S1.I1.p1.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math> is the size of cache, <math id="S1.I1.p1.m5" class="ltx_Math" alttext="l_{min}" display="inline" intent=":literal"><semantics><msub><mi>l</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><annotation encoding="application/x-tex">l_{min}</annotation></semantics></math>is the minimum number of queries required to fill the cache as much as possible, <math id="S1.I1.p1.m6" class="ltx_Math" alttext="P(q)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(q)</annotation></semantics></math> is the sampling probability of query <math id="S1.I1.p1.m7" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, <math id="S1.I1.p1.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is the time horizon, <math id="S1.I1.p1.m9" class="ltx_Math" alttext="\Delta_{q},\Delta_{q}^{c}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>q</mi></msub><mo>,</mo><msubsup><mi mathvariant="normal">Δ</mi><mi>q</mi><mi>c</mi></msubsup></mrow><annotation encoding="application/x-tex">\Delta_{q},\Delta_{q}^{c}</annotation></semantics></math> represent the complementary gap and the approximate gap between the cache containing <math id="S1.I1.p1.m10" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> and the optimal cache respectively. From the table, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> lacks an analysis of the problem-dependent form of regret, and when <span id="S1.I1.p1.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> provides an exact solution, the regret bound of our algorithm outperforms that of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> the coefficient of <math id="S1.I1.p1.m11" class="ltx_Math" alttext="\sqrt{MN}" display="inline" intent=":literal"><semantics><msqrt><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{MN}</annotation></semantics></math>.</p>
</div></li>
</ul>
</span></div>
</figure>
<div id="S1.p14" class="ltx_para ltx_noindent">
<p id="S1.p14.1" class="ltx_p">Table <a href="#S1.T1" title="Table 1 ‣ 1 Introduction ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> summarizes our key findings and provides a detailed comparison with prior work, demonstrating the advantages of our approach in terms of both generalization and computational efficiency.</p>
</div>
</section>
<section id="S2" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">2 </span>Related work</h2>

<div id="S2.p1" class="ltx_para ltx_noindent">
<p id="S2.p1.1" class="ltx_p"><span id="S2.p1.1.1" class="ltx_text ltx_font_bold">Cache for LLMs:</span> In the field of LLM, cache technology can address the issue of repeated inquiries, thereby reducing the cost of the LLM marketplace <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">4</a>]</cite>. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib10" title="" class="ltx_ref">10</a>, <a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite> focus on content reuse during the inference phase, aimed to optimize the internal data flow within LLMs. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">5</a>]</cite> is recognized in the industry for its simplicity and flexibility, providing various options for integration with different LLMChat services. <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite> leverage semantic understanding of queries to improve cache hit rates through a semantic-oriented caching approach.
Beyond these works, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> propose an online learning-based caching algorithm to minimize resource waste. While they briefly discuss the potential of extending their method to accommodate variable-sized queries, they do not provide a rigorous theoretical analysis or concrete solutions. Our work builds upon their approach by generalizing caching to variable-size constraints, addressing a critical gap in dynamic query management.</p>
</div>
<div id="S2.p2" class="ltx_para ltx_noindent">
<p id="S2.p2.1" class="ltx_p"><span id="S2.p2.1.1" class="ltx_text ltx_font_bold">Knapsack problem:</span> The Knapsack Problem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite> is a fundamental problem in optimization and computer science, frequently used in resource allocation and selection tasks.
In our work, the knapsack problem serves as the foundation for our cache selection strategy, helping determine which queries should be stored or evicted efficiently. Specifically, we model our problem as a 0-1 Knapsack Problem and employ dynamic programming <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib12" title="" class="ltx_ref">12</a>]</cite> as an <span id="S2.p2.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> for updating our cache replacement policy.
Additionally, the Online Knapsack Problem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite> is a variant where decisions must be made without knowledge of future inputs, making it particularly relevant to online caching scenarios. Another relevant extension is the Minimum Knapsack Problem (MKP) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>, <a href="#bib.bib15" title="" class="ltx_ref">15</a>]</cite>, which differs from the traditional 0/1 Knapsack by seeking to minimize an objective while satisfying specific constraints, rather than maximizing it. These formulations inform our approach to adaptive cache selection under variable query sizes.</p>
</div>
<div id="S2.p3" class="ltx_para ltx_noindent">
<p id="S2.p3.1" class="ltx_p"><span id="S2.p3.1.1" class="ltx_text ltx_font_bold">Multi-armed bandit:</span>
A natural extension of multi-armed bandit is the Combinatorial Multi-Armed Bandit (CMAB) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>, <a href="#bib.bib16" title="" class="ltx_ref">16</a>]</cite>, where a super arm consists of multiple base arms that are played simultaneously. In our work, we model each query as an arm, with its cost following an unknown distribution. Under this formulation, Upper Confidence Bound (UCB)-type methods provide a principled approach to managing uncertainty and making optimal caching decisions. From the perspective of the CMAB, we can regard the cache as a super arm. However, CMAB model cannot be directly adapted to our setting. On the one hand, feedback can only be obtained for queries that are not selected, which is the opposite of the traditional bandit feedback mechanism. On the other hand, in our online setting, each cache selection is restricted. Unlike CMAB, where super arms can be freely composed from all base arms, in our setting, the cache can only be chosen from the current cache and the query that has just arrived.</p>
</div>
</section>
<section id="S3" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Problem Setting</h2>

<section id="S3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Caching with Variable Size Query</h3>

<div id="S3.SS1.p1" class="ltx_para ltx_noindent">
<p id="S3.SS1.p1.1" class="ltx_p">We consider a finite set of queries <math id="S3.SS1.p1.m1" class="ltx_Math" alttext="\displaystyle\mathcal{Q}=\{q_{1},...,q_{N}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>q</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>q</mi><mi>N</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{Q}=\{q_{1},...,q_{N}\}</annotation></semantics></math> containing <math id="S3.SS1.p1.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> distinct queries, each query <math id="S3.SS1.p1.m3" class="ltx_Math" alttext="q\in\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">q\in\mathcal{Q}</annotation></semantics></math> is associated with a size <math id="S3.SS1.p1.m4" class="ltx_Math" alttext="L(q)\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">L(q)\in\mathbb{N}_{+}</annotation></semantics></math>. When query <math id="S3.SS1.p1.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> is input to the LLM system, the LLM processes it and returns a corresponding result with size <math id="S3.SS1.p1.m6" class="ltx_Math" alttext="A(q)\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">A(q)\in\mathbb{N}_{+}</annotation></semantics></math>. We use <math id="S3.SS1.p1.m7" class="ltx_Math" alttext="S(q)=L(q)+A(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">S(q)=L(q)+A(q)</annotation></semantics></math> to denote the <span id="S3.SS1.p1.1.1" class="ltx_text ltx_font_italic">total query size</span> of <math id="S3.SS1.p1.m8" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. Each distinct query has a sampling probability, which represents its frequency of occurrence. In each round, a query is received, which is sampled from <math id="S3.SS1.p1.m9" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> according to the fixed sample distribution. We use <math id="S3.SS1.p1.m10" class="ltx_Math" alttext="P(q)\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">P(q)\in(0,1]</annotation></semantics></math> to denote the sampling probability that query <math id="S3.SS1.p1.m11" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> be selected such that <math id="S3.SS1.p1.m12" class="ltx_Math" alttext="\sum_{q\in\mathcal{Q}}P(q)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow></msub><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{q\in\mathcal{Q}}P(q)=1</annotation></semantics></math>. Each time the LLM processes <math id="S3.SS1.p1.m13" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, it will incur a random cost <math id="S3.SS1.p1.m14" class="ltx_Math" alttext="C(q)" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(q)</annotation></semantics></math>, which is supported on <math id="S3.SS1.p1.m15" class="ltx_Math" alttext="[c_{1},c_{2}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>c</mi><mn>1</mn></msub><mo>,</mo><msub><mi>c</mi><mn>2</mn></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[c_{1},c_{2}]</annotation></semantics></math> with <math id="S3.SS1.p1.m16" class="ltx_Math" alttext="c_{2}&gt;c_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>&gt;</mo><msub><mi>c</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{2}&gt;c_{1}&gt;0</annotation></semantics></math>. The cost can be expressed as:</p>
<table id="S3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex1.m1" class="ltx_Math" alttext="\textstyle C(q)=C^{*}(q)+\epsilon_{q}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>ϵ</mi><mi>q</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle C(q)=C^{*}(q)+\epsilon_{q}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p1.2" class="ltx_p">where <math id="S3.SS1.p1.m17" class="ltx_Math" alttext="\epsilon_{q}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mi>q</mi></msub><annotation encoding="application/x-tex">\epsilon_{q}</annotation></semantics></math> is a sub-Gaussian noise that captures the uncertainties in the cost, with <math id="S3.SS1.p1.m18" class="ltx_Math" alttext="\mathbb{E}[\epsilon_{q}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>ϵ</mi><mi>q</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[\epsilon_{q}]=0</annotation></semantics></math>.
The expected true cost <math id="S3.SS1.p1.m19" class="ltx_Math" alttext="C^{*}(q)=\mathbb{E}[C(q)]" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C^{*}(q)=\mathbb{E}[C(q)]</annotation></semantics></math> is the mean cost of processing query <math id="S3.SS1.p1.m20" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>.
This model is aligned with <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>.</p>
</div>
<div id="S3.Thmtheorem1" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem1.2" class="ltx_text ltx_font_italic">Remark 3.1</span></span><span id="S3.Thmtheorem1.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmtheorem1.p1" class="ltx_para">
<p id="S3.Thmtheorem1.p1.1" class="ltx_p">Since the cache needs to store both the query for identification and the answer for direct response, we refer to the total query size as query size for simplicity.</p>
</div>
</div>
<div id="S3.SS1.p2" class="ltx_para ltx_noindent">
<p id="S3.SS1.p2.1" class="ltx_p">The cache stores both the query and its result content, and outputs the result of a matching query directly with zero cost. We use <math id="S3.SS1.p2.m1" class="ltx_Math" alttext="r(q)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(q)</annotation></semantics></math> to denote the result content return by LLM correspond to query <math id="S3.SS1.p2.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>. We maintain a cache <math id="S3.SS1.p2.m3" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> for the LLM system, storing a small subset of queries with their corresponding results, i.e. we store a question-answer pair <math id="S3.SS1.p2.m4" class="ltx_Math" alttext="(q,r(q))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(q,r(q))</annotation></semantics></math> in cache, and the size of <math id="S3.SS1.p2.m5" class="ltx_Math" alttext="(q,r(q))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(q,r(q))</annotation></semantics></math> is <math id="S3.SS1.p2.m6" class="ltx_Math" alttext="S(q)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S(q)</annotation></semantics></math>. We use <math id="S3.SS1.p2.m7" class="ltx_Math" alttext="q\in\mathcal{M}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow><annotation encoding="application/x-tex">q\in\mathcal{M}</annotation></semantics></math> to denote <math id="S3.SS1.p2.m8" class="ltx_Math" alttext="(q,r(q))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(q,r(q))</annotation></semantics></math> has been stored in cache. The size of cache has a maximum size <math id="S3.SS1.p2.m9" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, the total size of the stored queries must satisfy <math id="S3.SS1.p2.m10" class="ltx_Math" alttext="\sum_{q\in\mathcal{M}}S(q)\leq M" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></msub><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">\sum_{q\in\mathcal{M}}S(q)\leq M</annotation></semantics></math>. Let <math id="S3.SS1.p2.m11" class="ltx_Math" alttext="\mathfrak{J}" display="inline" intent=":literal"><semantics><mi>𝔍</mi><annotation encoding="application/x-tex">\mathfrak{J}</annotation></semantics></math> be the set of all possible sets that satisfy the size constraint</p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_Math" alttext="\textstyle\mathfrak{J}=\left\{\mathcal{M}|\sum\nolimits_{q\in\mathcal{M}}S(q)\leq M\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mi>𝔍</mi><mo>=</mo><mrow><mo>{</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo lspace="0em" rspace="0em">|</mo><mrow><mrow><mstyle displaystyle="false"><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></msub></mstyle><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mi>M</mi></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle\mathfrak{J}=\left\{\mathcal{M}|\sum\nolimits_{q\in\mathcal{M}}S(q)\leq M\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p2.2" class="ltx_p">To reduce overhead, we should place queries with high expected costs and high sampling frequencies into the cache. Following <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>, we can define the expected cost of a given cache <math id="S3.SS1.p2.m12" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> is</p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_math_unparsed" alttext="\textstyle cost(\mathcal{M})=\sum\nolimits_{q\in\mathcal{Q}}C^{*}(q)P(q)\mathbb{I}\{q\notin\mathcal{M}\}," display="block" intent=":literal"><semantics><mrow><mi>c</mi><mi>o</mi><mi>s</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mstyle displaystyle="false"><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow></msub></mstyle><msup><mi>C</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mi>P</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><mi>q</mi><mo>∉</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="false">}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\textstyle cost(\mathcal{M})=\sum\nolimits_{q\in\mathcal{Q}}C^{*}(q)P(q)\mathbb{I}\{q\notin\mathcal{M}\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS1.p2.3" class="ltx_p">where <math id="S3.SS1.p2.m13" class="ltx_Math" alttext="\mathbb{I}" display="inline" intent=":literal"><semantics><mi>𝕀</mi><annotation encoding="application/x-tex">\mathbb{I}</annotation></semantics></math> is the indicator function. Note that <math id="S3.SS1.p2.m14" class="ltx_math_unparsed" alttext="\mathbb{I}\{q\notin\mathcal{M}\}+\mathbb{I}\{q\in\mathcal{M}\}=1" display="inline" intent=":literal"><semantics><mrow><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><mi>q</mi><mo>∉</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="false">}</mo></mrow><mo>+</mo><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="false">}</mo></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbb{I}\{q\notin\mathcal{M}\}+\mathbb{I}\{q\in\mathcal{M}\}=1</annotation></semantics></math>. From another perspective, the cost we saved by cache hitting can be regarded as additional reward we have obtained. Then optimal cache can be define as</p>
<table id="S3.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S3.E1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S3.E1.m1" class="ltx_Math" alttext="\displaystyle\textstyle\mathcal{M}^{*}=argmax_{\mathcal{M}\in\mathfrak{J}}\sum_{q\in\mathcal{M}}C^{*}(q)P(q)." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup><mo>=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mi>𝔍</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></msub><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\textstyle\mathcal{M}^{*}=argmax_{\mathcal{M}\in\mathfrak{J}}\sum_{q\in\mathcal{M}}C^{*}(q)P(q).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(1)</span></td></tr></tbody>
</table>
<p id="S3.SS1.p2.4" class="ltx_p">Previous works such as <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> assume homogeneous query sizes, where <math id="S3.SS1.p2.m15" class="ltx_Math" alttext="S(q)=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">S(q)=1</annotation></semantics></math> for all queries, reducing the problem to a top-<math id="S3.SS1.p2.m16" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> selection problem. In contrast, we consider a heterogeneous setting, where queries have variable sizes <math id="S3.SS1.p2.m17" class="ltx_Math" alttext="S(q)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S(q)</annotation></semantics></math>, extending previous work.</p>
</div>
<div id="S3.SS1.p3" class="ltx_para ltx_noindent">
<p id="S3.SS1.p3.1" class="ltx_p"><span id="S3.SS1.p3.1.1" class="ltx_text ltx_font_typewriter ltx_font_bold">Oracle<span id="S3.SS1.p3.1.1.1" class="ltx_text ltx_font_serif">.</span></span> From the formula of optimal cache, we can model the optimal problem as a 0-1 knapsack problem where <math id="S3.SS1.p3.m1" class="ltx_Math" alttext="C^{*}(q)P(q)" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C^{*}(q)P(q)</annotation></semantics></math> represents the value of <math id="S3.SS1.p3.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> and <math id="S3.SS1.p3.m3" class="ltx_Math" alttext="S(q)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S(q)</annotation></semantics></math> is its volume. The cache is treated as a knapsack with capacity of <math id="S3.SS1.p3.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>, and the optimal cache is the optimal solution of a knapsack problem. Inspired by the CMAB model <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>, we assume that the agent has access to an offline <span id="S3.SS1.p3.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> to guide cache selection decisions. <span id="S3.SS1.p3.1.3" class="ltx_text ltx_font_typewriter">Oracle</span> have an offline solver that can solve the combinatorial optimization problem. In the case described above, the solver employs an algorithm for solving the knapsack problem.</p>
</div>
<div id="S3.SS1.p4" class="ltx_para ltx_noindent">
<p id="S3.SS1.p4.1" class="ltx_p">In some cases, the solution provided by the solver may be approximate, leading to approximate <span id="S3.SS1.p4.1.1" class="ltx_text ltx_font_typewriter">Oracle</span>. When <span id="S3.SS1.p4.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> is approximate, we reformulate the problem that <span id="S3.SS1.p4.1.3" class="ltx_text ltx_font_typewriter">Oracle</span> need to solve as a minimum knapsack problem (MKP), with the solver then acting as the algorithm for solving the MKP.
Details of this approach is in
Section <a href="#S5" title="5 VSOCB with Approximate Oracle ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>.</p>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Online Learning</h3>

<div id="S3.SS2.p1" class="ltx_para ltx_noindent">
<p id="S3.SS2.p1.1" class="ltx_p"><span id="S3.SS2.p1.1.1" class="ltx_text ltx_font_bold">Online cache bandit.</span> The agent’s objective is to choose the optimal cache without knowing the expected true cost and sample distribution. We consider a total number of <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="T\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">T\in\mathbb{N}_{+}</annotation></semantics></math> learning rounds. In round <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, agent receives a query <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="q_{t}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>t</mi></msub><annotation encoding="application/x-tex">q_{t}</annotation></semantics></math> which is sampled from <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> with probability <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="P(q)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(q)</annotation></semantics></math>. The agent has a <span id="S3.SS2.p1.1.2" class="ltx_text ltx_font_italic">current cache</span> <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="\mathcal{M}_{t}\in\mathfrak{J}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo>∈</mo><mi>𝔍</mi></mrow><annotation encoding="application/x-tex">\mathcal{M}_{t}\in\mathfrak{J}</annotation></semantics></math> in round <math id="S3.SS2.p1.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. <math id="S3.SS2.p1.m8" class="ltx_Math" alttext="\mathcal{M}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{t}</annotation></semantics></math> is selected based on the history feedback information from previous rounds. After <math id="S3.SS2.p1.m9" class="ltx_Math" alttext="q_{t}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>t</mi></msub><annotation encoding="application/x-tex">q_{t}</annotation></semantics></math> arrive, the agent will check the current cache <math id="S3.SS2.p1.m10" class="ltx_Math" alttext="\mathcal{M}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{t}</annotation></semantics></math>.
If <math id="S3.SS2.p1.m11" class="ltx_Math" alttext="q_{t}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>t</mi></msub><annotation encoding="application/x-tex">q_{t}</annotation></semantics></math> is found in the cache, i.e. <math id="S3.SS2.p1.m12" class="ltx_Math" alttext="q_{t}\in\mathcal{M}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>t</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">q_{t}\in\mathcal{M}_{t}</annotation></semantics></math>, we say that query <span id="S3.SS2.p1.1.3" class="ltx_text ltx_font_italic"> hits</span> the cache. In this case, the result of <math id="S3.SS2.p1.m13" class="ltx_Math" alttext="q_{t}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>t</mi></msub><annotation encoding="application/x-tex">q_{t}</annotation></semantics></math> is directly returned without further processing by the LLM. The cost of processing this query is <math id="S3.SS2.p1.m14" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> and will save a potential cost <math id="S3.SS2.p1.m15" class="ltx_Math" alttext="C(q_{t})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(q_{t})</annotation></semantics></math>, which is unobserved to the agent. Therefore, the feedback received during a cache hit would be: the arrival query <math id="S3.SS2.p1.m16" class="ltx_Math" alttext="q_{t}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>t</mi></msub><annotation encoding="application/x-tex">q_{t}</annotation></semantics></math> without cost.
If query <math id="S3.SS2.p1.m17" class="ltx_Math" alttext="q_{t}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>t</mi></msub><annotation encoding="application/x-tex">q_{t}</annotation></semantics></math> <span id="S3.SS2.p1.1.4" class="ltx_text ltx_font_italic">miss</span> the cache, i.e. <math id="S3.SS2.p1.m18" class="ltx_Math" alttext="q_{t}\notin\mathcal{M}_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>q</mi><mi>t</mi></msub><mo>∉</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">q_{t}\notin\mathcal{M}_{t}</annotation></semantics></math>, the system processes the query, incurring a cost <math id="S3.SS2.p1.m19" class="ltx_Math" alttext="C(q_{t})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(q_{t})</annotation></semantics></math>, returns the result, and delivers the feedback to the agent. Feedback received during a missing cache would be: the arrival query <math id="S3.SS2.p1.m20" class="ltx_Math" alttext="q_{t}" display="inline" intent=":literal"><semantics><msub><mi>q</mi><mi>t</mi></msub><annotation encoding="application/x-tex">q_{t}</annotation></semantics></math> with cost <math id="S3.SS2.p1.m21" class="ltx_Math" alttext="C(q_{t})" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C(q_{t})</annotation></semantics></math> and receiving the content of the result <math id="S3.SS2.p1.m22" class="ltx_Math" alttext="r(q_{t})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(q_{t})</annotation></semantics></math> from LLM and its size <math id="S3.SS2.p1.m23" class="ltx_Math" alttext="S(q_{t})" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S(q_{t})</annotation></semantics></math>.</p>
</div>
<div id="S3.SS2.p2" class="ltx_para ltx_noindent">
<p id="S3.SS2.p2.1" class="ltx_p">The agent can then choose to update the cache based on history feedback information or keep the current cache unchanged. In the same time, the algorithm will decide, based on historical information, whether to use <span id="S3.SS2.p2.1.1" class="ltx_text ltx_font_typewriter">Oracle</span>. If <span id="S3.SS2.p2.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> is called, the cache will be updated according to the output provided by <span id="S3.SS2.p2.1.3" class="ltx_text ltx_font_typewriter">Oracle</span>.</p>
</div>
<div id="S3.Thmtheorem2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem2.2" class="ltx_text ltx_font_italic">Remark 3.2</span></span><span id="S3.Thmtheorem2.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmtheorem2.p1" class="ltx_para">
<p id="S3.Thmtheorem2.p1.1" class="ltx_p">As noted in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>, our setting differs from traditional bandit problems because feedback may not be observed in every round. Specifically, when a query hits the cache, no cost feedback is received.</p>
</div>
</div>
<div id="S3.Thmtheorem3" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem3.2" class="ltx_text ltx_font_italic">Remark 3.3</span></span><span id="S3.Thmtheorem3.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S3.Thmtheorem3.p1" class="ltx_para">
<p id="S3.Thmtheorem3.p1.1" class="ltx_p">In the online mode, the agent’s updating of the cache in each round are constrained. At each time step, the cache can only be updated using the currently arriving query and the queries already stored in the cache, i.e. <math id="S3.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\mathcal{M}_{t+1}\subseteq\mathcal{M}_{t}\cup\{q_{t}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>⊆</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{t+1}\subseteq\mathcal{M}_{t}\cup\{q_{t}\}</annotation></semantics></math>. This is because that we discard the results <math id="S3.Thmtheorem3.p1.m2" class="ltx_Math" alttext="r(q)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(q)</annotation></semantics></math> of queries that are removed from the cache during updates (but we retain information such as the estimated sample probability, cost, and size of the query), only the query with <math id="S3.Thmtheorem3.p1.m3" class="ltx_Math" alttext="r(q)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(q)</annotation></semantics></math> can be putted in the cache. If a previously dropped query reappears, the <math id="S3.Thmtheorem3.p1.m4" class="ltx_Math" alttext="r(q)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(q)</annotation></semantics></math> need to be recomputed by LLM.</p>
</div>
</div>
<div id="S3.SS2.p3" class="ltx_para ltx_noindent">
<p id="S3.SS2.p3.1" class="ltx_p"><span id="S3.SS2.p3.1.1" class="ltx_text ltx_font_bold">Learning objective.</span>
Our goal is to minimize the total cost with time horizon <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>. By applying the indicator function to the regret in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> for an equivalent transformation, we define the regret as:</p>
<table id="S3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_math_unparsed" alttext="\textstyle Reg(T)=\mathbb{E}\left[\sum_{t=1}^{T}C(q_{t})\left(\mathbb{I}\{q_{t}\in\mathcal{M}^{*}\}-\mathbb{I}\{q_{t}\in\mathcal{M}_{t}\}\right)\right]," display="block" intent=":literal"><semantics><mrow><mi>R</mi><mi>e</mi><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo>[</mo><mstyle displaystyle="false"><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup></mstyle><mi>C</mi><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo>(</mo><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msub><mi>q</mi><mi>t</mi></msub><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup><mo stretchy="false">}</mo></mrow><mo>−</mo><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msub><mi>q</mi><mi>t</mi></msub><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\textstyle Reg(T)=\mathbb{E}\left[\sum_{t=1}^{T}C(q_{t})\left(\mathbb{I}\{q_{t}\in\mathcal{M}^{*}\}-\mathbb{I}\{q_{t}\in\mathcal{M}_{t}\}\right)\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p3.2" class="ltx_p">where <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="\mathcal{M}^{*}=argmax_{\mathcal{M}\in\mathfrak{J}}\sum_{q\in\mathcal{M}}C^{*}(q)P(q)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup><mo>=</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>x</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mi>𝔍</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></msub><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>P</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}^{*}=argmax_{\mathcal{M}\in\mathfrak{J}}\sum_{q\in\mathcal{M}}C^{*}(q)P(q)</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Variable Size Online Cache Bandit</h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Algorithm with Exact <span id="S4.SS1.2" class="ltx_text ltx_font_typewriter">Oracle</span></h3>

<div id="S4.SS1.p1" class="ltx_para ltx_noindent">
<p id="S4.SS1.p1.1" class="ltx_p">Our algorithm is presented in Alg.<a href="#alg1" title="Algorithm 1 ‣ 4.1 Algorithm with Exact Oracle ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>. When we have an exact solver, <math id="S4.SS1.p1.m1" class="ltx_Math" alttext="Oracle" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">Oracle</annotation></semantics></math> in line 25 refers to Alg.<a href="#alg2" title="Algorithm 2 ‣ 4.1 Algorithm with Exact Oracle ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para ltx_noindent">
<p id="S4.SS1.p2.1" class="ltx_p"><span id="S4.SS1.p2.1.1" class="ltx_text ltx_font_bold">Query record.</span> In the online setting, the agent does not know which queries exist at the beginning. Therefore, the agent needs to maintain a set to record the queries it has encountered. Only after the agent has seen a query will it have information about that query and estimate its cost and sampling probability. Subsequently, when invoking <span id="S4.SS1.p2.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> or updating the cache, the agent will take this query into account. We use a set <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\mathcal{Q}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{Q}_{t}</annotation></semantics></math> (line 2) in our algorithm to represent this record set, a query <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="q\in\mathcal{Q}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">q\in\mathcal{Q}_{t}</annotation></semantics></math> means that the estimation and information of this query (excluding <math id="S4.SS1.p2.m3" class="ltx_Math" alttext="r(q)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(q)</annotation></semantics></math>) have been recorded by algorithm. Clearly, when all the queries in <math id="S4.SS1.p2.m4" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> have arrived at least once, we have <math id="S4.SS1.p2.m5" class="ltx_Math" alttext="\mathcal{Q}_{t}=\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>t</mi></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">\mathcal{Q}_{t}=\mathcal{Q}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para ltx_noindent">
<p id="S4.SS1.p3.1" class="ltx_p"><span id="S4.SS1.p3.1.1" class="ltx_text ltx_font_typewriter ltx_font_bold">Oracle<span id="S4.SS1.p3.1.1.1" class="ltx_text ltx_font_serif"> guide:</span></span> For heterogeneous query sizes, the previously straightforward single-query replacement strategy is no longer applicable. This is because, with variable size query, we also need to consider whether the length of the query allows for a valid replacement during cache replacement. A query might not fit into the cache due to size constraints, causing the replacement to fail. In some cases, this could result in a scenario where no replacements occur, ultimately trapping the system. Inspired by the <span id="S4.SS1.p3.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> in the CMAB model <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>, we assume that the algorithm can use an <span id="S4.SS1.p3.1.3" class="ltx_text ltx_font_typewriter">Oracle</span> that accepts global query information and returns an optimal cache selection under the given constraints. As we mentioned above, solving for the optimal cache can be viewed as a knapsack problem. Specifically, <span id="S4.SS1.p3.1.4" class="ltx_text ltx_font_typewriter">Oracle</span> is denoted by</p>
<table id="S4.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex5.m1" class="ltx_Math" alttext="Oracle(\mathcal{Q}^{\prime},\{C^{*}(q)\}_{q\in\mathcal{Q}^{\prime}},\{P(q)\}_{q\in\mathcal{Q}^{\prime}},\{S(q)\}_{q\in\mathcal{Q}^{\prime}},M)." display="block" intent=":literal"><semantics><mrow><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">Oracle(\mathcal{Q}^{\prime},\{C^{*}(q)\}_{q\in\mathcal{Q}^{\prime}},\{P(q)\}_{q\in\mathcal{Q}^{\prime}},\{S(q)\}_{q\in\mathcal{Q}^{\prime}},M).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p3.2" class="ltx_p">It takes the cost, sample probability and query size of all queries in a given set <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="\mathcal{Q}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{Q}^{\prime}</annotation></semantics></math> as input and output a set <math id="S4.SS1.p3.m2" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> that yields the solution of knapsack problem with volume constraint of <math id="S4.SS1.p3.m3" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>.</p>
</div>
<div id="S4.SS1.p4" class="ltx_para ltx_noindent">
<p id="S4.SS1.p4.1" class="ltx_p">We assume that <span id="S4.SS1.p4.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> has a knapsack problem solver (e.g. dynamic programming) which can output the exact optimal knapsack solution. We denote this solver as <math id="S4.SS1.p4.m1" class="ltx_Math" alttext="Knap(\bm{w},\bm{v},m)" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒘</mi><mo>,</mo><mi>𝒗</mi><mo>,</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Knap(\bm{w},\bm{v},m)</annotation></semantics></math>. By inputting the item values <math id="S4.SS1.p4.m2" class="ltx_Math" alttext="\bm{w}" display="inline" intent=":literal"><semantics><mi>𝒘</mi><annotation encoding="application/x-tex">\bm{w}</annotation></semantics></math>, volumes <math id="S4.SS1.p4.m3" class="ltx_Math" alttext="\bm{v}" display="inline" intent=":literal"><semantics><mi>𝒗</mi><annotation encoding="application/x-tex">\bm{v}</annotation></semantics></math>, and the knapsack capacity <math id="S4.SS1.p4.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> into <math id="S4.SS1.p4.m5" class="ltx_Math" alttext="Knap" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">Knap</annotation></semantics></math>, it will return the optimal knapsack solution. We encapsulate this solver as our <span id="S4.SS1.p4.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> in Alg.<a href="#alg2" title="Algorithm 2 ‣ 4.1 Algorithm with Exact Oracle ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. <span id="S4.SS1.p4.1.3" class="ltx_text ltx_font_typewriter">Oracle</span> accepts the estimated values of query costs and sampling probabilities, multiplies them together to compute the value, and then inputs this value into <math id="S4.SS1.p4.m6" class="ltx_Math" alttext="Knap" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">Knap</annotation></semantics></math>. Compared to the typical single-query replacement, <span id="S4.SS1.p4.1.4" class="ltx_text ltx_font_typewriter">Oracle</span> can see global information, allowing it to provide global guidance on cache replacement.</p>
</div>
<div id="S4.SS1.p5" class="ltx_para ltx_noindent">
<p id="S4.SS1.p5.1" class="ltx_p"><span id="S4.SS1.p5.1.1" class="ltx_text ltx_font_bold">Lower confidence bound:</span> Similar to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>, we use a lower-confidence-bound (LCB) for estimating the cost of each query. This LCB approach is akin to adding a penalty to the estimation of queries that remain in the cache for a long time, making them more likely to be replaced, similar to an enforcement of exploration. We use <math id="S4.SS1.p5.m1" class="ltx_Math" alttext="C_{t}(q)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">C_{t}(q)</annotation></semantics></math> to denote the cost of query <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> that the agent receives in round <math id="S4.SS1.p5.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. In algorithm, we use <math id="S4.SS1.p5.m4" class="ltx_Math" alttext="T^{(c)}_{t}(q)=\sum_{s=1}^{t}\mathbb{I}\{q_{s}\notin\mathcal{M}_{s},q_{s}=q\}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><mi>𝕀</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>q</mi><mi>s</mi></msub><mo>∉</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>s</mi></msub></mrow><mo>,</mo><mrow><msub><mi>q</mi><mi>s</mi></msub><mo>=</mo><mi>q</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">T^{(c)}_{t}(q)=\sum_{s=1}^{t}\mathbb{I}\{q_{s}\notin\mathcal{M}_{s},q_{s}=q\}</annotation></semantics></math> to represent the number of cache misses for query <math id="S4.SS1.p5.m5" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> up to the <math id="S4.SS1.p5.m6" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>-th round, where <math id="S4.SS1.p5.m7" class="ltx_Math" alttext="\mathbb{I}\{q_{s}\notin\mathcal{M}_{s},q_{s}=q\}" display="inline" intent=":literal"><semantics><mrow><mi>𝕀</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>q</mi><mi>s</mi></msub><mo>∉</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>s</mi></msub></mrow><mo>,</mo><mrow><msub><mi>q</mi><mi>s</mi></msub><mo>=</mo><mi>q</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{I}\{q_{s}\notin\mathcal{M}_{s},q_{s}=q\}</annotation></semantics></math> denote query
<math id="S4.SS1.p5.m8" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> arrive in round <math id="S4.SS1.p5.m9" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and misses cache. Let <math id="S4.SS1.p5.m10" class="ltx_Math" alttext="\widetilde{C}_{t}(q)=\sum_{s=1}^{t}\mathbb{I}\{q_{s}\notin\mathcal{M}_{s},q_{s}=q\}C_{t}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mrow><mrow><mi>𝕀</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>q</mi><mi>s</mi></msub><mo>∉</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>s</mi></msub></mrow><mo>,</mo><mrow><msub><mi>q</mi><mi>s</mi></msub><mo>=</mo><mi>q</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{C}_{t}(q)=\sum_{s=1}^{t}\mathbb{I}\{q_{s}\notin\mathcal{M}_{s},q_{s}=q\}C_{t}(q)</annotation></semantics></math> to represent the accumulated cost information of query <math id="S4.SS1.p5.m11" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> up to the <math id="S4.SS1.p5.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>-th round. The lower-confidence-bound based estimator for cost is:</p>
<table id="S4.E2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E2.m1" class="ltx_Math" alttext="\textstyle\widehat{C}_{t}(q){=}\max\left\{0,\frac{\widetilde{C}_{t}(q)}{T^{(c)}_{t}(q)}-(c_{2}-c_{1})\sqrt{\frac{\ln{(8TN/\delta)}}{2T^{(c)}_{t}(q)}}\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mn>0</mn><mo>,</mo><mrow><mstyle displaystyle="false"><mfrac><mrow><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>2</mn></msub><mo>−</mo><msub><mi>c</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="false"><mfrac><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></msqrt></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\textstyle\widehat{C}_{t}(q){=}\max\left\{0,\frac{\widetilde{C}_{t}(q)}{T^{(c)}_{t}(q)}-(c_{2}-c_{1})\sqrt{\frac{\ln{(8TN/\delta)}}{2T^{(c)}_{t}(q)}}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(2)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p5.2" class="ltx_p"><span id="S4.SS1.p5.2.1" class="ltx_text ltx_font_bold">Variance confidence bound:</span> Different from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>, for the estimation of the sampling probability <math id="S4.SS1.p5.m13" class="ltx_Math" alttext="P(q)" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P(q)</annotation></semantics></math>, we also used an LCB-type estimate rather than a empirical estimate. Additionally, the confidence bound for <math id="S4.SS1.p5.m14" class="ltx_Math" alttext="\widehat{P}_{t}(q)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{P}_{t}(q)</annotation></semantics></math> is derived from the variance bound in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite>. According to the work in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib17" title="" class="ltx_ref">17</a>]</cite>, the variance estimate <math id="S4.SS1.p5.m15" class="ltx_Math" alttext="V_{t}(q)" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">V_{t}(q)</annotation></semantics></math> of the sampling probability of a query can be obtained in the following form:</p>
<table id="S4.EGx2" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.Ex6.m1" class="ltx_Math" alttext="\displaystyle V_{t}(q)=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle V_{t}(q)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex6.m2" class="ltx_math_unparsed" alttext="\displaystyle\textstyle\frac{1}{t}\sum^{t}_{s=1}\left(\mathbb{I}\{q_{s}=q\}-\frac{\sum_{i=1}^{t}\mathbb{I}\{q_{i}=q\}}{t}\right)^{2}." display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>t</mi></mfrac><msubsup><mo rspace="0em">∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><msup><mrow><mo>(</mo><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msub><mi>q</mi><mi>s</mi></msub><mo>=</mo><mi>q</mi><mo stretchy="false">}</mo></mrow><mo>−</mo><mfrac><mrow><mstyle scriptlevel="-1"><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>t</mi></msup><mi>𝕀</mi><mo stretchy="false">{</mo><mi>q</mi><msub><mrow></mrow><mi>i</mi></msub><mo>=</mo><mi>q</mi><mo stretchy="false">}</mo></mrow><mi>t</mi></mfrac><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\textstyle\frac{1}{t}\sum^{t}_{s=1}\left(\mathbb{I}\{q_{s}=q\}-\frac{\sum_{i=1}^{t}\mathbb{I}\{q_{i}=q\}}{t}\right)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p5.3" class="ltx_p">Let <math id="S4.SS1.p5.m16" class="ltx_math_unparsed" alttext="T^{(q)}_{t}(q)=\sum_{s=1}^{t}\mathbb{I}\{q_{s}=q\}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><msubsup><mo>∑</mo><mrow><mi>s</mi><mo>=</mo><mn>1</mn></mrow><mi>t</mi></msubsup><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msub><mi>q</mi><mi>s</mi></msub><mo>=</mo><mi>q</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">T^{(q)}_{t}(q)=\sum_{s=1}^{t}\mathbb{I}\{q_{s}=q\}</annotation></semantics></math>, the estimator for sample probability in round <math id="S4.SS1.p5.m17" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> is:</p>
<table id="S4.EGx3" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E3.m2" class="ltx_Math" alttext="\displaystyle\textstyle\widehat{P}_{t}(q)=\max\left\{0,\frac{T^{(q)}_{t}(q)}{t}-LVCB_{t}(q,\delta)\right\}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mn>0</mn><mo>,</mo><mrow><mfrac><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mi>t</mi></mfrac><mo>−</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\textstyle\widehat{P}_{t}(q)=\max\left\{0,\frac{T^{(q)}_{t}(q)}{t}-LVCB_{t}(q,\delta)\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3)</span></td></tr></tbody>
<tbody id="S4.E4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E4.m2" class="ltx_Math" alttext="\displaystyle\textstyle LVCB_{t}(q,\delta){=}\sqrt{\frac{3V_{t}(q)\ln{(16TN/\delta)}}{t}}{+}\frac{5\ln{(16TN/\delta)}}{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msqrt><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>t</mi></mfrac></msqrt><mo>+</mo><mfrac><mrow><mn>5</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mi>t</mi></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\textstyle LVCB_{t}(q,\delta){=}\sqrt{\frac{3V_{t}(q)\ln{(16TN/\delta)}}{t}}{+}\frac{5\ln{(16TN/\delta)}}{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4)</span></td></tr></tbody>
</table>
<p id="S4.SS1.p5.4" class="ltx_p"><span id="S4.SS1.p5.4.1" class="ltx_text ltx_font_bold">Recommend and wait strategy:</span> In online model, the algorithm does not store the result content corresponding to all queries. When the cache is updated, the results content <math id="S4.SS1.p5.m18" class="ltx_Math" alttext="r(q)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(q)</annotation></semantics></math> of the queries that are removed from the cache will be cleared. Because cache need to store <math id="S4.SS1.p5.m19" class="ltx_Math" alttext="(q,r(q))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>q</mi><mo>,</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(q,r(q))</annotation></semantics></math>, cache selection can only access the queries currently in the cache and any newly arriving queries. As mentioned in Remark<a href="#S3.Thmtheorem3" title="Remark 3.3. ‣ 3.2 Online Learning ‣ 3 Problem Setting ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, the queries chosen for cache updates are not arbitrary. Although <span id="S4.SS1.p5.4.2" class="ltx_text ltx_font_typewriter">Oracle</span> can output an optimal solution for the global set of queries, unlike the setting in CMAB <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>, our cache cannot be directly updated to the selection recommended by <span id="S4.SS1.p5.4.3" class="ltx_text ltx_font_typewriter">Oracle</span> due to the online constraint. For example, a query in <span id="S4.SS1.p5.4.4" class="ltx_text ltx_font_typewriter">Oracle</span>’s output indicates that the agent should add this query to the cache, but if this query was replaced from the cache during a previous update, the agent will not have <math id="S4.SS1.p5.m20" class="ltx_Math" alttext="r(q)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(q)</annotation></semantics></math> for this query in the current round. In this case, the cache must wait until the query arrives again and the <math id="S4.SS1.p5.m21" class="ltx_Math" alttext="r(q)" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">r(q)</annotation></semantics></math> is re-obtained before it can be added to the cache. Under this setting, we involve a <span id="S4.SS1.p5.4.5" class="ltx_text ltx_font_italic">Recommended cache</span> denoted by <math id="S4.SS1.p5.m22" class="ltx_Math" alttext="\widehat{\mathcal{M}}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\widehat{\mathcal{M}}_{t}</annotation></semantics></math> to temporarily store the results output by our <span id="S4.SS1.p5.4.6" class="ltx_text ltx_font_typewriter">Oracle</span> at the current time. When <span id="S4.SS1.p5.4.7" class="ltx_text ltx_font_typewriter">Oracle</span> is invoked, the policy does not update the cache immediately. Instead, it first receives a recommended cache <math id="S4.SS1.p5.m23" class="ltx_Math" alttext="\widehat{\mathcal{M}}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\widehat{\mathcal{M}}_{t}</annotation></semantics></math>, and the cache will retain only the portion that matches the recommended cache, and the differing parts will be removed to free up space for subsequent updates (line 25-26). In subsequent rounds, the algorithm updates the current cache based on recommended cache. In the following rounds, if a query that belongs to the recommended cache but is not currently in the cache arrives, it will miss the current cache and be processed by the LLM to obtain its response. The query will then be added to the current cache. Otherwise, the cache will not be updated unless there is still available space in the recommended cache. This process continues until the next recommended cache update occurs (line 18-22).</p>
</div>
<div id="S4.SS1.p6" class="ltx_para ltx_noindent">
<p id="S4.SS1.p6.1" class="ltx_p"><span id="S4.SS1.p6.1.1" class="ltx_text ltx_font_bold">Full cache:</span> The recommended cache may not be full until all queries have been seen at least once (i.e. <math id="S4.SS1.p6.m1" class="ltx_Math" alttext="\mathcal{Q}_{t}=\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>t</mi></msub><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">\mathcal{Q}_{t}=\mathcal{Q}</annotation></semantics></math>). This means that there may still be unused space in recommended cache. To avoid wasting space, we check whether there is still available space in the recommended cache (line 20). If so, we place additional queries into the cache, regardless of whether they belong to the recommended cache (line 18).</p>
</div>
<div id="S4.SS1.p7" class="ltx_para ltx_noindent">
<p id="S4.SS1.p7.1" class="ltx_p"><span id="S4.SS1.p7.1.1" class="ltx_text ltx_font_bold">Accumulation-based <span id="S4.SS1.p7.1.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> invoking policy:</span> The calling of <span id="S4.SS1.p7.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> can gradually update the current cache to the optimal solution, but it also introduces additional computational overhead for the entire system. Especially when solving such knapsack problems, the cost of calling <span id="S4.SS1.p7.1.3" class="ltx_text ltx_font_typewriter">Oracle</span> is substantial. Therefore, we need to minimize the number of <span id="S4.SS1.p7.1.4" class="ltx_text ltx_font_typewriter">Oracle</span> calls as much as possible, while still minimizing the impact on the cache updates. In our algorithm, we use an accumulation-based strategy (line 23) to balance this trade-off. <math id="S4.SS1.p7.m1" class="ltx_Math" alttext="T^{(r)}_{t}(q)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T^{(r)}_{t}(q)</annotation></semantics></math> represents the number of cache misses for query <math id="S4.SS1.p7.m2" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math> at the time of the most recent <span id="S4.SS1.p7.1.5" class="ltx_text ltx_font_typewriter">Oracle</span> call before time <math id="S4.SS1.p7.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Accumulation means that an <span id="S4.SS1.p7.1.6" class="ltx_text ltx_font_typewriter">Oracle</span> call occurs when the number of cache misses <math id="S4.SS1.p7.m4" class="ltx_Math" alttext="T^{(c)}_{t}(q)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T^{(c)}_{t}(q)</annotation></semantics></math> in current for a query exceeds <math id="S4.SS1.p7.m5" class="ltx_Math" alttext="1+\alpha" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><annotation encoding="application/x-tex">1+\alpha</annotation></semantics></math> times <math id="S4.SS1.p7.m6" class="ltx_Math" alttext="T^{(r)}_{t}(q)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T^{(r)}_{t}(q)</annotation></semantics></math>, where <math id="S4.SS1.p7.m7" class="ltx_Math" alttext="\alpha&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0</annotation></semantics></math> is a predetermined constant. This is equivalent to calling <span id="S4.SS1.p7.1.7" class="ltx_text ltx_font_typewriter">Oracle</span> only when the query has accumulated enough information about its cost, making the estimation of its cost more accurate. This approach is inspired by the asynchronous update strategy in federated bandit methods <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib18" title="" class="ltx_ref">18</a>]</cite>. Since our algorithm needs to estimate both the cost and the sampling probability of queries, our update strategy also maintains a timer <math id="S4.SS1.p7.m8" class="ltx_Math" alttext="T_{t}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>t</mi></msub><annotation encoding="application/x-tex">T_{t}</annotation></semantics></math> to represent the time of the most recent <span id="S4.SS1.p7.1.8" class="ltx_text ltx_font_typewriter">Oracle</span> call before <math id="S4.SS1.p7.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. When the number of rounds <math id="S4.SS1.p7.m10" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> reaches <math id="S4.SS1.p7.m11" class="ltx_Math" alttext="(1+\alpha)T_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">(1+\alpha)T_{t}</annotation></semantics></math>, we also perform an <span id="S4.SS1.p7.1.9" class="ltx_text ltx_font_typewriter">Oracle</span> call. The role of the timer <math id="S4.SS1.p7.m12" class="ltx_Math" alttext="T_{t}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>t</mi></msub><annotation encoding="application/x-tex">T_{t}</annotation></semantics></math> is to accumulate information about the query’s sampling probability, so that when the estimate of the sampling probability becomes more accurate, <span id="S4.SS1.p7.1.10" class="ltx_text ltx_font_typewriter">Oracle</span> can be called in a timely manner. This accumulation-based <span id="S4.SS1.p7.1.11" class="ltx_text ltx_font_typewriter">Oracle</span> invoking policy ensures that <span id="S4.SS1.p7.1.12" class="ltx_text ltx_font_typewriter">Oracle</span> is called in a timely manner, once the estimates become relatively accurate, while also keeping the number of <span id="S4.SS1.p7.1.13" class="ltx_text ltx_font_typewriter">Oracle</span> calls logarithmic in scale.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Variable Size Online Cache Bandits (VSOCB)</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l0" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">0:</span>
              
              
             <math id="alg1.l0.m1" class="ltx_Math" alttext="\mathcal{Q}_{0}=\phi" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mn>0</mn></msub><mo>=</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">\mathcal{Q}_{0}=\phi</annotation></semantics></math>. <math id="alg1.l0.m2" class="ltx_Math" alttext="T_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">T_{0}=0</annotation></semantics></math>. For all <math id="alg1.l0.m3" class="ltx_Math" alttext="q\in\mathcal{Q}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow><annotation encoding="application/x-tex">q\in\mathcal{Q}</annotation></semantics></math>: <math id="alg1.l0.m4" class="ltx_Math" alttext="T_{0}^{(r)}(q)=T^{(q)}_{0}(q)=T^{(c)}_{0}(q)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>T</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>T</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>T</mi><mn>0</mn><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">T_{0}^{(r)}(q)=T^{(q)}_{0}(q)=T^{(c)}_{0}(q)=0</annotation></semantics></math>, <math id="alg1.l0.m5" class="ltx_Math" alttext="\widehat{P}_{0}(q)=V_{0}(q)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>V</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{P}_{0}(q)=V_{0}(q)=0</annotation></semantics></math>, <math id="alg1.l0.m6" class="ltx_Math" alttext="\widetilde{C}_{0}(q)=\widehat{C}_{0}(q)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>C</mi><mo>~</mo></mover><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{C}_{0}(q)=\widehat{C}_{0}(q)=0</annotation></semantics></math>, <math id="alg1.l0.m7" class="ltx_Math" alttext="S(q)=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">S(q)=0</annotation></semantics></math>. <math id="alg1.l0.m8" class="ltx_Math" alttext="\mathcal{M}_{0}=\widehat{\mathcal{M}}_{0}=\phi" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mn>0</mn></msub><mo>=</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><mi>ϕ</mi></mrow><annotation encoding="application/x-tex">\mathcal{M}_{0}=\widehat{\mathcal{M}}_{0}=\phi</annotation></semantics></math>, <math id="alg1.l0.m9" class="ltx_Math" alttext="\alpha&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha&gt;0</annotation></semantics></math>.

</div>
<div id="alg1.l0a" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">0:</span>
              
              
               
</div>
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
             <span id="alg1.l1.2" class="ltx_text ltx_font_bold">for</span> round <math id="alg1.l1.m1" class="ltx_Math" alttext="t=1,...,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,...,T</annotation></semantics></math> <span id="alg1.l1.3" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l2" class="ltx_listingline">
