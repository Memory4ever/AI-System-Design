<td id="S1.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S1.T1.m3" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S1.T1.2.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S1.T1.m4" class="ltx_Math" alttext="\widetilde{O}\left(MN\sqrt{T}\right)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{O}\left(MN\sqrt{T}\right)</annotation></semantics></math></td></tr>
