              <span class="ltx_tag ltx_tag_listingline">22:</span>
              
              
              <span id="alg1.l22.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l22.3" class="ltx_text ltx_font_bold">if</span>

</div>
<div id="alg1.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">23:</span>
              
              
              <span id="alg1.l23.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l23.m1" class="ltx_Math" alttext="T^{(c)}_{t}(q_{t})\geq(1+\alpha)T^{(r)}_{t-1}(q_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>T</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T^{(c)}_{t}(q_{t})\geq(1+\alpha)T^{(r)}_{t-1}(q_{t})</annotation></semantics></math> or <math id="alg1.l23.m2" class="ltx_Math" alttext="t\geq(1+\alpha)T_{t-1}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">t\geq(1+\alpha)T_{t-1}</annotation></semantics></math> <span id="alg1.l23.3" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">24:</span>
              
              
               <math id="alg1.l24.m1" class="ltx_Math" alttext="T^{(r)}_{t}(q_{t})=T^{(c)}_{t}(q_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T^{(r)}_{t}(q_{t})=T^{(c)}_{t}(q_{t})</annotation></semantics></math>, <math id="alg1.l24.m2" class="ltx_Math" alttext="T_{t}=t" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>t</mi></msub><mo>=</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">T_{t}=t</annotation></semantics></math>


</div>
<div id="alg1.l25" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">25:</span>
              
              
               <math id="alg1.l25.m1" class="ltx_Math" alttext="\widehat{\mathcal{M}}_{t}=Oracle(\mathcal{Q}_{t},\widehat{C}_{t},\widehat{P}_{t},S,M)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>=</mo><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>t</mi></msub><mo>,</mo><msub><mover accent="true"><mi>C</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><mi>S</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathcal{M}}_{t}=Oracle(\mathcal{Q}_{t},\widehat{C}_{t},\widehat{P}_{t},S,M)</annotation></semantics></math>

</div>
<div id="alg1.l26" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">26:</span>
              
              
               <math id="alg1.l26.m1" class="ltx_Math" alttext="\mathcal{M}_{t}=\widehat{\mathcal{M}}_{t}\cap\mathcal{M}_{t-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo>=</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>∩</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}_{t}=\widehat{\mathcal{M}}_{t}\cap\mathcal{M}_{t-1}</annotation></semantics></math>

</div>
<div id="alg1.l27" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">27:</span>
              
              
              <span id="alg1.l27.2" class="ltx_text ltx_font_bold">else</span>


</div>
<div id="alg1.l28" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">28:</span>
              
              
               <math id="alg1.l28.m1" class="ltx_Math" alttext="T^{(r)}_{t}(q_{t})=T^{(r)}_{t-1}(q_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>T</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msubsup><mi>T</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>q</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T^{(r)}_{t}(q_{t})=T^{(r)}_{t-1}(q_{t})</annotation></semantics></math>, <math id="alg1.l28.m2" class="ltx_Math" alttext="T_{t}=T_{t-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>t</mi></msub><mo>=</mo><msub><mi>T</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">T_{t}=T_{t-1}</annotation></semantics></math>, <math id="alg1.l28.m3" class="ltx_Math" alttext="\widehat{\mathcal{M}}_{t}=\widehat{\mathcal{M}}_{t-1}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>=</mo><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\widehat{\mathcal{M}}_{t}=\widehat{\mathcal{M}}_{t-1}</annotation></semantics></math>

</div>
<div id="alg1.l29" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">29:</span>
              
              
              <span id="alg1.l29.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l29.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l30" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">30:</span>
              
              
             <span id="alg1.l30.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l30.3" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Exact <span id="alg2.5" class="ltx_text ltx_font_typewriter">Oracle</span></figcaption>
<div id="alg2.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
             Input <math id="alg2.l1.m1" class="ltx_Math" alttext="\mathcal{Q}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{Q}^{\prime}</annotation></semantics></math>, <math id="alg2.l1.m2" class="ltx_Math" alttext="\{C^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>C</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\{C^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}</annotation></semantics></math>, <math id="alg2.l1.m3" class="ltx_Math" alttext="\{P^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\{P^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}</annotation></semantics></math>, <math id="alg2.l1.m4" class="ltx_Math" alttext="\{S^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>S</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\{S^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}</annotation></semantics></math>, <math id="alg2.l1.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
             <math id="alg2.l2.m1" class="ltx_Math" alttext="w(q)=P^{\prime}(q)C^{\prime}(q),\forall q\in\mathcal{Q}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>q</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">w(q)=P^{\prime}(q)C^{\prime}(q),\forall q\in\mathcal{Q}^{\prime}</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
             <math id="alg2.l3.m1" class="ltx_Math" alttext="\mathcal{M}\leftarrow Knap(\{w(q)\}_{q\in\mathcal{Q}^{\prime}},\{S^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}},M)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="false">←</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">{</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>S</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}\leftarrow Knap(\{w(q)\}_{q\in\mathcal{Q}^{\prime}},\{S^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}},M)</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
             Output <math id="alg2.l4.m1" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math>

</div>
</div>
</figure>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Exact Solution Bound</h3>

<div id="S4.SS2.p1" class="ltx_para ltx_noindent">
<p id="S4.SS2.p1.1" class="ltx_p">As mentioned in the algorithm above regarding the full cache, we always aim to fill the cache as much as possible, meaning that no additional query can be added to the cache. Under this requirement, similar to CUCB <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>, we define the valid set of cache.</p>
</div>
<div id="S4.Thmtheorem1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem1.2" class="ltx_text ltx_font_bold">Definition 4.1</span></span><span id="S4.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem1.p1" class="ltx_para ltx_noindent">
<p id="S4.Thmtheorem1.p1.1" class="ltx_p">(Valid set): We define the valid set as</p>
<table id="S4.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex7.m1" class="ltx_math_unparsed" alttext="\textstyle\mathfrak{V}{=}\!\left\{\!\mathcal{M}|\mathcal{M}{\subseteq}\mathcal{Q},M{-}\min_{q^{\prime}\notin\mathcal{M}}\!S(q^{\prime}){&lt;}\sum_{q\in\mathcal{M}}\!S(q){\leq}M\!\right\}\!." display="block" intent=":literal"><semantics><mrow><mi>𝔙</mi><mo rspace="0.108em">=</mo><mrow><mo>{</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>⊆</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>,</mo><mi>M</mi><mo>−</mo><msub><mi>min</mi><mrow><msup><mi>q</mi><mo>′</mo></msup><mo>∉</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></msub><mi>S</mi><mrow><mo stretchy="false">(</mo><msup><mi>q</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mstyle displaystyle="false"><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></msub></mstyle><mi>S</mi><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo>≤</mo><mpadded style="width:0.909em;" width="0.909em"><mi>M</mi></mpadded><mpadded style="width:0.330em;" width="0.330em"><mo>}</mo></mpadded></mrow><mo>.</mo></mrow><annotation encoding="application/x-tex">\textstyle\mathfrak{V}{=}\!\left\{\!\mathcal{M}|\mathcal{M}{\subseteq}\mathcal{Q},M{-}\min_{q^{\prime}\notin\mathcal{M}}\!S(q^{\prime}){&lt;}\sum_{q\in\mathcal{M}}\!S(q){\leq}M\!\right\}\!.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem1.p1.2" class="ltx_p">We define <math id="S4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="l_{max}=\max_{\mathcal{M}\in\mathfrak{V}}|\mathcal{M}|" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>=</mo><mrow><msub><mi>max</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mi>𝔙</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l_{max}=\max_{\mathcal{M}\in\mathfrak{V}}|\mathcal{M}|</annotation></semantics></math>, <math id="S4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="l_{min}=\min_{\mathcal{M}\in\mathfrak{V}}|\mathcal{M}|" display="inline" intent=":literal"><semantics><mrow><msub><mi>l</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>=</mo><mrow><msub><mi>min</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mi>𝔙</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l_{min}=\min_{\mathcal{M}\in\mathfrak{V}}|\mathcal{M}|</annotation></semantics></math> to represent the maximum and minimum number of queries that can be included in the valid set, respectively.</p>
</div>
</div>
<div id="S4.Thmtheorem2" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Definition 4.2</span></span><span id="S4.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem2.p1" class="ltx_para">
<p id="S4.Thmtheorem2.p1.1" class="ltx_p">(Complementary Gap): For each <math id="S4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\mathcal{M}\in\mathfrak{V}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mi>𝔙</mi></mrow><annotation encoding="application/x-tex">\mathcal{M}\in\mathfrak{V}</annotation></semantics></math>, we define the gap <math id="S4.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\Delta_{\mathcal{M}}=\sum_{q\in\mathcal{M}^{*}}P(q)C^{*}(q)-\sum_{q\in\mathcal{M}}P(q)C^{*}(q)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup></mrow></msub><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">−</mo><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></msub><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{\mathcal{M}}=\sum_{q\in\mathcal{M}^{*}}P(q)C^{*}(q)-\sum_{q\in\mathcal{M}}P(q)C^{*}(q)</annotation></semantics></math>. For each query <math id="S4.Thmtheorem2.p1.m3" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, we define <math id="S4.Thmtheorem2.p1.m4" class="ltx_math_unparsed" alttext="\Delta_{q}=\min_{\mathcal{M}\in\mathfrak{V}:\mathcal{M}\neq\mathcal{M}^{*},q\notin\mathcal{M}}\Delta_{\mathcal{M}}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><msub><mrow></mrow><mi>q</mi></msub><mo>=</mo><mi>min</mi><msub><mrow></mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mi>𝔙</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>≠</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup></mrow></mrow><mo>,</mo><mrow><mi>q</mi><mo>∉</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></mrow></msub><mi mathvariant="normal">Δ</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub></mrow><annotation encoding="application/x-tex">\Delta_{q}=\min_{\mathcal{M}\in\mathfrak{V}:\mathcal{M}\neq\mathcal{M}^{*},q\notin\mathcal{M}}\Delta_{\mathcal{M}}</annotation></semantics></math>. Similar to the definition 2 in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib16" title="" class="ltx_ref">16</a>]</cite>, if there is no cache selection <math id="S4.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> such that <math id="S4.Thmtheorem2.p1.m6" class="ltx_Math" alttext="q\in\mathcal{M}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow><annotation encoding="application/x-tex">q\in\mathcal{M}</annotation></semantics></math> and <math id="S4.Thmtheorem2.p1.m7" class="ltx_Math" alttext="\mathcal{M}\neq\mathcal{M}^{*}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>≠</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">\mathcal{M}\neq\mathcal{M}^{*}</annotation></semantics></math>, we define <math id="S4.Thmtheorem2.p1.m8" class="ltx_Math" alttext="\Delta_{q}=+\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi>q</mi></msub><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\Delta_{q}=+\infty</annotation></semantics></math>. Then we define <math id="S4.Thmtheorem2.p1.m9" class="ltx_Math" alttext="\Delta_{min}=\min_{q\in\mathcal{Q}}\Delta_{q}=\min_{\mathcal{M}\in\mathfrak{V}}\Delta_{\mathcal{M}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>=</mo><mrow><msub><mi>min</mi><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Δ</mi><mi>q</mi></msub></mrow><mo>=</mo><mrow><msub><mi>min</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mi>𝔙</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\Delta_{min}=\min_{q\in\mathcal{Q}}\Delta_{q}=\min_{\mathcal{M}\in\mathfrak{V}}\Delta_{\mathcal{M}}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_italic">Remark 4.3</span></span><span id="S4.Thmtheorem3.3" class="ltx_text ltx_font_italic">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p">We define the gap of a query as the difference between the non-optimal cache that does not include this query and the optimal cache. This gap of query measures the impact when a cache does not select this query. Detailed discussion is in Appendix.</p>
</div>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 4.4</span></span><span id="S4.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p"><span id="S4.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Setting <math id="S4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="\delta=1/T" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">\delta=1/T</annotation></semantics></math>,
(1) if <math id="S4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\Delta_{min}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{min}&gt;0</annotation></semantics></math>, the problem-dependent regret bound for VSOCB (Alg.<a href="#alg1" title="Algorithm 1 ‣ 4.1 Algorithm with Exact Oracle ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) with exact <span id="S4.Thmtheorem4.p1.1.1.1" class="ltx_text ltx_font_typewriter">Oracle</span>(Alg.<a href="#alg2" title="Algorithm 2 ‣ 4.1 Algorithm with Exact Oracle ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>) holds:</span></p>
<table id="S4.EGx4" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex8.m1" class="ltx_Math" alttext="\displaystyle\textstyle Reg(T)\leq\widetilde{O}\left(\sum_{q\in\mathcal{M}^{*}}\frac{P(q)Nl(M,\mathcal{Q})}{\Delta_{q}}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup></mrow></msub><mfrac><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mi mathvariant="normal">Δ</mi><mi>q</mi></msub></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\textstyle Reg(T)\leq\widetilde{O}\left(\sum_{q\in\mathcal{M}^{*}}\frac{P(q)Nl(M,\mathcal{Q})}{\Delta_{q}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem4.p1.2" class="ltx_p"><span id="S4.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">(2) and problem-independent regret bound:</span></p>
<table id="S4.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.Ex9.m1" class="ltx_Math" alttext="\displaystyle Reg(T)\leq\widetilde{O}\left(\sqrt{Nl(M,\mathcal{Q})T}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msqrt><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle Reg(T)\leq\widetilde{O}\left(\sqrt{Nl(M,\mathcal{Q})T}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem4.p1.3" class="ltx_p"><span id="S4.Thmtheorem4.p1.3.1" class="ltx_text ltx_font_italic">where <math id="S4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="l(M,\mathcal{Q})=\min\{l_{max},N-l_{min}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>l</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></msub><mo>,</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>l</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">l(M,\mathcal{Q})=\min\{l_{max},N-l_{min}\}</annotation></semantics></math>.
(3) and the total number of <span id="S4.Thmtheorem4.p1.3.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> calls is <math id="S4.Thmtheorem4.p1.m4" class="ltx_Math" alttext="O(N\log{T})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(N\log{T})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S4.SS2.p2" class="ltx_para ltx_noindent">
<p id="S4.SS2.p2.1" class="ltx_p">This proof is deferred to Appendix. In the proof, we adopted an analysis method similar to <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib16" title="" class="ltx_ref">16</a>]</cite> and combined it with the <span id="S4.SS2.p2.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> invoking policy proposed in our algorithm. We show that the accumulation-based <span id="S4.SS2.p2.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> invoking policy associates the duration for which the cache remains unchanged. Our conclusion suggests that both very small and very large caches result in relatively low regret. This is intuitive because, if the cache is very small and can only hold one query, we will have <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="l(M,\mathcal{Q})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l(M,\mathcal{Q})=1</annotation></semantics></math>, the optimal cache can be easily identified. In this case, the algorithm can quickly find the best cache. If the cache is large enough to hold all queries, then <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="l(M,\mathcal{Q})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">l(M,\mathcal{Q})=0</annotation></semantics></math>, and the cache can store all queries, which eliminates regret altogether.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para ltx_noindent">
<p id="S4.SS2.p3.1" class="ltx_p">We demonstrate that our Online Variable Size Cache Bandits achieves the regret of <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="\widetilde{O}(\sqrt{MNT})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msqrt><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{O}(\sqrt{MNT})</annotation></semantics></math> (becasue <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="l(M,\mathcal{Q})\leq M" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">l(M,\mathcal{Q})\leq M</annotation></semantics></math>), which represents an improvement over Caching in Online Learning in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> with the coefficient of <math id="S4.SS2.p3.m3" class="ltx_Math" alttext="\sqrt{MN}" display="inline" intent=":literal"><semantics><msqrt><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></msqrt><annotation encoding="application/x-tex">\sqrt{MN}</annotation></semantics></math>, where the conclusion of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> was <math id="S4.SS2.p3.m4" class="ltx_Math" alttext="\widetilde{O}(MN\sqrt{T})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>T</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{O}(MN\sqrt{T})</annotation></semantics></math>. On the other hand, our model is an extension of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>, which can be regarded as a special case of our model. In this case, <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> proposed a lower bound of <math id="S4.SS2.p3.m5" class="ltx_Math" alttext="\Omega(\sqrt{T})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>T</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Omega(\sqrt{T})</annotation></semantics></math>. The problem-independent regret established in Theorem <a href="#S4.Thmtheorem4" title="Theorem 4.4. ‣ 4.2 Exact Solution Bound ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a> conforms to <math id="S4.SS2.p3.m6" class="ltx_Math" alttext="\widetilde{O}(\sqrt{T})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msqrt><mi>T</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{O}(\sqrt{T})</annotation></semantics></math>, indicating that our work provides an optimal solution in relation to <math id="S4.SS2.p3.m7" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p4" class="ltx_para ltx_noindent">
<p id="S4.SS2.p4.1" class="ltx_p">Although our algorithm requires an additional <span id="S4.SS2.p4.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> to assist in computation, our proof shows that the number of calling <span id="S4.SS2.p4.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> is <math id="S4.SS2.p4.m1" class="ltx_Math" alttext="O(N\log{T})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(N\log{T})</annotation></semantics></math>, which is logarithmic. This indicates that the additional computational cost caused by using <span id="S4.SS2.p4.1.3" class="ltx_text ltx_font_typewriter">Oracle</span> is not significant, and it well balances the trade-off between computational cost and regret.</p>
</div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>VSOCB with Approximate <span id="S5.2" class="ltx_text ltx_font_typewriter">Oracle</span></h2>

<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1 </span>Approximate <span id="S5.SS1.2" class="ltx_text ltx_font_typewriter">Oracle</span></h3>

<div id="S5.SS1.p1" class="ltx_para ltx_noindent">
<p id="S5.SS1.p1.1" class="ltx_p">When the solver can only output an approximate solution, we require the solver to output the complement of the cache. In this case, the optimization problem for solver transforms into a min-knapsack problem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">14</a>]</cite>:</p>
<table id="S5.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex10.m1" class="ltx_Math" alttext="\displaystyle\textstyle\min_{\mathcal{M}}{\sum_{q\in\mathcal{M}^{c}}P(q)C^{*}(q)}" display="inline" intent=":literal"><semantics><mrow><mi>min</mi><mo>⁡</mo><mrow><mmultiscripts><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup></mrow><mrow></mrow><mprescripts></mprescripts><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow></mrow></mmultiscripts><mo>⁡</mo><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\textstyle\min_{\mathcal{M}}{\sum_{q\in\mathcal{M}^{c}}P(q)C^{*}(q)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S5.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex11.m1" class="ltx_Math" alttext="\displaystyle s.t.\textstyle\sum_{q\in\mathcal{M}^{c}}S(q)\geq\sum_{q\in\mathcal{Q}}S(q)-M," display="inline" intent=":literal"><semantics><mrow><mrow><mi>s</mi><mo lspace="0em" rspace="0.167em">.</mo><mi>t</mi><mo lspace="0em" rspace="0em">.</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup></mrow></msub><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">≥</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow></msub><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>M</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle s.t.\textstyle\sum_{q\in\mathcal{M}^{c}}S(q)\geq\sum_{q\in\mathcal{Q}}S(q)-M,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.SS1.p1.2" class="ltx_p">where <math id="S5.SS1.p1.m1" class="ltx_Math" alttext="q\in\mathcal{M}^{c}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup></mrow><annotation encoding="application/x-tex">q\in\mathcal{M}^{c}</annotation></semantics></math> means that <math id="S5.SS1.p1.m2" class="ltx_Math" alttext="q\notin\mathcal{M}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∉</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow><annotation encoding="application/x-tex">q\notin\mathcal{M}</annotation></semantics></math>. We use <math id="S5.SS1.p1.m3" class="ltx_Math" alttext="knap_{min}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><annotation encoding="application/x-tex">knap_{min}</annotation></semantics></math> to denote min-knapsack problem solver and it output the a solution of MKP. Clearly, the optimal solution set for this MKP is the complement of the optimal solution set for the original knapsack problem. We use <math id="S5.SS1.p1.m4" class="ltx_Math" alttext="\mathcal{M}^{*c}=\mathcal{Q}\setminus\mathcal{M}^{*}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mi>c</mi></mrow></msup><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>∖</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}^{*c}=\mathcal{Q}\setminus\mathcal{M}^{*}</annotation></semantics></math> to denote the optimal complementary of cache.</p>
</div>
<div id="S5.Thmtheorem1" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem1.2" class="ltx_text ltx_font_bold">Definition 5.1</span></span><span id="S5.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem1.p1" class="ltx_para">
<p id="S5.Thmtheorem1.p1.1" class="ltx_p">(<math id="S5.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>-approximation solver): A minimum knapsack problem solver is <math id="S5.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>-approximation solver mean that: the output <math id="S5.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\mathcal{M}^{c}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup><annotation encoding="application/x-tex">\mathcal{M}^{c}</annotation></semantics></math> of solver under input set <math id="S5.Thmtheorem1.p1.m4" class="ltx_Math" alttext="\mathcal{Q}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{Q}^{\prime}</annotation></semantics></math> and input value <math id="S5.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\{P^{\prime}(q)C^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\{P^{\prime}(q)C^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}</annotation></semantics></math> satisfy <math id="S5.Thmtheorem1.p1.m6" class="ltx_Math" alttext="\sum_{q\in\mathcal{M}^{c}}P^{\prime}(q)C^{\prime}(q)&lt;(1+\beta)\sum_{q\in\mathcal{M}^{*c}}P^{\prime}(q)C^{\prime}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup></mrow></msub><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mi>c</mi></mrow></msup></mrow></msub><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{q\in\mathcal{M}^{c}}P^{\prime}(q)C^{\prime}(q)&lt;(1+\beta)\sum_{q\in\mathcal{M}^{*c}}P^{\prime}(q)C^{\prime}(q)</annotation></semantics></math></p>
</div>
</div>
<div id="S5.SS1.p2" class="ltx_para ltx_noindent">
<p id="S5.SS1.p2.1" class="ltx_p">Since the minimum knapsack solver outputs the complement of the knapsack problem solution, we take the complement of the solver’s output to obtain the recommended cache, <a href="#alg3" title="In 5.1 Approximate Oracle ‣ 5 VSOCB with Approximate Oracle ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">3</span></a> is our approximate <span id="S5.SS1.p2.1.1" class="ltx_text ltx_font_typewriter">Oracle</span>. Replacing the <math id="S5.SS1.p2.m1" class="ltx_Math" alttext="Oracle" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">Oracle</annotation></semantics></math> in Alg.<a href="#alg1" title="Algorithm 1 ‣ 4.1 Algorithm with Exact Oracle ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> with Alg.<a href="#alg3" title="Algorithm 3 ‣ 5.1 Approximate Oracle ‣ 5 VSOCB with Approximate Oracle ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> is the approximate version of VSOCB.</p>
</div>
<div id="S5.SS1.p3" class="ltx_para ltx_noindent">
<p id="S5.SS1.p3.1" class="ltx_p">Remarking that we define the approximate algorithm on the minimum knapsack problem instead of directly defining an approximate algorithm on the original knapsack problem. This mainly due to our theoretical analysis, when <span id="S5.SS1.p3.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> outputs an approximate solution, it cannot directly compare the optimal cache with the recommended cache in the same way as an <span id="S5.SS1.p3.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> that provides an exact solution. We relax the regret analysis to focus on the complement, using this relaxation to address this challenge.</p>
</div>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.4" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> Approximate <span id="alg3.5" class="ltx_text ltx_font_typewriter">Oracle</span></figcaption>
<div id="alg3.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">1:</span>
              
              
             Input <math id="alg3.l1.m1" class="ltx_Math" alttext="\mathcal{Q}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{Q}^{\prime}</annotation></semantics></math>, <math id="alg3.l1.m2" class="ltx_Math" alttext="\{C^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>C</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\{C^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}</annotation></semantics></math>, <math id="alg3.l1.m3" class="ltx_Math" alttext="\{P^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\{P^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}</annotation></semantics></math>, <math id="alg3.l1.m4" class="ltx_Math" alttext="\{S^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>S</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\{S^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}}</annotation></semantics></math>, <math id="alg3.l1.m5" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>

</div>
<div id="alg3.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">2:</span>
              
              
             <math id="alg3.l2.m1" class="ltx_Math" alttext="w(q)=P^{\prime}(q)C^{\prime}(q),\forall q\in\mathcal{Q}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>P</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>q</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">w(q)=P^{\prime}(q)C^{\prime}(q),\forall q\in\mathcal{Q}^{\prime}</annotation></semantics></math>

</div>
<div id="alg3.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">3:</span>
              
              
             <math id="alg3.l3.m1" class="ltx_Math" alttext="\mathcal{M}^{c}\leftarrow Knap_{min}(\{w(q)\}_{q\in\mathcal{Q}^{\prime}},\{S^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}},M)" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup><mo stretchy="false">←</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">{</mo><mrow><mi>w</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><mrow><msup><mi>S</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup></mrow></msub><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}^{c}\leftarrow Knap_{min}(\{w(q)\}_{q\in\mathcal{Q}^{\prime}},\{S^{\prime}(q)\}_{q\in\mathcal{Q}^{\prime}},M)</annotation></semantics></math>

</div>
<div id="alg3.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline">4:</span>
              
              
             Output <math id="alg3.l4.m1" class="ltx_Math" alttext="\mathcal{Q}^{\prime}\setminus\mathcal{M}^{c}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>′</mo></msup><mo>∖</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{Q}^{\prime}\setminus\mathcal{M}^{c}</annotation></semantics></math>

</div>
</div>
</figure>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2 </span>Approximate Solution Bound</h3>

<div id="S5.SS2.p1" class="ltx_para ltx_noindent">
<p id="S5.SS2.p1.1" class="ltx_p">Since the output in the case of an approximate solver is the complement of the cache, we need to redefine some of the previous definitions. First, following by CMAB <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">9</a>]</cite>,we redefine the regret of our problem.</p>
</div>
<div id="S5.Thmtheorem2" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem2.2" class="ltx_text ltx_font_bold">Definition 5.2</span></span><span id="S5.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem2.p1" class="ltx_para">
<p id="S5.Thmtheorem2.p1.1" class="ltx_p">(<math id="S5.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>-approximation regret): For a <math id="S5.Thmtheorem2.p1.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>-approximation solver, the <math id="S5.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>-approximation regret is:</p>
<table id="S5.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S5.Ex12.m1" class="ltx_Math" alttext="\displaystyle\textstyle Reg_{\beta}(T)=\sum_{t=1}^{T}\mathbb{E}\left[\sum_{q\in\mathcal{M}_{t}^{c}}P(q)C^{*}(q)-(1+\beta)\sum_{q\in\mathcal{M}^{*c}}P(q)C^{*}(q)\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>q</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi><mi>c</mi></msubsup></mrow></msub><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mi>c</mi></mrow></msup></mrow></msub><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\textstyle Reg_{\beta}(T)=\sum_{t=1}^{T}\mathbb{E}\left[\sum_{q\in\mathcal{M}_{t}^{c}}P(q)C^{*}(q)-(1+\beta)\sum_{q\in\mathcal{M}^{*c}}P(q)C^{*}(q)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="S5.Thmtheorem3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem3.2" class="ltx_text ltx_font_bold">Definition 5.3</span></span><span id="S5.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem3.p1" class="ltx_para">
<p id="S5.Thmtheorem3.p1.1" class="ltx_p">(Approximation gap): For each <math id="S5.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\mathcal{M}\in\mathfrak{V}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mi>𝔙</mi></mrow><annotation encoding="application/x-tex">\mathcal{M}\in\mathfrak{V}</annotation></semantics></math> and <math id="S5.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\mathcal{M}^{c}=\mathcal{Q}\setminus\mathcal{M}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒬</mi><mo>∖</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{M}^{c}=\mathcal{Q}\setminus\mathcal{M}</annotation></semantics></math>, we define the gap <math id="S5.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\Delta_{\mathcal{M}}^{c}=\sum_{q\in\mathcal{M}_{t}^{c}}P(q)C^{*}(q)-(1+\beta)\sum_{q\in\mathcal{M}^{*c}}P(q)C^{*}(q)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msubsup><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi><mi>c</mi></msubsup></mrow></msub><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>β</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mi>c</mi></mrow></msup></mrow></msub><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>C</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta_{\mathcal{M}}^{c}=\sum_{q\in\mathcal{M}_{t}^{c}}P(q)C^{*}(q)-(1+\beta)\sum_{q\in\mathcal{M}^{*c}}P(q)C^{*}(q)</annotation></semantics></math>. For each query <math id="S5.Thmtheorem3.p1.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, we define <math id="S5.Thmtheorem3.p1.m5" class="ltx_math_unparsed" alttext="\Delta_{q}^{c}=\min_{\mathcal{M}\in\mathfrak{V}:\mathcal{M}\neq\mathcal{M}^{*},q\notin\mathcal{M}}\Delta_{\mathcal{M}}^{c}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><msub><mrow></mrow><mi>q</mi></msub><msup><mrow></mrow><mi>c</mi></msup><mo>=</mo><mi>min</mi><msub><mrow></mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mi>𝔙</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>≠</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∗</mo></msup></mrow></mrow><mo>,</mo><mrow><mi>q</mi><mo>∉</mo><mi class="ltx_font_mathcaligraphic">ℳ</mi></mrow></mrow></msub><mi mathvariant="normal">Δ</mi><msub><mrow></mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi></msub><msup><mrow></mrow><mi>c</mi></msup></mrow><annotation encoding="application/x-tex">\Delta_{q}^{c}=\min_{\mathcal{M}\in\mathfrak{V}:\mathcal{M}\neq\mathcal{M}^{*},q\notin\mathcal{M}}\Delta_{\mathcal{M}}^{c}</annotation></semantics></math>. If there is no <math id="S5.Thmtheorem3.p1.m6" class="ltx_Math" alttext="\mathcal{M}^{c}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup><annotation encoding="application/x-tex">\mathcal{M}^{c}</annotation></semantics></math> such that <math id="S5.Thmtheorem3.p1.m7" class="ltx_Math" alttext="q\in\mathcal{M}^{c}" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup></mrow><annotation encoding="application/x-tex">q\in\mathcal{M}^{c}</annotation></semantics></math> and <math id="S5.Thmtheorem3.p1.m8" class="ltx_Math" alttext="\mathcal{M}^{c}\neq\mathcal{M}^{*c}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msup><mo>≠</mo><msup><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.222em">∗</mo><mi>c</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{M}^{c}\neq\mathcal{M}^{*c}</annotation></semantics></math>, we define <math id="S5.Thmtheorem3.p1.m9" class="ltx_Math" alttext="\Delta_{q}^{c}=+\infty" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>q</mi><mi>c</mi></msubsup><mo>=</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\Delta_{q}^{c}=+\infty</annotation></semantics></math>. We define <math id="S5.Thmtheorem3.p1.m10" class="ltx_Math" alttext="\Delta_{min}^{c}=\min_{q\in\mathcal{Q}}\Delta_{q}^{c}=\min_{\mathcal{M}\in\mathfrak{V}}\Delta_{\mathcal{M}}^{c}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathvariant="normal">Δ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mi>c</mi></msubsup><mo>=</mo><mrow><msub><mi>min</mi><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msubsup><mi mathvariant="normal">Δ</mi><mi>q</mi><mi>c</mi></msubsup></mrow><mo>=</mo><mrow><msub><mi>min</mi><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>∈</mo><mi>𝔙</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msubsup><mi mathvariant="normal">Δ</mi><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>c</mi></msubsup></mrow></mrow><annotation encoding="application/x-tex">\Delta_{min}^{c}=\min_{q\in\mathcal{Q}}\Delta_{q}^{c}=\min_{\mathcal{M}\in\mathfrak{V}}\Delta_{\mathcal{M}}^{c}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S5.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem 5.4</span></span><span id="S5.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem4.p1" class="ltx_para">
<p id="S5.Thmtheorem4.p1.1" class="ltx_p"><span id="S5.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Setting <math id="S5.Thmtheorem4.p1.m1" class="ltx_Math" alttext="\delta=1/T" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">\delta=1/T</annotation></semantics></math>, (1) if <math id="S5.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\Delta_{min}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\Delta_{min}&gt;0</annotation></semantics></math>, the problem-dependent regret bound for VSOCB (Alg.<a href="#alg1" title="Algorithm 1 ‣ 4.1 Algorithm with Exact Oracle ‣ 4 Variable Size Online Cache Bandit ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>) with approximate <span id="S5.Thmtheorem4.p1.1.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> (Alg.<a href="#alg3" title="Algorithm 3 ‣ 5.1 Approximate Oracle ‣ 5 VSOCB with Approximate Oracle ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>) holds:</span></p>
<table id="S5.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex13.m1" class="ltx_Math" alttext="\displaystyle\textstyle Reg_{\beta}(T)\leq\widetilde{O}\left(\sum_{q\in\mathcal{Q}}\frac{P(q)N(N-l_{min})}{\Delta_{q}^{c}}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mo lspace="0em">∑</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow></msub><mfrac><mrow><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>l</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msubsup><mi mathvariant="normal">Δ</mi><mi>q</mi><mi>c</mi></msubsup></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\textstyle Reg_{\beta}(T)\leq\widetilde{O}\left(\sum_{q\in\mathcal{Q}}\frac{P(q)N(N-l_{min})}{\Delta_{q}^{c}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem4.p1.2" class="ltx_p"><span id="S5.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">(2) our problem-independent regret bound:</span></p>
<table id="S5.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S5.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S5.Ex14.m1" class="ltx_Math" alttext="\displaystyle Reg_{\beta}(T)\leq\widetilde{O}\left(\sqrt{N(N-l_{min})T}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>β</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msqrt><mrow><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo>−</mo><msub><mi>l</mi><mrow><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle Reg_{\beta}(T)\leq\widetilde{O}\left(\sqrt{N(N-l_{min})T}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S5.Thmtheorem4.p1.3" class="ltx_p"><span id="S5.Thmtheorem4.p1.3.1" class="ltx_text ltx_font_italic">(3) and the total number of <span id="S5.Thmtheorem4.p1.3.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> calls is <math id="S5.Thmtheorem4.p1.m3" class="ltx_Math" alttext="O(N\log{T})" display="inline" intent=":literal"><semantics><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>T</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(N\log{T})</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S5.SS2.p2" class="ltx_para ltx_noindent">
<p id="S5.SS2.p2.1" class="ltx_p">Our result under the approximate <span id="S5.SS2.p2.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> is less favorable than that under the exact <span id="S5.SS2.p2.1.2" class="ltx_text ltx_font_typewriter">Oracle</span>. This is because, in the case of an approximate solution, it is difficult to directly apply the properties of the exact solution. Consequently, we relax the regret analysis to account for the gap between the optimal cache under the approximate solution and the cache selected by the algorithm.</p>
</div>
</section>
</section>
<section id="S6" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span>Experiment</h2>

<section id="S6.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.1 </span>Simulation Dataset</h3>

<div id="S6.SS1.p1" class="ltx_para ltx_noindent">
<p id="S6.SS1.p1.1" class="ltx_p">We compare performance of our algorithms and the baseline using cumulative regret in online learning with a simulated dataset. We use the method described in the appendix of <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> which replaces one query with the smallest expected cost per-size to solve variable size case as the baseline. We consider 100 distinct queries and set the cache size to be 60. The expected of cost for each query is sample from a uniform distribution support on <math id="S6.SS1.p1.m1" class="ltx_Math" alttext="[1,2]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1,2]</annotation></semantics></math>. We repeat the simulation 10 times and plot the mean in the figure. The cost for each query in each round is sampled from a normal distribution with a mean equal to the expected value generated above. We employ a dynamic programming algorithm as our solver in <span id="S6.SS1.p1.1.1" class="ltx_text ltx_font_typewriter">Oracle</span>. We use an offline version to compare, denoted as <span id="S6.SS1.p1.1.2" class="ltx_text ltx_font_bold">offline</span>. In offline, we assume that the algorithm can update the cache arbitrarily based on <span id="S6.SS1.p1.1.3" class="ltx_text ltx_font_typewriter">Oracle</span>’s output, and <span id="S6.SS1.p1.1.4" class="ltx_text ltx_font_typewriter">Oracle</span> can be called in every round without considering computational overhead.</p>
</div>
<div id="S6.SS1.p2" class="ltx_para ltx_noindent">
<p id="S6.SS1.p2.1" class="ltx_p">As shown in Fig.<a href="#S6.F1" title="Figure 1 ‣ 6.1 Simulation Dataset ‣ 6 Experiment ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, our algorithm outperforms the baseline. This improvement can be attributed to the fact that the method in <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite> provides an approximate solution to the knapsack problem <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib13" title="" class="ltx_ref">13</a>]</cite>, which poses a risk of falling into sub-optimal solutions. In contrast, our algorithm circumvents this issue by utilizing <span id="S6.SS1.p2.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> for the knapsack problem. We observe that VSOCB performs worse than offline. This discrepancy is due to the fact that offline algorithm can call <span id="S6.SS1.p2.1.2" class="ltx_text ltx_font_typewriter">Oracle</span> in each round, allowing it to converge faster. Although offline algorithm exhibits lower regret, it requires substantial additional memory and computational resources, which may be unrealistic in real-world scenarios. Conversely, our VSOCB algorithm avoiding these significant additional costs to some extent.</p>
</div>
<figure id="S6.F1" class="ltx_figure"><img src="2509.15515v1/icmltest1.png" id="S6.F1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:191/145;" width="191" height="145" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 1: </span>Synthetic dataset with 20000 rounds</figcaption>
</figure>
</section>
<section id="S6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">6.2 </span>Real Dataset</h3>

<div id="S6.SS2.p1" class="ltx_para ltx_noindent">
<p id="S6.SS2.p1.1" class="ltx_p">In line with <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite>, we evaluate our algorithms using the OpenAssistant <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite> dataset for the chat assistant task. For this task, we employ the FastChat-T5-3B <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib20" title="" class="ltx_ref">20</a>]</cite> model to implement our online algorithm, utilizing inference latency as the cost metric. We run our algorithm with 100 distinct queries in the online setting over a total of 20000 rounds, cache size is 100. As shown in Tab.<a href="#S6.T2" title="Table 2 ‣ 6.2 Real Dataset ‣ 6 Experiment ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and Fig. <a href="#S6.F2" title="Figure 2 ‣ 6.2 Real Dataset ‣ 6 Experiment ‣ LLM Cache Bandit Revisited: Addressing Query Heterogeneity for Cost-Effective LLM Inference" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, our method reduced the cost by <math id="S6.SS2.p1.m1" class="ltx_Math" alttext="13\%" display="inline" intent=":literal"><semantics><mrow><mn>13</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">13\%</annotation></semantics></math> compared to the baseline, with the result averaged over 5 repetitions. After a sufficient number of online learning steps, <span id="S6.SS2.p1.1.1" class="ltx_text ltx_font_typewriter">Oracle</span> accurately gets the costs and frequencies of each query, enabling VSOCB to outperform the baseline.</p>
</div>
<figure id="S6.F2" class="ltx_figure"><img src="2509.15515v1/icmltest2.png" id="S6.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:191/145;" width="191" height="145" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>Average cumulative cost over 5 repeat runs on Real dataset with 20000 rounds</figcaption>
</figure>
<figure id="S6.T2" class="ltx_table">
