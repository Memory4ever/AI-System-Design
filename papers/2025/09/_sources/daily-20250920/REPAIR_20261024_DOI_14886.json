{"data":{"id":"10.48550/arxiv.2509.14886","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14886","prefix":"10.48550","suffix":"arxiv.2509.14886","identifiers":[{"identifier":"2509.14886","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.14886"}],"creators":[{"name":"Shen, Ye","nameType":"Personal","givenName":"Ye","familyName":"Shen","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Junying","nameType":"Personal","givenName":"Junying","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Wen, Farong","nameType":"Personal","givenName":"Farong","familyName":"Wen","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Yijin","nameType":"Personal","givenName":"Yijin","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Jia, Qi","nameType":"Personal","givenName":"Qi","familyName":"Jia","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Zicheng","nameType":"Personal","givenName":"Zicheng","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhai, Guangtao","nameType":"Personal","givenName":"Guangtao","familyName":"Zhai","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Multi-To-One Interview Paradigm for Efficient MLLM Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-18T12:07:40Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T00:37:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The rapid progress of Multi-Modal Large Language Models (MLLMs) has spurred the creation of numerous benchmarks. However, conventional full-coverage Question-Answering evaluations suffer from high redundancy and low efficiency. Inspired by human interview processes, we propose a multi-to-one interview paradigm for efficient MLLM evaluation. Our framework consists of (i) a two-stage interview strategy with pre-interview and formal interview phases, (ii) dynamic adjustment of interviewer weights to ensure fairness, and (iii) an adaptive mechanism for question difficulty-level chosen. Experiments on different benchmarks show that the proposed paradigm achieves significantly higher correlation with full-coverage results than random sampling, with improvements of up to 17.6% in PLCC and 16.7% in SRCC, while reducing the number of required questions. These findings demonstrate that the proposed paradigm provides a reliable and efficient alternative for large-scale MLLM benchmarking.","descriptionType":"Abstract"},{"description":"5 pages, 2 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.14886","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:42:45.000Z","registered":"2025-09-19T01:42:45.000Z","published":"2025","updated":"2025-09-19T01:42:45.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.14886","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}