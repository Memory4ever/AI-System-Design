ntial\"},{\"title\":\" Transparency\",\"url\":\"/transparency\"},{\"title\":\"Responsible Scaling Policy\",\"url\":\"/responsible-scaling-policy\"},{\"title\":\"Beneficial Deployments\",\"url\":\"/beneficial-deployments\"}],\"title\":\"Initiatives\"},{\"_key\":\"16af50a6e2dd\",\"links\":[{\"title\":\"Security and compliance\",\"url\":\"https://trust.anthropic.com/\"}],\"title\":\"Trust center\"}]},{\"_key\":\"861a11ed9931\",\"category\":\"Learn\",\"displayType\":\"sections\",\"sections\":[{\"_key\":\"9f9f720a8793\",\"links\":[{\"title\":\"Claude Academy\",\"url\":\"https://academy.claude.com\"},{\"title\":\"Tutorials\",\"url\":\"https://claude.com/resources/tutorials\"},{\"title\":\"Use cases\",\"url\":\"https://claude.com/resources/use-cases\"},{\"title\":\"Developer docs\",\"url\":\"https://platform.claude.com/docs\"}],\"title\":\"Learn\"},{\"_key\":\"6bd061c46b10\",\"links\":[{\"title\":\"About\",\"url\":\"/company\"},{\"title\":\"Leadership\",\"url\":\"/company/leadership\"},{\"title\":\"Careers\",\"url\":\"/careers\"},{\"title\":\"Events\",\"url\":\"/events\"}],\"title\":\"Company\"}]},{\"_key\":\"22e8d8d2923d\",\"category\":\"News\",\"displayType\":\"singleLink\",\"sections\":null,\"url\":\"/news\"}],\"claudeCta\":{\"desktopCtas\":null,\"mobileCtas\":[{\"title\":\"Log in to Claude\",\"url\":\"https://claude.ai/login\"},{\"title\":\"Download app\",\"url\":\"https://claude.ai/download\"}],\"sections\":[{\"category\":\"About Claude\",\"links\":[{\"title\":\"Overview\",\"url\":\"https://claude.com/product/overview\"},{\"title\":\"Pricing\",\"url\":\"https://claude.com/pricing\"},{\"title\":\"Contact sales\",\"url\":\"https://claude.com/contact-sales\"}]},{\"category\":\"Models\",\"links\":[{\"title\":\"Mythos\",\"url\":\"/claude/mythos\"},{\"title\":\"Fable\",\"url\":\"/claude/fable\"},{\"title\":\"Opus\",\"url\":\"/claude/opus\"},{\"title\":\"Sonnet\",\"url\":\"/claude/sonnet\"},{\"title\":\"Haiku\",\"url\":\"/claude/haiku\"}]},{\"category\":\"Log in\",\"links\":[{\"title\":\"Claude.ai\",\"url\":\"https://claude.ai\"},{\"title\":\"Claude Console\",\"url\":\"https://platform.claude.com/\"}]}],\"title\":\"Try Claude\",\"url\":\"https://claude.ai/\"}},\"page\":{\"_createdAt\":\"2024-03-09T15:23:03Z\",\"_id\":\"b5e6b6d0-f668-4312-8a00-0e804343be62\",\"_rev\":\"dmV1nc4vpFyNxsAbKRJgfd\",\"_system\":{\"base\":{\"id\":\"b5e6b6d0-f668-4312-8a00-0e804343be62\",\"rev\":\"qfA5YhthdVbNrI0XpTg4gh\"}},\"_type\":\"page\",\"_updatedAt\":\"2026-09-09T13:27:36Z\",\"meta\":null,\"sections\":[{\"_createdAt\":\"2025-10-23T15:23:03Z\",\"_id\":\"b3e558fe-5b81-4985-95a1-1d2c7943390b\",\"_rev\":\"ym4yxM5uIQkTMvoznOZ3V0\",\"_system\":{\"base\":{\"id\":\"b3e558fe-5b81-4985-95a1-1d2c7943390b\",\"rev\":\"F5yZIU8sWbYpwZLxgt4GPv\"}},\"_type\":\"heroTwoColumn\",\"_updatedAt\":\"2026-08-24T17:54:25Z\",\"backgroundColor\":\"default\",\"body\":\"Our research teams investigate the safety, inner workings, and societal impacts of AI models—so that artificial intelligence has a positive impact as it becomes increasingly capable.\",\"ctaLabel\":\"Research teams:\",\"ctaVariant\":\"text-links\",\"ctas\":[{\"_key\":\"89bc6c65ec1a\",\"title\":\"Alignment\",\"url\":\"/research/team/alignment\"},{\"_key\":\"d6cab7356abf\",\"title\":\"Economics\",\"url\":\"/research/team/economics\"},{\"_key\":\"e4a8bb06c56a\",\"title\":\"Interpretability\",\"url\":\"/research/team/interpretability\"},{\"_key\":\"9e8c83c10490\",\"title\":\"Societal Impacts\",\"url\":\"/research/team/societal-impacts\"},{\"_key\":\"f90ec8145b6c\",\"title\":\"Frontier Red Team\",\"url\":\"https://www.anthropic.com/research/team/frontier-red-team\"}],\"flushBottom\":false,\"flushTop\":false,\"fullWidth\":false,\"title\":\"Research\"},{\"_createdAt\":\"2025-10-23T18:26:18Z\",\"_id\":\"cf44566d-d035-45b3-ba46-4564257ca437\",\"_rev\":\"FotzIp337NvhuBZ51yTZwd\",\"_system\":{\"base\":{\"id\":\"cf44566d-d035-45b3-ba46-4564257ca437\",\"rev\":\"ym4yxM5uIQkTMvoznOZ4HR\"}},\"_type\":\"linkGrid\",\"_updatedAt\":\"2026-08-26T09:20:44Z\",\"backgroundColor\":\"default\",\"borderTop\":true,\"featuredItem\":{\"video\":{\"_type\":\"video\",\"autoplay\":false,\"loop\":false,\"muted\":true,\"showControls\":true}},\"flushBottom\":false,\"flushTop\":true,\"fullWidth\":false,\"items\":[{\"_key\":\"b25a95b592f31132b552085cc65ef6d7\",\"body\":\"The Alignment team works to understand the risks of AI models and develop ways to ensure that future ones remain helpful, honest, and harmless.\",\"cta\":null,\"title\":\"Alignment\"},{\"_key\":\"3dc025665bd0\",\"body\":\"The Economics team studies how AI is reshaping the economy, including work, productivity, and economic opportunity.\",\"cta\":null,\"title\":\"Economics\"},{\"_key\":\"3319a104fa922b083891a8a58b8be5e6\",\"body\":\"The Frontier Red Team analyzes the implications of frontier AI models for cybersecurity, biosecurity, and autonomous systems.\",\"cta\":null,\"title\":\"Frontier Red Team\"},{\"_key\":\"99ee4103a9808b8c9101a129439d2ad7\",\"body\":\"The mission of the Interpretability team is to understand how large language models work internally, as a foundation for AI safety and positive outcomes.\",\"cta\":null,\"title\":\"Interpretability\"},{\"_key\":\"e7223450ad9551b93115fc1c3ad81227\",\"body\":\"Working closely with the Anthropic Policy and Safeguards teams, Societal Impacts is a technical research team that explores how AI is used in the real world.\",\"cta\":null,\"title\":\"Societal Impacts\"}],\"video\":{\"_type\":\"video\",\"autoplay\":false,\"loop\":false,\"muted\":true,\"showControls\":true,\"thumbnail\":null,\"url\":null}},{\"_createdAt\":\"2025-10-23T20:26:45Z\",\"_id\":\"e770fc61-c46a-48c5-8285-37e0cc140e65\",\"_rev\":\"T1BF2TA8FMwQMb09v5YRpn\",\"_system\":{\"base\":{\"id\":\"e770fc61-c46a-48c5-8285-37e0cc140e65\",\"rev\":\"E6X7FRPxWoEEyO8JcAZBjF\"}},\"_type\":\"featuredGrid\",\"_updatedAt\":\"2026-09-23T18:08:20Z\",\"backgroundColor\":\"default\",\"borderTop\":true,\"flushBottom\":false,\"flushTop\":true,\"fullWidth\":false,\"image\":{\"_type\":\"imageWithCaption\",\"asset\":{\"_ref\":\"image-b6e2c934b704f4856d361d842c9cec237465b5c6-1920x1080-webp\",\"_type\":\"reference\"},\"caption\":null,\"height\":1080,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/b6e2c934b704f4856d361d842c9cec237465b5c6-1920x1080.webp\",\"width\":1920},\"internalName\":\"Research Featured Grid\",\"items\":[{\"_key\":\"9aeeaf56bb06\",\"_type\":\"featuredGridLink\",\"summary\":\"Anthropic’s Economics team is sharing a new model of how AI may affect economic growth, jobs, wages, and more by 2030. The model lets you explore the scenarios, tell us what you think will happen, and see how your answers compare to +10,000 Americans.\",\"title\":\"Scenarios for our Economic Future\",\"url\":\"https://www.anthropic.com/institute/econ-scenarios\"},{\"_type\":\"post\",\"cardPhoto\":null,\"directories\":[{\"_key\":\"news\",\"_type\":\"tag\",\"label\":\"News\",\"value\":\"news\"}],\"illustration\":{\"backgroundColor\":\"default\",\"illustration\":null},\"publishedOn\":\"2026-09-23T16:06:00.000Z\",\"slug\":{\"_type\":\"slug\",\"current\":\"claude-discovers-novel-enzyme-system\"},\"subjects\":[{\"_key\":\"science\",\"_type\":\"tag\",\"label\":\"Science\",\"value\":\"science\"}],\"summary\":\"We’re announcing a new life sciences research group and laboratory at Anthropic. This post introduces the team behind this work and shares early results in which Claude discovered a novel enzyme system with properties reminiscent of CRISPR, with only high-level direction from our scientists.\",\"title\":\" Claude discovers a novel enzyme system with CRISPR-like repeats\"},{\"_key\":\"6a62b38fa1e2\",\"_type\":\"featuredGridLink\",\"date\":\"2026-09-17\",\"summary\":\"Today, the world can’t see what’s going on inside AI labs. Anthropic is proposing new metrics that would give the public visibility into frontier AI development.\",\"title\":\"Measurements for understanding the pace of AI development inside frontier labs\",\"url\":\"https://www.anthropic.com/institute/measuring-pace-of-ai-development\"},{\"_type\":\"post\",\"cardPhoto\":{\"description\":\"Mathematical image reminiscent of elliptical curves\",\"height\":630,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/578f91575c42231f0994e341014614255149af80-1200x630.jpg\",\"width\":1200},\"directories\":[{\"_key\":\"research\",\"_type\":\"tag\",\"label\":\"Research\",\"value\":\"research\"}],\"illustration\":{\"backgroundColor\":\"default\",\"illustration\":null},\"publishedOn\":\"2026-09-04T15:27:00.000Z\",\"slug\":{\"_type\":\"slug\",\"current\":\"formalizing-fermats-last-theorem\"},\"subjects\":[{\"_key\":\"science\",\"_type\":\"tag\",\"label\":\"Science\",\"value\":\"science\"}],\"summary\":\"We are sharing the first complete computer-checked proof of Fermat’s Last Theorem. Claude worked largely autonomously over 11 days to write the proof in the Lean programming language.\",\"title\":\"Formalizing Fermat's Last Theorem \"},{\"_type\":\"post\",\"cardPhoto\":{\"description\":null,\"height\":1125,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/25a7c99743ebfb3b79cb98ffa2b9e928ad7e712b-2000x1125.webp\",\"width\":2000},\"directories\":[{\"_key\":\"research\",\"_type\":\"tag\",\"label\":\"Research\",\"value\":\"research\"}],\"illustration\":{\"backgroundColor\":\"default\",\"illustration\":null},\"publishedOn\":\"2026-09-09T15:00:00.000Z\",\"slug\":{\"_type\":\"slug\",\"current\":\"alignment-assessment-cybersecurity-incidents\"},\"subjects\":[{\"_key\":\"alignment\",\"_type\":\"tag\",\"label\":\"Alignment\",\"value\":\"alignment\"}],\"summary\":\"We present an alignment assessment of four incidents in which Claude models gained unauthorized access to real third-party systems. \",\"title\":\"An alignment assessment of recent cybersecurity incidents\"}],\"video\":{\"_type\":\"video\",\"autoplay\":true,\"loop\":true,\"muted\":true,\"thumbnail\":null,\"url\":null}},{\"_createdAt\":\"2025-10-23T19:52:01Z\",\"_id\":\"909f7fd8-27ac-4f04-b843-5550a30af34b\",\"_rev\":\"b1eIcYcJgqHFyhGZU8qpYi\",\"_type\":\"publicationList\",\"_updatedAt\":\"2025-11-16T19:17:33Z\",\"backgroundColor\":\"default\",\"borderTop\":true,\"directory\":{\"_key\":\"research\",\"_type\":\"tag\",\"label\":\"Research\",\"value\":\"research\"},\"flushBottom\":false,\"flushTop\":true,\"fullWidth\":false,\"postSubjects\":null,\"posts\":[{\"_type\":\"post\",\"cardPhoto\":{\"description\":\"collage of a physics diagram and trees\",\"height\":1125,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/5dca367673e615ac7abbbdac9f44733d1f52638a-2000x1125.jpg\",\"width\":2000},\"directories\":[{\"_key\":\"research\",\"_type\":\"tag\",\"label\":\"Research\",\"value\":\"research\"}],\"illustration\":{\"backgroundColor\":\"default\",\"illustration\":null},\"publishedOn\":\"2026-10-01T14:02:00.000Z\",\"slug\":{\"_type\":\"slug\",\"current\":\"claude-shaped-science\"},\"subjects\":[{\"_key\":\"science\",\"_type\":\"tag\",\"label\":\"Science\",\"value\":\"science\"}],\"summary\":\"Guest author Prof. Matthew Schwartz describes what happened when he stopped fighting Claude and allowed Claude to find “Claude-shaped” problems: ones best suited to the capabilities of the current generation of LLM tools. This led him to build BootLoops, a toolkit for exact calculations in quantitative science, which he has been applying across scientific fields alongside experts.\",\"title\":\"Claude-shaped science\"},{\"_type\":\"post\",\"cardPhoto\":{\"description\":\"What work can robots do?\",\"height\":1280,\"url\":\"https://cdn.sanity.io/images/4zrzovbb/website/557fbb195505dbfd857102e10c8a73ffdf483b2e-1280x1280.jpg\",\"width\":1280},\"directories\":[{\"_key\":\"research\",\"_type\":\"tag\",\"label\":\"Research\",\"value\":\"research\"}],\"illustration\":{\"backgroundColor\":\"default\",\"illustration\":null},\"publishedOn\":\