            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
          <span id="alg1.l5.3" class="ltx_text ltx_font_bold">function</span> <span id="alg1.l5.4" class="ltx_text ltx_font_smallcaps">scheduler</span>(<math id="alg1.l5.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math>, <math id="alg1.l5.m2" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>, <math id="alg1.l5.m3" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math>)

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
            <span id="alg1.l6.3" class="ltx_text ltx_font_bold">while</span> <math id="alg1.l6.m1" class="ltx_Math" alttext="True" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">True</annotation></semantics></math> <span id="alg1.l6.4" class="ltx_text ltx_font_bold">do</span>

