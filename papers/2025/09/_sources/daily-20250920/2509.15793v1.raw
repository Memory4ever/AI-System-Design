<th id="S2.T1.2.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">0.65</th>
<td id="S2.T1.2.6.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S2.T1.2.6.2.1" class="ltx_inline-block ltx_align_top" style="width:241.5pt;">
