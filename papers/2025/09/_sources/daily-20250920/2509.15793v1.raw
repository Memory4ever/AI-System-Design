<th id="S2.T1.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt">Score</th>
<th id="S2.T1.2.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt">
<span id="S2.T1.2.1.2.1" class="ltx_inline-block ltx_align_top" style="width:241.5pt;">
