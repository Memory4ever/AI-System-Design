<h3 class="ltx_title ltx_title_subsection">VLM Instructions</h3>

<div id="A1.SSx3.p1" class="ltx_para">
<div id="A1.SSx3.p1.1" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx65" class="ltx_listingline"><span id="lstnumberx65.1" class="ltx_text ltx_lst_identifier">You</span><span id="lstnumberx65.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.3" class="ltx_text ltx_lst_identifier">must</span><span id="lstnumberx65.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.5" class="ltx_text ltx_lst_identifier">answer</span><span id="lstnumberx65.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.7" class="ltx_text ltx_lst_identifier">this</span><span id="lstnumberx65.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.9" class="ltx_text ltx_lst_identifier">question</span><span id="lstnumberx65.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.11" class="ltx_text ltx_lst_identifier">based</span><span id="lstnumberx65.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.13" class="ltx_text ltx_lst_identifier">on</span><span id="lstnumberx65.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.15" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx65.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.17" class="ltx_text ltx_lst_identifier">visible</span><span id="lstnumberx65.18" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.19" class="ltx_text ltx_lst_identifier">information</span><span id="lstnumberx65.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.21" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx65.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.23" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx65.24" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.25" class="ltx_text ltx_lst_identifier">image</span>,<span id="lstnumberx65.26" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.27" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx65.28" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.29" class="ltx_text ltx_lst_identifier">there</span><span id="lstnumberx65.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.31" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx65.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.33" class="ltx_text ltx_lst_identifier">only</span><span id="lstnumberx65.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.35" class="ltx_text ltx_lst_identifier">one</span><span id="lstnumberx65.36" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.37" class="ltx_text ltx_lst_identifier">correct</span><span id="lstnumberx65.38" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.39" class="ltx_text ltx_lst_identifier">answer</span><span id="lstnumberx65.40" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.41" class="ltx_text ltx_lst_identifier">for</span><span id="lstnumberx65.42" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.43" class="ltx_text ltx_lst_identifier">every</span><span id="lstnumberx65.44" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx65.45" class="ltx_text ltx_lst_identifier">question</span>.
</div>
