 id="lstnumberx11.198" class="ltx_text ltx_lst_identifier">physical</span><span id="lstnumberx11.199" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.200" class="ltx_text ltx_lst_identifier">attributes</span>,<span id="lstnumberx11.201" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.202" class="ltx_text ltx_lst_identifier">textures</span>,<span id="lstnumberx11.203" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.204" class="ltx_text ltx_lst_identifier">presentation</span><span id="lstnumberx11.205" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.206" class="ltx_text ltx_lst_identifier">style</span>,<span id="lstnumberx11.207" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.208" class="ltx_text ltx_lst_identifier">or</span><span id="lstnumberx11.209" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.210" class="ltx_text ltx_lst_identifier">objects</span><span id="lstnumberx11.211" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.212" class="ltx_text ltx_lst_identifier">present</span><span id="lstnumberx11.213" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.214" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx11.215" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.216" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx11.217" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.218" class="ltx_text ltx_lst_identifier">image</span>.<span id="lstnumberx11.219" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.220" class="ltx_text ltx_lst_identifier">Avoid</span><span id="lstnumberx11.221" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.222" class="ltx_text ltx_lst_identifier">questions</span><span id="lstnumberx11.223" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx11.224" class="ltx_text ltx_lst_identifier">about</span><span id="lstnumberx11.225" class="ltx_text ltx_