{"data":{"id":"10.48550/arxiv.2509.14448","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14448","prefix":"10.48550","suffix":"arxiv.2509.14448","identifiers":[{"identifier":"2509.14448","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.14448"}],"creators":[{"name":"Chen, Rick","nameType":"Personal","givenName":"Rick","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Ternasky, Joseph","nameType":"Personal","givenName":"Joseph","familyName":"Ternasky","affiliation":[],"nameIdentifiers":[]},{"name":"Kwesi, Afriyie Samuel","nameType":"Personal","givenName":"Afriyie Samuel","familyName":"Kwesi","affiliation":[],"nameIdentifiers":[]},{"name":"Griffin, Ben","nameType":"Personal","givenName":"Ben","familyName":"Griffin","affiliation":[],"nameIdentifiers":[]},{"name":"Yin, Aaron Ontoyin","nameType":"Personal","givenName":"Aaron Ontoyin","familyName":"Yin","affiliation":[],"nameIdentifiers":[]},{"name":"Salifu, Zakari","nameType":"Personal","givenName":"Zakari","familyName":"Salifu","affiliation":[],"nameIdentifiers":[]},{"name":"Amoaba, Kelvin","nameType":"Personal","givenName":"Kelvin","familyName":"Amoaba","affiliation":[],"nameIdentifiers":[]},{"name":"Mu, Xianling","nameType":"Personal","givenName":"Xianling","familyName":"Mu","affiliation":[],"nameIdentifiers":[]},{"name":"Alican, Fuat","nameType":"Personal","givenName":"Fuat","familyName":"Alican","affiliation":[],"nameIdentifiers":[]},{"name":"Ihlamur, Yigit","nameType":"Personal","givenName":"Yigit","familyName":"Ihlamur","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"VCBench: Benchmarking LLMs in Venture Capital"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2025-09-17T21:56:48Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T00:09:27Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-05T09:02:56Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-06T00:33:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Benchmarks such as SWE-bench and ARC-AGI demonstrate how shared datasets accelerate progress toward artificial general intelligence (AGI). We introduce VCBench, the first benchmark for predicting founder success in venture capital (VC), a domain where signals are sparse, outcomes are uncertain, and even top investors perform modestly. At inception, the market index achieves a precision of 1.9%. Y Combinator outperforms the index by a factor of 1.7x, while tier-1 firms are 2.9x better. VCBench provides 9,000 anonymized founder profiles, standardized to preserve predictive features while resisting identity leakage, with adversarial tests showing more than 90% reduction in re-identification risk. We evaluate nine state-of-the-art large language models (LLMs). DeepSeek-V3 delivers over six times the baseline precision, GPT-4o achieves the highest F0.5, and most models surpass human benchmarks. Designed as a public and evolving resource available at vcbench.com, VCBench establishes a community-driven standard for reproducible and privacy-preserving evaluation of AGI in early-stage venture forecasting.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.14448","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:32:22.000Z","registered":"2025-09-19T01:32:22.000Z","published":"2025","updated":"2026-05-06T02:14:31.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.14448","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}