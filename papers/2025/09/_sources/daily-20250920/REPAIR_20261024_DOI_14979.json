{"data":{"id":"10.48550/arxiv.2509.14979","type":"dois","attributes":{"doi":"10.48550/arxiv.2509.14979","prefix":"10.48550","suffix":"arxiv.2509.14979","identifiers":[{"identifier":"2509.14979","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2509.14979"}],"creators":[{"name":"Shi, Kainan","nameType":"Personal","givenName":"Kainan","familyName":"Shi","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Peilin","nameType":"Personal","givenName":"Peilin","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Ge","nameType":"Personal","givenName":"Ge","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Ding, Han","nameType":"Personal","givenName":"Han","familyName":"Ding","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Fei","nameType":"Personal","givenName":"Fei","familyName":"Wang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"What Matters in LLM-Based Feature Extractor for Recommender? A Systematic Analysis of Prompts, Models, and Adaptation"}],"publisher":"arXiv","container":{},"publicationYear":2025,"subjects":[{"lang":"en","subject":"Information Retrieval (cs.IR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"H.3.3; I.2.6; I.2.7","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2025-09-18T14:08:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2025-09-19T00:42:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2025-09-19T04:12:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2025-09-22T00:21:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-01-28T16:31:15Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-01-29T01:57:19Z","dateType":"Updated","dateInformation":"v3"},{"date":"2025-09","dateType":"Available","dateInformation":"v1"},{"date":"2025","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Using Large Language Models (LLMs) to generate semantic features has been demonstrated as a powerful paradigm for enhancing Sequential Recommender Systems (SRS). This typically involves three stages: processing item text, extracting features with LLMs, and adapting them for downstream models. However, existing methods vary widely in prompting, architecture, and adaptation strategies, making it difficult to fairly compare design choices and identify what truly drives performance. In this work, we propose RecXplore, a modular analytical framework that decomposes the LLM-as-feature-extractor pipeline into four modules: data processing, semantic feature extraction, feature adaptation, and sequential modeling. Instead of proposing new techniques, RecXplore revisits and organizes established methods, enabling systematic exploration of each module in isolation. Experiments on four public datasets show that simply combining the best designs from existing techniques without exhaustive search yields up to 18.7% relative improvement in NDCG@5 and 12.7% in HR@5 over strong baselines. These results underscore the utility of modular benchmarking for identifying effective design patterns and promoting standardized research in LLM-enhanced recommendation.","descriptionType":"Abstract"},{"description":"9 pages. Keywords: Recommender Systems, Large Language Models, Sequential Recommendation, Feature Extraction","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2509.14979","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2025-09-19T01:44:56.000Z","registered":"2025-09-19T01:44:56.000Z","published":"2025","updated":"2026-01-29T03:12:22.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2509.14979","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}