<td id="S5.T2.2.5.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.2.5.2.1" class="ltx_text" style="font-size:90%;">47.6</span></td>
<td id="S5.T2.2.5.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T2.2.5.3.1" class="ltx_text" style="font-size:90%;">83.9</span></td>
