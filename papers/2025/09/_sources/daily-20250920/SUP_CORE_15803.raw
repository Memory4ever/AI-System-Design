<th id="S4.T1.6.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.6.1.1.2.1" class="ltx_text ltx_font_bold">Method</span></th>
