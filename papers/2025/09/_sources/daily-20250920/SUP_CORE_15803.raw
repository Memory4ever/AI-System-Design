<figure id="S4.F5" class="ltx_figure"><object type="image/svg+xml" data="2509.15803v1/human_evaluation2.svg" id="S4.F5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:229/58;" width="229" height="58"></object>
