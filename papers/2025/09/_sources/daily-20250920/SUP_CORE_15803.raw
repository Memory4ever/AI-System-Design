<th id="S4.T1.6.1.17.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.6.1.17.1.1" class="ltx_text ltx_font_bold">CIDER (Full)</span></th>
<td id="S4.T1.6.1.17.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S4.T1.m45" class="ltx_Math" alttext="\textbf{48.91}_{{\color[rgb]{0.18,0.51,0.21}(+63.4\%)}}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_bold">48.91</mtext><mrow><mo style="--ltx-fg-color:#2E8236;" mathcolor="#2E8236" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#2E8236;" mathcolor="#2E8236">+</mo><mrow><mn style="--ltx-fg-color:#2E8236;" mathcolor="#2E8236">63.4</mn><mo>%</mo></mrow></mrow><mo style="--ltx-fg-color:#2E8236;" mathcolor="#2E8236" stretchy="false">)</mo></mrow></msub><annotation encoding="application/x-tex">\textbf{48.91}_{{\color[rgb]{0.18,0.51,0.21}(+63.4\%)}}</annotation></semantics></math></td>
