<td id="S4.T1.6.1.1.4" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.6.1.1.4.1" class="ltx_text ltx_font_bold">Aesthetics</span></td>
<td id="S4.T1.6.1.1.5" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.6.1.1.5.1" class="ltx_text ltx_font_bold">PickScore</span></td>
