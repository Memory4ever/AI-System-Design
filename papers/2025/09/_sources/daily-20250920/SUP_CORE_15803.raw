<span id="S4.T1.6.1.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:8.8pt;height:46.5pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:46.5pt;transform:translate(-18.9pt,-18.9pt) rotate(-90deg) ;">
<span id="S4.T1.6.1.2.1.1.1.1" class="ltx_p"><span id="S4.T1.6.1.2.1.1.1.1.1" class="ltx_text ltx_font_bold">Imagen 4</span></span>
</span></span></span></th>
<th id="S4.T1.6.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">Baseline</th>
<td id="S4.T1.6.1.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">29.70</td>
<td id="S4.T1.6.1.2.4" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.6.1.2.4.1" class="ltx_text ltx_font_bold">6.30</span></td>
<td id="S4.T1.6.1.2.5" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.6.1.2.5.1" class="ltx_text ltx_font_bold">22.95</span></td>
<td id="S4.T1.6.1.2.6" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.6.1.2.6.1" class="ltx_text ltx_font_bold">29.28</span></td></tr>
<tr id="S4.T1.6.1.3" class="ltx_tr">
