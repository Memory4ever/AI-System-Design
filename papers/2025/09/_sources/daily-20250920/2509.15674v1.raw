<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex14.m2" class="ltx_Math" alttext="\displaystyle=\epsilon\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}(\beta_{t}-\phi_{t})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∉</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\epsilon\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}(\beta_{t}-\phi_{t}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex15.m1" class="ltx_Math" alttext="\displaystyle\Rightarrow\mathbb{E}_{\zeta}\left[l_{t}(\vec{\theta})\right]-\mathbb{E}_{\zeta}\left[\tilde{l}_{t}(\vec{\theta})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⇒</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Rightarrow\mathbb{E}_{\zeta}\left[l_{t}(\vec{\theta})\right]-\mathbb{E}_{\zeta}\left[\tilde{l}_{t}(\vec{\theta})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex15.m2" class="ltx_Math" alttext="\displaystyle=\epsilon\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}(\beta_{t}-\phi_{t})\leq\epsilon." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∉</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\epsilon\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}(\beta_{t}-\phi_{t})\leq\epsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx3.p1.4" class="ltx_p"><span id="A1.SS0.SSSx3.p1.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">In the last step, we used Lemma.</span><a href="#Thmlemma1" title="Lemma 1. ‣ Regret analysis ‣ 4 The H2T2 Policy ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">1</span></a><span id="A1.SS0.SSSx3.p1.4.2" class="ltx_text" style="--ltx-fg-color:#000000;">. Since this holds for any </span><math id="A1.SS0.SSSx3.p1.m4" class="ltx_Math" alttext="\vec{\theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{\theta}</annotation></semantics></math><span id="A1.SS0.SSSx3.p1.4.3" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A1.SS0.SSSx3.p1.m5" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math><span id="A1.SS0.SSSx3.p1.4.4" class="ltx_text" style="--ltx-fg-color:#000000;">, we have for any policy and time horizon </span><math id="A1.SS0.SSSx3.p1.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></p>
<table id="A1.EGx23" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex16.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[L_{T}\right]-\mathbb{E}\left[\tilde{L}_{T}\right]\leq\epsilon\beta_{t}T\leq\epsilon\beta T\leq\epsilon T." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[L_{T}\right]-\mathbb{E}\left[\tilde{L}_{T}\right]\leq\epsilon\beta_{t}T\leq\epsilon\beta T\leq\epsilon T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">∎</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS0.SSSx4" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Proof of Theorem <a href="#Thmtheorem2" title="Theorem 2. ‣ Regret analysis ‣ 4 The H2T2 Policy ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> on page <a href="#Thmtheorem2" title="Theorem 2. ‣ Regret analysis ‣ 4 The H2T2 Policy ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>:</h4>

<div id="A1.SS0.SSSx4.p1" class="ltx_para">
<p id="A1.SS0.SSSx4.p1.1" class="ltx_p"><span id="A1.SS0.SSSx4.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Recall </span><math id="A1.SS0.SSSx4.p1.m1" class="ltx_Math" alttext="\tilde{L}_{T}(\vec{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tilde{L}_{T}(\vec{\theta})</annotation></semantics></math><span id="A1.SS0.SSSx4.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">: the cumulative estimated loss with a fixed </span><math id="A1.SS0.SSSx4.p1.m2" class="ltx_Math" alttext="\vec{\theta}" display="inline" intent=":literal"><semantics><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><annotation encoding="application/x-tex">\vec{\theta}</annotation></semantics></math><span id="A1.SS0.SSSx4.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">. Consider </span><math id="A1.SS0.SSSx4.p1.m3" class="ltx_Math" alttext="\ln\tfrac{W_{T+1}}{W_{1}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo lspace="0.167em">⁡</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mfrac></mrow><annotation encoding="application/x-tex">\ln\tfrac{W_{T+1}}{W_{1}}</annotation></semantics></math><span id="A1.SS0.SSSx4.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></p>
<table id="A1.EGx24" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex17.m1" class="ltx_Math" alttext="\displaystyle\ln\tfrac{W_{T+1}}{W_{1}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo lspace="0.167em">⁡</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle\ln\tfrac{W_{T+1}}{W_{1}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex17.m2" class="ltx_math_unparsed" alttext="\displaystyle=\ln\sum_{\vec{\theta}\in\Theta}e^{-\eta\sum_{t=1}^{T}\tilde{l}_{t}(\vec{\theta})}-\ln(|\Theta|)," display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mstyle displaystyle="true"><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder></mstyle><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mstyle scriptlevel="-1"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo></mstyle><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msup><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><msub><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" fence="false" mathcolor="#000000" rspace="0.167em" stretchy="false">|</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\ln\sum_{\vec{\theta}\in\Theta}e^{-\eta\sum_{t=1}^{T}\tilde{l}_{t}(\vec{\theta})}-\ln(|\Theta|),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E16"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E16.m1" class="ltx_Math" alttext="\displaystyle\geq-\min_{\vec{\theta}\in\Theta}\eta\tilde{L}_{T}(\vec{\theta})-\ln(|\Theta|)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">−</mo><mrow><mrow><munder><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq-\min_{\vec{\theta}\in\Theta}\eta\tilde{L}_{T}(\vec{\theta})-\ln(|\Theta|).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(16)</span></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx4.p1.2" class="ltx_p"><span id="A1.SS0.SSSx4.p1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Using Lemma </span><a href="#Thmlemma1" title="Lemma 1. ‣ Regret analysis ‣ 4 The H2T2 Policy ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">1</span></a><span id="A1.SS0.SSSx4.p1.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> and Jensen’s inequality on expectations:</span></p>
<table id="A1.EGx25" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex18"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex18.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\zeta}\left[\ln\tfrac{W_{T+1}}{W_{1}}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo lspace="0.167em">⁡</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\zeta}\left[\ln\tfrac{W_{T+1}}{W_{1}}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex18.m2" class="ltx_Math" alttext="\displaystyle\geq-\min_{\vec{\theta}\in\Theta}\eta\mathbb{E}_{\zeta}\left[\tilde{L}_{T}(\vec{\theta})\right]-\ln(|\Theta|)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">−</mo><mrow><mrow><munder><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\geq-\min_{\vec{\theta}\in\Theta}\eta\mathbb{E}_{\zeta}\left[\tilde{L}_{T}(\vec{\theta})\right]-\ln(|\Theta|)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E17"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E17.m1" class="ltx_Math" alttext="\displaystyle=-\min_{\vec{\theta}\in\Theta}\eta L_{T}(\vec{\theta})-\ln(|\Theta|)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">−</mo><mrow><mrow><munder><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=-\min_{\vec{\theta}\in\Theta}\eta L_{T}(\vec{\theta})-\ln(|\Theta|).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(17)</span></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx4.p1.3" class="ltx_p"><span id="A1.SS0.SSSx4.p1.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Next, we upper bound </span><math id="A1.SS0.SSSx4.p1.m4" class="ltx_Math" alttext="\log\tfrac{W_{T+1}}{W_{1}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo lspace="0.167em">⁡</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mfrac></mrow><annotation encoding="application/x-tex">\log\tfrac{W_{T+1}}{W_{1}}</annotation></semantics></math><span id="A1.SS0.SSSx4.p1.3.2" class="ltx_text" style="--ltx-fg-color:#000000;"> as follows:</span></p>
<table id="A1.EGx26" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex19.m1" class="ltx_Math" alttext="\displaystyle\ln" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><annotation encoding="application/x-tex">\displaystyle\ln</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex19.m2" class="ltx_math_unparsed" alttext="\displaystyle\tfrac{W_{t+1}}{W_{t}}=\ln\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}e^{-\eta\tilde{\ell}_{t}(\vec{\theta})}" display="inline" intent=":literal"><semantics><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mstyle displaystyle="true"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></msub><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><msup><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\tfrac{W_{t+1}}{W_{t}}=\ln\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}e^{-\eta\tilde{\ell}_{t}(\vec{\theta})}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
