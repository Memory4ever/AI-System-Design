<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E20.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\left(-\eta\tilde{\ell}_{t}(\vec{\theta})+{\eta^{2}\tilde{\ell}_{t}(\vec{\theta})}/{2\epsilon}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mstyle displaystyle="true"><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder></mstyle><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mrow><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\left(-\eta\tilde{\ell}_{t}(\vec{\theta})+{\eta^{2}\tilde{\ell}_{t}(\vec{\theta})}/{2\epsilon}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS0.SSSx4.p2" class="ltx_para ltx_noindent">
<p id="A1.SS0.SSSx4.p2.1" class="ltx_p"><span id="A1.SS0.SSSx4.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Above, we have used </span><math id="A1.SS0.SSSx4.p2.m1" class="ltx_Math" alttext="e^{-x}\leq 1-x+\tfrac{x^{2}}{2}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">e^{-x}\leq 1-x+\tfrac{x^{2}}{2}</annotation></semantics></math><span id="A1.SS0.SSSx4.p2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, </span><math id="A1.SS0.SSSx4.p2.m2" class="ltx_Math" alttext="\ln(1+x)\leq x" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi></mrow><annotation encoding="application/x-tex">\ln(1+x)\leq x</annotation></semantics></math><span id="A1.SS0.SSSx4.p2.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, and </span><math id="A1.SS0.SSSx4.p2.m3" class="ltx_Math" alttext="\tilde{\ell}_{t}(\vec{\theta})\leq\tfrac{1}{\epsilon}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mfrac></mrow><annotation encoding="application/x-tex">\tilde{\ell}_{t}(\vec{\theta})\leq\tfrac{1}{\epsilon}</annotation></semantics></math><span id="A1.SS0.SSSx4.p2.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> in (</span><a href="#A1.E18" title="In Proof of Theorem on page : ‣ Appendix A Proofs ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">18</span></a><span id="A1.SS0.SSSx4.p2.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">), (</span><a href="#A1.E19" title="In Proof of Theorem on page : ‣ Appendix A Proofs ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">19</span></a><span id="A1.SS0.SSSx4.p2.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">), and (</span><a href="#A1.E20" title="In Proof of Theorem on page : ‣ Appendix A Proofs ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">20</span></a><span id="A1.SS0.SSSx4.p2.1.7" class="ltx_text" style="--ltx-fg-color:#000000;">), respectively.
Now we sum (</span><a href="#A1.E20" title="In Proof of Theorem on page : ‣ Appendix A Proofs ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">20</span></a><span id="A1.SS0.SSSx4.p2.1.8" class="ltx_text" style="--ltx-fg-color:#000000;">) telescopically over the entire horizon </span><math id="A1.SS0.SSSx4.p2.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math><span id="A1.SS0.SSSx4.p2.1.9" class="ltx_text" style="--ltx-fg-color:#000000;"> as follows:</span></p>
<table id="A1.EGx28" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E21.m1" class="ltx_Math" alttext="\displaystyle\ln" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><annotation encoding="application/x-tex">\displaystyle\ln</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E21.m2" class="ltx_math_unparsed" alttext="\displaystyle\tfrac{W_{T+1}}{W_{1}}=\ln\prod_{t=1}^{T}\tfrac{W_{t+1}}{W_{t}}=\sum_{t=1}^{T}\ln\tfrac{W_{t+1}}{W_{t}}," display="inline" intent=":literal"><semantics><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mstyle displaystyle="true"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∏</mo></mstyle><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msup><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mstyle displaystyle="true"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msup><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tfrac{W_{T+1}}{W_{1}}=\ln\prod_{t=1}^{T}\tfrac{W_{t+1}}{W_{t}}=\sum_{t=1}^{T}\ln\tfrac{W_{t+1}}{W_{t}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
<tbody id="A1.E22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E22.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{t=1}^{T}\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\left(-\eta\tilde{\ell}_{t}(\vec{\theta})+\tfrac{\eta^{2}\tilde{\ell}_{t}(\vec{\theta})}{2\epsilon}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder></mstyle><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mrow></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{t=1}^{T}\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\left(-\eta\tilde{\ell}_{t}(\vec{\theta})+\tfrac{\eta^{2}\tilde{\ell}_{t}(\vec{\theta})}{2\epsilon}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
<tbody id="A1.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex21.m1" class="ltx_math_unparsed" alttext="\displaystyle\Rightarrow\mathbb{E}\Big[\ln" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⇒</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">[</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Rightarrow\mathbb{E}\Big[\ln</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex21.m2" class="ltx_math_unparsed" alttext="\displaystyle\tfrac{W_{T+1}}{W_{1}}\Big]\leq-\eta\sum_{t=1}^{T}\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\bar{\theta)}}{W_{t}}\mathbb{E}_{\zeta}[\tilde{l}_{t}(\vec{\theta})]" display="inline" intent=":literal"><semantics><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.600em" minsize="1.600em">]</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0em">≤</mo><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><mstyle displaystyle="true"><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder></mstyle><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mrow><mo style="--ltx-fg-color:#000000;" fence="true" lspace="0em" mathcolor="#000000" rspace="0em">OPEN</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">¯</mo></mover><mo style="--ltx-fg-color:#000000;" fence="true" lspace="0em" mathcolor="#000000">CLOSE</mo></mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tfrac{W_{T+1}}{W_{1}}\Big]\leq-\eta\sum_{t=1}^{T}\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\bar{\theta)}}{W_{t}}\mathbb{E}_{\zeta}[\tilde{l}_{t}(\vec{\theta})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex22.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad\qquad+\eta^{2}\sum_{t=1}^{T}\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\tfrac{\mathbb{E}_{\zeta}[\tilde{l}_{t}(\vec{\theta})]}{2\epsilon}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><msup><mrow></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mstyle displaystyle="true"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msup><mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mstyle displaystyle="true"><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></msub><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad\qquad+\eta^{2}\sum_{t=1}^{T}\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\tfrac{\mathbb{E}_{\zeta}[\tilde{l}_{t}(\vec{\theta})]}{2\epsilon}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E23.m1" class="ltx_Math" alttext="\displaystyle\leq-\eta\mathbb{E}[\tilde{L}_{T}(\vec{\theta})]+\tfrac{\eta^{2}}{2\epsilon}T" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\eta\mathbb{E}[\tilde{L}_{T}(\vec{\theta})]+\tfrac{\eta^{2}}{2\epsilon}T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
<tbody id="A1.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E24.m1" class="ltx_Math" alttext="\displaystyle\leq-\eta\mathbb{E}[L_{T}(\vec{\theta})]+\eta\epsilon\beta T+\tfrac{\eta^{2}}{2\epsilon}T." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq-\eta\mathbb{E}[L_{T}(\vec{\theta})]+\eta\epsilon\beta T+\tfrac{\eta^{2}}{2\epsilon}T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx4.p2.2" class="ltx_p"><span id="A1.SS0.SSSx4.p2.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">In (</span><a href="#A1.E23" title="In Proof of Theorem on page : ‣ Appendix A Proofs ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">23</span></a><span id="A1.SS0.SSSx4.p2.2.2" class="ltx_text" style="--ltx-fg-color:#000000;">), we use </span><math id="A1.SS0.SSSx4.p2.m5" class="ltx_Math" alttext="\mathbb{E}_{\zeta}[\tilde{l}_{t}(\vec{\theta})]\!=\!l_{t}(\vec{\theta})\!\leq\!1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000">≤</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\zeta}[\tilde{l}_{t}(\vec{\theta})]\!=\!l_{t}(\vec{\theta})\!\leq\!1</annotation></semantics></math><span id="A1.SS0.SSSx4.p2.2.3" class="ltx_text" style="--ltx-fg-color:#000000;"> and the expectation is taken over expert selection and </span><math id="A1.SS0.SSSx4.p2.m6" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math><span id="A1.SS0.SSSx4.p2.2.4" class="ltx_text" style="--ltx-fg-color:#000000;">. In (</span><a href="#A1.E24" title="In Proof of Theorem on page : ‣ Appendix A Proofs ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">24</span></a><span id="A1.SS0.SSSx4.p2.2.5" class="ltx_text" style="--ltx-fg-color:#000000;">), we use Lemma </span><a href="#Thmlemma1" title="Lemma 1. ‣ Regret analysis ‣ 4 The H2T2 Policy ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">1</span></a><span id="A1.SS0.SSSx4.p2.2.6" class="ltx_text" style="--ltx-fg-color:#000000;">. The result follows by comparing bounds from (</span><a href="#A1.E17" title="In Proof of Theorem on page : ‣ Appendix A Proofs ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">17</span></a><span id="A1.SS0.SSSx4.p2.2.7" class="ltx_text" style="--ltx-fg-color:#000000;">) and (</span><a href="#A1.E24" title="In Proof of Theorem on page : ‣ Appendix A Proofs ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">24</span></a><span id="A1.SS0.SSSx4.p2.2.8" class="ltx_text" style="--ltx-fg-color:#000000;">):</span></p>
<table id="A1.EGx29" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex23.m1" class="ltx_Math" alttext="\displaystyle\eta\mathbb{E}[L_{T}(\vec{\theta})]\!-\!\min_{\vec{\theta}\in\Theta}\eta L_{T}(\vec{\theta})" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.052em" mathcolor="#000000" rspace="0.052em">−</mo><mrow><mrow><munder><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\eta\mathbb{E}[L_{T}(\vec{\theta})]\!-\!\min_{\vec{\theta}\in\Theta}\eta L_{T}(\vec{\theta})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex23.m2" class="ltx_Math" alttext="\displaystyle\leq\eta\epsilon\beta T+\tfrac{\eta^{2}T}{2\epsilon}+\log(|\Theta|)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mrow></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta\epsilon\beta T+\tfrac{\eta^{2}T}{2\epsilon}+\log(|\Theta|).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx4.p2.3" class="ltx_p"><span id="A1.SS0.SSSx4.p2.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Recall (</span><a href="#S2.E5" title="In Threshold-based Policies and Performance Metric ‣ 2 Problem Setting ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">5</span></a><span id="A1.SS0.SSSx4.p2.3.2" class="ltx_text" style="--ltx-fg-color:#000000;">). Taking expectation over arrivals and </span><math id="A1.SS0.SSSx4.p2.m7" class="ltx_Math" alttext="\phi_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">\phi_{t}</annotation></semantics></math><span id="A1.SS0.SSSx4.p2.3.3" class="ltx_text" style="--ltx-fg-color:#000000;">, we get:</span></p>
<table id="A1.EGx30" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex24.m1" class="ltx_Math" alttext="\displaystyle R_{T}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">R</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><annotation encoding="application/x-tex">\displaystyle R_{T}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex24.m2" class="ltx_Math" alttext="\displaystyle\leq\left(\epsilon\beta+\tfrac{\eta}{2\epsilon}\right)T+\tfrac{\log(|\Theta|)}{\eta}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mrow><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mrow></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">log</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi></mfrac></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left(\epsilon\beta+\tfrac{\eta}{2\epsilon}\right)T+\tfrac{\log(|\Theta|)}{\eta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx4.p2.4" class="ltx_p"><span id="A1.SS0.SSSx4.p2.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">Corollary </span><a href="#Thmcorollary1" title="Corollary 1. ‣ Regret analysis ‣ 4 The H2T2 Policy ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">1</span></a><span id="A1.SS0.SSSx4.p2.4.2" class="ltx_text" style="--ltx-fg-color:#000000;"> follows by setting partial derivatives to zero.
While not optimal, choosing </span><math id="A1.SS0.SSSx4.p2.m8" class="ltx_Math" alttext="\eta\!=\!\left(2\ln^{2}(|\Theta|)/T^{2}\right)^{{1}/{3}}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">=</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">|</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\eta\!=\!\left(2\ln^{2}(|\Theta|)/T^{2}\right)^{{1}/{3}}</annotation></semantics></math><span id="A1.SS0.SSSx4.p2.4.3" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A1.SS0.SSSx4.p2.m9" class="ltx_Math" alttext="\epsilon\!=\!\sqrt{\eta/2}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">=</mo><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></mrow></msqrt></mrow><annotation encoding="application/x-tex">\epsilon\!=\!\sqrt{\eta/2}</annotation></semantics></math><span id="A1.SS0.SSSx4.p2.4.4" class="ltx_text" style="--ltx-fg-color:#000000;"> yields regret in the same order: </span><math id="A1.SS0.SSSx4.p2.m10" class="ltx_Math" alttext="O(T^{{2}/{3}})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">O</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">3</mn></mrow></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">O(T^{{2}/{3}})</annotation></semantics></math><span id="A1.SS0.SSSx4.p2.4.5" class="ltx_text" style="--ltx-fg-color:#000000;">. ∎</span></p>
</div>
</section>
<section id="A1.SS0.SSSx5" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Proof of Theorem <a href="#Thmtheorem3" title="Theorem 3. ‣ 6 Discussion: Multiclass Classification ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> on page <a href="#Thmtheorem3" title="Theorem 3. ‣ 6 Discussion: Multiclass Classification ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>:</h4>

<div id="A1.SS0.SSSx5.p1" class="ltx_para ltx_noindent">
<p id="A1.SS0.SSSx5.p1.1" class="ltx_p"><span id="A1.SS0.SSSx5.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Let random variables </span><math id="A1.SS0.SSSx5.p1.m1" class="ltx_Math" alttext="X,Y" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Y</mi></mrow><annotation encoding="application/x-tex">X,Y</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="A1.SS0.SSSx5.p1.m2" class="ltx_math_unparsed" alttext="\text{1}_{.}" display="inline" intent=":literal"><semantics><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><msub><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">.</mo></msub></mrow><annotation encoding="application/x-tex">\text{1}_{.}</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> denote </span><math id="A1.SS0.SSSx5.p1.m3" class="ltx_Math" alttext="x_{t},h_{r}(x_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{t},h_{r}(x_{t})</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> and the indicator function.</span></p>
<table id="A1.EGx31" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex25.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\phi_{t}]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\phi_{t}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex25.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{X}\sum_{j=1}^{K}\text{1}_{h_{l}(X)=j}\sum_{i=1}^{K}\mathbb{P}(Y=i\mid X)C_{ij}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover></mstyle><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover></mstyle><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></mrow><mo style="--ltx-fg-color:#000000;" fence="true" lspace="0em" mathcolor="#000000" rspace="0em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub></mrow></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{X}\sum_{j=1}^{K}\text{1}_{h_{l}(X)=j}\sum_{i=1}^{K}\mathbb{P}(Y=i\mid X)C_{ij},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex26.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{X}\sum_{j=1}^{K}\text{1}_{h_{l}(X)=j}f^{T}C_{j}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></munderover></mstyle><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{X}\sum_{j=1}^{K}\text{1}_{h_{l}(X)=j}f^{T}C_{j}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx5.p1.2" class="ltx_p"><span id="A1.SS0.SSSx5.p1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">It follows that </span><math id="A1.SS0.SSSx5.p1.m4" class="ltx_Math" alttext="h_{l}^{*}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h_{l}^{*}(X)</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> activates the </span><math id="A1.SS0.SSSx5.p1.m5" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.2.3" class="ltx_text" style="--ltx-fg-color:#000000;"> that minimizes </span><math id="A1.SS0.SSSx5.p1.m6" class="ltx_Math" alttext="f^{T}C_{j}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub></mrow><annotation encoding="application/x-tex">f^{T}C_{j}</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.2.4" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></p>
<table id="A1.EGx32" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex27.m1" class="ltx_Math" alttext="\displaystyle h_{l}^{*}(X)=\arg\min_{j}f^{T}C_{j}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">arg</mi><mo lspace="0.167em">⁡</mo><munder><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle h_{l}^{*}(X)=\arg\min_{j}f^{T}C_{j},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx5.p1.3" class="ltx_p"><span id="A1.SS0.SSSx5.p1.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">with </span><math id="A1.SS0.SSSx5.p1.m7" class="ltx_Math" alttext="\mathbb{E}[\phi_{t}]\!=\!\min_{j}f^{T}C_{j}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">=</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub><mo lspace="0.167em">⁡</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\phi_{t}]\!=\!\min_{j}f^{T}C_{j}</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.3.2" class="ltx_text" style="--ltx-fg-color:#000000;">. Now, let </span><math id="A1.SS0.SSSx5.p1.m8" class="ltx_Math" alttext="\mathbb{I}_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝕀</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">\mathbb{I}_{t}</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.3.3" class="ltx_text" style="--ltx-fg-color:#000000;"> denote the decision to offload </span><math id="A1.SS0.SSSx5.p1.m9" class="ltx_Math" alttext="x_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">x_{t}</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.3.4" class="ltx_text" style="--ltx-fg-color:#000000;">.
We have, </span><math id="A1.SS0.SSSx5.p1.m10" class="ltx_Math" alttext="l_{t}\!=\!\beta_{t}\mathbb{I}_{t}\!+\!\phi_{t}(1-\mathbb{I}_{t})." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">=</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝕀</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.052em">+</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝕀</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">l_{t}\!=\!\beta_{t}\mathbb{I}_{t}\!+\!\phi_{t}(1-\mathbb{I}_{t}).</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.3.5" class="ltx_text" style="--ltx-fg-color:#000000;"> Thus, it is optimal to offload if </span><math id="A1.SS0.SSSx5.p1.m11" class="ltx_Math" alttext="\beta_{t}\!&lt;\!\mathbb{E}[\phi_{t}]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">&lt;</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}\!&lt;\!\mathbb{E}[\phi_{t}]</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.3.6" class="ltx_text" style="--ltx-fg-color:#000000;">.
That is, for calibrated LDL with optimal predictor, it is optimal offload when </span><math id="A1.SS0.SSSx5.p1.m12" class="ltx_Math" alttext="\beta_{t}\!&lt;\!\min_{k}\{f^{T}C_{k}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">&lt;</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}\!&lt;\!\min_{k}\{f^{T}C_{k}\}</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.3.7" class="ltx_text" style="--ltx-fg-color:#000000;">,
with </span><math id="A1.SS0.SSSx5.p1.m13" class="ltx_Math" alttext="\mathbb{E}[l_{t}]\!=\!\min\{\beta_{t},\min_{k}f^{T}C_{k}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub><mo lspace="0.167em">⁡</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">C</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">k</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[l_{t}]\!=\!\min\{\beta_{t},\min_{k}f^{T}C_{k}\}</annotation></semantics></math><span id="A1.SS0.SSSx5.p1.3.8" class="ltx_text" style="--ltx-fg-color:#000000;">.
∎</span></p>
</div>
</section>
</section>
