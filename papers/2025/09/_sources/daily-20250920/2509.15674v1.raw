<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E18.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\ln\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\left(1-\eta\tilde{\ell}_{t}(\vec{\theta})+{\left(\eta\tilde{\ell}_{t}(\vec{\theta})\right)^{2}}/{2}\right)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≤</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ln</mi><mstyle displaystyle="true"><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder></mstyle><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msup><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">η</mi><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">/</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">2</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ln\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\left(1-\eta\tilde{\ell}_{t}(\vec{\theta})+{\left(\eta\tilde{\ell}_{t}(\vec{\theta})\right)^{2}}/{2}\right)</annotation></semantics></math></td>
