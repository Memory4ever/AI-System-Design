w><annotation encoding="application/x-tex">p_{t}=\sum_{\theta_{l}&lt;f_{t}}\sum_{\theta_{u}&lt;f_{t}}w_{t}(\vec{\theta}).</annotation></semantics></math><span id="alg1.l5.2" class="ltx_text" style="--ltx-fg-color:#000000;float:right;"><math id="alg1.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Region 3
