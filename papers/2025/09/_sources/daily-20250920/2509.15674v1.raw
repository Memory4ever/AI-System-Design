<li id="A2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A2.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i2.p1.1" class="ltx_p"><span id="A2.I1.i2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Additional numerical results</span></p>
<ol id="A2.I1.i2.I1" class="ltx_enumerate">
<li id="A2.I1.i2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(a)</span> 
<div id="A2.I1.i2.I1.i1.p1" class="ltx_para">
