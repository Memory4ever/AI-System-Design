<annotation encoding="application/x-tex">q_{t}=\sum_{\theta_{l}\leq f_{t}}\sum_{\theta_{u}&gt;f_{t}}w_{t}(\vec{\theta}).</annotation></semantics></math><span id="alg1.l6.2" class="ltx_text" style="--ltx-fg-color:#000000;float:right;"><math id="alg1.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Region 2
