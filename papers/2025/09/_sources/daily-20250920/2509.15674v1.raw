</table>
<p id="A1.SS0.SSSx3.p1.3" class="ltx_p"><span id="A1.SS0.SSSx3.p1.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Using </span><math id="A1.SS0.SSSx3.p1.m3" class="ltx_Math" alttext="l_{t}(\vec{\theta})\!=\!\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\phi_{t}+\left(1-\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\right)\beta_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">=</mo><mrow><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∉</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∉</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">l_{t}(\vec{\theta})\!=\!\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\phi_{t}+\left(1-\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\right)\beta_{t}</annotation></semantics></math><span id="A1.SS0.SSSx3.p1.3.2" class="ltx_text" style="--ltx-fg-color:#000000;"> from (</span><a href="#S2.E3" title="In Threshold-based Policies and Performance Metric ‣ 2 Problem Setting ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">3</span></a><span id="A1.SS0.SSSx3.p1.3.3" class="ltx_text" style="--ltx-fg-color:#000000;">) and taking expectation on both sides, we get,</span></p>
<table id="A1.EGx22" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
