<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix" style="--ltx-fg-color:#000000;"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Proofs</h2>

<section id="A1.SS0.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Proof of Theorem <a href="#Thmtheorem1" title="Theorem 1. ‣ 3 Optimal Policy Under a Calibrated Model ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> on page <a href="#Thmtheorem1" title="Theorem 1. ‣ 3 Optimal Policy Under a Calibrated Model ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>:</h4>

<div id="A1.SS0.SSSx1.p1" class="ltx_para">
<p id="A1.SS0.SSSx1.p1.1" class="ltx_p"><span id="A1.SS0.SSSx1.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Define optimal predictor as the one minimizing the expected LDL cost. Let </span><math id="A1.SS0.SSSx1.p1.m1" class="ltx_Math" alttext="Y" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Y</mi><annotation encoding="application/x-tex">Y</annotation></semantics></math><span id="A1.SS0.SSSx1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> denote random variable </span><math id="A1.SS0.SSSx1.p1.m2" class="ltx_Math" alttext="h_{r}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h_{r}(X)</annotation></semantics></math><span id="A1.SS0.SSSx1.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">. Recall </span><math id="A1.SS0.SSSx1.p1.m3" class="ltx_Math" alttext="\phi_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">\phi_{t}</annotation></semantics></math><span id="A1.SS0.SSSx1.p1.1.4" class="ltx_text" style="--ltx-fg-color:#000000;"> from (</span><a href="#S2.E1" title="In Loss Function ‣ 2 Problem Setting ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">1</span></a><span id="A1.SS0.SSSx1.p1.1.5" class="ltx_text" style="--ltx-fg-color:#000000;">) and </span><math id="A1.SS0.SSSx1.p1.m4" class="ltx_Math" alttext="f_{t}\!\coloneqq\!f_{1}(x_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" lspace="0.108em" mathcolor="#000000" rspace="0.108em">≔</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{t}\!\coloneqq\!f_{1}(x_{t})</annotation></semantics></math><span id="A1.SS0.SSSx1.p1.1.6" class="ltx_text" style="--ltx-fg-color:#000000;">.</span></p>
<table id="A1.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex3.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}[\phi_{t}]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}[\phi_{t}]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex3.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{X}\big[\delta_{1}\text{1}_{h_{l}(X)=1}\mathbb{P}(Y=0\mid X)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi></msub><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{X}\big[\delta_{1}\text{1}_{h_{l}(X)=1}\mathbb{P}(Y=0\mid X)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex4"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex4.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad+\delta_{-1}\text{1}_{h_{l}(X)=0}\mathbb{P}(Y=1\mid X)\big]," display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Y</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000" rspace="0.167em">∣</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">]</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad+\delta_{-1}\text{1}_{h_{l}(X)=0}\mathbb{P}(Y=1\mid X)\big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex5"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex5.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{X}\big[\delta_{1}\text{1}_{h_{l}(X)=1}(1-f(X))+\delta_{-1}\text{1}_{h_{l}(X)=0}f(X)\big]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{X}\big[\delta_{1}\text{1}_{h_{l}(X)=1}(1-f(X))+\delta_{-1}\text{1}_{h_{l}(X)=0}f(X)\big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx1.p1.2" class="ltx_p"><span id="A1.SS0.SSSx1.p1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">where </span><math id="A1.SS0.SSSx1.p1.m5" class="ltx_math_unparsed" alttext="\text{1}_{.}" display="inline" intent=":literal"><semantics><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><msub><mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">.</mo></msub></mrow><annotation encoding="application/x-tex">\text{1}_{.}</annotation></semantics></math><span id="A1.SS0.SSSx1.p1.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> is the indicator function.
It follows that the optimal predictor of the calibrated LDL denoted by </span><math id="A1.SS0.SSSx1.p1.m6" class="ltx_Math" alttext="h_{l}^{*}(X)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">h_{l}^{*}(X)</annotation></semantics></math><span id="A1.SS0.SSSx1.p1.2.3" class="ltx_text" style="--ltx-fg-color:#000000;"> activates the indicator function that minimizes </span><math id="A1.SS0.SSSx1.p1.m7" class="ltx_Math" alttext="\mathbb{E}[\phi_{t}]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}[\phi_{t}]</annotation></semantics></math><span id="A1.SS0.SSSx1.p1.2.4" class="ltx_text" style="--ltx-fg-color:#000000;">. That is,</span></p>
<table id="A1.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex6"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex6.m1" class="ltx_Math" alttext="\displaystyle h_{l}^{*}(X)=\begin{cases}1,&amp;\text{if }\quad\Rightarrow f(X)\geq\tfrac{\delta_{1}}{\delta_{1}+\delta_{-1}},\\
0,&amp;\text{otherwise},\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">if </mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⇒</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">X</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub></mrow></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">otherwise</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle h_{l}^{*}(X)=\begin{cases}1,&amp;\text{if }\quad\Rightarrow f(X)\geq\tfrac{\delta_{1}}{\delta_{1}+\delta_{-1}},\\
0,&amp;\text{otherwise},\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx1.p1.3" class="ltx_p"><span id="A1.SS0.SSSx1.p1.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">as given in (</span><a href="#S3.E6" title="In Theorem 1. ‣ 3 Optimal Policy Under a Calibrated Model ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">6</span></a><span id="A1.SS0.SSSx1.p1.3.2" class="ltx_text" style="--ltx-fg-color:#000000;">). Thus, with this optimum predictor, we get:</span></p>
<table id="A1.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex7.m1" class="ltx_Math" alttext="\mathbb{E}[\phi_{t}]=\min\{\delta_{1}(1-f_{t}),\delta_{-1}f_{t}\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}[\phi_{t}]=\min\{\delta_{1}(1-f_{t}),\delta_{-1}f_{t}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A1.SS0.SSSx1.p2" class="ltx_para">
<p id="A1.SS0.SSSx1.p2.1" class="ltx_p"><span id="A1.SS0.SSSx1.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Now, let </span><math id="A1.SS0.SSSx1.p2.m1" class="ltx_Math" alttext="\mathbb{I}_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝕀</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">\mathbb{I}_{t}</annotation></semantics></math><span id="A1.SS0.SSSx1.p2.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> denote the indicator random variable denoting the decision to offload sample </span><math id="A1.SS0.SSSx1.p2.m2" class="ltx_Math" alttext="x_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">x</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">x_{t}</annotation></semantics></math><span id="A1.SS0.SSSx1.p2.1.3" class="ltx_text" style="--ltx-fg-color:#000000;">.
Then we have the cost </span><math id="A1.SS0.SSSx1.p2.m3" class="ltx_Math" alttext="l_{t}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><annotation encoding="application/x-tex">l_{t}</annotation></semantics></math><span id="A1.SS0.SSSx1.p2.1.4" class="ltx_text" style="--ltx-fg-color:#000000;">:</span></p>
<table id="A1.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.Ex8.m1" class="ltx_Math" alttext="l_{t}=\beta_{t}\mathbb{I}_{t}+\phi_{t}(1-\mathbb{I}_{t})" display="block" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝕀</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝕀</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">l_{t}=\beta_{t}\mathbb{I}_{t}+\phi_{t}(1-\mathbb{I}_{t})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx1.p2.2" class="ltx_p"><span id="A1.SS0.SSSx1.p2.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">with an the optimum decision is to offload if </span><math id="A1.SS0.SSSx1.p2.m4" class="ltx_Math" alttext="\beta_{t}&lt;\mathbb{E}[\phi_{t}]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\beta_{t}&lt;\mathbb{E}[\phi_{t}]</annotation></semantics></math><span id="A1.SS0.SSSx1.p2.2.2" class="ltx_text" style="--ltx-fg-color:#000000;">.
That is, for calibrated LDL with optimal predictor, the optimum decision is to offload when</span></p>
<table id="A1.EGx18" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="A1.Ex9"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex9.m1" class="ltx_Math" alttext="\displaystyle\beta_{t}&lt;\min\{\delta_{1}(1-f_{t}),\delta_{-1}f_{t}\}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">{</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">}</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\beta_{t}&lt;\min\{\delta_{1}(1-f_{t}),\delta_{-1}f_{t}\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex10"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex10.m1" class="ltx_Math" alttext="\displaystyle\Rightarrow{\theta_{l}^{*}}^{(t)}=\tfrac{\beta_{t}}{\delta_{-1}}&lt;f_{t}&lt;1-\tfrac{\beta_{t}}{\delta_{1}}={\theta_{u}^{*}}^{(t)}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">⇒</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mmultiscripts><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow></msub></mfrac><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">δ</mi><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></msub></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mmultiscripts><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∗</mo><mrow></mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mmultiscripts></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Rightarrow{\theta_{l}^{*}}^{(t)}=\tfrac{\beta_{t}}{\delta_{-1}}&lt;f_{t}&lt;1-\tfrac{\beta_{t}}{\delta_{1}}={\theta_{u}^{*}}^{(t)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx1.p2.3" class="ltx_p"><span id="A1.SS0.SSSx1.p2.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">with an associated expected cost given by (</span><a href="#S3.E8" title="In Theorem 1. ‣ 3 Optimal Policy Under a Calibrated Model ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref" style="--ltx-fg-color:#000000;"><span class="ltx_text ltx_ref_tag">8</span></a><span id="A1.SS0.SSSx1.p2.3.2" class="ltx_text" style="--ltx-fg-color:#000000;">).
∎</span></p>
</div>
</section>
<section id="A1.SS0.SSSx2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Proof of Lemma <a href="#Thmlemma1" title="Lemma 1. ‣ Regret analysis ‣ 4 The H2T2 Policy ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a> on page <a href="#Thmlemma1" title="Lemma 1. ‣ Regret analysis ‣ 4 The H2T2 Policy ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>:</h4>

<div id="A1.SS0.SSSx2.p1" class="ltx_para">
<p id="A1.SS0.SSSx2.p1.1" class="ltx_p"><span id="A1.SS0.SSSx2.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Taking expectation of </span><math id="A1.SS0.SSSx2.p1.m1" class="ltx_Math" alttext="\hat{l}" display="inline" intent=":literal"><semantics><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><annotation encoding="application/x-tex">\hat{l}</annotation></semantics></math><span id="A1.SS0.SSSx2.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> over realizations of </span><math id="A1.SS0.SSSx2.p1.m2" class="ltx_Math" alttext="\zeta" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi><annotation encoding="application/x-tex">\zeta</annotation></semantics></math><span id="A1.SS0.SSSx2.p1.1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> gives</span></p>
<table id="A1.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex11"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex11.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\zeta}[\tilde{l}_{t}(\vec{\theta})]" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\zeta}[\tilde{l}_{t}(\vec{\theta})]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex11.m2" class="ltx_Math" alttext="\displaystyle=\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\cdot\mathbb{P}(\zeta=1)\tfrac{\phi_{t}}{\epsilon}+\text{1}_{\theta_{l}&lt;f_{t}&lt;\theta_{u}}\cdot\beta_{t}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∉</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℙ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϵ</mi></mfrac></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub></mrow></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\cdot\mathbb{P}(\zeta=1)\tfrac{\phi_{t}}{\epsilon}+\text{1}_{\theta_{l}&lt;f_{t}&lt;\theta_{u}}\cdot\beta_{t},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.Ex12"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex12.m1" class="ltx_Math" alttext="\displaystyle=\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\cdot\phi_{t}+\text{1}_{\theta_{l}&lt;f_{t}&lt;\theta_{u}}\cdot\beta_{t}=l_{t}(\vec{\theta})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∉</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">&lt;</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub></mrow></msub><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\cdot\phi_{t}+\text{1}_{\theta_{l}&lt;f_{t}&lt;\theta_{u}}\cdot\beta_{t}=l_{t}(\vec{\theta}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">∎</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A1.SS0.SSSx3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection" style="--ltx-fg-color:#000000;">Proof of Lemma <a href="#Thmlemma2" title="Lemma 2. ‣ Regret analysis ‣ 4 The H2T2 Policy ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> on page <a href="#Thmlemma2" title="Lemma 2. ‣ Regret analysis ‣ 4 The H2T2 Policy ‣ Inference Offloading for Cost-Sensitive Binary Classification at the Edge" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>:</h4>

<div id="A1.SS0.SSSx3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS0.SSSx3.p1.1" class="ltx_p"><span id="A1.SS0.SSSx3.p1.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">We have,</span></p>
<table id="A1.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.E14"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E14.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[L_{T}\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[L_{T}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E14.m2" class="ltx_Math" alttext="\displaystyle=\sum_{t=1}^{T}\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\mathbb{E}_{\zeta_{t}}\left[l_{t}(\vec{\theta})\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder></mstyle><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\mathbb{E}_{\zeta_{t}}\left[l_{t}(\vec{\theta})\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(14)</span></td></tr></tbody>
<tbody id="A1.E15"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.E15.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\tilde{L}_{T}\right]" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\tilde{L}_{T}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E15.m2" class="ltx_Math" alttext="\displaystyle=\sum_{t=1}^{T}\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\mathbb{E}_{\zeta_{t}}\left[\tilde{l}_{t}(\vec{\theta})\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mstyle displaystyle="true"><munderover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munder><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" movablelimits="false">∑</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">Θ</mi></mrow></munder></mstyle><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">W</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝔼</mi><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">[</mo><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">]</mo></mrow></mrow></mrow></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{t=1}^{T}\sum_{\vec{\theta}\in\Theta}\tfrac{w_{t}(\vec{\theta})}{W_{t}}\mathbb{E}_{\zeta_{t}}\left[\tilde{l}_{t}(\vec{\theta})\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(15)</span></td></tr></tbody>
</table>
<p id="A1.SS0.SSSx3.p1.2" class="ltx_p"><span id="A1.SS0.SSSx3.p1.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">If a policy chooses </span><math id="A1.SS0.SSSx3.p1.m1" class="ltx_Math" alttext="\vec{\theta}=(\theta_{l},\theta_{u})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\vec{\theta}=(\theta_{l},\theta_{u})</annotation></semantics></math><span id="A1.SS0.SSSx3.p1.2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> in round </span><math id="A1.SS0.SSSx3.p1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math><span id="A1.SS0.SSSx3.p1.2.3" class="ltx_text" style="--ltx-fg-color:#000000;">, the loss is</span></p>
<table id="A1.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex13"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex13.m1" class="ltx_Math" alttext="\displaystyle l_{t}(\vec{\theta})=" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle l_{t}(\vec{\theta})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex13.m2" class="ltx_Math" alttext="\displaystyle\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\text{1}_{\zeta_{t}=0}\phi_{t}+\left(1-\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\text{1}_{\zeta_{t}=0}\right)\beta_{t}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∉</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ϕ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">−</mo><mrow><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">f</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∉</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">θ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">u</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mtext style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mtext><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ζ</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">0</mn></mrow></msub></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">β</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub></mrow></mrow><mo style="--ltx-fg-color:#000000;" lspace="0em" mathcolor="#000000">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\text{1}_{\zeta_{t}=0}\phi_{t}+\left(1-\text{1}_{f_{t}\notin[\theta_{l},\theta_{u}]}\text{1}_{\zeta_{t}=0}\right)\beta_{t}.</annotation></semantics></math></td>
