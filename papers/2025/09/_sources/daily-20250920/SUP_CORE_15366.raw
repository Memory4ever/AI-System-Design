<td id="Ch5.T1.2.1.4.5" class="ltx_td ltx_align_left"><math id="Ch5.T1.m13" class="ltx_Math" alttext="&lt;2.2\times 10^{-16}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">&lt;</mo><mrow><mn mathsize="0.900em">2.2</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">16</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">&lt;2.2\times 10^{-16}</annotation></semantics></math></td>
