<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex92.m2" class="ltx_Math" alttext="\displaystyle\left(7+50\ln\left(\frac{2}{\delta}\right)\right)\frac{\sqrt{\Delta D_{3}}}{\sqrt{T}}+\frac{8\sigma_{f}+16\lambda\sigma_{g}}{M^{\frac{p-1}{p}}}+\sum_{t=0}^{T-1}\frac{4\left\|\nabla_{x}\tilde{{\mathcal{L}}}_{\lambda}(x_{t},y_{t},z_{t})-\nabla{\mathcal{L}}_{\lambda}^{*}(x_{t})\right\|}{T}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mn>7</mn><mo>+</mo><mrow><mn>50</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msqrt><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mn>3</mn></msub></mrow></msqrt><msqrt><mi>T</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>f</mi></msub></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>g</mi></msub></mrow></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo>,</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mi>T</mi></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(7+50\ln\left(\frac{2}{\delta}\right)\right)\frac{\sqrt{\Delta D_{3}}}{\sqrt{T}}+\frac{8\sigma_{f}+16\lambda\sigma_{g}}{M^{\frac{p-1}{p}}}+\sum_{t=0}^{T-1}\frac{4\left\|\nabla_{x}\tilde{{\mathcal{L}}}_{\lambda}(x_{t},y_{t},z_{t})-\nabla{\mathcal{L}}_{\lambda}^{*}(x_{t})\right\|}{T},</annotation></semantics></math></td>
