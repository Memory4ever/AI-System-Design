<tbody id="A2.Ex93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex93.m1" class="ltx_Math" alttext="\displaystyle\left\|\nabla{\mathcal{L}}_{\lambda}^{*}(x_{0})\right\|\leq\sqrt{2D_{3}({\mathcal{L}}_{\lambda}^{*}(x_{0})-\inf_{x\in{\mathbb{R}}^{d_{x}}}{\mathcal{L}}_{\lambda}^{*}(x))}\leq\sqrt{6\Delta D_{3}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>≤</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0.167em">inf</mo><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mi>x</mi></msub></msup></mrow></munder><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></msqrt><mo>≤</mo><msqrt><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mn>3</mn></msub></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\nabla{\mathcal{L}}_{\lambda}^{*}(x_{0})\right\|\leq\sqrt{2D_{3}({\mathcal{L}}_{\lambda}^{*}(x_{0})-\inf_{x\in{\mathbb{R}}^{d_{x}}}{\mathcal{L}}_{\lambda}^{*}(x))}\leq\sqrt{6\Delta D_{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p4.5" class="ltx_p"><span id="A2.SS2.p4.5.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A2.SS2.p5" class="ltx_para ltx_noindent">
<p id="A2.SS2.p5.1" class="ltx_p">Based on the above lemmas, we can establish the high probability convergence guarantee of N<sup id="A2.SS2.p5.1.1" class="ltx_sup">2</sup>SBA to solve the bilevel optimization problem as follows.</p>
</div>
<section id="A2.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.2.1 </span>Proof of Theorem <a href="#S4.EGx10" title="Theorem 4.2. ‣ 4.2 Convergence Analysis ‣ 4 Stochastic Bilevel Optimization under Heavy-Tailed Noise ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a></h4>

<div id="A2.SS2.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS1.p1.1" class="ltx_p"><span id="A2.SS2.SSS1.p1.1.1" class="ltx_text">According to Lemma <a href="#A2.EGx55" title="Lemma B.7. ‣ B.2 High-Probability Convergence Guarantee ‣ Appendix B Stochastic Bilevel Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a>, we have</span></p>
<table id="A2.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E28.m1" class="ltx_Math" alttext="\begin{split}&amp;\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla{\mathcal{L}}_{\lambda}^{*}(x_{t})\right\|\\
\leq&amp;\left(7+50\ln\left(\frac{2}{\delta}\right)\right)\frac{\sqrt{\Delta D_{3}}}{\sqrt{T}}+\frac{8\sigma_{f}+16\lambda\sigma_{g}}{M^{\frac{p-1}{p}}}+\sum_{t=0}^{T-1}\frac{4\left\|\nabla_{x}\tilde{{\mathcal{L}}}_{\lambda}(x_{t},y_{t},z_{t})-\nabla_{x}{\mathcal{L}}_{\lambda}^{*}(x_{t})\right\|}{T},\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mn>7</mn><mo>+</mo><mrow><mn>50</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msqrt><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mn>3</mn></msub></mrow></msqrt><msqrt><mi>T</mi></msqrt></mfrac></mrow><mo>+</mo><mfrac><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>f</mi></msub></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>g</mi></msub></mrow></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo>,</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mi>T</mi></mfrac></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}&amp;\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla{\mathcal{L}}_{\lambda}^{*}(x_{t})\right\|\\
\leq&amp;\left(7+50\ln\left(\frac{2}{\delta}\right)\right)\frac{\sqrt{\Delta D_{3}}}{\sqrt{T}}+\frac{8\sigma_{f}+16\lambda\sigma_{g}}{M^{\frac{p-1}{p}}}+\sum_{t=0}^{T-1}\frac{4\left\|\nabla_{x}\tilde{{\mathcal{L}}}_{\lambda}(x_{t},y_{t},z_{t})-\nabla_{x}{\mathcal{L}}_{\lambda}^{*}(x_{t})\right\|}{T},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p1.2" class="ltx_p"><span id="A2.SS2.SSS1.p1.2.1" class="ltx_text">with probability <math id="A2.SS2.SSS1.p1.m1" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>.
We note that</span></p>
<table id="A2.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E29.m1" class="ltx_Math" alttext="\begin{split}\left\|\nabla_{x}\tilde{{\mathcal{L}}}_{\lambda}(x_{t},y_{t},z_{t})-\nabla{\mathcal{L}}_{\lambda}^{*}(x_{t})\right\|\leq 2\lambda L_{g}\left\|y_{t}-y_{\lambda}^{*}(x_{t})\right\|+\lambda L_{g}\left\|z_{t}-y^{*}(x_{t})\right\|,\end{split}" display="block" intent=":literal"><semantics><mtable displaystyle="true"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>~</mo></mover><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo>,</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>y</mi><mi>t</mi></msub><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>g</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\left\|\nabla_{x}\tilde{{\mathcal{L}}}_{\lambda}(x_{t},y_{t},z_{t})-\nabla{\mathcal{L}}_{\lambda}^{*}(x_{t})\right\|\leq 2\lambda L_{g}\left\|y_{t}-y_{\lambda}^{*}(x_{t})\right\|+\lambda L_{g}\left\|z_{t}-y^{*}(x_{t})\right\|,\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p1.3" class="ltx_p"><span id="A2.SS2.SSS1.p1.3.1" class="ltx_text">where the inequality is due to Assumption <a href="#S3.Thmasm1" title="Assumption 3.1. ‣ 3.1 Approximate Stationary Points of Bilevel Optimization ‣ 3 Preliminaries ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> and <math id="A2.SS2.SSS1.p1.m2" class="ltx_Math" alttext="\lambda\geq 2L_{f}/\mu" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>f</mi></msub></mrow><mo>/</mo><mi>μ</mi></mrow></mrow><annotation encoding="application/x-tex">\lambda\geq 2L_{f}/\mu</annotation></semantics></math>.
In what follows, we will consider the high probability convergence analysis of the terms <math id="A2.SS2.SSS1.p1.m3" class="ltx_Math" alttext="\left\|z_{t}-y^{*}(x_{t})\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><annotation encoding="application/x-tex">\left\|z_{t}-y^{*}(x_{t})\right\|</annotation></semantics></math> and <math id="A2.SS2.SSS1.p1.m4" class="ltx_Math" alttext="\left\|y_{t}-y_{\lambda}^{*}(x_{t})\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mrow><msub><mi>y</mi><mi>t</mi></msub><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><annotation encoding="application/x-tex">\left\|y_{t}-y_{\lambda}^{*}(x_{t})\right\|</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS2.SSS1.p2" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS1.p2.1" class="ltx_p"><span id="A2.SS2.SSS1.p2.1.1" class="ltx_text">We first consider the term <math id="A2.SS2.SSS1.p2.m1" class="ltx_Math" alttext="\left\|z_{t}-y^{*}(x_{t})\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><annotation encoding="application/x-tex">\left\|z_{t}-y^{*}(x_{t})\right\|</annotation></semantics></math>.
We note that <math id="A2.SS2.SSS1.p2.m2" class="ltx_Math" alttext="\lambda g(x,y)" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\lambda g(x,y)</annotation></semantics></math> is <math id="A2.SS2.SSS1.p2.m3" class="ltx_Math" alttext="\lambda\mu" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><annotation encoding="application/x-tex">\lambda\mu</annotation></semantics></math>-strongly convex in <math id="A2.SS2.SSS1.p2.m4" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>, and we will show that</span></p>
<table id="A2.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E30.m1" class="ltx_Math" alttext="R_{z}\geq\left\|\hat{z}_{t,0}-y^{*}(x_{t})\right\|," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>z</mi></msub><mo>≥</mo><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">R_{z}\geq\left\|\hat{z}_{t,0}-y^{*}(x_{t})\right\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p2.2" class="ltx_p"><span id="A2.SS2.SSS1.p2.2.1" class="ltx_text">holds with high probability for <math id="A2.SS2.SSS1.p2.m5" class="ltx_Math" alttext="t=0,1,\dots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T-1</annotation></semantics></math>.
With these observations, we can invoke Lemma <a href="#A4.Thmlem3" title="Lemma D.3 ( [ , Lemma 3.1] ). ‣ D.2 High-Probability Convergence Analysis ‣ Appendix D Convergence Analysis of Clipped-SGD ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.3</span></a> with <math id="A2.SS2.SSS1.p2.m6" class="ltx_Math" alttext="\hat{f}(x,y)=\lambda g(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x,y)=\lambda g(x,y)</annotation></semantics></math> to establish the convergence guarantee for <math id="A2.SS2.SSS1.p2.m7" class="ltx_Math" alttext="\left\|\hat{z}_{t,K}-z^{*}(x_{t})\right\|" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>z</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><annotation encoding="application/x-tex">\left\|\hat{z}_{t,K}-z^{*}(x_{t})\right\|</annotation></semantics></math>.
We now show that equation (<a href="#A2.E30" title="In Proof. ‣ B.2.1 Proof of Theorem ‣ B.2 High-Probability Convergence Guarantee ‣ Appendix B Stochastic Bilevel Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) holds by induction.
In particular, for each <math id="A2.SS2.SSS1.p2.m8" class="ltx_Math" alttext="t=0,1,\dots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T</annotation></semantics></math>, we consider the following probability event <math id="A2.SS2.SSS1.p2.m9" class="ltx_Math" alttext="E_{t}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>t</mi></msub><annotation encoding="application/x-tex">E_{t}</annotation></semantics></math>:</span></p>
<table id="A2.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E31.m1" class="ltx_Math" alttext="R_{z}^{2}\geq\left\|\hat{z}_{l,0}-y^{*}(x_{l})\right\|^{2}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>z</mi><mn>2</mn></msubsup><mo>≥</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">R_{z}^{2}\geq\left\|\hat{z}_{l,0}-y^{*}(x_{l})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p2.3" class="ltx_p"><span id="A2.SS2.SSS1.p2.3.1" class="ltx_text">holds for all <math id="A2.SS2.SSS1.p2.m10" class="ltx_Math" alttext="l=0,1,\dots,t" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">l=0,1,\dots,t</annotation></semantics></math> simultaneously.
We want to prove <math id="A2.SS2.SSS1.p2.m11" class="ltx_Math" alttext="{\mathbb{P}}(E_{t})\geq 1-t\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(E_{t})\geq 1-t\delta/(4T)</annotation></semantics></math> for all <math id="A2.SS2.SSS1.p2.m12" class="ltx_Math" alttext="t=0,1,\dots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T</annotation></semantics></math>.
The base case of the induction is trivial: For <math id="A2.SS2.SSS1.p2.m13" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>, it holds that <math id="A2.SS2.SSS1.p2.m14" class="ltx_Math" alttext="\left\|\hat{z}_{0,0}-y^{*}(x_{0})\right\|^{2}\leq R_{0}^{2}\leq R_{z}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><msubsup><mi>R</mi><mn>0</mn><mn>2</mn></msubsup><mo>≤</mo><msubsup><mi>R</mi><mi>z</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\left\|\hat{z}_{0,0}-y^{*}(x_{0})\right\|^{2}\leq R_{0}^{2}\leq R_{z}^{2}</annotation></semantics></math> with probability 1 due to the initialziation that <math id="A2.SS2.SSS1.p2.m15" class="ltx_Math" alttext="\hat{z}_{0,0}=\hat{y}_{0,0}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub><mo>=</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\hat{z}_{0,0}=\hat{y}_{0,0}</annotation></semantics></math> and <math id="A2.SS2.SSS1.p2.m16" class="ltx_Math" alttext="R_{0}\geq\left\|\hat{y}_{0,0}-y^{*}(x_{0})\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>0</mn></msub><mo>≥</mo><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">R_{0}\geq\left\|\hat{y}_{0,0}-y^{*}(x_{0})\right\|</annotation></semantics></math>.
Next, assume that for <math id="A2.SS2.SSS1.p2.m17" class="ltx_Math" alttext="t=T^{\prime}-1\leq T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>≤</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=T^{\prime}-1\leq T</annotation></semantics></math>, it holds that <math id="A2.SS2.SSS1.p2.m18" class="ltx_Math" alttext="{\mathbb{P}}(E_{T^{\prime}-1})\geq 1-(T^{\prime}-1)\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(E_{T^{\prime}-1})\geq 1-(T^{\prime}-1)\delta/(4T)</annotation></semantics></math>.
Given this, we now consider the case <math id="A2.SS2.SSS1.p2.m19" class="ltx_Math" alttext="t=T^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msup><mi>T</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">t=T^{\prime}</annotation></semantics></math>:</span></p>
<table id="A2.EGx60" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex94"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex94.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{z}_{T^{\prime},0}-y^{*}(x_{T^{\prime}})\right\|^{2}\leq" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{z}_{T^{\prime},0}-y^{*}(x_{T^{\prime}})\right\|^{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex94.m2" class="ltx_Math" alttext="\displaystyle 2\left\|\hat{z}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+2\left\|y^{*}(x_{T^{\prime}})-y^{*}(x_{T^{\prime}-1})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\left\|\hat{z}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+2\left\|y^{*}(x_{T^{\prime}})-y^{*}(x_{T^{\prime}-1})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex95"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex95.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex95.m2" class="ltx_Math" alttext="\displaystyle 2\left\|\hat{z}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+\frac{2L_{g}^{2}}{\mu^{2}}\left\|x_{T^{\prime}}-x_{T^{\prime}-1}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mi>g</mi><mn>2</mn></msubsup></mrow><msup><mi>μ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo>−</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\left\|\hat{z}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+\frac{2L_{g}^{2}}{\mu^{2}}\left\|x_{T^{\prime}}-x_{T^{\prime}-1}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex96"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex96.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex96.m2" class="ltx_Math" alttext="\displaystyle 2\left\|\hat{z}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+\frac{2L_{g}^{2}\eta_{x}^{2}}{\mu^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mi>g</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup></mrow><msup><mi>μ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\left\|\hat{z}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+\frac{2L_{g}^{2}\eta_{x}^{2}}{\mu^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p2.4" class="ltx_p"><span id="A2.SS2.SSS1.p2.4.1" class="ltx_text">where the first inequality is due to <math id="A2.SS2.SSS1.p2.m20" class="ltx_Math" alttext="\left\|a+b\right\|^{2}\leq 2\left\|a\right\|^{2}+2\left\|b\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mi>a</mi><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mi>b</mi><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|a+b\right\|^{2}\leq 2\left\|a\right\|^{2}+2\left\|b\right\|^{2}</annotation></semantics></math>, the second inequality follows from Lemma <a href="#A2.Thmlem2" title="Lemma B.2 ( [ ] ). ‣ Appendix B Stochastic Bilevel Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>, and the last inequality is due to the update of <math id="A2.SS2.SSS1.p2.m21" class="ltx_Math" alttext="x_{T^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">x_{T^{\prime}}</annotation></semantics></math>.
Based on the induction hypothesis, <math id="A2.SS2.SSS1.p2.m22" class="ltx_Math" alttext="R_{z}^{2}\geq\left\|\hat{z}_{l,0}-y^{*}(x_{l})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>z</mi><mn>2</mn></msubsup><mo>≥</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">R_{z}^{2}\geq\left\|\hat{z}_{l,0}-y^{*}(x_{l})\right\|^{2}</annotation></semantics></math> holds for all <math id="A2.SS2.SSS1.p2.m23" class="ltx_Math" alttext="l=0,1,\dots,T^{\prime}-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l=0,1,\dots,T^{\prime}-1</annotation></semantics></math> with probability <math id="A2.SS2.SSS1.p2.m24" class="ltx_Math" alttext="1-(T^{\prime}-1)\delta/4T" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mn>4</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">1-(T^{\prime}-1)\delta/4T</annotation></semantics></math>.
We can apply Lemma <a href="#A4.Thmlem3" title="Lemma D.3 ( [ , Lemma 3.1] ). ‣ D.2 High-Probability Convergence Analysis ‣ Appendix D Convergence Analysis of Clipped-SGD ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.3</span></a> with <math id="A2.SS2.SSS1.p2.m25" class="ltx_Math" alttext="\hat{f}(x,y)=\lambda g(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x,y)=\lambda g(x,y)</annotation></semantics></math>, <math id="A2.SS2.SSS1.p2.m26" class="ltx_Math" alttext="\hat{R}=R_{z}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>R</mi><mo>^</mo></mover><mo>=</mo><msub><mi>R</mi><mi>z</mi></msub></mrow><annotation encoding="application/x-tex">\hat{R}=R_{z}</annotation></semantics></math> and <math id="A2.SS2.SSS1.p2.m27" class="ltx_Math" alttext="\hat{\delta}=\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo>=</mo><mrow><mi>δ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\delta}=\delta/(4T)</annotation></semantics></math> to obtain the following convergence guarantee:</span></p>
<table id="A2.EGx61" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex97"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex97.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{z}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}\leq" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{z}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex97.m2" class="ltx_Math" alttext="\displaystyle 2R_{z}^{2}\exp\left(-\frac{\mu K}{400L_{g}\ln\left({16TK}/{\delta}\right)}\right)+" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>z</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mrow><mn>400</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>g</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2R_{z}^{2}\exp\left(-\frac{\mu K}{400L_{g}\ln\left({16TK}/{\delta}\right)}\right)+</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex98"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex98.m1" class="ltx_Math" alttext="\displaystyle\frac{2*5400^{\frac{2}{p}}\sigma_{g}^{2}(\ln(B_{z,T^{\prime}-1}))^{2}\left(\ln\left({16TK}/{\delta}\right)\right)^{\frac{2(p-1)}{p}}}{\mu^{2}K^{\frac{2(p-1)}{p}}}\leq\frac{\epsilon^{4}}{\ell^{4}\kappa^{6}}," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">∗</mo><msup><mn>5400</mn><mfrac><mn>2</mn><mi>p</mi></mfrac></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mi>g</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mrow><mi>z</mi><mo>,</mo><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>p</mi></mfrac></msup></mrow><mrow><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>p</mi></mfrac></msup></mrow></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><msup><mi>ϵ</mi><mn>4</mn></msup><mrow><msup><mi mathvariant="normal">ℓ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>6</mn></msup></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2*5400^{\frac{2}{p}}\sigma_{g}^{2}(\ln(B_{z,T^{\prime}-1}))^{2}\left(\ln\left({16TK}/{\delta}\right)\right)^{\frac{2(p-1)}{p}}}{\mu^{2}K^{\frac{2(p-1)}{p}}}\leq\frac{\epsilon^{4}}{\ell^{4}\kappa^{6}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p2.5" class="ltx_p"><span id="A2.SS2.SSS1.p2.5.1" class="ltx_text">with probability <math id="A2.SS2.SSS1.p2.m28" class="ltx_Math" alttext="1-\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\delta/(4T)</annotation></semantics></math>, where the last inequality is due to the parameter choice of <math id="A2.SS2.SSS1.p2.m29" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.
Since <math id="A2.SS2.SSS1.p2.m30" class="ltx_Math" alttext="\eta_{x}=\sqrt{\Delta/D_{3}T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>x</mi></msub><mo>=</mo><msqrt><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><msub><mi>D</mi><mn>3</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">\eta_{x}=\sqrt{\Delta/D_{3}T}</annotation></semantics></math>, we further have</span></p>
<table id="A2.EGx62" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex99.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{z}_{T^{\prime},0}-y^{*}(x_{T^{\prime}})\right\|^{2}\leq\frac{2\epsilon^{4}}{\ell^{4}\kappa^{6}}+\frac{2\epsilon^{2}}{\ell^{2}\kappa^{4}}\leq R_{z}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>4</mn></msup></mrow><mrow><msup><mi mathvariant="normal">ℓ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>6</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mrow><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>4</mn></msup></mrow></mfrac></mstyle></mrow><mo>≤</mo><msubsup><mi>R</mi><mi>z</mi><mn>2</mn></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{z}_{T^{\prime},0}-y^{*}(x_{T^{\prime}})\right\|^{2}\leq\frac{2\epsilon^{4}}{\ell^{4}\kappa^{6}}+\frac{2\epsilon^{2}}{\ell^{2}\kappa^{4}}\leq R_{z}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p2.6" class="ltx_p"><span id="A2.SS2.SSS1.p2.6.1" class="ltx_text">with probability <math id="A2.SS2.SSS1.p2.m31" class="ltx_Math" alttext="1-\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\delta/(4T)</annotation></semantics></math>.
Applying the union bound, then we obtain <math id="A2.SS2.SSS1.p2.m32" class="ltx_Math" alttext="{\mathbb{P}}(E_{T^{\prime}})\geq 1-T^{\prime}\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(E_{T^{\prime}})\geq 1-T^{\prime}\delta/(4T)</annotation></semantics></math>.
The proof of induction (<a href="#A2.E30" title="In Proof. ‣ B.2.1 Proof of Theorem ‣ B.2 High-Probability Convergence Guarantee ‣ Appendix B Stochastic Bilevel Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) is complete.</span></p>
</div>
<div id="A2.SS2.SSS1.p3" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS1.p3.1" class="ltx_p"><span id="A2.SS2.SSS1.p3.1.1" class="ltx_text">Similarly, we can use induction to show that</span></p>
<table id="A2.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E32.m1" class="ltx_Math" alttext="R_{y}\geq\left\|\hat{y}_{t,0}-y_{\lambda}^{*}(x_{t})\right\|," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>y</mi></msub><mo>≥</mo><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">R_{y}\geq\left\|\hat{y}_{t,0}-y_{\lambda}^{*}(x_{t})\right\|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p3.2" class="ltx_p"><span id="A2.SS2.SSS1.p3.2.1" class="ltx_text">holds with high probability for <math id="A2.SS2.SSS1.p3.m1" class="ltx_Math" alttext="t=0,1,\dots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T</annotation></semantics></math>.
Specifically, for each <math id="A2.SS2.SSS1.p3.m2" class="ltx_Math" alttext="t=0,1,\dots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T</annotation></semantics></math>, we consider the following event <math id="A2.SS2.SSS1.p3.m3" class="ltx_Math" alttext="\hat{E}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{E}_{t}</annotation></semantics></math>:</span></p>
<table id="A2.EGx63" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex100.m1" class="ltx_Math" alttext="\displaystyle R_{y}^{2}\geq\left\|\hat{y}_{t,0}-y_{\lambda}^{*}(x_{t})\right\|^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup><mo>≥</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle R_{y}^{2}\geq\left\|\hat{y}_{t,0}-y_{\lambda}^{*}(x_{t})\right\|^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p3.3" class="ltx_p"><span id="A2.SS2.SSS1.p3.3.1" class="ltx_text">holds for all <math id="A2.SS2.SSS1.p3.m4" class="ltx_Math" alttext="l=0,1,\dots,t" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">l=0,1,\dots,t</annotation></semantics></math> simultaneously.
We want to prove that <math id="A2.SS2.SSS1.p3.m5" class="ltx_Math" alttext="{\mathbb{P}}(\hat{E}_{t})\geq 1-t\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>E</mi><mo>^</mo></mover><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(\hat{E}_{t})\geq 1-t\delta/(4T)</annotation></semantics></math> for all <math id="A2.SS2.SSS1.p3.m6" class="ltx_Math" alttext="t=0,1,\dots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T</annotation></semantics></math>.
The base case of the induction is trivial:
For <math id="A2.SS2.SSS1.p3.m7" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>, it holds that</span></p>
<table id="A2.EGx64" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex101.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{y}_{0,0}-y^{*}(x_{0})\right\|^{2}\leq 2\left\|\hat{y}_{0,0}-y^{*}(x_{0})\right\|^{2}+2\left\|y^{*}(x_{0})-y_{\lambda}^{*}(x_{0})\right\|^{2}\leq 2R_{0}^{2}+2R_{0}^{2}=4R_{0}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mn>0</mn><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mn>0</mn><mn>2</mn></msubsup></mrow></mrow><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mn>0</mn><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{y}_{0,0}-y^{*}(x_{0})\right\|^{2}\leq 2\left\|\hat{y}_{0,0}-y^{*}(x_{0})\right\|^{2}+2\left\|y^{*}(x_{0})-y_{\lambda}^{*}(x_{0})\right\|^{2}\leq 2R_{0}^{2}+2R_{0}^{2}=4R_{0}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p3.4" class="ltx_p"><span id="A2.SS2.SSS1.p3.4.1" class="ltx_text">with probability 1 where the first inequality follows from <math id="A2.SS2.SSS1.p3.m8" class="ltx_Math" alttext="\left\|a+b\right\|^{2}\leq 2\left\|a\right\|^{2}+2\left\|b\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mi>a</mi><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mi>b</mi><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|a+b\right\|^{2}\leq 2\left\|a\right\|^{2}+2\left\|b\right\|^{2}</annotation></semantics></math>, and the second inequality is due to Lemma <a href="#S3.Thmlem1" title="Lemma 3.1 ( [ ] ). ‣ 3.1 Approximate Stationary Points of Bilevel Optimization ‣ 3 Preliminaries ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> and the choice of <math id="A2.SS2.SSS1.p3.m9" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>.
Next, assume that for <math id="A2.SS2.SSS1.p3.m10" class="ltx_Math" alttext="t=0,1,\dots,T^{\prime}-1\leq T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>≤</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T^{\prime}-1\leq T</annotation></semantics></math>, it holds that <math id="A2.SS2.SSS1.p3.m11" class="ltx_Math" alttext="{\mathbb{P}}(E_{T^{\prime}-1})\geq 1-(T^{\prime}-1)\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(E_{T^{\prime}-1})\geq 1-(T^{\prime}-1)\delta/(4T)</annotation></semantics></math>.
Given this, we now consider the case <math id="A2.SS2.SSS1.p3.m12" class="ltx_Math" alttext="t=T^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msup><mi>T</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">t=T^{\prime}</annotation></semantics></math>:</span></p>
<table id="A2.EGx65" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex102.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{y}_{T^{\prime},0}-y_{\lambda}^{*}(x_{T^{\prime}})\right\|^{2}\leq" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{y}_{T^{\prime},0}-y_{\lambda}^{*}(x_{T^{\prime}})\right\|^{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex102.m2" class="ltx_Math" alttext="\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y_{\lambda}^{*}(x_{T^{\prime}-1})\right\|^{2}+2\left\|y_{\lambda}^{*}(x_{T^{\prime}-1})-y_{\lambda}^{*}(x_{T^{\prime}})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y_{\lambda}^{*}(x_{T^{\prime}-1})\right\|^{2}+2\left\|y_{\lambda}^{*}(x_{T^{\prime}-1})-y_{\lambda}^{*}(x_{T^{\prime}})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex103.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex103.m2" class="ltx_Math" alttext="\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y_{\lambda}^{*}(x_{T^{\prime}-1})\right\|^{2}+\frac{32L_{g}^{2}}{\mu^{2}}\left\|x_{T^{\prime}-1}-x_{T^{\prime}}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>32</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mi>g</mi><mn>2</mn></msubsup></mrow><msup><mi>μ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y_{\lambda}^{*}(x_{T^{\prime}-1})\right\|^{2}+\frac{32L_{g}^{2}}{\mu^{2}}\left\|x_{T^{\prime}-1}-x_{T^{\prime}}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex104.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex104.m2" class="ltx_Math" alttext="\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y_{\lambda}^{*}(x_{T^{\prime}-1})\right\|^{2}+\frac{32L_{g}^{2}\eta_{x}^{2}}{\mu^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>32</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>L</mi><mi>g</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup></mrow><msup><mi>μ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y_{\lambda}^{*}(x_{T^{\prime}-1})\right\|^{2}+\frac{32L_{g}^{2}\eta_{x}^{2}}{\mu^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p3.5" class="ltx_p"><span id="A2.SS2.SSS1.p3.5.1" class="ltx_text">where the first inequality is due to <math id="A2.SS2.SSS1.p3.m13" class="ltx_Math" alttext="\left\|a+b\right\|^{2}\leq 2\left\|a\right\|^{2}+2\left\|b\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mi>a</mi><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mi>b</mi><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|a+b\right\|^{2}\leq 2\left\|a\right\|^{2}+2\left\|b\right\|^{2}</annotation></semantics></math>, the second inequality follows from Lemma <a href="#A2.Thmlem2" title="Lemma B.2 ( [ ] ). ‣ Appendix B Stochastic Bilevel Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a> and the last inequality os due to the update of <math id="A2.SS2.SSS1.p3.m14" class="ltx_Math" alttext="x_{T^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">x_{T^{\prime}}</annotation></semantics></math>.
Based on the induction hypothesis, we can apply Lemma <a href="#A4.Thmlem3" title="Lemma D.3 ( [ , Lemma 3.1] ). ‣ D.2 High-Probability Convergence Analysis ‣ Appendix D Convergence Analysis of Clipped-SGD ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.3</span></a> with <math id="A2.SS2.SSS1.p3.m15" class="ltx_Math" alttext="\hat{f}(x,y)=f(x,y)+\lambda g(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x,y)=f(x,y)+\lambda g(x,y)</annotation></semantics></math>, <math id="A2.SS2.SSS1.p3.m16" class="ltx_Math" alttext="\hat{R}=R_{y}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>R</mi><mo>^</mo></mover><mo>=</mo><msub><mi>R</mi><mi>y</mi></msub></mrow><annotation encoding="application/x-tex">\hat{R}=R_{y}</annotation></semantics></math> and <math id="A2.SS2.SSS1.p3.m17" class="ltx_Math" alttext="\hat{\delta}=\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo>=</mo><mrow><mi>δ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\delta}=\delta/(4T)</annotation></semantics></math> to obtain the following convergence guarantee:</span></p>
<table id="A2.EGx66" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex105.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{y}_{\tilde{t},K}-y_{\lambda}^{*}(x_{t})\right\|^{2}\leq" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{y}_{\tilde{t},K}-y_{\lambda}^{*}(x_{t})\right\|^{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex105.m2" class="ltx_Math" alttext="\displaystyle 2R_{y}^{2}\exp\left(-\frac{\mu K}{1600L_{g}\ln\left({16TK}/{\delta}\right)}\right)" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mrow><mn>1600</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>L</mi><mi>g</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2R_{y}^{2}\exp\left(-\frac{\mu K}{1600L_{g}\ln\left({16TK}/{\delta}\right)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex106.m1" class="ltx_Math" alttext="\displaystyle+\frac{32*5400^{\frac{2}{p}}(\sigma_{f}+\lambda\sigma_{g})^{2}(\ln(B_{y,\tilde{t}}))^{2}\left(\ln\left({16TK}/{\delta}\right)\right)^{\frac{2(p-1)}{p}}}{\lambda^{2}\mu^{2}K^{\frac{2(p-1)}{p}}}\leq\frac{\epsilon^{4}}{\ell^{4}\kappa^{6}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mn>32</mn><mo lspace="0.222em" rspace="0.222em">∗</mo><msup><mn>5400</mn><mfrac><mn>2</mn><mi>p</mi></mfrac></msup></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>σ</mi><mi>f</mi></msub><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>g</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mrow><mi>y</mi><mo>,</mo><mover accent="true"><mi>t</mi><mo>~</mo></mover></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>p</mi></mfrac></msup></mrow><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>p</mi></mfrac></msup></mrow></mfrac></mstyle></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><msup><mi>ϵ</mi><mn>4</mn></msup><mrow><msup><mi mathvariant="normal">ℓ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>6</mn></msup></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{32*5400^{\frac{2}{p}}(\sigma_{f}+\lambda\sigma_{g})^{2}(\ln(B_{y,\tilde{t}}))^{2}\left(\ln\left({16TK}/{\delta}\right)\right)^{\frac{2(p-1)}{p}}}{\lambda^{2}\mu^{2}K^{\frac{2(p-1)}{p}}}\leq\frac{\epsilon^{4}}{\ell^{4}\kappa^{6}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p3.6" class="ltx_p"><span id="A2.SS2.SSS1.p3.6.1" class="ltx_text">with probability <math id="A2.SS2.SSS1.p3.m18" class="ltx_Math" alttext="1-\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\delta/(4T)</annotation></semantics></math>, where the last inequality is due to the parameter choice of <math id="A2.SS2.SSS1.p3.m19" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.
Since <math id="A2.SS2.SSS1.p3.m20" class="ltx_Math" alttext="\eta_{x}=\sqrt{\Delta/D_{3}T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>x</mi></msub><mo>=</mo><msqrt><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><msub><mi>D</mi><mn>3</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">\eta_{x}=\sqrt{\Delta/D_{3}T}</annotation></semantics></math>, we further have</span></p>
<table id="A2.EGx67" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex107"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex107.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{y}_{T^{\prime},0}-y_{\lambda}^{*}(x_{T^{\prime}})\right\|^{2}\leq\frac{2\epsilon^{4}}{\ell^{4}\kappa^{6}}+\frac{32\epsilon^{2}}{\ell^{2}\kappa^{4}}\leq R_{y}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msubsup><mi>y</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>4</mn></msup></mrow><mrow><msup><mi mathvariant="normal">ℓ</mi><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>6</mn></msup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>32</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mrow><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>4</mn></msup></mrow></mfrac></mstyle></mrow><mo>≤</mo><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{y}_{T^{\prime},0}-y_{\lambda}^{*}(x_{T^{\prime}})\right\|^{2}\leq\frac{2\epsilon^{4}}{\ell^{4}\kappa^{6}}+\frac{32\epsilon^{2}}{\ell^{2}\kappa^{4}}\leq R_{y}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p3.7" class="ltx_p"><span id="A2.SS2.SSS1.p3.7.1" class="ltx_text">with probability <math id="A2.SS2.SSS1.p3.m21" class="ltx_Math" alttext="1-\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\delta/(4T)</annotation></semantics></math>.
Applying the union bound, then we obtain <math id="A2.SS2.SSS1.p3.m22" class="ltx_Math" alttext="{\mathbb{P}}(E_{T^{\prime}})\geq 1-T^{\prime}\delta/(4T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(E_{T^{\prime}})\geq 1-T^{\prime}\delta/(4T)</annotation></semantics></math>.
The proof of induction (<a href="#A2.E32" title="In Proof. ‣ B.2.1 Proof of Theorem ‣ B.2 High-Probability Convergence Guarantee ‣ Appendix B Stochastic Bilevel Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>) is complete.</span></p>
</div>
<div id="A2.SS2.SSS1.p4" class="ltx_para ltx_noindent">
<p id="A2.SS2.SSS1.p4.1" class="ltx_p"><span id="A2.SS2.SSS1.p4.1.1" class="ltx_text">Using the union bound on <math id="A2.SS2.SSS1.p4.m1" class="ltx_Math" alttext="E_{T}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>T</mi></msub><annotation encoding="application/x-tex">E_{T}</annotation></semantics></math>, <math id="A2.SS2.SSS1.p4.m2" class="ltx_Math" alttext="\hat{E}_{T}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>E</mi><mo>^</mo></mover><mi>T</mi></msub><annotation encoding="application/x-tex">\hat{E}_{T}</annotation></semantics></math> and the event of equation (<a href="#A2.E28" title="In Proof. ‣ B.2.1 Proof of Theorem ‣ B.2 High-Probability Convergence Guarantee ‣ Appendix B Stochastic Bilevel Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>) implies that with probability at least <math id="A2.SS2.SSS1.p4.m3" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, it holds that <math id="A2.SS2.SSS1.p4.m4" class="ltx_Math" alttext="\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla{\mathcal{L}}_{\lambda}(x_{t})\right\|\leq\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>≤</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla{\mathcal{L}}_{\lambda}(x_{t})\right\|\leq\epsilon</annotation></semantics></math> with the parameter setting of</span></p>
<table id="A2.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex108.m1" class="ltx_Math" alttext="\displaystyle T=\tilde{\mathcal{O}}(\Delta\ell\kappa^{3}\epsilon^{-2}),~~~M={\mathcal{O}}\left(\frac{\ell^{\frac{p}{p-1}}\sigma^{\frac{p}{p-1}}\kappa^{\frac{3p}{p-1}}}{\epsilon^{\frac{2p}{p-1}}}\right),~~~K=\tilde{\mathcal{O}}\left(\frac{\ell^{\frac{p}{p-1}}\kappa^{\frac{4p}{p-1}}\sigma^{\frac{p}{p-1}}}{\epsilon^{\frac{2p}{p-1}}}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="1.157em">,</mo><mrow><mi>M</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi mathvariant="normal">ℓ</mi><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mrow><msup><mi>ϵ</mi><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo rspace="1.157em">,</mo><mrow><mi>K</mi><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi mathvariant="normal">ℓ</mi><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mrow><msup><mi>ϵ</mi><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle T=\tilde{\mathcal{O}}(\Delta\ell\kappa^{3}\epsilon^{-2}),~~~M={\mathcal{O}}\left(\frac{\ell^{\frac{p}{p-1}}\sigma^{\frac{p}{p-1}}\kappa^{\frac{3p}{p-1}}}{\epsilon^{\frac{2p}{p-1}}}\right),~~~K=\tilde{\mathcal{O}}\left(\frac{\ell^{\frac{p}{p-1}}\kappa^{\frac{4p}{p-1}}\sigma^{\frac{p}{p-1}}}{\epsilon^{\frac{2p}{p-1}}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.SSS1.p4.2" class="ltx_p"><span id="A2.SS2.SSS1.p4.2.1" class="ltx_text">where <math id="A2.SS2.SSS1.p4.m5" class="ltx_Math" alttext="\sigma=\max\{\sigma_{f},\sigma_{g}\}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mi>σ</mi><mi>f</mi></msub><mo>,</mo><msub><mi>σ</mi><mi>g</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma=\max\{\sigma_{f},\sigma_{g}\}</annotation></semantics></math>.
The total SFO complexity is</span></p>
<table id="A2.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex109.m1" class="ltx_Math" alttext="\displaystyle TM+TK=\tilde{\mathcal{O}}\left(\frac{\Delta\ell^{\frac{2p-1}{p-1}}\kappa^{\frac{7p-3}{p-1}}\sigma^{\frac{p}{p-1}}}{\epsilon^{\frac{4p-2}{p-1}}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mfrac><mrow><mrow><mn>7</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>3</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mrow><msup><mi>ϵ</mi><mfrac><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>2</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle TM+TK=\tilde{\mathcal{O}}\left(\frac{\Delta\ell^{\frac{2p-1}{p-1}}\kappa^{\frac{7p-3}{p-1}}\sigma^{\frac{p}{p-1}}}{\epsilon^{\frac{4p-2}{p-1}}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.SSS1.p5" class="ltx_para">
<p id="A2.SS2.SSS1.p5.1" class="ltx_p"><span id="A2.SS2.SSS1.p5.1.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Stochastic Minimax Optimization</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">In this section, we present the proof of in-expectation and high-probability convergence guarantee of the N<sup id="A3.p1.1.1" class="ltx_sup">2</sup>SGDA method for solving the nonconvex-strongly-concave problem.</p>
</div>
<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>In-Expectation Convergence Guarantee</h3>

<div id="A3.SS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.p1.1" class="ltx_p">To provide the in-expectation convergence guarantee of the N<sup id="A3.SS1.p1.1.1" class="ltx_sup">2</sup>SGDA method, we first establish the convergence lemma of the algorithm in one iteration.</p>
</div>
<div id="A3.Thmlem1" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlem1.2" class="ltx_text ltx_font_bold">Lemma C.1</span></span><span id="A3.Thmlem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlem1.p1" class="ltx_para">
<p id="A3.Thmlem1.p1.1" class="ltx_p"><span id="A3.Thmlem1.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#S3.Thmasm2" title="Assumption 3.2. ‣ 3.2 Approximate Stationary Points of Minimax Optimization ‣ 3 Preliminaries ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> and <a href="#S3.Thmasm3" title="Assumption 3.3. ‣ 3.3 Stochastic Gradient Assumption ‣ 3 Preliminaries ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, the iterates <math id="A3.Thmlem1.p1.m1" class="ltx_Math" alttext="\{x_{t}\}_{t\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\{x_{t}\}_{t\geq 1}</annotation></semantics></math> generated by N<sup id="A3.Thmlem1.p1.1.1.1" class="ltx_sup">2</sup>SGDA satisfies the following inequality:</span></p>
<table id="A3.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex110.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{t+1})]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{t+1})]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex110.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{t})]-\eta_{x}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{2\sigma\eta_{x}}{M^{\frac{p-1}{p}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{t})]-\eta_{x}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{2\sigma\eta_{x}}{M^{\frac{p-1}{p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex111.m1" class="ltx_Math" alttext="\displaystyle+\eta_{x}{\mathbb{E}}[\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\eta_{x}{\mathbb{E}}[\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS1.p2.1" class="ltx_p"><span id="A3.SS1.p2.1.1" class="ltx_text">Since <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="\Phi(x)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi(x)</annotation></semantics></math> is <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="(\ell+\kappa\ell)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>+</mo><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\ell+\kappa\ell)</annotation></semantics></math>-smooth according to Proposition <a href="#S3.Thmprop2" title="Proposition 3.2 ( [ , Lemma 4.3] ). ‣ 3.2 Approximate Stationary Points of Minimax Optimization ‣ 3 Preliminaries ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, we have</span></p>
<table id="A3.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E33.m1" class="ltx_Math" alttext="\Phi(x_{t+1})-\Phi(x_{t})-\langle x_{t+1}-x_{t},\nabla\Phi(x_{t})\rangle\leq(\kappa+1)\ell\left\|x_{t+1}-x_{t}\right\|^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Phi(x_{t+1})-\Phi(x_{t})-\langle x_{t+1}-x_{t},\nabla\Phi(x_{t})\rangle\leq(\kappa+1)\ell\left\|x_{t+1}-x_{t}\right\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="A3.SS1.p2.2" class="ltx_p"><span id="A3.SS1.p2.2.1" class="ltx_text">Plugging <math id="A3.SS1.p2.m3" class="ltx_Math" alttext="x_{t+1}-x_{t}=-\eta_{x}\frac{g_{x,t}}{\left\|g_{x,t}\right\|}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>x</mi><mi>t</mi></msub></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mfrac><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mo>‖</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>‖</mo></mrow></mfrac></mrow></mrow></mrow><annotation encoding="application/x-tex">x_{t+1}-x_{t}=-\eta_{x}\frac{g_{x,t}}{\left\|g_{x,t}\right\|}</annotation></semantics></math> into the above inequality yields</span></p>
<table id="A3.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex112.m1" class="ltx_Math" alttext="\displaystyle\Phi(x_{t+1})\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi(x_{t+1})\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex112.m2" class="ltx_Math" alttext="\displaystyle\Phi(x_{t})-\eta_{x}\left\langle\frac{g_{x,t}}{\left\|g_{x,t}\right\|},\nabla\Phi(x_{t})\right\rangle+\eta_{x}^{2}(\kappa+1)\ell" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mo>‖</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>‖</mo></mrow></mfrac></mstyle><mo>,</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Phi(x_{t})-\eta_{x}\left\langle\frac{g_{x,t}}{\left\|g_{x,t}\right\|},\nabla\Phi(x_{t})\right\rangle+\eta_{x}^{2}(\kappa+1)\ell</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex113.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex113.m2" class="ltx_Math" alttext="\displaystyle\Phi(x_{t})-\eta_{x}\left\|\nabla\Phi(x_{t})\right\|+2\eta_{x}\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|+\eta_{x}^{2}(\varkappa+1)\ell." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ϰ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Phi(x_{t})-\eta_{x}\left\|\nabla\Phi(x_{t})\right\|+2\eta_{x}\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|+\eta_{x}^{2}(\varkappa+1)\ell.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.3" class="ltx_p"><span id="A3.SS1.p2.3.1" class="ltx_text">The second inequality follows from Lemma <a href="#A1.EGx19" title="Lemma A.1 ( [ , Lemma 7] ). ‣ Appendix A Supporting Lemmas ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>.
By the triangle inequality, one has</span></p>
<table id="A3.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex114.m1" class="ltx_Math" alttext="\displaystyle\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex114.m2" class="ltx_Math" alttext="\displaystyle\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|+\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo>+</mo><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|+\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.4" class="ltx_p"><span id="A3.SS1.p2.4.1" class="ltx_text">Taking the expectation on both sides of the inequality, we have</span></p>
<table id="A3.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex115.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|]\leq\frac{2\sigma}{M^{\frac{p-1}{p}}}+{\mathbb{E}}[\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|]\leq\frac{2\sigma}{M^{\frac{p-1}{p}}}+{\mathbb{E}}[\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.5" class="ltx_p"><span id="A3.SS1.p2.5.1" class="ltx_text">where the above inequality is due to Lemma <a href="#A1.EGx23" title="Lemma A.4. ‣ Appendix A Supporting Lemmas ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a>.
It follows that</span></p>
<table id="A3.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex116"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex116.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{t+1})]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{t+1})]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex116.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{t})]-\eta_{x}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+2\eta_{x}{\mathbb{E}}[\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{t})]-\eta_{x}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+2\eta_{x}{\mathbb{E}}[\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex117"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex117.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex117.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{t})]-\eta_{x}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{4\sigma\eta_{x}}{M^{\frac{p-1}{p}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{t})]-\eta_{x}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{4\sigma\eta_{x}}{M^{\frac{p-1}{p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex118.m1" class="ltx_Math" alttext="\displaystyle+2\eta_{x}{\mathbb{E}}[\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+2\eta_{x}{\mathbb{E}}[\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.6" class="ltx_p"><span id="A3.SS1.p2.6.1" class="ltx_text">∎</span></p>
</div>
</div>
<div id="A3.SS1.p3" class="ltx_para ltx_noindent">
<p id="A3.SS1.p3.1" class="ltx_p">Based on the above lemma, we provide the convergence analysis of N<sup id="A3.SS1.p3.1.1" class="ltx_sup">2</sup>SGDA for solving the nonconvex-strongly-concave problems.</p>
</div>
<section id="A3.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.1.1 </span>Proof of Theorem <a href="#S5.Thmthm1" title="Theorem 5.1. ‣ 5.2 Convergence Analysis ‣ 5 Stochastic Minimax Optimization under Heavy-Tailed Noise ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a></h4>

<div id="A3.SS1.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS1.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS1.p1.1" class="ltx_p"><span id="A3.SS1.SSS1.p1.1.1" class="ltx_text">Lemma <a href="#A3.EGx70" title="Lemma C.1. ‣ C.1 In-Expectation Convergence Guarantee ‣ Appendix C Stochastic Minimax Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a> implies that</span></p>
<table id="A3.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex119.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{t+1})]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{t+1})]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex119.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{t})]-\eta_{x}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{2\sigma\eta_{x}}{M^{\frac{p-1}{p}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{t})]-\eta_{x}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{2\sigma\eta_{x}}{M^{\frac{p-1}{p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex120"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex120.m1" class="ltx_Math" alttext="\displaystyle+\eta_{x}{\mathbb{E}}[\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\eta_{x}{\mathbb{E}}[\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p1.2" class="ltx_p"><span id="A3.SS1.SSS1.p1.2.1" class="ltx_text">Telescope the above inequalities from <math id="A3.SS1.SSS1.p1.m1" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math> to <math id="A3.SS1.SSS1.p1.m2" class="ltx_Math" alttext="T-1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T-1</annotation></semantics></math>, we have</span></p>
<table id="A3.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex121"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex121.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{T})]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{T})]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex121.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{0})]-\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{2\sigma\eta_{x}T}{M^{\frac{p-1}{p}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{0})]-\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{2\sigma\eta_{x}T}{M^{\frac{p-1}{p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex122"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex122.m1" class="ltx_math_unparsed" alttext="\displaystyle+\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell T" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>η</mi><mi>x</mi></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">ℓ</mi><mi>T</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex123"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex123.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex123.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{0})]-\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{2\sigma\eta_{x}T}{M^{\frac{p-1}{p}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{0})]-\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{2\sigma\eta_{x}T}{M^{\frac{p-1}{p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex124"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex124.m1" class="ltx_math_unparsed" alttext="\displaystyle+\eta_{x}\ell\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|y_{t}-y^{*}(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell T" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>η</mi><mi>x</mi></msub><mi mathvariant="normal">ℓ</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><msub><mi>y</mi><mi>t</mi></msub><mo>−</mo><msup><mi>y</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow><mo>+</mo><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">ℓ</mi><mi>T</mi></mrow><annotation encoding="application/x-tex">\displaystyle+\eta_{x}\ell\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|y_{t}-y^{*}(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex125"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex125.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex125.m2" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}[\Phi(x_{0})]-\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{2\sigma\eta_{x}T}{M^{\frac{p-1}{p}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\Phi(x_{0})]-\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]+\frac{2\sigma\eta_{x}T}{M^{\frac{p-1}{p}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex126"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex126.m1" class="ltx_math_unparsed" alttext="\displaystyle+\eta_{x}\ell\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|y_{t}-y^{*}(x_{t})\right\|^{2}]^{\frac{1}{2}}+\eta_{x}^{2}(\kappa+1)\ell T." display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi>η</mi><mi>x</mi></msub><mi mathvariant="normal">ℓ</mi><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mi>𝔼</mi><msup><mrow><mo stretchy="false">[</mo><msup><mrow><mo>‖</mo><msub><mi>y</mi><mi>t</mi></msub><mo>−</mo><msup><mi>y</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup><mo>+</mo><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mi mathvariant="normal">ℓ</mi><mi>T</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\eta_{x}\ell\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|y_{t}-y^{*}(x_{t})\right\|^{2}]^{\frac{1}{2}}+\eta_{x}^{2}(\kappa+1)\ell T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p1.3" class="ltx_p"><span id="A3.SS1.SSS1.p1.3.1" class="ltx_text">The second inequality follows from the <math id="A3.SS1.SSS1.p1.m3" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-smoothness of the function <math id="A3.SS1.SSS1.p1.m4" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>.
The last inequality is due to Jensen’s inequality.
Rearrange the terms, and divide both sides by <math id="A3.SS1.SSS1.p1.m5" class="ltx_Math" alttext="\eta_{x}T" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\eta_{x}T</annotation></semantics></math>, it follows that</span></p>
<table id="A3.E34" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E34.m1" class="ltx_Math" alttext="\begin{split}\frac{1}{T}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]\leq&amp;\frac{{\mathbb{E}}[\Phi(x_{0})-\Phi(x_{T})]}{\eta_{x}T}+\frac{2\sigma}{M^{\frac{p-1}{p}}}+\frac{\ell\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|y_{t}-y^{*}(x_{t})\right\|^{2}]^{\frac{1}{2}}}{T}\\
&amp;+\eta_{x}(\kappa+1)\ell.\end{split}" display="block" intent=":literal"><semantics><mtable columnspacing="0pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mfrac><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac><mo>+</mo><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">[</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>y</mi><mi>t</mi></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow></mrow></mrow><mi>T</mi></mfrac></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}\frac{1}{T}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|\nabla\Phi(x_{t})\right\|]\leq&amp;\frac{{\mathbb{E}}[\Phi(x_{0})-\Phi(x_{T})]}{\eta_{x}T}+\frac{2\sigma}{M^{\frac{p-1}{p}}}+\frac{\ell\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|y_{t}-y^{*}(x_{t})\right\|^{2}]^{\frac{1}{2}}}{T}\\
&amp;+\eta_{x}(\kappa+1)\ell.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(34)</span></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p1.4" class="ltx_p"><span id="A3.SS1.SSS1.p1.4.1" class="ltx_text">Since <math id="A3.SS1.SSS1.p1.m6" class="ltx_Math" alttext="f(x,y)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(x,y)</annotation></semantics></math> is <math id="A3.SS1.SSS1.p1.m7" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-strongly concave in <math id="A3.SS1.SSS1.p1.m8" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>, it follows that <math id="A3.SS1.SSS1.p1.m9" class="ltx_Math" alttext="-f(x,y)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-f(x,y)</annotation></semantics></math> is <math id="A3.SS1.SSS1.p1.m10" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-strongly convex with respect to <math id="A3.SS1.SSS1.p1.m11" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>.
Furthermore, we will show that</span></p>
<table id="A3.E35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E35.m1" class="ltx_Math" alttext="R_{y}^{2}\geq{\mathbb{E}}[\left\|\hat{y}_{t,0}-y^{*}(x_{t})\right\|^{2}]" display="block" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup><mo>≥</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R_{y}^{2}\geq{\mathbb{E}}[\left\|\hat{y}_{t,0}-y^{*}(x_{t})\right\|^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p1.5" class="ltx_p"><span id="A3.SS1.SSS1.p1.5.1" class="ltx_text">for <math id="A3.SS1.SSS1.p1.m12" class="ltx_Math" alttext="t=0,1,\dots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T-1</annotation></semantics></math>.
With these observations, we can invoke Lemma <a href="#A4.EGx105" title="Lemma D.2. ‣ D.1 In-Expectation Convergence Analysis ‣ Appendix D Convergence Analysis of Clipped-SGD ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.2</span></a> with <math id="A3.SS1.SSS1.p1.m13" class="ltx_Math" alttext="\hat{f}(x,y)=-f(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x,y)=-f(x,y)</annotation></semantics></math> to establish the convergence guarantee for <math id="A3.SS1.SSS1.p1.m14" class="ltx_Math" alttext="{\mathbb{E}}[\left\|y^{*}(x_{t})-\hat{y}_{t,K}\right\|^{2}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo>‖</mo><mrow><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>K</mi></mrow></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{E}}[\left\|y^{*}(x_{t})-\hat{y}_{t,K}\right\|^{2}]</annotation></semantics></math>.
We now show that equation (<a href="#A3.E35" title="In Proof. ‣ C.1.1 Proof of Theorem ‣ C.1 In-Expectation Convergence Guarantee ‣ Appendix C Stochastic Minimax Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>) holds by induction.
For the base case <math id="A3.SS1.SSS1.p1.m15" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>, it holds that <math id="A3.SS1.SSS1.p1.m16" class="ltx_Math" alttext="{\mathbb{E}}[\left\|\hat{y}_{0,0}-y^{*}(x_{0})\right\|^{2}]\leq R_{0}^{2}\leq R_{y}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><msubsup><mi>R</mi><mn>0</mn><mn>2</mn></msubsup><mo>≤</mo><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">{\mathbb{E}}[\left\|\hat{y}_{0,0}-y^{*}(x_{0})\right\|^{2}]\leq R_{0}^{2}\leq R_{y}^{2}</annotation></semantics></math>.
Let equation (<a href="#A3.E35" title="In Proof. ‣ C.1.1 Proof of Theorem ‣ C.1 In-Expectation Convergence Guarantee ‣ Appendix C Stochastic Minimax Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>) holds for <math id="A3.SS1.SSS1.p1.m17" class="ltx_Math" alttext="t=0,\dots,\tilde{t}-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=0,\dots,\tilde{t}-1</annotation></semantics></math>, we consider the case <math id="A3.SS1.SSS1.p1.m18" class="ltx_Math" alttext="t=\tilde{t}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mover accent="true"><mi>t</mi><mo>~</mo></mover></mrow><annotation encoding="application/x-tex">t=\tilde{t}</annotation></semantics></math>:</span></p>
<table id="A3.EGx77" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex127.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t},0}-y^{*}(x_{\tilde{t}})\right\|^{2}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mover accent="true"><mi>t</mi><mo>~</mo></mover></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t},0}-y^{*}(x_{\tilde{t}})\right\|^{2}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex127.m2" class="ltx_Math" alttext="\displaystyle 2{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t}-1,K}-y^{*}(x_{\tilde{t}-1})\right\|^{2}\right]+2{\mathbb{E}}\left[\left\|y^{*}(x_{\tilde{t}-1})-y^{*}(x_{\tilde{t}})\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mover accent="true"><mi>t</mi><mo>~</mo></mover></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t}-1,K}-y^{*}(x_{\tilde{t}-1})\right\|^{2}\right]+2{\mathbb{E}}\left[\left\|y^{*}(x_{\tilde{t}-1})-y^{*}(x_{\tilde{t}})\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex128.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex128.m2" class="ltx_Math" alttext="\displaystyle 2{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t}-1,K}-y^{*}(x_{\tilde{t}-1})\right\|^{2}\right]+2\kappa^{2}\left\|x_{\tilde{t}-1}-x_{\tilde{t}}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>x</mi><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>x</mi><mover accent="true"><mi>t</mi><mo>~</mo></mover></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t}-1,K}-y^{*}(x_{\tilde{t}-1})\right\|^{2}\right]+2\kappa^{2}\left\|x_{\tilde{t}-1}-x_{\tilde{t}}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex129"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex129.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex129.m2" class="ltx_Math" alttext="\displaystyle 2{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t}-1,K}-y^{*}(x_{\tilde{t}-1})\right\|^{2}\right]+2\kappa^{2}\eta_{x}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t}-1,K}-y^{*}(x_{\tilde{t}-1})\right\|^{2}\right]+2\kappa^{2}\eta_{x}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p1.6" class="ltx_p"><span id="A3.SS1.SSS1.p1.6.1" class="ltx_text">According to the induction hypothesis, one has <math id="A3.SS1.SSS1.p1.m19" class="ltx_Math" alttext="{\mathbb{E}}\Big[\left\|\hat{y}_{\tilde{t}-1,0}-y^{*}(x_{\tilde{t}-1})\right\|^{2}\Big]\leq R_{y}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>≤</mo><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">{\mathbb{E}}\Big[\left\|\hat{y}_{\tilde{t}-1,0}-y^{*}(x_{\tilde{t}-1})\right\|^{2}\Big]\leq R_{y}^{2}</annotation></semantics></math>, we apply Lemma <a href="#A4.EGx105" title="Lemma D.2. ‣ D.1 In-Expectation Convergence Analysis ‣ Appendix D Convergence Analysis of Clipped-SGD ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.2</span></a> with <math id="A3.SS1.SSS1.p1.m20" class="ltx_Math" alttext="\hat{f}(x,y)=-f(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x,y)=-f(x,y)</annotation></semantics></math> and <math id="A3.SS1.SSS1.p1.m21" class="ltx_Math" alttext="\hat{R}=R_{y}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>R</mi><mo>^</mo></mover><mo>=</mo><msub><mi>R</mi><mi>y</mi></msub></mrow><annotation encoding="application/x-tex">\hat{R}=R_{y}</annotation></semantics></math> to obtain the following convergence guarantee:</span></p>
<table id="A3.EGx78" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex130"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex130.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t}-1,K}-y^{*}(x_{\tilde{t}-1})\right\|^{2}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t}-1,K}-y^{*}(x_{\tilde{t}-1})\right\|^{2}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex130.m2" class="ltx_Math" alttext="\displaystyle 2R_{y}^{2}\max\left\{\exp\left(-\frac{K}{400\kappa}\right),\frac{5400^{\frac{2}{p}}\sigma^{2}(\ln(B_{K}))^{2}}{\mu^{2}K^{\frac{2(p-1)}{p}}R_{y}^{2}}\right\}\leq\frac{4\epsilon^{2}}{\ell^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>K</mi><mrow><mn>400</mn><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mn>5400</mn><mfrac><mn>2</mn><mi>p</mi></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mi>K</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>K</mi><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>p</mi></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>}</mo></mrow></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2R_{y}^{2}\max\left\{\exp\left(-\frac{K}{400\kappa}\right),\frac{5400^{\frac{2}{p}}\sigma^{2}(\ln(B_{K}))^{2}}{\mu^{2}K^{\frac{2(p-1)}{p}}R_{y}^{2}}\right\}\leq\frac{4\epsilon^{2}}{\ell^{2}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p1.7" class="ltx_p"><span id="A3.SS1.SSS1.p1.7.1" class="ltx_text">where the last inequality follows from the choice of <math id="A3.SS1.SSS1.p1.m22" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.
Consequently, it implies that</span></p>
<table id="A3.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex131"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex131.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t},0}-y^{*}(x_{\tilde{t}})\right\|^{2}\right]\leq\frac{10\epsilon^{2}}{\ell^{2}}\leq R_{y}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mover accent="true"><mi>t</mi><mo>~</mo></mover><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mover accent="true"><mi>t</mi><mo>~</mo></mover></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup></mfrac></mstyle><mo>≤</mo><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}\left[\left\|\hat{y}_{\tilde{t},0}-y^{*}(x_{\tilde{t}})\right\|^{2}\right]\leq\frac{10\epsilon^{2}}{\ell^{2}}\leq R_{y}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p1.8" class="ltx_p"><span id="A3.SS1.SSS1.p1.8.1" class="ltx_text">which completes the proof of induction.</span></p>
</div>
<div id="A3.SS1.SSS1.p2" class="ltx_para ltx_noindent">
<p id="A3.SS1.SSS1.p2.1" class="ltx_p"><span id="A3.SS1.SSS1.p2.1.1" class="ltx_text">To obtain a local <math id="A3.SS1.SSS1.p2.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-approximate solution for the problem, we choose the following parameters</span></p>
<table id="A3.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex132"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex132.m1" class="ltx_Math" alttext="\displaystyle\eta_{x}={\mathcal{O}}\left(\frac{\epsilon}{\kappa\ell}\right),\quad T={\mathcal{O}}\left(\frac{\Delta_{\Phi}\kappa\ell}{\epsilon^{2}}\right),\quad M={\mathcal{O}}\left(\left(\frac{\sigma}{\epsilon}\right)^{\frac{p}{p-1}}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>x</mi></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>ϵ</mi><mrow><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>T</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>M</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{x}={\mathcal{O}}\left(\frac{\epsilon}{\kappa\ell}\right),\quad T={\mathcal{O}}\left(\frac{\Delta_{\Phi}\kappa\ell}{\epsilon^{2}}\right),\quad M={\mathcal{O}}\left(\left(\frac{\sigma}{\epsilon}\right)^{\frac{p}{p-1}}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex133"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex133.m1" class="ltx_Math" alttext="\displaystyle K={\mathcal{O}}\left(\kappa\ln\left(\frac{\ell R_{y}}{\epsilon}\right)+\left(\frac{\ell^{2}\sigma^{2}(\ln(\ell R_{y}/\epsilon))^{2}}{\mu^{2}\epsilon^{2}}\right)^{\frac{p}{2(p-1)}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>κ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>y</mi></msub></mrow><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>+</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>y</mi></msub></mrow><mo>/</mo><mi>ϵ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow><mfrac><mi>p</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></msup></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle K={\mathcal{O}}\left(\kappa\ln\left(\frac{\ell R_{y}}{\epsilon}\right)+\left(\frac{\ell^{2}\sigma^{2}(\ln(\ell R_{y}/\epsilon))^{2}}{\mu^{2}\epsilon^{2}}\right)^{\frac{p}{2(p-1)}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS1.SSS1.p3" class="ltx_para">
<p id="A3.SS1.SSS1.p3.1" class="ltx_p"><span id="A3.SS1.SSS1.p3.1.1" class="ltx_text">The total SFO complexity is</span></p>
<table id="A3.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex134"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex134.m1" class="ltx_Math" alttext="\displaystyle TM+TK={\mathcal{O}}\left(\frac{\Delta_{\Phi}\kappa\ell\sigma^{\frac{p}{p-1}}}{\epsilon^{\frac{3p-2}{p-1}}}+\frac{\Delta_{\Phi}\kappa^{\frac{2p-1}{p-1}}\ell\sigma^{\frac{p}{p-1}}}{\epsilon^{\frac{3p-2}{p-1}}}\left(\ln\left(\frac{\ell R_{y}}{\epsilon}\right)\right)^{\frac{p}{p-1}}+\frac{\Delta_{\Phi}\kappa^{2}\ell}{\epsilon^{2}}\ln\left(\frac{\ell R_{y}}{\epsilon}\right)\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mrow><msup><mi>ϵ</mi><mfrac><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>2</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mrow><msup><mi>ϵ</mi><mfrac><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>2</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>y</mi></msub></mrow><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>y</mi></msub></mrow><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle TM+TK={\mathcal{O}}\left(\frac{\Delta_{\Phi}\kappa\ell\sigma^{\frac{p}{p-1}}}{\epsilon^{\frac{3p-2}{p-1}}}+\frac{\Delta_{\Phi}\kappa^{\frac{2p-1}{p-1}}\ell\sigma^{\frac{p}{p-1}}}{\epsilon^{\frac{3p-2}{p-1}}}\left(\ln\left(\frac{\ell R_{y}}{\epsilon}\right)\right)^{\frac{p}{p-1}}+\frac{\Delta_{\Phi}\kappa^{2}\ell}{\epsilon^{2}}\ln\left(\frac{\ell R_{y}}{\epsilon}\right)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p3.2" class="ltx_p"><span id="A3.SS1.SSS1.p3.2.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>High Probability Convergence Guarantee</h3>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p">In this subsection, we present the proof of the high-probability convergence guarantee of the N<sup id="A3.SS2.p1.1.1" class="ltx_sup">2</sup>SGDA method for solving nonconvex-strongly-concave problems.
We start by providing a high-probability convergence guarantee of N<sup id="A3.SS2.p1.1.2" class="ltx_sup">2</sup>SGDA with a general gradient estimator <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="g_{x,t}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">g_{x,t}</annotation></semantics></math>.
Throughout this section, we denote the natural filtration of our iterates by <math id="A3.SS2.p1.m4" class="ltx_Math" alttext="{\mathcal{F}}_{t}\coloneqq\sigma(g_{x,0},g_{x,1},\dots,g_{x,t})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub><mo>≔</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>,</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{F}}_{t}\coloneqq\sigma(g_{x,0},g_{x,1},\dots,g_{x,t})</annotation></semantics></math>.</p>
</div>
<div id="A3.Thmlem2" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlem2.2" class="ltx_text ltx_font_bold">Lemma C.2</span></span><span id="A3.Thmlem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlem2.p1" class="ltx_para">
<p id="A3.Thmlem2.p1.1" class="ltx_p"><span id="A3.Thmlem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmlem2.p1.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>. Under Assumption <a href="#S3.Thmasm2" title="Assumption 3.2. ‣ 3.2 Approximate Stationary Points of Minimax Optimization ‣ 3 Preliminaries ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> and <a href="#S3.Thmasm3" title="Assumption 3.3. ‣ 3.3 Stochastic Gradient Assumption ‣ 3 Preliminaries ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, the iterates generated by N<sup id="A3.Thmlem2.p1.1.1.1" class="ltx_sup">2</sup>SGDA satisfy</span></p>
<table id="A3.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex135"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex135.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex135.m2" class="ltx_Math" alttext="\displaystyle\frac{2\Delta_{\Phi}}{\eta_{x}T}+\sum_{t=1}^{T}\frac{4{\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|]}{T}+\sum_{t=1}^{T}\frac{4\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|}{T}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mi>T</mi></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mi>T</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2\Delta_{\Phi}}{\eta_{x}T}+\sum_{t=1}^{T}\frac{4{\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|]}{T}+\sum_{t=1}^{T}\frac{4\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|}{T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex136"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex136.m1" class="ltx_Math" alttext="\displaystyle+2\eta_{x}(\kappa+1)\ell+12\left(\frac{\left\|\nabla\Phi(x_{0})\right\|}{T}+2\eta_{x}(\kappa+1)\ell\right)\ln\left(\frac{2}{\delta}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo>+</mo><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>T</mi></mfrac></mstyle><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+2\eta_{x}(\kappa+1)\ell+12\left(\frac{\left\|\nabla\Phi(x_{0})\right\|}{T}+2\eta_{x}(\kappa+1)\ell\right)\ln\left(\frac{2}{\delta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.Thmlem2.p1.2" class="ltx_p"><span id="A3.Thmlem2.p1.2.1" class="ltx_text ltx_font_italic">with probability at least <math id="A3.Thmlem2.p1.m3" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p2" class="ltx_para ltx_noindent">
<p id="A3.SS2.p2.1" class="ltx_p"><span id="A3.SS2.p2.1.1" class="ltx_text">Let <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="\nu_{t}\coloneqq\frac{\langle\nabla\Phi(x_{t}),g_{x,t}\rangle}{\left\|\nabla\Phi(x_{t})\right\|\left\|g_{x,t}\right\|}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo>≔</mo><mfrac><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">⟩</mo></mrow><mrow><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>‖</mo></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\nu_{t}\coloneqq\frac{\langle\nabla\Phi(x_{t}),g_{x,t}\rangle}{\left\|\nabla\Phi(x_{t})\right\|\left\|g_{x,t}\right\|}</annotation></semantics></math> denote the cosine angle between <math id="A3.SS2.p2.m2" class="ltx_Math" alttext="\nabla\Phi(x_{t})" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla\Phi(x_{t})</annotation></semantics></math> and <math id="A3.SS2.p2.m3" class="ltx_Math" alttext="g_{x,t}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">g_{x,t}</annotation></semantics></math>.
Then, by Lemma <a href="#A3.EGx70" title="Lemma C.1. ‣ C.1 In-Expectation Convergence Guarantee ‣ Appendix C Stochastic Minimax Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>, we have</span></p>
<table id="A3.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex137"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex137.m1" class="ltx_Math" alttext="\displaystyle\Phi(x_{t+1})\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi(x_{t+1})\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex137.m2" class="ltx_Math" alttext="\displaystyle\Phi(x_{t})-\eta_{x}\left\|\nabla\Phi(x_{t})\right\|\nu_{t}+\eta_{x}^{2}(\kappa+1)\ell." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>t</mi></msub></mrow></mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Phi(x_{t})-\eta_{x}\left\|\nabla\Phi(x_{t})\right\|\nu_{t}+\eta_{x}^{2}(\kappa+1)\ell.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.2" class="ltx_p"><span id="A3.SS2.p2.2.1" class="ltx_text">Telescope the above inequality from <math id="A3.SS2.p2.m4" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math> to <math id="A3.SS2.p2.m5" class="ltx_Math" alttext="T-1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T-1</annotation></semantics></math>, and rearrange the terms, we obtain</span></p>
<table id="A3.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex138"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex138.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=0}^{T-1}\eta_{x}\nu_{t}\left\|\nabla\Phi(x_{t})\right\|\leq\Delta_{\Phi}+\eta_{x}^{2}(\kappa+1)\ell T." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=0}^{T-1}\eta_{x}\nu_{t}\left\|\nabla\Phi(x_{t})\right\|\leq\Delta_{\Phi}+\eta_{x}^{2}(\kappa+1)\ell T.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.3" class="ltx_p"><span id="A3.SS2.p2.3.1" class="ltx_text">Next, we use the fact that <math id="A3.SS2.p2.m6" class="ltx_Math" alttext="\nu_{t}" display="inline" intent=":literal"><semantics><msub><mi>ν</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\nu_{t}</annotation></semantics></math> is bounded and hence sharply concentrates around its expectation.
Formally, let <math id="A3.SS2.p2.m7" class="ltx_Math" alttext="\psi_{t}\coloneqq{\mathbb{E}}[\nu_{t}\mid{\mathcal{F}}_{t-1}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo>≔</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\psi_{t}\coloneqq{\mathbb{E}}[\nu_{t}\mid{\mathcal{F}}_{t-1}]</annotation></semantics></math> and denote that <math id="A3.SS2.p2.m8" class="ltx_Math" alttext="D_{t}\coloneqq-\eta_{x}(\nu_{t}-\psi_{t})\left\|\nabla\Phi(x_{t})\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>t</mi></msub><mo>≔</mo><mrow><mo>−</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo>−</mo><msub><mi>ψ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{t}\coloneqq-\eta_{x}(\nu_{t}-\psi_{t})\left\|\nabla\Phi(x_{t})\right\|</annotation></semantics></math> is a martingale difference sequence with respect to <math id="A3.SS2.p2.m9" class="ltx_Math" alttext="({\mathcal{F}}_{t})_{t\in\mathbb{N}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>t</mi><mo>∈</mo><mi>ℕ</mi></mrow></msub><annotation encoding="application/x-tex">({\mathcal{F}}_{t})_{t\in\mathbb{N}}</annotation></semantics></math>.
Furthermore, noting that</span></p>
<table id="A3.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex139"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex139.m1" class="ltx_Math" alttext="\displaystyle\exp\left(\frac{D_{t}^{2}}{4\eta_{x}^{2}\left\|\nabla\Phi(x_{t})\right\|^{2}}\right)=\exp\left(\frac{(\nu_{t}-\psi_{t})^{2}}{4}\right)\leq e" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>D</mi><mi>t</mi><mn>2</mn></msubsup><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>=</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo>−</mo><msub><mi>ψ</mi><mi>t</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mn>4</mn></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>≤</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left(\frac{D_{t}^{2}}{4\eta_{x}^{2}\left\|\nabla\Phi(x_{t})\right\|^{2}}\right)=\exp\left(\frac{(\nu_{t}-\psi_{t})^{2}}{4}\right)\leq e</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.4" class="ltx_p"><span id="A3.SS2.p2.4.1" class="ltx_text">implies that we may apply Lemma <a href="#A1.Thmlem8" title="Lemma A.8 ( [ ] ). ‣ Appendix A Supporting Lemmas ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.8</span></a>.
Doing so yields, for all <math id="A3.SS2.p2.m10" class="ltx_Math" alttext="\lambda&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda&gt;0</annotation></semantics></math>,</span></p>
<table id="A3.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex140"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex140.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=0}^{T-1}\eta_{x}(\psi_{t}-3\lambda\eta_{x}\left\|\nabla\Phi(x_{t})\right\|)\left\|\nabla\Phi(x_{t})\right\|\leq\Delta_{\Phi}+\eta_{x}^{2}(\kappa+1)\ell T+\frac{1}{\lambda}\ln\left(\frac{2}{\delta}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>λ</mi></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=0}^{T-1}\eta_{x}(\psi_{t}-3\lambda\eta_{x}\left\|\nabla\Phi(x_{t})\right\|)\left\|\nabla\Phi(x_{t})\right\|\leq\Delta_{\Phi}+\eta_{x}^{2}(\kappa+1)\ell T+\frac{1}{\lambda}\ln\left(\frac{2}{\delta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.5" class="ltx_p"><span id="A3.SS2.p2.5.1" class="ltx_text">with probability at least <math id="A3.SS2.p2.m11" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>.
By the smoothness of <math id="A3.SS2.p2.m12" class="ltx_Math" alttext="\Phi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Φ</mi><annotation encoding="application/x-tex">\Phi</annotation></semantics></math> we get</span></p>
<table id="A3.E36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E36.m1" class="ltx_Math" alttext="\left\|\nabla\Phi(x_{t})\right\|\leq\left\|\nabla\Phi(x_{0})\right\|+(\kappa+1)\ell t\eta_{x}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>≤</mo><mrow><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left\|\nabla\Phi(x_{t})\right\|\leq\left\|\nabla\Phi(x_{0})\right\|+(\kappa+1)\ell t\eta_{x},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(36)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.6" class="ltx_p"><span id="A3.SS2.p2.6.1" class="ltx_text">and hence choosing <math id="A3.SS2.p2.m13" class="ltx_Math" alttext="\lambda\coloneqq{1}/{(6(\eta_{x}\left\|\nabla\Phi(x_{0})\right\|+C_{T}(\kappa+1)\ell))}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≔</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda\coloneqq{1}/{(6(\eta_{x}\left\|\nabla\Phi(x_{0})\right\|+C_{T}(\kappa+1)\ell))}</annotation></semantics></math> where <math id="A3.SS2.p2.m14" class="ltx_Math" alttext="C_{T}=\eta_{x}^{2}T" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>T</mi></msub><mo>=</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">C_{T}=\eta_{x}^{2}T</annotation></semantics></math> yields, with probability at least <math id="A3.SS2.p2.m15" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>,</span></p>
<table id="A3.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex141"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex141.m1" class="ltx_Math" alttext="\displaystyle\sum_{t=0}^{T-1}\eta_{x}\left(\psi_{t}-\frac{1}{2}\right)\left\|\nabla\Phi(x_{t})\right\|\leq\Delta_{\Phi}+\eta_{x}^{2}(\kappa+1)\ell T+6(\eta_{x}\left\|\nabla\Phi(x_{0})\right\|+C_{T}(\kappa+1)\ell)\ln\left(\frac{2}{\delta}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>≤</mo><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{t=0}^{T-1}\eta_{x}\left(\psi_{t}-\frac{1}{2}\right)\left\|\nabla\Phi(x_{t})\right\|\leq\Delta_{\Phi}+\eta_{x}^{2}(\kappa+1)\ell T+6(\eta_{x}\left\|\nabla\Phi(x_{0})\right\|+C_{T}(\kappa+1)\ell)\ln\left(\frac{2}{\delta}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.7" class="ltx_p"><span id="A3.SS2.p2.7.1" class="ltx_text">By applying Lemma <a href="#A1.EGx19" title="Lemma A.1 ( [ , Lemma 7] ). ‣ Appendix A Supporting Lemmas ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.1</span></a>, we get</span></p>
<table id="A3.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex142"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex142.m1" class="ltx_Math" alttext="\displaystyle\psi_{t}\left\|\nabla\Phi(x_{t})\right\|\geq\left\|\nabla\Phi(x_{t})\right\|-2{\mathbb{E}}[\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ψ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow><mo>≥</mo><mrow><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\psi_{t}\left\|\nabla\Phi(x_{t})\right\|\geq\left\|\nabla\Phi(x_{t})\right\|-2{\mathbb{E}}[\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.8" class="ltx_p"><span id="A3.SS2.p2.8.1" class="ltx_text">Consequently, we have</span></p>
<table id="A3.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex143"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex143.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\sum_{t=0}^{T-1}\eta_{x}\left\|\nabla\Phi(x_{t})\right\|\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\sum_{t=0}^{T-1}\eta_{x}\left\|\nabla\Phi(x_{t})\right\|\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex143.m2" class="ltx_Math" alttext="\displaystyle\Delta_{\Phi}+2\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell T" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{\Phi}+2\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|g_{x,t}-\nabla\Phi(x_{t})\right\|]+\eta_{x}^{2}(\kappa+1)\ell T</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex144"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex144.m1" class="ltx_Math" alttext="\displaystyle+6(\eta_{x}\left\|\nabla\Phi(x_{0})\right\|+C_{T}(\kappa+1)\ell)\ln\left(\frac{2}{\delta}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+6(\eta_{x}\left\|\nabla\Phi(x_{0})\right\|+C_{T}(\kappa+1)\ell)\ln\left(\frac{2}{\delta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex145"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex145.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex145.m2" class="ltx_Math" alttext="\displaystyle\Delta_{\Phi}+2\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|]+2\eta_{x}\sum_{t=0}^{T-1}\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\Delta_{\Phi}+2\eta_{x}\sum_{t=0}^{T-1}{\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|]+2\eta_{x}\sum_{t=0}^{T-1}\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex146"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex146.m1" class="ltx_Math" alttext="\displaystyle+\eta_{x}^{2}(\kappa+1)\ell T+6(\eta_{x}\left\|\nabla\Phi(x_{0})\right\|+C_{T}(\kappa+1)\ell)\ln\left(\frac{2}{\delta}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\eta_{x}^{2}(\kappa+1)\ell T+6(\eta_{x}\left\|\nabla\Phi(x_{0})\right\|+C_{T}(\kappa+1)\ell)\ln\left(\frac{2}{\delta}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.9" class="ltx_p"><span id="A3.SS2.p2.9.1" class="ltx_text">Dividing both sides by <math id="A3.SS2.p2.m16" class="ltx_Math" alttext="{\eta_{x}T}/{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">{\eta_{x}T}/{2}</annotation></semantics></math> leads to the desired inequality.
∎</span></p>
</div>
</div>
<div id="A3.SS2.p3" class="ltx_para ltx_noindent">
<p id="A3.SS2.p3.1" class="ltx_p">Under an appropriate choice of <math id="A3.SS2.p3.m1" class="ltx_Math" alttext="\eta_{x}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>x</mi></msub><annotation encoding="application/x-tex">\eta_{x}</annotation></semantics></math>, we can derive the following high-probability lemma.</p>
</div>
<div id="A3.Thmlem3" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A3.Thmlem3.2" class="ltx_text ltx_font_bold">Lemma C.3</span></span><span id="A3.Thmlem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A3.Thmlem3.p1" class="ltx_para">
<p id="A3.Thmlem3.p1.1" class="ltx_p"><span id="A3.Thmlem3.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A3.Thmlem3.p1.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>. Under Assumption <a href="#S3.Thmasm2" title="Assumption 3.2. ‣ 3.2 Approximate Stationary Points of Minimax Optimization ‣ 3 Preliminaries ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> and <a href="#S3.Thmasm3" title="Assumption 3.3. ‣ 3.3 Stochastic Gradient Assumption ‣ 3 Preliminaries ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, we choose <math id="A3.Thmlem3.p1.m2" class="ltx_Math" alttext="\eta_{x}=\sqrt{\frac{\Delta_{\Phi}}{(\varkappa+1)\ell T}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>x</mi></msub><mo>=</mo><msqrt><mfrac><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>ϰ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></msqrt></mrow><annotation encoding="application/x-tex">\eta_{x}=\sqrt{\frac{\Delta_{\Phi}}{(\varkappa+1)\ell T}}</annotation></semantics></math> for the N<sup id="A3.Thmlem3.p1.1.1.1" class="ltx_sup">2</sup>SGDA algorithm.
Then, with probability at least <math id="A3.Thmlem3.p1.m4" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>, the iterates generated by N<sup id="A3.Thmlem3.p1.1.1.2" class="ltx_sup">2</sup>SGDA satisfy</span></p>
<table id="A3.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex147"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex147.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex147.m2" class="ltx_Math" alttext="\displaystyle\left(4+50\ln\left(\frac{2}{\delta}\right)\right)\frac{\sqrt{\Delta_{\Phi}(\kappa+1)\ell}}{\sqrt{T}}+\sum_{t=1}^{T}\frac{4\ell\left\|y_{t}-y^{*}(x_{t})\right\|}{T}+\frac{8\sigma}{M^{\frac{p-1}{p}}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mn>4</mn><mo>+</mo><mrow><mn>50</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msqrt><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msqrt><msqrt><mi>T</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>y</mi><mi>t</mi></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mi>T</mi></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(4+50\ln\left(\frac{2}{\delta}\right)\right)\frac{\sqrt{\Delta_{\Phi}(\kappa+1)\ell}}{\sqrt{T}}+\sum_{t=1}^{T}\frac{4\ell\left\|y_{t}-y^{*}(x_{t})\right\|}{T}+\frac{8\sigma}{M^{\frac{p-1}{p}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A3.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.p4" class="ltx_para">
<p id="A3.SS2.p4.1" class="ltx_p"><span id="A3.SS2.p4.1.1" class="ltx_text">Let <math id="A3.SS2.p4.m1" class="ltx_Math" alttext="\xi_{i}^{t}" display="inline" intent=":literal"><semantics><msubsup><mi>ξ</mi><mi>i</mi><mi>t</mi></msubsup><annotation encoding="application/x-tex">\xi_{i}^{t}</annotation></semantics></math> be the <math id="A3.SS2.p4.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-th random sample at the <math id="A3.SS2.p4.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>-th iteration.
First note that <math id="A3.SS2.p4.m4" class="ltx_Math" alttext="x_{t}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mi>t</mi></msub><annotation encoding="application/x-tex">x_{t}</annotation></semantics></math> and <math id="A3.SS2.p4.m5" class="ltx_Math" alttext="y_{t}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mi>t</mi></msub><annotation encoding="application/x-tex">y_{t}</annotation></semantics></math> are <math id="A3.SS2.p4.m6" class="ltx_Math" alttext="{\mathcal{F}}_{t-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{t-1}</annotation></semantics></math> measurable and <math id="A3.SS2.p4.m7" class="ltx_Math" alttext="\xi_{1}^{t},\ldots,\xi_{M}^{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>ξ</mi><mn>1</mn><mi>t</mi></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>ξ</mi><mi>M</mi><mi>t</mi></msubsup></mrow><annotation encoding="application/x-tex">\xi_{1}^{t},\ldots,\xi_{M}^{t}</annotation></semantics></math> are independent of <math id="A3.SS2.p4.m8" class="ltx_Math" alttext="{\mathcal{F}}_{t-1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">{\mathcal{F}}_{t-1}</annotation></semantics></math>.
We have <math id="A3.SS2.p4.m9" class="ltx_math_unparsed" alttext="{\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|\mid{\mathcal{F}}_{t-1}]={\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|\mid x_{t},y_{t}]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|\mid{\mathcal{F}}_{t-1}]={\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|\mid x_{t},y_{t}]</annotation></semantics></math> and hence applying Lemma <a href="#A1.EGx23" title="Lemma A.4. ‣ Appendix A Supporting Lemmas ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.4</span></a> to get</span></p>
<table id="A3.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex148"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex148.m1" class="ltx_math_unparsed" alttext="\displaystyle{\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|\mid{\mathcal{F}}_{t-1}]={\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|\mid x_{t},y_{t}]\leq\frac{2\sigma}{M^{\frac{p-1}{p}}}." display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>𝔼</mi><mrow><mo stretchy="false">[</mo><mrow><mo>‖</mo><msub><mi>g</mi><mrow><mi>x</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>−</mo><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>‖</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">]</mo></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|\mid{\mathcal{F}}_{t-1}]={\mathbb{E}}[\left\|g_{x,t}-\nabla_{x}f(x_{t},y_{t})\right\|\mid x_{t},y_{t}]\leq\frac{2\sigma}{M^{\frac{p-1}{p}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p4.2" class="ltx_p"><span id="A3.SS2.p4.2.1" class="ltx_text">Plugging into Lemma <a href="#A3.Thmlem2" title="Lemma C.2. ‣ C.2 High Probability Convergence Guarantee ‣ Appendix C Stochastic Minimax Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a> now yields</span></p>
<table id="A3.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex149"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex149.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex149.m2" class="ltx_Math" alttext="\displaystyle\frac{2\Delta_{\Phi}}{\eta_{x}T}+\frac{8\sigma}{M^{\frac{p-1}{p}}}+\sum_{t=1}^{T}\frac{4\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|}{T}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub></mrow><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mi>T</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2\Delta_{\Phi}}{\eta_{x}T}+\frac{8\sigma}{M^{\frac{p-1}{p}}}+\sum_{t=1}^{T}\frac{4\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|}{T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex150"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex150.m1" class="ltx_Math" alttext="\displaystyle+2\eta_{x}(\kappa+1)\ell+12\left(\frac{\left\|\nabla\Phi(x_{0})\right\|}{T}+2\eta_{x}(\kappa+1)\ell\right)\ln\left(\frac{2}{\delta}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo>+</mo><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>T</mi></mfrac></mstyle><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+2\eta_{x}(\kappa+1)\ell+12\left(\frac{\left\|\nabla\Phi(x_{0})\right\|}{T}+2\eta_{x}(\kappa+1)\ell\right)\ln\left(\frac{2}{\delta}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p4.3" class="ltx_p"><span id="A3.SS2.p4.3.1" class="ltx_text">If we choose <math id="A3.SS2.p4.m10" class="ltx_Math" alttext="\eta_{x}=\sqrt{\frac{\Delta_{\Phi}}{(\kappa+1)\ell T}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>x</mi></msub><mo>=</mo><msqrt><mfrac><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></msqrt></mrow><annotation encoding="application/x-tex">\eta_{x}=\sqrt{\frac{\Delta_{\Phi}}{(\kappa+1)\ell T}}</annotation></semantics></math>, then with probability at least <math id="A3.SS2.p4.m11" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>,</span></p>
<table id="A3.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex151"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex151.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex151.m2" class="ltx_Math" alttext="\displaystyle\frac{4\sqrt{\Delta_{\Phi}(\kappa+1)\ell}}{\sqrt{T}}+\frac{8\sigma}{M^{\frac{p-1}{p}}}+\sum_{t=0}^{T-1}\frac{4\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|}{T}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msqrt></mrow><msqrt><mi>T</mi></msqrt></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>x</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo>,</mo><msub><mi>y</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mi>T</mi></mfrac></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{4\sqrt{\Delta_{\Phi}(\kappa+1)\ell}}{\sqrt{T}}+\frac{8\sigma}{M^{\frac{p-1}{p}}}+\sum_{t=0}^{T-1}\frac{4\left\|\nabla_{x}f(x_{t},y_{t})-\nabla\Phi(x_{t})\right\|}{T}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex152"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex152.m1" class="ltx_Math" alttext="\displaystyle+12\left(\frac{\left\|\nabla\Phi(x_{0})\right\|}{T}+\frac{2\sqrt{\Delta_{\Phi}(\kappa+1)\ell}}{\sqrt{T}}\right)\ln\left(\frac{2}{\delta}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>T</mi></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msqrt></mrow><msqrt><mi>T</mi></msqrt></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+12\left(\frac{\left\|\nabla\Phi(x_{0})\right\|}{T}+\frac{2\sqrt{\Delta_{\Phi}(\kappa+1)\ell}}{\sqrt{T}}\right)\ln\left(\frac{2}{\delta}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex153"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex153.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex153.m2" class="ltx_Math" alttext="\displaystyle\left(4+50\ln\left(\frac{2}{\delta}\right)\right)\frac{\sqrt{\Delta_{\Phi}(\kappa+1)\ell}}{\sqrt{T}}+\sum_{t=0}^{T-1}\frac{4\ell\left\|y_{t}-y^{*}(x_{t})\right\|}{T}+\frac{8\sigma}{M^{\frac{p-1}{p}}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>(</mo><mrow><mn>4</mn><mo>+</mo><mrow><mn>50</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><msqrt><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msqrt><msqrt><mi>T</mi></msqrt></mfrac></mstyle></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>y</mi><mi>t</mi></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mi>T</mi></mfrac></mstyle></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(4+50\ln\left(\frac{2}{\delta}\right)\right)\frac{\sqrt{\Delta_{\Phi}(\kappa+1)\ell}}{\sqrt{T}}+\sum_{t=0}^{T-1}\frac{4\ell\left\|y_{t}-y^{*}(x_{t})\right\|}{T}+\frac{8\sigma}{M^{\frac{p-1}{p}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p4.4" class="ltx_p"><span id="A3.SS2.p4.4.1" class="ltx_text">where we use <math id="A3.SS2.p4.m12" class="ltx_Math" alttext="\left\|\nabla\Phi(x_{0})\right\|\leq\sqrt{2(\kappa+1)\ell\Delta_{\Phi}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>≤</mo><msqrt><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub></mrow></msqrt></mrow><annotation encoding="application/x-tex">\left\|\nabla\Phi(x_{0})\right\|\leq\sqrt{2(\kappa+1)\ell\Delta_{\Phi}}</annotation></semantics></math> that follows from Lemma <a href="#A1.Thmlem5" title="Lemma A.5 ( [ , Theorem 2.1.5] ). ‣ Appendix A Supporting Lemmas ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.5</span></a> and the <math id="A3.SS2.p4.m13" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-smoothness of <math id="A3.SS2.p4.m14" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> to derive the last inequality.
∎</span></p>
</div>
</div>
<section id="A3.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.2.1 </span>Proof of Theorem <a href="#S5.Thmthm2" title="Theorem 5.2. ‣ 5.2 Convergence Analysis ‣ 5 Stochastic Minimax Optimization under Heavy-Tailed Noise ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a></h4>

<div id="A3.SS2.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A3.SS2.SSS1.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.SSS1.p1.1" class="ltx_p"><span id="A3.SS2.SSS1.p1.1.1" class="ltx_text">Recall that by Lemma <a href="#A3.EGx90" title="Lemma C.3. ‣ C.2 High Probability Convergence Guarantee ‣ Appendix C Stochastic Minimax Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.3</span></a>, we have with probability <math id="A3.SS2.SSS1.p1.m1" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math></span></p>
<table id="A3.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E37.m1" class="ltx_Math" alttext="\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq\left(4+50\ln\left(\frac{2}{\delta}\right)\right)\frac{\sqrt{\Delta_{\Phi}(\kappa+1)\ell}}{\sqrt{T}}+\sum_{t=1}^{T}\frac{4\ell(\left\|y_{t}-y^{*}(x_{t})\right\|^{2})^{\frac{1}{2}}}{T}+\frac{8\sigma}{M^{\frac{p-1}{p}}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></munderover><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mrow><mo>(</mo><mrow><mn>4</mn><mo>+</mo><mrow><mn>50</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mn>2</mn><mi>δ</mi></mfrac><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><msqrt><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow></msqrt><msqrt><mi>T</mi></msqrt></mfrac></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>y</mi><mi>t</mi></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow><mfrac><mn>1</mn><mn>2</mn></mfrac></msup></mrow><mi>T</mi></mfrac></mrow><mo>+</mo><mfrac><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>σ</mi></mrow><msup><mi>M</mi><mfrac><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mi>p</mi></mfrac></msup></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq\left(4+50\ln\left(\frac{2}{\delta}\right)\right)\frac{\sqrt{\Delta_{\Phi}(\kappa+1)\ell}}{\sqrt{T}}+\sum_{t=1}^{T}\frac{4\ell(\left\|y_{t}-y^{*}(x_{t})\right\|^{2})^{\frac{1}{2}}}{T}+\frac{8\sigma}{M^{\frac{p-1}{p}}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p1.2" class="ltx_p"><span id="A3.SS2.SSS1.p1.2.1" class="ltx_text">Since <math id="A3.SS2.SSS1.p1.m2" class="ltx_Math" alttext="f(x,y)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f(x,y)</annotation></semantics></math> is <math id="A3.SS2.SSS1.p1.m3" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-strongly concave in <math id="A3.SS2.SSS1.p1.m4" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>, it follows that <math id="A3.SS2.SSS1.p1.m5" class="ltx_Math" alttext="-f(x,y)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">-f(x,y)</annotation></semantics></math> is <math id="A3.SS2.SSS1.p1.m6" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-strongly concave with respect to <math id="A3.SS2.SSS1.p1.m7" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>.
Furthermore, we will show that</span></p>
<table id="A3.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E38.m1" class="ltx_Math" alttext="R_{y}^{2}\geq\left\|\hat{y}_{t,0}-y^{*}(x_{t})\right\|^{2}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup><mo>≥</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">R_{y}^{2}\geq\left\|\hat{y}_{t,0}-y^{*}(x_{t})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p1.3" class="ltx_p"><span id="A3.SS2.SSS1.p1.3.1" class="ltx_text">with high probability for <math id="A3.SS2.SSS1.p1.m8" class="ltx_Math" alttext="t=0,1,\dots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T-1</annotation></semantics></math>.
With these observations, we can invoke Lemma <a href="#A4.Thmlem3" title="Lemma D.3 ( [ , Lemma 3.1] ). ‣ D.2 High-Probability Convergence Analysis ‣ Appendix D Convergence Analysis of Clipped-SGD ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.3</span></a> with <math id="A3.SS2.SSS1.p1.m9" class="ltx_Math" alttext="\hat{f}(x,y)=-f(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x,y)=-f(x,y)</annotation></semantics></math> to establish the convergence guarantee for <math id="A3.SS2.SSS1.p1.m10" class="ltx_Math" alttext="\left\|\hat{y}_{t,K}-y^{*}(x_{t})\right\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\left\|\hat{y}_{t,K}-y^{*}(x_{t})\right\|^{2}</annotation></semantics></math>.
We now show that equation (<a href="#A3.E38" title="In Proof. ‣ C.2.1 Proof of Theorem ‣ C.2 High Probability Convergence Guarantee ‣ Appendix C Stochastic Minimax Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">38</span></a>) holds by induction.
In particular, for each <math id="A3.SS2.SSS1.p1.m11" class="ltx_Math" alttext="t=0,1,\dots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T</annotation></semantics></math>, we consider the following probability event <math id="A3.SS2.SSS1.p1.m12" class="ltx_Math" alttext="E_{t}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>t</mi></msub><annotation encoding="application/x-tex">E_{t}</annotation></semantics></math>:</span></p>
<table id="A3.E39" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E39.m1" class="ltx_Math" alttext="R_{y}^{2}\geq\left\|\hat{y}_{l,0}-y^{*}(x_{l})\right\|^{2}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup><mo>≥</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">R_{y}^{2}\geq\left\|\hat{y}_{l,0}-y^{*}(x_{l})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p1.4" class="ltx_p"><span id="A3.SS2.SSS1.p1.4.1" class="ltx_text">holds for all <math id="A3.SS2.SSS1.p1.m13" class="ltx_Math" alttext="l=0,1,\dots,t" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">l=0,1,\dots,t</annotation></semantics></math> simultaneously.
We want to prove <math id="A3.SS2.SSS1.p1.m14" class="ltx_Math" alttext="{\mathbb{P}}(E_{t})\geq 1-t\delta/(2T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(E_{t})\geq 1-t\delta/(2T)</annotation></semantics></math> for all <math id="A3.SS2.SSS1.p1.m15" class="ltx_Math" alttext="t=0,1,\dots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=0,1,\dots,T</annotation></semantics></math>.
The base case of the induction is trivial:
For <math id="A3.SS2.SSS1.p1.m16" class="ltx_Math" alttext="t=0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t=0</annotation></semantics></math>, it holds that <math id="A3.SS2.SSS1.p1.m17" class="ltx_Math" alttext="\left\|\hat{y}_{0,0}-y^{*}(x_{0})\right\|^{2}\leq R_{0}^{2}\leq R_{y}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mn>0</mn><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><msubsup><mi>R</mi><mn>0</mn><mn>2</mn></msubsup><mo>≤</mo><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\left\|\hat{y}_{0,0}-y^{*}(x_{0})\right\|^{2}\leq R_{0}^{2}\leq R_{y}^{2}</annotation></semantics></math> with probability 1.
Next, assume that for <math id="A3.SS2.SSS1.p1.m18" class="ltx_Math" alttext="t=T^{\prime}-1\leq T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>≤</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=T^{\prime}-1\leq T</annotation></semantics></math>, then <math id="A3.SS2.SSS1.p1.m19" class="ltx_Math" alttext="{\mathbb{P}}(E_{T^{\prime}-1})\geq 1-(T^{\prime}-1)\delta/(2T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(E_{T^{\prime}-1})\geq 1-(T^{\prime}-1)\delta/(2T)</annotation></semantics></math>.
Given this, we now consider the case <math id="A3.SS2.SSS1.p1.m20" class="ltx_Math" alttext="t=T^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><msup><mi>T</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">t=T^{\prime}</annotation></semantics></math>:</span></p>
<table id="A3.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex154"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex154.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{y}_{T^{\prime},0}-y^{*}(x_{T^{\prime}})\right\|^{2}\leq" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{y}_{T^{\prime},0}-y^{*}(x_{T^{\prime}})\right\|^{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex154.m2" class="ltx_Math" alttext="\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+2\left\|y^{*}(x_{T^{\prime}-1})-y^{*}(x_{T^{\prime}})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+2\left\|y^{*}(x_{T^{\prime}-1})-y^{*}(x_{T^{\prime}})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex155"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex155.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex155.m2" class="ltx_Math" alttext="\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+2\kappa^{2}\left\|x_{T^{\prime}-1}-x_{T^{\prime}}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+2\kappa^{2}\left\|x_{T^{\prime}-1}-x_{T^{\prime}}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex156"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex156.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex156.m2" class="ltx_Math" alttext="\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+2\kappa^{2}\eta_{x}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>η</mi><mi>x</mi><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle 2\left\|\hat{y}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}+2\kappa^{2}\eta_{x}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p1.5" class="ltx_p"><span id="A3.SS2.SSS1.p1.5.1" class="ltx_text">where the first inequality is due to <math id="A3.SS2.SSS1.p1.m21" class="ltx_Math" alttext="\left\|a+b\right\|^{2}\leq 2\left\|a\right\|^{2}+2\left\|b\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mi>a</mi><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mi>b</mi><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\left\|a+b\right\|^{2}\leq 2\left\|a\right\|^{2}+2\left\|b\right\|^{2}</annotation></semantics></math>, the second inequality is due to Proposition <a href="#S3.Thmprop2" title="Proposition 3.2 ( [ , Lemma 4.3] ). ‣ 3.2 Approximate Stationary Points of Minimax Optimization ‣ 3 Preliminaries ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, and the last inequality follows from the update of <math id="A3.SS2.SSS1.p1.m22" class="ltx_Math" alttext="x_{T^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">x_{T^{\prime}}</annotation></semantics></math>.
According to the induction hypothesis, <math id="A3.SS2.SSS1.p1.m23" class="ltx_Math" alttext="R_{y}^{2}\geq\left\|\hat{y}_{l,0}^{2}-y^{*}(x_{l})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup><mo>≥</mo><msup><mrow><mo>‖</mo><mrow><msubsup><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>l</mi><mo>,</mo><mn>0</mn></mrow><mn>2</mn></msubsup><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">R_{y}^{2}\geq\left\|\hat{y}_{l,0}^{2}-y^{*}(x_{l})\right\|^{2}</annotation></semantics></math> holds for all <math id="A3.SS2.SSS1.p1.m24" class="ltx_Math" alttext="l=0,1,\dots,T^{\prime}-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">l=0,1,\dots,T^{\prime}-1</annotation></semantics></math> with probability <math id="A3.SS2.SSS1.p1.m25" class="ltx_Math" alttext="1-(T^{\prime}-1)\delta/(2T)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-(T^{\prime}-1)\delta/(2T)</annotation></semantics></math>.
We further apply Lemma <a href="#A4.Thmlem3" title="Lemma D.3 ( [ , Lemma 3.1] ). ‣ D.2 High-Probability Convergence Analysis ‣ Appendix D Convergence Analysis of Clipped-SGD ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.3</span></a> with <math id="A3.SS2.SSS1.p1.m26" class="ltx_Math" alttext="\hat{f}(x,y)=-f(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x,y)=-f(x,y)</annotation></semantics></math>, <math id="A3.SS2.SSS1.p1.m27" class="ltx_Math" alttext="\hat{R}=R_{y}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>R</mi><mo>^</mo></mover><mo>=</mo><msub><mi>R</mi><mi>y</mi></msub></mrow><annotation encoding="application/x-tex">\hat{R}=R_{y}</annotation></semantics></math> and <math id="A3.SS2.SSS1.p1.m28" class="ltx_Math" alttext="\hat{\delta}=\delta/(2T)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>δ</mi><mo>^</mo></mover><mo>=</mo><mrow><mi>δ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\delta}=\delta/(2T)</annotation></semantics></math> to obtain the following convergence guarantee</span></p>
<table id="A3.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex157"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex157.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{y}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}\leq 2\hat{R}^{2}\max\left\{\exp\left(-\frac{K}{400\kappa\ln\left({4K}/{\hat{\delta}}\right)}\right),\frac{1}{B_{K}}\right\}\leq\frac{4\epsilon^{2}}{\ell^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>K</mi></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mover accent="true"><mi>R</mi><mo>^</mo></mover><mn>2</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>K</mi><mrow><mn>400</mn><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>/</mo><mover accent="true"><mi>δ</mi><mo>^</mo></mover></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>B</mi><mi>K</mi></msub></mfrac></mstyle><mo>}</mo></mrow></mrow></mrow><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{y}_{T^{\prime}-1,K}-y^{*}(x_{T^{\prime}-1})\right\|^{2}\leq 2\hat{R}^{2}\max\left\{\exp\left(-\frac{K}{400\kappa\ln\left({4K}/{\hat{\delta}}\right)}\right),\frac{1}{B_{K}}\right\}\leq\frac{4\epsilon^{2}}{\ell^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p1.6" class="ltx_p"><span id="A3.SS2.SSS1.p1.6.1" class="ltx_text">with probability <math id="A3.SS2.SSS1.p1.m29" class="ltx_Math" alttext="1-\delta/(2T)" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1-\delta/(2T)</annotation></semantics></math>, where the last inequality follows from the parameter setting of <math id="A3.SS2.SSS1.p1.m30" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.
According to the parameter setting of <math id="A3.SS2.SSS1.p1.m31" class="ltx_Math" alttext="\eta_{x}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>x</mi></msub><annotation encoding="application/x-tex">\eta_{x}</annotation></semantics></math>, we further have <math id="A3.SS2.SSS1.p1.m32" class="ltx_Math" alttext="\left\|\hat{y}_{T^{\prime},0}-y^{*}(x_{T^{\prime}})\right\|^{2}\leq 10\epsilon^{2}/\ell^{2}\leq R_{y}^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><msup><mi>T</mi><mo>′</mo></msup><mo>,</mo><mn>0</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow><mo>/</mo><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup></mrow><mo>≤</mo><msubsup><mi>R</mi><mi>y</mi><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\left\|\hat{y}_{T^{\prime},0}-y^{*}(x_{T^{\prime}})\right\|^{2}\leq 10\epsilon^{2}/\ell^{2}\leq R_{y}^{2}</annotation></semantics></math>.
Applying the union bound, then we obtain <math id="A3.SS2.SSS1.p1.m33" class="ltx_Math" alttext="{\mathbb{P}}(E_{T^{\prime}})\geq 1-T^{\prime}\delta/(2T)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ℙ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>E</mi><msup><mi>T</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><msup><mi>T</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{\mathbb{P}}(E_{T^{\prime}})\geq 1-T^{\prime}\delta/(2T)</annotation></semantics></math>.
The proof of induction is complete.</span></p>
</div>
<div id="A3.SS2.SSS1.p2" class="ltx_para">
<p id="A3.SS2.SSS1.p2.1" class="ltx_p"><span id="A3.SS2.SSS1.p2.1.1" class="ltx_text">Using the union bound on <math id="A3.SS2.SSS1.p2.m1" class="ltx_Math" alttext="E_{T}" display="inline" intent=":literal"><semantics><msub><mi>E</mi><mi>T</mi></msub><annotation encoding="application/x-tex">E_{T}</annotation></semantics></math> and the event of equation (<a href="#A3.E37" title="In Proof. ‣ C.2.1 Proof of Theorem ‣ C.2 High Probability Convergence Guarantee ‣ Appendix C Stochastic Minimax Optimization ‣ Stochastic Bilevel Optimization with Heavy-Tailed Noise" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>) implies that with probability at least <math id="A3.SS2.SSS1.p2.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>, it holds that <math id="A3.SS2.SSS1.p2.m3" class="ltx_Math" alttext="\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq\epsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi mathvariant="normal">Φ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow><mo>≤</mo><mi>ϵ</mi></mrow><annotation encoding="application/x-tex">\frac{1}{T}\sum_{t=0}^{T-1}\left\|\nabla\Phi(x_{t})\right\|\leq\epsilon</annotation></semantics></math> with the parameter setting of</span></p>
<table id="A3.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex158"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex158.m1" class="ltx_Math" alttext="\displaystyle T={\mathcal{O}}\left(\left(1+\ln\left(\frac{1}{\delta}\right)\right)^{2}\frac{\Delta_{\Phi}\kappa\ell}{\epsilon^{2}}\right),\quad M={\mathcal{O}}\left(\left(\frac{\sigma}{\epsilon}\right)^{\frac{p}{p-1}}\right),\quad\eta_{x}=\sqrt{\frac{\Delta_{\Phi}}{(\kappa+1)\ell T}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msup><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>M</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>σ</mi><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo>)</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo>=</mo><msqrt><mstyle displaystyle="true"><mfrac><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>κ</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mfrac></mstyle></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle T={\mathcal{O}}\left(\left(1+\ln\left(\frac{1}{\delta}\right)\right)^{2}\frac{\Delta_{\Phi}\kappa\ell}{\epsilon^{2}}\right),\quad M={\mathcal{O}}\left(\left(\frac{\sigma}{\epsilon}\right)^{\frac{p}{p-1}}\right),\quad\eta_{x}=\sqrt{\frac{\Delta_{\Phi}}{(\kappa+1)\ell T}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex159"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex159.m1" class="ltx_Math" alttext="\displaystyle K={\mathcal{O}}\left(\kappa\ln\left(\frac{\ell R_{y}}{\epsilon}\right)\ln\left(\frac{T\kappa}{\delta}\right)+\left(\frac{\sigma^{2}\ell^{2}}{\mu^{2}\epsilon^{2}}\right)^{\frac{p}{2(p-1)}}\left(\ln\left(\frac{\ell R_{y}}{\epsilon}\right)\right)^{\frac{p}{p-1}}\ln\left(\frac{T}{\delta}\left(\frac{\ell^{2}\sigma^{2}}{\mu^{2}\epsilon^{2}}\right)^{\frac{p}{2(p-1)}}\right)\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mi>K</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>κ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>y</mi></msub></mrow><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup></mrow><mrow><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow><mfrac><mi>p</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>y</mi></msub></mrow><mi>ϵ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>)</mo></mrow><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>T</mi><mi>δ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi mathvariant="normal">ℓ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><msup><mi>μ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>ϵ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo>)</mo></mrow><mfrac><mi>p</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></msup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle K={\mathcal{O}}\left(\kappa\ln\left(\frac{\ell R_{y}}{\epsilon}\right)\ln\left(\frac{T\kappa}{\delta}\right)+\left(\frac{\sigma^{2}\ell^{2}}{\mu^{2}\epsilon^{2}}\right)^{\frac{p}{2(p-1)}}\left(\ln\left(\frac{\ell R_{y}}{\epsilon}\right)\right)^{\frac{p}{p-1}}\ln\left(\frac{T}{\delta}\left(\frac{\ell^{2}\sigma^{2}}{\mu^{2}\epsilon^{2}}\right)^{\frac{p}{2(p-1)}}\right)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p2.2" class="ltx_p"><span id="A3.SS2.SSS1.p2.2.1" class="ltx_text">The total SFO complexity is</span></p>
<table id="A3.EGx97" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex160"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex160.m1" class="ltx_Math" alttext="\displaystyle TM+TK=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle TM+TK=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex160.m2" class="ltx_Math" alttext="\displaystyle\tilde{O}\left(\frac{\Delta_{\Phi}\kappa^{\frac{2p-1}{p-1}}\ell\sigma^{\frac{p}{p-1}}}{\epsilon^{\frac{3p-2}{p-1}}}+\frac{\Delta_{\Phi}\kappa^{2}\ell}{\epsilon^{2}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>O</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mfrac><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>1</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mfrac><mi>p</mi><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mrow><msup><mi>ϵ</mi><mfrac><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow><mo>−</mo><mn>2</mn></mrow><mrow><mi>p</mi><mo>−</mo><mn>1</mn></mrow></mfrac></msup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi mathvariant="normal">Δ</mi><mi mathvariant="normal">Φ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>κ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">ℓ</mi></mrow><msup><mi>ϵ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\tilde{O}\left(\frac{\Delta_{\Phi}\kappa^{\frac{2p-1}{p-1}}\ell\sigma^{\frac{p}{p-1}}}{\epsilon^{\frac{3p-2}{p-1}}}+\frac{\Delta_{\Phi}\kappa^{2}\ell}{\epsilon^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.SSS1.p2.3" class="ltx_p"><span id="A3.SS2.SSS1.p2.3.1" class="ltx_text">∎</span></p>
</div>
</div>
</section>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Convergence Analysis of Clipped-SGD</h2>

<div id="A4.p1" class="ltx_para ltx_noindent">
<p id="A4.p1.1" class="ltx_p">In this section, we examine the convergence of clipped-SGD for solving strongly convex functions under heavy-tailed noise, providing both in-expectation and high-probability guarantees.
This result serves as a key building block for tackling our bilevel and minimax optimization problems.</p>
</div>
<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>In-Expectation Convergence Analysis</h3>

<div id="A4.SS1.p1" class="ltx_para ltx_noindent">
<p id="A4.SS1.p1.1" class="ltx_p">We observe that clipped-SGD satisfies the following recursive relation, as established in Lemma D.3 in <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib23" title="" class="ltx_ref">Gorbunov et al. [23]</a></cite>.
For completeness, we include the proof here.</p>
</div>
<div id="A4.Thmlem1" class="ltx_theorem ltx_theorem_lem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmlem1.2" class="ltx_text ltx_font_bold">Lemma D.1</span></span><span id="A4.Thmlem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmlem1.p1" class="ltx_para">
<p id="A4.Thmlem1.p1.1" class="ltx_p"><span id="A4.Thmlem1.p1.1.1" class="ltx_text ltx_font_italic">Assume the function <math id="A4.Thmlem1.p1.m1" class="ltx_Math" alttext="\hat{f}(x,y)={\mathbb{E}}[\hat{F}(x,y;\xi)]" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi>F</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>ξ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x,y)={\mathbb{E}}[\hat{F}(x,y;\xi)]</annotation></semantics></math> is <math id="A4.Thmlem1.p1.m2" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-strongly concave in <math id="A4.Thmlem1.p1.m3" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> and <math id="A4.Thmlem1.p1.m4" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math>-smooth, running the stochastic gradient descent on <math id="A4.Thmlem1.p1.m5" class="ltx_Math" alttext="\hat{f}(x,y)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x,y)</annotation></semantics></math>,</span></p>
<table id="A4.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex161"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex161.m1" class="ltx_Math" alttext="\displaystyle\hat{y}_{k+1}=\hat{y}_{k}-\eta_{y}\hat{g}_{y,k}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>k</mi></msub><mo>−</mo><mrow><msub><mi>η</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\hat{y}_{k+1}=\hat{y}_{k}-\eta_{y}\hat{g}_{y,k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmlem1.p1.2" class="ltx_p"><span id="A4.Thmlem1.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A4.Thmlem1.p1.m6" class="ltx_Math" alttext="\hat{g}_{y,k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">\hat{g}_{y,k}</annotation></semantics></math> is a stochastic gradient estimator of <math id="A4.Thmlem1.p1.m7" class="ltx_Math" alttext="\hat{f}(x,y)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{f}(x,y)</annotation></semantics></math> for <math id="A4.Thmlem1.p1.m8" class="ltx_Math" alttext="k=0,1,\dots,K" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">k=0,1,\dots,K</annotation></semantics></math>.
Then the following statement holds true with <math id="A4.Thmlem1.p1.m9" class="ltx_Math" alttext="\eta_{y}\leq 1/\ell" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>y</mi></msub><mo>≤</mo><mrow><mn>1</mn><mo>/</mo><mi mathvariant="normal">ℓ</mi></mrow></mrow><annotation encoding="application/x-tex">\eta_{y}\leq 1/\ell</annotation></semantics></math>,</span></p>
<table id="A4.EGx99" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex162"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex162.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{y}_{K+1}-y^{*}(x)\right\|^{2}\leq" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{y}_{K+1}-y^{*}(x)\right\|^{2}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex162.m2" class="ltx_Math" alttext="\displaystyle(1-\eta_{y}\mu)^{K+1}\left\|\hat{y}_{0}-y^{*}(x)\right\|^{2}+\eta_{y}^{2}\sum_{k=0}^{K}(1-\eta_{y}\mu)^{K-k}\left\|\omega_{k}\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>η</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>+</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mn>0</mn></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msubsup><mi>η</mi><mi>y</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>K</mi></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>η</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><msub><mi>ω</mi><mi>k</mi></msub><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle(1-\eta_{y}\mu)^{K+1}\left\|\hat{y}_{0}-y^{*}(x)\right\|^{2}+\eta_{y}^{2}\sum_{k=0}^{K}(1-\eta_{y}\mu)^{K-k}\left\|\omega_{k}\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex163"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex163.m1" class="ltx_math_unparsed" alttext="\displaystyle-2\eta_{y}\sum_{k=0}^{K}(1-\eta_{y}\mu)^{K-k}\langle\hat{y}_{k}-y^{*}(x)-\eta_{y}\nabla_{y}f(x,\hat{y}_{k}),\omega_{k}\rangle." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>2</mn><msub><mi>η</mi><mi>y</mi></msub><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mi>K</mi></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>η</mi><mi>y</mi></msub><mi>μ</mi><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mi>k</mi></mrow></msup><mrow><mo stretchy="false">⟨</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>k</mi></msub><mo>−</mo><msup><mi>y</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>η</mi><mi>y</mi></msub><msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>y</mi></msub><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>ω</mi><mi>k</mi></msub><mo stretchy="false">⟩</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle-2\eta_{y}\sum_{k=0}^{K}(1-\eta_{y}\mu)^{K-k}\langle\hat{y}_{k}-y^{*}(x)-\eta_{y}\nabla_{y}f(x,\hat{y}_{k}),\omega_{k}\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmlem1.p1.3" class="ltx_p"><span id="A4.Thmlem1.p1.3.1" class="ltx_text ltx_font_italic">where <math id="A4.Thmlem1.p1.m10" class="ltx_Math" alttext="\omega_{k}=\hat{g}_{y,k}-\nabla_{y}f(x,\hat{y}_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>ω</mi><mi>k</mi></msub><mo>=</mo><mrow><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>y</mi></msub><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\omega_{k}=\hat{g}_{y,k}-\nabla_{y}f(x,\hat{y}_{k})</annotation></semantics></math> and <math id="A4.Thmlem1.p1.m11" class="ltx_Math" alttext="y^{*}(x)=\argmin_{y\in{\mathbb{R}}^{d_{y}}}\hat{f}(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mrow><mi mathvariant="normal">y</mi><mo>∈</mo><msup><mi>ℝ</mi><msub><mi mathvariant="normal">d</mi><mi mathvariant="normal">y</mi></msub></msup></mrow></msub><mo>⁡</mo><mover accent="true"><mi mathvariant="normal">f</mi><mo>^</mo></mover></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">x</mi><mo>,</mo><mi mathvariant="normal">y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y^{*}(x)=\argmin_{y\in{\mathbb{R}}^{d_{y}}}\hat{f}(x,y)</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS1.p2" class="ltx_para ltx_noindent">
<p id="A4.SS1.p2.1" class="ltx_p"><span id="A4.SS1.p2.1.1" class="ltx_text">Using the update rule of <math id="A4.SS1.p2.m1" class="ltx_Math" alttext="\hat{y}_{k}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>k</mi></msub><annotation encoding="application/x-tex">\hat{y}_{k}</annotation></semantics></math>, we have</span></p>
<table id="A4.EGx100" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex164"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex164.m1" class="ltx_Math" alttext="\displaystyle\left\|\hat{y}_{k+1}-y^{*}(x)\right\|^{2}=" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left\|\hat{y}_{k+1}-y^{*}(x)\right\|^{2}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex164.m2" class="ltx_Math" alttext="\displaystyle\left\|\hat{y}_{k}-\eta_{y}\hat{g}_{y,k}-y^{*}(x)\right\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>y</mi><mo>^</mo></mover><mi>k</mi></msub><mo>−</mo><mrow><msub><mi>η</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mrow><mi>y</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow><mo>−</mo><mrow><msup><mi>y</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\left\|\hat{y}_{k}-\eta_{y}\hat{g}_{y,k}-y^{*}(x)\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex165"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex165.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
