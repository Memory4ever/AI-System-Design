<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex89.m1" class="ltx_Math" alttext="\displaystyle+D_{3}\eta_{x}+12\left(\frac{\left\|\nabla{\mathcal{L}}_{\lambda}^{*}(x_{0})\right\|}{T}+\eta_{x}D_{3}\right)\ln\left(\frac{2}{\delta}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><msub><mi>D</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>η</mi><mi>x</mi></msub></mrow></mrow><mo>+</mo><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi><mo>∗</mo></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>T</mi></mfrac></mstyle><mo>+</mo><mrow><msub><mi>η</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>D</mi><mn>3</mn></msub></mrow></mrow><mo>)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>ln</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>δ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+D_{3}\eta_{x}+12\left(\frac{\left\|\nabla{\mathcal{L}}_{\lambda}^{*}(x_{0})\right\|}{T}+\eta_{x}D_{3}\right)\ln\left(\frac{2}{\delta}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p4.3" class="ltx_p"><span id="A2.SS2.p4.3.1" class="ltx_text">Note that <math id="A2.SS2.p4.m11" class="ltx_Math" alttext="{\mathcal{L}}_{\lambda}^{*}(x_{0})-{\mathcal{L}}_{\lambda}^{*}(x_{T})\leq 3\Delta" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>λ</mi><mo>∗</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>T</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi></mrow></mrow><annotation encoding="application/x-tex">{\mathcal{L}}_{\lambda}^{*}(x_{0})-{\mathcal{L}}_{\lambda}^{*}(x_{T})\leq 3\Delta</annotation></semantics></math> and we choose <math id="A2.SS2.p4.m12" class="ltx_Math" alttext="\eta_{x}=\sqrt{\Delta/D_{3}T}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>x</mi></msub><mo>=</mo><msqrt><mrow><mrow><mi mathvariant="normal">Δ</mi><mo>/</mo><msub><mi>D</mi><mn>3</mn></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></msqrt></mrow><annotation encoding="application/x-tex">\eta_{x}=\sqrt{\Delta/D_{3}T}</annotation></semantics></math>, then with probability at least <math id="A2.SS2.p4.m13" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>, one has</span></p>
