<p id="A4.Thmlem3.p1.5" class="ltx_p"><span id="A4.Thmlem3.p1.5.1" class="ltx_text ltx_font_italic">with probability at least <math id="A4.Thmlem3.p1.m14" class="ltx_Math" alttext="1-\hat{\delta}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mover accent="true"><mi>δ</mi><mo>^</mo></mover></mrow><annotation encoding="application/x-tex">1-\hat{\delta}</annotation></semantics></math>.</span></p>
