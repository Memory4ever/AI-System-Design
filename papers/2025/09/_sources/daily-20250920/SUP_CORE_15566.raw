<td id="S4.T1.5.2.2" class="ltx_td ltx_align_left ltx_border_t">ShowUI-Desktop <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib35" title="" class="ltx_ref">35</a>]</cite></td>
<td id="S4.T1.5.2.3" class="ltx_td ltx_align_center ltx_border_t">1K</td></tr>
