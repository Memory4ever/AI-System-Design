<span id="S2.T1.4.1.1.1.2.8" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:-0.4pt 2.0pt;">100%</span></span>
<span id="S2.T1.4.1.1.1.3" class="ltx_tr">
<span id="S2.T1.4.1.1.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:-0.4pt 2.0pt;"><span id="S2.T1.4.1.1.1.3.1.1" class="ltx_text ltx_font_bold">Model Architecture</span></span>
<span id="S2.T1.4.1.1.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">SSIM<math id="S2.T1.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math> / LPIPS<math id="S2.T1.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
<span id="S2.T1.4.1.1.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">SSIM<math id="S2.T1.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math> / LPIPS<math id="S2.T1.m4" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span>
