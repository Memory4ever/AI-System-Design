<span id="S2.T2.2.1.1.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding:-0.4pt 2.0pt;"><span id="S2.T2.2.1.1.1.6.1.1" class="ltx_text ltx_font_bold">SRFormer</span></span>
<span id="S2.T2.2.1.1.1.6.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">26.15 / 0.6884</span>
<span id="S2.T2.2.1.1.1.6.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">26.56 / 0.7109</span>
<span id="S2.T2.2.1.1.1.6.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">26.73 / 0.7157</span>
<span id="S2.T2.2.1.1.1.6.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">26.77 / 0.7188</span>
<span id="S2.T2.2.1.1.1.6.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">26.82 / 0.7219</span>
<span id="S2.T2.2.1.1.1.6.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:-0.4pt 2.0pt;">26.85 / 0.7227</span>
<span id="S2.T2.2.1.1.1.6.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">27.05 / 0.7297</span></span>
<span id="S2.T2.2.1.1.1.7" class="ltx_tr">
<span id="S2.T2.2.1.1.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r ltx_border_t" style="padding:-0.4pt 2.0pt;"><span id="S2.T2.2.1.1.1.7.1.1" class="ltx_text ltx_font_bold">HiTSR</span></span>
<span id="S2.T2.2.1.1.1.7.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:-0.4pt 2.0pt;">26.17 / 0.6895</span>
<span id="S2.T2.2.1.1.1.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:-0.4pt 2.0pt;">26.48 / 0.7081</span>
<span id="S2.T2.2.1.1.1.7.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:-0.4pt 2.0pt;">26.68 / 0.7134</span>
<span id="S2.T2.2.1.1.1.7.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:-0.4pt 2.0pt;">26.75 / 0.7167</span>
