<span id="S2.T1.4.1.1.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.4pt 2.0pt;"><span id="S2.T1.4.1.1.1.1.2.1" class="ltx_text ltx_font_bold">7</span></span>
<span id="S2.T1.4.1.1.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.4pt 2.0pt;"><span id="S2.T1.4.1.1.1.1.3.1" class="ltx_text ltx_font_bold">35</span></span>
<span id="S2.T1.4.1.1.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.4pt 2.0pt;"><span id="S2.T1.4.1.1.1.1.4.1" class="ltx_text ltx_font_bold">70</span></span>
<span id="S2.T1.4.1.1.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.4pt 2.0pt;"><span id="S2.T1.4.1.1.1.1.5.1" class="ltx_text ltx_font_bold">140</span></span>
<span id="S2.T1.4.1.1.1.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.4pt 2.0pt;"><span id="S2.T1.4.1.1.1.1.6.1" class="ltx_text ltx_font_bold">280</span></span>
<span id="S2.T1.4.1.1.1.1.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:-0.4pt 2.0pt;"><span id="S2.T1.4.1.1.1.1.7.1" class="ltx_text ltx_font_bold">420</span></span>
<span id="S2.T1.4.1.1.1.1.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt" style="padding:-0.4pt 2.0pt;"><span id="S2.T1.4.1.1.1.1.8.1" class="ltx_text ltx_font_bold">FULL</span></span></span>
<span id="S2.T1.4.1.1.1.2" class="ltx_tr">
<span id="S2.T1.4.1.1.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r" style="padding:-0.4pt 2.0pt;"><span id="S2.T1.4.1.1.1.2.1.1" class="ltx_text ltx_font_bold">Ratio</span></span>
<span id="S2.T1.4.1.1.1.2.2" class="ltx_td ltx_align_center" style="padding:-0.4pt 2.0pt;">0.07%</span>
