<span id="S2.T2.2.1.1.1.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">24.89 / 0.6935</span>
<span id="S2.T2.2.1.1.1.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">25.10 / 0.7085</span>
<span id="S2.T2.2.1.1.1.5.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">25.17 / 0.7157</span>
<span id="S2.T2.2.1.1.1.5.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">25.29 / 0.7161</span>
<span id="S2.T2.2.1.1.1.5.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">25.35 / 0.7185</span>
<span id="S2.T2.2.1.1.1.5.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:-0.4pt 2.0pt;">25.39 / 0.7212</span>
<span id="S2.T2.2.1.1.1.5.8" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding:-0.4pt 2.0pt;">25.73 / 0.7355</span></span>
