<p id="S6.F3.4" class="ltx_p ltx_figure_panel ltx_align_center"><math id="S6.F3.m7" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> <span id="S6.F3.4.1" class="ltx_text ltx_font_bold">Secure Aggregation</span> <math id="S6.F3.m8" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
