<span id="S6.F3.5.1" class="ltx_inline-block ltx_minipage ltx_align_middle ltx_framed ltx_framed_rectangle" style="width:345.0pt;">
<span id="S6.F3.5.1.1" class="ltx_p ltx_align_center"><span id="S6.F3.5.1.1.1" class="ltx_text ltx_font_bold">Federated Server (Privacy-Preserving Aggregation)
<br class="ltx_break" style="--ltx-break-space:8.5pt;"></span>

<span id="S6.F3.5.1.1.2" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<span class="ltx_thead">
<span id="S6.F3.5.1.1.2.1" class="ltx_tr">
<span id="S6.F3.5.1.1.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_r"><span id="S6.F3.5.1.1.2.1.1.1" class="ltx_text ltx_font_bold">Global Model Synthesis</span></span>
<span id="S6.F3.5.1.1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r"><span id="S6.F3.5.1.1.2.1.2.1" class="ltx_text ltx_font_bold">Heat-Kernel Fusion</span></span>
<span id="S6.F3.5.1.1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S6.F3.5.1.1.2.1.3.1" class="ltx_text ltx_font_bold">Privacy Protection</span></span></span>
</span>
<span class="ltx_tbody">
<span id="S6.F3.5.1.1.2.2" class="ltx_tr">
<span id="S6.F3.5.1.1.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t"><math id="S6.F3.m9" class="ltx_Math" alttext="\mathbf{A}_{global}^{h}=\sum_{p=1}^{2}w_{p}\mathbf{A}_{[p]}^{h}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐀</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mi>h</mi></msubsup><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><msub><mi>w</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>𝐀</mi><mrow><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo></mrow><mi>h</mi></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{A}_{global}^{h}=\sum_{p=1}^{2}w_{p}\mathbf{A}_{[p]}^{h}</annotation></semantics></math></span>
<span id="S6.F3.5.1.1.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="S6.F3.m10" class="ltx_Math" alttext="\bm{\delta}_{global}=\mathcal{F}(\bm{\delta}_{[1]},\bm{\delta}_{[2]})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝜹</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝜹</mi><mrow><mo stretchy="false">[</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></msub><mo>,</mo><msub><mi>𝜹</mi><mrow><mo stretchy="false">[</mo><mn>2</mn><mo stretchy="false">]</mo></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{\delta}_{global}=\mathcal{F}(\bm{\delta}_{[1]},\bm{\delta}_{[2]})</annotation></semantics></math></span>
<span id="S6.F3.5.1.1.2.2.3" class="ltx_td ltx_align_center ltx_border_t">Differential Privacy: <math id="S6.F3.m11" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>-DP</span></span>
<span id="S6.F3.5.1.1.2.3" class="ltx_tr">
<span id="S6.F3.5.1.1.2.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r"><math id="S6.F3.m12" class="ltx_Math" alttext="\mathbf{V}_{global}=\sum_{p=1}^{2}w_{p}\mathbf{V}_{[p]}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐕</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>p</mi><mo>=</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mrow><msub><mi>w</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐕</mi><mrow><mo stretchy="false">[</mo><mi>p</mi><mo stretchy="false">]</mo></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{V}_{global}=\sum_{p=1}^{2}w_{p}\mathbf{V}_{[p]}</annotation></semantics></math></span>
<span id="S6.F3.5.1.1.2.3.2" class="ltx_td ltx_align_center ltx_border_r">Heat Diffusion Alignment</span>
<span id="S6.F3.5.1.1.2.3.3" class="ltx_td ltx_align_center">Secure Multi-Party Computation</span></span>
</span>
</span></span>
<span id="S6.F3.5.1.2" class="ltx_p ltx_align_center"><span id="S6.F3.5.1.2.1" class="ltx_text ltx_font_bold">Convergence:</span> <math id="S6.F3.m13" class="ltx_Math" alttext="\|J_{t+1}-J_{t}\|&lt;\epsilon_{convergence}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>J</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>J</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mo>&lt;</mo><msub><mi>ϵ</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\|J_{t+1}-J_{t}\|&lt;\epsilon_{convergence}</annotation></semantics></math></span>
</span></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="S6.F3.6" class="ltx_p ltx_figure_panel ltx_align_center"><math id="S6.F3.m14" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math> <span id="S6.F3.6.1" class="ltx_text ltx_font_bold">Global Model Distribution</span> <math id="S6.F3.m15" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></p></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
