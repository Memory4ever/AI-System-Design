<td id="S6.F10.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.F10.2.1.2.1" class="ltx_text ltx_font_bold">FedMV-KMeans</span></td>
<td id="S6.F10.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.F10.2.1.3.1" class="ltx_text ltx_font_bold">FedHK-MVFC</span></td>
<td id="S6.F10.2.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.F10.2.1.4.1" class="ltx_text ltx_font_bold">Reduction</span></td></tr>
