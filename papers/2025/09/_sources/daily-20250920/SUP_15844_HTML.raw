<span id="S6.F3.7.1.1.2.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.F3.7.1.1.2.1.3.1" class="ltx_text ltx_font_bold">Hospital B</span></span>
<span id="S6.F3.7.1.1.2.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.F3.7.1.1.2.1.4.1" class="ltx_text ltx_font_bold">Clinical Characteristics</span></span></span>
