<td id="S0.T1.2.8.8" class="ltx_td ltx_align_center ltx_border_r">✓</td>
<td id="S0.T1.2.8.9" class="ltx_td ltx_align_center">✗</td>
<td id="S0.T1.2.8.10" class="ltx_td ltx_align_center">✓</td></tr>
<tr id="S0.T1.2.9" class="ltx_tr">
<td id="S0.T1.2.9.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r ltx_border_t">
