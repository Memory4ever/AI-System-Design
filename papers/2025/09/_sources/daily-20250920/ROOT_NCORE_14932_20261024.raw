<td id="S0.T1.2.8.2" class="ltx_td ltx_align_center">Universal</td>
<td id="S0.T1.2.8.3" class="ltx_td ltx_align_center ltx_border_r">Multiple</td>
<td id="S0.T1.2.8.4" class="ltx_td ltx_align_center">✓</td>
