<td id="S6.T1.3.5.5" class="ltx_td ltx_align_center"><span id="S6.T1.3.5.5.1" class="ltx_text" style="font-size:80%;">0.6279</span></td></tr>
<tr id="S6.T1.3.6" class="ltx_tr">
