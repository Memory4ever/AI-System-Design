<th id="S6.T1.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_r ltx_border_tt"><span id="S6.T1.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">#PoV</span></th>
<th id="S6.T1.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S6.T1.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Accuracy</span></th>
