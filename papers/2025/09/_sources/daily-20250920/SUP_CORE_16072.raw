<th id="S6.T1.3.11.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb"><span id="S6.T1.3.11.1.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#FFEBEB;">(ours)</span></th>
