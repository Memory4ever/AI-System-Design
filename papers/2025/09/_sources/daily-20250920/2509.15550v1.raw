<td id="S4.T2.5.1.12.6" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.12.6.1" class="ltx_text" style="font-size:120%;">67.30</span></td>
<td id="S4.T2.5.1.12.7" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T2.5.1.12.7.1" class="ltx_text" style="font-size:120%;">66.67</span></td>
<td id="S4.T2.5.1.12.8" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.12.8.1" class="ltx_text" style="font-size:120%;">93.90</span></td>
<td id="S4.T2.5.1.12.9" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T2.5.1.12.9.1" class="ltx_text" style="font-size:120%;">89.41</span></td>
<td id="S4.T2.5.1.12.10" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.12.10.1" class="ltx_text" style="font-size:120%;">82.00</span></td>
<td id="S4.T2.5.1.12.11" class="ltx_td ltx_align_center"><span id="S4.T2.5.1.12.11.1" class="ltx_text" style="font-size:120%;">77.57</span></td></tr>
<tr id="S4.T2.5.1.13" class="ltx_tr">
<td id="S4.T2.5.1.13.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r"><span id="S4.T2.5.1.13.1.1" class="ltx_text ltx_font_bold">DNA-DetectLLM</span></td>
<td id="S4.T2.5.1.13.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.5.1.13.2.1" class="ltx_text ltx_font_bold" style="font-size:120%;">91.74</span></td>
<td id="S4.T2.5.1.13.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T2.5.1.13.3.1" class="ltx_text ltx_font_bold" style="font-size:120%;">87.72</span></td>
