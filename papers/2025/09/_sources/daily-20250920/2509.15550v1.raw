<span id="S4.T1.5.1.2.4.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Turbo</span></span>
</span></span><span id="S4.T1.5.1.2.4.3" class="ltx_text"></span></td>
<td id="S4.T1.5.1.2.5" class="ltx_td ltx_align_center"><span id="S4.T1.5.1.2.5.1" class="ltx_text"></span> <span id="S4.T1.5.1.2.5.2" class="ltx_text">
<span id="S4.T1.5.1.2.5.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.5.1.2.5.2.1.1" class="ltx_tr">
<span id="S4.T1.5.1.2.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center">Gemini-2.0</span></span>
<span id="S4.T1.5.1.2.5.2.1.2" class="ltx_tr">
<span id="S4.T1.5.1.2.5.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center">Flash</span></span>
</span></span><span id="S4.T1.5.1.2.5.3" class="ltx_text"></span></td>
<td id="S4.T1.5.1.2.6" class="ltx_td ltx_align_center ltx_border_r"><span id="S4.T1.5.1.2.6.1" class="ltx_text"></span> <span id="S4.T1.5.1.2.6.2" class="ltx_text">
<span id="S4.T1.5.1.2.6.2.1" class="ltx_tabular ltx_align_middle">
<span id="S4.T1.5.1.2.6.2.1.1" class="ltx_tr">
