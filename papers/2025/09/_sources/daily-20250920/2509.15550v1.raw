<td id="S4.T2.5.1.13.6" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T2.5.1.13.6.1" class="ltx_text ltx_font_bold" style="font-size:120%;">88.23</span></td>
<td id="S4.T2.5.1.13.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><span id="S4.T2.5.1.13.7.1" class="ltx_text ltx_font_bold" style="font-size:120%;">84.94</span></td>
