<figure id="S3.F2.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2509.15667v1/images/mean_correlation_by_layer_full.png" id="S3.F2.sf2.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:238/139;" width="238" height="139" alt="Refer to caption">
