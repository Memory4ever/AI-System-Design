<figure id="S3.T3" class="ltx_table">
<table id="S3.T3.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S3.T3.2.1" class="ltx_tr">
<th id="S3.T3.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_rr"><span id="S3.T3.2.1.1.1" class="ltx_text ltx_font_bold">Dataset</span></th>
<th id="S3.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r" colspan="2"><span id="S3.T3.2.1.2.1" class="ltx_text ltx_font_bold">VoxKrikri-1</span></th>
<th id="S3.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r" colspan="2"><span id="S3.T3.2.1.3.1" class="ltx_text ltx_font_bold">VoxKrikri-9</span></th>
<th id="S3.T3.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r" colspan="2"><span id="S3.T3.2.1.4.1" class="ltx_text ltx_font_bold">VoxKrikri-15</span></th>
<th id="S3.T3.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r" colspan="2"><span id="S3.T3.2.1.5.1" class="ltx_text ltx_font_bold">VoxKrikri-21</span></th>
<th id="S3.T3.2.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_rr" colspan="2"><span id="S3.T3.2.1.6.1" class="ltx_text ltx_font_bold">VoxKrikri-30</span></th>
<th id="S3.T3.2.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column"><span id="S3.T3.2.1.7.1" class="ltx_text ltx_font_bold">Whisper-large-v3</span></th></tr>
<tr id="S3.T3.2.2" class="ltx_tr">
<th id="S3.T3.2.2.1" class="ltx_td ltx_th ltx_th_column ltx_border_rr"></th>
