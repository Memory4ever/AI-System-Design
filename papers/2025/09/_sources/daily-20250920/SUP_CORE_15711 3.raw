</span></span>
<span id="S4.T2.2.1.1.1.1.1.1.1.1.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt" style="padding-left:0.0pt;padding-right:0.0pt;">
<span id="S4.T2.2.1.1.1.1.1.1.1.1.7.1" class="ltx_inline-block ltx_align_top" style="width:54.1pt;">
<span id="S4.T2.2.1.1.1.1.1.1.1.1.7.1.1" class="ltx_p ltx_align_center">X-ray</span>
</span></span>
<span id="S4.T2.2.1.1.1.1.1.1.1.1.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt" style="padding-left:0.0pt;padding-right:0.0pt;">
<span id="S4.T2.2.1.1.1.1.1.1.1.1.8.1" class="ltx_inline-block ltx_align_top" style="width:54.1pt;">
<span id="S4.T2.2.1.1.1.1.1.1.1.1.8.1.1" class="ltx_p ltx_align_center">Mean</span>
</span></span></span>
</span>
<span class="ltx_tbody">
