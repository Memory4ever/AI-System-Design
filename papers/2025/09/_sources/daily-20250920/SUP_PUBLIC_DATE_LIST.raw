        [<a href="/pdf/2610.12341" title="Download PDF" id="pdf-2610.12341" aria-labelledby="pdf-2610.12341">pdf</a>, <a href="https://arxiv.org/html/2610.12341v1" title="View HTML" id="html-2610.12341" aria-labelledby="html-2610.12341" rel="noopener noreferrer" target="_blank">html</a>, <a href="/format/2610.12341" title="Other formats" id="oth-2610.12341" aria-labelledby="oth-2610.12341">other</a>]
