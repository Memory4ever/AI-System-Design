lstnumberx115.71" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">rapidly</span><span id="lstnumberx115.72" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx115.73" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">dividing</span><span id="lstnumberx115.74" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx115.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">cells</span><span id="lstnumberx115.76" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span><span id="lstnumberx115.77" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx115.78" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">such</span><span id="lstnumberx115.79" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx115.80" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">as</span><span id="lstnumberx115.81" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx115.82" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">cancer</span><span id="lstnumberx115.83" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx115.84" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">cells</span><span id="lstnumberx115.85" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span>
