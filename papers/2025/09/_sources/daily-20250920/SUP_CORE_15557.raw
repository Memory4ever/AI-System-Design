<tr id="S6.T4.2.1.4" class="ltx_tr">
<th id="S6.T4.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">0.5</th>
