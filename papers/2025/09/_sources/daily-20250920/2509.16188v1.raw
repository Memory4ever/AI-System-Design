<figure id="Sx8.F7.sf6" class="ltx_figure ltx_figure_panel"><img src="2509.16188v1/Core-Values-and-Social-Structures-ch.png" id="Sx8.F7.sf6.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:698/269;" width="698" height="269" alt="Refer to caption">
