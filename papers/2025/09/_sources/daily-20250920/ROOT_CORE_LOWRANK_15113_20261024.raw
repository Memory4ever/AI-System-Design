updated <math id="alg2.l2.m1" class="ltx_Math" alttext="\theta_{1}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\theta_{1}</annotation></semantics></math>, <math id="alg2.l2.m2" class="ltx_Math" alttext="\bm{\omega}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝝎</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\bm{\omega}_{1}</annotation></semantics></math>, and <math id="alg2.l2.m3" class="ltx_Math" alttext="\bm{\phi}_{1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\bm{\phi}_{1}</annotation></semantics></math>


