            <math id="alg2.l4.m1" class="ltx_Math" alttext="\bm{x}_{in}\leftarrow\text{NN}_{\text{before}}(\bm{x})" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒙</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mtext>NN</mtext><mtext>before</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{x}_{in}\leftarrow\text{NN}_{\text{before}}(\bm{x})</annotation></semantics></math>
