<th id="S3.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.2.1.2.1" class="ltx_text ltx_font_bold">Size (#docs)</span></th>
<th id="S3.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T1.2.1.3.1" class="ltx_text ltx_font_bold">Avg #Words</span></th>
