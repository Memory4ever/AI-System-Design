<td id="S4.T5.5.3.5" class="ltx_td ltx_align_center"><span id="S4.T5.5.3.5.1" class="ltx_text" style="font-size:70%;">51.10</span></td></tr>
<tr id="S4.T5.5.4" class="ltx_tr">
