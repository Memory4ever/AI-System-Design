<td id="S4.T5.5.2.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" rowspan="3"><span id="S4.T5.5.2.4.1" class="ltx_text" style="font-size:70%;">20,000</span></td>
<td id="S4.T5.5.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T5.5.2.5.1" class="ltx_text" style="font-size:70%;">44.43</span></td>
<td id="S4.T5.5.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T5.5.2.6.1" class="ltx_text" style="font-size:70%;">54.81</span></td>
<td id="S4.T5.5.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T5.5.2.7.1" class="ltx_text" style="font-size:70%;">49.62</span></td></tr>
<tr id="S4.T5.5.3" class="ltx_tr">
<td id="S4.T5.5.3.1" class="ltx_td ltx_align_left"><span id="S4.T5.5.3.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:70%;">OCE-Lazy-FT</span></td>
<td id="S4.T5.5.3.2" class="ltx_td ltx_align_left"><span id="S4.T5.5.3.2.1" class="ltx_text" style="font-size:70%;">Lazy</span></td>
