<td id="S4.T1.6.5.3" class="ltx_td ltx_align_center"><span id="S4.T1.6.5.3.1" class="ltx_text" style="font-size:70%;">58.52</span></td>
<td id="S4.T1.6.5.4" class="ltx_td ltx_align_center"><span id="S4.T1.6.5.4.1" class="ltx_text" style="font-size:70%;">51.76</span></td></tr>
<tr id="S4.T1.6.6" class="ltx_tr">
