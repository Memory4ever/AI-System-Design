<th id="A2.T3.5.1.6.3" class="ltx_td ltx_align_left ltx_th ltx_th_row">64x64</th>
<td id="A2.T3.5.1.6.4" class="ltx_td ltx_align_left">5000000</td>
<td id="A2.T3.5.1.6.5" class="ltx_td ltx_align_left">1000000</td>
<td id="A2.T3.5.1.6.6" class="ltx_td ltx_align_left">2</td>
<td id="A2.T3.5.1.6.7" class="ltx_td ltx_align_left">2500000</td></tr>
<tr id="A2.T3.5.1.7" class="ltx_tr">
<th id="A2.T3.5.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="A2.T3.5.1.7.1.1" class="ltx_text ltx_font_sansserif">Polygons</span></th>
<th id="A2.T3.5.1.7.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">1</th>
