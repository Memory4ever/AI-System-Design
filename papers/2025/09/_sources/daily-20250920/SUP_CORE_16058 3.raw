<tr id="A2.T3.5.1.9" class="ltx_tr">
<th id="A2.T3.5.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="A2.T3.5.1.9.1.1" class="ltx_text ltx_font_sansserif">Places365</span></th>
<th id="A2.T3.5.1.9.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">3</th>
<th id="A2.T3.5.1.9.3" class="ltx_td ltx_align_left ltx_th ltx_th_row">256x256</th>
<td id="A2.T3.5.1.9.4" class="ltx_td ltx_align_left">1803460</td>
