<th id="A2.T3.5.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="A2.T3.5.1.5.1.1" class="ltx_text ltx_font_sansserif">SVHN</span></th>
<th id="A2.T3.5.1.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">3</th>
