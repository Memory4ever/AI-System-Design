<td id="S6.T1.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S6.T1.1.1.2.1" class="ltx_text ltx_font_bold">Specs</span></td>
<th id="S6.T1.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t"><span id="S6.T1.1.1.3.1" class="ltx_text ltx_font_bold">Component</span></th>
<td id="S6.T1.1.1.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S6.T1.1.1.4.1" class="ltx_text ltx_font_bold">Specs</span></td></tr>
