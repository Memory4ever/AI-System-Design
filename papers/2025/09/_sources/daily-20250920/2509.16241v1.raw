<tr id="S7.T2.2.4" class="ltx_tr">
<td id="S7.T2.2.4.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">PaLM 2-L</td>
<td id="S7.T2.2.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">34.3%</td></tr>
<tr id="S7.T2.2.5" class="ltx_tr">
<td id="S7.T2.2.5.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Claude 2</td>
<td id="S7.T2.2.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">37.6%</td></tr>
<tr id="S7.T2.2.6" class="ltx_tr">
<td id="S7.T2.2.6.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Codex Zero-Shot †</td>
