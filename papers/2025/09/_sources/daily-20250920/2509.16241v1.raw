<span id="A2.T5.2.5.4.1.1" class="ltx_p">1.714285714</span>
</span></td></tr>
<tr id="A2.T5.2.6" class="ltx_tr">
<th id="A2.T5.2.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t">5</th>
