<tr id="S7.T2.2.7" class="ltx_tr">
<td id="S7.T2.2.7.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Codex Few-Shot †</td>
<td id="S7.T2.2.7.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">81.1%</td></tr>
<tr id="S7.T2.2.8" class="ltx_tr">
<td id="S7.T2.2.8.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">REAMS Zero-Shot †</td>
<td id="S7.T2.2.8.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S7.T2.2.8.2.1" class="ltx_text ltx_font_bold">75.55%</span></td></tr>
<tr id="S7.T2.2.9" class="ltx_tr">
<td id="S7.T2.2.9.1" class="ltx_td ltx_border_l ltx_border_r"></td>
<td id="S7.T2.2.9.2" class="ltx_td ltx_align_center ltx_border_r"><span id="S7.T2.2.9.2.1" class="ltx_text" style="font-size:90%;">(0.65-0.84)</span></td></tr>
<tr id="S7.T2.2.10" class="ltx_tr">
<td id="S7.T2.2.10.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">REAMS Zero-Shot + Reasoning †</td>
