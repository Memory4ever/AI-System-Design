<figure id="A2.T4" class="ltx_table">
<table id="A2.T4.2" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A2.T4.2.1" class="ltx_tr">
<th id="A2.T4.2.1.1" class="ltx_td ltx_align_left ltx_align_middle ltx_th ltx_th_column ltx_border_l ltx_border_r ltx_border_t">
