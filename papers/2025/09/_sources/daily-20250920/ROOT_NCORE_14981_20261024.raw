<td id="S5.T3.7.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span id="S5.T3.7.2.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">-1.016</span></td></tr>
<tr id="S5.T3.7.3" class="ltx_tr">
<td id="S5.T3.7.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T3.7.3.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:80%;">SpatialGen</span></td>
