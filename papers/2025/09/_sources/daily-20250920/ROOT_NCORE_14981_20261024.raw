<td id="S5.T2.7.8.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb"><span id="S5.T2.7.8.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">26.84</span></td>
