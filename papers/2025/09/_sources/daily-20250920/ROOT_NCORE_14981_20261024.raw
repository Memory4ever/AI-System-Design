<td id="S5.T3.7.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span id="S5.T3.7.4.2.1" class="ltx_text" style="font-size:80%;">Ctrl-Room <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib8" title="" class="ltx_ref">8</a>]</cite></span></td>
<td id="S5.T3.7.4.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span id="S5.T3.7.4.3.1" class="ltx_text" style="font-size:80%;">22.63</span></td>
<td id="S5.T3.7.4.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span id="S5.T3.7.4.4.1" class="ltx_text" style="font-size:80%;">-1.546</span></td></tr>
<tr id="S5.T3.7.5" class="ltx_tr">
<td id="S5.T3.7.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb"><span id="S5.T3.7.5.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:80%;">SpatialGen</span></td>
