<th id="S5.T2.7.1.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_tt"><span id="S5.T2.7.1.1.1" class="ltx_text" style="font-size:80%;">Dataset</span></th>
<td id="S5.T2.7.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt"><span id="S5.T2.7.1.2.1" class="ltx_text" style="font-size:80%;">Method</span></td>
<td id="S5.T2.7.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt"><span id="S5.T2.7.1.3.1" class="ltx_text" style="font-size:80%;">CLIP Sim. (%) <math id="S5.T2.m1" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S5.T2.7.1.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_tt"><span id="S5.T2.7.1.4.1" class="ltx_text" style="font-size:80%;">Image Reward <math id="S5.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
