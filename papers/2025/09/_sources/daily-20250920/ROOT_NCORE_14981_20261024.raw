<td id="S5.T2.7.2.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span id="S5.T2.7.2.3.1" class="ltx_text" style="font-size:80%;">25.18</span></td>
<td id="S5.T2.7.2.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span id="S5.T2.7.2.4.1" class="ltx_text" style="font-size:80%;">-2.005</span></td></tr>
<tr id="S5.T2.7.3" class="ltx_tr">
<td id="S5.T2.7.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.3.1.1" class="ltx_text" style="font-size:80%;">SceneCraft <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib51" title="" class="ltx_ref">51</a>]</cite></span></td>
<td id="S5.T2.7.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.3.2.1" class="ltx_text" style="font-size:80%;">26.94</span></td>
<td id="S5.T2.7.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.3.3.1" class="ltx_text" style="font-size:80%;">-1.096</span></td></tr>
<tr id="S5.T2.7.4" class="ltx_tr">
<td id="S5.T2.7.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.4.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:80%;">SpatialGen<sup id="S5.T2.7.4.1.1.1" class="ltx_sup">†</sup></span></td>
<td id="S5.T2.7.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.4.2.1" class="ltx_text" style="font-size:80%;">25.93</span></td>
<td id="S5.T2.7.4.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.4.3.1" class="ltx_text" style="font-size:80%;">-1.168</span></td></tr>
<tr id="S5.T2.7.5" class="ltx_tr">
<td id="S5.T2.7.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.5.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:80%;">SpatialGen</span></td>
<td id="S5.T2.7.5.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.5.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">27.59</span></td>
<td id="S5.T2.7.5.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.5.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">-0.285</span></td></tr>
<tr id="S5.T2.7.6" class="ltx_tr">
<th id="S5.T2.7.6.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" rowspan="3"><span id="S5.T2.7.6.1.1" class="ltx_text" style="font-size:80%;">Our Dataset</span></th>
<td id="S5.T2.7.6.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span id="S5.T2.7.6.2.1" class="ltx_text" style="font-size:80%;">Set-the-Scene <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite></span></td>
<td id="S5.T2.7.6.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span id="S5.T2.7.6.3.1" class="ltx_text" style="font-size:80%;">25.23</span></td>
<td id="S5.T2.7.6.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t"><span id="S5.T2.7.6.4.1" class="ltx_text" style="font-size:80%;">-2.100</span></td></tr>
<tr id="S5.T2.7.7" class="ltx_tr">
<td id="S5.T2.7.7.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.7.1.1" class="ltx_text" style="font-size:80%;">SceneCraft <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib51" title="" class="ltx_ref">51</a>]</cite></span></td>
<td id="S5.T2.7.7.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.7.2.1" class="ltx_text" style="font-size:80%;">18.93</span></td>
<td id="S5.T2.7.7.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><span id="S5.T2.7.7.3.1" class="ltx_text" style="font-size:80%;">-2.267</span></td></tr>
