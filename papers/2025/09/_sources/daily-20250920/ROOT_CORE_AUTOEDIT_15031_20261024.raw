<tr id="A2.T8.5.3" class="ltx_tr">
<th id="A2.T8.5.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding-left:1.4pt;padding-right:1.4pt;">SDXL</th>
<td id="A2.T8.5.3.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r" style="padding-left:1.4pt;padding-right:1.4pt;">+AutoEdit</td>
<td id="A2.T8.5.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.4pt;padding-right:1.4pt;"><span id="A2.T8.5.3.3.1" class="ltx_text ltx_font_bold">28.3</span></td></tr>
<tr id="A2.T8.5.4" class="ltx_tr">
<th id="A2.T8.5.4.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:1.4pt;padding-right:1.4pt;">SD 1.4</th>
<td id="A2.T8.5.4.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding-left:1.4pt;padding-right:1.4pt;">P2P</td>
<td id="A2.T8.5.4.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding-left:1.4pt;padding-right:1.4pt;">25.5</td></tr>
<tr id="A2.T8.5.5" class="ltx_tr">
<th id="A2.T8.5.5.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-left:1.4pt;padding-right:1.4pt;">SD 1.4</th>
<td id="A2.T8.5.5.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:1.4pt;padding-right:1.4pt;">+AutoEdit</td>
