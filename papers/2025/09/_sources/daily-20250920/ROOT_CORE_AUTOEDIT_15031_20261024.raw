<td id="A2.T7.5.3.4" class="ltx_td ltx_align_center"><span id="A2.T7.5.3.4.1" class="ltx_text ltx_font_bold">23.4</span></td>
<td id="A2.T7.5.3.5" class="ltx_td ltx_align_center ltx_border_r"><span id="A2.T7.5.3.5.1" class="ltx_text ltx_font_bold">26.1</span></td>
<td id="A2.T7.5.3.6" class="ltx_td ltx_align_center"><span id="A2.T7.5.3.6.1" class="ltx_text ltx_font_bold">1.30</span></td></tr>
