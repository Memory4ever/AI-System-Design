</mi><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi></mrow></msub><annotation encoding="application/x-tex">D_{table}</annotation></semantics></math><span id="algorithm1.6.5.6" class="ltx_text" style="font-size:80%;">);</span>
</div>
