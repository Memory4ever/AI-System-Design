</table>
</span></div>
</figure>
<figure id="S5.T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S5.T3.3" class="ltx_text" style="font-size:90%;">Table 3</span>: </span><span id="S5.T3.4" class="ltx_text" style="font-size:90%;">Experiments setting of embodied RL</span></figcaption>
<div id="S5.T3.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:404.7pt;height:66.1pt;vertical-align:-28.6pt;"><span class="ltx_transformed_inner" style="transform:translate(88.6pt,-14.5pt) scale(1.77917442107568,1.77917442107568) ;">
<table id="S5.T3.5.1" class="ltx_tabular ltx_align_middle">
<tr id="S5.T3.5.1.1" class="ltx_tr">
