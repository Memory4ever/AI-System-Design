</div>
<div id="algorithm1.6.2" class="ltx_listingline"><span id="algorithm1.6.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Output :</span><span id="algorithm1.6.2.2" class="ltx_text" style="font-size:80%;"> A worker schedule </span><math id="algorithm1.m3" class="ltx_Math" alttext="S_{best}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">S</mi><mrow><mi mathsize="0.800em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow></msub><annotation encoding="application/x-tex">S_{best}</annotation></semantics></math><span id="algorithm1.6.2.3" class="ltx_text" style="font-size:80%;"> and its estimated time </span><math id="algorithm1.m4" class="ltx_Math" alttext="T_{best}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">b</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow></msub><annotation encoding="application/x-tex">T_{best}</annotation></semantics></math><span id="algorithm1.6.2.4" class="ltx_text" style="font-size:80%;">.</span>
</div>
<div id="algorithm1.6.3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.6.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">1</span></span>
