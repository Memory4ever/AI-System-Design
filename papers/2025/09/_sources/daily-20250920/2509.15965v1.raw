<div id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold">  </span><span id="lstnumberx3.2" class="ltx_text ltx_lst_keywords3 ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#008000;">def</span><span id="lstnumberx3.3" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx3.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">recv</span><span id="lstnumberx3.5" class="ltx_text ltx_font_typewriter ltx_font_bold">(</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">self</span><span id="lstnumberx3.7" class="ltx_text ltx_font_typewriter ltx_font_bold">,</span><span id="lstnumberx3.8" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx3.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">src</span><span id="lstnumberx3.10" class="ltx_text ltx_font_typewriter ltx_font_bold">,</span><span id="lstnumberx3.11" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx3.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">async_op</span><span id="lstnumberx3.13" class="ltx_text ltx_font_typewriter ltx_font_bold">)</span>
</div>
<div id="lstnumberx4" class="ltx_listingline"><span id="lstnumberx4.1" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold">  </span><span id="lstnumberx4.2" class="ltx_text ltx_lst_keywords4 ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#B00040;">@overload</span>
</div>
<div id="lstnumberx5" class="ltx_listingline"><span id="lstnumberx5.1" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold">  </span><span id="lstnumberx5.2" class="ltx_text ltx_lst_keywords3 ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#008000;">def</span><span id="lstnumberx5.3" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx5.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">onload</span><span id="lstnumberx5.5" class="ltx_text ltx_font_typewriter ltx_font_bold">(</span><span id="lstnumberx5.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">self</span><span id="lstnumberx5.7" class="ltx_text ltx_font_typewriter ltx_font_bold">)</span>
</div>
<div id="lstnumberx6" class="ltx_listingline"><span id="lstnumberx6.1" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold">  </span><span id="lstnumberx6.2" class="ltx_text ltx_lst_keywords4 ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#B00040;">@overload</span>
</div>
<div id="lstnumberx7" class="ltx_listingline"><span id="lstnumberx7.1" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold">  </span><span id="lstnumberx7.2" class="ltx_text ltx_lst_keywords3 ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#008000;">def</span><span id="lstnumberx7.3" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx7.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">offload</span><span id="lstnumberx7.5" class="ltx_text ltx_font_typewriter ltx_font_bold">(</span><span id="lstnumberx7.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">self</span><span id="lstnumberx7.7" class="ltx_text ltx_font_typewriter ltx_font_bold">)</span>
</div>
<div id="lstnumberx8" class="ltx_listingline">
</div>
<div id="lstnumberx9" class="ltx_listingline"><span id="lstnumberx9.1" class="ltx_text ltx_lst_keywords5 ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#B00040;">class</span><span id="lstnumberx9.2" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx9.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">RolloutWorker</span><span id="lstnumberx9.4" class="ltx_text ltx_font_typewriter ltx_font_bold">(</span><span id="lstnumberx9.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">Worker</span><span id="lstnumberx9.6" class="ltx_text ltx_font_typewriter ltx_font_bold">):</span>
</div>
<div id="lstnumberx10" class="ltx_listingline"><span id="lstnumberx10.1" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold">  </span><span id="lstnumberx10.2" class="ltx_text ltx_lst_keywords3 ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#008000;">def</span><span id="lstnumberx10.3" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx10.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">generate</span><span id="lstnumberx10.5" class="ltx_text ltx_font_typewriter ltx_font_bold">(</span><span id="lstnumberx10.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">self</span><span id="lstnumberx10.7" class="ltx_text ltx_font_typewriter ltx_font_bold">,</span><span id="lstnumberx10.8" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx10.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">in_channel</span><span id="lstnumberx10.10" class="ltx_text ltx_font_typewriter ltx_font_bold">,</span><span id="lstnumberx10.11" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx10.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">out_channel</span><span id="lstnumberx10.13" class="ltx_text ltx_font_typewriter ltx_font_bold">):</span>
</div>
<div id="lstnumberx11" class="ltx_listingline"><span id="lstnumberx11.1" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold">    </span><span id="lstnumberx11.2" class="ltx_text ltx_lst_keywords3 ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#008000;">with</span><span id="lstnumberx11.3" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx11.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">out_channel</span><span id="lstnumberx11.5" class="ltx_text ltx_font_typewriter ltx_font_bold">.</span><span id="lstnumberx11.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">device_lock</span><span id="lstnumberx11.7" class="ltx_text ltx_font_typewriter ltx_font_bold">:</span>
</div>
<div id="lstnumberx12" class="ltx_listingline"><span id="lstnumberx12.1" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold">      </span><span id="lstnumberx12.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter ltx_font_bold">batch_size</span><span id="lstnumberx12.3" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx12.4" class="ltx_text ltx_font_typewriter ltx_font_bold">=</span><span id="lstnumberx12.5" class="ltx_text ltx_lst_space ltx_font_typewriter ltx_font_bold"> </span><span id="lstnumberx12.6" class="ltx_text ltx_font_typewriter ltx_font_bold">0</span>
</div>
