<td id="S3.T3.4.44.10" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EDCFCF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T3.4.44.10.1" class="ltx_text" style="font-size:50%;--ltx-bg-color:#EDCFCF;">54.4</span></td>
<td id="S3.T3.4.44.11" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EDCFCF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T3.4.44.11.1" class="ltx_text" style="font-size:50%;--ltx-bg-color:#EDCFCF;">56.3</span></td>
<td id="S3.T3.4.44.12" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T3.4.44.12.1" class="ltx_text" style="font-size:50%;">50.3</span></td>
