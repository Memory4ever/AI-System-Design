<th id="S3.T3.4.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="25"><span id="S3.T3.4.3.1.1" class="ltx_text ltx_font_bold" style="font-size:50%;">w/ images</span></th></tr>
<tr id="S3.T3.4.4" class="ltx_tr">
<th id="S3.T3.4.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T3.4.4.1.1" class="ltx_text" style="font-size:50%;">Yi-Vision-V2<cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite></span></th>
