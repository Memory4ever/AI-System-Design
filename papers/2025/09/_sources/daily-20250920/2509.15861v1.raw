<td id="A3.T5.2.1.2" class="ltx_td ltx_align_left"><span id="A3.T5.2.1.2.1" class="ltx_text ltx_font_bold">Parameter</span></td>
<td id="A3.T5.2.1.3" class="ltx_td ltx_align_left"><span id="A3.T5.2.1.3.1" class="ltx_text ltx_font_bold">Value</span></td></tr>
<tr id="A3.T5.2.2" class="ltx_tr">
<th id="A3.T5.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">ShiftScaleRotate</th>
