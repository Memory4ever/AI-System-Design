<figure id="algorithm2" class="ltx_float ltx_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="font-size:90%;"><span class="ltx_tag ltx_tag_float"><span id="algorithm2.5" class="ltx_text ltx_font_bold">Algorithm 2</span> </span>Transformation Function for ToFU</figcaption>
<div id="algorithm2.6" class="ltx_listing ltx_lst_numbers_left ltx_framed ltx_framed_topbottom ltx_listing">
<div id="algorithm2.6.1" class="ltx_listingline"><span id="algorithm2.6.1.1" class="ltx_text" style="font-size:90%;">



</span>
</div>
<div id="algorithm2.6.2" class="ltx_listingline"><span id="algorithm2.6.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Input :</span><span id="algorithm2.6.2.2" class="ltx_text" style="font-size:90%;"> Transformation intensity level </span><math id="algorithm2.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>
</div>
<div id="algorithm2.6.3" class="ltx_listingline"><span id="algorithm2.6.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Output :</span><span id="algorithm2.6.3.2" class="ltx_text" style="font-size:90%;"> Composed transformation function</span>
</div>
<div id="algorithm2.6.4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">1</span></span>
          <span id="algorithm2.6.4.2" class="ltx_text ltx_font_bold" style="font-size:90%;">Define</span><span id="algorithm2.6.4.3" class="ltx_text" style="font-size:90%;"> TRANSFORMS as an ordered list:</span>
</div>
<div id="algorithm2.6.5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">2</span></span>
          <math id="algorithm2.m2" class="ltx_Math" alttext="\mathcal{T}_{1}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mn mathsize="0.900em">1</mn></msub><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{T}_{1}\leftarrow</annotation></semantics></math><span id="algorithm2.6.5.2" class="ltx_text" style="font-size:90%;"> OneOf([HorizontalFlip, VerticalFlip, ShiftScaleRotate])</span>
</div>
<div id="algorithm2.6.6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">3</span></span>
          <math id="algorithm2.m3" class="ltx_Math" alttext="\mathcal{T}_{2}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mn mathsize="0.900em">2</mn></msub><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{T}_{2}\leftarrow</annotation></semantics></math><span id="algorithm2.6.6.2" class="ltx_text" style="font-size:90%;"> RandomBrightnessContrast</span>
</div>
<div id="algorithm2.6.7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">4</span></span>
          <math id="algorithm2.m4" class="ltx_Math" alttext="\mathcal{T}_{3}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mn mathsize="0.900em">3</mn></msub><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{T}_{3}\leftarrow</annotation></semantics></math><span id="algorithm2.6.7.2" class="ltx_text" style="font-size:90%;"> OneOf([HueSaturationValue, RandomGamma, RGBShift])</span>
</div>
<div id="algorithm2.6.8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">5</span></span>
          <math id="algorithm2.m5" class="ltx_Math" alttext="\mathcal{T}_{4}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mn mathsize="0.900em">4</mn></msub><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{T}_{4}\leftarrow</annotation></semantics></math><span id="algorithm2.6.8.2" class="ltx_text" style="font-size:90%;"> OneOf([GaussianBlur, MotionBlur, Downscale])</span>
</div>
<div id="algorithm2.6.9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;">6</span></span>
          <math id="algorithm2.m6" class="ltx_Math" alttext="\mathcal{T}_{5}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mn mathsize="0.900em">5</mn></msub><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{T}_{5}\leftarrow</annotation></semantics></math><span id="algorithm2.6.9.2" class="ltx_text" style="font-size:90%;"> OneOf([ToGray, ChannelShuffle, ColorJitter])</span>
</div>
<div id="algorithm2.6.10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.10.1" class="ltx_text ltx_font_bold" style="font-size:90%;">7</span></span>
          <math id="algorithm2.m7" class="ltx_Math" alttext="\mathcal{T}_{6}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mn mathsize="0.900em">6</mn></msub><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{T}_{6}\leftarrow</annotation></semantics></math><span id="algorithm2.6.10.2" class="ltx_text" style="font-size:90%;"> OneOf([Sharpen, Emboss, GaussNoise])</span>
</div>
<div id="algorithm2.6.11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.11.1" class="ltx_text ltx_font_bold" style="font-size:90%;">8</span></span>
          <math id="algorithm2.m8" class="ltx_Math" alttext="\mathcal{T}_{7}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mn mathsize="0.900em">7</mn></msub><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{T}_{7}\leftarrow</annotation></semantics></math><span id="algorithm2.6.11.2" class="ltx_text" style="font-size:90%;"> RandomResizedCrop</span>
</div>
<div id="algorithm2.6.12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.12.1" class="ltx_text ltx_font_bold" style="font-size:90%;">9</span></span>
          <math id="algorithm2.m9" class="ltx_Math" alttext="\mathcal{T}_{8}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mn mathsize="0.900em">8</mn></msub><mo mathsize="0.900em" stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{T}_{8}\leftarrow</annotation></semantics></math><span id="algorithm2.6.12.2" class="ltx_text" style="font-size:90%;"> CoarseDropout</span>
</div>
<div id="algorithm2.6.13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.13.1" class="ltx_text ltx_font_bold" style="font-size:90%;">10</span></span>
          <span id="algorithm2.6.13.2" class="ltx_text ltx_font_bold" style="font-size:90%;">Group transformations by function:</span>
</div>
<div id="algorithm2.6.14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.14.1" class="ltx_text ltx_font_bold" style="font-size:90%;">11</span></span>
          <span id="algorithm2.6.14.2" class="ltx_text" style="font-size:90%;">Geometric transforms </span><math id="algorithm2.m10" class="ltx_Math" alttext="\leftarrow\{\mathcal{T}_{1},\mathcal{T}_{7}\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mn mathsize="0.900em">1</mn></msub><mo mathsize="0.900em">,</mo><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒯</mi><mn mathsize="0.900em">7</mn></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\leftarrow\{\mathcal{T}_{1},\mathcal{T}_{7}\}</annotation></semantics></math><span id="algorithm2.6.14.3" class="ltx_text" style="font-size:90%;">   </span><span id="algorithm2.6.14.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;"><math id="algorithm2.m11" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> </span><span id="algorithm2.6.14.5" class="ltx_text ltx_font_typewriter" style="font-size:90%;">Spatial modifications</span>
</div>
