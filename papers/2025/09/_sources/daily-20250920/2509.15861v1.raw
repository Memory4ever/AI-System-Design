<td id="A3.T5.2.18.3" class="ltx_td ltx_align_left">(0.2, 0.5)</td></tr>
<tr id="A3.T5.2.19" class="ltx_tr">
<th id="A3.T5.2.19.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">GaussNoise</th>
<td id="A3.T5.2.19.2" class="ltx_td ltx_align_left">var_limit</td>
<td id="A3.T5.2.19.3" class="ltx_td ltx_align_left">(10.0, 50.0)</td></tr>
<tr id="A3.T5.2.20" class="ltx_tr">
<th id="A3.T5.2.20.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">RandomResizedCrop</th>
<td id="A3.T5.2.20.2" class="ltx_td ltx_align_left">scale</td>
<td id="A3.T5.2.20.3" class="ltx_td ltx_align_left">(0.5, 1.0)</td></tr>
<tr id="A3.T5.2.21" class="ltx_tr">
<th id="A3.T5.2.21.1" class="ltx_td ltx_align_center ltx_th ltx_th_row">CoarseDropout</th>
