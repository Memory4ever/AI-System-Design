<tr id="S3.T2.5.1.3" class="ltx_tr">
<td id="S3.T2.5.1.3.1" class="ltx_td ltx_align_left ltx_border_t">FT</td>
<td id="S3.T2.5.1.3.2" class="ltx_td ltx_align_center ltx_border_t">0.57</td>
<td id="S3.T2.5.1.3.3" class="ltx_td ltx_align_center ltx_border_t">-0.01</td>
<td id="S3.T2.5.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">0.58</td>
<td id="S3.T2.5.1.3.5" class="ltx_td ltx_align_center ltx_border_t">0.69</td>
<td id="S3.T2.5.1.3.6" class="ltx_td ltx_align_center ltx_border_t">0.74</td>
<td id="S3.T2.5.1.3.7" class="ltx_td ltx_align_center ltx_border_t">0.78</td>
<td id="S3.T2.5.1.3.8" class="ltx_td ltx_align_center ltx_border_t">0.72</td></tr>
