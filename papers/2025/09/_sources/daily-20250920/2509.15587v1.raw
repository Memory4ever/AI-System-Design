<th id="S1.T1.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">RuleTaker</th>
<td id="S1.T1.2.4.2" class="ltx_td ltx_align_center ltx_border_t">✗</td>
