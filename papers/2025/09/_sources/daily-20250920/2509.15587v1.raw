<th id="S1.T1.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Diversity</th>
<th id="S1.T1.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Logic-centered</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S1.T1.2.2" class="ltx_tr">
