<figure id="S2.T5" class="ltx_table">
<table id="S2.T5.2" class="ltx_tabular ltx_centering ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="S2.T5.2.1" class="ltx_tr">
<td id="S2.T5.2.1.1" class="ltx_td ltx_border_tt"></td>
