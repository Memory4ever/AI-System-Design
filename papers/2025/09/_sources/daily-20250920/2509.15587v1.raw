<tr id="S1.T1.2.6" class="ltx_tr">
<th id="S1.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">FOLIO</th>
<td id="S1.T1.2.6.2" class="ltx_td ltx_align_center">✗</td>
