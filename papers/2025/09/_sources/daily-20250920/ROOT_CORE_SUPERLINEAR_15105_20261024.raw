<td id="A6.T12.2.1.5.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A6.T12.m3" class="ltx_Math" alttext="30" display="inline" intent=":literal"><semantics><mn>30</mn><annotation encoding="application/x-tex">30</annotation></semantics></math></td></tr>
<tr id="A6.T12.2.1.6" class="ltx_tr">
<td id="A6.T12.2.1.6.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Patience</td>
<td id="A6.T12.2.1.6.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Number of epochs without improvement before early stopping</td>
<td id="A6.T12.2.1.6.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A6.T12.m4" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math></td></tr>
<tr id="A6.T12.2.1.7" class="ltx_tr">
<td id="A6.T12.2.1.7.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Learning Rate Adjustment (decay)</td>
<td id="A6.T12.2.1.7.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Strategy for adapting the learning rate during training</td>
<td id="A6.T12.2.1.7.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A6.T12.m5" class="ltx_Math" alttext="0.9^{epoch-3}" display="inline" intent=":literal"><semantics><msup><mn>0.9</mn><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>−</mo><mn>3</mn></mrow></msup><annotation encoding="application/x-tex">0.9^{epoch-3}</annotation></semantics></math> if <math id="A6.T12.m6" class="ltx_Math" alttext="epoch&gt;3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>&gt;</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">epoch&gt;3</annotation></semantics></math> else <math id="A6.T12.m7" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math></td></tr>
<tr id="A6.T12.2.1.8" class="ltx_tr">
