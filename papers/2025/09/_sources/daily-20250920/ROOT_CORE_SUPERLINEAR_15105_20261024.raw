<td id="A6.T12.2.1.8.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A6.T12.m8" class="ltx_Math" alttext="12" display="inline" intent=":literal"><semantics><mn>12</mn><annotation encoding="application/x-tex">12</annotation></semantics></math></td></tr>
<tr id="A6.T12.2.1.9" class="ltx_tr">
<td id="A6.T12.2.1.9.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Dataset Max Size</td>
