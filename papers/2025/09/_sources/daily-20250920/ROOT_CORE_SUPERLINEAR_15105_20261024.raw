<td id="A6.T12.2.1.9.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A6.T12.m9" class="ltx_Math" alttext="100,000" display="inline" intent=":literal"><semantics><mn>100,000</mn><annotation encoding="application/x-tex">100,000</annotation></semantics></math></td></tr>
<tr id="A6.T12.2.1.10" class="ltx_tr">
<td id="A6.T12.2.1.10.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t">Frequency Experts <math id="A6.T12.m10" class="ltx_Math" alttext="N_{f}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>f</mi></msub><annotation encoding="application/x-tex">N_{f}</annotation></semantics></math></td>
<td id="A6.T12.2.1.10.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">Number of different frequency experts</td>
<td id="A6.T12.2.1.10.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A6.T12.m11" class="ltx_Math" alttext="37" display="inline" intent=":literal"><semantics><mn>37</mn><annotation encoding="application/x-tex">37</annotation></semantics></math></td></tr>
