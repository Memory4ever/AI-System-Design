<td id="A6.T12.2.1.13.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><math id="A6.T12.m15" class="ltx_Math" alttext="2,500" display="inline" intent=":literal"><semantics><mn>2,500</mn><annotation encoding="application/x-tex">2,500</annotation></semantics></math></td></tr>
<tr id="A6.T12.2.1.14" class="ltx_tr">
